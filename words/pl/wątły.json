{
    "word_family": [
        "wątłość"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b742834b-c586-3a1d-bcac-d004c0cc4756",
                    "sense_definition": "mający drobną, delikatną budowę ciała",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "budowa_ciała",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jak z tych <w>wątłych</w> chuderlaków zrobimy drużynę rugby?",
                            "target_lang_translations": {
                                "ru": "Как мы сделаем команду по регби из этих <w>хилых</w> доходяг?"
                            }
                        },
                        {
                            "text": "Mimo <w>wątłej</w> budowy ciała, był niezwykle szybkim biegaczem.",
                            "target_lang_translations": {
                                "ru": "Несмотря на <w>хилое</w> телосложение, он был невероятно быстрым бегуном."
                            }
                        }
                    ],
                    "synonyms": [
                        "drobny",
                        "szczupły",
                        "chudy",
                        "delikatny"
                    ],
                    "common_phrases": [
                        "wątła budowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий хрупкое, тонкое телосложение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хилый",
                                "target_lang_sense_clarification": "о слабом, болезненном телосложении"
                            },
                            {
                                "target_lang_word": "тощий",
                                "target_lang_sense_clarification": "очень худой, худощавый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e2eda6-450d-354a-af65-5f40f37f9873",
                    "sense_definition": "mający słabe zdrowie, często chorujący",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zdrowie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Widocznie babcinka martwi się o zdrowie swojego <w>wątłego</w> trzyletniego wnusia.",
                            "target_lang_translations": {
                                "ru": "Видимо, бабушка беспокоится о здоровье своего <w>хилого</w> трёхлетнего внучка."
                            }
                        },
                        {
                            "text": "Dziecko było bardzo <w>wątłe</w> i wymagało stałej opieki lekarskiej.",
                            "target_lang_translations": {
                                "ru": "Ребёнок был очень <w>хилым</w> и требовал постоянного медицинского наблюдения."
                            }
                        }
                    ],
                    "synonyms": [
                        "chorowity",
                        "słaby",
                        "mizerny"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий слабое здоровье, часто болеющий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хилый",
                                "target_lang_sense_clarification": "болезненный, немощный"
                            },
                            {
                                "target_lang_word": "чахлый",
                                "target_lang_sense_clarification": "болезненный, худосочный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2d2ed9a-b985-3be0-92a2-7a57fa931542",
                    "sense_definition": "łatwy do zniszczenia, nietrwały",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trwałość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zbudował <w>wątły</w> szałas, który zawalił się przy pierwszym silniejszym wietrze.",
                            "target_lang_translations": {
                                "ru": "Он построил <w>утлый</w> шалаш, который развалился при первом же сильном ветре."
                            }
                        },
                        {
                            "text": "Most był tak <w>wątły</w>, że baliśmy się przez niego przechodzić.",
                            "target_lang_translations": {
                                "ru": "Мост был таким <w>ветхим</w>, что мы боялись по нему переходить."
                            }
                        }
                    ],
                    "synonyms": [
                        "kruchy",
                        "delikatny",
                        "wiotki"
                    ],
                    "common_phrases": [
                        "wątła konstrukcja"
                    ],
                    "target_lang_definitions": {
                        "ru": "легко разрушаемый, непрочный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утлый",
                                "target_lang_sense_clarification": "непрочный, ненадёжный"
                            },
                            {
                                "target_lang_word": "ветхий",
                                "target_lang_sense_clarification": "старый, близкий к разрушению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8937ced1-274c-3b0c-a47c-9b08215e1a5e",
                    "sense_definition": "mający słabe podstawy lub słabe powiązania",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trwałość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przedstawił bardzo <w>wątłe</w> argumenty na poparcie swojej tezy.",
                            "target_lang_translations": {
                                "ru": "Он представил очень <w>слабые</w> аргументы в поддержку своего тезиса."
                            }
                        },
                        {
                            "text": "Jego <w>wątłe</w> nadzieje na sukces szybko zniknęły po ogłoszeniu wyników.",
                            "target_lang_translations": {
                                "ru": "Его <w>шаткие</w> надежды на успех быстро исчезли после объявления результатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "słaby",
                        "chwiejny",
                        "niesilny"
                    ],
                    "common_phrases": [
                        "wątłe nadzieje",
                        "wątłe argumenty"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий слабые основания или связи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "неубедительный, не имеющий прочной основы"
                            },
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "неустойчивый, ненадёжный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcfe305a-1235-367d-8f44-af18dbd3f741",
                    "sense_definition": "słabo widoczny, niewyraźny",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "widoczność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W oddali majaczył <w>wątły</w> płomień świecy.",
                            "target_lang_translations": {
                                "ru": "Вдали мерцал <w>тусклый</w> огонёк свечи."
                            }
                        },
                        {
                            "text": "Zza chmur wyłonił się <w>wątły</w> promień słońca.",
                            "target_lang_translations": {
                                "ru": "Из-за облаков показался <w>слабый</w> луч солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "niewyraźny",
                        "zanikający",
                        "znikający"
                    ],
                    "target_lang_definitions": {
                        "ru": "слабо видимый, неясный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусклый",
                                "target_lang_sense_clarification": "слабый, неяркий (о свете)"
                            },
                            {
                                "target_lang_word": "слабый",
                                "target_lang_sense_clarification": "едва заметный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}