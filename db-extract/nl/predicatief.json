                    {
                        "sense_id": "8f166703-b61d-3249-8805-b8a8b83d7e7c",
                        "entry_id": "7eaeb4c4-cb98-3e2a-8ca2-9dd9de39b64a",
                        "glosses": [
                            "als naamwoordelijk deel van het gezegde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb3a4c0-5205-4fc5-a8c0-8c0a26b5a2e3",
                                "sense_id": "8f166703-b61d-3249-8805-b8a8b83d7e7c",
                                "text": "Je kunt een bijvoeglijk naamwoord als \"lief\" zowel predicatief (\"een kind dat lief is\") als attributief (\"een lief kind\") gebruiken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b59cc1c-41be-4b01-b5a4-4e4b97837d78",
