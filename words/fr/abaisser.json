                        "abaisser les yeux",
                        "abaisser le regard"
                    ]
                },
                {
                    "sense_id": "da2629af-728b-3062-b648-1aaf8b2e3195",
                    "sense_definition": "Rendre une valeur, une quantité ou un niveau moins élevé.",
