                "senses": [
                    {
                        "sense_id": "3a2f2854-bbee-3950-b11f-3ed16b35f352",
                        "entry_id": "6149e7f7-358f-3f02-b970-dabfc10239c3",
                        "glosses": [
                            "Licht, das von Scheinwerfern ausgesandt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea012033-c2f8-4f3e-b335-f1df96c2351b",
                                "sense_id": "3a2f2854-bbee-3950-b11f-3ed16b35f352",
                                "text": "„Überall glitzerten vom leichten Morgenfrost überzogene Glockenblumen im Schweinwerferlicht.“"
                            },
                            {
                                "example_id": "2b8d43b2-3f4e-4e64-b9a8-e54d5790f874",
                                "sense_id": "3a2f2854-bbee-3950-b11f-3ed16b35f352",
                                "text": "„Wir fahren schweigend durch dichten Nebel, der das Scheinwerferlicht des Wagens schluckt.“"
                            },
                            {
                                "example_id": "1ce3cd05-5597-43a7-adc4-681072c2a191",
                                "sense_id": "3a2f2854-bbee-3950-b11f-3ed16b35f352",
                                "text": "„Kurz nach Verlassen der Stadt, ich wohne 15 km außerhalb, tauchte eine winkende, vollschlanke Dame (45) im Scheinwerferlicht auf.“"
                            },
                            {
                                "example_id": "40f1fe8d-b1bd-4ed5-bd0c-070c1ab55704",
                                "sense_id": "3a2f2854-bbee-3950-b11f-3ed16b35f352",
                                "text": "„Zwei Stühle standen im Scheinwerferlicht, um das die Schauspielschüler einen Kreis bildeten.“"
                            },
                            {
                                "example_id": "0151ea05-9275-48ea-ad9f-81e64554544b",
                                "sense_id": "3a2f2854-bbee-3950-b11f-3ed16b35f352",
                                "text": "„Das Tier flatterte wild auf im Scheinwerferlicht, ganz weiß, drehte ab und entschwebte in die Dunkelheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
