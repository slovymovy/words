                "senses": [
                    {
                        "sense_id": "bafc7876-37b2-37b5-83d7-7e4c26db65c6",
                        "entry_id": "c70ace2f-eeb2-3ee1-814e-373380f6ed3a",
                        "glosses": [
                            "En vertu d’une condition territoriale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88b4465-a4e3-4bf6-91e7-8163432b32f7",
                                "sense_id": "bafc7876-37b2-37b5-83d7-7e4c26db65c6",
                                "text": "À l'exception d'une courte période, […], les tenants d'un pouvoir séculier optèrent pour des idéologies supranationales, comme le panarabisme, détournant leur attention des problèmes de l'État-nation territorialement délimité."
                            },
                            {
                                "example_id": "ef2dec58-9af1-4e35-8afd-8e154bf72709",
                                "sense_id": "bafc7876-37b2-37b5-83d7-7e4c26db65c6",
                                "text": "Cette trajectoire progressive doit être déclinée territorialement dans les documents de planification et d’urbanisme."
                            },
                            {
                                "example_id": "65e1fe1c-c829-45cb-b75f-f1d64fc47cb5",
                                "sense_id": "bafc7876-37b2-37b5-83d7-7e4c26db65c6",
                                "text": "Au Moyen Âge les abbayes faisaient partie, territorialement, de l’ordre féodal."
                            }
                        ]
                    }
                ],
