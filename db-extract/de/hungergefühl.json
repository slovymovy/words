                "senses": [
                    {
                        "sense_id": "2896edd3-117c-3d08-a0f3-f58ff83b8a6a",
                        "entry_id": "d20a0b11-9b3d-3656-9582-ce62882c2658",
                        "glosses": [
                            "das Gefühl, dringend Nahrung zu sich nehmen zu müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c18a1a3c-e7d1-4fc0-a85a-a739de31aadb",
                                "sense_id": "2896edd3-117c-3d08-a0f3-f58ff83b8a6a",
                                "text": "„Dieses Hungergefühl war ewig da.“"
                            },
                            {
                                "example_id": "b6ac8dc2-223e-406f-b8f9-731d0d759a43",
                                "sense_id": "2896edd3-117c-3d08-a0f3-f58ff83b8a6a",
                                "text": "„Ein kräftiges Hungergefühl trieb mich auf.“"
                            },
                            {
                                "example_id": "f85ef66b-6709-4f96-9575-32163a7266ce",
                                "sense_id": "2896edd3-117c-3d08-a0f3-f58ff83b8a6a",
                                "text": "„Ein plötzliches Hungergefühl riss ihn aus seinem Gedankenwirrwarr, führte ihn ganz einfach zum Frühstück.“"
                            },
                            {
                                "example_id": "2ea01197-6831-450f-b3b1-c6f5623979d4",
                                "sense_id": "2896edd3-117c-3d08-a0f3-f58ff83b8a6a",
                                "text": "„Bei den anderen fährt der Körper nach einer Weile die langfristig ungesunde Stressreaktion wieder herunter – allerdings kann das Gehirn dann nicht mehr so flexibel mit Zucker versorgt werden und reagiert mit Hungergefühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
