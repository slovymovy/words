                    {
                        "translation_id": "d0f0cdbb-9b69-4b64-a751-243c69885c8c",
                        "source_entry_id": "59a0d999-044c-31f0-a7c0-ef50fc9bbe01",
                        "source_sense_id": "9b27d1d5-6041-37c0-b039-b1c6fe04909c",
