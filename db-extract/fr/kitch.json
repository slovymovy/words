                            {
                                "example_id": "6637d4d2-3e5b-4c00-9c03-a9c0f9d20c5c",
                                "sense_id": "b1a15aae-79e8-3f00-b7a7-ce7af0af5518",
                                "text": "La chromo, en allemand le kitch, existe dans le domaine des cabarets de nuit. Restaurants bizarres, généralement slaves, qui sont à la fête nocturne ce que la quincaillerie catholico-lugubre de la place Saint-Sulpice est à l’art."
                            }
                        ]
                    }
