                "senses": [
                    {
                        "sense_id": "963b6bea-c524-356b-a9fc-b712e5bdcacb",
                        "entry_id": "ed97abcc-89e3-3088-9bd0-7d1511ba08f0",
                        "glosses": [
                            "Name für ein topografisches Objekt (Stadt, Fluss oder Ähnliches) in der Sprache, die im Gebiet des Objektes gesprochen wird"
                        ],
                        "tags": [
                            "Onomastik"
                        ],
                        "examples": [
                            {
                                "example_id": "3e44645c-bd17-4021-b2d0-7603694e086f",
                                "sense_id": "963b6bea-c524-356b-a9fc-b712e5bdcacb",
                                "text": "„Unterschieden werden zwei Typen von geographischen Namen: Endonyme und Exonyme. Als Endonyme bezeichnet man die von der Mehrheit der ansässigen Bevölkerung benutzten Namen, als standardisierte Endonyme die amtlich festgelegten Namensformen; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40e5c378-52f8-47d4-ad82-29b8b2912286",
                        "source_entry_id": "ed97abcc-89e3-3088-9bd0-7d1511ba08f0",
                        "source_sense_id": "963b6bea-c524-356b-a9fc-b712e5bdcacb",
                        "source_sense_description": "Name für ein topografisches Objekt in der Sprache, die im Gebiet des Objektes gesprochen wird",
                        "target_lang_word": "endonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                        "entry_id": "e8b9dd9d-0132-3b32-a75f-f40cb7d3f151",
                                        "glosses": [
                                            "A name used by a group or category of people (an ingroup) to refer to themselves or their language, as opposed to a name given to them by other groups (outgroups)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced3cab6-bdb5-4ba2-bf74-59506d507587",
                                                "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                                "text": "The endonym is the basic toponymic exemplar and as such it needs to be understood properly. To do so we need to appreciate the context of space and place that produces it. Most endonyms arise from the elemental human relationship with space and place, and possess an intrinsic and enduring value which cannot normally be either bestowed or removed by political arbitrariness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04f2090c-6461-4d26-845c-ba7abc6598bb",
                        "source_entry_id": "ed97abcc-89e3-3088-9bd0-7d1511ba08f0",
                        "source_sense_id": "963b6bea-c524-356b-a9fc-b712e5bdcacb",
                        "source_sense_description": "Name für ein topografisches Objekt in der Sprache, die im Gebiet des Objektes gesprochen wird",
                        "target_lang_word": "endonyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d99b3ec5-9db6-3404-973c-b79eb269a796",
                                        "entry_id": "5db1df47-8b79-30eb-a22a-a3dec3cf7407",
                                        "glosses": [
                                            "Mot indigène utilisé dans la forme exacte de la langue locale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c42e1d0-5aff-49e5-bb36-391f85610360",
                                                "sense_id": "d99b3ec5-9db6-3404-973c-b79eb269a796",
                                                "text": "Moscou est l'exonyme français de Moskva, translittération de l'endonyme Москва."
                                            },
                                            {
                                                "example_id": "29432980-7395-46db-a7ea-239ae0fc2a7d",
                                                "sense_id": "d99b3ec5-9db6-3404-973c-b79eb269a796",
                                                "text": "Il convient donc de s’attarder un instant sur les différentes appellations employées en insistant plus particulièrement sur les endonymes les plus répandus en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a14b6244-4b64-34c5-8cda-b48e06d2eeee",
                                        "entry_id": "5db1df47-8b79-30eb-a22a-a3dec3cf7407",
                                        "glosses": [
                                            "Mot par lequel les membres d'une ethnie se désignent eux-mêmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c0a997-790c-48e8-859e-5201903cf818",
                                                "sense_id": "a14b6244-4b64-34c5-8cda-b48e06d2eeee",
                                                "text": "L’expression « Malayu » n’est aujourd’hui que très rarement employée comme endonyme par les populations concernées car, dans son acception khmère, elle tend à connoter une certaine altérité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
