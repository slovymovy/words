                                        "sense_id": "c91ca8cd-c6d9-33fd-9bfa-8c3d885d5f46",
                                        "entry_id": "f74f5436-cf60-3797-9034-84c7a7dfd1c0",
                                        "glosses": [
                                            "The state of being preferred over others."
                                        ],
