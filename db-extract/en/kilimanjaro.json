                                    {
                                        "sense_id": "e991144d-89b4-33c3-a929-31d34b491ede",
                                        "entry_id": "37963ff8-fecd-33a2-a899-326556d276e9",
                                        "glosses": [
                                            "Montagne située dans le Nord-Est de la Tanzanie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "332cfba5-125c-4e9b-bcf4-99b09d2e1dbb",
                                                "sense_id": "e991144d-89b4-33c3-a929-31d34b491ede",
                                                "text": "Mais, à présent, tout était enveloppé de brouillard. Pour seul repère, j’avais, juste en face, au bout du ciel, sur la cime du monde, la table cyclopéenne chargée de neiges éternelles qui couronne le Kilimandjaro."
                                            },
                                            {
                                                "example_id": "59cdb7c5-2f7a-45db-8750-61df3353c75c",
                                                "sense_id": "e991144d-89b4-33c3-a929-31d34b491ede",
                                                "text": "La Tanzanie, pays de 58 millions d'habitants connu pour ses parcs naturels, l'île de Zanzibar et le Kilimandjaro, a longtemps été considérée comme un havre de stabilité dans une région particulièrement volatile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "198ec7a9-9888-4f1a-80f0-c8561a575337",
                        "source_entry_id": "74d3bdfe-4391-3746-9e6c-da0935f8f1fe",
                        "source_sense_id": "cf490a56-0459-3591-ae48-0d4f8bc2adfa",
                        "source_sense_description": "volcano",
                        "target_lang_word": "Kilimandscharo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kilimandscharo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e3f36e5-ecca-32c9-8bcf-d90e5bd6e708",
                                        "entry_id": "c2c82425-047b-373f-84a4-a1789e6c0f71",
                                        "glosses": [
                                            "Gebirgsmassiv vulkanischen Ursprungs in Tansania mit der höchsten Erhebung Afrikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a65fd1-41d2-4d06-920d-338caaedd0d9",
                                                "sense_id": "2e3f36e5-ecca-32c9-8bcf-d90e5bd6e708",
                                                "text": "„Er hat mit dem Fahrrad die Welt umrundet, den australischen Kontinent durchquert und mehrfach den Kilimandscharo bestiegen.“"
                                            },
                                            {
                                                "example_id": "e767bc90-3c44-4e17-8651-35a10899d9fe",
                                                "sense_id": "2e3f36e5-ecca-32c9-8bcf-d90e5bd6e708",
                                                "text": "„Der Kilimandscharo ist längst kein unbeschriebenes Blatt mehr.“"
                                            },
                                            {
                                                "example_id": "3e1890a3-f8a2-490f-a16d-d100070ff08b",
                                                "sense_id": "2e3f36e5-ecca-32c9-8bcf-d90e5bd6e708",
                                                "text": "„Meyer war am Ziel seiner Träume angelangt: Endlich hatte er den Gipfel jenes Berges erklommen, den die Einheimischen Kilimandscharo nannten - »der afrikanische Riese war bezwungen«.“"
                                            },
                                            {
                                                "example_id": "a5ac72b9-a1f9-4559-b350-48d2100c717f",
                                                "sense_id": "2e3f36e5-ecca-32c9-8bcf-d90e5bd6e708",
                                                "text": "„Am 28. September 1889 wurde der Kilimandscharo mit neun Trägern, einem Koch und vier weiteren Helfern in Angriff genommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
