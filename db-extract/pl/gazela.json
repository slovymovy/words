                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f3f69f7-a53d-35e2-a8ff-f120ed37d21a",
                        "entry_id": "649c0dc5-e665-389c-a394-4aca94e3d16f",
                        "glosses": [
                            "mała afrykańska antylopa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d529bd4-a61b-4fe0-ab59-33420bc9e046",
                                "sense_id": "5f3f69f7-a53d-35e2-a8ff-f120ed37d21a",
                                "text": "Pawie, flamingi, łabędzie i strusie, gazele i antylopy z Afryki, jelenie i sarny, służące za ozdobę ogrodów, poszły pod nóż tłuszczy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "04a5e2e7-7a71-320d-b492-77ae282c4c49",
                        "entry_id": "649c0dc5-e665-389c-a394-4aca94e3d16f",
                        "glosses": [
                            "gazel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b14e1b-141b-46ff-975d-02d01324214f",
                                "sense_id": "04a5e2e7-7a71-320d-b492-77ae282c4c49",
                                "text": "Jeszcze w uniwersytecie czytałem jakąś gazelę arabską, porównującą siłę miłości do siły piekielnych kleszczów"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "485de8ea-a6a3-47d8-b974-77077eeabe38",
                        "source_entry_id": "649c0dc5-e665-389c-a394-4aca94e3d16f",
                        "source_sense_id": "5f3f69f7-a53d-35e2-a8ff-f120ed37d21a",
                        "target_lang_word": "gazelle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazelle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e97b78bd-4173-3fa9-99e3-2148d76a9dca",
                                        "entry_id": "02b7bc57-f8d5-3113-94a1-c2d928d7a458",
                                        "glosses": [
                                            "An antelope of either of the genera Gazella (mostly native to Africa), Procapra (native to Asia), Eudorcas, or Nanger, capable of running at high speeds for long periods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba21da58-8f2f-422e-8de3-63e80304c875",
                                                "sense_id": "e97b78bd-4173-3fa9-99e3-2148d76a9dca",
                                                "text": "“One does not judge the gazelle by the lions that attack it,” replied Tarzan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8e2e25b-db6f-4e41-9ee0-cfb6e57ebcfb",
                        "source_entry_id": "649c0dc5-e665-389c-a394-4aca94e3d16f",
                        "source_sense_id": "5f3f69f7-a53d-35e2-a8ff-f120ed37d21a",
                        "target_lang_word": "gazelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acf52ebb-8e5d-3a8e-8aa2-b4cab1070399",
                                        "entry_id": "eebf6fb9-5afc-3a80-ba23-b44b1c507d12",
                                        "glosses": [
                                            "Espèces d’antilopes plus petites que le daim, élancées et gracieuses, aux longues pattes fines et légères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56c370e-b8d4-4108-82fc-da1adba127a0",
                                                "sense_id": "acf52ebb-8e5d-3a8e-8aa2-b4cab1070399",
                                                "text": "Savez-vous qu’elle a des yeux de gazelle ? Il est vrai que je n’ai jamais vu des gazelles, et pourtant je suis sûre qu’elles ont ces yeux-là."
                                            },
                                            {
                                                "example_id": "01113ef9-78cf-489d-8597-fbde4e1063ab",
                                                "sense_id": "acf52ebb-8e5d-3a8e-8aa2-b4cab1070399",
                                                "text": "Plus loin, une vision rapide de chevaux lancés à toute vitesse, de selles rouges et de vêtements blancs envolés dans un nuage de poussière : des chasseurs à la poursuite de quelque gibier, lièvre ou gazelle probablement."
                                            },
                                            {
                                                "example_id": "23044727-d064-4726-8ffd-29a97aef6462",
                                                "sense_id": "acf52ebb-8e5d-3a8e-8aa2-b4cab1070399",
                                                "text": "Elle dérobait du kohl à sa mère pour s’en noircir les cils et donner à ses yeux agrandis la langueur du regard des gazelles."
                                            },
                                            {
                                                "example_id": "92e0578c-5b38-447f-bf08-0d9c2c5c523e",
                                                "sense_id": "acf52ebb-8e5d-3a8e-8aa2-b4cab1070399",
                                                "text": "Au détour d'un amas de roches buissonneuses, je tire sur une gazelle. Un bellah arrête le dernier bourriquot du convoi pour emporter ce gibier — notre repas, ce soir."
                                            },
                                            {
                                                "example_id": "928922d1-417f-471a-b4a1-e3e4e1afc72a",
                                                "sense_id": "acf52ebb-8e5d-3a8e-8aa2-b4cab1070399",
                                                "text": "Une troupe de gazelles passa au milieu de la clairière, sur le fond du Kilimandjaro. Leurs cornes très minces et rejetées loin en arrière, presque à l’horizontale, avaient la courbure d’une aile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e661e283-125b-31db-a3da-ea6b88374708",
                                        "entry_id": "eebf6fb9-5afc-3a80-ba23-b44b1c507d12",
                                        "glosses": [
                                            "Jeune fille ; jeune femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d16c98f-3cf4-4e18-88c7-13dbb99b0ccb",
                                                "sense_id": "e661e283-125b-31db-a3da-ea6b88374708",
                                                "text": "À bien y regarder, ces braqueurs, c'étaient pas des pégreleux mais des frangines ! Trois gazelles, avec plus de testostérone que le pauvre mariole que je suis, apparemment. Quand elles ont aperçu les flics, elles ont toutes plongé dans la marave, sans un fétu de pétoche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a79adc6-c3cb-3a19-8f88-34d6b5806eaa",
                                        "entry_id": "eebf6fb9-5afc-3a80-ba23-b44b1c507d12",
                                        "glosses": [
                                            "Mot tendre → voir biche."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39052371-4338-4512-8e1b-308f99e6ce1c",
                                                "sense_id": "2a79adc6-c3cb-3a19-8f88-34d6b5806eaa",
                                                "text": "Ma gazelle !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fa3b7c6-98ba-3ef0-b1cf-c8cb1d4dbb4f",
                                        "entry_id": "eebf6fb9-5afc-3a80-ba23-b44b1c507d12",
                                        "glosses": [
                                            "Plate-forme à roulettes utilisée dans le secteur d'activité du bâtiment."
                                        ],
                                        "tags": [
                                            "Échafaudage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ea9244-3eda-4da9-812a-065418271d54",
                                                "sense_id": "9fa3b7c6-98ba-3ef0-b1cf-c8cb1d4dbb4f",
                                                "text": "Sur un chantier en intérieur, les électriciens, lorsqu’ils installent des chemins de câble en hauteur ou qu’ils font passer des gaines dans les faux-plafonds, utilise une PIRL (plate-forme individuelle roulante légère), communément appelée « gazelle » ou un échafaudage roulant, de préférence à MDS (montage et démontage en sécurité)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
