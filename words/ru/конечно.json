{
    "word_family": [
        "конец",
        "конечный",
        "бесконечный",
        "наконец",
        "кончать",
        "закончить",
        "окончательно",
        "конечность"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "151aeb0a-915f-3c90-9001-480a85bc87a6",
                    "sense_definition": "Вводное слово, выражающее уверенность говорящего в истинности сообщаемого; само собой разумеется, без сомнения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "certainty_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы, <w>конечно</w>, придём к тебе в гости в следующую субботу.",
                            "target_lang_translations": {
                                "en": "We will, <w>of course</w>, come visit you next Saturday.",
                                "zh": "下周六我们<w>当然</w>会去你家做客。"
                            }
                        },
                        {
                            "text": "<w>Конечно</w>, учить новый язык непросто, но это очень интересно.",
                            "target_lang_translations": {
                                "en": "<w>Of course</w>, learning a new language is not easy, but it is very interesting.",
                                "zh": "<w>当然</w>，学习一门新语言并不容易，但它非常有趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разумеется",
                        "естественно",
                        "несомненно",
                        "само собой",
                        "действительно",
                        "определённо",
                        "однозначно",
                        "само собой разумеется"
                    ],
                    "common_phrases": [
                        "ну конечно",
                        "конечно же",
                        "конечно нет"
                    ],
                    "target_lang_definitions": {
                        "en": "An introductory word expressing the speaker's certainty in the truth of the statement; naturally, without doubt.",
                        "zh": "用于句首或句中，表示说话人对所说内容确信无疑；当然，毫无疑问。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of course",
                                "target_lang_sense_clarification": "indicating that something is obvious or expected"
                            },
                            {
                                "target_lang_word": "certainly",
                                "target_lang_sense_clarification": "emphasizing that something is true or without doubt"
                            },
                            {
                                "target_lang_word": "naturally",
                                "target_lang_sense_clarification": "as is normal or to be expected"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当然",
                                "target_lang_sense_clarification": "表示理所当然，用于强调确信"
                            },
                            {
                                "target_lang_word": "肯定",
                                "target_lang_sense_clarification": "表示确定无疑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b909a773-b650-37ec-935a-bcd47806002d",
                    "sense_definition": "Утвердительный ответ на вопрос или просьбу, выражающий полное согласие.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "certainty_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты поможешь мне перевести этот текст? — <w>Конечно</w>!",
                            "target_lang_translations": {
                                "en": "Will you help me translate this text? — <w>Of course</w>!",
                                "zh": "你能帮我翻译这段文字吗？——<w>当然</w>可以！"
                            }
                        },
                        {
                            "text": "Можно мне взять твою ручку на минуту? — <w>Конечно</w>, бери.",
                            "target_lang_translations": {
                                "en": "May I borrow your pen for a minute? — <w>Sure</w>, go ahead.",
                                "zh": "我能借用一下你的笔吗？——<w>当然</w>，拿去吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "да",
                        "разумеется",
                        "естественно",
                        "точно",
                        "обязательно"
                    ],
                    "common_phrases": [
                        "да конечно"
                    ],
                    "target_lang_definitions": {
                        "en": "An affirmative answer to a question or request, expressing full agreement.",
                        "zh": "对问题或请求的肯定回答，表示完全同意。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "of course",
                                "target_lang_sense_clarification": "used to give permission or agree enthusiastically"
                            },
                            {
                                "target_lang_word": "sure",
                                "target_lang_sense_clarification": "informal expression of agreement"
                            },
                            {
                                "target_lang_word": "certainly",
                                "target_lang_sense_clarification": "formal or polite expression of agreement"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当然",
                                "target_lang_sense_clarification": "表示完全同意或乐意帮忙"
                            },
                            {
                                "target_lang_word": "没问题",
                                "target_lang_sense_clarification": "口语中表示爽快答应"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4306d093-64bc-3415-972a-313a5c4931d5",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>конечный</w>; имеющее предел, не бесконечное.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Число возможных комбинаций в этой сложной игре <w>конечно</w>.",
                            "target_lang_translations": {
                                "en": "The number of possible combinations in this complex game is <w>finite</w>.",
                                "zh": "这个复杂游戏中可能的组合数量是<w>有限</w>的。"
                            }
                        },
                        {
                            "text": "Всё в нашем материальном мире временно и <w>конечно</w>.",
                            "target_lang_translations": {
                                "en": "Everything in our material world is temporary and <w>finite</w>.",
                                "zh": "我们物质世界中的一切都是暂时的且<w>有限</w>的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "бесконечно"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular of конечный"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective meaning having a limit; not infinite.",
                        "zh": "形容词“有限的”的短尾形式，指有界限的，非无限的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finite",
                                "target_lang_sense_clarification": "having limits or bounds"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有限",
                                "target_lang_sense_clarification": "指数量或范围有尽头"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}