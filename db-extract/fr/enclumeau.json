                "senses": [
                    {
                        "sense_id": "a1214776-f7bf-37ba-8a86-d6b36f0d653e",
                        "entry_id": "b4b712e0-1d05-3c57-aacf-60fe3e3be1d9",
                        "glosses": [
                            "Petite enclume portative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d120f010-dba9-49d1-a74c-de243e31d6b1",
                                "sense_id": "a1214776-f7bf-37ba-8a86-d6b36f0d653e",
                                "text": "– Souffre, souffre, enclumeau. Souffre, tant qu’es enclumeau. Frappe, quand tu seras marteau…"
                            },
                            {
                                "example_id": "4af625e4-c0cb-4aa1-b479-ec5648192095",
                                "sense_id": "a1214776-f7bf-37ba-8a86-d6b36f0d653e",
                                "text": "Sous une pince à bec, une main tient un maillet et une rangée d’aiguilles qu’elle palme : l’extrémité pointue est saisie, afin d’aplatir au maillet le bout opposé ou cul de l’aiguille, sur un enclumeau."
                            },
                            {
                                "example_id": "21eb0c65-8506-4872-bdbf-90e0cf070b96",
                                "sense_id": "a1214776-f7bf-37ba-8a86-d6b36f0d653e",
                                "text": "Enclumette existe bien, dans le dictionnaire, entre enclumeau et enclumot, trois synonymes servant à désigner les toutes petites enclumes portatives, notamment de faucheurs, qui servaient surtout, jadis, à aiguiser la lame, peut-être en martelant la faux."
                            }
                        ]
                    }
