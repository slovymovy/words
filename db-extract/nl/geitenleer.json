                "senses": [
                    {
                        "sense_id": "eb372bc0-fa46-36ed-90ee-7e33fb2eed0b",
                        "entry_id": "86dc4214-6048-31bd-a858-e4a2de817c5f",
                        "glosses": [
                            "leer gemaakt van de huid van een geit"
