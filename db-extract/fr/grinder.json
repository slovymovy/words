                "senses": [
                    {
                        "sense_id": "2a859d88-5b9e-34b6-b064-1bed21bc9065",
                        "entry_id": "9547580f-1d26-3285-a3a2-c032cad2e406",
                        "glosses": [
                            "Répéter sans arrêt la même action pour obtenir à chaque fois un petit avantage, dans un jeu vidéo,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "810f86b2-c037-40c2-94c5-22c039df776a",
                                "sense_id": "2a859d88-5b9e-34b6-b064-1bed21bc9065",
                                "text": "J'ajouterai quand même une chose qui n'est pas dite dans le test ci-dessus : contrairement à beaucoup d'Action-RPG qui deviennent assez faciles vers la fin, une fois qu'on a bien grindé notre perso et qu'il est over-craqué, jouer avec la difficulté au maximum (c'est-à-dire, en activant toutes les idoles) rend le jeu incroyablement fun, et dur :)"
                            },
                            {
                                "example_id": "4914895b-ad6f-4a05-8d30-71e088b9ddbc",
                                "sense_id": "2a859d88-5b9e-34b6-b064-1bed21bc9065",
                                "text": "Donc en 10 minutes tu peux te défactionner, remettre à 0 ton niveau de pilote, te refactionner et recommencer à grinder ton pilote."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5ebac13-f536-3798-8b0e-aa3d4a4ba296",
                        "entry_id": "9547580f-1d26-3285-a3a2-c032cad2e406",
                        "glosses": [
                            "Jouer de façon à obtenir de tout petits gains, mais un très grand nombre de fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a9d867-3bfa-4d57-a889-240fdeaa37cb",
                                "sense_id": "d5ebac13-f536-3798-8b0e-aa3d4a4ba296",
                                "text": "Un grinder grinde toujours deux fois"
                            },
                            {
                                "example_id": "c799ee78-549e-45d2-afac-a26657098db3",
                                "sense_id": "d5ebac13-f536-3798-8b0e-aa3d4a4ba296",
                                "text": "Ca grinde toujours à Végas"
                            },
                            {
                                "example_id": "de9eaf65-d7d9-48f3-afd0-00c30eacd5c7",
                                "sense_id": "d5ebac13-f536-3798-8b0e-aa3d4a4ba296",
                                "text": "Je grinde toujours la NL10 avec deux grosses sessions hier."
                            }
                        ]
                    }
