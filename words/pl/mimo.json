                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nikt <w>mimo</w> niego nie odważył się zabrać głosu na zebraniu.",
