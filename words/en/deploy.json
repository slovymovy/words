                            },
                            {
                                "target_lang_word": "развёртывание",
                                "target_lang_sense_clarification": "технический процесс"
                            },
                            {
                                "target_lang_word": "релиз",
                                "target_lang_sense_clarification": "выпуск версии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
