    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f70de795-ddae-32a8-b0b7-9aa9508e6314",
                    "sense_definition": "Pomieszczenie znajdujące się poniżej poziomu parteru budynku, często wykorzystywane jako magazyn lub schronienie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pomieszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>piwnicy</w> trzymam rower oraz stare pudełka z pamiątkami."
                        },
                        {
                            "text": "Podczas burzy wszyscy mieszkańcy zeszli do <w>piwnicy</w>."
                        }
                    ],
                    "antonyms": [
                        "strych",
                        "poddasze"
                    ],
                    "common_phrases": [
                        "zejść do piwnicy",
                        "ciemna piwnica"
                    ]
                },
                {
                    "sense_id": "80932465-0ef6-3e70-98cd-47c10daa4c7b",
                    "sense_definition": "Wolnostojący budynek gospodarczy lub ziemianka służąca do przechowywania żywności w niskiej temperaturze.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pomieszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Za domem dziadkowie mieli ziemną <w>piwnicę</w>, w której zimą trzymali ziemniaki."
                        },
                        {
                            "text": "W dawnych czasach każda wiejska <w>piwnica</w> była pełna zapasów na zimę."
                        }
                    ],
                    "common_phrases": [
                        "ziemna piwnica"
                    ]
                },
                {
                    "sense_id": "2c369d9d-e61e-36f5-b667-7fd17b498386",
                    "sense_definition": "Zbiór trunków, zwłaszcza win, przechowywanych w odpowiednich warunkach.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kolekcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Restaurator posiada imponującą <w>piwnicę</w> pełną rzadkich win z całego świata."
                        },
                        {
                            "text": "Jego <w>piwnica</w> liczy ponad tysiąc butelek."
                        }
                    ],
                    "common_phrases": [
                        "piwnica win"
                    ]
                },
                {
                    "sense_id": "2697cb09-0824-3887-894c-64c7c8bcfaa3",
                    "sense_definition": "Lokal gastronomiczny lub artystyczny mieszczący się w podziemnych pomieszczeniach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lokal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Słynna <w>Piwnica</w> pod Baranami to miejsce z bogatą historią artystyczną."
                        },
                        {
                            "text": "Wieczorem spotkaliśmy się w klimatycznej <w>piwnicy</w> na koncert jazzowy."
                        }
                    ],
                    "common_phrases": [
                        "artystyczna piwnica"
                    ]
                }
            ]
        }
    ]
