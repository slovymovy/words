            {
                "entry_id": "920a1e66-6508-3067-bea7-3176d1966455",
                "word": "bluestone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cbac1562-2ee1-457f-a0ed-b285075a0b73",
                        "entry_id": "920a1e66-6508-3067-bea7-3176d1966455",
                        "tags": [
                            "plural"
