                                                "sense_id": "0ea6e644-ef3b-336c-9ff8-9289b5785160",
                                                "text": "to roast meat on a spit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f2b897d-4355-3ec5-b434-8437aff72910",
                                        "entry_id": "678c424d-56c1-392f-80fa-c214e682499d",
                                        "glosses": [
                                            "To cook by surrounding with hot embers, ashes, sand, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e31dcd-6ea2-43d9-b8e6-7aef2fd2ae2d",
                                                "sense_id": "8f2b897d-4355-3ec5-b434-8437aff72910",
                                                "text": "to roast a potato in ashes"
                                            },
                                            {
                                                "example_id": "7dd1edb3-4e0a-41a9-b923-0958cee853d0",
                                                "sense_id": "8f2b897d-4355-3ec5-b434-8437aff72910",
                                                "text": "In eggs boiled and roasted […]there is scarce difference to be discerned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b894a2-2f7d-3a74-9d3a-d7bec8d7da34",
                                        "entry_id": "678c424d-56c1-392f-80fa-c214e682499d",
                                        "glosses": [
                                            "To process by drying through exposure to sun or artificial heat."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe8ca771-ecce-4036-974b-da11bd452114",
                                                "sense_id": "74b894a2-2f7d-3a74-9d3a-d7bec8d7da34",
                                                "text": "Coffee beans need roasting before use."
                                            },
                                            {
                                                "example_id": "d02154be-bb03-40fe-b3a4-2660344a4134",
                                                "sense_id": "74b894a2-2f7d-3a74-9d3a-d7bec8d7da34",
                                                "text": "to roast chestnuts or peanuts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaa880e0-0a11-3319-bbb9-364ab0e3a946",
                                        "entry_id": "678c424d-56c1-392f-80fa-c214e682499d",
                                        "glosses": [
                                            "To heat to excess; to heat violently; to burn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b6cc93-687a-42ae-99da-52b9536f4f39",
                                                "sense_id": "eaa880e0-0a11-3319-bbb9-364ab0e3a946",
                                                "text": "roasted in wrath and fire"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2ece005-b963-372f-82c4-c4f6f43ddc41",
                                        "entry_id": "678c424d-56c1-392f-80fa-c214e682499d",
                                        "glosses": [
                                            "To admonish someone vigorously."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d70ccbe6-eb9d-4e7b-85f4-6be4598cde8e",
                                                "sense_id": "a2ece005-b963-372f-82c4-c4f6f43ddc41",
                                                "text": "I'm late home for the fourth time this week; my mate will really roast me this time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a606a73-d250-34bf-bb9f-8893524e56d9",
                                        "entry_id": "678c424d-56c1-392f-80fa-c214e682499d",
                                        "glosses": [
                                            "To subject to bantering, severely criticize, sometimes as a comedy routine."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328e1e47-f683-46d7-ad41-f84451c5546c",
                                                "sense_id": "1a606a73-d250-34bf-bb9f-8893524e56d9",
                                                "text": "He roasted a bully who then fought with him."
                                            },
                                            {
                                                "example_id": "cdd7b26e-4ca3-4d29-8bf9-b539660ba78a",
                                                "sense_id": "1a606a73-d250-34bf-bb9f-8893524e56d9",
                                                "text": "The class clown enjoys being roasted by mates as well as staff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07deb96f-2951-3afc-878b-157209a923a3",
                                        "entry_id": "678c424d-56c1-392f-80fa-c214e682499d",
                                        "glosses": [
                                            "To dissipate the volatile parts of by heat, as ores."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
