                            {
                                "example_id": "d1795224-e4df-4e5f-a5a0-c1a6cf98d942",
                                "sense_id": "b40032b9-0547-33dc-8faa-93995b83b7b4",
                                "text": "пе́рвая в ми́ре же́нщина-космона́вт",
                                "translation": "the world’s first woman astronaut",
                                "english": "the world’s first woman astronaut"
                            }
