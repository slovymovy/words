                "senses": [
                    {
                        "sense_id": "05a250d9-b086-33c5-a2f6-997217f17790",
                        "entry_id": "b2acd0e8-0762-39aa-8b11-929e380d9990",
                        "glosses": [
                            "jährlich am 8. August gefeierter internationaler Tag der Katze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1855241-1315-41d3-87fb-f8f83eddb15d",
                                "sense_id": "05a250d9-b086-33c5-a2f6-997217f17790",
                                "text": "„Der achte August ist Weltkatzentag – als ob nicht ohnehin jeder Tag ihr Ehrentag wäre, wie die meisten Katzenhalter bestätigen können.“"
                            },
                            {
                                "example_id": "b4c71c87-eb5c-404e-8162-af68445084a2",
                                "sense_id": "05a250d9-b086-33c5-a2f6-997217f17790",
                                "text": "„Und gerade deshalb muss man sich fragen: Wieso wird regelmäßig am 8. August Weltkatzentag gefeiert?“"
                            },
                            {
                                "example_id": "9bb828d8-3a35-4d80-9807-90b7c5a3bfb9",
                                "sense_id": "05a250d9-b086-33c5-a2f6-997217f17790",
                                "text": "„Der Weltkatzentag wurde im Jahr 2002 vom ‚International Fund for Animal Welfare‘ (IFAW) eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
