                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f99a6ca-1d0f-4876-bb99-ac349a7e5647",
                                "sense_id": "837ce45d-c1ee-3cbc-92fa-f5bbbdb7f385",
                                "text": "Die Sporthalle hat nur einen kleinen Umkleideraum."
                            },
                            {
                                "example_id": "0faf3f34-dca7-4883-ab8a-2b355e0969d0",
                                "sense_id": "837ce45d-c1ee-3cbc-92fa-f5bbbdb7f385",
                                "text": "Wertgegenstände sollten nicht im Umkleideraum gelassen werden."
                            },
                            {
                                "example_id": "7fe367b2-897d-4fd6-81dc-40a9e1af95ae",
                                "sense_id": "837ce45d-c1ee-3cbc-92fa-f5bbbdb7f385",
                                "text": "„Loos hatte sich für einen Umkleideraum im Reich des Herrn dos Santos entschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f78370a7-00e9-450b-9e70-fc89bd7d2eef",
