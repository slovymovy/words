                        "examples": [
                            {
                                "example_id": "fc6b4da3-653f-435d-beef-58904dd96619",
                                "sense_id": "3e9c5a9c-137a-3b51-8c9e-b3dbbbc673dd",
                                "text": "De zemstvo — een lokale bestuursorganisatie met gekozen afgevaardigden uit de gelederen van de boeren en de landeigenaren die na het afschaffen van de lijfeigenschap in 1861 in het leven werd geroepen — hield zich vooral bezig met wegenaanleg en de bouw van ziekenhuizen en scholen."
                            },
                            {
                                "example_id": "32a74a00-9e61-4ab9-b654-8ae1e638d1ef",
                                "sense_id": "3e9c5a9c-137a-3b51-8c9e-b3dbbbc673dd",
                                "text": "Volgens de directeur van de stichting Protestants Christelijk Onderwijs Noordoost Twente, de bestuursorganisatie waaronder De Huve ressorteert, leidt de bouw van topsporthal IISPA in Almelo regelmatig tot contacten met ouders die op zoek zijn naar een basisschool die rekening houdt met de sportambities van hun kind."
                            }
                        ]
                    }
