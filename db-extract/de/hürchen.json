                "senses": [
                    {
                        "sense_id": "a0f8697d-a14b-3ea1-8158-d8539ee53583",
                        "entry_id": "8295be48-1c97-34f6-ba3f-10d4bb4faf9f",
                        "glosses": [
                            "abwertend für weibliche Prostituierte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1af8c56b-f90a-4eb7-a913-740ad2450c59",
                                "sense_id": "a0f8697d-a14b-3ea1-8158-d8539ee53583",
                                "text": "„Ein […] krummes Gäßchen, mit niedrigen Türchen,",
                                "translation": "Mit steilen Treppchen und feilen Hürchen“"
                            },
                            {
                                "example_id": "a842132e-73e5-4ad5-af73-9a8a43149d63",
                                "sense_id": "a0f8697d-a14b-3ea1-8158-d8539ee53583",
                                "text": "„Es wurde kein Spaziergang, auch wenn das darüber geschriebene Buch so hieß, sondern ein Gewaltmarsch, ein Abenteuer mit Spelunken, Hürchen und Räuberpistolen - fingerfertig erzählten und handgreiflich auf die Brust gesetzten.“"
                            },
                            {
                                "example_id": "a7584011-441c-49a0-ab1e-83e5e885cd39",
                                "sense_id": "a0f8697d-a14b-3ea1-8158-d8539ee53583",
                                "text": "„Er hätte es ihnen so beibringen sollen, daß sie später einem mittleren Hürchen gewachsen gewesen wären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
