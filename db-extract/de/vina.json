                "senses": [
                    {
                        "sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                        "entry_id": "8d266ef7-87b5-3953-ba35-9aa06c1ee8f0",
                        "glosses": [
                            "das fünfseitige, zitherähnliche, klassische Zupfinstrument Nordindiens mit 2 hohlen Kürbissen als Resonanzkörper an den beiden Enden des Instrumentes; die Vina wird mit einem Metallring angerissen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "6964c7d7-d299-4a24-a492-e8b17cea91ab",
                                "sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                                "text": "„Anscheinend bereits im Mittelalter entwickelte auch Indien seine Notenschrift auf der Basis eines entsprechenden Systems. Das ganze System wird an der Vina entwickelt und ist daher wohl aus der Praxis dieses Instrumentes heraus entstanden.“"
                            },
                            {
                                "example_id": "4f96f9cf-3c07-40b9-9439-3e69b07ca2d6",
                                "sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                                "text": "Das Hindumädchen spielte die Vina sehr schön."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e0a2d53-c255-4741-90ee-b18a522e849b",
                        "source_entry_id": "8d266ef7-87b5-3953-ba35-9aa06c1ee8f0",
                        "source_sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                        "target_lang_word": "veena",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50d2ed0d-15af-3c05-9b54-42f500ee440e",
                                        "entry_id": "d5d84404-b18d-3f8e-be04-fd6b66f46cc0",
                                        "glosses": [
                                            "A plucked stringed instrument with five or seven steel strings stretched on a long fretted finger-board over two gourds, used mostly in Carnatic Indian classical music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff879dda-ba54-455f-841f-89a885b11a0d",
                                                "sense_id": "50d2ed0d-15af-3c05-9b54-42f500ee440e",
                                                "text": "When he wanted to test any of the principles he was enunciating or elucidating, he went over to the veena which sits in a glass case now and played for hours and substantially extended the vocabulary and scope of the instrument."
                                            },
                                            {
                                                "example_id": "4907dbff-71ad-472d-bbe2-dd7c4ac45cfe",
                                                "sense_id": "50d2ed0d-15af-3c05-9b54-42f500ee440e",
                                                "text": "Shanmugavadivu continued to earn her income through her veena performances, and by introducing her daughters to the stage as soon as they were able."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8313c834-f130-4cbb-9f28-4bf31b25c137",
                        "source_entry_id": "8d266ef7-87b5-3953-ba35-9aa06c1ee8f0",
                        "source_sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                        "target_lang_word": "vînâ",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vînâ",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbbaa7a8-745b-3aa5-8aa9-231671ab2c5a",
                                        "entry_id": "ab22f092-653b-3a1a-8272-bcc792250b07",
                                        "glosses": [
                                            "Famille d’instruments à cordes indiens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39366d82-8b43-3fc1-9f01-e5613fa0796d",
                                        "entry_id": "ab22f092-653b-3a1a-8272-bcc792250b07",
                                        "glosses": [
                                            "Un instrument de cette famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "357ec88a-49fc-461a-a6d0-baf6d950e600",
                                                "sense_id": "39366d82-8b43-3fc1-9f01-e5613fa0796d",
                                                "text": "D’ordinaire, chaque famille accomplit ce rituel au sein de son foyer mais le matériel est cette fois réuni dans la salle de classe, près d’un tableau de la déité à quatre bras, assise en lotus, en train de jouer de la vînâ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fbcd06e-4ef4-4c27-a08d-33867ee4164b",
                        "source_entry_id": "8d266ef7-87b5-3953-ba35-9aa06c1ee8f0",
                        "source_sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                        "target_lang_word": "ヴィーナ",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c08e9027-98f7-40d0-8f3b-41f96ca94c82",
                        "source_entry_id": "8d266ef7-87b5-3953-ba35-9aa06c1ee8f0",
                        "source_sense_id": "1ae55440-b636-3006-bcaf-dd525d262c4b",
                        "target_lang_word": "вина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fff2404f-f5bd-31b3-8a57-44dcbe9a8937",
                                        "entry_id": "b2cd1d59-12b9-3f60-a583-eb297d49456b",
                                        "glosses": [
                                            "причастность к совершению проступка, преступления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfcce9a5-cb89-4ab1-afb9-aeb0adb69d74",
                                                "sense_id": "fff2404f-f5bd-31b3-8a57-44dcbe9a8937",
                                                "text": "Он не сумел приготовить своё лицо к тому положению, в которое он становился пред женой после открытия его вины."
                                            },
                                            {
                                                "example_id": "ffb42667-ff5f-428b-9a13-e569e5fb4091",
                                                "sense_id": "fff2404f-f5bd-31b3-8a57-44dcbe9a8937",
                                                "text": "Во время следствия арестант признавал свою вину и в красках описывал все детали преступления."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689b39fb-0c8a-358c-94c3-dca6be3ea7cd",
                                        "entry_id": "b2cd1d59-12b9-3f60-a583-eb297d49456b",
                                        "glosses": [
                                            "ответственность за совершение предосудительного деяния"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b188b919-cd06-437c-ad56-ee4fa4f0e244",
                                                "sense_id": "689b39fb-0c8a-358c-94c3-dca6be3ea7cd",
                                                "text": "Не чувствовать за собой вины."
                                            },
                                            {
                                                "example_id": "99ac173c-9dec-4924-9ed1-6f0f74963880",
                                                "sense_id": "689b39fb-0c8a-358c-94c3-dca6be3ea7cd",
                                                "text": "Если хватались, всю вину валили на прислугу Сашу ― Саша не исключение, конечно, подворовывала, но сказать Саше боялись, а выговорить не смели ― не прежнее время!"
                                            },
                                            {
                                                "example_id": "547e864d-b3b3-40aa-ab85-d10e5f0c8447",
                                                "sense_id": "689b39fb-0c8a-358c-94c3-dca6be3ea7cd",
                                                "text": "Он справедливо не снимал с них вины, но и не переваливал всю вину только на их плечи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c1a7a1d-f8f4-3791-93a4-61e3e271a473",
                                        "entry_id": "b2cd1d59-12b9-3f60-a583-eb297d49456b",
                                        "glosses": [
                                            "причина чего-либо"
                                        ],
                                        "tags": [
                                            "в твор. п., в знач. сказуемого, часто с гл. быть, стать"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
