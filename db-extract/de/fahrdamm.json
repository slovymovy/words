                    {
                        "form_id": "59bbff5e-1bb2-471e-877b-12bce57dab3e",
                        "entry_id": "53373f93-01e3-3c7c-be06-78bda64d083c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fahrdämme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4298686c-9ba6-3327-abf6-2472b716a302",
                        "entry_id": "53373f93-01e3-3c7c-be06-78bda64d083c",
                        "glosses": [
                            "aufgeschütteter Damm für eine Verkehrsverbindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bdbaeed-b428-4050-aadb-d2f3870521b6",
                                "sense_id": "4298686c-9ba6-3327-abf6-2472b716a302",
                                "text": "„Ein 15 m breiter Fahrdamm führt zur neu aufgeschütteten Hafenhalbinsel Port Taufiq.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "92294ebe-d9c3-3d31-8274-621af104c7f8",
                        "entry_id": "53373f93-01e3-3c7c-be06-78bda64d083c",
                        "glosses": [
                            "norddeutsch: der Bereich eines Verkehrswegs, der den Fahrzeugen vorbehalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b975dd5e-ee97-4c1d-9c73-d4d0106f2309",
                                "sense_id": "92294ebe-d9c3-3d31-8274-621af104c7f8",
                                "text": "„Es war die Lea Bertini, die ihren Kindern erst spät erlaubt hatte, allein den Fahrdamm zu passieren, und die sie jahrelang zur Schule hatte bringen und von dort abholen lassen.“"
                            },
                            {
                                "example_id": "36d38cea-5a10-4975-b2d9-0dd7d7b0f3bb",
                                "sense_id": "92294ebe-d9c3-3d31-8274-621af104c7f8",
                                "text": "„Sie entschied, wann es ratsam war, den Fahrdamm zu betreten.“"
                            },
                            {
                                "example_id": "c81b43d1-9bdb-43a8-bada-8eb1ea0e6545",
                                "sense_id": "92294ebe-d9c3-3d31-8274-621af104c7f8",
                                "text": "„Die Heerstraße von Smolensk nach Moskau besaß eine gehörige Breite, hatte in der Mitte einen festen Fahrdamm für die Kanonen, daneben marschierte auf birkenumsäumter Chaussee das Fußvolk.“"
                            },
                            {
                                "example_id": "83c6bc94-4c1f-440c-b6d1-8ed8871ead03",
                                "sense_id": "92294ebe-d9c3-3d31-8274-621af104c7f8",
                                "text": "„Einige Bäume – nämlich solche, die sich zu weit über den Fahrdamm neigten – hatten weiße Stämme.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f1f6d0-3cd2-4b8d-9410-50ea77f0619b",
                        "source_entry_id": "53373f93-01e3-3c7c-be06-78bda64d083c",
                        "source_sense_id": "4298686c-9ba6-3327-abf6-2472b716a302",
                        "source_sense_description": "aufgeschütteter Damm für eine Verkehrsverbindung",
                        "target_lang_word": "causeway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "causeway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97a33ef4-0957-3bde-bf75-13f5004a62ae",
                                        "entry_id": "5191b429-38df-37be-9b33-1a2dadde46fd",
                                        "glosses": [
                                            "A road that is raised so as to be above water, marshland, and similar low-lying obstacles, which in some cases may flood periodically (e.g. due to tides). Originally causeways were much like dykes, generally pierced to let water through, whereas many modern causeways are more like bridges or viaducts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c03bfcb-c739-4765-8fd9-6cb724b00ebf",
                                                "sense_id": "97a33ef4-0957-3bde-bf75-13f5004a62ae",
                                                "text": "1836, Account of the Old Bridge at Stratford-le-Bow in Essex from Alfred Burges, Esq. addressed to Sir Henry Ellis https://archive.org/details/archaeologiaorm01londgoog\n. . .the passage over the water of the Luye at Stratford atte Bowe, anciently used to be in a certain place which is called the Old Forde, which is distant from the place where the bridges and causeway now are nearly one mile, at which passage many persons passing over it at divers times were drowned, and in great danger, and when after so much danger came to the knowledge of Lady Matilda, Queen of England […]"
                                            },
                                            {
                                                "example_id": "7f269fe5-978f-4e13-8241-dd8b3eeb7e12",
                                                "sense_id": "97a33ef4-0957-3bde-bf75-13f5004a62ae",
                                                "text": "Throughout the parish are ancient causeways paved with irregular slabs of local marble, and in some places the outline of the fossils of small snails can be seen in the stone. The causeways were laid as hard paths for heavily laden pack-animals bringing in wool from outlying hamlets and farms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "causeway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5650b60-016e-37f9-8a58-7b5ac13f6794",
                                        "entry_id": "ab609cb1-565f-32fe-99c3-16b77447eba6",
                                        "glosses": [
                                            "To pave, to cobble."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14aaff3b-2a35-4c1c-a167-01c2b72046db",
                                                "sense_id": "b5650b60-016e-37f9-8a58-7b5ac13f6794",
                                                "text": "In thus limiting his judgment, I understand that he has not pronounced any opinion in regard to the formation and causewaying of streets […]"
                                            },
                                            {
                                                "example_id": "a01d5078-c3a4-4e30-9fb4-df8535571ed0",
                                                "sense_id": "b5650b60-016e-37f9-8a58-7b5ac13f6794",
                                                "text": "The Glasgow Town Council decided at their last meeting to causeway the following streets at the respective costs given […]"
                                            },
                                            {
                                                "example_id": "581ef1d8-10e4-4c5e-89ce-7e24fcd5eae9",
                                                "sense_id": "b5650b60-016e-37f9-8a58-7b5ac13f6794",
                                                "text": "There had been a previous partial allocation, but the final allocation was made in 1875; and the whole sums payable by the owners of the streets for paving and causewaying them, as resolved upon by the Commissioners, have been duly paid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
