                ],
                "senses": [
                    {
                        "sense_id": "a9efb125-70ed-3c56-aa00-7d6c37b10b6d",
                        "entry_id": "6b176354-e73b-314d-922d-c30607943040",
                        "glosses": [
                            "Leiterin von Gottesdiensten mit Ausnahme von Eucharistiefeiern (Messen)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9219c950-d230-4f37-8d33-ba8d2537c8b3",
                                "sense_id": "a9efb125-70ed-3c56-aa00-7d6c37b10b6d",
                                "text": "„Heilige, so die Gottesdienstbeauftragte weiter, waren zu Lebzeiten ‚zu hundert Prozent Alltagsmenschen‘ wie wir.“"
                            },
                            {
                                "example_id": "d7b00fcf-7e8e-47b2-a4a1-be8932a5a42a",
                                "sense_id": "a9efb125-70ed-3c56-aa00-7d6c37b10b6d",
                                "text": "„Das könnte ein ‚Auftragsdiebstahl‘ gewesen sein, mutmaßt die Gottesdienstbeauftragte.“"
                            },
                            {
                                "example_id": "35f1b48e-c139-4e00-8fd7-86d0e0bf1466",
                                "sense_id": "a9efb125-70ed-3c56-aa00-7d6c37b10b6d",
                                "text": "„Die Leitung haben die Gottesdienstbeauftragte Sabine Schilling für die katholische, Pastor Jörg Möller-Ehmcke für die evangelische Gemeinde, und in der Vorbereitung engagieren sich ehrenamtliche Helferinnen und professionelle Pflegekräfte, sowie Mitglieder der AG-Demenz in Bad Bramstedt.“"
                            },
                            {
                                "example_id": "10ae2da5-411b-48c1-b51f-c2621237e5a6",
                                "sense_id": "a9efb125-70ed-3c56-aa00-7d6c37b10b6d",
                                "text": "„‚Ich möchte für die Gemeinde da sein und sie unterstützen, wo ich kann‘, erläutert die Fachbereichsleiterin Fremdsprachen bei der Offenbacher Volkshochschule ihre Motivation, nun auch noch die Ausbildung zur Gottesdienstbeauftragten gemacht zu haben.“"
                            },
                            {
                                "example_id": "175e7460-dc5b-4078-a0ec-d85681a59f99",
                                "sense_id": "a9efb125-70ed-3c56-aa00-7d6c37b10b6d",
                                "text": "„Die Gottesdienstbeauftragte sah sich plötzlich vor die Aufgabe gestellt, eine Wort-Gottes-Feier ‚aus dem Hut zu zaubern‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
