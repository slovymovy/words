            "senses": [
                {
                    "sense_id": "974010c1-9f82-34ae-82f6-06a36cf478e2",
                    "sense_definition": "Successful, flourishing, or prospering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city has a <w>thriving</w> economy thanks to new businesses.",
                            "target_lang_translations": {
                                "ru": "У города <w>процветающая</w> экономика благодаря новым предприятиям."
                            }
                        },
                        {
                            "text": "She runs a <w>thriving</w> bakery in the center of town.",
                            "target_lang_translations": {
                                "ru": "Она управляет <w>процветающей</w> пекарней в центре города."
                            }
