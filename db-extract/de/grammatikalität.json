                                "target_senses": [
                                    {
                                        "sense_id": "25a98627-61ce-3ec0-bed3-b5eb89c58378",
                                        "entry_id": "52581740-1e85-3c9f-9304-6b0d7a3d22b3",
                                        "glosses": [
                                            "(of language) The state or attribute of obeying the rules of grammar (being grammatical)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e78eb2a-c8d3-46fd-b705-52b0e96b625e",
                                                "sense_id": "25a98627-61ce-3ec0-bed3-b5eb89c58378",
                                                "text": "One cannot consistently judge the grammaticality of utterances without knowing what grammatical types their constituent morphemes represent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6669555f-88c7-405c-a0d8-61d36544d346",
                        "source_entry_id": "8117f343-3045-387e-b755-ab90c4729010",
                        "source_sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                        "target_lang_word": "grammaticalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammaticalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddb26af-877a-3f52-8a01-54e19511f23a",
                                        "entry_id": "ac970ba5-f9a0-315f-a3e6-845a9bd0937a",
                                        "glosses": [
                                            "Qualité de ce qui respecte les règles de production d’un énoncé propres à une langue donnée. La grammaticalité est jugée seulement par la construction tandis que l’acceptabilité est jugée aussi par le sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cf949c2-3607-4d7f-a739-1dc6278cfd93",
                                                "sense_id": "4ddb26af-877a-3f52-8a01-54e19511f23a",
                                                "text": "Dans une perspective fonctionnelle, il est évident que les jugements introspectifs au sujet de la grammaticalité de phrases dépouillées de tout contexte ne constituent pas une base adéquate pour l’analyse linguistique."
                                            }
                                        ]
                                    }
                                ]
                            }
