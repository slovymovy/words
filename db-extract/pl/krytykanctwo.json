                        "source_sense_id": "e544cc06-c9d7-3587-b496-1c7862419516",
                        "target_lang_word": "критиканство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "критиканство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a86afd81-0fb2-3001-b7c8-e152da086a38",
                                        "entry_id": "6f5b7694-7ad7-3220-8de1-b4436eeb0c39",
                                        "glosses": [
                                            "неодобр. придирчивая, но поверхностная и пристрастная критика"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1bf7f3b-e447-42f1-bca9-e7626d2f8f21",
                                                "sense_id": "a86afd81-0fb2-3001-b7c8-e152da086a38",
                                                "text": "Что это я вдаюсь сегодня в критиканство?"
                                            },
                                            {
                                                "example_id": "08b2c7bd-d2ad-4e4e-be73-9c5ebeaeda72",
                                                "sense_id": "a86afd81-0fb2-3001-b7c8-e152da086a38",
                                                "text": "Меня в тот раз просто выгнали из кабинета, расценив мои доводы как мелкое критиканство и неумение видеть главное."
                                            },
                                            {
                                                "example_id": "16ec010c-161c-49b6-afbc-3b698414abfa",
                                                "sense_id": "a86afd81-0fb2-3001-b7c8-e152da086a38",
                                                "text": "… «Фабричную девчонку» ругали за очернительство, критиканство и искажение действительности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f724d20d-a59e-385a-bb5d-10345ee5811a",
                                        "entry_id": "6f5b7694-7ad7-3220-8de1-b4436eeb0c39",
                                        "glosses": [
                                            "свойство критикана"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f1af2c-9d7e-4f3b-b7d1-6649a8146857",
                                                "sense_id": "f724d20d-a59e-385a-bb5d-10345ee5811a",
                                                "text": "Я полагаю, вы убеждены, что не наклонность к критиканству и не желание потешить себя заставляет меня так много писать о романе и говорить, что говорю, а желание совсем другого рода."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
