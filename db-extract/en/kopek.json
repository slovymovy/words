                                                "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                                                "text": "100 Kopeken ergeben 1 Rubel."
                                            },
                                            {
                                                "example_id": "d5f4fda4-e336-49ef-81a5-8af71d356c2f",
                                                "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                                                "text": "„Am 9. Mai kosteten Narzissen nur drei und Tulpen fünf Kopeken das Stück.“"
                                            },
                                            {
                                                "example_id": "bc6de713-fe35-490e-b299-5fe99359306d",
                                                "sense_id": "2295ee66-740d-3898-b760-a6208bc75d7e",
                                                "text": "„Ab Januar 1858 folgten dann gezähnte Briefmarken zu 10, 20 und 30 Kopeken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
