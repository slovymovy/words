                ],
                "senses": [
                    {
                        "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                        "entry_id": "9115a39f-320e-3a52-9088-2ff3dc41bf81",
                        "glosses": [
                            "Einstellung eines Geräts oder einer App, die speziell für das Training auf einem Laufband ausgelegt ist, wobei die zurückgelegte Distanz ohne GPS (meist über interne Bewegungssensoren) gemessen wird"
                        ],
                        "tags": [
                            "Laufsport",
                            "Fitness"
                        ],
                        "examples": [
                            {
                                "example_id": "3528f1e9-7e2c-44ed-83dc-90ea0826002d",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Nach Rücksprache mit einem Arbeitskollegen gab dieser mir den Tipp, ich solle doch mal den Laufbandmodus testen.“"
                            },
                            {
                                "example_id": "dd22b092-f6b3-4a4f-8c89-089a49dc9180",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Auch ein eigener Laufbandmodus ist verfügbar.“"
                            },
                            {
                                "example_id": "e8b25cc2-b94b-4213-b915-77b9c7e79e08",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Neben der Herzfrequenzmessung und den diversen daraus abzuleitenden Trainingsresultaten, bietet der TICKR X einen äussert praktischen Laufbandmodus, einen Wiederholungszähler, sowie eigens dafür konzipierte Fitness-Programme an.“"
                            },
                            {
                                "example_id": "1752a32d-f118-41a1-b30b-3f2df92da7a2",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Wer jetzt gerne noch etwas über den Laufbandmodus gelesen hätte, den muss ich leider enttäuschen, ich hasse Laufbänder und finde auch nichts affiger, als Indoor ‚auf der Stelle‘ zu laufen.“"
                            },
                            {
                                "example_id": "1bfee784-8943-4398-bf78-9e7acdc8e634",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Ohne GPS lässt sich die Uhr nur im Laufbandmodus starten, in dem Bewegungssensoren die gelaufene Strecke wesentlich ungenauer messen.“"
                            },
                            {
                                "example_id": "ed4e0025-73a0-4146-ba97-95f32e2802ed",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Multisport-Modus: Trainiere wahlweise im Lauf-, Rad-, Schwimm-, Fitness- und Laufbandmodus“"
                            },
                            {
                                "example_id": "ee83ab06-3d7e-4333-80a5-640c5006ee62",
                                "sense_id": "3b02ef26-b695-3e69-97c8-25005ee6ce8b",
                                "text": "„Als ich dann von der Rolle absteige, stoppe ich den Laufbandmodus und ziehe mich um.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
