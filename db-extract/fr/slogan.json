                                        "glosses": [
                                            "A catchphrase associated with a product or service being advertised."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "879ab4ce-d183-3fbe-ab58-b53c3d132339",
                                        "entry_id": "1e8e70a3-866f-3edb-a03d-6db14a17acd5",
                                        "glosses": [
                                            "A battle cry among the ancient Irish or highlanders of Scotland."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90f690d8-ddb7-42f0-8816-6ad4b6877c50",
                                                "sense_id": "879ab4ce-d183-3fbe-ab58-b53c3d132339",
                                                "text": "His bugle Wat of Harden blew; / Pensils and pennons wide were flung, / To heaven the Border slogan rung, / \"St Mary for the young Buccleuch!\""
                                            }
                                        ]
                                    }
                                ]
                            }
