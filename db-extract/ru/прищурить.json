                "translations": [
                    {
                        "translation_id": "5e4f8dae-6b78-4ad1-8e03-41baf40e3fc8",
                        "source_entry_id": "b7bbe1e6-f472-31c1-a3b9-5fe06b7bf73b",
                        "source_sense_id": "05ad7ae4-8586-3e6a-ab0c-93ca374e400e",
                        "target_lang_word": "cligner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cligner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf5da84e-0e78-3102-9d97-a38906623875",
                                        "entry_id": "4aa0a4a2-a7b9-32f2-946b-4a7378750603",
                                        "glosses": [
                                            "Fermer les yeux à demi pour diminuer l’impression d’une lumière trop vive, pour considérer des objets très petits ou éloignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b63c8964-8764-4052-8b42-b23b7aacd3d7",
                                                "sense_id": "cf5da84e-0e78-3102-9d97-a38906623875",
                                                "text": "Et King avait les yeux fixés sur ceux de Bullit et comme il avait le gauche un peu plus rétréci et fendu que le droit, il semblait en cligner."
                                            },
                                            {
                                                "example_id": "8a761606-23ef-49c9-bfe1-ada408185785",
                                                "sense_id": "cf5da84e-0e78-3102-9d97-a38906623875",
                                                "text": "Le batcha n’osait plus cligner des paupières. Il lui semblait que leur plus rapide et léger battement ferait disparaître ce spectacle, ce rêve…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d71b356-dba5-3674-914b-808c0eb42447",
                                        "entry_id": "4aa0a4a2-a7b9-32f2-946b-4a7378750603",
                                        "glosses": [
                                            "Faire un signe à quelqu’un en remuant la paupière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d5a2d54-f545-48c7-bab1-1c36b96517f4",
                                                "sense_id": "7d71b356-dba5-3674-914b-808c0eb42447",
                                                "text": "Elle eut le temps de me cligner un regard qui ne fut pas perdu."
                                            },
                                            {
                                                "example_id": "a590a140-8019-4dba-b703-976fc7777c25",
                                                "sense_id": "7d71b356-dba5-3674-914b-808c0eb42447",
                                                "text": "La succession de Lénine s'ouvre de son vivant ; il finit de vivre dans un fauteuil, réduit à cligner des paupières ou bégayer pour tenter de se faire comprendre de son entourage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
