{
    "word_family": [
        "sneer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e10c9ba-5f43-3059-b4d7-418ec0304459",
                    "sense_definition": "Expressing contempt or mockery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>sneering</w> comment about their lack of experience.",
                            "target_lang_translations": {
                                "fr": "Il a fait une remarque <w>ricanante</w> sur leur manque d'expérience.",
                                "de": "Er machte einen <w>spöttischen</w> Kommentar über ihre mangelnde Erfahrung."
                            }
                        },
                        {
                            "text": "She gave him a <w>sneering</w> look that made him feel very small.",
                            "target_lang_translations": {
                                "fr": "Elle lui a lancé un regard <w>méprisant</w> qui l'a fait se sentir tout petit.",
                                "de": "Sie warf ihm einen <w>höhnischen</w> Blick zu, der ihn ganz klein fühlen ließ."
                            }
                        }
                    ],
                    "synonyms": [
                        "mocking",
                        "scornful",
                        "contemptuous"
                    ],
                    "common_phrases": [
                        "sneering comment",
                        "sneering look"
                    ],
                    "target_lang_definitions": {
                        "fr": "Qui exprime le mépris ou la moquerie.",
                        "de": "Verachtung oder Spott ausdrückend."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ricanant",
                                "target_lang_sense_clarification": "qui exprime un rire méprisant ou moqueur"
                            },
                            {
                                "target_lang_word": "méprisant",
                                "target_lang_sense_clarification": "qui manifeste du dédain"
                            },
                            {
                                "target_lang_word": "narquois",
                                "target_lang_sense_clarification": "qui exprime une moquerie ironique"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spöttisch",
                                "target_lang_sense_clarification": "voller Spott und Hohn"
                            },
                            {
                                "target_lang_word": "höhnisch",
                                "target_lang_sense_clarification": "boshaft spottend, verächtlich"
                            },
                            {
                                "target_lang_word": "verächtlich",
                                "target_lang_sense_clarification": "Verachtung zeigend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a39ab213-00c7-3f94-b0d4-7311b5de0738",
                    "sense_definition": "The act of expressing contempt or mockery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>sneerings</w> from his rivals made it hard to stay focused.",
                            "target_lang_translations": {
                                "fr": "Les <w>ricanements</w> constants de ses rivaux rendaient difficile le fait de rester concentré.",
                                "de": "Die ständigen <w>Spötteleien</w> seiner Rivalen machten es schwer, konzentriert zu bleiben."
                            }
                        },
                        {
                            "text": "He ignored the <w>sneerings</w> of the crowd and continued his speech.",
                            "target_lang_translations": {
                                "fr": "Il a ignoré les <w>moqueries</w> de la foule et a poursuivi son discours.",
                                "de": "Er ignorierte den <w>Hohn</w> der Menge und setzte seine Rede fort."
                            }
                        }
                    ],
                    "synonyms": [
                        "mockery",
                        "scorn"
                    ],
                    "target_lang_definitions": {
                        "fr": "L'acte d'exprimer du mépris ou de la moquerie.",
                        "de": "Das Äußern von Verachtung oder Spott."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ricanements",
                                "target_lang_sense_clarification": "rires moqueurs et méprisants"
                            },
                            {
                                "target_lang_word": "moqueries",
                                "target_lang_sense_clarification": "paroles ou actes destinés à ridiculiser"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "das Spotten",
                                "target_lang_sense_clarification": "das Äußern von Spott"
                            },
                            {
                                "target_lang_word": "der Hohn",
                                "target_lang_sense_clarification": "boshafter Spott"
                            },
                            {
                                "target_lang_word": "die Spöttelei",
                                "target_lang_sense_clarification": "wiederholte spöttische Bemerkungen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24bf658c-3f80-3ec7-a7f1-4b20480915d2",
                    "sense_definition": "Present participle and gerund of <w>sneer</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>sneering</w> at everyone who disagreed with his opinion.",
                            "target_lang_translations": {
                                "fr": "Il <w>ricanait</w> de tous ceux qui n'étaient pas d'accord avec son opinion.",
                                "de": "Er <w>spottete</w> über jeden, der nicht seiner Meinung war."
                            }
                        },
                        {
                            "text": "Stop <w>sneering</w> at people just because they are different from you.",
                            "target_lang_translations": {
                                "fr": "Arrête de <w>te moquer</w> des gens juste parce qu'ils sont différents de toi.",
                                "de": "Hör auf, über Leute zu <w>spotten</w>, bloß weil sie anders sind als du."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent et gérondif du verbe ricaner ou se moquer.",
                        "de": "Partizip Präsens und Gerundium von 'sneer' (höhnen, spotten)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ricanant",
                                "target_lang_sense_clarification": "en train de rire avec mépris"
                            },
                            {
                                "target_lang_word": "se moquant",
                                "target_lang_sense_clarification": "en train de tourner en dérision"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spottend",
                                "target_lang_sense_clarification": "Spott äußernd"
                            },
                            {
                                "target_lang_word": "höhnend",
                                "target_lang_sense_clarification": "boshaft lachend oder spottend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}