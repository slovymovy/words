                "senses": [
                    {
                        "sense_id": "314f5b0a-f0f7-3a11-9656-128c77aeff30",
                        "entry_id": "877ebb45-a389-327f-84f7-db9072067d7f",
                        "glosses": [
                            "dotyczący piekarnictwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd60150-cb92-4424-aaa0-22f5725c2e41",
                                "sense_id": "314f5b0a-f0f7-3a11-9656-128c77aeff30",
                                "text": "Zaprezentowane zostaną również różne produkty: mięsne, mleczarskie, piekarnicze oraz niskoalkoholowe, połączone z degustacją."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2bec8d6-f1e7-4fde-8a71-b00b61f980fe",
                        "source_entry_id": "877ebb45-a389-327f-84f7-db9072067d7f",
                        "source_sense_id": "314f5b0a-f0f7-3a11-9656-128c77aeff30",
                        "target_lang_word": "bakery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bakery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7febfcae-2e2e-3ed5-8da2-d818cb7380f5",
                                        "entry_id": "19fe76ea-9d7c-3da0-b183-6be1b0a7496d",
                                        "glosses": [
                                            "A place in which bread (and often other baked goods such as cakes) is baked and/or sold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8dac5979-c174-3854-a8c9-9f3a37af1e8f",
                                        "entry_id": "19fe76ea-9d7c-3da0-b183-6be1b0a7496d",
                                        "glosses": [
                                            "The trade of a baker."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                        "entry_id": "19fe76ea-9d7c-3da0-b183-6be1b0a7496d",
                                        "glosses": [
                                            "Baked goods."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f66c7ee-c3af-440d-896f-8ead88fb472c",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "Fresh bakery!"
                                            },
                                            {
                                                "example_id": "e9fb9e56-1866-4673-b094-a76d7cad1e8b",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "1970-1975, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nBridget & Jacob were coming home from the hospital bout 11:30. Kathy & I made a little \"brunch\" of bakery & coffee."
                                            },
                                            {
                                                "example_id": "be651a33-81ae-4309-8a36-e9b902423a86",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "Then, later, I think I saw them at Lemke's Tomahawk Foods getting roasted chicken from the delicatessen and at Nelson's County Market picking up some bakery and fruit. It looked like they were going on a picnic."
                                            },
                                            {
                                                "example_id": "ec76bf8d-7268-4d8e-a520-266648a1732f",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "She set about preparing the house for everyone to come over. She and Danielle made the sandwiches and put them in the refrigerator. They got out plates, glasses, napkins and silverware and set up a buffet table. Chuck went to the bakery and got some bakery."
                                            },
                                            {
                                                "example_id": "fd5554ca-84b7-4637-85d3-d1f099cdd023",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "Perhaps she would be able to bring me something to eat in the evening. Still it was doubtful if she could get away. I better had let her buy some bakery for me. With some inconceivable pride, or rather stubbornness, as I wanted money, I refused. In consequence, I suffered all night and the next day and the following night."
                                            },
                                            {
                                                "example_id": "20448a01-88a6-4015-a490-d3fd08c2448a",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "“The next morning I woke up and she was fast asleep. Guess I did pass out for a while. So I thought I would go surprise her, and I bought her some flowers and picked up some bakery in town. But when I got back, she wasn't in bed. […]”"
                                            },
                                            {
                                                "example_id": "4aa6f18a-fe38-4036-b79e-094f8bb96eba",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "Shen Lian thought for a moment, walked up to the table, and picked up some bakery, wine, and fruits. He then walked to the sofa in the corner of the hall and started eating without a care in the world."
                                            },
                                            {
                                                "example_id": "a921009e-5838-48cd-a85c-6c6d588114d1",
                                                "sense_id": "f796a438-aae6-3c34-953d-eb65d13b910e",
                                                "text": "- Thank you, Liza. Are you coming with me to get some fresh bakery?\n- Sure, let's go."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ab49d8-7106-325b-bcf8-2ee5fc974282",
                                        "entry_id": "19fe76ea-9d7c-3da0-b183-6be1b0a7496d",
                                        "glosses": [
                                            "A big pair of buttocks."
                                        ],
