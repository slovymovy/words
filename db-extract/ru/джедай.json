                        "cross_references": [
                            {
                                "target_word": "Jedi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f219beb-7013-37c5-8260-e86de8f790d3",
                                        "entry_id": "fb37bd88-2a8a-3e1a-b97e-46b75d6b4b7d",
                                        "glosses": [
                                            "Guerrier, gardien de la paix dans la galaxie de l’univers de Star Wars. Il maîtrise la Force et son arme de prédilection est le sabre laser."
                                        ],
                                        "tags": [
                                            "Science-fiction",
                                            "univers de Star Wars"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65606493-ca70-413b-94d1-f4b8c37d0526",
                                                "sense_id": "7f219beb-7013-37c5-8260-e86de8f790d3",
                                                "text": "C'est la voix de Luke Skywalker. Le Jedi vient tout juste de franchir une porte pour participer au briefing. Ses amis sont heureux de le revoir et les Rebelles se réjouissent d'avoir devant eux le héros de la Bataille de Yavin, […]."
                                            },
                                            {
                                                "example_id": "ce191590-49e1-45d1-99dc-555364850c9f",
                                                "sense_id": "7f219beb-7013-37c5-8260-e86de8f790d3",
                                                "text": "Vu les très grandes distances qui séparent les étoiles et les planètes, et donc les Jedis dans la galaxie, la dissémination et la divergence des midichloriens auraient pu se faire durant la « jeunesse » de l'univers."
                                            },
                                            {
                                                "example_id": "f667cd79-1359-42d1-84dd-84c921f015cc",
                                                "sense_id": "7f219beb-7013-37c5-8260-e86de8f790d3",
                                                "text": "Et Magash savait que les Jedi n'étaient soumis à personne. Les Jedi mâles étaient apparemment aussi libres de s'entraîner à la Force ou même d'enseigner son usage que les Jedi de sexe féminin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jedi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9431b9ea-157c-396f-8cf4-fcd761bbedd9",
                                        "entry_id": "bd8254eb-e7ad-3229-b1f8-e07058fa4f3b",
                                        "glosses": [
                                            "Relatif aux Jedi, à leur statut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0747ce5a-f4e4-49cc-9c26-a71f3a9bc2b3",
                                                "sense_id": "9431b9ea-157c-396f-8cf4-fcd761bbedd9",
                                                "text": "C’est un vaisseau Jedi !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
