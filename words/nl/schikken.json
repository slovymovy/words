                    "sense_id": "d4ffd41b-3e49-3c2d-8d72-ee0bc7dbee2a",
                    "sense_definition": "gelegen komen of passen wat betreft tijd of omstandigheden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "convenience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Schikt</w> het als ik morgen even langskom?",
                            "target_lang_translations": {
                                "en": "Does it <w>suit</w> you if I drop by tomorrow?"
                            }
                        },
                        {
                            "text": "Laat me weten of die tijd je <w>schikt</w> voor onze afspraak.",
                            "target_lang_translations": {
                                "en": "Let me know if that time <w>is convenient</w> for our appointment."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitkomen",
                        "passen"
                    ],
                    "common_phrases": [
                        "als het schikt"
                    ],
                    "target_lang_definitions": {
                        "en": "to be convenient or appropriate regarding time or circumstances"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suit",
                                "target_lang_sense_clarification": "to be convenient for someone"
                            },
                            {
                                "target_lang_word": "be convenient",
                                "target_lang_sense_clarification": "to fit into a schedule"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b4bdfc1-18d7-3883-947a-1684bab1a9da",
                    "sense_definition": "dingen in een bepaalde, vaak nette of aantrekkelijke volgorde plaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arrangement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bloemen waren prachtig in de vaas <w>geschikt</w>.",
                            "target_lang_translations": {
                                "en": "The flowers were beautifully <w>arranged</w> in the vase."
                            }
                        },
                        {
                            "text": "Zij begon de boeken op de plank te <w>schikken</w> op kleur.",
                            "target_lang_translations": {
                                "en": "She started to <w>organize</w> the books on the shelf by color."
                            }
                        }
                    ],
                    "synonyms": [
