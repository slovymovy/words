                                        "sense_id": "d0a5cdab-88f6-329d-a1f3-694046e8a360",
                                        "entry_id": "ef955d07-ace6-3743-bd35-22fc2da7331e",
                                        "glosses": [
                                            "A long stick with a sharp tip used as a weapon for throwing or thrusting, or anything used to make a thrusting motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daacb2a9-f08f-4bcb-8800-7cb3d0270309",
                                                "sense_id": "d0a5cdab-88f6-329d-a1f3-694046e8a360",
                                                "text": "It's not like you killed someone\nIt's not like you drove a spiteful spear into his side\nTalk to Jesus Christ as if he knows the reasons why\nHe did it all for you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a59384e8-42b7-3a14-9870-834dd8080bca",
                                        "entry_id": "ef955d07-ace6-3743-bd35-22fc2da7331e",
                                        "glosses": [
                                            "A soldier armed with such a weapon; a spearman."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5214d5-55ed-46a2-98ff-6e8dfab8f176",
                                                "sense_id": "a59384e8-42b7-3a14-9870-834dd8080bca",
                                                "text": "Now toil'd the Bruce, the battle done ,\nTo use his conquest boldly won;\nAnd gave command for horse and spear\nTo press the Southron's scatter'd rear"
                                            },
                                            {
                                                "example_id": "6681d83e-fba5-4ec4-9268-6dd90cd1d7ca",
                                                "sense_id": "a59384e8-42b7-3a14-9870-834dd8080bca",
                                                "text": "Two of the four spears came directly from Lady Margaret's staff. One was her great-nephew Maurice St John […]."
                                            }
                                        ]
                                    },
