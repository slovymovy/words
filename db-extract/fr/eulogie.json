                    {
                        "sense_id": "ea1c1054-72e3-3f7b-9618-63afacf2e7df",
                        "entry_id": "f438d217-5f40-3f74-a795-01b3e8d68b10",
                        "glosses": [
                            "Formule, phrase de bénédiction ou de louange prononcée après un nom ou une prière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e939d8e1-9f50-4843-92b2-ecd9a843e2d0",
                                "sense_id": "ea1c1054-72e3-3f7b-9618-63afacf2e7df",
                                "text": "Les musulmans pieux ont l’habitude, lorsqu'ils citent le nom du prophète Mohammed, de le faire suivre par la phrase d’eulogie suivante : « que la bénédiction et la paix de Dieu soient sur lui »."
                            },
                            {
                                "example_id": "2ea66c7c-6881-4e6c-bdc0-ecb9aafb8f1c",
                                "sense_id": "ea1c1054-72e3-3f7b-9618-63afacf2e7df",
                                "text": "Le nom des pharaons était suivi d’une eulogie comme : « qu'il soit vivant à jamais »."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc8170e5-db32-32db-b091-3fd13853bf78",
                        "entry_id": "f438d217-5f40-3f74-a795-01b3e8d68b10",
                        "glosses": [
                            "Objet ayant fait l’objet d’une bénédiction."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "414a3c1a-5f65-39ec-8153-e4960023ca8b",
                        "entry_id": "f438d217-5f40-3f74-a795-01b3e8d68b10",
                        "glosses": [
                            "Objet ayant fait l’objet d’une bénédiction.",
                            "Offrande de pain bénit chez les catholiques."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05b47278-25dd-31e1-924e-5fd8d185450c",
                        "entry_id": "f438d217-5f40-3f74-a795-01b3e8d68b10",
                        "glosses": [
                            "Objet ayant fait l’objet d’une bénédiction.",
                            "Eau ou huile bénite ramenée en souvenir d’un lieu de pèlerinage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f88345c-76b9-48f9-8d18-0956f0b47972",
                                "sense_id": "05b47278-25dd-31e1-924e-5fd8d185450c",
                                "text": "Des petites fioles en terre cuite appelées ampoules à eulogie étaient destinées à recevoir de l’huile des lampes ou de l’eau bénite du sanctuaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1693fcb-73ee-3895-8e10-be88d2e67da3",
                        "entry_id": "f438d217-5f40-3f74-a795-01b3e8d68b10",
                        "glosses": [
                            "Objet ayant fait l’objet d’une bénédiction.",
                            "Miettes du pain eucharistique, dans ce sens est toujours au pluriel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a58a3e-e12e-4cc3-b4b6-335e2c8e2427",
                                "sense_id": "d1693fcb-73ee-3895-8e10-be88d2e67da3",
                                "text": "Après l’eucharistie, les eulogies sont ramassées pour être données aux fidèles."
                            }
                        ]
                    }
