                        "cross_references": [
                            {
                                "target_word": "species",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb20129-c65e-38fb-b826-6fef54bc3ec0",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "A type or kind. (Compare race.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dee794-fcd9-4035-9296-bdfd8cab36ea",
                                                "sense_id": "9bb20129-c65e-38fb-b826-6fef54bc3ec0",
                                                "text": "the male species"
                                            },
                                            {
                                                "example_id": "922a341d-d441-487e-b429-ceaf161c0069",
                                                "sense_id": "9bb20129-c65e-38fb-b826-6fef54bc3ec0",
                                                "text": "a new species of war"
                                            },
                                            {
                                                "example_id": "5c7a0968-e12d-4853-91b8-b9edd578c0e5",
                                                "sense_id": "9bb20129-c65e-38fb-b826-6fef54bc3ec0",
                                                "text": "What is called spiritualism should, I think, be called a mental species of materialism."
                                            },
                                            {
                                                "example_id": "9b4b9d37-0844-4e30-96db-0bf52fd9ef7d",
                                                "sense_id": "9bb20129-c65e-38fb-b826-6fef54bc3ec0",
                                                "text": "He went on kissing her with unflagging industry, while she remained limply in his arms, in a species of satisfied trance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aedf0eb-eba2-3d8f-ba69-3e64b6440d33",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "A type or kind. (Compare race.)",
                                            "A group of plants or animals in which any two individuals of the appropriate sexes or mating types can produce fertile offspring, typically by sexual reproduction, usually having similar appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638f00fe-9134-4e29-b0fa-1e51aaca1bb7",
                                                "sense_id": "3aedf0eb-eba2-3d8f-ba69-3e64b6440d33",
                                                "text": "This species of animal is unique to the area."
                                            },
                                            {
                                                "example_id": "6039610b-f2d7-4052-8a22-a7686b0416ac",
                                                "sense_id": "3aedf0eb-eba2-3d8f-ba69-3e64b6440d33",
                                                "text": "Louise felt raised above her species; a voice had spoken within her inmost soul, whose revealings were vouchsafed but to the chosen few; and what had been indifference, was now disdain."
                                            },
                                            {
                                                "example_id": "4e750910-b392-43c1-94cc-6315b0383466",
                                                "sense_id": "3aedf0eb-eba2-3d8f-ba69-3e64b6440d33",
                                                "text": "We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water."
                                            },
                                            {
                                                "example_id": "9adb0c5a-7799-43b0-9255-d16d8145b7d7",
                                                "sense_id": "3aedf0eb-eba2-3d8f-ba69-3e64b6440d33",
                                                "text": "Westerlund News Reporter Khalisah Bint Sinan al-Jilani reached out recently to her viewers with a wartime plea for unity and cooperation among all galactic species.\nUPDATED\nHer sincerity touched extranet viewers and donations for war relief efforts are pouring in, both to the Alliance and its alien allies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7794c91-6d1d-3029-94d7-87d8cbad64e1",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "A type or kind. (Compare race.)",
                                            "A category in the classification of organisms, ranking below genus; a taxon at that rank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f498c31-43ac-4b22-a95e-61a89c693a00",
                                                "sense_id": "c7794c91-6d1d-3029-94d7-87d8cbad64e1",
                                                "text": "Hence, in determining whether a form should be ranked as a species or a variety, the opinion of naturalists having sound judgment and wide experience seems the only guide to follow."
                                            },
                                            {
                                                "example_id": "e84a2f5a-3c97-41ab-a225-67593188574c",
                                                "sense_id": "c7794c91-6d1d-3029-94d7-87d8cbad64e1",
                                                "text": "Firstly, I continue to base most species treatments on personally collected material, rather than on herbarium plants."
                                            },
                                            {
                                                "example_id": "c6a66a11-f854-4a72-8f40-48308bfc22f7",
                                                "sense_id": "c7794c91-6d1d-3029-94d7-87d8cbad64e1",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b6c8d59-a664-37ab-8700-a225874ac453",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "A type or kind. (Compare race.)",
                                            "A particular type of atom, molecule, ion or other particle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c1659bd-57ab-35e9-8406-fe2cebf421d9",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "A type or kind. (Compare race.)",
                                            "A mineral with a unique chemical formula whose crystals belong to a unique crystallographic system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94bf4cfb-9d28-3f68-bd93-1453347f6b18",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "An image, an appearance, a spectacle.",
                                            "The image of something cast on a surface, or reflected from a surface, or refracted through a lens or telescope; a reflection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b17a1d8-d8b8-468d-a8ae-5a514331ff28",
                                                "sense_id": "94bf4cfb-9d28-3f68-bd93-1453347f6b18",
                                                "text": "I cast the species of the Sun onto a sheet of paper through a telescope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ffae8d-962f-397e-88da-c07f7db86a5a",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "An image, an appearance, a spectacle.",
                                            "Visible or perceptible presentation; appearance; something perceived."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d1fd4b5-b5d2-4667-bbc5-4648a3521e5c",
                                                "sense_id": "82ffae8d-962f-397e-88da-c07f7db86a5a",
                                                "text": "Wit,[…]the faculty of imagination in the writer, which searches over all the memory for the species or ideas of those things which it designs to represent."
                                            },
                                            {
                                                "example_id": "48e26dab-cfbd-4e26-9af3-00367a268be5",
                                                "sense_id": "82ffae8d-962f-397e-88da-c07f7db86a5a",
                                                "text": "the species of the letters illuminated with indigo and violet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e63ad369-f9bc-3839-8552-e2096cd8f572",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "Either of the two elements of the Eucharist after they have been consecrated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d5c8ffc0-c3e3-3413-a1ba-5270e1417f79",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "Coin, or coined silver, gold, or other metal, used as a circulating medium; specie."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91156345-48ea-4c65-a42e-120e5ff46f6d",
                                                "sense_id": "d5c8ffc0-c3e3-3413-a1ba-5270e1417f79",
                                                "text": "There was, in the splendour of the Roman empire, a less quantity of current species in Europe than there is now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c80f023-fcb8-33d5-b118-f3ab28074ee6",
                                        "entry_id": "521f5d32-7617-3f6d-9702-3131d6ab3e43",
                                        "glosses": [
                                            "A component part of compound medicine; a simple."
                                        ],
                                        "tags": [
