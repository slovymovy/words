    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea45507b-20c0-3bad-b25b-8e27ac20c8cf",
                    "sense_definition": "Small in amount or effect; barely meeting a standard or requirement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The improvement in his test scores was <w>marginal</w> at best.",
                            "target_lang_translations": {
                                "ru": "Улучшение его результатов теста было в лучшем случае <w>незначительным</w>."
                            }
                        },
                        {
                            "text": "The pilots struggled to land the plane in <w>marginal</w> weather conditions.",
                            "target_lang_translations": {
                                "ru": "Пилоты с трудом посадили самолет в <w>предельных</w> погодных условиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "slight",
                        "minimal",
                        "negligible"
                    ],
                    "antonyms": [
                        "significant",
                        "substantial"
                    ],
                    "common_phrases": [
                        "marginal weather conditions",
                        "marginal improvement",
                        "marginal difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный по количеству или эффекту; едва соответствующий стандарту или требованию."
