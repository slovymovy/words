                "senses": [
                    {
                        "sense_id": "c8fea6f4-6e85-3764-890f-8b4f5b4e4240",
                        "entry_id": "ea205998-8019-3f03-bdc9-50676de1c0b4",
                        "glosses": [
                            "Mincir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec21ae2-8652-474c-83ff-96f983bccc9d",
                                "sense_id": "c8fea6f4-6e85-3764-890f-8b4f5b4e4240",
                                "text": "Pour remincir, après une césarienne, ma fille a fait un régime alimentaire strict et de la gym avec une cassette vidéo."
                            },
                            {
                                "example_id": "f2c07dd6-a040-4760-917d-b66906a4027c",
                                "sense_id": "c8fea6f4-6e85-3764-890f-8b4f5b4e4240",
                                "text": "Tu peux toujours mincir, faire une prise de masse et remincir mais autant attaquer la prise de masse tout de suite je pense puis la sèche ensuite, ça me parait le plus logique et le moins chiant."
                            },
                            {
                                "example_id": "1dd4446f-3519-4077-a1d6-67e2d59899da",
                                "sense_id": "c8fea6f4-6e85-3764-890f-8b4f5b4e4240",
                                "text": "Bien sûr, on peut perdre du poids à tout âge, mais il est vrai qu'après la ménopause le corps se transforme, mais on voit des femmes remincir après ce cap difficile (de corrigé en des)"
                            }
                        ]
                    }
