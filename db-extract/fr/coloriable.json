                "senses": [
                    {
                        "sense_id": "fc775db3-0616-3f8e-a042-ed77fe6f8bad",
                        "entry_id": "8f68be93-85cc-39b3-b1bb-40e9888d6345",
                        "glosses": [
                            "Qui peut, ou est destiné à, être colorié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f45c563-30e1-41b4-8fdb-8d138f0a6845",
                                "sense_id": "fc775db3-0616-3f8e-a042-ed77fe6f8bad",
                                "text": "Cela s'est produit pour le théorème des quatre couleurs (« toute carte est coloriable avec quatre couleurs sans que deux pays voisins portent la même couleur »), dont d'ailleurs aujourd'hui on ne connaît que des preuves utilisant l'ordinateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "903eea4b-2fe4-4163-afd9-a869cb07b345",
                        "source_entry_id": "8f68be93-85cc-39b3-b1bb-40e9888d6345",
                        "source_sense_id": "fc775db3-0616-3f8e-a042-ed77fe6f8bad",
                        "target_lang_word": "colourable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colourable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3c1491c-d4c2-30df-806d-02f4ed6d358a",
                                        "entry_id": "f9506ffe-32e9-37d9-b3c8-3798c6336053",
                                        "glosses": [
                                            "Colourful."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f063a1c6-bc11-3456-b288-4b34cb8957bb",
                                        "entry_id": "f9506ffe-32e9-37d9-b3c8-3798c6336053",
                                        "glosses": [
                                            "Apparently true; specious; potentially justifiable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37aab2cb-1169-4f0d-ad5c-13754e202b0a",
                                                "sense_id": "f063a1c6-bc11-3456-b288-4b34cb8957bb",
                                                "text": "Doth the master make any bargaine, or dispatch that pleaseth not? it is immediately smothered and suppressed, soone after forging causes, and devising colourable excuses, to excuse the want of execution or answer."
                                            },
                                            {
                                                "example_id": "819b81af-311e-41d0-a0f8-bb7e21cd38ad",
                                                "sense_id": "f063a1c6-bc11-3456-b288-4b34cb8957bb",
                                                "text": "they told him their comming was for some extraordinary tooles and shift of apparell; by this colourable excuse, they obtained 6. or 7. more to their confederacie […]."
                                            },
                                            {
                                                "example_id": "2b8ff471-a2c8-41c9-9992-63fdbc2c7bc9",
                                                "sense_id": "f063a1c6-bc11-3456-b288-4b34cb8957bb",
                                                "text": "These three examples have what may be called a 'colourable' claim for a public justification: they do not appear to us as checkerboard statues because, looking at the distinctions they draw, we presume the required justification does exist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d1afe8-80b8-3ae4-8ce7-b8f5beb687fc",
                                        "entry_id": "f9506ffe-32e9-37d9-b3c8-3798c6336053",
                                        "glosses": [
                                            "Deceptive; fake, misleading."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811ae68b-037f-4564-a02b-9d99483712c9",
                                                "sense_id": "d7d1afe8-80b8-3ae4-8ce7-b8f5beb687fc",
                                                "text": "Glauce, what needs this colourable word, / To cloke the cause, that hath it selfe bewrayd?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaf86169-3f86-31fc-90de-ce524d985200",
                                        "entry_id": "f9506ffe-32e9-37d9-b3c8-3798c6336053",
                                        "glosses": [
                                            "Deceptive; fake, misleading.",
                                            "In appearance only; not in reality what it purports to be, hence counterfeit, feigned."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "841cf898-4aad-33bb-a816-80d2aa759b64",
                                        "entry_id": "f9506ffe-32e9-37d9-b3c8-3798c6336053",
                                        "glosses": [
                                            "That can be coloured."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b5dd406-11e5-430e-a10d-6dfbd413fa85",
                                                "sense_id": "841cf898-4aad-33bb-a816-80d2aa759b64",
                                                "text": "This matter, however, is not itself coloured, but is only capable of exhibiting colours, by the addition of other matters : and hence we have ventured to call it the colourable, rather than the colouring parts of the plant, by which we merely indicate its property of becoming coloured, but not its actual possession of colour."
                                            },
                                            {
                                                "example_id": "08bfdd36-4239-4c01-9d99-36f8b336bf2c",
                                                "sense_id": "841cf898-4aad-33bb-a816-80d2aa759b64",
                                                "text": "These results were discovered whilst investigating uniquely edge colourable graphs."
                                            },
                                            {
                                                "example_id": "326cddcf-b69f-498f-8ca0-72bddc3106c2",
                                                "sense_id": "841cf898-4aad-33bb-a816-80d2aa759b64",
                                                "text": "A circle graph with no cycle of length four is colourable with three colours."
                                            },
                                            {
                                                "example_id": "abc623d5-d8a3-4581-8b61-0e516ec231fa",
                                                "sense_id": "841cf898-4aad-33bb-a816-80d2aa759b64",
                                                "text": "Take a look at the free colouring page application available at Kidopo[…]This service offers all the essential colouring tools _^([sic]) a pen, a pencil, colouring palette etc _ and presents a variety of colourable pictures for helping the child simulate a real colouring experience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
