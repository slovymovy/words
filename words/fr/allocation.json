    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5b95a3a-d758-31aa-b73a-05fb055a8c27",
                    "sense_definition": "Somme d'argent versée par un organisme public ou une entreprise pour subvenir à certains besoins précis.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aide_financiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la perte de son emploi, il a déposé une demande pour toucher son <w>allocation</w>."
                        },
                        {
                            "text": "Cette famille nombreuse reçoit chaque mois une <w>allocation</w> pour les dépenses quotidiennes."
                        }
                    ],
                    "synonyms": [
                        "aide",
                        "indemnité",
                        "prestation",
                        "subvention"
                    ],
                    "common_phrases": [
                        "allocation de chômage",
                        "allocations familiales"
                    ]
                },
                {
                    "sense_id": "cc7e5a01-7745-30ab-bfd1-b3f4c8caf224",
                    "sense_definition": "Action d'attribuer, de distribuer ou de réserver une somme ou des ressources à un usage défini.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conseil municipal a approuvé l'<w>allocation</w> de nouveaux fonds pour rénover l'école du quartier."
                        },
                        {
                            "text": "Une meilleure <w>allocation</w> des ressources humaines permettra d'accélérer l'avancement de ce projet."
                        }
                    ],
                    "synonyms": [
                        "affectation",
                        "attribution",
                        "distribution",
                        "répartition"
                    ],
                    "common_phrases": [
                        "allocation des ressources",
                        "allocation budgétaire"
                    ]
                },
                {
                    "sense_id": "698e03a5-a9b7-334c-84ab-ddc29962c041",
                    "sense_definition": "Action de réserver une partie de la mémoire ou une ressource système pour des données ou un processus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le programme a planté en raison d'un problème lors de l'<w>allocation</w> de mémoire vive."
                        },
                        {
                            "text": "Une <w>allocation</w> dynamique permet de gérer plus efficacement la mémoire utilisée par l'application."
                        }
                    ],
                    "synonyms": [
                        "affectation",
                        "réservation"
                    ],
                    "antonyms": [
                        "désallocation"
                    ],
                    "common_phrases": [
                        "allocation de mémoire",
                        "allocation dynamique"
                    ]
                },
                {
                    "sense_id": "cde0db03-43cc-31e8-9df9-d743a3585515",
                    "sense_definition": "Action d'enregistrer et de valider un article dans les comptes ou les registres comptables.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "comptabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable a vérifié chaque écriture avant de procéder à l'<w>allocation</w> définitive des dépenses."
                        },
                        {
                            "text": "L'<w>allocation</w> de cette facture doit être validée par le responsable financier."
                        }
                    ],
                    "synonyms": [
                        "imputation",
                        "comptabilisation"
                    ]
                },
                {
                    "sense_id": "1efc85cf-34dc-3800-819d-7537a2ca3bcd",
                    "sense_definition": "Somme totale distribuée sous forme de prix aux propriétaires des chevaux vainqueurs ou placés lors d'une course hippique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hippisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette prestigieuse compétition équestre offre une <w>allocation</w> très importante aux vainqueurs."
                        },
                        {
                            "text": "Les jockeys s'affrontent pour remporter une part de l'<w>allocation</w> globale de la course."
                        }
                    ],
                    "synonyms": [
                        "dotation",
                        "prime"
                    ]
                }
            ]
        }
    ]
}