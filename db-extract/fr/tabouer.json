                "senses": [
                    {
                        "sense_id": "0101e61b-b554-3cc6-ab04-efcca5c7002f",
                        "entry_id": "7b7e9ac2-7f4f-36bd-950b-e52e8349f529",
                        "glosses": [
                            "Déclarer tabou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4157181b-9ca1-4b0e-ac7b-ad3f672795f3",
                                "sense_id": "0101e61b-b554-3cc6-ab04-efcca5c7002f",
                                "text": "Lorsqu’un objet est taboué, nul n’y peut toucher impunément."
                            },
                            {
                                "example_id": "76c69828-829e-42ca-8ab8-49c5cf3c8d34",
                                "sense_id": "0101e61b-b554-3cc6-ab04-efcca5c7002f",
                                "text": "Je fus longtemps hanté par l’idée qu’il y avait là quelque chose de pervers, et je pris conscience de l’existence de tout un monde à côté, d’un domaine défendu, taboué, « érotique », ainsi que me le prouvait cette scène que des raisons mystérieuses avaient fait censurer."
                            }
                        ]
                    }
