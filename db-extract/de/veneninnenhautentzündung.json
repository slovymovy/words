                        "glosses": [
                            "Entzündung der Innenhaut einer Vene"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "75cece79-d267-4fc0-baea-aef3eac90d41",
                                "sense_id": "d79ca04f-0e15-33b2-9525-5cdd9778f8bf",
                                "text": "„Die Gefahren und Störungen der Veneninnenhautentzündung auf bakterieller Grundlage entstehen aus der Thrombose und dem Thrombiis.“"
                            },
                            {
                                "example_id": "33331522-0c08-4703-8d69-1ff19dc271fe",
                                "sense_id": "d79ca04f-0e15-33b2-9525-5cdd9778f8bf",
                                "text": "„Weniger häufig breitet sich im Anschluß an Leberabscesse eine Veneninnenhautentzündung, ausgehend von den intrahepatischen Pfortaderzweigen, retrograd auf den Pfortaderstamm aus.“"
                            }
                        ],
