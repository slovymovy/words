                    {
                        "translation_id": "398d470b-1f6f-4af2-9c35-314ae25d8034",
                        "source_entry_id": "277a8e7c-3adc-3ca1-b9fb-b981806fab79",
                        "source_sense_id": "d8efca56-0ba6-3ac2-ae04-5adeb15c162b",
                        "source_sense_description": "not exhibiting any symptoms of disease",
                        "target_lang_word": "asymptomatisch",
