{
    "word_family": [
        "bubbly",
        "bubbler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed40f2d6-b19d-30ee-b6f3-140565eeca0a",
                    "sense_definition": "A spherically contained volume of air or other gas, especially one made from soapy liquid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children laughed as they chased the soap <w>bubbles</w> across the garden.",
                            "target_lang_translations": {
                                "ru": "Дети смеялись, гоняясь за мыльными <w>пузырями</w> по саду.",
                                "zh": "孩子们笑着在花园里追逐肥皂<w>泡泡</w>。"
                            }
                        },
                        {
                            "text": "He blew a huge <w>bubble</w> with his gum, but it popped on his nose.",
                            "target_lang_translations": {
                                "ru": "Он надул огромный <w>пузырь</w> из жвачки, но тот лопнул прямо у него на носу.",
                                "zh": "他用口香糖吹了一个巨大的<w>泡泡</w>，结果在鼻子上破了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blow bubbles",
                        "soap bubble",
                        "burst a bubble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сферический объём воздуха или газа, заключённый в оболочку, особенно из мыльной жидкости.",
                        "zh": "球状的气体或空气体积，尤指由肥皂水形成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузырь",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "пузырёк",
                                "target_lang_sense_clarification": "маленький, например, в напитке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泡泡",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "气泡",
                                "target_lang_sense_clarification": "液体中的小泡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63a164f3-14e8-394b-a6d2-7a8bc8c72c53",
                    "sense_definition": "A period of intense speculation in a market, causing prices to rise quickly to irrational levels and then fall even more quickly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many investors lost their savings when the housing <w>bubble</w> finally burst.",
                            "target_lang_translations": {
                                "ru": "Многие инвесторы потеряли свои сбережения, когда <w>пузырь</w> на рынке недвижимости наконец лопнул.",
                                "zh": "当房地产<w>泡沫</w>最终破裂时，许多投资者损失了积蓄。"
                            }
                        },
                        {
                            "text": "Economists are worried that the tech industry is in a dangerous <w>bubble</w>.",
                            "target_lang_translations": {
                                "ru": "Экономисты обеспокоены тем, что в технологической индустрии образовался опасный <w>пузырь</w>.",
                                "zh": "经济学家担心科技行业正处于一个危险的<w>泡沫</w>之中。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "housing bubble",
                        "dot-com bubble",
                        "market bubble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период ажиотажного спроса на рынке, приводящий к необоснованному росту цен с последующим обвалом.",
                        "zh": "市场中投机过度的时期，导致价格迅速上涨至不合理的水平，随后又迅速下跌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузырь",
                                "target_lang_sense_clarification": "экономический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泡沫",
                                "target_lang_sense_clarification": "经济学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c4d716b-03cb-3883-b88c-ab13b793ebd0",
                    "sense_definition": "The emotional or physical atmosphere in which a subject is immersed, often implying isolation from reality or others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "social_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He lives in a <w>bubble</w> of wealth and does not understand the struggles of ordinary people.",
                            "target_lang_translations": {
                                "ru": "Он живёт в <w>пузыре</w> богатства и не понимает проблем обычных людей.",
                                "zh": "他生活在财富的<w>小圈子</w>里，不理解普通人的挣扎。"
                            }
                        },
                        {
                            "text": "Social media algorithms can create a filter <w>bubble</w> where you only see opinions you agree with.",
                            "target_lang_translations": {
                                "ru": "Алгоритмы социальных сетей могут создавать информационный <w>пузырь</w>, где вы видите только те мнения, с которыми согласны.",
                                "zh": "社交媒体算法会制造一种<w>信息茧房</w>，让你只能看到自己认同的观点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambience"
                    ],
                    "common_phrases": [
                        "live in a bubble",
                        "filter bubble",
                        "support bubble",
                        "burst someone's bubble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изолированная среда или атмосфера, отделяющая человека от реальности или других мнений.",
                        "zh": "一种将人与现实或其他观点隔离开来的孤立环境或氛围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузырь",
                                "target_lang_sense_clarification": "метафорически: изоляция"
                            },
                            {
                                "target_lang_word": "мирок",
                                "target_lang_sense_clarification": "замкнутый мир"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小圈子",
                                "target_lang_sense_clarification": "封闭的社交环境"
                            },
                            {
                                "target_lang_word": "信息茧房",
                                "target_lang_sense_clarification": "指过滤气泡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5af6aa96-060e-3fa7-a44e-d78830caf6a8",
                    "sense_definition": "A small spherical cavity in a solid material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I noticed a tiny air <w>bubble</w> trapped inside the glass paperweight.",
                            "target_lang_translations": {
                                "ru": "Я заметил крошечный <w>пузырёк</w> воздуха внутри стеклянного пресс-папье.",
                                "zh": "我注意到玻璃镇纸里有一个微小的<w>气泡</w>。"
                            }
                        },
                        {
                            "text": "You should smooth out the wallpaper to ensure there are no <w>bubbles</w> underneath.",
                            "target_lang_translations": {
                                "ru": "Вам следует разгладить обои, чтобы под ними не осталось <w>пузырей</w>.",
                                "zh": "你应该把壁纸抹平，确保下面没有<w>鼓包</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "air bubble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая полость с воздухом внутри твёрдого материала или под покрытием.",
                        "zh": "固体材料中的小球形空腔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузырёк",
                                "target_lang_sense_clarification": "в стекле или жидкости"
                            },
                            {
                                "target_lang_word": "пузырь",
                                "target_lang_sense_clarification": "вздутие, например, на обоях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气泡",
                                "target_lang_sense_clarification": "玻璃或材料中的空隙"
                            },
                            {
                                "target_lang_word": "鼓包",
                                "target_lang_sense_clarification": "表面隆起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d4ba1b-45c8-39cc-9397-39d777f9f076",
                    "sense_definition": "A laugh.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must be having a <w>bubble</w> if you think I am going to pay that price.",
                            "target_lang_translations": {
                                "ru": "Ты, должно быть, <w>шутишь</w>, если думаешь, что я заплачу такую цену.",
                                "zh": "如果你觉得我会付那个价格，那你一定是在<w>开玩笑</w>。"
                            }
                        },
                        {
                            "text": "He is just having a <w>bubble</w> with you; don't take him so seriously.",
                            "target_lang_translations": {
                                "ru": "Он просто <w>разыгрывает</w> тебя, не воспринимай его так серьёзно.",
                                "zh": "他只是在<w>戏弄</w>你，别太当真。"
                            }
                        }
                    ],
                    "synonyms": [
                        "giraffe",
                        "bubble bath"
                    ],
                    "common_phrases": [
                        "having a bubble"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Cockney rhyming slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутка или смех (рифмованный сленг кокни).",
                        "zh": "玩笑或戏弄（源自考克尼押韵俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутка",
                                "target_lang_sense_clarification": "значение сленга"
                            },
                            {
                                "target_lang_word": "розыгрыш",
                                "target_lang_sense_clarification": "прикол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开玩笑",
                                "target_lang_sense_clarification": "俚语含义"
                            },
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "捉弄某人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e34a106-7b81-34cb-b9de-5b35352a9245",
                    "sense_definition": "To produce bubbles or to rise up in bubbles, such as in foods cooking or liquids boiling.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup began to <w>bubble</w> gently on the stove after a few minutes.",
                            "target_lang_translations": {
                                "ru": "Через несколько минут суп на плите начал тихонько <w>кипеть</w>.",
                                "zh": "几分钟后，炉子上的汤开始轻轻<w>冒泡</w>。"
                            }
                        },
                        {
                            "text": "Gas <w>bubbled</w> up from the bottom of the swampy lake.",
                            "target_lang_translations": {
                                "ru": "Газ <w>пузырился</w>, поднимаясь со дна болотистого озера.",
                                "zh": "沼泽湖底不断有气体<w>冒出</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bubble up",
                        "bubble over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать пузыри или подниматься пузырями, например, при кипении.",
                        "zh": "产生气泡或冒泡，如烹饪食物或液体沸腾时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пузыриться",
                                "target_lang_sense_clarification": "выделять пузырьки"
                            },
                            {
                                "target_lang_word": "бурлить",
                                "target_lang_sense_clarification": "активно кипеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒泡",
                                "target_lang_sense_clarification": "产生气泡"
                            },
                            {
                                "target_lang_word": "沸腾",
                                "target_lang_sense_clarification": "剧烈冒泡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2911679-1801-39da-835b-471498d31a2e",
                    "sense_definition": "To mark a response on a form by filling in a circular area.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "academic_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to <w>bubble</w> in your answers completely with a number two pencil.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что вы полностью <w>закрасили</w> кружочки с ответами мягким карандашом.",
                                "zh": "确保用2号铅笔将你的答案完全<w>涂黑</w>。"
                            }
                        },
                        {
                            "text": "She realized she had <w>bubbled</w> the wrong row on the answer sheet.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что <w>отметила</w> не тот ряд в бланке ответов.",
                                "zh": "她意识到自己在答题卡上<w>填涂</w>错了行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bubble in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отмечать ответ в бланке, закрашивая кружок.",
                        "zh": "通过填充圆形区域在表格上标记答案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрашивать",
                                "target_lang_sense_clarification": "заполнять кружок"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "выбирать ответ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂黑",
                                "target_lang_sense_clarification": "填涂答题卡"
                            },
                            {
                                "target_lang_word": "填涂",
                                "target_lang_sense_clarification": "标记选项"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9731eb7f-5d12-3db5-b3c0-708552b2d14b",
                    "sense_definition": "To churn or foment, as if wishing to rise to the surface; to be felt intensely but internally.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Excitement <w>bubbled</w> inside her as she waited for the news.",
                            "target_lang_translations": {
                                "ru": "Волнение <w>бурлило</w> в ней, пока она ждала новостей.",
                                "zh": "当她等待消息时，内心充满了<w>涌动</w>的兴奋。"
                            }
                        },
                        {
                            "text": "Resentment had <w>bubbled</w> under the surface for years before the conflict started.",
                            "target_lang_translations": {
                                "ru": "Обида <w>кипела</w> внутри годами, прежде чем начался конфликт.",
                                "zh": "在冲突开始前，怨恨已经在内心<w>翻腾</w>多年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bubble to the surface",
                        "bubble under"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильное внутреннее волнение или нарастание чувств.",
                        "zh": "内心强烈涌动或积压的情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурлить",
                                "target_lang_sense_clarification": "о чувствах"
                            },
                            {
                                "target_lang_word": "кипеть",
                                "target_lang_sense_clarification": "быть переполненным эмоциями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涌动",
                                "target_lang_sense_clarification": "形容情绪"
                            },
                            {
                                "target_lang_word": "翻腾",
                                "target_lang_sense_clarification": "内心不安"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}