                },
                {
                    "sense_id": "3b9d2950-bfa7-32bb-8908-22e042770e2b",
                    "sense_definition": "Передняя, верхняя или наружная сторона предмета, здания или ткани.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер внимательно осмотрел ткань, чтобы определить, где у неё <w>лицо</w>, а где изнанка.",
                            "target_lang_translations": {
                                "en": "The master carefully examined the fabric to determine which was the <w>right side</w> and which was the wrong side.",
                                "zh": "师傅仔细检查了布料，以区分哪一面是<w>正面</w>，哪一面是反面。"
                            }
                        },
                        {
                            "text": "Наш загородный дом стоял <w>лицом</w> к реке, и из окон открывался прекрасный вид.",
                            "target_lang_translations": {
                                "en": "Our country house stood <w>facing</w> the river, and a beautiful view opened from the windows.",
                                "zh": "我们的乡间别墅<w>面向</w>河流，从窗户望去景色优美。"
                            }
                        }
                    ],
                    "common_phrases": [
