                "senses": [
                    {
                        "sense_id": "53857c6f-5fc9-364d-ae5d-ef18f8348130",
                        "entry_id": "b00f9b83-38ac-38be-89bf-0c024b26e48d",
                        "glosses": [
                            "aus den ältesten Mitgliedern einer Gemeinschaft gebildete Institution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a98c53-118d-47d8-bbac-0bced7b88f2a",
                                "sense_id": "53857c6f-5fc9-364d-ae5d-ef18f8348130",
                                "text": "„Was nützen gut ausgebildete Juristen, die nicht eingesetzt werden, weil die Afghanen – gerade auf dem Land – lieber zum Ältestenrat gehen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd6540ba-2718-3e52-8a6e-794e117f1bc7",
                        "entry_id": "b00f9b83-38ac-38be-89bf-0c024b26e48d",
                        "glosses": [
                            "spezieller Ausschuss des Bundestages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb3c518-54fc-435d-a48e-6f4a5f0b99ed",
                                "sense_id": "dd6540ba-2718-3e52-8a6e-794e117f1bc7",
                                "text": "„…keineswegs um einen \"normalen\" mittelgroßen Hack handelte, wie er in allen größeren Unternehmen vorkommt und ausweislich des Protokolls des Ältestenrats schon acht- bis zehnmal im Bundestag vorgekommen ist, sondern um einen Angriff, hinter dem womöglich ein fremder Geheimdienst steckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
