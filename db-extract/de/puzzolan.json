                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2d092bd-d8ea-3f28-a78f-b0c3764c120f",
                        "entry_id": "3057c85c-e91d-3e43-94c5-470be4c6ce00",
                        "glosses": [
                            "in Italien vorkommender poröser vulkanischer Tuff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1193e4-3ec1-4478-aa66-e173a4d7f185",
                                "sense_id": "b2d092bd-d8ea-3f28-a78f-b0c3764c120f",
                                "text": "Puzzolane sind glasige Silikatgesteine, die zu einem Viertel aus wasserlöslichem Siliziumdioxyd bestehen und außer Calcium-, Magnesium- und Aluminiumoxyd beträchtliche Mengen Eisenoxyd enthalten, dem sie ihre tief rotbraune Farbe verdanken."
                            },
                            {
                                "example_id": "646f8a23-823c-4ed4-9d0c-1b61da41a642",
                                "sense_id": "b2d092bd-d8ea-3f28-a78f-b0c3764c120f",
                                "text": "Doch im Vergleich zu den Schwesterinseln ist Milos durchsetzt von Mineralien und Erzen, sie ist ein Rohstofflager aus Kaolin und Bentonit, Perlit und Baryt, Limonit, Manganerz und Puzzolan."
                            },
                            {
                                "example_id": "68bb56ad-8bb0-4b2b-bd2b-e4718d95eddc",
                                "sense_id": "b2d092bd-d8ea-3f28-a78f-b0c3764c120f",
                                "text": "In etwa drei Kilometern Tiefe wird Kohlendioxid freigesetzt, dieses reagiert beim Aufsteigen mit Meerwasser, Kalk und anderen Mineralien im Boden, inklusive Puzzolan – der besonderen Vulkanasche in der Region."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "339af905-2c1d-3771-ac6a-6d7d0c71d1e5",
                        "entry_id": "3057c85c-e91d-3e43-94c5-470be4c6ce00",
                        "glosses": [
                            "hydraulisches Bindemittel für Zement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a56991e5-f96b-4d2e-b9e7-0b601dd3f93e",
                                "sense_id": "339af905-2c1d-3771-ac6a-6d7d0c71d1e5",
                                "text": "Das Geheimnis ist eine Vulkanasche, die es auch bei Rom gibt, die aber nach einer Abbaustätte am Vesuv Puzzolan genannt wurde. Die wird gebranntem Kalk beigemischt, Wasser kommt dazu, Ergebnis ist ein Kalzium-Aluminium-Silikat-Hydrat, es härtet zu Strätlingit aus, einem Kalzium-Aluminium-Silikat."
                            },
                            {
                                "example_id": "f6356e76-8744-4865-8f9d-90f9834131df",
                                "sense_id": "339af905-2c1d-3771-ac6a-6d7d0c71d1e5",
                                "text": "Feingepulvert und mit Kalk und Wasser angerührt, erhärten die Puzzolane wie Zement."
                            },
                            {
                                "example_id": "5ea36d33-ba00-4934-bbc6-38a2893c7392",
                                "sense_id": "339af905-2c1d-3771-ac6a-6d7d0c71d1e5",
                                "text": "Erst durch die Beimengung der Puzzolane erhielt das opus caementitium jene hydraulischen Eigenschaften, durch die dieses Gemisch nach der Zugabe von Wasser zu druckfestem Stein aushärtete – ähnlich wie unser heutiger Beton bzw. Zement."
                            },
                            {
                                "example_id": "12cc8e97-d10c-4de2-b8cd-3dd3f74ac843",
                                "sense_id": "339af905-2c1d-3771-ac6a-6d7d0c71d1e5",
                                "text": "Durch die Zugabe verschiedener Stoffe wie Hüttensand, Puzzolan, Flugasche oder Kalkstein werden Zemente mit speziellen chemischen und physikalischen Eigenschaften hergestellt."
                            },
                            {
                                "example_id": "a4b49abc-971e-48ed-80fc-0fa43082af49",
                                "sense_id": "339af905-2c1d-3771-ac6a-6d7d0c71d1e5",
                                "text": "Im Mittelalter und der frühen Neuzeit gab es keinen Beton, weil das Wissen über die Puzzolane verloren gegangen war."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
