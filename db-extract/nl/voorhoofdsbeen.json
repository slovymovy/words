                                        "sense_id": "4006e2c2-fa8e-3d82-9715-e40e20e25c91",
                                        "entry_id": "93843ea0-de75-3ee6-9f13-0bee4627a25f",
                                        "glosses": [
                                            "unpaariger, zwischen Nasen-, Joch- und Scheitelbein gelegener, den vorderen Teil des Schädeldaches sowie die Grundlage der Stirn bildender Schädelknochen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bb2483-29a3-47ce-8eef-23a5b05e4a25",
                                                "sense_id": "4006e2c2-fa8e-3d82-9715-e40e20e25c91",
                                                "text": "„Im Zuge der Evolution aus einem gemeinsamen Vorfahren haben sich Gehirnstrukturen von Affen und Menschen unterschiedlich entwickelt: So liegt bei den großen Primaten heute der untere Teil des Sulcus praecentralis, einer auffälligen Furche des Großhirns, im Schädel eindeutig vor der Koronarnaht, der von außen sichtbaren Naht zwischen vorderem Stirnbein und dem sich nach hinten anschließenden Scheitelbein des Schädels. Beim modernen Menschen ist das anders, denn die Hirnwindung wich im Lauf der Menschwerdung nach hinten aus, um Teilen des Frontallappens Platz zu machen, der offenbar wichtiger wurde und zunehmend mehr Platz einnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
