            "senses": [
                {
                    "sense_id": "ad16da5a-cb35-3feb-9ef0-8f885c055bbf",
                    "sense_definition": "Terme familier et affectueux désignant un oncle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour son anniversaire, mon <w>tonton</w> lui a offert un très beau livre illustré."
                        },
                        {
                            "text": "Les enfants passent toutes leurs vacances d'été chez leur <w>tonton</w> à la campagne."
                        }
                    ],
                    "synonyms": [
                        "oncle"
                    ],
                    "common_phrases": [
                        "cher tonton"
                    ],
                    "traits": [
                        {
