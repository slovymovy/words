                                "example_id": "047fd176-b465-4058-a154-38b5aadb265f",
                                "sense_id": "0e72a813-3336-3502-9814-1b7f57fbe19d",
                                "text": "„Johannes R. Becher stand noch im Schüleralter unter Mordanklage.“"
                            },
                            {
                                "example_id": "7e2ad517-e521-47c1-98d8-4d2cb9078074",
                                "sense_id": "0e72a813-3336-3502-9814-1b7f57fbe19d",
                                "text": "„Alle Kassiber wurden von den Gerichten abgefangen und gegen Tinius verwandt, der sich jetzt zusätzlich mit der Mordanklage im Fall Schmidt, den er selbst ins Spiel gebracht hatte, konfrontiert sah.“"
                            }
