                                                "example_id": "463d7d6a-483e-4c0f-854f-0242916681c1",
                                                "sense_id": "ccb2967b-e1aa-37ac-94ea-63023713dfe7",
                                                "text": "„Trotzdem blieb scholastisches Denken bis weit in die Neuzeit hinein grundlegender Bestandteil des wissenschaftlichen Arbeitens und des universitären Lehrbetriebs in allen Disziplinen.“"
                                            }
                                        ],
