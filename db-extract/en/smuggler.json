                                "target_senses": [
                                    {
                                        "sense_id": "732f3fe5-a5c0-34e5-90e3-6ac7e150fdef",
                                        "entry_id": "726a7c40-5cbf-34c0-b8ae-0688d36339bb",
                                        "glosses": [
                                            "Femme qui fait de la contrebande, qui passe des objets en dehors des formalités et taxes d’une frontière, et qui est pourchassée par les douaniers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ce4d7c-271e-4f2f-8a2f-28f826309bb7",
                                                "sense_id": "732f3fe5-a5c0-34e5-90e3-6ac7e150fdef",
                                                "text": "Mais, longtemps, le mouvement fut inverse, comme le montrent les deux articles sur la contrebande en un temps où le café et le tabac, moins chers en Belgique, étaient ramenés par des fraudeurs et fraudeuses. La bande dessinée d’Yves Kreztmeyer est très instructive sur ce point... Certes, sa contrebandière emprunte le Toré mais elle aurait pu tout aussi bien voyager avec le petit train qui allait de Monthermé à Sorendal-Bohan, dont nous racontons l’histoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e0aee8f-fb02-45a2-b6cf-7e5040e452e1",
                        "source_entry_id": "8b77ceff-2ed0-345f-ad56-295d09a2b007",
                        "source_sense_description": "One who smuggles things",
                        "target_lang_word": "Schmuggler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmuggler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                        "entry_id": "585efde4-9d0d-3798-817b-4900fd9b4239",
                                        "glosses": [
                                            "Person, die schmuggelt, die Ware illegal über die Staatsgrenze bringt und nicht den notwendigen Zoll und andere Steuern oder Abgaben zahlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fe1420-f73d-4304-aaa0-40d60d2bd99e",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "Die Schmuggler versuchten im Schutz der Dunkelheit die Grenze zu überqueren."
                                            },
                                            {
                                                "example_id": "130a75f1-e35d-4c87-a7cc-82b476fd3be3",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Als er von diesem Plan erfuhr, klagte der Vizekönig, dass Torres, welcher der größte Schmuggler von allen sei, diese Untersuchung nur deswegen leiten wollte, um seine eigenen illegalen Aktivitäten vertuschen zu können.“"
                                            },
                                            {
                                                "example_id": "03c5bed6-3918-420e-8041-f9042750d3a4",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Er mochte nicht, dass sein Vater bei den Schmugglern stehen blieb und mit ihnen redete, wenn er mit ihm unterwegs war.“"
                                            },
                                            {
                                                "example_id": "cce08bb2-17cd-43f2-af47-db1ad66d66d9",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Wir beobachteten das Treiben der Schmuggler durch unsere Zelttüren mit skeptischem Interesse, aber sie ließen uns in Frieden.“"
                                            },
                                            {
                                                "example_id": "a913c8af-e52f-4b5a-b7a0-4d7908700001",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Noch zwei Mal ging sie alleine, dann kam Leo mit, dann Pfaff mit seinem Sohn Heiner, dann Bronski mit seinem Sohn Gert, und schließlich führte sie drei Mal pro Woche bis zu fünfzehn Schmuggler übers Hohe Venn.“"
                                            },
                                            {
                                                "example_id": "d6cd9e3d-ce99-42a8-932a-f28efe2d90d4",
                                                "sense_id": "702ed381-3e61-324f-af72-ae20231b331c",
                                                "text": "„Schmuggler verstecken kiloweise Kokain in Pferdesätteln[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
