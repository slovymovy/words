                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>ruikt</w> hier heel sterk naar gas.",
                            "target_lang_translations": {
                                "en": "It <w>smells</w> very strongly of gas here.",
                                "ru": "Здесь очень сильно <w>пахнет</w> газом.",
                                "pl": "Bardzo mocno tu <w>pachnie</w> gazem.",
                                "de": "Es <w>riecht</w> hier sehr stark nach Gas.",
                                "fr": "Ça <w>sent</w> très fort le gaz ici.",
                                "it": "Qui <w>c'è un forte odore</w> di gas.",
                                "cs": "Tady to velmi silně <w>páchne</w> plynem.",
                                "tr": "Burası çok keskin gaz <w>kokuyor</w>.",
                                "es": "Aquí <w>huele</w> muy fuerte a gas."
                            }
                        },
                        {
                            "text": "Na het douchen <w>rook</w> hij weer lekker fris.",
                            "target_lang_translations": {
                                "en": "After showering, he <w>smelled</w> nice and fresh again.",
                                "ru": "После душа он снова приятно и свежо <w>пах</w>.",
                                "pl": "Po prysznicu znowu ładnie i świeżo <w>pachniał</w>.",
                                "de": "Nach dem Duschen <w>roch</w> er wieder gut und frisch.",
                                "fr": "Après sa douche, il <w>sentait</w> à nouveau bon et frais.",
                                "it": "Dopo la doccia <w>profumava</w> di nuovo di fresco.",
                                "cs": "Po sprše zase příjemně a svěže <w>voněl</w>.",
                                "tr": "Duş aldıktan sonra yine mis gibi temiz <w>kokuyordu</w>.",
                                "es": "Después de ducharse, <w>olía</w> a limpio y fresco otra vez."
                            }
