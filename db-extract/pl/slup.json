                    {
                        "sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
                        "entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "glosses": [
                            "jednomasztowy żaglowiec z grotem i fokiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad03a354-3d16-45d4-8edb-a893d0fe5ad2",
                                "sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
                                "text": "Slupy są najczęściej spotykanymi w Polsce żaglówkami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "70a2b603-8b21-39ca-bfc7-916b26e55f11",
                        "entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "glosses": [
                            "żaglowy okręt wojenny, w użyciu w XVIII i XIX w."
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79625f62-e978-4c45-b2f9-00837219db09",
                        "source_entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "source_sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
                        "target_lang_word": "sloop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "330f1a7e-eda8-36bd-ab83-6abb15283582",
                                        "entry_id": "a04ea84f-f66f-3747-8294-71132a9a21ac",
                                        "glosses": [
                                            "A single-masted sailboat with only one headsail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3945b30a-9c9e-4852-b38a-3b097b8f4e19",
                                                "sense_id": "330f1a7e-eda8-36bd-ab83-6abb15283582",
                                                "text": "1789, Olaudah Equiano (Gustavus Vassa), The Interesting Narrative of the Life of Olaudah Equiano,\nI stayed in this island for a few days; I believe it could not be above a fortnight; when I and some few more slaves, that were not saleable amongst the rest, from very much fretting, were shipped off in a sloop for North America."
                                            },
                                            {
                                                "example_id": "c90d8a17-7044-4614-a98c-304708d6890b",
                                                "sense_id": "330f1a7e-eda8-36bd-ab83-6abb15283582",
                                                "text": "And where but from Nantucket, too, did that first adventurous little sloop put forth, partly laden with imported cobblestones—so goes the story—to throw at the whales, in order to discover when they were nigh enough to risk a harpoon from the bowsprit?"
                                            },
                                            {
                                                "example_id": "57bb8af7-c9d0-46a6-8546-13da06b88a14",
                                                "sense_id": "330f1a7e-eda8-36bd-ab83-6abb15283582",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bd53a62-b001-35dc-b7b2-fabe4d6caa8d",
                                        "entry_id": "a04ea84f-f66f-3747-8294-71132a9a21ac",
                                        "glosses": [
                                            "A sailing warship, smaller than a frigate, with its guns all on one deck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd3c3e1c-f5db-3348-af26-c2a2342badec",
                                        "entry_id": "a04ea84f-f66f-3747-8294-71132a9a21ac",
                                        "glosses": [
                                            "A sloop-of-war, smaller than a frigate, larger than a corvette."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d78f6676-865f-4232-874d-5ea2efe193a7",
                        "source_entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "source_sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
                        "target_lang_word": "šalupa",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "515e3d4e-733f-416e-aa5d-b68c0b0bcade",
                        "source_entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "source_sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
                        "target_lang_word": "sloop",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloop",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "154ce96f-19cf-3cf5-a7fa-78bef8aaa2d7",
                                        "entry_id": "ad1ba966-2960-31dd-9bc4-098fff466c5c",
                                        "glosses": [
                                            "Bâtiment à un seul mât avec une seule voile à l'avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59959db6-5bd0-4d22-a2ac-250bee4c32d0",
                                                "sense_id": "154ce96f-19cf-3cf5-a7fa-78bef8aaa2d7",
                                                "text": "Sans rien dire, le frère de Bob nous désigna de la main un navire gréé en sloop ; nous comprîmes que c’était le sien ; en quelques minutes nous fûmes à bord ; alors il nous fit descendre dans une petite cabine."
                                            },
                                            {
                                                "example_id": "9dd44d94-48c9-4b41-afe9-e6e77c825d4e",
                                                "sense_id": "154ce96f-19cf-3cf5-a7fa-78bef8aaa2d7",
                                                "text": "Pour ces voyages, on employa, en 1735, un sloop double construit à Iakoutsk, et, en 1739, deux bateaux construits à Nischni Kolymsk."
                                            },
                                            {
                                                "example_id": "c8988e8f-c742-4834-92a2-eb3f062e9db6",
                                                "sense_id": "154ce96f-19cf-3cf5-a7fa-78bef8aaa2d7",
                                                "text": "Il y avait beaucoup de lumières sur la mer, et le vent régulier et violent qui soufflait, après avoir contourné le promontoire, poussait devant lui un sloop dont la grand-voile et le spinnaker étaient totalement déployés."
                                            },
                                            {
                                                "example_id": "8109ddf7-93ee-4452-afcc-274e2e06b36e",
                                                "sense_id": "154ce96f-19cf-3cf5-a7fa-78bef8aaa2d7",
                                                "text": "Des voiliers, goélettes, « sloops » ou « tapouilles » assurent la plus grande partie des transports entre Cayenne et les communes qui, pour la plupart, ne sont pas reliées par voie routière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad850e8a-4346-49cd-a55f-752efa188983",
                        "source_entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "source_sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
                        "target_lang_word": "sloep",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloep",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "90c046ea-e1d7-3500-a8a3-28f028671df1",
                                        "entry_id": "09a1e7f2-fdcb-3dcd-a67a-2e0286e73dc0",
                                        "glosses": [
                                            "een klein scheepstype dat op het dek van een groter schip wordt meegevoerd"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de8d02c0-ef72-36f2-8dbd-2648774f5dc7",
                                        "entry_id": "09a1e7f2-fdcb-3dcd-a67a-2e0286e73dc0",
                                        "glosses": [
                                            "een klein scheepstype dat vele jaren als onafhankelijk zeevaartuig in gebruik is geweest"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e4849b-5336-4fad-b9d8-05197e99d998",
                                                "sense_id": "de8d02c0-ef72-36f2-8dbd-2648774f5dc7",
                                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                                            },
                                            {
                                                "example_id": "c933819d-e65d-420d-9279-900012ca3b60",
                                                "sense_id": "de8d02c0-ef72-36f2-8dbd-2648774f5dc7",
                                                "text": "Terwijl we voor anker lagen op de rede konden de passagiers aan land gaan door langs een stevige ladder aan de zijkant van het schip af te dalen naar wachtende sloepen die ons naar de kade brachten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "789e613d-f959-4d12-90bc-aaa731cb2545",
                        "source_entry_id": "9873c11a-13d5-35df-a737-c50e78712c09",
                        "source_sense_id": "815b1534-22a5-3282-b6df-e64431be523d",
