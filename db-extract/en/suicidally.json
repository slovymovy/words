                        "glosses": [
                            "In a suicidal fashion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ccd6cb-d268-40ce-b15e-de1a1a094443",
                                "sense_id": "0225e127-a3eb-3bd9-b961-bd6914a0aa7f",
                                "text": "“Misled how?” I toss this over in my mind as my fork tosses the murg phall, a suicidally hot Bangalore-style chicken curry designed for masochistic European taste, slowly oxidizing in my plate."
                            },
                            {
                                "example_id": "114d3e97-c2ea-4f43-8fa7-0076f9e49eb9",
                                "sense_id": "0225e127-a3eb-3bd9-b961-bd6914a0aa7f",
                                "text": "My father did not magnanimously toss fish to the admiring multitudes, and most likely he did not beckon to the catfish, which then leapt suicidally into our boat."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dea77f5-fd99-3a29-9238-d15ee83d86b6",
                        "entry_id": "730d8048-58dc-37e1-8b91-8457f06a4be1",
                        "glosses": [
                            "In terms of or by means of suicide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce1018e-5ac1-4c90-bff2-d5b0e991ccc1",
                                "sense_id": "2dea77f5-fd99-3a29-9238-d15ee83d86b6",
                                "text": "To accusations that her leap from her prison tower was suicidally motivated, she replies scornfully that anybody with any sense prefers to try for freedom instead of remaining in prison."
                            },
                            {
                                "example_id": "277beeed-4702-41a1-a8df-23db1ad40a1e",
                                "sense_id": "2dea77f5-fd99-3a29-9238-d15ee83d86b6",
                                "text": "There can be a suicidally motivated parent who wishes to take the children with him or her."
                            }
                        ]
                    }
