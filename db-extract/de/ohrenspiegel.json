                "senses": [
                    {
                        "sense_id": "5d9f908f-6011-38bd-ae89-9c947dc61d9c",
                        "entry_id": "a94499ce-ed97-3d89-a150-8003561c0b8d",
                        "glosses": [
                            "„Gerät des HNO-Arztes und des Hörgeräteakustikers zur Betrachtung und Untersuchung des äußeren Gehörganges einschließlich des Trommelfells“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298b54e1-d6f5-4c97-a92f-a83fc4137d79",
                                "sense_id": "5d9f908f-6011-38bd-ae89-9c947dc61d9c",
                                "text": "„Der heutige Ohrenspiegel hat meistens einen Durchmesser von 10 cm und eine Brennweite von 20 mm.“"
                            },
                            {
                                "example_id": "f2039e90-0884-44df-906b-dc20f98feeea",
                                "sense_id": "5d9f908f-6011-38bd-ae89-9c947dc61d9c",
                                "text": "„In beiden Fällen benützt man eine möglichst starke Lichtquelle und einen Ohrenspiegel, den man an der Stirne anbringt.“"
                            },
                            {
                                "example_id": "3989fadf-305f-4110-9d66-86bd24406aaf",
                                "sense_id": "5d9f908f-6011-38bd-ae89-9c947dc61d9c",
                                "text": "„Als Carmichael das Sprechzimmer betrat, sah er gerade in den Ohrenspiegel, den er auf das Ohr eines Patienten gerichtet hatte.“"
                            },
                            {
                                "example_id": "d733894f-a6fd-450f-b0a7-1ab552cd4afd",
                                "sense_id": "5d9f908f-6011-38bd-ae89-9c947dc61d9c",
                                "text": "„Unsere medizinische Ausrüstung bestand aus Stethoskop, Ohrenspiegel, Blutdruckmessgerät, Mundspatel, einem Mikroskop und etwa einhundert Basismedikamenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
