                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le violent cyclone a <w>dévasté</w> toute la côte en quelques heures seulement."
                        },
                        {
                            "text": "Les troupes ennemies ont continué à <w>dévaster</w> les champs et les villages voisins."
                        }
                    ],
                    "synonyms": [
                        "détruire",
                        "ravager"
                    ],
                    "common_phrases": [
