                "senses": [
                    {
                        "sense_id": "2c398b69-e661-352f-abd4-3e8c3f4414ca",
                        "entry_id": "17943a56-15df-385c-94f1-375e4c731f1f",
                        "glosses": [
                            "mit großer Wucht einhergehender, sehr starker Wind; Sturm"
                        ],
                        "tags": [
                            "gehoben",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "28b7c862-9626-445c-b488-e8566a45af92",
                                "sense_id": "2c398b69-e661-352f-abd4-3e8c3f4414ca",
                                "text": "„Es dämmerte. Schwere Regenschauer trommelten gegen die Fenster. Der Sturmwind zerrte weiße Rauchfahnen aus den Schornsteinen der Häuser und zerstreute den bittersüßen Geruch von Torffeuern durch den Ort.“"
                            },
                            {
                                "example_id": "6cd43dd0-72e4-47d6-b04c-21f419f48f13",
                                "sense_id": "2c398b69-e661-352f-abd4-3e8c3f4414ca",
                                "text": "„Was heulst und winselst du, Sturmwind, in meinem Schornstein?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
