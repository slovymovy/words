                ],
                "senses": [
                    {
                        "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                        "entry_id": "36c6d5a9-50a5-3bcc-9b5c-0c94bff49fe2",
                        "glosses": [
                            "Borte/Nahtbesatz/Zierstreifen an Nähten oder Rändern von Kleidungsstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "290f0d83-f9b4-4c82-90ba-fd79a675f79c",
                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                "text": "„An der rechten Seite war ein Stück an der Paspel aufgeschlitzt.“"
                            },
                            {
                                "example_id": "471878ab-ae09-4c1f-8657-3f61970dbe21",
                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                "text": "„Ein in den Stoff geschnittener Tascheneingriff muss von einer Paspel oder einer Patte abgedeckt werden, um die beiden Schnittkanten zu versäubern.“"
                            },
                            {
                                "example_id": "a14df531-022b-4d30-9272-54e896334207",
                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                "text": "„Während er sich bemüht, mich mit seinen Paspeln und Borten, seinen Litzen und Medaillen, seinen Achselschnüren und Goldknöpfen zu beeindrucken, denke ich gerührt an den Bundespolizisten am Eingang des Kanzleramts.“"
                            },
                            {
                                "example_id": "3b1b6eed-c597-4860-8c47-d0b0ef7e71f9",
                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                "text": "„Sie lächelt tatsächlich, als sie das Handy in die Gesäßtasche ihrer Bluejeans mit schmaler silberner Paspel entlang der Beinnaht schiebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
