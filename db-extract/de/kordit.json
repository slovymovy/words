                "senses": [
                    {
                        "sense_id": "78c80a88-afc7-3ba1-b7aa-56010e2486cd",
                        "entry_id": "47aeb931-bc59-3b1d-b503-82b34e421055",
                        "glosses": [
                            "rauchschwaches Schießpulver"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1df5c18-b301-440f-ae2f-5eb46d29f508",
                                "sense_id": "78c80a88-afc7-3ba1-b7aa-56010e2486cd",
                                "text": "„Er sah die Hausnummer auf dem Holzzaun. Sechs. Patronenhülsen, er roch Kordit.“"
                            },
                            {
                                "example_id": "023e335b-6be7-4391-af60-d00d6f19c5a6",
                                "sense_id": "78c80a88-afc7-3ba1-b7aa-56010e2486cd",
                                "text": "„Bei Lockett's blieb er stehen und bestaunte die staubigen Scherzartikel im Schaufenster, kleine Niespulverdosen, mit Kordit versetzte Zigarren, ein aus Blech gestanzter Tintenklecks.“"
                            },
                            {
                                "example_id": "07102246-2afa-4429-9398-9bfc54d6cdc3",
                                "sense_id": "78c80a88-afc7-3ba1-b7aa-56010e2486cd",
                                "text": "„Der Raum war ein Schlachthaus, in dem es nach Kordit stank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
