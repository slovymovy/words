                    {
                        "translation_id": "6204d223-7e3e-4a55-981e-9e2ffdbb2331",
                        "source_entry_id": "9f98b1ba-962a-3047-8478-b917b49bdab8",
                        "target_lang_word": "Abstreicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "03594553-79e1-4a45-a14d-9e216eff32cd",
                        "source_entry_id": "9f98b1ba-962a-3047-8478-b917b49bdab8",
                        "target_lang_word": "Abstreifmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4e37cc37-8337-4b54-be70-ba50535c4465",
                        "source_entry_id": "9f98b1ba-962a-3047-8478-b917b49bdab8",
                        "target_lang_word": "Doktor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doktor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19b0f991-bc0e-3360-a846-36ebca942e6e",
                                        "entry_id": "08226798-e33f-3dcb-b2d2-35cd791b9bed",
                                        "glosses": [
                                            "Person mit medizinischer Ausbildung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811bf2c7-59b1-4b9e-8d03-aaf7a9d58fb7",
                                                "sense_id": "19b0f991-bc0e-3360-a846-36ebca942e6e",
                                                "text": "Ich bin zu meinem Doktor gegangen."
                                            },
                                            {
                                                "example_id": "f7219245-cfe5-4ec9-ae01-71b5b64b6175",
                                                "sense_id": "19b0f991-bc0e-3360-a846-36ebca942e6e",
                                                "text": "Die Frau Doktor hat uns sehr geholfen."
                                            },
                                            {
                                                "example_id": "6f10b4c9-22e0-4c97-af36-757d344df988",
                                                "sense_id": "19b0f991-bc0e-3360-a846-36ebca942e6e",
                                                "text": "„Alle Vorhaltungen, Überzeugungsversuche und Bitten halfen nichts, der Doktor blieb unbeirrbar und lernte in seiner Freizeit seelenruhig Arabisch, Kisuaheli und Mandingo-Dialekte.“"
                                            },
                                            {
                                                "example_id": "c1ffabd5-615e-4efb-bf03-c295c21611fa",
                                                "sense_id": "19b0f991-bc0e-3360-a846-36ebca942e6e",
                                                "text": "„Alle taten desgleichen, der Herr Pfarrer gab eine Art Glucksen von sich, Hurel hustete, dem Doktor liefen die Tränen herunter, seine Frau bekam einen nervösen Lachkrampf – und Foureau, ein Mann, der keine Scheu kannte, brach einen Abd-el-Kader ab und steckte ihn als Andenken in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4c90705-33d9-3c0e-b5f6-9de98e920a29",
                                        "entry_id": "08226798-e33f-3dcb-b2d2-35cd791b9bed",
                                        "glosses": [
                                            "akademischer Grad, den man nach erfolgreicher Promotion und erfolgter Verleihung durch eine Hochschule führen darf"
                                        ],
                                        "tags": [
                                            "Titel",
                                            "Universität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165e21c0-6cd5-475c-b403-88e9338fa738",
                                                "sense_id": "e4c90705-33d9-3c0e-b5f6-9de98e920a29",
                                                "text": "Sie hat ihren Doktor in Philosophie gemacht."
                                            },
                                            {
                                                "example_id": "b184269f-cf03-47bf-956f-80e6e62b5af1",
                                                "sense_id": "e4c90705-33d9-3c0e-b5f6-9de98e920a29",
                                                "text": "„Nachdem er seinen Doktor in der Tasche hatte, unterbrach er seine Studien bei den Pirahã periodisch, um an der Universität von Campinas zu lehren, an der Universität von Pittsburgh die Linguistische Fakultät zu leiten und an der Universität von Manchester in England Vorlesungen zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccce186a-741b-4774-88e9-ac3c97a963e5",
                        "source_entry_id": "9f98b1ba-962a-3047-8478-b917b49bdab8",
                        "target_lang_word": "Farbabstreicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60bda63f-1791-4728-9b70-1d3a46307d3a",
                        "source_entry_id": "9f98b1ba-962a-3047-8478-b917b49bdab8",
                        "target_lang_word": "Rakel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rakel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                                        "entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                                        "glosses": [
                                            "Werkzeug, mit dem man Folien glatt streicht oder abkratzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054fb3a7-2f40-42b7-b106-aa24f7de0b3a",
                                                "sense_id": "c76d44f6-0752-36ae-a770-e3e9ddd121c7",
                                                "text": "Der Dekorateur streicht vorsichtig die Folie mit der Rakel auf dem Schaufenster glatt, während seine Kollegin die Schutzfolie abzieht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a8a71a1b-a553-3a6d-9752-85cd77174246",
                                        "entry_id": "4803a8fa-3e36-3016-8b02-315b54f05a81",
                                        "glosses": [
                                            "flexibles Werkzeug, mit dem überschüssige Farbe von der Druckform abgezogen wird"
                                        ],
                                        "tags": [
                                            "Drucktechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5481ac5c-cba5-4e0d-8cf7-cb2243be4b8a",
                                                "sense_id": "a8a71a1b-a553-3a6d-9752-85cd77174246",
                                                "text": "Beim Tiefdruck dient die Rakel dazu, die überschüssige Druckfarbe von den Stegen des Druckzylinders abzustreifen, so dass nur noch die Näpfchen mit Farbe gefüllt sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b91dcec-936d-4b11-8878-bb2b1dd6d307",
                        "source_entry_id": "9f98b1ba-962a-3047-8478-b917b49bdab8",
                        "target_lang_word": "docteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "docteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a2c0a0-da16-32f3-83c6-b2cc25d143ef",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Personne promue dans une université au grade le plus élevé de quelque faculté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05734643-cafd-444c-ab77-1ab40c8f7304",
                                                "sense_id": "d0a2c0a0-da16-32f3-83c6-b2cc25d143ef",
                                                "text": "M. Pierre-Nicolas Anot, prêtre, docteur en théologie, chanoine, théologal et grand-pénitencier de Reims, est mort le 21 octobre dernier, âgé de près de 61 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6967a5-b86c-3637-88db-9f231b02a5df",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Personne qui professe la médecine et aussi la chirurgie, après avoir acquis le grade de docteur."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7e130df-54d4-3ff5-a188-41b50bc8cae9",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Médecin."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b97a8538-b5f5-4dda-b5b1-72d72f7fa606",
                                                "sense_id": "c7e130df-54d4-3ff5-a188-41b50bc8cae9",
                                                "text": "Ces dames s’adressaient au bon docteur, comme elles l’appelaient ; mais il était plus qu’évident que tout l’édifice du dialogue était élevé en l’honneur du brillant uniforme dont la présence dans l’église des Pénitents faisait événement ce soir-là."
                                            },
                                            {
                                                "example_id": "b1262eba-1afa-48b9-9f3e-c2a21cb69fbd",
                                                "sense_id": "c7e130df-54d4-3ff5-a188-41b50bc8cae9",
                                                "text": "[…] madame d’Aiglemont sourit à l’espoir d’une prompte guérison, et n’opposa plus de résistance à la volonté de son mari, qui la violentait pour lui faire accepter les soins du jeune docteur."
                                            },
                                            {
                                                "example_id": "77e9cd9d-9e71-440e-9fe1-70b206734f2b",
                                                "sense_id": "c7e130df-54d4-3ff5-a188-41b50bc8cae9",
                                                "text": "On se représente difficilement aujourd’hui le prestige dont jouissaient la médecine et les médecins dans le société matérialiste d’il y a trente ans. Le « bon docteur » remplaçait le prêtre, disait-on, et le haute influence morale et sociale appartenait aux maîtres des corps, aux dispensateurs des traitements et régimes."
                                            },
                                            {
                                                "example_id": "ab2e9db6-31a3-4546-96d1-a8f534f71e38",
                                                "sense_id": "c7e130df-54d4-3ff5-a188-41b50bc8cae9",
                                                "text": "Nous sommes de beaux Jacques, allez, de gratifier de plus de trois mille francs ce mauvais docteur là. […] Qui tombe jamais malade ici ? […] Si on l’appelle c’est tout au plus pour le permis d’inhumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d13c0ea-1820-32d7-b855-019f9da62362",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Personne qui est habile en quelque chose que ce soit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "163815ea-dc1b-45c8-a2d2-f17572bff379",
                                                "sense_id": "5d13c0ea-1820-32d7-b855-019f9da62362",
                                                "text": "Faire le docteur."
                                            },
                                            {
                                                "example_id": "8afbf021-d58c-47d5-a550-4c3a741e9430",
                                                "sense_id": "5d13c0ea-1820-32d7-b855-019f9da62362",
                                                "text": "Un ton de docteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51e8fa0-c1bf-34b4-a8d9-e0d27053b064",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Personne donnant des enseignements sur des points de doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb8aa23-599e-494a-b03a-bd51043bbb3b",
                                                "sense_id": "a51e8fa0-c1bf-34b4-a8d9-e0d27053b064",
                                                "text": "Personne ne fut empalé ; de quoi plusieurs docteurs murmurèrent, et en présagèrent la décadence de Babylone."
                                            },
                                            {
                                                "example_id": "adff551a-8eae-4832-b964-e3eb5923b692",
                                                "sense_id": "a51e8fa0-c1bf-34b4-a8d9-e0d27053b064",
                                                "text": "Ainsi, dire, comme les traditionnaires, que les hadiths rapportés à la fois par El-Boukhari et par Moslem sont plus certains que ceux qui ne le sont que par l’un de ces docteurs ; que les hadiths racontés par Moslem sont moins solides que ceux qui sont rapportés par El-Boukhari etc., c’est dire qu’aucun hadith n’est revêtu de la certitude requise pour devenir matière de foi."
                                            },
                                            {
                                                "example_id": "5ecfd638-48b1-497e-a957-b36b26036ba3",
                                                "sense_id": "a51e8fa0-c1bf-34b4-a8d9-e0d27053b064",
                                                "text": "[…] il n’est que trop vrai que mille autres docteurs et religieux ont enseigné la doctrine du pouvoir de l’Église sur le temporel des rois […]"
                                            },
                                            {
                                                "example_id": "b46da05f-930b-4d33-93fa-69223f6e54c6",
                                                "sense_id": "a51e8fa0-c1bf-34b4-a8d9-e0d27053b064",
                                                "text": "[…] les docteurs du Talmud ne donnaient-ils pas eux-mêmes l’exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgerons, ou savetier, ou fabricant d’épingles, etc. ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1860a19-d71d-3a1c-ad23-bd1a992d960d",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Exégète ou commentateur pédant ou oiseux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c670ad8f-a002-44dc-9073-777a43a0fdb8",
                                                "sense_id": "d1860a19-d71d-3a1c-ad23-bd1a992d960d",
                                                "text": "Ces docteurs confondent, par un grossier sophisme, un idéal qui, en tant que non changeant, peut par pure métaphore être qualifié de mort, avec les hommes, les êtres charnels […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "955b6e3f-8673-319f-9ffc-0e4d3c0df416",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Cylindre gravé en creux, destiné à recevoir de l’encre, dans les usines d’impression sur tissu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "748f74b6-f2ef-331f-b288-16570b4f43cc",
                                        "entry_id": "d2bd2d7a-ab6c-3319-9064-4745fad0cf1d",
                                        "glosses": [
                                            "Cylindre destiné à presser la colle sur le cylindre encolleur dans les usines de fabrication de carton ondulé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
