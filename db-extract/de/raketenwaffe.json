                ],
                "senses": [
                    {
                        "sense_id": "aaac3280-c6c8-3fe6-b00a-836885034cd3",
                        "entry_id": "2f292812-4c82-38b7-8845-ab8132217cc0",
                        "glosses": [
                            "als Waffe eingesetzter Flugkörper mit Rückstoßantrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f72c83-c693-4da6-9f93-89a7e3fe6d04",
                                "sense_id": "aaac3280-c6c8-3fe6-b00a-836885034cd3",
                                "text": "„Die Congreve’sche Rakete war eine britische militärische Raketenwaffe, die 1804 vom britischen Artillerieoffizier und Ingenieur Sir William Congreve entworfen und entwickelt wurde.“"
                            },
                            {
                                "example_id": "b84fb03c-358f-477c-a32e-3fc41b0c9c80",
                                "sense_id": "aaac3280-c6c8-3fe6-b00a-836885034cd3",
                                "text": "„So trat von Braun in den Dienst der Reichswehr und späteren Wehrmacht ein und entwickelte während des Zweiten Weltkriegs die erste Raketenwaffe der Welt, die V2.“"
                            },
                            {
                                "example_id": "b31080a8-1777-4c87-924e-a25451a0f5bb",
                                "sense_id": "aaac3280-c6c8-3fe6-b00a-836885034cd3",
                                "text": "„Mit lautem Zischen stob ein Feuerball aus der Raketenwaffe und explodierte in der Höhle.“"
                            },
                            {
                                "example_id": "036529c2-53af-44b1-84e0-23987bc5697e",
                                "sense_id": "aaac3280-c6c8-3fe6-b00a-836885034cd3",
                                "text": "„Der Versager hatte es nicht geschafft, mit den beiden Ladungen der Raketenwaffe den Feind vom Himmel zu holen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
