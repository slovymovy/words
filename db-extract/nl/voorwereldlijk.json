                ],
                "senses": [
                    {
                        "sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                        "entry_id": "8b18a88a-0915-31ce-9d55-4effb3c38bc4",
                        "glosses": [
                            "van iets dat het van heel erg lang geleden is; letterlijk voordat de wereld werd geschapen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b8d731-fb3a-42ea-bc5b-a9b7a0a1e501",
                                "sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                                "text": "Zoals hij daar stond, dinsdagmorgen vroeg, had het gevaarte wel iets weg van een voorwereldlijk monster; klaar voor de aanval."
                            },
                            {
                                "example_id": "e1d082f1-b94c-4baf-8897-980ab6b5ecee",
                                "sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                                "text": "Mediteren is een beetje sterven, vind ik, en erna vind ik het heerlijk dat ik nog leef en een boterham met kaas kan eten, en kan genieten van de voorwereldlijke kreet van de fazant in de tuin."
                            },
                            {
                                "example_id": "bc353127-1b25-4335-b633-0d4fa9d2cd17",
                                "sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                                "text": "Wie hem ooit op zijn droogkomisch-elitaire 78-toeren-kraaktoon heeft horen voordragen of als dj een voorwereldlijke milonga of blues aankondigen in het radioprogramma De Avonden van de VPRO, zal dat niet snel vergeten."
                            },
                            {
                                "example_id": "921537cf-deb4-4117-ba8f-6cee2cf49bea",
                                "sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                                "text": "“En ga in plaats van in een bos eens wandelen door een veengebied, in de Engbertsdijksvenen bijvoorbeeld, ten zuidoosten van het Overijsselse Vechtdal. Zowel op dat Hogeland, met zijn hoge luchten en lage horizonten, als in de Engbertsdijksvenen, met een bijna voorwereldlijk landschap, liggen de foto’s voor het oprapen. Elke foto die je daar maakt, lukt.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b033da1-2a5d-43c2-ab29-3563c7875031",
                        "source_entry_id": "8b18a88a-0915-31ce-9d55-4effb3c38bc4",
                        "source_sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                        "target_lang_word": "prehistoric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prehistoric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "930fc230-cac4-323d-88ad-044b64755a26",
                                        "entry_id": "74863f88-e592-3e21-919e-b7ab0972a6be",
                                        "glosses": [
                                            "Of or relating to the epoch before written record."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16843e8c-5d73-455f-9512-99b53ccca8a6",
                                                "sense_id": "930fc230-cac4-323d-88ad-044b64755a26",
                                                "text": "Was it then in a pre-historic time that the Romans wandered into these lands?"
                                            },
                                            {
                                                "example_id": "56c08f37-6266-41ff-a614-01d134c4ede7",
                                                "sense_id": "930fc230-cac4-323d-88ad-044b64755a26",
                                                "text": "The cartoon image of prehistoric woman being dragged by the hair by her caveman-husband probably conditions the perceptions of archaeologists far more than they realize."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9964f2be-b9eb-3848-ba64-950f52e52956",
                                        "entry_id": "74863f88-e592-3e21-919e-b7ab0972a6be",
                                        "glosses": [
                                            "Ancient; very old, outdated, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "621c0976-4aad-4017-86b8-9b4df3e3a011",
                        "source_entry_id": "8b18a88a-0915-31ce-9d55-4effb3c38bc4",
                        "source_sense_id": "eae32d65-8c9c-39b1-a750-7b31351c27c6",
                        "target_lang_word": "antediluvian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antediluvian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd58b052-6b6b-3fa3-ace3-33a32704e768",
                                        "entry_id": "a7de41dd-8cdb-3514-bad3-50585b46a64e",
                                        "glosses": [
                                            "Belonging or pertaining to, or existing in, the time prior to the great flood described in Genesis, or (by extension) to a great or destructive flood or deluge described in other mythologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0d4416-3b63-46d8-bafe-dd2a5cce0ead",
                                                "sense_id": "cd58b052-6b6b-3fa3-ace3-33a32704e768",
                                                "text": "[P]erhaps ſome perſons might outlive Methuſelah; the Text intending onely the maſculine line of Seth, conduceable unto the Genealogy of our Saviour, and the antediluvian Chronology."
                                            },
                                            {
                                                "example_id": "bf376886-6b80-476e-95a5-6a453299ed9a",
                                                "sense_id": "cd58b052-6b6b-3fa3-ace3-33a32704e768",
                                                "text": "For Noah, vvho had no doubt preach'd againſt the Vices of the Antediluvian VVorld, and againſt Drunkenneſs among the reſt, muſt certainly knovv the Uſe of the Vine, and the Abuſe of it too; hovv elſe did he come to plant it at all, and to preſs the Juice out for Drinking it at all?"
                                            },
                                            {
                                                "example_id": "e876d64e-9c15-4ae9-ae90-119c76d767f3",
                                                "sense_id": "cd58b052-6b6b-3fa3-ace3-33a32704e768",
                                                "text": "The great Egyptian age is but a remnant of the Atlantean culture / The antediluvian kings colonized the world / All the gods who play in the mythological dramas / In all legends from all lands were from fair Atlantis"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09bbf6b2-8123-3c85-b514-81b4b24fd066",
                                        "entry_id": "a7de41dd-8cdb-3514-bad3-50585b46a64e",
                                        "glosses": [
                                            "Of animals and plants: long extinct; prehistoric."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3970225-7177-4692-ab10-af6aa483f00d",
                                                "sense_id": "09bbf6b2-8123-3c85-b514-81b4b24fd066",
                                                "text": "Having already described him [the whale] in most of his present habitatory and anatomical peculiarities, it now remains to magnify him in an archæological, fossiliferous, and antediluvian point of view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de19d46-175c-3e6c-96b7-0fc81405e20e",
                                        "entry_id": "a7de41dd-8cdb-3514-bad3-50585b46a64e",
                                        "glosses": [
                                            "Of a person or thing: very old; ancient."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59f0dc88-0134-47a9-81fe-88109d10c900",
                                                "sense_id": "0de19d46-175c-3e6c-96b7-0fc81405e20e",
                                                "text": "[H]is eldest son Bo-bo, […] let some sparks escape into a bundle of straw, which kindling quickly, spread the conflagration over every part of their poor mansion, till it was reduced to ashes. Together with the cottage (a sorry antediluvian make-shift of a building, you may think it), what was of much more importance, a fine litter of new-farrowed pigs, no less than nine in number, perished."
                                            },
                                            {
                                                "example_id": "181e1503-0bbc-40ae-aa68-3cc6c6347328",
                                                "sense_id": "0de19d46-175c-3e6c-96b7-0fc81405e20e",
                                                "text": "There was an antediluvian tradition (much older than Shakespeare) that on Midsummer's Night young people should go with lanterns, and a fiddler, and a keg or two of cider, to a patch of turf known as Donkey's Green in the heart of the woods and there celebrate the solstice with dancing."
                                            },
                                            {
                                                "example_id": "94b4a75c-8979-48f6-aca7-75a113a31436",
                                                "sense_id": "0de19d46-175c-3e6c-96b7-0fc81405e20e",
                                                "text": "The air inside smelled antediluvian, regal somehow, with traces of pipe tobacco, tea leaves, cooking sherry, and the earthen aroma of stone architecture."
                                            },
                                            {
                                                "example_id": "1bee24fb-a34f-4ac0-9626-f490c5a23521",
                                                "sense_id": "0de19d46-175c-3e6c-96b7-0fc81405e20e",
                                                "text": "If we agree with [Alan] Blinder's assessment, we must acknowledge the pressing need to inject new ideas into an old system—a system so antediluvian that it is, remarkably, still based on the agrarian calendar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3bc5dd7-55a0-3739-9a31-05aa3ff59b22",
                                        "entry_id": "a7de41dd-8cdb-3514-bad3-50585b46a64e",
                                        "glosses": [
                                            "Of attitudes, ideas, etc.: extremely old-fashioned, especially to a laughable extent; antiquated."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef642fc4-d0a3-431a-9d36-19ed684c8d42",
                                                "sense_id": "c3bc5dd7-55a0-3739-9a31-05aa3ff59b22",
                                                "text": "Those ideas are antediluvian."
                                            },
                                            {
                                                "example_id": "53be4b34-683d-4074-88b0-6ee89cc40efd",
                                                "sense_id": "c3bc5dd7-55a0-3739-9a31-05aa3ff59b22",
                                                "text": "If, by any miſchance, and in an evil hour, ſome country couſin, not knovving my vvays, or ſome antediluvian prig, not minding them, happen to fall upon me vvith formal ſpeeches, vvhere I can make no eſcape, a fit of yavvning takes me immediately, and I am demoliſhed for the reſt of the day."
                                            },
                                            {
                                                "example_id": "e9ce3ac3-9801-44ff-8d60-23e2e4fcf9c3",
                                                "sense_id": "c3bc5dd7-55a0-3739-9a31-05aa3ff59b22",
                                                "text": "Portions of the ruling reflected the court's culturally conservative roots, stating that because marriage is only for reproduction, LGBTQ relationships are unnatural because they cannot produce children. […] The ruling continued in its surprisingly antediluvian rationale, invalidating untold numbers of nontraditional families."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
