    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01484c16-1007-3bd8-9470-4178f1c7b5a1",
                    "sense_definition": "Rendre pur en éliminant les impuretés ou les éléments indésirables.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce filtre moderne permet de <w>purifier</w> l'eau du robinet pour la rendre meilleure."
                        },
                        {
                            "text": "Certaines plantes d'intérieur aident à <w>purifier</w> l'air des pièces fermées."
                        }
                    ],
                    "synonyms": [
                        "épurer"
                    ],
                    "common_phrases": [
                        "purifier l'eau",
                        "purifier l'air"
                    ]
                },
                {
                    "sense_id": "6a3b5c4c-bc16-37f3-8443-ad757599dfb5",
                    "sense_definition": "Rendre moralement ou spirituellement pur, débarrasser du mal ou des fautes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spiritualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il cherchait la solitude de la montagne pour <w>purifier</w> son esprit des soucis quotidiens."
                        },
                        {
                            "text": "Une longue méditation quotidienne lui a permis de <w>purifier</w> ses pensées les plus sombres."
                        }
                    ],
                    "common_phrases": [
                        "purifier son âme"
                    ]
                },
                {
                    "sense_id": "49117487-feca-359c-84fa-9c6330f4ce6b",
                    "sense_definition": "Accomplir des rites sacrés pour ôter une souillure rituelle ou rendre consacré.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spiritualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les prêtres ont brûlé de l'encens précieux afin de <w>purifier</w> les lieux saints."
                        },
                        {
                            "text": "Avant le début de la prière, le rituel commandait de <w>purifier</w> l'autel avec de l'eau."
                        }
                    ],
                    "common_phrases": [
                        "purifier un temple"
                    ]
                },
                {
                    "sense_id": "d4b96e28-346b-3ce2-a194-70920c0d80b5",
                    "sense_definition": "Devenir pur ou plus pur, perdre ses éléments étrangers ou nuisibles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En traversant ces couches de roche, l'eau de source se <w>purifie</w> naturellement."
                        },
                        {
                            "text": "Grâce aux exercices de respiration, les poumons se <w>purifient</w> au fil des semaines."
                        }
                    ],
                    "common_phrases": [
                        "se purifier naturellement"
                    ]
                }
            ]
        }
    ]
