                        "glosses": [
                            "Gesamtheit aller Maßnahmen und Organisationen, die der Wahrung des Rechts dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1b87e2f-1315-4747-96a2-5b6dac815322",
                                "sense_id": "1383fbae-e15a-390c-9878-c669c9fb8950",
                                "text": "„Nach unserem Rechtssystem basiert der Schuldbegriff auf dem Prinzip der Willensfreiheit.“"
                            },
                            {
                                "example_id": "514c8fa5-8e28-4d41-b389-487a2924aae1",
                                "sense_id": "1383fbae-e15a-390c-9878-c669c9fb8950",
                                "text": "„Die religiöse Ausrichtung der pakistanischen Verfassung von 1956, die Koran und Scharia zur Grundlage des pakistanischen Rechtssystems erhob, geht vor allem auf den Einfluss von Maududi zurück.“"
                            }
                        ],
