                    {
                        "sense_id": "ce5aa256-d7ee-3063-97df-bef4c070aeeb",
                        "entry_id": "cd61f5e7-84b6-3044-bac2-7efdef2abbfd",
                        "glosses": [
                            "Sorte d'amorce pour la pêche, en usage en Méditerranée occidentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208e7042-de2b-4535-82ad-057f73faf2d6",
                                "sense_id": "ce5aa256-d7ee-3063-97df-bef4c070aeeb",
                                "text": "On prépare un appât, un broumé fait de rate de bœuf hachée, mélangée à des débris de poissons salés avariés."
                            },
                            {
                                "example_id": "48ff4b82-eb8a-4742-844b-2d5863713d5b",
                                "sense_id": "ce5aa256-d7ee-3063-97df-bef4c070aeeb",
                                "text": "Loin des eaux estuariennes mais en haute mer, la grande pêche sportive se rallie parfois à cette situation quand s'ancrant, on recherche thons et bonites au broumé ou requins à la strouille."
                            },
                            {
                                "example_id": "89106e96-3ce2-44f7-bbfa-efe154bc3d10",
                                "sense_id": "ce5aa256-d7ee-3063-97df-bef4c070aeeb",
                                "text": "Le broumé (mélange oh combien odorant !) sera fait le jour même avec du pain, de la bouillie de sardine, de l’huile de sardine, du sable pour alourdir, prévoir un sac en toile de jute avec éventuellement un poids. Dès le mouillage effectué, cette mixture doit être introduite dans le sac et mouillée à son tour sous le bateau."
                            }
                        ]
                    }
