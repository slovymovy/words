                ],
                "senses": [
                    {
                        "sense_id": "212bd33f-7053-3e5a-9e00-d44df804a5da",
                        "entry_id": "7a5bcc29-6b3b-3ab8-8cc0-8b817c9134a2",
                        "glosses": [
                            "Qui fait preuve de bienveillance, de bonté indulgente."
                        ],
                        "tags": [
                            "literary",
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1ee36863-3584-4cbc-8f4c-8b5ddf736c6a",
                                "sense_id": "212bd33f-7053-3e5a-9e00-d44df804a5da",
                                "text": "[…] on forma un fonds destiné à procurer des pommes de terre et autres provisions indispensables, aux prisonniers pauvres et à leurs familles, et l’on trouve à toutes les portes, des boites où les personnes bénévolentes peuvent jeter leurs contributions volontaires pour ajouter à ce fonds."
                            },
                            {
                                "example_id": "8f005c14-a3a5-458b-b59b-e554815fba50",
                                "sense_id": "212bd33f-7053-3e5a-9e00-d44df804a5da",
                                "text": "Ce sont des gendarmes de zone rurale, se dit, bénévolent, Jasselin. Habilités à verbaliser un excès de vitesse, une fraude minime à la carte bleue."
                            },
                            {
                                "example_id": "163e0bfd-40a7-4013-8809-2e9439038390",
                                "sense_id": "212bd33f-7053-3e5a-9e00-d44df804a5da",
                                "text": "Dans une analyse de jeux stratégiques de long terme sur un marché avec investissement, le papier analyse comment une entreprise bénévolente peut parvenir à corriger les effets de stratégies de restriction d’investissement."
                            },
                            {
                                "example_id": "f6b64ca5-7129-410f-b896-7d5dc9dc23d2",
                                "sense_id": "212bd33f-7053-3e5a-9e00-d44df804a5da",
                                "text": "Nous pouvons donc ressentir une présence bénévolente, aimante, sage, ou même avoir une vision ou entendre une voix qui nous guide. Ce sont des expériences que j’appelle « divines »."
                            },
                            {
                                "example_id": "d2308b25-fb85-42d2-ab80-aaeb2e4c5e5d",
                                "sense_id": "212bd33f-7053-3e5a-9e00-d44df804a5da",
                                "text": "Gewecke ressemblait plus à un bénévolent aïeul qu’à un tueur, nous nous quittâmes, de sa part du moins, presque à regret."
                            }
                        ]
                    }
                ],
