                    "sense_id": "0ad7e6de-54a0-3b06-a291-e4376ae71fb8",
                    "sense_definition": "Rendre meilleur ou de meilleure qualité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rendre_meilleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque jour, il fait des exercices pour <w>améliorer</w> son français.",
                            "target_lang_translations": {
                                "en": "Every day, he does exercises to <w>improve</w> his French.",
                                "ru": "Каждый день он делает упражнения, чтобы <w>улучшить</w> свой французский.",
                                "de": "Jeden Tag macht er Übungen, um sein Französisch zu <w>verbessern</w>.",
                                "es": "Todos los días hace ejercicios para <w>mejorar</w> su francés.",
                                "zh": "他每天都做练习，想<w>改进</w>自己的法语。"
                            }
                        },
                        {
                            "text": "Le gouvernement cherche de nouvelles solutions pour <w>améliorer</w> la situation économique.",
                            "target_lang_translations": {
                                "en": "The government is looking for new solutions to <w>improve</w> the economic situation.",
                                "ru": "Правительство ищет новые решения, чтобы <w>улучшить</w> экономическую ситуацию.",
                                "de": "Die Regierung sucht nach neuen Lösungen, um die wirtschaftliche Lage zu <w>verbessern</w>.",
                                "es": "El gobierno busca nuevas soluciones para <w>mejorar</w> la situación económica.",
                                "zh": "政府正在寻找新的办法来<w>改善</w>经济形势。"
                            }
