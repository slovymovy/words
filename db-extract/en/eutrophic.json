                "senses": [
                    {
                        "sense_id": "abcb4c38-5290-3eb5-9820-d6997b363650",
                        "entry_id": "de98452b-48af-3efc-a7e3-a2e01031f535",
                        "glosses": [
                            "Being rich in nutrients and minerals and therefore having an excessive growth of algae and thus a diminished oxygen content to the detriment of other organisms."
                        ],
                        "tags": [
                            "of a body of water"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7475bd3e-78f2-3372-bd82-0b53b048170a",
                        "entry_id": "de98452b-48af-3efc-a7e3-a2e01031f535",
                        "glosses": [
                            "Promoting nutrition."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00264119-b6e8-4bf1-affc-57b9de2d32cb",
                        "source_entry_id": "de98452b-48af-3efc-a7e3-a2e01031f535",
                        "source_sense_description": "rich in nutrients",
                        "target_lang_word": "eutrophisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eutrophisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d83f0ec-e8b1-3422-8aff-71e15b8539f3",
                                        "entry_id": "f5392a91-6edb-3859-a1f1-308c8efbfba9",
                                        "glosses": [
                                            "nährend, nährstoffreich, gut genährt, in normal gutem Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02c20fae-a682-46a1-8be1-a49b7b69309a",
                                                "sense_id": "1d83f0ec-e8b1-3422-8aff-71e15b8539f3",
                                                "text": "„Ich glaube daher behaupten zu können, dass das Vitamin E. gerade so wie es im Weizenkeimöl erscheint, auch eine eutrophische Fähigkeit besitzt.“"
                                            },
                                            {
                                                "example_id": "47b0d301-43d4-41db-816c-7b7ad9470629",
                                                "sense_id": "1d83f0ec-e8b1-3422-8aff-71e15b8539f3",
                                                "text": "„Von wenigen Versagern abgesehen, hat die Speckdiät namentlich bei Ekzemkrankheiten der Säuglinge und Kleinkinder eine unverkennbare eutrophische Wirkung.“"
                                            },
                                            {
                                                "example_id": "4449d674-141c-43c6-ad94-1ba3a46cdb0b",
                                                "sense_id": "1d83f0ec-e8b1-3422-8aff-71e15b8539f3",
                                                "text": "„Das eutrophische Stadium kann durch eine Reihe von Umständen in ein offenes Mangelstadium übergehen und schließlich kann Kachexie und Tod erfolgen.“"
                                            },
                                            {
                                                "example_id": "00d6a742-47d6-46c6-9aa8-1fb52848df5a",
                                                "sense_id": "1d83f0ec-e8b1-3422-8aff-71e15b8539f3",
                                                "text": "„Wahrscheinlich schon sehr früh im Altpleistozän, vielleicht schon früher, hatten Homo oder seine unmittelbaren Vorfahren die eutrophische Grenze ihres Verbreitungsgebietes immer tiefer in dieienigen Gebiete vorgeschoben.“"
                                            },
                                            {
                                                "example_id": "875f7f55-5c52-4422-a95c-0d6e9acb96a5",
                                                "sense_id": "1d83f0ec-e8b1-3422-8aff-71e15b8539f3",
                                                "text": "„In den Bruchversumpfungen dominieren etwas eutrophischere Moosarten, die sich auf den moosfreien Teilen der Versumpfungen nicht auszubreiten scheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c8a50ef-8df8-47bd-9cb8-b2bea5553031",
                        "source_entry_id": "de98452b-48af-3efc-a7e3-a2e01031f535",
                        "source_sense_description": "rich in nutrients",
                        "target_lang_word": "nährstoffreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nährstoffreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3a7ae86-fc16-3336-9e32-303b1c48ef57",
                                        "entry_id": "9b020e94-eab5-3223-b908-2b8ddd10a8fa",
                                        "glosses": [
                                            "reich an, mit viel Nährstoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d86630b-5991-437a-9b2b-8057e9ee779c",
                                                "sense_id": "f3a7ae86-fc16-3336-9e32-303b1c48ef57",
                                                "text": "In der Senke befindet sich ein nährstoffreicher Teich."
                                            },
                                            {
                                                "example_id": "537e820d-55dc-4e93-93d4-c796e173cedc",
                                                "sense_id": "f3a7ae86-fc16-3336-9e32-303b1c48ef57",
                                                "text": "„Man unterscheidet die flachen meist nährstoffreichen Niedermoore, in denen verschiedene Laubmoose, vor allem aber Seggen und Binsen wachsen, und die und die nährstoffarmen, in der Mitte uhrglasartig aufgewölbten Hochmoore, auf denen vor allem Torfmoose gedeihen.“"
                                            },
                                            {
                                                "example_id": "94796c37-b85c-4cd3-a786-2495d0b7233a",
                                                "sense_id": "f3a7ae86-fc16-3336-9e32-303b1c48ef57",
                                                "text": "„Auf 700.000 Jahre nach dem Einschlag datieren die ältesten Belege für die nährstoffreiche Pflanzenfamilie der Hülsenfrüchtler.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
