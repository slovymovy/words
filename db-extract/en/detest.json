                        "sense_id": "ecf86e47-7ad0-3285-84ab-f3f2262f62c6",
                        "entry_id": "5f169730-f9c2-3811-9c10-4e2c11598f7c",
                        "glosses": [
                            "To dislike (someone or something) intensely; to loathe."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ef94fd80-ec7f-41c0-b764-22c1ce3fbb27",
                                "sense_id": "ecf86e47-7ad0-3285-84ab-f3f2262f62c6",
                                "text": "I detest snakes."
                            },
                            {
                                "example_id": "0b2bebc9-7dc4-4bef-9f7d-b0ad0e3b6d43",
                                "sense_id": "ecf86e47-7ad0-3285-84ab-f3f2262f62c6",
                                "text": "Who dares think one thing, and another tell, / My heart detests him as the gates of hell."
                            },
                            {
                                "example_id": "ed0e4295-9ed3-4e64-a141-7fbfc4ff88c9",
                                "sense_id": "ecf86e47-7ad0-3285-84ab-f3f2262f62c6",
                                "text": "Nurse Cramer had a cute nose and a radiant, blooming complexion dotted with fetching sprays of adorable freckles that Yossarian detested."
                            }
                        ]
                    },
                    {
                        "sense_id": "aae4ec24-ab13-343d-8921-6f883387c6c9",
                        "entry_id": "5f169730-f9c2-3811-9c10-4e2c11598f7c",
                        "glosses": [
                            "To witness against; to denounce; to condemn."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cf86b69d-58bf-4141-b35c-1e4f8341bcb8",
                                "sense_id": "aae4ec24-ab13-343d-8921-6f883387c6c9",
                                "text": "The heresy of Nestorius […] was detested in the Eastern churches."
                            },
                            {
                                "example_id": "9bd7a88b-6265-4580-bdaa-ad07097c7fac",
                                "sense_id": "aae4ec24-ab13-343d-8921-6f883387c6c9",
                                "text": "God hath detested them with his own mouth."
                            }
                        ]
                    }
