    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d0fec2c5-463a-3e58-8d4c-ed7112b87a82",
                "word": "zoneless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "904d897a-c14c-3822-8d6e-e8b5a4f9912a",
                        "entry_id": "d0fec2c5-463a-3e58-8d4c-ed7112b87a82",
                        "glosses": [
                            "Without zones; unzoned."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a41edede-a352-4890-91e7-ac3cc8a32195",
                                "sense_id": "904d897a-c14c-3822-8d6e-e8b5a4f9912a",
                                "text": "In this style of defense he is the one zoneless player, being able to cross into either of the zones as he is needed."
                            },
                            {
                                "example_id": "c46e7925-3b6e-4c5d-b697-44ab72eb733b",
                                "sense_id": "904d897a-c14c-3822-8d6e-e8b5a4f9912a",
                                "text": "1988, Aniko Varpalotai, “Ringette: The Sport for Girls,” Orbit, Ontario Institute for Studies in Education, Volume 19, No. 3, October 1988, p. 10,\n[…] ringette players are agitating for zoneless play which would make the game faster and more demanding."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4a5b606-8c2b-3adb-98d0-9f9436da2a65",
                        "entry_id": "d0fec2c5-463a-3e58-8d4c-ed7112b87a82",
                        "glosses": [
                            "Without a belt or girdle."
                        ],
                        "tags": [
                            "archaic",
                            "literary",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "27c1a961-d7cc-45cd-8fa4-37d92645f858",
                                "sense_id": "d4a5b606-8c2b-3adb-98d0-9f9436da2a65",
                                "text": "Clos’d was her eye, and from her heaving breast\nIn careless folds loose flow’d her zoneless vest;"
                            },
                            {
                                "example_id": "e0a0b5bc-189b-4de4-b3aa-7a0b2f604f04",
                                "sense_id": "d4a5b606-8c2b-3adb-98d0-9f9436da2a65",
                                "text": "Thou art not known where pleasure is adored,\nThat reeling goddess with the zoneless waist\nAnd wand’ring eyes, still leaning on the arm\nOf novelty, her fickle frail support;"
                            }
                        ]
                    },
                    {
                        "sense_id": "399c7e81-3ef3-3d03-87cd-14e023458a49",
                        "entry_id": "d0fec2c5-463a-3e58-8d4c-ed7112b87a82",
                        "glosses": [
                            "Lacking bands or rings (particularly with reference to fungi)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
