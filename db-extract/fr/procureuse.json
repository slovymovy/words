                                    {
                                        "sense_id": "a3defe97-85fb-3e9a-b1b9-d6f83bbbc42c",
                                        "entry_id": "886837a9-d09e-34f2-85bc-8aa41b9c45cf",
                                        "glosses": [
                                            "weibliche Person, die im Gericht die Anklage vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cede7f5-5baa-4326-9b08-a52ed988cb73",
                                                "sense_id": "a3defe97-85fb-3e9a-b1b9-d6f83bbbc42c",
                                                "text": "Die Anklägerin beschuldigte den Angeklagten schwer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b414cc8d-b197-429f-b80f-76282fb1e980",
                        "source_entry_id": "caefb607-5121-3796-a4ad-ecd73cc83f7c",
                        "source_sense_id": "8639362b-e44a-3076-8762-0573ebec74eb",
