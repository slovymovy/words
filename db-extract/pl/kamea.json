                                "target_senses": [
                                    {
                                        "sense_id": "990a19d3-e45a-386c-8404-8aab71898e8c",
                                        "entry_id": "1604dc17-1a23-3d41-a7b1-dc3df8a93119",
                                        "glosses": [
                                            "Ónice u otra piedra preciosa, con una figura tallada en relieve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c35493-feac-4326-b961-d35b970762f1",
                                                "sense_id": "990a19d3-e45a-386c-8404-8aab71898e8c",
                                                "text": "¡Oh, célebre museo y plausible teatro de toda esta antigua griega y romana cultura, así en estatuas como en piedras, ya en sellos anulares, ya en monedas, vasos, urnas, láminas y camafeos, el de nuestro mayor amigo, el culto y erudito don Vincencio Juan de Lastanosa, honor de los romanos por su memoria, gloria de los aragoneses por su ingenio!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e81eacfb-01d9-4110-b275-e2291358c8d3",
                        "source_entry_id": "248e3000-ee3a-377e-b98e-2672aa4479a8",
