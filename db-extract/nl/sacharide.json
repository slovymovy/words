                                "target_senses": [
                                    {
                                        "sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                                        "entry_id": "b468bc10-5f75-34b3-8fcb-60e6d7132c88",
                                        "glosses": [
                                            "The unit structure of carbohydrates, of general formula CₙH₂ₙOₙ. Either the simple sugars or polymers such as starch and cellulose. The saccharides exist in either a ring or short chain conformation, and typically contain five or six carbon atoms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f87a93d-f605-472f-b770-1cccc14a238d",
                                                "sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                                                "text": "Holonyms: monosaccharide, oligosaccharide, polysaccharide"
                                            },
                                            {
                                                "example_id": "5b49a14f-f701-44ef-92ce-db04a3d08c42",
                                                "sense_id": "761f1c91-8df9-346f-b0ac-1a4ebe09b0d4",
                                                "text": "The saccharides include such substances as dextrose and levulose, which are typical examples of the two classes into which these bodies are divisible, viz. the Aldoses and Ketoses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc7c1f5f-929a-4246-a00e-97af867c89ff",
                        "source_entry_id": "6c7c9b45-154a-3212-86ff-41e0240bda99",
                        "source_sense_id": "184b85ce-0d6a-3308-bbe4-5373fb922b98",
