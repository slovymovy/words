                                            "formal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d67c2577-b7af-4a7c-9f42-bf03604f147d",
                        "source_entry_id": "3343d30b-3d87-35a4-95cd-d14f4c4fc817",
                        "source_sense_description": "воспринимающий, тот, кто слушает",
                        "target_lang_word": "hearer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hearer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d42bf0-9744-376d-a3f4-825a2e285889",
                                        "entry_id": "1db29d71-5fb8-3e80-97f0-6193435ec67b",
                                        "glosses": [
                                            "One who hears."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6992b84-6aba-465a-a200-d96c87aee9af",
                                                "sense_id": "16d42bf0-9744-376d-a3f4-825a2e285889",
                                                "text": "Defaultism\nThe defaultist view is that some conversational implicatures are default inferences—presumptive meanings—that the hearer makes unless given reason not to by the speaker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52d573d-af94-3be8-8db5-7238eb9d85e4",
                                        "entry_id": "1db29d71-5fb8-3e80-97f0-6193435ec67b",
                                        "glosses": [
                                            "A person who regularly attends sermons; a devout listener."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07ac9e7e-48cc-44c2-a6b3-4214e9927b27",
                                                "sense_id": "b52d573d-af94-3be8-8db5-7238eb9d85e4",
                                                "text": "Whilst Mr. Taale was priest in Osteröe, it happened that one of his hearers was carried away and returned again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "743b509e-e175-4667-a779-5a6b8c995637",
                        "source_entry_id": "3343d30b-3d87-35a4-95cd-d14f4c4fc817",
                        "source_sense_description": "воспринимающий, тот, кто слушает",
                        "target_lang_word": "auditeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auditeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50b1c07b-75b5-3e79-9377-7577aa850383",
                                        "entry_id": "101ef7ef-808e-3a97-a184-79868352c59a",
                                        "glosses": [
                                            "Homme qui écoute un discours, une émission radiophonique, une lecture, un récit, une leçon, une exécution musicale, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1220c2f5-6b15-4b55-a0c7-974fe6e44057",
                                                "sense_id": "50b1c07b-75b5-3e79-9377-7577aa850383",
                                                "text": "Il s'agissait de conférences et de parlottes défaitistes, au cours desquelles il était donné lecture de fragments de séances parlementaires en comité secret, considérés comme aptes à démoraliser les auditeurs, et aussi de tracts et de brochures progermaniques."
                                            },
                                            {
                                                "example_id": "1a1425df-c957-423e-a541-14cf85d7d228",
                                                "sense_id": "50b1c07b-75b5-3e79-9377-7577aa850383",
                                                "text": "La musique exprime les sentiments, mais elle serait bien empêchée de les définir, et, sans le commentaire des paroles, absent de la musique instrumentale, l’auditeur reste toujours dans un certain vague quant à la nature et à l’objet du sentiment dont s’est inspiré le musicien."
                                            },
                                            {
                                                "example_id": "212e6301-7038-4258-a731-f6292432b24d",
                                                "sense_id": "50b1c07b-75b5-3e79-9377-7577aa850383",
                                                "text": "L'amour que le poète se plaît à chanter, revêt alors une particulière authenticité à laquelle l’auditeur ne saurait rester indifférent : le jeu grâce auquel cet amour s’exprime, le fait valoir en tant que sentiment et vie, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a5ca56f-3cb6-3eda-8be1-d69f5222b4ca",
                                        "entry_id": "101ef7ef-808e-3a97-a184-79868352c59a",
                                        "glosses": [
                                            "Étudiant qui assiste aux cours sans avoir le titre d’élève, dans certaines grandes écoles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a995b8-3d89-449a-8e62-bda988255a2a",
                                                "sense_id": "9a5ca56f-3cb6-3eda-8be1-d69f5222b4ca",
                                                "text": "Un auditeur libre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b508710d-a44c-35f5-ada6-8b44f57df8a6",
                                        "entry_id": "101ef7ef-808e-3a97-a184-79868352c59a",
                                        "glosses": [
                                            "Titre de certains officiers de judicature qui assistaient aux audiences d’une cour d’appel ou d’un tribunal de première instance, mais qui n’avaient pas voix délibérative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84be5e04-d467-3679-8f1c-64e3e574e7e5",
                                        "entry_id": "101ef7ef-808e-3a97-a184-79868352c59a",
                                        "glosses": [
                                            "Titre de certains fonctionnaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57285e81-bb57-4c66-8104-be4b89684ddb",
                                                "sense_id": "84be5e04-d467-3679-8f1c-64e3e574e7e5",
                                                "text": "Auditeur au Conseil d’État : membre de cette juridiction, recruté par concours, qui occupe le poste au dessous de maitre des requêtes."
                                            },
                                            {
                                                "example_id": "271fd935-026f-4171-bf26-ea79c81e4b9e",
                                                "sense_id": "84be5e04-d467-3679-8f1c-64e3e574e7e5",
                                                "text": "Auditeur à la Cour des comptes : membre de la cour des comptes qui occupe le poste au-dessous de Référendaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "462f9bbb-97c2-3317-a821-16642bb934c8",
                                        "entry_id": "101ef7ef-808e-3a97-a184-79868352c59a",
                                        "glosses": [
                                            "Titre de charge ou d’emploi, dans certains pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d6d66d-094b-448c-89a4-3a5f255e4ee5",
                                                "sense_id": "462f9bbb-97c2-3317-a821-16642bb934c8",
                                                "text": "L’auditeur d’un cardinal. Auditeur de la nonciature. Auditeur de rote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1489cc60-97b5-39b9-8655-68f254124198",
                                        "entry_id": "101ef7ef-808e-3a97-a184-79868352c59a",
                                        "glosses": [
                                            "Homme chargé de la réalisation d’un audit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70a3c9e0-dfe0-4177-b685-541236a5aeaf",
                                                "sense_id": "1489cc60-97b5-39b9-8655-68f254124198",
                                                "text": "En regardant de plus près, ils s’aperçoivent alors que tous les produits étaient périmés depuis longtemps. Le \"partenaire\" coréen avait \"arrosé\" l’auditeur lors de l'estimation comptable de l’apport en capital."
                                            },
                                            {
                                                "example_id": "5486c15f-2e56-4219-8354-ee004a693f5a",
                                                "sense_id": "1489cc60-97b5-39b9-8655-68f254124198",
                                                "text": "Si quelques pages restent à finaliser (pompes à chaleur, photovoltaïque, bois, ventilation et chaudières haute performance actuellement en relecture à l’Association française du gaz), les auditeurs s’y sont déjà confrontés et n’ont pas manqué d’exprimer leurs remarques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "auditeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd6a486-cb7c-3d94-b7cc-05cbf88fe815",
                                        "entry_id": "296fcb03-d0f1-3450-bcab-9ff6f5363a08",
                                        "glosses": [
                                            "Qui écoute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d02041-966c-40ba-9f70-cc8f3a707dec",
                                                "sense_id": "bdd6a486-cb7c-3d94-b7cc-05cbf88fe815",
                                                "text": "Juge auditeur, conseiller auditeur."
                                            },
                                            {
                                                "example_id": "c60fd5cc-458e-41bb-81b1-d4d62f10e4b7",
                                                "sense_id": "bdd6a486-cb7c-3d94-b7cc-05cbf88fe815",
                                                "text": "Les juges auditeurs sont aujourd’hui supprimés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1df4ad92-86ef-4c33-b8e1-924720fadd22",
                        "source_entry_id": "3343d30b-3d87-35a4-95cd-d14f4c4fc817",
                        "source_sense_description": "студент",
                        "target_lang_word": "student",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "student",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                        "entry_id": "900e9f36-1942-3cd1-ba3d-2b38aebff53c",
                                        "glosses": [
                                            "A person who studies or learns about a particular subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2f98bb-92b6-41d3-8ffa-09a04019519f",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "She is a student of human interactions."
                                            },
                                            {
                                                "example_id": "2a61a31f-8e73-4645-b81e-cbfc82f587dc",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "He is a student of life."
                                            },
                                            {
                                                "example_id": "9bc625f9-c6ce-4d2c-940e-dbe829103b44",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "I am not tall enough to become the function well, nor leane enough to bee thought a good Studient : but to be ſaid an honeſt man and a good houſkeeper goes as fairely, as to ſay, a carefull man, & a great ſcholler. The Competitors enter."
                                            },
                                            {
                                                "example_id": "87b0e656-bc67-4361-bc02-80853055f320",
                                                "sense_id": "6ce892b3-d1d3-3db6-b46f-b57022283a4f",
                                                "text": "The student of marine life in Southern California should become aware that […] a great many changes have taken place during the past century that have modified the characters of the plant and animal communities of the seashore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                        "entry_id": "900e9f36-1942-3cd1-ba3d-2b38aebff53c",
                                        "glosses": [
                                            "A person who is formally enrolled at a school, a college or university, or another educational institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905bf065-8154-4ddf-b033-f5feab77e550",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "The students were out raising funds for rag week."
                                            },
                                            {
                                                "example_id": "6c54da99-58c3-4646-b80e-b2946778ffd4",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "In general, alſo, it may be obſerved, that a greater degree of gentility is affixed to the character of a ſtudent in England than elſewhere ; by which means our clergy have an opportunity of ſeeing better company while young, and of ſooner wearing off thoſe prejudices which they are apt to imbibe even in the beſt regulated univerſities, and which may be juſtly termed the vulgar errors of the wiſe."
                                            },
                                            {
                                                "example_id": "a141275a-c593-433c-aa45-067a287b35fe",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "In behalf of manhood and common sense, he would protest against such a conclusion ; and if any pale student, glued to his desk here, seek an apology for a way of life whose natural fruit is that pallid and emasculate scholarship of which New England has had too many examples, it will be far better that this sketch had not been written."
                                            },
                                            {
                                                "example_id": "fd7c2f54-fb90-4ac0-b6ab-73725633c4bd",
                                                "sense_id": "8f048fc0-2abb-3120-89c6-1e9d97f3b23b",
                                                "text": "A handful of young students bent on showing their patriotism had stirred up more trouble than they possibly could have imagined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e9b937f-10c4-35dc-bec1-b9069c7173e8",
                                        "entry_id": "900e9f36-1942-3cd1-ba3d-2b38aebff53c",
                                        "glosses": [
                                            "A person who is formally enrolled at a school, a college or university, or another educational institution.",
                                            "A person who is enrolled at a college or university (as contrasted with a pupil or schoolchild attending a primary or secondary school)."
                                        ],
                                        "tags": [
                                            "in particular"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
