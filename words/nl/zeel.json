            "senses": [
                {
                    "sense_id": "9c56c548-00b1-331e-a556-4d008c09cd83",
                    "sense_definition": "Een dik touw of koord.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "touwwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schipper bond de boot vast met een stevig <w>zeel</w> aan de steiger.",
                            "target_lang_translations": {
                                "ru": "Шкипер привязал лодку к причалу крепким <w>канатом</w>."
                            }
                        },
                        {
                            "text": "In het oude pakhuis hingen nog verschillende dikke <w>zelen</w> aan het plafond.",
                            "target_lang_translations": {
                                "ru": "В старом складе с потолка всё ещё свисало несколько толстых <w>верёвок</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "touw",
                        "koord",
                        "zeelband"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "verouderd woord voor touw of koord"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстая верёвка или канат (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канат",
                                "target_lang_sense_clarification": "толстая прочная верёвка"
                            },
                            {
                                "target_lang_word": "верёвка",
                                "target_lang_sense_clarification": "прочный шнур, бечёвка"
                            },
                            {
                                "target_lang_word": "бечёва",
                                "target_lang_sense_clarification": "толстая верёвка, канат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f860b838-8812-3f4f-869e-a43c85b3de58",
                    "sense_definition": "Een sterke, brede band of riem waarmee men lasten voorttrekt of vastbindt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "touwwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeiders sloegen de handen aan het <w>zeel</w> om de zware trekschuit vooruit te trekken.",
                            "target_lang_translations": {
                                "ru": "Рабочие взялись за <w>лямку</w>, чтобы тащить тяжёлую баржу вперёд."
                            }
                        },
                        {
                            "text": "Het paard droeg een stevig <w>zeel</w> over de borst om de wagen door de modder te slepen.",
                            "target_lang_translations": {
                                "ru": "На груди лошади была надета прочная <w>постромка</w>, чтобы тащить телегу по грязи."
                            }
                        }
                    ],
                    "synonyms": [
                        "trekgordel",
                        "trekband"
                    ],
                    "common_phrases": [
                        "de hand aan het zeel slaan"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "voornamelijk historisch gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочный широкий ремень, лямка или постромка для тяги или крепления груза (историческое)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лямка",
                                "target_lang_sense_clarification": "широкий ремень через плечо или грудь для тяги"
                            },
                            {
                                "target_lang_word": "постромка",
                                "target_lang_sense_clarification": "ремень упряжи для тяги повозки"
                            },
                            {
                                "target_lang_word": "гуж",
                                "target_lang_sense_clarification": "тяговый ремень или петля"
                            }
                        ]
                    }
                }
            ]
        }
