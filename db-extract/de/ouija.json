                    },
                    {
                        "translation_id": "c0202c29-47b0-40ec-8c58-bf81d259ba1f",
                        "source_entry_id": "5f72f367-313c-359e-a259-b82a3f6c8c27",
                        "source_sense_id": "6e42bb1f-9f23-3fc5-b283-2619074ccd2c",
                        "source_sense_description": "Tafel, die vorgeblich dazu dient, mit Geistern zu kommunizieren",
                        "target_lang_word": "Ouija board",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ouija board",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12ab704f-60fb-3ef4-b3a5-178b13882877",
                                        "entry_id": "b9b6eaa0-0e71-3124-ae94-a10648cbe001",
                                        "glosses": [
                                            "A tabletop model of the individual aircraft and their locations on a carrier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4772fdd1-872d-392d-b6f6-3b336659f70f",
                                        "entry_id": "b9b6eaa0-0e71-3124-ae94-a10648cbe001",
                                        "glosses": [
                                            "Synonym of Ouija (“a board used to try to communicate with spirits”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f42a28-2630-4716-b90a-271a82c59ff5",
                                                "sense_id": "4772fdd1-872d-392d-b6f6-3b336659f70f",
                                                "text": "Archie forces himself across the floor to see what the Ouija board is spelling out."
                                            },
                                            {
                                                "example_id": "3f0168f2-9a3e-4e75-8665-8f912edbc34c",
                                                "sense_id": "4772fdd1-872d-392d-b6f6-3b336659f70f",
                                                "text": "These, then, are the usual means by which we receive psychic messages, though table tilting, ouija boards, glasses upon a smooth surface, or anything which can be moved by the vital animal-magnetic force already discussed will equally serve the purpose."
                                            },
                                            {
                                                "example_id": "5ac4ba2f-28e5-4ec8-8ce9-654e0c0c5b78",
                                                "sense_id": "4772fdd1-872d-392d-b6f6-3b336659f70f",
                                                "text": "Ouija board / Would you work for me? / I have got to say \"Hello\" / To an old friend"
                                            },
                                            {
                                                "example_id": "45d1022b-f2c9-4efe-9929-23b9c69a65dc",
                                                "sense_id": "4772fdd1-872d-392d-b6f6-3b336659f70f",
                                                "text": "She had an intuition that the A.I. chatbot might be able to channel communications with her subconscious or a higher plane, “like how Ouija boards work,” she said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
