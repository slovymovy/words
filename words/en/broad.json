                        {
                            "text": "Using a <w>broad</w> helps to eliminate harsh shadows in the studio.",
                            "target_lang_translations": {
                                "ru": "Использование <w>широкоизлучателя</w> помогает устранить резкие тени в студии."
                            }
                        }
                    ],
                    "synonyms": [
                        "floodlight"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in cinematography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип прожектора, используемого в фотографии или кино для обеспечения равномерного освещения."
                    },
                    "translations": {
                        "ru": [
