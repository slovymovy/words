{
    "word_family": [
        "występ",
        "wystąpienie",
        "wstępować",
        "postępować"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70028323-3980-3d47-abbc-a7feaccf0834",
                    "sense_definition": "odgrywać rolę lub prezentować program artystyczny przed publicznością na scenie, w filmie lub telewizji",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sztuka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znany aktor bardzo chętnie <w>występuje</w> w teatrze dramatycznym.",
                            "target_lang_translations": {
                                "ru": "Известный актёр с большим удовольствием <w>играет</w> в драматическом театре."
                            }
                        },
                        {
                            "text": "Młodzi muzycy z całej Polski często <w>występują</w> na scenie tego klubu.",
                            "target_lang_translations": {
                                "ru": "Молодые музыканты со всей Польши часто <w>выступают</w> на сцене этого клуба."
                            }
                        }
                    ],
                    "synonyms": [
                        "prezentować się",
                        "produkować się"
                    ],
                    "common_phrases": [
                        "występować na scenie",
                        "występować w filmie",
                        "występować w teatrze"
                    ],
                    "target_lang_definitions": {
                        "ru": "играть роль или представлять художественную программу перед зрителями на сцене, в кино или на телевидении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "на сцене, перед публикой"
                            },
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "в театре или кино"
                            },
                            {
                                "target_lang_word": "сниматься",
                                "target_lang_sense_clarification": "в кино или на телевидении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6246d89-301f-3da5-84a5-7c3d15b8154e",
                    "sense_definition": "znajdować się, zdarzać się lub być obecnym w określonym miejscu lub czasie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obecność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten rzadki gatunek ptaka naturalnie <w>występuje</w> tylko w puszczach na wschodzie kraju.",
                            "target_lang_translations": {
                                "ru": "Этот редкий вид птиц в естественной среде <w>встречается</w> только в пущах на востоке страны."
                            }
                        },
                        {
                            "text": "W starych dokumentach bardzo powszechnie <w>występują</w> błędy językowe.",
                            "target_lang_translations": {
                                "ru": "В старых документах весьма часто <w>попадаются</w> языковые ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "pojawiać się"
                    ],
                    "common_phrases": [
                        "powszechnie występować",
                        "licznie występować",
                        "występować w przyrodzie"
                    ],
                    "target_lang_definitions": {
                        "ru": "находиться, встречаться, иметь место или присутствовать в определённом месте или в определённое время"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встречаться",
                                "target_lang_sense_clarification": "о видах животных, растений или явлениях"
                            },
                            {
                                "target_lang_word": "попадаться",
                                "target_lang_sense_clarification": "об ошибках, фактах, примерах"
                            },
                            {
                                "target_lang_word": "обитать",
                                "target_lang_sense_clarification": "о животных в ареале"
                            },
                            {
                                "target_lang_word": "водиться",
                                "target_lang_sense_clarification": "о животных, рыбах, птицах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e615bdc1-9ba2-378f-bbae-e5b086c140b1",
                    "sense_definition": "przemawiać przed słuchaczami, zabierać głos publicznie lub reprezentować określone stanowisko",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wypowiedź",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ekspert chętnie <w>występuje</w> w mediach, aby wyjaśniać zawiłe sprawy prawne.",
                            "target_lang_translations": {
                                "ru": "Эксперт охотно <w>выступает</w> в средствах массовой информации, чтобы разъяснять запутанные правовые вопросы."
                            }
                        },
                        {
                            "text": "Przedstawiciel rządu wielokrotnie <w>występował</w> z oficjalnym oświadczeniem dla dziennikarzy.",
                            "target_lang_translations": {
                                "ru": "Представитель правительства неоднократно <w>выступал</w> с официальным заявлением для журналистов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "występować w mediach",
                        "występować publicznie",
                        "występować w imieniu"
                    ],
                    "target_lang_definitions": {
                        "ru": "произносить речь перед слушателями, публично высказываться или представлять чью-либо позицию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступать",
                                "target_lang_sense_clarification": "публично с речью, заявлением или от имени кого-либо"
                            },
                            {
                                "target_lang_word": "брать слово",
                                "target_lang_sense_clarification": "на собрании или заседании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c0c9157-8630-3abd-917d-74b874ccdf6c",
                    "sense_definition": "rezygnować z członkostwa w jakiejś organizacji, partii, zrzeszeniu lub stowarzyszeniu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "członkostwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z powodów osobistych polityk nagle <w>występuje</w> z partii i przechodzi do opozycji.",
                            "target_lang_translations": {
                                "ru": "По личным причинам политик внезапно <w>выходит</w> из партии и переходит в оппозицию."
                            }
                        },
                        {
                            "text": "Wielu członków dobrowolnie <w>występuje</w> ze stowarzyszenia po zmianie zarządu.",
                            "target_lang_translations": {
                                "ru": "Многие члены добровольно <w>выходят</w> из ассоциации после смены руководства."
                            }
                        }
                    ],
                    "synonyms": [
                        "wypisywać się"
                    ],
                    "antonyms": [
                        "wstępować"
                    ],
                    "common_phrases": [
                        "występować z partii",
                        "występować z organizacji",
                        "występować ze związku"
                    ],
                    "target_lang_definitions": {
                        "ru": "прекращать членство в какой-либо организации, партии, объединении или ассоциации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "из партии, состава организации"
                            },
                            {
                                "target_lang_word": "уходить",
                                "target_lang_sense_clarification": "из объединения или движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee9adf9d-b9fb-3e87-9c20-6029460e0889",
                    "sense_definition": "składać oficjalny wniosek, żądanie lub prośbę do urzędu lub innej instytucji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "formalne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Właściciel nieruchomości oficjalnie <w>występuje</w> o odszkodowanie za zniszczenia po burzy.",
                            "target_lang_translations": {
                                "ru": "Владелец недвижимости официально <w>обращается с ходатайством о</w> компенсации за повреждения после бури."
                            }
                        },
                        {
                            "text": "Prawnik często <w>występuje</w> do sądu z ważnym wnioskiem dowodowym.",
                            "target_lang_translations": {
                                "ru": "Юрист часто <w>обращается</w> в суд с важным ходатайством о приобщении доказательств."
                            }
                        }
                    ],
                    "common_phrases": [
                        "występować z wnioskiem",
                        "występować o odszkodowanie",
                        "występować do sądu"
                    ],
                    "target_lang_definitions": {
                        "ru": "подавать официальное заявление, иск, ходатайство или требование в учреждение либо орган власти"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обращаться",
                                "target_lang_sense_clarification": "с заявлением, ходатайством или иском"
                            },
                            {
                                "target_lang_word": "ходатайствовать",
                                "target_lang_sense_clarification": "официально заявлять просьбу"
                            },
                            {
                                "target_lang_word": "подавать",
                                "target_lang_sense_clarification": "заявление, иск или прошение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34809c9-fefe-3d36-b31f-70dc6a3f83db",
                    "sense_definition": "o rzece lub zbiorniku wodnym: wylewać się poza naturalne koryto lub ograniczenia",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "woda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po gwałtownych ulewach rzeka niespodziewanie <w>występuje</w> z brzegów i zalewa pola.",
                            "target_lang_translations": {
                                "ru": "После сильных ливней река неожиданно <w>выходит из</w> берегов и затапливает поля."
                            }
                        },
                        {
                            "text": "Podczas wiosennych roztopów woda regularnie <w>występuje</w> ze swojego koryta.",
                            "target_lang_translations": {
                                "ru": "Во время весенней оттепели вода регулярно <w>выходит из</w> своего русла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "występować z brzegów",
                        "występować z koryta"
                    ],
                    "target_lang_definitions": {
                        "ru": "о реке или водоёме: переливаться за пределы естественного русла или границ"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить из берегов",
                                "target_lang_sense_clarification": "о реках и водоёмах"
                            },
                            {
                                "target_lang_word": "разливаться",
                                "target_lang_sense_clarification": "о реке во время половодья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f401a1a-ef56-373e-8ba3-c52391015216",
                    "sense_definition": "robić krok do przodu i opuszczać szereg lub grupę stojących osób",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na rozkaz dowódcy żołnierz natychmiast <w>występuje</w> z szyku przed pozostałych.",
                            "target_lang_translations": {
                                "ru": "По приказу командира солдат тут же <w>выходит из</w> строя перед остальными."
                            }
                        },
                        {
                            "text": "Ochotnik powoli <w>występuje</w> przed szereg, aby zgłosić się do zadania.",
                            "target_lang_translations": {
                                "ru": "Доброволец медленно <w>выступает из</w> шеренги, чтобы вызваться на выполнение задания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "występować przed szereg",
                        "występować z szyku"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать шаг вперёд и выходить из строя или группы стоящих людей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить из строя",
                                "target_lang_sense_clarification": "делать шаг вперед из шеренги"
                            },
                            {
                                "target_lang_word": "выступать вперед",
                                "target_lang_sense_clarification": "вышагивать из ряда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}