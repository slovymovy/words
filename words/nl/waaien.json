                    "sense_definition": "door de kracht van de wind verplaatst worden of verplaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplaatsing-door-wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn hoed <w>waaide</w> plotseling van mijn hoofd door een windvlaag.",
                            "target_lang_translations": {
                                "en": "My hat suddenly <w>blew</w> off my head due to a gust of wind."
                            }
                        },
                        {
                            "text": "De droge bladeren <w>waaien</w> over de straat in de herfst.",
                            "target_lang_translations": {
                                "en": "The dry leaves <w>blow</w> across the street in the autumn."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weg waaien",
                        "omver waaien"
                    ],
                    "target_lang_definitions": {
