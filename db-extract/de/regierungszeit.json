                "senses": [
                    {
                        "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                        "entry_id": "258d5fa4-3d4b-3031-95c3-ae5f2b07db94",
                        "glosses": [
                            "ein bestimmter Zeitraum oder eine Zeitspanne, innerhalb der eine Regierung oder ein Politiker an der Macht ist bzw. war oder laut Gesetz bzw. Verfassung regieren darf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960dc4ed-90d8-458c-b224-4df9a423a899",
                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                "text": "Die Regierungszeit des preußischen Königs Friedrich II. betrug von 1740 bis 1786 insgesamt 46 Jahre."
                            },
                            {
                                "example_id": "c15265f7-4ee9-4774-97d5-443d99adb25e",
                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                "text": "Die Regierungszeit der Bundesregierung ist in Deutschland im Normalfall auf vier Jahre begrenzt."
                            },
                            {
                                "example_id": "d40a3fed-1684-4026-8cec-71a7814b53ad",
                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                "text": "„Die ersten Wochen seiner Regierungszeit zeigen, dass er so selbstherrlich und wankelmütig wie ein antiker Despot herrscht.“"
                            },
                            {
                                "example_id": "cee52c74-ee06-472e-bd0a-2cecaf4c9448",
                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                "text": "„Die Reformen, die Zar Alexander II. zu Beginn seiner Regierungszeit (1855-1881) in Angriff nahm, weckten nicht nur bei jüdischen Intellektuellen Hoffnungen auf eine dauerhafte Liberalisierung.“"
                            },
                            {
                                "example_id": "6507ee74-bf93-47cf-a494-af86c7de039e",
                                "sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                                "text": "„Das mag auch besonders den Zorn Ludwigs XV. erregt haben, der zwar ein recht sündiger Herrscher, doch ein sehr gläubiger König war und zum Schutz des Glaubens jedenfalls während seiner Regierungszeit bedeutend mehr tat als für die Sanierung der französischen Finanzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb15f192-da3a-4a6e-989d-00cc3e05e400",
                        "source_entry_id": "258d5fa4-3d4b-3031-95c3-ae5f2b07db94",
                        "source_sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                        "target_lang_word": "reign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                                        "entry_id": "39aba560-f2c2-3a04-a9b7-41e84adcab53",
                                        "glosses": [
                                            "The exercise of sovereign power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c4fb0cc-c48b-4c24-b024-1529ea2ba232",
                                                "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                                                "text": "England prospered under Elizabeth I's reign."
                                            },
                                            {
                                                "example_id": "106fa63c-101d-48c3-8ee6-f094fafc9e23",
                                                "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                                                "text": "Throughout history, no single dictator has successfully upheld their reign forever, no matter how powerful they seemed to be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307e42ef-a94e-37ea-aec3-8fb837341beb",
                                        "entry_id": "39aba560-f2c2-3a04-a9b7-41e84adcab53",
                                        "glosses": [
                                            "The period during which a monarch rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10f39f9-6aec-4270-80e5-7f3d3619d841",
                                                "sense_id": "307e42ef-a94e-37ea-aec3-8fb837341beb",
                                                "text": "The reign of Victoria was a long one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9578951-b4da-318a-9c8a-5278e21bae03",
                                        "entry_id": "39aba560-f2c2-3a04-a9b7-41e84adcab53",
                                        "glosses": [
                                            "The territory or sphere over which a kingdom; empire; realm; dominion, etc. is ruled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7c2bf15-a2c6-46cd-8bbe-307316079e23",
                                                "sense_id": "a9578951-b4da-318a-9c8a-5278e21bae03",
                                                "text": "And the Fox guileful, and most covetous; / That neither pleased was, to have the reign / Twixt them divided into even twain"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To exercise sovereign power, to rule as a monarch."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33b95564-08c1-49f3-b393-8bd4f1aa7979",
                                                "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                                                "text": "He reigned in an autocratic manner."
                                            },
                                            {
                                                "example_id": "00a936cb-1919-4435-9ee6-20ea545bb762",
                                                "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                                                "text": "Both we will raigne as Conſuls of the earth,\nAnd mightie kings ſhall be our Senators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f28cb40-ddc0-3604-b311-42824ad56417",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To reign over (a country)"
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5544c78-af6e-4967-9487-c5a2616edaa3",
                                                "sense_id": "2f28cb40-ddc0-3604-b311-42824ad56417",
                                                "text": "The House of Piast reigned Poland from its foundation to 1385."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e9af4a-aacf-3b52-a8bf-c03a1b025c63",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To be the winner of the most recent iteration of a competition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                        "entry_id": "54d309a4-b27b-3492-8565-fd78448ff2f6",
                                        "glosses": [
                                            "To be a dominant quality of a place or situation; to prevail, predominate, rule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61058a68-ebd4-48e2-93e1-79e66b79f0ec",
                                                "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                                "text": "Silence reigned."
                                            },
                                            {
                                                "example_id": "a7c8a615-e884-49dc-af68-91aa9f5063cb",
                                                "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                                "text": "Silence reigned, broken only by the hideous screeching of vultures and the sound of a lawn-mower being used in the hospital grounds."
                                            },
                                            {
                                                "example_id": "21d2a460-3748-4c04-980f-001700dc5172",
                                                "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                                                "text": "Unfortunately – and ironically – the word ‘system’ itself is used in such a wide variety of contexts within animal science, as indeed it is in virtually every domain of human activity, that confusion reigns about what a systems-oriented research programme actually looks like and what systems-oriented animal scientists actually do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4f05ebc-03e2-422d-882a-b0f5fb492c10",
                        "source_entry_id": "258d5fa4-3d4b-3031-95c3-ae5f2b07db94",
                        "source_sense_id": "8818a188-ac08-3245-ac88-46117d524fe3",
                        "target_lang_word": "ministère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ministère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Emploi ou charge qu’on exerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0467c75-dc92-4317-8722-348872e5fa41",
                                                "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                                "text": "Ces sortes d'affaires s'instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n'être pas obligatoire, et le surcroît de frais qu'il eût occasionné être irrépétible."
                                            },
                                            {
                                                "example_id": "43d19ae9-58c9-416e-b254-f23e4befae73",
                                                "sense_id": "2acdd4db-dcfc-327c-b1d4-775743a71b10",
                                                "text": "Satisfaire aux obligations, remplir les devoirs de son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88301569-c87d-3e4a-afae-e96b8555fc11",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonction d’un huissier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3a747b0-021f-44ab-a213-0c0085580f58",
                                                "sense_id": "88301569-c87d-3e4a-afae-e96b8555fc11",
                                                "text": "Opérer une saisie par ministère d’huissier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonctions dans l’Église, notamment d’un prêtre (sacerdoce)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b727188-3ac6-483b-a485-f3c6bf29eb74",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Je fus un instant sur le point de céder, et de me servir de son ministère, non point pour lui dire ce qu'il attendait sans doute, un grand secret, mais afin de m'éprouver moi-même, et de savoir ce que ces secours religieux produiraient sur mon esprit."
                                            },
                                            {
                                                "example_id": "4e06afa6-a18d-44d6-9b3a-4c01a33bed3e",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Jacques Monceau de Tournai avait étudié à Genève en 1566 et y avait exercé le ministère ; appelé au pastorat d’Anvers, il vint visiter Lille."
                                            },
                                            {
                                                "example_id": "e6a5025f-b44f-4910-9ba7-eb15b91147fe",
                                                "sense_id": "87e712f1-897a-3c57-8de5-4e33b9bc7802",
                                                "text": "Il faut rappeler qu’en 1972, Paul VI avait créé les ministères laïcs d’acolyte et de lecteur, fonctions relevant auparavant du sacrement de l’ordination, avec son motu proprio Ministeria quaedam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "674ae61d-3274-3607-9fdb-c4e19b5eecc4",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Entremise de quelqu’un dans une affaire, le service qu’on rend à une autre personne dans quelque emploi, dans quelque fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142c53e9-20b7-4ed3-99ed-daddd6df837e",
                                                "sense_id": "674ae61d-3274-3607-9fdb-c4e19b5eecc4",
                                                "text": "Il nous a offert, il nous a prêté son ministère. — Vous pouvez compter sur son ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1377ebb8-29ac-3c03-b17d-b40e7ad92c45",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Fonction des ministres chargés du soin des affaires publiques et dont l’ensemble constitue le gouvernement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Le département qu’ils administrent."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c8a76eb-3c2e-4763-9691-0a4764ec67a6",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "La première escarmouche se produit avec la discussion relative aux crédits nécessités par la création de deux ministères nouveaux : celui des Postes et Télégraphes et celui des Beaux-Arts."
                                            },
                                            {
                                                "example_id": "4ed1258a-2b39-4acf-9a68-3a9e8531065f",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "Ripont — […]. Commune entièrement détruite pendant la guerre de 1914-18. Son territoire est administré en 1919, par le \"ministère du blocus et des régions libérées\" puis par les Domaines."
                                            },
                                            {
                                                "example_id": "b431e478-b385-438f-b489-f2d42ecb8195",
                                                "sense_id": "08ba8a1f-e5ad-3e97-945a-12d4203cd50a",
                                                "text": "Il faudrait représenter Rabourdin habillé en boucher, mais bien ressemblant, chercher des analogies entre un bureau et une cuisine, lui mettre à la main un tranche-lard, peindre les principaux employés des ministères en volailles, les encager dans une immense souricière sur laquelle on écrirait : Exécutions administratives, et il serait censé leur couper le cou un à un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cbc0719-6378-3dc8-a6aa-490cb89073ff",
                                        "entry_id": "7123af6c-a6b1-399c-ae32-dc24dcf8f20e",
                                        "glosses": [
                                            "Temps pendant lequel la personne dont on parle a été ministre."
                                        ],
                                        "tags": [],
