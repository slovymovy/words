{
    "word_family": [
        "mentionable",
        "unmentionable",
        "mentioner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c513711d-ed45-3a51-aaad-e49274c3b565",
                    "sense_definition": "To make a short reference to something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you <w>mention</w> the plans to your brother?",
                            "target_lang_translations": {
                                "ru": "Ты <w>упомянул</w> о планах своему брату?",
                                "tr": "Planlardan kardeşine <w>bahsettin</w> mi?"
                            }
                        },
                        {
                            "text": "I forgot to <w>mention</w> that the store is closed today.",
                            "target_lang_translations": {
                                "ru": "Я забыл <w>упомянуть</w>, что магазин сегодня закрыт.",
                                "tr": "Mağazanın bugün kapalı olduğunu <w>söylemeyi</w> unuttum."
                            }
                        }
                    ],
                    "synonyms": [
                        "bring up",
                        "reference",
                        "touch on"
                    ],
                    "antonyms": [
                        "orate",
                        "speechify"
                    ],
                    "common_phrases": [
                        "don't mention it",
                        "not to mention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать краткую отсылку к чему-либо.",
                        "tr": "Bir şeyden kısaca bahsetmek, söz etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упомина́ть",
                                "target_lang_sense_clarification": "касаться вскользь какой-либо темы"
                            },
                            {
                                "target_lang_word": "упомяну́ть",
                                "target_lang_sense_clarification": "назвать, затронуть в речи (совершенный вид)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bahsetmek",
                                "target_lang_sense_clarification": "bir konu hakkında konuşmak veya yazmak"
                            },
                            {
                                "target_lang_word": "söz etmek",
                                "target_lang_sense_clarification": "bir konuya kısaca değinmek"
                            },
                            {
                                "target_lang_word": "değinmek",
                                "target_lang_sense_clarification": "bir konuyu kısaca ele almak, temas etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89e5866f-3238-3712-a294-0114eec3bc50",
                    "sense_definition": "To utter a word or expression in order to refer to the expression itself, as opposed to its usual referent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this context, you are using the word rather than just <w>mentioning</w> it.",
                            "target_lang_translations": {
                                "ru": "В этом контексте вы используете слово, а не просто <w>упоминаете</w> его.",
                                "tr": "Bu bağlamda sözcüğü sadece <w>anmak</w> yerine onu kullanıyorsunuz."
                            }
                        },
                        {
                            "text": "Philosophers often distinguish between using a term and <w>mentioning</w> it.",
                            "target_lang_translations": {
                                "ru": "Философы часто различают использование термина и его <w>упоминание</w>.",
                                "tr": "Filozoflar genellikle bir terimi kullanmak ile ondan <w>bahsetmek</w> arasında ayrım yaparlar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Произнести слово или выражение для ссылки на само выражение, а не на его значение.",
                        "tr": "Bir kelimeyi kendi anlamına gönderme yapmak yerine kelimenin kendisine atıfta bulunmak için söylemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упомина́ть",
                                "target_lang_sense_clarification": "называть слово как лингвистический объект"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anmak",
                                "target_lang_sense_clarification": "kelimenin kendisine atıfta bulunarak söylemek"
                            },
                            {
                                "target_lang_word": "bahsetmek",
                                "target_lang_sense_clarification": "sözcüğün kendisini ifade etmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6e33a43-a6d8-3676-a582-ebcc427d1f23",
                    "sense_definition": "A speaking or noticing of anything, usually in a brief or cursory manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report made no <w>mention</w> of the incident.",
                            "target_lang_translations": {
                                "ru": "В отчёте не было <w>упоминания</w> об инциденте.",
                                "tr": "Raporda olaydan hiç <w>bahsedilmiyordu</w>."
                            }
                        },
                        {
                            "text": "At the <w>mention</w> of his name, everyone looked up.",
                            "target_lang_translations": {
                                "ru": "При <w>упоминании</w> его имени все подняли головы.",
                                "tr": "Onun adı <w>geçtiğinde</w> herkes başını kaldırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "reference",
                        "remark",
                        "comment"
                    ],
                    "common_phrases": [
                        "make mention",
                        "honorable mention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высказывание или замечание о чём-либо, обычно в краткой или беглой форме.",
                        "tr": "Bir şeyden genellikle kısa veya üstünkörü bir şekilde söz edilmesi veya fark edilmesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упомина́ние",
                                "target_lang_sense_clarification": "слова, касающиеся кого-либо или чего-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bahis",
                                "target_lang_sense_clarification": "bir şeyden söz edilmesi"
                            },
                            {
                                "target_lang_word": "değinme",
                                "target_lang_sense_clarification": "kısaca temas etme durumu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75ff7cb6-4ff6-31cb-95ee-96cdc90c8d6c",
                    "sense_definition": "A social media feed, a list of replies or posts mentioning a person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After his controversial post, his <w>mentions</w> were full of angry comments.",
                            "target_lang_translations": {
                                "ru": "После его скандального поста его <w>упоминания</w> были полны гневных комментариев.",
                                "tr": "Tartışmalı gönderisinden sonra, <w>bahsetmeler</w> bölümü öfkeli yorumlarla doluydu."
                            }
                        },
                        {
                            "text": "She checked her <w>mentions</w> to see if anyone had replied.",
                            "target_lang_translations": {
                                "ru": "Она проверила свои <w>упоминания</w>, чтобы узнать, ответил ли кто-нибудь.",
                                "tr": "Birinin yanıt verip vermediğini görmek için <w>bildirimlerini</w> kontrol etti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лента в социальных сетях, список ответов или постов с упоминанием человека.",
                        "tr": "Sosyal medyada bir kişiden bahsedilen gönderilerin veya yanıtların listesi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упомина́ние",
                                "target_lang_sense_clarification": "уведомление в социальных сетях"
                            },
                            {
                                "target_lang_word": "отме́тка",
                                "target_lang_sense_clarification": "тег пользователя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bahsetme",
                                "target_lang_sense_clarification": "sosyal medya etiketlemesi veya bildirimi"
                            },
                            {
                                "target_lang_word": "etiketleme",
                                "target_lang_sense_clarification": "sosyal medyada bir kullanıcıya atıfta bulunma"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}