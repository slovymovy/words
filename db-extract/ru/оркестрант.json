                        "sense_id": "22f8aca9-dcad-37f1-b066-e0bb7fcb1e63",
                        "entry_id": "15047802-af56-3a3c-ae4c-80f429b18030",
                        "glosses": [
                            "музыкант, играющий в оркестре"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efd9de8-5694-4efa-91d4-63c10e841af7",
                                "sense_id": "22f8aca9-dcad-37f1-b066-e0bb7fcb1e63",
                                "text": "Каждый окрестрант должен отлично знать свою партию, чтобы нигде не запнуться, не сбиться."
                            }
                        ]
                    },
                    {
                        "sense_id": "aebe69a8-0c91-3584-a157-572ba31d257a",
                        "entry_id": "15047802-af56-3a3c-ae4c-80f429b18030",
                        "glosses": [
                            "воен. жарг. то же, что вагнеровец"
                        ],
                        "tags": [],
                        "examples": [
