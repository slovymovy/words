        "fr-extract.jsonl": [
            {
                "entry_id": "c212e273-d0db-399d-bdf6-eb4cff4a1dc3",
                "word": "tatane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "366f6201-827b-4be0-b104-8f0c45f3fae5",
                        "entry_id": "c212e273-d0db-399d-bdf6-eb4cff4a1dc3",
                        "tags": [
                            "plural"
                        ],
                        "form": "tatanes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "feb46775-f267-3900-956e-16f36888ad94",
                        "entry_id": "c212e273-d0db-399d-bdf6-eb4cff4a1dc3",
                        "glosses": [
                            "Chaussure."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a61c4a7b-f721-433d-a491-07327f4f5cdd",
                                "sense_id": "feb46775-f267-3900-956e-16f36888ad94",
                                "text": "Il soupirait en regardant l’extrémité de ses tatanes."
                            },
                            {
                                "example_id": "05052796-5192-48fe-91b9-13f22f0ee2a4",
                                "sense_id": "feb46775-f267-3900-956e-16f36888ad94",
                                "text": "— J’ai mal aux pieds.\n— Ah ! toi et tes tatanes !"
                            },
                            {
                                "example_id": "3ae5e19f-401d-432b-be98-a7cbf9e929ee",
                                "sense_id": "feb46775-f267-3900-956e-16f36888ad94",
                                "text": "J’ai viré de mon sac tout ce qui était irrémédiablement naze, lavé le sac dans une espèce d’abreuvoir à vaches, tordu les vêtements et tassé ça dans le sac à coups de tatane."
                            },
                            {
                                "example_id": "b488e888-4b63-4649-b1fb-b47d0ffde2d2",
                                "sense_id": "feb46775-f267-3900-956e-16f36888ad94",
                                "text": "Même pas eu le temps de me payer une paire de tatanes en daim comme j’avais envie. J’étais sapé de mes anciennes fringues, ma garde-robe d’avant la taule… les frocs se faisaient plus si fuseaux…"
                            },
                            {
                                "example_id": "a8d30ea0-a080-46d1-b433-5d77aca83bc2",
                                "sense_id": "feb46775-f267-3900-956e-16f36888ad94",
                                "text": "En revanche, son pied chaussé d’une tatane sans âge atteignit parfaitement son but : le bas-ventre de l’agresseur, qui se plia de douleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bbe3321-c5e0-3666-9963-ff8858c6a054",
                        "entry_id": "c212e273-d0db-399d-bdf6-eb4cff4a1dc3",
                        "glosses": [
                            "Claque, gifle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "41255bdd-5802-42af-b943-db9dfc246d39",
                                "sense_id": "5bbe3321-c5e0-3666-9963-ff8858c6a054",
                                "text": "Je lui ai mis une tatane."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a338ad4-9f92-4072-843a-352173b3ae5a",
                        "source_entry_id": "c212e273-d0db-399d-bdf6-eb4cff4a1dc3",
