{
    "word_family": [
        "kind",
        "kindness",
        "unkind",
        "unkindly",
        "unkindness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "62187aef-cdec-324e-8169-dd1d08422161",
                    "sense_definition": "In a kind, caring, or generous manner; out of kindness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>kindly</w> offered to drive us to the train station.",
                            "target_lang_translations": {
                                "ru": "Он <w>любезно</w> предложил подвезти нас до вокзала.",
                                "zh": "他<w>好心地</w>提出开车送我们去火车站。"
                            }
                        },
                        {
                            "text": "The nurse spoke <w>kindly</w> to the patient to calm him down.",
                            "target_lang_translations": {
                                "ru": "Медсестра <w>доброжелательно</w> поговорила с пациентом, чтобы успокоить его.",
                                "zh": "护士<w>亲切地</w>与病人交谈，以安抚他的情绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thoughtfully",
                        "generously",
                        "warmly",
                        "benevolently",
                        "nicely",
                        "politely"
                    ],
                    "common_phrases": [
                        "speak kindly",
                        "treat kindly",
                        "act kindly"
                    ],
                    "target_lang_definitions": {
                        "ru": "С добротой, заботой или щедростью; из вежливости.",
                        "zh": "以友善、关怀或慷慨的方式；出于好意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезно",
                                "target_lang_sense_clarification": "вежливо, услужливо"
                            },
                            {
                                "target_lang_word": "доброжелательно",
                                "target_lang_sense_clarification": "с добрыми намерениями"
                            },
                            {
                                "target_lang_word": "ласково",
                                "target_lang_sense_clarification": "нежно, мягко"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好心地",
                                "target_lang_sense_clarification": "出于善意"
                            },
                            {
                                "target_lang_word": "亲切地",
                                "target_lang_sense_clarification": "态度和蔼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0b6b6ad-0f63-37b4-9226-360da9cd582b",
                    "sense_definition": "Used to make a polite request or command.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Would you <w>kindly</w> close the door behind you?",
                            "target_lang_translations": {
                                "ru": "<w>Будьте добры</w>, закройте за собой дверь?",
                                "zh": "<w>请</w>随手关门好吗？"
                            }
                        },
                        {
                            "text": "Guests are <w>kindly</w> requested to refrain from smoking inside.",
                            "target_lang_translations": {
                                "ru": "Гостей <w>убедительно</w> просят воздержаться от курения в помещении.",
                                "zh": "<w>请</w>各位客人在室内不要吸烟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "please"
                    ],
                    "common_phrases": [
                        "kindly request",
                        "kindly inform",
                        "kindly ask"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения вежливой просьбы или приказа.",
                        "zh": "用于提出礼貌的请求或指令。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "будьте добры",
                                "target_lang_sense_clarification": "фраза вежливости"
                            },
                            {
                                "target_lang_word": "любезно",
                                "target_lang_sense_clarification": "в официальных просьбах"
                            },
                            {
                                "target_lang_word": "пожалуйста",
                                "target_lang_sense_clarification": "общее слово вежливости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "请",
                                "target_lang_sense_clarification": "礼貌请求"
                            },
                            {
                                "target_lang_word": "劳驾",
                                "target_lang_sense_clarification": "客气的请求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d06c34e-403e-327b-9cb5-236bb5c7d785",
                    "sense_definition": "Used in negative constructions to indicate that someone does not accept, like, or tolerate something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager does not take <w>kindly</w> to employees arriving late.",
                            "target_lang_translations": {
                                "ru": "Менеджер не относится <w>благосклонно</w> к сотрудникам, которые опаздывают.",
                                "zh": "经理对员工迟到一点也不<w>乐意</w>。"
                            }
                        },
                        {
                            "text": "Local residents did not take <w>kindly</w> to the construction noise.",
                            "target_lang_translations": {
                                "ru": "Местные жители не отнеслись <w>одобрительно</w> к шуму от стройки.",
                                "zh": "当地居民对施工噪音并不<w>喜欢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "not take kindly to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в отрицательных конструкциях, означая неприятие или неодобрение чего-либо.",
                        "zh": "用于否定结构，表示某人不能接受、不喜欢或无法容忍某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благосклонно",
                                "target_lang_sense_clarification": "положительно"
                            },
                            {
                                "target_lang_word": "одобрительно",
                                "target_lang_sense_clarification": "с согласием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乐意",
                                "target_lang_sense_clarification": "愿意接受"
                            },
                            {
                                "target_lang_word": "喜欢",
                                "target_lang_sense_clarification": "对某事持正面态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a2401f3-d913-3336-acac-8dc02746892b",
                    "sense_definition": "In a favourable or lucky way; to one's advantage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball bounced <w>kindly</w> for the striker, allowing him to score easily.",
                            "target_lang_translations": {
                                "ru": "Мяч <w>удачно</w> отскочил к нападающему, позволив ему легко забить гол.",
                                "zh": "球<w>幸运地</w>弹到了前锋脚下，让他轻松得分。"
                            }
                        },
                        {
                            "text": "History has not always looked <w>kindly</w> on such decisions.",
                            "target_lang_translations": {
                                "ru": "История не всегда смотрела <w>благосклонно</w> на такие решения.",
                                "zh": "历史并不总是<w>有利地</w>看待这类决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "favourably"
                    ],
                    "common_phrases": [
                        "look kindly upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Благоприятным или удачным образом; к чьей-либо выгоде.",
                        "zh": "以有利或幸运的方式；对某人有利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удачно",
                                "target_lang_sense_clarification": "везуче"
                            },
                            {
                                "target_lang_word": "благосклонно",
                                "target_lang_sense_clarification": "о судьбе или истории"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幸运地",
                                "target_lang_sense_clarification": "运气好"
                            },
                            {
                                "target_lang_word": "有利地",
                                "target_lang_sense_clarification": "产生好的结果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de5ccf91-c18e-38cd-a03a-85d8520d4ee1",
                    "sense_definition": "Having a kind, warm, and sympathetic nature or personality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>kindly</w> old man sits on the park bench every afternoon feeding pigeons.",
                            "target_lang_translations": {
                                "ru": "<w>Добродушный</w> старик сидит на скамейке в парке каждый день и кормит голубей.",
                                "zh": "一位<w>和蔼的</w>老人在公园长椅上坐着，每天下午都喂鸽子。"
                            }
                        },
                        {
                            "text": "She had a <w>kindly</w> face that made the children trust her immediately.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>доброе</w> лицо, из-за которого дети сразу же доверились ей.",
                                "zh": "她有一张<w>善良的</w>脸，让孩子们立刻就信任她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "warmhearted",
                        "gentle",
                        "benevolent",
                        "good-natured",
                        "friendly",
                        "sympathetic",
                        "nice"
                    ],
                    "antonyms": [
                        "cruel",
                        "mean",
                        "stern",
                        "cold-blooded",
                        "hardhearted",
                        "malicious"
                    ],
                    "common_phrases": [
                        "kindly soul",
                        "kindly face",
                        "kindly disposition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий добрым, мягким и отзывчивым характером.",
                        "zh": "具有善良、温暖和富有同情心的性格或个性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добродушный",
                                "target_lang_sense_clarification": "мягкосердечный"
                            },
                            {
                                "target_lang_word": "добрый",
                                "target_lang_sense_clarification": "хороший, отзывчивый"
                            },
                            {
                                "target_lang_word": "приветливый",
                                "target_lang_sense_clarification": "располагающий к себе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "和蔼的",
                                "target_lang_sense_clarification": "态度温和"
                            },
                            {
                                "target_lang_word": "善良的",
                                "target_lang_sense_clarification": "心地好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06ff5b97-84a7-3d05-b589-138fb06f17d8",
                    "sense_definition": "Pleasant, mild, or agreeable; often used to describe weather, light, or environment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pleasantness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>kindly</w> breeze cooled the air on that hot summer afternoon.",
                            "target_lang_translations": {
                                "ru": "<w>Ласковый</w> ветерок охладил воздух в этот жаркий летний день.",
                                "zh": "那个炎热的夏日下午，一阵<w>温和的</w>微风吹散了暑气。"
                            }
                        },
                        {
                            "text": "The plants grew quickly under the <w>kindly</w> spring sun.",
                            "target_lang_translations": {
                                "ru": "Растения быстро росли под <w>мягким</w> весенним солнцем.",
                                "zh": "在<w>宜人的</w>春日阳光下，植物长得很快。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pleasant",
                        "mild",
                        "gentle"
                    ],
                    "antonyms": [
                        "hardhearted",
                        "savage"
                    ],
                    "common_phrases": [
                        "kindly light",
                        "kindly air"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный, мягкий или благоприятный (о погоде или среде).",
                        "zh": "令人愉悦、温和或宜人的；常用于描述天气、光线或环境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ласковый",
                                "target_lang_sense_clarification": "о ветре или солнце"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "не суровый"
                            },
                            {
                                "target_lang_word": "приятный",
                                "target_lang_sense_clarification": "комфортный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "温和的",
                                "target_lang_sense_clarification": "不猛烈"
                            },
                            {
                                "target_lang_word": "宜人的",
                                "target_lang_sense_clarification": "舒适的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}