                "senses": [
                    {
                        "sense_id": "bb14145b-93c6-3c13-82aa-5a0c4dbc5657",
                        "entry_id": "d42a36ce-be3b-39d5-af10-6753752dcc9b",
                        "glosses": [
                            "von Norden nach Süden verlaufende Achse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c63b0815-7066-4dbb-9aeb-2ba30bcf2a0c",
                                "sense_id": "bb14145b-93c6-3c13-82aa-5a0c4dbc5657",
                                "text": "„Hinsichtlich der Ausrichtung hat sich ein möglichst sonniger Platz auf Nord-Süd-Achse als hilfreich erwiesen, mit direkter Sonnen-Einwirkung bereits in den Morgenstunden.“"
                            },
                            {
                                "example_id": "64ee7c06-ef61-4a3f-bbcd-a423de8a6563",
                                "sense_id": "bb14145b-93c6-3c13-82aa-5a0c4dbc5657",
                                "text": "„Damit würden sich die Ameisen nicht nur anhand mechanischer und pheromoneller Reize orientieren, sondern auch die Nord-Süd-Achse des Erdmagnetfeldes erkennen, so die Wissenschaftler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
