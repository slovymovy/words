                "senses": [
                    {
                        "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                        "entry_id": "95169c6f-3039-3daf-88b6-c6f2c8f134fc",
                        "glosses": [
                            "Person, die einer anderen Person rechtswidrig und unter Androhung oder auch Anwendung von Gewalt etwas wegnimmt"
                        ],
                        "tags": [
                            "archaic",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "a3532d6b-f92d-464a-8132-c45d61c6db09",
                                "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                "text": "Sie geraten in die Doppelmühle zwischen einem immer brutaler werdenden Arbeitsalltag und den Wegelagerern vom Ballhausplatz, die ihnen am Nachhauseweg weit mehr als die Hälfte des Lohns wieder abknöpfen."
                            },
                            {
                                "example_id": "002f111b-e9fb-4813-9ede-df239adc8bbe",
                                "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                "text": "„Am 2. Juni sind sie in Zürich; es ist alles glatt gegangen, kein Radbruch, kein Wegelagerer.“"
                            },
                            {
                                "example_id": "156eb13e-886a-4488-b3ef-de566d94657f",
                                "sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                                "text": "„An den Kaufmannszügen interessierten die Wegelagerer in erster Linie nicht deren Waren, die man hätte weiterverkaufen müssen, um sie zu Geld zu machen, sondern die Kaufleute selbst, für die Lösegelder verlangt wurden, manchmal sogar ›über das Vermögen‹, was die Frankfurter Bittschrift eigens hervorhebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9528e49e-8b45-46b9-8236-546ba4a11533",
                        "source_entry_id": "95169c6f-3039-3daf-88b6-c6f2c8f134fc",
                        "source_sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
                        "source_sense_description": "Person, die jemandem auflauert",
                        "target_lang_word": "highwayman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highwayman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                        "entry_id": "893279ec-2f31-34d3-9fd3-306b1c0926e4",
                                        "glosses": [
                                            "A person, usually mounted on horseback, who robbed travelers on public roads."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b8a295-2e97-42ec-90cb-7554f98dce8d",
                                                "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                                "text": "[…] here were no Gibers, Cenſurers, Backbiters, Pick-pockets, Highwaymen, Houſebreakers, Attorneys, Bawds, Buffoons, Gameſters, Politicians, Wits, ſplenetick tedious Talkers, Controvertiſts, Raviſhers, Murderers, Robbers, Virtuoſo's; […]"
                                            },
                                            {
                                                "example_id": "fa3a2e6b-213f-41dd-a6b7-38616a537745",
                                                "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                                "text": "And the highwayman came riding— / Riding—riding— / The highwayman came riding, up to the old inn-door."
                                            },
                                            {
                                                "example_id": "9cac1858-920b-46b5-baf5-6182b53c92e4",
                                                "sense_id": "b20b9f6f-46b5-37fe-888c-033f8be6876f",
                                                "text": "I was a highwayman / Across the coach roads I did ride / With sword and pistol by my side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d36609f-c678-4d60-a2d0-d17edd46c244",
                        "source_entry_id": "95169c6f-3039-3daf-88b6-c6f2c8f134fc",
                        "source_sense_id": "4361e059-3e48-36d7-b809-0d6826e12d16",
