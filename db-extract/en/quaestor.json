                "senses": [
                    {
                        "sense_id": "e1052e73-d7b5-30a4-9137-8d6899a9e8e7",
                        "entry_id": "6df1c6d6-f0fe-3a13-9d84-1a5b691fa536",
                        "glosses": [
                            "An Ancient Roman official responsible for public revenue and other financial affairs."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2b8565a8-1ca2-473d-b519-a3885ec1e6ac",
                                "sense_id": "e1052e73-d7b5-30a4-9137-8d6899a9e8e7",
                                "text": "Decoratus was quæstor in A.D. 508."
                            }
                        ]
                    },
                    {
                        "sense_id": "08b4ba5a-fcd4-35d4-9940-0600ba7a89e5",
                        "entry_id": "6df1c6d6-f0fe-3a13-9d84-1a5b691fa536",
                        "glosses": [
                            "The Quaestor sacri palatii of the late Roman Empire and Byzantium; first generally a legislator, then judicial official, and eventually an honorary title by the 14th century."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "23dbc928-a916-38d6-8c9d-b4da341c4d41",
                        "entry_id": "6df1c6d6-f0fe-3a13-9d84-1a5b691fa536",
                        "glosses": [
                            "In the Middle Ages, an officer who announced indulgences."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f270ac1-6881-47ee-ba45-f2fca136caaa",
                        "source_entry_id": "6df1c6d6-f0fe-3a13-9d84-1a5b691fa536",
                        "source_sense_description": "Ancient Roman official",
                        "target_lang_word": "questeur",
