    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "17e5d763-4b41-3d68-9aca-d43bce8ea8d9",
                    "sense_definition": "Having or giving off a high temperature; relating to heat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful because the frying pan is very <w>hot</w> and might burn you.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, потому что сковорода очень <w>горячая</w> и может тебя обжечь."
                            }
                        },
                        {
                            "text": "It is much <w>hotter</w> in the summer than it is in the winter.",
                            "target_lang_translations": {
                                "ru": "Летом гораздо <w>жарче</w>, чем зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "heated",
                        "boiling",
                        "burning",
                        "scorching",
                        "piping hot"
                    ],
                    "antonyms": [
                        "cold",
                        "chilled",
                        "chilly",
                        "freezing",
                        "icy"
                    ],
                    "common_phrases": [
                        "hot water",
                        "hot weather",
                        "hot summer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий высокую температуру или выделяющий тепло; относящийся к жаре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горячий",
                                "target_lang_sense_clarification": "о предметах или жидкостях"
