                "senses": [
                    {
                        "sense_id": "88c8cb99-9dfc-35d4-8a17-194b7cc2266b",
                        "entry_id": "3a0f637a-51b8-30db-b62e-a2d0e74f00b0",
                        "glosses": [
                            "weibliche Person, die die Runenschrift beherrschte und in der Lage war, entsprechende Texte zu gestalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2cbe81-7de7-4126-b9f8-1f5787811801",
                                "sense_id": "88c8cb99-9dfc-35d4-8a17-194b7cc2266b",
                                "text": "„Zu ihnen gehören auch Frauen: »Blidgund« oder »Odlind« heißen die Runenmeisterinnen, in einigen Regionen wie dem südgermanischen Alamannien ist die Kunst des Schreibens sogar vorwiegend Frauensache.“"
                            },
                            {
                                "example_id": "ca7f7643-0238-4748-9676-4d848760f87d",
                                "sense_id": "88c8cb99-9dfc-35d4-8a17-194b7cc2266b",
                                "text": "„Meist sind es heilkundige Frauen, die als Runenmeisterinnen alte Kulte pflegen, weissagen und die Heilkräfte der Natur kennen.“"
                            },
                            {
                                "example_id": "2a21bb78-3587-4602-9a84-d90503cc4742",
                                "sense_id": "88c8cb99-9dfc-35d4-8a17-194b7cc2266b",
                                "text": "„Wer zum einen seit mehr als 20 Jahren zahlreiche Runendenkmäler … dokumentiert hat …, muß nun eine Lanze für die so gescholtenen Runenmeister - wo bleiben hier eigentlich die Runenmeisterinnen? - und, in diesem Fall, den Stab über Reichert brechen."
                            },
                            {
                                "example_id": "77d7f726-0c55-4e52-b742-99f85dbb1a81",
                                "sense_id": "88c8cb99-9dfc-35d4-8a17-194b7cc2266b",
                                "text": "„Hier erscheinen … Aerzte und Runenmeisterinnen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
