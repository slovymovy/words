{
    "word_family": [
        "envelop",
        "envelopment",
        "enveloper"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be91c1c2-fc2a-376c-98ae-1b8a3c330ed9",
                    "sense_definition": "A paper or cardboard wrapper used to enclose small, flat items, especially letters, for mailing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mailing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put the letter in a sealed <w>envelope</w> before you drop it in the mailbox.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи письмо в запечатанный <w>конверт</w>, прежде чем опустить его в почтовый ящик.",
                                "zh": "请把信件放入密封的<w>信封</w>里，然后再投进邮箱。"
                            }
                        },
                        {
                            "text": "She wrote the address clearly on the front of the white <w>envelope</w>.",
                            "target_lang_translations": {
                                "ru": "Она четко написала адрес на лицевой стороне белого <w>конверта</w>.",
                                "zh": "她在白色<w>信封</w>的正面清晰地写下了地址。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wrapper"
                    ],
                    "common_phrases": [
                        "sealed envelope",
                        "stamped envelope",
                        "return envelope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бумажная или картонная упаковка, используемая для вложения плоских предметов, особенно писем, для отправки по почте.",
                        "zh": "用于装载扁平物品（特别是信件）以便邮寄的纸质或纸板包装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конверт",
                                "target_lang_sense_clarification": "для писем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信封",
                                "target_lang_sense_clarification": "用于邮寄信件的纸袋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81c8ab78-e905-35a0-a1a6-19b2deea24f4",
                    "sense_definition": "The set of limitations within which a technological system can perform safely and effectively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The test pilot wanted to push the <w>envelope</w> to see how fast the new jet could actually fly.",
                            "target_lang_translations": {
                                "ru": "Пилот-испытатель хотел <w>выйти за рамки</w> привычного, чтобы проверить, какую скорость на самом деле может развить новый реактивный самолет.",
                                "zh": "试飞员想要<w>挑战极限</w>，看看这架新喷气式飞机到底能飞多快。"
                            }
                        },
                        {
                            "text": "Engineers must ensure that the machine stays within its operational <w>envelope</w> to avoid failure.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны гарантировать, что машина остается в пределах своего эксплуатационного <w>диапазона</w>, чтобы избежать поломок.",
                                "zh": "工程师必须确保机器保持在<w>运行范围</w>内，以避免故障。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "push the envelope",
                        "flight envelope",
                        "operational envelope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор ограничений, в рамках которых технологическая система может работать безопасно и эффективно.",
                        "zh": "技术系统能够安全有效运行的限制范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пределы",
                                "target_lang_sense_clarification": "возможностей или системы"
                            },
                            {
                                "target_lang_word": "границы",
                                "target_lang_sense_clarification": "эксплуатационные"
                            },
                            {
                                "target_lang_word": "диапазон",
                                "target_lang_sense_clarification": "режимов работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极限",
                                "target_lang_sense_clarification": "性能或操作的边界"
                            },
                            {
                                "target_lang_word": "运行范围",
                                "target_lang_sense_clarification": "系统工作的安全区间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f9818f1-05d7-3ddb-b687-1c3e1b9e7bf5",
                    "sense_definition": "A bag containing the lifting gas of a balloon or airship; fabric that encloses the gas-bags of an airship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aeronautics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot air balloon's <w>envelope</w> was made of colorful, heat-resistant nylon.",
                            "target_lang_translations": {
                                "ru": "<w>Оболочка</w> воздушного шара была сделана из разноцветного термостойкого нейлона.",
                                "zh": "热气球的<w>气囊</w>是由色彩鲜艳的耐热尼龙制成的。"
                            }
                        },
                        {
                            "text": "A small tear in the <w>envelope</w> caused the airship to lose altitude slowly.",
                            "target_lang_translations": {
                                "ru": "Небольшой разрыв в <w>оболочке</w> привел к тому, что дирижабль начал медленно терять высоту.",
                                "zh": "<w>气囊</w>上的一个小裂口导致飞艇缓慢下降。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gasbag"
                    ],
                    "common_phrases": [
                        "balloon envelope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мешок, содержащий подъемный газ воздушного шара или дирижабля; ткань, закрывающая газовые баллоны дирижабля.",
                        "zh": "气球或飞艇中容纳升力气体的袋子；包裹飞艇气囊的织物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "аэростата или дирижабля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气囊",
                                "target_lang_sense_clarification": "航空器中容纳气体的部分"
                            },
                            {
                                "target_lang_word": "外壳",
                                "target_lang_sense_clarification": "气球的蒙皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ab6bb1d-3598-3f03-95e4-6a5edb8f48d5",
                    "sense_definition": "The shape of a sound, which may be controlled by a synthesizer or sampler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acoustics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adjusting the volume <w>envelope</w> can make the synthesizer sound more like a piano.",
                            "target_lang_translations": {
                                "ru": "Настройка <w>огибающей</w> громкости может сделать звучание синтезатора более похожим на пианино.",
                                "zh": "调整音量<w>包络</w>可以让合成器的声音听起来更像钢琴。"
                            }
                        },
                        {
                            "text": "The producer spent hours tweaking the ADSR <w>envelope</w> for the lead synth.",
                            "target_lang_translations": {
                                "ru": "Продюсер часами настраивал ADSR-<w>огибающую</w> для ведущего синтезатора.",
                                "zh": "制作人花了几个小时为领奏合成器调整 ADSR <w>包络</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sound envelope",
                        "volume envelope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма звукового сигнала, которая может управляться синтезатором или семплером.",
                        "zh": "声音的波形变化过程，可通过合成器或采样器进行控制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огибающая",
                                "target_lang_sense_clarification": "звукового сигнала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包络",
                                "target_lang_sense_clarification": "音频信号的振幅变化曲线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "683f031e-f2ed-335f-a0dd-ed280beb80ed",
                    "sense_definition": "An enclosing structure or cover, such as a membrane; a space between two membranes",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nuclear <w>envelope</w> protects the genetic material inside the cell's nucleus.",
                            "target_lang_translations": {
                                "ru": "Ядерная <w>оболочка</w> защищает генетический материал внутри ядра клетки.",
                                "zh": "核<w>包膜</w>保护着细胞核内的遗传物质。"
                            }
                        },
                        {
                            "text": "Certain viruses are surrounded by a lipid <w>envelope</w> derived from the host cell.",
                            "target_lang_translations": {
                                "ru": "Некоторые вирусы окружены липидной <w>оболочкой</w>, полученной из клетки хозяина.",
                                "zh": "某些病毒被一层源自宿主细胞的脂质<w>包膜</w>所包裹。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nuclear envelope",
                        "viral envelope"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограждающая структура или покрытие, такое как мембрана; пространство между двумя мембранами.",
                        "zh": "一种包裹结构或覆盖物，如膜；或两层膜之间的空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оболочка",
                                "target_lang_sense_clarification": "биологическая или вирусная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "包膜",
                                "target_lang_sense_clarification": "生物学中的包裹结构"
                            },
                            {
                                "target_lang_word": "外膜",
                                "target_lang_sense_clarification": "细胞或病毒的包裹层"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7cfbe335-d218-3e6a-b252-f90fee962bd6",
                    "sense_definition": "To put something in an envelope.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mailing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After signing the contract, he carefully <w>enveloped</w> the document and sent it off.",
                            "target_lang_translations": {
                                "ru": "Подписав контракт, он аккуратно <w>вложил</w> документ <w>в конверт</w> и отправил его.",
                                "zh": "签完合同后，他小心翼翼地将文件<w>装入信封</w>并寄了出去。"
                            }
                        },
                        {
                            "text": "The clerk spent the afternoon <w>enveloping</w> hundreds of invitations for the gala.",
                            "target_lang_translations": {
                                "ru": "Клерк провел весь день, <w>раскладывая по конвертам</w> сотни приглашений на торжественный вечер.",
                                "zh": "职员花了一下午时间将数百份晚宴请柬<w>装入信封</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить что-либо в конверт.",
                        "zh": "将某物装入信封。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладывать в конверт",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "запечатывать в конверт",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装入信封",
                                "target_lang_sense_clarification": "动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "756f407f-8e48-3a5b-b171-e801da29f156",
                    "sense_definition": "Archaic form of <w>envelop</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enveloping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fog began to <w>envelope</w> the ancient castle as night fell.",
                            "target_lang_translations": {
                                "ru": "С наступлением ночи густой туман начал <w>окутывать</w> древний замок.",
                                "zh": "夜幕降临时，浓雾开始<w>笼罩</w>着古老的城堡。"
                            }
                        },
                        {
                            "text": "In the old text, the author describes how shadows <w>envelope</w> the valley.",
                            "target_lang_translations": {
                                "ru": "В старинном тексте автор описывает, как тени <w>обволакивают</w> долину.",
                                "zh": "在古文中，作者描述了阴影是如何<w>包围</w>山谷的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "spelling variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичная форма глагола envelop (окутывать, обволакивать).",
                        "zh": "envelop 的古体形式（意为笼罩、包围）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "покрывать со всех сторон"
                            },
                            {
                                "target_lang_word": "обволакивать",
                                "target_lang_sense_clarification": "о тумане, дыме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "像雾一样覆盖"
                            },
                            {
                                "target_lang_word": "包围",
                                "target_lang_sense_clarification": "从四周环绕"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}