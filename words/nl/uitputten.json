{
    "word_family": [
        "uitputting",
        "uitputtend",
        "putten",
        "put"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "178ce77c-42d1-3e6f-a7d5-6b0d1fb2d5d9",
                    "sense_definition": "iemand fysiek of mentaal volledig moe maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hele dag hardlopen <w>putte</w> hem behoorlijk <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "Running all day <w>exhausted</w> him quite a bit.",
                                "zh": "跑了一整天步让他感到非常<w>精疲力竭</w>。"
                            }
                        },
                        {
                            "text": "Deze zware werkweek zal me volledig <w>uitputten</w> als ik niet oppas.",
                            "target_lang_translations": {
                                "en": "This heavy work week will completely <w>exhaust</w> me if I'm not careful.",
                                "zh": "如果我不注意的话，这周繁重的工作会让我彻底<w>耗尽</w>精力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afmatten",
                        "vermoeien",
                        "slopen"
                    ],
                    "antonyms": [
                        "opladen",
                        "verkwikken"
                    ],
                    "common_phrases": [
                        "iemand volledig uitputten",
                        "zichzelf uitputten"
                    ],
                    "target_lang_definitions": {
                        "en": "to make someone completely tired physically or mentally",
                        "zh": "使某人在身体或精神上完全疲惫"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exhaust",
                                "target_lang_sense_clarification": "to tire out completely"
                            },
                            {
                                "target_lang_word": "wear out",
                                "target_lang_sense_clarification": "to make someone very tired"
                            },
                            {
                                "target_lang_word": "burn out",
                                "target_lang_sense_clarification": "to tire due to overwork"
                            },
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "to deplete someone's energy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使精疲力竭",
                                "target_lang_sense_clarification": "形容身体或精神极度疲劳"
                            },
                            {
                                "target_lang_word": "耗尽",
                                "target_lang_sense_clarification": "指精力或体力被消耗殆尽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e753b611-39ef-3c5d-b0c5-c33a2392ac83",
                    "sense_definition": "een voorraad of bron volledig opgebruiken zodat er niets meer over is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>putten</w> de mijn volledig <w>uit</w> door jarenlang goud te winnen.",
                            "target_lang_translations": {
                                "en": "They <w>depleted</w> the mine completely by extracting gold for years.",
                                "zh": "他们多年来不断开采黄金，最终使这座矿山资源<w>枯竭</w>。"
                            }
                        },
                        {
                            "text": "We moeten oppassen dat we de natuurlijke hulpbronnen niet <w>uitputten</w>.",
                            "target_lang_translations": {
                                "en": "We must be careful not to <w>exhaust</w> natural resources.",
                                "zh": "我们必须小心，不要<w>耗尽</w>自然资源。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opmaken",
                        "verbruiken",
                        "ledigen"
                    ],
                    "antonyms": [
                        "aanvullen"
                    ],
                    "common_phrases": [
                        "een bron uitputten",
                        "de voorraad uitputten"
                    ],
                    "target_lang_definitions": {
                        "en": "to completely use up a supply or resource so that nothing remains",
                        "zh": "完全用尽某种供应或资源，以致所剩无几"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deplete",
                                "target_lang_sense_clarification": "to reduce the amount of a resource"
                            },
                            {
                                "target_lang_word": "exhaust",
                                "target_lang_sense_clarification": "to use up a supply completely"
                            },
                            {
                                "target_lang_word": "drain",
                                "target_lang_sense_clarification": "to use up all of something"
                            },
                            {
                                "target_lang_word": "run dry",
                                "target_lang_sense_clarification": "to use up a source or supply"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耗尽",
                                "target_lang_sense_clarification": "指资源或储备被用光"
                            },
                            {
                                "target_lang_word": "枯竭",
                                "target_lang_sense_clarification": "指资源或水源完全干涸或用完"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}