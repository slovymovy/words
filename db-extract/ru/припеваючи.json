                                "target_senses": [
                                    {
                                        "sense_id": "5660719e-bac5-3ab1-b415-d3f92417afe3",
                                        "entry_id": "1eab18d7-ef0b-3522-ad00-8727ef1191f3",
                                        "glosses": [
                                            "In a condition of prosperity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12ff23a9-77e1-4a7c-b781-75341dc30c34",
                                                "sense_id": "5660719e-bac5-3ab1-b415-d3f92417afe3",
                                                "text": "[S]he resigned herself with noble fortitude to lodging, as one may say, in clover, and feeding on the fat of the land."
                                            },
                                            {
                                                "example_id": "30cddbb7-e1c8-411a-a037-d22a7f1bcc77",
                                                "sense_id": "5660719e-bac5-3ab1-b415-d3f92417afe3",
                                                "text": "A young man belonging to a good London club, having an allowance of £150 a year, and earning £300 a year by driving a taxameter cab, would be in clover."
                                            },
                                            {
                                                "example_id": "78ad9582-8623-439c-9169-6ab6f5ceb672",
                                                "sense_id": "5660719e-bac5-3ab1-b415-d3f92417afe3",
                                                "text": "They tell Sasha, \"There is big money here. You and the kids can get real decent money and live in clover the rest of your lives.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca13d10-8b4f-30e6-ac6b-1635ddd022c6",
                                        "entry_id": "1eab18d7-ef0b-3522-ad00-8727ef1191f3",
                                        "glosses": [
                                            "Happy and contented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8282690a-f44e-4ee5-9eab-7fb9d265db00",
                                                "sense_id": "2ca13d10-8b4f-30e6-ac6b-1635ddd022c6",
                                                "text": "Shelter at Carbury Manor was very much more comfortable than the priest's own establishment, even with the roof on, and Father Barham was in clover."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
