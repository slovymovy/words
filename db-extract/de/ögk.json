                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9da4beea-ad11-3673-97be-1b8f59389a44",
                        "entry_id": "a58bf10c-edd1-3b43-8763-3b5719a26834",
                        "glosses": [
                            "Österreichische Gesellschaft für Kommunikationswissenschaft"
