            "senses": [
                {
                    "sense_id": "89ab33d5-eb47-30cd-b4dd-0675e31c23fe",
                    "sense_definition": "Restaurer l'énergie électrique d'un appareil ou d'une batterie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "electricite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>recharger</w> ton téléphone avant de partir en voyage."
                        },
                        {
                            "text": "Cette voiture électrique met environ six heures pour se <w>recharger</w> complètement."
                        }
                    ],
                    "antonyms": [
                        "décharger"
                    ],
                    "common_phrases": [
                        "recharger la batterie",
                        "recharger son portable",
                        "recharger son téléphone"
                    ]
                },
                {
                    "sense_id": "bb2dde1b-d11a-311e-98ad-b6d21b5e5ca7",
                    "sense_definition": "Charger de nouveau des marchandises ou des objets sur un véhicule.",
