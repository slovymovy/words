                ],
                "senses": [
                    {
                        "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                        "entry_id": "17beb060-5108-3518-9ab2-0228d3e9fc97",
                        "glosses": [
                            "in den Jahren 2014 und 2015 unter dem gleichnamigen Hashtag geführte Kampagne gegen Frauen und LGBTIQ-Personen und ihre Repräsentation in der Computerspielbranche"
                        ],
                        "tags": [
                            "Netzjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "4f2ed3c2-40b7-45a2-8c67-2589f9c66da2",
                                "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                                "text": "„Im vergangenen Jahr hatte dies im Netz eine große Kontroverse ausgelöst, es war von Gamergate die Rede.“"
                            },
                            {
                                "example_id": "ffc594e7-4cce-4ca7-b1f4-521e0b35d33c",
                                "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                                "text": "„Ein Beispiel dafür ist Gamergate, eine Debatte über Sexismus in Videospielen.“"
                            },
                            {
                                "example_id": "d2a8c569-d076-4274-9082-f57d81852e34",
                                "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                                "text": "„Gamergate war ein Kampf mehrheitlich junger Männer, die den Status quo verteidigen wollten. Diesen Kampf nahmen auch rechtsradikale Antifeministen gern auf.“"
                            },
                            {
                                "example_id": "2615eab7-4b1d-4938-af6d-192b2b4e175c",
                                "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                                "text": "„Er bezeichnete mehrere Frauen als \"Feminazis\" und erklärte in einem Beitrag, dass Gamergate für Menschen wie die Retrogame-Sammlerin Catherine DeSpira gemacht worden sei. Die Schriftstellerin und Historikerin wurde ebenso wie Patterson regelmäßig zur Zielscheibe Ferrettis.“"
                            },
                            {
                                "example_id": "4dcd91a6-a9b9-4b86-bd51-3687339cdd38",
                                "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                                "text": "„Tatsächlich wurde im Nachhinein auch versucht, zu argumentieren, dass es bei Gamergate ja um Ethik im Spielejournalismus gegangen wäre. Aber das ist natürlich an den Haaren herbeigezogen.“"
                            },
                            {
                                "example_id": "8223f03d-160f-4b20-878c-ca6f4e493b61",
                                "sense_id": "71c28e95-4102-3ef9-9f79-7a5d2af88860",
                                "text": "„Ich bin einfach genervt, wenn Leute fragen, wie es zu Gamergate kommen konnte. Dabei ist Frauenfeindlichkeit in Strategiespielen so alt wie Schach. Oder wahrscheinlich noch älter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
