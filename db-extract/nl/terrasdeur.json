                        "glosses": [
                            "de deur die een terras vanuit de woning bereikbaar maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8981976a-bed2-488d-8b4b-3ef8e5ec64fa",
                                "sense_id": "9fd35743-1b1e-3047-bfa7-6b59d3c90e9d",
                                "text": "In de laatste weken van haar moeders leven schoof Jojo het ziekenhuisbed dwars voor de terrasdeur, zodat haar moeder als ze haar hoofd iets draaide naar buiten kon kijken en tot op het laatst de vogels kon zien."
                            },
                            {
                                "example_id": "5a4911b2-0649-4073-b8f5-5e617f41c5ab",
                                "sense_id": "9fd35743-1b1e-3047-bfa7-6b59d3c90e9d",
                                "text": "GRONAU - Een of meerdere daders zijn dinsdag aan het begin van de avond met grof geweld een woonhuis aan de Overdinkelstraße in Gronau binnengedrongen, vlakbij de grens met Nederland. Ze gooiden een bloembak door de ruit van de terrasdeur en doorzochten binnen alle kamers en kasten."
                            }
                        ]
                    }
