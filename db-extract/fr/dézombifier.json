                "senses": [
                    {
                        "sense_id": "81a38f4e-c6cd-397f-8cb1-d0066579c445",
                        "entry_id": "828f85b3-6175-3465-a39e-b4ca358c3147",
                        "glosses": [
                            "Retirer le caractère de zombie à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88d493a8-d0a8-40ff-b74d-562fa74e2d60",
                                "sense_id": "81a38f4e-c6cd-397f-8cb1-d0066579c445",
                                "text": "Nous t’avons sauvé, pérora Rodolphe. Tu étais devenu un zombie. On t’a dézombifié"
                            },
                            {
                                "example_id": "1001ff5a-b890-4bd8-b297-397eeb413190",
                                "sense_id": "81a38f4e-c6cd-397f-8cb1-d0066579c445",
                                "text": "Elle doivent se dézombifier, pour ainsi dire, afin de se libérer de l’existence tronquée dans laquelle elles sont prises et afin d’échapper à l’anéantissement."
                            }
                        ]
                    }
                ],
