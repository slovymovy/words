                ],
                "senses": [
                    {
                        "sense_id": "bd871716-acfd-31ef-a0ef-d639de1b5a8e",
                        "entry_id": "a5068371-f97a-393a-b442-52e59f72fc2e",
                        "glosses": [
                            "Handlung mit dem Ziel, dem, was man als seine Pflicht auffasst, gerecht zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea84d21f-edf1-44bf-838c-40bfa4243cca",
                                "sense_id": "bd871716-acfd-31ef-a0ef-d639de1b5a8e",
                                "text": "„Das klingt alles eher nach Pflichterfüllung als nach Freude am gemeinsamen Zusammenleben.“"
                            },
                            {
                                "example_id": "e5618d54-6fca-40fa-a7ec-c8f5cafe284c",
                                "sense_id": "bd871716-acfd-31ef-a0ef-d639de1b5a8e",
                                "text": "„Aber es half nichts, Johanna ließ sich nicht auf den Pfad der weiblichen Pflichterfüllung abdrängen.“"
                            },
                            {
                                "example_id": "d0f0b4b4-5bf6-4f6d-b865-6b32e9395ca2",
                                "sense_id": "bd871716-acfd-31ef-a0ef-d639de1b5a8e",
                                "text": "„Als sie vorhin durch den Wald geritten waren, da hatte Petja immer noch gemeint, er müsse in strenger Pflichterfüllung sofort wieder umkehren.“"
                            },
                            {
                                "example_id": "c245c5ea-c19d-4330-a27e-8bf12c69d4b5",
                                "sense_id": "bd871716-acfd-31ef-a0ef-d639de1b5a8e",
                                "text": "„Die Atmosphäre im Hause Busch muß von einer puritanischen Herbheit gewesen sein, und es scheint, daß die Zuneigung der Eltern sich vor allem in reibungsloser, vielleicht etwas kühler Pflichterfüllung äußerte.“"
                            },
                            {
                                "example_id": "c98571b7-0916-47ac-8c5c-8e9a1ab1c1c2",
                                "sense_id": "bd871716-acfd-31ef-a0ef-d639de1b5a8e",
                                "text": "„Er blickte zu Mathis auf, um zu sehen, ob diese Spitzfindigkeiten hinsichtlich einer Sache, die für Mathis lediglich eine Frage der Pflichterfüllung war, ihn sehr langweilten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
