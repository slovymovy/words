                    {
                        "sense_id": "0d8dea39-cbaa-3d27-9da2-f363a8ece9c2",
                        "entry_id": "4e2a2ca3-e7d6-32f8-a6c7-446b189de014",
                        "glosses": [
                            "comparative form of fast: more fast"
                        ],
