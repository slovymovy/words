                "senses": [
                    {
                        "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                        "entry_id": "febf5043-ea70-3e62-becf-929abdabe5a9",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb46845-7112-4e85-bd0a-ebc5f6028993",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Frau Aschemann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f95905cf-9905-47c0-af60-761058358547",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Herr Aschemann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "edb0fd45-f790-4002-a153-bb75121d7dba",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Die Aschemanns kommen heute aus Vorarlberg."
                            },
                            {
                                "example_id": "a4de9e55-ece4-4205-af6c-38e39be9c4ff",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Der Aschemann trägt nie die Schals, die die Aschemann ihm strickt."
                            },
                            {
                                "example_id": "044f1f40-c6ef-411a-88c2-79cfe4332147",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aschemann kommt, geht der Herr Aschemann.“"
                            },
                            {
                                "example_id": "95823e5a-a91f-40cf-b83d-d4386b3cc6d3",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Aschemann kommt und geht."
                            },
                            {
                                "example_id": "19f10cb0-cda8-4191-9e94-bf9b7408dda8",
                                "sense_id": "c04e165a-76d2-3e1d-9037-26e93cba13f6",
                                "text": "Aschemanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
