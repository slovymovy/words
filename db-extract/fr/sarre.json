            {
                "entry_id": "67b7cefd-dc2b-3609-a826-2125d2ef08c9",
                "word": "Sarre",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e6d495b1-153e-323f-a36f-22ff30f7a6b7",
                        "entry_id": "67b7cefd-dc2b-3609-a826-2125d2ef08c9",
                        "glosses": [
                            "Successivement ancienne province française de l’Ancien Régime (1675-1697), ancien département français (de 1797 à 1815), mandat de la Société des Nations (1920-1935), et protectorat français (1947–1957)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf09a13-cb79-4181-84f3-a02d4f103a48",
                                "sense_id": "e6d495b1-153e-323f-a36f-22ff30f7a6b7",
                                "text": "Dès le 16 juin 1947, la France, qui avait déjà établi un cordon douanier autour de la Sarre, procéda à une première réforme monétaire, l’échange du mark allemand contre un mark sarrois, première étape avant l’introduction du franc."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a1def9b-792f-3873-ac78-72f3ff5804af",
                        "entry_id": "67b7cefd-dc2b-3609-a826-2125d2ef08c9",
                        "glosses": [
                            "Un des seize Länder qui constituent la République fédérale d’Allemagne. Sa capitale est Sarrebruck."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "f32781a4-715d-449b-8ff9-f239edce6cba",
                                "sense_id": "8a1def9b-792f-3873-ac78-72f3ff5804af",
                                "text": "Quand des Alsaciens ou des Mosellans se précipitaient dans le Bade-Wurtemberg, la Sarre ou la Rhénanie-Palatinat pour faire le plein, chercher du tabac ou acheter des produits d’hygiène…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f65b613c-a607-44cd-b18d-b85dd70ccacc",
                        "source_entry_id": "67b7cefd-dc2b-3609-a826-2125d2ef08c9",
                        "source_sense_id": "e6d495b1-153e-323f-a36f-22ff30f7a6b7",
