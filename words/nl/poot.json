                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond gaf braaf een <w>poot</w> aan zijn baasje.",
                            "target_lang_translations": {
                                "en": "The dog obediently gave a <w>paw</w> to its owner.",
                                "ru": "Собака послушно дала <w>лапу</w> своему хозяину.",
                                "pl": "Pies grzecznie podał <w>łapę</w> swojemu właścicielowi.",
                                "de": "Der Hund gab seinem Besitzer brav eine <w>Pfote</w>.",
                                "fr": "Le chien a sagement donné la <w>patte</w> à son maître.",
                                "it": "Il cane ha dato ubbidientemente la <w>zampa</w> al suo padrone.",
                                "cs": "Pes poslušně podal <w>tlapu</w> svému pánovi.",
                                "tr": "Köpek sahibine uslu bir şekilde <w>pati</w> verdi.",
                                "es": "El perro le dio obedientemente la <w>pata</w> a su dueño.",
                                "zh": "那只狗乖乖地向主人伸出了<w>爪子</w>。"
                            }
                        },
                        {
                            "text": "Spinnen hebben acht <w>poten</w> en insecten hebben er zes.",
                            "target_lang_translations": {
                                "en": "Spiders have eight <w>legs</w> and insects have six.",
                                "ru": "У пауков восемь <w>лап</w>, а у насекомых — шесть.",
                                "pl": "Pająki mają osiem <w>nóg</w>, a owady mają ich sześć.",
                                "de": "Spinnen haben acht <w>Beine</w> und Insekten haben sechs.",
                                "fr": "Les araignées ont huit <w>pattes</w> et les insectes en ont six.",
                                "it": "I ragni hanno otto <w>zampe</w> e gli insetti ne hanno sei.",
                                "cs": "Pavouci mají osm <w>nohou</w> a hmyz jich má šest.",
                                "tr": "Örümceklerin sekiz <w>bacağı</w>, böceklerin ise altı bacağı vardır.",
                                "es": "Las arañas tienen ocho <w>patas</w> y los insectos tienen seis.",
                                "zh": "蜘蛛有八条<w>腿</w>，昆虫有六条。"
