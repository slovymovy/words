                        ],
                        "examples": [
                            {
                                "example_id": "3587bfe9-8f10-4c3c-b98f-70406d5077ab",
                                "sense_id": "c9b55228-1395-3a89-8520-4b18fbc9cfab",
                                "text": "Ich spießte mit meiner Gabel einen Tortellino auf. »So schnell machst du dicht? Dabei habe ich dir ja noch nicht einmal von meiner furchterregenden Porzellanpuppensammlung erzählt.«"
                            },
                            {
                                "example_id": "1cda3d32-6b2e-4f75-b771-eae319da995f",
                                "sense_id": "c9b55228-1395-3a89-8520-4b18fbc9cfab",
                                "text": "»Hab dir ja gesagt, man lernt auch im TV was.« Sie schob sich den nächsten Tortellino genüsslich in den Mund."
                            },
                            {
                                "example_id": "cf9e8562-33e8-4a7e-88e7-74de61925eb2",
                                "sense_id": "c9b55228-1395-3a89-8520-4b18fbc9cfab",
                                "text": "„Was ist?“, fragte er kauend. „Warum glotzt ihr so? Schmeckt es euch nicht?“\n„Doch“, antwortete ich und piekste einen Tortellino mit der Gabel auf. Nach dem Schwimmen habe ich immer doppelt so viel Hunger wie sonst."
                            }
                        ]
                    }
