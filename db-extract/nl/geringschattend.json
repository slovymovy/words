        "nl-extract.jsonl": [
            {
                "entry_id": "34ed7a3e-4cc0-3727-ad4e-10a89ca0234e",
                "word": "geringschattend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4d36590f-ef91-3595-89eb-078e660b2aee",
                        "entry_id": "34ed7a3e-4cc0-3727-ad4e-10a89ca0234e",
                        "glosses": [
                            "van iets of iemand dat je vindt dat het van weinig of geen waarde is en dat je jezelf gerechtigd voelt om dat oordeel te vellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9aa4c1e-785a-4126-8e48-bee0fe63de8a",
                                "sense_id": "4d36590f-ef91-3595-89eb-078e660b2aee",
                                "text": "Als leidinggevend lid van de Académie Royale des Sciences werd hij ook geacht een ter zake kundige en actieve belangstelling te hebben voor allerlei actuele onderwerpen zoals hypnose, de hervorming van het gevangeniswezen, de ademhaling van insecten, de watervoorziening van Parijs. In die hoedanigheid maakte Lavoisier een paar geringschattende opmerkingen betreffende een nieuwe theorie over het verbrandingsproces die een hoopvolle jonge wetenschapper de academie had voorgelegd. De theorie was inderdaad onjuist, maar de wetenschapper heeft het hem nooit vergeven. Hij heette Jean-Paul Marat."
                            },
                            {
                                "example_id": "7f799d39-6c24-4e84-b2e9-11de1d920815",
                                "sense_id": "4d36590f-ef91-3595-89eb-078e660b2aee",
                                "text": "„Migrantenclubjes.” Zo worden zelforganisaties voor migranten vandaag genoemd in het Brabants Dagblad. „Clubjes” – een geringschattend verkleinwoordje. Om aan te geven hoe weinig men tegenwoordig op heeft met deze organisaties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d55c2e15-0701-49eb-8026-2db1ff2ef26f",
                        "source_entry_id": "34ed7a3e-4cc0-3727-ad4e-10a89ca0234e",
                        "source_sense_id": "4d36590f-ef91-3595-89eb-078e660b2aee",
                        "source_sense_description": "van iets of iemand dat je vindt dat het van weinig of geen waarde is en dat je jezelf gerechtigd voelt om dat oordeel te vellen",
