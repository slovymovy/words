    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "43b6e90c-4c06-366e-be92-42da78897c0e",
                    "sense_definition": "Relating to democracy or the principle of government chosen by the people.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "political_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Citizens in a <w>democratic</w> country have the right to choose their leaders.",
                            "target_lang_translations": {
                                "ru": "Граждане <w>демократической</w> страны имеют право выбирать своих лидеров.",
                                "zh": "<w>民主</w>国家的公民有权选择他们的领导人。"
                            }
                        },
                        {
                            "text": "Free and fair elections are essential for a <w>democratic</w> government.",
                            "target_lang_translations": {
                                "ru": "Свободные и честные выборы необходимы для <w>демократического</w> правительства.",
                                "zh": "自由公正的选举对于<w>民主</w>政府至关重要。"
                            }
                        }
                    ],
                    "antonyms": [
                        "undemocratic",
                        "nondemocratic"
                    ],
                    "common_phrases": [
                        "democratic society",
                        "democratic government",
                        "democratic process",
                        "democratic country",
                        "democratic elections"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к демократии или принципу управления, при котором власть выбирается народом.",
                        "zh": "与民主或由人民选择政府的原则相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демократический",
                                "target_lang_sense_clarification": "относящийся к политическому устройству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民主的",
                                "target_lang_sense_clarification": "指政治制度或原则"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ad065e6-f414-3de5-a68c-9be6afc2b41e",
                    "sense_definition": "Relating to or supporting the Democratic Party, one of the two major political parties in the United States.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Democratic</w> candidate promised to improve the healthcare system.",
                            "target_lang_translations": {
                                "ru": "Кандидат от <w>Демократической</w> партии пообещал улучшить систему здравоохранения.",
                                "zh": "<w>民主党</w>候选人承诺改善医疗保健系统。"
                            }
                        },
                        {
                            "text": "She has been a loyal member of the <w>Democratic</w> Party for many years.",
                            "target_lang_translations": {
                                "ru": "Она была преданным членом <w>Демократической</w> партии на протяжении многих лет.",
                                "zh": "多年来，她一直是<w>民主党</w>的忠实成员。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Democratic Party",
                        "Democratic candidate",
                        "Democratic senator",
                        "Democratic convention"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "capitalized"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Демократической партии, одной из двух основных политических партий в США.",
                        "zh": "与美国两大主要政党之一的民主党相关的或支持该党的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демократический",
                                "target_lang_sense_clarification": "относящийся к Демократической партии США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民主党的",
                                "target_lang_sense_clarification": "指美国民主党"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4723641-9059-3cb0-9614-a8c7f291293d",
                    "sense_definition": "Based on social equality; treating everyone equally.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher uses a <w>democratic</w> style to manage the classroom discussions.",
                            "target_lang_translations": {
                                "ru": "Учитель использует <w>демократичный</w> стиль ведения дискуссий в классе.",
                                "zh": "老师用一种<w>民主</w>的风格来管理课堂讨论。"
                            }
                        },
                        {
                            "text": "They appreciated the <w>democratic</w> spirit of the community organization.",
                            "target_lang_translations": {
                                "ru": "Они ценили <w>демократичный</w> дух этой общественной организации.",
                                "zh": "他们赞赏该社区组织所体现的<w>民主</w>精神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "democratical"
                    ],
                    "common_phrases": [
                        "democratic spirit",
                        "democratic values",
                        "democratic atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на социальном равенстве; относящийся ко всем одинаково, простой в общении.",
                        "zh": "基于社会平等；平等对待每一个人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демократичный",
                                "target_lang_sense_clarification": "простой, доступный, без сословных предрассудков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民主的",
                                "target_lang_sense_clarification": "指作风平易近人、平等对待他人"
                            },
                            {
                                "target_lang_word": "民主作风的",
                                "target_lang_sense_clarification": "指管理或处事方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "287b805e-e3e9-3f09-b29a-6d3a88bb7791",
                    "sense_definition": "A supporter of democracy or democratic politics.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>democratics</w> of the time argued fiercely against the rule of the king.",
                            "target_lang_translations": {
                                "ru": "<w>Демократы</w> того времени яростно выступали против правления короля.",
                                "zh": "当时的<w>民主人士</w>激烈地反对国王的统治。"
                            }
                        },
                        {
                            "text": "He was known as one of the most passionate <w>democratics</w> in the movement.",
                            "target_lang_translations": {
                                "ru": "Он был известен как один из самых страстных <w>демократов</w> в движении.",
                                "zh": "他被认为是该运动中最热情的<w>民主派</w>之一。"
                            }
                        }
                    ],
                    "synonyms": [
                        "democrat"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторонник демократии или демократической политики.",
                        "zh": "民主或民主政治的支持者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демократ",
                                "target_lang_sense_clarification": "сторонник демократии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民主人士",
                                "target_lang_sense_clarification": "支持民主的人"
                            },
                            {
                                "target_lang_word": "民主派",
                                "target_lang_sense_clarification": "主张民主的群体或个人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
