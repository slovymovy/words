                        "entry_id": "bd1ab043-0369-3a0a-a23c-ff58ea15790c",
                        "glosses": [
                            "État de ce qui est hypermoderne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd97a407-514b-44f5-b93b-d1b65c0fc29c",
                                "sense_id": "f904ff78-c24e-3408-a830-820b1f4f13bc",
                                "text": "L’hypermodernité de certaines techniques ne saurait faire office d'alibi de nos conservatismes."
                            },
                            {
                                "example_id": "06c9d6db-8fb6-4b9d-8bfb-e6cf1b4c11e4",
                                "sense_id": "f904ff78-c24e-3408-a830-820b1f4f13bc",
                                "text": "Je ressentais une excitation secrète d’être au cœur même d’une hypermodernité dont ce lieu me paraissait l’emblème fascinant. C'était comme une promotion existentielle."
                            }
                        ]
                    },
                    {
                        "sense_id": "1389d175-8753-3df1-8400-35cc138d2dcc",
                        "entry_id": "bd1ab043-0369-3a0a-a23c-ff58ea15790c",
                        "glosses": [
                            "Épistémè qui succède à la modernité et la postmodernité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b82ea27-91a3-44a3-90de-42538789f92d",
                                "sense_id": "1389d175-8753-3df1-8400-35cc138d2dcc",
                                "text": "L’hypermodernité comporte une attention particulière à tous les processus de médiation, aux « entre-deux »."
                            }
                        ]
                    }
