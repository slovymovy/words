                ],
                "senses": [
                    {
                        "sense_id": "9da08245-00e6-3c26-9580-a2b8fb7d73a1",
                        "entry_id": "49e2e5b0-3369-389b-b2c8-feb8caaa0415",
                        "glosses": [
                            "Relatif aux troglodytes ou à leur pays."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "94ea3082-345d-49f3-a5b2-37d8b15b0246",
                                "sense_id": "9da08245-00e6-3c26-9580-a2b8fb7d73a1",
                                "text": "La côte troglodytique."
                            }
                        ]
                    },
                    {
                        "sense_id": "9329d5b1-9741-3052-8623-6942a5337ff5",
                        "entry_id": "49e2e5b0-3369-389b-b2c8-feb8caaa0415",
                        "glosses": [
                            "Qui est creusée dans la roche ou qui utilise une caverne, en parlant d’une habitation, d’une tombe, etc."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "73b109ad-594e-4944-b434-300de9f6c6f9",
                                "sense_id": "9329d5b1-9741-3052-8623-6942a5337ff5",
                                "text": "Quelques-unes de ces tombes troglodytiques renferment, au dire du docteur Leipsius, le corps de plusieurs hauts personnages qui portent le titre singulier de : nourrice mâle d'un prince royal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1555d7f1-0ada-442a-9916-3a7e9704582d",
                        "source_entry_id": "49e2e5b0-3369-389b-b2c8-feb8caaa0415",
                        "target_lang_word": "troglodytic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troglodytic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22c7137f-054d-321b-a9a9-bbd119adeff2",
                                        "entry_id": "a3b7244a-b84c-3d8a-ac80-4d29ecd0e74f",
                                        "glosses": [
                                            "Of or pertaining to troglodytes, or dwellers in caves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac47fc1-3cb0-4eff-8ede-883fb222bf1e",
                                                "sense_id": "22c7137f-054d-321b-a9a9-bbd119adeff2",
                                                "text": "Foremost of all, of course, were the sight of the fiery caves and the certainty that some troglodytic race inhabited them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a31cc0-aa0a-3fdf-aeb8-d3ad7a01b3a4",
                                        "entry_id": "a3b7244a-b84c-3d8a-ac80-4d29ecd0e74f",
                                        "glosses": [
                                            "Like or befitting a troglodyte; brutish, backwards, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99138f2f-0dee-410a-9832-c92280be1080",
                                                "sense_id": "e9a31cc0-aa0a-3fdf-aeb8-d3ad7a01b3a4",
                                                "text": "\"There is something more, if I could find a name for it. God bless me, the man seems hardly human! Something troglodytic, shall we say? or can it be the old story of Dr. Fell? or is it the mere radiance of a foul soul that thus transpires through, and transfigures, its clay continent? The last, I think; for, O my poor old Harry Jekyll, if ever I read Satan’s signature upon a face, it is on that of your new friend.”"
                                            },
                                            {
                                                "example_id": "7e0a8fdd-bb7a-4956-90c3-00126a843be8",
                                                "sense_id": "e9a31cc0-aa0a-3fdf-aeb8-d3ad7a01b3a4",
                                                "text": "You have my thanks for not closing debate in Community Voices, so that the late but thoughtful and intelligent contributions to a controversy isn't squelched. I've found this usually means clawing one's way through mounds of troglodytic gay male misogyny and an occasional off-the-wall lesbian interpretation of gay male sexuality, but it's worth it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
