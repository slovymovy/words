                    "frequency": "Low",
                    "semantic_group_id": "incomplete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind werd geboren in een <w>onvolkomen</w> stuitligging.",
                            "target_lang_translations": {
                                "de": "Das Kind wurde in einer <w>unvollkommenen</w> Steißlage geboren.",
                                "en": "The child was born in an <w>incomplete</w> breech presentation."
                            }
                        },
                        {
                            "text": "Zonder deze cruciale documenten blijft het dossier helaas <w>onvolkomen</w>.",
                            "target_lang_translations": {
                                "de": "Ohne diese entscheidenden Dokumente bleibt die Akte leider <w>unvollständig</w>.",
                                "en": "Without these crucial documents, the file unfortunately remains <w>incomplete</w>."
                            }
                        }
                    ],
                    "synonyms": [
