                "senses": [
                    {
                        "sense_id": "f82c3615-cae0-3d5e-8af8-9723e82fcbad",
                        "entry_id": "bcb617d9-e952-395a-914f-e64fff32af6a",
                        "glosses": [
                            "een woning voornamelijk bestaande uit een voor- en achterkamer gescheiden door schuifdeuren"
                        ],
                        "tags": [
                            "wonen"
                        ],
                        "examples": [
                            {
                                "example_id": "14b8af6f-7ab6-4c27-8ba0-340ebd17cb2c",
                                "sense_id": "f82c3615-cae0-3d5e-8af8-9723e82fcbad",
                                "text": "Toen hij zijn suite betrok, werd dit ingeluid met een concertje tussen de schuifdeuren."
                            }
                        ]
                    },
                    {
                        "sense_id": "359b7742-d1d3-3abd-80db-2d6faa3c13e3",
                        "entry_id": "bcb617d9-e952-395a-914f-e64fff32af6a",
                        "glosses": [
                            "een uitgebreide hotelkamer, vaak bestaande uit meer dan een vertrek"
                        ],
                        "tags": [
                            "horeca"
                        ],
                        "examples": [
                            {
                                "example_id": "21978fd4-6b6c-4ddd-9c10-eb1eb4a4fe29",
                                "sense_id": "359b7742-d1d3-3abd-80db-2d6faa3c13e3",
                                "text": "Dit alles zou ik geneigd zijn positief te beoordelen. Daar staat echter tegenover dat deze vaas met plastic bloemen reden geeft tot zorgen met betrekking tot de affiniteit die de nieuwe eigenaar heeft met onze tradities. Maar ik wil u niet met mijn bekommeringen vervelen. We zijn er. Dit is kamer 17, de suite die ik voor u op orde heb laten brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e7d29f8-d272-3898-a742-d99473bbb852",
                        "entry_id": "bcb617d9-e952-395a-914f-e64fff32af6a",
                        "glosses": [
                            "een muziekstuk bestaande uit een opeenvolging van een aantal dansen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93195056-7dc2-437f-bfe5-b9711197a561",
                                "sense_id": "6e7d29f8-d272-3898-a742-d99473bbb852",
                                "text": "De klassieke suite bestond gewoonlijk uit een allemande, een courante en een sarabande met als slotstuk een snelle gigue."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f58a3da-751d-3140-adcd-1f7dd417f336",
                        "entry_id": "bcb617d9-e952-395a-914f-e64fff32af6a",
                        "glosses": [
                            "een groep gesteenten die chemisch, mineralogisch of anderszins bij elkaar horen, maar geen duidelijke gelaagdheid of andere structuur vertonen waarop ze in eenheden in te delen zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4f2606-f9a7-4c83-9141-1aa4c5bbe0f3",
                                "sense_id": "2f58a3da-751d-3140-adcd-1f7dd417f336",
                                "text": "Stollingsgesteentes worden vaak in suites ingedeeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "b66c235c-f0ac-3f43-a58a-1433bcd1ed70",
                        "entry_id": "bcb617d9-e952-395a-914f-e64fff32af6a",
                        "glosses": [
                            "een reeks van drie of meer opeenvolgende kaarten"
                        ],
