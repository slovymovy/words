            {
                "entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                "word": "dudgeon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                        "entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                        "glosses": [
                            "A feeling of anger or resentment, especially haughty indignation."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "de92d1af-e62d-4d16-9086-29588c5613f9",
                                "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                                "text": "All gentle folks who owe a grudge / To any living thing, / Open your ears and stay your trudge / Whilst I in dudgeon sing."
                            },
                            {
                                "example_id": "e9bb87a9-eb58-431d-a16d-0f32a34c515a",
                                "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                                "text": "To crown his discontent, his approach was utterly unnoticed by that capricious damsel. He dashed away in dudgeon from the house at an early hour, certainly less regretted by the maid than by the master of the inn."
                            },
                            {
                                "example_id": "4f7fa310-e0b8-43ae-a023-3f4f6671960c",
                                "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                                "text": "[…] I have reason to know that she took its impressment into the service of boiling my egg and broiling my bacon, in dudgeon; for I saw her, with my own discomfited eyes, shake her fist at me once […]"
                            },
                            {
                                "example_id": "5f0f31c4-c0ed-40d5-8255-00fa1109305b",
                                "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                                "text": "You may take the whole damned houseful if you like. Except the jewels. Theyre hired. Will that satisfy you? [He turns on his heel and is about to go in extreme dudgeon]."
                            },
                            {
                                "example_id": "c8099631-da46-411f-8eca-583a5d33623e",
                                "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                                "text": "[W]ith girls of high and haughty spirit you have to watch your step, especially if they have red hair, like Bobbie. If they think you're talking out of turn, dudgeon ensues, and dudgeon might easily lead her to reach for the ginger ale bottle and bean me with it."
                            },
                            {
                                "example_id": "2fb73dd3-e26d-4f17-bfcc-b85dcf67e991",
                                "sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                                "text": "In her typical appearances on Fox News, Jeanine Pirro, a former Republican district attorney, reserves her highest dudgeon for castigating liberals and lamenting the demise of law and order."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e042e4c4-2d9d-49e9-bb66-05f3eeb7d2c5",
                        "source_entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                        "source_sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                        "source_sense_description": "feeling of anger or resentment, especially haugthy indignation",
                        "target_lang_word": "Groll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Groll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                        "entry_id": "0e986053-3c41-3cc6-9559-1c080cedb95d",
                                        "glosses": [
                                            "lang anhaltender, aber stiller Zorn, versteckter Hass, verborgene Feindschaft"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bc33cee-b7af-4530-acb1-7c29633edf26",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "Ich hege keinen Groll gegen dich, ich bin einfach sehr beschäftigt."
                                            },
                                            {
                                                "example_id": "907690f2-5d6f-4824-b5e1-11b24e989a41",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "Peter hat einen tiefen Groll auf seine Exfrau."
                                            },
                                            {
                                                "example_id": "6e4365f2-2ffa-4e6e-bc18-42bb9aba7f06",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Steinmeiers Worten hört man Groll selbst dann nicht an, wenn es Zoff gegeben hat.“"
                                            },
                                            {
                                                "example_id": "53fbf068-f7f0-43df-aab0-253546f7a7d3",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Sie waren viel zu verspielt, um sich von oben mit Feindseligkeit und Groll und Erbitterung indoktrinieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "3bce2ec0-969d-4621-9eb0-2c40059752cf",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Da fühle ich einen kleinen Groll gegen Karnej in mir erwachen.“"
                                            },
                                            {
                                                "example_id": "ff79420c-5df3-411d-a091-30803b222e12",
                                                "sense_id": "88ec58a7-d0d2-347b-99ec-9ea098219158",
                                                "text": "„Ein hübsches Sümmchen ist das, und ihre Freude darüber mildert ihren Groll auf Jürgen Loose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d7c951e-749e-31e2-949a-b681c60b1ec2",
                                        "entry_id": "0e986053-3c41-3cc6-9559-1c080cedb95d",
                                        "glosses": [
                                            "plötzlich aufwallender und hervorbrechender Zorn"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff66d92-5e84-4cc7-8518-379f34bdfbb7",
                                                "sense_id": "4d7c951e-749e-31e2-949a-b681c60b1ec2",
                                                "text": "In einem Anfall von Groll erwürgte Mechthild ihre Tante."
                                            },
                                            {
                                                "example_id": "04d1a7a9-109f-4fbb-aa2b-2e2635c6ef9b",
                                                "sense_id": "4d7c951e-749e-31e2-949a-b681c60b1ec2",
                                                "text": "„Der Leser muß mich verabscheuen, das ist mir klar; aber ich rate ihm, mit seinem Groll zu warten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec25e230-ce52-47b0-98f6-8f84989ebb17",
                        "source_entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                        "source_sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                        "source_sense_description": "feeling of anger or resentment, especially haugthy indignation",
                        "target_lang_word": "Empörung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empörung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "708b2101-3e75-310d-910a-160c129126ac",
                                        "entry_id": "9f616b25-f457-37c9-ae97-57f9417f9d27",
                                        "glosses": [
                                            "stark emotionale Verärgerung über etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77e71357-c2c6-47d7-91b4-f972918d29d8",
                                                "sense_id": "708b2101-3e75-310d-910a-160c129126ac",
                                                "text": "Die Sozialverbände reagierten mit Empörung auf den Vorschlag des Ministers."
                                            },
                                            {
                                                "example_id": "5b4566af-ff2f-4135-ab28-b32b7be5c826",
                                                "sense_id": "708b2101-3e75-310d-910a-160c129126ac",
                                                "text": "„Österreichs Empörung führte letztlich zu der Kriegserklärung an Serbien.“"
                                            },
                                            {
                                                "example_id": "e914581f-3722-4967-9ed5-c886deafbad1",
                                                "sense_id": "708b2101-3e75-310d-910a-160c129126ac",
                                                "text": "„Ein Aufschrei der Empörung ging durch die Presse.“"
                                            },
                                            {
                                                "example_id": "ae980bef-d12a-433a-8ddd-46b3dec6fe38",
                                                "sense_id": "708b2101-3e75-310d-910a-160c129126ac",
                                                "text": "„Nachdem Hunderte Menschen stundenlang erfolglos nach Eiern, Butter, Käse und vor allem Kartoffeln angestanden hatten, machte sich ihre Empörung in Protesten Luft.“"
                                            },
                                            {
                                                "example_id": "d08b1d5a-274d-45db-8a36-f8230f98ec88",
                                                "sense_id": "708b2101-3e75-310d-910a-160c129126ac",
                                                "text": "„In ganz Tijuana ist Unsicherheit und Empörung zu spüren, auch Wut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0078eb7c-2890-3bef-9c62-9a58626ef3b4",
                                        "entry_id": "9f616b25-f457-37c9-ae97-57f9417f9d27",
                                        "glosses": [
                                            "Auflehnung gegen bestehende (Hierarchie-)Verhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36dda027-f79e-4e55-9930-0f19501fa7ef",
                                                "sense_id": "0078eb7c-2890-3bef-9c62-9a58626ef3b4",
                                                "text": "Die Empörung der Arbeiter wurde blutig niedergeschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d7c1ade-14fa-42ef-bf25-43547bfc7298",
                        "source_entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                        "source_sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                        "source_sense_description": "feeling of anger or resentment, especially haugthy indignation",
                        "target_lang_word": "Wut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd04e869-be4e-39ed-812f-0eab7f5bdc9e",
                                        "entry_id": "cd552220-0c9c-3ec9-bb83-ed0baa4f7c3e",
                                        "glosses": [
                                            "starke Gemütserregung, ein Gefühl großen Ärgers, oft in Verbindung mit aggressivem Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d452532-6a4f-4e35-a98f-90a9d007ee87",
                                                "sense_id": "bd04e869-be4e-39ed-812f-0eab7f5bdc9e",
                                                "text": "„Hugo klang, als schluchzte er selbst vor Empörung und Wut.“"
                                            },
                                            {
                                                "example_id": "c03b9976-5254-4438-9a3a-92f4c06cf020",
                                                "sense_id": "bd04e869-be4e-39ed-812f-0eab7f5bdc9e",
                                                "text": "„Und der Umstand, dass ihm das nicht früher eingefallen war, steigerte seine Wut noch.“"
                                            },
                                            {
                                                "example_id": "cfccf7f0-a1cd-4d90-aa56-cc792f22c68d",
                                                "sense_id": "bd04e869-be4e-39ed-812f-0eab7f5bdc9e",
                                                "text": "Voller Wut schrie sie ihn an."
                                            },
                                            {
                                                "example_id": "34a30839-5cd3-46e4-a7c0-1dfff9fe7fae",
                                                "sense_id": "bd04e869-be4e-39ed-812f-0eab7f5bdc9e",
                                                "text": "„Zdenek sprach stockend und voller Wut und riß Grasbüschel aus.“"
                                            },
                                            {
                                                "example_id": "ec0911d3-8f03-4de1-9c70-1460f5eb0132",
                                                "sense_id": "bd04e869-be4e-39ed-812f-0eab7f5bdc9e",
                                                "text": "„Denn sie hatte gemerkt, dass sich ein Teil ihrer Traurigkeit in Wut umwandelte und dass diese Wut Worte brauchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4abd35cf-0888-4b1b-893b-6be2910765ca",
                        "source_entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                        "source_sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                        "source_sense_description": "feeling of anger or resentment, especially haugthy indignation",
                        "target_lang_word": "Zorn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zorn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee515a01-b294-347f-a0dc-9b6a4b15ff74",
                                        "entry_id": "dfb73202-75f3-3438-8647-98dbd19fcbeb",
                                        "glosses": [
                                            "starkes und heftiges Gefühl, das negativ gegen etwas oder jemanden gerichtet ist, weil etwas als nicht richtig empfunden wird oder nicht den eigenen Wünschen entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6cfba5d-02f5-43e3-9128-ee19f157b90f",
                                                "sense_id": "ee515a01-b294-347f-a0dc-9b6a4b15ff74",
                                                "text": "„Sie drückt den allgemeinen Zorn über soziale Ungerechtigkeit aus und die Angst davor, dass die Krise das bisschen Wohlstand zerstört, das sich bisher vor den Stürmen der Globalisierung bewahren ließ.“"
                                            },
                                            {
                                                "example_id": "ac546a97-e086-4671-bf00-70c2852da55d",
                                                "sense_id": "ee515a01-b294-347f-a0dc-9b6a4b15ff74",
                                                "text": "„In diesem Augenblick fühlte er nichts anderes als einen unbestimmten Zorn, einen tiefen Widerwillen und den Beginn einer grenzenlosen Hoffnungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "6e00a90a-a945-4ccf-b731-cee61ac845b1",
                                                "sense_id": "ee515a01-b294-347f-a0dc-9b6a4b15ff74",
                                                "text": "„Das heizte seinen Zorn an.“"
                                            },
                                            {
                                                "example_id": "352b3bf3-4fe8-4704-9014-5de9e7f8df74",
                                                "sense_id": "ee515a01-b294-347f-a0dc-9b6a4b15ff74",
                                                "text": "„Nicht einmal der Nieselregen schaffte es, seinen Zorn zu kühlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "798b15ad-81a1-4270-8f41-f698be8eefbe",
                        "source_entry_id": "50d86fe2-8484-35df-8e7b-892c3d1bbba0",
                        "source_sense_id": "9e393d7e-e1a8-3558-bda4-f9574407996e",
                        "source_sense_description": "feeling of anger or resentment, especially haugthy indignation",
                        "target_lang_word": "Entrüstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entrüstung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                        "entry_id": "df5d4cd4-df02-3036-8c85-916d983a16ce",
                                        "glosses": [
                                            "Gefühl der Beleidigung in seinem sittlichen Empfinden"
                                        ],
                                        "tags": [
                                            "Plural ungebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5878b502-7332-43d7-b11c-14a086626ca7",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "Vor Entrüstung über die freche Antwort fehlten dem Lehrer die Worte."
                                            },
                                            {
                                                "example_id": "2451b3de-0311-4fd5-991b-693d10f6670e",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "Ein britischer Fernsehsender hat eine Weihnachtsansprache des iranischen Präsidenten Mahmud Ahmadinedschad ausgestrahlt und damit einen Sturm der Entrüstung ausgelöst."
                                            },
                                            {
                                                "example_id": "28dc0e80-1429-4b47-aea9-243cf021e0d5",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "Mit Entrüstung reagieren die Telekom-Konkurrenten auf die Pläne des Ex-Monopolisten, die Miete für die Teilnehmeranschlussleitung zu erhöhen."
                                            },
                                            {
                                                "example_id": "807c5147-1cd8-4656-a9bd-99207b21ef8e",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "„Meine Entrüstung ist ungebrochen.“"
                                            },
                                            {
                                                "example_id": "3cacb0dd-95b8-4eb3-bba4-1d58b482d651",
                                                "sense_id": "567ce811-569a-3912-911b-6f72c0395e76",
                                                "text": "„Ein Sturm der Entrüstung bricht los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
