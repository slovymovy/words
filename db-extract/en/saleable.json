                                        "entry_id": "e14ec0d3-1730-3596-b18d-3d6c35a77a7c",
                                        "glosses": [
                                            "vorgesehen, gegen Bezahlung abgegeben werden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf0efeb7-a917-4b8d-a2c6-71bde1ba4ebc",
                                                "sense_id": "498b8c7e-8715-3a46-aec1-b5bdb3bdc85c",
                                                "text": "Alle hier präsentierten Schnitzarbeiten können erworben werden, nur das Ansichtsexemplar ist nicht verkäuflich."
                                            },
                                            {
                                                "example_id": "ea518778-e690-49ca-9846-e979660319e1",
                                                "sense_id": "498b8c7e-8715-3a46-aec1-b5bdb3bdc85c",
                                                "text": "„Während der Handel mit Elefanten-Elfenbein aus Artenschutzgründen strikt untersagt ist, ist das Elfenbein der ausgestorbenen Mammuts frei verkäuflich, weswegen Elefanten-Elfenbein häufig als Mammut-Elfenbein deklariert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
