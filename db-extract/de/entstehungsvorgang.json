                "senses": [
                    {
                        "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                        "entry_id": "c586c3c5-69c9-3f8f-8ed5-256febb990ce",
                        "glosses": [
                            "Ablauf, der etwas hervorbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3124984-5af9-44c2-9134-958996939489",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Der Entstehungsvorgang eines Bildes ist durchaus kompliziert, wie Daniel Walter erläutert: ‚Um ein Foto zu veröffentlichen, überlege ich mir erst mal, welche Produkte in Frage kommen, danach werde ich circa zwei Stunden damit verbringen, mich zu schminken.‘“"
                            },
                            {
                                "example_id": "58a56710-836b-45c5-85d0-04bfe9c3cf15",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Als ‚parametrisches Entwerfen‘ bezeichnen die Architekten den Entstehungsvorgang: Die runden Formen werden dabei geometrisch in kleine ebene Teile zerlegt, in Dreiecke, Vierecke oder Vielecke.“"
                            },
                            {
                                "example_id": "840f98b4-4a01-407b-84ac-c39ff0770577",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Denn jedes Kunstwerk, auch das selbstverständlich erscheinende, ist das - oft willkürlich stillgestellte - Ergebnis eines komplexen Entstehungsvorgangs.“"
                            },
                            {
                                "example_id": "4ea6a01c-35c7-479e-a38c-c5bb78d34ae1",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Der Entstehungsvorgang des menschlichen Papillarleistensystems lässt sich vereinfacht wie folgt beschreiben: Der Prozess wird eingeleitet, wenn sich kurze Zeit davor die Tastballen an Händen und Füßen durch eine starke Blutzufuhr aufblähen und dadurch die Oberhaut (vgl. Abschn. 4.2) stark gespannt wird.“"
                            },
                            {
                                "example_id": "2471ff47-45a0-470d-8ee8-a7aefd7e0bf1",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Der Entstehungsvorgang des Verkehrsgeräusches (Fahrzeug, Motorgeräusch) wird durch ein lineares System mit mehreren Eingängen und einem Ausgang gekennzeichnet.“"
                            },
                            {
                                "example_id": "d7de90c1-66bb-4126-8329-e9584df81a9e",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Den Ausgangspunkt zur Erforschung der Ursachen und Entstehungsvorgänge von Geschwülsten bildeten Beobachtungen am Menschen.“"
                            },
                            {
                                "example_id": "22b751c5-2aff-401c-8661-63b68545f7cd",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Diese mehrfache Verwendung beleuchtet Le Corbusiers Auffassung vom Verhältnis architektonischer Entwurfsprozesse zu den Entstehungsvorgängen von Gemälden und Skulpturen.“"
                            },
                            {
                                "example_id": "061302d3-112b-4bc0-9ee2-36824ae2fb47",
                                "sense_id": "e4bece56-bda7-3fa9-8530-8f936b9e815a",
                                "text": "„Und folglich muß der Grund, warum in dem einen Falle die vorhandene Empfindung von uns bemerft wird, im andern dagegen unbemerft und unbemerkbar bleibt, wo anders als in dem Entstehungsvorgange der Empfindung liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
