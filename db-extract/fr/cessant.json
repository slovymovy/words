                        "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                        "entry_id": "2a0a8a69-c1b0-3325-bc4a-5a3ecd064acc",
                        "glosses": [
                            "Qui cesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4cca634-cbef-4e57-af0c-3428861f3039",
                                "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                                "text": "Note : Il ne s’emploie guère que dans ces phrases :"
                            },
                            {
                                "example_id": "16ff4f3e-2b34-447f-b1af-6861544e0ae8",
                                "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                                "text": "Tous empêchements cessants."
                            },
                            {
                                "example_id": "362006b9-0c74-45cd-add0-34d02163324f",
                                "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                                "text": "Toutes choses cessantes."
                            },
                            {
                                "example_id": "d11358cc-a7ed-4958-8d05-9f94bc1da57c",
                                "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                                "text": "Toutes affaires cessantes."
                            },
                            {
                                "example_id": "7093800b-6fae-4550-8122-5c757d879712",
                                "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                                "text": "Toute affaire cessante."
                            },
                            {
                                "example_id": "e316b358-23ff-42ed-bb02-86f64aa9827b",
                                "sense_id": "089ef5c3-33f4-3189-8855-a11afece3a94",
                                "text": "Il tenait à me voir, ne serait-ce qu’une fois, avant de mourir. J’accourus, toutes études cessantes, et, sur le bateau, je me préparai au rôle qu’il m’incomberait de jouer, m’agenouiller à son chevet, tenir courageusement sa main refroidie en l’écoutant murmurer ses dernières recommandations."
                            }
                        ]
                    }
