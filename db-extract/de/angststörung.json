                "senses": [
                    {
                        "sense_id": "8bfc1a89-e0d9-353b-bfd1-f414afa56428",
                        "entry_id": "e24cbbe7-e73a-30d9-b268-a46499364e95",
                        "glosses": [
                            "psychiatrische Erkrankung mit Angstgefühlen als vorherrschendes Symptom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f9ccd8-01d2-4931-b234-af1ab4f71693",
                                "sense_id": "8bfc1a89-e0d9-353b-bfd1-f414afa56428",
                                "text": "Die posttraumatische Belastungsstörung geht oft mit einer Angststörung einher."
                            },
                            {
                                "example_id": "9fbdf5c4-ed24-40fb-a7da-b1f7a6d0f682",
                                "sense_id": "8bfc1a89-e0d9-353b-bfd1-f414afa56428",
                                "text": "„Weitere Indikationen der Thymoleptika sind Angst- und Zwangsstörungen, Entzugssyndrome sowie Schmerzbehandlung.“"
                            },
                            {
                                "example_id": "1620c07d-2b8b-4fb3-aad0-9122eeca9e94",
                                "sense_id": "8bfc1a89-e0d9-353b-bfd1-f414afa56428",
                                "text": "„Rund 75 bis 80 Prozent der autistischen Erwachsenen haben zusätzlich eine psychiatrische Diagnose, am häufigsten Angststörungen, ADHS, Schizophrenie und Depression.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
