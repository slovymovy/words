    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bc8e022-9234-3225-8d12-55d9615e37ce",
                    "sense_definition": "Bij tegenwind zigzagsgewijs opzeilen met een schip.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeilen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip moest <w>laveren</w> om de haven tegen de wind in te bereiken."
                        },
                        {
                            "text": "Door te <w>laveren</w> konden ze toch vooruitkomen ondanks de sterke tegenwind."
                        }
                    ],
                    "synonyms": [
                        "opkruisen"
                    ],
                    "common_phrases": [
                        "tegen de wind laveren"
                    ]
                },
                {
                    "sense_id": "40a59289-4143-30e0-a578-44fc6d021228",
                    "sense_definition": "Bepaalde dilemma's of moeilijkheden trachten te omzeilen door belangen af te wegen, schipperen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus moest <w>laveren</w> tussen de verschillende standpunten van zijn achterban."
                        },
                        {
                            "text": "Het is lastig om te <w>laveren</w> tussen werk en privé in deze drukke tijden."
                        }
                    ],
                    "common_phrases": [
                        "laveren tussen standpunten"
                    ]
                },
                {
                    "sense_id": "7db9bd55-3bf5-3cd0-9d2d-4df8606cfcd9",
                    "sense_definition": "Zigzagsgewijs of met moeite ergens doorheen bewegen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze waren met veel moeite door de nauwe straat <w>gelaveerd</w>."
                        },
                        {
                            "text": "De fietser moest <w>laveren</w> om de vele obstakels op de weg te ontwijken."
                        }
                    ]
                },
                {
