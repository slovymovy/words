                "senses": [
                    {
                        "sense_id": "ec692330-08cd-3400-83c5-ce816ca6c391",
                        "entry_id": "a8cc62da-ca40-3721-86e5-48db5db7a1a9",
                        "glosses": [
                            "Un barbiturique, le di-éthyl malonylurée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e59561f-27f6-41f5-8a56-f685fd44a940",
                                "sense_id": "ec692330-08cd-3400-83c5-ce816ca6c391",
                                "text": "Je me serais trompé de boîte de médicament et, au lieu de prendre quelques cachets de véronal un jour où je sentais que j’avais bu trop de tasses de thé, j’aurais pris autant de cachets de caféine, que mon cœur n’eût pas pu battre plus violemment."
                            },
                            {
                                "example_id": "07934357-7c7e-46bb-8688-87117466f6b9",
                                "sense_id": "ec692330-08cd-3400-83c5-ce816ca6c391",
                                "text": "Au-dessus de la toilette, un pain de savon, un onguent en pot, des cachets d’aspirine et un tube de véronal."
                            },
                            {
                                "example_id": "b9174c75-6c06-4f01-9df1-f75b69b97e4d",
                                "sense_id": "ec692330-08cd-3400-83c5-ce816ca6c391",
                                "text": "J’avais pris, malgré la défense du docteur, un cachet de véronal et m’étais endormi profondément."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa3cb62d-374a-4eb0-b019-ecea633d08f5",
                        "source_entry_id": "a8cc62da-ca40-3721-86e5-48db5db7a1a9",
                        "source_sense_id": "ec692330-08cd-3400-83c5-ce816ca6c391",
                        "target_lang_word": "veronal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veronal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73d816fc-6658-3a1a-a480-e23477014bd2",
                                        "entry_id": "e626dbf5-0e15-3537-9d39-219667574ffd",
                                        "glosses": [
                                            "A barbiturate, used formerly to induce sleep."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "702cbb30-98c6-4f22-b5ce-ad8babb37fcc",
                                                "sense_id": "73d816fc-6658-3a1a-a480-e23477014bd2",
                                                "text": "He was by now so worn out that he could not resist my firmness. I gave him a sufficient dose of veronal to insure his unconsciousness for several hours. I thought that was the best service I could render him."
                                            },
                                            {
                                                "example_id": "0e46b961-c5be-43c7-a267-6c3a77929945",
                                                "sense_id": "73d816fc-6658-3a1a-a480-e23477014bd2",
                                                "text": "She died of an overdose of veronal. She's been taking it lately for sleeplessness. Must have taken too much."
                                            },
                                            {
                                                "example_id": "b7a8cec9-4f2e-4d39-badc-d07218769133",
                                                "sense_id": "73d816fc-6658-3a1a-a480-e23477014bd2",
                                                "text": "I have seen the Brazilian press photograph of Zweig and Lotte, his second wife, lying dead of their overdoses of veronal on two pushed-together single iron bedsteads, he on his back, mouth a little agape, in a sweat-stained shirt and knitted tie, she on his shoulder in a floral wrap and clean hair, and you can practically hear the ceiling fan going round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
