                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef96a992-9624-34b2-adc8-6dcc29478cd6",
                                        "entry_id": "90a59bf0-b546-3ccc-abb2-a92a48b7697a",
