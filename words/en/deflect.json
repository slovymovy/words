{
    "word_family": [
        "deflection",
        "deflective",
        "deflector"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86e7b707-5f2f-34d3-ab0f-803d8be68b0f",
                    "sense_definition": "To cause something to change direction or deviate from its original path or course.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sturdy shield managed to <w>deflect</w> the blow and save the guard.",
                            "target_lang_translations": {
                                "ru": "Прочный щит сумел <w>отразить</w> удар и спасти стражника."
                            }
                        },
                        {
                            "text": "Thick clouds can <w>deflect</w> sunlight back into outer space.",
                            "target_lang_translations": {
                                "ru": "Густые облака могут <w>отражать</w> солнечный свет обратно в космос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflect a blow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо изменить направление или траекторию движения; отражать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонять",
                                "target_lang_sense_clarification": "менять направление движения"
                            },
                            {
                                "target_lang_word": "отражать",
                                "target_lang_sense_clarification": "удар, лучи или свет"
                            },
                            {
                                "target_lang_word": "отбивать",
                                "target_lang_sense_clarification": "удар или нападение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c1cbf28-0b76-371b-b686-66919bd473dc",
                    "sense_definition": "To divert attention, focus, or energy away from oneself or another subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "redirect_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>deflect</w> attention away from the growing scandal.",
                            "target_lang_translations": {
                                "ru": "Политик попытался <w>отвлечь</w> внимание от разгорающегося скандала."
                            }
                        },
                        {
                            "text": "Humor is often used to <w>deflect</w> scrutiny during awkward moments.",
                            "target_lang_translations": {
                                "ru": "Юмор часто используют, чтобы <w>отвести</w> от себя пристальное внимание в неловкие моменты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflect attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переключать или отвлекать внимание, интерес или энергию от себя или определенной темы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвлекать",
                                "target_lang_sense_clarification": "внимание или взгляд"
                            },
                            {
                                "target_lang_word": "переключать",
                                "target_lang_sense_clarification": "внимание на другое"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "подозрения или пристальное внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a34497e3-693e-3510-a770-16f458a3be67",
                    "sense_definition": "To avoid answering or addressing questions, accusations, or criticism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "redirect_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spokesperson attempted to <w>deflect</w> questions regarding the budget deficit.",
                            "target_lang_translations": {
                                "ru": "Пресс-секретарь попытался <w>уклониться от</w> вопросов о дефиците бюджета."
                            }
                        },
                        {
                            "text": "He managed to <w>deflect</w> criticism by praising his team's hard work.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>парировать</w> критику, похвалив усердную работу своей команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "elude"
                    ],
                    "common_phrases": [
                        "deflect criticism",
                        "deflect questions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избегать ответов на вопросы, отбиваться от обвинений или критики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "от ответов или критики"
                            },
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "выпады, критику, вопросы"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "критику или претензии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d3aab8e-7d3e-3b9e-9117-4bb75f9d1577",
                    "sense_definition": "To touch or strike a moving ball, causing it to alter direction unpredictably.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defender accidentally <w>deflected</w> the cross into his own net.",
                            "target_lang_translations": {
                                "ru": "Защитник случайно <w>срезал</w> навес в свои ворота."
                            }
                        },
                        {
                            "text": "The goalkeeper tried to push the shot wide, but only <w>deflected</w> it toward the attacker.",
                            "target_lang_translations": {
                                "ru": "Вратарь попытался отбить мяч в сторону, но лишь <w>отбил его рикошетом</w> прямо на нападающего."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflect the shot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Касаться летящего мяча или шайбы, меняя траекторию их движения (рикошетить, срезать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рикошетить",
                                "target_lang_sense_clarification": "отскоком менять направление мяча"
                            },
                            {
                                "target_lang_word": "срезать",
                                "target_lang_sense_clarification": "случайно изменить полет мяча касанием"
                            },
                            {
                                "target_lang_word": "отклонять",
                                "target_lang_sense_clarification": "траекторию мяча"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef92715d-bd94-3442-9a9b-52cbf5864b80",
                    "sense_definition": "To turn aside or deviate from an original direction or path.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bullet struck the stone wall and <w>deflected</w> harmlessly into the bushes.",
                            "target_lang_translations": {
                                "ru": "Пуля ударилась о каменную стену и <w>отрикошетила</w> в кусты, не причинив никому вреда."
                            }
                        },
                        {
                            "text": "The needle will <w>deflect</w> slightly when exposed to a magnetic field.",
                            "target_lang_translations": {
                                "ru": "Стрелка слегка <w>отклонится</w> под воздействием магнитного поля."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сворачивать в сторону, отклоняться от первоначального курса или направления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "о траектории, стрелке прибора"
                            },
                            {
                                "target_lang_word": "рикошетить",
                                "target_lang_sense_clarification": "отскакивать в сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6398982-6c5e-347e-95b8-3030545e10f5",
                    "sense_definition": "To shift blame, responsibility, or culpability onto someone or something else to avoid consequences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "redirect_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rather than admitting his error, the manager tried to <w>deflect</w> blame onto the junior staff.",
                            "target_lang_translations": {
                                "ru": "Вместо признания своей ошибки менеджер попытался <w>переложить</w> вину на младший персонал."
                            }
                        },
                        {
                            "text": "She was adept at <w>deflecting</w> responsibility whenever a project failed.",
                            "target_lang_translations": {
                                "ru": "Она умело <w>снимала с себя</w> ответственность всякий раз, когда проект терпел неудачу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflect blame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перекладывать или отводить вину, ответственность на кого-то другого, чтобы избежать последствий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перекладывать",
                                "target_lang_sense_clarification": "вину или ответственность"
                            },
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "вину на другого"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "от себя вину"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}