                                        "glosses": [
                                            "Variante orthographique de doberman (race de chien)."
                                        ],
                                        "tags": [
                                            "Zootechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab9a32e5-6a47-4dd6-b2d9-e3e306838644",
                                                "sense_id": "1ac96d92-9eb4-357e-a464-d03b687948ee",
                                                "text": "Comme le montre l’étude, publiée dans Neuro-Psychopharmacology and Biological Psychiatry, les dobermanns atteints de Toc présentent les particularités retrouvées chez les patients humains."
                                            }
                                        ]
