                        "examples": [
                            {
                                "example_id": "f563d229-a3cb-400d-b844-e49d8e02124b",
                                "sense_id": "f3d6619a-810d-3195-9432-648a2612a080",
                                "text": "On leaving Wye, we find the country changing character; the Downs come closer to the line, and grazing gives way to orchards and hop-gardens, with pleasant farm buildings, including oasthouses, another characteristic Kentish sight."
                            },
                            {
                                "example_id": "6e44a767-1566-458c-9de7-063ab3305ebb",
                                "sense_id": "f3d6619a-810d-3195-9432-648a2612a080",
                                "text": "The church has a high, typically Kentish, tower, begun in the 15th century, while parts of the main structure date from two centuries earlier."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a872cea-ed6a-39ef-940b-0ad35296af35",
                        "entry_id": "bdd64da7-abff-3b79-9046-3bd8ff96a8e2",
                        "glosses": [
                            "From the western part of Kent (whose inhabitants are traditionally called \\\"Kentish men\\\" and \\\"Kentish maids\\\"), as opposed to the eastern part (whose inhabitants are \\\"men of Kent\\\" and \\\"maids of Kent\\\")."
