                "senses": [
                    {
                        "sense_id": "6fb0a48a-6ce7-3fcf-a6a6-fd5a151ff2bb",
                        "entry_id": "e092af14-97f2-345f-abf0-0fce33bbb66b",
                        "glosses": [
                            "Teil der Erdoberfläche, der sich durch Gebirgsstrukturen von der Umgebung abhebt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "059e258a-9297-4360-93ae-d4f4bbc227bd",
                                "sense_id": "6fb0a48a-6ce7-3fcf-a6a6-fd5a151ff2bb",
                                "text": "„Ihr hochgezogener Vorhang öffnet den Blick auf rohgemalte Kulissen und Versatzstücke, die eine Gebirgslandschaft darstellen.“"
                            },
                            {
                                "example_id": "f21dee12-657a-48a8-845f-27ece8124fd9",
                                "sense_id": "6fb0a48a-6ce7-3fcf-a6a6-fd5a151ff2bb",
                                "text": "„Er beginnt mit dem Absprung zweier amerikanischer Spione, die mit ihren Fallschirmen über eine verschneite Gebirgslandschaft fliegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
