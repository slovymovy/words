                ],
                "senses": [
                    {
                        "sense_id": "22961aae-c6de-3019-8553-54edf71f1f19",
                        "entry_id": "050600d2-bb13-364c-a31e-ec161f6d232e",
                        "glosses": [
                            "ein auf Schleimhäute oder Wunden zusammenziehend, und damit entzündungshemmend und blutstillend wirkendes Arzneimittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a63c081-099e-4f99-9d31-7b1b2e4e539d",
                                "sense_id": "22961aae-c6de-3019-8553-54edf71f1f19",
                                "text": "„Adstringentien werden arzneilich verwendet, um Blutungen aus kleinen Blutgefäßen zu stillen […] oder in der Behandlung von entzündlichen, nässenden und juckenden Hauterkrankungen.“"
                            },
                            {
                                "example_id": "4cbf1840-65ac-41f8-81da-6d6881bf4643",
                                "sense_id": "22961aae-c6de-3019-8553-54edf71f1f19",
                                "text": "„Die »Piscine« war ein Raum, in dem die neuankommenden Mädchen – ein Heer von Agenten wählte sie in den Provinzen aus – gebadet und hergerichtet wurden; die Eau de pucelle, ein Adstringens, war unentbehrlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4cbc8a17-2bb2-3a61-ab7b-af8f1c0380ad",
                        "entry_id": "050600d2-bb13-364c-a31e-ec161f6d232e",
                        "glosses": [
                            "Fähigkeit eines Weines, ein „raues“, „pelziges“ Mundgefühl zu verursachen und die Mundhöhle zusammenzuziehen"
                        ],
                        "tags": [
                            "Weinsprache"
                        ],
