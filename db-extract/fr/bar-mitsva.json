                ],
                "senses": [
                    {
                        "sense_id": "bdf7dd36-e22f-33ed-99cf-5d4890a25f7b",
                        "entry_id": "7160f8eb-ff95-370c-9ea8-f0c60a3d3666",
                        "glosses": [
                            "Rite initiatique par lequel le jeune garçon juif marque sa majorité, en principe à 13 ans."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "2812d26c-2051-4e5d-901f-8d863b8259f8",
                                "sense_id": "bdf7dd36-e22f-33ed-99cf-5d4890a25f7b",
                                "text": "Au sens propre, bar-mitsva (notez l'orthographe en français) est la cérémonie de confirmation, dans la religion hébraïque, des garçons qui ont atteint l'âge de 13 ans."
                            },
                            {
                                "example_id": "2058b9f5-0ee9-4632-b8fc-977b98e24184",
                                "sense_id": "bdf7dd36-e22f-33ed-99cf-5d4890a25f7b",
                                "text": "Maurice, le père d’Emma, offre à Jacques son Talit, le grand châle de prière des hommes :\n– Ainsi, il portera son grand-père sur son dos le jour où il montera à la Torah, dit Maurice à sa fille, évoquant ainsi la bar-mitsva de son petit-fils."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91d8bdb2-c036-405c-945e-681303504294",
                        "source_entry_id": "7160f8eb-ff95-370c-9ea8-f0c60a3d3666",
                        "source_sense_id": "bdf7dd36-e22f-33ed-99cf-5d4890a25f7b",
                        "target_lang_word": "Bar-Mizwa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bar-Mizwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                        "entry_id": "1845a29e-e39d-3dd7-9d67-56a76e7f4741",
                                        "glosses": [
                                            "jüdischer Junge, der sich am Sabbat nach dessen 13. Geburtstag auf die religiösen Vorschriften des Judentums verpflichtet"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b35a590-dc59-4cdc-8c48-10f97b25a874",
                                                "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                                "text": "„Drei Monate vorher wird der Bar-Mizwa im Anlegen der Tephelin (s. d. A.) und in den damit in Verbindung stehenden Gesetzen unterrichtet.“"
                                            },
                                            {
                                                "example_id": "9cc4c99d-89c3-4e46-92e7-ff9b459f05ff",
                                                "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                                "text": "„Mit der Hilfe eines Lehrers und eines Rabbis bereitet sich Albert darauf vor, ein ‚Bar-Mizwa‘, ein vollwertiges Mitglied in der jüdischen Gemeinde zu werden.“"
                                            },
                                            {
                                                "example_id": "dcab5ced-1c00-4bcf-834f-a40b37135c18",
                                                "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                                "text": "„Im Alter von 13 Jahren wurde ich wie jeder jüdische Junge ein Bar-Mizwa.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bar-Mizwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79d51f50-2f9e-3f56-b086-b69ce4cc39c2",
                                        "entry_id": "c2dc1e50-1a34-35b0-be9b-7f618be1822a",
                                        "glosses": [
                                            "Feier zur Einführung der »Bar-Mizwas« in die jüdische Glaubensgemeinschaft, bei der sie ihre Religionsmündigkeit erwerben"
                                        ],
                                        "tags": [
                                            "jüdische Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c4c8480-241b-4c57-8e1e-3c2fdb6125b5",
                                                "sense_id": "79d51f50-2f9e-3f56-b086-b69ce4cc39c2",
                                                "text": "Die Bar-Mizwa ist entfernt mit der Konfirmation oder Erstkommunion vergleichbar."
                                            },
                                            {
                                                "example_id": "c3bba2cc-540e-462b-83fa-e0d4b6242682",
                                                "sense_id": "79d51f50-2f9e-3f56-b086-b69ce4cc39c2",
                                                "text": "„Die Verfolgung ‚zionistischer Verbindungen‘ und ‚Aktivitäten‘ während der frühen Jahre der DDR schüchterte viele jüdische Intellektuelle ein und brachte sie dahin, ihre jüdischen Wurzeln zu verleugnen. Es gab bis 1987 keinen Rabbiner und keinen Mohel, zum Judesein unerlässliche Rituale wie Beschneidung und Bar-Mizwa wurden verhindert.“"
                                            },
                                            {
                                                "example_id": "48d6c228-4968-4876-9f67-4d432b889ae6",
                                                "sense_id": "79d51f50-2f9e-3f56-b086-b69ce4cc39c2",
                                                "text": "„Wie alle Burschen seines Alters, die Bar-Mizwa feiern wollen, hat er ein Jahr lang dafür gelernt.“"
                                            },
                                            {
                                                "example_id": "e18e660f-c398-440f-8dcb-3190459551d9",
                                                "sense_id": "79d51f50-2f9e-3f56-b086-b69ce4cc39c2",
                                                "text": "„Sehr merkwürdig ist, dass Canetti für die Darstellung seiner Jugend- und Schulzeit später nie auf die Bar-Mizwa zu sprechen kommt, also auf die traditionelle Aufnahme der Jungen in die jüdische Gemeinde mit dreizehn Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
