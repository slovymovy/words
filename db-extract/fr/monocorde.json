                        "entry_id": "dd29e985-1312-3e66-9f26-a32227812b1b",
                        "glosses": [
                            "Qualifie un instrument doté d’une seule corde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c7275fc-e4ff-4de5-814d-2011e47276b8",
                                "sense_id": "3a16491a-1855-3dda-899c-d16f73aa2069",
                                "text": "Un instrument monocorde."
                            }
                        ]
                    },
                    {
                        "sense_id": "713a864d-4e90-3bc3-8515-8d3dc52bef41",
                        "entry_id": "dd29e985-1312-3e66-9f26-a32227812b1b",
                        "glosses": [
                            "Parlé sur un seul ton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d9cf438-40c2-4532-8536-3a6c38f47a7e",
                                "sense_id": "713a864d-4e90-3bc3-8515-8d3dc52bef41",
                                "text": "Lire un texte d'une voix monocorde."
                            },
                            {
                                "example_id": "5340f17b-dbf1-42c8-9bd6-5c4fabf2de33",
                                "sense_id": "713a864d-4e90-3bc3-8515-8d3dc52bef41",
                                "text": "Elle continuait d’un ton rapide, monocorde, presque comme s’il s’agissait de réciter une leçon apprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "8723a64d-4a41-35d8-800c-03054f6fa612",
                        "entry_id": "dd29e985-1312-3e66-9f26-a32227812b1b",
                        "glosses": [
                            "Qualifie un orateur, un écrivain qui emploie toujours les mêmes procédés, qui fait toujours vibrer la même corde."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f50d77f-9bef-4617-93a0-06a6bf3ead3b",
                        "source_entry_id": "dd29e985-1312-3e66-9f26-a32227812b1b",
                        "source_sense_description": "Qualifie un orateur",
                        "target_lang_word": "monotone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32c943f7-a39c-3d9b-9c46-4061cd64491f",
                                        "entry_id": "355069a0-ad01-39d6-aefa-d5a9b214252a",
                                        "glosses": [
                                            "Having a single unvaried pitch."
                                        ],
                                        "tags": [
                                            "of speech or a sound"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b25e4c0-6e13-49e1-a19e-d714df01daa0",
                                                "sense_id": "32c943f7-a39c-3d9b-9c46-4061cd64491f",
                                                "text": "The prominence of the syllables is more monotone than in English, the intonation of the latter having a larger variation of stressed and unstressed syllables."
                                            },
                                            {
                                                "example_id": "0534518e-68c6-40aa-81f8-f0679b62d14a",
                                                "sense_id": "32c943f7-a39c-3d9b-9c46-4061cd64491f",
                                                "text": "In the formal register, such variation is reduced and the talk has a more monotone, business-like quality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cd5a9a4-98ed-33d2-9205-c30ed6184c9d",
                                        "entry_id": "355069a0-ad01-39d6-aefa-d5a9b214252a",
                                        "glosses": [
                                            "Of a function: that is always nonincreasing or nondecreasing on an interval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea7255e-9df1-4ad3-be36-bc7d679eb7fb",
                                                "sense_id": "3cd5a9a4-98ed-33d2-9205-c30ed6184c9d",
                                                "text": "The function f(x)#58;#61;x³ is monotone on #92;R, while g(x)#58;#61;x² is not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5866d10-7daf-3dee-be6b-0ccfe10b513f",
                                        "entry_id": "355069a0-ad01-39d6-aefa-d5a9b214252a",
                                        "glosses": [
                                            "Synonym of monochrome."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monotone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb6452f-3bf6-3dfc-8492-8201e24b01e1",
                                        "entry_id": "180c3ec7-0539-336b-a14a-13c40b5d2beb",
                                        "glosses": [
                                            "A single unvaried tone of speech or a sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5fedc12-955e-49d9-931b-b1526f7d4b9f",
                                                "sense_id": "8bb6452f-3bf6-3dfc-8492-8201e24b01e1",
                                                "text": "When Tima felt like her parents were treating her like a servant, she would speak in monotone and act as though she were a robot."
                                            },
                                            {
                                                "example_id": "1f7f9e93-30ad-41ce-985c-5a985b745cef",
                                                "sense_id": "8bb6452f-3bf6-3dfc-8492-8201e24b01e1",
                                                "text": "It is no very difficult matter to be loud in a high tone of voice; but to be loud and forcible in a low tone, requires great practice and management; this, however, may be facilitated by pronouncing forcibly at firſt in a low monotone; a monotone, though in a low key, and without force, is much more ſonorous and audible than when the voice ſlides up and down at almoſt every word, as it muſt do to be various."
                                            },
                                            {
                                                "example_id": "a1a8bb8b-29b6-4728-a551-89f8a7eefd8e",
                                                "sense_id": "8bb6452f-3bf6-3dfc-8492-8201e24b01e1",
                                                "text": "There is a water-break formed by a small terrace of rock in mid-stream, and purling with a hollow, delicious monotone—an island of pebbles is above, with here and there smaller ones near the \"forks.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c48bf6-6a33-3844-9ba9-69736823184f",
                                        "entry_id": "180c3ec7-0539-336b-a14a-13c40b5d2beb",
                                        "glosses": [
                                            "A piece of writing in one strain throughout."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monotone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ee86463-d24c-35fd-8962-43c37f3b4a1c",
                                        "entry_id": "71e10f14-c8a2-3441-ab99-32d13cf34dd5",
                                        "glosses": [
                                            "To speak in a monotone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
