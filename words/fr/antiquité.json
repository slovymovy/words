                    "frequency": "Middle",
                    "semantic_group_id": "objet_ancien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes grands-parents aiment chiner et acheter des <w>antiquités</w> dans les brocantes le dimanche."
                        },
                        {
                            "text": "Ce marchand vend des <w>antiquités</w> rares provenant de vieux châteaux de la région."
                        }
                    ],
                    "common_phrases": [
