                                        "sense_id": "8298fd4d-285e-306c-aff3-231e2e2ad230",
                                        "entry_id": "eba31618-f5d8-3c76-8c7c-5f2f14562eb1",
                                        "glosses": [
                                            "unità strutturale di organizzazione del DNA in una cellula, insieme a specifiche proteine, col compito di conservare e trasmettere i caratteri ereditari, quindi dai genitori verso i figli"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afa980dc-96b8-438d-9479-4bc30bd42ffa",
                                                "sense_id": "8298fd4d-285e-306c-aff3-231e2e2ad230",
                                                "text": "il numero dei cromosomi dell'uomo è 46"
                                            },
                                            {
                                                "example_id": "f848195a-f734-415f-8888-eb58d705e06e",
                                                "sense_id": "8298fd4d-285e-306c-aff3-231e2e2ad230",
                                                "text": "nel 2006 la rivista Nature ha pubblicato la sequenza del cromosoma umano"
                                            },
                                            {
                                                "example_id": "6057a247-3b26-4cdf-893e-1e22a400f961",
                                                "sense_id": "8298fd4d-285e-306c-aff3-231e2e2ad230",
                                                "text": "nei mammiferi le femmine hanno due cromosomi X, i maschi hanno un cromosoma X e un cromosoma Y"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
