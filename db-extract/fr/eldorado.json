                ],
                "senses": [
                    {
                        "sense_id": "47578605-373f-36ee-a479-4dcbc78b3b15",
                        "entry_id": "56b0ae3f-0d9d-32c1-90bb-339d6bb35349",
                        "glosses": [
                            "Contrée imaginaire que l’on croyait située dans l’Amérique du Sud et très riche en or et en pierres précieuses."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5bf2acdd-c283-3d33-8570-31343009d209",
                        "entry_id": "56b0ae3f-0d9d-32c1-90bb-339d6bb35349",
                        "glosses": [
                            "Pays imaginaire, où chacun vit au sein de l’abondance et des richesses."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "1fd48169-06e3-4724-9c6b-04459cd0a984",
                                "sense_id": "5bf2acdd-c283-3d33-8570-31343009d209",
                                "text": "Ce sont ces idéologues, pourfendeurs des experts et apôtres de la gratuité, qui monopolisent la nouvelle pensée presque unique qui fait d’Internet un eldorado libertaire."
                            },
                            {
                                "example_id": "7c1e13d6-4d9b-4ded-8816-c3cc12a64831",
                                "sense_id": "5bf2acdd-c283-3d33-8570-31343009d209",
                                "text": "Notre incompréhension devant l’inconnu a dressé aux quatre coins du monde un atlas mythologique. Des centaines d'endroits où la virginité et le merveilleux se sont mués en eldorados, en paradis perdus, en enfers verts, en mirages et en abîmes."
                            },
                            {
                                "example_id": "5f3bc5b6-52ba-4d5d-b78f-916ffbb5a9c7",
                                "sense_id": "5bf2acdd-c283-3d33-8570-31343009d209",
                                "text": "La reconnaissance faciale en temps réel dans l’espace public, c’est l’eldorado policier, cela revient à un contrôle d’identité permanent et général."
                            }
                        ]
                    }
                ],
