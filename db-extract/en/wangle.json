                        "source_entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
                        "source_sense_description": "obtain through manipulative of deceitful methods",
                        "target_lang_word": "sehnat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sehnat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "79362a05-5878-3ac8-ac29-7818e94be4cc",
                                        "entry_id": "b8c6a7f7-3826-34b8-a73f-eca42c12ac20",
                                        "glosses": [
                                            "hnaním přimět sejít dolů"
                                        ],
                                        "tags": [
                                            "sehnat směrem dolů"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "332b67ff-30ea-4436-9641-023ecdf607ca",
                                                "sense_id": "79362a05-5878-3ac8-ac29-7818e94be4cc",
                                                "text": "Horalé sehnali stáda s hor do žďárských dřevěných chlévů…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8308582-a594-3f59-becc-9aceecc00e8c",
                                        "entry_id": "b8c6a7f7-3826-34b8-a73f-eca42c12ac20",
                                        "glosses": [
                                            "s úsilím shromáždit"
                                        ],
                                        "tags": [
                                            "sehnat směrem dohromady"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c17a7a0-55ee-4b97-bab5-924082e4dc4d",
                                                "sense_id": "a8308582-a594-3f59-becc-9aceecc00e8c",
                                                "text": "Jeden z nich (…) celé město pobouřil a obyvatelstvo jeho k zátoce přístavní sehnal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad43770e-a20e-33e0-b51b-a354dfdd7d44",
                                        "entry_id": "b8c6a7f7-3826-34b8-a73f-eca42c12ac20",
                                        "glosses": [
                                            "najít, koupit či jinak obstarat s vynaložením určitého úsilí a času"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec0939a7-e147-4ed5-8157-9497ff8585ff",
                                                "sense_id": "ad43770e-a20e-33e0-b51b-a354dfdd7d44",
                                                "text": "Třásl se celou noc. Pak něco vypil a dříve než sehnali lékaře, vypustil duši."
                                            },
                                            {
                                                "example_id": "0b2ffe0b-39dd-493d-8341-ba5d78c72f73",
                                                "sense_id": "ad43770e-a20e-33e0-b51b-a354dfdd7d44",
                                                "text": "Za tyhle peníze seženeš všechno."
                                            },
                                            {
                                                "example_id": "5253cb67-4b11-4c18-81c0-370dd400028f",
                                                "sense_id": "ad43770e-a20e-33e0-b51b-a354dfdd7d44",
                                                "text": "Mnozí organizátoři už nyní sčítají odpadlíky a tvrdí, že EET rozvoj farmářských trhů výrazně zpomalí. A bojí se, že až budou muset příští rok evidovat skoro všichni, neseženou prodejce a trhy začnou skomírat."
                                            },
                                            {
                                                "example_id": "5857fc68-8da4-4f2b-8d12-754e1e2665c6",
                                                "sense_id": "ad43770e-a20e-33e0-b51b-a354dfdd7d44",
                                                "text": "Pěknej kabát! Kdes ho sehnal?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01085513-0baf-4f67-9962-b829e4841006",
                        "source_entry_id": "5eb77d1f-832b-31a0-a753-3cdf250d166b",
