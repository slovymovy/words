            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f643dfe6-487f-38ec-9194-8684853818ea",
                    "sense_definition": "To calm or make a person or animal unconscious by administering a drug or medication.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sedate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wildlife team had to <w>tranquilize</w> the aggressive bear before moving it to a safer habitat.",
                            "target_lang_translations": {
                                "tr": "Yaban hayatı ekibi, saldırgan ayıyı daha güvenli bir yaşam alanına taşımadan önce <w>uyuşturmak</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "The vet decided to <w>tranquilize</w> the injured dog to examine its wounds without causing it distress.",
                            "target_lang_translations": {
                                "tr": "Veteriner, yaralarını ona acı çektirmeden inceleyebilmek için yaralı köpeği <w>sakinleştirmeye</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "sedate#Verb"
                    ],
                    "common_phrases": [
                        "tranquilize an animal"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir insanı veya hayvanı ilaç vererek sakinleştirmek, uyuşturmak ya da bayıltmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sakinleştirmek",
                                "target_lang_sense_clarification": "ilaç veya sakinleştirici vererek"
                            },
                            {
                                "target_lang_word": "uyuşturmak",
                                "target_lang_sense_clarification": "ilaçla bilincini veya tepkilerini azaltmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d8211e2-4254-3ec4-85c2-2ee2cc22ae2a",
                    "sense_definition": "To make someone or something calm, quiet, or peaceful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listening to the sound of soft ocean waves helped to <w>tranquilize</w> her anxious thoughts.",
                            "target_lang_translations": {
                                "tr": "Yumuşak okyanus dalgalarının sesini dinlemek, onun endişeli düşüncelerini <w>yatıştırmaya</w> yardımcı oldu."
                            }
                        },
                        {
                            "text": "The gentle music served to <w>tranquilize</w> the restless audience before the speaker arrived.",
                            "target_lang_translations": {
                                "tr": "Hafif müzik, konuşmacı gelmeden önce huzursuz dinleyicileri <w>sakinleştirmeye</w> yaradı."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "pacify",
                        "relax"
                    ],
                    "antonyms": [
                        "madden"
                    ],
                    "common_phrases": [
                        "tranquilize the mind"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini veya bir şeyi sakin, huzurlu ya da dingin kılmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sakinleştirmek",
                                "target_lang_sense_clarification": "huzur vermek, teskin etmek"
                            },
                            {
                                "target_lang_word": "yatıştırmak",
                                "target_lang_sense_clarification": "öfkeyi, heyecanı veya telaşı dindirmek"
                            },
                            {
                                "target_lang_word": "dinginleştirmek",
                                "target_lang_sense_clarification": "huzurlu ve sessiz hale getirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d2e8d2-2a3b-3326-ba8d-841ad365bf3f",
                    "sense_definition": "To become calm, serene, or tranquil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took several deep breaths in the garden, waiting for her racing heart to <w>tranquilize</w>.",
                            "target_lang_translations": {
                                "tr": "Bahçede birkaç derin nefes alarak çarpan kalbinin <w>sakinleşmesini</w> bekledi."
                            }
                        },
                        {
                            "text": "After hours of turmoil, the stormy sea began to <w>tranquilize</w> as dawn approached.",
                            "target_lang_translations": {
                                "tr": "Saatler süren çalkantının ardından, şafak sökerken fırtınalı deniz <w>durulmaya</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "calm down",
                        "relax"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used intransitively in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sakin, dingin veya huzurlu bir duruma gelmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sakinleşmek",
                                "target_lang_sense_clarification": "huzura kavuşmak, yatışmak"
                            },
                            {
                                "target_lang_word": "durulmak",
                                "target_lang_sense_clarification": "dingin ve hareketsiz hale gelmek"
                            },
                            {
                                "target_lang_word": "yatışmak",
                                "target_lang_sense_clarification": "hareketliliğin veya heyecanın azalması"
                            }
                        ]
                    }
                }
            ]
        }
