                        "source_entry_id": "0de94f97-c26a-3b18-bbae-6db7be5f35f9",
                        "source_sense_id": "c1355cd3-453b-3975-ab17-4b95e20ba2a0",
                        "target_lang_word": "autodestructive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autodestructive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80b4f287-f1c5-35ee-9864-1e4955d3381c",
                                        "entry_id": "b6a57392-8183-3efc-8643-a6ab0e382625",
                                        "glosses": [
                                            "Self-destroying; self-destructive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18d17829-7bbf-4f9c-8ab7-f1dc45f6db31",
                                                "sense_id": "80b4f287-f1c5-35ee-9864-1e4955d3381c",
                                                "text": "[…] until 1957 he was a painter. However, as he told Bomberg, he was searching for something 'extremely fast and intense' and in 1960 he began 'painting' with acid on nylon, thus becoming a pioneer of autodestructive art, for which he has remained the chief spokesman."
                                            },
                                            {
                                                "example_id": "992cbb7f-31b8-4b4e-bd67-1785ae7d9f8f",
                                                "sense_id": "80b4f287-f1c5-35ee-9864-1e4955d3381c",
                                                "text": "Collectively they conjure up a crazed version of autodestructive white America at its most solipsistic, hankering after its own lost origins."
                                            },
                                            {
                                                "example_id": "e31edec3-650f-4da7-af1e-01f4c5bffddf",
                                                "sense_id": "80b4f287-f1c5-35ee-9864-1e4955d3381c",
                                                "text": "In contrast to what might be expected, MHC class I-deficient mice are not autodestructive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
