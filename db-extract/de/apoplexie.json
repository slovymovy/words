                        "cross_references": [
                            {
                                "target_word": "апоплексия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "825d2f13-bba7-3133-a512-ede6cd037ada",
                                        "entry_id": "beffb57f-cdb9-329c-b290-da8db48a6f09",
                                        "glosses": [
                                            "мед. внезапно развивающееся кровоизлияние в какой-либо орган (чаще всего в головной мозг), сопровождающееся неожиданной потерей сознания и параличами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13e1630-4db1-444c-adf9-3a7a7943c7a4",
                                                "sense_id": "825d2f13-bba7-3133-a512-ede6cd037ada",
                                                "text": "Медицинское следствие обнаружило апоплексию, происшедшую от купания сейчас после плотного обеда, с выпитою чуть не бутылкой вина, да и ничего другого и обнаружить оно не могло…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
