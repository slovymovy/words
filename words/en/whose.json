{
    "word_family": [],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "073ae5b8-54f1-38f7-94ef-bb55295a25a8",
                    "sense_definition": "Used in questions to ask who owns or is responsible for something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whose</w> wallet is this lying on the floor?",
                            "target_lang_translations": {
                                "ru": "<w>Чей</w> это кошелек лежит на полу?"
                            }
                        },
                        {
                            "text": "I found a set of keys, but I do not know <w>whose</w> keys they are.",
                            "target_lang_translations": {
                                "ru": "Я нашел связку ключей, но не знаю, <w>чьи</w> это ключи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whose keys",
                        "whose turn",
                        "whose idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в вопросах, чтобы узнать, кому принадлежит вещь или кто несет за что-либо ответственность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чей",
                                "target_lang_sense_clarification": "вопросительное местоимение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                    "sense_definition": "Used to indicate that something belongs to or is associated with a person previously mentioned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the man <w>whose</w> dog caused the accident yesterday.",
                            "target_lang_translations": {
                                "ru": "Это тот человек, <w>чья</w> собака вчера стала причиной аварии."
                            }
                        },
                        {
                            "text": "I want to thank my parents, without <w>whose</w> help I would not be here.",
                            "target_lang_translations": {
                                "ru": "Я хочу поблагодарить своих родителей, без <w>чьей</w> помощи меня бы здесь не было."
                            }
                        }
                    ],
                    "common_phrases": [
                        "without whose help",
                        "man whose dog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что что-то принадлежит или относится к ранее упомянутому человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чей",
                                "target_lang_sense_clarification": "относительное местоимение, согласуется с существительным"
                            },
                            {
                                "target_lang_word": "которого",
                                "target_lang_sense_clarification": "в значении принадлежности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e43905ff-defc-352b-a773-b39e54cc209e",
                    "sense_definition": "Used to indicate that something belongs to or is associated with a thing or animal previously mentioned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw several old houses <w>whose</w> roofs were falling off.",
                            "target_lang_translations": {
                                "ru": "Мы видели несколько старых домов, крыши <w>которых</w> разваливались."
                            }
                        },
                        {
                            "text": "It was a difficult decision <w>whose</w> consequences we did not fully understand.",
                            "target_lang_translations": {
                                "ru": "Это было трудное решение, последствия <w>которого</w> мы не до конца понимали."
                            }
                        }
                    ],
                    "common_phrases": [
                        "houses whose roofs",
                        "book whose title"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что что-то принадлежит или относится к ранее упомянутому предмету или животному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "которого",
                                "target_lang_sense_clarification": "для неодушевленных предметов и животных"
                            },
                            {
                                "target_lang_word": "чей",
                                "target_lang_sense_clarification": "относительное местоимение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "9604e800-cf8c-32b7-9965-5615aa31c8b5",
                    "sense_definition": "The one or ones belonging to whom; used as a pronoun to replace a noun phrase indicating possession.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "possession_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several people have lost their suitcases, so <w>whose</w> have you found?",
                            "target_lang_translations": {
                                "ru": "Несколько человек потеряли свои чемоданы, так <w>чей</w> же вы нашли?"
                            }
                        },
                        {
                            "text": "I have my coat, but I am not sure <w>whose</w> is on the chair.",
                            "target_lang_translations": {
                                "ru": "Мое пальто при мне, но я не уверен, <w>чьё</w> лежит на стуле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whose is this",
                        "know whose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот или те, которые принадлежат кому-либо; используется как местоимение вместо существительного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чей",
                                "target_lang_sense_clarification": "в роли подлежащего или дополнения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}