                                        "glosses": [
                                            "To sum up; to put together mentally; to add up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb17b72f-6ff7-4638-aea7-63c7480d9451",
                                                "sense_id": "f40cdc1d-1e02-393d-a614-ca1a43f3a480",
                                                "text": "to add numbers"
                                            },
                                            {
                                                "example_id": "7ce9916f-4ea3-44e8-a9d8-f7b7ea02c2c5",
                                                "sense_id": "f40cdc1d-1e02-393d-a614-ca1a43f3a480",
                                                "text": "[…]as easily as he can add together the ideas of two days or two years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4298bc13-6a83-3dd4-90cd-d514dff9c05c",
                                        "entry_id": "74c7271f-3e08-36b4-bb63-9f50103c482b",
