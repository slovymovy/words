                                        "entry_id": "d520ddb7-5c7c-3233-a052-cce5cdb08f0e",
                                        "glosses": [
                                            "One who invents, either as a hobby or as an occupation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff344fed-dab9-47b8-aec7-56aa32168d5d",
                                                "sense_id": "67fd564d-5f54-3125-8396-586e2563b50b",
                                                "text": "Thomas Edison was the inventor of the phonograph."
                                            },
                                            {
                                                "example_id": "75bd8177-3acb-4190-97f1-546baca27a5f",
                                                "sense_id": "67fd564d-5f54-3125-8396-586e2563b50b",
                                                "text": "The young inventor received a patent for her design."
                                            }
