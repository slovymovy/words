                        "examples": [
                            {
                                "example_id": "0a50093f-f685-4fcc-b08d-e628da4bbd15",
                                "sense_id": "2b3a831b-0c95-3a3f-b000-5dac64c43a2e",
                                "text": "Many a time but for a Sallet, my braine-pan had bene cleft with a brown Bill."
                            },
                            {
                                "example_id": "3e89d3c8-03d8-419e-947f-6c9190db3447",
                                "sense_id": "2b3a831b-0c95-3a3f-b000-5dac64c43a2e",
                                "text": "Yet, whether thwart or flatly it did lyte, / The tempred steele did not into his braynepan byte."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b7384da-5c2e-3a05-9d89-e3ade1d859ac",
                        "entry_id": "adc46edd-9705-376e-8863-181f7ca15ceb",
                        "glosses": [
                            "The brain or mind."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7884daaf-b40e-46a2-8962-8b91ad9c5232",
                                "sense_id": "0b7384da-5c2e-3a05-9d89-e3ade1d859ac",
                                "text": "‘And a hard word it is,’ said Richie, ‘as my brainpan kens to this blessed moment.’"
                            }
                        ]
