    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                "word": "asphyxia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b75eb327-d8f0-4398-be10-0e003006818e",
                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                        "tags": [
                            "plural"
                        ],
                        "form": "asphyxias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d3ad3ff-0873-3119-b523-f5e777a7bb33",
                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                        "glosses": [
                            "Loss of consciousness due to the interruption of breathing and consequent anoxia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e4f3597e-ab37-41f4-aaf7-a60d254b8429",
                                "sense_id": "5d3ad3ff-0873-3119-b523-f5e777a7bb33",
                                "text": "Asphyxia may result from choking, drowning, electric shock, or injury."
                            },
                            {
                                "example_id": "3a155983-0567-4f44-950a-52f0a62753e3",
                                "sense_id": "5d3ad3ff-0873-3119-b523-f5e777a7bb33",
                                "text": "The mattress platform on Davey’s bed fell unexpectedly, “trapping her neck against the upper surface of the side panel of the bed’s base,” Chipperfield explained. “Unable to free herself, she died of positional asphyxia. One of the two gas-lift pistons was defective.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "8daca4fa-20d9-3c09-b52b-07e4bd1f2009",
                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                        "glosses": [
                            "Loss of consciousness due to the body's inability to deliver oxygen to its tissues, either by the breathing of air lacking oxygen or by the inability of the blood to carry oxygen."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1a3967b9-5b27-37b7-81c4-1f3c34f53489",
                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                        "glosses": [
                            "A condition in which an extreme decrease in the concentration of oxygen in the body leads to loss of consciousness or death. Replaced in the mid-20th century by the more specific terms anoxia, hypoxia, hypoxemia and hypercapnia."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "28e9f757-a7ef-4514-9009-9d4054b282f5",
                                "sense_id": "1a3967b9-5b27-37b7-81c4-1f3c34f53489",
                                "text": "Hypoxaemia [...is] a deficient oxygenation of the blood; asphyxia from defective oxygenation of the blood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "679b7abc-9047-4f59-a1b1-2a905ac3593a",
                        "source_entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                        "source_sense_description": "condition with extreme decrease of oxygen and increase of carbon dioxide",
                        "target_lang_word": "asfyxie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asfyxie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "29aac6f0-9db6-3e42-90f3-2e997fa6fdee",
                                        "entry_id": "2b547607-f937-3128-8211-9793339dc5c8",
                                        "glosses": [
                                            "zuurstofgebrek door verstikking"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e8c5bae-2878-47f5-930b-15ae3cf9c008",
                                                "sense_id": "29aac6f0-9db6-3e42-90f3-2e997fa6fdee",
                                                "text": "Ik moet mijn verbeelding onzinnig hard inspannen, en tien maal zo hard nog door deze wurgende greep van asfyxie, om erin te slagen mijn leed te denken. En als ik dit streven zo hardnekkig volhoud, deze drang om eens en voor al mijn staat van verstikking vast te leggen..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95a1c01a-1c69-43c1-b301-298f7fca8bf2",
                        "source_entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                        "source_sense_description": "condition with extreme decrease of oxygen and increase of carbon dioxide",
                        "target_lang_word": "asphyxie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphyxie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1081283-146b-36dc-95b7-f6623f21a681",
                                        "entry_id": "097c7676-b33c-3c62-9058-ac6e0e4afc3d",
                                        "glosses": [
                                            "Arrêt plus ou moins long de la respiration, produit par différentes causes, telles que la submersion, la strangulation, l’absorption de gaz irrespirables, la compression du thorax, le rétrécissement du larynx, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8438ec-7b78-4789-adc9-989aa7b37baa",
                                                "sense_id": "c1081283-146b-36dc-95b7-f6623f21a681",
                                                "text": "Ce fait permet de prévoir l'utilité du spirophore pour combattre l’asphyxie due à l'abondance de mucosités bronchiques."
                                            },
                                            {
                                                "example_id": "6f91f2b2-3c37-4c9e-9dd9-37941daaf9b8",
                                                "sense_id": "c1081283-146b-36dc-95b7-f6623f21a681",
                                                "text": "Il était là, allongé, non pas serein, comme Kyo, avant de se tuer, avait pensé qu’il deviendrait, mais convulsé par l’asphyxie, déjà autre chose qu’un homme."
                                            },
                                            {
                                                "example_id": "d04df7ef-9a4a-4d76-b1c4-49d72bc90791",
                                                "sense_id": "c1081283-146b-36dc-95b7-f6623f21a681",
                                                "text": "J'essayais, en contractant le gosier, d'absorber le moins possible d'eau et de résister à l'asphyxie en retenant le plus longtemps que je pouvais l'air dans mes poumons. Mais je ne pus tenir plus de quelques instants."
                                            }
                                        ]
                                    }
                                ]
                            },
