                "senses": [
                    {
                        "sense_id": "ae2151dd-a094-39a1-b5ad-5c69a9a633e3",
                        "entry_id": "543e0936-f068-3914-a004-0b2f5ca1724d",
                        "glosses": [
                            "portolan"
                        ],
