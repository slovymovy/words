                "senses": [
                    {
                        "sense_id": "7c513065-0a0c-358f-b351-7d7ab017619f",
                        "entry_id": "6aa2bcd0-b9b3-30f6-8ff9-a112a1372225",
                        "glosses": [
                            "Société ayant pour vocation de regrouper des participations dans diverses sociétés et dont la fonction est d’en assurer l’unité de direction."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "f9bcf592-6741-47dc-aac8-6a43827c0acb",
                                "sense_id": "7c513065-0a0c-358f-b351-7d7ab017619f",
                                "text": "L’exercice de leur activité industrielle permet aux sociétés d’exploitation de renter le capital des actionnaires de la holding, selon des modalités définies par le statut des entreprises contrôlées."
                            },
                            {
                                "example_id": "761299af-1d27-4f0f-ae86-69c8bcdc143e",
                                "sense_id": "7c513065-0a0c-358f-b351-7d7ab017619f",
                                "text": "Même ses employés l’appellent Jo, et son nom n’apparaît nulle part, sauf sans doute dans le capital de la holding qui possède la société, inscrite au registre du commerce."
                            }
                        ]
                    }
                ],
