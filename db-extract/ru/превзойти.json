                    {
                        "sense_id": "4043227b-d7e2-3d37-8a0c-112a356b0a09",
                        "entry_id": "fe659032-f8f4-3e59-a874-fc07711ba8d5",
                        "glosses": [
                            "оказаться больше чего-либо; превысить"
                        ],
                        "tags": [],
