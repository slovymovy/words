                        "glosses": [
                            "Regarder de grosses quantités de programmes à la télévision, en particulier de nombreux épisodes d’une série à la suite."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "85ede364-cdfc-4dd1-871d-e035d0f4ca16",
                                "sense_id": "b9f7ca5c-47db-364a-940c-fab55f3c0b6a",
                                "text": "Regard sur la ville en 10 séries pour télévorer la ville des vents, préparer votre prochain séjour ou y voyager par procuration."
                            },
                            {
                                "example_id": "70e79bf0-3a10-486f-ab22-79aca69c4ea7",
                                "sense_id": "b9f7ca5c-47db-364a-940c-fab55f3c0b6a",
                                "text": "Télé-Québec, une programmation 2022-2023 à télévorer !"
                            },
                            {
                                "example_id": "c7b4d2a7-c106-4e60-9439-6f15e2f6d7d5",
                                "sense_id": "b9f7ca5c-47db-364a-940c-fab55f3c0b6a",
                                "text": "Télévorez québécois grâce à une semaine de programmation spéciale du 19 au 25 juin 2022"
                            },
                            {
                                "example_id": "e3946c35-af30-421d-bdad-d93b65fd3a42",
                                "sense_id": "b9f7ca5c-47db-364a-940c-fab55f3c0b6a",
                                "text": "le verbe “télévorer” (regarder plusieurs épisodes d’une série sans interruption)"
                            }
                        ]
