                        "examples": [
                            {
                                "example_id": "5f0cb398-852d-456e-b117-f422f448bf12",
                                "sense_id": "eb2c7fb0-c325-345a-815f-051aa18c8992",
                                "text": "[…] and then to lyrically proclaim that, not only was it a way they had in the Varsity to drive dull care away, but that the same practice was also pursued in the army and navy for the attainment of a similar end."
                            }
                        ]
                    },
                    {
                        "sense_id": "741e21a5-901e-360c-8f92-b2ad607600c8",
                        "entry_id": "8e2fc69e-ea15-3793-be60-45dcfa3c3661",
                        "glosses": [
                            "The principal sports team representing an institution (usually a high school, college, or university.)"
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4f818c40-1ba0-4935-9ea3-7611c48ce44c",
                                "sense_id": "741e21a5-901e-360c-8f92-b2ad607600c8",
                                "text": "There were sixteen of them in all, for the most part upper classmen who had failed to make the varsity the year before, with a sprinkling of sophomores and two freshmen."
                            },
                            {
                                "example_id": "20649636-fe19-4b96-8c8f-36a93114436d",
                                "sense_id": "741e21a5-901e-360c-8f92-b2ad607600c8",
                                "text": "A small Pennsylvania university has only one varsity program: e-sports. Is this the future of college athletics?"
                            }
                        ]
                    }
                ],
