                        "target_lang_word": "de una forma cómica",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c79d0679-6556-475f-800b-b7bed03dab07",
                        "source_entry_id": "45f258a4-09e4-36d8-ad37-9eb6caacff51",
                        "source_sense_id": "9fcfd94c-7fe1-3c43-92a0-26a9078e9b28",
                        "target_lang_word": "komisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "komisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4038457-4459-35ab-8bc8-c2e0c3c7e12c",
                                        "entry_id": "2e642989-6d46-369f-8b0a-bbadb4e23286",
                                        "glosses": [
                                            "nach Art einer Komödie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626b6daf-7549-4f04-8692-95ed7cc197f8",
                                                "sense_id": "f4038457-4459-35ab-8bc8-c2e0c3c7e12c",
                                                "text": "Die „Hochzeit des Figaro“ ist eine komische Oper."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "283338c3-7652-316c-adca-8ee8fbd40472",
                                        "entry_id": "2e642989-6d46-369f-8b0a-bbadb4e23286",
                                        "glosses": [
                                            "zum Lachen anregend (witzig); erheiternd, spaßig, lustig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c954b6f5-c473-4847-9f17-575f5009bfa8",
                                                "sense_id": "283338c3-7652-316c-adca-8ee8fbd40472",
                                                "text": "Am meisten hat der Clown die Kinder mit seinen komischen Bewegungen zum Lachen gebracht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                        "entry_id": "2e642989-6d46-369f-8b0a-bbadb4e23286",
                                        "glosses": [
                                            "Verwunderung auslösend; sonderbar, seltsam, merkwürdig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d688c0-72ef-47d2-98c8-72e4b25a1efd",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "Erdbeeren mit Senf schmecken komisch."
                                            },
                                            {
                                                "example_id": "92bd3662-3d1c-4179-b597-9bb129101b7a",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "Das war schon ein komisches Zusammentreffen, wieso taucht sie gerade jetzt auf?"
                                            },
                                            {
                                                "example_id": "ce9bace8-d97b-4a61-808e-381d013aa26b",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "Die Praktikantin schlug sich den Kopf an der Befestigungsstange an, fing an zu bluten und reagierte komisch, anstatt vor Schmerzen zu jammern, fing sie an zu lachen."
                                            },
                                            {
                                                "example_id": "cb5b9983-ff6e-4bc9-8362-d474caba4205",
                                                "sense_id": "b0dc2287-7b14-358f-9d12-12aadaa4f591",
                                                "text": "„Für eine Landpomeranze wie mich war es irgendwie komisch, in Norditalien Deutsch zu unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8f75682-3a03-4101-92dd-d314733ebdbe",
                        "source_entry_id": "45f258a4-09e4-36d8-ad37-9eb6caacff51",
                        "source_sense_id": "9fcfd94c-7fe1-3c43-92a0-26a9078e9b28",
                        "target_lang_word": "comiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
                                        "entry_id": "600c17fd-d413-394e-95c0-ad8a334fe7c9",
                                        "glosses": [
                                            "D’une manière comique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aed9543-ee57-49a1-8158-a4c07e6eb3d3",
                                                "sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
                                                "text": "La petite dame du type « conoïde » tristement inexpressif, que l’absence de menton fait comiquement grimacer alors qu’elle s’imagine gracieusement sourire, se proclame volontiers reine de beauté, […]."
                                            },
                                            {
                                                "example_id": "48fc325c-bb94-4c37-aeeb-847450ad114e",
                                                "sense_id": "ecbef2e5-eaae-3e75-8716-a3f7e0871018",
                                                "text": "On représente comiquement ce qui se passe de ridicule en divers lieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
