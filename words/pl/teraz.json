{
    "word_family": [
        "terazniejszy",
        "terazniejszość"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f709a740-30e7-35c0-8355-4f998f661fc3",
                    "sense_definition": "W obecnym momencie, w tej chwili.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie mogę teraz rozmawiać, ponieważ jestem bardzo zajęty.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>сейчас</w> разговаривать, потому что я очень занят."
                            }
                        },
                        {
                            "text": "Wszyscy <w>teraz</w> słuchają uważnie nauczyciela.",
                            "target_lang_translations": {
                                "ru": "Все <w>сейчас</w> внимательно слушают учителя."
                            }
                        }
                    ],
                    "synonyms": [
                        "aktualnie",
                        "obecnie"
                    ],
                    "antonyms": [
                        "nigdy przedtem",
                        "potem"
                    ],
                    "common_phrases": [
                        "właśnie teraz",
                        "teraz już"
                    ],
                    "target_lang_definitions": {
                        "ru": "В настоящий момент, в данную минуту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "указывает на текущий момент времени"
                            },
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "указывает на настоящий момент, часто в сопоставлении с прошлым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e65a495e-cd12-315a-9d16-c5be401ec124",
                    "sense_definition": "Chwila obecna, teraźniejszość.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "czas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dla niego liczy się tylko <w>teraz</w> i przyszłość.",
                            "target_lang_translations": {
                                "ru": "Для него важно только <w>настоящее</w> и будущее."
                            }
                        },
                        {
                            "text": "Trzeba skupić się na tym, co dzieje się w <w>teraz</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно сосредоточиться на том, что происходит в <w>настоящем</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Текущий момент времени, настоящее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящее",
                                "target_lang_sense_clarification": "существительное, обозначающее текущий момент"
                            },
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "используется в значении 'настоящее время' в философском или абстрактном контексте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e701fac1-1f6f-32e5-92d7-197bbdcb5bb8",
                    "sense_definition": "Partykuła używana do podkreślenia logicznego następstwa w wypowiedzi.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Skoro już wszystko wyjaśniłem, <w>teraz</w> możemy przejść do głosowania.",
                            "target_lang_translations": {
                                "ru": "Раз я уже всё объяснил, <w>теперь</w> мы можем перейти к голосованию."
                            }
                        },
                        {
                            "text": "Skoro znasz prawdę, <w>teraz</w> musisz podjąć decyzję.",
                            "target_lang_translations": {
                                "ru": "Раз ты знаешь правду, <w>теперь</w> ты должен принять решение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, используемое для подчеркивания логического перехода или следствия в речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "указывает на логический переход к следующему этапу или действию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}