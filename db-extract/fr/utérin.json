                ],
                "senses": [
                    {
                        "sense_id": "9f13a326-ecb6-32d5-828a-e1003e2a51ed",
                        "entry_id": "08f1c551-82d0-38bd-8a6b-06ebb3cd8f54",
                        "glosses": [
                            "Qui concerne l’utérus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "986a309f-bd07-4d7b-990b-44ba10f87746",
                                "sense_id": "9f13a326-ecb6-32d5-828a-e1003e2a51ed",
                                "text": "Des essais cliniques ont eu pour but de radiosensibiliser des tumeurs pour lesquelles des arguments indirects laissaient envisager l’existence de cellules hypoxiques (tumeurs cérébrales, tumeurs du col utérin ou tumeurs ORL)."
                            },
                            {
                                "example_id": "4794f454-de89-4d91-959b-2e833548bcb4",
                                "sense_id": "9f13a326-ecb6-32d5-828a-e1003e2a51ed",
                                "text": "À mon tour, j’ai été opérée d’une pathologie utérine en partie héréditaire dont avaient souffert Ann avant ma naissance et, je l’ai appris à cette occasion, Alice."
                            }
                        ]
                    },
                    {
                        "sense_id": "69396c75-5ec6-332e-a173-377ae5afa28c",
                        "entry_id": "08f1c551-82d0-38bd-8a6b-06ebb3cd8f54",
                        "glosses": [
                            "Hystérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc0365c4-c831-4b25-835d-f29540b18f9d",
                                "sense_id": "69396c75-5ec6-332e-a173-377ae5afa28c",
                                "text": "Alors, Nannette parut comme saisie d’une fureur utérine ; elle me serra, s’empara de tout mon être, et me fit palper tout le sien."
                            }
                        ]
                    },
                    {
                        "sense_id": "622892ba-ee2c-30f6-8f6e-7ab2baae6edb",
                        "entry_id": "08f1c551-82d0-38bd-8a6b-06ebb3cd8f54",
                        "glosses": [
                            "Qui se rapporte à la période prénatale."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "113c8866-ce2d-46d8-91c5-7ade797f6cf1",
                                "sense_id": "622892ba-ee2c-30f6-8f6e-7ab2baae6edb",
                                "text": "Le petit Marcel, dont la vie utérine a été troublée par la Commune (18 mars - 28 mai 1871), voit le jour le 10 juillet 1871 ."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d878857-522d-3150-921f-480760a2514a",
                        "entry_id": "08f1c551-82d0-38bd-8a6b-06ebb3cd8f54",
                        "glosses": [
                            "Qui est né de même mère, mais non de même père."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5031a63-fa3d-4078-bf10-aa0018cdf7af",
                                "sense_id": "7d878857-522d-3150-921f-480760a2514a",
                                "text": "C’est son frère utérin."
                            },
                            {
                                "example_id": "39bdd8b9-11ff-462b-bac7-e4a9cce681a9",
                                "sense_id": "7d878857-522d-3150-921f-480760a2514a",
                                "text": "Elle n’est que sa sœur utérine."
                            }
                        ]
                    }
                ],
