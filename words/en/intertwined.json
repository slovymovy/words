    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d5ddb1b6-a6e1-35bf-beb9-d76a1a53adc5",
                    "sense_definition": "Twined or twisted together",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intertwined</w> threads of cotton created a very strong fabric.",
                            "target_lang_translations": {
                                "cs": "<w>Propletená</w> bavlněná vlákna vytvořila velmi pevnou látku."
                            }
                        },
                        {
                            "text": "The lovers' limbs were <w>intertwined</w> as they slept peacefully.",
                            "target_lang_translations": {
                                "cs": "Končetiny milenců byly <w>propletené</w>, zatímco klidně spali."
                            }
                        }
                    ],
                    "synonyms": [
                        "braided"
                    ],
                    "common_phrases": [
                        "intertwined branches",
                        "intertwined roots"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vzájemně propletený nebo zkroucený dohromady."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "propletený",
                                "target_lang_sense_clarification": "fyzicky spojený proplétáním"
                            },
                            {
                                "target_lang_word": "spletený",
                                "target_lang_sense_clarification": "vytvořený spletením více částí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ec7306f-e248-39c4-b84d-0ea7f1d7cddf",
                    "sense_definition": "Inextricably related or relevant",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The problems of poverty and poor education are deeply <w>intertwined</w> in this city.",
                            "target_lang_translations": {
                                "cs": "Problémy chudoby a špatného vzdělání jsou v tomto městě hluboce <w>propojeny</w>."
                            }
                        },
                        {
                            "text": "The company's success and the economy are <w>intertwined</w> in a complex way.",
                            "target_lang_translations": {
                                "cs": "Úspěch společnosti a ekonomika jsou složitým způsobem <w>úzce spjaty</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "intertwined fates",
                        "intertwined interests"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nerozlučně spjatý nebo vzájemně související."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úzce spjatý",
                                "target_lang_sense_clarification": "abstraktní propojení věcí či jevů"
                            },
                            {
                                "target_lang_word": "propojený",
                                "target_lang_sense_clarification": "vzájemně závislý"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07297dc7-5d1a-3fa8-bef5-d10fff3d2927",
                    "sense_definition": "Simple past and past participle of <w>intertwine</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vines <w>intertwined</w> around the old wooden fence over the summer.",
                            "target_lang_translations": {
                                "cs": "Vinná réva se během léta <w>propletla</w> kolem starého dřevěného plotu."
                            }
                        },
                        {
                            "text": "She has <w>intertwined</w> her fingers with his during the long walk.",
                            "target_lang_translations": {
                                "cs": "Během dlouhé procházky si <w>propletla</w> prsty s jeho."
                            }
