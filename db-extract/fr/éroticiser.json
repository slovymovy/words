                ],
                "senses": [
                    {
                        "sense_id": "202a3e81-cfb7-30cc-be1e-f79abcd0ee14",
                        "entry_id": "a08674f2-63f1-3ed8-a9ba-1675c2e14ee9",
                        "glosses": [
                            "Donner un caractère érotique à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "06bf7908-bedb-49d0-aea0-e37b17476576",
                                "sense_id": "202a3e81-cfb7-30cc-be1e-f79abcd0ee14",
                                "text": "D’ailleurs, si parfois la frustration est trop forte et que le producteur a besoin de l’acte sexuel, il ne faut pas éroticiser celui-ci."
                            },
                            {
                                "example_id": "dab374aa-ba20-47f8-b88f-4399a018a5bd",
                                "sense_id": "202a3e81-cfb7-30cc-be1e-f79abcd0ee14",
                                "text": "Cependant Bataille n’a pas cherché, selon une méthode simpliste, souvent grossière chez la plupart des écrivains érotiques, parfois subtile, comme elle l’est chez Flaubert ou chez Proust, à éroticiser les jeux métaphoriques du style."
                            }
                        ]
                    }
