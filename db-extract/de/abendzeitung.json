                        ],
                        "form": "die Abendzeitungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94e98ee6-d8f4-3095-a01c-5fa41d0aa2eb",
                        "entry_id": "04088534-ac10-36a4-893e-3e1ae55229dd",
                        "glosses": [
                            "Zeitung, die abends erscheint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf51a21-a1b3-4efc-bf17-da2de6c5c14d",
                                "sense_id": "94e98ee6-d8f4-3095-a01c-5fa41d0aa2eb",
                                "text": "In der Abendzeitung wurde über die Ansprache der Bundeskanzlerin berichtet."
                            },
                            {
                                "example_id": "8a031ce4-73d4-4e23-adf3-936660a243d3",
                                "sense_id": "94e98ee6-d8f4-3095-a01c-5fa41d0aa2eb",
                                "text": "„Hier sind hohe Häuser und viele Menschen, Autos fahren in Rudeln, die Abendzeitungen sind schon da, niemand achtet auf die beiden.“"
                            },
                            {
                                "example_id": "8d04f469-d043-40fd-9dd2-fd10725b627f",
                                "sense_id": "94e98ee6-d8f4-3095-a01c-5fa41d0aa2eb",
                                "text": "„Mich interessieren Zeitungen nur abends oder in der Badewanne, und in der Badewanne kommen mir die seriösesten Morgenzeitungen so unseriös wie Abendzeitungen vor.“"
                            },
                            {
                                "example_id": "11395f5a-b80a-4cc5-9bb6-e27905e5f087",
                                "sense_id": "94e98ee6-d8f4-3095-a01c-5fa41d0aa2eb",
                                "text": "„Nun zeigt er mir in der Abendzeitung einen Artikel; da steht, eine von den Großmächten hätte gefragt, ob der isländische Staat ihr seine Hauptstadt Reykjavik, auch Smoky Bay genannt, oder irgendeine andre Bucht des Landes, die sich in einem Atomkriege sowohl zum Angriff wie zur Verteidigung eigne, verkaufen, verpachten oder verschenken wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
