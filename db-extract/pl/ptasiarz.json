                "senses": [
                    {
                        "sense_id": "b39644c3-3166-3874-a663-b90e75a0b812",
                        "entry_id": "493454e9-9fa0-36d6-a84b-c33a4a3e152e",
                        "glosses": [
                            "osoba hobbistycznie zajmująca się ornitologią, obserwator ptactwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8fa749f-da0f-49f5-8984-e5d98b52ae10",
                                "sense_id": "b39644c3-3166-3874-a663-b90e75a0b812",
                                "text": "Jako entuzjastyczny ptasiarz Robert zawsze marzył o sfotografowaniu pięknej lazurki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "265e797e-0ef4-405a-9049-7be21e7fe6c3",
                        "source_entry_id": "493454e9-9fa0-36d6-a84b-c33a4a3e152e",
                        "source_sense_id": "b39644c3-3166-3874-a663-b90e75a0b812",
                        "target_lang_word": "birdwatcher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birdwatcher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81ad4cef-b5b5-3b24-b3ef-93020b796387",
                                        "entry_id": "5d006b40-bb6c-3bfb-848f-e1f96768bd0d",
                                        "glosses": [
                                            "A person who observes or identifies wild birds in their natural environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05350703-b77b-4e23-8c03-6640b6a5d90e",
                                                "sense_id": "81ad4cef-b5b5-3b24-b3ef-93020b796387",
                                                "text": "Alec Warner was gazing like a bird-watcher at Charmian, who plucked at the rug round her knees, waiting to tell her own story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a751039c-94f4-34fd-adee-3a2440a1e0a3",
                                        "entry_id": "5d006b40-bb6c-3bfb-848f-e1f96768bd0d",
                                        "glosses": [
                                            "A person who enjoys watching rocket launches."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816c8885-10d8-4ab4-a4db-a8296118d9b8",
                                                "sense_id": "a751039c-94f4-34fd-adee-3a2440a1e0a3",
                                                "text": "In fact, on this night, the birdwatching is over for everyone, for the firing is cancelled. Nobody notifies birdwatchers officially, of course, so the exodus is scattered and gradual."
                                            },
                                            {
                                                "example_id": "8446a05b-d1d8-45ba-b04f-a6aca436bb8e",
                                                "sense_id": "a751039c-94f4-34fd-adee-3a2440a1e0a3",
                                                "text": "[…] particularly those carrying astronauts, are the area's major drawing power, and each \"advertised\" shoot brings thousands of space age \"birdwatchers\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb4ede21-900e-476a-8bfc-5fa4c4b3ab1a",
                        "source_entry_id": "493454e9-9fa0-36d6-a84b-c33a4a3e152e",
                        "source_sense_id": "b39644c3-3166-3874-a663-b90e75a0b812",
                        "target_lang_word": "birder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1d9548e-43b1-3e37-8c21-931521b7418d",
                                        "entry_id": "6a706d33-d0bc-3e25-a661-452bf2d79f86",
                                        "glosses": [
                                            "A birdwatcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694c9574-28d6-414b-9a1b-396d57809f01",
                                                "sense_id": "e1d9548e-43b1-3e37-8c21-931521b7418d",
                                                "text": "Many of the crofters on Fair Isle and Shetland know as much about the birds as the birders."
                                            },
                                            {
                                                "example_id": "4c84a7bd-4160-4f6a-960c-cf077b1851e6",
                                                "sense_id": "e1d9548e-43b1-3e37-8c21-931521b7418d",
                                                "text": "It's good to be the king. Even if the kingdom is rather small. It is amazing how often really good birders are borderline megalomaniacs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8166df2-9ee7-36e9-8fab-f3c08a5fc9c6",
                                        "entry_id": "6a706d33-d0bc-3e25-a661-452bf2d79f86",
                                        "glosses": [
                                            "A person who hunts birds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
