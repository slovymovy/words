{
    "word_family": [
        "ontwijking",
        "ontwijkend",
        "wijken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0171cd12-0f73-3a9b-a44d-52c0b33beb73",
                    "sense_definition": "iets of iemand uit de weg gaan om een botsing of contact te voorkomen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vermijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fietser moest snel opzij sturen om de auto te <w>ontwijken</w>.",
                            "target_lang_translations": {
                                "en": "The cyclist had to steer aside quickly to <w>dodge</w> the car.",
                                "ru": "Велосипедисту пришлось резко свернуть в сторону, чтобы <w>увернуться</w> от машины."
                            }
                        },
                        {
                            "text": "Hij probeerde de <w>vragen te ontwijken</w> tijdens het interview met de journalist.",
                            "target_lang_translations": {
                                "en": "He tried to <w>evade the questions</w> during the interview with the journalist.",
                                "ru": "Он пытался <w>уклониться от вопросов</w> во время интервью с журналистом."
                            }
                        }
                    ],
                    "synonyms": [
                        "vermijden",
                        "ontlopen",
                        "mijden"
                    ],
                    "antonyms": [
                        "opzoeken",
                        "confronteren"
                    ],
                    "common_phrases": [
                        "vragen te ontwijken",
                        "elkaar ontwijken",
                        "een botsing ontwijken"
                    ],
                    "target_lang_definitions": {
                        "en": "To move out of the way of something or someone to prevent a collision or contact.",
                        "ru": "Уклоняться от чего-либо или кого-либо, чтобы избежать столкновения или контакта."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dodge",
                                "target_lang_sense_clarification": "physically moving to avoid an object"
                            },
                            {
                                "target_lang_word": "evade",
                                "target_lang_sense_clarification": "cleverly avoiding something like a question or a pursuer"
                            },
                            {
                                "target_lang_word": "avoid",
                                "target_lang_sense_clarification": "general term for staying away from something"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "физически или метафорически избегать чего-то"
                            },
                            {
                                "target_lang_word": "избегать",
                                "target_lang_sense_clarification": "общий термин для предотвращения контакта"
                            },
                            {
                                "target_lang_word": "уворачиваться",
                                "target_lang_sense_clarification": "быстро двигаться в сторону, чтобы не задело"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23fd418b-6ff8-373c-9951-c536fe21f62b",
                    "sense_definition": "bewust proberen contact of een onaangename situatie uit de weg te gaan",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vermijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had hem enige tijd weten te <w>ontwijken</w>, maar liep nu tegen de lamp.",
                            "target_lang_translations": {
                                "en": "He had managed to <w>avoid</w> him for some time, but now he got caught.",
                                "ru": "Ему удавалось <w>избегать</w> его какое-то время, но теперь он попался."
                            }
                        },
                        {
                            "text": "Ik kon het niet langer uitstellen of <w>ontwijken</w>, deze nacht zou ik eraan moeten geloven.",
                            "target_lang_translations": {
                                "en": "I could no longer postpone or <w>avoid</w> it; tonight I would have to face it.",
                                "ru": "Я больше не мог это откладывать или <w>избегать</w> этого, этой ночью мне пришлось бы через это пройти."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontlopen",
                        "schuwen",
                        "vermijden"
                    ],
                    "antonyms": [
                        "tegemoet treden"
                    ],
                    "common_phrases": [
                        "verantwoordelijkheid ontwijken",
                        "oogcontact ontwijken"
                    ],
                    "target_lang_definitions": {
                        "en": "To consciously try to avoid contact or an unpleasant situation.",
                        "ru": "Сознательно пытаться избежать контакта или неприятной ситуации."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "avoid",
                                "target_lang_sense_clarification": "staying away from a person or situation"
                            },
                            {
                                "target_lang_word": "shun",
                                "target_lang_sense_clarification": "persistently avoiding or ignoring someone"
                            },
                            {
                                "target_lang_word": "sidestep",
                                "target_lang_sense_clarification": "avoiding a responsibility or issue"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "избегать",
                                "target_lang_sense_clarification": "стараться не встречаться с кем-то или чем-то"
                            },
                            {
                                "target_lang_word": "уклоняться",
                                "target_lang_sense_clarification": "избегать ответственности или прямых ответов"
                            },
                            {
                                "target_lang_word": "сторониться",
                                "target_lang_sense_clarification": "держаться в стороне от кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be2ded55-c96b-3a2d-8661-a548f4408687",
                    "sense_definition": "het ontsnappen van een gas of vloeistof uit een afgesloten ruimte",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ontsnappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is veel lucht uit de band <w>ontweken</w> door het kleine gaatje.",
                            "target_lang_translations": {
                                "en": "A lot of air has <w>escaped</w> from the tire through the small hole.",
                                "ru": "Из шины через маленькое отверстие <w>вышло</w> много воздуха."
                            }
                        },
                        {
                            "text": "Men kon ruiken dat er gas uit de leiding was <w>ontweken</w>.",
                            "target_lang_translations": {
                                "en": "One could smell that gas had <w>leaked</w> from the pipe.",
                                "ru": "Можно было почувствовать по запаху, что из трубы <w>вышел</w> газ."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsnappen",
                        "wegstromen"
                    ],
                    "common_phrases": [
                        "gas laten ontwijken"
                    ],
                    "target_lang_definitions": {
                        "en": "The escape of a gas or liquid from an enclosed space.",
                        "ru": "Выход газа или жидкости из замкнутого пространства."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "escape",
                                "target_lang_sense_clarification": "gas or liquid leaking out"
                            },
                            {
                                "target_lang_word": "leak",
                                "target_lang_sense_clarification": "accidental escape of fluid or gas"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "о газе или воздухе из емкости"
                            },
                            {
                                "target_lang_word": "улетучиваться",
                                "target_lang_sense_clarification": "о газе или запахе"
                            },
                            {
                                "target_lang_word": "утекать",
                                "target_lang_sense_clarification": "о жидкости или газе через отверстие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}