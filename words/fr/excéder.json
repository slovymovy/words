                    "frequency": "Low",
                    "semantic_group_id": "limites",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a manifestement <w>excédé</w> ses pouvoirs en prenant cette décision unilatérale."
                        },
                        {
                            "text": "En intervenant dans ce litige privé, l'agent risque d'<w>excéder</w> ses compétences."
