    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81a015e2-0935-3507-a2e8-32a4fe39616e",
                    "sense_definition": "Secured by a lock so that it cannot be opened.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "secured_restricted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>locked</w> door prevented us from entering the empty house.",
                            "target_lang_translations": {
                                "ru": "<w>Запертая</w> дверь помешала нам войти в пустой дом.",
                                "zh": "一扇<w>锁上的</w>门阻止了我们进入那间空房子。"
                            }
                        },
                        {
                            "text": "She keeps her valuable jewelry in a <w>locked</w> box.",
                            "target_lang_translations": {
                                "ru": "Она хранит свои драгоценности в <w>запертой</w> шкатулке.",
                                "zh": "她把贵重首饰放在一个<w>锁住的</w>盒子里。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unlocked"
                    ],
                    "common_phrases": [
                        "locked door",
                        "locked room",
                        "locked gate",
                        "locked out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запертый на замок или закрытый так, что его нельзя открыть.",
                        "zh": "用锁锁住，使其无法打开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запертый",
                                "target_lang_sense_clarification": "на ключ"
                            },
                            {
                                "target_lang_word": "закрытый",
                                "target_lang_sense_clarification": "на замок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锁上的",
                                "target_lang_sense_clarification": "已上锁的"
                            },
                            {
                                "target_lang_word": "锁住的",
                                "target_lang_sense_clarification": "处于关闭状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "844ec9b5-e3e5-32a5-bb2f-3403445dc07a",
                    "sense_definition": "Protected by a digital restriction or password that prevents access to a computer resource or file.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secured_restricted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot edit or delete a <w>locked</w> computer file without permission.",
                            "target_lang_translations": {
                                "ru": "Вы не можете редактировать или удалять <w>заблокированный</w> компьютерный файл без разрешения.",
                                "zh": "未经许可，你无法编辑或删除一个<w>锁定的</w>电脑文件。"
                            }
                        },
                        {
                            "text": "The system administrator reset the password for the <w>locked</w> account.",
                            "target_lang_translations": {
                                "ru": "Системный администратор сбросил пароль для <w>заблокированной</w> учетной записи.",
                                "zh": "系统管理员重置了那个<w>锁定</w>账户的密码。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unlocked"
                    ],
                    "common_phrases": [
                        "locked file",
                        "locked screen",
                        "locked account"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищенный цифровым ограничением или паролем, предотвращающим доступ.",
                        "zh": "受数字限制或密码保护，无法访问的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заблокированный",
                                "target_lang_sense_clarification": "о доступе или файле"
                            },
                            {
                                "target_lang_word": "запароленный",
                                "target_lang_sense_clarification": "защищенный паролем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锁定的",
                                "target_lang_sense_clarification": "指文件或账户"
                            },
                            {
                                "target_lang_word": "加密的",
                                "target_lang_sense_clarification": "受密码保护的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "017bb636-5338-39b6-97e0-e12d92e1315b",
                    "sense_definition": "Bound to a specific mobile carrier and unable to use SIM cards from other networks.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "secured_restricted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a <w>locked</w> phone that only works with one specific provider.",
                            "target_lang_translations": {
                                "ru": "Он купил <w>залоченный</w> телефон, который работает только с одним конкретным провайдером.",
                                "zh": "他买了一部<w>有锁</w>手机，只能使用特定的运营商。"
                            }
                        },
                        {
                            "text": "It is often cheaper to buy a <w>locked</w> device than an unlocked one.",
                            "target_lang_translations": {
                                "ru": "Часто дешевле купить <w>залоченное</w> устройство, чем разблокированное.",
                                "zh": "购买<w>有锁</w>设备通常比无锁设备便宜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dedicated"
                    ],
                    "antonyms": [
                        "unlocked"
                    ],
                    "common_phrases": [
                        "locked phone",
                        "network locked",
                        "carrier locked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привязанный к определенному оператору связи (о телефоне).",
                        "zh": "绑定特定移动运营商，无法使用其他网络SIM卡的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "залоченный",
                                "target_lang_sense_clarification": "сленг, об операторе"
                            },
                            {
                                "target_lang_word": "заблокированный",
                                "target_lang_sense_clarification": "под оператора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有锁的",
                                "target_lang_sense_clarification": "指手机网络限制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89e2b15b-fbde-32b1-9ec3-ee27b54b2a2a",
                    "sense_definition": "Very drunk.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were absolutely <w>locked</w> after celebrating at the pub all night.",
                            "target_lang_translations": {
