                                            {
                                                "example_id": "b6ec2bc8-760f-4f65-bec0-2bc1b73eec6f",
                                                "sense_id": "fb5ccef4-44a0-3187-b526-d292877f9373",
                                                "text": "That spruce table is beautiful!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f86577ca-1228-3edd-aed0-181a0ccdf346",
                                        "entry_id": "6c462742-1e75-37a6-8899-81400607156c",
                                        "glosses": [
                                            "Prussian leather; pruce."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
