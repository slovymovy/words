                    {
                        "sense_id": "15abfc66-b84a-3de6-9b37-2879b7492b4d",
                        "entry_id": "b2efb178-ff57-3367-ad42-8a2aea0dd4a0",
                        "glosses": [
                            "Propriété qu’ont les corps de se réduire à un moindre volume par l’effet d’une pression."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "48a59203-9684-4427-a6e0-d6bce0cdb3df",
                                "sense_id": "15abfc66-b84a-3de6-9b37-2879b7492b4d",
                                "text": "La compressibilité d'un gaz."
                            },
                            {
                                "example_id": "d1dcc91f-7afb-4285-b972-48d51db54371",
                                "sense_id": "15abfc66-b84a-3de6-9b37-2879b7492b4d",
                                "text": "L’accroissement de viscosité avec la pression peut s’expliquer par la compressibilité."
                            },
                            {
                                "example_id": "b8d06d34-68d8-4fe6-9110-699f8f11c22b",
                                "sense_id": "15abfc66-b84a-3de6-9b37-2879b7492b4d",
                                "text": "Les compressibilités similaires des phases solide et liquide d’une substance viennent corroborer l’idée que les particules sont disposées à la même distance dans ces deux phases."
                            }
                        ]
                    }
