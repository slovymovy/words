                    },
                    {
                        "form_id": "467f5c53-73cb-4b06-91df-9c63525ac1db",
                        "entry_id": "f60dd4d1-4270-3797-978a-0cb816581da7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Todesängste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                        "entry_id": "f60dd4d1-4270-3797-978a-0cb816581da7",
                        "glosses": [
                            "Angst davor, zu sterben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bde5701-f78d-4c0f-84c6-05568a4d1c22",
                                "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                                "text": "„Diese Stimmen, diese wenigen, leisen Worte, diese Schritte im Graben hinter mir reißen mich mit einem Ruck aus der fürchterlichen Vereinsamung der Todesangst, der ich beinahe verfallen wäre.“"
                            },
                            {
                                "example_id": "c40bfd1e-1823-43b0-b0a6-87f61c430fb8",
                                "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                                "text": "„In den Gesichtern der Alten um mich herum sah ich nur eines: nackte Todesangst.“"
                            },
                            {
                                "example_id": "4ff0dfbc-56b9-4e1c-9813-cb34398beb69",
                                "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                                "text": "„Er hoffte noch immer, davonzukommen, aber die Todesangst lähmte ihn und wurde enorm.“"
                            },
                            {
                                "example_id": "e1890902-2969-41b1-9e14-6bb9e7f14c9f",
                                "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                                "text": "„Sie hatte ununterbrochen Todesangst und rannte viel.“"
                            },
                            {
                                "example_id": "8bd1aab2-3a1c-4e3a-9095-6a1fe4db0dc7",
                                "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                                "text": "„Franklin hasst Kinder, er liebt Tiere, und er hat eine Todesangst vor den Zuckermenschen.“"
                            },
                            {
                                "example_id": "23132bf1-66fe-4c7f-ac6d-5b66ab9bb79e",
                                "sense_id": "b00ee42d-b7af-318c-823d-50fc9f0328c3",
                                "text": "„Es ist mein freier Tag und ich sollte eigentlich ausruhen, aber ich habe eine Todesangst vor diesem widernatürlichen Ding.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
