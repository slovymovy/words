                "senses": [
                    {
                        "sense_id": "85a23de6-d016-3555-b631-c2247c7d4f91",
                        "entry_id": "89df57c1-595a-3b43-b8cc-7fa141217e0f",
                        "glosses": [
                            "Erlass eines Sultans"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "99e99587-f7a7-4bbd-a6c0-6bf5260ed3c0",
                                "sense_id": "85a23de6-d016-3555-b631-c2247c7d4f91",
                                "text": "„Im Januar 1876 mußte aber der Statthalter von Bosnien die Ausführung der in der Irade vorgeschriebenen Reformen einstellen, weil er einen Aufstand der muselmännischen Bevölkerung fürchtete.“"
                            },
                            {
                                "example_id": "341356b7-c23d-4b3d-89dc-dc275110a2fe",
                                "sense_id": "85a23de6-d016-3555-b631-c2247c7d4f91",
                                "text": "„Die französische Regierung hatte anfangs gegen das Irade des Sultans protestiert, dann jedoch nachgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
