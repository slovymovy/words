        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                "word": "statuette",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5f68770b-d8be-441d-935a-4298b5f69617",
                        "entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                        "tags": [
                            "plural"
                        ],
                        "form": "statuettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                        "entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                        "glosses": [
                            "A small statue, usually a figure much less than life size, especially when of marble or bronze, or of plaster or clay as a preparation for the marble or bronze, as distinguished from a figure in terra cotta etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e1179c4-a395-4a8c-952d-79679cb2c569",
                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                "text": "[…] may be discovered not far from a charming statuette of Queen Alexandra, and there is also the figurette of King George's elder brother."
                            },
                            {
                                "example_id": "a7e3b7e2-9ff9-431d-a000-3c5f32bacf4e",
                                "sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                                "text": "Some statuettes are not monochrome but represent characters. That is why they are called nanofigures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df4bba8e-88b1-4ef2-9c28-9192d49bbf26",
                        "source_entry_id": "d6510b96-cb8f-3f8f-aaa1-1b9b7ba24dcc",
                        "source_sense_id": "6697bea5-136e-34e4-88a1-cb2004e7a634",
                        "source_sense_description": "a small statue",
