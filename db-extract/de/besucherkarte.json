                        "glosses": [
                            "Dokument, das zum Betreten zum Beispiel eines Eislaufplatzes/einer Eisbahn, nicht aber zum Benutzen der Eisfläche berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d70359a9-3285-4f75-8c0b-42853c31ed4b",
                                "sense_id": "8626e940-8340-3db1-8715-49fc6d152a01",
                                "text": "„Die Eintrittspreise und Öffnungszeiten des Eisstadions bleiben gleich, auch die Besucherkarte für Begleitpersonen, die nicht Eis laufen wollen, wird wieder erhältlich sein.“"
                            },
                            {
                                "example_id": "8ec5fef1-eb2f-4144-8892-234fc4495e0d",
                                "sense_id": "8626e940-8340-3db1-8715-49fc6d152a01",
                                "text": "„Auch die im vergangenen Jahr neu vorgestellte Besucherkarte ist weiter erhältlich.“"
                            }
                        ],
