                                            {
                                                "example_id": "25df20f7-67a1-414b-8b8b-c5c9a0594bb2",
                                                "sense_id": "578bb86c-5da5-3783-b887-99f0ce6f82a9",
                                                "text": "That plumber's fix is much better than the first one's."
                                            },
                                            {
                                                "example_id": "1ac771d0-1ce4-401f-813a-7e541c53fcce",
                                                "sense_id": "578bb86c-5da5-3783-b887-99f0ce6f82a9",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, […]. A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a64c474d-04a3-3bbe-bdbf-35f6c1f13b0c",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A difficult situation; a quandary or dilemma; a predicament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c804cd-d4e5-499e-b021-a02950780844",
                                                "sense_id": "a64c474d-04a3-3bbe-bdbf-35f6c1f13b0c",
                                                "text": "It rained before we repaired the roof, and were we in a fix!"
                                            },
                                            {
                                                "example_id": "dcb19d79-a0e7-4319-bb84-1a25fb4fc17e",
                                                "sense_id": "a64c474d-04a3-3bbe-bdbf-35f6c1f13b0c",
                                                "text": "\"How come you're in this fix?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6b2ca21-7f34-3d97-92bb-d68fe8bdd15b",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A single dose of a narcotic drug, especially when injected."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636fc656-8f9e-4a77-bfa8-f5c8d58f4b00",
                                                "sense_id": "e6b2ca21-7f34-3d97-92bb-d68fe8bdd15b",
                                                "text": "And Cash told me of cases where two hips take a fix together and then one pulls out his badge."
                                            },
                                            {
                                                "example_id": "ec374bfa-1f26-41e2-8e6e-bcd9cbce74c5",
                                                "sense_id": "e6b2ca21-7f34-3d97-92bb-d68fe8bdd15b",
                                                "text": "Maybe I will find in yage what I was looking for in junk and weed and coke. Yage may be the final fix."
                                            },
                                            {
                                                "example_id": "6d4e90a3-3bf4-4920-bdc3-9ed3e26021f3",
                                                "sense_id": "e6b2ca21-7f34-3d97-92bb-d68fe8bdd15b",
                                                "text": "Just one fix!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b87d61-c2bf-3ac2-95a0-5f1c4153a230",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A single dose of a narcotic drug, especially when injected.",
                                            "Something that satisfies a yearning or a craving."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2e02a51-c935-3196-8715-42bcfe0dd3ef",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A single dose of a narcotic drug, especially when injected.",
                                            "A compulsive desire or thrill."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6af9f4e0-cf32-36b5-b584-53507ff1b3ee",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A prearrangement of the outcome of a supposedly competitive process, such as a sporting event, a game, an election, a trial, or a bid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18850a5e-6b0a-44ae-8e5e-cb76ae787e9a",
                                                "sense_id": "6af9f4e0-cf32-36b5-b584-53507ff1b3ee",
                                                "text": "As the professional thief notes: You can tell by the way the case is handled in court when the fix is in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24e6d0bb-c91b-38fe-9c7f-729486d47fc3",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "An understanding, grasp of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18931eee-a437-40f5-a259-19f75e5f38cf",
                                                "sense_id": "24e6d0bb-c91b-38fe-9c7f-729486d47fc3",
                                                "text": "Each character comes to us with her own particular fix on reality, shaped by a lifetime of experience and by the urgencies of the moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8177a5ee-6be1-3840-b4e4-74eab305de79",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A determination of location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4dc37c6-c587-4ab4-bb81-8866cab0af2d",
                                                "sense_id": "8177a5ee-6be1-3840-b4e4-74eab305de79",
                                                "text": "We have a fix on your position."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c47aa6-08fe-3062-ac91-d2274e042228",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "A non-waypoint terrain feature used to make a determination of location."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df4415b8-57fa-32d9-b1e1-52037abbec9b",
                                        "entry_id": "5b595e95-4ea3-3d42-a057-a8aaae4f260d",
                                        "glosses": [
                                            "Fettlings (mixture used to line a furnace)"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
