                        "glosses": [
                            "энтомол. бабочка из семейства пестрянок (Zygaenidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2227ca73-76f0-449a-9ce2-8d61390af74b",
                                "sense_id": "daa0e51b-2fdf-3708-82a8-b9431c8b0b0d",
                                "text": "Тыртыр — татарское название гусеницы бабочки виноградной пестрянки, или букны (Ino ampelophaga), употребляемое в Крыму."
                            }
                        ]
                    }
