                "senses": [
                    {
                        "sense_id": "8ec378a1-f2bc-38b4-8b97-2613b31a93a1",
                        "entry_id": "fd4b4362-0a6f-3c3f-9336-9ef708bb8601",
                        "glosses": [
                            "to dry, to drain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "089d9b28-cb5a-4cea-8085-c33d3abb2da1",
                                "sense_id": "8ec378a1-f2bc-38b4-8b97-2613b31a93a1",
                                "text": "осуша́ть слёзы",
                                "translation": "to dry one's tears",
                                "english": "to dry one's tears"
                            },
                            {
                                "example_id": "582d464e-ca61-4250-8af5-1dcf3a813f48",
                                "sense_id": "8ec378a1-f2bc-38b4-8b97-2613b31a93a1",
                                "text": "осуша́ть боло́то",
                                "translation": "to drain/reclaim a marsh",
                                "english": "to drain/reclaim a marsh"
                            }
                        ]
                    },
                    {
                        "sense_id": "7ae409d4-5c00-3b6b-89b1-2c08c64608f4",
                        "entry_id": "fd4b4362-0a6f-3c3f-9336-9ef708bb8601",
                        "glosses": [
                            "to drain, to drink up"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d6e86f12-225a-48b5-8036-da6f95e8da13",
                                "sense_id": "7ae409d4-5c00-3b6b-89b1-2c08c64608f4",
                                "text": "— Да-с, люби́л-с вы́пить; э́то люби́ли-с, пива́ли-с! — кри́кнул вдруг отставно́й провиа́нтский, осуша́я двена́дцатую рю́мку во́дки.",
                                "translation": "\"Yes, he was fond of drink, he was fond of it, he did drink!\" cried the commissariat clerk, gulping down his twelfth glass of vodka.",
                                "english": "\"Yes, he was fond of drink, he was fond of it, he did drink!\" cried the commissariat clerk, gulping down his twelfth glass of vodka."
                            }
                        ]
                    }
                ],
