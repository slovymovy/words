                "senses": [
                    {
                        "sense_id": "1b64df0d-d990-36d8-b075-50d88a6c6ac0",
                        "entry_id": "0c996c75-7cbf-369f-b5f0-97ca75a60e3d",
                        "glosses": [
                            "Sie, meine Dame"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
