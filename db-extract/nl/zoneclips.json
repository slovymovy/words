                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "967e1651-1f29-424a-8e2b-299967e335fb",
                        "source_entry_id": "b1081846-7a66-38e6-83dc-bf692827661c",
                        "source_sense_id": "27b34b75-8ac5-3241-8e9d-f5d520c1e89c",
                        "source_sense_description": "het verschijnsel dat de maan voor de zon langstrekt, waardoor het zonlicht geblokkeerd wordt",
                        "target_lang_word": "Sonnenfinsternis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenfinsternis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                        "entry_id": "3d3d395a-c8aa-3cfa-b92a-4ca52e58f927",
                                        "glosses": [
                                            "Ereignis, bei dem der Mond die Sonne verdunkelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a16f746-738e-43d9-befc-819a0bf94aea",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "1999 gab es eine totale Sonnenfinsternis, die auch in Österreich zu sehen war."
                                            },
                                            {
                                                "example_id": "dd66250a-8ab0-4a1a-98d3-ab3e09dd1da9",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„Im August 1999, am Tag der Sonnenfinsternis, sahen ihn seine Eltern zum letzten Mal, abends waren er und sein rotes Auto fort.“"
                                            },
                                            {
                                                "example_id": "916e455b-e22d-45f4-8fee-985f71fc9635",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "Die Sonnenfinsternis an diesem Freitagvormittag ist ein Naturspektakel, dem viele Menschen mit Spannung entgegen sehen."
                                            },
                                            {
                                                "example_id": "3fade5bb-a6d0-46dd-a342-eae5fc32a1e9",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "Erst führte die besondere Sonne-Mond-Konstellation zur Sonnenfinsternis. Jetzt lässt sie an der Küste des nordfranzösischen Saint-Malo und anderen Orten den Wasserstand massiv ansteigen."
                                            },
                                            {
                                                "example_id": "709a0d2c-965e-4d51-81e7-c43c11a86ac5",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„Etwa zwei bis fünf Sonnenfinsternisse gibt es weltweit jedes Jahr, darunter fallen allerdings auch partielle Sonnenfinsternisse.“"
                                            },
                                            {
                                                "example_id": "8a9168f4-d52c-42ec-a2a5-a30bafc56329",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„In früheren Zeiten gab es keine wissenschaftlichen Erklärungen für eine Sonnenfinsternis. In allen Teilen der Welt rankten sich daher Mythen und Aberglaube um die Sonnenfinsternis.“"
                                            },
                                            {
                                                "example_id": "7724d31a-c0c4-487e-bb1d-19c2c4e4cf85",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„In der Geschichte der Menschheit wurden Sonnenfinsternisse oft als Vorboten von Unglück und Not gedeutet.“"
                                            },
                                            {
                                                "example_id": "d6ba14eb-467f-4efc-b6d4-f754375894e4",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„Auch heute noch gibt es Menschen, die in einer Sonnenfinsternis den Vorboten von Unglück sehen.“"
                                            },
                                            {
                                                "example_id": "368d63db-de28-4d12-8a20-82cb30351a16",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„So haben viele Leute geglaubt, dass die Sonnenfinsternis von 1999 den Beginn des Weltunterganges um den Jahrtausendwechsel ankündigt.“"
                                            },
                                            {
                                                "example_id": "6d32394f-e3b0-4627-84da-72ec17e4580a",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„Bei einer totalen Sonnenfinsternis verdeckt der Mond die Sonne von der Erde aus gesehen also völlig, so dass es für wenige Minuten am Tag dunkel wie in der Nacht wird.“"
                                            },
                                            {
                                                "example_id": "46b6b708-e9af-4bf1-9778-d4a9576eec6c",
                                                "sense_id": "3a824d47-cb70-3cb9-b92a-0b6c122c95a7",
                                                "text": "„Eine teilweise Verdeckung der Sonne durch den Mond gibt es übrigens öfters als eine totale Sonnenfinsternis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
