        "fr-extract.jsonl": [
            {
                "entry_id": "cd63093f-3d55-3814-b260-17032f130231",
                "word": "Naples",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2f0af74-7a63-36bc-960c-39c258d3fa6d",
                        "entry_id": "cd63093f-3d55-3814-b260-17032f130231",
                        "glosses": [
                            "Commune et ville de la région de Campanie, en Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb091043-2234-4194-9ec3-567ce95c2ac2",
                                "sense_id": "a2f0af74-7a63-36bc-960c-39c258d3fa6d",
                                "text": "Je voyageois en Italie : arrivé à Naples, je m’empressai de visiter ce fameux Vésuve, dont la première éruption éclata, selon quelques auteurs, sous l’empereur Titus, l’an soixante-dix-neuf de notre ère, et coûta la vie au célèbre Pline."
                            },
                            {
                                "example_id": "c163061e-056b-4587-81a2-ac22959202a8",
                                "sense_id": "a2f0af74-7a63-36bc-960c-39c258d3fa6d",
                                "text": "En 1980, l’Italie est d'ailleurs déjà celui des pays du Marché commun qui a les plus graves problèmes d'environnement : des égouts de Naples aux pollutions chimiques de la plaine du Pô, la péninsule exprime son incivisme glorieux. Dans une civilisation industrielle avancée, le chacun pour sa peau se paye au prix fort."
                            },
                            {
                                "example_id": "4cc5a013-99da-41cf-a14d-5943dffaf3bf",
                                "sense_id": "a2f0af74-7a63-36bc-960c-39c258d3fa6d",
                                "text": "Enfin, difficile de quitter Naples sans s’être rendu à Pompéi."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc04fcc6-cb66-377e-82ed-d0b3ad556d69",
                        "entry_id": "cd63093f-3d55-3814-b260-17032f130231",
                        "glosses": [
                            "Province autour de cette ville."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a7667780-7dbd-3d5d-b51a-8f120179f5ad",
                        "entry_id": "cd63093f-3d55-3814-b260-17032f130231",
                        "glosses": [
                            "Ville de Floride, aux États-Unis."
                        ],
                        "tags": [],
                        "note": "Généralement prononcé [nɛ.pœlz]",
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ffad25e-8702-4fde-bf41-b2c65fb0595e",
                        "source_entry_id": "cd63093f-3d55-3814-b260-17032f130231",
                        "source_sense_description": "Ville d’Italie",
                        "target_lang_word": "Neapel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neapel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10fe0ba6-f09f-3757-b15e-63d5c4f239cf",
                                        "entry_id": "83c6546b-dc9b-3dbf-a06f-503beec50bbc",
                                        "glosses": [
                                            "Stadt in Süditalien mit etwa 1 Million Einwohner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6aee5c-015a-49ad-8af9-83c7e418e251",
                                                "sense_id": "10fe0ba6-f09f-3757-b15e-63d5c4f239cf",
                                                "text": "„Auffällig ist, dass Neapel keine einzelne Stadtmitte besitzt, sondern mehrere kleinere Zentren.“"
                                            },
                                            {
                                                "example_id": "e74d5bff-20c1-4b43-ada2-0d09a0a0cecf",
                                                "sense_id": "10fe0ba6-f09f-3757-b15e-63d5c4f239cf",
                                                "text": "Das Neapel des Mittelalter kann man noch wiederentdecken."
                                            },
                                            {
                                                "example_id": "06c7a082-9d9c-4696-945c-931a8f4fc470",
                                                "sense_id": "10fe0ba6-f09f-3757-b15e-63d5c4f239cf",
                                                "text": "„Er gab mir einen Brief an den Erzbischof von Cosenza mit, in dem er mich diesem warm empfahl und ihn bat, mich auf seine Kosten nach Neapel zu schicken.“"
                                            },
                                            {
                                                "example_id": "8fbe963d-7da1-45eb-8cbc-66aeea8fed61",
                                                "sense_id": "10fe0ba6-f09f-3757-b15e-63d5c4f239cf",
                                                "text": "„Rund elf Tage später verhaftete er in dem Dorf Caivano nordöstlich von Neapel den General Contanelli, der sich hier – der Not gehorchend, nicht der eigenen Tugend –gerade als Schafhirte versuchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
