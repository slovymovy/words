                                                "sense_id": "22d147f4-d5f5-38b7-b025-366601a3a2ae",
                                                "text": "An addendum was added to the contract to clarify payment terms."
                                            },
                                            {
                                                "example_id": "43813550-675a-44f3-a9da-a49a58306c3f",
                                                "sense_id": "22d147f4-d5f5-38b7-b025-366601a3a2ae",
                                                "text": "The author included an addendum at the end of the book."
                                            }
