{
    "word_family": [
        "elucidation",
        "elucidative",
        "elucidator",
        "elucidatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1533dd4-df63-3412-ad4d-e2ca9e78fbe8",
                    "sense_definition": "To make something clear and understandable by providing an explanation or more details.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor's notes have the rare merit of really <w>elucidating</w> the complex text for the students.",
                            "target_lang_translations": {
                                "ru": "Заметки профессора обладают редким достоинством — они действительно <w>разъясняют</w> сложный текст студентам."
                            }
                        },
                        {
                            "text": "I would like to <w>elucidate</w> the point further so that everyone understands the new policy.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы подробнее <w>разъяснить</w> этот момент, чтобы все поняли новую политику."
                            }
                        }
                    ],
                    "synonyms": [
                        "clarify",
                        "explain",
                        "explicate",
                        "illuminate"
                    ],
                    "common_phrases": [
                        "elucidate the point",
                        "elucidate the matter",
                        "elucidate the text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо ясным и понятным, предоставив объяснение или дополнительные детали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъяснять",
                                "target_lang_sense_clarification": "делать понятным, объяснять детали"
                            },
                            {
                                "target_lang_word": "прояснять",
                                "target_lang_sense_clarification": "вносить ясность в вопрос"
                            },
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "подробно излагать суть проблемы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f9ac14-8f5c-389d-96d8-8c77565e7cb3",
                    "sense_definition": "To make something physically bright, luminous, or transparent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illumination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist used a series of colored lights to <w>elucidate</w> the internal workings of the plastic model.",
                            "target_lang_translations": {
                                "ru": "Ученый использовал серию цветных огней, чтобы <w>осветить</w> внутреннее устройство пластиковой модели."
                            }
                        },
                        {
                            "text": "The chemical reaction began <w>elucidating</w> the liquid, turning it from a dark murk to a clear state.",
                            "target_lang_translations": {
                                "ru": "Химическая реакция начала <w>просветлять</w> жидкость, превращая ее из темной мути в прозрачное состояние."
                            }
                        }
                    ],
                    "synonyms": [
                        "illuminate",
                        "brighten"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо физически ярким, светящимся или прозрачным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "делать светлым, наполнять светом"
                            },
                            {
                                "target_lang_word": "просветлять",
                                "target_lang_sense_clarification": "делать прозрачным или чистым"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "218d2a81-f1dd-3a1d-9255-63c044acd91d",
                    "sense_definition": "Characterized by being clear or easily understood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a master of perspicuity and <w>elucidate</w> distinctions in his philosophical writings.",
                            "target_lang_translations": {
                                "ru": "В своих философских трудах он был известен как мастер ясности и <w>отчетливых</w> разграничений."
                            }
                        },
                        {
                            "text": "The author provided an <w>elucidate</w> account of the events that left no room for doubt.",
                            "target_lang_translations": {
                                "ru": "Автор представил <w>ясное</w> изложение событий, не оставившее места для сомнений."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "evident",
                        "manifest",
                        "obvious",
                        "plain"
                    ],
                    "antonyms": [
                        "turbid"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This adjective form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся ясностью или легкостью для понимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "понятный и отчетливый"
                            },
                            {
                                "target_lang_word": "вразумительный",
                                "target_lang_sense_clarification": "легко поддающийся пониманию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}