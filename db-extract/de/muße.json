                ],
                "senses": [
                    {
                        "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                        "entry_id": "8cac3911-3483-39a2-8b3b-fab96c4df937",
                        "glosses": [
                            "arbeitsfreie Zeit für Erholung, Entspannung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62efbb36-c690-4d8f-a206-b6e526ed13de",
                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                "text": "Der Alltag lässt uns oft wenig Muße."
                            },
                            {
                                "example_id": "56f824ab-6c15-49cf-9bd5-07cc05ab6c9f",
                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                "text": "Wir sollten uns mehr Muße gönnen."
                            },
                            {
                                "example_id": "c7592a8b-9eb2-4d4c-a4b9-c93707b1c1ce",
                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                "text": "„Die Muße verliert, wie alle guten Dinge dieser Welt, sogleich den Reiz, wenn sie uns aufgenötigt wird.“"
                            },
                            {
                                "example_id": "c9e42f89-68ba-4867-9c55-ec43d2027021",
                                "sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                                "text": "„Weil Simen Tjing nicht zu Hause war, hatten alle Frauen Muße und lustwandelten nun, um die Frühlingsmattigkeit zu verscheuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5622b555-a4ef-43e6-9d92-a4cf86d00f59",
                        "source_entry_id": "8cac3911-3483-39a2-8b3b-fab96c4df937",
                        "source_sense_id": "93bee68f-7870-3bc2-9a61-4a5aef9742a7",
                        "source_sense_description": "arbeitsfreie Zeit für Erholung, Entspannung",
                        "target_lang_word": "leisure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leisure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e1867f-009a-3a75-aaff-786b5d67ff42",
                                        "entry_id": "54e9096e-ed09-34b4-a57f-5e1f34a0711d",
                                        "glosses": [
                                            "Freedom provided by the cessation of activities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                        "entry_id": "54e9096e-ed09-34b4-a57f-5e1f34a0711d",
                                        "glosses": [
                                            "Free time, time free from work or duties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1259eb71-bd1a-43c3-8453-76a942665d40",
                                                "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                                "text": "The desire of leisure is much more natural than of business and care."
                                            },
                                            {
                                                "example_id": "defc2967-643b-4e9c-a012-b0a087e33bc3",
                                                "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                                "text": "Little had Mrs. Dashwood or her daughters imagined when they first came into Devonshire, that so many engagements would arise to occupy their time as shortly presented themselves, or that they should have such frequent invitations and such constant visitors as to leave them little leisure for serious employment."
                                            },
                                            {
                                                "example_id": "3413c8c1-e57f-43cc-8d3b-34efc1bb3ad5",
                                                "sense_id": "6042f590-1141-333c-82dd-8d9542a27183",
                                                "text": "This is why the mathematical arts were founded in Egypt; for there the priestly caste was allowed to be at leisure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3fd2d5-4cef-37e2-a3aa-0fdb76591d14",
                                        "entry_id": "54e9096e-ed09-34b4-a57f-5e1f34a0711d",
                                        "glosses": [
                                            "Time at one's command, free from engagement; convenient opportunity; hence, convenience; ease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccdc80e0-4477-4aab-8c3b-9a64625b7b37",
                                                "sense_id": "bb3fd2d5-4cef-37e2-a3aa-0fdb76591d14",
                                                "text": "He sigh'd, and had no leisure more to say."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0491ade9-9cc7-42cf-9a1f-651c69e77973",
                        "source_entry_id": "8cac3911-3483-39a2-8b3b-fab96c4df937",
