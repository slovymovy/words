                    "sense_definition": "proces powolnego rozkładu substancji organicznych (zwłaszcza drewna lub roślin) pod wpływem wilgoci i mikroorganizmów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "proces_rozkladu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wilgoć w piwnicy doprowadziła do szybkiego <w>butwienia</w> drewnianych belek konstrukcyjnych.",
                            "target_lang_translations": {
                                "ru": "Сырость в подвале привела к быстрому <w>гниению</w> деревянных балок конструкции."
                            }
                        },
                        {
                            "text": "Jesienią w lesie można wyraźnie poczuć zapach <w>butwienia</w> opadłych z drzew liści.",
                            "target_lang_translations": {
                                "ru": "Осенью в лесу отчетливо чувствуется запах <w>прения</w> опавших с деревьев листьев."
                            }
                        }
                    ],
                    "synonyms": [
                        "gnicie",
                        "próchnienie",
                        "rozkład"
                    ],
                    "common_phrases": [
                        "proces butwienia",
                        "butwienie drewna",
                        "butwienie liści"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс медленного разложения органических веществ (особенно древесины или растений) под воздействием влаги и микроорганизмов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гниение",
