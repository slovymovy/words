                "translations": [
                    {
                        "translation_id": "830fd6d8-5816-4794-bef4-b367052d7dec",
                        "source_entry_id": "bb45525c-d50e-3bf7-8610-d04a9d66b268",
                        "source_sense_id": "8743d1c6-a90e-3a88-9af5-6a5902f37527",
                        "target_lang_word": "parabiosis",
