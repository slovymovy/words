                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>prêtre</w> célèbre la messe tous les dimanches matin dans l'église du village."
                        },
                        {
                            "text": "Après plusieurs années d'études théologiques, le jeune diacre a enfin été ordonné <w>prêtre</w>."
                        }
