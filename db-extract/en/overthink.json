                        "sense_id": "44e2c439-ffbd-3e51-8102-eb291b6515bb",
                        "entry_id": "0f759a30-c3ff-3cc1-8760-dcc30136ac02",
                        "glosses": [
                            "To think or analyze too much."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57bda3c-d0c0-4fd5-8110-dcda6ac13d59",
                                "sense_id": "44e2c439-ffbd-3e51-8102-eb291b6515bb",
                                "text": "Don't overthink the problem. It's not that difficult."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ada1a47-76bf-3e7a-a052-98602ee15484",
                        "entry_id": "0f759a30-c3ff-3cc1-8760-dcc30136ac02",
                        "glosses": [
                            "To think too highly (of); overestimate"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "81d33548-792d-4b1a-ba42-7b456fbeb27b",
                                "sense_id": "1ada1a47-76bf-3e7a-a052-98602ee15484",
                                "text": "So to think of self as not to overthink — to think of yourself with sober, moral judgment."
                            }
                        ]
                    }
