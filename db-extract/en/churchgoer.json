                        "source_sense_id": "9285e084-795b-38a9-acad-dcc6e36163af",
                        "source_sense_description": "one who goes to church",
                        "target_lang_word": "Kirchenbesucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchenbesucher",
