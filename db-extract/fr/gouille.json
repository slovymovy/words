            {
                "entry_id": "306fa39c-58be-3546-9836-88c5b075e075",
                "word": "gouille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4871c2eb-6013-47f2-a81a-dd849e5b5480",
                        "entry_id": "306fa39c-58be-3546-9836-88c5b075e075",
                        "tags": [
                            "plural"
                        ],
                        "form": "gouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4f5da25-1d37-3a5b-894c-7410ea0ebe63",
                        "entry_id": "306fa39c-58be-3546-9836-88c5b075e075",
                        "glosses": [
                            "Flaque, trou d’eau dans une rivière, mare, petit étang."
                        ],
                        "tags": [
                            "Suisse",
                            "Bugey",
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "c0b54363-b9fd-4aba-a696-f2210a557b0a",
                                "sense_id": "a4f5da25-1d37-3a5b-894c-7410ea0ebe63",
                                "text": "J’ai bien failli me noyer en apprenant à nager dans une gouille du Séran !"
                            },
                            {
                                "example_id": "c20af35c-a1d8-458f-a83e-0a2d6de01e63",
                                "sense_id": "a4f5da25-1d37-3a5b-894c-7410ea0ebe63",
                                "text": "Devant le chalet du Pré-de-Joux, il y avait une gouille d’eau qu’il fallait traverser. […] Quand ils sont arrivés au milieu de la gouille, le taureau s’est mis à souffler dedans."
                            },
                            {
                                "example_id": "9bd4e13e-8504-4d23-84da-c07c7eb42613",
                                "sense_id": "a4f5da25-1d37-3a5b-894c-7410ea0ebe63",
                                "text": "Autour des gouilles, de petites mares, les grenouilles rousses et vertes font un tintamarre et les larves des leucorrhines à gros thorax, une libellule noire, sèchent après un séjour aquatique de plusieurs années."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c4d8e47-94aa-3b61-9a3c-256d39d5240a",
                        "entry_id": "306fa39c-58be-3546-9836-88c5b075e075",
                        "glosses": [
                            "Lac, mer, océan."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bf36ae99-9149-4901-b59d-97ca24c97bc9",
                                "sense_id": "6c4d8e47-94aa-3b61-9a3c-256d39d5240a",
                                "text": "Un grand bateau à roue nous faisait traverser la gouille et nous posait à proximité d’une plage de sable fin entre les roseaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "611f4fe9-9716-3854-89c6-d5db27a5c70d",
                        "entry_id": "306fa39c-58be-3546-9836-88c5b075e075",
                        "glosses": [
                            "Trou peu profond qui sert à jouer aux billes. ^([4])"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "61edefe8-e6b5-46ce-ab31-f69174e3c111",
                                "sense_id": "611f4fe9-9716-3854-89c6-d5db27a5c70d",
                                "text": "L’école n’était pas encore mixte et on jouait à la gouille (jeu de bille) et à “tir au poils” dans la cour !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c64a33cf-5d48-33b5-93c3-81bd1ccc4151",
                        "entry_id": "306fa39c-58be-3546-9836-88c5b075e075",
                        "glosses": [
                            "Alcool plus ou moins fort et de mauvaise qualité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
