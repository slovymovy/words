    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ab74515-b63d-39df-9adb-1496c9f5bef8",
                    "sense_definition": "Répéter ou prononcer des mots, des noms ou des slogans avec un rythme régulier et accentué.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants réunis dans la rue ont commencé à <w>scander</w> un slogan pour réclamer justice."
                        },
                        {
                            "text": "La foule n'a pas cessé de <w>scander</w> le nom de son champion tout au long de la course."
                        }
                    ],
                    "synonyms": [
                        "clamer",
                        "entonner"
                    ],
                    "common_phrases": [
                        "scander des slogans"
                    ]
                },
                {
                    "sense_id": "c0aadcb7-7eb2-3f24-a9ae-19c9cfdf3ab2",
                    "sense_definition": "Réciter ou analyser un vers en marquant nettement le rythme, les syllabes ou les pieds qui le composent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous a montré comment <w>scander</w> un vers afin de repérer le mètre poétique."
                        },
                        {
                            "text": "Pour bien réciter ce poème classique, l'actrice a appris à <w>scander</w> des vers avec précision."
                        }
                    ],
                    "synonyms": [
                        "mesurer",
                        "rythmer"
                    ],
                    "common_phrases": [
                        "scander des vers"
                    ]
                },
                {
                    "sense_id": "4e01d5d3-a269-366c-a070-597b68953882",
                    "sense_definition": "Rythmer ou ponctuer des paroles, une action ou un discours par des gestes ou des temps réguliers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur a choisi de <w>scander</w> son discours en frappant régulièrement la table du poing."
                        },
                        {
                            "text": "Des applaudissements chaleureux venaient régulièrement <w>scander</w> chaque pause de son intervention."
                        }
                    ],
                    "synonyms": [
                        "ponctuer",
                        "rythmer"
                    ],
                    "common_phrases": [
                        "scander son discours"
                    ]
                }
            ]
        }
    ]
