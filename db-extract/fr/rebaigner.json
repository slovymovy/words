                "senses": [
                    {
                        "sense_id": "30dc8e28-62b8-33ec-870e-dbe63e5a36a5",
                        "entry_id": "b0aec029-5f10-37a0-a143-7423a0a28dd4",
                        "glosses": [
                            "Baigner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd17879a-de52-416f-a708-8e31ded29478",
                                "sense_id": "30dc8e28-62b8-33ec-870e-dbe63e5a36a5",
                                "text": "Sois toujours en mai rebaigné De la rosée qui doux glisse, Et jamais juin ne te fanisse."
                            },
                            {
                                "example_id": "7c64a560-af25-40e9-829d-97209a32c15e",
                                "sense_id": "30dc8e28-62b8-33ec-870e-dbe63e5a36a5",
                                "text": "Il aurait fallu la grande Étrangleuse pour l’empêcher d’aller jusqu’au bout de cette étrange confession qui lui donnait peut-être, à son dernier jour, la bonne chimère de se rebaigner dans sa Vengeance."
                            }
                        ]
                    }
