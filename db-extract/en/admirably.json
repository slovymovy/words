                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a3b07e10-02af-4ea5-81c1-9039ee08bd23",
                        "entry_id": "1f4a6f7c-4eed-3682-8a4e-7fd584f0293e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more admirably"
                    },
                    {
                        "form_id": "3c2ee824-f8e7-47a8-87e4-381fa36fd563",
                        "entry_id": "1f4a6f7c-4eed-3682-8a4e-7fd584f0293e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most admirably"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d23cdb98-c9df-3b4a-9b78-6d52b905d845",
                        "entry_id": "1f4a6f7c-4eed-3682-8a4e-7fd584f0293e",
                        "glosses": [
                            "In a way worthy of admiration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee1d88f-b7c8-4d60-9a2a-4c79327b170e",
                                "sense_id": "d23cdb98-c9df-3b4a-9b78-6d52b905d845",
                                "text": "Near-synonym: laudably"
                            },
                            {
                                "example_id": "681d1509-6cd5-4134-b520-e5e6d50f08a3",
                                "sense_id": "d23cdb98-c9df-3b4a-9b78-6d52b905d845",
                                "text": "He succeeded admirably in drawing fire away from the troop transports."
                            },
                            {
                                "example_id": "8801cabd-5a72-4366-b9b5-9706f7c6b112",
                                "sense_id": "d23cdb98-c9df-3b4a-9b78-6d52b905d845",
                                "text": "Admirably, he went down with his ship after the surviving crew got away in lifeboats."
                            },
                            {
                                "example_id": "3862f24a-db34-4805-bf84-3ea8b91dcd1e",
                                "sense_id": "d23cdb98-c9df-3b4a-9b78-6d52b905d845",
                                "text": "...yet more than all I had heard of it, now strongly informed me I was to expect that supreme pleasure which she had placed in the meeting of those parts so admirably fitted for each other.",
                                "translation": "Fanny Hill",
                                "english": "Fanny Hill"
                            }
                        ]
                    },
                    {
                        "sense_id": "18c0e3a5-d569-397f-b970-5d4585fcf5f9",
                        "entry_id": "1f4a6f7c-4eed-3682-8a4e-7fd584f0293e",
                        "glosses": [
                            "To an admirable degree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f352839-0940-4c66-aacc-ff3c3d8a0783",
                                "sense_id": "18c0e3a5-d569-397f-b970-5d4585fcf5f9",
                                "text": "They have made admirably great improvements in quality."
                            },
                            {
                                "example_id": "959229f7-07a4-4b4b-8611-db649e0ac86f",
                                "sense_id": "18c0e3a5-d569-397f-b970-5d4585fcf5f9",
                                "text": "Naturally, odd pairs of engines and solitary examples lend themselves admirably to nicknames: for example, the Great Eastern 0-10-0 tank \"Decapod\", and the Lickey Incline banker, \"Big Bertha\", recently withdrawn from service."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f046ef46-bd7d-4708-8e55-5d73a255aece",
                        "source_entry_id": "1f4a6f7c-4eed-3682-8a4e-7fd584f0293e",
                        "source_sense_description": "in an admirable manner",
                        "target_lang_word": "bewonderenswaardig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bewonderenswaardig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3716fb8d-c815-3614-9b82-028a11f055aa",
                                        "entry_id": "4acf853e-9efd-3c54-925a-801859fbbf16",
                                        "glosses": [
                                            "wat het verdient bewonderd te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db0a24b-3fcf-49bf-afba-5e3db4d5b2cf",
                                                "sense_id": "3716fb8d-c815-3614-9b82-028a11f055aa",
                                                "text": "Met een bewonderenswaardige nauwgezetheid deed de vriendelijke verpleegster haar werk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16e48b4a-dee7-4e15-a26d-60234147b2ca",
                        "source_entry_id": "1f4a6f7c-4eed-3682-8a4e-7fd584f0293e",
                        "source_sense_description": "in an admirable manner",
                        "target_lang_word": "admirablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "admirablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                        "entry_id": "f6261c13-5bd4-31e5-8b0e-3ef38edca920",
                                        "glosses": [
                                            "D’une manière admirable, parfaite, merveilleuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fdcd4cd-7c76-402e-bd56-9d11b647e121",
                                                "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                                "text": "La porte du pullman de queue, fermée à clef, s’ouvrit : superbement, admirablement vide, la voiture offrait à ses visiteurs impromptus le plus admirable décor de marqueterie en bois de rose — jaune citron et carmin pâle — qui se pût imaginer."
                                            },
                                            {
                                                "example_id": "cefb50eb-ad8a-448d-9c27-7cf532e22afd",
                                                "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                                            },
                                            {
                                                "example_id": "a69486f3-b33a-49d7-8406-edd287e6321c",
                                                "sense_id": "4db48eba-0add-3e21-8740-32d21f63399b",
                                                "text": "Ces deux adverbes joints font admirablement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
