        "ru-extract.jsonl": [
            {
                "entry_id": "5ceba96f-e5b1-35bf-b211-890e1f104a6a",
                "word": "неуклонно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "64f47d2b-f861-321c-a27b-288fa7e3c1cc",
                        "entry_id": "5ceba96f-e5b1-35bf-b211-890e1f104a6a",
                        "glosses": [
                            "наречие к неуклонный; не допуская отклонений"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b30425db-e086-4abc-b142-bcad8bd22918",
                        "source_entry_id": "5ceba96f-e5b1-35bf-b211-890e1f104a6a",
                        "source_sense_id": "64f47d2b-f861-321c-a27b-288fa7e3c1cc",
                        "target_lang_word": "constamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                        "entry_id": "3f23cbf7-3750-3705-a925-35a37ef27653",
                                        "glosses": [
                                            "Avec constance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01956101-9305-476e-a61e-6ae03ca11dbd",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Dans ma tente même, aux endroits qui ne sont pas constamment piétinés, sous mon lit, dans les coins, il y a maintenant tout un jardinet d'herbes vertes et de fleurettes multicolores."
                                            },
                                            {
                                                "example_id": "6946dcfe-73ec-404f-a814-9b286ee28a8f",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Les autorités prirent soin que ce mouvement ne leur glissât pas des mains, comme cela s'était produit en Californie et en Alaska ; elles le surveillèrent et le régulèrent constamment."
                                            },
                                            {
                                                "example_id": "6013dbad-7441-4275-bfc1-b0c7bbd9046f",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Combien de fois le peuple Romain avait-il porté constamment la défaite des armées !"
                                            },
                                            {
                                                "example_id": "e8c63cd0-e1ce-4912-b879-0c8c6133786b",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "[…]Préparons-nous à montrer constamment Ce que doit une amante à la mort d’un amant."
                                            },
                                            {
                                                "example_id": "7be7ee07-f223-44a0-ac0e-ee2630b7890e",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Parlons de sa mort, s'il se peut, aussi constamment qu’elle est morte."
                                            },
                                            {
                                                "example_id": "71c290a6-dc9c-4bf7-9da3-b4432fb28ef9",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Seigneur, je ne vous demande pas cette raison orgueilleuse qui cherche dans la gloire de souffrir constamment toute la consolation de ses peines."
                                            },
                                            {
                                                "example_id": "4c12dde1-a886-4c93-97c5-62b69ecfef92",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "Il sait souffrir constamment et meurt en paix."
                                            },
                                            {
                                                "example_id": "14e71dce-7620-4089-bf42-ae0b5fe0a887",
                                                "sense_id": "0889cc19-dbf1-3650-a835-b9cdbbfa60a5",
                                                "text": "On ne pense pas toujours constamment d’un même sujet ; l’entêtement et le dégoût se suivent de près."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                        "entry_id": "3f23cbf7-3750-3705-a925-35a37ef27653",
                                        "glosses": [
                                            "Invariablement ; sans interruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd27428-e896-4860-b42e-5a49a0a2d669",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "Le coq , ses aides et les hommes affectés au service des cuisines, porteront constamment la vareuse et le pantalon de fatigue ; […]."
                                            },
                                            {
                                                "example_id": "6cedebad-9653-4c30-be88-9d70c0c0c91c",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "J'ai pour compagnon de couchette un affreux ronfleur sur qui les coups de poing n'ont point d'effet, et qui gigotte constamment comme une grenouille."
                                            },
                                            {
                                                "example_id": "2da658af-2c5c-4d44-a8b5-fe2d4d372fc9",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "Les vagues brisent à bord et submergent constamment le pont qui, mal calfaté à New-York, laisse pénétrer l'eau dans la cabine."
                                            },
                                            {
                                                "example_id": "e50a3d00-247e-4aff-a60a-15f359cb019f",
                                                "sense_id": "bbe762cb-37a8-31eb-a973-60cf53fcc8d7",
                                                "text": "L’Empire romain, qui s’étendait des sables d’Arabie jusqu'aux neiges d’Écosse, fut constamment à la recherche de frontières défendables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db611181-24c3-39c9-aacb-4594987e9357",
                                        "entry_id": "3f23cbf7-3750-3705-a925-35a37ef27653",
                                        "glosses": [
                                            "Certainement ; assurément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1d6d07-810e-4d8d-b425-1a80377698e8",
                                                "sense_id": "db611181-24c3-39c9-aacb-4594987e9357",
                                                "text": "Cette nouvelle est constamment vraie."
                                            },
                                            {
                                                "example_id": "a2c8283c-31bd-41e1-af13-ce6b7fba38c0",
                                                "sense_id": "db611181-24c3-39c9-aacb-4594987e9357",
                                                "text": "Quand il cite pour un maître celui qui constamment est un ignorant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62c22e9c-5844-4bf8-9824-41ecdb08a50f",
                        "source_entry_id": "5ceba96f-e5b1-35bf-b211-890e1f104a6a",
                        "source_sense_id": "64f47d2b-f861-321c-a27b-288fa7e3c1cc",
                        "target_lang_word": "régulièrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régulièrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                        "entry_id": "48f9bdb9-0300-30a4-8737-35f56c4d7b13",
                                        "glosses": [
                                            "D’une manière régulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a399258c-fa62-4a81-96e2-81660b36d709",
                                                "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                                "text": "Vers la racine, le poil se rétrécit régulièrement et les extrémités libres sont légèrement renflées ou obtuses."
                                            },
                                            {
                                                "example_id": "49b6872b-fb58-4b63-9ef7-46854249ba95",
                                                "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                                "text": "Elle était sujette à de fréquentes insomnies et prenait régulièrement un ou deux cachets de théralène qu’elle faisait dissoudre dans un verre d’eau."
                                            },
                                            {
                                                "example_id": "bb750285-8b7e-4de0-8f04-71bf513ef964",
                                                "sense_id": "4889dc77-3e3b-3060-ab87-ba4d594211cf",
                                                "text": "Ainsi, le lit de l'Oued Bouskoura à Casablanca a vu s'établir de nombreuses populations à la suite de vagues d’exodes ruraux, ou le quartier Koulima à Tétouan, situé dans un point bas régulièrement touché par les inondations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "981f790a-5dcc-3fd6-a4c2-1411f8517ccb",
                                        "entry_id": "48f9bdb9-0300-30a4-8737-35f56c4d7b13",
                                        "glosses": [
                                            "Exactement, ponctuellement, uniformément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80499674-b2fd-4fc9-bef5-370d3dee90c3",
                                                "sense_id": "981f790a-5dcc-3fd6-a4c2-1411f8517ccb",
                                                "text": "La duchesse de Nemours dit que, dans une conférence accordée à quelques députés des rebelles [dans la Fronde], on leur fit accroire que le prince de Condé se faisait servir régulièrement à son dîner des oreilles de Parisiens,"
                                            },
                                            {
                                                "example_id": "ad813b98-98f4-4c23-8018-36e1aef3365b",
                                                "sense_id": "981f790a-5dcc-3fd6-a4c2-1411f8517ccb",
                                                "text": "Vous voyez que j'écris régulièrement, tout malade que je suis, dès qu’il s'agit de la moindre affaire,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e81b9cc-1e8f-3308-ba0d-c6c9473b834e",
                                        "entry_id": "48f9bdb9-0300-30a4-8737-35f56c4d7b13",
                                        "glosses": [
                                            "Dans les formes ; selon la procédure ou les règles prescrites."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a693905-f41b-40f8-b993-55945d2ea487",
                                                "sense_id": "9e81b9cc-1e8f-3308-ba0d-c6c9473b834e",
                                                "text": "Enfin sur le chemin de Bolmont à la halte du même nom, […], l’empierrement du chemin bien que régulièrement exécuté, est incapable de retenir les marnes qui refluent entre les cailloux, au passage des voitures."
                                            },
                                            {
                                                "example_id": "73db73b0-93da-407c-b04d-058d36fe14ee",
                                                "sense_id": "9e81b9cc-1e8f-3308-ba0d-c6c9473b834e",
                                                "text": "Il a été ainsi jugé qu’un amendement (à un projet de décret), présenté verbalement en séance par le Gouvernement lors de l’examen pour avis par le Conseil d’État, est régulièrement soumis au Conseil d’État."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9435aa75-df1c-4fcc-89ed-111755287f89",
                        "source_entry_id": "5ceba96f-e5b1-35bf-b211-890e1f104a6a",
                        "source_sense_id": "64f47d2b-f861-321c-a27b-288fa7e3c1cc",
                        "target_lang_word": "inexorablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexorablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44ff1da8-b14f-389a-a9d7-990e5b7ffd32",
                                        "entry_id": "02b4a95c-dcb4-379f-8d63-1752945a032c",
                                        "glosses": [
                                            "D’une manière inexorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39524964-f475-4163-bf4b-32fe1c19b772",
                                                "sense_id": "44ff1da8-b14f-389a-a9d7-990e5b7ffd32",
                                                "text": "Pendant ce temps, ma mutation morphologique se poursuit, inexorablement. En plus de mes jambes atrophiées, d’autres signes conjecturés semblent devoir se confirmer, des petits pieds et de petites mains, un crâne disproportionné, des traits assez grossiers avec un menton fuyant."
                                            },
                                            {
                                                "example_id": "4247d762-e984-452d-bff8-45ee451d4817",
                                                "sense_id": "44ff1da8-b14f-389a-a9d7-990e5b7ffd32",
                                                "text": "C'est là le juste supplice du pécheur qui se retire de Dieu, que Dieu aussi se retire de lui, et par cette soustraction le prive de tout le bien et l’investisse irremédiablement et inexorablement de tout le mal."
                                            },
                                            {
                                                "example_id": "ab4b94cb-3849-4c9d-bbac-fae2d214e896",
                                                "sense_id": "44ff1da8-b14f-389a-a9d7-990e5b7ffd32",
                                                "text": "Elle avait un sari tellement usé que le bleu d'origine tirait inexorablement vers le blanc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27bed1ee-baa1-4f09-bc15-7d95cfb60209",
                        "source_entry_id": "5ceba96f-e5b1-35bf-b211-890e1f104a6a",
                        "source_sense_id": "64f47d2b-f861-321c-a27b-288fa7e3c1cc",
                        "target_lang_word": "fermement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fermement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                                        "entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                                        "glosses": [
                                            "D’une manière ferme, avec force, avec vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5fe66c1-87b3-493a-97a9-2dd486d32d7d",
                                                "sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                                                "text": "Mis en cause dans son intelligence en tant que doctrine révolutionnaire, le néomalthusianisme ne s'en est pas moins ancré fermement en milieu ouvrier, et cela en dépit d’équivoques à l'égard de l’avortement, déconseillé, justifié à regret, ou encouragé."
                                            },
                                            {
                                                "example_id": "1d8bb541-b278-4490-b2f3-8c26a47beedb",
                                                "sense_id": "c3b8e61b-9efd-3fa9-9314-285f7a82a078",
                                                "text": "A la main, il tenait fermement une fraise dentaire de bonne taille. Il l'activa d'un geste et le ronronnement inquiétant envahit la pièce, fort comme le bruit d'un réacteur d'avion. Il tendit sa main armée vers Raphaël et agita son instrument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                        "entry_id": "0f56a4bf-39bc-350a-9623-0f8c49c597c1",
                                        "glosses": [
                                            "Avec assurance, autorité, constance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b04a569d-0c54-4f95-892b-57ba49aeb766",
                                                "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                                "text": "Parler fermement."
                                            },
                                            {
                                                "example_id": "821cb87a-dcea-4562-a7be-785e16c81e84",
                                                "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                                "text": "Persister fermement dans sa résolution, dans son opinion."
                                            },
                                            {
                                                "example_id": "808bef7b-5480-4dd9-a0da-1f98d64c0fb0",
                                                "sense_id": "a0c5255c-a7a8-3c95-b554-3e6b55958047",
                                                "text": "Croire fermement une chose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
