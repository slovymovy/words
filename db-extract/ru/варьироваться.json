                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07882817-1dc0-438f-b26a-b695a66ec716",
                                                "sense_id": "67ccaee1-a6b0-3fe3-aec9-40113f4d738a",
                                                "text": "God hath[…] varied their inclinations."
