                            }
                        ]
                    }
                },
                {
                    "sense_id": "95b7da5c-32bf-34b1-9a75-cdf032af6c86",
                    "sense_definition": "Any mechanism or device used for fastening objects together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
