                                                "sense_id": "58d8a47d-754a-3fc0-b471-a6c665afed23",
                                                "text": "Son père était grainetier."
                                            },
                                            {
                                                "example_id": "0ef0e559-c175-4411-9869-ad7e61994e54",
                                                "sense_id": "58d8a47d-754a-3fc0-b471-a6c665afed23",
                                                "text": "Le grainetier verse du thé dans un verre, le vide dans la théière, recommence cette opération trois ou quatre fois, puis remplit les deux verres."
                                            }
