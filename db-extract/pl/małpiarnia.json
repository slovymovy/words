                        "entry_id": "297437a6-246c-380c-a063-5bddbfdce42a",
                        "glosses": [
                            "pomieszczenie albo budynek przeznaczony dla małp lub małpiatek"
                        ],
                        "tags": [
                            "zootechn."
                        ],
                        "examples": [
                            {
                                "example_id": "344eb0e5-f54d-47d8-8a5e-e515074a8b7c",
                                "sense_id": "fb27451a-5998-343a-885a-1d76d3d823b7",
                                "text": "Wybudowana w latach 60. małpiarnia, w 1998 r. została wyremontowana i przebudowana"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8738c15c-9c71-49dd-823c-b8b64496926e",
                        "source_entry_id": "297437a6-246c-380c-a063-5bddbfdce42a",
                        "source_sense_id": "fb27451a-5998-343a-885a-1d76d3d823b7",
                        "target_lang_word": "обезьянник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обезьянник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "701e8d6f-1490-3dd9-965b-9cfb13ffa68e",
                                        "entry_id": "5243c683-a250-353c-8496-4396408e7d9d",
                                        "glosses": [
                                            "зоол. помещение для содержания обезьян"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c586cb82-67bc-4cb6-bd39-53c1cd9757c8",
                                                "sense_id": "701e8d6f-1490-3dd9-965b-9cfb13ffa68e",
                                                "text": "Мы пошли к обезьянам. У обезьянника творилось что-то невообразимое. Толпа осаждала павильон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbf8c678-a12c-3d16-b957-7185d4a1588f",
                                        "entry_id": "5243c683-a250-353c-8496-4396408e7d9d",
                                        "glosses": [
                                            "перен., разг. камера для административных задержанных при дежурной части ОВД или в опорном пункте охраны правопорядка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86106b2-de0d-4a4b-ab89-f672ad3b1349",
                                                "sense_id": "cbf8c678-a12c-3d16-b957-7185d4a1588f",
                                                "text": "Но мне кажется, хирург и лежащий на операционном столе больной гораздо ближе друг к другу, чем, к примеру, милиционер и задержанный в «обезьяннике»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e78a2d6-46af-3dfd-a92e-79d7e377f223",
                                        "entry_id": "5243c683-a250-353c-8496-4396408e7d9d",
                                        "glosses": [
                                            "перен., разг. ограниченное решёткой помещение для прогулок осужденных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e056edf-0c52-49d7-88e9-b0b6124e4543",
                                                "sense_id": "0e78a2d6-46af-3dfd-a92e-79d7e377f223",
                                                "text": "Три дня вновь прибывшие в карантине — на работу не ходят, читают, отъедаются, спят, гуляют в «обезьяннике», т. е. в железной клетке, построенной на крыше КОСОС, в которой заключенные после работы дышат воздухом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
