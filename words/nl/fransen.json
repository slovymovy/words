                {
                    "sense_id": "901af20b-33d0-3f70-8177-b5fe33ac041f",
                    "sense_definition": "Meervoud van <w>Franse</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "form_female",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee <w>Fransen</w> in de groep spraken vloeiend Nederlands.",
                            "target_lang_translations": {
                                "en": "The two <w>French people</w> in the group spoke fluent Dutch.",
                                "ru": "Двое <w>французов</w> в группе свободно говорили по-нидерландски.",
                                "pl": "Dwoje <w>Francuzów</w> w grupie mówiło płynnie po niderlandzku.",
                                "de": "Die beiden <w>Franzosen</w> in der Gruppe sprachen fließend Niederländisch.",
                                "fr": "Les deux <w>Français</w> du groupe parlaient couramment le néerlandais.",
                                "it": "I due <w>francesi</w> nel gruppo parlavano olandese fluentemente.",
                                "cs": "Ti dva <w>Francouzi</w> ve skupině mluvili plynně nizozemsky.",
                                "tr": "Gruptaki iki <w>Fransız</w> akıcı bir şekilde Felemenkçe konuşuyordu.",
                                "es": "Los dos <w>franceses</w> del grupo hablaban neerlandés con fluidez.",
                                "zh": "小组里的那两位<w>法国人</w>荷兰语说得很流利。"
                            }
                        },
                        {
                            "text": "Zij zijn <w>Fransen</w> die al jaren in Amsterdam wonen.",
                            "target_lang_translations": {
                                "en": "They are <w>French nationals</w> who have lived in Amsterdam for years.",
                                "ru": "Они — <w>французы</w>, которые уже много лет живут в Амстердаме.",
                                "pl": "Oni są <w>Francuzami</w>, którzy od lat mieszkają w Amsterdamie.",
                                "de": "Sie sind <w>Franzosen</w>, die schon seit Jahren in Amsterdam leben.",
                                "fr": "Ce sont des <w>Français</w> qui vivent à Amsterdam depuis des années.",
                                "it": "Loro sono <w>francesi</w> che vivono ad Amsterdam da anni.",
                                "cs": "Jsou to <w>Francouzi</w>, kteří už roky žijí v Amsterdamu.",
                                "tr": "Onlar, yıllardır Amsterdam'da yaşayan <w>Fransızlardır</w>.",
                                "es": "Ellos son <w>franceses</w> que viven en Ámsterdam desde hace años.",
                                "zh": "他们是已经在阿姆斯特丹住了多年的<w>法国人</w>。"
                            }
                        }
