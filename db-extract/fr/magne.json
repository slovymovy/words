        "fr-extract.jsonl": [
            {
                "entry_id": "ff6825ad-0c30-3c11-a1bf-0fe22ccb6242",
                "word": "Magne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd2bb5f9-57b3-3157-b77e-cf587617ba74",
                        "entry_id": "ff6825ad-0c30-3c11-a1bf-0fe22ccb6242",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b1424e-e842-4c3e-90ae-5f745af58988",
                                "sense_id": "fd2bb5f9-57b3-3157-b77e-cf587617ba74",
                                "text": "Le contre-amiral Xavier Magne, qui commandait le groupe aéronaval français pendant les missions Agapanthe en 2006 et 2007, a été nommé à la tête de l'Etat-Major des Opérations Marine, à Paris, où il remplace le vice-amiral Jacques Mazars."
                            },
                            {
                                "example_id": "a777e2bf-60a6-4619-ad26-ad912bb410ab",
                                "sense_id": "fd2bb5f9-57b3-3157-b77e-cf587617ba74",
                                "text": "Jean-Pierre Magne est un éminent collectionneur philatéliste ; depuis de longues années, sa réputation a franchi nos frontières hexagonales."
                            },
                            {
                                "example_id": "2b2ca7b3-2ddb-4f6e-96ed-273736549f43",
                                "sense_id": "fd2bb5f9-57b3-3157-b77e-cf587617ba74",
                                "text": "À l’approche de la nouvelle saison du jeu, Julien Magne, directeur général d’Adventure Line Productions (ALP), détaille les défis environnementaux, les critères de casting, et dévoile les secrets d’un succès qui dure depuis plus de deux décennies."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "47cafa3d-0b7c-37da-a07c-5481d5fc2b1f",
                "word": "magne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "59b60cd8-4868-4ee4-8e9f-6a656ca6ba96",
                        "entry_id": "47cafa3d-0b7c-37da-a07c-5481d5fc2b1f",
                        "tags": [
                            "plural"
                        ],
                        "form": "magnes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca42a404-e41f-337d-ad62-f0d578824741",
                        "entry_id": "47cafa3d-0b7c-37da-a07c-5481d5fc2b1f",
                        "glosses": [
                            "Manière, savoir-vivre."
                        ],
                        "tags": [
                            "dated",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "6adc663c-fcaa-4960-9f28-f33f47a7f8c1",
                                "sense_id": "ca42a404-e41f-337d-ad62-f0d578824741",
                                "text": "Qu’est-ce que tu as à nous dire ? Allez, jaspine, et ne fais pas de magnes !"
                            },
                            {
                                "example_id": "defdb17a-2c87-4047-b375-e0afdbe4989e",
                                "sense_id": "ca42a404-e41f-337d-ad62-f0d578824741",
                                "text": "Les gonzes me suivent et voilà les magnes et les giries avec Lange, le patron de la boîte : tout ça rapport à la police et rapport au prix."
                            },
                            {
                                "example_id": "77a1a7ad-2bd7-487c-86b5-05f1fb7c6e09",
                                "sense_id": "ca42a404-e41f-337d-ad62-f0d578824741",
                                "text": "Clo-Clo m’annonce que mon beau-frère accepte de venir dîner avec moi, ce soir. Quel honneur ! Et ce qu’ils en font des magnes pour taper les gens !"
                            },
                            {
                                "example_id": "78f1069a-b12c-4d77-859e-2572a473bf05",
                                "sense_id": "ca42a404-e41f-337d-ad62-f0d578824741",
                                "text": "Elle se laisse aller en douceur et, sans faire de magnes, me colle ses bras autour du cou."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c46c7c8-adfd-31db-9dfe-fbdae9eff86f",
                        "entry_id": "47cafa3d-0b7c-37da-a07c-5481d5fc2b1f",
                        "glosses": [
                            "Femme ayant enfanté des jumeaux."
                        ],
                        "tags": [
                            "Cameroun"
                        ],
                        "examples": [
                            {
                                "example_id": "e11d7864-b7eb-483f-ad7c-f74c8682acda",
                                "sense_id": "4c46c7c8-adfd-31db-9dfe-fbdae9eff86f",
                                "text": "En pays Bamiléké, la magne, c'est-à-dire la mère des jumeaux, est considérée comme une femme bénie de Dieu et investie d’une mission de paix."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
