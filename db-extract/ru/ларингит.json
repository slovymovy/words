                                        "glosses": [
                                            "An inflammation of the larynx, typically resulting in hoarseness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa73d205-4874-4ce4-863c-d8bbc7d0a430",
                                                "sense_id": "bbeb5b18-a4b3-320b-b000-3a6848e672e5",
                                                "text": "The moment had come for the honeyed word. I lowered my voice to a confidential murmur, but on her inquiring if I had laryngitis raised it again."
                                            }
