                "senses": [
                    {
                        "sense_id": "0cc3c4b1-8cb6-3849-9cf9-ed1bb4ba0ba2",
                        "entry_id": "4ae70c26-2277-30fc-9c89-f6b94c44162d",
                        "glosses": [
                            "Devenir riquiqui, rapetisser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72f4e0b-ae23-4d6a-9f0b-53192f4d4cb7",
                                "sense_id": "0cc3c4b1-8cb6-3849-9cf9-ed1bb4ba0ba2",
                                "text": "Depuis le printemps dernier, le cryptovirus a poussé un peu partout. Puis rapetissé. Puis repoussé de partout. Le confinement aussi. Espace vital zéro. Puis augmenté. Puis riquiquité."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ecc80f5-8bdb-34ea-8562-373046522e24",
                        "entry_id": "4ae70c26-2277-30fc-9c89-f6b94c44162d",
                        "glosses": [
                            "Rendre riquiqui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa70146b-c26a-4a0b-aaf0-3951df75573c",
                                "sense_id": "5ecc80f5-8bdb-34ea-8562-373046522e24",
                                "text": "D'un autre côté, vu que tu vises des couleurs très foncées, tu peux peut-être y aller avec la main lourde côté teinture... mais en faisant attention à la température pour ne pas te retrouver avec un truc tout riquiquité mais noir !"
                            },
                            {
                                "example_id": "c1813013-6414-4384-8e34-af57c393126d",
                                "sense_id": "5ecc80f5-8bdb-34ea-8562-373046522e24",
                                "text": "La voilà toute riquiquitée.."
                            }
                        ]
