{
    "word_family": [
        "precise",
        "precisely",
        "preciseness",
        "imprecision"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                    "sense_definition": "The quality or state of being exact, accurate, and detailed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon performed the operation with great <w>precision</w> to avoid damaging any nerves.",
                            "target_lang_translations": {
                                "ru": "Хирург провел операцию с большой <w>точностью</w>, чтобы избежать повреждения нервов."
                            }
                        },
                        {
                            "text": "The clock was built with mathematical <w>precision</w> to ensure it never lost a second.",
                            "target_lang_translations": {
                                "ru": "Часы были изготовлены с математической <w>точностью</w>, чтобы они не отставали ни на секунду."
                            }
                        }
                    ],
                    "synonyms": [
                        "exactitude",
                        "nicety"
                    ],
                    "antonyms": [
                        "inaccuracy",
                        "vagueness"
                    ],
                    "common_phrases": [
                        "mathematical precision",
                        "surgical precision",
                        "great precision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние точности, аккуратности и детальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точность",
                                "target_lang_sense_clarification": "соответствие образцу или факту"
                            },
                            {
                                "target_lang_word": "четкость",
                                "target_lang_sense_clarification": "ясность и выверенность"
                            },
                            {
                                "target_lang_word": "аккуратность",
                                "target_lang_sense_clarification": "тщательность исполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                    "sense_definition": "The ability of a measurement or process to be reproduced consistently with the same results.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In scientific experiments, high <w>precision</w> is necessary to ensure that results are repeatable.",
                            "target_lang_translations": {
                                "ru": "В научных экспериментах необходима высокая <w>точность</w>, чтобы гарантировать повторяемость результатов."
                            }
                        },
                        {
                            "text": "The <w>precision</w> of the instrument allowed the researchers to get the same reading every time.",
                            "target_lang_translations": {
                                "ru": "<w>Точность</w> прибора позволила исследователям каждый раз получать одни и те же показания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high precision",
                        "measurement precision"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность измерения или процесса последовательно воспроизводиться с теми же результатами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точность",
                                "target_lang_sense_clarification": "воспроизводимость результатов"
                            },
                            {
                                "target_lang_word": "прецизионность",
                                "target_lang_sense_clarification": "техническая повторяемость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c38040-7559-3d64-8d19-6d8f8519acfa",
                    "sense_definition": "The number of significant digits or decimal places to which a value is reliably measured.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer calculates the value of pi to a <w>precision</w> of fifty decimal places.",
                            "target_lang_translations": {
                                "ru": "Компьютер вычисляет значение числа пи с <w>точностью</w> до пятидесяти знаков после запятой."
                            }
                        },
                        {
                            "text": "Double-precision floating-point numbers provide more <w>precision</w> than single-precision ones.",
                            "target_lang_translations": {
                                "ru": "Числа с плавающей запятой двойной <w>точности</w> обеспечивают большую точность, чем числа с одинарной точностью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "double precision",
                        "decimal precision"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество значащих цифр или десятичных знаков, до которых надежно измеряется значение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точность",
                                "target_lang_sense_clarification": "количество знаков после запятой"
                            },
                            {
                                "target_lang_word": "разрядность",
                                "target_lang_sense_clarification": "в контексте вычислений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                    "sense_definition": "Designed for or capable of extremely exact measurement or operation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory is equipped with <w>precision</w> instruments for analyzing chemical samples.",
                            "target_lang_translations": {
                                "ru": "Лаборатория оснащена <w>прецизионными</w> инструментами для анализа химических проб."
                            }
                        },
                        {
                            "text": "Engineers use <w>precision</w> tools to manufacture the tiny components of a smartphone.",
                            "target_lang_translations": {
                                "ru": "Инженеры используют <w>высокоточные</w> инструменты для изготовления крошечных компонентов смартфона."
                            }
                        }
                    ],
                    "common_phrases": [
                        "precision instruments",
                        "precision tools",
                        "precision engineering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для чрезвычайно точного измерения или работы или способный на них."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прецизионный",
                                "target_lang_sense_clarification": "высокоточный (о приборах)"
                            },
                            {
                                "target_lang_word": "высокоточный",
                                "target_lang_sense_clarification": "обладающий высокой степенью точности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                    "sense_definition": "Characterized by or executed with high accuracy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker scored with a <w>precision</w> volley that flew right into the corner of the net.",
                            "target_lang_translations": {
                                "ru": "Нападающий забил гол <w>точным</w> ударом с лета прямо в угол ворот."
                            }
                        },
                        {
                            "text": "The military carried out a <w>precision</w> strike to minimize damage to the surrounding area.",
                            "target_lang_translations": {
                                "ru": "Военные нанесли <w>точечный</w> удар, чтобы минимизировать ущерб окружающей территории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "precision strike",
                        "precision bombing",
                        "precision volley"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся или выполненный с высокой точностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "точный",
                                "target_lang_sense_clarification": "выверенный и аккуратный"
                            },
                            {
                                "target_lang_word": "выверенный",
                                "target_lang_sense_clarification": "тщательно подготовленный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}