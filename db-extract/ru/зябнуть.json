                        "glosses": [
                            "разг. ощущать холод, страдать от холода"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1d90fe87-a17b-369d-896f-ab38180e76d4",
                        "entry_id": "6318f77d-6594-3898-a954-bed7717fe2eb",
                        "glosses": [
                            "частично утрачивать чувствительность из-за чрезмерного охлаждения"
                        ],
                        "tags": [
                            "о части тела"
                        ],
                        "examples": [
                            {
                                "example_id": "4147bb69-f50c-472e-a841-c48e06778488",
                                "sense_id": "1d90fe87-a17b-369d-896f-ab38180e76d4",
                                "text": "Был конец сентября; помню, что я вдруг почувствовал холодный воздух и у меня начали зябнуть кисти рук, не закрытые оттянувшимися назад рукавами."
                            }
                        ]
                    },
                    {
                        "sense_id": "0052356a-ed42-3a9c-a830-ab03a5cd2bfb",
                        "entry_id": "6318f77d-6594-3898-a954-bed7717fe2eb",
                        "glosses": [
                            "· повреждаться от холода, вымерзать"
                        ],
                        "tags": [
                            "о растениях"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b34cdbb-abb4-4491-a4fb-35eee1ef9be0",
                        "source_entry_id": "6318f77d-6594-3898-a954-bed7717fe2eb",
                        "target_lang_word": "frösteln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frösteln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "604b2384-87e0-3e64-b590-91dc4d04015c",
                                        "entry_id": "4dd8e33d-f004-3fab-8b3b-ff6c82218f0c",
                                        "glosses": [
                                            "deutlich ein Kältegefühl empfinden, weil es nicht warm genug ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82753371-793c-4c23-9a65-186ffb29c42a",
                                                "sense_id": "604b2384-87e0-3e64-b590-91dc4d04015c",
                                                "text": "„Ganser fröstelt leicht in seinem Lederblouson. Das freie Gelände des angrenzenden Landschaftsschutzgebietes erlaubt dem Wind ungehindert, seine wilde Kraft zu entfalten.“"
                                            },
                                            {
                                                "example_id": "7a24706c-b7c0-48f1-b1e4-dbdc8f1525ef",
                                                "sense_id": "604b2384-87e0-3e64-b590-91dc4d04015c",
                                                "text": "Mich fröstelt, können Sie bitte die Wollstola für mich holen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c2195900-985b-34e0-8ff1-d3f327668f37",
                                        "entry_id": "4dd8e33d-f004-3fab-8b3b-ff6c82218f0c",
                                        "glosses": [
                                            "ein Gefühl der Kälte empfinden, das einen schaudern lässt, dies durch zum Beispiel Furcht oder Abscheu ausgelöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9383b804-f790-4ff1-b8dd-8e742fbf013b",
                                                "sense_id": "c2195900-985b-34e0-8ff1-d3f327668f37",
                                                "text": "„Foday fröstelt, seine Stirn ist schweißbedeckt, seine Atmung flach und angestrengt. Seine Augen sind offen, starr, auf Kai gerichtet.“"
                                            },
                                            {
                                                "example_id": "5e5ce9bb-47fa-4516-b486-f3629d0b025a",
                                                "sense_id": "c2195900-985b-34e0-8ff1-d3f327668f37",
                                                "text": "Ihr eiskalter Blick trifft ihn und lässt ihn frösteln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "014c573a-4191-4bd8-9bf2-c2c349c5aae8",
                        "source_entry_id": "6318f77d-6594-3898-a954-bed7717fe2eb",
                        "target_lang_word": "avoir froid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2847daa4-6e36-4c8f-ab57-4d59d0dbe7a8",
                        "source_entry_id": "6318f77d-6594-3898-a954-bed7717fe2eb",
                        "target_lang_word": "geler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e98d2ecd-a73e-3448-9e6c-45fe3c2dfa31",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Durcir, rendre solide par le froid, transformer en glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a05aa6d9-252c-4180-a5a5-a0ad358eded3",
                                                "sense_id": "e98d2ecd-a73e-3448-9e6c-45fe3c2dfa31",
                                                "text": "Moi, je porte en mon sein joyeux un beau jardin tout parfumé que l’été ne peut brûler, que l’automne ne peut flétrir, que l’hiver ne peut geler."
                                            },
                                            {
                                                "example_id": "b3c71249-7b6c-41c2-9af3-ee6049dfa132",
                                                "sense_id": "e98d2ecd-a73e-3448-9e6c-45fe3c2dfa31",
                                                "text": "Le froid a gelé l’eau du bassin. Il fait un si grand froid que l’huile se gèle dans la bouteille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79bfb123-5d42-3bb7-b9f6-7cc7f5ac9b3c",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Pénétrer par un froid excessif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "149895e7-7333-4eb2-80f3-81600977da7a",
                                                "sense_id": "79bfb123-5d42-3bb7-b9f6-7cc7f5ac9b3c",
                                                "text": "Le froid lui gela les doigts, le bout des oreilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a34f4d3-8a68-3579-8c7c-fc9bc6772a2a",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Détériorer les membres par le froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a0bc05-d37f-4280-9350-aa1f6997e92d",
                                                "sense_id": "0a34f4d3-8a68-3579-8c7c-fc9bc6772a2a",
                                                "text": "Il a eu les pieds et les mains gelées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f94d21aa-fbc3-3781-92f0-49b040338051",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Endommager les arbres fruitiers, surtout lorsqu’ils sont en boutons ou en fleurs, par le froid."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f001119b-afcc-4361-99b2-34989f3d90f6",
                                                "sense_id": "f94d21aa-fbc3-3781-92f0-49b040338051",
                                                "text": "Le froid a gelé mes vignes. Tous les poiriers ont été gelés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc4bf57f-0851-38ba-9221-7e53ee7f3e73",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Faire souffrir du froid."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af311daf-f701-4837-aed8-8ff209e171e3",
                                                "sense_id": "cc4bf57f-0851-38ba-9221-7e53ee7f3e73",
                                                "text": "L’air qui vient par cette porte nous gèle. Vous avez les mains si froides que vous me gelez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efcb77f7-d539-3c87-8b1f-d8e8ffc492f6",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Avoir un accueil qui est extrêmement froid."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ee2b5a-b052-4bb3-a894-e0c5a21caf83",
                                                "sense_id": "efcb77f7-d539-3c87-8b1f-d8e8ffc492f6",
                                                "text": "Cet homme gèle ceux qui l’abordent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "287b7286-7bff-38fb-9dd5-bdb26d2b0aa4",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Bloquer un processus."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31db5612-10aa-4d0a-be10-4821c6b729bc",
                                                "sense_id": "287b7286-7bff-38fb-9dd5-bdb26d2b0aa4",
                                                "text": "Il soutient les efforts d’Antonio Guterres, le secrétaire général de l’ONU, pour geler les combats autour de la centrale nucléaire ukrainienne de Zaporijia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e74ec55-a93a-3104-8815-d6506bb2360b",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "être défoncé, être drogué."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a99971f-39db-465f-9ae7-0b0f1eb35ed9",
                                                "sense_id": "6e74ec55-a93a-3104-8815-d6506bb2360b",
                                                "text": "Il a tant fumé de cannabis qu'il est totalement gelé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48a570a3-e927-3d77-9200-eda920e5f974",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Se durcir par le froid, ou subir l’action du froid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881fae85-6ab7-41db-9904-902e40007826",
                                                "sense_id": "48a570a3-e927-3d77-9200-eda920e5f974",
                                                "text": "Un rude hiver s’est abattu sur la campagne bourguignonne : les quelques arpents de vigne qui font vivre la famille ont gelé."
                                            },
                                            {
                                                "example_id": "b7ecd4a0-7a52-44e0-ac6b-bb00a870686c",
                                                "sense_id": "48a570a3-e927-3d77-9200-eda920e5f974",
                                                "text": "Vous ne gèlerez pas cet hiver, mes mignons…' — (Françoise Bourdin, Dans les pas d’Ariane, Belfond, 2011, chapitre 5)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9636e0d0-de47-399e-a688-0dbf49eee87d",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "- faire plus froid que 0 ᵒC."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02a282ed-2b93-484c-b730-c9b7b757a924",
                                                "sense_id": "9636e0d0-de47-399e-a688-0dbf49eee87d",
                                                "text": "J’ai grimpé avec le pilote à mon poste dans les barres de perroquet ; il gelait et nous remontions vers le Nord, les voiles serrées, contre un vent coupant et froid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "014aeb93-7baf-3d6b-9d80-902a509a3367",
                                        "entry_id": "cd1c94d8-68a9-3584-836b-7134f0716bca",
                                        "glosses": [
                                            "Avoir extrêmement froid, subir une sensation de froid intense."
                                        ],
                                        "tags": [
                                            "common",
                                            "hyperbole",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e9b240-83ff-401d-83ac-e4dac52582e6",
                                                "sense_id": "014aeb93-7baf-3d6b-9d80-902a509a3367",
                                                "text": "Cette chambre est si froide qu’on y gèle."
                                            },
                                            {
                                                "example_id": "7d8faffd-2ef1-4f9f-8a1f-cc28f7064567",
                                                "sense_id": "014aeb93-7baf-3d6b-9d80-902a509a3367",
                                                "text": "Ma phrase était pourtant remarquablement stupide : on gelait, en réalité, dans cet autocar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
