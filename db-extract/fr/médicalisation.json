                "forms": [
                    {
                        "form_id": "bb49e73a-cbad-4bc4-9b6f-ba2af6d19b54",
                        "entry_id": "ee4ab973-6ef5-3277-a1bf-6a7f0cf0cd04",
                        "tags": [
                            "plural"
                        ],
                        "form": "médicalisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "637fb358-bdf5-36e5-8a19-3d0c97799ab6",
                        "entry_id": "ee4ab973-6ef5-3277-a1bf-6a7f0cf0cd04",
                        "glosses": [
                            "Action de médicaliser, de confier quelque chose aux soins de la médecine, de donner un caractère médical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36bfbc8-f077-4abb-a6b6-6eb754a66757",
                                "sense_id": "637fb358-bdf5-36e5-8a19-3d0c97799ab6",
                                "text": "Telle une déferlante, la médicalisation de la mer refoulera hors des usages courants la balnéophilie marginale de ces précurseurs indisciplinés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8d3c479-a361-4a2b-acfa-d12a51564db1",
                        "source_entry_id": "ee4ab973-6ef5-3277-a1bf-6a7f0cf0cd04",
                        "source_sense_id": "637fb358-bdf5-36e5-8a19-3d0c97799ab6",
                        "target_lang_word": "medizinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medizinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                        "entry_id": "14989a57-9607-3740-b168-b3689081171a",
                                        "glosses": [
                                            "die Medizin als Wissenschaft und Heilkunst betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84cd135-899a-44bb-9b81-8f956e81a471",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "Sie sollten sich medizinisch behandeln lassen."
                                            },
                                            {
                                                "example_id": "cd82231d-8da8-4c27-a32a-3b8de8c2151c",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "„Ob in Brennstoffzellen, zur medizinischen Diagnostik oder Produktion neuer Materialien und Energieträger — Katalysatoren haben ein enormes Einsatzpotenzial.“"
                                            },
                                            {
                                                "example_id": "b4845f60-2359-43b6-877e-31f63d8e20e0",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            },
                                            {
                                                "example_id": "742417d2-a904-4d4b-ad38-99359c620efd",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "„Wohl keine andere Stadt in Deutschland hat ein so breit gefächertes medizinisches Angebot wie Berlin.“"
                                            },
                                            {
                                                "example_id": "b865c55a-e477-45b7-abfa-5073b4bfe04a",
                                                "sense_id": "39ccb23d-e0e3-3779-bf20-7491520fde59",
                                                "text": "Zwar hat jeder Mensch - mit oder ohne Aufenthaltsstatus - in akuten Notlagen Anspruch auf medizinische Versorgung. Doch in Deutschland verpflichtet das Ausländergesetz öffentliche Stellen wie Sozialämter oder Krankenhäuser dazu, Menschen ohne Papiere sofort der Ausländerbehörde zu melden - für illegale Einwanderer kann der Gang ins städtische Krankenhaus deshalb tatsächlich mit der Ausweisung enden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc968ab8-0016-3f03-a08d-c14859a0374a",
                                        "entry_id": "14989a57-9607-3740-b168-b3689081171a",
                                        "glosses": [
                                            "unter Berücksichtigung der Medizin hergestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e95438a-b4dc-41e5-9664-909cbaef5e51",
                                                "sense_id": "bc968ab8-0016-3f03-a08d-c14859a0374a",
                                                "text": "Offensichtlich wirkte sie durch ihre rote Farbe als medizinische Zahncreme unglaubwürdig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f2dfed7-06e4-48e7-9feb-fc8a03d28856",
                        "source_entry_id": "ee4ab973-6ef5-3277-a1bf-6a7f0cf0cd04",
                        "source_sense_id": "637fb358-bdf5-36e5-8a19-3d0c97799ab6",
                        "target_lang_word": "Betreuung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betreuung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                        "entry_id": "cd6e522f-b806-371c-89c4-565055758b79",
                                        "glosses": [
                                            "das Aufpassen und Helfen von jemandem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2feb8237-b24a-4953-97cd-5f804f1cf654",
                                                "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                                "text": "[…] in der gesellschaftlichen und politischen Debatte in Deutschland spielen frühkindliche Bildung und Betreuung bislang noch eine untergeordnete Rolle."
                                            },
                                            {
                                                "example_id": "eb3b935f-abd0-4058-83ef-37593caf89f9",
                                                "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                                "text": "„Ziel unserer Betreuung ist, den Schüler in einem überschaubaren Zeitraum aus seiner negativen Lernstruktur zu befreien und ihn so weit zu bringen, daß er imstande ist, selbständig zu lernen.“"
                                            },
                                            {
                                                "example_id": "ae89252e-521c-4075-b3a7-1b81c32c384b",
                                                "sense_id": "f57f0999-d4f7-3304-a0f5-3bffcdb9d342",
                                                "text": "„Bei der Betreuung des wissenschaftlichen Nachwuchses verhielt Einstein sich vorbildlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0414b0c-b907-3a96-b477-a8a03a09208b",
                                        "entry_id": "cd6e522f-b806-371c-89c4-565055758b79",
                                        "glosses": [
                                            "Person, die jemanden betreut (nach [1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4fef0af-8ae7-42af-8ac8-8a856f9a422e",
                                                "sense_id": "e0414b0c-b907-3a96-b477-a8a03a09208b",
                                                "text": "„In Kinderheimen sei die Lage katastrophal, berichteten Helfer und Experten. Viele obdachlose Kinder seien ohne jegliche Betreuung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9ce93180-7211-32c6-a43a-cc1b82d75ab0",
                                        "entry_id": "cd6e522f-b806-371c-89c4-565055758b79",
                                        "glosses": [
                                            "gerichtlich angeordnete Vertretung (insbesondere im Rechtsverkehr) und Hilfe (wie [1]) für jemanden, der „seine Angelegenheiten ganz oder teilweise nicht besorgen“ kann (Deutschland: § 1896 BGB)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a64e358-d067-4033-840e-a3cb8f49999a",
                                                "sense_id": "9ce93180-7211-32c6-a43a-cc1b82d75ab0",
                                                "text": "„Ein Betreuer darf nur für Aufgabenkreise bestellt werden, in denen die Betreuung erforderlich ist.“ (§ 1896 BGB)"
                                            },
                                            {
                                                "example_id": "650bd096-6fce-4c43-ab79-380c685b73b0",
                                                "sense_id": "9ce93180-7211-32c6-a43a-cc1b82d75ab0",
                                                "text": "„Für den Betreuungsrichter bedeutet dies, dass er bestrebt sein sollte, die Betreuungen, die er dem einzelnen Berufsbetreuer überträgt, entsprechend zu ‚mischen‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
