                            "prepositional"
                        ],
                        "form": "за́лпе"
                    },
                    {
                        "form_id": "0aba18bb-a6c5-4855-b208-d250841947ad",
                        "entry_id": "55c9d487-a11d-3f5d-bbc5-b92ba7a191bb",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "за́лпах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "427b7515-13ac-3b7d-95b9-fe047bf84ec3",
                        "entry_id": "55c9d487-a11d-3f5d-bbc5-b92ba7a191bb",
                        "glosses": [
                            "одновременный выстрел по команде из нескольких ружей, орудий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15abcf10-3324-4fdc-af56-a91061ae304a",
                                "sense_id": "427b7515-13ac-3b7d-95b9-fe047bf84ec3",
                                "text": "На берегу Днепра под Оршей батарея капитана Флерова дала первый залп из БМ-13 — боевых машин реактивной артиллерии."
                            },
                            {
                                "example_id": "cbe1ae01-dca5-42ef-bf29-71d1b9ba5811",
                                "sense_id": "427b7515-13ac-3b7d-95b9-fe047bf84ec3",
                                "text": "Ударил второй залп, и началась стрельба по всему лесу — уже не залпами, а лихорадочными и неприцельными одиночными выстрелами, — и поручик сразу вскочил, поняв, что рота его яростно отстреливается от наседающих турок."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa2ca96b-662e-3820-bdbe-4eac7179cafa",
                        "entry_id": "55c9d487-a11d-3f5d-bbc5-b92ba7a191bb",
                        "glosses": [
                            "снаряды, выпущенные одновременно, в ходе залпа [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef702ad4-51eb-4c7a-b756-a043e10a1f3b",
                                "sense_id": "fa2ca96b-662e-3820-bdbe-4eac7179cafa",
                                "text": "Солдат с радостью кинулся выполнять поручение, в это время далеко за бугром хрипло, немазанно заскрипело, и едва солдат успел броситься под машину, а майор Проскуряков выскочить из «студебеккера», как на колонну обрушился залп шестиствольных минометов."
                            }
                        ]
                    },
                    {
                        "sense_id": "00594429-2ca3-3e78-8717-b0a7f77a83b0",
                        "entry_id": "55c9d487-a11d-3f5d-bbc5-b92ba7a191bb",
                        "glosses": [
                            "перен. массовое одновременное появление, проявление чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceefb3e3-4533-4687-a27e-451b35a7d452",
                                "sense_id": "00594429-2ca3-3e78-8717-b0a7f77a83b0",
                                "text": "Последовал второй залп смеха, причем на этот раз громче всех смеялись друзья и ставленники Левенвольде."
                            },
                            {
                                "example_id": "827b4802-d89a-4d6e-9e02-f6fe9622b92d",
                                "sense_id": "00594429-2ca3-3e78-8717-b0a7f77a83b0",
                                "text": "Директор управления поначалу пробовал перевести разговор с обсуждения грехов своей шоферни на убийственную для общественного транспорта систему льгот, но это вызвало такой ответный залп ненависти, что тот счел за лучшее заткнуться."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8db94823-52f1-4b76-9eed-fdb28d10c2c9",
                        "source_entry_id": "55c9d487-a11d-3f5d-bbc5-b92ba7a191bb",
                        "source_sense_description": "выстрел",
                        "target_lang_word": "salvo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salvo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4f22fad-e40c-3b3e-8764-a67f5645a998",
                                        "entry_id": "4e21348b-94d8-3858-b1c1-e2ffe9c30bd1",
                                        "glosses": [
                                            "An exception; a reservation; an excuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2826451-bb82-4b81-90df-0902d29bf502",
                                                "sense_id": "a4f22fad-e40c-3b3e-8764-a67f5645a998",
                                                "text": "1649, Charles I of England (attributed), Eikon Basilike\nThey admit […] salvos, cautions, and reservations."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "salvo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adeef5f7-5b5d-30f1-bdaf-0500e3364e27",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "A concentrated fire from pieces of artillery, as in endeavoring to make a break in a fortification; a volley."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12cda06a-3ac5-303b-b3a7-67ff04727e81",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "A salute paid by a simultaneous, or nearly simultaneous, firing of a number of cannon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e13cc3f-be6b-4de8-9134-57aa7200298a",
                                                "sense_id": "12cda06a-3ac5-303b-b3a7-67ff04727e81",
                                                "text": "“Regard not that, my brother,” answered Magdalen Græme; “the first successors of Saint Peter himself, were elected not in sunshine but in tempests—not in the halls of the Vatican, but in the subterranean vaults and dungeons of Heathen Rome—they were not gratulated with shouts and salvos of cannon-shot and of musquetry, and the display of artificial fire—no, my brother—but by the hoarse summons of Lictors and Prætors, who came to drag the Fathers of the Church to martyrdom.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1abda2-7b49-3c08-a173-47d818f7eca5",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "Any volley, as in an argument or debate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60eba688-1466-47f8-9ab0-72ff46995678",
                                                "sense_id": "2a1abda2-7b49-3c08-a173-47d818f7eca5",
                                                "text": "It was an impressive opening salvo from the Baggies, especially for a side that have made a poor beginning to what has been an admittedly tough start to their campaign."
                                            },
                                            {
                                                "example_id": "dd30a479-4e5d-4739-8f57-96ee5eeb78dd",
                                                "sense_id": "2a1abda2-7b49-3c08-a173-47d818f7eca5",
                                                "text": "Together, Johnson's plans mean that the clashes in parliament and the Supreme Court may be only the opening salvos in what promises to be the biggest constitutional storm in centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa2bf32-f19f-36df-8e24-b2b3d9aaa775",
                                        "entry_id": "2ecb00f6-d95d-3a72-8650-310c3a7aaa16",
                                        "glosses": [
                                            "The combined cheers of a crowd."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "salvo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74976755-b9a7-33d1-91ea-38b87c8af8f4",
                                        "entry_id": "1e76f4c1-34f6-3ec6-bcd7-705d393780fe",
                                        "glosses": [
                                            "To discharge weapons in a salvo."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dadcec01-9f27-41ed-903c-f84e841a722c",
                        "source_entry_id": "55c9d487-a11d-3f5d-bbc5-b92ba7a191bb",
                        "source_sense_description": "выстрел",
                        "target_lang_word": "volley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea63b92-44d3-361c-8d71-cf06d0a65941",
                                        "entry_id": "ca5a61ef-13dc-3334-a86f-4ea24e7b4944",
                                        "glosses": [
                                            "The simultaneous firing of a number of missiles or bullets; the projectiles so fired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccee40ab-6509-4cc9-8781-3b6b4a493e48",
                                                "sense_id": "6ea63b92-44d3-361c-8d71-cf06d0a65941",
                                                "text": "Fiery darts in flaming volies flew."
                                            },
                                            {
                                                "example_id": "81e13634-2561-4f2d-bc4f-5be566f7cee2",
                                                "sense_id": "6ea63b92-44d3-361c-8d71-cf06d0a65941",
                                                "text": "Each volley tells that thousands cease to breathe."
                                            },
                                            {
                                                "example_id": "4d8b876d-9ab4-46ce-b6d8-fbf082e0ed95",
                                                "sense_id": "6ea63b92-44d3-361c-8d71-cf06d0a65941",
                                                "text": "It was by his order the shattered leading company flung itself into the houses when the Sin Verguenza were met by an enfilading volley as they reeled into the calle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7525d64-aea7-326a-9e97-a0daf7359825",
                                        "entry_id": "ca5a61ef-13dc-3334-a86f-4ea24e7b4944",
                                        "glosses": [
                                            "A burst or emission of many things at once."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bcafc32-674b-4208-af0c-c3085a82452b",
                                                "sense_id": "e7525d64-aea7-326a-9e97-a0daf7359825",
                                                "text": "a volley of words"
                                            },
                                            {
                                                "example_id": "af959cfd-320d-4e7c-96e9-35f01542eb1b",
                                                "sense_id": "e7525d64-aea7-326a-9e97-a0daf7359825",
                                                "text": "When we do speak at volley"
                                            },
                                            {
                                                "example_id": "ac4ab3e9-b790-44e4-8da4-0f3ba4b907d4",
                                                "sense_id": "e7525d64-aea7-326a-9e97-a0daf7359825",
                                                "text": "A whole volley of furious criticism was poured on the author [Alexander Pope] by those enemies whom his contempt had created, and his honest pride had justly disdained to propitiate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8c3e24a-fd9c-32ba-864b-72840dbf119c",
                                        "entry_id": "ca5a61ef-13dc-3334-a86f-4ea24e7b4944",
                                        "glosses": [
                                            "The flight of a ball just before it bounces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41f5b1c6-7123-32ad-9791-4ef01ff7aa6f",
                                        "entry_id": "ca5a61ef-13dc-3334-a86f-4ea24e7b4944",
                                        "glosses": [
                                            "A shot in which the ball is played before it hits the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
