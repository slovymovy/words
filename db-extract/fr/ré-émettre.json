                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1d797e8b-ebce-347b-ac13-afd8211b5566",
                        "entry_id": "a5bdb995-728e-3bff-8ea7-8fcf007d7611",
                        "glosses": [
                            "Émettre ce qui a été reçu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0ecbdd-a5d9-4387-823d-1a52fef35648",
                                "sense_id": "1d797e8b-ebce-347b-ac13-afd8211b5566",
                                "text": "Un atome de césium sous forme gazeuse à température ambiante peut ainsi être quasiment arrêté, à condition d’absorber et de ré-émettre environ 70 000 photons."
                            },
                            {
                                "example_id": "575d3fe2-3014-4eea-8993-4a5af60a8029",
                                "sense_id": "1d797e8b-ebce-347b-ac13-afd8211b5566",
                                "text": "Ceci permet, en intérieur, d’augmenter les chances de recevoir un signal, et donc d’éviter de devoir le ré-émettre."
                            }
                        ]
                    }
