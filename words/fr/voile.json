        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fe6ca9c2-73ab-3204-ae68-36dc0c38a797",
                    "sense_definition": "Grande pièce de toile solide fixée au gréement d'un navire pour capter le vent et le propulser.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nautisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine demande aux marins de hisser la grande <w>voile</w> dès le départ du port."
                        },
                        {
                            "text": "Le vent souffle si fort que la <w>voile</w> menace de se déchirer à tout moment."
                        }
                    ],
                    "common_phrases": [
                        "hisser la voile",
                        "border la voile",
                        "gonfler la voile"
                    ]
                },
                {
                    "sense_id": "38c26b4a-0861-374b-8122-daf1b4d54091",
