                                    {
                                        "sense_id": "86297190-8bed-3f57-965a-18824ef2825e",
                                        "entry_id": "cb8d6da6-d9be-348f-a8ea-40dbf5684930",
                                        "glosses": [
                                            "het op grote schaal kweken van planten die dienen om iets mooier te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0ed8004-52c1-429e-a5e4-de0ac81f16de",
                                                "sense_id": "86297190-8bed-3f57-965a-18824ef2825e",
                                                "text": "Agrarische producten zijn ook heel belangrijk voor de Nederlandse export, meldde CBS eerder. Zo staat sierteelt op plaats drie in de top tien van meest waardevolle exportproducten. Ook vlees, zuivel, groenten en aardappelen zijn terug te vinden in de top tien van exportproducten met de hoogste toegevoegde waarde."
                                            },
                                            {
                                                "example_id": "8459d21e-0792-4ebf-b58a-f2c34f31ec44",
                                                "sense_id": "86297190-8bed-3f57-965a-18824ef2825e",
                                                "text": "Momenteel verdient Nederland vooral veel geld aan de uitvoer van minerale brandstoffen, chemische producten, machines en vervoermiddelen. Sierteelt, zoals bloemen, planten, boomkwekerijproducten en bloembollen is in 2017 het enige landbouwproduct in de export top tien."
                                            },
                                            {
                                                "example_id": "1f812df6-8dd5-4208-8444-de698a0c7bcb",
                                                "sense_id": "86297190-8bed-3f57-965a-18824ef2825e",
                                                "text": "Greenpeace zet grote vraagtekens bij de eerder aangekondigde staatssteun voor de sierteelt en de fritesaardappelsector. Daar gaat 650 miljoen euro belastinggeld naartoe, “terwijl juist de sierteelt grootverbruiker is van gif en daarmee bijdraagt aan de natuurcrisis”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eaac7f8-b774-47b3-ac83-212e88f625cc",
                        "source_entry_id": "7651edf6-eb8f-305a-bc6c-9f0719df35a7",
