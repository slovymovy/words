                                "target_lang_word": "solemn entry",
                                "target_lang_sense_clarification": "ceremonial royal or official entrance"
                            },
                            {
                                "target_lang_word": "state entry",
                                "target_lang_sense_clarification": "ceremonial public arrival of a monarch"
                            }
                        ]
                    }
                }
            ]
        },
