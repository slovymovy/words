                                            {
                                                "example_id": "336ad927-a8f2-49ca-96d4-1a99bd88d71c",
                                                "sense_id": "c0ebd87d-46bd-3d01-a86d-b72cc7bda6b9",
                                                "text": "Andrea kenne ich noch aus Schulzeiten."
