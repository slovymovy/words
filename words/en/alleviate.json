{
    "word_family": [
        "alleviation",
        "alleviator",
        "alleviative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d9da881-a900-3355-ab51-f2260095c203",
                    "sense_definition": "To make a physical or emotional pain, or a difficult situation, less severe or easier to bear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reduce severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed a new medication to help <w>alleviate</w> the chronic pain in her lower back.",
                            "target_lang_translations": {
                                "ru": "Врач назначил новое лекарство, чтобы помочь <w>облегчить</w> хроническую боль в пояснице."
                            }
                        },
                        {
                            "text": "The government introduced several new measures to <w>alleviate</w> poverty in the most affected rural areas.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело несколько новых мер по <w>смягчению</w> проблемы бедности в наиболее пострадавших сельских районах."
                            }
                        }
                    ],
                    "synonyms": [
                        "allay",
                        "assuage",
                        "ease",
                        "mitigate",
                        "relieve"
                    ],
                    "antonyms": [
                        "aggravate"
                    ],
                    "common_phrases": [
                        "alleviate the pain",
                        "alleviate the symptoms",
                        "alleviate the stress",
                        "alleviate the suffering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать физическую или эмоциональную боль, либо трудную ситуацию менее тяжелой или более легкой для восприятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "делать менее тягостным или трудным"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "делать менее суровым или резким"
                            },
                            {
                                "target_lang_word": "уменьшать",
                                "target_lang_sense_clarification": "сокращать интенсивность или количество"
                            },
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "устранять симптом или состояние (например, боль или стресс)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b528c95c-c297-3587-9e3b-7f6d80295e56",
                    "sense_definition": "To reduce the total amount of a financial debt or burden by paying it down partially.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company used its quarterly profits to <w>alleviate</w> its long-term debt and improve its credit rating.",
                            "target_lang_translations": {
                                "ru": "Компания использовала свою квартальную прибыль, чтобы <w>сократить</w> долгосрочную задолженность и повысить свой кредитный рейтинг."
                            }
                        },
                        {
                            "text": "There are many different ways to <w>alleviate</w> financial debt if you manage your budget carefully.",
                            "target_lang_translations": {
                                "ru": "Существует много различных способов <w>облегчить</w> финансовое долговое бремя, если тщательно управлять своим бюджетом."
                            }
                        }
                    ],
                    "synonyms": [
                        "ease",
                        "mitigate"
                    ],
                    "antonyms": [
                        "aggravate"
                    ],
                    "common_phrases": [
                        "alleviate financial debt",
                        "alleviate the burden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшить общую сумму финансового долга или бремени путем его частичного погашения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчать",
                                "target_lang_sense_clarification": "уменьшать финансовое бремя"
                            },
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "уменьшать размер задолженности"
                            },
                            {
                                "target_lang_word": "смягчать",
                                "target_lang_sense_clarification": "делать долговую нагрузку менее тяжелой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}