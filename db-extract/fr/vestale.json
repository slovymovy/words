                                "target_senses": [
                                    {
                                        "sense_id": "d86f04c9-a2cf-3a6e-9383-2bb1f8e06f03",
                                        "entry_id": "b2937405-fe9e-3626-bbbf-066ba3b46ad7",
                                        "glosses": [
                                            "Of or pertaining to Vesta, the virgin goddess of the hearth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b28f2f1-d9f1-3708-b1be-5bad703492c8",
                                        "entry_id": "b2937405-fe9e-3626-bbbf-066ba3b46ad7",
                                        "glosses": [
                                            "Pure; chaste."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed64601-cf59-48c2-94c3-35fe8ddc39ed",
                                                "sense_id": "3b28f2f1-d9f1-3708-b1be-5bad703492c8",
                                                "text": "Does money fail?—come to my mint—coin paper,\nTill gold be at a discount, and ashamed\nTo show his bilious face, go purge himself,\nIn emulation of her vestal whiteness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vestal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0fd9b6f-1114-3b02-8285-70297b4423b2",
                                        "entry_id": "65667697-eabb-323b-a936-d33e7f522061",
                                        "glosses": [
                                            "A virgin consecrated to Vesta, and to the service of watching the sacred fire, which was to be perpetually kept burning upon her altar; a vestal virgin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "615ab5b0-b4d5-3a56-aa64-d883db6d3fd0",
                                        "entry_id": "65667697-eabb-323b-a936-d33e7f522061",
                                        "glosses": [
                                            "A female virgin; a woman who has never had sexual relations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33e85714-8e67-355e-b9fb-8ea7ad67ed7a",
