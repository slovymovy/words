                                        "entry_id": "11caf224-0a11-3407-a7f7-5c2a600b8965",
                                        "glosses": [
                                            "An emotional and physical intimate relationship which includes a common living place and which exists without legal or religious sanction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9c4576-71b8-4c75-8650-d0d7ff7e1ea0",
                                                "sense_id": "80a12ff2-895b-3114-90ce-3a56fca91e94",
                                                "text": "According to Greene, sodomy, gross indecency, adultery, cohabitation and repeated convictions for indecent exposure are all considered sex offenses in Michigan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64a3476-14d3-34b8-a755-53c10041a922",
                                        "entry_id": "11caf224-0a11-3407-a7f7-5c2a600b8965",
                                        "glosses": [
                                            "The act of living together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2444ce3-d94e-3cf9-b7a2-a1105bf5d86d",
                                        "entry_id": "11caf224-0a11-3407-a7f7-5c2a600b8965",
                                        "glosses": [
                                            "A place where two or more individuals reside together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2383b40b-9593-30cd-bc61-2d655b7518e6",
                                        "entry_id": "11caf224-0a11-3407-a7f7-5c2a600b8965",
                                        "glosses": [
                                            "The act of two species living together in the same habitat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c64958b-8368-3851-b847-307021d2acee",
                                        "entry_id": "11caf224-0a11-3407-a7f7-5c2a600b8965",
                                        "glosses": [
                                            "Cooperation between politicians of opposing political parties; especially, in France, between a President and Prime Minister."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e6666a-a2c7-4015-9e77-0af64c25ec40",
                                                "sense_id": "6c64958b-8368-3851-b847-307021d2acee",
                                                "text": "Commentators agreed that Mr Chirac's unusually aggressive remarks, followed by the equally fierce response of Mr Jospin's government, signalled the beginning of the end for the tense but so far civil \"cohabitation\" under which the two men have ruled France since 1997."
                                            },
                                            {
                                                "example_id": "7d323b0b-77e9-4820-af3f-2af073c82dbc",
                                                "sense_id": "6c64958b-8368-3851-b847-307021d2acee",
                                                "text": "She said: “I am respectful of institutions; I am not calling for institutional chaos. There will simply be a cohabitation.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
