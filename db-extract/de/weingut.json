                ],
                "senses": [
                    {
                        "sense_id": "9767dafb-705d-3c29-a9a8-c25605106a0f",
                        "entry_id": "b7081e21-b857-3463-b26a-ad03dac56bd2",
                        "glosses": [
                            "Betrieb, der Wein an- und ausbaut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b1381ab-38b8-400a-88cf-dc1e3bc40ff5",
                                "sense_id": "9767dafb-705d-3c29-a9a8-c25605106a0f",
                                "text": "Dieses Weingut ist für seine hervorragend ausgebauten Rotweine bekannt."
                            },
                            {
                                "example_id": "c9e93982-65d3-4230-810a-9d3bf22471d0",
                                "sense_id": "9767dafb-705d-3c29-a9a8-c25605106a0f",
                                "text": "„Auf Schloss Vollrads im Rheingau wurde schon im Jahr 1211 Wein verkauft - damit ist es eines der ältesten noch bestehenden Weingüter der Welt.“"
                            },
                            {
                                "example_id": "8c516da0-862a-4975-88ed-8202e681f0bf",
                                "sense_id": "9767dafb-705d-3c29-a9a8-c25605106a0f",
                                "text": "„Bei meinem letzten Besuch in Kapstadt hatte dieses Weingut noch nicht existiert – keine Reben, keine Fässer, kein Lebenszeichen außer dem Muhen der Kühe.\""
                            },
                            {
                                "example_id": "17166791-e01b-42ab-a573-771335b24397",
                                "sense_id": "9767dafb-705d-3c29-a9a8-c25605106a0f",
                                "text": "„Ein paar Weingüter haben hier ihre Verkaufs- und Probierstuben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
