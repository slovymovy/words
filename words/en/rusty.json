{
    "word_family": [
        "rust"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46f071aa-cddc-3fe0-a8c4-84f4eefe7022",
                    "sense_definition": "Covered with or corroded by rust.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "corrosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old bicycle was <w>rusty</w> after being left in the rain for years.",
                            "target_lang_translations": {
                                "ru": "Старый велосипед был <w>ржавым</w> после того, как простоял под дождем много лет."
                            }
                        },
                        {
                            "text": "He tried to open the <w>rusty</w> gate but the hinges were stuck.",
                            "target_lang_translations": {
                                "ru": "Он попытался открыть <w>ржавые</w> ворота, но петли заклинило."
                            }
                        }
                    ],
                    "synonyms": [
                        "corroded",
                        "oxidized"
                    ],
                    "common_phrases": [
                        "rusty gate",
                        "rusty nail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый ржавчиной или подвергшийся коррозии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ржавый",
                                "target_lang_sense_clarification": "о металле, покрытом коррозией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2e6f587-91bd-3f92-8702-533636e1f951",
                    "sense_definition": "Lacking recent practice or experience in a skill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have not played the piano in years and feel quite <w>rusty</w>.",
                            "target_lang_translations": {
                                "ru": "Я не играл на пианино много лет и чувствую, что совсем <w>потерял навыки</w>."
                            }
                        },
                        {
                            "text": "My French is a bit <w>rusty</w> because I have not spoken it lately.",
                            "target_lang_translations": {
                                "ru": "Мой французский немного <w>забылся</w>, потому что я в последнее время на нем не говорил."
                            }
                        }
                    ],
                    "synonyms": [
                        "out of practice"
                    ],
                    "common_phrases": [
                        "feel rusty",
                        "a bit rusty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утративший навыки из-за отсутствия практики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потерявший навыки",
                                "target_lang_sense_clarification": "о человеке, который давно не практиковался"
                            },
                            {
                                "target_lang_word": "забытый",
                                "target_lang_sense_clarification": "о навыке или языке, который стал хуже из-за отсутствия практики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5220d6-bdbc-3974-b64e-6a7cc574497c",
                    "sense_definition": "Having a reddish or reddish-brown color similar to rust.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn leaves turned a beautiful <w>rusty</w> shade of orange.",
                            "target_lang_translations": {
                                "ru": "Осенние листья приобрели красивый <w>ржаво-оранжевый</w> оттенок."
                            }
                        },
                        {
                            "text": "She wore a <w>rusty</w> coat that matched the color of the soil.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>ржаво-коричневое</w> пальто, которое подходило под цвет почвы."
                            }
                        }
                    ],
                    "synonyms": [
                        "reddish-brown"
                    ],
                    "common_phrases": [
                        "rusty color"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий красновато-коричневый цвет, напоминающий ржавчину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ржаво-коричневый",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "рыжеватый",
                                "target_lang_sense_clarification": "о цвете, близком к ржавому"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbecf098-ea89-3647-8bc4-3d753d1da40a",
                    "sense_definition": "Describing clothing that is worn out or shabby.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "shabby",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beggar wore a <w>rusty</w> black coat that had seen better days.",
                            "target_lang_translations": {
                                "ru": "Нищий был одет в <w>поношенное</w> черное пальто, которое знало лучшие времена."
                            }
                        },
                        {
                            "text": "He looked quite poor in his <w>rusty</w> old suit.",
                            "target_lang_translations": {
                                "ru": "Он выглядел довольно бедно в своем <w>потертом</w> старом костюме."
                            }
                        }
                    ],
                    "synonyms": [
                        "shabby",
                        "worn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Об одежде: изношенная, потрепанная."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поношенный",
                                "target_lang_sense_clarification": "об одежде"
                            },
                            {
                                "target_lang_word": "потертый",
                                "target_lang_sense_clarification": "об одежде, потерявшей вид"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ca4d069-6149-33af-b17c-1f4d23c571df",
                    "sense_definition": "Affected by the fungal plant disease known as rust.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wheat crop was <w>rusty</w> due to the damp weather conditions.",
                            "target_lang_translations": {
                                "ru": "Урожай пшеницы был <w>поражен ржавчиной</w> из-за влажных погодных условий."
                            }
                        },
                        {
                            "text": "Farmers must treat <w>rusty</w> plants to prevent the spread of the fungus.",
                            "target_lang_translations": {
                                "ru": "Фермеры должны обрабатывать <w>пораженные ржавчиной</w> растения, чтобы предотвратить распространение грибка."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пораженный грибковым заболеванием растений, называемым ржавчиной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пораженный ржавчиной",
                                "target_lang_sense_clarification": "о растениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47801de1-6360-37e2-b448-25dcda4302e3",
                    "sense_definition": "Discolored and having a rancid smell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rancid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rusty</w> bacon had been left out of the fridge for too long.",
                            "target_lang_translations": {
                                "ru": "Этот <w>прогорклый</w> бекон слишком долго пролежал вне холодильника."
                            }
                        },
                        {
                            "text": "Do not eat that <w>rusty</w> meat as it has clearly gone bad.",
                            "target_lang_translations": {
                                "ru": "Не ешь это <w>прогорклое</w> мясо, оно явно испортилось."
                            }
                        }
                    ],
                    "synonyms": [
                        "rancid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испорченный, имеющий прогорклый запах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогорклый",
                                "target_lang_sense_clarification": "об испорченном жире или продуктах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6074ce5b-c689-3e7c-9123-262b7e3f0a79",
                    "sense_definition": "A male given name.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Rusty</w> is coming over to help us move the furniture today.",
                            "target_lang_translations": {
                                "ru": "<w>Расти</w> придет сегодня, чтобы помочь нам переставить мебель."
                            }
                        },
                        {
                            "text": "I met a man named <w>Rusty</w> at the conference last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе на конференции я встретил человека по имени <w>Расти</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Расти",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acbc9b58-b185-3d4c-8359-9e38bb958732",
                    "sense_definition": "A firearm, especially one that is old or worn.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled an old <w>rusty</w> from his coat pocket during the fight.",
                            "target_lang_translations": {
                                "ru": "Во время драки он вытащил из кармана пальто старую <w>пушку</w>."
                            }
                        },
                        {
                            "text": "The criminal was caught carrying a <w>rusty</w> in the alleyway.",
                            "target_lang_translations": {
                                "ru": "Преступника поймали в переулке, когда он нес с собой <w>ствол</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gun",
                        "firearm"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in criminal or street slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Огнестрельное оружие, особенно старое или изношенное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушка",
                                "target_lang_sense_clarification": "сленговое название оружия"
                            },
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "криминальный сленг для обозначения пистолета"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}