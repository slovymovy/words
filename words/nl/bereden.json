                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de demonstratie werd de <w>bereden</w> politie ingezet om de orde te handhaven.",
