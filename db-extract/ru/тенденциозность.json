                "senses": [
                    {
                        "sense_id": "62fb4739-aca4-3a91-8bfa-a3619313632d",
                        "entry_id": "083d431b-9c46-3595-b11a-830871323813",
                        "glosses": [
                            "книжн. свойство по значению прилагательного тенденциозный; предвзятость, пристрастность, необъективность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bef13a0f-ba99-4caa-9b57-ba3bb62e39e9",
                                "sense_id": "62fb4739-aca4-3a91-8bfa-a3619313632d",
                                "text": "Литературе вредна не революционность, а тенденциозность — т. е. неискренность, родная сестра бездарности."
                            },
                            {
                                "example_id": "7c6f8637-fe0f-4f79-ac80-0830e9a09644",
                                "sense_id": "62fb4739-aca4-3a91-8bfa-a3619313632d",
                                "text": "Вот откуда рождается, вот откуда идёт, неизменно утверждая идеи партии, идеи Ленина, открытая партийная тенденциозность советского многонационального искусства."
                            }
                        ]
                    }
                ],
