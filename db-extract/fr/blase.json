                        ],
                        "examples": [
                            {
                                "example_id": "6c071917-59f8-4c1e-942f-5c13843162f2",
                                "sense_id": "ed52c5cc-c516-340a-a8a4-642d002337b2",
                                "text": "C’est quoi son blase? – Ch’ai pas.",
                                "translation": "Wat is zijn naam? – Weet ik niet."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fe16532-46f5-39af-a0f0-e9f636925434",
                        "entry_id": "5439085d-8d9b-3af0-8945-f331a76f525b",
                        "glosses": [
                            "neus, snufferd"
                        ],
                        "tags": [
