                                        "sense_id": "73ad6a26-94d8-3f5a-afa9-a8a24fc388c3",
                                        "entry_id": "9e1da1e3-27d8-3a02-9759-4cba67c733cf",
                                        "glosses": [
                                            "A fellow rival; a competitor; a rival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a04dc637-dd1f-4dc8-a3a9-04b2db877046",
                                                "sense_id": "73ad6a26-94d8-3f5a-afa9-a8a24fc388c3",
                                                "text": "So he that doth redeem her thence might wear\n Without corrival all her dignities:\n But out upon this half-facd fellowship!"
                                            },
                                            {
                                                "example_id": "bec2ddee-7e37-4d2e-b726-db2d680b6f6c",
                                                "sense_id": "73ad6a26-94d8-3f5a-afa9-a8a24fc388c3",
                                                "text": "Petronius calleth this paſſion [i.e., jealousy] amantium furioſam æmulationem, a furious emulation, and their ſymptomes are well expreſſed by Sʳ Ieffrey Chaucer in his firſt Canterbury tale. It will make the neareſt & deareſt friends fall out; they will endure al other things to be common, goods, lands, moneyes, participate of all other pleaſures, and take in good part any diſgraces, iniuries in another kind, but as Propertius well deſcribes it in an Elegie of his, in this they will ſuffer nothing, have no corriuals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccbd751a-fba6-3a1c-b322-4e0d1a6e3c2c",
                                        "entry_id": "9e1da1e3-27d8-3a02-9759-4cba67c733cf",
                                        "glosses": [
                                            "A companion."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95a1cfc8-6651-45a6-b332-fb3d42c6c07f",
                                                "sense_id": "ccbd751a-fba6-3a1c-b322-4e0d1a6e3c2c",
                                                "text": "The Prince of Wales, Lord John of Lancaster,\nThe noble Westmoreland, and warlike Blunt;\nAnd many more corrivals and dear men\nOf estimation and command in arms."
                                            }
                                        ]
                                    }
                                ]
                            },
