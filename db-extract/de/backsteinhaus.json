                "senses": [
                    {
                        "sense_id": "5d4bdee7-0c4e-36fb-b9b4-e93171ca7a19",
                        "entry_id": "15541d86-fc99-3b71-b282-c84a7db9e757",
                        "glosses": [
                            "Haus, dessen Außenwände aus Backsteinen bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52eb27af-4c88-4ac8-b08a-7a82515687f5",
                                "sense_id": "5d4bdee7-0c4e-36fb-b9b4-e93171ca7a19",
                                "text": "„In den Jahren 2001 bis 2002 wurde der ‚Bürotower‘ an der Hammer Straße als Glas- oder Metallkonstruktion inmitten eines Umfeldes von Backsteinhäusern gebaut.“"
                            },
                            {
                                "example_id": "b4014aca-d732-4d7e-b1bc-59fe5ee3ad6d",
                                "sense_id": "5d4bdee7-0c4e-36fb-b9b4-e93171ca7a19",
                                "text": "„Lange Reihen von eintönigen Backsteinhäusern wurden nur von dem grellen Schein und aufgedonnerten Glanz der Gasthäuser an der Ecke abgelöst.“"
                            },
                            {
                                "example_id": "1f0a47ab-7503-4df5-9623-a403199e0087",
                                "sense_id": "5d4bdee7-0c4e-36fb-b9b4-e93171ca7a19",
                                "text": "„Nach einer weiteren kleinen Ewigkeit parkte Ben in einer winzigen Parklücke am Rand einer Seitenstraße, gesäumt von roten Backsteinhäusern, deren strahlend weiße Zierleisten sich gegen den grauen Himmel abhoben.“"
                            },
                            {
                                "example_id": "f19d73fd-ad99-4179-bb33-9b5392bfe206",
                                "sense_id": "5d4bdee7-0c4e-36fb-b9b4-e93171ca7a19",
                                "text": "„Hat man die Innenstadt von Severnford, in der einige altertümliche Gebäude saniert wurden, erst einmal hinter sich gelassen und erreicht die umgebenden Backsteinhäuser, gibt es nur noch wenig, was einen Touristen interessiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
