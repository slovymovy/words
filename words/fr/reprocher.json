    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "146226e4-6dd0-3662-a567-def53e18e690",
                    "sense_definition": "Adresser des griefs ou imputer une faute, une négligence ou un défaut à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "blâme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon collègue me <w>reproche</w> constamment d'arriver en retard aux réunions importantes."
                        },
                        {
                            "text": "Elle n'a rien à se <w>reprocher</w> car elle a toujours agi avec une parfaite honnêteté."
                        }
                    ],
                    "synonyms": [
                        "blâmer",
                        "critiquer",
                        "accuser"
                    ],
                    "antonyms": [
                        "féliciter",
                        "louer"
                    ],
                    "common_phrases": [
                        "reprocher une erreur",
                        "ne rien avoir à reprocher",
                        "reprocher son retard"
                    ]
                },
                {
                    "sense_id": "c38efd50-3cb6-3c10-8e86-831ae4cbf181",
                    "sense_definition": "Rappeler avec insistance à quelqu'un une aide ou une faveur accordée, pour l'accuser d'ingratitude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ingratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne cesse de lui <w>reprocher</w> l'aide financière qu'il lui avait autrefois accordée."
                        },
                        {
                            "text": "Un bienfait <w>reproché</w> perd immédiatement toute sa valeur morale aux yeux des autres."
                        }
                    ],
                    "synonyms": [
                        "rappeler"
                    ],
                    "common_phrases": [
                        "reprocher un bienfait",
                        "reprocher un service"
                    ]
                },
                {
                    "sense_id": "887d3a61-4cc1-3c1a-9537-afb3bb22c1b9",
                    "sense_definition": "En parlant d'un aliment difficile à digérer, provoquer des aigreurs ou des renvois gastriques.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "digestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet assaisonnement trop chargé en ail va me <w>reprocher</w> pendant tout l'après-midi."
                        },
                        {
                            "text": "Je refuse de manger ce plat épicé car il me <w>reproche</w> à chaque fois."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Principalement usité dans certaines régions de France et en Suisse romande"
                        }
                    ]
                }
            ]
        }
    ]
