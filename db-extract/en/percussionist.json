                        "entry_id": "5b54052e-617e-344a-81af-35ce3bb948e0",
                        "glosses": [
                            "A trained musician who plays percussion instruments, as opposed to a drummer who lacks formal training."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a1c8dd-b4fe-43cd-b7c2-7c4bdb40e8ec",
                                "sense_id": "175e5cff-cff8-3302-ae2a-a796c7cb8937",
                                "text": "Since the 1960s, the keyboardist, vibraphonist and percussionist Mulatu Astatke has been a prime mover in Ethio-jazz: unmistakably Ethiopian music that also draws on American jazz, Afro-Caribbean music and more."
                            }
                        ]
                    }
                ],
