    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e89c9039-c307-3c47-96ee-f8d8a6f89fcb",
                    "sense_definition": "capable of being changed or moved slightly to achieve a better fit, position, or result",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office chair has an <w>adjustable</w> height to ensure you can work comfortably at your desk.",
                            "target_lang_translations": {
                                "ru": "Офисное кресло имеет <w>регулируемую</w> высоту, чтобы вы могли комфортно работать за столом."
                            }
                        },
                        {
                            "text": "Modern cars often feature <w>adjustable</w> seats that can be moved forward or backward.",
                            "target_lang_translations": {
                                "ru": "Современные автомобили часто оснащены <w>регулируемыми</w> сиденьями, которые можно перемещать вперед или назад."
                            }
                        }
                    ],
                    "synonyms": [
                        "adaptable",
                        "flexible",
                        "modifiable",
                        "variable"
                    ],
                    "antonyms": [
                        "fixed",
                        "rigid",
                        "unalterable"
                    ],
                    "common_phrases": [
                        "adjustable height",
                        "adjustable wrench",
                        "adjustable seats",
                        "fully adjustable"
                    ],
                    "target_lang_definitions": {
                        "ru": "способный изменяться или перемещаться для достижения лучшего положения или результата"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регулируемый",
