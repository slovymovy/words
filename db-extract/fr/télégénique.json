                                                "sense_id": "2bdbb1ca-5e38-3dc9-a552-182b66961e11",
                                                "text": "The young politician was very telegenic."
                                            },
                                            {
                                                "example_id": "d197c535-177b-4e08-a9e9-52d2e661f8e8",
