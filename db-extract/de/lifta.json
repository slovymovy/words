                "senses": [
                    {
                        "sense_id": "4a298ab0-b46b-38d2-aac7-ff43e422d0ee",
                        "entry_id": "e35f648c-0caf-3cfe-9d21-3cecf88e0d9a",
                        "glosses": [
                            "wüst gefallenes palästinensisches Dorf in Israel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f85213-a47a-4a2d-9341-34a602940a47",
                                "sense_id": "4a298ab0-b46b-38d2-aac7-ff43e422d0ee",
                                "text": "„Gemeinsam setzten sie ihren Weg in Richtung Lifta fort, wo später der Jerusalemer Stadtteil Romema entstehen sollte.“"
                            },
                            {
                                "example_id": "8796a7b4-8cd7-4f80-9c66-7d12075f40f6",
                                "sense_id": "4a298ab0-b46b-38d2-aac7-ff43e422d0ee",
                                "text": "„1961 in Jerusalem geboren, wuchs sie in Lifta, einem Vorort Jerusalems, auf.“"
                            },
                            {
                                "example_id": "d0b55175-bc3c-48a7-9601-60752ac16194",
                                "sense_id": "4a298ab0-b46b-38d2-aac7-ff43e422d0ee",
                                "text": "„Das war Lifta, und dieses Dorf war seit vielen Generationen die Heimat meiner Familie gewesen.“"
                            },
                            {
                                "example_id": "4ab5bbc0-36c2-4eb2-8566-017aa152e2a2",
                                "sense_id": "4a298ab0-b46b-38d2-aac7-ff43e422d0ee",
                                "text": "„Sie gehörten einer kleinen messianischen Gruppe an, die sich ‹Söhne Jehudas› (Bnei Jehuda) nannte und in den Ruinen des bei Jerusalem gelegenen ehemaligen palästinensischen Dorfes Lifta lebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
