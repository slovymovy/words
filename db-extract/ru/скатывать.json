                ],
                "senses": [
                    {
                        "sense_id": "23ae7d61-b566-3a6f-9584-427709e65f15",
                        "entry_id": "2bb089dc-42cd-3595-bb4b-44d6c00b6042",
                        "glosses": [
                            "катая, придавать форму трубки, собирать в шарик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9bb53c-bf86-4fd8-bd29-04dbc13e7ed5",
                                "sense_id": "23ae7d61-b566-3a6f-9584-427709e65f15",
                                "text": "Навозные жуки скатывали в шарики весь мусор на полу пещеры и выкидывали их прочь."
                            },
                            {
                                "example_id": "565ed722-c640-4703-aeb0-9ed02073a8bd",
                                "sense_id": "23ae7d61-b566-3a6f-9584-427709e65f15",
                                "text": "После остывания шеллак вынимают из воды и скатывают в виде карандашей."
                            }
                        ]
                    },
                    {
                        "sense_id": "22627665-1368-366f-971f-8d045de1c937",
                        "entry_id": "2bb089dc-42cd-3595-bb4b-44d6c00b6042",
                        "glosses": [
                            "свёртывать в трубку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eed03f9-6d83-4725-abef-e739e01c6616",
                                "sense_id": "22627665-1368-366f-971f-8d045de1c937",
                                "text": "Мокрую палатку не скатывают, а дают ей сначала высохнуть."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cfbb8f7-a13d-3e70-b2b6-56a11b0d9c50",
                        "entry_id": "2bb089dc-42cd-3595-bb4b-44d6c00b6042",
                        "glosses": [
                            "делать, изготавливать путём валяния, катания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d60a0c6f-27da-4a21-95a8-c001d28bf8de",
                                "sense_id": "5cfbb8f7-a13d-3e70-b2b6-56a11b0d9c50",
                                "text": "Из теста скатываем жгутики толщиной с палец, затем разрезаем их на кусочки по 6-7 см."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fa2ed86-05fb-3ff3-a86a-3d74e2d7dabb",
                        "entry_id": "2bb089dc-42cd-3595-bb4b-44d6c00b6042",
                        "glosses": [
                            "спутывать, сваливать, сбивать в космы (волосы, шерсть)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f3380bd9-0a96-3d43-aa67-9154f76b9fca",
                        "entry_id": "2bb089dc-42cd-3595-bb4b-44d6c00b6042",
                        "glosses": [
                            "перен., жарг. быстро, незаметно списывать, копировать откуда-либо, у кого-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
