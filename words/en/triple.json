                                "target_lang_sense_clarification": "состоящий из трёх частей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "三重",
                                "target_lang_sense_clarification": "由三个相关部分组成；用于结构、层次等"
                            },
                            {
                                "target_lang_word": "三周",
                                "target_lang_sense_clarification": "由三个部分构成；用于动作次数或项目名称中"
                            }
                        ]
