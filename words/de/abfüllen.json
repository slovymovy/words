                    "frequency": "Middle",
                    "semantic_group_id": "behälter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>füllen</w> den frisch gekochten Saft vorsichtig in saubere Flaschen <w>ab</w>."
                        },
                        {
                            "text": "In der Brauerei wird das Bier vollautomatisch in Flaschen <w>abgefüllt</w>."
                        }
                    ],
                    "synonyms": [
                        "einfüllen",
                        "umfüllen"
                    ],
                    "common_phrases": [
