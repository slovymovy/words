                "senses": [
                    {
                        "sense_id": "8eb19811-7757-36b3-af3a-5999788b21ae",
                        "entry_id": "9e636599-e151-320d-a97c-33c9ad651e7f",
                        "glosses": [
                            "Maison écologique de très petite taille, entre la cabane et la roulotte, construite en bois et montée sur roues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "415633b1-d7f0-482d-a8ce-7e43cdff7586",
                                "sense_id": "8eb19811-7757-36b3-af3a-5999788b21ae",
                                "text": "Maison d'appoint ou résidence principale, le mouvement de tiny houses, ou micromaisons, continue à faire son bonhomme de chemin. Et cette expression n'est pas galvaudée puisque cette appellation désigne des maisons de taille très petite, certes, mais également montées sur roues."
                            },
                            {
                                "example_id": "4a2a6fa9-e19c-45d5-8d5b-14dd71ebc379",
                                "sense_id": "8eb19811-7757-36b3-af3a-5999788b21ae",
                                "text": "Cette dernière caractéristique autorise ses occupants à y vivre et s'installer sur un terrain sans devoir entreprendre des démarches de permis de bâtir, car les micromaisons sont alors considérées comme des caravanes."
                            },
                            {
                                "example_id": "aee3ef6b-0ddd-418b-aba0-7ebfc08c72a3",
                                "sense_id": "8eb19811-7757-36b3-af3a-5999788b21ae",
                                "text": "Pour certains, la micromaison qui permet à la fois de réduire l’empreinte écologique et l’hypothèque est l’habitat de l’avenir."
                            },
                            {
                                "example_id": "78c45d14-31df-44fd-ab21-ee29a42754ac",
                                "sense_id": "8eb19811-7757-36b3-af3a-5999788b21ae",
                                "text": "De par sa nature miniature, la construction d’une micromaison devient un projet tout à fait envisageable pour un individu qui ne possède pas nécessairement de compétences techniques dans le domaine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3977519f-4757-4c4b-885f-7b33c0925772",
                        "source_entry_id": "9e636599-e151-320d-a97c-33c9ad651e7f",
                        "source_sense_id": "8eb19811-7757-36b3-af3a-5999788b21ae",
