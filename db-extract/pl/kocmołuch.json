                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "02f00ab2-f466-4192-b1d1-9f40896fc262",
                                "sense_id": "d00fff07-66e3-3242-9e6d-b13df1ddc642",
