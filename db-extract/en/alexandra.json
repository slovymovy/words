                                            "name"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb6dd990-317e-4bae-acb4-3ae00915dbde",
                                                "sense_id": "bdf1612e-b3aa-37b1-a847-a1c35816eb5f",
                                                "text": "Terlouw was in de jaren 50 tijdens zijn studie natuurkunde in Utrecht wiskundestudente Alexandra van Hulst tegengekomen. Hij zou ruim zestig jaar met haar getrouwd zijn, tot haar overlijden in 2017. Ze kregen vier kinderen, aan wie Terlouw voor het slapen eigen verhaaltjes vertelde. Ze vormden de basis van zijn latere schrijverschap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fafd40d-d3ba-433b-9901-11f59e23b33a",
                        "source_entry_id": "1195af94-3d24-30d8-8890-08c986664f4e",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Alexandra",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
