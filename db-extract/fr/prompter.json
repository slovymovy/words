                                "target_senses": [
                                    {
                                        "sense_id": "6197e816-1fda-3e81-853a-62a43634c06c",
                                        "entry_id": "8ba8563c-8068-3340-bf47-1373f15ddb0f",
                                        "glosses": [
                                            "To lead (someone) toward what they should say or do."
