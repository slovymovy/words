                "senses": [
                    {
                        "sense_id": "ae268f92-41d3-3428-934e-e5d7d4b2acba",
                        "entry_id": "048fb1b8-0670-3746-8f67-d962c7883a6d",
                        "glosses": [
                            "Ruf, der dazu dient, etwas (meist Tiere) anzulocken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68221df-38d9-439b-a806-eacdb4f94149",
                                "sense_id": "ae268f92-41d3-3428-934e-e5d7d4b2acba",
                                "text": "Mit seinem Lockruf hat der Vogel ein Weibchen angelockt."
                            },
                            {
                                "example_id": "9d4b7e97-64da-4c82-93b6-506f40f06f5b",
                                "sense_id": "ae268f92-41d3-3428-934e-e5d7d4b2acba",
                                "text": "„Es waren drei Hasenpärchen, und als Dahlerup keine Lockrufe mehr einfielen, wusste er sich nicht anders zu helfen, als ein Ende des Käfigs anzuheben und die Hasen vorsichtig ins Gras plumpsen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
