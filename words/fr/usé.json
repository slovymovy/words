                {
                    "sense_id": "5403e23a-4581-3da0-973c-099992cef626",
                    "sense_definition": "Qui a trop servi et qui a perdu de son originalité ou de son intérêt ; rebattu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuratif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conférencier a encore utilisé un argument <w>usé</w> pour tenter de convaincre son auditoire.",
                            "target_lang_translations": {
                                "en": "The speaker once again used a <w>stale</w> argument to try to convince his audience.",
                                "ru": "Докладчик снова прибег к <w>избитому</w> аргументу, пытаясь убедить слушателей.",
                                "nl": "De spreker heeft opnieuw een <w>afgezaagd</w> argument gebruikt in een poging zijn publiek te overtuigen.",
                                "pl": "Prelegent znowu użył <w>oklepanego</w> argumentu, próbując przekonać słuchaczy.",
                                "it": "Il relatore ha di nuovo usato un argomento <w>trito</w> per cercare di convincere il suo pubblico.",
                                "cs": "Řečník opět použil <w>ohraný</w> argument, aby se pokusil přesvědčit své posluchače.",
                                "tr": "Konuşmacı, dinleyicilerini ikna etmek için yine <w>basmakalıp</w> bir argüman kullandı.",
                                "es": "El conferenciante volvió a usar un argumento <w>manido</w> para intentar convencer a su auditorio.",
                                "zh": "演讲者又用了一个<w>老套</w>的论点来试图说服听众。",
                                "de": "Der Redner hat wieder einmal ein <w>abgedroschenes</w> Argument verwendet, um sein Publikum zu überzeugen."
                            }
                        },
                        {
                            "text": "Cette vieille comédie s'appuie sur une intrigue un peu <w>usée</w> qui n'amuse plus personne.",
                            "target_lang_translations": {
                                "en": "This old comedy relies on a somewhat <w>hackneyed</w> plot that no longer amuses anyone.",
                                "ru": "Эта старая комедия опирается на немного <w>избитый</w> сюжет, который уже никого не забавляет.",
                                "nl": "Deze oude komedie steunt op een wat <w>afgezaagde</w> intrige die niemand meer amuseert.",
                                "pl": "Ta stara komedia opiera się na nieco <w>oklepanej</w> intrydze, która już nikogo nie bawi.",
                                "it": "Questa vecchia commedia si basa su una trama un po' <w>banale</w> che non diverte più nessuno.",
                                "cs": "Tato stará komedie se opírá o trochu <w>ohranou</w> zápletku, která už nikoho nebaví.",
                                "tr": "Bu eski komedi, artık kimseyi eğlendirmeyen biraz <w>eskimiş</w> bir olay örgüsüne dayanıyor.",
                                "es": "Esta vieja comedia se apoya en una trama un poco <w>trillada</w> que ya no divierte a nadie.",
                                "zh": "这部老喜剧依靠的是一个有些<w>俗套</w>的情节，已经逗不了任何人发笑了。",
                                "de": "Diese alte Komödie stützt sich auf eine etwas <w>abgedroschene</w> Handlung, die niemanden mehr amüsiert."
                            }
                        }
                    ],
                    "synonyms": [
