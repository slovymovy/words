                        "examples": []
                    },
                    {
                        "sense_id": "cc73f984-d0bf-341f-b75b-91a5bf92b462",
                        "entry_id": "a287f1d7-d4a8-368d-b119-e33e60e88f11",
                        "glosses": [
                            "in het algemeen iemand die kleine porties serveert vanuit een grotere voorraad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40580fe2-3bfd-4954-93e9-0100590efc37",
                                "sense_id": "cc73f984-d0bf-341f-b75b-91a5bf92b462",
                                "text": "In clubs als de Comedytrain wordt stand-up uiteraard heel goed gedaan. En ik noem speciaal de Comedytrain, omdat ik eerlijk gezegd geen andere club weet. Daar zit je goed. Zowel publiek als tapper der grappen. Bakker des poetsen."
                            }
                        ]
