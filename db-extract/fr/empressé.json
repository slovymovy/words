                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "469a42f1-6adc-4e3d-9640-d31c562a33ec",
                        "entry_id": "220df181-30ca-393b-ac18-7762183b1862",
