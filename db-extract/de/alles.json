                    {
                        "sense_id": "fcfa9bc2-f4cb-3342-a4d0-1d554972aac6",
                        "entry_id": "fb404059-a8ae-3647-8809-82e6e638a510",
                        "glosses": [
                            "Génitif neutre singulier de all."
                        ],
                        "tags": [
