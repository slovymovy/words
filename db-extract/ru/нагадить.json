                "senses": [
                    {
                        "sense_id": "c3004497-3411-337b-a611-6c9f7d75b3d4",
                        "entry_id": "d5a9be9c-5ffd-3b7e-9ff8-727c19008afc",
                        "glosses": [
                            "прост. испражниться; оставить кал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74800f41-51f9-459e-9798-63de31bc63ea",
                                "sense_id": "c3004497-3411-337b-a611-6c9f7d75b3d4",
                                "text": "Как-то, уйдя на работу, Нина не затворила дверцу шкафа, и подлец, конечно, воспользовался ее оплошкой, нагадил в шкафу."
                            }
                        ]
                    },
                    {
                        "sense_id": "4bea03ec-a481-3ff8-82b5-860275b3a074",
                        "entry_id": "d5a9be9c-5ffd-3b7e-9ff8-727c19008afc",
                        "glosses": [
                            "нарушить чистоту"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8d41c2ca-e3f7-39f5-acb4-a4326d6c4650",
                        "entry_id": "d5a9be9c-5ffd-3b7e-9ff8-727c19008afc",
                        "glosses": [
                            "перен. сделать подлость или пакость, нанести вред"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f7b5baa-05c5-48bf-a1dc-a56c14bd9d2f",
                                "sense_id": "8d41c2ca-e3f7-39f5-acb4-a4326d6c4650",
                                "text": "Консерватор нагадил — бей в морду; либерал напакостил — лупи в харю! Всех лупи!"
                            },
                            {
                                "example_id": "f53281c5-f47f-45cc-bfef-c6f4cda524a5",
                                "sense_id": "8d41c2ca-e3f7-39f5-acb4-a4326d6c4650",
                                "text": "Он нагадил там, где ел, он нагадил тем, чьими трудами он живёт и дышит."
                            }
                        ]
                    }
                ],
