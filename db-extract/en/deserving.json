                                "target_senses": [
                                    {
                                        "sense_id": "326d07dc-f9c9-388a-bbb5-cfaa1f87b4bf",
                                        "entry_id": "f1fb279e-c201-3682-80d5-ddc5adb97c56",
                                        "glosses": [
                                            "van iets dat het zo goed is dat het applaus verdient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4212e6f9-9257-48a4-9099-ee5291943eb7",
                                                "sense_id": "326d07dc-f9c9-388a-bbb5-cfaa1f87b4bf",
                                                "text": "De prijzen worden dit jaar voor de 66ste keer toegekend. Dat gebeurt naar loffelijke traditie op een gala in LA, op 25 augustus. Vorig jaar was ‘The Newsroom’ de grote Emmy-winnaar."
                                            },
                                            {
                                                "example_id": "4f3fcfd1-ae36-482e-bbd5-14f85ea35c88",
                                                "sense_id": "326d07dc-f9c9-388a-bbb5-cfaa1f87b4bf",
                                                "text": "De jeugdige held Lars Karelse uit Nieuw-Beijerland kan het felbegeerde nieuwe (uit)tenue van Feyenoord aanschaffen. De 9-jarige jongen redde in februari het leven van zijn vader Joost en kreeg daarvoor woensdag een 'loffelijk getuigschrift'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
