                "senses": [
                    {
                        "sense_id": "518ec092-f1ab-39d9-b3d9-78cd1dd4ac12",
                        "entry_id": "1f461f2e-9570-3227-aedf-6df09fd3a238",
                        "glosses": [
                            "Of or characteristic of grown men, as opposed to women or children; macho, mannish, virile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5bf523c-d121-4901-971c-a95de6863c30",
                                "sense_id": "518ec092-f1ab-39d9-b3d9-78cd1dd4ac12",
                                "text": "In events, I carry my selfe man-like; in the conduct childishly."
                            }
                        ]
                    },
                    {
                        "sense_id": "745c3c17-eacd-3e21-a87d-d55489d35051",
                        "entry_id": "1f461f2e-9570-3227-aedf-6df09fd3a238",
                        "glosses": [
                            "Of or relating to a human being; anthropoid, anthropomorphous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87973d29-1a41-49a3-8712-6331fa8f7fb4",
                                "sense_id": "745c3c17-eacd-3e21-a87d-d55489d35051",
                                "text": "The legendary Bigfoot is said to be a manlike creature."
                            },
                            {
                                "example_id": "a4d4b2f2-529e-4155-af78-40311329b4ce",
                                "sense_id": "745c3c17-eacd-3e21-a87d-d55489d35051",
                                "text": "\"In heaven's name, what is it?\" he asked. \"We have been asked not to photograph it. Possibly the light would infuriate it. The command through the medium was definite. We can only say that it is either an ape-like man or a man-like ape.\""
                            }
                        ]
                    }
                ],
