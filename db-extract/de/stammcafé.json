                "senses": [
                    {
                        "sense_id": "104a1237-7b34-3ceb-beab-e3a58e1f770a",
                        "entry_id": "6163174c-5545-3cbb-8a8a-6c3d3823709c",
                        "glosses": [
                            "Café, das jemand immer wieder aufsucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d69e51-0c53-4eda-a411-3776d57d7ced",
                                "sense_id": "104a1237-7b34-3ceb-beab-e3a58e1f770a",
                                "text": "„Die Kumpane in seinem Stammcafé hörten ihn gern an, wenn er von Sibirien erzählte.“"
                            },
                            {
                                "example_id": "a2b769c1-6a6b-4849-b507-a82dcbf071fa",
                                "sense_id": "104a1237-7b34-3ceb-beab-e3a58e1f770a",
                                "text": "„Vor allem aber war das Odeon Lenins Stammcafé während seines Schweizer Exils gewesen; von hier aus dirigierte er bis 1917 die Aktionen der Bolschewiki in Petersburg.“"
                            },
                            {
                                "example_id": "4c9bdfda-4944-4e09-ab88-1f53827d57cb",
                                "sense_id": "104a1237-7b34-3ceb-beab-e3a58e1f770a",
                                "text": "„Es gab auch andere gute Cafés, in denen du arbeiten konntest, aber der Weg dorthin war weit, und das hier war dein Stammcafé.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
