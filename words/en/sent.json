                    "sense_id": "234ebbee-36be-36d7-afd4-21c37099f6f5",
                    "sense_definition": "Simple past and past participle of <w>send</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>sent</w> a letter to my grandmother for her birthday.",
                            "target_lang_translations": {
                                "ru": "Я <w>отправил</w> письмо бабушке на день рождения.",
                                "zh": "我给祖母生日的时候<w>寄</w>了一封信。"
                            }
                        },
                        {
                            "text": "The package was <w>sent</w> away before I could check the address.",
                            "target_lang_translations": {
                                "ru": "Посылка была <w>отправлена</w>, прежде чем я успел проверить адрес.",
                                "zh": "我还没来得及核对地址，包裹就被<w>寄出</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sent a message",
                        "sent away",
                        "sent home",
                        "sent for"
                    ],
                    "traits": [
