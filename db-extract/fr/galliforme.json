                    {
                        "sense_id": "0ce8bb48-6820-3560-96e6-de3b8dbdce5c",
                        "entry_id": "aa275e20-9359-3580-9261-e7a7c1dbab23",
                        "glosses": [
                            "Membre d’un ordre d’oiseaux néognathes, constitué d’oiseaux aux ailes courtes, aux pattes et au bec puissants, de mœurs terrestres, marcheurs, granivores et sédentaires, tels que la poule, la pintade, le dindon, le faisan, le tétras, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb200959-79d5-409a-a68c-d6863c5aed93",
                                "sense_id": "0ce8bb48-6820-3560-96e6-de3b8dbdce5c",
                                "text": "GALLIFORME, adj. et s. m. pl., Galliformes (gallus, coq, forma, forme). Nom donné par Latreille, Ficinus et Carus à une famille de l’ordre des Grimpeurs, comprenant des oiseaux qui se rapprochent des Gallinacés."
                            },
                            {
                                "example_id": "7a0ae148-33ca-44cf-b50a-08638939fb6b",
                                "sense_id": "0ce8bb48-6820-3560-96e6-de3b8dbdce5c",
                                "text": "La perdrix grise est un galliforme au même titre que la poule domestique, la caille ou le faisan."
                            }
                        ]
                    }
