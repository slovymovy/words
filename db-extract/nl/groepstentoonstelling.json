                        "examples": [
                            {
                                "example_id": "4a230084-8f7b-4e8e-9238-2c2b7274c3b4",
                                "sense_id": "d87ccc6d-d059-34ab-a138-8b3841ba0a5f",
                                "text": ".... ze had de kunstacademie in Manhattan gedaan en woonde nu dus in Brooklyn, had daar een paar tentoonstellingen gehad, niets bijzonders, behalve een belangrijke groepstentoonstelling onlangs, moderne kunst van jonge kunstenaars in het Whitney-museum, daar had ze het schilderij verkocht (met de titel 3) waarvan ze nu leefde."
                            },
                            {
