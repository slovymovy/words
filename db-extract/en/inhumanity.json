                "translations": [
                    {
                        "translation_id": "481eea2e-3ad6-4bb1-b79d-c0b35408ec5a",
                        "source_entry_id": "05b83a74-3318-37aa-b422-80ae1ef4ec51",
                        "source_sense_description": "lack of compassion",
                        "target_lang_word": "Unmenschlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unmenschlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                        "entry_id": "1eb49b8c-1995-3bd6-a949-137632686b3c",
                                        "glosses": [
                                            "die Eigenschaft, unmenschlich zu sein oder unmenschliches Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "484ebe76-9ec3-4a84-93be-aa6f954cdf83",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "Die Unmenschlichkeit der Tierindustrie überzeugt viele vom Veganismus."
                                            },
                                            {
                                                "example_id": "cf87b492-5731-443b-8a96-76888d655c59",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "„Jahraus, jahrein hallen die Zeitungen von den Unmenschlichkeiten des Sultans wider.“"
                                            },
                                            {
                                                "example_id": "87f12f7e-cb3d-4d05-9145-81cd3c105419",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "„Die Unmenschlichkeit von Hitlers Regime hatte ihn moralisch stumpf gemacht – und ebenso Roosevelt.“"
                                            },
                                            {
                                                "example_id": "6f02a881-4a51-497f-b735-24a2fc69175e",
                                                "sense_id": "9e674903-8ccb-399f-b129-9527f327a2c9",
                                                "text": "„Es war eine Verbindung von Unmenschlichkeit und Bürokratie, die die Unmenschlichkeit noch unmenschlicher machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23ad5d24-0585-482a-a26f-dd71b8d610ff",
                        "source_entry_id": "05b83a74-3318-37aa-b422-80ae1ef4ec51",
                        "source_sense_description": "lack of compassion",
                        "target_lang_word": "Inhumanität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inhumanität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a71a05a-707a-3c4a-9c85-0655347d7442",
                                        "entry_id": "2456227a-a126-32db-b983-e08a31765ce8",
                                        "glosses": [
                                            "Eigenschaft/Haltung, die in deutlichem Maße des Menschen nicht würdiges (inhumanes) Verhalten zeigt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ac2687c-ed7b-49b9-b737-f328a1b80191",
                                                "sense_id": "8a71a05a-707a-3c4a-9c85-0655347d7442",
                                                "text": "„Damit sind wir auf dem Wege zur Inhumanität. Wo das Bewußtsein schwindet, daß jeder Mensch uns als Mensch etwas angeht, kommen Kultur und Ethik ins Wanken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b568bd8-fcdf-3a07-82e1-aa5052b10d36",
                                        "entry_id": "2456227a-a126-32db-b983-e08a31765ce8",
                                        "glosses": [
                                            "Handlung, unmenschliches (inhumanes) Verhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0998476-3c05-482c-8b0a-2c88109bc776",
                                                "sense_id": "2b568bd8-fcdf-3a07-82e1-aa5052b10d36",
                                                "text": "„Wer sich als gemäßigter oder radikaler Defensivmilitarist zur unhaltbaren Lehre vom ‚gerechten Krieg‘ bekennt, möge auch nur einen einzigen Krieg der letzten Jahrhunderte nennen, der nur aus erlaubten Notwehrhandlungen besteht und der völlig frei ist von Exzeßhandlungen und militärischen Aggressionshandlungen, von Inhumanitäten und Verbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
