                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "15fbb4cd-8c06-48b7-a399-0813180c3300",
                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "univoques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45eabadc-fdbf-3c00-8480-659b6ff8e224",
                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "glosses": [
                            "Qualifie un terme qui conserve le même sens dans des emplois différents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a4588c-75fb-4e90-b74e-8c049aba5e3f",
                                "sense_id": "45eabadc-fdbf-3c00-8480-659b6ff8e224",
                                "text": "Les seuls termes dont le sens généalogique reste univoque sont « père », « mère », « fils », « fille », « frère », « sœur », « époux » et « épouse »."
                            }
                        ]
                    },
                    {
                        "sense_id": "80144316-f0c3-3ffc-a90e-f69b385ee5eb",
                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "glosses": [
                            "Qualifie une relation qui ne s’exerce que dans un sens."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f494bcdb-11c2-3c05-8112-bcfbd04e63d8",
                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "glosses": [
                            "Qualifie un symptôme qui ne se rencontre que dans une seule maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc107520-8676-4783-b3c6-1ca8006923e3",
                                "sense_id": "f494bcdb-11c2-3c05-8112-bcfbd04e63d8",
                                "text": "La psychorigidité forme un couple bien assorti avec l’égocentrisme qui peut se définir comme un rapport privilégié, voire univoque à soi, à ses préoccupations, différent de ce que l'on entend communément par égoïsme."
                            }
                        ]
                    },
                    {
                        "sense_id": "93281223-366c-3aee-ba4c-a5faedacb127",
                        "entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "glosses": [
                            "Qui n’admet qu'une seule interprétation ; non ambigu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e04dd9e-2b60-4420-bfd5-923d12da6a98",
                                "sense_id": "93281223-366c-3aee-ba4c-a5faedacb127",
                                "text": "La volonté de Beckett avait été univoque ; il avait fait interdire ce travestissement par un tribunal hollandais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49565ebf-f984-42b9-b255-bed213571295",
                        "source_entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "target_lang_word": "eindeutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindeutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                        "entry_id": "c6962fd6-1f16-3873-9abf-f6724e1bf73a",
                                        "glosses": [
                                            "keine andere Möglichkeit zulassend; nur eine Deutung zulassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13299546-0d0e-4622-bab2-ba344e007e04",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "Dieser Brief ist eine eindeutige Absage."
                                            },
                                            {
                                                "example_id": "861e056c-eca0-4f8b-bce1-b5ae0344d9f1",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "Eindeutiger kann man es wohl kaum formulieren, wenn man nicht beleidigen will."
                                            },
                                            {
                                                "example_id": "110e88b3-7a38-4aa7-a1fa-181b049bbc78",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "Die Pisa-Schulleistungsvergleiche der Organisation für wirtschaftliche Organisation und Entwicklung (OECD) sind eindeutig: Die schulischen Leistungen 15-Jähriger mit zwei Jahren Kindergartenerfahrung sind im Durchschnitt besser als die von gleichaltrigen Mitschülern, die keine Kita besucht haben."
                                            },
                                            {
                                                "example_id": "70ff2d6f-14b6-499d-856b-2bafd8ed40c0",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            },
                                            {
                                                "example_id": "cd4913a0-d0b2-42c5-bb06-fcf3dfa021a5",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "„Die Forscher Dr. Lisa Welling und Justin Mogilski haben dabei herausgefunden, dass Personen mit ‚dunklen Persönlichkeitszügen‘ (‚Dunkle Triade‘), also Personen, die eindeutig narzisstische, machiavellistische und psychopathische Züge aufweisen, aus bestimmten, pragmatischen Gründen mit dem/der Ex befreundet bleiben“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32e8d01b-cc64-404a-924f-d649a03fa293",
                        "source_entry_id": "4b801daf-071c-3b9f-bd0f-63f18ce1fb2b",
                        "target_lang_word": "univocal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "univocal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b48197bc-afa8-3c53-8b7b-c155995ce0aa",
                                        "entry_id": "900d6663-ce8d-3b36-ac60-d57b8e1f978e",
                                        "glosses": [
                                            "Having only one possible meaning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e88a32f6-5c40-4ecd-bace-4ba6f1de8392",
                                                "sense_id": "b48197bc-afa8-3c53-8b7b-c155995ce0aa",
                                                "text": "There were, he argued, some words, such as ‘fat’ or ‘exhausted’, that could not apply to God, but if such terms as ‘being’, ‘goodness’ or ‘wisdom’ were not univocal of God and creatures, ‘one could not naturally have any concept of God – which is false.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9d787d1-8906-31fa-a77c-219511949a62",
                                        "entry_id": "900d6663-ce8d-3b36-ac60-d57b8e1f978e",
                                        "glosses": [
                                            "Containing instances of only one vowel; univocalic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f052d7a-1a55-4146-8910-d02fc54f05e1",
                                                "sense_id": "e9d787d1-8906-31fa-a77c-219511949a62",
                                                "text": "Eunoia is a univocal lipogram — an anomalous narrative, in which each vowel appears by itself in its own chapter, telling a story in its own voice."
                                            },
                                            {
                                                "example_id": "eebd256b-c2fa-43d7-b8f1-6f1df9a69092",
                                                "sense_id": "e9d787d1-8906-31fa-a77c-219511949a62",
                                                "text": "I read through the dictionary five times to extract an extensive lexicon of univocal words containing only one of the five vowels."
                                            },
                                            {
                                                "example_id": "43b26d00-7e5e-4766-b59a-fc426c878d85",
                                                "sense_id": "e9d787d1-8906-31fa-a77c-219511949a62",
                                                "text": "The book's main conceit is to make poetry from univocal words (words containing just one vowel) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44681336-f7fa-3be7-aef6-81145df3862d",
                                        "entry_id": "900d6663-ce8d-3b36-ac60-d57b8e1f978e",
                                        "glosses": [
                                            "Having unison of sound, as the octave has in music."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8df74a08-e10d-396d-8848-e2064c0d384e",
                                        "entry_id": "900d6663-ce8d-3b36-ac60-d57b8e1f978e",
                                        "glosses": [
                                            "Having always the same drift or tenor; uniform; certain; regular."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6e7ffd-22b9-47db-b88a-5bfa9e961bf7",
                                                "sense_id": "8df74a08-e10d-396d-8848-e2064c0d384e",
                                                "text": "It is not indeed impossible, that from the sperm of a cock, hen, or other animal, being once in putrescence, either from incubation or otherwise, some generation may ensue; not univocal and of the same species, but some imperfect or monstrous production […]"
                                            },
                                            {
                                                "example_id": "64cf123f-d212-4010-b1a8-9b1db72dc119",
                                                "sense_id": "8df74a08-e10d-396d-8848-e2064c0d384e",
                                                "text": "But I am much pleased at the repetition of the divine favour to you in the like instances; that God hath given you another testimony of his love to your person, and care of your family ; it is an engagement to you of new degrees of duty, which you cannot but superadde to the former, because the principle is genuine and prolific, and all the emanations of grace are univocal and alike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea848259-d776-3e14-9947-ab8f284d4c7e",
                                        "entry_id": "900d6663-ce8d-3b36-ac60-d57b8e1f978e",
                                        "glosses": [
                                            "Unequivocal; indubitable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6e5d9e-5d3f-434f-a494-9c00e8dfc88f",
                                                "sense_id": "ea848259-d776-3e14-9947-ab8f284d4c7e",
                                                "text": "There is no blessed soul goes to heaven but he makes a general joy in all the mansions where the saints do dwell, and in all the chapels where the angels sing ; and the joys of religion are not univocal, but productive of rare and accidental and preternatural pleasures ; for the music of holy hymns delights the ear and refreshes the spirit, and makes the very bones of the saints to rejoice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "univocal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b297f186-1df5-3d4e-bbcf-e1d8cba32270",
                                        "entry_id": "deadfd52-ff30-3545-8628-a2736d4f7a6f",
                                        "glosses": [
                                            "A word having only one meaning."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02734350-20ff-3638-a601-9469324021da",
                                        "entry_id": "deadfd52-ff30-3545-8628-a2736d4f7a6f",
                                        "glosses": [
                                            "A document containing instances of only one vowel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a586a4b9-5d17-4157-974d-1716ed0b0107",
                                                "sense_id": "02734350-20ff-3638-a601-9469324021da",
                                                "text": "The univocal is by no means the preserve of the nineteenth century. Georges Perec's 1972 novella Les revenentes complemented his earlier lipogrammatic work by being a univocalic piece in which the letter e is the only vowel used."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
