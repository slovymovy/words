                        "glosses": [
                            "Homme cis, qui n’est pas trans."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f63050e3-a830-45a1-99be-9895ec1beda5",
                                "sense_id": "034d87f4-dcca-3289-b0e6-9c8b7066af76",
                                "text": "Quand je me balade avec un ciskeum je ne passe pas, apparemment c’est une loi universelle"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3ff9138-3ec5-4160-ab9f-1ede4ade6fb3",
