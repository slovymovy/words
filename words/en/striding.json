{
    "word_family": [
        "stride",
        "strider"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0947c0bc-39ff-3f3b-9759-3d35bfedfd85",
                    "sense_definition": "A technique for propelling forward that appears similar to walking, where a foot slides forward on the opposite side of a pole being planted to provide a location to apply force.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "skiing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete used a smooth <w>striding</w> motion to maintain speed on the flat section of the track.",
                            "target_lang_translations": {
                                "zh": "运动员用平稳的<w>滑步</w>动作在赛道的平坦路段保持速度。"
                            }
                        },
                        {
                            "text": "Mastering the <w>striding</w> technique is essential for efficient cross-country skiing.",
                            "target_lang_translations": {
                                "zh": "掌握<w>滑步</w>技术对于高效越野滑雪至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classic striding",
                        "striding technique"
                    ],
                    "common_phrases": [
                        "classic striding",
                        "striding technique"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种越野滑雪中类似步行的推进技术，通过滑行和撑杆来产生动力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑步",
                                "target_lang_sense_clarification": "越野滑雪中的经典滑行技术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b240c288-d7e7-3248-9bc6-b7f0737b0340",
                    "sense_definition": "The act of taking long, decisive steps.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His confident <w>striding</w> across the room commanded the attention of everyone present.",
                            "target_lang_translations": {
                                "zh": "他自信地<w>大步走</w>过房间，吸引了在场所有人的注意。"
                            }
                        },
                        {
                            "text": "The rhythmic <w>striding</w> of the soldiers echoed through the quiet morning air.",
                            "target_lang_translations": {
                                "zh": "士兵们有节奏的<w>大步走</w>声在宁静的清晨空气中回荡。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "迈着大步走的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大步走",
                                "target_lang_sense_clarification": "形容步伐坚定且跨度大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8301c1a2-581b-3c4a-9240-04ad64656638",
                    "sense_definition": "Present participle and gerund of <w>stride</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>striding</w> purposefully toward the exit when the phone began to ring.",
                            "target_lang_translations": {
                                "zh": "当电话铃响起时，她正<w>阔步</w>走向出口。"
                            }
                        },
                        {
                            "text": "He enjoys <w>striding</w> through the park every morning to clear his head.",
                            "target_lang_translations": {
                                "zh": "他喜欢每天早上在公园里<w>阔步</w>行走，以清醒头脑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb stride"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "大步走；阔步走（stride的现在分词或动名词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阔步",
                                "target_lang_sense_clarification": "形容步伐大而自信"
                            },
                            {
                                "target_lang_word": "大步走",
                                "target_lang_sense_clarification": "指跨大步前行"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}