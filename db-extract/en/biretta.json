    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "12069ffb-7c67-39b5-b70f-c4545d8898b2",
                "word": "biretta",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4072bcf7-fbc1-4323-ad66-2ecc61648f2a",
                        "entry_id": "12069ffb-7c67-39b5-b70f-c4545d8898b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "birettas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a512b138-e1d6-357f-ac15-6291fad6c6fe",
                        "entry_id": "12069ffb-7c67-39b5-b70f-c4545d8898b2",
                        "glosses": [
                            "A square cap, originally with four ridges across the top, surmounted by a tuft, worn by Roman Catholic clergy (and by some in the Anglican Church). A three-sided biretta is worn by Roman Catholic clergy for liturgical celebrations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d257af47-aeac-4042-966c-8fca091327ae",
                                "sense_id": "a512b138-e1d6-357f-ac15-6291fad6c6fe",
                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                            },
                            {
                                "example_id": "091d2445-c01c-4b41-a571-ebfbbff31ae6",
                                "sense_id": "a512b138-e1d6-357f-ac15-6291fad6c6fe",
                                "text": "To right and left, embedded in their stalls, the other canons sit reverently engrossed, birettas hung on the walls behind; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eea4822-59f0-427b-865f-57c1a9d1f036",
                        "source_entry_id": "12069ffb-7c67-39b5-b70f-c4545d8898b2",
