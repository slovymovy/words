                                "sense_id": "0bb1ad0a-0b66-380a-80ff-1a432819d25a",
                                "text": "Les pâtissons peuvent être blancs, verts jaunes, orangés, ou panachés de ces diverses couleurs."
                            },
                            {
                                "example_id": "f710e8de-dc6b-4b91-8b73-a3ea00c5ea7f",
                                "sense_id": "0bb1ad0a-0b66-380a-80ff-1a432819d25a",
                                "text": "Le pâtisson ressemble fort à une courgette pour le feuillage."
                            }
                        ]
