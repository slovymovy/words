                            "inanimate"
                        ],
                        "examples": [
                            {
                                "example_id": "38cf4837-a713-44c9-8b02-b0067737bf12",
                                "sense_id": "1250d518-6c05-367c-b2d0-060b92b39529",
                                "text": "В суббо́ту, когда́ он постуча́лся к Севостья́нову, старика́н пе́рвым де́лом посади́л за стол, навали́л по́лную таре́лку отварно́й карто́шки с тушёнкой и су́нул ви́лку в ру́ку."
                            }
                        ]
                    }
