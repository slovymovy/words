                    {
                        "translation_id": "3225d6fd-95fd-498d-95ff-271eedbab94d",
                        "source_entry_id": "4880b420-47ab-3db3-8355-676573ba8685",
                        "source_sense_id": "4095d496-b36b-32d5-9ea0-fc08620a89c2",
                        "target_lang_word": "Dominanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dominanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "312c93ec-4d13-3452-a41f-12f1bb249a44",
                                        "entry_id": "2c86695f-dfb4-30bd-a64d-0a9f5127c156",
                                        "glosses": [
                                            "das Durchsetzungsvermögen gegenüber Schwächeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b949ee-1218-478d-a4e8-82fca2561476",
                                                "sense_id": "312c93ec-4d13-3452-a41f-12f1bb249a44",
                                                "text": "„Gerade wenn wir die von Wahlforschern festgestellte kulturelle Dominanz von Rot-Grün brechen wollen, muss unsere Politik Leitlinien folgen, die über den Tag hinausweisen.“"
                                            },
                                            {
                                                "example_id": "8bb5c034-8e84-40fd-8652-b0e6b375642e",
                                                "sense_id": "312c93ec-4d13-3452-a41f-12f1bb249a44",
                                                "text": "„Die wachsende Dominanz von nationalistischen, expansionistischen und antidemokratischen Ideologien, Zielen und politischen Vorgehensweisen haben die demokratische und moralische rote Linie schon überschritten.“"
                                            },
                                            {
                                                "example_id": "d5194924-0509-4469-9952-88d6eb1b9a92",
                                                "sense_id": "312c93ec-4d13-3452-a41f-12f1bb249a44",
                                                "text": "„Es war der eigentliche Beginn ihrer Dominanz – der Dominanz, zu der meine eigene Dominanz ihr verholfen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
