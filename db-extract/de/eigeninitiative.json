                "senses": [
                    {
                        "sense_id": "468cf608-7d50-363e-bdc8-b1caff953ac3",
                        "entry_id": "ff53dc53-8d56-388a-b196-771a9b35f5c0",
                        "glosses": [
                            "von einer Person oder Organisation ohne Anstoß von anderswo ausgehende Aktivität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39021fe5-5246-4c35-8522-bf26eb9dd2f4",
                                "sense_id": "468cf608-7d50-363e-bdc8-b1caff953ac3",
                                "text": "„Angesichts der Tatsache, dass die Industrie am Trend zum übermäßigen Genuss ganz fabelhaft verdient, kommen wir um die nötige Eigeninitiative im Kampf gegen die Fettsucht offensichtlich nicht herum.“"
                            },
                            {
                                "example_id": "5a5136a7-53a0-40ad-b51f-8afaec1956c0",
                                "sense_id": "468cf608-7d50-363e-bdc8-b1caff953ac3",
                                "text": "„Im Interesse der Sicherheit wird einem jede Befugnis entzogen und jede Eigeninitiative verboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
