                        ],
                        "examples": [
                            {
                                "example_id": "b36c50b5-2ef9-4c14-b8e9-a5b1b15793e3",
                                "sense_id": "d45a82d7-b12a-328f-b35d-7153659144db",
                                "text": "Here and there an adventurous genius coins a phrase for the benefit of posterity,--as we once heard a mate order a couple of men to \"go forrard and trim the ship's whiskers,\" to the utter bewilderment of his captain, who, in thirty years' following of the sea, had never heard the martingale chains and stays so designated."
                            },
                            {
                                "example_id": "6319aa1a-7f7f-4e2f-bdb1-908403f64962",
                                "sense_id": "d45a82d7-b12a-328f-b35d-7153659144db",
                                "text": "Off, here, Masser Mile--larboard bow, well forrard; look sharp and soon see him, yourself, sir.\""
                            },
                            {
                                "example_id": "80306a3a-cb70-4016-9014-cf6b0f226eee",
                                "sense_id": "d45a82d7-b12a-328f-b35d-7153659144db",
                                "text": "The old chap who had just come off the look-out, had returned forrard again, and I was alone on that part of the deck."
                            }
                        ]
                    }
                ],
