                        "sense_id": "654c64da-d383-357f-bdd0-fffe01f141fb",
                        "entry_id": "34b5c29f-c212-3197-88ee-2e1494875a6b",
                        "glosses": [
                            "Logiciel de profilage, permettant d’évaluer les compétences et ressources utilisées d’un autre logiciel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a5838c-9953-4ad7-8673-1a5ac055ccfa",
                                "sense_id": "654c64da-d383-357f-bdd0-fffe01f141fb",
                                "text": "D’une manière générale, les développeurs ne semblent pas accorder une grande valeur aux profileurs et ont tendance à se reposer sur les optimisations de leur compilateur."
                            },
                            {
                                "example_id": "9c25fc44-0901-4c0a-b763-9f34c87c493b",
                                "sense_id": "654c64da-d383-357f-bdd0-fffe01f141fb",
                                "text": "Le profileur Adobe Flex permet d’identifier les problèmes de performance et les fuites de mémoire des applications."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e7a5a50-0eb5-3739-a9f5-4f34b794c791",
                        "entry_id": "34b5c29f-c212-3197-88ee-2e1494875a6b",
                        "glosses": [
                            "Instrument de mesure, radar pour mesurer la direction et la vitesse du vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f0ef4b9-90b8-4a46-aba6-a6c04d9c1a8d",
                                "sense_id": "4e7a5a50-0eb5-3739-a9f5-4f34b794c791",
                                "text": "Un profileur de vents."
                            }
                        ]
                    },
                    {
                        "sense_id": "399edc63-33fd-342f-8e5d-b49a86428616",
                        "entry_id": "34b5c29f-c212-3197-88ee-2e1494875a6b",
                        "glosses": [
                            "Instrument de dessin utilisé pour tracer les profils."
