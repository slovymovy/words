                {
                    "sense_id": "29e40628-ad99-3bfa-8374-f35de1b974ff",
                    "sense_definition": "die gesamten organisierten militärischen Streitkräfte eines Staates",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "militaer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem Schulabschluss entschied er sich, freiwillig zur <w>Armee</w> zu gehen."
                        },
                        {
                            "text": "Früher mussten fast alle jungen Männer verpflichtend ihren Dienst in der <w>Armee</w> leisten."
                        }
                    ],
                    "synonyms": [
                        "Militär",
                        "Streitkräfte"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "zur Armee gehen",
                        "in der Armee dienen"
                    ]
                },
                {
                    "sense_id": "de0c5566-73d4-3f81-b74d-0532f55d1da9",
                    "sense_definition": "die Streitkräfte eines Staates zu Lande; das Heer",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "militaer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der König befahl seinen Generälen sofort, eine neue schlagkräftige <w>Armee</w> aufzustellen."
                        },
                        {
                            "text": "Die feindliche <w>Armee</w> überschritt bei Tagesanbruch die Grenze und besetzte das Tal."
                        }
                    ],
                    "synonyms": [
                        "Heer",
                        "Landstreitkräfte"
                    ],
                    "common_phrases": [
                        "eine Armee aufstellen"
                    ]
                },
                {
                    "sense_id": "dfdc39a6-4267-3a10-aca3-fb2f3d073d43",
                    "sense_definition": "eine sehr große Anzahl an Personen oder Tieren mit einem gemeinsamen Ziel oder Verhalten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eine riesige <w>Armee</w> von freiwilligen Helfern reparierte den beschädigten Deich am Fluss."
                        },
                        {
                            "text": "Im Sommer fiel eine unübersehbare <w>Armee</w> von Heuschrecken über die Getreidefelder her."
                        }
                    ],
                    "common_phrases": [
                        "eine Armee von Helfern"
                    ],
                    "synonyms": [
                        "Heer",
                        "Schar"
                    ]
                },
                {
                    "sense_id": "bfc30581-9f2b-35b2-93c0-243849762054",
                    "sense_definition": "militärischer Großverband der Landstreitkräfte, der aus mehreren Korps oder Divisionen besteht",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die geschwächte <w>Armee</w> musste sich nach harten Kämpfen hinter den Fluss zurückziehen."
                        },
                        {
                            "text": "Der General übernahm das Kommando über die neu formierte vierte <w>Armee</w> an der Front."
                        }
                    ]
                }
            ]
        }
