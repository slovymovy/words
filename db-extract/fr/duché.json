                "senses": [
                    {
                        "sense_id": "d0cc2f9f-f361-3749-b7f2-2ce61f12d78d",
                        "entry_id": "cc77aad2-d052-3c71-94ed-82bca2393248",
                        "glosses": [
                            "Seigneurie, principauté à laquelle le titre de duc est attaché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b66d47c-b3d9-4df5-95de-6eb6bf04d5f7",
                                "sense_id": "d0cc2f9f-f361-3749-b7f2-2ce61f12d78d",
                                "text": "Entre la Slovaquie et la Tchéquie proprement dite ou le royaume de Bohème, s'étend le duché de Moravie, qui, avec plusieurs districts de Silésie, fait également partie intégrante du territoire des Tchéquo-Slaves."
                            },
                            {
                                "example_id": "05b8b4d6-d864-4003-b2e4-d299a18c9375",
                                "sense_id": "d0cc2f9f-f361-3749-b7f2-2ce61f12d78d",
                                "text": "Le duché de Salzbourg, avec ses 7000 kilomètres carrés et ses 150000 habitants, est la plus petite des provinces de la monarchie austro-hongroise."
                            },
                            {
                                "example_id": "7691d4ca-3bd6-47f2-809c-410e7e4637c4",
                                "sense_id": "d0cc2f9f-f361-3749-b7f2-2ce61f12d78d",
                                "text": "De même que les duchés de France, jadis indépendants, durent se fusionner en une nation, de même à présent les nations auraient dû s’adapter à une fusion plus vaste, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1342c697-af7e-4eaa-9f45-ee96abfc9425",
                        "source_entry_id": "cc77aad2-d052-3c71-94ed-82bca2393248",
                        "source_sense_id": "d0cc2f9f-f361-3749-b7f2-2ce61f12d78d",
                        "target_lang_word": "Herzogtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzogtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                        "entry_id": "49cae3e1-5f04-34e9-90c0-76b661cea800",
                                        "glosses": [
                                            "Herrschaftsgebiet eines Herzogs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475da020-d4a8-45fb-be65-54a1c1d460d0",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„Der Konflikt des neuen Königs mit dem Welfen Heinrich gen. der Stolze, dem das sächsische Herzogtum genommen wurde, brachte Albrecht an das von ihm und seiner Mutter höchst erwünschte Ziel, indem er nun die Belehnung mit dem Herzogtum empfing.“"
                                            },
                                            {
                                                "example_id": "a9ef907f-dd3b-468e-a81f-529c3de8cb1e",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„Der Welfe wurde vor den Reichstag zitiert, unter Reichsacht gestellt und verlor die Herzogtümer Sachsen und Bayern.“"
                                            },
                                            {
                                                "example_id": "1cdbf289-927b-446f-8079-7e9a4f58bc69",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„Das Herzogtum Schleswig gehörte zu Dänemark.“"
                                            },
                                            {
                                                "example_id": "7a87b276-38e1-44f7-ab3d-e333015b17e5",
                                                "sense_id": "9d90271b-51fc-3764-adf6-46036c4022fb",
                                                "text": "„In Königsberg, der Hauptstadt des Herzogtums Preußen, wurde Immanuel Kant am 22. April 1724 geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
