            "senses": [
                {
                    "sense_id": "c3dfd0cb-b31a-3546-931d-d2e323766ad0",
                    "sense_definition": "present participle and gerund of <w>dart</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat was <w>darting</w> across the room to catch the toy.",
                            "target_lang_translations": {
                                "fr": "Le chat <w>filait</w> à travers la pièce pour attraper le jouet.",
                                "es": "El gato <w>corría como una flecha</w> por la habitación para atrapar el juguete."
                            }
                        },
                        {
                            "text": "She kept <w>darting</w> glances at the clock during the long meeting.",
                            "target_lang_translations": {
                                "fr": "Elle n'arrêtait pas de <w>jeter des coups d'œil rapides</w> à l'horloge pendant la longue réunion.",
                                "es": "No paraba de <w>lanzar</w> miradas al reloj durante la larga reunión."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent et gérondif du verbe 'se précipiter' ou 'filer'.",
                        "es": "Participio de presente y gerundio de 'dart'; moverse o lanzar con rapidez y de forma repentina."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "filer",
                                "target_lang_sense_clarification": "se déplacer très rapidement"
                            },
                            {
                                "target_lang_word": "se précipiter",
                                "target_lang_sense_clarification": "aller rapidement dans une direction"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "correr rápidamente",
                                "target_lang_sense_clarification": "moverse con rapidez y ligereza"
                            },
                            {
                                "target_lang_word": "lanzar",
                                "target_lang_sense_clarification": "dirigir miradas o movimientos de golpe"
                            },
                            {
                                "target_lang_word": "lanzarse",
                                "target_lang_sense_clarification": "precipitarse velozmente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc8268f8-d25a-35fc-a01d-71f980770ccd",
                    "sense_definition": "Characterized by sudden, quick movements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird made <w>darting</w> movements as it searched for insects in the grass.",
                            "target_lang_translations": {
                                "fr": "L'oiseau faisait des <w>mouvements vifs</w> en cherchant des insectes dans l'herbe.",
                                "es": "El pájaro hacía <w>rápidos</w> movimientos mientras buscaba insectos en la hierba."
                            }
                        },
                        {
                            "text": "He felt <w>darting</w> pains in his shoulder after the intense workout.",
                            "target_lang_translations": {
                                "fr": "Il a ressenti des <w>élancements</w> dans l'épaule après l'entraînement intense.",
                                "es": "Sintió dolores <w>punzantes</w> en el hombro tras el intenso entrenamiento."
                            }
                        }
                    ],
                    "synonyms": [
