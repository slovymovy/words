                "translations": [
                    {
                        "translation_id": "d92b6d80-d754-461a-94e6-bea3d31232bb",
                        "source_entry_id": "2462a16c-a20e-3d05-910d-0860b052fc84",
                        "source_sense_id": "ab6a59f0-0156-3587-a944-b465f092e31d",
                        "target_lang_word": "DJ",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DJ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                        "entry_id": "29e300b8-1557-3ef7-aed8-31bfcf63f51e",
                                        "glosses": [
                                            "Initialism of disc jockey."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0a3a54-83ef-45c0-a598-db1a6b86db87",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "Last night a DJ saved my life / Last night a DJ saved my life from a broken heart"
                                            },
                                            {
                                                "example_id": "13c821ce-8dcd-4495-b59e-aabc95ba400f",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "Burn down the disco / Hang the blessed DJ / Because the music that they constantly play / It says nothing to me about my life"
                                            },
                                            {
                                                "example_id": "04acc2d0-99dc-4730-a7cb-2786c686e29c",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "Three MC's and one DJ / We be getting down with no delay"
                                            },
                                            {
                                                "example_id": "64710337-a5cf-4d03-aea4-3189e86c0104",
                                                "sense_id": "11380dbd-2355-38d1-9ad3-3915e9d85a43",
                                                "text": "“I like to put it simply,” says Randy “R Dub!” Williams, a late-night “slow jams” DJ from San Diego who’s also known as “the Sultan of Slowjamastan.” “I ran out of countries, so I created my own.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5041dbf9-03b6-3914-bbdc-b01998a82423",
                                        "entry_id": "29e300b8-1557-3ef7-aed8-31bfcf63f51e",
                                        "glosses": [
                                            "Initialism of dinner jacket."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad0ca2f3-1719-3be4-abec-86565af6297a",
                                        "entry_id": "29e300b8-1557-3ef7-aed8-31bfcf63f51e",
                                        "glosses": [
                                            "Initialism of dust jacket."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "DJ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cbd560b-8e4e-3c33-8e3d-8d805ef40e0c",
                                        "entry_id": "a7dd79df-b5f3-3d63-a695-f835383b45e6",
                                        "glosses": [
                                            "To act as a DJ (disc jockey); to play, cut and mix/blend recorded music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c97c0bfe-2cf8-473f-9f6d-0eed67786f8e",
                                                "sense_id": "3cbd560b-8e4e-3c33-8e3d-8d805ef40e0c",
                                                "text": "A tattooed camp staffer DJs from a heavily stickered laptop, next to a whirling party light that scatters rainbow beams throughout the space."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "DJ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8d4a4a9-66d1-355a-aae5-965a45a40bd6",
                                        "entry_id": "86fecd48-e164-32ae-9bec-79c875528564",
                                        "glosses": [
                                            "Dow Jones & Company, an American publishing firm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12947a65-c421-3b74-acd4-d29ce6362924",
                                        "entry_id": "86fecd48-e164-32ae-9bec-79c875528564",
                                        "glosses": [
                                            "Initialism of David Jones, an Australian luxury department store."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d95179-2838-4daa-8519-b68639964a77",
                                                "sense_id": "12947a65-c421-3b74-acd4-d29ce6362924",
                                                "text": "DJ shares fell as much as 4.7% in Sydney after Australia’s second-biggest department-store chain said McInnes would leave his role and the board immediately and that Paul Zahra, general manager, would assume the CEO’s role."
                                            },
                                            {
                                                "example_id": "9410853f-2902-4661-a20a-9b4b4b9e14f4",
                                                "sense_id": "12947a65-c421-3b74-acd4-d29ce6362924",
                                                "text": "But one shareholder started building a position in DJ shares that, if it continued to grow (as it can in Australia up to 20%), could come close to blocking the deal."
                                            },
                                            {
                                                "example_id": "ed2ef16e-7f21-4bc8-b8f5-d161eace70da",
                                                "sense_id": "12947a65-c421-3b74-acd4-d29ce6362924",
                                                "text": "DJ's bottom line net profit was just $14.5m in 2022, compared to $84.3m in 2021 – an 82.7 per cent collapse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
