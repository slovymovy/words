                    "sense_definition": "Dégager ou produire une substance, de l'énergie ou un gaz au cours d'une réaction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sciences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette transformation chimique va inévitablement <w>libérer</w> une forte quantité de chaleur."
                        },
                        {
                            "text": "Certains métaux en fusion peuvent <w>libérer</w> des vapeurs très toxiques."
                        }
                    ],
                    "common_phrases": [
                        "libérer de la chaleur",
                        "libérer de l'énergie",
                        "libérer un gaz"
                    ]
