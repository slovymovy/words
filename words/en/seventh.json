{
    "word_family": [
        "seven",
        "seventeen",
        "seventy",
        "seventeenth",
        "seventieth",
        "seventhly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "faba3c1f-365f-37fd-84fb-2dca2dcf1667",
                    "sense_definition": "The ordinal form of the number <w>seven</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordinal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>seventh</w> time I have called you today.",
                            "target_lang_translations": {
                                "ru": "Это уже <w>седьмой</w> раз, когда я звоню тебе сегодня.",
                                "zh": "这是我今天<w>第七</w>次给你打电话了。"
                            }
                        },
                        {
                            "text": "They live on the <w>seventh</w> floor of the apartment building.",
                            "target_lang_translations": {
                                "ru": "Они живут на <w>седьмом</w> этаже многоквартирного дома.",
                                "zh": "他们住在公寓楼的<w>第七</w>层。"
                            }
                        }
                    ],
                    "synonyms": [
                        "7th",
                        "VII"
                    ],
                    "common_phrases": [
                        "seventh heaven",
                        "seventh grade",
                        "seventh son",
                        "seventh day"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порядковое числительное, соответствующее числу семь.",
                        "zh": "数字七的序数形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седьмой",
                                "target_lang_sense_clarification": "порядковый номер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第七",
                                "target_lang_sense_clarification": "用于表示顺序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7bbbb09a-1f84-34d2-8b76-38840fef8222",
                    "sense_definition": "The person or thing in the seventh position.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ordinal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was the <w>seventh</w> to finish the race.",
                            "target_lang_translations": {
                                "ru": "Она пришла к финишу <w>седьмой</w>.",
                                "zh": "她是<w>第七名</w>跑完比赛的。"
                            }
                        },
                        {
                            "text": "My birthday is on the <w>seventh</w> of July.",
                            "target_lang_translations": {
                                "ru": "Мой день рождения <w>седьмого</w> июля.",
                                "zh": "我的生日是七月<w>七号</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "7th"
                    ],
                    "common_phrases": [
                        "the seventh of",
                        "July the seventh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, занимающий седьмое место в ряду; также используется для обозначения даты.",
                        "zh": "处于第七位的人或事物，或指月份中的第七天。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седьмой",
                                "target_lang_sense_clarification": "человек или предмет"
                            },
                            {
                                "target_lang_word": "седьмое",
                                "target_lang_sense_clarification": "число месяца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第七名",
                                "target_lang_sense_clarification": "用于排名"
                            },
                            {
                                "target_lang_word": "七号",
                                "target_lang_sense_clarification": "用于日期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "446405dc-8a47-376a-9079-69d7b8680bcf",
                    "sense_definition": "One of <w>seven</w> equal parts of a whole.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fraction_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He inherited a <w>seventh</w> of the large estate.",
                            "target_lang_translations": {
                                "ru": "Он унаследовал одну <w>седьмую</w> большого поместья.",
                                "zh": "他继承了那份大地产的<w>七分之一</w>。"
                            }
                        },
                        {
                            "text": "Only about one <w>seventh</w> of the group agreed with the plan.",
                            "target_lang_translations": {
                                "ru": "Лишь около одной <w>седьмой</w> группы согласились с планом.",
                                "zh": "小组中只有大约<w>七分之一</w>的人同意这个计划。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "one seventh",
                        "two sevenths"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из семи равных частей целого.",
                        "zh": "整体的七分之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седьмая",
                                "target_lang_sense_clarification": "доля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "七分之一",
                                "target_lang_sense_clarification": "分数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b68db4e0-33cb-362a-8859-e6b16e6b8f86",
                    "sense_definition": "A musical interval spanning seven degrees of the diatonic scale.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The composer resolved the dominant <w>seventh</w> to the tonic.",
                            "target_lang_translations": {
                                "ru": "Композитор разрешил доминантовую <w>септиму</w> в тонику.",
                                "zh": "作曲家将属<w>七度</w>和弦解决到了主和弦上。"
                            }
                        },
                        {
                            "text": "This chord features a major <w>seventh</w> that creates a jazzy sound.",
                            "target_lang_translations": {
                                "ru": "Этот аккорд содержит большую <w>септиму</w>, создающую джазовое звучание.",
                                "zh": "这个和弦包含一个大<w>七度</w>音，营造出一种爵士乐的音色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "major seventh",
                        "minor seventh",
                        "dominant seventh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный интервал, охватывающий семь ступеней диатонической гаммы.",
                        "zh": "跨越自然音阶七个音级的音乐音程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "септима",
                                "target_lang_sense_clarification": "музыкальный интервал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "七度",
                                "target_lang_sense_clarification": "音乐术语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}