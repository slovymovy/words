                                        "entry_id": "301062e4-9a06-338c-b25c-4784b2f9705c",
                                        "glosses": [
                                            "teoria secondo cui le leggi della natura non possono subire stravolgimenti ed avvengono in modo meccanicistico, teoria quindi contraria alla fede nei miracoli e nella provvidenza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e5f4ad-8c7f-4c1f-8243-71b8306fa6eb",
                                                "sense_id": "d7c4db1b-167a-3c54-ae09-05051039620a",
                                                "text": "quanto detto secondo la filosofia del determinismo si avvicina molto alla concezione del libero arbitrio pur avendo Dio prestabilito tutto"
                                            }
