                    {
                        "sense_id": "bc36251f-8e72-32e1-96af-e8532172daf5",
                        "entry_id": "e26f9af0-b7e2-30aa-a651-1f9329dbe29b",
                        "glosses": [
                            "een aantrekkelijk uitzicht om je heen gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b22e020c-acb2-4d45-b7fc-bc959849dd74",
                                "sense_id": "bc36251f-8e72-32e1-96af-e8532172daf5",
                                "text": "Het moet wel zo groot zijn om landschappelijk te werken, maar het is ingehouden."
                            }
                        ]
                    },
                    {
                        "sense_id": "f44b3722-0e6a-31a9-aae7-ca91b7055fb3",
                        "entry_id": "e26f9af0-b7e2-30aa-a651-1f9329dbe29b",
                        "glosses": [
                            "ingericht om op vrije natuur te lijken"
                        ],
                        "tags": [
                            "van parken en tuinen"
                        ],
                        "examples": [
                            {
                                "example_id": "6574055a-6da3-4c9e-8fa5-989b4e5a0172",
                                "sense_id": "f44b3722-0e6a-31a9-aae7-ca91b7055fb3",
                                "text": "De landschappelijk aangelegde parken verschilden niet alleen van de formele parken in stijl."
                            }
                        ]
                    },
                    {
                        "sense_id": "fae264ee-cb21-3e2b-99ac-aa5a7b3236c8",
                        "entry_id": "e26f9af0-b7e2-30aa-a651-1f9329dbe29b",
                        "glosses": [
                            "van niet of weinig bebouwd terrein, dat je om je heen kunt zien liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ea508a6-0574-4181-852c-fa221dbe9f67",
                                "sense_id": "fae264ee-cb21-3e2b-99ac-aa5a7b3236c8",
                                "text": "Het is landschappelijk uiterst gevarieerd, ruw en rotsig in de hoge bergen, liefelijk en agrarisch in de dalen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a0715fa-1745-38d1-98da-76e83ba6a105",
                        "entry_id": "e26f9af0-b7e2-30aa-a651-1f9329dbe29b",
                        "glosses": [
                            "niet verstedelijkt, provinciaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e97540e-01b0-4db2-9d89-cbcbbe1f7334",
                                "sense_id": "4a0715fa-1745-38d1-98da-76e83ba6a105",
                                "text": "In de polder Waard-Nieuwland en in het Robbenoordbos wil men landschappelijk gelegen woningen bouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "959372c3-64d5-38d5-8bd4-15085439fd5c",
                        "entry_id": "e26f9af0-b7e2-30aa-a651-1f9329dbe29b",
                        "glosses": [
                            "op een bepaalde streek betrekking hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b579a81b-f1b6-40c6-8a90-f0856b9c11d4",
                                "sense_id": "959372c3-64d5-38d5-8bd4-15085439fd5c",
                                "text": "En dat het bisdom Luik als kultuurgebied waaruit Veldeke dient verklaard te worden zou kunnen samenvallen met het landschappelijk begrip Limburgs-Maaslands."
                            }
                        ]
                    }
