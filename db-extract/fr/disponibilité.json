                        "target_lang_word": "Verfügbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfügbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef000e5c-9282-3964-892c-aaf83f0de954",
                                        "entry_id": "2727d24d-9c90-371a-8eaa-5ce8ec365256",
                                        "glosses": [
                                            "relative Zeitangabe, während der ein System genutzt werden kann"
                                        ],
                                        "tags": [],
