                        "cross_references": [
                            {
                                "target_word": "guava",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb05bd6b-e4bd-33c6-83a6-4d4ec1b03784",
                                        "entry_id": "39adabd7-a5f6-3a93-ac4c-7defef42df42",
                                        "glosses": [
                                            "A tropical tree or shrub of the myrtle family, Psidium guajava."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "617638fb-218b-3a0b-a722-5d670ec4ac79",
                                        "entry_id": "39adabd7-a5f6-3a93-ac4c-7defef42df42",
                                        "glosses": [
                                            "Its yellowish tropical fruit, globular or pear-shaped with thin, yellow, green or brown skin, is often made into jams and jellies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66726ca5-2a62-46ec-bc64-ab01ef545840",
                                                "sense_id": "617638fb-218b-3a0b-a722-5d670ec4ac79",
                                                "text": "CREAM CHEESE AND GUAVA JELLY SANDWICH: Spread an equal number of slices of lightly buttered white bread with guava jelly and cream cheese. Put slices together and trim the edges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16cdd002-6fb8-3a3c-b207-ce0191f7c395",
                                        "entry_id": "39adabd7-a5f6-3a93-ac4c-7defef42df42",
                                        "glosses": [
                                            "A medium reddish-pink color, like that of guava flesh (also called guava pink)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "204cc710-8567-49e5-a7d1-334088708eea",
                        "source_entry_id": "6fb1477b-9b61-3621-bab1-ce21d0fae585",
                        "source_sense_id": "99b18e66-80dd-33ef-8388-a1603b8a8e36",
                        "target_lang_word": "goyavier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goyavier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b41089bc-23f9-3c52-9e88-045499e22dca",
                                        "entry_id": "bfbee3ab-5b95-35ca-88c0-de2b9531d4df",
                                        "glosses": [
                                            "Arbre originaire des régions tropicales pouvant atteindre 8 mètres de haut exploité pour ses fruits, les goyaves. Son nom scientifique est Psidium guajava de la famille des Myrtacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c06a65-a962-4066-90f3-b6c8d1eea607",
                                                "sense_id": "b41089bc-23f9-3c52-9e88-045499e22dca",
                                                "text": "Nous nous élevons rapidement et ne tardons pas à quitter la zone des cultures tropicales et subtropicales des terres basses. […] ; aux dattiers, aux dragonniers, aux manguiers, aux anoniers, aux avocatiers, aux goyaviers succèdent les arbres fruitiers des régions méditerranéennes, puis de l'Europe centrale. Nous montons toujours."
                                            },
                                            {
                                                "example_id": "9275f933-82b1-42af-a53c-3478d1971497",
                                                "sense_id": "b41089bc-23f9-3c52-9e88-045499e22dca",
                                                "text": "Ce sont des arbres fruitiers (manguiers paysagers, goyaviers, cocotiers) et des arbres d’ornement."
                                            },
                                            {
                                                "example_id": "d2ca52d1-4c74-4fb3-bc28-5bc6b374c98b",
                                                "sense_id": "b41089bc-23f9-3c52-9e88-045499e22dca",
                                                "text": "L’auteur décrit ces pratiques comme la recherche d’une harmonie entre les pôles « chaud » et « froid », éléments de base du système de classification. Cet équilibre associe espèces ligneuses (cèdre pour la construction, avocat, goyavier, orangers et autres agrumes) et non ligneuses, qu’elles soient sauvages, adventices comestibles ou médicinales, et espèces cultivées, notamment les différentes variétés de maïs – le maïs rouge étant « le chef » de cette céréale, la variété qui entraîne les autres et permet de maintenir les cycles végétaux et religieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eb22174-4724-3198-a04c-3e02c261e514",
                                        "entry_id": "bfbee3ab-5b95-35ca-88c0-de2b9531d4df",
                                        "glosses": [
                                            "Fruit du goyavier de Chine."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c0af5ad-6ab8-4083-b5f1-294fc8e5aa01",
                                                "sense_id": "1eb22174-4724-3198-a04c-3e02c261e514",
                                                "text": "En effet, les goyaviers sont fréquemment cités comme remède en cas de coliques ou de diarrhées."
                                            },
                                            {
                                                "example_id": "bed0c26f-99a3-48c3-9a49-1d40a16186f2",
                                                "sense_id": "1eb22174-4724-3198-a04c-3e02c261e514",
                                                "text": "L'hiver austral nous prive des sublimes litchis, mangues ou longanes, mais on s'émerveille devant les piles d'ananas victoria, le rouge profond des goyaviers, les caramboles aux formes étoilées, les agrumes locaux comme le tangor à la peau vert orangé, le minuscule citron galet ou le combawa fripé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
