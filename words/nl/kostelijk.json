                    ],
                    "synonyms": [
                        "duur"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd voor 'duur' of 'prijzig'"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "qui coûte beaucoup d'argent; dispendieux ou onéreux"
