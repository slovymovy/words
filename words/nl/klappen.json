                {
                    "sense_id": "363dd695-a6fe-3f02-9470-eefe824d36a0",
                    "sense_definition": "In de handen slaan om geluid te maken, vaak als teken van waardering of op het ritme van muziek.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het publiek begon luid te <w>klappen</w> toen de voorstelling was afgelopen.",
                            "target_lang_translations": {
                                "en": "The audience started to <w>clap</w> loudly when the performance was over.",
                                "ru": "Зрители начали громко <w>аплодировать</w>, когда представление закончилось.",
                                "fr": "Le public a commencé à <w>applaudir</w> fort lorsque le spectacle s'est terminé."
                            }
                        },
                        {
                            "text": "De kinderen <w>klappen</w> vrolijk mee met het liedje.",
                            "target_lang_translations": {
                                "en": "The children <w>clap</w> along cheerfully with the song.",
                                "ru": "Дети весело <w>хлопают</w> в такт песне.",
                                "fr": "Les enfants <w>frappent des mains</w> joyeusement en rythme avec la chanson."
                            }
                        }
                    ],
                    "synonyms": [
                        "applaudisseren"
                    ],
                    "common_phrases": [
                        "in de handen klappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To strike the hands together to make noise, often as a sign of appreciation or to the rhythm of music.",
                        "ru": "Бить в ладоши, чтобы издать звук, часто в знак одобрения или в такт музыке.",
                        "fr": "Frapper dans ses mains pour faire du bruit, souvent en signe d'appréciation ou au rythme de la musique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clap",
                                "target_lang_sense_clarification": "to strike palms together"
                            },
                            {
                                "target_lang_word": "applaud",
                                "target_lang_sense_clarification": "to show approval by clapping"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хлопать",
                                "target_lang_sense_clarification": "бить в ладоши"
                            },
                            {
                                "target_lang_word": "аплодировать",
                                "target_lang_sense_clarification": "выражать одобрение хлопками"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "applaudir",
                                "target_lang_sense_clarification": "battre des mains en signe d'approbation"
                            },
                            {
                                "target_lang_word": "claquer des mains",
                                "target_lang_sense_clarification": "frapper dans ses mains"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7082acad-0382-31d9-9db0-f0c2f7df29db",
                    "sense_definition": "Plotseling kapotgaan of uit elkaar springen met een hard geluid, vaak door te hoge druk.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "burst_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je de ballon te ver opblaast, zal hij <w>klappen</w>.",
                            "target_lang_translations": {
                                "en": "If you blow up the balloon too much, it will <w>pop</w>.",
                                "ru": "Если ты слишком сильно надуешь шарик, он <w>лопнет</w>.",
                                "fr": "Si tu gonfles trop le ballon, il va <w>éclater</w>."
                            }
                        },
                        {
                            "text": "Zijn achterband <w>klapte</w> toen hij over een scherp stuk glas reed.",
                            "target_lang_translations": {
                                "en": "His rear tire <w>burst</w> when he drove over a sharp piece of glass.",
                                "ru": "Его задняя шина <w>лопнула</w>, когда он наехал на острый кусок стекла.",
                                "fr": "Son pneu arrière a <w>éclaté</w> lorsqu'il a roulé sur un morceau de verre tranchant."
                            }
                        }
                    ],
                    "synonyms": [
                        "knallen",
                        "ontploffen",
                        "springen"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly break or burst apart with a loud noise, often due to excessive pressure.",
                        "ru": "Внезапно ломаться или разрываться с громким звуком, часто из-за высокого давления.",
                        "fr": "Eclater ou se rompre soudainement avec un bruit fort, souvent à cause d'une pression trop élevée."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burst",
                                "target_lang_sense_clarification": "to break open suddenly"
                            },
                            {
                                "target_lang_word": "pop",
                                "target_lang_sense_clarification": "to explode with a sharp sound"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "лопаться",
                                "target_lang_sense_clarification": "разрываться (о шаре, шине)"
                            },
                            {
                                "target_lang_word": "взрываться",
                                "target_lang_sense_clarification": "разлетаться с шумом"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "éclater",
                                "target_lang_sense_clarification": "se rompre bruyamment (ballon, pneu)"
                            },
                            {
                                "target_lang_word": "exploser",
                                "target_lang_sense_clarification": "voler en éclats sous la pression"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7ef48e9-56fc-3b44-afea-82d915957ed1",
                    "sense_definition": "Met kracht en lawaai ergens tegenaan komen, slaan of smijten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burst_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto <w>klapte</w> met hoge snelheid tegen de vangrail.",
                            "target_lang_translations": {
                                "en": "The car <w>crashed</w> into the guardrail at high speed.",
                                "ru": "Машина на большой скорости <w>врезалась</w> в отбойник.",
                                "fr": "La voiture s'est <w>encastrée</w> à grande vitesse contre la glissière de sécurité."
                            }
                        },
                        {
                            "text": "Hij was zo boos dat hij de deur dicht <w>klapte</w>.",
                            "target_lang_translations": {
                                "en": "He was so angry that he <w>slammed</w> the door shut.",
                                "ru": "Он был так зол, что <w>захлопнул</w> дверь.",
                                "fr": "Il était si en colère qu'il a <w>claqué</w> la porte."
                            }
                        }
