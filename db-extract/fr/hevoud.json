                        "glosses": [
                            "Ancien symbole nationaliste breton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8784d61-13e1-492c-8642-e0553427677e",
                                "sense_id": "564b11e4-b74a-305e-afe9-94ffcc821ed6",
                                "text": "C’est lors de ce congrès [du parti nationaliste breton, à Rosporden, le 10 septembre 1927] qu’est adopté l’emblème du parti, l’hevoud, évoquant une croix gammée inversée. — (Chisthophe Belser, La Collaboration en Loire-Inférieure (1940-1944), tome 2 « intelligence avec l’ennemi », Geste éditions, collection histoire, 2004, page 27)"
                            },
                            {
                                "example_id": "a67b6f54-e1c5-4e01-9cf4-232331d075f9",
                                "sense_id": "564b11e4-b74a-305e-afe9-94ffcc821ed6",
                                "text": "Le PNB abandonne l’hevoud [en 1940], trop connoté « hitlérien » pour se rabattre sur le triskèle, roue solaire à trois branches, plus anodin.— (Ibidem, page 29)"
                            }
                        ]
                    }
