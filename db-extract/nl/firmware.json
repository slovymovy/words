                                        "sense_id": "07f7a744-d518-350e-9284-bb2c2e35422d",
                                        "entry_id": "94c187fc-34d7-39cd-88cd-a8c70cd4476f",
                                        "glosses": [
                                            "grundlegende Software eines elektronischen Geräts oder Computer-Bauteils, die üblicherweise in nur lesbaren Speichern abgelegt wird."
                                        ],
                                        "tags": [
                                            "Informationstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33eaa130-ed73-4e2a-b46b-27de40e83ea9",
                                                "sense_id": "07f7a744-d518-350e-9284-bb2c2e35422d",
                                                "text": "Die Firmware der WLAN-Karte enthält auch eine Liste der Frequenzen, die in Deutschland genutzt werden dürfen."
                                            },
                                            {
                                                "example_id": "eea53cdf-403a-49c2-9b5e-2cd312eb73ea",
                                                "sense_id": "07f7a744-d518-350e-9284-bb2c2e35422d",
                                                "text": "„Der Festplattenhersteller Seagate hat in der vergangenen Nacht bekannt gegeben, dass (…) Festplatten dieser Baureihe durch eine fehlerhafte Firmware plötzlich ausfallen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fdbb0931-e297-3f6c-892a-95f97f9f0718",
                                        "entry_id": "94c187fc-34d7-39cd-88cd-a8c70cd4476f",
                                        "glosses": [
                                            "Betriebssystem und Programme eingebetteter Systeme (zum Beispiel in Waschmaschinen, Mobiltelefonen und DVD-Playern)"
                                        ],
                                        "tags": [
                                            "Informationstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea1549d2-e134-42f6-8be6-c92de41b8636",
                                                "sense_id": "fdbb0931-e297-3f6c-892a-95f97f9f0718",
                                                "text": "„Mit einer neuen Firmware ermöglicht Brother beim Fax-2920 eine neue Funktion: den Mehrfachausdruck von eingehenden Faxen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
