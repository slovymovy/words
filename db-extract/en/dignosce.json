                        "sense_id": "3e93ab42-e314-3f43-8f22-7eed7d5df2c7",
                        "entry_id": "1c92b50f-d3e3-3a7c-bff2-eb7742a5e64e",
                        "glosses": [
                            "to discern"
                        ],
