                        "examples": [
                            {
                                "example_id": "6a514304-0e03-48c3-a463-6a2404514581",
                                "sense_id": "bd3cff3b-cbb7-390f-bc4f-96fa3a687fa4",
                                "text": "In zijn wijk worden meer dan honderd woningen via Airbnb aangeboden, waarvan vijftig permanent, zegt Van der Sluijs. Hij heeft een bewonersplatform opgericht om de wildgroei aan toeristenaccommodaties in zijn buurt tegen te gaan."
                            },
                            {
                                "example_id": "2a734c19-e077-482d-a430-0bef86b115d4",
                                "sense_id": "bd3cff3b-cbb7-390f-bc4f-96fa3a687fa4",
                                "text": "Volgens Woningcorporatie Rijswijk Wonen heeft een flink deel van de huurders aangegeven dat zij het Glazen Huis daar niet prettig vinden. Het bewonersplatform zegt dat dat er maar zes van de negentig waren."
                            }
