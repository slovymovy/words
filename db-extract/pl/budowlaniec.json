                        "translation_id": "8513d640-b96f-46b2-9c3e-6dc9ef2053a0",
                        "source_entry_id": "58721327-6365-354e-866c-7f368299d0a4",
                        "source_sense_id": "1657f89c-5240-33c7-9652-954b1ce0b11a",
                        "target_lang_word": "builder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "builder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f05f69e-736f-3711-9ca1-fb034cc5907f",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "One who builds or constructs things."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7865ca8-e777-3293-a867-20ecf089d7a4",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Master artisan, who receives his instructions from the architect, and employs workers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Software that allows the user to create a certain kind of (often automated) output."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d267eb9-1e8f-439f-8eb3-b1fd556a5b25",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "To cut coding time and to insure maintainability of the algorithms, an \"algorithm builder tool\" was constructed."
                                            },
                                            {
                                                "example_id": "47571c3b-a2f4-4974-bafe-5751df544be8",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "A map builder uses map layers from several sources and adds data to make a custom map."
                                            },
                                            {
                                                "example_id": "8e858f5a-9124-4693-9d33-192843b7cd8d",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "Many users may find this easier to use as each field is clearly displayed and the user interface provides a formula builder and a Check formula function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Clipping of bodybuilder."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513f63e5-e3a6-410d-a092-2caa37268f9d",
                                                "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                                                "text": "In the competitions, bodybuilders go through \"mandatories\"—a set of mandatory poses—in the morning, where the judges compare the body parts of the builders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
