                "senses": [
                    {
                        "sense_id": "aa861a90-c419-395c-bc26-830b430fc82f",
                        "entry_id": "6f645c26-4f6a-36ae-a022-abb1583568e2",
                        "glosses": [
                            "ucięcie głowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71dcf7e8-2060-46c5-9ea7-7adcb7300138",
                                "sense_id": "aa861a90-c419-395c-bc26-830b430fc82f",
                                "text": "W dawnych czasach dekapitacja była często stosowaną karą śmierci."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbbb0b0d-7556-45a4-ae1b-f08ba05922d7",
                        "source_entry_id": "6f645c26-4f6a-36ae-a022-abb1583568e2",
                        "source_sense_id": "aa861a90-c419-395c-bc26-830b430fc82f",
                        "target_lang_word": "decapitation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decapitation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0247c3c4-0028-3369-b2be-ed03e71b3d4e",
                                        "entry_id": "28a5b36a-25b4-380d-96e5-0467e3abdb03",
                                        "glosses": [
                                            "Beheading; the act of beheading or decapitating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09789a79-e9eb-404d-aef2-eb08b6eba0b1",
                                                "sense_id": "0247c3c4-0028-3369-b2be-ed03e71b3d4e",
                                                "text": "If the headsman's axe was sharp and his aim was true, decapitation was a quick and relatively painless form of death."
                                            },
                                            {
                                                "example_id": "2e832160-14ee-435e-af28-10004cbae4db",
                                                "sense_id": "0247c3c4-0028-3369-b2be-ed03e71b3d4e",
                                                "text": "The tortoise, possessing, like the serpent, the power of retaining life in its limbs after mutilation or decapitation, became a symbol of androgynity as well as of immortality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adf255a-d98e-3e18-bb9d-4e35f11df62c",
                                        "entry_id": "28a5b36a-25b4-380d-96e5-0467e3abdb03",
                                        "glosses": [
                                            "The ousting or destruction of the ruling body of a government or other organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b51f1cd0-b3ba-458c-9de7-c7e468eecdba",
                                                "sense_id": "8adf255a-d98e-3e18-bb9d-4e35f11df62c",
                                                "text": "A decapitation strike carried out by drone killed many of the country's senior generals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8c583c8-cf04-3c81-80dd-b9674f24451b",
                                        "entry_id": "28a5b36a-25b4-380d-96e5-0467e3abdb03",
                                        "glosses": [
                                            "The unseating of a senior politician."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00290505-ae1a-407a-a53a-fec73ab93400",
                                                "sense_id": "e8c583c8-cf04-3c81-80dd-b9674f24451b",
                                                "text": "The decapitation of the Foreign Secretary was a significant publicity coup for the opposition."
                                            },
                                            {
                                                "example_id": "ad8854bb-5ba5-4d82-9441-d3d7f736c3f6",
                                                "sense_id": "e8c583c8-cf04-3c81-80dd-b9674f24451b",
                                                "text": "The Lib Dem contender hoping to accomplish a bit of pre-emptive decapitation is Andrew Crawford."
                                            },
                                            {
                                                "example_id": "8885772b-abdf-4cca-baa7-f399597a362b",
                                                "sense_id": "e8c583c8-cf04-3c81-80dd-b9674f24451b",
                                                "text": "Some also thought that the Lib Dem decapitation strategy had kept him cornered in his constituency during the campaign, unable to play a wider role."
                                            },
                                            {
                                                "example_id": "daa2e526-d6b5-4d91-95dc-fa73e4964527",
                                                "sense_id": "e8c583c8-cf04-3c81-80dd-b9674f24451b",
                                                "text": "Nearing 2.30, stoking fears of a disastrous night for the Lib Dems, the Tories achieved their first \"decapitation\" ‑ a visibly shocked Lembit Opik, in once-safe Montgomeryshire ‑ while evading their own biggest risk of high-profile embarrassment: Oliver Letwin held Dorset West."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9530fdb7-7526-493c-9bc6-d88183d588df",
                        "source_entry_id": "6f645c26-4f6a-36ae-a022-abb1583568e2",
                        "source_sense_id": "aa861a90-c419-395c-bc26-830b430fc82f",
                        "target_lang_word": "décapitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décapitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c99efce-909d-39d4-b082-5a1a6f7b5520",
                                        "entry_id": "c5527f35-32bd-3317-86d3-4f2e565127b5",
                                        "glosses": [
                                            "Action de décapiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db38b03e-8f41-4126-93be-7ea5ca94efdb",
                                                "sense_id": "4c99efce-909d-39d4-b082-5a1a6f7b5520",
                                                "text": "Le crapaud a la vie très dure. Il survit plusieurs heures à la décapitation, plusieurs jours à l'avulsion du cœur, quarante jours à l'ablation des poumons, plusieurs semaines à l'amputation du museau en arrière des yeux."
                                            },
                                            {
                                                "example_id": "0c1c2c75-8a1a-4e2a-b7b4-b4045267cb91",
                                                "sense_id": "4c99efce-909d-39d4-b082-5a1a6f7b5520",
                                                "text": "En Arabie saoudite, l'apostasie est passible de la peine de mort par décapitation au sabre."
                                            },
                                            {
                                                "example_id": "b11c10f8-174c-4564-b37e-d14ca51f7f68",
                                                "sense_id": "4c99efce-909d-39d4-b082-5a1a6f7b5520",
                                                "text": "Qu'une femme, témoin de la décapitation de son père et de son époux, ait pu \"être heureuse dans les bras du Prophète\", comme dit le texte, me semble impossible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77ab7e2d-e613-4706-b497-5cb80a971a07",
                        "source_entry_id": "6f645c26-4f6a-36ae-a022-abb1583568e2",
                        "source_sense_id": "aa861a90-c419-395c-bc26-830b430fc82f",
