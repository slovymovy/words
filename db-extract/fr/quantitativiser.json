                        "glosses": [
                            "Donner un caractère quantitatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d7e9d3f-ed5d-4a11-a1f7-0ef968a06d2a",
                                "sense_id": "52f27f6a-92ae-3ea1-8df3-fdf678bf805d",
                                "text": "L’orientation de l’agir économique sur l’argent code la rareté par un symbole capable de la quantitativiser de manière continue et complète."
                            },
                            {
                                "example_id": "cb999b29-b0d4-4545-8452-9ab2b57edb8e",
                                "sense_id": "52f27f6a-92ae-3ea1-8df3-fdf678bf805d",
                                "text": "La manière privilégiée de traiter ici la masse d'informations consiste, à partir de ce matériau qualitatif que l’on pourrait dire «quantitativisé», à construire une typologie fondée sur l’analyse extensive de la diversité des entretiens."
                            }
                        ]
                    }
