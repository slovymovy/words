                "senses": [
                    {
                        "sense_id": "caa1a89d-4897-30cd-9354-50e179657410",
                        "entry_id": "65e5fb82-647d-315a-a2af-e72160ec7ec3",
                        "glosses": [
                            "Zeichen, das auf die Hochwertigkeit von etwas hindeutet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3ea2e4-9f4b-4c15-b693-658c2033d269",
                                "sense_id": "caa1a89d-4897-30cd-9354-50e179657410",
                                "text": "„Allein in Deutschland gibt es mehr als tausend Gütesiegel, Handelsmarken, Qualitätszeichen und Logos, stellte die Verbraucherorganisation ‚foodwatch‘ fest.“"
                            },
                            {
                                "example_id": "9b506bc1-87d9-4516-9c5c-d1797a6b9395",
                                "sense_id": "caa1a89d-4897-30cd-9354-50e179657410",
                                "text": "„Wenn die Mortadella aus der Provinz Bologna stammt, trägt sie das Qualitätszeichen IGP (indicazione geografica protetta).“"
                            },
                            {
                                "example_id": "ca2f2b34-4e5f-464b-9c48-65618b0bad99",
                                "sense_id": "caa1a89d-4897-30cd-9354-50e179657410",
                                "text": "„Aus dem Kühlschrank wird nicht nur fair gehandelter Orangensaft sondern auch Greyerzer Käse, der das Qualitätszeichen Appellation d'Origine Protégée (AOP) trägt, hervorgeholt.“"
                            },
                            {
                                "example_id": "4cdedc82-b461-49e1-8ca3-60ddc3f0543c",
                                "sense_id": "caa1a89d-4897-30cd-9354-50e179657410",
                                "text": "„Somit stellt die Akkreditierung ein Gütesiegel und Qualitätszeichen dar und gibt dem Patienten auch die Sicherheit, dass er qualitativ hochwertig versorgt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
