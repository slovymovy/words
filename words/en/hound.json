                },
                {
                    "sense_id": "3f8d5b7e-cebb-3675-a416-270dbbc6aaff",
                    "sense_definition": "A despicable or contemptible person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get out of my sight, you lying <w>hound</w>!",
                            "target_lang_translations": {
                                "nl": "Verdwijn uit mijn ogen, leugenachtige <w>hond</w>!"
                            }
                        },
                        {
                            "text": "He felt like a miserable <w>hound</w> after betraying his best friend.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich een ellendige <w>schoft</w> nadat hij zijn beste vriend had verraden."
                            }
