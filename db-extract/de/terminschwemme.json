                        ],
                        "examples": [
                            {
                                "example_id": "6a65faac-60ac-4fc0-b619-7463a8eac484",
                                "sense_id": "76c8e294-c3ca-3d1a-8def-b1b727e956a1",
                                "text": "„Die Terminschwemme produziert Ermüdungserscheinungen.“"
                            },
                            {
                                "example_id": "00c885e7-2f6a-4302-83df-dddf6829496f",
                                "sense_id": "76c8e294-c3ca-3d1a-8def-b1b727e956a1",
                                "text": "„Terminschwemme, Überforderung und Freizeitstress sollen jedoch nicht Gegenstand dieser Kolumne sein.“"
                            },
                            {
                                "example_id": "525e7391-a457-4d91-af0e-59bfb56a708a",
                                "sense_id": "76c8e294-c3ca-3d1a-8def-b1b727e956a1",
                                "text": "„Im Gartenschaujahr 2011 aber konnte er die Terminschwemme nicht mehr bewältigen, deshalb suchte er sich Verstärkung.“"
                            },
                            {
                                "example_id": "eb47de9d-b8b1-4dff-a592-8089219de9a1",
                                "sense_id": "76c8e294-c3ca-3d1a-8def-b1b727e956a1",
                                "text": "„Wer geglaubt hat, beim Hersfelder Hessentag sei viel los gewesen, der hat die Terminschwemme dieses und des nächsten Wochenenden noch nicht gesehen […].“"
                            },
                            {
                                "example_id": "b601700f-20a6-4bd8-bf66-0d9dd1e909da",
                                "sense_id": "76c8e294-c3ca-3d1a-8def-b1b727e956a1",
                                "text": "„Vor allem aber die Terminschwemme für die Klubs hat die Hallenturniere zurückgedrängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
