                        "form": "aankomsten"
                    },
                    {
                        "form_id": "c2ec8132-138b-4252-9c83-977843cf2750",
                        "entry_id": "44cb7393-9dc3-3ec5-b775-0520dbe83be5",
                        "tags": [
                            "diminutive",
