                        "bloquer le passage",
                        "bloquer l'accès"
                    ]
                },
                {
                    "sense_id": "04b0687e-cc07-3f2c-8405-d1448b206b1f",
                    "sense_definition": "Empêcher le fonctionnement normal, l'utilisation ou le mouvement de quelque chose, notamment un compte ou un appareil.",
