                        "glosses": [
                            "To format a document, particularly a legal document including citations, according to the rules of the Bluebook, a US style guide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b6ba66-58da-4555-ba06-91140c559098",
                                "sense_id": "e98e1841-2163-3916-a6af-ac11c38c5c9f",
                                "text": "After all, the nonmember author who has never participated in the endless chores of bluebooking and typing is more successful than most law review members in writing a piece of publishable quality."
                            }
                        ]
                    },
