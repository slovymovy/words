                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ceef952e-c1f3-37c9-a764-5bca2f597c3d",
                        "entry_id": "fc6441f1-2550-3885-9ccf-ec736c7abdcd",
                        "glosses": [
                            "onvoltooid deelwoord van rusten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "b60f00fa-9eb0-4857-9f8d-fb81f5745c09",
                                "sense_id": "ceef952e-c1f3-37c9-a764-5bca2f597c3d",
                                "text": "Het werk is volgens hem tussen de 80.000 en 100.000 euro waard. Op het schilderijtje (uit 1620) van 17 centimeter doorsnede staat een boerenechtpaar afgebeeld, rustend bij een boom na het hooien. De signatuur is verwerkt in de stam van de boom, en is van boven naar beneden leesbaar. Hoogsteder is er zeker van dat het een origineel betreft „door de opstaande verf, die wordt veroorzaakt door het krimpen van het houten paneel.”"
                            }
                        ]
                    }
