                    {
                        "sense_id": "3fea67cb-45ec-3a06-92a7-7a7019ba5281",
                        "entry_id": "899fb00b-2bcd-3c03-a538-5357001438ad",
                        "glosses": [
                            "To undergo the process of burning in reverse."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5102788b-970c-4a54-869c-0136f7a7432b",
                                "sense_id": "3fea67cb-45ec-3a06-92a7-7a7019ba5281",
                                "text": "Similarly, you cannot 'unstir' the sugar from a cup of coffee once it has been dissolved, and you never see a pile of ash in the fireplace 'unburn' to become a log of wood again."
                            },
                            {
                                "example_id": "77c4fe64-591f-48d3-a7fe-2a480eb18df1",
                                "sense_id": "3fea67cb-45ec-3a06-92a7-7a7019ba5281",
                                "text": "In your class last year we learned that increase in entropy is why matches burn but never unburn, why cans rust but never unrust, and why engines are never perfectly efficient."
                            }
                        ]
                    }
