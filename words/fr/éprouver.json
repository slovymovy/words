{
    "word_family": [
        "épreuve",
        "éprouvant",
        "éprouvette"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1449a5c0-d752-3923-98a1-ff574ad58eee",
                    "sense_definition": "Ressentir une émotion, un sentiment, ou percevoir une sensation physique ou morale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ressentir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>éprouvé</w> un immense soulagement en apprenant cette bonne nouvelle."
                        },
                        {
                            "text": "Elle <w>éprouve</w> une grande fierté à voir ses élèves réussir leurs examens."
                        }
                    ],
                    "common_phrases": [
                        "éprouver un sentiment",
                        "éprouver de la fierté",
                        "éprouver le besoin"
                    ]
                },
                {
                    "sense_id": "a0a76fef-dba6-37ae-a668-79c905a9f932",
                    "sense_definition": "Soumettre une personne à des difficultés, à la souffrance ou à la fatigue ; tester son endurance morale ou physique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tester",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette longue maladie a lourdement <w>éprouvé</w> toute la famille pendant plusieurs mois."
                        },
                        {
                            "text": "Les questions insistantes du journaliste commençaient à <w>éprouver</w> la patience du ministre."
                        }
                    ],
                    "synonyms": [
                        "mettre à l'épreuve"
                    ],
                    "common_phrases": [
                        "éprouver la patience",
                        "éprouver les forces"
                    ]
                },
                {
                    "sense_id": "a26ffe94-0044-3557-9f86-a53e51db7c76",
                    "sense_definition": "Vérifier la résistance, la qualité ou le bon fonctionnement d'un objet, d'un matériau ou d'une méthode.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tester",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs doivent <w>éprouver</w> la solidité des nouveaux matériaux avant la construction."
                        },
                        {
                            "text": "Le laboratoire a <w>éprouvé</w> ce traitement afin d'en vérifier scientifiquement l'efficacité."
                        }
                    ],
                    "synonyms": [
                        "mettre à l'épreuve"
                    ],
                    "common_phrases": [
                        "éprouver la résistance",
                        "éprouver la solidité"
                    ]
                },
                {
                    "sense_id": "9bacce52-975c-3c06-8eaf-34b183978acb",
                    "sense_definition": "Subir une altération, un dommage ou des variations sous l'effet d'une cause extérieure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux pont a <w>éprouvé</w> d'importantes dégradations à la suite des récentes inondations."
                        },
                        {
                            "text": "Sous l'action d'une forte chaleur, la structure métallique <w>éprouve</w> une déformation visible."
                        }
                    ],
                    "common_phrases": [
                        "éprouver des altérations",
                        "éprouver des secousses"
                    ]
                }
            ]
        }
    ]
}