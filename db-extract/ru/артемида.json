                    {
                        "translation_id": "40218b32-e15b-4c25-917e-f0cb4c1b9f25",
                        "source_entry_id": "314df3fd-fe73-3eda-af8b-7e4d5c3bb086",
                        "source_sense_description": "богиня",
                        "target_lang_word": "Artémis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Artémis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b2eeb43-60c2-35e4-b67f-c4636123e615",
                                        "entry_id": "a0c8d43c-d57b-3ae2-a598-a95bbf055a9b",
                                        "glosses": [
                                            "Déesse vierge grecque de la chasse et de la Lune, sœur jumelle d’Apollon."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87749f8d-c1f3-4e39-997b-c169128ac5c2",
                                                "sense_id": "5b2eeb43-60c2-35e4-b67f-c4636123e615",
                                                "text": "Elle dit, le front détourné,\nCar l’être solitaire\nGarde en son cœur prédestiné\nLe songe et le mystère ;\nL’herbe a des bleus froids de lapis\nQue percent des éclairs d’iris,\nEt, triomphante, l’Artémis\nIllumine la terre."
                                            },
                                            {
                                                "example_id": "2f49c11e-f2ea-48fd-85f4-f83dc741054a",
                                                "sense_id": "5b2eeb43-60c2-35e4-b67f-c4636123e615",
                                                "text": "Artémis, aux cheveux surmontés d’un croissant,\nDans sa froide beauté triomphante, et froissant\nSous ses pieds lumineux les fleurs de la broussaille,\nSans redouter le vent sauvage qui l’assaille,\nD’un élan vigoureux s’avance au fond des bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fcefa1e-7226-3b1c-9671-b000c59feda4",
                                        "entry_id": "a0c8d43c-d57b-3ae2-a598-a95bbf055a9b",
                                        "glosses": [
                                            "(105) Artémis, internationalement (105) Artemis, planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
