{
    "word_family": [
        "swatching"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6b06eca-9d4a-3342-a6e4-996fec63f8c6",
                    "sense_definition": "A small sample or piece of fabric or material used to show color, texture, or quality.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sample",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held a <w>swatch</w> of the wallpaper up to see if the colors would match the room.",
                            "target_lang_translations": {
                                "de": "Er hielt ein <w>Tapetenmuster</w> hoch, um zu sehen, ob die Farben zum Raum passten."
                            }
                        },
                        {
                            "text": "Fabric <w>swatches</w> are free, so you can test the material before buying a large amount.",
                            "target_lang_translations": {
                                "de": "<w>Stoffmuster</w> sind kostenlos, sodass man das Material testen kann, bevor man eine große Menge kauft."
                            }
                        }
                    ],
                    "synonyms": [
                        "sample",
                        "specimen"
                    ],
                    "common_phrases": [
                        "fabric swatch",
                        "color swatch"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines Musterstück aus Stoff oder Material, das Farbe, Textur oder Qualität veranschaulicht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stoffmuster",
                                "target_lang_sense_clarification": "speziell für Textilien"
                            },
                            {
                                "target_lang_word": "Muster",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für eine Materialprobe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f1645cf-f430-35aa-90cb-23e9ffd58ae2",
                    "sense_definition": "A small portion, clump, or section of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "portion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted a small <w>swatch</w> of blue on the canvas to test the shade.",
                            "target_lang_translations": {
                                "de": "Der Künstler malte einen kleinen <w>Farbklecks</w> Blau auf die Leinwand, um den Farbton zu testen."
                            }
                        },
                        {
                            "text": "She cut a small <w>swatch</w> of hair to keep as a memento.",
                            "target_lang_translations": {
                                "de": "Sie schnitt eine kleine <w>Haarsträhne</w> ab, um sie als Andenken aufzubewahren."
                            }
                        }
                    ],
                    "synonyms": [
                        "patch",
                        "section",
                        "segment"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleiner Teil, ein Büschel oder ein Abschnitt von etwas."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stück",
                                "target_lang_sense_clarification": "allgemeiner Teil von etwas"
                            },
                            {
                                "target_lang_word": "Fleck",
                                "target_lang_sense_clarification": "bei Farbe oder Oberflächen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30db2e11-9546-34ce-9bf4-5dba50dd0164",
                    "sense_definition": "A collection of samples bound or grouped together for reference.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sample",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer flipped through the <w>swatch</w> book to find the perfect shade of green.",
                            "target_lang_translations": {
                                "de": "Der Designer blätterte durch das <w>Musterbuch</w>, um den perfekten Grünton zu finden."
                            }
                        },
                        {
                            "text": "She kept a <w>swatch</w> of various leather types to show her clients.",
                            "target_lang_translations": {
                                "de": "Sie bewahrte eine <w>Musterkollektion</w> verschiedener Ledersorten auf, um sie ihren Kunden zu zeigen."
                            }
                        }
                    ],
                    "synonyms": [
                        "sample book"
                    ],
                    "common_phrases": [
                        "swatch book"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Sammlung von Mustern, die zur Referenz zusammengebunden oder gruppiert sind."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Musterbuch",
                                "target_lang_sense_clarification": "gebundene Sammlung von Materialproben"
                            },
                            {
                                "target_lang_word": "Musterkollektion",
                                "target_lang_sense_clarification": "Zusammenstellung von Proben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ecce5f0-39cc-3fee-96a8-b00ba8f6c06f",
                    "sense_definition": "A narrow channel or passage of water between sandbanks or near a shore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waterway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat navigated carefully through the <w>swatch</w> between the shifting sandbanks.",
                            "target_lang_translations": {
                                "de": "Das Boot navigierte vorsichtig durch die <w>Fahrrinne</w> zwischen den sich verlagernden Sandbänken."
                            }
                        },
                        {
                            "text": "Deep water flows through the <w>swatch</w> even at low tide.",
                            "target_lang_translations": {
                                "de": "Selbst bei Ebbe fließt tiefes Wasser durch den <w>Priel</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "channel",
                        "passage"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein schmaler Kanal oder Durchgang zwischen Sandbänken oder in Küstennähe."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Fahrrinne",
                                "target_lang_sense_clarification": "schiffbarer Durchgang"
                            },
                            {
                                "target_lang_word": "Priel",
                                "target_lang_sense_clarification": "natürlicher Wasserlauf im Watt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "435bc937-900d-38f5-9f5a-76207fa11196",
                    "sense_definition": "A demonstration or proof of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His generous donation was a <w>swatch</w> of his commitment to the charity.",
                            "target_lang_translations": {
                                "de": "Seine großzügige Spende war ein <w>Beweis</w> für sein Engagement für die Wohltätigkeitsorganisation."
                            }
                        },
                        {
                            "text": "The successful project served as a <w>swatch</w> of the team's capability.",
                            "target_lang_translations": {
                                "de": "Das erfolgreiche Projekt diente als <w>Zeichen</w> für die Leistungsfähigkeit des Teams."
                            }
                        }
                    ],
                    "synonyms": [
                        "proof",
                        "demonstration",
                        "evidence"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts to mean a sign or proof."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Beweis oder eine Demonstration für etwas (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beweis",
                                "target_lang_sense_clarification": "Nachweis für eine Eigenschaft"
                            },
                            {
                                "target_lang_word": "Zeichen",
                                "target_lang_sense_clarification": "Indiz für eine Haltung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fea986e8-ef1d-340b-abd6-0e147d0db201",
                    "sense_definition": "A physical tag or tally used for identification or record-keeping.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant attached a wooden <w>swatch</w> to the bundle of cloth to identify the owner.",
                            "target_lang_translations": {
                                "de": "Der Händler befestigte ein hölzernes <w>Identifikationsschild</w> am Stoffballen, um den Besitzer zu kennzeichnen."
                            }
                        },
                        {
                            "text": "Each delivery was tracked using a simple <w>swatch</w> system.",
                            "target_lang_translations": {
                                "de": "Jede Lieferung wurde mithilfe eines einfachen <w>Zählsystems</w> nachverfolgt."
                            }
                        }
                    ],
                    "synonyms": [
                        "tally",
                        "tag"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical methods of tallying."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein physisches Etikett oder eine Kerbe zur Identifizierung oder Buchführung (veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kerbholz",
                                "target_lang_sense_clarification": "historisches Zählsystem"
                            },
                            {
                                "target_lang_word": "Anhänger",
                                "target_lang_sense_clarification": "zur Kennzeichnung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7749eb6-0c97-3ebd-b49b-7e7eb1b34d5d",
                    "sense_definition": "To create a small sample of knitted fabric to test gauge or pattern.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always <w>swatch</w> before starting a new sweater to ensure the size is correct.",
                            "target_lang_translations": {
                                "de": "Du solltest immer eine <w>Maschenprobe stricken</w>, bevor du einen neuen Pullover beginnst, um sicherzustellen, dass die Größe stimmt."
                            }
                        },
                        {
                            "text": "I had to <w>swatch</w> several times to get the tension right for this yarn.",
                            "target_lang_translations": {
                                "de": "Ich musste mehrmals eine <w>Maschenprobe machen</w>, um die richtige Spannung für dieses Garn zu finden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swatch for gauge"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines Stück Strickarbeit anfertigen, um die Maschenprobe oder das Muster zu testen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Maschenprobe stricken",
                                "target_lang_sense_clarification": "beim Stricken zur Größenbestimmung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "94f2bbca-a75a-3a9b-b885-c7622d0b115f",
                    "sense_definition": "A brand of Swiss watches.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "She bought a colorful <w>Swatch</w> watch while visiting Switzerland.",
                            "target_lang_translations": {
                                "de": "Sie kaufte eine bunte <w>Swatch</w>-Uhr, während sie die Schweiz besuchte."
                            }
                        },
                        {
                            "text": "The <w>Swatch</w> brand is known for its affordable and stylish designs.",
                            "target_lang_translations": {
                                "de": "Die Marke <w>Swatch</w> ist für ihre erschwinglichen und stilvollen Designs bekannt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Marke für Schweizer Uhren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Swatch",
                                "target_lang_sense_clarification": "Eigenname der Uhrenmarke"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}