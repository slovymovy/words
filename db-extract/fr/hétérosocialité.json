                "senses": [
                    {
                        "sense_id": "546d46cb-d65d-35e0-b25e-a0b37be10a7c",
                        "entry_id": "3ef065a3-9edf-352d-a4ba-c6f22c952328",
                        "glosses": [
                            "Socialité hétérosexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f47569e6-828e-467d-8fba-e3addb38d646",
                                "sense_id": "546d46cb-d65d-35e0-b25e-a0b37be10a7c",
                                "text": "On utilise le terme hétérosocialité parce que l’hétérosexualité ne recouvre pas uniquement la sexualité mais aussi des modes de vie, des courants de pensée, une culture propre."
                            },
                            {
                                "example_id": "f4172c7b-c615-4205-9b5f-afbd0e4d42b0",
                                "sense_id": "546d46cb-d65d-35e0-b25e-a0b37be10a7c",
                                "text": "La vie en société est à ce prix : le mouvement de la pluralité à la singularité, de la différence à la similitude, de l’hétérosocialité à l’homosocialité, de l’autre au même."
                            }
                        ]
                    }
                ],
