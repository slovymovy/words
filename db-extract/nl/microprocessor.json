                                        "sense_id": "32135d96-c7d4-3f6b-9998-b43a36124fcd",
                                        "entry_id": "48d8c8e6-d3b7-3e5a-8f64-80675e9b00ad",
                                        "glosses": [
                                            "The entire CPU of a computer on a single integrated circuit (chip)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559568b9-25f4-46da-93ad-96c8ebb76026",
                                                "sense_id": "32135d96-c7d4-3f6b-9998-b43a36124fcd",
                                                "text": "When the microprocessor decodes the JSR opcode, it stores the operand into the TEMP register and pushes the current contents of the PC ($00 0128) onto the stack."
                                            },
                                            {
                                                "example_id": "1c307164-47e4-43af-ab0d-cc42589791b7",
                                                "sense_id": "32135d96-c7d4-3f6b-9998-b43a36124fcd",
                                                "text": "When you think of current microprocessors (μPs), the Intel Itanium processor with 592 million transistors may come to mind. […] Clearly today's FPGAs will not be able to implement such a top-of-the-range μP with a single FPGA."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d0b2515-b5d7-4cbe-9f5b-a59bc9eaa6ac",
                        "source_entry_id": "1d24ed89-d817-3e79-898d-0ca305ae3a2b",
