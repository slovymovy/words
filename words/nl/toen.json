                                "tr": "Saat beş <w>olduğunda</w> eve gitti.",
                                "es": "Se fue a casa <w>cuando</w> eran las cinco."
                            }
                        },
                        {
                            "text": "Hoe oud was je <w>toen</w> je vegetariër werd?",
                            "target_lang_translations": {
                                "ru": "Сколько тебе было лет, <w>когда</w> ты стал вегетарианцем?",
                                "en": "How old were you <w>when</w> you became a vegetarian?",
                                "pl": "Ile miałeś lat, <w>gdy</w> zostałeś wegetarianinem?",
                                "de": "Wie alt warst du, <w>als</w> du Vegetarier wurdest?",
                                "fr": "Quel âge avais-tu <w>quand</w> tu es devenu végétarien ?",
                                "it": "Quanti anni avevi <w>quando</w> sei diventato vegetariano?",
                                "cs": "Kolik ti bylo let, <w>když</w> ses stal vegetariánem?",
                                "tr": "Vejetaryen <w>olduğunda</w> kaç yaşındaydın?",
                                "es": "¿Qué edad tenías <w>cuando</w> te hiciste vegetariano?"
                            }
