                    },
                    {
                        "translation_id": "325cb6e2-1efe-4edb-b30e-c0c6a92e13f6",
                        "source_entry_id": "14ac7f30-1f13-3030-b1df-142163883216",
                        "target_lang_word": "hello",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hello",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f605b7da-8a8f-3bff-b388-5b5bf4aeeb79",
                                        "entry_id": "d65cccb9-782b-3b8c-a3c7-683bb7d1661d",
                                        "glosses": [
                                            "A greeting (salutation) said when meeting someone or acknowledging someone’s arrival or presence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "675a2273-bc2d-434f-b96f-0d98cf23abff",
                                                "sense_id": "f605b7da-8a8f-3bff-b388-5b5bf4aeeb79",
                                                "text": "Hello, everyone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "731eccb9-9ed3-3b3b-b795-652352d1cb9e",
                                        "entry_id": "d65cccb9-782b-3b8c-a3c7-683bb7d1661d",
                                        "glosses": [
                                            "A greeting used when answering the telephone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b13b7da1-661b-4067-afd0-2bfad61b4cb6",
                                                "sense_id": "731eccb9-9ed3-3b3b-b795-652352d1cb9e",
                                                "text": "Hello? How may I help you?"
                                            },
                                            {
                                                "example_id": "10a090b3-93ab-4e00-8c6d-0bb7e8359ebb",
                                                "sense_id": "731eccb9-9ed3-3b3b-b795-652352d1cb9e",
                                                "text": "Hello. This is Marsha. ― Yes, Marsha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6c740d4-4bb0-3add-9a18-62132f558481",
                                        "entry_id": "d65cccb9-782b-3b8c-a3c7-683bb7d1661d",
                                        "glosses": [
                                            "A call for response if it is not clear if anyone is present or listening, or if a telephone conversation may have been disconnected."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ed7e6c-fa1b-460e-82f6-d133d39aad02",
                                                "sense_id": "c6c740d4-4bb0-3add-9a18-62132f558481",
                                                "text": "Hello? Is anyone there?"
                                            },
                                            {
                                                "example_id": "3ac1d8c7-c055-4c40-9b1d-fb7bf5e67272",
                                                "sense_id": "c6c740d4-4bb0-3add-9a18-62132f558481",
                                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf1741a-c792-3a37-b9d9-e7cdc69e2349",
                                        "entry_id": "d65cccb9-782b-3b8c-a3c7-683bb7d1661d",
                                        "glosses": [
                                            "Used sarcastically to imply that the person addressed has done something the speaker considers to be foolish, or missed something that should have been obvious."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f63889-5fbf-43ec-bbdb-89e68b4cee34",
                                                "sense_id": "bdf1741a-c792-3a37-b9d9-e7cdc69e2349",
                                                "text": "You just tried to start your car with your cell phone. Hello?"
                                            },
                                            {
                                                "example_id": "b60b7a6d-1d1c-40d9-8170-69dabace2028",
                                                "sense_id": "bdf1741a-c792-3a37-b9d9-e7cdc69e2349",
                                                "text": "Uh, hello? We're using a CANNON to get to the moon? Isn't that, like, dangerous?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56a347cd-fd1b-37fb-92c0-0da3a5e2e646",
                                        "entry_id": "d65cccb9-782b-3b8c-a3c7-683bb7d1661d",
                                        "glosses": [
                                            "An expression of puzzlement or discovery."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85323daa-7e3d-4b51-8224-3fa2df79bf10",
                                                "sense_id": "56a347cd-fd1b-37fb-92c0-0da3a5e2e646",
                                                "text": "Hello! What’s going on here?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hello",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0985fa-fb66-35aa-b70a-936e29c303b6",
                                        "entry_id": "d615e411-d2fc-3a61-ac3c-d300583888ca",
                                        "glosses": [
                                            "\\\"Hello!\\\" or an equivalent greeting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2566a077-d83e-4873-9182-a915c03c6b2a",
                                                "sense_id": "0d0985fa-fb66-35aa-b70a-936e29c303b6",
                                                "text": "In many new buildings, though, neighbors are venturing beyond tight-lipped hellos at the mailbox."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hello",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31ef55b0-6f87-3a8e-b645-5b55b7da4580",
                                        "entry_id": "67327cc4-9df1-308d-a638-b4c64e0f1dac",
                                        "glosses": [
                                            "To greet with \\\"hello\\\"."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b36e53b-f355-4e5e-954e-f0de379dbdcf",
                                                "sense_id": "31ef55b0-6f87-3a8e-b645-5b55b7da4580",
                                                "text": "She is there guarding and looking after the candy and the children generally, and she helloes and renders an exclamation that Maidie is crossing the street."
                                            },
                                            {
                                                "example_id": "fa8f42d1-ac33-42ca-861f-11cc3d1d786a",
                                                "sense_id": "31ef55b0-6f87-3a8e-b645-5b55b7da4580",
                                                "text": "He helloes to my daughter:[…]"
                                            },
                                            {
                                                "example_id": "29efc605-057e-4dfa-97af-a7e1c1c14081",
                                                "sense_id": "31ef55b0-6f87-3a8e-b645-5b55b7da4580",
                                                "text": "‘Hello Minka! Great to meet you!’ Minka seems nonplussed at what I thought was an uncontroversial opening remark. There’s an awkward pause. She then helloes me back. But that’s all I get."
                                            },
                                            {
                                                "example_id": "6c16f272-87d9-4af6-a72d-8c58d8199978",
                                                "sense_id": "31ef55b0-6f87-3a8e-b645-5b55b7da4580",
                                                "text": "I had to traipse around somewhat, helloing people and being helloed, before I spotted my mother and my father, sharing shade and a spread blanket with Pete and Marie Reese and Toussaint Rennie near the back of the park."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
