                        "glosses": [
                            "Accumulation de micro-organismes sur la coque des navires, nécessitant un entretien régulier."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "da9894d6-bdc9-45d7-b0f9-7011bb391b41",
                                "sense_id": "2d3afdf5-80d5-3aaa-9de1-6e206b6f5116",
                                "text": "Le fouling des coques de navire se traduit non seulement par un revêtement plus ou moins continu de la surface des parois, mais également par la formation de boursouflures, de protubérances et d’aspérités. L'ensemble se manifeste par un accroissement de charge pour le bateau et une entrave pour son déplacement."
                            }
                        ]
                    }
