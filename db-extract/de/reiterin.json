                "senses": [
                    {
                        "sense_id": "e3cca9ab-9b58-32b0-83eb-0eae17d5064a",
                        "entry_id": "e4c4fdd8-b58a-31c2-82f4-930038e17a43",
                        "glosses": [
                            "weibliche Person, die auf einem Pferd, Esel, Kamel etc. reitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d9b136-bb6b-4c7e-91e6-ad49207285a7",
                                "sense_id": "e3cca9ab-9b58-32b0-83eb-0eae17d5064a",
                                "text": "Die Reiterin fiel vom Pferd, als dieses sich durch die laute Musik gestört fühlte."
                            },
                            {
                                "example_id": "a3700bd7-ac06-414a-9a42-42a2f448d29d",
                                "sense_id": "e3cca9ab-9b58-32b0-83eb-0eae17d5064a",
                                "text": "„Sie hatten wirklich Ursache, erstaunt zu sein, denn auf schnaubendem Rappen, den Kopf gegen den scharfen Luftzug niedergebeugt, flog Adele in sausendem Galopp vorbei, kaum war der Ruf ihren Lippen entflohen, da verschwand die wilde Reiterin schon um die nächste, dem oberen Teil des Flußufers zuführende Ecke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "076a70b2-6c70-4d8e-afbe-693a8439506c",
                        "source_entry_id": "e4c4fdd8-b58a-31c2-82f4-930038e17a43",
                        "source_sense_id": "e3cca9ab-9b58-32b0-83eb-0eae17d5064a",
                        "target_lang_word": "equestrian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equestrian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e7045ce-1653-323d-bc9f-fb22aec07745",
                                        "entry_id": "a88c7902-56b8-3b20-be4d-1990773d69ad",
                                        "glosses": [
                                            "Of horseback riding or horseback riders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a7c3d80-18f4-429c-abea-4310c3c5ec31",
                                                "sense_id": "0e7045ce-1653-323d-bc9f-fb22aec07745",
                                                "text": "They were an equestrian people."
                                            },
                                            {
                                                "example_id": "80bd1d38-fc26-4a5c-8139-cebd3a1af17c",
                                                "sense_id": "0e7045ce-1653-323d-bc9f-fb22aec07745",
                                                "text": "After his death an equestrian statue was erected."
                                            },
                                            {
                                                "example_id": "864641bd-77c9-4031-9493-fa2cd20d6817",
                                                "sense_id": "0e7045ce-1653-323d-bc9f-fb22aec07745",
                                                "text": "The society of colonial Spanish-America was one of the most equestrian in all history, and, to a very great extent, its existence depended on the adaptability of the Old World horse to New World conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dee7cdc9-ff2e-3842-854a-88a67b7140ab",
                                        "entry_id": "a88c7902-56b8-3b20-be4d-1990773d69ad",
                                        "glosses": [
                                            "Of or relating to the ancient Roman class of equites."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
