                        "glosses": [
                            "handeling, al of niet gerechtelijk, waarbij een zaak tot het eigendom van iemand anders gemaakt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9a671f-fddf-4cb0-a29a-99cd6d44a7b0",
                                "sense_id": "856a741d-6c23-30ad-8df5-c008a03e38ab",
                                "text": "De opmerkelijke rol van toezichthouder De Nederlandsche Bank (DNB) bij de onteigening van 2,5 miljard euro, opgebracht door Nederlandse havenarbeiders en hun werkgevers."
                            }
