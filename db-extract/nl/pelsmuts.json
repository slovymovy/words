                    {
                        "sense_id": "8b9287b3-9082-3b1a-bfcf-1e3f7f233920",
                        "entry_id": "893837aa-e663-3369-bb82-ee80f3f71f6d",
                        "glosses": [
                            "hoofddeksel gemaakt van bont"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5469392b-19c2-4d6d-8d35-2e2107168b5b",
                                "sense_id": "8b9287b3-9082-3b1a-bfcf-1e3f7f233920",
                                "text": "Denisov liep met een somber gezicht, zijn pelsmuts in de hand, achter de kozakken aan die het lichaam van Petja Rostov naar een in de tuin gegraven kuil droegen."
                            },
                            {
                                "example_id": "03ed209e-292f-49e5-83fe-d592fe91f7b6",
                                "sense_id": "8b9287b3-9082-3b1a-bfcf-1e3f7f233920",
                                "text": "Hij was een van de meest opvallende verschijningen tijdens de rellen in het Amerikaanse Capitool deze week: de man met de pelsmuts, hoorns en een gezicht dat in de Amerikaanse kleuren was geschilderd. De man, die zichzelf Jake Angeli noemt, is vandaag opgepakt."
                            }
                        ]
                    }
