    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f1f4a903-e6f2-390c-8d0b-2310e9e4fcea",
                    "sense_definition": "Producing a calming, relaxing, or reassuring effect on the mind, senses, or emotions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listening to <w>soothing</w> music after work helped him unwind and fall asleep quickly.",
                            "target_lang_translations": {
                                "pl": "Słuchanie <w>uspokajającej</w> muzyki po pracy pomogło mu się odprężyć i szybko zasnąć."
                            }
                        },
                        {
                            "text": "She spoke in a calm, <w>soothing</w> voice to comfort the frightened child.",
                            "target_lang_translations": {
                                "pl": "Mówiła spokojnym, <w>kojącym</w> głosem, aby pocieszyć przestraszone dziecko."
                            }
                        }
                    ],
                    "synonyms": [
                        "calming",
                        "relaxing",
                        "pacifying"
                    ],
                    "antonyms": [
                        "agitating",
                        "irritating"
                    ],
                    "common_phrases": [
                        "soothing voice",
                        "soothing music"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wywierający uspokajający, relaksujący lub pocieszający wpływ na umysł, zmysły lub emocje."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "uspokajający",
                                "target_lang_sense_clarification": "działający wyciszająco na emocje i nerwy"
                            },
                            {
                                "target_lang_word": "kojący",
                                "target_lang_sense_clarification": "przynoszący ulgę zmysłom lub psychice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4fe09bc-aab5-3987-87d3-bf9e46fc372e",
                    "sense_definition": "Providing physical relief from pain, irritation, or discomfort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied a <w>soothing</w> cream to reduce the redness and irritation on her skin.",
                            "target_lang_translations": {
                                "pl": "Nałożyła <w>łagodzący</w> krem, aby zmniejszyć zaczerwienienie i podrażnienie skóry."
                            }
                        },
                        {
                            "text": "A warm cup of herbal tea had a <w>soothing</w> effect on her sore throat.",
                            "target_lang_translations": {
                                "pl": "Ciepła filiżanka herbaty ziołowej miała <w>kojący</w> wpływ na jej bolące gardło."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviating",
                        "balmy"
                    ],
                    "antonyms": [
                        "aggravating"
                    ],
                    "common_phrases": [
                        "soothing effect",
                        "soothing cream",
                        "soothing balm"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przynoszący fizyczną ulgę w bólu, podrażnieniu lub dyskomforcie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kojący",
                                "target_lang_sense_clarification": "łagodzący ból lub podrażnienia"
                            },
                            {
                                "target_lang_word": "łagodzący",
                                "target_lang_sense_clarification": "zmniejszający dyskomfort fizyczny"
                            },
                            {
                                "target_lang_word": "uśmierzający",
                                "target_lang_sense_clarification": "tłumiący dolegliwości bólowe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4aede0dd-c1b9-37e4-a15a-2cf54a42b074",
