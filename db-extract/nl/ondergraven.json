                                "sense_id": "b4820846-0b60-3947-9f47-8b7627ceb150",
                                "text": "Zijn nieuwe gegevens ondergroeven de rechtvaardiging van het beleid danig."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f7c53ce-d5d8-3bc8-bb42-680ee190e027",
