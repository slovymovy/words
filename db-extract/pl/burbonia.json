                                            {
                                                "example_id": "3d781d47-b3d6-48a1-bc99-531c7a650be3",
                                                "sense_id": "95ad6118-95b2-30b9-a14a-b3c8eba75b09",
                                                "text": "Un concours est lancé, remporté par les architectes Alain Bourbonnais et Thierry Bouts."
