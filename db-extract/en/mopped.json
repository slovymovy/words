                    {
                        "sense_id": "d7508676-1563-31b8-836f-7392e68d2487",
                        "entry_id": "2cb1b0c3-b132-345d-b727-bc9b7472f61a",
                        "glosses": [
                            "Haired."
                        ],
                        "tags": [
                            "humorous",
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bbdfa860-f0cf-42fb-95c2-6eb095606512",
                                "sense_id": "d7508676-1563-31b8-836f-7392e68d2487",
                                "text": "There was more in the same vein before an anti-climactic conclusion: “This horror is obviously a satire of today’s long-mopped singing groups, but it has failed. It is in a class by itself – if it can be classified.”"
                            },
                            {
                                "example_id": "8257248b-0488-40f7-b12b-833e7e9428d6",
                                "sense_id": "d7508676-1563-31b8-836f-7392e68d2487",
                                "text": "So when JD Emmenthaler lit from Dallas with ginger hair, black boots, tan Stetson, and wads of long green money, no one on either side of the village took much notice of him, his blonde-mopped wife Narcissa with her red Corvette she sashayed all over La Mancha in, or his small son Travis, except to note that the latter was a snotty little ass."
                            },
                            {
                                "example_id": "83984906-b68f-4d57-92ed-7583e77b561f",
                                "sense_id": "d7508676-1563-31b8-836f-7392e68d2487",
                                "text": "Tall, dapper, brown-mopped Will was the closest thing I had to a brother."
                            }
                        ]
                    }
