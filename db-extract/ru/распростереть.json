                ],
                "senses": [
                    {
                        "sense_id": "9db40228-81cc-3ccf-9073-4161aeacfc7b",
                        "entry_id": "f9dafbfc-f2ca-311f-b865-185769b348ef",
                        "glosses": [
                            "широко развести, раскинуть в стороны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e5531b-edfa-4646-9fc5-0c914c3b98e5",
                                "sense_id": "9db40228-81cc-3ccf-9073-4161aeacfc7b",
                                "text": "В небе, в лучах кометы, распростёрла крылья огромная летучая мышь."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8129369b-bb16-4b1a-9904-f423341ca4fa",
                        "source_entry_id": "f9dafbfc-f2ca-311f-b865-185769b348ef",
                        "source_sense_id": "9db40228-81cc-3ccf-9073-4161aeacfc7b",
                        "target_lang_word": "spread out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spread out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a191671-5c1e-3df4-b8ec-07b44b2b4fb6",
                                        "entry_id": "ee35734b-b787-37c6-96e7-fe7f3963c31d",
                                        "glosses": [
                                            "Become further apart."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a9cbbb3-e111-40a0-9131-3067eaa6e3a8",
                                                "sense_id": "0a191671-5c1e-3df4-b8ec-07b44b2b4fb6",
                                                "text": "The police spread out to search a wider area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31e3b4fd-f7b2-3df0-9c32-08a0ee3d37b6",
                                        "entry_id": "ee35734b-b787-37c6-96e7-fe7f3963c31d",
                                        "glosses": [
                                            "To place items further apart."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fbfaf85-0f08-44e8-b695-342c5952e5e6",
                                                "sense_id": "31e3b4fd-f7b2-3df0-9c32-08a0ee3d37b6",
                                                "text": "Spread the cards out and then turn two of them over at random."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spread out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                        "entry_id": "d4569b63-fd1a-351c-bd9b-86f7f65e950b",
                                        "glosses": [
                                            "Far apart, not close to each other - far apart, extended over an expanse of space or time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04745f52-793e-4fc4-8a02-48ab8fdde27d",
                                                "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                                "text": "In other words, space is very empty, and particles are very spread out."
                                            },
                                            {
                                                "example_id": "b7b6758c-848f-44f5-86a8-3d2e93700c25",
                                                "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                                "text": "It is extremely time-consuming to use public transportation and the restaurants and dining are very spread out."
                                            },
                                            {
                                                "example_id": "ff43722b-35ea-45a5-b272-8ee1c20d25d8",
                                                "sense_id": "3f320b0e-416a-3bcb-bda2-91a6f84f5303",
                                                "text": "The plague is spread person to person, so if the people are very spread out, fewer of them will come in contact with those afflected by the plague."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                        "entry_id": "d4569b63-fd1a-351c-bd9b-86f7f65e950b",
                                        "glosses": [
                                            "Covering a wide area of space or long period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75163d6-e233-4dec-bd2b-8d13a7183f99",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "The park is very spread out, with two core areas approximately 1.5 km apart, and the trailer dump station almost 2 km away near the park entrance."
                                            },
                                            {
                                                "example_id": "0ffeb2d2-b36c-4dce-8c6b-34a1876cc920",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "As a result, U.S. cities have become very spread out and cover a great deal of land."
                                            },
                                            {
                                                "example_id": "cf87d26d-c0d7-4f13-afa2-c2bcedffae7b",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "The t distribution tends to be flatter and more spread out, whereas the normal z distribution has more of a central peak."
                                            },
                                            {
                                                "example_id": "ceeeaaec-ff4d-4dab-b7d3-f5e7effd3a43",
                                                "sense_id": "62e44870-f17b-3ef6-bb18-f8b0750c5cfe",
                                                "text": "If you live in or around Houston you cannot survive without wheels. The city is very spread out and continues to sprawl outward and consume more and more real estate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
