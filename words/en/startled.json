    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b1362a36-ba17-383a-b4bf-598079b1b671",
                    "sense_definition": "Surprised and slightly frightened.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>startled</w> cat jumped onto the fence when the dog barked loudly.",
                            "target_lang_translations": {
                                "cs": "<w>Vylekaná</w> kočka vyskočila na plot, když pes hlasitě zaštěkal.",
                                "pl": "<w>Spłoszony</w> kot wskoczył na płot, gdy pies głośno zaszczekał.",
                                "de": "Die <w>erschrockene</w> Katze sprang auf den Zaun, als der Hund laut bellte.",
                                "es": "El gato <w>asustado</w> saltó a la valla cuando el perro ladró fuertemente."
                            }
                        },
                        {
                            "text": "She gave a <w>startled</w> look when the door suddenly slammed shut.",
                            "target_lang_translations": {
                                "cs": "Když se dveře náhle zabouchly, vrhla <w>vylekaný</w> pohled.",
                                "pl": "Rzuciła <w>zaskoczone</w> spojrzenie, gdy drzwi nagle się zatrzasnęły.",
                                "de": "Sie blickte <w>erschrocken</w>, als die Tür plötzlich zuschlug.",
                                "es": "Puso una mirada <w>sobresaltada</w> cuando la puerta se cerró de golpe de repente."
                            }
                        }
                    ],
                    "synonyms": [
                        "spooked"
                    ],
                    "common_phrases": [
                        "startled look",
                        "startled expression"
                    ],
                    "target_lang_definitions": {
                        "cs": "Překvapený a mírně vystrašený.",
                        "pl": "Zaskoczony i lekko przestraszony.",
                        "de": "Überrascht und leicht verängstigt.",
                        "es": "Sorprendido y ligeramente asustado o alarmado."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vylekaný",
                                "target_lang_sense_clarification": "pocit náhlého leknutí nebo strachu"
                            },
                            {
                                "target_lang_word": "překvapený",
                                "target_lang_sense_clarification": "reakce na nečekanou událost"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zaskoczony",
                                "target_lang_sense_clarification": "reakcja na nieoczekiwane zdarzenie"
                            },
                            {
                                "target_lang_word": "przestraszony",
                                "target_lang_sense_clarification": "odczuwający nagły strach lub niepokój"
                            },
                            {
                                "target_lang_word": "spłoszony",
                                "target_lang_sense_clarification": "często używane w kontekście zwierząt lub nagłego uciekania"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "erschrocken",
                                "target_lang_sense_clarification": "plötzlich verängstigt oder überrascht"
                            },
                            {
                                "target_lang_word": "aufgeschreckt",
                                "target_lang_sense_clarification": "besonders bei Tieren oder plötzlicher Störung"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sobresaltado",
                                "target_lang_sense_clarification": "asustado por una sorpresa o sonido repentino"
                            },
                            {
                                "target_lang_word": "asustado",
                                "target_lang_sense_clarification": "que siente miedo o sobresalto repentino"
                            },
                            {
                                "target_lang_word": "sorprendido",
                                "target_lang_sense_clarification": "que experimenta una reacción ante algo inesperado"
                            }
                        ]
                    }
                }
            ]
        },
