                "senses": [
                    {
                        "sense_id": "c70de559-e8a0-3c9c-92fd-07b9a6894eaf",
                        "entry_id": "2958d92c-d234-3abe-b6b1-9f09d7ee861b",
                        "glosses": [
                            "A composition that resembles a lullaby, often in 6/8 time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdac0d21-3d58-4365-a8f5-4d6fda89944c",
                                "sense_id": "c70de559-e8a0-3c9c-92fd-07b9a6894eaf",
                                "text": "What was in my mind as I waited for sleep and the engines thundered their ineffectual berceuse was the chapter, a brief one, about the Jews."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2041199-5ed0-4ec3-b531-4169227b6d61",
                        "source_entry_id": "2958d92c-d234-3abe-b6b1-9f09d7ee861b",
                        "source_sense_id": "c70de559-e8a0-3c9c-92fd-07b9a6894eaf",
                        "source_sense_description": "specific type of lullaby",
                        "target_lang_word": "berceuse",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berceuse",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "763b8b93-db4c-3f0c-a48c-f8b2d8013bc5",
                                        "entry_id": "e03f50f2-e371-3c90-958b-ede82e385403",
                                        "glosses": [
                                            "wijsje dat helpt slaperig te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4d78c2-3f45-4cbe-bb6e-4e3e76099173",
                                                "sense_id": "763b8b93-db4c-3f0c-a48c-f8b2d8013bc5",
                                                "text": "Op het programma de Davidsbündlertänze en de Sonate nr 3 op 14 'Concert zonder orkest' van Schumann en een aantal nocturnes, ballades en een berceuse van Chopin."
                                            },
                                            {
                                                "example_id": "2a09cb22-2b09-44d9-8031-5f8f4288ca9f",
                                                "sense_id": "763b8b93-db4c-3f0c-a48c-f8b2d8013bc5",
                                                "text": "In de laan om de hoek was het een eenzame weduwe, die de ogen niet sluiten kon en even opstond om door het gordijn te gluren wie het toch waren die zo aardig speelden. Het leek wel een wiegelied, een berceuse, op een gitaar en een viool, heel in de verte begeleid door een paar fluitjes of zo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2000146-d5bd-3458-b621-9d10783ef6d3",
                                        "entry_id": "e03f50f2-e371-3c90-958b-ede82e385403",
                                        "glosses": [
                                            "stoel die door de persoon die erop zit gemakkelijk een klein stukje voor of achterover kan worden gekanteld"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6a9b070-4c63-4172-a141-95a07f4ba25d",
                        "source_entry_id": "2958d92c-d234-3abe-b6b1-9f09d7ee861b",
                        "source_sense_id": "c70de559-e8a0-3c9c-92fd-07b9a6894eaf",
                        "source_sense_description": "specific type of lullaby",
                        "target_lang_word": "berceuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "berceuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6ea1b4-6e21-338c-9e33-bc4b1bf60089",
                                        "entry_id": "88ecd8af-c6af-325e-a8b5-f11c4d8c083e",
                                        "glosses": [
                                            "Femme chargée de bercer un enfant."
                                        ],
                                        "tags": [
                                            "Puériculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c27bafed-6e1e-482f-823b-ba03750986c1",
                                                "sense_id": "ee6ea1b4-6e21-338c-9e33-bc4b1bf60089",
                                                "text": "[…] ; cette succession de grands noms de duchesses, de marquises et de belles dames, les gouvernantes et les sous-gouvernantes, et les dames pour accompagner, les femmes de chambre, les dames d'atours, les habilleuses, les berceuses, les feutières, les remueuses, tout un monde de femmes qu'on se représente si élégamment délicates, si pleines de respectueuses attentions pour l'enfant qui leur est confié."
                                            },
                                            {
                                                "example_id": "4eb7da94-9820-46ff-a6db-83cb0c0dabfb",
                                                "sense_id": "ee6ea1b4-6e21-338c-9e33-bc4b1bf60089",
                                                "text": "– Slick ! Ouvre !\n– Quoi encore ? J’ai pas commandé une berceuse.\n– Rex te laisse dire que le job, c’est pour demain soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f793fe1-cbf9-3abc-91fc-6ac00c503993",
                                        "entry_id": "88ecd8af-c6af-325e-a8b5-f11c4d8c083e",
                                        "glosses": [
                                            "Forme musicale instrumentale ou vocale destinée à endormir les enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14c641c-32c0-41c8-9a90-d61b783eeecc",
                                                "sense_id": "2f793fe1-cbf9-3abc-91fc-6ac00c503993",
                                                "text": "J’entendais ma voix comme de l’extérieur, elle était sourde et monotone, et sa régularité me calmait comme la plus douce des berceuses, moi à qui on n’en avait jamais chantées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                        "entry_id": "88ecd8af-c6af-325e-a8b5-f11c4d8c083e",
                                        "glosses": [
                                            "Rocking-chair sans mécanisme, monté sur des berceaux ; rarement utilisé en France."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e806d234-83e9-472a-9fc3-62821bee6d4d",
                                                "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                                "text": "Dans ma famille, la berceuse s’offre de père en fils."
                                            },
                                            {
                                                "example_id": "32969927-e638-4bac-aac5-b867ceeb73a2",
                                                "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                                "text": "Marie-Élodie jaillissait de sa somnolence tel un diable en boîte, se levait non sans peine de sa berceuse et traversait la cour intérieure en claudiquant."
                                            },
                                            {
                                                "example_id": "27752cf9-6d4d-40ff-b788-3d795923c6d8",
                                                "sense_id": "b1a358a6-8685-3351-adf9-f6da4bef0306",
                                                "text": "Anna s’était assise dans une berceuse qui avait un coussin tricoté et une mantille à dentelles sur le dossier."
                                            }
                                        ]
                                    }
                                ]
                            },
