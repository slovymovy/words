                "senses": [
                    {
                        "sense_id": "d1cb53d0-22dc-397c-98e3-8c14bfc158bd",
                        "entry_id": "1ff5470f-4a58-361c-a4a4-667b186dac33",
                        "glosses": [
                            "eine ausgestorbene Tupí-Sprache, die vorwiegend im heutigen Brasilien gesprochen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c75cdcd-acfb-4381-be95-c64893399386",
                                "sense_id": "d1cb53d0-22dc-397c-98e3-8c14bfc158bd",
                                "text": "„Die einzige originelle Grammatik des Tupinambá der Kolonialzeit ist die des Begründers der Jesuitenmission in Brasilien, des von den kanarischen Inseln stammenden […] José de Anchieta […].“"
                            },
                            {
                                "example_id": "0c8ffb7a-e448-4a0e-840b-73453d240f40",
                                "sense_id": "d1cb53d0-22dc-397c-98e3-8c14bfc158bd",
                                "text": "„Die bekanntesten Vertreter sind die Guaraní-Untergruppe sowie die heute ausgestorbenen Sprachen Tupí und Tupinambá.“"
                            },
                            {
                                "example_id": "8379b6be-4bd7-4639-8ab1-3e2fbae9c75b",
                                "sense_id": "d1cb53d0-22dc-397c-98e3-8c14bfc158bd",
                                "text": "„In einigen Sprachen, wie beispielsweise dem Tupinambá, gibt es geringe Abweichungen;“"
                            },
                            {
                                "example_id": "1cb95348-6d10-45cc-bd15-9222c6bb8a32",
                                "sense_id": "d1cb53d0-22dc-397c-98e3-8c14bfc158bd",
                                "text": "„Bei nicht eingedeutschten Sprachnamen bleibt der Genitiv in der Regel unbezeichnet: Wir haben das Beispiel des Tupinambá gewählt[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
