                {
                    "sense_id": "691bc65b-a201-31aa-bed8-9ba44bdaa1b9",
                    "sense_definition": "A particular point or place in physical space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "place_general",
                    "name_type": "no",
