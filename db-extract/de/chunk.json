                "senses": [
                    {
                        "sense_id": "6eb30703-144c-3556-a055-f8be986e2d86",
                        "entry_id": "f66116f9-25ad-3554-84c9-9d3dcbc837d9",
                        "glosses": [
                            "Block sprachlicher Information zur wirksameren Nutzung des Kurzzeitgedächtnisses (durch Umschlüsseln von Informationen)"
                        ],
                        "tags": [
                            "speziell Psycholinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "31104d4e-8f20-4ab9-b9f6-c7bbbd7878ae",
                                "sense_id": "6eb30703-144c-3556-a055-f8be986e2d86",
                                "text": "Ein Chunk ist ein kleiner Block sprachlicher Information; nach einer verbreiteten Faustregel kann das Kurzzeitgedächtnis, der Sprachverarbeitungsspeicher des Menschen, etwa 7 +/- 2 Chunks verarbeiten."
                            },
                            {
                                "example_id": "e9c7225f-557b-4c93-8557-4bfac8f49458",
                                "sense_id": "6eb30703-144c-3556-a055-f8be986e2d86",
                                "text": "„In Gedächtnisexperimenten zeigt sich, daß die in ein Chunk enkodierten Wörter gemeinsam reproduziert werden (…).“"
                            },
                            {
                                "example_id": "2fc6b130-ddc9-4c8d-bfdd-14a9f9917dec",
                                "sense_id": "6eb30703-144c-3556-a055-f8be986e2d86",
                                "text": "„Wir haben oben schon erwähnt, daß MILLER nachweisen konnte, daß die Kapazität des Kurzzeitgedächtnisses (…) nach der Anzahl der zu speichernden Einheiten begrenzt ist, daß die Größe dieser (Chunk genannten) Einheiten jedoch variabel ist und durch den Vorgang des Codierens beziehungsweise Recodierens verändert werden kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "875696e2-8e67-463a-b2d6-ee22de8f9c60",
                        "source_entry_id": "f66116f9-25ad-3554-84c9-9d3dcbc837d9",
                        "source_sense_id": "6eb30703-144c-3556-a055-f8be986e2d86",
                        "source_sense_description": "Block sprachlicher Information zur wirksameren Nutzung des Kurzzeitgedächtnisses",
                        "target_lang_word": "chunk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06175f9a-7ea5-3659-a382-8d8ba38f8d38",
                                        "entry_id": "b85d4fe6-3ec6-3c32-bdac-4f970b123a23",
                                        "glosses": [
                                            "A part of something that has been separated; a generally squat, thick, irregular piece of something, e.g. wood or stone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd9b7db0-acba-49f0-bb08-cd4102a0e60c",
                                                "sense_id": "06175f9a-7ea5-3659-a382-8d8ba38f8d38",
                                                "text": "The statue broke into chunks."
                                            },
                                            {
                                                "example_id": "f19bfa58-3a02-4fd4-ae81-aa10e5751f3b",
                                                "sense_id": "06175f9a-7ea5-3659-a382-8d8ba38f8d38",
                                                "text": "a chunk of granite"
                                            },
                                            {
                                                "example_id": "65e9002f-929f-4226-baef-5c612882732d",
                                                "sense_id": "06175f9a-7ea5-3659-a382-8d8ba38f8d38",
                                                "text": "Daylight, between mouthfuls, fed chunks of ice into the tin pot, where it thawed into water. ... Daylight cut up generous chunks of bacon and dropped them in the pot of bubbling beans."
                                            },
                                            {
                                                "example_id": "3126247a-d827-4d5d-8380-3a18b3578bfc",
                                                "sense_id": "06175f9a-7ea5-3659-a382-8d8ba38f8d38",
                                                "text": "Until the main road from Hatfield to Hertford was diverted a few years ago, heavy lorries trundling through the village sometimes knocked chunks off corner buildings, but now the village has regained much of its former tranquillity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef73c37e-4397-3a81-9763-ef32b7c13b90",
                                        "entry_id": "b85d4fe6-3ec6-3c32-bdac-4f970b123a23",
                                        "glosses": [
                                            "A part of something that has been separated; a generally squat, thick, irregular piece of something, e.g. wood or stone.",
                                            "A large or substantial portion of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "851e527c-48e5-4cf6-86a2-deb296b3d63b",
                                                "sense_id": "ef73c37e-4397-3a81-9763-ef32b7c13b90",
                                                "text": "I'd be willing to bet a chunk of my retirement that the number hasn't decreased."
                                            },
                                            {
                                                "example_id": "659eb1eb-7b39-4e27-8534-b1db468d6def",
                                                "sense_id": "ef73c37e-4397-3a81-9763-ef32b7c13b90",
                                                "text": "[…] she'd be willing to bet a chunk of change this would be one of the nicest rooms Kate-Lynn Bowers had ever slept in: it was the sort of place you'd think twice about running away from."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c301d3-4b66-3dfb-9b9d-a1a508947787",
                                        "entry_id": "b85d4fe6-3ec6-3c32-bdac-4f970b123a23",
                                        "glosses": [
                                            "A sequence of two or more words that occur in language with high frequency but are not idiomatic; a bundle or cluster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9cf536b-b477-431a-956a-0d234443e3f4",
                                                "sense_id": "a9c301d3-4b66-3dfb-9b9d-a1a508947787",
                                                "text": "examples of chunks would include \"in accordance with\", \"the results of\", and \"so far\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d0e2f05-6d4f-35bd-88ec-92ddeedc1a34",
                                        "entry_id": "b85d4fe6-3ec6-3c32-bdac-4f970b123a23",
                                        "glosses": [
                                            "A discrete segment of a file, stream, etc. (especially one that represents audiovisual media); a block."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ef5386-d411-4882-a7d4-85fe360b265c",
                                                "sense_id": "4d0e2f05-6d4f-35bd-88ec-92ddeedc1a34",
                                                "text": "The first DWORD of a chunk data in the RIFF chunk is a four character code value identifying the form type of the file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f6ca186-919c-3199-8021-cd1af1603aa7",
                                        "entry_id": "b85d4fe6-3ec6-3c32-bdac-4f970b123a23",
                                        "glosses": [
                                            "A segment of a comedian's performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a27ae07-efd3-4306-9f11-de38fa08217c",
                                                "sense_id": "4f6ca186-919c-3199-8021-cd1af1603aa7",
                                                "text": "You begin gathering two hours of dependable comedy by developing that first three-minute chunk. When you're satisfied with it, you create another three minutes of laughs, then another three minutes."
                                            },
                                            {
                                                "example_id": "0e42db16-51e6-4bdf-a216-8f49952b1529",
                                                "sense_id": "4f6ca186-919c-3199-8021-cd1af1603aa7",
                                                "text": "If you're gigging outdoors for the Society of Catholic Gardeners, don't close your set with your \"Papa Beelzebub\" chunk (no matter how life affirming you think it is!)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chunk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bbf8b2d-1ac3-3a9c-bf6c-fb68ac6345b3",
