                ],
                "senses": [
                    {
                        "sense_id": "08aaa4a3-3101-3124-9479-aaca0bf48a6c",
                        "entry_id": "526806c8-8030-3b02-9753-150ab4e41c9e",
                        "glosses": [
                            "Faire un bruit de moteur."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "caec2886-a7dc-4559-ab83-0f2a1fd0fa04",
                                "sense_id": "08aaa4a3-3101-3124-9479-aaca0bf48a6c",
                                "text": "Il n’est guère de jours qu’on n’entende teuf-teufer sa deux-chevaux verte dans les rues du bourg."
                            },
                            {
                                "example_id": "ac9b1ecf-f5a4-4078-b5e5-01e6335bc099",
                                "sense_id": "08aaa4a3-3101-3124-9479-aaca0bf48a6c",
                                "text": "Cet exemple dramatique n’a pas corrigé — heureusement pour l’automobilisme — les chauffeurs américains qui continuent de teuf-teufer avec un entrain endiablé."
                            },
                            {
                                "example_id": "b4e3df72-ef61-47ff-98a4-b0bea2d4a4aa",
                                "sense_id": "08aaa4a3-3101-3124-9479-aaca0bf48a6c",
                                "text": "C’était beau, la péniche emportait avec elle en teuf-teufant un secret qui partait vers Saint-Cloud, vers les lointaines banlieues de la mémoire ou de l’oubli."
                            }
                        ]
                    }
                ],
