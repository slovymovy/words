                ],
                "senses": [
                    {
                        "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                        "entry_id": "6eb82e1e-a6d5-3678-a36f-b7a18678f03e",
                        "glosses": [
                            "festgelegte Strecke, die im Rahmen eines Wettkampfes zurückgelegt werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319235ea-cbd6-4726-8d11-c78f135fc873",
                                "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                                "text": "„Die z.Zt. gültigen Wettkampfdistanzen sind: 30, 50, 60, 70, (90) m.“"
                            },
                            {
                                "example_id": "1c8c6b81-40fb-4ea6-a792-d88a371a85c6",
                                "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                                "text": "„Je länger die Wettkampfdistanz, desto wichtiger wird die erweiterte Grundlagenausdauer, die dem Aufbau der wettkampfspezifischen Geschwindigkeit dient.“"
                            },
                            {
                                "example_id": "2dedf026-7986-458a-be69-303254ef75f5",
                                "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                                "text": "„Mit steigender Erfahrung und Leistungsfähigkeit wächst bei vielen Triathleten der Wunsch, auch längere Wettkampfdistanzen erfolgreich zu meistern.“"
                            },
                            {
                                "example_id": "893d9162-b9b3-4252-a429-11caaf5691be",
                                "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                                "text": "„Hierzu mussten die 18 Teilnehmer auf dem Ruderergometer, unterstützt durch die Anfeuerung der zahlreichen Zuschauer, die olympische Wettkampfdistanz von 2000m zurücklegen.“"
                            },
                            {
                                "example_id": "217108e9-c661-43f1-a6f0-dd93baf17c3a",
                                "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                                "text": "„Fünf Kilometer sind rein von der Distanz her keine große sportliche Herausforderung, aber trotzdem eine interessante Wettkampfdistanz.“"
                            },
                            {
                                "example_id": "73bb9b32-bb8c-4e5b-a6c1-192d761f1bd5",
                                "sense_id": "6ae9285f-1651-3583-afb3-62ad15e29cb1",
                                "text": "„Eine sehr interessante Wettkampfdistanz sind die 15 Kilometer – eine nette Mischung aus Tempo und Ausdauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
