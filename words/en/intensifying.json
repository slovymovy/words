    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "394fe596-b85f-3ad0-bd62-0507bead4852",
                    "sense_definition": "The present participle and gerund of <w>intensify</w>, meaning to make or become more intense, stronger, or more extreme.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm is <w>intensifying</w> as it moves closer to the coast.",
                            "target_lang_translations": {
                                "nl": "De storm <w>intensiveert</w> naarmate hij de kust nadert."
                            }
                        },
                        {
                            "text": "They are <w>intensifying</w> their efforts to find a solution to the problem.",
                            "target_lang_translations": {
                                "nl": "Zij <w>voeren</w> hun inspanningen om een oplossing voor het probleem te vinden <w>op</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthening",
                        "increasing",
                        "heightening",
                        "escalating"
                    ],
                    "antonyms": [
                        "weakening",
                        "decreasing",
                        "diminishing"
                    ],
                    "common_phrases": [
                        "intensifying efforts",
                        "intensifying pressure"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het sterker, krachtiger of extremer maken of worden van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "versterken",
                                "target_lang_sense_clarification": "het krachtiger maken van een proces of actie"
                            },
                            {
                                "target_lang_word": "intensiveren",
                                "target_lang_sense_clarification": "het verhogen van de intensiteit of frequentie"
                            },
                            {
                                "target_lang_word": "opvoeren",
                                "target_lang_sense_clarification": "het verhogen van de snelheid of inspanning"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ec90224-89e8-346e-979c-7aacb232d83f",
                    "sense_definition": "The act or process of making something more intense or stronger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>intensifying</w> of the conflict caused many people to flee the region.",
                            "target_lang_translations": {
                                "nl": "De <w>intensivering</w> van het conflict zorgde ervoor dat veel mensen uit de regio vluchtten."
                            }
                        },
                        {
                            "text": "Constant <w>intensifying</w> of the light levels damaged the delicate film.",
                            "target_lang_translations": {
                                "nl": "Het constant <w>versterken</w> van de lichtniveaus beschadigde de gevoelige film."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensification",
                        "strengthening",
                        "escalation"
                    ],
                    "antonyms": [
                        "weakening",
                        "diminishment"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling of het proces waarbij iets intenser of sterker wordt gemaakt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "intensivering",
                                "target_lang_sense_clarification": "het proces van sterker worden"
                            },
                            {
                                "target_lang_word": "versterking",
                                "target_lang_sense_clarification": "de actie van het krachtiger maken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
