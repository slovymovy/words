                        "glosses": [
                            "To chant, or to recite musically (especially in a synagogue)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f855a940-d6fb-44cb-8cb1-a2c46fa7fa4b",
                                "sense_id": "27150f2f-2beb-3bcc-b8cc-898b6941b9db",
                                "text": "Some recite this portion by cantillating each verse twice and then saying the Targum."
                            },
                            {
                                "example_id": "e0e642e4-04c3-4a88-9dba-19d87ef06e76",
                                "sense_id": "27150f2f-2beb-3bcc-b8cc-898b6941b9db",
                                "text": "Five women [in the Temple of Vesta ...] were cantillating—Vesta this and Vesta that—all robed in identical white dresses, with white wool scarves wrapped several times about their heads."
                            }
                        ]
                    }
