                "senses": [
                    {
                        "sense_id": "e7baca99-fa94-3b3e-8648-52a7652d96a5",
                        "entry_id": "6660ba0a-0352-38e6-8a06-7e68314b7cf3",
                        "glosses": [
                            "Lieu de fabrication, en quantité limitée, de spiritueux obtenu par distillation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc5c4ec-ae66-4cb9-ad95-9ed1bc322ae1",
                                "sense_id": "e7baca99-fa94-3b3e-8648-52a7652d96a5",
                                "text": "Même si rien n'y paraît encore à la Société des alcools, les microdistilleries poussent comme des champignons ces jours-ci au Québec."
                            },
                            {
                                "example_id": "3d74d8f5-b2b6-4ffd-bc54-84eeb08c9f38",
                                "sense_id": "e7baca99-fa94-3b3e-8648-52a7652d96a5",
                                "text": "La microdistillerie fabriquera une large gamme de spiritueux québécois incluant des gins et des vodkas."
                            },
                            {
                                "example_id": "558075c1-a800-4e04-b8e8-2183ca7a56e6",
                                "sense_id": "e7baca99-fa94-3b3e-8648-52a7652d96a5",
                                "text": "Elle partage même les valeurs des microdistilleries de campagne : petites productions, petits flacons, sens du terroir."
                            }
                        ]
                    }
                ],
