                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb5a203-07ec-4c20-b90f-3cf9d12cb62c",
                                                "sense_id": "674df1ba-08a1-3efc-9046-9ce8f9b57675",
                                                "text": "We used to think bodybuilding was all about anabolism by way of turning on testosterone and growth hormone secretion."
                                            }
