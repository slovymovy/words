        "fr-extract.jsonl": [
            {
                "entry_id": "9ef6c52a-4939-3729-b4b3-e5a5339b5b96",
                "word": "sciure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e8dffb9-b35b-3dbe-a0a2-b470096665d9",
                        "entry_id": "9ef6c52a-4939-3729-b4b3-e5a5339b5b96",
                        "glosses": [
                            "Parcelles qui tombent du bois ou de toute autre matière dure que l’on scie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41d462f-582b-44ad-9fe4-6b252ca2007b",
                                "sense_id": "3e8dffb9-b35b-3dbe-a0a2-b470096665d9",
                                "text": "De la sciure de bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "c157b17a-e568-3052-b3fb-8a7511d728d2",
                        "entry_id": "9ef6c52a-4939-3729-b4b3-e5a5339b5b96",
                        "glosses": [
                            "Sciure de bois."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "14a0bd22-e79b-4ab7-916c-b12e981e8726",
                                "sense_id": "c157b17a-e568-3052-b3fb-8a7511d728d2",
                                "text": "Il occupait un bureau tapissé d’affiches, et fleurant la sciure, pour peu qu’on reniflât avec ardeur."
                            },
                            {
                                "example_id": "974da19a-a1bf-4b35-a809-e99bb847a6c9",
                                "sense_id": "c157b17a-e568-3052-b3fb-8a7511d728d2",
                                "text": "— Allez préparer vos paniers pour le déjeuner : n’oubliez pas la sciure humide sur le parquet. Surtout ne quittez pas le préau ; ces dames peuvent avoir besoin de vous d’un instant à l’autre."
                            },
                            {
                                "example_id": "8030944b-9098-4f2f-b272-0ebf8b010a54",
                                "sense_id": "c157b17a-e568-3052-b3fb-8a7511d728d2",
                                "text": "Je lançais ma sciure à poignées, à la façon d’un garçon de café saupoudrant de sable sa terrasse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c9744b8-0bc9-4a7f-a3f6-b1da38f8a99d",
                        "source_entry_id": "9ef6c52a-4939-3729-b4b3-e5a5339b5b96",
                        "target_lang_word": "Sägemehl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sägemehl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc15660-1e79-3cfb-910f-6f2aa49a7364",
                                        "entry_id": "7bd3418d-a37c-315b-8a77-46190d2997be",
                                        "glosses": [
                                            "beim Sägen (normalerweise von Holz) auftretende Anhäufung von Spänen oder Pulver des zersägten Materials"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292171ca-7b52-464e-a719-f11fb075e242",
                                                "sense_id": "6fc15660-1e79-3cfb-910f-6f2aa49a7364",
                                                "text": "„Im Angesicht des Alpenpanoramas steigen zwei Muskelpakete in Sennenhemd und Drillichhose in den Ring aus Sägemehl.“"
                                            },
                                            {
                                                "example_id": "513c46a6-cf51-42c8-93bf-ac0d76f66fbd",
                                                "sense_id": "6fc15660-1e79-3cfb-910f-6f2aa49a7364",
                                                "text": "Beim Tischlern fällt gewöhnlich eine Menge Sägemehl an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
