                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778869b1-28d6-41f7-8a73-d2fcf8f66eed",
                                                "sense_id": "434331f0-bf27-36db-ba7f-b00030b1d698",
                                                "text": "On peut supposer, à ce qu’il semble, que le refondateur de la langue hébraïque moderne, Éliézer Ben-Yéhuda, ait repris un schème de signification qui pourrait bien être celui de la version napoléonienne, puis laïque, de l’émancipation qui confessionnalise et « religionnise » le judaïsme."
                                            }
                                        ]
                                    }
