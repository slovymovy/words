                        "zh": "动词 hike 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похо́д",
                                "target_lang_sense_clarification": "процесс пешего путешествия"
                            },
                            {
                                "target_lang_word": "повыше́ние",
                                "target_lang_sense_clarification": "процесс увеличения стоимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "徒步",
                                "target_lang_sense_clarification": "指进行远足活动的过程"
                            },
                            {
                                "target_lang_word": "提高",
                                "target_lang_sense_clarification": "指增加价格或费用的过程"
                            }
                        ]
                    }
                }
