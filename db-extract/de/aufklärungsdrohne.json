                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8665c505-53ee-4323-9787-6bf427875c2d",
                                "sense_id": "b7904241-399d-370d-9c05-4091bedcd07f",
                                "text": "„Eine US-Aufklärungsdrohne ist nach Angaben des pakistanischen Geheimdienstes im Grenzgebiet zu Afghanistan abgestürzt.“"
                            },
                            {
                                "example_id": "10b8d2fe-96a0-4846-b2ba-a7626a6b0ffc",
                                "sense_id": "b7904241-399d-370d-9c05-4091bedcd07f",
                                "text": "„Zusätzlich wurde jedes Fahrzeug, das die Villa verließ, von Aufklärungsdrohnen verfolgt.“"
                            }
                        ],
