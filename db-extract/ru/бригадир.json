                                    {
                                        "sense_id": "dd5cba99-f23f-3e7f-91dc-10d8459e4ea1",
                                        "entry_id": "ec9ca07d-af05-3155-ab4b-291c42e0edca",
                                        "glosses": [
                                            "An army rank; an officer commanding a brigade."
                                        ],
                                        "tags": [],
