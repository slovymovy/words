{
    "word_family": [
        "shop",
        "shopping",
        "shopkeeper",
        "shopaholic",
        "shopfront",
        "shoplift"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e029fbf-f8a1-3e41-a0b2-c52ec0eecc3f",
                    "sense_definition": "A person who visits stores to look at or buy goods.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store was crowded with an <w>adventurous</w> <w>shopper</w> looking for unique gifts.",
                            "target_lang_translations": {
                                "ru": "Магазин был переполнен азартными <w>покупателями</w>, ищущими уникальные подарки."
                            }
                        },
                        {
                            "text": "Every <w>online</w> <w>shopper</w> should be careful when entering their credit card details.",
                            "target_lang_translations": {
                                "ru": "Каждый интернет-<w>покупатель</w> должен быть осторожен при вводе данных своей кредитной карты."
                            }
                        }
                    ],
                    "synonyms": [
                        "customer",
                        "buyer",
                        "consumer"
                    ],
                    "antonyms": [
                        "seller",
                        "vendor"
                    ],
                    "common_phrases": [
                        "online shopper",
                        "adventurous shopper",
                        "frequent shopper",
                        "savvy shopper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который посещает магазины, чтобы посмотреть или купить товары."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покупатель",
                                "target_lang_sense_clarification": "человек, совершающий покупки"
                            },
                            {
                                "target_lang_word": "посетитель магазина",
                                "target_lang_sense_clarification": "тот, кто пришел в магазин"
                            },
                            {
                                "target_lang_word": "шопер",
                                "target_lang_sense_clarification": "человек, увлекающийся покупками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75558050-b72f-30bd-9f14-74d508cd5277",
                    "sense_definition": "A free local newspaper that primarily contains advertisements and coupons for local businesses.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "publications",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a great discount for the new bakery in the <w>weekly</w> <w>shopper</w>.",
                            "target_lang_translations": {
                                "ru": "Я нашел отличную скидку в новую пекарню в еженедельной <w>рекламной газете</w>."
                            }
                        },
                        {
                            "text": "Most people just throw the <w>local</w> <w>shopper</w> straight into the recycling bin.",
                            "target_lang_translations": {
                                "ru": "Большинство людей просто выбрасывают местный <w>рекламный листок</w> прямо в корзину для вторсырья."
                            }
                        }
                    ],
                    "synonyms": [
                        "pennysaver"
                    ],
                    "common_phrases": [
                        "weekly shopper",
                        "local shopper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесплатная местная газета, содержащая преимущественно рекламу и купоны местных предприятий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекламная газета",
                                "target_lang_sense_clarification": "бесплатное издание с объявлениями"
                            },
                            {
                                "target_lang_word": "рекламный листок",
                                "target_lang_sense_clarification": "малоформатное издание с купонами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a6e0dbc-f3e0-3126-9712-bacdd2880ab6",
                    "sense_definition": "A type of bicycle with small wheels and often a large basket, designed for short trips and carrying groceries.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rode her <w>humble</w> <w>shopper</w> to the market every morning to get fresh bread.",
                            "target_lang_translations": {
                                "ru": "Каждое утро она ездила на рынок за свежим хлебом на своем скромном <w>хозяйственном велосипеде</w>."
                            }
                        },
                        {
                            "text": "While others had racing bikes, he preferred the upright position of his old <w>shopper</w>.",
                            "target_lang_translations": {
                                "ru": "В то время как у других были гоночные велосипеды, он предпочитал прямую посадку своего старого <w>ситибайка</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shopping bike"
                    ],
                    "common_phrases": [
                        "humble shopper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип велосипеда с маленькими колесами и часто большой корзиной, предназначенный для коротких поездок за продуктами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяйственный велосипед",
                                "target_lang_sense_clarification": "велосипед для поездок за покупками"
                            },
                            {
                                "target_lang_word": "ситибайк",
                                "target_lang_sense_clarification": "городской велосипед с корзиной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "841d585f-acfc-313e-b25a-1e8a9bb239b6",
                    "sense_definition": "A plastic or reusable bag used for carrying purchased items.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carried the heavy groceries in a large <w>plastic</w> <w>shopper</w>.",
                            "target_lang_translations": {
                                "ru": "Он нес тяжелые продукты в большом пластиковом <w>пакете</w>."
                            }
                        },
                        {
                            "text": "The store stopped giving out a <w>plastic</w> <w>shopper</w> to encourage environmental friendliness.",
                            "target_lang_translations": {
                                "ru": "Магазин перестал выдавать пластиковые <w>пакеты</w>, чтобы способствовать экологичности."
                            }
                        }
                    ],
                    "synonyms": [
                        "carrier bag",
                        "shopping bag"
                    ],
                    "common_phrases": [
                        "plastic shopper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage for a bag"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пластиковая или многоразовая сумка, используемая для переноски купленных товаров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хозяйственная сумка",
                                "target_lang_sense_clarification": "большая сумка для продуктов"
                            },
                            {
                                "target_lang_word": "шопер",
                                "target_lang_sense_clarification": "вместительная сумка без застежки"
                            },
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "пластиковый пакет для покупок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}