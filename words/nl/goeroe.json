                    "sense_definition": "een spiritueel leraar of gids, oorspronkelijk binnen het hindoeïsme of boeddhisme",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religieus leider",
                    "name_type": "no",
                    "examples": [
