                    },
                    {
                        "translation_id": "acba14a8-8aea-4bfb-9dfe-2d7ec316fa17",
                        "source_entry_id": "98e5f5bf-105a-3d1e-8a2f-327108bf2bc7",
                        "source_sense_id": "e900a0ed-b758-384b-ae28-40119be768b0",
                        "target_lang_word": "Oman",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oman",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                        "entry_id": "ee339d9c-6ca4-3a73-9024-b17faaa122e6",
                                        "glosses": [
                                            "Staat im Südosten der Arabischen Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23b7ca13-bcf7-42a0-abb5-0dbde2cf35f3",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "Oman lebt vom Ölexport, Tourismus und der Landwirtschaft."
                                            },
                                            {
                                                "example_id": "b3542e67-5c34-4e3d-8c18-0a9ea1fc22ce",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "Maskat ist die Hauptstadt von Oman."
                                            },
                                            {
                                                "example_id": "bda94eff-12b6-4d7c-9d0f-5106be5b0c36",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "„Das heutige Oman war bereits in der Steinzeit besiedelt.“"
                                            },
                                            {
                                                "example_id": "0be233fb-d664-4825-b98c-d510a73e4497",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "„Unter anderem waren Forscher 2018 im Rahmen der Simulation ‚Amadee 18‘ in der Wüste des Oman unterwegs.“"
                                            },
                                            {
                                                "example_id": "58cf2dc7-9d27-4676-b685-d412ccd90423",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "„Doch das Gefühl, was man seinem Pferd zumuten kann, haben viele offenbar verloren, nicht nur die Reiter aus den arabischen Staaten, von denen am Ende nur noch ein Starter aus dem Oman im Rennen war.“"
                                            },
                                            {
                                                "example_id": "99addd91-bafe-4b9b-a619-12da26703072",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "„Die Golfregion im Mittleren Osten ist eines der Hitzezentren der Erde. Das zeigt eine neue maximale Minimumtemperatur, die im Oman gemessen wurde.“"
                                            },
                                            {
                                                "example_id": "dff7db98-14ca-4755-ba9d-1835ec61cc47",
                                                "sense_id": "a3481394-95bc-3d53-b290-4cecf40c1666",
                                                "text": "„Der Oman ist ein Land voller Magie, der man als Luxusreisender genauso erliegen kann wie als Abenteurer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
