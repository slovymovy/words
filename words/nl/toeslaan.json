{
    "word_family": [
        "slag",
        "slager",
        "slagerij",
        "slagveld"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1569dafb-b15b-3d4f-b162-2c35d1f4c34d",
                    "sense_definition": "Met kracht dichtvallen of dichtdoen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De deur <w>sloeg</w> hard <w>toe</w> door de tocht.",
                            "target_lang_translations": {
                                "en": "The door <w>slammed shut</w> hard because of the draft."
                            }
                        },
                        {
                            "text": "Hij <w>sloeg</w> het boek gefrustreerd <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "He <w>slammed</w> the book <w>shut</w> in frustration."
                            }
                        }
                    ],
                    "synonyms": [
                        "dichtslaan"
                    ],
                    "common_phrases": [
                        "deur slaat toe"
                    ],
                    "target_lang_definitions": {
                        "en": "To close or shut something with force."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slam shut",
                                "target_lang_sense_clarification": "Used for doors or lids closing forcefully."
                            },
                            {
                                "target_lang_word": "bang shut",
                                "target_lang_sense_clarification": "Used for objects closing with a loud noise."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a113dc2-bf42-39dc-8dda-7600eb3267f5",
                    "sense_definition": "De kans grijpen of profiteren van een situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de prijzen daalden, <w>sloegen</w> de beleggers direct <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "When prices dropped, the investors <w>struck</w> immediately."
                            }
                        },
                        {
                            "text": "Je moet op het juiste moment <w>toeslaan</w> om de winst te pakken.",
                            "target_lang_translations": {
                                "en": "You have to <w>strike</w> at the right moment to take the profit."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingrijpen",
                        "profiteren"
                    ],
                    "common_phrases": [
                        "op het juiste moment toeslaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To seize an opportunity or take advantage of a situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seize the opportunity",
                                "target_lang_sense_clarification": "To act quickly when a chance arises."
                            },
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "To act decisively at the right moment."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f073363e-bb6d-3958-aa22-93c9fb24ad12",
                    "sense_definition": "Plotseling optreden of toeslaan (van een ramp of ziekte)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebeurtenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter kan de griep hard <w>toeslaan</w>.",
                            "target_lang_translations": {
                                "en": "In winter, the flu can <w>strike</w> hard."
                            }
                        },
                        {
                            "text": "De natuurramp <w>sloeg</w> onverwacht <w>toe</w> in de regio.",
                            "target_lang_translations": {
                                "en": "The natural disaster <w>struck</w> the region unexpectedly."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To occur or affect suddenly, often referring to disasters or illnesses."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "Used for sudden, negative events like disasters or diseases."
                            },
                            {
                                "target_lang_word": "hit",
                                "target_lang_sense_clarification": "To affect an area or population suddenly."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7e5024b-aeb7-3d33-adb0-cb2a3dc6cbf4",
                    "sense_definition": "Een aanval uitvoeren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vijand <w>sloeg</w> midden in de nacht <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "The enemy <w>struck</w> in the middle of the night."
                            }
                        },
                        {
                            "text": "De inbrekers <w>sloegen</w> <w>toe</w> terwijl de bewoners sliepen.",
                            "target_lang_translations": {
                                "en": "The burglars <w>struck</w> while the residents were sleeping."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To carry out an attack."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strike",
                                "target_lang_sense_clarification": "To launch an attack."
                            },
                            {
                                "target_lang_word": "attack",
                                "target_lang_sense_clarification": "To commit an act of aggression."
                            }
                        ]
                    }
                }
            ]
        }
    ]
