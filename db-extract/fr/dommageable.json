                "forms": [
                    {
                        "form_id": "2ccb7b1e-8595-4262-b935-72fd4b795806",
                        "entry_id": "f0be5a8e-f65e-37cf-a8cb-b6dc99956875",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dommageables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                        "entry_id": "f0be5a8e-f65e-37cf-a8cb-b6dc99956875",
                        "glosses": [
                            "Qui cause du dommage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbf6f902-4def-495b-9d0b-1196f174c2c5",
                                "sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                                "text": "Cette entreprise lui a été fort dommageable."
                            },
                            {
                                "example_id": "8be91d5c-afec-43de-b962-c9857c57b58c",
                                "sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                                "text": "Odeur d’enfance et odeur de pauvreté, de tristesse aussi, comme si les particules noires de combustion illustraient les malheurs, petits ou grands, dommageables ou bénins, pérennes ou passagers, qui se déposent sur les vies humaines et les souillent."
                            },
                            {
                                "example_id": "eada3b87-761a-456e-a19c-b42fad8cc6ed",
                                "sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                                "text": "La CAA de Bordeaux rappelle qu’il appartient, en principe, au maître d’ouvrage qui entend obtenir la réparation des conséquences dommageables d’un vice imputable à la conception ou à l’exécution d’un ouvrage de diriger son action contre le ou les constructeurs avec lesquels il a conclu un contrat de louage d’ouvrage."
                            },
                            {
                                "example_id": "85ec8bdb-410d-4202-80d2-88b11daf95d7",
                                "sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                                "text": "Nous construisons notre sens de la communauté et nos quartiers autour de nos rues urbaines, soutient-il. Tout ce qui mine ce tissu, cette continuité, sera dommageable pour le quartier. Et ce sera très difficile de revenir de ça parce que les habitudes des gens vont changer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc347fab-ffd5-4717-9942-8e652b8ba513",
                        "source_entry_id": "f0be5a8e-f65e-37cf-a8cb-b6dc99956875",
                        "source_sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                        "target_lang_word": "schädlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schädlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                        "entry_id": "3f38145a-2519-35c7-8611-7de29054c3cf",
                                        "glosses": [
                                            "zur Schädigung führend, sich nachteilig auswirkend, Schaden verursachend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "075bb4e6-5cb2-4203-b52f-6e05642da6c4",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "Quecksilber ist sehr schädlich für die Atemwege."
                                            },
                                            {
                                                "example_id": "a9ab44eb-6322-4fa0-acf4-49d69c995e4a",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "Unterschlagung ist schädlich für die Wirtschaft."
                                            },
                                            {
                                                "example_id": "0f986085-9b1d-44c3-a993-6f4b3f5cb8d0",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "„Alkohol ist zwar für die Gesundheit des Menschen schädlich, für viele Krankheitserreger ist er dagegen absolut tödlich.“"
                                            },
                                            {
                                                "example_id": "be44871d-7611-4495-af87-66800f005a7d",
                                                "sense_id": "0ab1bc1e-a722-3118-a02d-d35b052ea4f2",
                                                "text": "„Wasserstoff ist ein umweltfreundlicher Energieträger. Bei seiner Verbrennung entstehen keine schädlichen Abgase, sondern nur Wasserdampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b80df3ff-c11d-4859-9126-7d447055753e",
                        "source_entry_id": "f0be5a8e-f65e-37cf-a8cb-b6dc99956875",
                        "source_sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                        "target_lang_word": "ζημιογόνος",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ζημιογόνος",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "6cbc1cc0-9e8a-30dc-aabc-f2c9efecbd5e",
                                        "entry_id": "a33a5f42-06b2-3811-afb1-23d90b0945ff",
                                        "glosses": [
                                            "που ζημιώνει, προκαλεί ζημία"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee2fd20-674c-4545-b4da-b8d78907930f",
                                                "sense_id": "6cbc1cc0-9e8a-30dc-aabc-f2c9efecbd5e",
                                                "text": "το κάπνισμα είναι ζημιογόνο για την υγεία"
                                            },
                                            {
                                                "example_id": "a4b0dc28-7322-4c2a-b452-8414344a1d64",
                                                "sense_id": "6cbc1cc0-9e8a-30dc-aabc-f2c9efecbd5e",
                                                "text": "※ Ωστόσο, οι καύσωνες της Άνοιξης και ιδίως του Μάιου, παραδόξως, είναι και ωφέλιμοι γιατί είναι ζημιογόνοι για τον Δάκο. Και αυτό γιατί είναι γνωστό ότι ακμαία άτομα Δάκου που εκτίθενται επί αρκετό χρόνο σε θερμοκρασίες άνω 32^ο αδρανοποιούνται και άνω των 36^ο θνήσκουν. (Ν. Μιχελάκης, Καύσωνες εναντίον Ελιάς αλλά και … Δάκου! Πιθανοί κίνδυνοι αλλά και ...οφέλη., Σύλλογος Ελαιοκομικών Δήμων Κρήτης, 14/5/2020 https://sedik.gr/arxeio-elaioneon/2020/1864-kausones-enantion-elias-alla-kai-dakou)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cbd4886-157d-36a4-8f99-cbc69d8e7cec",
                                        "entry_id": "a33a5f42-06b2-3811-afb1-23d90b0945ff",
                                        "glosses": [
                                            "που αφορά αρνητικό ισοζύγιο εσόδων"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0dd7698-1059-4156-af84-c68a63011aba",
                                                "sense_id": "1cbd4886-157d-36a4-8f99-cbc69d8e7cec",
                                                "text": "το σφάλμα της διοίκησης απέβη ζημιογόνο για την εταιρεία"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0fcb6b4-cade-4a45-8392-4f53060936fb",
                        "source_entry_id": "f0be5a8e-f65e-37cf-a8cb-b6dc99956875",
                        "source_sense_id": "6fcdaf8e-a3b7-3593-b489-0a02c1fdc262",
                        "target_lang_word": "schadelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schadelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                        "entry_id": "f661cf4a-478d-3278-9ed1-69f0c0b74c56",
                                        "glosses": [
                                            "schade toebrengend; ziek makend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd5090a-0c2b-44fa-be53-1829c0a9f409",
                                                "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                                "text": "Te veel eten is schadelijk voor de gezondheid."
                                            },
                                            {
                                                "example_id": "789a38fd-d6f0-4c1f-bc28-c99b8560b88e",
                                                "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                                "text": "Al snel duiken gezondheidsklachten op. Niet bij Van Nijen, die er nuchter in staat. 'Als het echt erg was, had de GGD wel gewaarschuwd.' Andere bewoners maken zich grote zorgen. 'Een gifwijk!', roepen ze. 'Wij gaan dood hier.' De autoriteiten proberen de onrust te temperen. Volgens de GGD blijft de uitstoot van schadelijke stoffen binnen de normen."
                                            },
                                            {
                                                "example_id": "07028bd6-3cc9-45f5-aca9-6090ddc613cd",
                                                "sense_id": "a00a4a7e-5c92-3246-b020-b7bb1a1b5cff",
                                                "text": "De tests gingen niet van een leien dakje. De eerste keer was er een probleem met de mobiele draagraket. Een systeem dat ventilatoren gebruikt om schadelijke gassen buiten te houden werkte niet naar behoren. De tweede keer ging het mis omdat medewerkers een ventiel niet hadden opengedraaid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
