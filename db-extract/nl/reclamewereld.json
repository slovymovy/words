                        ],
                        "examples": [
                            {
                                "example_id": "58e3d67f-09fb-4000-a3a1-58425c3ffed9",
                                "sense_id": "77d8922f-b068-3359-8ca2-2f98fcf86dc5",
                                "text": "Real time bidding heeft grote gevolgen voor de reclamewereld. De macht van grote adverteerders met flinke budgetten neemt af ten gunste van kleine slimme adverteerders."
                            },
                            {
                                "example_id": "d2dfe65f-033d-4356-b39a-2cfe9a6b3b12",
                                "sense_id": "77d8922f-b068-3359-8ca2-2f98fcf86dc5",
                                "text": "Slechts enkele beeldmerken komen er dan ook mee weg de merknaam helemaal te schrappen uit het logo. Het is de elite van de reclamewereld, zoals de swoosh van Nike, de batwing van Levi's spijkerbroeken, de pinguïn van het boekenmerk of Bibendum van Michelin. Allemaal herkenbaar zonder de merknaam."
                            }
                        ]
