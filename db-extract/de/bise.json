                ],
                "senses": [
                    {
                        "sense_id": "289908c1-6e8a-3147-8ceb-1a9314047381",
                        "entry_id": "ec18d169-1cfe-3120-a515-b73425716535",
                        "glosses": [
                            "ein kalter und trockener, in der Regel aus Norden, Nordosten oder Osten wehender und gewöhnlich aufhellender Wind"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "00fc9d8c-943e-44fe-807a-0241e5fd579b",
                                "sense_id": "289908c1-6e8a-3147-8ceb-1a9314047381",
                                "text": "„Nach dem Walliser Volksglauben ist die Bise erst seit der Reformation ins Land gekommen; mit der Kälte im Glauben sei auch Kälte in der Natur eingetreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ea7240b-007b-3771-aafd-636bc448878f",
                        "entry_id": "ec18d169-1cfe-3120-a515-b73425716535",
                        "glosses": [
                            "ein im Schweizer Mittelland vorkommender, aus Nordosten wehender Regionalwind"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "4c5f9296-5b75-4093-80fc-2cd96898dc6b",
                                "sense_id": "1ea7240b-007b-3771-aafd-636bc448878f",
                                "text": "„In der Meteorologie wird immer die Richtung genannt, wo der Wind her kommt. Der Nordwind ist ein allgemeiner Wind, der aus Norden kommt. Der Nordföhn ist ein typischer Fallwind im Tessin. Er ist zusätzlich an die Bedingung geknüpft, dass von Norden her feuchte Luft an der Alpennordseite aufsteigt und im Süden als trockener Fallwind wieder absinkt. Die Bise letztlich ist ein Nordostwind im Mittelland. Streng genommen ist es ein Regionalwind, der nur im Mittelland vorkommen kann. In der Nordwestschweiz wird auch von Bise gesprochen, eigentlich ist es dort aber einfach ein Nordost- oder Ostwind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9dbf67e2-a629-33f2-9f3d-21ab590aaff8",
                        "entry_id": "ec18d169-1cfe-3120-a515-b73425716535",
                        "glosses": [
                            "die Himmelsrichtung, woher der Wind weht"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "051bfacf-a7d8-4295-9938-95cb1c5f38f8",
                                "sense_id": "9dbf67e2-a629-33f2-9f3d-21ab590aaff8",
                                "text": "„Gegen Bisen“, in zwei 1720 und 1763 vorgenommenen Grenzbereinigungen zwischen Bern und Freiburg."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
