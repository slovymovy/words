                            {
                                "example_id": "78e4df64-7f3d-439f-9cc0-90388c6ecf15",
                                "sense_id": "964dc233-bd73-38c2-a3c0-51c6c0821d68",
                                "text": "Pete dressed Eddie's high-pitched voicings in the stick-sweet strings of the Philadelphia Symphony Orchestra."
