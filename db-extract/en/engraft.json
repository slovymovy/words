                    {
                        "sense_id": "068ea60f-befd-3387-8857-79046bbb609b",
                        "entry_id": "12d4f8dc-28ef-30b4-82c6-f79f60c682bc",
                        "glosses": [
                            "To insert, as a scion of one tree or plant into another, for the purpose of propagation; graft onto a plant"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c0ba80dd-d333-391d-911f-f6b9f3c722fc",
                        "entry_id": "12d4f8dc-28ef-30b4-82c6-f79f60c682bc",
                        "glosses": [
                            "To fix firmly into place"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b88b82-92ce-4067-9e79-57dbcd908310",
                                "sense_id": "c0ba80dd-d333-391d-911f-f6b9f3c722fc",
                                "text": "Then the conceit of this inconstant stay\nSets you most rich in youth before my sight,\nWhere wasteful Time debateth with Decay,\nTo change your day of youth to sullied night;\nAnd all in war with Time for love of you,\nAs he takes from you, I engraft you new."
                            }
                        ]
                    }
