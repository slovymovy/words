        "fr-extract.jsonl": [
            {
                "entry_id": "d4647434-0dda-3741-973f-b95c1a02fc1e",
                "word": "purgation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "008d4097-90f4-4611-ba6d-1f738491d2bf",
                        "entry_id": "d4647434-0dda-3741-973f-b95c1a02fc1e",
                        "tags": [
                            "plural"
                        ],
                        "form": "purgations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e4f9790-6d01-3dbc-8970-857e9fac8743",
                        "entry_id": "d4647434-0dda-3741-973f-b95c1a02fc1e",
                        "glosses": [
                            "Évacuation par le moyen d’un remède qui purge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b09efff3-5950-42a6-8f31-6aaeac1d6488",
                                "sense_id": "9e4f9790-6d01-3dbc-8970-857e9fac8743",
                                "text": "Lorsqu’une femme nourrice se purge pour quelques affections légères, il est à propos que, pendant les effets de sa purgation, elle fasse téter son enfant des deux seins, au moins une fois; sans cette précaution, son lait pourrait disparaître."
                            },
                            {
                                "example_id": "bfe123bf-5be6-480f-bcac-57d6ceef4e39",
                                "sense_id": "9e4f9790-6d01-3dbc-8970-857e9fac8743",
                                "text": "Avec le lacto-sérum, surtout s'il est très légèrement additionné de sel de soude, nous disposons d'un moyen très sûr et très efficace et, par surcroît agréable, d'obtenir des purgations aussi importantes qu'on le désire."
                            },
                            {
                                "example_id": "ef1154c6-aca9-4dcc-ae10-bed3e7aac0c5",
                                "sense_id": "9e4f9790-6d01-3dbc-8970-857e9fac8743",
                                "text": "Une pratique, pourtant, prend pour Lessius, une place qu'elle n'avait pas auparavant : la purgation, censée régulièrement « décharger toutes les mauvaises humeurs » ([…])."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ea10f27-9206-33f9-acbe-43a1b6548495",
                        "entry_id": "d4647434-0dda-3741-973f-b95c1a02fc1e",
                        "glosses": [
                            "Remède que l’on prend pour se purger."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a61aef8f-ebae-4d4d-b029-774958fdbf49",
                                "sense_id": "5ea10f27-9206-33f9-acbe-43a1b6548495",
                                "text": "[…], nous voyons ces mêmes personnes, quand elles ont eu recours aux mélodies qui transportent l'âme hors d'elle-même, remises d'aplomb comme si elles avaient pris un remède et une purgation."
                            },
                            {
                                "example_id": "6982a0ba-6655-4448-8d83-174227650833",
                                "sense_id": "5ea10f27-9206-33f9-acbe-43a1b6548495",
                                "text": "L’Adélaïde ne croyait pas qu’il fût opportun d’administrer une purgation par les jours de grand soleil : le corps est plein de choses dangereuses qui tournent facilement en eaux amères et en purulences. Un coup de chaleur sur une purge, et voilà l’huile qui revient sur le cœur, ou encore qui se mélange au sang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39f89dad-57e6-4e8e-aabb-3f4f59724190",
                        "source_entry_id": "d4647434-0dda-3741-973f-b95c1a02fc1e",
                        "target_lang_word": "purge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "purge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "413f29c9-f512-33a3-b9fe-7b100b78fc53",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To clean thoroughly; to rid of impurities; to cleanse."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb8e1689-2022-33d9-ba42-b35691d244e5",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To remove by cleansing; to wash away."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9ee4032-e0ef-353b-81d5-aa3f924c572d",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To free from sin, guilt, or burden."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd8dd236-5d88-472e-95f8-47b440d371dd",
                                                "sense_id": "f9ee4032-e0ef-353b-81d5-aa3f924c572d",
                                                "text": "Purge away our sins, for thy name’s sake."
                                            },
                                            {
                                                "example_id": "8ddc6010-dacc-4f15-b94a-0a31e8741e91",
                                                "sense_id": "f9ee4032-e0ef-353b-81d5-aa3f924c572d",
                                                "text": "We'll join our cares to purge away / Our country’s crimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "129e3bf1-0083-3a12-a050-35ab9ac6a205",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To evacuate (the bowels or the stomach); to defecate or vomit."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6307f232-7ada-31d7-a2b5-a95cecdbabaa",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To cause someone to purge; to operate (on somebody) using a cathartic or emetic, or in a similar manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33181a5b-2fd6-4c0f-8066-2a5bda182a5b",
                                                "sense_id": "6307f232-7ada-31d7-a2b5-a95cecdbabaa",
                                                "text": "\"What did they die of?” I asked. / \"Fevers. The doctor came and bled them and purged them, but they still died.\" / \"He bled and purged babies?\" / \"They were two and three. He said it would break the fever. And it did. But they … they died anyway.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3747af89-dcb0-3311-95c7-37dba9921000",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To forcibly remove, for example, from political activity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb769664-799c-4cf4-91ab-7eada1626d67",
                                                "sense_id": "3747af89-dcb0-3311-95c7-37dba9921000",
                                                "text": "Deng Xiaoping was purged twice during the Cultural Revolution, but managed to return to power after Mao's death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaf9d57d-e43e-3026-9e4f-ab05113567ca",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To forcibly remove people by an organization."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fac8b2c-11d1-4522-91c2-f32381ae3536",
                                                "sense_id": "eaf9d57d-e43e-3026-9e4f-ab05113567ca",
                                                "text": "Cromwell had Colonel Pride purge Parliament of royalists who opposed Charles I's execution."
                                            },
                                            {
                                                "example_id": "9004bd17-31a8-4dfa-aee5-58bd2569a8de",
                                                "sense_id": "eaf9d57d-e43e-3026-9e4f-ab05113567ca",
                                                "text": "Late triumphs of Russian science are scaring the very dogwater out of large elements in our society, and we both fear more \"purging\" instead of more effort at catching up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b6f4cc-e9d1-3568-bb1c-f98754faa590",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To clear of a charge, suspicion, or imputation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77f9e4a5-9e49-38e3-9c84-074161460c1d",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To clarify; to clear the dregs from (liquor)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ca9c394-076b-3ccf-b22f-88c4f217cdc5",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To become pure, as by clarification."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b67d17e9-4d5a-394b-a066-71dfe22f974d",
                                        "entry_id": "f27c052c-5cbd-3018-a0bf-0b85c41874bd",
                                        "glosses": [
                                            "To have or produce frequent evacuations from the intestines, as by means of a cathartic."
                                        ],
