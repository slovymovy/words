                        "entry_id": "3c97f711-3a79-33a6-aa1e-9bb1878e5348",
                        "glosses": [
                            "A traditional Japanese inn with communal baths and other public areas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b820aec4-05d3-4cef-8b19-3bcd01b8e233",
                                "sense_id": "eb54b5b1-d702-3d4d-ba84-1a4746d3e2c5",
                                "text": "Mr. Ducasse is pursuing plans for a new hotel one hour from central Tokyo, a cross between a ryokan, a traditional Japanese inn, and an auberge, a French country inn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85e92f6d-3950-41cc-aab0-376e7a2e58b1",
