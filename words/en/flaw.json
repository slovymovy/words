{
    "word_family": [
        "flawless",
        "flawlessly",
        "flawedness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56ead861-a212-3510-96e3-bbe49eb5bc0f",
                    "sense_definition": "A defect, fault, or imperfection, especially one that is hidden or not immediately obvious.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "imperfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective noticed a tiny <w>flaw</w> in the suspect's alibi that eventually led to his arrest.",
                            "target_lang_translations": {
                                "ru": "Детектив заметил крошечный <w>изъян</w> в алиби подозреваемого, что в итоге привело к его аресту."
                            }
                        },
                        {
                            "text": "Despite being a great leader, his fatal <w>flaw</w> was his inability to trust his advisors.",
                            "target_lang_translations": {
                                "ru": "Несмотря на то что он был великим лидером, его роковым <w>недостатком</w> была неспособность доверять своим советникам."
                            }
                        }
                    ],
                    "synonyms": [
                        "vice"
                    ],
                    "antonyms": [
                        "perfection",
                        "strength"
                    ],
                    "common_phrases": [
                        "fatal flaw",
                        "character flaw",
                        "minor flaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дефект, недостаток или несовершенство, особенно скрытое или не сразу заметное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоста́ток",
                                "target_lang_sense_clarification": "общее несовершенство"
                            },
                            {
                                "target_lang_word": "изъя́н",
                                "target_lang_sense_clarification": "скрытый или явный дефект"
                            },
                            {
                                "target_lang_word": "поро́к",
                                "target_lang_sense_clarification": "серьезный недостаток характера или структуры"
                            },
                            {
                                "target_lang_word": "дефе́кт",
                                "target_lang_sense_clarification": "несовершенство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7561b198-d541-3e58-822a-57c19f45ee77",
                    "sense_definition": "A physical crack, breach, or gap in an object that affects its continuity or strength.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_defect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer discovered a structural <w>flaw</w> in the bridge that required immediate repair.",
                            "target_lang_translations": {
                                "ru": "Инженер обнаружил структурный <w>дефект</w> в мосту, который требовал немедленного ремонта."
                            }
                        },
                        {
                            "text": "You should check the ceramic vase for any <w>flaw</w> before you decide to purchase it.",
                            "target_lang_translations": {
                                "ru": "Вам следует проверить керамическую вазу на наличие любого <w>изъяна</w>, прежде чем решите её купить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "structural flaw",
                        "surface flaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая трещина, разлом или зазор в объекте, влияющий на его целостность или прочность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тре́щина",
                                "target_lang_sense_clarification": "физический разлом"
                            },
                            {
                                "target_lang_word": "изъя́н",
                                "target_lang_sense_clarification": "повреждение поверхности или структуры"
                            },
                            {
                                "target_lang_word": "дефе́кт",
                                "target_lang_sense_clarification": "техническая неисправность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55b48155-f622-35ec-8c2c-84275be8a528",
                    "sense_definition": "An inclusion, stain, or other defect found within a diamond or other gemstone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gemology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jeweler used a magnifying glass to look for a microscopic <w>flaw</w> inside the emerald.",
                            "target_lang_translations": {
                                "ru": "Ювелир использовал увеличительное стекло, чтобы найти микроскопический <w>поро́к</w> внутри изумруда."
                            }
                        },
                        {
                            "text": "A diamond with no visible <w>flaw</w> is extremely rare and very expensive.",
                            "target_lang_translations": {
                                "ru": "Алмаз без видимых <w>изъянов</w> встречается крайне редко и стоит очень дорого."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in gemology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Включение, пятно или другой дефект внутри алмаза или другого драгоценного камня."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поро́к",
                                "target_lang_sense_clarification": "дефект в драгоценном камне"
                            },
                            {
                                "target_lang_word": "изъя́н",
                                "target_lang_sense_clarification": "несовершенство камня"
                            },
                            {
                                "target_lang_word": "дефе́кт",
                                "target_lang_sense_clarification": "включение или пятно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25c08f6a-d1a4-3080-8b59-e3331bd623ab",
                    "sense_definition": "A defect or error in a legal contract or document which may make it invalid or ineffective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_error",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer found a legal <w>flaw</w> in the contract that allowed his client to cancel the deal.",
                            "target_lang_translations": {
                                "ru": "Адвокат нашел юридический <w>изъян</w> в контракте, который позволил его клиенту аннулировать сделку."
                            }
                        },
                        {
                            "text": "A small <w>flaw</w> in the wording of the will caused a long dispute among the heirs.",
                            "target_lang_translations": {
                                "ru": "Небольшая <w>ошибка</w> в формулировке завещания вызвала долгий спор между наследниками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal flaw"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дефект или ошибка в юридическом контракте или документе, которые могут сделать его недействительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изъя́н",
                                "target_lang_sense_clarification": "ошибка в документе"
                            },
                            {
                                "target_lang_word": "недочёт",
                                "target_lang_sense_clarification": "упущение в тексте"
                            },
                            {
                                "target_lang_word": "оши́бка",
                                "target_lang_sense_clarification": "юридическая неточность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dae9474-6b8e-3349-ad7a-2d5ccff331b5",
                    "sense_definition": "A sudden, brief burst or gust of wind; a short-lived storm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat was nearly overturned by a sudden <w>flaw</w> of wind coming off the coast.",
                            "target_lang_translations": {
                                "ru": "Маленькую лодку чуть не перевернул внезапный <w>порыв</w> ветра, дующий с берега."
                            }
                        },
                        {
                            "text": "Sailors must be careful of a summer <w>flaw</w> that can appear without warning.",
                            "target_lang_translations": {
                                "ru": "Моряки должны остерегаться летнего <w>шквала</w>, который может возникнуть без предупреждения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный, кратковременный порыв или дуновение ветра; короткий шторм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шквал",
                                "target_lang_sense_clarification": "резкий порыв ветра"
                            },
                            {
                                "target_lang_word": "поры́в ве́тра",
                                "target_lang_sense_clarification": "внезапное дуновение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8387b268-f57e-3cdd-b33e-f240c80f2b02",
                    "sense_definition": "A sudden burst of noise, disorder, or a loud quarrel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet evening was interrupted by a mighty <w>flaw</w> coming from the tavern down the street.",
                            "target_lang_translations": {
                                "ru": "Тихий вечер был прерван мощным <w>шумом</w>, доносившимся из таверны вниз по улице."
                            }
                        },
                        {
                            "text": "He was startled by the sudden <w>flaw</w> of shouting and clashing metal in the courtyard.",
                            "target_lang_translations": {
                                "ru": "Он был напуган внезапной <w>вспышкой</w> криков и лязга металла во дворе."
                            }
                        }
                    ],
                    "synonyms": [
                        "tumult",
                        "uproar",
                        "quarrel"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный взрыв шума, беспорядка или громкая ссора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспы́шка",
                                "target_lang_sense_clarification": "внезапный шум или гнев"
                            },
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "беспорядок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "182348de-2245-3612-94c6-6774a5a6835f",
                    "sense_definition": "To add a defect to something or to make it imperfect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist was careful not to <w>flaw</w> the smooth surface of the sculpture with his tools.",
                            "target_lang_translations": {
                                "ru": "Художник старался не <w>испортить</w> гладкую поверхность скульптуры своими инструментами."
                            }
                        },
                        {
                            "text": "One wrong move during the manufacturing process could <w>flaw</w> the entire batch of glass.",
                            "target_lang_translations": {
                                "ru": "Одно неверное движение в процессе производства могло <w>повредить</w> всю партию стекла."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавить дефект чему-либо или сделать это несовершенным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́ртить",
                                "target_lang_sense_clarification": "делать хуже"
                            },
                            {
                                "target_lang_word": "поврежда́ть",
                                "target_lang_sense_clarification": "нарушать целостность"
                            },
                            {
                                "target_lang_word": "испо́ртить",
                                "target_lang_sense_clarification": "нанести изъян"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89d66a50-8725-3c9f-b91e-fec5390904ee",
                    "sense_definition": "To become imperfect, defective, or to develop a crack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone began to <w>flaw</w> after centuries of exposure to the harsh winter weather.",
                            "target_lang_translations": {
                                "ru": "Древний камень начал <w>трескаться</w> после столетий воздействия суровой зимней погоды."
                            }
                        },
                        {
                            "text": "If the cooling process is too fast, the metal might <w>flaw</w> and lose its integrity.",
                            "target_lang_translations": {
                                "ru": "Если процесс охлаждения будет слишком быстрым, металл может <w>деформироваться</w> и потерять свою целостность."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться несовершенным, дефектным или давать трещину."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́ртиться",
                                "target_lang_sense_clarification": "становиться дефектным"
                            },
                            {
                                "target_lang_word": "поврежда́ться",
                                "target_lang_sense_clarification": "получать повреждение"
                            },
                            {
                                "target_lang_word": "тре́скаться",
                                "target_lang_sense_clarification": "давать трещину"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}