                "senses": [
                    {
                        "sense_id": "8fe6ec59-124a-38ce-a385-7ebda1f046c2",
                        "entry_id": "801a74be-4208-3b10-9263-7681b7d68b96",
                        "glosses": [
                            "een onderdeel, een instrument dat wordt toegepast om een informatief signaal af te geven over één of meer technische grootheden (snelheid, temperatuur enz.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253ebcc9-5b67-4752-bcec-d059425331b8",
                                "sense_id": "8fe6ec59-124a-38ce-a385-7ebda1f046c2",
                                "text": "De microprocessor krijgt de informatie uit de signalen die de sensors afgeven."
                            },
                            {
                                "example_id": "16afabad-0731-4bf6-883e-b7e5edc9eca1",
                                "sense_id": "8fe6ec59-124a-38ce-a385-7ebda1f046c2",
                                "text": "De Amerikaanse ruimtevaartorganisatie wilde de raket afgelopen voorjaar voor het eerst lanceren, maar dat wordt nu op zijn vroegst in augustus. Er zijn dan nog geen astronauten aan boord, maar wel drie poppen met sensoren."
                            },
                            {
                                "example_id": "9a5a9e3d-09e3-4c20-a59d-33d78f79a335",
                                "sense_id": "8fe6ec59-124a-38ce-a385-7ebda1f046c2",
                                "text": "Een prothese, waar je ook mee kunt voelen. Dat lijkt misschien onmogelijk, maar Zwitserse en Italiaanse wetenschappers hebben een prothesehand ontwikkeld die door sensoren toch gevoel kan geven. De Deense Dennis mocht hem als eerste testen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0fc0e1a-6ffb-452c-aef4-68e5c719a286",
                        "source_entry_id": "801a74be-4208-3b10-9263-7681b7d68b96",
                        "source_sense_id": "8fe6ec59-124a-38ce-a385-7ebda1f046c2",
                        "target_lang_word": "Sensor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sensor",
