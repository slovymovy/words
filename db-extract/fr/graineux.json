                        "sense_id": "2c90af31-e6be-3614-828c-d1667f12252a",
                        "entry_id": "5a8fbbbc-fce8-30dc-b83f-1dded5081cbd",
                        "glosses": [
                            "Qui a une consistance ou une apparence granuleuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa910a65-9a0f-428f-910c-a9d0de03484a",
                                "sense_id": "2c90af31-e6be-3614-828c-d1667f12252a",
                                "text": "Amatir, en terme d’Orfévre en grosserie, c’est ôter l’éclat & le poliment à certaines parties qui doivent servir comme d’ombre en les rendant graineuses & mattes, pour que celles auxquelles on laisse le poli paroissent avec plus d’éclat lorsque ce sont des reliefs."
                            },
                            {
                                "example_id": "3c400b5a-f710-4166-aacc-d26c80cf1b8b",
                                "sense_id": "2c90af31-e6be-3614-828c-d1667f12252a",
                                "text": "Recouverte d'une texture graineuse et anti-dérapante sur son côté gauche, l’utilisation de la Corsair Harpoon s’apparente à entrer dans une voiture confortable aux garnitures en cuir."
                            }
                        ]
                    },
                    {
                        "sense_id": "de351e91-e98e-38a2-a06e-1b9f28ed1949",
                        "entry_id": "5a8fbbbc-fce8-30dc-b83f-1dded5081cbd",
                        "glosses": [
                            "Qui contient des graines (ou beaucoup de graines)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b594b883-6c6a-4d9c-8584-2d030be14a79",
                                "sense_id": "de351e91-e98e-38a2-a06e-1b9f28ed1949",
                                "text": "Pâques pluvieux, blé graineux."
                            },
                            {
                                "example_id": "9a56bb56-427e-4e58-b12b-663b774a6499",
                                "sense_id": "de351e91-e98e-38a2-a06e-1b9f28ed1949",
                                "text": "Couper les courgettes en quatre dans le sens de la longueur, ceci afin d’enlever la partie graineuse (comme on le fait pour un melon)."
                            }
                        ]
                    }
