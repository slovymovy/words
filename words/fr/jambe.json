                    ]
                },
                {
                    "sense_id": "9b7f108b-637f-3af6-8438-1854f88e16b6",
                    "sense_definition": "Chacune des deux parties d'un pantalon qui recouvrent les membres inférieurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>jambes</w> de ce pantalon sont beaucoup trop longues pour moi."
