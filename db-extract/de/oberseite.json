                ],
                "senses": [
                    {
                        "sense_id": "dccd438d-f186-36b9-a5bd-12294d15bfaa",
                        "entry_id": "42d7b61f-ed89-356f-a31e-122a464877c4",
                        "glosses": [
                            "Teil von etwas, der normalerweise nach oben gerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9565bf6-c814-4062-9b29-05a650a95223",
                                "sense_id": "dccd438d-f186-36b9-a5bd-12294d15bfaa",
                                "text": "„Nun kroch ich auf der Oberseite des Schanzkleids nach achtern, inmitten eines unglaublich schrecklichen und höllischen Getöses aus Donner und Geschrei und grellen Blitzen, während der Wind die ganze Zeit wie ein Tornado blies.“"
                            },
                            {
                                "example_id": "5bd87c80-458a-4e86-a4f0-a1df571ea35e",
                                "sense_id": "dccd438d-f186-36b9-a5bd-12294d15bfaa",
                                "text": "„Ein Vogelflügel ist gewölbt und zwingt allein durch sein Profil die Luft auf seiner Oberseite auf einen längeren Weg, wodurch dort Unterdruck und damit Auftrieb entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
