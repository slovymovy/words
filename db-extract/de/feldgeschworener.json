                        "tags": [],
                        "examples": [
                            {
                                "example_id": "260f23ae-0fa9-44f7-a44b-4827fe365a27",
                                "sense_id": "f9490859-8fa3-34ff-a56e-73faca52fb0a",
                                "text": "„Einmal im Jahr erscheinen auf dem Schulhof der Wombacher Grundschule die Feldgeschworenen.“"
                            },
                            {
                                "example_id": "74640c1e-b33c-49e5-9745-c1c36eb73753",
                                "sense_id": "f9490859-8fa3-34ff-a56e-73faca52fb0a",
                                "text": "„Auf Vorschlag der Gemeinschaft der Feldgeschworenen im Ortsteil Habichsthal beschließt der Gemeinderat, […] zu Feldgeschworenen für den Ortsteil Habichsthal zu bestellen.“"
                            }
                        ],
