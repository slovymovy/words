                ],
                "senses": [
                    {
                        "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                        "entry_id": "101c9988-ce7b-3a1b-8f77-32f21ccbe246",
                        "glosses": [
                            "auf dem Boden verteilte Decke meist aus organischem Material (beispielsweise Stroh, Laub, Rinden‑/Holzhäcksel, Rasenschnitt), die den Boden vor Austrocknung, Erosion und Wuchs von Unkraut schützen soll und nach und nach verrottet"
                        ],
                        "tags": [
                            "Gärtnern"
                        ],
                        "examples": [
                            {
                                "example_id": "13810eec-1d25-4eba-a3f1-84e5a00ba140",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Je nach Pflanzhöhe sollte eine Mulchschicht maximal zehn Zentimeter dick sein.“"
                            },
                            {
                                "example_id": "0c714018-4969-4433-9c42-39443039c7f8",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Um Salate und andere bodennahe Pflanzen herum wird nur eine dünne Mulchschicht verteilt.“"
                            },
                            {
                                "example_id": "e7a378c9-b9f2-4431-a120-c4f125522684",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Eine Mulchschicht aus Rasenschnitt, Hanfstreu oder Laub schützt den Boden gleich mehrfach: Sie verhindert die Verdunstung von Wasser, lässt Regen besser versickern und bewahrt den Boden vor Überhitzung. Gleichzeitig bietet sie Schutz vor Erosion durch Wind und Starkregen.“"
                            },
                            {
                                "example_id": "c114072e-dd57-4ac6-91f2-8473ea2dcf76",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "[…] „Die Mulchschicht schützt im Sommer vor Verdunstung, sodass der Boden weniger austrocknet und man seltener gießen muss.“"
                            },
                            {
                                "example_id": "85757929-f79b-4b08-968c-a32ee92b79b9",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "[Birnbäume:] „Eine Mulchschicht rund um die Pflanze sorgt dafür, dass der Boden nicht so schnell austrocknet.“"
                            },
                            {
                                "example_id": "7e4285b1-7961-4158-a343-bb80dfe0eb8d",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Hitzewellen, austrocknende Bise und starke Regenfälle setzen dem Gartenboden zu – mit einer Mulchschicht wird offener Boden im Gemüse-, Blumen- und Beerengarten vor Verdunstung, Austrocknung und Verschlämmung geschützt.“"
                            },
                            {
                                "example_id": "6e99c8ac-cd6b-45a0-b85f-c02a2935b57e",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Die Mulchschicht blockiert Sonnenlicht und erstickt Unkrautsamen, wodurch ihr Keimen und Wachstum gehemmt wird.“"
                            },
                            {
                                "example_id": "a63d3408-8115-4a04-bd47-0003f66c8f02",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Eine Mulchschicht […] beugt Wildkrautaufwuchs vor.“"
                            },
                            {
                                "example_id": "7801ef3c-1ec0-4d18-bb8a-592282614dd8",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Sobald Gartenpflanzen eine geschlossene Fläche bilden, können sich unerwünschte Arten nur schwer ansiedeln. Bis dahin kann neben dem Jäten auch eine 15 cm starke Mulchschicht helfen, einen unerwünschten Aufwuchs von Wildkräutern zu unterdrücken.“"
                            },
                            {
                                "example_id": "34d3a6a3-2122-4701-b7d7-46799dd22000",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Die Mikroorganismen und Regenwürmer im Boden sind darunter gut geschützt – sie bauen die Mulchschicht ab und lockern den Boden spürbar auf.“"
                            },
                            {
                                "example_id": "8064441b-4e64-4d66-9f83-3c7825dc384f",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Außerdem erwärmt sich unter der Mulchschicht der Boden und speichert die Wärme auch. Viele Gemüsesorten lieben das und wachsen dadurch besser. Verrottet der Mulch, gibt er zusätzlich Nährstoffe an den Boden ab und wirkt wie ein Dünger.“"
                            },
                            {
                                "example_id": "ccb180ff-a862-4f83-ba2b-4f41d63bfe9e",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "„Charakteristisch für das Direktsaatsystem ist die Mulchschicht, die den Boden im günstigsten Fall das ganze Jahr bedeckt.“"
                            },
                            {
                                "example_id": "312ccf5e-9279-4cbd-9bc6-b2541089b418",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "[Man sollte] „Rosenbeete besser nicht mulchen: Krankheitserreger aus Blättern könnten in der Mulchschicht überwintern.“"
                            },
                            {
                                "example_id": "026aba07-bb5e-4728-8359-90d2a8f24e58",
                                "sense_id": "2731b846-1981-3b13-965e-e873bc65c5d8",
                                "text": "[Erdflöhe:] „Die an Kohlgewächsen auftretenden Arten überwintern als Käfer in der Mulchschicht von Hecken und in Stein- oder Holzhaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
