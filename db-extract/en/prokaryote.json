                    }
                ],
                "senses": [
                    {
                        "sense_id": "af057c75-df26-37c9-bba8-95e6d610ff82",
                        "entry_id": "aa49fc6f-b72d-39a4-a638-925aea2d388c",
                        "glosses": [
                            "An organism whose cell (or cells) are characterized by the absence of a nucleus or any other membrane-bound organelles."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bf17e785-24e0-37ef-85b4-24b9f639b9cd",
                        "entry_id": "aa49fc6f-b72d-39a4-a638-925aea2d388c",
                        "glosses": [
                            "In the two-empire system of biological taxonomy, an organism of the kingdom Prokaryotae (now superseded)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fe35a66-1e27-4092-9b66-c0c49e964640",
                        "source_entry_id": "aa49fc6f-b72d-39a4-a638-925aea2d388c",
                        "source_sense_description": "organism characterized by absence of nucleus",
