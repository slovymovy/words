                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f1b0ed-1d18-41e1-9b56-bdc8c9b056ee",
                                "sense_id": "30acceba-af25-3f43-b6b1-521a86165975",
                                "text": "Het cholesterolverlagend effect van Becel pro.activ is bewezen in meer dan 45 onderzoeken en is onomstreden."
                            },
                            {
                                "example_id": "a829e7c9-2c73-4207-9adf-8bb585b86d46",
                                "sense_id": "30acceba-af25-3f43-b6b1-521a86165975",
                                "text": "„Het is puur biologisch, gezond, eiwitrijk, bloeddruk- en cholesterolverlagend en erg lekker. Je hebt met shiitake ook meer ‘bite’ dan bijvoorbeeld met champignons”, aldus Johnni Masselink."
                            },
                            {
                                "example_id": "353f7b23-1bf5-4f26-9797-220c48ed29a1",
                                "sense_id": "30acceba-af25-3f43-b6b1-521a86165975",
                                "text": "Ongezouten noten zitten boordevol onverzadigde vetten die ons beschermen tegen hart- en vaatziekten en cholesterolverlagend zijn."
                            }
                        ]
                    }
