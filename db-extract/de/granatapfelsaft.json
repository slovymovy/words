                "senses": [
                    {
                        "sense_id": "980cd015-6c52-3fdd-8218-35a8d6f49e30",
                        "entry_id": "eca8663c-de97-37d1-9dcd-fabc736199a9",
                        "glosses": [
                            "aus Granatäpfel hergestellter Saft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d34b949-62d7-47cf-a78d-d40ad4a9502d",
                                "sense_id": "980cd015-6c52-3fdd-8218-35a8d6f49e30",
                                "text": "„Er schlug eine Trommel, worauf mir sofort eine Holzschale gebracht wurde, die bis an den Rand mit Granatapfelsaft gefüllt war.“"
                            },
                            {
                                "example_id": "258950e2-c0f9-4b3c-9a19-e22bcc510ad0",
                                "sense_id": "980cd015-6c52-3fdd-8218-35a8d6f49e30",
                                "text": "„Auf wundersame Weise war es ihr gelungen, in der kurzen Zeit zwischen Karims SMS und seiner Ankunft Lammspieße chelo kebab mit einer riesigen Schüssel Reis, ein Brathuhn mit einer fesenjun-Sauce aus Granatapfelsaft, Walnüssen und Kardamom und dolme bademjun zuzubereiten, mit Fleisch und Rosinen gefüllte Auberginen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
