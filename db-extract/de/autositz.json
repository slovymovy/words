                ],
                "senses": [
                    {
                        "sense_id": "ea288cc5-14f7-3367-886b-5eeb472877e0",
                        "entry_id": "8123fbab-7b05-3055-8251-05ba5cb5fbc3",
                        "glosses": [
                            "Sitz, der in einem Automobil eingebaut ist und für die Insassen bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f384a57-31ff-4e91-809e-3fa0f4231c5f",
                                "sense_id": "ea288cc5-14f7-3367-886b-5eeb472877e0",
                                "text": "Die Autositze können mit einem robusten Stoff oder feinem Leder bezogen sein."
                            },
                            {
                                "example_id": "aee257ee-d08e-4b7d-90ba-8ee6a5d5be20",
                                "sense_id": "ea288cc5-14f7-3367-886b-5eeb472877e0",
                                "text": "Bei komfortableren Autositzen gibt es Verstellungen der Höhe, der Lordosenstütze, und der Sitzneigung, Sitzheizung und weitere Komfortfunktionen."
                            },
                            {
                                "example_id": "3e4c28c1-c7b0-4ae6-9864-c7e4b3c95e35",
                                "sense_id": "ea288cc5-14f7-3367-886b-5eeb472877e0",
                                "text": "„Es ist fast Abend, als sich Ali ein paar Tage später auf einen alten Autositz vor der Werkstatt fallen lässt, dunkle Schatten unter seinen Augen.“"
                            },
                            {
                                "example_id": "1d454c41-dc01-4119-8f0d-d4e9bca4ca72",
                                "sense_id": "ea288cc5-14f7-3367-886b-5eeb472877e0",
                                "text": "„Wir saßen auf Autositzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
