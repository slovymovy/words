                },
                {
                    "sense_id": "5f83a06f-314d-364f-9dda-2e9ba87c3b23",
                    "sense_definition": "Люди, объединённые общей целью, работой, интересами или взглядами.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочая <w>группа</w> подготовила новый проект для обсуждения на собрании.",
                            "target_lang_translations": {
