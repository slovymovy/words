                "senses": [
                    {
                        "sense_id": "da654544-7c95-30f7-86e8-4aa0301b2473",
                        "entry_id": "8dd80df6-8da6-316d-900d-7279bd813af2",
                        "glosses": [
                            "clown"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "a65fcd9a-b6c8-49c8-8604-83520b2b8260",
                                "sense_id": "da654544-7c95-30f7-86e8-4aa0301b2473",
                                "text": "Jan Brinkman, als paljas uitgedost met een allergekst besmeerd gezicht en een karpet om het lijf gebonden, gaf Pietje de meegebrachte gereedschappen uit een mandje aan."
                            }
                        ]
                    },
                    {
                        "sense_id": "91dfa0bb-23b4-30bb-8596-4502e73a6cc1",
                        "entry_id": "8dd80df6-8da6-316d-900d-7279bd813af2",
                        "glosses": [
                            "iemand die zich lachwekkend en/of dom/belachelijk gedraagt"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d27ac002-ba69-3fc4-ba8e-85098aebbc0d",
                        "entry_id": "8dd80df6-8da6-316d-900d-7279bd813af2",
                        "glosses": [
                            "strozak, stromatras"
                        ],
                        "tags": [],
