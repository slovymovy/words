                                                "example_id": "a8dc500d-cf44-49f8-8b04-c45eb52d2752",
                                                "sense_id": "4675a00b-5461-39b7-8f9f-df43cf076a37",
                                                "text": "Sup guise? — What's up, guys?"
                                            }
