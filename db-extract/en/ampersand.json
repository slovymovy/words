                        "cross_references": [
                            {
                                "target_word": "амперса́нд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b8fad27f-a406-3821-9de2-1e8571aa415a",
                                        "entry_id": "e9025458-5189-3daa-acef-a4580be3d1f0",
                                        "glosses": [
                                            "типогр. специальный символ (&), обозначающий союз «и»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702549a5-cff0-48f4-8d07-e8c39826f1ab",
                                                "sense_id": "b8fad27f-a406-3821-9de2-1e8571aa415a",
                                                "text": "Попробуйте нарисовать амперсанд (&). Этот знак — самый претенциозный в европейской шрифтовой системе."
                                            },
                                            {
                                                "example_id": "b0d11ead-7a6d-4bdf-80d8-9885aa1ff1e9",
                                                "sense_id": "b8fad27f-a406-3821-9de2-1e8571aa415a",
                                                "text": "Она открывает глаза: в руках у неё бенгальский огонь в форме амперсанда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc01062-e7bf-33cd-88ff-ca71c819caa4",
                                        "entry_id": "e9025458-5189-3daa-acef-a4580be3d1f0",
                                        "glosses": [
                                            "матем. : символ логической операции «и»"
                                        ],
                                        "tags": [
                                            "в математической логике"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29486f2a-e18d-3e99-aa2d-538704b0bb16",
                                        "entry_id": "e9025458-5189-3daa-acef-a4580be3d1f0",
                                        "glosses": [
                                            "прогр. символ, использующийся во многих языках программирования в качестве различных управляющих конструкций (операторов, операций, префиксов и др.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b81cd1a6-c5c0-464a-b988-9fd5870405f0",
                                                "sense_id": "29486f2a-e18d-3e99-aa2d-538704b0bb16",
                                                "text": "При объявлении переменной наличие амперсанда означает, что эта переменная используется в качестве ссылки (дополнительного имени) другой переменной."
                                            },
                                            {
                                                "example_id": "d39067d6-4414-4d56-89b8-58e584e7306f",
                                                "sense_id": "29486f2a-e18d-3e99-aa2d-538704b0bb16",
                                                "text": "Конъюнкция – это ещё одна операция, также называемая «и», и она представлена двумя амперсандами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
