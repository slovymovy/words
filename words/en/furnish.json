{
    "word_family": [
        "furniture",
        "furnishing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54b5699a-d6ef-37e0-9f05-87fb63ab0f47",
                    "sense_definition": "To provide a room or building with furniture and other necessary equipment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>furnish</w> the new apartment with modern pieces.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>меблировать</w> новую квартиру в современном стиле."
                            }
                        },
                        {
                            "text": "It is expensive to <w>furnish</w> a home from scratch.",
                            "target_lang_translations": {
                                "ru": "Дорого <w>обставлять</w> дом с нуля."
                            }
                        }
                    ],
                    "synonyms": [
                        "equip",
                        "fit out"
                    ],
                    "common_phrases": [
                        "furnish a home",
                        "furnish an apartment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать помещение мебелью и другими необходимыми предметами обстановки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меблировать",
                                "target_lang_sense_clarification": "обставлять мебелью какое-либо помещение"
                            },
                            {
                                "target_lang_word": "обставлять",
                                "target_lang_sense_clarification": "размещать мебель в комнате или доме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba886f37-2846-362e-80be-5347f704e415",
                    "sense_definition": "To supply or provide something, such as information or materials.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness could <w>furnish</w> no evidence to support his claims.",
                            "target_lang_translations": {
                                "ru": "Свидетель не смог <w>предоставить</w> никаких доказательств в поддержку своих слов."
                            }
                        },
                        {
                            "text": "The report will <w>furnish</w> the necessary details for the investigation.",
                            "target_lang_translations": {
                                "ru": "Отчет <w>предоставит</w> необходимые детали для расследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "provide",
                        "supply",
                        "yield"
                    ],
                    "common_phrases": [
                        "furnish evidence",
                        "furnish details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять что-либо, например информацию, доказательства или материалы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "давать в распоряжение или пользование"
                            },
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать чем-либо необходимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3296b9e1-8cff-36bd-84e7-42ae853285b4",
                    "sense_definition": "To supply someone with something they need.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company will <w>furnish</w> you with all the tools required for the job.",
                            "target_lang_translations": {
                                "ru": "Компания <w>снабдит</w> вас всеми инструментами, необходимыми для работы."
                            }
                        },
                        {
                            "text": "The library can <w>furnish</w> students with access to rare archives.",
                            "target_lang_translations": {
                                "ru": "Библиотека может <w>предоставить</w> студентам доступ к редким архивам."
                            }
                        }
                    ],
                    "synonyms": [
                        "provide",
                        "supply"
                    ],
                    "common_phrases": [
                        "furnish with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать кого-либо тем, что ему необходимо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжать",
                                "target_lang_sense_clarification": "обеспечивать кого-то нужными ресурсами"
                            },
                            {
                                "target_lang_word": "предоставлять",
                                "target_lang_sense_clarification": "давать возможность пользоваться чем-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a3c6e0c-c6cd-35f4-87c6-561fa01ef358",
                    "sense_definition": "The raw material or mixture used to create an engineered product, especially in paper or composite manufacturing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paper <w>furnish</w> must be carefully balanced to ensure strength.",
                            "target_lang_translations": {
                                "ru": "Бумажная <w>масса</w> должна быть тщательно сбалансирована для обеспечения прочности."
                            }
                        },
                        {
                            "text": "Workers added the chemical additives to the <w>furnish</w> before processing.",
                            "target_lang_translations": {
                                "ru": "Рабочие добавили химические присадки в <w>шихту</w> перед обработкой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сырье или смесь, используемые для создания промышленного продукта, особенно в производстве бумаги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бумажная масса",
                                "target_lang_sense_clarification": "сырьевая смесь для производства бумаги"
                            },
                            {
                                "target_lang_word": "шихта",
                                "target_lang_sense_clarification": "смесь сырьевых материалов в производстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8872d2c4-d275-342d-b278-40b3ca464fbf",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Furnish</w> is the new manager of the local bank.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Ферниш</w> — новый управляющий местного банка."
                            }
                        },
                        {
                            "text": "The research was conducted by a professor named <w>Furnish</w>.",
                            "target_lang_translations": {
                                "ru": "Исследование проводил профессор по фамилии <w>Ферниш</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ферниш",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}