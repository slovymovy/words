        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78a93c95-3e94-37cb-a997-4e118b29251c",
                    "sense_definition": "present participle and gerund of <w>swear</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "swear_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He apologised immediately for <w>swearing</w> in front of the young children.",
                            "target_lang_translations": {
                                "ru": "Он сразу же извинился за то, что <w>сматерился</w> при маленьких детях.",
                                "de": "Er entschuldigte sich sofort dafür, vor den kleinen Kindern <w>geflucht zu haben</w>."
                            }
                        },
                        {
                            "text": "The witness was seen <w>swearing</w> an oath on the Bible before testifying.",
                            "target_lang_translations": {
                                "ru": "Было видно, как свидетель <w>приносил присягу</w> на Библии перед дачей показаний.",
                                "de": "Man sah, wie der Zeuge vor seiner Aussage einen Eid auf die Bibel <w>schwor</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop swearing",
                        "swearing an oath"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола swear (ругаться, клясться).",
                        "de": "Partizip Präsens oder Gerundium des Verbs 'swear' (fluchen, schwören)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ругаясь",
                                "target_lang_sense_clarification": "деепричастие: использование бранных слов"
                            },
                            {
                                "target_lang_word": "клянясь",
                                "target_lang_sense_clarification": "деепричастие: принесение клятвы"
                            },
                            {
                                "target_lang_word": "ругающийся",
                                "target_lang_sense_clarification": "причастие: тот, кто ругается"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fluchend",
                                "target_lang_sense_clarification": "Partizip: Kraftausdrücke benutzend"
                            },
                            {
                                "target_lang_word": "schwörend",
                                "target_lang_sense_clarification": "Partizip: einen Eid ablegend"
                            },
                            {
                                "target_lang_word": "fluchen",
                                "target_lang_sense_clarification": "als Gerundium/Infinitiv: Schimpfwörter gebrauchen"
                            },
                            {
                                "target_lang_word": "schwören",
                                "target_lang_sense_clarification": "als Gerundium/Infinitiv: einen Eid leisten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8955d33c-6516-3794-8ef4-1ec19fc1ebc8",
                    "sense_definition": "The act of using bad, offensive language, or of making a formal oath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "swear_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher told the students that <w>swearing</w> was not allowed in the classroom.",
                            "target_lang_translations": {
                                "ru": "Учитель сказал ученикам, что <w>сквернословие</w> в классе запрещено.",
                                "de": "Die Lehrerin sagte den Schülern, dass <w>Fluchen</w> im Klassenzimmer nicht erlaubt sei."
                            }
                        },
                        {
                            "text": "There was a lot of loud <w>swearing</w> coming from the crowded bar next door.",
                            "target_lang_translations": {
                                "ru": "Из переполненного соседнего бара доносилась громкая <w>ругань</w>.",
                                "de": "Aus der überfüllten Bar nebenan drang laute <w>Schimpferei</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasphemy",
                        "curse",
                        "foul language",
                        "profanity",
                        "vulgarity"
                    ],
                    "common_phrases": [
                        "casual swearing",
                        "constant swearing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование нецензурной лексики, брани или принесение официальной клятвы.",
                        "de": "Der Gebrauch von anstößigen Ausdrücken oder Kraftausdrücken, oder das Ablegen eines formellen Eides."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ругань",
