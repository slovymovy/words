                    {
                        "translation_id": "26e9e013-2da2-434f-b6b4-64ef7b1247c7",
                        "source_entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                        "source_sense_description": "use of power to force a person to act",
                        "target_lang_word": "принужде́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "принужде́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6c7f8ad-06a3-3524-a925-75beaff88b7f",
                                        "entry_id": "0cd03bb2-9fb7-3135-ac4a-574fa57d034c",
                                        "glosses": [
                                            "действие по значению гл. принуждать, принудить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef74f701-61e8-41ea-bdfd-0da881f7af38",
                                                "sense_id": "d6c7f8ad-06a3-3524-a925-75beaff88b7f",
                                                "text": "Множество обид и злобы копилось из поколения в поколение; каждый пришелец был врагом, каждое племя ― добычей, обещавшей скот и рабов, то есть людей, работавших по принуждению, как скот, под кнутом."
                                            },
                                            {
                                                "example_id": "84e62afc-89fa-47d6-8897-34db43944635",
                                                "sense_id": "d6c7f8ad-06a3-3524-a925-75beaff88b7f",
                                                "text": "Устройство было необычайно демократичным, ни о каком принуждении граждан не могло быть и речи (он несколько раз с особым ударением это подчеркнул), все были богаты и свободны от забот, и даже самый последний землепашец имел не менее трёх рабов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
