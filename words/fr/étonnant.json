                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>étonnant</w> ainsi le public, le comédien a réussi à capter toute l'attention de la salle.",
                            "target_lang_translations": {
                                "en": "By <w>astonishing</w> the audience like this, the actor managed to capture the attention of the whole house.",
                                "ru": "<w>Удивляя</w> таким образом публику, актёр сумел привлечь внимание всего зала.",
                                "nl": "Door het publiek zo te <w>verbazen</w>, wist de acteur de aandacht van de hele zaal te trekken.",
                                "de": "Indem er das Publikum so <w>verblüffte</w>, schaffte es der Schauspieler, die Aufmerksamkeit des ganzen Saals auf sich zu ziehen.",
                                "pl": "<w>Zadziwiając</w> w ten sposób publiczność, aktor zdołał przyciągnąć uwagę całej sali.",
                                "it": "<w>Sorprendendo</w> così il pubblico, l'attore è riuscito a catturare l'attenzione di tutta la sala.",
                                "cs": "Tím, že takto <w>udivil</w> publikum, dokázal herec upoutat pozornost celého sálu.",
                                "tr": "İzleyicileri bu şekilde <w>şaşırtarak</w>, aktör salonun tüm dikkatini çekmeyi başardı.",
                                "es": "<w>Sorprendiendo</w> así al público, el actor logró captar la atención de toda la sala.",
                                "zh": "演员这样<w>震惊</w>观众，成功吸引了全场的注意力。"
                            }
                        },
                        {
                            "text": "Il a remporté la compétition en <w>étonnant</w> ses adversaires par sa rapidité exceptionnelle.",
                            "target_lang_translations": {
                                "en": "He won the competition by <w>astonishing</w> his opponents with his exceptional speed.",
                                "ru": "Он выиграл соревнование, <w>поражая</w> соперников своей исключительной быстротой.",
                                "nl": "Hij won de wedstrijd door zijn tegenstanders met zijn uitzonderlijke snelheid te <w>verbluffen</w>.",
                                "de": "Er gewann den Wettkampf, indem er seine Gegner mit seiner außergewöhnlichen Schnelligkeit <w>verblüffte</w>.",
                                "pl": "Wygrał zawody, <w>zaskakując</w> rywali swoją wyjątkową szybkością.",
                                "it": "Ha vinto la gara <w>sbalordendo</w> i suoi avversari con la sua eccezionale velocità.",
                                "cs": "Soutěž vyhrál tím, že své soupeře <w>ohromil</w> výjimečnou rychlostí.",
                                "tr": "Yarışmayı, olağanüstü hızıyla rakiplerini <w>şaşırtarak</w> kazandı.",
                                "es": "Ganó la competición <w>asombrando</w> a sus rivales con su excepcional rapidez.",
                                "zh": "他以出众的速度<w>震惊</w>了对手，赢得了比赛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
