                "senses": [
                    {
                        "sense_id": "6cf97559-7e75-3815-a22e-dea3ea41223d",
                        "entry_id": "aa441bea-29ec-3fb2-8b20-b2300d3e3c4f",
                        "glosses": [
                            "Donner un caractère parthe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1965bf5-1625-4fa8-b8f5-6fb2662b2ddd",
                                "sense_id": "6cf97559-7e75-3815-a22e-dea3ea41223d",
                                "text": "En ce qui concerne Artabaze, son monnayage fortement parthisé trahit une volonté patente de rapprochement avec l’empire parthe qui, elle aussi, s’explique mieux si le roi était le protégé de la cour de Ctésiphon."
                            },
                            {
                                "example_id": "be4c91ca-3566-4c75-b490-d807b068c248",
                                "sense_id": "6cf97559-7e75-3815-a22e-dea3ea41223d",
                                "text": "Mais le plus fou, c'est qu'elle n'est pas sont influences fondamentales, le vieux perse n'a quasi rien à voir avec aujourd'hui, celui d'aujourd'hui est arabisé, parthisé et j'en passe et ça a toujours été comme ça pour toutes les nations."
                            }
                        ]
                    }
