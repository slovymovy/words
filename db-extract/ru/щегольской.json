                        ]
                    },
                    {
                        "translation_id": "a6ea92d8-e11f-499a-9b00-dca356e710e6",
                        "source_entry_id": "0e5ddb67-854b-3287-9920-e45d884c0b43",
                        "source_sense_description": "изысканно нарядный, модный",
                        "target_lang_word": "élégant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élégant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6e36c9-f521-34ca-842b-e84aa3262454",
                                        "entry_id": "550e924f-8079-3705-b8b8-db5e35cf1ea7",
                                        "glosses": [
                                            "Qui a de l’élégance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41159676-d46a-4473-a041-ddcbf5e9e752",
                                                "sense_id": "6a6e36c9-f521-34ca-842b-e84aa3262454",
                                                "text": "La décoration extérieure du Château de Trianon, par exemple, peut être considérée comme une Architecture élégante, quoique l’ordre Ionique seul y préside ; parce que la disposition générale de ses bâtiments, la colonnade qui les unit, la richesse des matieres dont on s'est servi, & la distribution des ornements qu’on y a employés, la caractérisent telle, & qu’il n’y manque peut-être que la substitution de l’ordre Composite, pour en faire un modèle parfait en ce genre"
                                            },
                                            {
                                                "example_id": "8fc3f28a-5cf2-48f3-82c3-90705c5b789a",
                                                "sense_id": "6a6e36c9-f521-34ca-842b-e84aa3262454",
                                                "text": "À cet instant, un élégant cabriolet stoppa derrière la limousine et deux aimables personnes sautèrent sur le pavé."
                                            },
                                            {
                                                "example_id": "b9c1535b-78a6-4af3-81ab-883472457aab",
                                                "sense_id": "6a6e36c9-f521-34ca-842b-e84aa3262454",
                                                "text": "La cure de boisson est la base du traitement à Vals. L'eau y est consommée suivant les prescriptions médicales dans des buvettes élégantes et bien agencées."
                                            },
                                            {
                                                "example_id": "83a59727-b582-4825-9902-04a89d67dd30",
                                                "sense_id": "6a6e36c9-f521-34ca-842b-e84aa3262454",
                                                "text": "Ils manient avec une élégante aisance les mètres latins les plus compliqués et les vocables les plus choisis de la mythologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf24cdf2-c740-319d-a663-d13f2ecbcb09",
                                        "entry_id": "550e924f-8079-3705-b8b8-db5e35cf1ea7",
                                        "glosses": [
                                            "Qualifie une solution simple et satisfaisante."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af91977c-fb7d-4c03-936b-ef45b3f40385",
                                                "sense_id": "bf24cdf2-c740-319d-a663-d13f2ecbcb09",
                                                "text": "Victor Horta trouve dans le hall octogonal de l'hôtel Tassel une solution élégante au problème posé par l’encombrement des radiateurs."
                                            },
                                            {
                                                "example_id": "92be373e-1dee-40b4-a569-082448c7ffef",
                                                "sense_id": "bf24cdf2-c740-319d-a663-d13f2ecbcb09",
                                                "text": "Je commence à leur montrer que ça vaut n(n-1)/2, avec une méthode simple – un grand classique. Je n'irai pas jusqu'à dire que c'est une démonstration élégante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "élégant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96f510ee-44fb-36c1-9fcc-b5e3fdd24411",
                                        "entry_id": "01702c5f-d146-3e4b-9e42-e91384018418",
                                        "glosses": [
                                            "Celui qui affecte l’élégance dans sa toilette et dans ses manières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c5bfc7-9ccc-4de4-92c6-e7b6b2ff253b",
                                                "sense_id": "96f510ee-44fb-36c1-9fcc-b5e3fdd24411",
                                                "text": "À cette époque, le Jardin Turc fut le rendez-vous des élégants et élégantes du Marais, du faubourg Saint-Antoine et lieux circonvoisins."
                                            },
                                            {
                                                "example_id": "f99392ef-0b39-41dc-bedf-77c6f0f8df51",
                                                "sense_id": "96f510ee-44fb-36c1-9fcc-b5e3fdd24411",
                                                "text": "Aux pieds l’élégant aura des derbys ou des richelieux, bouts fleuris ou non."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca09db50-8f36-402f-be2f-67619cac6ad8",
                        "source_entry_id": "0e5ddb67-854b-3287-9920-e45d884c0b43",
                        "source_sense_description": "изысканно нарядный, модный",
                        "target_lang_word": "chic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba28377-c826-3ab9-ac49-577ec8d5b4fb",
                                        "entry_id": "460bc152-b7af-3542-95ae-eb906d3f8531",
                                        "glosses": [
                                            "Élégant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a337b7ea-115d-4fe5-8843-d0a2a365c4b7",
                                                "sense_id": "8ba28377-c826-3ab9-ac49-577ec8d5b4fb",
                                                "text": "Une à une les succursales des magasins de luxe parisiens, londoniens ou berlinois fermaient, devant rouvrir, l’été, dans les stations chic : Chamonix, Royat, ou Aix-les-Bains."
                                            },
                                            {
                                                "example_id": "73c78dfc-46fa-41b0-af2e-a6b3ee560723",
                                                "sense_id": "8ba28377-c826-3ab9-ac49-577ec8d5b4fb",
                                                "text": "D’ailleurs il a pas mal lu, Nastase ; autrefois, avec Totome, ils passaient des soirées et des veillées à chercher des mots chics dans le petit Larousse ."
                                            },
                                            {
                                                "example_id": "2af04822-972d-40e5-8110-57eeed810171",
                                                "sense_id": "8ba28377-c826-3ab9-ac49-577ec8d5b4fb",
                                                "text": "Nous étions en pleine déclaration d’amour quand un maître d’hôtel, ou quelque chose du genre, habillé en pingouin cravaté, est sorti du restaurant chic en face de nous."
                                            },
                                            {
                                                "example_id": "cb0cddc8-de7b-49dd-8289-4fc35b0f3a55",
                                                "sense_id": "8ba28377-c826-3ab9-ac49-577ec8d5b4fb",
                                                "text": "Cette robe fait fureur également dans les boutiques chics de la zone sud de Rio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                        "entry_id": "460bc152-b7af-3542-95ae-eb906d3f8531",
                                        "glosses": [
                                            "Digne de sympathie par son caractère, sa manière d’agir. (Dans ce sens moral, l’épithète précède le nom.)"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a228f475-809d-4f90-983f-99b431e283f5",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "Oh ! elles m’ont aussi promis, ces premières fois, d’être avec moi d’une gentillesse débordante, de me faire des tas de choses : « Tu verras, va, si je suis une chic femme ! » etc."
                                            },
                                            {
                                                "example_id": "6282607d-5614-4b34-a8f0-6a6eec1d1434",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "Il était, dans son métier, un dispensateur de bienfaits, une conscience scrupuleuse, « quelqu’un de chic », comme on dit en salle de garde."
                                            },
                                            {
                                                "example_id": "8205fce9-1a49-4bdf-8545-f9f8fcb18389",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "— Alexandre, dit Maillat, tu es un chic type. Alexandre releva la tête, et le dévisagea d’un air choqué.\n— Un chic type ? gronda-t-il, qu’est-ce qui te prend ? Tu deviens fou, non ? Un chic type ? Un chic type ? Je t’en foutrai du chic type, moi !"
                                            },
                                            {
                                                "example_id": "76891ae7-f06e-40cd-8125-ad77035e64ae",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "- Je m’en vais, je lui dis, mais avant de partir, je veux vous dire la chose suivante : je trouve que vous êtes une chic môme."
                                            },
                                            {
                                                "example_id": "f1ce36e5-8518-4737-8f86-7b555289882f",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "Va donc faire des gnards avec une chic fille. Tu promets de m'en faire un en plus, rien que pour moi qui peux plus en avoir ?"
                                            },
                                            {
                                                "example_id": "fae53392-f282-4c32-a7d8-1035792ea257",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "En fait, je vais vous dire, c’est une très chic fille… Qui a un peu disjoncté au printemps dernier…"
                                            },
                                            {
                                                "example_id": "253bad76-59d0-44ed-8164-fcc3f5570d25",
                                                "sense_id": "c16f8c9e-834f-3928-9eaf-c417376d94d2",
                                                "text": "Personne ne vous engage pour être votre ami. Les gens vous engagent pour concevoir des solutions à des problèmes. Mais s'ils peuvent obtenir la même solution auprès d'un chic type et d'un personnage imbuvable, ils choisiront le premier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2e2d4fb-6da2-3ed6-b6b8-567ce9237fe0",
                                        "entry_id": "460bc152-b7af-3542-95ae-eb906d3f8531",
                                        "glosses": [
                                            "Chouette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbe2732-0541-46dc-aaa6-8d1b0b23451d",
                                                "sense_id": "b2e2d4fb-6da2-3ed6-b6b8-567ce9237fe0",
                                                "text": "— Vous avez lu ? « Caractère fier et indépendant… »\n— C’est chic, ça, fit Pierre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2e8f9db-ad69-349c-952b-d41f21291e81",
                                        "entry_id": "86e433b2-e02e-3630-9fb4-9a6b0883bb8d",
                                        "glosses": [
                                            "Élégance extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c0439f-9e72-421b-a09a-cbcd34c9438e",
                                                "sense_id": "b2e8f9db-ad69-349c-952b-d41f21291e81",
                                                "text": "Mais enfin elle était de race, son sang était noble ; et puis ses équipages étaient les plus corrects de Bordeaux, elle se mettait bien, et sa maison avait vraiment du chic."
                                            },
                                            {
                                                "example_id": "a34d6767-cdc0-4c29-a88d-7788ce2f8c0c",
                                                "sense_id": "b2e8f9db-ad69-349c-952b-d41f21291e81",
                                                "text": "Ce fut un événement parisien du plus haut chic. Les gazettes vantèrent, sur le mode pindarique, la richesse de la mariée, l’élégance entraînante du marié, l’extraordinaire probité, l’inépuisable bienfaisance et les goûts artistiques d’Alexandre de Gavinard."
                                            },
                                            {
                                                "example_id": "2a71cba4-2da8-403f-8fa5-a0959f7ea341",
                                                "sense_id": "b2e8f9db-ad69-349c-952b-d41f21291e81",
                                                "text": "[…] Mmes Daudoird et Clara Lemonnier, dont la première portait l’habit noir avec un chic et une aisance qui auraient damé le pion au clubman le plus élégant."
                                            },
                                            {
                                                "example_id": "bcd7efc5-df0c-4f83-be45-61ee11ab4d2b",
                                                "sense_id": "b2e8f9db-ad69-349c-952b-d41f21291e81",
                                                "text": "Elle avait soif de chic, mais ne s’en faisait pas la même idée que les gens du monde. Pour eux, le chic est une émanation de quelques personnes peu nombreuses qui le projettent jusqu’à un degré assez éloigné — et plus ou moins affaibli dans la mesure où l’on est distant du centre de leur intimité — dans le cercle de leurs amis ou des amis de leurs amis dont les noms forment une sorte de répertoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "400746e3-af10-3c30-afbd-3590835d5dd1",
                                        "entry_id": "86e433b2-e02e-3630-9fb4-9a6b0883bb8d",
                                        "glosses": [
                                            "Grande habileté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab196f5b-a8ad-4683-b577-1ef6b62f47fe",
                                                "sense_id": "400746e3-af10-3c30-afbd-3590835d5dd1",
                                                "text": "Ils avaient un chic spécial et une habileté extraordinaire pour s’excuser auprès des Rouges d’avoir été vus à l’offerte le dimanche, et auprès des Blancs pour s’être laissé entraîner à fêter le 14 juillet parmi les drapeaux, les lampions, les litres et les Marseillaises."
                                            },
                                            {
                                                "example_id": "a1502dba-c20d-4cf7-bb79-15ba0ca31175",
                                                "sense_id": "400746e3-af10-3c30-afbd-3590835d5dd1",
                                                "text": "Henry Kistemaeckers avait le chic pour se mettre à dos les autorités de Belgique, de France et, pour peu qu'il y traînât ses guêtres, du reste de la planète."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49ea78aa-0e78-3d3d-8f12-e2417b41990a",
                                        "entry_id": "433c1c65-09ca-396f-97cc-f534d14a5ad5",
                                        "glosses": [
                                            "Bruant."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380ca12b-4bfe-4d60-872a-bc2d9e12e2fd",
                                                "sense_id": "49ea78aa-0e78-3d3d-8f12-e2417b41990a",
                                                "text": "Suivant Crespon, la plupart des Bruants sont désignés aux environs de Nîmes par le mot Chic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b841592e-2133-4909-a641-3ce87554176e",
                        "source_entry_id": "0e5ddb67-854b-3287-9920-e45d884c0b43",
                        "source_sense_description": "изысканно нарядный, модный",
                        "target_lang_word": "raffiné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raffiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "699448fe-0b5f-3300-b473-71e0231423c5",
                                        "entry_id": "9aa5d9be-6d11-377b-bd2b-e6a42a36eaba",
                                        "glosses": [
                                            "Qui montre du raffinement, en parlant de personnes ou de choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8dc64d1-48c6-4d1b-a829-987b144f2d3d",
                                                "sense_id": "699448fe-0b5f-3300-b473-71e0231423c5",
                                                "text": "J'étais alors d'une candeur stupéfiante et d'une délicatesse de sentiment si raffinée que, pour recevoir galamment une « femme mariée » qui me venait voir, j'avais allumé toutes les bougies de mes deux candélabres."
                                            },
                                            {
                                                "example_id": "08168587-cae5-4047-8fd8-777e10988463",
                                                "sense_id": "699448fe-0b5f-3300-b473-71e0231423c5",
                                                "text": "À la recherche de saveurs japonaises raffinées dans un environnement moderne ultra-séduisant?"
                                            },
                                            {
                                                "example_id": "0e65f57c-a1e6-44be-afe5-86791118c5a2",
                                                "sense_id": "699448fe-0b5f-3300-b473-71e0231423c5",
                                                "text": "Il parle un beau français raffiné qui va bien avec sa personnalité. Tout en finesse et en subtilité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raffiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5e849b-1223-3951-afea-d3749294ac35",
