                ],
                "senses": [
                    {
                        "sense_id": "6fa39ca6-c0a4-3088-a589-d284a0836f78",
                        "entry_id": "9eebc7bd-4842-35f2-88ca-db36cad52ae3",
                        "glosses": [
                            "der senkrechte Schacht oder Hohlraum, in dem sich die Zisterne befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc8dffb-31c7-4c3f-8336-4a1e4f967963",
                                "sense_id": "6fa39ca6-c0a4-3088-a589-d284a0836f78",
                                "text": "„Am Dienstag ist in Dorfweil, einem Ortsteil von Schmitten, ein 68-jähriger Mann bei einem Sturz in einen 2,50 Meter tiefen Zisternenschacht ums Leben gekommen.“"
                            },
                            {
                                "example_id": "39138027-a80c-4e87-ab97-f92ce1c0b0d9",
                                "sense_id": "6fa39ca6-c0a4-3088-a589-d284a0836f78",
                                "text": "„Der Mann war aus zunächst ungeklärter Ursache am Dienstagnachmittag auf seinem Grundstück in den teilweise mit Wasser gefüllten Zisternenschacht gestürzt.“"
                            },
                            {
                                "example_id": "45958ebe-e798-468b-82c0-a70d7f660cb1",
                                "sense_id": "6fa39ca6-c0a4-3088-a589-d284a0836f78",
                                "text": "„Im Bemühen um die Erhaltung des historischen Zisternenschachts auf dem alten Rellinger Markt haben der Heimatverein und die Gemeinde einen gemeinsamen Nenner gefunden.“"
                            },
                            {
                                "example_id": "d4b06055-ce14-4d68-a633-e788c1ee9692",
                                "sense_id": "6fa39ca6-c0a4-3088-a589-d284a0836f78",
                                "text": "„Bei den Ausgrabungen kam im Bereich des ersten Halsgrabens vor der Kirche ein runder Zisternenschacht aus Backsteinen zum Vorschein, dessen Boden mit Teilen mehrerer Mahlsteine ausgelegt war.“"
                            },
                            {
                                "example_id": "97173da9-291b-4384-bbf8-d2238b499d87",
                                "sense_id": "6fa39ca6-c0a4-3088-a589-d284a0836f78",
                                "text": "„Eine Besonderheit stellt ein tiefer Zisternenschacht mit fünf Meter Durchmesser dar, der im südlichen, tiefer gelegenen Teil aus dem Felsen geschlagen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
