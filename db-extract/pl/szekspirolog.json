                        "glosses": [
                            "badacz zajmujący się twórczością i życiem Szekspira"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7617861-e76e-4954-bd3f-9e9959959e07",
                                "sense_id": "b36190d5-5bb1-3582-9b57-db6310b42116",
                                "text": "Wilhelm poznał znanego szekspirologa w Londynie."
                            }
