                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ec5ef05-36ca-4b97-9adc-c6c34936a7cd",
                        "source_entry_id": "34035da9-7a44-306d-a4e4-6fbdabd1a920",
                        "source_sense_description": "тот, кто карает, наказывает кого-либо",
                        "target_lang_word": "chastiser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chastiser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4eea759c-bd14-3892-a6c7-0b733b7e253e",
                                        "entry_id": "71774aa1-7672-3881-bbbd-e801ace3f8fd",
                                        "glosses": [
                                            "Someone who chastises"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630abcf2-5421-4a7a-8b9e-15e10d24d430",
                                                "sense_id": "4eea759c-bd14-3892-a6c7-0b733b7e253e",
                                                "text": "1779 Samuel Johnson (ed) - The Works of the English Poets\nThat kind chastiser of thy soul in joy!"
                                            },
                                            {
                                                "example_id": "23f83271-abb3-4c6c-8162-e1ad238856cc",
                                                "sense_id": "4eea759c-bd14-3892-a6c7-0b733b7e253e",
                                                "text": "Having spoken thus, Arjuna, chastiser of enemies, told Krsna, \"Govinda, I shall not fight,\" and fell silent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5efdb93-dfee-42df-a78d-be7aa7e1a16f",
                        "source_entry_id": "34035da9-7a44-306d-a4e4-6fbdabd1a920",
                        "source_sense_description": "тот, кто карает, наказывает кого-либо",
                        "target_lang_word": "punisher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "punisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5efc4b03-7279-38c5-802b-f87bc9b96698",
                                        "entry_id": "134ff9b3-5d57-34f9-9219-4f708e8d8af9",
                                        "glosses": [
                                            "One who punishes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6498659b-f79a-4ed9-9fd4-ccc0a97c3c1c",
                                                "sense_id": "5efc4b03-7279-38c5-802b-f87bc9b96698",
                                                "text": "He grimaced after another lash across his back and settled deeper into the post. The punisher stood nearly ten feet away, dragged the end of his whip through the dirt back toward him."
                                            }
                                        ]
                                    }
                                ]
                            }
