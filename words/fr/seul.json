                        "seule solution"
                    ]
                },
                {
                    "sense_id": "1d7f3ea1-113a-31b7-8ac5-a292e78a974a",
                    "sense_definition": "Qui souffre de solitude, qui éprouve un sentiment d'isolement affectif.",
