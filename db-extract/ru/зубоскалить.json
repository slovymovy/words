                                            {
                                                "example_id": "180768eb-a138-4f77-8055-cdec1ad347fa",
                                                "sense_id": "d588a75a-57d6-3834-a421-3851712e55a7",
                                                "text": "Der Besoffene grinst den Polizisten in Verkennung der wahren Lage an."
