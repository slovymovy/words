                "senses": [
                    {
                        "sense_id": "94950083-4af0-379c-861c-78d7d902f309",
                        "entry_id": "4bd90c7b-000e-3708-905f-7b95259c19db",
                        "glosses": [
                            "Flügel einer Tür, der sich schließen und öffnen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9298be1-52e6-4181-8381-02c0398cc615",
                                "sense_id": "94950083-4af0-379c-861c-78d7d902f309",
                                "text": "„Hainstock stand hinter seinem Tisch, diesem alten Türblatt auf Tischlerböcken, und klopfte seine Pfeife aus.“"
                            },
                            {
                                "example_id": "902c4cf0-5a8f-42f8-be51-8fb1c519c1d3",
                                "sense_id": "94950083-4af0-379c-861c-78d7d902f309",
                                "text": "„Erst jetzt sah er, dass im unteren Bereich der Tür zwischen Türblatt und Zarge ein etwa ein Zentimeter breiter Spalt klaffte, der nach oben hin schmaler wurde und aus dem das Wasser schoss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
