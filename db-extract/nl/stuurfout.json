                        "glosses": [
                            "fout die men maakt bij het besturen van een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8461577-4205-4779-a343-91bce30ee93c",
                                "sense_id": "09425a15-d9f7-33c0-98b8-7eaccfaac623",
                                "text": "Loch leidde riant na drie runs, maar maakte in de beslissende run op de lastige baan in bocht 9 een enorme stuurfout. Weg snelheid, weg gouden medaille. Plek vijf, daar moest hij het mee doen."
                            },
                            {
                                "example_id": "8354688b-223e-438c-b614-d30e548461dc",
                                "sense_id": "09425a15-d9f7-33c0-98b8-7eaccfaac623",
                                "text": "Vrouw (88) hangt met auto boven water na stuurfout"
                            },
                            {
                                "example_id": "f131c620-67ee-4e69-b5f1-3ba0dd8673fe",
                                "sense_id": "09425a15-d9f7-33c0-98b8-7eaccfaac623",
                                "text": "Ook Cant kon een paar kaar afstand nemen, maar pas in de laatste ronde sloeg ze een kloof, na een stuurfout van Kaptheijns in het zand. Cant won dit jaar ook al de wereldbeker en de DVV-trofee. De Belgische kampioene greep daarna ook goud op de EK."
                            }
                        ]
                    }
