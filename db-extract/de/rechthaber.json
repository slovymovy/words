                        "glosses": [
                            "Person, die - oft fälschlicherweise - glaubt, im Recht zu sein und versucht, sich durchzusetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2cd68c8-dc35-4898-8472-cd7783c34714",
                                "sense_id": "df59aba8-1aab-3bf9-85c7-96db51a29e40",
                                "text": "„Auch in Meister Pfriem setzten die Brüder Grimm einem Nörgler, Besserwisser und Rechthaber par exellence ein unvergessliches Denkmal…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
