                "senses": [
                    {
                        "sense_id": "ac73a38e-1d09-36be-ba71-12b5b472a040",
                        "entry_id": "c31bfcdd-f288-3b2c-adcb-11e3552187e1",
                        "glosses": [
                            "die fachsprachliche Beschreibung eines Wappens"
                        ],
                        "tags": [
                            "Heraldik"
                        ],
                        "examples": [
                            {
                                "example_id": "9c912c35-60aa-4b55-8658-dfba798d78c3",
                                "sense_id": "ac73a38e-1d09-36be-ba71-12b5b472a040",
                                "text": "Die Blasonierung des Wappens des Landkreises Harburg ist: Gold, bestreut mit roten Herzen, ein blauer, rotbewehrter Löwe, einen silbernen Schlüssel haltend."
                            },
                            {
                                "example_id": "e031f3d6-e19a-4206-9f32-6a3b991f18e9",
                                "sense_id": "ac73a38e-1d09-36be-ba71-12b5b472a040",
                                "text": "Im allgemeinen ist der Karakter der lateinischen Blasonierungen der einer Uebersetzung aus der Sprache derjenigen Nation, welcher der Blasonist des Wappens angehörte."
                            },
                            {
                                "example_id": "9175b316-b53c-4b8a-9505-591fc3b313f2",
                                "sense_id": "ac73a38e-1d09-36be-ba71-12b5b472a040",
                                "text": "Blasonierung verwendet eine verständliche und moderne Sprache."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b4340df-78ef-4fc7-ade1-00eb434703db",
                        "source_entry_id": "c31bfcdd-f288-3b2c-adcb-11e3552187e1",
                        "source_sense_id": "ac73a38e-1d09-36be-ba71-12b5b472a040",
                        "source_sense_description": "Heraldik: die fachsprachliche Beschreibung eines Wappens",
                        "target_lang_word": "blazon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blazon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4b9d67-a98e-31df-b35e-e5dd91a7ae74",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "A verbal or written description of a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928247cc-b53e-4f32-8ea2-c44c049a8370",
                                                "sense_id": "cb4b9d67-a98e-31df-b35e-e5dd91a7ae74",
                                                "text": "...it should never be forgotten that the best blazon is that which is the most perspicuous"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c503158-432c-337e-aad8-15840d3b093b",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "A formalized language for describing a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6ed31bb-031a-47fc-a442-b92db3802832",
                                                "sense_id": "7c503158-432c-337e-aad8-15840d3b093b",
                                                "text": "The official blazon of the arms of Perth is \"Gules, a Holy Lambe passant regardant staff and cross argent, with the banner of St. Andrew proper, all within a double tressure counter-flowered of the second\": […]."
                                            },
                                            {
                                                "example_id": "3e2e60a1-f026-4429-95cc-d8f4574fb5fa",
                                                "sense_id": "7c503158-432c-337e-aad8-15840d3b093b",
                                                "text": "We must banish, therefore, the persistent but wholly erroneous notion that the heralds invented many of the terms used in blazon and borrowed the rest from the everyday lexicon of terms..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97537731-770b-30d6-b8f8-a86ba8ac6af3",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "A coat of arms or a banner depicting a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ac712f-7aaf-410d-b185-4a4d6b26864e",
                                                "sense_id": "97537731-770b-30d6-b8f8-a86ba8ac6af3",
                                                "text": "He wears their motto on his blade, / Their blazon o'er his towers displayed; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416d526e-ec20-30ad-aa18-7cdd98f47d40",
                                        "entry_id": "943b7ceb-7d92-33d0-b4cb-485200f8f209",
                                        "glosses": [
                                            "Ostentatious display, verbal or otherwise; publication; description; record."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df025a10-94f6-4f8f-bb55-3eccdc391862",
                                                "sense_id": "416d526e-ec20-30ad-aa18-7cdd98f47d40",
                                                "text": "Obtrude the blazon of their exploits upon the company."
                                            },
                                            {
                                                "example_id": "7dbb8b26-1ba6-452d-9b08-9963af2f7206",
                                                "sense_id": "416d526e-ec20-30ad-aa18-7cdd98f47d40",
                                                "text": "Thy tongue, thy face, thy limbs, actions, and spirit, / Do give thee five-fold blazon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blazon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ecb7c38-ecd4-3f86-bd6f-cbd6af575a41",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To describe a coat of arms."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75682ed-3156-4660-9e0e-f3c2839887f2",
                                                "sense_id": "7ecb7c38-ecd4-3f86-bd6f-cbd6af575a41",
                                                "text": "the following coat of arms, which I will send you in the original language, not being herald enough to blazon it in English"
                                            },
                                            {
                                                "example_id": "a299559e-c6f9-4608-9307-7adc0d088dbe",
                                                "sense_id": "7ecb7c38-ecd4-3f86-bd6f-cbd6af575a41",
                                                "text": "After Blazoning the Shield, you proceed to the exterior ornaments viz.: The Helmet, Lambrequin, Crest, Supporters, Badge, and Motto"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To make widely or generally known, to proclaim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84934c22-bc08-40e5-a502-a8d4869c4912",
                                                "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                                "text": "O thou goddess/ thou divine Nature, how thyself thou blazon'st/ in these two princely boys."
                                            },
                                            {
                                                "example_id": "f29a62b9-566b-4311-9b64-b28f8512f329",
                                                "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                                "text": "There pride sits blazoned on th' unmeaning brow."
                                            },
                                            {
                                                "example_id": "77fda2cd-d173-49b9-98ef-cd7a76ad68ee",
                                                "sense_id": "5aee8013-5265-3720-8f2b-20746eed07b7",
                                                "text": "18th century, William Cowper, Retirement\nIn drawing pictures of forbidden joys,\nRetires to blazon his own worthless name"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d19fb7e3-ad45-3773-a020-1c416d15aeaa",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To display conspicuously or publicly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de902f22-83cd-37f2-8c7c-ce8f9f0a3a2b",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To shine; to be conspicuous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0ee6800-90bf-3b63-9888-81c5dae5140f",
                                        "entry_id": "40050e66-66c0-3edb-aac8-d95fb6464676",
                                        "glosses": [
                                            "To deck; to embellish; to adorn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b61397-b62a-4d9e-a02b-eb71c1df5752",
                                                "sense_id": "d0ee6800-90bf-3b63-9888-81c5dae5140f",
                                                "text": "She blazons in dread smiles her hideous form."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9610b1f-4755-4056-9e5b-4ff46e81ff77",
                        "source_entry_id": "c31bfcdd-f288-3b2c-adcb-11e3552187e1",
                        "source_sense_id": "ac73a38e-1d09-36be-ba71-12b5b472a040",
                        "source_sense_description": "Heraldik: die fachsprachliche Beschreibung eines Wappens",
                        "target_lang_word": "blason",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blason",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04161efc-2440-3ef0-b0e9-da30bc8d5544",
                                        "entry_id": "c6d6b083-2e8d-3f52-9440-1f521f118ccc",
                                        "glosses": [
                                            "Héraldique."
                                        ],
                                        "tags": [],
                                        "note": "Il s’agit de l’ensemble des règles qui permettent l’élaboration et le blasonnement des armoiries. Souvent confondu à tort avec les armoiries qui sont un cas particulier appliquant les règles du blason mais aucunement le blason lui-même. C’est pourquoi on parle des règles du blason. Il existe plusieurs blasons suivant les régions linguistiques (blason français, allemand, anglais, italien, espagnol…",
                                        "examples": [
                                            {
                                                "example_id": "01ba2591-bdff-4313-b7dd-52a8a700c30b",
                                                "sense_id": "04161efc-2440-3ef0-b0e9-da30bc8d5544",
                                                "text": "Entendre le blason."
                                            },
                                            {
                                                "example_id": "252b86ef-89c8-48b1-a5cd-0a8ffc9c13a5",
                                                "sense_id": "04161efc-2440-3ef0-b0e9-da30bc8d5544",
                                                "text": "Savoir le blason."
                                            },
                                            {
                                                "example_id": "f6102f10-1017-43b5-adfc-11db10c52af6",
                                                "sense_id": "04161efc-2440-3ef0-b0e9-da30bc8d5544",
                                                "text": "Enseigner le blason."
                                            },
                                            {
                                                "example_id": "7adcca99-3530-447c-9d1e-c6ea4d2808a1",
                                                "sense_id": "04161efc-2440-3ef0-b0e9-da30bc8d5544",
                                                "text": "Pour qui sait le déchiffrer, le blason est une algèbre, le blason est une langue."
                                            },
                                            {
                                                "example_id": "6a6112b9-1827-4e08-8195-a34e58a04f76",
                                                "sense_id": "04161efc-2440-3ef0-b0e9-da30bc8d5544",
                                                "text": "Les règles du blason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fafd808-6caa-3b5a-b1cc-90273e2206cc",
                                        "entry_id": "c6d6b083-2e8d-3f52-9440-1f521f118ccc",
                                        "glosses": [
                                            "Armoiries."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db968590-e70d-4503-aadb-f70e65f1fc39",
                                                "sense_id": "8fafd808-6caa-3b5a-b1cc-90273e2206cc",
                                                "text": "Elle ne signait pas en vain Nieuport-la-Noble ; elle ne portait pas pour rien sur son blason un lion lampassé issant d'une nef et brandissant une hallebarde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "217d75ee-8aad-3421-97aa-ea70ac6fc8af",
                                        "entry_id": "c6d6b083-2e8d-3f52-9440-1f521f118ccc",
                                        "glosses": [
                                            "Genre de poème à la mode au XVIe siècle, généralement versifié et à rimes plates, ayant généralement pour objet le corps féminin, ou une partie de celui-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fd7d3ba-89e6-4e90-9d74-a59782c74157",
                                                "sense_id": "217d75ee-8aad-3421-97aa-ea70ac6fc8af",
                                                "text": "Ayant avec lui toujours fait bon ménage\nJ’eusse aimé célébrer sans être inconvenant,\nTendre corps féminin, ton plus bel apanage,\nQue tous ceux qui l’ont vu disent hallucinant."
                                            }
                                        ]
                                    }
                                ]
                            }
