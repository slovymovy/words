                "senses": [
                    {
                        "sense_id": "f1904bfc-b007-3104-aadd-ce90d06cd4cd",
                        "entry_id": "a03553d9-c777-34a8-856d-d23db7f4f1bb",
                        "glosses": [
                            "Enterrer des glands dans une fosse avec de l’eau salée pour les faire germer et en prolonger la conservation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95686fc5-3bd3-4ed7-b095-93fbbd7b98ab",
                                "sense_id": "f1904bfc-b007-3104-aadd-ce90d06cd4cd",
                                "text": "Si l’on veut employer spécialement les glands, il faut les faire drécher (germer), en les entassant dans une fosse et en les arrosant d’eau salée, puis en les recouvrant de terre."
                            },
                            {
                                "example_id": "3cf7ebf8-2a9f-4806-8015-3251405a56f8",
                                "sense_id": "f1904bfc-b007-3104-aadd-ce90d06cd4cd",
                                "text": "Enfin des auteurs, au nombre desquels il faut citer Viborg, conseillent de drécher le gland, c’est-à-dire de le stratifier dans la terre, de l’arroser, de le faire germer, puis quand la germination est accomplie, de le faire sécher et de le concasser."
                            }
                        ]
                    }
                ],
