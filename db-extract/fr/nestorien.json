        "fr-extract.jsonl": [
            {
                "entry_id": "7c47e9e8-0fe1-37b5-94d2-7e77a9a249a3",
                "word": "nestorien",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0b9b9b33-e9f9-4529-93c5-90256e0ffdd8",
                        "entry_id": "7c47e9e8-0fe1-37b5-94d2-7e77a9a249a3",
