                "senses": [
                    {
                        "sense_id": "b76ffc37-6b44-3f1e-9614-1a8bddffd74c",
                        "entry_id": "954ce6bb-65d3-394e-a492-03c1279ba08f",
                        "glosses": [
                            "in Größe oder Aussehen einem Zyklopen ähnelnd, an einen Zyklopen erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bb909a0-fc40-4a6e-854b-7e50ba7e7b34",
                                "sense_id": "b76ffc37-6b44-3f1e-9614-1a8bddffd74c",
                                "text": "„Schrilles Gelächter ertönte in dem schwarzen Wald auf den vertikalen Hängen, die uns beengten, und wir sahen schreckliche, zyklopenartige Silhouetten, weder Menschen noch Tiere, sondern eine diabolische Mischung aus beidem - Wesen mit riesigen, abstehenden Ohren und langen, zuckenden Rüsseln, die in der schwarzen Nacht schnupperten und heulten - um die lodernden Feuer auf den Berggipfeln tanzten.“"
                            }
                        ],
