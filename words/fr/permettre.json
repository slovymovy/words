{
    "word_family": [
        "permission",
        "permissif",
        "permissivement",
        "permissivité",
        "permissible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "220f7379-80fc-3821-9f6b-65a442c8641a",
                    "sense_definition": "Donner l'autorisation ou le droit de faire ou de dire quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "autorisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le règlement de l'école ne <w>permet</w> pas l'utilisation des téléphones en classe."
                        },
                        {
                            "text": "Mes parents me <w>permettent</w> de sortir avec mes amis ce week-end."
                        }
                    ],
                    "synonyms": [
                        "autoriser",
                        "laisser"
                    ],
                    "antonyms": [
                        "interdire",
                        "défendre"
                    ],
                    "common_phrases": [
                        "permettre l'accès",
                        "permettre de sortir"
                    ]
                },
                {
                    "sense_id": "18e735f0-a194-33d4-a519-e94893b7439a",
                    "sense_definition": "Rendre possible, procurer le moyen ou l'occasion d'accomplir une action.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle application <w>permet</w> de réserver des billets en quelques secondes."
                        },
                        {
                            "text": "Le beau temps nous a <w>permis</w> de faire une longue promenade en forêt."
                        }
                    ],
                    "synonyms": [
                        "laisser"
                    ],
                    "antonyms": [
                        "empêcher"
                    ],
                    "common_phrases": [
                        "permettre de faire",
                        "permettre d'améliorer"
                    ]
                },
                {
                    "sense_id": "5abcf102-cd0b-3434-b311-90ee80d4c9d8",
                    "sense_definition": "Prendre la liberté d'agir ou de parler, oser faire une chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "audace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>permets</w> de vous contacter afin d'obtenir des informations complémentaires."
                        },
                        {
                            "text": "Il s'est <w>permis</w> une remarque déplacée pendant la réunion de ce matin."
                        }
                    ],
                    "synonyms": [
                        "oser"
                    ],
                    "common_phrases": [
                        "se permettre de",
                        "se permettre une remarque"
                    ]
                },
                {
                    "sense_id": "153a7c81-f27e-3376-8a9e-8fe37c4fd0e2",
                    "sense_definition": "Avoir les moyens matériels ou financiers d'assumer une dépense ou une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "moyens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec notre petit budget actuel, nous ne pouvons pas nous <w>permettre</w> un tel voyage."
                        },
                        {
                            "text": "Après des années d'économies, elle peut enfin se <w>permettre</w> d'acheter cette maison."
                        }
                    ],
                    "common_phrases": [
                        "pouvoir se permettre",
                        "se permettre un luxe"
                    ]
                }
            ]
        }
    ]
}