                "senses": [
                    {
                        "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                        "entry_id": "a3697d77-8ee5-3b27-8d13-e6b6a37f8511",
                        "glosses": [
                            "Synonym of jambeau (“piece of armor for the leg”)."
                        ],
                        "tags": [
                            "in-plural",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "a8c624f4-7505-4747-a893-782ea33904d1",
                                "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                                "text": "[…] just below laid upon the jamber, and fastened by straps round it; […]"
                            },
                            {
                                "example_id": "6b32ce3d-fb77-4734-a200-a6fba0e75171",
                                "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                                "text": "Two pair of jambers (armour for the legs,) of iron, old and new; two coats of velvet to cover the plates."
                            },
                            {
                                "example_id": "8e6a720a-2531-428a-9c8d-bfad7db7bf43",
                                "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                                "text": "An inventory dated 1313 of the armour which belonged to Piers Gaveston, includes breast and back plates and two pairs of \"jambers\" of iron; but most of the monumental figures are still in chain-mail and genouillières."
                            },
                            {
                                "example_id": "f7829d68-efc2-4a12-8d2c-92e3f2780bb2",
                                "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                                "text": "This material was largely used, as Chaucer tells us that the knights' jambers were of cuir bouilli; and from many […]"
                            },
                            {
                                "example_id": "06b7bb00-1fef-43b0-a050-6afc8e41c254",
                                "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                                "text": "It shows him wearing a tabard and the Garter on his jamber. The latter is modelled, as if so worn. The only existing armour which we can with certainty say was one of Anne de Montmorency's, is that presented to Ferdinand […]"
                            },
                            {
                                "example_id": "50d86c4b-22d5-484c-97d4-67aa652822eb",
                                "sense_id": "7a9a1f16-2c76-34b9-86d8-1e0fd17f2567",
                                "text": "Edward needed weapons and the armourers of London, including a man named Manekin, supplied three steel bacinets (headpieces), two pairs of jambers (leg armour), and two helmets, one with visor and another without."
                            }
                        ]
                    }
