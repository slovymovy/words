                "senses": [
                    {
                        "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                        "entry_id": "2e190c14-b56a-3b54-961f-0582bb466d1e",
                        "glosses": [
                            "Professor an einer wissenschaftlichen Hochschule für das Fachgebiet Erziehungswissenschaft (Pädagogik)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d0f637-2949-42ce-b1cb-3f8adf426e0d",
                                "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                                "text": "„Eine andere Erklärung ist die starke Belastung der Pädagogikprofessoren durch die Lehre.“"
                            },
                            {
                                "example_id": "7b0fd774-afba-43c8-97d0-5b3f433cb0d4",
                                "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                                "text": "„Vorher war er unter anderem Projektleiter am Max-Planck-Institut für Bildungsforschung in Berlin und Pädagogikprofessor in Hamburg.“"
                            },
                            {
                                "example_id": "d2efe763-90c5-4ba5-beb7-dcab4a956c28",
                                "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                                "text": "„Natürlich wird es Einwände geben: von Pädagogikprofessoren, Bildungspolitikern und Journalisten.“"
                            },
                            {
                                "example_id": "84a4ce80-fd44-4f00-8237-e06b6e668d52",
                                "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                                "text": "„Pädagogikprofessoren sind über der Frage ergraut und emeritiert.“"
                            },
                            {
                                "example_id": "481a03a8-e0be-4e7d-8faf-4dc0b8abdcbb",
                                "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                                "text": "„Erst seit der Pisa-Debatte entdecken die frustrierten Pädagogikprofessoren einen Silberstreifen am Horizont.“"
                            },
                            {
                                "example_id": "a08abd27-4e29-4176-95f7-dbab10752437",
                                "sense_id": "2b7c212a-aaa3-3e86-b645-ad07ea0b3d18",
                                "text": "„Irreführend ist für den Pädagogikprofessor auch der Begriff Serienstraftäter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
