    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5f1dee8a-945d-33fc-85e0-46b94cc4716d",
                "word": "juju",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "60838f95-5de8-44c9-be7a-4778b33bf24b",
                        "entry_id": "5f1dee8a-945d-33fc-85e0-46b94cc4716d",
                        "tags": [
                            "plural"
                        ],
                        "form": "jujus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31aa5a16-cab3-3c6d-a0b0-0c6579d64601",
                        "entry_id": "5f1dee8a-945d-33fc-85e0-46b94cc4716d",
                        "glosses": [
                            "A fetish or charm believed by West Africans to have magical or supernatural powers."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "fe88e99d-07c3-4e3e-8fb6-dab426f6263d",
                                "sense_id": "31aa5a16-cab3-3c6d-a0b0-0c6579d64601",
                                "text": "Pendants round the neck, bangles round the wrists or ankles, potatoes or nutmegs in the pocket are as old or older than civilisation, carrying the same prophylactic magic as any juju in an African witchdoctor's armamentarium."
                            }
                        ]
                    },
                    {
                        "sense_id": "e08c0be7-6a34-38b5-9326-18ad3018a9ca",
                        "entry_id": "5f1dee8a-945d-33fc-85e0-46b94cc4716d",
                        "glosses": [
                            "The magical or supernatural power of such a charm."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a77ac69-2a31-4f1c-9fe1-5f4cb66ed8b4",
                                "sense_id": "e08c0be7-6a34-38b5-9326-18ad3018a9ca",
                                "text": "They are believed to be \"Ju-Ju\" or were-leopards, and in this guise to roam through the forest in bands, bent on evil and destruction."
                            },
                            {
                                "example_id": "a2f8826f-eadb-4b61-b031-e0854e7b1a0a",
                                "sense_id": "e08c0be7-6a34-38b5-9326-18ad3018a9ca",
                                "text": "The party had nominal hosts, all famous, but the real hostess, as everyone knew, was La Doll, who had more connections and access and juju than all of those people combined."
                            },
                            {
                                "example_id": "3a2936be-cad5-4efc-aebe-a604f1fb2b29",
                                "sense_id": "e08c0be7-6a34-38b5-9326-18ad3018a9ca",
                                "text": "The blues juju—or jou-jou—relies upon the enjoyment of desires that cannot be satisfied."
                            }
                        ]
                    },
                    {
                        "sense_id": "db782eb5-83c4-35ce-b5b0-d439e885f7d7",
                        "entry_id": "5f1dee8a-945d-33fc-85e0-46b94cc4716d",
                        "glosses": [
                            "The (usually negative) karmic consequences of an action or behavior."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "623d61a1-bfb5-4262-80b2-6de4ac660604",
                                "sense_id": "db782eb5-83c4-35ce-b5b0-d439e885f7d7",
                                "text": "That's some bad juju."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
