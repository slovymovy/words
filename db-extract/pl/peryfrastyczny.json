                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a2f17ff-1e50-389b-a2e0-fc93f2ec59c2",
                        "entry_id": "c01febda-669e-3e7a-8089-d8cf5b1164ce",
                        "glosses": [
                            "określający coś za pomocą peryfrazy"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "925c9f27-e13e-4b6c-94b7-cb51d82c80bd",
                        "source_entry_id": "c01febda-669e-3e7a-8089-d8cf5b1164ce",
                        "source_sense_id": "9a2f17ff-1e50-389b-a2e0-fc93f2ec59c2",
                        "target_lang_word": "periphrastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periphrastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                        "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                                        "glosses": [
                                            "Expressed in more words than are necessary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da978b32-cfd3-48ed-ba24-b7bc76d691d2",
                                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                                "text": "He wrote a periphrastic love letter to his wife to patch up their relationship."
                                            },
                                            {
                                                "example_id": "381e8e7f-793c-4e34-94b7-76d79edd888c",
                                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                                "text": "She was simply asked to express how she felt, but her response was periphrastic."
                                            },
                                            {
                                                "example_id": "95969eef-5691-4d6d-9c32-4447d3b8c4d2",
                                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                                "text": "As poetry it does not measure up to Aasen; as translation it is periphrastic, arbitrary, not at all faithful."
                                            },
                                            {
                                                "example_id": "b9b169ca-3ebb-40a6-a89b-7cb665a56460",
                                                "sense_id": "e0d0d43a-f780-353b-8d4e-0731bdd6de96",
                                                "text": "That was a way of putting it—not very satisfactory/ A periphrastic study in a worn-out poetical fashion/ Leaving one still with the intolerable wrestle / With words and meanings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5769c501-f7a6-305d-ad1a-d2b626ba8853",
                                        "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                                        "glosses": [
                                            "Indirect in naming an entity; circumlocutory."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac1942c-8963-4a11-bb69-efbabf758328",
                                                "sense_id": "5769c501-f7a6-305d-ad1a-d2b626ba8853",
                                                "text": "In writing, they deem it irreverent to express the Supreme Being [and] in conversation they generally use a periphrastic epithet, such as the All-Good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a28f82b-f307-3b40-9fa6-4a08bf6225e0",
                                        "entry_id": "248f090c-0e2b-35e5-8fe8-2690b457e2c9",
                                        "glosses": [
                                            "Characterized by periphrasis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9eb5679-6703-44b5-9811-4c939a2ee549",
                                                "sense_id": "3a28f82b-f307-3b40-9fa6-4a08bf6225e0",
                                                "text": "“The daughter of the man” may be used as a periphrastic synonym for “the man’s daughter”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9140fa64-d709-481f-b200-6be53731eb5b",
                        "source_entry_id": "c01febda-669e-3e7a-8089-d8cf5b1164ce",
                        "source_sense_id": "9a2f17ff-1e50-389b-a2e0-fc93f2ec59c2",
                        "target_lang_word": "circumlocutory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circumlocutory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6288808-1f32-357d-a672-15282bddbec7",
                                        "entry_id": "d94ba19b-a559-3029-9ead-3c4be8742885",
                                        "glosses": [
                                            "Characterised by circumlocution; overly wordy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a4e96c5-3621-4309-aa30-20524e3acab7",
                                                "sense_id": "f6288808-1f32-357d-a672-15282bddbec7",
                                                "text": "1727, Jonathan Swift (attributed), Martinus Scriblerus, or the Art of Sinking In Poetry\nPeriphrase is another great aid to prolixity; being a diffused circumlocutory manner of expressing a known idea, which should be so mysteriously couched, as to give the reader the pleasure of guessing what it is, that the author can possibly mean; and a strange surprise, when he finds it."
                                            },
                                            {
                                                "example_id": "32f93575-572c-4404-a72d-066871b26e01",
                                                "sense_id": "f6288808-1f32-357d-a672-15282bddbec7",
                                                "text": "Rachel's talks with the vicar were frequent; and poor little Mrs. William Wylder, who knew not the reason of his visits, fell slowly, and to the good man's entire bewilderment, into a chronic jealousy. It expressed itself enigmatically; it was circumlocutory, sad, and mysterious."
                                            },
                                            {
                                                "example_id": "6210e8e5-14e2-464a-b5bd-45257a2ea71f",
                                                "sense_id": "f6288808-1f32-357d-a672-15282bddbec7",
                                                "text": "Another common type of error is a circumlocutory error, when the patient describes the item in several words (e.g., describing a beaver as \"an animal that eats trees\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
