    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9bd0492-625b-33c3-ba38-fea238c13101",
                    "sense_definition": "Making a lot of noise; having a high volume or great intensity of sound.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please turn the volume down because the music is too <w>loud</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убавь громкость, потому что музыка слишком <w>громкая</w>.",
                                "tr": "Lütfen sesi kısın çünkü müzik çok <w>yüksek</w>.",
                                "zh": "请把音量调小，因为音乐太<w>响</w>了。"
                            }
                        },
                        {
                            "text": "We heard a <w>loud</w> noise coming from the street.",
                            "target_lang_translations": {
                                "ru": "Мы услышали <w>громкий</w> шум, доносящийся с улицы.",
                                "tr": "Sokaktan gelen <w>gürültülü</w> bir ses duyduk.",
                                "zh": "我们听到街上传来一阵<w>巨大</w>的噪音。"
                            }
                        },
                        {
                            "text": "He spoke in a <w>loud</w> voice so everyone could hear him.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>громким</w> голосом, чтобы все могли его слышать.",
                                "tr": "Herkesin kendisini duyabilmesi için <w>yüksek</w> bir sesle konuştu.",
                                "zh": "他用<w>响亮</w>的声音说话，以便每个人都能听见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "noisy",
                        "blaring",
                        "strong",
                        "powerful"
                    ],
                    "antonyms": [
                        "quiet",
                        "silent",
                        "soft",
                        "low",
                        "weak"
                    ],
                    "common_phrases": [
                        "loud noise",
                        "loud voice",
                        "loud music",
                        "loud bang"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издающий много шума; имеющий высокую громкость или интенсивность звука.",
                        "tr": "Çok gürültü çıkaran; sesi yüksek veya şiddetli olan.",
                        "zh": "发出很大声音的；音量高或声音强度大的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громкий",
                                "target_lang_sense_clarification": "о звуке"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüksek",
                                "target_lang_sense_clarification": "ses için"
                            },
                            {
                                "target_lang_word": "yüksek sesli",
                                "target_lang_sense_clarification": "ses veya müzik için"
                            },
                            {
                                "target_lang_word": "gürültülü",
                                "target_lang_sense_clarification": "şiddetli ses için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "响亮",
                                "target_lang_sense_clarification": "形容声音大"
                            },
                            {
                                "target_lang_word": "大声",
                                "target_lang_sense_clarification": "形容音量高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "968d22a4-ce36-3769-8ebb-bde61a024fac",
                    "sense_definition": "Used to describe a person, event, or thing that produces a lot of noise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>loud</w> party next door kept us awake all night.",
                            "target_lang_translations": {
                                "ru": "<w>Шумная</w> вечеринка по соседству не давала нам спать всю ночь.",
                                "tr": "Yandaki <w>gürültülü</w> parti bütün gece bizi uyutmadı.",
                                "zh": "隔壁<w>吵闹</w>的派对让我们整晚没睡。"
                            }
                        },
                        {
                            "text": "They are a very <w>loud</w> family who love to shout and laugh.",
                            "target_lang_translations": {
                                "ru": "Это очень <w>шумная</w> семья, которая любит кричать и смеяться.",
                                "tr": "Bağırmayı ve gülmeyi seven çok <w>gürültücü</w> bir aileler.",
                                "zh": "他们一家人都很<w>喧闹</w>，喜欢大喊大笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "noisy"
                    ],
                    "antonyms": [
                        "quiet"
                    ],
                    "common_phrases": [
                        "loud party",
                        "loud crowd",
                        "loud neighbors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для описания человека, события или предмета, производящего много шума.",
                        "tr": "Çok gürültü çıkaran bir kişiyi, olayı veya nesneyi tanımlamak için kullanılır.",
                        "zh": "用于描述产生大量噪音的人、事件或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шумный",
                                "target_lang_sense_clarification": "производящий шум"
                            },
                            {
                                "target_lang_word": "громкий",
                                "target_lang_sense_clarification": "о голосе или событии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "gürültülü",
                                "target_lang_sense_clarification": "insan, ortam veya olay için"
                            },
                            {
                                "target_lang_word": "patırtılı",
                                "target_lang_sense_clarification": "gürültülü yer veya etkinlik"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吵闹",
                                "target_lang_sense_clarification": "形容环境或人喧哗"
                            },
                            {
                                "target_lang_word": "喧闹",
                                "target_lang_sense_clarification": "形容场面嘈杂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c367cb-dc52-3345-9800-3e85164b4ea0",
                    "sense_definition": "Demanding attention; not subtle, reserved, or shy in behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>loud</w> personality that dominates the room.",
                            "target_lang_translations": {
                                "ru": "У неё <w>громогласный</w> характер, который доминирует в комнате.",
                                "tr": "Odaya hakim olan <w>baskın</w> bir kişiliği var.",
                                "zh": "她有着一种<w>张扬</w>的个性，在房间里总是占据主导地位。"
                            }
                        },
                        {
                            "text": "He can be quite <w>loud</w> and opinionated when discussing politics.",
                            "target_lang_translations": {
                                "ru": "Он может быть довольно <w>шумным</w> и категоричным при обсуждении политики.",
                                "tr": "Politika tartışırken oldukça <w>baskın</w> ve ısrarcı olabiliyor.",
                                "zh": "在讨论政治时，他可能会变得相当<w>高调</w>且固执己见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forceful",
                        "strident"
                    ],
                    "antonyms": [
                        "subtle",
                        "quiet"
                    ],
                    "common_phrases": [
                        "loud personality",
                        "loud mouth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий внимания; не сдержанный и не скромный в поведении.",
                        "tr": "Dikkat çeken; davranışlarında çekingen, sessiz veya mütevazı olmayan.",
                        "zh": "引人注目的；在行为上不含蓄、不拘谨或不害羞的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "громогласный",
                                "target_lang_sense_clarification": "о человеке или манере поведения"
                            },
                            {
                                "target_lang_word": "шумный",
                                "target_lang_sense_clarification": "привлекающий внимание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "baskın",
                                "target_lang_sense_clarification": "kişilik için"
                            },
                            {
                                "target_lang_word": "gürültücü",
                                "target_lang_sense_clarification": "dikkat çeken, gürültülü davranan kişi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张扬",
                                "target_lang_sense_clarification": "形容性格外露"
                            },
                            {
                                "target_lang_word": "高调",
                                "target_lang_sense_clarification": "形容行为引人注意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc3700c5-1609-3cdd-8e4f-f2057136a782",
                    "sense_definition": "Having very bright and noticeable colors or patterns, often in a way that is considered tasteless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visual_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>loud</w> shirt with bright orange flowers to the meeting.",
                            "target_lang_translations": {
                                "ru": "Он надел на встречу <w>кричащую</w> рубашку с ярко-оранжевыми цветами.",
                                "tr": "Toplantıya parlak turuncu çiçekleri olan <w>bağıran</w> bir gömlek giyip geldi.",
                                "zh": "他穿了一件印有亮橙色花朵的<w>花哨</w>衬衫去参加会议。"
                            }
                        },
                        {
                            "text": "The wallpaper in the hallway is a bit too <w>loud</w> for my taste.",
                            "target_lang_translations": {
                                "ru": "Обои в коридоре немного слишком <w>кричащие</w> на мой вкус.",
                                "tr": "Koridordaki duvar kağıdı benim zevkime göre biraz fazla <w>göz alıcı</w>.",
                                "zh": "走廊里的壁纸对我来说有点太<w>扎眼</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gaudy",
                        "garish"
                    ],
                    "antonyms": [
                        "subtle"
                    ],
                    "common_phrases": [
                        "loud colors",
                        "loud shirt",
                        "loud tie",
                        "loud pattern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий очень яркие и заметные цвета или узоры, часто безвкусные.",
                        "tr": "Göz alıcı, çok parlak ve dikkat çekici renklere veya desenlere sahip olan (genellikle zevksiz kaçan).",
                        "zh": "颜色或图案非常鲜艳醒目，通常被认为缺乏品味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "о цвете или одежде"
                            },
                            {
                                "target_lang_word": "аляповатый",
                                "target_lang_sense_clarification": "безвкусный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bağıran",
                                "target_lang_sense_clarification": "renk veya kıyafet için"
                            },
                            {
                                "target_lang_word": "göze batan",
                                "target_lang_sense_clarification": "çok parlak veya gösterişli"
                            },
                            {
                                "target_lang_word": "cart",
                                "target_lang_sense_clarification": "canlı, göz alıcı renk"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花哨",
                                "target_lang_sense_clarification": "形容颜色过于艳丽"
                            },
                            {
                                "target_lang_word": "扎眼",
                                "target_lang_sense_clarification": "形容颜色过于显眼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4a7e38c-7b5a-3e61-a5fe-6a09bfa2186f",
                    "sense_definition": "Having a strong or pungent smell; often used to describe high-quality marijuana.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smell_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skunk sprayed something that smelled really <w>loud</w>.",
                            "target_lang_translations": {
                                "ru": "Скунс брызнул чем-то, что пахло очень <w>сильно</w>.",
                                "tr": "Kutup porsuğu gerçekten <w>keskin</w> kokan bir şey püskürttü.",
                                "zh": "臭鼬喷出了一种闻起来非常<w>浓烈</w>的东西。"
                            }
                        },
                        {
                            "text": "He opened the bag and the <w>loud</w> scent filled the car.",
                            "target_lang_translations": {
                                "ru": "Он открыл сумку, и <w>резкий</w> запах наполнил машину.",
                                "tr": "Çantayı açtı ve <w>ağır</w> koku arabanın içini doldurdu.",
                                "zh": "他打开袋子，那股<w>刺鼻</w>的气味充满了整个车厢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strong"
                    ],
                    "antonyms": [
                        "mild",
                        "subtle"
                    ],
