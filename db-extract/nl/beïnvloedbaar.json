                        "examples": [
                            {
                                "example_id": "a81868dc-813f-4644-8676-e9981230bfbd",
                                "sense_id": "1601129e-0a75-37d9-934f-a2c18d33b422",
                                "text": "- Als ze al iets wil aantonen, dan is het dat een moordzaak zelden een duidelijke oplossing heeft. Politieonderzoek laat belangrijke details links liggen, jury’s zijn beïnvloedbaar, en de pech van een slechte advocaat kan een verdachte opbreken."
                            },
                            {
                                "example_id": "bbb55d93-76ea-47aa-bb48-63ce9f9d5713",
                                "sense_id": "1601129e-0a75-37d9-934f-a2c18d33b422",
                                "text": "- Mensen zijn vaak heel beïnvloedbaar door reclame."
                            }
                        ]
                    }
