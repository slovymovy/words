                        "examples": [
                            {
                                "example_id": "e655ba1e-aa59-4e71-9f3d-c5b92d30b0c6",
                                "sense_id": "e9b06032-01f8-353c-a9d6-0964c1c9175a",
                                "text": "De opvolger van Silk Road, met de geïnspireerde naam Silk Road 2.0, is inmiddels opgesplitst in twee nieuwe: Agora en Evolution. Het aantal advertenties op die sites steeg in de laatste twee maanden van het onderzoek met 20 procent."
                            },
                            {
                                "example_id": "f6710f78-5fcf-4129-bd21-341d6e9e62c7",
                                "sense_id": "e9b06032-01f8-353c-a9d6-0964c1c9175a",
                                "text": "Vanwege alle aandacht van de fans, heeft de lampenmaker besloten om een op One Direction geïnspireerde lamp te gaan maken."
                            }
                        ]
                    }
                ],
