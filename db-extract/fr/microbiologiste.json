                                "target_senses": [
                                    {
                                        "sense_id": "6b366962-549f-3d4d-baf8-be2f8a2dd5e9",
                                        "entry_id": "d298f45d-1cdd-3d29-8188-6d67f8998c61",
                                        "glosses": [
                                            "A scientist whose speciality is microbiology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ae72032-3060-470a-81ab-37d72b096a22",
                                                "sense_id": "6b366962-549f-3d4d-baf8-be2f8a2dd5e9",
                                                "text": "On a tour of the cavernous and gleaming BrewDog plant in Ellon, just north of Aberdeen, Dickie happily batted around terminology – IBU, ABV, pH, haze, present gravity, headspace oxygen – with PhD-level microbiologists working in the lab."
                                            },
                                            {
                                                "example_id": "b4970f07-bb2f-4e55-8846-0a463930167b",
                                                "sense_id": "6b366962-549f-3d4d-baf8-be2f8a2dd5e9",
                                                "text": "No, because we obsessively clean it (or use paper coverings at work), said microbiologist Charles Gerba, a professor of public health, environmental science and immunology at the University of Arizona."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
