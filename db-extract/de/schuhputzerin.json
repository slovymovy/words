                "senses": [
                    {
                        "sense_id": "724beae0-86b3-35f0-ab06-83e63389963e",
                        "entry_id": "18ea1b4f-27c2-3a98-b3b7-bad2ab7a0a5e",
                        "glosses": [
                            "weibliche Person, die auf der Straße Passanten die Schuhe putzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99124a58-a12b-4037-b95d-bbaff3745196",
                                "sense_id": "724beae0-86b3-35f0-ab06-83e63389963e",
                                "text": "„Babette war achtjährig als Dienstmädchenhelferin, Schuhputzerin und Küchengehilfin zum Gesinde des Schlosses gestoßen.“"
                            },
                            {
                                "example_id": "84e20221-aea8-4dc5-a4ef-966a5133f36c",
                                "sense_id": "724beae0-86b3-35f0-ab06-83e63389963e",
                                "text": "„Paula erklärte sich bereit, nicht mehr nach Timbuktu auswandern oder Schuhputzerin in New York werden zu wollen.“"
                            },
                            {
                                "example_id": "881f04f4-d8ce-4071-8ff9-1d0510b1d1b1",
                                "sense_id": "724beae0-86b3-35f0-ab06-83e63389963e",
                                "text": "„Du erinnerst dich doch sicher an die Schuhputzerin, die eines Abends bei euch erschienen ist.“"
                            }
                        ],
