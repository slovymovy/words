                "senses": [
                    {
                        "sense_id": "dc6a6b5d-8ada-3618-a023-ab04f1f4221a",
                        "entry_id": "a50dc808-e33f-3347-b104-ef8b1ba79056",
                        "glosses": [
                            "Faire du striptease."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a6f8b9c9-3ee1-4ff0-9941-7e1899e355f3",
                                "sense_id": "dc6a6b5d-8ada-3618-a023-ab04f1f4221a",
                                "text": "Derrière cette entrée somptueuse vint un tango, avec une chanteuse à voix, pulpeuse, stripteasant ses effets, adorablement ringarde."
                            },
                            {
                                "example_id": "1f860caf-7868-4e8b-8830-4133fc3853ff",
                                "sense_id": "dc6a6b5d-8ada-3618-a023-ab04f1f4221a",
                                "text": "À tour de rôle, les serveurs montent sur la scène, au milieu de la salle, stripteasent en deux temps et font trois mouvements de danse, nus, bottes de cowboy exceptées, sur la musique du juke box."
                            },
                            {
                                "example_id": "3fb1d20e-f18a-4071-91fe-d81a493fb08b",
                                "sense_id": "dc6a6b5d-8ada-3618-a023-ab04f1f4221a",
                                "text": "On va se payer une petite balade à la campagne ; c’est tout stripteasé par l’hiver, mais c’est solitaire et salement beau."
                            },
                            {
                                "example_id": "34535dc4-d49e-4024-8b14-df2ce99a29e6",
                                "sense_id": "dc6a6b5d-8ada-3618-a023-ab04f1f4221a",
                                "text": "Alors que je tisais, elle se stripteasait autour d’une longue barre à laquelle elle ne se tenait rien qu’avec les jambes."
                            }
                        ]
                    },
                    {
                        "sense_id": "44274121-ba58-3ffe-83b0-176cb232f7bc",
                        "entry_id": "a50dc808-e33f-3347-b104-ef8b1ba79056",
                        "glosses": [
                            "Révéler à la vue de tous."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a33a730b-a672-468e-a6d5-69aba5376aed",
                                "sense_id": "44274121-ba58-3ffe-83b0-176cb232f7bc",
                                "text": "Ils stripteasent leurs faux secrets, et ça les fait bander."
                            }
                        ]
                    }
