                    {
                        "translation_id": "ef604ee1-3fe6-4638-b345-fa803df6eafd",
                        "source_entry_id": "48865db2-c560-38bf-a0bf-b3a4059c6377",
                        "source_sense_id": "ccdc31d8-957a-3846-9b9d-e6288681a604",
                        "source_sense_description": "Zustand der Rechtlosigkeit und Ausbeutung",
                        "target_lang_word": "рабство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рабство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3877c277-25c2-393c-94e3-433445352ee7",
                                        "entry_id": "786c47af-c3c1-3f13-8390-02854c68e7a5",
                                        "glosses": [
                                            "состояние раба, бесправное положение, полная зависимость от другого человека, подчинённость другому человеку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a78ba36-827e-409b-82cc-09d70e69f230",
                                                "sense_id": "3877c277-25c2-393c-94e3-433445352ee7",
                                                "text": "Если никто не выкупал должника, то кредитор имел право продать его в рабство либо даже убить и завладеть его имуществом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b797534e-e133-31cc-befa-825945a4d777",
                                        "entry_id": "786c47af-c3c1-3f13-8390-02854c68e7a5",
                                        "glosses": [
                                            "полит. общественный строй, основанный на рабовладении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f89836-f40a-43c7-bad9-51b0ed126844",
                                                "sense_id": "b797534e-e133-31cc-befa-825945a4d777",
                                                "text": "Во всяком случае, рабство быстро превратилось в обычный институт общества, в нормальный способ трудовых взаимоотношений чернокожих и белых в Новом Свете."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0c37192-f0e8-3214-b261-11de586fd1e2",
                                        "entry_id": "786c47af-c3c1-3f13-8390-02854c68e7a5",
                                        "glosses": [
                                            "перен. полная зависимость от чего-либо или кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2599c40-4d63-4f85-b5b2-2e05136348ff",
                                                "sense_id": "e0c37192-f0e8-3214-b261-11de586fd1e2",
                                                "text": "К сожалению, нас еще не озарило понимание, что беспамятство ― верная дорога к повторению обстановки духовного рабства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
