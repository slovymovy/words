                "senses": [
                    {
                        "sense_id": "8df6ccb7-a740-3e07-9337-d48f3845a71f",
                        "entry_id": "ae223d79-2ade-351a-b2ec-94abe7a3ab17",
                        "glosses": [
                            "Retirer d’une carotte qui a été extraite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7069cff-35b4-4c28-804c-6843f614b334",
                                "sense_id": "8df6ccb7-a740-3e07-9337-d48f3845a71f",
                                "text": "Au lieu de décarotter, on pèserait le tube et son contenu. Le volume et le poids de la carotte seraient alors obtenus avec précision."
                            },
                            {
                                "example_id": "ae518bb7-35f9-40ef-8924-30933988cb10",
                                "sense_id": "8df6ccb7-a740-3e07-9337-d48f3845a71f",
                                "text": "Je « décarotte » dans le même ordre, mes émotions enfouies qui ont été sources de malaises et de déconvenues pour semer des graines d'envies, de projets et de rencontres, que j’ai personnellement choisi pour les mettre en terre nourricière."
                            }
                        ]
                    }
