{
    "word_family": [
        "sifter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99fd5120-fa15-3545-bdb0-34187c220306",
                    "sense_definition": "To pass a substance through a sieve or strainer to remove large particles or lumps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>sift</w> the flour before adding it to the cake batter.",
                            "target_lang_translations": {
                                "cs": "Před přidáním do těsta byste měli mouku <w>prosít</w>."
                            }
                        },
                        {
                            "text": "The chef used a fine mesh to <w>sift</w> the sugar for the dessert.",
                            "target_lang_translations": {
                                "cs": "Šéfkuchař použil jemné síto, aby <w>prosel</w> cukr na dezert."
                            }
                        }
                    ],
                    "synonyms": [
                        "strain",
                        "filter",
                        "sieve"
                    ],
                    "common_phrases": [
                        "sift the flour"
                    ],
                    "target_lang_definitions": {
                        "cs": "Prosévat nebo propasírovat látku přes síto, aby se odstranily hrubé částice nebo hrudky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prosévat",
                                "target_lang_sense_clarification": "zejména u sypkých látek jako mouka"
                            },
                            {
                                "target_lang_word": "přesívat",
                                "target_lang_sense_clarification": "obecný proces prosévání"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fb2f076-841d-3a3c-9bd5-5e1512aeb92d",
                    "sense_definition": "To carefully examine or search through a large amount of information or objects to find something specific.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "examination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Detectives had to <w>sift</w> through hundreds of documents to find the evidence.",
                            "target_lang_translations": {
                                "cs": "Detektivové museli <w>prohledat</w> stovky dokumentů, aby našli důkazy."
                            }
                        },
                        {
                            "text": "Researchers <w>sift</w> through data to identify important trends in the study.",
                            "target_lang_translations": {
                                "cs": "Výzkumníci <w>procházejí</w> data, aby identifikovali důležité trendy ve studii."
                            }
                        }
                    ],
                    "synonyms": [
                        "examine",
                        "scrutinize",
                        "investigate"
                    ],
                    "common_phrases": [
                        "sift through data",
                        "sift through evidence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pečlivě zkoumat nebo prohledávat velké množství informací či předmětů za účelem nalezení něčeho konkrétního."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "procházet",
                                "target_lang_sense_clarification": "v kontextu dokumentů nebo dat"
                            },
                            {
                                "target_lang_word": "prohledávat",
                                "target_lang_sense_clarification": "důkladné hledání v objemu informací"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e72c3a-2d87-391e-a06c-58c5905b400b",
                    "sense_definition": "To analyze or question someone or something thoroughly to discover the truth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "examination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer began to <w>sift</w> the witness's testimony for inconsistencies.",
                            "target_lang_translations": {
                                "cs": "Právník začal <w>prověřovat</w> svědkovu výpověď, zda neobsahuje rozpory."
                            }
                        },
                        {
                            "text": "It is necessary to <w>sift</w> the facts from the rumors in this case.",
                            "target_lang_translations": {
                                "cs": "V tomto případě je nutné <w>oddělit</w> fakta od fám."
                            }
                        }
                    ],
                    "synonyms": [
                        "analyze",
                        "probe"
                    ],
                    "common_phrases": [
                        "sift the facts"
                    ],
                    "target_lang_definitions": {
                        "cs": "Důkladně analyzovat nebo zpochybňovat někoho či něco, aby se odhalila pravda."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prověřovat",
                                "target_lang_sense_clarification": "kritické zkoumání faktů či výpovědí"
                            },
                            {
                                "target_lang_word": "analyzovat",
                                "target_lang_sense_clarification": "rozbor informací za účelem zjištění pravdy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1a8aa8f-bdd1-3d5a-b7fc-73a8c6f9f60c",
                    "sense_definition": "To separate or scatter items as if they were being passed through a sieve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind began to <w>sift</w> the dry sand across the desert floor.",
                            "target_lang_translations": {
                                "cs": "Vítr začal <w>rozptylovat</w> suchý písek po poušti."
                            }
                        },
                        {
                            "text": "Light seemed to <w>sift</w> through the dense canopy of the forest.",
                            "target_lang_translations": {
                                "cs": "Světlo jako by <w>prosvítalo</w> hustou korunou stromů v lese."
                            }
                        }
                    ],
                    "synonyms": [
                        "scatter",
                        "sprinkle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Oddělovat nebo rozptylovat předměty, jako by procházely sítem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozptylovat",
                                "target_lang_sense_clarification": "v kontextu pohybu částic nebo světla"
                            },
                            {
                                "target_lang_word": "prosvítat",
                                "target_lang_sense_clarification": "v kontextu světla procházejícího skrz něco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea1fd55-f942-368b-91c5-571882c3d012",
                    "sense_definition": "To move data records within memory to create space for new entries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm must <w>sift</w> the existing records to make room for the new data.",
                            "target_lang_translations": {
                                "cs": "Algoritmus musí <w>přesunout</w> stávající záznamy, aby uvolnil místo pro nová data."
                            }
                        },
                        {
                            "text": "The system will <w>sift</w> the memory blocks during the reorganization process.",
                            "target_lang_translations": {
                                "cs": "Systém během procesu reorganizace <w>přesune</w> paměťové bloky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přesouvat datové záznamy v paměti za účelem uvolnění místa pro nové položky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přesouvat",
                                "target_lang_sense_clarification": "v kontextu správy paměti"
                            },
                            {
                                "target_lang_word": "reorganizovat",
                                "target_lang_sense_clarification": "uspořádání datových bloků"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ab19e00-19cb-337e-945e-243dd48e82c9",
                    "sense_definition": "The act or process of sifting.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>sift</w> of the soil revealed several small stones.",
                            "target_lang_translations": {
                                "cs": "Rychlé <w>prosetí</w> půdy odhalilo několik malých kamínků."
                            }
                        },
                        {
                            "text": "The final <w>sift</w> of the mixture ensures a smooth texture.",
                            "target_lang_translations": {
                                "cs": "Závěrečné <w>prosátí</w> směsi zajistí hladkou texturu."
                            }
                        }
                    ],
                    "synonyms": [
                        "screening",
                        "filtration"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt nebo proces prosévání."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prosátí",
                                "target_lang_sense_clarification": "výsledek nebo proces prosévání"
                            },
                            {
                                "target_lang_word": "prosetí",
                                "target_lang_sense_clarification": "proces prosévání"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fe71041a-7df8-35cd-b102-f2a5b92f76fb",
                    "sense_definition": "An algorithm used in computer vision to detect and describe local features in images.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The software uses <w>SIFT</w> to match objects between different photographs.",
                            "target_lang_translations": {
                                "cs": "Software používá <w>SIFT</w> k porovnávání objektů mezi různými fotografiemi."
                            }
                        },
                        {
                            "text": "Researchers implemented <w>SIFT</w> to improve the accuracy of the image recognition system.",
                            "target_lang_translations": {
                                "cs": "Výzkumníci implementovali <w>SIFT</w> pro zlepšení přesnosti systému rozpoznávání obrazu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Algoritmus používaný v počítačovém vidění k detekci a popisu lokálních rysů v obrazech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "SIFT",
                                "target_lang_sense_clarification": "technický název algoritmu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "faeac0bc-7e18-36a0-af0b-7e7d51f4e94d",
                    "sense_definition": "A specific training program used for selecting candidates for flight training.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education",
                    "name_type": "event_name",
                    "examples": [
                        {
                            "text": "The pilot candidate successfully completed the <w>SIFT</w> requirements.",
                            "target_lang_translations": {
                                "cs": "Kandidát na pilota úspěšně splnil požadavky <w>SIFT</w>."
                            }
                        },
                        {
                            "text": "The military uses <w>SIFT</w> to evaluate the aptitude of potential aviators.",
                            "target_lang_translations": {
                                "cs": "Armáda používá <w>SIFT</w> k hodnocení schopností potenciálních letců."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Specifický výcvikový program používaný pro výběr kandidátů na letecký výcvik."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "SIFT",
                                "target_lang_sense_clarification": "název výběrového programu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}