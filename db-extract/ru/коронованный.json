                                        "sense_id": "36a46d38-af45-3d63-9630-8eb8b3762538",
                                        "entry_id": "9865b0fd-a879-3c2b-a44f-7a9be30269e5",
                                        "glosses": [
                                            "Wearing a crown."
                                        ],
                                        "tags": [
