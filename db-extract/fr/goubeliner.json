                ],
                "senses": [
                    {
                        "sense_id": "edf00b5d-64ca-3eee-8272-9a099f235c71",
                        "entry_id": "f6fb41a6-aa85-3eaa-acf3-518b90fb544e",
                        "glosses": [
                            "Effrayer comme un goubelin."
                        ],
                        "tags": [
                            "Manche"
                        ],
                        "examples": [
                            {
                                "example_id": "3202ac17-1aff-4d1f-8c3c-d4724d535256",
                                "sense_id": "edf00b5d-64ca-3eee-8272-9a099f235c71",
                                "text": "Un universitaire qui abuse de sa blouse blanche pour goubeliner les citoyens pourrait se retrouver dans les mêmes affres."
                            },
                            {
                                "example_id": "deebb200-579b-4ed7-ab5a-eb5a19549340",
                                "sense_id": "edf00b5d-64ca-3eee-8272-9a099f235c71",
                                "text": "Envoyez lui itou le nom des récalcitrants et il se chargera de les goubeliner le moment venu."
                            },
                            {
                                "example_id": "ae8c971d-9325-44c9-9914-88147e9d6ff8",
                                "sense_id": "edf00b5d-64ca-3eee-8272-9a099f235c71",
                                "text": "Oh! écoutez, Mam’zelle Sophie, restez pas là à me « goubeliner », allez faire votre travail et laissez moi faire le mien."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c67f4f3-9fa9-3cde-a38d-32faafd4c531",
                        "entry_id": "f6fb41a6-aa85-3eaa-acf3-518b90fb544e",
                        "glosses": [
                            "Se changer en goubelin."
                        ],
                        "tags": [
                            "Manche"
                        ],
                        "examples": [
                            {
                                "example_id": "71d03d0c-d908-4911-930f-3b01fc9bc9c6",
                                "sense_id": "5c67f4f3-9fa9-3cde-a38d-32faafd4c531",
                                "text": "On sait que dans les vieilles traditions populaires de Normandie, le sorcier qui s'est changé en bête, doit pour reprendre sa forme humaine, \"délire\", c'est à dire lire à rebours la formule qui lui a servi à se \"goubeliner\"."
                            }
                        ]
                    }
                ],
