                                        "glosses": [
                                            "Symbol des weiblichen Geschlechts als göttliche schöpferische Kraft, das meist in Form eines runden Steines dargestellt wird"
                                        ],
                                        "tags": [
                                            "speziell Hinduismus"
                                        ],
