                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "af56ad6b-d8fa-43a3-b5eb-f07c74ae81b0",
                                "sense_id": "84333096-5954-3362-adb6-27ae67ab94f6",
                                "text": "Essentially, Jarden makes anything that you’d find left behind after a burglary."
                            },
                            {
                                "example_id": "f9b83c92-be87-4d76-bcc6-3c4e437a5eca",
                                "sense_id": "84333096-5954-3362-adb6-27ae67ab94f6",
                                "text": "It’s hard to say whether Corona was actually playing pickleball or was just nowhere near Slowjamastan at the time of the burglary and thinks it’s funny to say he was playing pickleball."
                            }
                        ]
                    },
                    {
                        "sense_id": "370bad77-af5e-3995-a164-4bc5a30b159e",
                        "entry_id": "a697d508-8415-3f5f-9c36-6d882329f6d9",
                        "glosses": [
                            "The crime of unlawfully breaking into a vehicle, house, store, or other enclosure with the intent to steal.",
                            "Under the common law, breaking and entering of the dwelling of another at night with the intent to commit a felony."
