                "senses": [
                    {
                        "sense_id": "047f7e84-f202-3add-a45c-d5d5ee6c8f76",
                        "entry_id": "aaee40cd-b8d1-385c-bfbe-dba30063f2e0",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit öffentlichen, Publikum unterhaltenden, Darbietungen befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d28d5f8-0ce5-45b5-ad35-ac51670b5da0",
                                "sense_id": "047f7e84-f202-3add-a45c-d5d5ee6c8f76",
                                "text": "„Nach rasch verflogenen neunzig Minuten ihrer Gegenwart verläßt man das Theater in dem Bewußtsein, wahrer Größe und einem der erstaunlichsten Erfolge im Schaugeschäft begegnet zu sein.“"
                            },
                            {
                                "example_id": "5fbdb657-bff3-4129-9be5-e9b01c19f213",
                                "sense_id": "047f7e84-f202-3add-a45c-d5d5ee6c8f76",
                                "text": "„Im August 1964 konnte man im »Magazin« über John, Paul, Ringo und George lesen, »die aus einem bescheidenen Liverpooler Arbeitermilieu auf die schillernden Gipfel des Schaugeschäfts geschleudert wurden«.“"
                            },
                            {
                                "example_id": "f6cacde9-7f0d-4b26-ba75-380714f628b4",
                                "sense_id": "047f7e84-f202-3add-a45c-d5d5ee6c8f76",
                                "text": "„Das Schaugeschäft des byzantinischen 6. Jahrhunderts hatte kaum noch etwas mit der hohen Theaterkultur der griechischen klassischen und frühnachklassischen Periode zu tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e43b78d5-6456-30a4-a3e9-3a7ec3e4fe29",
                        "entry_id": "aaee40cd-b8d1-385c-bfbe-dba30063f2e0",
                        "glosses": [
                            "einzelnes Wirtschaftsunternehmen auf einem Jahrmarkt, das von einem Schausteller betrieben wird und in dem das Publikum etwas zu sehen bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab6bba43-bf02-411a-8d42-9c1a0c684df6",
                                "sense_id": "e43b78d5-6456-30a4-a3e9-3a7ec3e4fe29",
                                "text": "Schaugeschäfte, bei denen der Besucher in die Rolle des Zuschauers schlüpfte, waren ein beliebtes Jahrmarktvergnügen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
