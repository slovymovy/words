                "senses": [
                    {
                        "sense_id": "3cf9904d-be1b-326a-b74a-c01e30da9ea3",
                        "entry_id": "e812ebb1-99b2-3557-9761-a2b79e6c7ef6",
                        "glosses": [
                            "Femme parvenue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416b236b-3209-47ed-8b3d-ba3b5a613516",
                                "sense_id": "3cf9904d-be1b-326a-b74a-c01e30da9ea3",
                                "text": "Je suis une parvenue au sens propre du terme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f6ac604-4d06-4588-a03c-9404440d5690",
                        "source_entry_id": "e812ebb1-99b2-3557-9761-a2b79e6c7ef6",
                        "source_sense_id": "3cf9904d-be1b-326a-b74a-c01e30da9ea3",
                        "target_lang_word": "Emporkömmling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emporkömmling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                        "entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                                        "glosses": [
                                            "jemand, der irgendwie in kurzer Zeit zu Geld und Einfluss gekommen ist, ohne bereits als dazugehörig akzeptiert zu werden"
                                        ],
                                        "tags": [
                                            "mit negativer Konnotation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee04f577-28cf-466a-8806-bafb63cbd863",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "Er ist ein kleiner Emporkömmling, der meint, er müsse seinen Reichtum jedem auf die Nase binden."
                                            },
                                            {
                                                "example_id": "86eb52f6-dd39-408f-8e8e-bd4010e42d6c",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Ein Spottname, den der Präsident, von der Höhe seines Amtes herab, den Emporkömmlingen aus der Sechs-Parteien-Allianz »Georgischer Traum« verpasst.“"
                                            },
                                            {
                                                "example_id": "de35c183-0437-416a-87ca-99e53602abce",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Der Emporkömmling musste am weiteren Aufstieg gehindert werden, und so ordnete der Stadtrat Pater Pintos Verhaftung an und ermächtigte seinen Gegenspieler Andrade, zu den Waffen zu greifen.“"
                                            },
                                            {
                                                "example_id": "822d8d10-2d34-4c6f-8f2e-50c5eb97ad37",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Es liegt auf der Hand, ein Emporkömmling muß man nicht erst werden, man kann bereits als Emporkömmling zur Welt kommen.“"
                                            },
                                            {
                                                "example_id": "d99bd79d-bb96-43f6-b978-785b857f0ee2",
                                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                                "text": "„Die Kerle, die in den verschiedenen Kerkern folterten, waren kleine Emporkömmlinge, die man hier und da in einem der zahlreichen Befreiungskriege aufgelesen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "432cc61b-0002-4b24-8cac-d0518a807169",
                        "source_entry_id": "e812ebb1-99b2-3557-9761-a2b79e6c7ef6",
                        "source_sense_id": "3cf9904d-be1b-326a-b74a-c01e30da9ea3",
                        "target_lang_word": "Parvenue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parvenue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ebac39-d857-3519-ac2d-26131b829e75",
                                        "entry_id": "02f90211-c3ba-3398-8275-8d62168e9736",
                                        "glosses": [
                                            "für einen weiblichen Emporkömmling, eine Neureiche, die schnell aufgestiegen ist und mit ihrem Reichtum protzt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d5cfff2-6c86-435e-9123-c2b9f35c3929",
                                                "sense_id": "a6ebac39-d857-3519-ac2d-26131b829e75",
                                                "text": "„Sie war eine Parvenue, eine Abenteurerin, eine Geschiedene, eine Amerikanerin …!“"
                                            },
                                            {
                                                "example_id": "0b3be582-95dd-4215-a2a9-1f803286d447",
                                                "sense_id": "a6ebac39-d857-3519-ac2d-26131b829e75",
                                                "text": "„Sie war niemand, als er sie heiratete, bloß die Tochter eines Gentleman, aber seit sie eine Churchill geworden ist, überchurchillt sie sie allesamt mit ihren großmächtigen Ansprüchen; an sich, muß ich sagen, ist sie einfach eine Parvenue.“"
                                            },
                                            {
                                                "example_id": "2730c3d2-33d4-47d5-9495-97bae39098fc",
                                                "sense_id": "a6ebac39-d857-3519-ac2d-26131b829e75",
                                                "text": "„Meiner Meinung nach ist eben Frau von Cambremer eine Frau von Welt und Frau von Villeparisis eine Parvenue.“"
                                            },
                                            {
                                                "example_id": "f356e04a-cb74-4a5f-95b2-44c972c2b923",
                                                "sense_id": "a6ebac39-d857-3519-ac2d-26131b829e75",
                                                "text": "„Mizzi Schinagl aber ist anders: nicht nur ein gefallenes Wiener Madl oder eine Parvenue, die in der kapitalistischen Wohlstandswelt scheitern muss.“"
                                            },
                                            {
                                                "example_id": "afb0b6fb-dd07-459a-9ad0-f1c10e8fe770",
                                                "sense_id": "a6ebac39-d857-3519-ac2d-26131b829e75",
                                                "text": "„Lord Garstang kann sich nicht so leicht verlieben, am allerwenigsten in ein Mädchen von niedriger Geburt, oder in eine Parvenue, wie Sir Ralph mich nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
