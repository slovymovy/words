                    }
                ],
                "senses": [
                    {
                        "sense_id": "9741b2ee-22e8-3966-a5bf-918773fe4a4a",
                        "entry_id": "f51b0f31-d166-395e-b125-2a08ac2b97ed",
                        "glosses": [
                            "polityk, działacz, który wygłasza hasła nierealne, lecz dające mu szerokie poparcie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ca98ba6-92bf-4f09-b5d2-677e21eedcb2",
                                "sense_id": "9741b2ee-22e8-3966-a5bf-918773fe4a4a",
                                "text": "Jeśli ten demagog zostanie przewodniczącym, wystąpię z partii!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1fa0a4f7-26bd-3197-890b-d208736a236b",
                        "entry_id": "f51b0f31-d166-395e-b125-2a08ac2b97ed",
                        "glosses": [
                            "przywódca ludowy w starożytnej Grecji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98b9f869-4e0a-4577-8978-fe2004017053",
                        "source_entry_id": "f51b0f31-d166-395e-b125-2a08ac2b97ed",
                        "source_sense_id": "9741b2ee-22e8-3966-a5bf-918773fe4a4a",
                        "target_lang_word": "demagogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demagogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20b91b67-48d7-3d7b-aa2b-fd7d74912992",
                                        "entry_id": "e6549e65-c64d-379b-8299-ad3c32e6a065",
                                        "glosses": [
                                            "A political orator or leader, especially in a democratic system, who gains favor by pandering to or exciting the passions and prejudices of the audience rather than by using rational argument."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e343c5f-35d9-4871-bd0f-51eeae508bb5",
                                                "sense_id": "20b91b67-48d7-3d7b-aa2b-fd7d74912992",
                                                "text": "1938, O'Neill, translating The Knights by Aristophanes, 424 BC, lines 191-193,\nA demagogue must be neither an educated nor an honest man; he has to be an ignoramus and a rogue."
                                            },
                                            {
                                                "example_id": "5aca4db4-b05f-427f-ac9c-e3e4c5f5f788",
                                                "sense_id": "20b91b67-48d7-3d7b-aa2b-fd7d74912992",
                                                "text": "If the majority of our fellow-citizens are more susceptible to the slogans of fear and race hatred than to those of peaceful accommodation and mutual respect among human beings, our political liberties remain at the mercy of any eloquent and unscrupulous demagogue."
                                            },
                                            {
                                                "example_id": "43de4783-3cef-49a9-b31d-d30b1dae0ee8",
                                                "sense_id": "20b91b67-48d7-3d7b-aa2b-fd7d74912992",
                                                "text": "What is a demagogue? He is a politician skilled in oratory, flattery and invective; evasive in discussing vital issues; promising everything to everybody; appealing to the passions rather than the reason of the public; and arousing racial, religious, and class prejudices—a man whose lust for power without recourse to principle leads him to seek to become a master of the masses. He has for centuries practiced his profession of 'man of the people'. He is a product of a political tradition nearly as old as western civilization itself."
                                            },
                                            {
                                                "example_id": "a4e87c2c-3ff5-4907-9e8b-1b66ff313732",
                                                "sense_id": "20b91b67-48d7-3d7b-aa2b-fd7d74912992",
                                                "text": "It is true that America has a paranoid streak in its politics, and demagogues come along from time to time to feed on anger and resentment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "199005c6-75db-30ce-8d7f-1abb878463e8",
                                        "entry_id": "e6549e65-c64d-379b-8299-ad3c32e6a065",
                                        "glosses": [
                                            "A leader of the people."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "demagogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff336eb-5aa9-3937-8a3b-5725165fd21f",
                                        "entry_id": "594f79ef-2b14-3735-aacb-c5e18d9e2aa5",
                                        "glosses": [
                                            "To speak or act in the manner of a demagogue; to speak about (an issue) in the manner of a demagogue."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aded08ef-16db-42f3-a391-0cde658baff5",
                                                "sense_id": "eff336eb-5aa9-3937-8a3b-5725165fd21f",
                                                "text": "c. 1938, Maury Maverick, The New York Times, quoted in 1970, Richard B. Henderson, Maury Maverick: A Political Biography, page 183,\nI never demagogued on our serious questions and stood for civil liberties."
                                            },
                                            {
                                                "example_id": "4af2c2d6-5ab2-4949-a428-3466134d71fd",
                                                "sense_id": "eff336eb-5aa9-3937-8a3b-5725165fd21f",
                                                "text": "On the subject of foreign aid, although it is a relatively unimportant economic category, it is an area of expenditure that has frequently been demagogued and has been a favorite target of politicians during tough times in the domestic economy."
                                            },
                                            {
                                                "example_id": "9311cf99-57f4-47ba-beaa-9483768a8291",
                                                "sense_id": "eff336eb-5aa9-3937-8a3b-5725165fd21f",
                                                "text": "Talk to anyone with half a brain (and at least half a heart) and they will tell you, regardless of their position, that this is an issue to be weighed, not demagogued."
                                            },
                                            {
                                                "example_id": "6e454b5e-adf6-41e3-b119-359565ee7e49",
                                                "sense_id": "eff336eb-5aa9-3937-8a3b-5725165fd21f",
                                                "text": "Fear-mongering, and demagoguing on the issue of immigrants, has been Mr. Trump’s preferred speed since he announced his first candidacy for the presidency in June 2015, and he has often found a receptive audience for it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04091752-7cf1-48b6-9510-3f1bc8af5f24",
                        "source_entry_id": "f51b0f31-d166-395e-b125-2a08ac2b97ed",
                        "source_sense_id": "9741b2ee-22e8-3966-a5bf-918773fe4a4a",
                        "target_lang_word": "démagogue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démagogue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07f0ecd8-404c-3bc2-9644-b45329353275",
                                        "entry_id": "c62587af-309d-3cf4-87aa-3f242661a6b4",
                                        "glosses": [
                                            "Chef, meneur d'une faction populaire."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6b04c7b-bd58-37dc-93c3-2dfd8ec1a755",
                                        "entry_id": "c62587af-309d-3cf4-87aa-3f242661a6b4",
                                        "glosses": [
                                            "Homme politique ou toute personne qui fait preuve de démagogie."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e03190cc-d4a4-49ab-a467-db093a554387",
                                                "sense_id": "d6b04c7b-bd58-37dc-93c3-2dfd8ec1a755",
                                                "text": "Il serait impossible de comprendre les succès des démagogues, depuis les temps d'Athènes jusqu'à la New York contem­poraine, si on ne tenait compte de la force extraordinaire que possède l'idée de vengeance pour oblitérer tout raisonnement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "démagogue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4403c9c0-f22a-3e9c-a221-e9061f3f514b",
                                        "entry_id": "56af2052-d111-34d2-8e25-495ef5d09e45",
                                        "glosses": [
                                            "Qualifie une personne qui pratique la démagogie."
                                        ],
