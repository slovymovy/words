                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silenus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6fd2cb7-b312-32fa-bb6d-561d32f96c97",
                                        "entry_id": "5786daf4-6046-3f5b-b09c-5a8cc01ae5b9",
                                        "glosses": [
                                            "A companion and tutor to the wine god Dionysus."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4291eacb-c414-4aaf-933c-b79336ba253d",
                                                "sense_id": "d6fd2cb7-b312-32fa-bb6d-561d32f96c97",
                                                "text": "As a goat he [Dionysus] can hardly be separated from the minor divinities, the Pans, Satyrs, and Silenuses, all of whom are closely associated with him and are represented more or less completely in the form of goats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ec634eb-efba-4a57-b7ee-63f36483e59d",
                        "source_entry_id": "c962cd2e-6c29-3af9-a1ed-f9d394b1209b",
                        "source_sense_id": "91f9e900-a950-3771-9a12-a4599ae85ab5",
                        "source_sense_description": "griechische Mythologie: Dämon mit tierischen Körperteilen im Gefolge des Dionysos",
                        "target_lang_word": "Silène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1e7823-7db2-3a99-b0a4-2deea83db345",
                                        "entry_id": "dbdd5671-07e8-319e-a3b8-ea7608783a42",
                                        "glosses": [
                                            "Demi-dieu phrygien, père nourricier de Dionysos et ancêtre des silènes."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4236051-965c-41df-b4dc-b89509949ace",
                                                "sense_id": "9b1e7823-7db2-3a99-b0a4-2deea83db345",
                                                "text": "On attribuait à Silène l’invention de la flûte."
                                            },
                                            {
                                                "example_id": "b9ad1ca5-abad-40e1-8f9c-81fa701420ba",
                                                "sense_id": "9b1e7823-7db2-3a99-b0a4-2deea83db345",
                                                "text": "Je me rappelle une comédie où un valet intelligent trouve le moyen de mettre à la porte de chez son maître trois coquins ivres comme Silène."
                                            },
                                            {
                                                "example_id": "cc256a37-2231-4503-ba5f-368544805c94",
                                                "sense_id": "9b1e7823-7db2-3a99-b0a4-2deea83db345",
                                                "text": "M. Bergeret, parvenu au premier étage, où logeait ce M. Raynaud, propriétaire de terrains situés dans le quartier de la nouvelle gare, regarda, selon sa coutume, le bas-relief qui surmontait la porte. On y voyait le vieux Silène sur son âne parmi des nymphes."
                                            }
                                        ]
                                    }
                                ]
