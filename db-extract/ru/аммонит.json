                                        "entry_id": "a2d5fc9d-436b-3804-8695-186dab68bc87",
                                        "glosses": [
                                            "kopalny głowonóg z podgromady Ammonoidea, amonitowatych o płaskiej spiralnej skorupie o średnicy od 1 cm do 3 m, żyjący w okresie od dewonu do kredy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e1258e3-5e67-4479-b8f5-5171f3a07dcb",
                                                "sense_id": "3b592703-9597-30cb-9b69-d436dc06f6c4",
                                                "text": "W wapienną ścianę domu wkomponowano kilka zastygłych amonitów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
