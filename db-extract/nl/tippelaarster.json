                    {
                        "sense_id": "2a5b1ac5-3109-30b4-a032-aae5c6a5d26b",
                        "entry_id": "6348cd3a-df40-3ab9-9472-eabbdee52df4",
                        "glosses": [
                            "prostituee die haar diensten aanbiedt op straat"
