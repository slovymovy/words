                "entry_id": "19597606-8081-363e-80f9-09ed19e15632",
                "word": "keylogger",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ca0a1a71-d7eb-4580-827b-0541d43cc417",
