                "senses": [
                    {
                        "sense_id": "d122d0a8-c06c-3c93-8163-df9c4cb4ac62",
                        "entry_id": "f896799b-eae8-38bc-b3b9-18eb470eca9d",
                        "glosses": [
                            "A practitioner of ayurvedic medicine."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "8cee7280-4688-4597-b40f-393b06712221",
                                "sense_id": "d122d0a8-c06c-3c93-8163-df9c4cb4ac62",
                                "text": "Like the sannyāsī, the religious ascetic, moreover, the vaidya did not adhere rigidly to the stringent rules of ritual purity which regulated the lives of the ordinary members of the higher classes."
                            },
                            {
                                "example_id": "464d34d9-68ca-4e41-ad9d-e4ad6a851566",
                                "sense_id": "d122d0a8-c06c-3c93-8163-df9c4cb4ac62",
                                "text": "‘You lie down quietly and I'll run and tell the vaidya that it's nothing but a thorn in your foot.’"
                            },
                            {
                                "example_id": "2c87e7a3-2efb-4649-b434-b8adc43294c9",
                                "sense_id": "d122d0a8-c06c-3c93-8163-df9c4cb4ac62",
                                "text": "If a prescribed sēva such as the feeding of Brahmans or the poor was not carried out by a patient, then the vaidya considered himself likely to be affected by the patient's karma."
                            }
                        ]
                    }
                ],
