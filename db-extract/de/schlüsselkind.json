                ],
                "senses": [
                    {
                        "sense_id": "9a33a226-33bb-3606-93e0-bd9c96a3754f",
                        "entry_id": "e34c9834-4386-3e62-875e-3e30a926cda9",
                        "glosses": [
                            "Kind, das den Tag nach der Schule alleine zu Hause verbringt, da beide Elternteile berufstätig sind, und daher den Hausschlüssel bei sich trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "138fddb3-5897-4fe0-b032-f629cefd10fb",
                                "sense_id": "9a33a226-33bb-3606-93e0-bd9c96a3754f",
                                "text": "Ein Problem bei den Schlüsselkindern kann man darin sehen, dass sie sich zu lange allein überlassen sind."
                            },
                            {
                                "example_id": "e24dee7f-758b-42e7-8884-63af4bfc503c",
                                "sense_id": "9a33a226-33bb-3606-93e0-bd9c96a3754f",
                                "text": "„Ab meinem zehnten Lebensjahr ging meine Mutter arbeiten, dadurch war ich oft nachmittags ein ‚Schlüsselkind‘.“"
                            },
                            {
                                "example_id": "8328e85c-d637-4d07-a54e-fbd65a8865a0",
                                "sense_id": "9a33a226-33bb-3606-93e0-bd9c96a3754f",
                                "text": "„In Hannover war ich tagsüber Schlüsselkind und durfte machen, was ich wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
