                    {
                        "sense_id": "f2943950-cbca-367b-9416-7fccc733ad31",
                        "entry_id": "d2d95445-2e9a-35c1-813e-d7da5a217902",
                        "glosses": [
                            "A Nordic country having borders with Sweden, Norway and Russia in Europe. Official name: Republic of Finland."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d5629b4d-04a6-40e1-8da3-1b7718cd5688",
                                "sense_id": "f2943950-cbca-367b-9416-7fccc733ad31",
                                "text": "Over the following decades, the EEC became the European Union, and expanded from the original six nations to today’s 27 members, from Finland in the north to Malta in the south."
                            },
                            {
                                "example_id": "6e10ee2b-f548-4098-bb8f-e5c58ee362a6",
                                "sense_id": "f2943950-cbca-367b-9416-7fccc733ad31",
                                "text": "And so far just two member states, Malta and Finland, are on track to meet their resettling obligations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea6e156d-ec87-4f05-988c-543d3a923912",
                        "source_entry_id": "d2d95445-2e9a-35c1-813e-d7da5a217902",
