                "senses": [
                    {
                        "sense_id": "86622549-e6ad-32cf-959b-fbbb1dd757ff",
                        "entry_id": "e3353b68-a892-36ca-b689-f73acd7451ad",
                        "glosses": [
                            "Stern mit extrem großem Durchmesser und extrem großer Leuchtkraft, der bei gleicher Oberflächentemperatur innerhalb des Hertzsprung-Russell-Diagramms (HRD) deutlich oberhalb der Hauptreihe liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73caa537-77a7-4e8f-b017-6771774c43f0",
                                "sense_id": "86622549-e6ad-32cf-959b-fbbb1dd757ff",
                                "text": "„Gelbe Riesensterne strahlen ihr Licht vor allem im sichtbaren Bereich und erscheinen aufgrund ihrer Oberflächentemperaturen gelblich bzw. gelbweiß.“"
                            },
                            {
                                "example_id": "abf6a73c-1e8b-4c99-be30-2727a38f5a47",
                                "sense_id": "86622549-e6ad-32cf-959b-fbbb1dd757ff",
                                "text": "„Es sind Doppelsterne, die sich in engem Abstand umkreisen, wobei einer der Sterne sein Endstadium erreicht und sich zum Riesenstern aufgebläht hat. Das Gas aus der Hülle des Riesensterns strömt auf den Begleitstern über.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
