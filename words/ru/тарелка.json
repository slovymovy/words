{
    "word_family": [
        "тарелочный",
        "тарелочка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cfc3a35c-86f5-31eb-be93-4b25299a9374",
                    "sense_definition": "Столовая посуда круглой формы с приподнятыми краями, используемая для еды.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама поставила на стол глубокую <w>тарелку</w> с горячим супом.",
                            "target_lang_translations": {
                                "en": "Mom put a deep <w>bowl</w> of hot soup on the table."
                            }
                        },
                        {
                            "text": "После вкусного ужина он помог помыть грязные <w>тарелки</w> и чашки.",
                            "target_lang_translations": {
                                "en": "After a delicious dinner, he helped wash the dirty <w>plates</w> and cups."
                            }
                        }
                    ],
                    "synonyms": [
                        "блюдо"
                    ],
                    "common_phrases": [
                        "глубокая тарелка",
                        "мыть тарелки",
                        "не в своей тарелке"
                    ],
                    "target_lang_definitions": {
                        "en": "A round tableware item with raised edges, used for holding or eating food."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plate",
                                "target_lang_sense_clarification": "flat or shallow tableware item"
                            },
                            {
                                "target_lang_word": "dish",
                                "target_lang_sense_clarification": "tableware piece for eating or serving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a63be19-6c8b-38a3-9948-6cfe22a45b40",
                    "sense_definition": "Ударный музыкальный инструмент в виде металлического диска выпуклой формы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Музыкант в оркестре громко ударил в медные <w>тарелки</w> перед финальной частью симфонии.",
                            "target_lang_translations": {
                                "en": "The musician in the orchestra crashed the brass <w>cymbals</w> loudly before the final part of the symphony."
                            }
                        },
                        {
                            "text": "Барабанщик купил новые <w>тарелки</w> для своей ударной установки.",
                            "target_lang_translations": {
                                "en": "The drummer bought new <w>cymbals</w> for his drum kit."
                            }
                        }
                    ],
                    "common_phrases": [
                        "медные тарелки"
                    ],
                    "target_lang_definitions": {
                        "en": "A percussion musical instrument consisting of a slightly convex metal disc."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cymbals",
                                "target_lang_sense_clarification": "percussion instrument (usually plural)"
                            },
                            {
                                "target_lang_word": "cymbal",
                                "target_lang_sense_clarification": "single percussion disc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f08f4aac-699b-385e-9434-5108f70fad31",
                    "sense_definition": "Параболическая антенна округлой формы, принимающая спутниковый сигнал.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На крыше нового дома установили большую спутниковую <w>тарелку</w> для телевидения.",
                            "target_lang_translations": {
                                "en": "A large satellite <w>dish</w> for television was installed on the roof of the new building."
                            }
                        },
                        {
                            "text": "Из-за сильного ветра белая <w>тарелка</w> на стене немного сместилась и потеряла сигнал.",
                            "target_lang_translations": {
                                "en": "Because of strong winds, the white <w>dish</w> on the wall shifted slightly and lost its signal."
                            }
                        }
                    ],
                    "common_phrases": [
                        "спутниковая тарелка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное обозначение антенны"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A round parabolic antenna used for receiving satellite signals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dish",
                                "target_lang_sense_clarification": "satellite or radar antenna"
                            },
                            {
                                "target_lang_word": "satellite dish",
                                "target_lang_sense_clarification": "parabolic antenna for television or data"
                            },
                            {
                                "target_lang_word": "dish aerial",
                                "target_lang_sense_clarification": "parabolic reflector aerial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0f2a96-af36-3ac9-8c46-fc30d916daa2",
                    "sense_definition": "Неопознанный летающий объект дискообразной формы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scifi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В фантастическом фильме пришельцы высадились на Землю в огромной летающей <w>тарелке</w>.",
                            "target_lang_translations": {
                                "en": "In the science fiction film, aliens landed on Earth in a huge flying <w>saucer</w>."
                            }
                        },
                        {
                            "text": "Многие люди утверждали, что видели серебристую <w>тарелку</w> над ночным лесом.",
                            "target_lang_translations": {
                                "en": "Many people claimed to have seen a silvery <w>saucer</w> over the night forest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "летающая тарелка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "в значении летающей тарелки"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A disc-shaped unidentified flying object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flying saucer",
                                "target_lang_sense_clarification": "disc-shaped UFO"
                            },
                            {
                                "target_lang_word": "saucer",
                                "target_lang_sense_clarification": "short for flying saucer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dc0861d-b563-3430-b36e-f4d2526cf95f",
                    "sense_definition": "Деталь механизма или прибора в виде круглого диска.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Металлическая <w>тарелка</w> клапана была сильно изношена из-за долгой работы двигателя.",
                            "target_lang_translations": {
                                "en": "The metal valve <w>disc</w> was heavily worn due to prolonged engine operation."
                            }
                        },
                        {
                            "text": "Инженер тщательно проверил крепление стальной <w>тарелки</w> железнодорожного буфера.",
                            "target_lang_translations": {
                                "en": "The engineer carefully checked the mounting of the railway buffer's steel <w>faceplate</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "тарелка буфера",
                        "тарелка клапана"
                    ],
                    "target_lang_definitions": {
                        "en": "A mechanical component shaped like a flat circular disc or head."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plate",
                                "target_lang_sense_clarification": "circular disc component or buffer plate"
                            },
                            {
                                "target_lang_word": "disc",
                                "target_lang_sense_clarification": "circular flat mechanism part"
                            },
                            {
                                "target_lang_word": "valve head",
                                "target_lang_sense_clarification": "poppet valve disc"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0412dba2-e6bc-321f-9fbe-08a689e38df6",
                    "sense_definition": "Старинный настенный громкоговоритель в форме круглого конуса или диска.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "radio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чёрная <w>тарелка</w> репродуктора передавала важные военные сводки на всю улицу.",
                            "target_lang_translations": {
                                "en": "The black loudspeaker <w>dish</w> broadcast important military dispatches across the whole street."
                            }
                        },
                        {
                            "text": "В углу комнаты висела старая <w>тарелка</w>, из которой доносились звуки радиопередачи.",
                            "target_lang_translations": {
                                "en": "An old radio <w>speaker</w> hung in the corner of the room, broadcasting the sounds of a radio show."
                            }
                        }
                    ],
                    "common_phrases": [
                        "тарелка репродуктора"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное обозначение радиорепродуктора"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "историческая реалия"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An early vintage wall-mounted loudspeaker shaped like a conical disc."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cone loudspeaker",
                                "target_lang_sense_clarification": "early disc-shaped wall radio loudspeaker"
                            },
                            {
                                "target_lang_word": "dish loudspeaker",
                                "target_lang_sense_clarification": "vintage conical wall speaker"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fca5b7a-a350-38c1-a1ba-904e4dc08432",
                    "sense_definition": "Круглая щитковидная гарда эфеса холодного оружия, защищающая кисть руки.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Шпага с широкой стальной <w>тарелкой</w> надёжно защищала пальцы фехтовальщика от ударов.",
                            "target_lang_translations": {
                                "en": "The rapier with a wide steel <w>dish-hilt</w> reliably protected the fencer's fingers from blows."
                            }
                        },
                        {
                            "text": "Оружейник тщательно отполировал фигурную <w>тарелку</w> старинного фламандского эфеса.",
                            "target_lang_translations": {
                                "en": "The armorer meticulously polished the ornate <w>cup guard</w> of the antique Flemish hilt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "исторический термин оружия"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A round, dish-shaped guard on the hilt of a bladed weapon that protects the wielder's hand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dish-hilt",
                                "target_lang_sense_clarification": "round cup-like sword guard"
                            },
                            {
                                "target_lang_word": "cup guard",
                                "target_lang_sense_clarification": "circular guard on a rapier or sword hilt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}