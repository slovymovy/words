                ],
                "senses": [
                    {
                        "sense_id": "e2642ac4-31e9-3bab-8ab6-ba809cac2f1b",
                        "entry_id": "74943c11-a497-38dc-bffd-c9bd351df8d8",
                        "glosses": [
                            "ou Nourriture."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "16a73e8a-797e-4847-8a39-fdaf75e90dfe",
                                "sense_id": "e2642ac4-31e9-3bab-8ab6-ba809cac2f1b",
                                "text": "Question bectance, c'était le paradis."
                            },
                            {
                                "example_id": "69415ff8-cee5-4f25-8b9e-2d9281376166",
                                "sense_id": "e2642ac4-31e9-3bab-8ab6-ba809cac2f1b",
                                "text": "— Certes, le chemin fut long… mais rien que les viennoiseries parisiennes valaient cette peine !\n — Hormis votre passion pour la bectance… vous avez quoi à m’apprendre ?!"
                            },
                            {
                                "example_id": "39d4ec77-3b85-41bc-9379-48878192f2ba",
                                "sense_id": "e2642ac4-31e9-3bab-8ab6-ba809cac2f1b",
                                "text": "À part cela, tout va bien. De la bectance, j’en ai même souvent trop. Je fais des heureux autour de moi. Faut voir à s’entraider."
                            }
                        ]
                    }
                ],
