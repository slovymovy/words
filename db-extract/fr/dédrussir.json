                "senses": [
                    {
                        "sense_id": "74b626a8-ad7e-3555-bc5e-b6d18c71f83c",
                        "entry_id": "926cd69e-2192-3a07-8001-648b7d71bb2b",
                        "glosses": [
                            "(Champagne-Picardie) Éclaircir, desserrer, rendre moins dru."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "bf53ded1-4441-4a44-aa2c-faa8f7500ed5",
                                "sense_id": "74b626a8-ad7e-3555-bc5e-b6d18c71f83c",
                                "text": "Avec eux, j’apprends à biner les pommes de terre, sarcler entre les rangées de carottes, dédrussir les plants de salades, cueillir et écosser les haricots ou les petits pois."
                            },
                            {
                                "example_id": "5a2212c8-ea8b-4275-8438-39f6e57fc20c",
                                "sense_id": "74b626a8-ad7e-3555-bc5e-b6d18c71f83c",
                                "text": "Pourtant, récolter les premiers radis avait été facile. Dédrussir les salades un peu moins."
                            }
                        ]
                    }
