                "senses": [
                    {
                        "sense_id": "59a74279-162e-36e2-9adb-23b5dd00ed0d",
                        "entry_id": "d9365777-9bbd-3c75-b203-25b81d33dee9",
                        "glosses": [
                            "lufttechnische Brandschutzvorrichtung zum Schließen einer Kanalöffnung in der feuerbeständigen Brandschutzwand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1134c1ce-f83c-49fd-a4cc-ced16419591b",
                                "sense_id": "59a74279-162e-36e2-9adb-23b5dd00ed0d",
                                "text": "„Brandschutzklappen sind Absperrvorrichtungen gegen Brandübertragung in Lüftungsleitungen und dazu bestimmt, allein oder in Verbindung mit anderen Bauteilen (z.B. Auslöseeinrichtungen) die Übertragung von Feuer oder Rauch durch Lüftungsleitungen zu verhindern“"
                            },
                            {
                                "example_id": "98c18b0a-72ce-4bb1-a071-dc197100d78e",
                                "sense_id": "59a74279-162e-36e2-9adb-23b5dd00ed0d",
                                "text": "„Brandschutzklappen und Brandschutzventile verhindern die Übertragung von Feuer und Rauch in Lüftungsleitungen“"
                            },
                            {
                                "example_id": "34728355-b0cb-4809-8a55-8b64c5e23c09",
                                "sense_id": "59a74279-162e-36e2-9adb-23b5dd00ed0d",
                                "text": "„FK90 Brandschutzklappen für gewerbliche Küchen erfüllen die Anforderungen für 90 Minuten Feuerwiderstandsdauer und entsprechen dem europäischen Stand der Technik nach EN 1366-2., Baureihe FK92.“"
                            },
                            {
                                "example_id": "4e541410-a44c-44c6-a796-60d7fce5aa39",
                                "sense_id": "59a74279-162e-36e2-9adb-23b5dd00ed0d",
                                "text": "„Eine Rauchausbreitung über die Lüftungs- und Klimaanlagen lässt sich effektiv nur mit motorisierten Brandschutzklappen in Verbindung mit Rauchmeldeauslösungen (Rauchmelder Typ RMS oder RSA) verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
