                        "form": "sie sind selbstinduziert"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                        "entry_id": "851e4303-b163-3ff9-baf8-1e1a630e2fc7",
                        "glosses": [
                            "selbst verursacht, selbst herbeigeführt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "8353a872-20da-4070-9bc4-434a34c32e03",
                                "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                                "text": "„Anorexia nervosa ist durch selbstinduziertes Untergewicht, extreme Angst vor Gewichtszunahme und eine verzerrte Körperwahrnehmung gekennzeichnet.“"
                            },
                            {
                                "example_id": "5b78b423-0daa-42f5-8347-ed2131ab9c1e",
                                "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                                "text": "„Die Behandlung der Haut mit dem Enpitsu Derma Pen führt zu einer selbstinduzierten entzündlichen Reaktion, die zu einer Regeneration der Epidermis führt.“"
                            },
                            {
                                "example_id": "57711ec8-67ba-4ad3-9971-e256561a4065",
                                "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                                "text": "„Auch können selbstinduzierte Diäten unter Umständen ein gestörtes Essverhalten nach sich ziehen, so dass von pauschalen Diäten ausdrücklich gewarnt werden muss.“"
                            },
                            {
                                "example_id": "75909ffa-c3a3-4fdb-8da4-5d86e2bc876b",
                                "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                                "text": "„Mein Körper reagiert hier ganz sensibel sowohl auf äußere als auch auf selbstinduzierte Stress-Situationen.“"
                            },
                            {
                                "example_id": "7661f0c3-0975-47e9-9e26-a90fc47c1b34",
                                "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                                "text": "„In gewisser Weise ist der Begriff Selbsthypnose überflüssig, da in der Tat jede Hypnose selbstinduziert ist.“"
                            },
                            {
                                "example_id": "855a1f76-cb35-4498-b04f-7509b889a4ae",
                                "sense_id": "43ef9ad0-235a-3535-afea-6a1cd1c80d44",
                                "text": "„Rezidivierende (selbstinduzierte) Mischintoxikationen mit Medikamenten (wie von dem behandelnden Nervenarzt K. beschrieben) könnten über kreislauf-deprimierende Effekte ebenfalls ursächlich zu den“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
