{
    "word_family": [
        "rivalry",
        "unrivaled",
        "unrivalled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1835233-f27e-3df1-a008-9c4202e34b8e",
                    "sense_definition": "A person, team, or organization competing with another for the same objective or for superiority in the same field.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chris is my biggest <w>rival</w> in the 400-metre race.",
                            "target_lang_translations": {
                                "ru": "Крис — мой главный <w>соперник</w> в забеге на 400 метров.",
                                "zh": "克里斯是我在400米赛跑中最大的<w>对手</w>。"
                            }
                        },
                        {
                            "text": "The company is working hard to stay ahead of its main <w>rival</w>.",
                            "target_lang_translations": {
                                "ru": "Компания усердно работает, чтобы опережать своего главного <w>конкурента</w>.",
                                "zh": "这家公司正努力保持领先，以超越其主要<w>竞争者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "competitor",
                        "opponent",
                        "adversary",
                        "contender",
                        "challenger"
                    ],
                    "antonyms": [
                        "ally",
                        "partner",
                        "teammate"
                    ],
                    "common_phrases": [
                        "bitter rival",
                        "arch rival",
                        "main rival",
                        "defeat a rival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, команда или организация, конкурирующие с другими за одну и ту же цель или за превосходство в одной области.",
                        "zh": "指为了同一个目标或在同一领域争夺优势而进行竞争的人、团队或组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперник",
                                "target_lang_sense_clarification": "общий термин для спорта, любви, достижений"
                            },
                            {
                                "target_lang_word": "конкурент",
                                "target_lang_sense_clarification": "в бизнесе или коммерции"
                            },
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "в спорте или конфликте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "对手",
                                "target_lang_sense_clarification": "通用的竞争者，适用于体育、竞赛或冲突"
                            },
                            {
                                "target_lang_word": "竞争者",
                                "target_lang_sense_clarification": "侧重于商业或市场竞争"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "694c054a-2854-3bb9-b1c3-16535fc745dd",
                    "sense_definition": "A person or thing that equals another in quality, skill, or distinction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a social historian, the professor has no <w>rival</w>.",
                            "target_lang_translations": {
                                "ru": "Как социальный историк, профессор не имеет <w>соперников</w>.",
                                "zh": "作为一名社会历史学家，这位教授没有<w>匹敌者</w>。"
                            }
                        },
                        {
                            "text": "This vintage wine has few <w>rivals</w> when it comes to flavor.",
                            "target_lang_translations": {
                                "ru": "У этого марочного вина мало <w>соперников</w>, когда речь идет о вкусе.",
                                "zh": "论口感，这款陈年葡萄酒几乎没有<w>对手</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "equal",
                        "match",
                        "peer"
                    ],
                    "common_phrases": [
                        "without rival",
                        "have no rival"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, не уступающие другому по качеству, мастерству или значимости.",
                        "zh": "在质量、技能或地位上与他人不相上下的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперник",
                                "target_lang_sense_clarification": "тот, кто равен по силе или качеству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "匹敌者",
                                "target_lang_sense_clarification": "指在能力或水平上相当的人或物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a997d8a4-04c2-348a-a6c7-798f848d4f05",
                    "sense_definition": "One having a common right or privilege with another; a partner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He greeted the <w>rivals</w> of his watch with a solemn nod.",
                            "target_lang_translations": {
                                "ru": "Он приветствовал <w>напарников</w> по страже торжественным кивком.",
                                "zh": "他向他的守卫<w>同伴</w>庄重地点了点头。"
                            }
                        },
                        {
                            "text": "The ancient text speaks of <w>rivals</w> who shared the duty of guarding the gate.",
                            "target_lang_translations": {
                                "ru": "Древний текст говорит о <w>сотоварищах</w>, которые разделяли долг охраны ворот.",
                                "zh": "古籍中提到了共同分担守门职责的<w>同伴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "partner",
                        "associate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts or literature like Shakespeare."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто имеет общие права или привилегии с другим; партнер (устаревшее).",
                        "zh": "与他人享有共同权利或特权的人；伙伴（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотоварищ",
                                "target_lang_sense_clarification": "устар.: имеющий равное с другим право; компаньон"
                            },
                            {
                                "target_lang_word": "напарник"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同伴",
                                "target_lang_sense_clarification": "指共同承担职责或享有权利的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bf60591-0198-3db0-9fe9-7f2f3d4aee0a",
                    "sense_definition": "To be as good as, equal to, or comparable with another in quality or amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the hotel room <w>rivals</w> any landscape in the world.",
                            "target_lang_translations": {
                                "ru": "Вид из гостиничного номера <w>соперничает</w> с любым пейзажем в мире.",
                                "zh": "酒店房间外的景色足以与世界上任何风景<w>媲美</w>。"
                            }
                        },
                        {
                            "text": "Her singing voice <w>rivals</w> that of a professional opera star.",
                            "target_lang_translations": {
                                "ru": "Ее певческий голос <w>соперничает</w> с голосом профессиональной оперной звезды.",
                                "zh": "她的歌声足以与专业歌剧明星<w>媲美</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "match",
                        "equal",
                        "parallel"
                    ],
                    "common_phrases": [
                        "rival the best",
                        "rival in beauty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть таким же хорошим, равным или сопоставимым с другим по качеству или количеству.",
                        "zh": "在质量或数量上与某物相当、相等或可比。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперничать",
                                "target_lang_sense_clarification": "быть равным по достоинству"
                            },
                            {
                                "target_lang_word": "сравниться",
                                "target_lang_sense_clarification": "быть сопоставимым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "媲美",
                                "target_lang_sense_clarification": "指美好程度相当，常用于赞美"
                            },
                            {
                                "target_lang_word": "比得上",
                                "target_lang_sense_clarification": "指在水平或质量上达到同一高度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f62a0f-f419-3753-9535-31929c2d3253",
                    "sense_definition": "To oppose or compete with someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers <w>rival</w> each other for their father's approval.",
                            "target_lang_translations": {
                                "ru": "Два брата <w>соперничают</w> друг с другом за одобрение отца.",
                                "zh": "两兄弟为了得到父亲的认可而互相<w>竞争</w>。"
                            }
                        },
                        {
                            "text": "Few athletes can <w>rival</w> him in speed and endurance.",
                            "target_lang_translations": {
                                "ru": "Немногие спортсмены могут <w>соперничать</w> с ним в скорости и выносливости.",
                                "zh": "在速度和耐力方面，很少有运动员能与他<w>抗衡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compete with",
                        "oppose",
                        "contend with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Противостоять или соревноваться с кем-то или чем-то.",
                        "zh": "与某人或某事进行对抗或竞争。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперничать",
                                "target_lang_sense_clarification": "состязаться в чем-либо"
                            },
                            {
                                "target_lang_word": "конкурировать",
                                "target_lang_sense_clarification": "бороться за преимущество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竞争",
                                "target_lang_sense_clarification": "为了达到目的而进行的较量"
                            },
                            {
                                "target_lang_word": "抗衡",
                                "target_lang_sense_clarification": "指力量相当的对抗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53a9eed2-52a5-3a69-bcf5-842e1b608095",
                    "sense_definition": "To strive to equal or excel; to emulate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_equality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young artist tries to <w>rival</w> the masters of the Renaissance.",
                            "target_lang_translations": {
                                "ru": "Молодой художник пытается <w>соперничать</w> с мастерами эпохи Возрождения.",
                                "zh": "这位年轻艺术家试图<w>追赶</w>文艺复兴时期的大师们。"
                            }
                        },
                        {
                            "text": "The noise of the engine seemed to <w>rival</w> thunder in its intensity.",
                            "target_lang_translations": {
                                "ru": "Шум двигателя, казалось, <w>соперничал</w> с громом по своей интенсивности.",
                                "zh": "引擎的轰鸣声在强度上似乎足以与雷声<w>争胜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emulate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремиться сравняться или превзойти; подражать с целью превзойти.",
                        "zh": "努力达到与他人同等的水平或超越他人；效仿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперничать",
                                "target_lang_sense_clarification": "стараться не уступать или превзойти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追赶",
                                "target_lang_sense_clarification": "努力达到前者的水平"
                            },
                            {
                                "target_lang_word": "争胜",
                                "target_lang_sense_clarification": "力求在竞争中胜出"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9518145d-37fd-319e-bdfc-8bfde5a67ef7",
                    "sense_definition": "Standing in competition for superiority or having the same claims.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rival</w> teams met on the field for the final match of the season.",
                            "target_lang_translations": {
                                "ru": "<w>Соперничающие</w> команды встретились на поле для финального матча сезона.",
                                "zh": "<w>竞争的</w>两支队伍在赛场上会师，进行本赛季的最后一场比赛。"
                            }
                        },
                        {
                            "text": "Two <w>rival</w> companies are fighting for the largest market share.",
                            "target_lang_translations": {
                                "ru": "Две <w>конкурирующие</w> компании борются за самую большую долю рынка.",
                                "zh": "两家<w>竞争的</w>公司正在争夺最大的市场份额。"
                            }
                        }
                    ],
                    "synonyms": [
                        "competing",
                        "opposing"
                    ],
                    "common_phrases": [
                        "rival gangs",
                        "rival factions",
                        "rival firm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревнующийся за превосходство или имеющий одинаковые притязания.",
                        "zh": "处于竞争状态以争夺优势，或拥有相同的主张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкурирующий",
                                "target_lang_sense_clarification": "о компаниях, фирмах"
                            },
                            {
                                "target_lang_word": "соперничающий",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竞争的",
                                "target_lang_sense_clarification": "形容处于竞争关系中的"
                            },
                            {
                                "target_lang_word": "敌对的",
                                "target_lang_sense_clarification": "形容处于对立面或竞争中的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}