                        "examples": [
                            {
                                "example_id": "69d9e8cd-d240-4cbd-b5db-2c978b24363e",
                                "sense_id": "4247677e-0633-31d8-9fd5-05b12a40da10",
                                "text": "HET DUURSTE papier, onbetaalbaar ballonlinnen en de beste ontwerper. Bij de uitvoering van zijn luxe-reeksen keek uitgever G.A. van Oorschot niet op een paar centen, hoewel hij toch de reputatie had in menig opzicht een krentenweger te zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "15165964-d306-3c7b-b88b-7d1100957e99",
                        "entry_id": "19e53979-4308-3d73-b7d3-5b3e34e7ffc4",
                        "glosses": [
                            "kille rekenaar"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "fc8a31d7-b72c-4e2e-bf7f-c09e3b53aecb",
                                "sense_id": "15165964-d306-3c7b-b88b-7d1100957e99",
                                "text": "„Ik vind het leven veel rijker en complexer dan mijn verzinsels. Ik wil drama niet uitvergroten, maar juist al het vet van het vlees snijden. Zeelieden als martelaars, piraten als beesten, de CEO als een kille krentenweger: dat is toch oninteressant? Als filmmaker voel ik me een dwerg op de schouders van Ken Loach en de gebroeders Dardenne.”"
                            }
                        ]
                    },
