                    "sense_id": "6ebc3b9a-8652-3062-8b96-6c0d957e8649",
                    "sense_definition": "Qui arrive de façon imprévue et très rapide ; subit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soudain_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son départ <w>soudain</w> a surpris l'ensemble de ses collègues au bureau.",
                            "target_lang_translations": {
                                "en": "His <w>sudden</w> departure surprised all of his colleagues at the office.",
                                "ru": "Его <w>внезапный</w> уход удивил всех коллег в офисе.",
                                "nl": "Zijn <w>plotselinge</w> vertrek verraste al zijn collega's op kantoor.",
                                "de": "Sein <w>plötzlicher</w> Weggang hat alle seine Kollegen im Büro überrascht.",
                                "pl": "Jego <w>nagłe</w> odejście zaskoczyło wszystkich kolegów z biura.",
                                "it": "La sua partenza <w>improvvisa</w> ha sorpreso tutti i colleghi in ufficio.",
                                "cs": "Jeho <w>náhlý</w> odchod překvapil všechny spolupracovníky v kanceláři.",
                                "tr": "Onun <w>ani</w> ayrılışı ofisteki bütün meslektaşlarını şaşırttı.",
                                "es": "Su <w>repentina</w> marcha sorprendió a todos sus compañeros de oficina.",
                                "zh": "他的离职很<w>突然</w>，让办公室里的同事们都吃了一惊。"
                            }
                        },
                        {
                            "text": "Une <w>soudaine</w> baisse de température a surpris les habitants de la région.",
                            "target_lang_translations": {
                                "en": "A <w>sudden</w> drop in temperature surprised the residents of the region.",
                                "ru": "<w>Внезапное</w> понижение температуры застало врасплох жителей региона.",
                                "nl": "Een <w>plotselinge</w> daling van de temperatuur verraste de bewoners van de regio.",
                                "de": "Ein <w>plötzlicher</w> Temperatursturz überraschte die Bewohner der Region.",
                                "pl": "<w>Nagły</w> spadek temperatury zaskoczył mieszkańców regionu.",
                                "it": "Un <w>improvviso</w> calo della temperatura ha sorpreso gli abitanti della regione.",
                                "cs": "<w>Náhlý</w> pokles teploty překvapil obyvatele regionu.",
                                "tr": "<w>Ani</w> bir sıcaklık düşüşü bölge sakinlerini şaşırttı.",
                                "es": "Una <w>repentina</w> bajada de temperatura sorprendió a los habitantes de la región.",
                                "zh": "一次<w>突然</w>的气温下降让该地区的居民感到十分意外。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subit"
                    ],
                    "common_phrases": [
                        "changement soudain",
                        "mort soudaine"
                    ],
                    "target_lang_definitions": {
                        "en": "Happening unexpectedly and very quickly; abrupt.",
                        "ru": "Наступает неожиданно и очень быстро, без подготовки.",
                        "nl": "Dat onverwacht en heel snel optreedt, zonder voorbereiding.",
                        "de": "Unerwartet und sehr schnell eintretend, ohne Vorbereitung.",
                        "pl": "Taki, który przychodzi niespodziewanie i bardzo szybko, bez przygotowania.",
                        "it": "Che avviene in modo imprevisto e molto rapido, senza preavviso.",
                        "cs": "Nastává nečekaně a velmi rychle, bez přípravy nebo varování.",
                        "tr": "Beklenmedik biçimde ve çok çabuk ortaya çıkan.",
                        "es": "Que llega de forma imprevista y muy rápida, sin preparación ni aviso. Se aplica a cambios, sucesos o enfermedades.",
                        "zh": "来得出乎意料且非常迅速，事先毫无准备。"
                    },
