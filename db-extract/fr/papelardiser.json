                "senses": [
                    {
                        "sense_id": "e771daf6-ab47-3c2f-8837-c71757da3fdd",
                        "entry_id": "42072515-f0b6-30f5-b860-00c1a488b22d",
                        "glosses": [
                            "Donner un caractère papelard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9810e91-dffe-43b3-9a0c-6cdcd8563a2f",
                                "sense_id": "e771daf6-ab47-3c2f-8837-c71757da3fdd",
                                "text": "Jacques Sarthou jouait sur un ton de froide assurance le suspect n°l et Marguerite Guéreau papelardisait à merveille le rôle de la bonne vieille dame à qui l'on aurait eu tort de se fier."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9958578-5e3b-32ab-afbb-6bd144e1c1f2",
                        "entry_id": "42072515-f0b6-30f5-b860-00c1a488b22d",
                        "glosses": [
                            "Se montrer papelard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb301cf4-fbdc-4fac-946d-28e0807c873a",
                                "sense_id": "b9958578-5e3b-32ab-afbb-6bd144e1c1f2",
                                "text": "va t'instruire au lieu de papelardiser!!!"
                            },
                            {
                                "example_id": "2c259592-b84d-4cda-aef0-aaf033c15360",
                                "sense_id": "b9958578-5e3b-32ab-afbb-6bd144e1c1f2",
                                "text": "Tout ceci estrancinait les gens du parti God and My Right, de Jesuslands — c’est ainsi qu’on nommait la nouvelle Amérique — papelardisant sur les misères que l'on faisait à Deubeulyou, et pestant de se voir ainsi tourner en bourriques, au travers de leur champion."
                            }
                        ]
                    }
