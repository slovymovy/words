                                "target_senses": [
                                    {
                                        "sense_id": "547ec571-8810-3895-8c1a-8acd06489c6e",
                                        "entry_id": "13091201-4791-395c-b006-781c80462c30",
                                        "glosses": [
                                            "An advocate or helper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643992a9-3396-4a5f-aa9c-30497aed2a88",
                                                "sense_id": "547ec571-8810-3895-8c1a-8acd06489c6e",
                                                "text": "He passed a block of bright posters. One of them extolled domestic gas: a smiling toy paraclete called Mr Therm presided over a sort of warm Holy Family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84652eda-5255-359d-81d1-7057773a5e5c",
                                        "entry_id": "13091201-4791-395c-b006-781c80462c30",
                                        "glosses": [
                                            "Alternative letter-case form of Paraclete, the Holy Spirit or Holy Ghost."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da7228cc-c1dd-4b94-83ad-4aa2c717d02e",
                        "source_entry_id": "e1e49e6c-150b-3ff8-8489-72d6b0507b9e",
                        "target_lang_word": "Paraklet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraklet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                                        "entry_id": "a9e0f03e-c78d-3fc3-a167-7887f2f9eb67",
                                        "glosses": [
                                            "mehrfach im Johannes-Evangelium verwendeter Begriff, der in der christlichen Theologie gewöhnlich mit dem Heiligen Geist identifiziert wird"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9682a2-82ff-4275-bbf0-1c27db657261",
                                                "sense_id": "71addc7e-bc66-3e3a-8eb4-b537ca66306a",
                                                "text": "„Wimmernd und schluchzend heulte es seinen Fluch über den Pfuhl seiner Geburt; und er lag mit ohnmächtig klappernden Kiefern da und wehrte sich gegen die Nacht, wie ein verrückter, vom Wehklagen der Vorhölle umdrohter Paraklet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f37bb63-8281-4ce0-99c9-1a72c8fa2d17",
                        "source_entry_id": "e1e49e6c-150b-3ff8-8489-72d6b0507b9e",
                        "target_lang_word": "paraclet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paraclet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
                                        "entry_id": "99b24c8b-01a0-3f66-b046-5a46c5079ac8",
                                        "glosses": [
                                            "Consolateur protecteur, intercesseur, nom parfois donné au Saint-Esprit, troisième personne de la Trinité."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51373346-a5bd-45fa-b6d4-4082d9beefac",
                                                "sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
                                                "text": "Dans la coction de cette destinée, la mise au monde, je parle du monde, prend la place éminente, celle du ciel, celle du paraclet !"
                                            },
                                            {
                                                "example_id": "8776b318-797a-41a8-abdb-086420b391a3",
                                                "sense_id": "7e948ced-db46-3b42-9554-3782c8bc73e3",
                                                "text": "Il y a des vies qui constituent des appels à vivre. Des « paraclets », disait le poète anglais Hopkins. On peut appliquer le mot à Fanon en le dépouillant de son contexte religieux et mystique. Celui qui réveille, et celui qui encourage. Et, celui qui somme l’homme d’accomplir sa tâche d’homme et de s’accomplir lui-même, en accomplissant sa propre pensée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
