                                        "entry_id": "9770522c-9aa3-38b9-88a5-a6f33a72dfd8",
                                        "glosses": [
                                            "weltweit kleinste anerkannte Hunderasse, ursprünglich aus Mexiko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e28bcc-1173-4996-a5b7-c70e31327f22",
                                                "sense_id": "03126257-04e8-3710-80ec-97388a862f36",
                                                "text": "In Europa ist der Chihuahua nicht sehr verbreitet."
                                            },
                                            {
                                                "example_id": "710e59ff-f9b6-4420-b1db-311b0e17f1e1",
                                                "sense_id": "03126257-04e8-3710-80ec-97388a862f36",
                                                "text": "„Der eine führt einen Dobermann Pinscher und der zweite einen Chihuahua.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chihuahua",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f68a4918-7f62-3e64-be58-ed6532965c03",
                                        "entry_id": "45c8fa98-1671-3840-bf46-5cf900c90726",
                                        "glosses": [
                                            "Wüste im Grenzgebiet der USA und Mexikos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "910fd927-de86-4d2b-9c39-dc576ac38158",
                                                "sense_id": "f68a4918-7f62-3e64-be58-ed6532965c03",
                                                "text": "Die Gipswüste „White Sands“ ist der ungewöhnlichste Teil der Chihuahua."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Chihuahua",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8b1f4d0-5f48-3126-8ad9-a323e959a940",
                                        "entry_id": "a6523053-5e0e-359c-af3a-5cf70df9c768",
                                        "glosses": [
                                            "Stadt in Mexiko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "195aca92-8c43-4c19-b345-16e0817c11bb",
                                                "sense_id": "a8b1f4d0-5f48-3126-8ad9-a323e959a940",
                                                "text": "Mit rund 800.000 Einwohnern steht Chihuahua an zwölfter Stelle der Städte Mexikos."
                                            },
                                            {
                                                "example_id": "a9dbb25d-6586-4296-8390-f808b10e24d1",
                                                "sense_id": "a8b1f4d0-5f48-3126-8ad9-a323e959a940",
                                                "text": "„Als Colonel Doniphan die Stadt Chihuahua eingenommen hat, gab es auf Feindesseite über tausend Gefallene; er selber hat bloß einen einzigen Mann verloren, und den durch Selbstmord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea7ebb98-6cca-3eba-9253-78b4c7ce0ed9",
                                        "entry_id": "a6523053-5e0e-359c-af3a-5cf70df9c768",
                                        "glosses": [
                                            "mexikanischer Bundesstaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e35b484-5216-491d-a59c-d41bb5e9d11b",
                                                "sense_id": "ea7ebb98-6cca-3eba-9253-78b4c7ce0ed9",
                                                "text": "Die sogenannte Kupferschlucht liegt in Chihuahua und entstand durch einen ehemals starken Flusslauf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
