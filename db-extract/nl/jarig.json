                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1ccfb2a8-5eed-3ed4-a01a-2925cfa813a1",
                        "entry_id": "fe83478d-eeec-3f5a-8e77-7d765be851c5",
                        "glosses": [
                            "iemand met een leeftijd van ... jaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432c4be6-a12f-436c-bb51-74a0bb36e908",
                                "sense_id": "1ccfb2a8-5eed-3ed4-a01a-2925cfa813a1",
                                "text": "Het was alsof ik bij een onverwacht obstakel minder snel ging lopen of ik stopte zelfs helemaal totdat er iemand anders op het pad langskwam. Samen ben je sterker dan alleen, ook al was het met een onbekend 18-jarig meisje dat nog minder ervaring in de bergen had dan ik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a849e62d-53a1-4f3c-bd4f-544dfd6520c4",
                        "source_entry_id": "fe83478d-eeec-3f5a-8e77-7d765be851c5",
                        "source_sense_id": "75a0254c-79a2-3fad-8dd2-3fe66194f18c",
                        "source_sense_description": "iemand is jarig tijdens zijn verjaardag",
                        "target_lang_word": "Geburtstag haben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e99dda07-59c2-4585-81ad-5aff648c5c47",
                        "source_entry_id": "fe83478d-eeec-3f5a-8e77-7d765be851c5",
                        "source_sense_id": "75a0254c-79a2-3fad-8dd2-3fe66194f18c",
                        "source_sense_description": "iemand is jarig tijdens zijn verjaardag",
                        "target_lang_word": "birthday",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "birthday",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                        "entry_id": "e2cfcb21-c1f7-30ef-9b43-7bc114370e28",
                                        "glosses": [
                                            "The anniversary of the day on which someone is born."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49aaaf9a-047f-4214-8335-c8b9c2937145",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "Oliver Twist's ninth birthday found him a pale thin child, somewhat diminutive in stature, and decidedly small in circumference."
                                            },
                                            {
                                                "example_id": "a66c9061-3e63-4b74-bd3c-ebf1b8e4fdf0",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "When's your birthday? Mine's on April 1."
                                            },
                                            {
                                                "example_id": "0541f519-039b-4a98-a3f5-4bdb8ce22d23",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "I'll be thirty-seven (years old) next birthday."
                                            },
                                            {
                                                "example_id": "b32d8d1e-433d-4b8c-a1c6-0f65cadd1550",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "1903, L. Frank Baum, The Surprising Adventures of the Magical Monarch of Mo and His People, The Fifth Surprise: The Monarch Celebrates His Birthday,\nOne of the Wise Men said the King was born in February; another declared it was in May, and a third figured the great event happened in October. So the King issued a royal decree that he should have three birthdays every year, in order to be on the safe side; and whenever he happened to think of it he put in an odd birthday or two for luck."
                                            },
                                            {
                                                "example_id": "f0feddee-7463-4a11-8edb-7855f152adae",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "1906, Edith Nesbit, The Railway Children, Chapter 9: The pride of Perks,\n\"And we thought we'd make a nice birthday for him. He's been so awfully jolly decent to us, you know, Mother,\" said Peter, \"and we agreed that next bun-day we'd ask you if we could.\""
                                            },
                                            {
                                                "example_id": "63b0eb10-a37d-4895-b680-41d18a9be23e",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "c. 1911, Cotton Mather, Worthington Chauncey Ford (editor), Diary of Cotton Mather, Volume 1: 1681-1708, footnote, page 1,\nIt was his custom to begin a new year's record on February 12, his birthday."
                                            },
                                            {
                                                "example_id": "52e63d95-90b7-40a8-854e-27f3ba898cc9",
                                                "sense_id": "8d099b79-74ee-3fd6-89c9-0029cdb37049",
                                                "text": "The King's Birthday, which occurred yesterday, will be officially observed to-day, and the customary list of honours conferred on the occasion is published."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2803021-14e0-3250-b153-2bc14f08ca7d",
                                        "entry_id": "e2cfcb21-c1f7-30ef-9b43-7bc114370e28",
                                        "glosses": [
                                            "The anniversary of the day on which something is created."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0d60261-70c9-37dd-997f-37c647b1e9f0",
                                        "entry_id": "e2cfcb21-c1f7-30ef-9b43-7bc114370e28",
                                        "glosses": [
                                            "The date on which someone is born or something is created, more commonly called birthdate or date of birth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "797b0d22-80d9-30d8-bf85-261a7403cae4",
                                        "entry_id": "e2cfcb21-c1f7-30ef-9b43-7bc114370e28",
                                        "glosses": [
                                            "A birthday party."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08e6f959-858c-4ac7-a9e7-457a2880a370",
                                                "sense_id": "797b0d22-80d9-30d8-bf85-261a7403cae4",
                                                "text": "I'd like to invite you all to my birthday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "birthday",
                                "target_lang_code": "en",
                                "target_senses": [
