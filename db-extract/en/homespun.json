                                    {
                                        "sense_id": "427fdc2c-0ecb-329e-b07b-8883ad3c4382",
                                        "entry_id": "5b3d53d5-73b6-37a9-bab8-af543ebc9ecf",
                                        "glosses": [
                                            "für den eigenen Verbrauch zu Hause gebacken"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5faf0cf-63de-41fa-9c35-cf9c0d5cf23e",
                                                "sense_id": "427fdc2c-0ecb-329e-b07b-8883ad3c4382",
                                                "text": "In der Adventszeit freut sich die ganze Familie auf unser hausbackenes Schokoladenbrot."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bba6ffaa-c71b-379f-aa62-9eca374421ef",
                                        "entry_id": "5b3d53d5-73b6-37a9-bab8-af543ebc9ecf",
                                        "glosses": [
                                            "langweilig und brav, ohne das gewisse Etwas, ohne Reiz"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07afab64-83d5-402e-9e11-756bb9beb47b",
                                                "sense_id": "bba6ffaa-c71b-379f-aa62-9eca374421ef",
                                                "text": "Die hausbackenen Mädels hocken den ganzen Abschlussball auf ihren Stühlen und werden einfach nicht zum Tanzen aufgefordert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42767633-822e-4a93-bb7e-934d967d9ca2",
