                ],
                "senses": [
                    {
                        "sense_id": "66ec4ef9-368d-3631-83bb-c9f9da7297bb",
                        "entry_id": "ccc85efd-2e28-345b-b00a-48dc3c602925",
                        "glosses": [
                            "wie ein Kuchen (aussehend, beschaffen); einem Kuchen ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a782b5fb-bb94-4a34-8a60-62b0923e3487",
                                "sense_id": "66ec4ef9-368d-3631-83bb-c9f9da7297bb",
                                "text": "„Auf die Suppe folgte eine kuchenartige Mischung aus Reis, Gemüse und feingehacktem Fisch.“"
                            },
                            {
                                "example_id": "88ba87f8-c8f0-49ae-974e-771dab912d1a",
                                "sense_id": "66ec4ef9-368d-3631-83bb-c9f9da7297bb",
                                "text": "„Das Backwerk besteht aus Weizenmehl in Form verschiedener Brötchen und aus kuchenartigen, süßen Stücken.“"
                            },
                            {
                                "example_id": "b511f218-d610-495c-9a49-53e1b4cacf44",
                                "sense_id": "66ec4ef9-368d-3631-83bb-c9f9da7297bb",
                                "text": "„Halawa ist eine kuchenartige Süßspeise, die sie schon des Öfteren im Palast für die Lieblingsfrau des Prinzen verkauft hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
