                "senses": [
                    {
                        "sense_id": "1bd6fc30-5b65-3571-aefb-b24045335299",
                        "entry_id": "fc859367-3e28-3ede-b0ae-fd4ad65ba640",
                        "glosses": [
                            "ozdobna płytka ceramiczna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78053719-2e3d-4d6e-b7f6-c67e50ac03a9",
                                "sense_id": "1bd6fc30-5b65-3571-aefb-b24045335299",
                                "text": "Nasz stary piec miał wspaniałe ozdobne kafle."
                            },
                            {
                                "example_id": "9048a182-207c-43e5-994c-98ad447d5a49",
                                "sense_id": "1bd6fc30-5b65-3571-aefb-b24045335299",
                                "text": "Całe pomieszczenie wyłożone było turkusowymi kaflami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2127f5c2-5efd-326a-9f01-6feb4777d773",
                        "entry_id": "fc859367-3e28-3ede-b0ae-fd4ad65ba640",
                        "glosses": [
                            "tysiąc złotych"
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ce576a92-b666-4748-b926-8b84a84f0494",
                                "sense_id": "2127f5c2-5efd-326a-9f01-6feb4777d773",
                                "text": "Kosztowało mnie to pięć kafli."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a186f9e-f056-4fa0-b9d2-8d0d923b09dc",
                        "source_entry_id": "fc859367-3e28-3ede-b0ae-fd4ad65ba640",
                        "source_sense_id": "1bd6fc30-5b65-3571-aefb-b24045335299",
                        "target_lang_word": "tile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbc68f4c-0c6f-36dc-88c6-e74ca3872a32",
                                        "entry_id": "c892f87f-5e20-3fe5-a615-cec1c35e8f25",
                                        "glosses": [
                                            "A regularly-shaped slab of clay or other material, affixed to cover or decorate a surface, as in a roof-tile, glazed tile, stove tile, carpet tile, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09aecfa2-8e53-4fa0-b230-f4e62c19a20c",
                                                "sense_id": "fbc68f4c-0c6f-36dc-88c6-e74ca3872a32",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7769abc-4842-3c50-8cbc-6beab998dec0",
                                        "entry_id": "c892f87f-5e20-3fe5-a615-cec1c35e8f25",
                                        "glosses": [
                                            "A rectangular graphic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f155b19f-c072-48fb-ba1e-c3e2c41b57fd",
                                                "sense_id": "c7769abc-4842-3c50-8cbc-6beab998dec0",
                                                "text": "Each tile within the map consists of 256 × 256 pixels."
                                            },
                                            {
                                                "example_id": "24c98319-a447-4cb5-b842-fae46a1db51b",
                                                "sense_id": "c7769abc-4842-3c50-8cbc-6beab998dec0",
                                                "text": "Sprites and tiles that are hidden in the prototype ROM file can be recovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "350c7778-6ecf-3e02-a49f-9ca1dea76def",
                                        "entry_id": "c892f87f-5e20-3fe5-a615-cec1c35e8f25",
                                        "glosses": [
                                            "Any of various flat cuboid playing pieces used in certain games, such as dominoes, Scrabble, or mahjong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a86421-af7d-44dd-b0ad-85cdb81a1f74",
                                                "sense_id": "350c7778-6ecf-3e02-a49f-9ca1dea76def",
                                                "text": "One hot summer day in the Chinese city of Nan-ning, I wandered through a park of lotus leaves and exotic flowers to a pagoda where ancient women sat, drowsily, happily playing mahjongg amidst the scent of flowers, and that excellent sound of clicking tiles enchanted me; I was far from home, but that long slow summer afternoon with the mah-jongg sounds brought me back to my own continent and specifically to Mexicali, whose summer tranquillity never ends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2706cd8-b7d4-38e7-9f3c-54bdb8fb4ad2",
                                        "entry_id": "c892f87f-5e20-3fe5-a615-cec1c35e8f25",
                                        "glosses": [
                                            "A stiff hat."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a672b4-c935-40f8-a6ce-11ca64e1d5c5",
                                                "sense_id": "a2706cd8-b7d4-38e7-9f3c-54bdb8fb4ad2",
                                                "text": "Tile - Tile, a Hat."
                                            },
                                            {
                                                "example_id": "5f928169-4df9-484c-8817-a850b0152d52",
                                                "sense_id": "a2706cd8-b7d4-38e7-9f3c-54bdb8fb4ad2",
                                                "text": "1911, Charles Collins, Fred E. Terry and E.A. Sheppard, \"Any Old Iron\", British Music Hall song\nDressed in style, brand-new tile, And your father's old green tie on."
                                            },
                                            {
                                                "example_id": "18ea7aec-d0be-4a99-a388-e060119197aa",
                                                "sense_id": "a2706cd8-b7d4-38e7-9f3c-54bdb8fb4ad2",
                                                "text": "Thus, when old Doctor Meldrum, with his well-known curly-brimmed opera-hat, appeared upon the platform, there was such a universal query of \"Where did you get that tile?\" that he hurriedly removed it, and concealed it furtively under his chair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938f2f2d-e65c-33fc-8431-74db9e8024b9",
                                        "entry_id": "c892f87f-5e20-3fe5-a615-cec1c35e8f25",
                                        "glosses": [
                                            "A Lego piece that is 1/3 the height of a brick, and is smooth without studs on top."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f37b526b-90e7-30cc-84f8-a6cca28e0775",
                                        "entry_id": "2e74f751-783b-3d96-a6aa-6f0f7843f2f1",
                                        "glosses": [
                                            "To cover with tiles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369e7f31-c5d1-44c0-95df-31c78bb7d503",
                                                "sense_id": "f37b526b-90e7-30cc-84f8-a6cca28e0775",
                                                "text": "The handyman tiled the kitchen."
                                            },
                                            {
                                                "example_id": "c5677e07-1d35-4985-855d-26bc1b1b5f93",
                                                "sense_id": "f37b526b-90e7-30cc-84f8-a6cca28e0775",
                                                "text": "White marble tiled the bathroom."
                                            },
                                            {
                                                "example_id": "3afb4f6b-8d87-461a-8b63-eb07a5456ab4",
                                                "sense_id": "f37b526b-90e7-30cc-84f8-a6cca28e0775",
                                                "text": "Some professionals begin tiling a wall by setting a full tile in the most visually prominent corner […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503d52d4-a967-313d-923c-0a8e16d77cf6",
                                        "entry_id": "2e74f751-783b-3d96-a6aa-6f0f7843f2f1",
                                        "glosses": [
                                            "To arrange in a regular pattern, with adjoining edges (applied to tile-like objects, graphics, windows in a computer interface)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9c67a02-31ff-3587-bffe-8f3b987d6c26",
                                        "entry_id": "2e74f751-783b-3d96-a6aa-6f0f7843f2f1",
                                        "glosses": [
                                            "To optimize (a loop in program code) by means of the tiling technique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
