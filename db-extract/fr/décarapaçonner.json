                "senses": [
                    {
                        "sense_id": "dbb5f4b1-e2d6-34ab-87e9-b4fcc31fc089",
                        "entry_id": "a98a8796-d0b7-3ad4-93b9-f5af4c382fdc",
                        "glosses": [
                            "Variante de décaparaçonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81b62f0-7cb1-4d4a-8f36-7ccadf9185bb",
                                "sense_id": "dbb5f4b1-e2d6-34ab-87e9-b4fcc31fc089",
                                "text": "Me « décarapaçonner » des automatismes, libérer la créativité jusqu’à présent dupée, tronquée, soudoyée…"
                            },
                            {
                                "example_id": "59a0dc68-0592-4078-b455-3ea14b42eefa",
                                "sense_id": "dbb5f4b1-e2d6-34ab-87e9-b4fcc31fc089",
                                "text": "Le monsieur devant moi à droite se décarapaçonne de sa Peugeot “ quat’quat’Bâchie ” (comme dit, non seulement Le Chameau, mais tout le monde), se met à hurler ; il a freiné au beau milieu de la chaussi pardon chaussée."
                            }
                        ]
                    },
                    {
                        "sense_id": "18621262-0538-31df-89ec-d7887d2e37ad",
                        "entry_id": "a98a8796-d0b7-3ad4-93b9-f5af4c382fdc",
                        "glosses": [
                            "Variante de décarapacer (enlever la carapace)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4de275-b4fd-4658-bd5a-05a83a1fb2e6",
                                "sense_id": "18621262-0538-31df-89ec-d7887d2e37ad",
                                "text": "Car ce n’est pas rien, 8 homards à décarapaçonner le jour J !"
                            }
                        ]
                    }
