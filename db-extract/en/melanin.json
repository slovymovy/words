                    {
                        "translation_id": "9476fca3-a4e6-41e0-99f5-66757180fdd7",
                        "source_entry_id": "e5652afd-c377-36db-b0a9-7528bea8655b",
                        "source_sense_id": "cc015755-23e6-3f5e-853e-4aa6c777313d",
                        "source_sense_description": "dark pigment",
                        "target_lang_word": "mélanine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mélanine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d93b7829-a22a-3508-bd2f-4ac5f629776c",
                                        "entry_id": "ef34c1ee-b585-3425-9f9e-aa05141c9606",
                                        "glosses": [
                                            "Pigment noir de la peau des animaux et des hommes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "768cb2d5-2a67-49e7-8a6f-46eee6652683",
                                                "sense_id": "d93b7829-a22a-3508-bd2f-4ac5f629776c",
                                                "text": "Le pigment noir, ou mélanine, qui est le plus important, a pour siège certaines cellules étoilées du derme, les mélanophores, qui peuvent […] déterminer l’assombrissement ou l’éclaircissement de la peau."
                                            },
                                            {
                                                "example_id": "0f643894-01c3-4318-92af-a5ad30163003",
                                                "sense_id": "d93b7829-a22a-3508-bd2f-4ac5f629776c",
                                                "text": "Quelques décennies plus tard, les Zemmour, Le Pen ou Ciotti font des chocs allergiques à la mélanine : ils ont suffoqué de voir Taubira nommée garde des Sceaux en 2012, ils défaillent devant Pap Ndiaye."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eec3e8c-bc70-403f-a270-18681da5396e",
                        "source_entry_id": "e5652afd-c377-36db-b0a9-7528bea8655b",
                        "source_sense_id": "cc015755-23e6-3f5e-853e-4aa6c777313d",
                        "source_sense_description": "dark pigment",
                        "target_lang_word": "Melanin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melanin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                        "entry_id": "fad70d57-0c5c-3ed0-bc5c-44ce0cebe639",
                                        "glosses": [
                                            "weit verbreitete dunkelbraune bis schwarze oder gelbliche bis rötliche Pigmente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e239d250-7d95-4076-951d-1b9c09a81a07",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Der Pilz, Cladosporium sphaerospermum, verdankt seine Farbe einem Mantel aus Melanin.“"
                                            },
                                            {
                                                "example_id": "92630449-ef5f-4fab-b0d7-5b90b6405bff",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„So kann der zweite Wirkstoff, das Hydrochinon, leichter in die Zellen eindringen - und dort verhindern, dass neues Melanin gebildet wird.“"
                                            },
                                            {
                                                "example_id": "b0d548f5-4189-472d-8f08-f469c39b7438",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Ziehen beispielsweise Blauwale in sonnenreichere Gebiete, produzieren die Pigmentzellen ihrer Haut - wie die der Menschen - zunehmend Melanin, berichten die Forscher in der Fachzeitschrift ‚Scientific Reports‘ […].“"
                                            },
                                            {
                                                "example_id": "dfcdeee9-fdeb-425e-98a1-dcdbd73f5431",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Eine genetische Störung sorgt dafür, dass die Körper dieser Menschen den Pigmentstoff Melanin bestenfalls in geringen Mengen produzieren können.“"
                                            },
                                            {
                                                "example_id": "acffca25-8592-4ac6-a3d6-5f84e131f5bc",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Die Betroffenen bilden im schlimmsten Fall keinerlei Melanin und müssen besonders in Äquatornähe die Sonne und ihre UVB-Strahlung fürchten.“"
                                            },
                                            {
                                                "example_id": "900216d3-58f7-4e29-82dc-63c4ba0f3901",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Bislang glaubte man, dass der Farbwechel durch Konzentrationsänderungen des Pigments Melanin in der Haut zustande kommt, wie es auch bei anderen Tieren der Fall ist, die ihr Äußeres verändern können.“"
                                            },
                                            {
                                                "example_id": "60ea126a-ee8c-40eb-b83c-491ed328fe51",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Braun werden ist eigentlich ein Lichtschutz für die Haut, wofür der Stoff Melanin in der Haut des Menschen verantwortlich ist – rötliche, schwarze und braune Pigmente.“"
                                            },
                                            {
                                                "example_id": "a41a4335-81b0-4ea6-b3a5-ac099ad6bf5f",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Dieses liefert den Bauplan für das sogenannte P-Protein, das die Produktion des braunen Pigments Melanin reguliert.“"
                                            },
                                            {
                                                "example_id": "e4095a6c-5351-4c1f-8296-5d5d2ea074aa",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Denn erstens leiden Menschen wie Omari unter der starken Sonneneinstrahlung, weil durch den rezessiv vererbbaren Gen-Defekt die reguläre Produktion des Pigments Melanin blockiert und die Dunkelfärbung der Haut dadurch verhindert wird.“"
                                            },
                                            {
                                                "example_id": "7e077b56-5584-493a-b59f-f4e552fb2171",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„Man findet lediglich, dass es in den weißen Flecken der Oberhaut keine Zellen mehr gibt, die das Pigment Melanin herstellen.“"
                                            },
                                            {
                                                "example_id": "b9895b31-1cb8-4034-b131-256630421a1e",
                                                "sense_id": "e2036c91-7066-3acc-8d29-dea8979b46b3",
                                                "text": "„In Japan hat das Lebensmittelunternehmen Marudai Food fünf Produkte vom Markt zurückgerufen, die womöglich mit Melanin versetzt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
