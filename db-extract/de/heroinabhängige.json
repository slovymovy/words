                "senses": [
                    {
                        "sense_id": "528625a0-0bdc-3cda-9d67-04e540ad53ee",
                        "entry_id": "61aa443f-d63b-32fa-9131-2f6735b48b86",
                        "glosses": [
                            "weibliche Person, die unter einer Heroinabhängigkeit leidet, heroinabhängig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b3e51a-b410-4de6-9d43-7b8e57a054b1",
                                "sense_id": "528625a0-0bdc-3cda-9d67-04e540ad53ee",
                                "text": "„Der Alkoholiker trinkt weiter, die Heroinabhängige spritzt weiter und die alte Frau lebt weiter isoliert in einem anonymen Neubau.“"
                            },
                            {
                                "example_id": "2869cbdc-c872-440e-a55e-ac66c4d8ccd3",
                                "sense_id": "528625a0-0bdc-3cda-9d67-04e540ad53ee",
                                "text": "„Mit zwei Freunden wollte die Heroinabhängige das Motorrad eines Bekannten stehlen und zu Geld machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
