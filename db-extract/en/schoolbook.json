                                        "glosses": [
                                            "Livre de référence destiné à l’enseignement et l’apprentissage d’une matière scolaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4611f1f-746a-4204-978e-77141dd0a31b",
                                                "sense_id": "fbf27998-75b7-332b-9a4b-0538fc1e8bcb",
                                                "text": "Partout dans le monde les manuels scolaires sont quelque peu malmenés, dans des sens divers : les chantres de l’électronique en prédisent la disparition au profit du multimédia ; […]."
                                            },
                                            {
                                                "example_id": "1f2e624a-a9cb-4492-9252-b583d0b9c235",
                                                "sense_id": "fbf27998-75b7-332b-9a4b-0538fc1e8bcb",
                                                "text": "Le manuel scolaire est destiné à être utilisé en classe comme support de cours avec l’aide directe ou indirecte d’un enseignant."
                                            }
                                        ]
                                    }
                                ]
                            }
