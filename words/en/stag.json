                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b96c6bb-ca47-341b-9b40-9dd5a4154c8a",
                    "sense_definition": "An outside dealer in stocks who is not an official member of the exchange.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Brokers were advised to avoid doing business with an unverified <w>stag</w>.",
                            "target_lang_translations": {
                                "ru": "Брокерам советовали избегать сделок с непроверенными <w>внебиржевыми маклерами</w>."
                            }
                        },
                        {
                            "text": "Trading outside the exchange floor was dominated by every opportunistic <w>stag</w>.",
                            "target_lang_translations": {
                                "ru": "В торговле вне биржевого зала главенствовали ушлые <w>вольные дельцы</w> всех мастей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical financial term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внебиржевой маклер, не являющийся официальным членом биржи (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внебиржевой маклер",
                                "target_lang_sense_clarification": "неофициальный биржевой торговец"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b148ee49-5610-3918-9bab-686dd4e31567",
                    "sense_definition": "Without a female companion or date at a formal social function.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to go <w>stag</w> to the formal winter banquet.",
                            "target_lang_translations": {
                                "ru": "Он решил пойти на официальный зимний банкет <w>без пары</w>."
                            }
                        },
                        {
                            "text": "My brother went <w>stag</w> to prom because he couldn't find a date.",
                            "target_lang_translations": {
                                "ru": "Мой брат пошёл на выпускной <w>без спутницы</w>, потому что не смог найти пару."
                            }
                        }
                    ],
                    "common_phrases": [
