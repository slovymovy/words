                ],
                "senses": [
                    {
                        "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                        "glosses": [
                            "Characterized by or constituting (any kind of) irony."
                        ],
                        "tags": [
                            "of a situation"
                        ],
                        "examples": [
                            {
                                "example_id": "abd79392-df69-4d30-ba0c-9649059f8401",
                                "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                "text": "It's somewhat ironic to have a wave of smog right on Earth Day."
                            },
                            {
                                "example_id": "eada0f7e-7dfb-4f61-bedf-58a77bb0438c",
                                "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                "text": "It was ironic I forgot my textbook on human memory."
                            },
                            {
                                "example_id": "80479409-9547-4bdf-a4dc-4f1cdc7dbb5f",
                                "sense_id": "62ee4695-b75b-353d-9793-788a9859f151",
                                "text": "Chloe had once seen a real-life goth hanging around by a garbage bin in the high street and become incredibly excited. She really wanted to go over and ask her how to get started in the goth world, but she was too shy. Which was ironic, since shyness is something you need if you want to be a successful goth."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7b75cb5-b5f2-395e-af0e-3dcd756828b6",
                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                        "glosses": [
                            "Characterized by or constituting (any kind of) irony.",
                            "Odd or coincidental; strange."
                        ],
                        "tags": [
                            "proscribed"
                        ],
                        "examples": [
                            {
                                "example_id": "c6af9920-12bf-4846-a173-f63d4a5b1817",
                                "sense_id": "e7b75cb5-b5f2-395e-af0e-3dcd756828b6",
                                "text": "It's ironic that we are eating a sandwich in Sandwich, Massachusetts."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa5eab24-ba43-31e4-9f45-e5626c4d420f",
                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                        "glosses": [
                            "Acting in an unserious and teasing manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a93069f1-647c-4e5a-8f02-2190954127e5",
                                "sense_id": "fa5eab24-ba43-31e4-9f45-e5626c4d420f",
                                "text": "Don't take it personally. We're just being ironic."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                        "entry_id": "2c41ea93-383f-3db7-8fad-dbb835245a35",
                        "glosses": [
                            "Done in an insincere and mocking manner; satirical."
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "85a61d2f-e13f-4eb2-a8a8-80827d5f1d21",
                                "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                                "text": "You should assume that everything this guy posts is ironic."
                            },
                            {
                                "example_id": "109ae1e9-2f1e-48f2-93d1-1e3a981bf287",
                                "sense_id": "6e51c42a-f78a-35f8-b2bf-1dd068d12348",
                                "text": "Here’s a tip: If a group of people start using something as ironic hate speech, it will eventually be used for unironic hate speech. Don’t act surprised."
                            }
                        ]
                    }
                ],
