                "senses": [
                    {
                        "sense_id": "47b2e52f-7395-3342-b11c-817f7a258d01",
                        "entry_id": "df0fa533-8421-306f-8b84-4025ac97d6d3",
                        "glosses": [
                            "die Möglichkeiten, die jemandem offenstehen, um zu agieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b0becc-2b0e-4362-95d8-a07282c9f188",
                                "sense_id": "47b2e52f-7395-3342-b11c-817f7a258d01",
                                "text": "Die griffige Formel des „nationalen Sozialismus“ wurde inhaltlich nie genau bestimmt, um den Handlungsspielraum der Parteiführung nicht einzuengen."
                            },
                            {
                                "example_id": "0d2b1d10-364d-4bce-b874-fb4516730b59",
                                "sense_id": "47b2e52f-7395-3342-b11c-817f7a258d01",
                                "text": "„Entwicklung braucht das Überwinden der Verharrungstendenz. Sie braucht die Grenzsprengung, weil nur so die Handlungsspielräume und die eigenen Persönlichkeitsdimensionen erfahrbar werden.“"
                            },
                            {
                                "example_id": "c09d155d-3e76-4bfc-be3b-98a8f4dc827f",
                                "sense_id": "47b2e52f-7395-3342-b11c-817f7a258d01",
                                "text": "„Die extreme Reaktion der Wähler auf die oft nur kosmetischen Zugeständnisse an die Afrikaner offenbarte, wie eingeschränkt die Handlungsspielräume weißer rhodesischer Politiker waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e922e6e5-0f25-4e14-aa30-39cc05166a14",
                        "source_entry_id": "df0fa533-8421-306f-8b84-4025ac97d6d3",
                        "source_sense_id": "47b2e52f-7395-3342-b11c-817f7a258d01",
                        "source_sense_description": "die Möglichkeiten, die jemandem offenstehen, um zu agieren",
                        "target_lang_word": "scope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d97874-fe5f-30e0-85b4-93c5e79e7c1d",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "The breadth, depth or reach of a subject; the extent of applicability or relevance; a domain, purview or remit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cef0f09-f84b-4516-a026-a9c54a2562db",
                                                "sense_id": "e5d97874-fe5f-30e0-85b4-93c5e79e7c1d",
                                                "text": "Environmental impacts lie outside the scope of this report."
                                            },
                                            {
                                                "example_id": "0f52470c-039c-4d2b-ad70-b134fa4db893",
                                                "sense_id": "e5d97874-fe5f-30e0-85b4-93c5e79e7c1d",
                                                "text": "Such transactions fall within the scope of VAT."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946d955c-8143-358a-9a45-f87de2689ea1",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "A device used in aiming a projectile, through which the person aiming looks at the intended target."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ee99ab7-7046-42a7-9bef-fc52b9cef306",
                                                "sense_id": "946d955c-8143-358a-9a45-f87de2689ea1",
                                                "text": "Coastie yanked her eye away from the night scope when those big lights were caught by it and amplified in intensity. Her entire view had gone white in an instant. “I can't see!” Temporarily blinded, she let touch become her primary sense, dropped the M40, and grabbed her alternate weapon, an M16 with an ACOG day scope that was already registered for the same distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582cb4a8-590b-30af-9e86-72f45ea5710d",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "Potential range of action; degree of freedom; opportunity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1425fcc-ea92-48ee-a5ae-0fb86f130556",
                                                "sense_id": "582cb4a8-590b-30af-9e86-72f45ea5710d",
                                                "text": "My job doesn't give me much scope for personal development."
                                            },
                                            {
                                                "example_id": "5231a521-f19b-4e29-a848-aa0f94d276bc",
                                                "sense_id": "582cb4a8-590b-30af-9e86-72f45ea5710d",
                                                "text": "It is also true that the vast majority of teachers are highly skilled and experienced professionals who are already doing an excellent job in the classroom, thus leaving relatively little scope for improvement."
                                            },
                                            {
                                                "example_id": "83067ffc-204b-4a18-af4f-cd04263922eb",
                                                "sense_id": "582cb4a8-590b-30af-9e86-72f45ea5710d",
                                                "text": "She had in fact put in a resume at another firm that gave their graphics team much more scope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d91badc-e468-3f33-9247-f938357f6157",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "The region of program source code in which a given identifier is meaningful, or a given object can be accessed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "561e63d7-022f-47aa-b4cb-039fc3228063",
                                                "sense_id": "7d91badc-e468-3f33-9247-f938357f6157",
                                                "text": "A variable's scope is the region of a program within which the variable can be referred to by its simple name. Secondarily, scope also determines when the system creates and destroys memory for the variable. Scope is distinct from visibility, which applies only to member variables and determines whether the variable can be used from outside of the class within which it is declared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2bac4c4-46cb-3d59-ae05-862db40945f9",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "The shortest sub-wff of which a given instance of a logical connective is a part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "026bc314-4018-3375-a4cd-4772f601df85",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "The region of an utterance to which some modifying element applies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63d70e68-81b1-4e69-ac1e-7bc666df76d8",
                                                "sense_id": "026bc314-4018-3375-a4cd-4772f601df85",
                                                "text": "the scope of an adverb"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3385487-7f12-3895-a8a5-6c422fa06dc8",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "Alternative form of 'scope (“periscope, telescope, microscope, oscilloscope”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7bd4b4d-ae7d-38ee-8010-f04801fd30e7",
                                        "entry_id": "b73c3c2f-1089-34ee-9962-21de5635f825",
                                        "glosses": [
                                            "Any medical procedure that ends in the suffix -scopy, such as endoscopy, colonoscopy, bronchoscopy, etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7f3a5b-3f1c-3679-a702-9b4fb5f28936",
                                        "entry_id": "cd30c9f2-1d4b-3dbe-a730-87fce6417d31",
                                        "glosses": [
                                            "To perform a cursory investigation of; scope out."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba9214c-b1fc-4688-a987-00f95f053ccd",
                                                "sense_id": "bb7f3a5b-3f1c-3679-a702-9b4fb5f28936",
                                                "text": "We don't know, so let's scope the action before having another shoot out."
                                            },
                                            {
                                                "example_id": "7d7356cb-8846-413e-9fcb-609a279eab44",
                                                "sense_id": "bb7f3a5b-3f1c-3679-a702-9b4fb5f28936",
                                                "text": "“Let's scope the scene.” The gang advanced, searching for humanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05bd9158-8957-363e-b004-1e6fd6ac8dde",
                                        "entry_id": "cd30c9f2-1d4b-3dbe-a730-87fce6417d31",
                                        "glosses": [
                                            "To perform any medical procedure that ends in the suffix -scopy, such as endoscopy, colonoscopy, bronchoscopy, etc."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ff3a0ae-f56e-4913-9199-a88a51d550ad",
                                                "sense_id": "05bd9158-8957-363e-b004-1e6fd6ac8dde",
                                                "text": "The surgeon will scope the football player's knee to repair damage to a ligament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ebdbb4-2de7-31cc-9bfc-2f7017c1e288",
                                        "entry_id": "cd30c9f2-1d4b-3dbe-a730-87fce6417d31",
                                        "glosses": [
                                            "To define the scope of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09acaff7-1d7b-4e6e-b9a4-285ab93d04f8",
                                                "sense_id": "86ebdbb4-2de7-31cc-9bfc-2f7017c1e288",
                                                "text": "Before scoping the investigation and developing a work plan, it is necessary to establish reasonable goals and objectives."
                                            },
                                            {
                                                "example_id": "e0956aa1-e0fb-4304-a9eb-026814b272a5",
                                                "sense_id": "86ebdbb4-2de7-31cc-9bfc-2f7017c1e288",
                                                "text": "The purpose of witness interviews is multi-faceted but generally includes scoping the investigation, understanding the facts and issues at play, and assessing the accountability of individuals and possible defences for the company and[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "184a0f90-b203-32b6-8a74-63f0cbfe5a14",
                                        "entry_id": "cd30c9f2-1d4b-3dbe-a730-87fce6417d31",
                                        "glosses": [
                                            "To limit (an object or variable) to a certain region of program source code."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2a9b9b-d89b-4bf6-8463-f238b1cfe4d7",
                                                "sense_id": "184a0f90-b203-32b6-8a74-63f0cbfe5a14",
                                                "text": "If we locally scope the user's login name, it won't be accessible from outside this function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9669fad8-a0e2-3e19-b7dd-094f49b53cbe",
                                        "entry_id": "cd30c9f2-1d4b-3dbe-a730-87fce6417d31",
                                        "glosses": [
                                            "To examine under a microscope."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f6f250-e335-4a32-822f-6812486e2abd",
                                                "sense_id": "9669fad8-a0e2-3e19-b7dd-094f49b53cbe",
                                                "text": "The entomologist explained that he could not tell what species of springtail we were looking at without scoping it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e162d068-e3ae-38b4-a1f8-490a92d31dc0",
                                        "entry_id": "cd30c9f2-1d4b-3dbe-a730-87fce6417d31",
                                        "glosses": [
                                            "To observe a bird using a spotting scope."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "164c1926-2b5b-4c74-be71-8d7d713b817c",
                                                "sense_id": "e162d068-e3ae-38b4-a1f8-490a92d31dc0",
                                                "text": "`Maybe there was another darker bird and it had flown away before we could scope it?' `Yes there must have been,' came the grim-faced reply."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4681b8fb-e0c7-31dc-82b6-793b524554f4",
                                        "entry_id": "9928ef6f-7d0d-3bbb-ba00-eabe64df295e",
                                        "glosses": [
                                            "A bundle, as of twigs."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0cf3852-7459-4d72-80f4-b71995ad3057",
                        "source_entry_id": "df0fa533-8421-306f-8b84-4025ac97d6d3",
                        "source_sense_id": "47b2e52f-7395-3342-b11c-817f7a258d01",
                        "source_sense_description": "die Möglichkeiten, die jemandem offenstehen, um zu agieren",
                        "target_lang_word": "room for maneuver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "room for maneuver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e4118e0-2628-3f0c-bf9a-6d2543fa8490",
                                        "entry_id": "7fa5eab3-9794-3adc-b1ee-e3375021c100",
                                        "glosses": [
                                            "Synonym of wiggle room."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ea8f92f-6aa7-4b22-9ff1-b6f65f8761ff",
                                                "sense_id": "7e4118e0-2628-3f0c-bf9a-6d2543fa8490",
                                                "text": "“He doesn’t have much room for maneuver,” said Sam Hill, a fixed-income fund manager at Threadneedle in London. “On the one hand he wants to loosen fiscal policy, but on the other hand he’s already in a massive hole, and if he does anything to make that worse the market will react very negatively.”"
                                            },
                                            {
                                                "example_id": "fd94362b-05b5-45ac-a8df-30605a50e493",
                                                "sense_id": "7e4118e0-2628-3f0c-bf9a-6d2543fa8490",
                                                "text": "To this end, Obama and Romney will need to lift the impediments to growth and job creation. Here again – in areas like housing, the labor market, credit intermediation, and infrastructure – there is less room for maneuver than most politicians would like us to believe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4fc7f6a-895d-4c2e-a534-5b9203bdff7b",
