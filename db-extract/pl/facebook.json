                                "sense_id": "0de29e07-4150-301e-8adf-63072f3d2ba9",
                                "text": "Nie jestem użytkownikiem Facebooka"
                            },
                            {
                                "example_id": "ae32f6ee-edbd-4410-94e4-61e5dc509301",
                                "sense_id": "0de29e07-4150-301e-8adf-63072f3d2ba9",
                                "text": "Utrzymywali kontakt przez Facebook"
                            },
                            {
                                "example_id": "41142216-39b1-447f-973d-9c113a993ec7",
                                "sense_id": "0de29e07-4150-301e-8adf-63072f3d2ba9",
