                    {
                        "translation_id": "cc4736ab-b7ad-4691-b192-370127258689",
                        "source_entry_id": "cea0257b-42f5-31c8-ab07-388b162a128f",
                        "source_sense_id": "1beb601c-277e-385b-9ae7-03244177f51e",
                        "source_sense_description": "incessant",
                        "target_lang_word": "persistente",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persistente",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "47e330f1-8554-3697-864b-4960906b3850",
                                        "entry_id": "21078f29-cbce-3488-8a20-f0caec98b50a",
                                        "glosses": [
                                            "que persiste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1cb434a-c181-4f90-a3aa-022e804a913c",
                                                "sense_id": "47e330f1-8554-3697-864b-4960906b3850",
                                                "text": "Mas quando mais nada subsiste de um passado remoto, após a morte das criaturas e a destruição das coisas, sozinhos, mais frágeis porém mais vivos, mais imateriais, mais persistentes, mais fiéis, o odor e o sabor permanecem ainda por muito tempo, como almas, lembrando, guardando, esperando, sobre as ruínas de tudo o mais, e suportando sem ceder, em sua gotícula impalpável, o edifício imenso da recordação."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7d2176c-9243-3c49-a5f0-17fa608ad484",
                                        "entry_id": "21078f29-cbce-3488-8a20-f0caec98b50a",
                                        "glosses": [
                                            "tenaz"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52bda136-281d-3cb7-82e1-a296c4a0e7ee",
                                        "entry_id": "21078f29-cbce-3488-8a20-f0caec98b50a",
                                        "glosses": [
                                            "duradouro"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77b571ea-ac9f-4718-abaf-6e0d2d923e31",
                                                "sense_id": "52bda136-281d-3cb7-82e1-a296c4a0e7ee",
                                                "text": "A única forma de desenvolvimento é um esforço constante através da meditação. É claro que, no início, isso não é fácil. Encontram-se dificuldades inesperadas, às vezes há perda de entusiasmo. Ou talvez o entusiasmo inicial seja excessivo e diminua progressivamente com o passar das semanas ou meses. É preciso elaborar uma abordagem persistente, constante, baseada em um compromisso de longo prazo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a5cbed-71ec-3dc1-babd-778ba5ffa13e",
                                        "entry_id": "21078f29-cbce-3488-8a20-f0caec98b50a",
                                        "glosses": [
                                            "folha que não cai durante as estações frias"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
