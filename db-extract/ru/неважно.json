        "ru-extract.jsonl": [
            {
                "entry_id": "4af273a1-e7e3-37b2-a76f-7a222df678ef",
                "word": "неважно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1a8aeab1-9b6c-32d7-bc76-0818f259b7a0",
                        "entry_id": "4af273a1-e7e3-37b2-a76f-7a222df678ef",
                        "glosses": [
                            "не имея большого значения, не заслуживая внимания; несущественно, незначительно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7078ea-8ef5-47d9-be17-25f9da95ccf2",
                                "sense_id": "1a8aeab1-9b6c-32d7-bc76-0818f259b7a0",
                                "text": "Училась она в пансионе и ещё чему-то, но так как это «что-то» было ненужно, неважно и неинтересно, то она и забыла его."
                            }
                        ]
                    },
                    {
                        "sense_id": "2af662fa-d188-379e-bcc0-94579d21c146",
                        "entry_id": "4af273a1-e7e3-37b2-a76f-7a222df678ef",
                        "glosses": [
                            "перен. посредственно, плохо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7368c0e8-7485-4160-a565-e3ba01ef9234",
                                "sense_id": "2af662fa-d188-379e-bcc0-94579d21c146",
                                "text": "— У него дифтерит носовой полости, — сказал он вполголоса. — Уже и сердце неважно работает. В сущности, плохи дела."
                            },
                            {
                                "example_id": "47bc1f59-742f-4227-9e4a-aa612e14570b",
                                "sense_id": "2af662fa-d188-379e-bcc0-94579d21c146",
                                "text": "Он был еврей серьёзный, но неудачливый, и дела его шли неважно."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7ad50c7-a308-3bdf-a1e2-1c995b0d8547",
                        "entry_id": "4af273a1-e7e3-37b2-a76f-7a222df678ef",
                        "glosses": [
                            "предик. оценочная характеристика чего-либо как несущественного, незначительного, не имеющего большого значения, не заслуживающего внимания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a216cc-2835-4c9f-9c8a-bd7fdb8ca0dd",
                                "sense_id": "c7ad50c7-a308-3bdf-a1e2-1c995b0d8547",
                                "text": "Оптимист я или что другое, — это неважно, — но жить — мне нравится!"
                            }
                        ]
                    },
                    {
                        "sense_id": "8d888601-e498-3415-be6e-c4329c8a7262",
                        "entry_id": "4af273a1-e7e3-37b2-a76f-7a222df678ef",
                        "glosses": [
                            "предик. перен. разг. оценочная характеристика чего-либо как посредственного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a38bea0a-ec9c-487a-b19e-6bc4e2714a55",
                                "sense_id": "8d888601-e498-3415-be6e-c4329c8a7262",
                                "text": "А как здоровье синьорины Марии? — Все ещё неважно."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
