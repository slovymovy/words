                "senses": [
                    {
                        "sense_id": "fd585f42-e999-3b73-ad55-c6d09e9e30b2",
                        "entry_id": "1c55ca64-dee9-34fe-a174-d8b21ea7ffe7",
                        "glosses": [
                            "Möbelstück für ein Badezimmer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24fcac0-613e-4bbe-9ac0-e9db1491c8fd",
                                "sense_id": "fd585f42-e999-3b73-ad55-c6d09e9e30b2",
                                "text": "Ich habe im Internet neue Badmöbel bestellt."
                            },
                            {
                                "example_id": "b980ed7d-49eb-4376-aad9-adbd801e8b0d",
                                "sense_id": "fd585f42-e999-3b73-ad55-c6d09e9e30b2",
                                "text": "„Manche sorgen sich gar, der Vermieter könnte geneigt sein, für Inventar wie die Küche oder Badmöbel einen überhöhten Abstand zu verlangen, um so die Maklerkosten wieder hereinzuholen.“"
                            },
                            {
                                "example_id": "9e71478a-9933-4648-a515-f46015b2efed",
                                "sense_id": "fd585f42-e999-3b73-ad55-c6d09e9e30b2",
                                "text": "„So wurde in der Ausstellung des Fachgeschäfts in Glinde eine neue Generation von Badmöbeln montiert, bei der die LED-Beleuchtung integriert ist und sich die Farbtemperatur stufenlos einstellen lässt.“"
                            },
                            {
                                "example_id": "7d4a9e19-9f81-4a55-a8d7-e7c914fcf7b6",
                                "sense_id": "fd585f42-e999-3b73-ad55-c6d09e9e30b2",
                                "text": "„Auch die Badmöbel sind bei vielen Herstellern deutlich farbiger geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
