                                                "example_id": "7aec14e6-f0e2-4794-8efc-5e2474e7b0db",
                                                "sense_id": "1dcf28a6-a94c-3136-832f-d60e86cff97b",
                                                "text": "В Африке климат всегда жаркий, поэтому времена года связывались с разливом Нила."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db1c5f1-06ea-3c4b-8abb-4c711ee86c05",
                                        "entry_id": "38bcff78-3eb4-3fcf-ba52-4f783f58a188",
