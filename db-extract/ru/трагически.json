                                        "sense_id": "17f73bac-e72e-3d73-9ad4-57cab574ea41",
                                        "entry_id": "73d2bc97-c618-36bf-b711-ed6abef7bb59",
                                        "glosses": [
                                            "D’une manière conforme à la tragédie."
