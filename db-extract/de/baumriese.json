                        "examples": [
                            {
                                "example_id": "e9a324be-7339-4185-bee0-32b10d8ea787",
                                "sense_id": "2da0a978-3664-3575-a1fd-2c293f121147",
                                "text": "„In den Kronen der Baumriesen erwachten die nachtaktiven Tiere, und von unserem Logenplatz aus fiel mir ein graubraunes Fellbündel auf, das in einem der letzten Lichtflecke hing – keine zehn Meter von uns entfernt.“"
                            },
                            {
                                "example_id": "cb9717f0-65fe-48f2-83d3-df388cd44604",
                                "sense_id": "2da0a978-3664-3575-a1fd-2c293f121147",
                                "text": "„Meterhohe Baumfarne, dicke Moospolster an Baumriesen, wilde Bananen waren zu bestaunen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
