                "senses": [
                    {
                        "sense_id": "b9bdcc7e-1036-36f4-b666-2bef94c911e3",
                        "entry_id": "a8773b91-3432-3e72-8168-363c34d3f885",
                        "glosses": [
                            "Être soumis aux exigences de l’audimat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f75421b-40c4-47be-84d1-af94c1aa6e65",
                                "sense_id": "b9bdcc7e-1036-36f4-b666-2bef94c911e3",
                                "text": "Informer et non audimatiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "200b2b3c-02e6-38d3-b18a-67e1eba12179",
                        "entry_id": "a8773b91-3432-3e72-8168-363c34d3f885",
                        "glosses": [
                            "Soumettre aux exigences de l’audimat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e34a382-1b34-4e3c-be89-46c95b67e365",
                                "sense_id": "200b2b3c-02e6-38d3-b18a-67e1eba12179",
                                "text": "Dans l'univers de la radio, pourtant moins cruellement «audimatisé» que la télévision, ce petit matin-vitrine est une sorte de prime time."
                            },
                            {
                                "example_id": "9d61dd57-4672-48f3-9258-941f2b828833",
                                "sense_id": "200b2b3c-02e6-38d3-b18a-67e1eba12179",
                                "text": "Démarche louable du petit écran et du service public que de ne pas chercher une fois de plus à renvoyer du «peuple» l'image audimatisée des «reality shows» et autres «sit-coms»."
                            }
                        ]
                    }
