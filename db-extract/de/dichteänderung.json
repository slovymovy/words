                                "example_id": "2e61720b-1bcf-4aa2-a0e2-3e27d041cb6b",
                                "sense_id": "456a3af2-2933-3eab-8b20-73ab50414881",
                                "text": "„Strömungen mit Dichteänderungen, treten in Gasen auf; bei Flüssigkeiten ist die Dichteänderung fast immer vernachlässigbar.“"
                            },
