                        "examples": [
                            {
                                "example_id": "8668f008-85d8-4e1d-b970-5df79332aed7",
                                "sense_id": "4951f3f2-190a-3402-849d-798434a05c64",
                                "text": "„Niedrige Drahtgeflechte trennten die Bereiche voneinander, Emailletafeln wiesen auf die jeweiligen Gebresten hin.“"
                            },
                            {
                                "example_id": "1f8887a3-0220-4964-b362-03b2c61714dc",
                                "sense_id": "4951f3f2-190a-3402-849d-798434a05c64",
                                "text": "„Er weiß, wie ernst sein Zustand ist, nimmt ihn mit Humor und Mut auf sich und macht sich über sich selbst lustig, wie er sich über die Gebresten der anderen lustig macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
