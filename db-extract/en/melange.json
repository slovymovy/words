                    {
                        "translation_id": "ea6993fd-db4f-4117-a71b-23d39d0f7d4d",
                        "source_entry_id": "768ec385-c957-3a97-bdb9-da88121593a7",
                        "source_sense_description": "collection containing a variety of miscellaneous things",
                        "target_lang_word": "směs",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
