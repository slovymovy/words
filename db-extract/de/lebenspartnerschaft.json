                "senses": [
                    {
                        "sense_id": "32ea1f7b-bee5-3100-90e2-e12650acb510",
                        "entry_id": "c7a85096-7f9f-3532-a7a1-c1d504849598",
                        "glosses": [
                            "Beziehung zwischen zwei Menschen, die verschiedene Dinge des täglichen Lebens miteinander tun"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24ecc5d7-e5fb-4034-b5a1-fb2176e8fcfb",
                                "sense_id": "32ea1f7b-bee5-3100-90e2-e12650acb510",
                                "text": "Nach zwei Monaten des intensiven Kennenlernens entschlossen sie sich zu einer Lebenspartnerschaft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38319374-19a4-421c-8bcb-0cefa039b43e",
                        "source_entry_id": "c7a85096-7f9f-3532-a7a1-c1d504849598",
                        "source_sense_id": "32ea1f7b-bee5-3100-90e2-e12650acb510",
                        "source_sense_description": "Beziehung zwischen zwei Menschen, die verschiedene Dinge des täglichen Lebens miteinander tun",
                        "target_lang_word": "concubinage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concubinage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c58da29-03c6-3152-b3bb-85f458b04dfa",
                                        "entry_id": "de9045da-b9fa-3414-a030-349964874f10",
                                        "glosses": [
                                            "État d’un couple qui vit ensemble comme si les deux membres étaient mariés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e634acb0-b035-449b-923e-db28569ae27b",
                                                "sense_id": "2c58da29-03c6-3152-b3bb-85f458b04dfa",
                                                "text": "La réunion de ces circonstances, par un temps où l’on s’inquiète beaucoup trop des nègres, des petits condamnés de la police correctionnelle, pour s’occuper des honnêtes gens qui souffrent, fait que beaucoup de ménages honnêtes restent dans le concubinage, faute de trente francs, dernier prix auquel le Notariat, l’Enregistrement, la Mairie et l’Église puissent unir deux Parisiens."
                                            },
                                            {
                                                "example_id": "0ffdc635-cdd8-4c4f-a4c5-4231441b3424",
                                                "sense_id": "2c58da29-03c6-3152-b3bb-85f458b04dfa",
                                                "text": "Samuel connut toutes les tortures de la jalousie, et l’abaissement et la tristesse où nous jette la conscience d’un mal incurable et constitutionnel, — bref, toutes les horreurs de ce mariage vicieux qu’on nomme le concubinage."
                                            },
                                            {
                                                "example_id": "b5c50914-1fe3-4e8b-9f4f-c51c47aab75b",
                                                "sense_id": "2c58da29-03c6-3152-b3bb-85f458b04dfa",
                                                "text": "Elle préférait encore aller chez une de ses amies qui vivait en concubinage avec un homme."
                                            },
                                            {
                                                "example_id": "0078bc27-4d2f-46a3-bf30-beaf299c1d8b",
                                                "sense_id": "2c58da29-03c6-3152-b3bb-85f458b04dfa",
                                                "text": "Depuis que les mœurs étaient devenues moins rigides, beaucoup d’hommes libres à Rome et en Italie vivaient en concubinage avec des affranchies."
                                            },
                                            {
                                                "example_id": "df10529b-e9fa-4bcc-970e-a5d0772d7b96",
                                                "sense_id": "2c58da29-03c6-3152-b3bb-85f458b04dfa",
                                                "text": "Le phénomène de la croyance ou de l’admiration, qui n’est qu’une croyance éphémère, s’établit difficilement en concubinage avec l’idole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
