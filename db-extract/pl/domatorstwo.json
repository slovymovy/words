                "senses": [
                    {
                        "sense_id": "936c123a-1171-3be5-bd5c-7543fae024a6",
                        "entry_id": "427641f9-dec8-3ddd-9187-5121851abef0",
                        "glosses": [
                            "zamiłowanie do domowego życia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38f9acd4-2ce2-40bd-ad9e-07f07f8a9303",
                                "sense_id": "936c123a-1171-3be5-bd5c-7543fae024a6",
                                "text": "Pan Taszycki podkomorzy, człek wielkiego doświadczenia a rozumu w takich rzeczach, bardzo dobrze na to wszystko powiada: Domatorstwo, panie Stańczyku, domatorstwo ich gubi. Zapomnieli co życie publiczne"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b521de96-27a1-4147-9de8-586a6657fc97",
                        "source_entry_id": "427641f9-dec8-3ddd-9187-5121851abef0",
                        "source_sense_id": "936c123a-1171-3be5-bd5c-7543fae024a6",
                        "target_lang_word": "domesticity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domesticity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61c9c879-3fd9-3e1c-920d-96d6dab1e1cf",
                                        "entry_id": "48183280-2356-324e-b037-f3a0640fdc09",
                                        "glosses": [
                                            "Life at home; homelife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d76c8530-190c-44a9-aa18-575882c1afdd",
                                                "sense_id": "61c9c879-3fd9-3e1c-920d-96d6dab1e1cf",
                                                "text": "The Neolithic of 8000 to 6000 B.C. is in the sign of Cancer, a feminine sign associated with domesticity, retentiveness, and sentiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c66ec689-da4d-3606-9520-4eba86316726",
                                        "entry_id": "48183280-2356-324e-b037-f3a0640fdc09",
                                        "glosses": [
                                            "Domestic chores; housework."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d486e98a-0508-431f-baaf-6d85d1c5a3e4",
                                                "sense_id": "c66ec689-da4d-3606-9520-4eba86316726",
                                                "text": "Besides the jar of contrast there came to her a chill self-reproach that she had not returned sooner, to help her mother in these domesticities, instead of indulging herself out-of-doors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b0a7e35-521c-33d0-96d9-648f746a8da6",
                                        "entry_id": "48183280-2356-324e-b037-f3a0640fdc09",
                                        "glosses": [
                                            "Affection for the home and its material comforts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec85142-0c20-42a2-a28c-8856d0ef591f",
                                                "sense_id": "3b0a7e35-521c-33d0-96d9-648f746a8da6",
                                                "text": "As we have seen, Browning renovates her life-after-divorce by framing her domesticity in increasingly autoerotic terms. With her sensuous boudoir, lust for furniture, love affair with houses, and espousal of baked goods, hers is an appetitive domesticity geared to self-pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
