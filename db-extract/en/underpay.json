                                        "entry_id": "b8df03c2-e60b-34c7-b09d-8e97b7c4bcdc",
                                        "glosses": [
                                            "jemandem weniger Lohn/Gehalt/Entgelt geben, als für die Leistung angemessen ist oder einer Regelung entsprechend gezahlt werden sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca30b435-063f-445b-b764-a6a7571e638c",
                                                "sense_id": "66d7e0e7-d2fb-3ea6-bd3d-ecb964111395",
                                                "text": "„Den [den Tee] trinkst du mit schlechtem Gewissen, weil du ihn unterbezahlt hast und deshalb die Kaffeepflücker Guatemalas hungern.“"
                                            },
                                            {
                                                "example_id": "76729aed-c868-40f3-b5cd-8c52074766af",
                                                "sense_id": "66d7e0e7-d2fb-3ea6-bd3d-ecb964111395",
                                                "text": "„Ich erklärte meine Mandantinnen zu Opfern unserer heuchlerischen Gesellschaft, die Frauen unterbezahle, sie aber strafrechtlich verfolge, wenn sie sich zur Prostitution gezwungen sähen.“"
                                            },
                                            {
                                                "example_id": "418b5332-9596-4364-b0c2-48493fa3e960",
                                                "sense_id": "66d7e0e7-d2fb-3ea6-bd3d-ecb964111395",
                                                "text": "„Leonhards Masche, seine Galerie-Damen irgendwie gänzlich tariflos aber auf jeden Fall unterzubezahlen, führt zu dauernden Kündigungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
