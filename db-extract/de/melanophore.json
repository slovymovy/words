                "senses": [
                    {
                        "sense_id": "f0bb8a25-29cf-3e27-8664-76988dd2eaf8",
                        "entry_id": "69e47546-0138-3568-9f35-b00fb2f52f56",
                        "glosses": [
                            "Pigmentzelle, in welcher der Farbstoff Melanin produziert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76513cf7-5779-4fb3-a0f6-6eb8e682594b",
                                "sense_id": "f0bb8a25-29cf-3e27-8664-76988dd2eaf8",
                                "text": "„Über den Melanophoren breiten sich meist mit Guaninkörnern gefüllte Leukophoren (Guanophoren) aus, die von farbigen – gewöhnlich roten und gelben – Pigmentzellen überlagert werden.“"
                            },
                            {
                                "example_id": "aac7ae26-e93d-4cec-a70a-6efb8881b5a8",
                                "sense_id": "f0bb8a25-29cf-3e27-8664-76988dd2eaf8",
                                "text": "„Bufo vulgaris enthält in der Pigmentzone des Stratum spongiosum reichlich weit verzweigte Melanophoren, dazwischen diffus verteiltes braungrünes Pigment.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
