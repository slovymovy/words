{
    "word_family": [
        "disposed",
        "disposition",
        "predisposed",
        "predisposition"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3866ecd8-ebf1-3405-bc4a-8f8df747c6ba",
                    "sense_definition": "Feeling slightly ill or unwell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor was <w>indisposed</w> with a fever and had to cancel his lecture.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>недомогала</w> из-за высокой температуры и был вынужден отменить лекцию."
                            }
                        },
                        {
                            "text": "She felt slightly <w>indisposed</w> after the long flight and decided to rest.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя слегка <w>недомогающей</w> после долгого перелета и решила отдохнуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwell",
                        "sickly"
                    ],
                    "antonyms": [
                        "healthy",
                        "well"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий легкое недомогание или болезнь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недомогающий",
                                "target_lang_sense_clarification": "о человеке, который чувствует себя нездоровым"
                            },
                            {
                                "target_lang_word": "приболевший",
                                "target_lang_sense_clarification": "разговорный вариант, означающий легкое недомогание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56c955bb-b64f-330a-a407-9321845ff499",
                    "sense_definition": "Not willing or inclined to do something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>indisposed</w> to join the party after such a tiring day at work.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что <w>не расположен</w> идти на вечеринку после такого утомительного рабочего дня."
                            }
                        },
                        {
                            "text": "The committee was <w>indisposed</w> to accept the new proposal without further discussion.",
                            "target_lang_translations": {
                                "ru": "Комитет был <w>не склонен</w> принимать новое предложение без дальнейшего обсуждения."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwilling",
                        "reluctant",
                        "disinclined"
                    ],
                    "antonyms": [
                        "willing",
                        "inclined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не желающий или не склонный что-либо делать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несклонный",
                                "target_lang_sense_clarification": "не имеющий желания или расположения к действию"
                            },
                            {
                                "target_lang_word": "не расположенный",
                                "target_lang_sense_clarification": "не имеющий настроения или желания что-то делать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5099906f-8448-3e00-a208-8a780a211e44",
                    "sense_definition": "Currently using the bathroom or lavatory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "euphemism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host is currently <w>indisposed</w> but will be with you in a few minutes.",
                            "target_lang_translations": {
                                "ru": "Хозяин в данный момент <w>занят</w>, но подойдет к вам через несколько минут."
                            }
                        },
                        {
                            "text": "Please wait in the hallway while the guest is <w>indisposed</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подождите в коридоре, пока гость <w>занят</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a polite euphemism."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый эвфемизм для обозначения человека, который в данный момент находится в туалете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "занят",
                                "target_lang_sense_clarification": "вежливая форма, используемая, чтобы не называть причину отсутствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11230c32-2958-3b58-8873-57d5ac4a8cf2",
                    "sense_definition": "Not dressed or prepared to receive visitors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "euphemism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot see anyone right now as I am quite <w>indisposed</w>.",
                            "target_lang_translations": {
                                "ru": "Я сейчас никого не могу принять, так как я <w>не готов к приему</w>."
                            }
                        },
                        {
                            "text": "The actress was <w>indisposed</w> and could not come to the door to greet the fans.",
                            "target_lang_translations": {
                                "ru": "Актриса была <w>не готова к приему</w> и не смогла выйти к двери, чтобы поприветствовать фанатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "unprepared"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in formal or older contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не одетый или не готовый к приему гостей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не готов к приему",
                                "target_lang_sense_clarification": "о человеке, который не может принять посетителей из-за внешнего вида или занятости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}