                "senses": [
                    {
                        "sense_id": "61297899-71df-3565-be25-95171f2ab4ae",
                        "entry_id": "12954f35-f9d5-337a-a811-fd00d85186db",
                        "glosses": [
                            "een aantal bij elkaar staande huizen op het platteland qua grootte gelegen tussen een dorp en een buurtgemeenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "004af5c4-40d4-45d0-8f27-7d7ef983de78",
                                "sense_id": "61297899-71df-3565-be25-95171f2ab4ae",
                                "text": "Al dat eten stuurde ik vervolgens in zeven verschillende postdozen naar mezelf vooruit, omdat de trail alleen maar door de wildernis trok en de voedselprijzen erg hoog waren in de gehuchten waar ik af en toe langs zou komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "018a2f6a-9c0b-4850-a285-777a5dcb43b9",
                        "source_entry_id": "12954f35-f9d5-337a-a811-fd00d85186db",
                        "source_sense_id": "61297899-71df-3565-be25-95171f2ab4ae",
                        "source_sense_description": "een aantal bij elkaar staande huizen op het platteland",
                        "target_lang_word": "Weiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb84b31c-c540-3ed8-9114-f75a8430ce21",
                                        "entry_id": "db77476e-9528-3c7e-867f-adda7ce2c809",
                                        "glosses": [
                                            "Wohnsiedlung oder ein Gehöft bestehend aus wenigen Gebäuden, deutlich kleiner als ein Dorf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d02a1dc6-00d5-45e8-a886-f9191227ae27",
                                                "sense_id": "eb84b31c-c540-3ed8-9114-f75a8430ce21",
                                                "text": "In unserem Landkreis gibt es viele Weiler."
                                            },
                                            {
                                                "example_id": "14c7ef36-1627-4544-afc9-aab4c1c4eb7e",
                                                "sense_id": "eb84b31c-c540-3ed8-9114-f75a8430ce21",
                                                "text": "„In der gesamten Hallstatt- und Latènezeit war der Weiler, bestehend aus mehreren Gehöften, die weitverbreitetste Siedlungsform.“"
                                            },
                                            {
                                                "example_id": "62312e9e-097c-4c8a-8387-88d0f7694c61",
                                                "sense_id": "eb84b31c-c540-3ed8-9114-f75a8430ce21",
                                                "text": "„Vier Stunden später hielt ich hinter einem Weiler an und erfuhr, daß ich vierundzwanzig Meilen von Treviso entfernt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7707ded-0b9f-38f2-bcfc-515e2a9d9199",
                                        "entry_id": "2e0e3983-9476-3680-9ebd-74b0251ca137",
                                        "glosses": [
                                            "häufiger Ortsname im Südwesten des deutschsprachigen Raums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42439ab7-77b1-4261-9fa7-8e6cb108c195",
                                                "sense_id": "f7707ded-0b9f-38f2-bcfc-515e2a9d9199",
                                                "text": "Morgen fahren wir nach Weiler."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
