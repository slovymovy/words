                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Море сегодня <w>спокойно</w>, и мы можем поплавать на лодке.",
                            "target_lang_translations": {
                                "en": "The sea is <w>calm</w> today, and we can go boating.",
                                "zh": "今天海面<w>平静</w>，我们可以划船。"
                            }
                        },
                        {
                            "text": "Лицо его было <w>спокойно</w> и приветливо во время встречи.",
                            "target_lang_translations": {
                                "en": "His face was <w>calm</w> and welcoming during the meeting.",
                                "zh": "会面时，他的表情<w>平静</w>而亲切。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Free from turbulence or agitation (short form adjective)",
