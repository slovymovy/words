                {
                    "sense_id": "b8765c25-1831-31aa-9d70-c69f15dc6461",
                    "sense_definition": "Geweihter Versammlungsort oder Gebäude einer christlichen Glaubensgemeinschaft, in dem Gottesdienste und religiöse Rituale stattfinden.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "Gotteshaus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden Sonntag geht meine Familie zusammen in die <w>Kirche</w>."
                        },
                        {
                            "text": "Die alte <w>Kirche</w> im Zentrum der Stadt wurde vor vielen Jahrhunderten gebaut."
                        }
                    ],
                    "synonyms": [
                        "Kirchgebäude",
                        "Kirchengebäude"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "in die Kirche gehen",
                        "alte Kirche"
                    ]
                },
                {
                    "sense_id": "43d2c9d2-89ac-331e-b66a-df7ada1ebc22",
                    "sense_definition": "Christliche Glaubensgemeinschaft oder Konfession als Gesamtheit der Gläubigen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Gemeinschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Papst gilt als das weltweite Oberhaupt der katholischen <w>Kirche</w>."
                        },
                        {
                            "text": "In diesem Land gehören immer weniger Jugendliche einer christlichen <w>Kirche</w> an."
                        }
                    ],
                    "synonyms": [
                        "Konfession"
                    ],
                    "common_phrases": [
