                        "examples": [
                            {
                                "example_id": "4b15dedd-04cc-4201-a04d-9c5465631c5c",
                                "sense_id": "98476cbe-53d5-3981-8309-fa323fdf2d30",
                                "text": "Nooit eerder bracht een aquarel van de Nederlandse schilder zo veel geld op. Volgens veilinghuis Christie's, waar het werk onder de hamer ging, stond het vorige record voor een werk van Van Gogh in deze schildertechniek op bijna 15 miljoen dollar."
                            },
                            {
                                "example_id": "df2c9a35-f809-48a1-9d80-22dae402f2e2",
                                "sense_id": "98476cbe-53d5-3981-8309-fa323fdf2d30",
                                "text": "Rembrandt heeft het schilderij gemaakt rond 1630, aan het einde van zijn Leidse periode. Volgens Van de Wetering komt de schildertechniek namelijk overeen met hoe Rembrandt toen werkte."
                            }
