{
    "word_family": [
        "cheat",
        "cheating"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00322f3b-658a-390a-b4fd-bb7d9000abc6",
                    "sense_definition": "A person who acts dishonestly to gain an unfair advantage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonest_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game was ruined because a <w>cheater</w> was using illegal software to win.",
                            "target_lang_translations": {
                                "ru": "Игра была испорчена, потому что один <w>читер</w> использовал запрещенные программы для победы."
                            }
                        },
                        {
                            "text": "Teachers always watch the students closely to make sure no <w>cheater</w> can copy answers.",
                            "target_lang_translations": {
                                "ru": "Учителя всегда внимательно следят за учениками, чтобы ни один <w>обманщик</w> не мог списать ответы."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который поступает нечестно ради получения несправедливого преимущества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читер",
                                "target_lang_sense_clarification": "в играх"
                            },
                            {
                                "target_lang_word": "жулик",
                                "target_lang_sense_clarification": "нечестный человек, мошенник"
                            },
                            {
                                "target_lang_word": "обманщик",
                                "target_lang_sense_clarification": "тот, кто обманывает"
                            },
                            {
                                "target_lang_word": "списывальщик",
                                "target_lang_sense_clarification": "на экзамене или учебе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c773f12a-fb73-34e1-936a-5dfd90caa957",
                    "sense_definition": "A person who is unfaithful to their romantic partner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dishonest_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to leave her husband after discovering he was a serial <w>cheater</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила уйти от мужа после того, как узнала, что он был серийным <w>изменщиком</w>."
                            }
                        },
                        {
                            "text": "It is difficult to trust a <w>cheater</w> even after they promise to change their ways.",
                            "target_lang_translations": {
                                "ru": "Трудно доверять <w>изменщику</w>, даже если он обещает исправиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "adulterer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, изменяющий своему романтическому партнеру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменщик",
                                "target_lang_sense_clarification": "тот, кто изменяет партнеру"
                            },
                            {
                                "target_lang_word": "неверный партнер",
                                "target_lang_sense_clarification": "человек, нарушающий верность в отношениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8287ec08-2e29-3b5e-923b-14df22853700",
                    "sense_definition": "A tool or device used to make a difficult task easier, often by providing extra leverage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic used a long pipe as a <w>cheater</w> to loosen the rusted bolt.",
                            "target_lang_translations": {
                                "ru": "Механик использовал длинную трубу в качестве <w>удлинителя рычага</w>, чтобы ослабить заржавевший болт."
                            }
                        },
                        {
                            "text": "Without a <w>cheater</w> bar, the heavy nut would not budge from the engine block.",
                            "target_lang_translations": {
                                "ru": "Без <w>рычага-удлинителя</w> тяжелая гайка на блоке цилиндров не сдвинулась бы с места."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheater bar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент или приспособление для облегчения трудной работы, обычно за счет создания дополнительного рычага."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удлинитель рычага",
                                "target_lang_sense_clarification": "труба или надставка для ключа"
                            },
                            {
                                "target_lang_word": "рычаг",
                                "target_lang_sense_clarification": "приспособление для увеличения усилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}