                "senses": [
                    {
                        "sense_id": "1fd4747d-53a9-3337-8f6b-e275b792fe2a",
                        "entry_id": "191932ec-2840-3807-8cdb-8f3f1a52d8c9",
                        "glosses": [
                            "Gottesdienst, der am Sonntag gefeiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2e24b30-0558-4eef-95bf-559fdbcd80f7",
                                "sense_id": "1fd4747d-53a9-3337-8f6b-e275b792fe2a",
                                "text": "„Die Schönings waren gläubige Katholiken, weshalb die Familie regelmäßig die Sonntagsgottesdienste besuchte, aber jetzt wandte Herbert Schöning sich ganz seinem Glauben zu.“"
                            },
                            {
                                "example_id": "5578f8cb-a2d2-4a4d-b4ae-46670fe9922d",
                                "sense_id": "1fd4747d-53a9-3337-8f6b-e275b792fe2a",
                                "text": "„In beiden Gemeinden kamen jeweisl geschätzte 150 Menschen zum Sonntagsgottesdienst.“"
                            },
                            {
                                "example_id": "7cf65c8f-d1a0-425a-83cc-07062f5d7f63",
                                "sense_id": "1fd4747d-53a9-3337-8f6b-e275b792fe2a",
                                "text": "„Stattdessen hat er gesagt, dass wir morgen früh drüben in Cochem ein sehr gutes Sonntagsfrühstück essen und anschließend zum Sonntagsgottesdienst in die Kirche gehen würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
