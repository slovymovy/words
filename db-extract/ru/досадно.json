        "ru-extract.jsonl": [
            {
                "entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
                "word": "досадно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "60352db7-db54-30f0-aebc-9ec77fbb7ca1",
                        "entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
                        "glosses": [
                            "наречие к досадный; вызывая досаду — чувство неудовольствия, раздражения, явившееся результатом неудачи, обиды и т. п."
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "0a568fa9-5798-43cd-bbf0-1bb21b37e041",
                                "sense_id": "60352db7-db54-30f0-aebc-9ec77fbb7ca1",
                                "text": "— Чего орешь, дура! — досадно крикнул на неё Григорий."
                            }
                        ]
                    },
                    {
                        "sense_id": "2165a2f8-bd71-38c5-b45f-e6ac819fccce",
                        "entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
                        "glosses": [
                            "выражая досаду или свидетельствуя о ней"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a162ec8-ff71-4629-8d39-0c74692f71ad",
                                "sense_id": "2165a2f8-bd71-38c5-b45f-e6ac819fccce",
                                "text": "И вдруг, досадно омрачен, // вспомнил на второй затяжке // из трубки царственной и тяжкой, // что богу не молился он."
                            }
                        ]
                    },
                    {
                        "sense_id": "4104b5d4-ee12-3df6-97b0-259a430fdba8",
                        "entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
                        "glosses": [
                            "предик. оценочная характеристика ситуации, чьих-либо действий как вызывающих чувство неудовольствия, огорчения, досады"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdafda96-00db-4450-9f80-b87c27cd01fd",
                                "sense_id": "4104b5d4-ee12-3df6-97b0-259a430fdba8",
                                "text": "Терпенья, мочи нет, досадно."
                            },
                            {
                                "example_id": "60e979de-a10a-47ba-82b3-1c8aad6e6a85",
                                "sense_id": "4104b5d4-ee12-3df6-97b0-259a430fdba8",
                                "text": "Мы долго молча отступали, // Досадно было, боя ждали, // Ворчали старики: // «Что ж мы? на зимние квартиры? // Не смеют что ли командиры // Чужие изорвать мундиры // О русские штыки?»"
                            },
                            {
                                "example_id": "bc061c8d-7d75-41af-b765-af52c9841d63",
                                "sense_id": "4104b5d4-ee12-3df6-97b0-259a430fdba8",
                                "text": "И ей стало обидно и досадно до слёз."
                            },
                            {
                                "example_id": "ebf1307a-5bba-497a-a6bf-df706689784a",
                                "sense_id": "4104b5d4-ee12-3df6-97b0-259a430fdba8",
                                "text": "Да, да, в высшей степени досадно, что мы вчера с вами не свиделись."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be65a8c6-c3ba-40d4-98fa-e028b706648b",
                        "source_entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
                        "target_lang_word": "annoyingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "annoyingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "051816d4-b487-3a4d-a251-b377d1f1ce6f",
                                        "entry_id": "f1469bd4-6eed-38c4-9a95-9662fa1df62e",
                                        "glosses": [
                                            "In an annoying manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e362e3e-c392-4db2-90fd-cd6dbd8f96cb",
                                                "sense_id": "051816d4-b487-3a4d-a251-b377d1f1ce6f",
                                                "text": "Flies buzzed annoyingly around my head."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e157fb33-2bc2-47f1-b07c-f7433f1f993c",
                        "source_entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
                        "target_lang_word": "sadly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sadly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "In a sad manner; sorrowfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529f1844-2e6e-4fc6-af81-edb289395b38",
                                                "sense_id": "9bdac360-dbee-34b6-982f-ff1d605331d5",
                                                "text": "“Only when we climb up can we see it,” he said sadly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Unfortunately, sad to say."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0964bd-27ae-4666-aca3-d3b7d7c36207",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "If you think you’re getting out of this place alive, you are sadly mistaken, my friend."
                                            },
                                            {
                                                "example_id": "b17756d0-749d-4bc4-94db-7bf904012daa",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "Sadly, the two were never to meet again."
                                            },
                                            {
                                                "example_id": "9f744ee0-d37f-4e15-aa05-6060b3696a8d",
                                                "sense_id": "74575692-2332-325d-bc13-7b85f9e02e4c",
                                                "text": "Before kick-off, a section of Chelsea's support sadly let themselves and their club down by noisily interrupting the silence held in memory of the Hillsborough disaster and for Livorno midfielder Piermario Morosini, who collapsed and died after suffering a heart attack during a Serie B game on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "In a manner to cause sadness; badly; terribly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b263d3-18b1-402b-8f1a-5c52c1e0f944",
                                                "sense_id": "4ce4f8f1-a94e-3c01-9c35-f16a6eb6ff23",
                                                "text": "The people of Ebeltoft were once sadly plagued by them, as they plundered their pantries in a most unconscionable manner; so they consulted a very wise and pious man and his advice was, that they should hang a bell in the steeple of the church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Very much (of a desire etc.); dearly; urgently."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e7a445-8b43-4025-b3e1-a631670ef28e",
                                                "sense_id": "137725de-f8bd-36ac-b4bc-105465fbe964",
                                                "text": "\"Don't ask me: don't make me talk of it,\" she answered. \"I'm not fit now. I have been cruelly used and cruelly wronged. You will be kinder than ever, if you will walk on fast, and not speak to me. I sadly want to quiet myself, if I can.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                                        "entry_id": "59460819-6f7c-3f2d-ae80-6569fc152079",
                                        "glosses": [
                                            "Deeply, completely."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e242634e-fe64-471a-bceb-4c71f169fdc8",
                                                "sense_id": "cc809da5-f620-364c-94cb-ce70f6cd066a",
                                                "text": "By my feythe sayd syre launcelot in that pauelione wil I lodge alle this nyghte / and soo there he alyghte doune and tayed his hors to the pauelione / and there he vnarmed hym / and there he fond a bedde / and layd hym theryn / and felle on slepe sadly"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a069238-5a2b-4cfc-b1e6-80aa962af8d0",
                        "source_entry_id": "34efa8e5-c107-3909-b26e-c2f26266f187",
