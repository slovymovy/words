{
    "word_family": [
        "ozonize",
        "ozonizer",
        "ozonolysis",
        "ozonosphere",
        "ozonous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2215439a-3f46-3779-a165-e02057ff4e1a",
                    "sense_definition": "A form of oxygen with three atoms in each molecule, often found in the atmosphere or created by electrical discharge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemical_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ozone</w> layer protects the Earth from the harmful ultraviolet rays of the sun.",
                            "target_lang_translations": {
                                "ru": "<w>Озоновый</w> слой защищает Землю от вредных ультрафиолетовых лучей солнца."
                            }
                        },
                        {
                            "text": "After the lightning strike, a sharp smell of <w>ozone</w> filled the air.",
                            "target_lang_translations": {
                                "ru": "После удара молнии воздух наполнился резким запахом <w>озона</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ozone layer",
                        "ozone depletion",
                        "smell of ozone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма кислорода, состоящая из трех атомов в каждой молекуле, часто встречающаяся в атмосфере или образующаяся при электрическом разряде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озон",
                                "target_lang_sense_clarification": "химическое вещество O3"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "316a6449-4f3a-3c45-a79b-7c511f0625cd",
                    "sense_definition": "Fresh, invigorating air, especially the kind found at the seaside.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fresh_air",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the coast to breathe in some fresh sea <w>ozone</w> and improve our health.",
                            "target_lang_translations": {
                                "ru": "Мы отправились на побережье, чтобы подышать свежим морским <w>озоном</w> и поправить здоровье."
                            }
                        },
                        {
                            "text": "The morning walk by the cliffs provided a healthy dose of <w>ozone</w> and seaweed scent.",
                            "target_lang_translations": {
                                "ru": "Утренняя прогулка у скал подарила здоровую порцию <w>свежего воздуха</w> и аромат морских водорослей."
                            }
                        }
                    ],
                    "synonyms": [
                        "sea air"
                    ],
                    "common_phrases": [
                        "sea ozone",
                        "fresh ozone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used poetically or in travel contexts to describe sea air."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свежий, бодрящий воздух, особенно тот, который встречается на морском побережье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озон",
                                "target_lang_sense_clarification": "в поэтическом смысле о свежем воздухе"
                            },
                            {
                                "target_lang_word": "свежий воздух",
                                "target_lang_sense_clarification": "чистый бодрящий воздух"
                            },
                            {
                                "target_lang_word": "морской воздух",
                                "target_lang_sense_clarification": "воздух у побережья"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "536440c4-2c72-3568-a582-245bda3d5911",
                    "sense_definition": "To treat, purify, or affect something with ozone gas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemical_treatment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician <w>ozoned</w> the room to remove the persistent smell of smoke.",
                            "target_lang_translations": {
                                "ru": "Техник <w>проозонировал</w> помещение, чтобы устранить стойкий запах дыма."
                            }
                        },
                        {
                            "text": "They decided to <w>ozone</w> the water supply to ensure it was completely sterile.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>озонировать</w> водопроводную воду, чтобы гарантировать её полную стерильность."
                            }
                        }
                    ],
                    "synonyms": [
                        "ozonize"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical usage in cleaning or industrial processes."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать, очищать или воздействовать на что-либо газом озоном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озонировать",
                                "target_lang_sense_clarification": "подвергать действию озона"
                            },
                            {
                                "target_lang_word": "очищать озоном",
                                "target_lang_sense_clarification": "проводить дезинфекцию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}