                                "target_senses": [
                                    {
                                        "sense_id": "e36120f2-5bcd-3766-9ce8-bf2cd6ffd943",
                                        "entry_id": "02f4702c-16de-3a5f-a5a7-90ce107cea82",
                                        "glosses": [
                                            "so, dass man es niedlich findet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1927e3e7-5128-4890-bc04-55d16bff3165",
                                                "sense_id": "e36120f2-5bcd-3766-9ce8-bf2cd6ffd943",
                                                "text": "Das drollig aussehende Schnabeltier hat giftige Fersensporen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f2abc08-6b69-3b7c-95e8-23a2db9530b6",
                                        "entry_id": "02f4702c-16de-3a5f-a5a7-90ce107cea82",
                                        "glosses": [
                                            "so, dass man lachen möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65aea112-5f89-429d-9419-0e1d87e37e4e",
                                                "sense_id": "8f2abc08-6b69-3b7c-95e8-23a2db9530b6",
                                                "text": "Nicht lachen! Das ist überhaupt nicht drollig!"
                                            },
                                            {
                                                "example_id": "f339ffed-3070-4583-8df6-5643b407f43e",
                                                "sense_id": "8f2abc08-6b69-3b7c-95e8-23a2db9530b6",
                                                "text": "Sie sagte es so drollig, dass alle lachen mussten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f0a6394b-f074-31ae-9197-95ab09bcaae7",
                                        "entry_id": "02f4702c-16de-3a5f-a5a7-90ce107cea82",
                                        "glosses": [
                                            "so, dass es einem merkwürdig vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c9790c-d084-46de-bf43-07097ac034d9",
                                                "sense_id": "f0a6394b-f074-31ae-9197-95ab09bcaae7",
                                                "text": "Ist es nicht drollig, dass sie ausgerechnet jetzt Urlaub nimmt?"
                                            },
                                            {
                                                "example_id": "d26bf206-96c7-4590-a968-7fc72afa857c",
                                                "sense_id": "f0a6394b-f074-31ae-9197-95ab09bcaae7",
                                                "text": "Das ist jetzt aber eine drollige Ausrede gewesen!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ebb8e51-a85a-4438-b5e6-4037ebdff643",
                        "source_entry_id": "931ef79c-6257-3f2c-b4ef-3310bc9595bc",
                        "source_sense_id": "4c3ce5aa-a717-344e-b18c-eee279b327f0",
