                "translations": [
                    {
                        "translation_id": "d97d98f3-1145-4e81-a013-d8c12169947a",
                        "source_entry_id": "9d790914-34f3-3e3e-b754-660aeffcfb68",
                        "source_sense_id": "008a2be5-c90b-3575-be9b-d0bbb95dc051",
                        "target_lang_word": "spirometry",
