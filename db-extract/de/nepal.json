                                "sense_id": "80b5647c-c0be-3669-8a9f-5ef88a8f2b2c",
                                "text": "Nepal ist bei Bergsteigern beliebt."
                            },
                            {
                                "example_id": "c077d91f-1ff2-4ed7-b341-d7902af15923",
                                "sense_id": "80b5647c-c0be-3669-8a9f-5ef88a8f2b2c",
                                "text": "Kathmandu ist die Hauptstadt von Nepal."
                            },
                            {
                                "example_id": "fab0a75f-11b1-46ed-a927-b213e5dcb170",
                                "sense_id": "80b5647c-c0be-3669-8a9f-5ef88a8f2b2c",
                                "text": "Das heutige Nepal ist durch seine vielen verschiedenen Völker geprägt."
                            },
                            {
                                "example_id": "18b3ca3c-ef69-4afb-851f-3d33066263af",
                                "sense_id": "80b5647c-c0be-3669-8a9f-5ef88a8f2b2c",
                                "text": "„Er hatte sieben Jahre lang in der Hauptstadt Tibets und in den Zentren des Buddhismus in Bhutan und Nepal studiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
