                                "target_senses": [
                                    {
                                        "sense_id": "76c46971-3a70-3070-a7fb-c6507073fbfb",
                                        "entry_id": "7840418c-b833-3a52-97b5-c1223a29cc4f",
                                        "glosses": [
                                            "A flight of stairs; a stairway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e311c1f-6b1c-4fa9-bbb5-f8d7a08c0eb1",
                                                "sense_id": "76c46971-3a70-3070-a7fb-c6507073fbfb",
                                                "text": "I was on the staircase by the bell / Blinded by the black magician's spell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                        "entry_id": "7840418c-b833-3a52-97b5-c1223a29cc4f",
                                        "glosses": [
                                            "A connected set of flights of stairs; a stairwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fed937-7c37-48cc-9a58-18bfa3434696",
                                                "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "2be7a2ad-4e7d-43f7-8c82-edcf3c55a3cf",
                                                "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "2feb1466-1d9c-42cb-89dc-f0ca75d5385e",
                                                "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                                "text": "Oliver immediately gets a 'guided tour, Felix wheeling through libraries and endless colour-coded rooms, up and down staircases and along echoing halls where various \"dead relly[s]\" stare down from the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c71c303-768d-36ce-ace8-86ea31448bc1",
                                        "entry_id": "7840418c-b833-3a52-97b5-c1223a29cc4f",
                                        "glosses": [
                                            "A set of locks (enclosed sections of waterway) mounted one above the next."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "staircase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8cea6da-adf4-358d-ba4d-fd0ac2ac8bf8",
                                        "entry_id": "479c8de7-bf51-3f7b-bd40-1ed3a0c45b4a",
                                        "glosses": [
                                            "To modify (a signal, a graph, etc.) to reduce a smooth curve to a series of discrete steps."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa944f74-30bb-47f0-a004-46dee669f4e9",
                                                "sense_id": "a8cea6da-adf4-358d-ba4d-fd0ac2ac8bf8",
                                                "text": "This leads to much smoother reconstructions in regions of moderate gradient and thus prevents staircasing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c150bb2-df39-39c3-ac18-ce35bc457a26",
                                        "entry_id": "479c8de7-bf51-3f7b-bd40-1ed3a0c45b4a",
                                        "glosses": [
                                            "To increase one's share in a co-ownership."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18807d4-bd85-479b-bcbb-92c4f5e609b8",
                                                "sense_id": "5c150bb2-df39-39c3-ac18-ce35bc457a26",
                                                "text": "It is a good idea to make plans for staircasing when you first buy your shared ownership home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c37b1cc-cc30-4ced-9da5-43833b783bd0",
                        "source_entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
