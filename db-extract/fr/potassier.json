                        "glosses": [
                            "Industriel ou autrefois artisan qui fabriquait des engrais à base de composés potassiques"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a4d4187c-99eb-4dc2-aade-352245880df5",
                                "sense_id": "b9bcd094-6a5d-353f-b215-3f0c104592e8",
                                "text": "Une autre forme d'exploitation dans le domaine de la potasse est l'association entre un marchand et un potassier. Le potassier, qui n'a pas le capital nécessaire pour acheter un fond de commerce, doit s'en remettre à un tiers pour établir son commerce."
                            },
                            {
                                "example_id": "2346a1a8-9c8c-4fdc-9472-9d6b7ecc913d",
                                "sense_id": "b9bcd094-6a5d-353f-b215-3f0c104592e8",
                                "text": "Le travail du potassier consistait essentiellement en une calcination prolongée du salin qui détruisait une partie des impuretés et qui s'opérait dans un four spécial, assez semblable à un four de boulanger."
                            }
                        ]
                    }
