{
    "word_family": [
        "roezen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3f0861b-728b-3da4-9624-d5580f26d495",
                    "sense_definition": "Een toestand van lichte bedwelming of euforie door drank, drugs of sterke emoties.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was helemaal in een <w>roes</w> door de overwinning.",
                            "target_lang_translations": {
                                "en": "He was completely in a <w>state of euphoria</w> because of the victory."
                            }
                        },
                        {
                            "text": "De laatste zware klim gleed in een <w>roes</w> voorbij.",
                            "target_lang_translations": {
                                "en": "The last difficult climb passed by in a <w>daze</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedwelming",
                        "euforie",
                        "roes"
                    ],
                    "common_phrases": [
                        "in een roes"
                    ],
                    "target_lang_definitions": {
                        "en": "A state of light intoxication or euphoria caused by alcohol, drugs, or strong emotions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intoxication",
                                "target_lang_sense_clarification": "The state of being drunk or under the influence of a substance."
                            },
                            {
                                "target_lang_word": "euphoria",
                                "target_lang_sense_clarification": "A feeling of intense excitement or happiness."
                            },
                            {
                                "target_lang_word": "trance",
                                "target_lang_sense_clarification": "A state of being lost in thought or detached from reality."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffff7179-50b9-3ad7-a0c2-afd45a8a7d01",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>roe</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sint en zijn pieten dragen vaak <w>roes</w> bij zich.",
                            "target_lang_translations": {
                                "en": "Sinterklaas and his helpers often carry <w>rods</w> with them."
                            }
                        },
                        {
                            "text": "Vroeger werden kinderen gestraft met de <w>roes</w>.",
                            "target_lang_translations": {
                                "en": "In the past, children were punished with <w>switches</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of the noun 'roe' (a rod or switch used for punishment)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rods",
                                "target_lang_sense_clarification": "Thin sticks or switches used for corporal punishment."
                            },
                            {
                                "target_lang_word": "switches",
                                "target_lang_sense_clarification": "Flexible sticks used for whipping or punishment."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6aad17fa-4798-32cf-880e-9b324d0af6bf",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>roezen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>roes</w> na een glas wijn al snel.",
                            "target_lang_translations": {
                                "en": "I <w>get intoxicated</w> quickly after one glass of wine."
                            }
                        },
                        {
                            "text": "Elke avond <w>roes</w> ik weg bij de open haard.",
                            "target_lang_translations": {
                                "en": "Every evening I <w>drift into a daze</w> by the fireplace."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'roezen' (to become intoxicated or dazed)."
                    },
                    "translations": {
                        "en": [
                            {
