                "senses": [
                    {
                        "sense_id": "9278c94c-9d94-3339-89ce-cf94845b0e05",
                        "entry_id": "5f240e3b-173a-3489-9e57-e2a44b694e18",
                        "glosses": [
                            "хим. химический элемент с атомным номером 115, обозначается химическим символом Mc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d24ba16-1d54-447a-a99e-13d509b41bea",
                                "sense_id": "9278c94c-9d94-3339-89ce-cf94845b0e05",
                                "text": "Московий и оганессон внесены в таблицу Менделеева."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19cef77c-4d16-43b5-8f8c-3bee8aeb8d2f",
                        "source_entry_id": "5f240e3b-173a-3489-9e57-e2a44b694e18",
                        "source_sense_id": "9278c94c-9d94-3339-89ce-cf94845b0e05",
                        "target_lang_word": "moscovium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moscovium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f990a15-c9ae-3656-b4d0-ade8e09e9188",
                                        "entry_id": "9eacf9ce-32a7-3709-9061-8e5e5a2deb90",
                                        "glosses": [
                                            "The chemical element with atomic number 115."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d173d9-8ce5-4ae0-afbf-c3d92dcd8ab2",
                                                "sense_id": "6f990a15-c9ae-3656-b4d0-ade8e09e9188",
                                                "text": "In January 2016 the International Union of Pure and Applied Chemistry (IUPAC) announced the discovery of four new elements, so completing the seventh row of the periodic table. They have since been named as nihonium, Nh, muscovium^([sic]), Mc, tennessine, Ts, and organesson^([sic]), Og. The procedures for naming new elements are clearly laid out by IUPAC."
                                            },
                                            {
                                                "example_id": "8c4dc975-1e22-4de3-b430-ac3d12076587",
                                                "sense_id": "6f990a15-c9ae-3656-b4d0-ade8e09e9188",
                                                "text": "Researchers carefully choose the makeup of the beam and the target in hopes of producing a designer atom of the element desired. That’s how the four newest elements were created: nihonium (element 113), moscovium (115), tennessine (117) and oganesson (118) (SN Online: 11/30/16)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
