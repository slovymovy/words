                "senses": [
                    {
                        "sense_id": "f620fe03-dabb-31ca-8083-e2c25fdc4930",
                        "entry_id": "3ba9a412-aebe-3c1d-b199-78b38fbd54bd",
                        "glosses": [
                            "Glocke einer Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e94fc92-570e-4ba3-b735-f12f67962248",
                                "sense_id": "f620fe03-dabb-31ca-8083-e2c25fdc4930",
                                "text": "„Er war ein Klassenschwarm, mit seiner Lederjacke und den Band-Shirts aus den 80ern, seiner Gitarre, die neben ihm auf dem Boden in ihrem Kasten auf die letzte Schulglocke wartete.“"
                            },
                            {
                                "example_id": "8752afa9-c46a-45ba-96e1-e9d8800de4fa",
                                "sense_id": "f620fe03-dabb-31ca-8083-e2c25fdc4930",
                                "text": "„In die konnte sie sich voll und ganz vertiefen und hörte nicht einmal mehr, wenn der Lehrer etwas sagte oder die Schulglocke läutete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
