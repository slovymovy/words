                                                "sense_id": "bcb72cd2-bf8c-3536-b95a-2d6a122deb92",
                                                "text": "Tout cela n’est qu’ergotage."
                                            },
                                            {
                                                "example_id": "b980ae2f-47d2-45a7-a824-caaf37bbd4e6",
                                                "sense_id": "bcb72cd2-bf8c-3536-b95a-2d6a122deb92",
                                                "text": "Toute sa conversation n’est qu’un perpétuel ergotage."
                                            },
                                            {
                                                "example_id": "c3d8b72f-12b1-4da1-bf9f-6ca1ada2e81f",
                                                "sense_id": "bcb72cd2-bf8c-3536-b95a-2d6a122deb92",
                                                "text": "Suffit de le prendre, à propos de Bataille, en flagrant délit d’ergotage."
                                            }
                                        ]
