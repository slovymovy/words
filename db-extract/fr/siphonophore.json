                "senses": [
                    {
                        "sense_id": "2b6d865e-8d32-3bcd-aeab-92585fecaf3a",
                        "entry_id": "9e0a9afc-e668-3735-bd62-562a9fb0fb66",
                        "glosses": [
                            "Organisme zooplanctonique, souvent bioluminescent, vivant en colonies composées d'individus différenciés, et possédant des tentacules flottants équipés de cellules urticantes qui leur permettent de capturer leurs proies (larves, poissons, crustacés,…)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41c034a-158c-4b7d-b8f3-a3867e3b1ab9",
                                "sense_id": "2b6d865e-8d32-3bcd-aeab-92585fecaf3a",
                                "text": "Les siphonophores sont des cnidaires, comme les hydres, les méduses, les anémones de mer ou encore les coraux. Ils font partie des hydrozoaires (le groupe des hydres). Ce sont des organismes marins assimilés au zooplancton bien qu’ils puissent atteindre de grandes tailles (jusqu’à 40m de long)."
                            },
                            {
                                "example_id": "06885691-43e5-43f4-bf96-d92ea3fb9912",
                                "sense_id": "2b6d865e-8d32-3bcd-aeab-92585fecaf3a",
                                "text": "Malgré les apparences, la Physalie ou Galère portugaise n'est pas une sorte de méduse, mais une colonie de siphonophores."
                            }
                        ]
                    }
                ],
                "translations": [
