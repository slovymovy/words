        "nl-extract.jsonl": [
            {
                "entry_id": "066dd58e-7578-32eb-8dbb-bd4b96596b93",
                "word": "boekje",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "41685528-acf7-3e6a-a9f0-d1b828e23aba",
                        "entry_id": "066dd58e-7578-32eb-8dbb-bd4b96596b93",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord boek"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "725ce312-1faf-48f5-b01a-c9ed47e3d627",
                                "sense_id": "41685528-acf7-3e6a-a9f0-d1b828e23aba",
                                "text": "'Neel Ik moest van haar een adresboek pakken en daar zat die brief in! Maar luister, in dat boekje zat ook een telegram van Harold Schloss, uit juli 1936."
                            },
                            {
                                "example_id": "7c90201e-d8c7-410c-bfaf-f9b1837766a7",
                                "sense_id": "41685528-acf7-3e6a-a9f0-d1b828e23aba",
                                "text": "ﬁ Een vriendin, de oudste uit een nest van vier, drukt me een boekje in handen dat volgens haar moeder een veelbesproken titel was op het schoolplein van de vrije school in de jaren negentig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0173258b-a469-4657-a4e2-3219c685487a",
                        "source_entry_id": "066dd58e-7578-32eb-8dbb-bd4b96596b93",
                        "source_sense_id": "41685528-acf7-3e6a-a9f0-d1b828e23aba",
                        "source_sense_description": "verkleinwoord enkelvoud van boek",
                        "target_lang_word": "Büchlein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büchlein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2813593f-e122-32e2-b207-cf12ad8dd9ca",
                                        "entry_id": "051b462e-d968-343e-9ed4-1a2add69d682",
                                        "glosses": [
                                            "ein kleines Buch"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6eb960a6-8043-4d09-8d22-7482a92acc03",
                                                "sense_id": "2813593f-e122-32e2-b207-cf12ad8dd9ca",
                                                "text": "Er hatte immer ein Büchlein für Notizen bei sich."
                                            },
                                            {
                                                "example_id": "ef8f721d-3547-453e-94f7-2d9aa3fd99a4",
                                                "sense_id": "2813593f-e122-32e2-b207-cf12ad8dd9ca",
                                                "text": "„Das Büchlein hat das Genre der Reiseliteratur auf den Kopf gestellt.“"
                                            },
                                            {
                                                "example_id": "f4eaf9ce-6549-4993-96c6-8d065b851baa",
                                                "sense_id": "2813593f-e122-32e2-b207-cf12ad8dd9ca",
                                                "text": "„Doch solche Tricks waren eine kleine Erleichterung für römische Leser, die sich ja dann im zweiten, regional gegliederten Teil des Büchleins durch einen Wust bizarrer Stammes- und Ortsnamen kämpfen mussten.“"
                                            },
                                            {
                                                "example_id": "c3e80f2f-7362-43fe-8eee-8f140af75b71",
                                                "sense_id": "2813593f-e122-32e2-b207-cf12ad8dd9ca",
                                                "text": "„Jedes der Länder ist mit einer Nummer bezeichnet, und ein beigelegtes Büchlein gibt an, welche Tugend oder Untugend in diesem Staat residiert.“"
                                            },
                                            {
                                                "example_id": "3f6b886a-63f6-44a5-8dbf-2f265b903117",
                                                "sense_id": "2813593f-e122-32e2-b207-cf12ad8dd9ca",
                                                "text": "„Der folgende Redner, den ich nicht kannte, hatte mein Büchlein gelesen und äußerte sein Wohlwollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be2d16f0-fb3a-486c-b6e7-2f8618254ef8",
                        "source_entry_id": "066dd58e-7578-32eb-8dbb-bd4b96596b93",
