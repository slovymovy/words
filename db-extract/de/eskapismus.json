                        "examples": [
                            {
                                "example_id": "2c37fbc5-c934-4b94-a495-4de38164d054",
                                "sense_id": "5113cf31-29cd-32a2-8cab-1fbb98550b89",
                                "text": "In „Let’s Not Talk About the War“ lässt Imler widersprüchliche Aussagen aufeinanderprallen. Trotz scharfer Kanten sorgt die ambivalent verhandelte Sehnsucht nach Eskapismus für einen vergleichsweise geschmeidigen Groove: „Let us talk about the time / Before the internet was born. […] Let us tell some jokes / That we’ve told 20,000 times before / About our souls that we’ve sold.“"
                            }
                        ]
                    }
