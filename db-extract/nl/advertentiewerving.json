                        "examples": [
                            {
                                "example_id": "decc5cc1-d20f-450d-887c-1ed00cad39b5",
                                "sense_id": "2dcf803d-cb4f-345e-b81e-afdd06a37a1a",
                                "text": "De stichting NIW wordt formeel weer zelf de uitgever van het blad, waarbij De Groene Amsterdammer de uitgeefdiensten verleent, zorgt voor de (abonnementen)administratie, het bladmanagement, de advertentiewerving en de marketing."
                            },
                            {
                                "example_id": "0fea0900-5fa2-4142-9120-3f1a0e7cba4f",
                                "sense_id": "2dcf803d-cb4f-345e-b81e-afdd06a37a1a",
                                "text": "Ik schreef toen: ‘In wezen zijn het dezelfde vragen die over advertenties gesteld worden. Daar is het klassieke antwoord: “Er staat een muur tussen de redactie en de advertentiewerving, de ene beïnvloedt de andere niet.” Die afspraak werkt: lezers accepteren dat een krant de column van Joris Luyendijk over de Londense City plaatst, en een paar pagina’s verder een advertentie voor een bank. Nu ligt dat moeilijker, omdat hetzelfde bedrijf onder dezelfde naam beide aanbiedt.’"
                            }
                        ]
                    }
