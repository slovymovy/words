                        "translation_id": "a8ecf5aa-67bc-470d-913a-620daf7b53f7",
                        "source_entry_id": "b6ac56d6-b5ae-3785-9910-b4fbe9b889d7",
                        "source_sense_id": "e5794d4c-ee4b-3931-8417-0bf1d699331d",
