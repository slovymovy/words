                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fraction one-fourth results in a <w>terminating</w> decimal.",
                            "target_lang_translations": {
                                "ru": "Дробь одна четвёртая даёт <w>конечную</w> десятичную дробь."
                            }
                        },
                        {
                            "text": "Students must distinguish between a <w>terminating</w> decimal and a repeating one.",
                            "target_lang_translations": {
                                "ru": "Студенты должны различать <w>конечную</w> десятичную дробь и периодическую."
                            }
                        }
                    ],
                    "synonyms": [
                        "finite"
                    ],
                    "antonyms": [
                        "nonterminating"
                    ],
                    "common_phrases": [
                        "terminating decimal"
                    ],
                    "target_lang_definitions": {
                        "ru": "О десятичной дроби: имеющий конечное число знаков после запятой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конечный",
                                "target_lang_sense_clarification": "в математическом контексте о дробях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13636daa-a3c5-341c-bd33-87489c07c4f9",
