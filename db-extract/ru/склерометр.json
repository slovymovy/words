                                    {
                                        "sense_id": "e9cd6cd1-54fa-3271-99de-af5ff8468a11",
                                        "entry_id": "1336a67f-3a90-3df5-8d27-17bf7f37336f",
                                        "glosses": [
                                            "Vorrichtung zur Bestimmung der Härte eines Festkörpers (besonders von Mineralien)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19542214-ccec-4686-a18e-16e0bf38724a",
                                                "sense_id": "e9cd6cd1-54fa-3271-99de-af5ff8468a11",
                                                "text": "„Zur ungefähren quantitativen Härtebestimmung dient das Ritzverfahren im Sklerometer […].“"
                                            },
                                            {
                                                "example_id": "ba7e04a5-9391-492a-bab5-7c11f9f19d04",
                                                "sense_id": "e9cd6cd1-54fa-3271-99de-af5ff8468a11",
                                                "text": "„Der Verfasser dieser Schrift gibt zuerst die von ihm mit Hilfe eines Sklerometers angestellten Härtebeobachtungen, welche die Untersuchung von 116 Flächen an 17 verschiedenen Substanzen umfassen.“"
                                            },
                                            {
                                                "example_id": "ef9bd667-0273-4b19-8222-6856f98120a7",
                                                "sense_id": "e9cd6cd1-54fa-3271-99de-af5ff8468a11",
                                                "text": "„Turner bestimmte die Härte von verschiedenen Metallen (Blei, Zinn, Zink, Kupfer und von zahlreichen Stahl- und Eisensorten) mittelst des Seebeck-Franz’schen Sklerometers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
