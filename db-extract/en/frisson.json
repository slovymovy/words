                                "target_word": "Anwandlung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17302a1a-7047-3e98-ad0d-1937f8b1ad2a",
                                        "entry_id": "8818f923-2bc0-3ea4-974e-f24cecdb2e20",
                                        "glosses": [
                                            "plötzliche kurzzeitige Änderung des Gemütszustandes, der Stimmung; plötzlicher (seltsamer) Einfall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f03f5bd-fde5-4054-8594-476c5f313ba1",
                                                "sense_id": "17302a1a-7047-3e98-ad0d-1937f8b1ad2a",
                                                "text": "„In einer Anwandlung von moralischem Rigorismus und Enttäuschung begeht der Enkelsohn Selbstmord.“"
                                            },
                                            {
                                                "example_id": "c830ce80-1958-4bee-9a53-1754f6e545f2",
                                                "sense_id": "17302a1a-7047-3e98-ad0d-1937f8b1ad2a",
                                                "text": "„Erst vor kurzem forderte die FPÖ in einer Anwandlung von brauchtumspflegerischem Protektionismus, die traditionsbewusste Gastronomie stärker zu fördern. Österreich soll zu einer Festung des Vermeidungsverhaltens ausgebaut werden, die anhaltendem Kebab- und Pizza-Beschuss dauerhaft Stand hält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
