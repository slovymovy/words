                "senses": [
                    {
                        "sense_id": "651d4cce-6829-3668-9ac8-11fa284398d2",
                        "entry_id": "82383bf1-a572-3459-92cb-109eea168de2",
                        "glosses": [
                            "Angehöriger eines (fast ausgestorbenen) brasilianischen Indianerstammes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5971d2a2-6936-4dc1-8d11-72dcd38fc749",
                                "sense_id": "651d4cce-6829-3668-9ac8-11fa284398d2",
                                "text": "Einige Botokuden sollen noch in Reservaten leben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f6f0f07-a161-31f9-9d96-5d88727353d2",
                        "entry_id": "82383bf1-a572-3459-92cb-109eea168de2",
                        "glosses": [
                            "Inbegriff eines unzivilisierten Menschen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d0e456c3-67a8-4ad0-8e72-ac584de9a3a2",
                                "sense_id": "7f6f0f07-a161-31f9-9d96-5d88727353d2",
                                "text": "Wir sind hier nicht bei den Botokuden!"
                            },
                            {
                                "example_id": "46c85066-ddfb-44eb-bbb4-727ced72b86b",
                                "sense_id": "7f6f0f07-a161-31f9-9d96-5d88727353d2",
                                "text": "„Ich saß rechts neben Volker, und weil ich Linkshänder war, kamen wir uns immer mit den Ellbogen ins Gehege, bis wir ein für allemal umgesetzt wurden, Volker nach rechts und ich nach links, damit wir uns nicht mehr benahmen wie die Botokuden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
