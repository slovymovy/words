                                        ],
                                        "examples": [
                                            {
                                                "example_id": "154c24c8-337a-406e-bcfc-989212d5239f",
                                                "sense_id": "3dbf5e08-4a2a-3ed9-8ac1-de0f0f38772c",
                                                "text": "Das Unternehmen fabriziert Kugellager."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca33e3ed-15a3-34a3-b0e8-dda436a09e91",
                                        "entry_id": "cc862469-09bf-31f6-bcb6-be3b8f5f13c2",
                                        "glosses": [
                                            "etwas eigenhändig anfertigen – eher nicht besonders geschickt oder gut, mit einfachen Mitteln, aber mit gewissem Erfindungsreichtum"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative",
                                            "humorous",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34825b5b-503b-4f13-9b12-47ac285e9308",
                                                "sense_id": "ca33e3ed-15a3-34a3-b0e8-dda436a09e91",
                                                "text": "Was hast du denn da für ein tolles „Kunstwerk“ fabriziert?"
                                            },
                                            {
                                                "example_id": "e9d4d07a-e1df-4489-95d9-d1cc463ae088",
                                                "sense_id": "ca33e3ed-15a3-34a3-b0e8-dda436a09e91",
                                                "text": "„So war er einer, der immer etwas fabrizierte, und das war das Eigentliche, worauf er aus war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3826b4e3-1f91-3a49-a6f6-6d9d6cf37d17",
                                        "entry_id": "cc862469-09bf-31f6-bcb6-be3b8f5f13c2",
                                        "glosses": [
                                            "etwas Schlimmes oder Schlechtes verursachen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5ae2db-7a24-4e12-9b66-0ff9b9f7eff9",
                                                "sense_id": "3826b4e3-1f91-3a49-a6f6-6d9d6cf37d17",
                                                "text": "„Bryant kam lediglich auf 20 Punkte und fabrizierte obendrein sieben Ballverluste.“"
                                            },
                                            {
                                                "example_id": "5d97a984-7c20-4328-85b7-ab3817dc1f64",
                                                "sense_id": "3826b4e3-1f91-3a49-a6f6-6d9d6cf37d17",
                                                "text": "Betrunken, wie er war, fabrizierte er prompt einen Verkehrsunfall."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
