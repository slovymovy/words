                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e76697-e55c-4d5f-945b-1d4827e60d67",
                                "sense_id": "74b518f9-79ca-33b1-bf0a-5b69086b28b2",
                                "text": "We zijn gisteren naar een prachtig ballet geweest."
                            },
                            {
                                "example_id": "8e2b0c3f-ffb0-413e-91ab-293de01b2c7f",
                                "sense_id": "74b518f9-79ca-33b1-bf0a-5b69086b28b2",
                                "text": "We zijn naar het Russisch gezelschap geweest om het ballet het Zwanenmeer te zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a84708f3-adca-4a32-a28a-c2f50f671e10",
                        "source_entry_id": "1368107e-a4f5-3b7e-917d-4455d8c6921b",
                        "source_sense_id": "74b518f9-79ca-33b1-bf0a-5b69086b28b2",
                        "source_sense_description": "een artistieke dansvorm",
                        "target_lang_word": "Ballett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ballett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6fb7bf0-8485-3328-9891-37c737b7971a",
                                        "entry_id": "9cc11447-323f-360a-b3d7-bea7154e490d",
                                        "glosses": [
                                            "Kunstform am Theater neben Oper und Schauspiel; die Kunst des Tanzes"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84f96d46-15df-4eb9-8378-2babb793b0fe",
                                                "sense_id": "e6fb7bf0-8485-3328-9891-37c737b7971a",
                                                "text": "Um Ballett tanzen zu können, ist jahrelanges Training erforderlich."
                                            },
                                            {
                                                "example_id": "bbadbb06-ae0e-4c90-8c0d-8b05d1e67053",
                                                "sense_id": "e6fb7bf0-8485-3328-9891-37c737b7971a",
                                                "text": "„Von einer Tänzerin erfuhr ich, dass man beim Ballett gleichzeitig schweben und stabiler als jemand sonst auf dem Boden stehen könne.“"
                                            },
                                            {
                                                "example_id": "749398f3-af20-402b-9e28-309117875e51",
                                                "sense_id": "e6fb7bf0-8485-3328-9891-37c737b7971a",
                                                "text": "„Während des Balletts legte sie das Textbuch auf die Logenbrüstung; da sah ich, wie die männliche Maske herüberlangte und es fortnahm.“"
                                            },
                                            {
                                                "example_id": "352ab878-8b96-457b-b186-bf7d8e92df47",
                                                "sense_id": "e6fb7bf0-8485-3328-9891-37c737b7971a",
                                                "text": "„Einer festen Freundin am nächsten kam in jenem Jahr eine sprunghafte Doktorandin namens Pat McEnerney, die kurz zuvor das Ballett aufgegeben und beschlossen hatte, Lehrerin zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61f434e5-fa74-378a-bf43-4e7786b1c284",
                                        "entry_id": "9cc11447-323f-360a-b3d7-bea7154e490d",
                                        "glosses": [
                                            "konkrete Vorstellung dieser Kunstform; Tanz auf der Bühne zu Musikbegleitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13df70e-cec5-4581-a563-90f50553f5cd",
                                                "sense_id": "61f434e5-fa74-378a-bf43-4e7786b1c284",
                                                "text": "Am Samstag haben wir uns ein tolles Ballett angeschaut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4d7273c5-04b2-304a-b8ab-223c212e5d75",
                                        "entry_id": "9cc11447-323f-360a-b3d7-bea7154e490d",
                                        "glosses": [
                                            "Ensemble von Tänzern, zum Beispiel eines Theaters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcad01da-eedb-4908-81bc-57529f507302",
                                                "sense_id": "4d7273c5-04b2-304a-b8ab-223c212e5d75",
                                                "text": "Die Tänzer des Balletts begeisterten die Zuschauer."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597b94de-6357-4dec-8f12-ad5dd81db81e",
                        "source_entry_id": "1368107e-a4f5-3b7e-917d-4455d8c6921b",
                        "source_sense_id": "74b518f9-79ca-33b1-bf0a-5b69086b28b2",
