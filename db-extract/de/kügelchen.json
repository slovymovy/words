                        ],
                        "form": "das Kügelchen"
                    },
                    {
                        "form_id": "ed02176f-9b9a-43fb-8606-685fe9f438b9",
                        "entry_id": "941083c0-f904-3adc-8191-00e1ea03396a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kügelchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7289b4f3-19b8-36c2-b6ee-66018a2ec54c",
                        "entry_id": "941083c0-f904-3adc-8191-00e1ea03396a",
                        "glosses": [
                            "kleines kugelförmiges Objekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea36d639-9172-4795-9018-d045bf72b9cc",
                                "sense_id": "7289b4f3-19b8-36c2-b6ee-66018a2ec54c",
                                "text": "Dreierlei Kügelchen finden sich wie gesagt zunächst in den Atomen: 1. Zwei Arten elektrisch geladener, nämlich a) positiv geladene Kügelchen, die „Protonen“ und b) an die 2000mal leichtere, negativ geladene Kügelchen, die „Elektronen“."
                            },
                            {
                                "example_id": "032bf641-b37c-4ab4-996c-531757f2cdf2",
                                "sense_id": "7289b4f3-19b8-36c2-b6ee-66018a2ec54c",
                                "text": "„Sie bohrte eine Weile nachdenklich in der Nase, strich übers Haar, suchte nach Brotkrumen auf dem Küchentich, machte kleine Kügelchen, schnippte sie spielerisch mit dem Finger, zielte absichtlich gegen die Hand von Max Schulz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22738d0f-4f09-45d7-a6e5-a9fec571ec23",
                        "source_entry_id": "941083c0-f904-3adc-8191-00e1ea03396a",
                        "source_sense_id": "7289b4f3-19b8-36c2-b6ee-66018a2ec54c",
                        "source_sense_description": "kleines kugelförmiges Objekt",
                        "target_lang_word": "шарик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шарик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "83b97782-e0b3-3269-92b7-7e79a80b7b63",
                                        "entry_id": "8e101ed6-4799-3ec9-8e7c-8e7b8037b50b",
                                        "glosses": [
                                            "уменьш. к шар; маленький шар"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdc5d9f-9414-484b-b53e-762fb398cd17",
                                                "sense_id": "83b97782-e0b3-3269-92b7-7e79a80b7b63",
                                                "text": "Он схватил обоих своих юных друзей и стал, ко всеобщему удивлению, жонглировать ими, словно это были не хорошо упитанные тринадцатилетние мальчики, а пластмассовые шарики комнатного бильярда."
                                            },
                                            {
                                                "example_id": "ae81f89a-e859-4869-8389-625625bfdd71",
                                                "sense_id": "83b97782-e0b3-3269-92b7-7e79a80b7b63",
                                                "text": "Я закрыл чемодан. Внутри гулко перекатывались шарики нафталина. Вещи пёстрой грудой лежали на кухонном столе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ea2448-a1c3-3b48-b02d-2b723781f0eb",
                                        "entry_id": "8e101ed6-4799-3ec9-8e7c-8e7b8037b50b",
                                        "glosses": [
                                            "биол., устар. частица вещества крови"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63bd867c-2efd-4f0d-ba83-1468dd1c3ea3",
                                                "sense_id": "76ea2448-a1c3-3b48-b02d-2b723781f0eb",
                                                "text": "Необходимый организму кислород доставляют красные кровяные шарики, которые захватывают его в лёгких при вдыхании."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                        "entry_id": "8e101ed6-4799-3ec9-8e7c-8e7b8037b50b",
                                        "glosses": [
                                            "жарг., мн. ч. умственные способности, мозги"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d724d21-d417-476e-bea0-39340348d0cf",
                                                "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                                "text": "— Ша́рик у тебя работает — вижу! — непохоже на себя заявил Пухов."
                                            },
                                            {
                                                "example_id": "a6e9c2ad-977c-4bdb-93a0-34d02fb18b32",
                                                "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                                "text": "Шарики у него в голове хорошо крутятся."
                                            },
                                            {
                                                "example_id": "8d428f55-7e61-49ec-a93f-e433a8b7fff7",
                                                "sense_id": "c3d931ec-4ff0-3c59-b073-513667116dca",
                                                "text": "Не то что я, грешник, — подскочу к столу на три-четыре часа, покатаю в голове какие-то там шарики, и выскочит диалог, а то и сценка, что Бог подаст."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b88b6945-9277-42c9-8d51-f9b955b1b498",
                        "source_entry_id": "941083c0-f904-3adc-8191-00e1ea03396a",
                        "source_sense_id": "7289b4f3-19b8-36c2-b6ee-66018a2ec54c",
                        "source_sense_description": "kleines kugelförmiges Objekt",
                        "target_lang_word": "kulička",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kulička",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2aed618e-f85a-346a-8998-e747c06f1439",
                                        "entry_id": "ac53e14b-15b3-31e1-b815-4a6012d343d0",
                                        "glosses": [
                                            "koule"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc6988e-84e1-436f-905d-43757fb4eff4",
                                                "sense_id": "2aed618e-f85a-346a-8998-e747c06f1439",
                                                "text": "Všecko, co nevíme, je tu jako možnost, a každý fakt je jedna kulička v růženci předchozích i budoucích eventualit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
