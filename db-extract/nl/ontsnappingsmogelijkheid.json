                                            {
                                                "example_id": "a861d556-2fc3-4eb5-8cdc-11cbd68787a2",
                                                "sense_id": "f9406ec9-32d1-3ff2-9b8d-08d5b3beb208",
                                                "text": "He lives way out in the middle of nowhere."
