                        "examples": [
                            {
                                "example_id": "9b38d10b-43e6-44c7-b1b9-01cf7d045038",
                                "sense_id": "f29a2df2-25e2-3c79-9137-5ccd09ff415f",
                                "text": "Met het groene waas van heel de achterstraat glansden de algen aan de gevel."
                            },
                            {
                                "example_id": "3410def4-6ee4-4237-b476-563251cec41b",
                                "sense_id": "f29a2df2-25e2-3c79-9137-5ccd09ff415f",
                                "text": "„Had veel eerder moeten gebeuren”, zegt een buurtbewoner. De buurt had al langer last van het internetcafé aan de Achterstraat. De politie heeft met de douane een inval gedaan. Twee verdachten zijn aangehouden, ook werden er drugs aangetroffen. „Het heeft veel te lang aangemodderd”, moppert een bewoner van de Woerdense Achterstraat, die zijn naam niet wil noemen."
                            }
                        ]
