                ],
                "senses": [
                    {
                        "sense_id": "74397ba4-1017-3f34-b834-6ea28a9c206f",
                        "entry_id": "40743106-71cd-39c8-b7dd-7945ec1b977c",
                        "glosses": [
                            "Disziplin, die stilistische Phänomene (in Sprache oder Kunst) mit den Mitteln der Statistik untersucht"
                        ],
                        "tags": [
                            "Linguistik/Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "6354b474-ab8e-4a70-ac1b-6b5a57a78f74",
                                "sense_id": "74397ba4-1017-3f34-b834-6ea28a9c206f",
                                "text": "Die Stilometrie befasst sich unter anderem mit dem Problem, die Autoren anonymer Schriftstücke/ Werke zu identifizieren."
                            },
                            {
                                "example_id": "a98fbcf6-5fd6-42f7-9b76-0152eed55a85",
                                "sense_id": "74397ba4-1017-3f34-b834-6ea28a9c206f",
                                "text": "„Auf N. A. Morozov (1854-1946)…geht die Einführung des Begriffs ‚stilometrija // Stilometrie‘ in Russland zurück…“"
                            },
                            {
                                "example_id": "7f82c137-8a60-4dec-a6ef-c3442de908a7",
                                "sense_id": "74397ba4-1017-3f34-b834-6ea28a9c206f",
                                "text": "„Die Gesamtheit der mit den Mitteln der Stilometrie gefundenen Charakteristika bestimmt objektiv seine Besonderheit im Vergleich mit anderen Texten, vermag jedoch nicht, seine dichterische Qualität zu erfassen.“"
                            },
                            {
                                "example_id": "6680c910-c73f-407f-bd4b-218fd90863b1",
                                "sense_id": "74397ba4-1017-3f34-b834-6ea28a9c206f",
                                "text": "„Die Stilometrie hat ihren Ursprung in der Literatur.“"
                            },
                            {
                                "example_id": "309db91b-630d-4d62-a12c-743f475156d1",
                                "sense_id": "74397ba4-1017-3f34-b834-6ea28a9c206f",
                                "text": "„Das Verfahren heißt Stilometrie, was etwa \"Ausmessen des (Schreib-)stils\" bedeutet. Stilometrie geht grundsätzlich so vor: Um herauszufinden, ob ein Text X von Autorin A oder Autor B stammt, werden zuerst möglichst viele Texte von A und B auf Grundmuster hin durchleuchtet, dann schaut man, ob X nun eher die Merkmale von A oder von B zeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
