                                        "sense_id": "b5487bbe-8059-3b56-b9ce-f2ac760f6ff7",
                                        "entry_id": "abd0c3cd-0700-38f8-8a08-6383efdd23db",
                                        "glosses": [
                                            "The doctrine that this world is the worst of all possible worlds."
