                "senses": [
                    {
                        "sense_id": "909961d5-0b86-3b58-9590-d79b4af65897",
                        "entry_id": "b2a75863-7c8b-3eaa-a2d5-de5d2649bc48",
                        "glosses": [
                            "Gruppe mehrerer Sprachen, die vor allem im Südwesten Chinas gesprochen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a181e1-d3d7-491f-aa21-82f9d1499ae7",
                                "sense_id": "909961d5-0b86-3b58-9590-d79b4af65897",
                                "text": "„Auch kleinere Sprachen wie Xibe, Jingpo, Yi, Zhuang, Lisu, Lahu und Va werden in der Prim[ä]rstufe unterrichtet.“"
                            },
                            {
                                "example_id": "8ba5374e-e854-45b6-885f-fa6a9c43ee0c",
                                "sense_id": "909961d5-0b86-3b58-9590-d79b4af65897",
                                "text": "„Würde für das Chinesische – ähnlich wie für das Yi – eine Silbenschrift mit konventionell festgelegten individuellen Zeichen für spezifische Silbenstrukturen konzipiert, hätte dies den Vorteil, daß die Zahl der Schriftzeichen, die derzeit verwendet werden, drastisch reduziert würde.“"
                            },
                            {
                                "example_id": "7d2ec658-07f0-48fe-8e0f-8bb7bc8c8036",
                                "sense_id": "909961d5-0b86-3b58-9590-d79b4af65897",
                                "text": "„Die Glottalisierung der Vokale in Yi ist von den Tönen der Sprache unabhängig und kann daher nicht als suprasegmental betrachtet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
