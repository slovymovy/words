                        "sense_id": "db01000d-ce1a-3fbb-bb5b-1f09534e95f4",
                        "entry_id": "00e46c68-d433-37f5-9ae8-244a7c1b6c45",
                        "glosses": [
                            "Aneinanderreihung/Folge von Bergen"
                        ],
