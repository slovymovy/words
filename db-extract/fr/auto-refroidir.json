                    {
                        "sense_id": "6758b941-22b2-3c83-b024-5e629f9d131d",
                        "entry_id": "f57399c2-4f17-3439-9d2d-80653778c73e",
                        "glosses": [
                            "Se refroidir tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfe4eace-d71d-4219-a9f6-8d5fd92f1dbc",
                                "sense_id": "6758b941-22b2-3c83-b024-5e629f9d131d",
                                "text": "La rotation lui conférerait un autre avantage : en tournant sur lui-même, le panneau conique pourrait s'auto-refroidir en passant rapidement de l'ombre à la lumière."
                            },
                            {
                                "example_id": "9cbedc36-c5ba-426c-91bd-04a34f1e3c3e",
                                "sense_id": "6758b941-22b2-3c83-b024-5e629f9d131d",
                                "text": "Le graphène a aussi montré qu'en plus de s'auto-réparer, il pouvait s'auto-refroidir (cf. « Un transistor qui s'auto-refroidit »)."
                            },
                            {
                                "example_id": "3077e79a-7f03-4551-9592-85a3f5ea5de2",
                                "sense_id": "6758b941-22b2-3c83-b024-5e629f9d131d",
                                "text": "Un TEC bouclé sur lui-même ne peut pas s'auto-refroidir pour la simple raison qu'il dissipe plus qu'il n'absorbe de puissance sur la face froide, la puissance électrique absorbée se retrouvant sous forme de chaleur sur la face chaude en plus de ce qui arrive de la plaque froide."
                            }
                        ]
                    }
