                        "entry_id": "545f6a15-f958-3f80-a42d-a901a2323631",
                        "glosses": [
                            "Cabane de chasseur, pour chasser à l’affut."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f65f2190-882b-4912-adf9-8fd9bb45d613",
                                "sense_id": "bd1565b7-1261-3200-9e6b-81d7782cb058",
                                "text": "Sur un rocher qui domine la mer, Janet Coriol avait construit un agachon qui passait pour un chef-d’œuvre d’agachonnerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8ffb99e-f6eb-3b70-99d6-d0ece8b9f742",
                        "entry_id": "545f6a15-f958-3f80-a42d-a901a2323631",
                        "glosses": [
                            "Poste d’affût sous-marin, pour la chasse sous-marine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "460cdd41-3e04-4a4d-b8de-b6d4651022c2",
                                "sense_id": "f8ffb99e-f6eb-3b70-99d6-d0ece8b9f742",
                                "text": "Des chasseurs sous-marins évoquent souvent l’arrivée « coléreuse » des bars à l’appel de « l’agachon »."
                            },
                            {
                                "example_id": "47b954f3-9fbe-4dec-8545-74dd0ee129d5",
                                "sense_id": "f8ffb99e-f6eb-3b70-99d6-d0ece8b9f742",
                                "text": "L’agachon tranquille consiste à se faire oublier complètement sous l’eau, se tenir en embuscade, en faisant partie du décor, une fois posté au bon endroit."
                            },
                            {
                                "example_id": "3775ee49-7a88-419d-9591-15037df94357",
                                "sense_id": "f8ffb99e-f6eb-3b70-99d6-d0ece8b9f742",
                                "text": "Par beau temps avec une eau claire, vous pourrez effectuer des agachons si vous avez repéré du poisson susceptible d'être capturé par cette méthode."
                            }
                        ]
                    }
