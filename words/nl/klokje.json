    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3665eac-3a01-3501-9227-8f35dc5c4f0d",
                    "sense_definition": "verkleinwoord van <w>klok</w>, een klein instrument om de tijd aan te duiden of een kleine luidklok",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uurwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er hangt een klein <w>klokje</w> aan de muur in de keuken.",
                            "target_lang_translations": {
                                "ru": "На стене в кухне висят маленькие <w>часики</w>."
                            }
                        },
                        {
                            "text": "Het <w>klokje</w> op haar nachtkastje maakt helemaal geen geluid.",
                            "target_lang_translations": {
                                "ru": "<w>Часики</w> на её прикроватной тумбочке не издают совершенно ни звука."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het klokje rond"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verkleinvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное от klok; небольшие часы (настенные, настольные) или маленький колокольчик"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "часики",
                                "target_lang_sense_clarification": "небольшие настольные или настенные часы"
                            },
                            {
                                "target_lang_word": "часы",
                                "target_lang_sense_clarification": "небольшой прибор для измерения времени"
                            },
                            {
                                "target_lang_word": "колокольчик",
                                "target_lang_sense_clarification": "маленький колокол"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b85584e-4ef5-3d36-a893-1a8d85d8c66f",
                    "sense_definition": "horloge gedragen om de pols of in een zak",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uurwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voor zijn verjaardag kreeg hij een mooi gouden <w>klokje</w>.",
                            "target_lang_translations": {
                                "ru": "На день рождения он получил красивые золотые <w>часики</w>."
                            }
                        },
                        {
                            "text": "Kijk eens op je <w>klokje</w> hoe laat het nu precies is.",
                            "target_lang_translations": {
                                "ru": "Посмотри-ка на свои <w>часы</w>, сколько сейчас точно времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "horloge",
                        "polshorloge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel voor horloge"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разговорное обозначение наручных или карманных часов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "часики",
                                "target_lang_sense_clarification": "наручные или карманные часы (разговорно)"
                            },
                            {
                                "target_lang_word": "часы",
                                "target_lang_sense_clarification": "наручные часы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ca8b588-59b9-3837-8229-1a99bd1883d1",
                    "sense_definition": "plant met klokvormige bloemen, behorend tot het geslacht Campanula of de klokjesfamilie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de rotstuin bloeit een prachtig blauw <w>klokje</w>.",
                            "target_lang_translations": {
                                "ru": "В альпинарии цветёт прекрасный синий <w>колокольчик</w>."
                            }
                        },
                        {
                            "text": "Zij plukte een paars <w>klokje</w> langs de rand van het bospad.",
                            "target_lang_translations": {
                                "ru": "Она сорвала фиолетовый <w>колокольчик</w> на краю лесной тропинки."
                            }
                        }
                    ],
                    "synonyms": [
                        "campanula"
                    ],
                    "target_lang_definitions": {
                        "ru": "растение с цветками в форме колокола; колокольчик (род Campanula)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колокольчик",
                                "target_lang_sense_clarification": "цветок рода Campanula"
                            },
                            {
                                "target_lang_word": "кампанула",
                                "target_lang_sense_clarification": "ботаническое название"
                            }
                        ]
                    }
                }
            ]
        }
