                            "Block aus Platin mit einem bestimmten Gewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a34b962-bcd0-4d37-8d1c-ab0a084b8651",
                                "sense_id": "e700170e-897b-31db-8e92-77887eeed62b",
                                "text": "Platinbarren sind in verschiedenen Größen erhältlich."
                            },
                            {
                                "example_id": "2b316029-fca8-4150-aa6e-65d7e9347996",
                                "sense_id": "e700170e-897b-31db-8e92-77887eeed62b",
                                "text": "„Ein mit physischen Platinbarren besicherter Exchange Traded Commodity (ETC) als Depotbeimischung wäre -eine mögliche Variante, um an einem steigenden Preis für Platin zu verdienen.“"
                            },
                            {
                                "example_id": "78440385-b47a-464d-8fcb-9f15f714e475",
                                "sense_id": "e700170e-897b-31db-8e92-77887eeed62b",
                                "text": "„Ein Versender von Spam-Mails schuldet AOL einen saftigen Schadenersatz. Doch der Mann ist verschwunden. AOL will nun im Garten seiner Eltern nach Gold- und Platinbarren buddeln.“"
                            },
                            {
                                "example_id": "bfb68850-a713-41a1-984e-4a5972540cca",
                                "sense_id": "e700170e-897b-31db-8e92-77887eeed62b",
                                "text": "„Die Platinbarren, die er stets unter seinem Bett verborgen hatte, waren verschwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
