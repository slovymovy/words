                    },
                    {
                        "sense_id": "00c18939-ea52-3e3d-b367-1d600561e662",
                        "entry_id": "773b6f7c-f23d-3fb8-ab00-68ed61efe67d",
                        "glosses": [
                            "iets dat een zware last is"
                        ],
