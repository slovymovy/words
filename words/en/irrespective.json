    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5508484-fa4a-3b1e-bd91-b1bbdccacd9a",
                    "sense_definition": "Not taking into account; regardless of certain circumstances or conditions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regardless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The competition is open to everyone <w>irrespective</w> of age or background.",
                            "target_lang_translations": {
                                "tr": "Yarışma, yaşa veya geçmişe <w>bakılmaksızın</w> herkese açıktır."
                            }
                        },
                        {
                            "text": "Every citizen should receive equal treatment under the law, <w>irrespective</w> of their wealth.",
                            "target_lang_translations": {
                                "tr": "Varlıklarına <w>bakılmaksızın</w> her vatandaş yasa önünde eşit muamele görmelidir."
                            }
                        }
                    ],
                    "synonyms": [
                        "regardless"
                    ],
                    "common_phrases": [
                        "irrespective of"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli koşulları veya durumları hesaba katmayan; -e bakılmaksızın, gözetmeksizin."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bakılmaksızın",
                                "target_lang_sense_clarification": "bir durumu hesaba katmadan"
                            },
                            {
                                "target_lang_word": "gözetmeksizin",
                                "target_lang_sense_clarification": "dikkate almayarak"
                            },
                            {
                                "target_lang_word": "bağımsız",
                                "target_lang_sense_clarification": "-den bağımsız olarak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5653074-16e5-3699-8679-f3ef93371f33",
                    "sense_definition": "Unbiased, independent, or formed without regard to consequences or circumstances.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "regardless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee reached an <w>irrespective</w> judgment free from outside political pressure.",
                            "target_lang_translations": {
                                "tr": "Komite, dış siyasi baskılardan uzak, <w>tarafsız</w> bir karara vardı."
                            }
                        },
                        {
                            "text": "The theologian described the decree as an expression of divine and <w>irrespective</w> will.",
                            "target_lang_translations": {
                                "tr": "İlahiyatçı, fermanı ilahi ve <w>koşulsuz</w> bir iradenin ifadesi olarak tanımladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "impartial",
                        "unbiased"
                    ],
                    "antonyms": [
                        "biased"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English except in specialized philosophical or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Sonuçları veya dış koşulları dikkate almayan; tarafsız, bağımsız (özellikle felsefi/tarihsel bağlamda)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tarafsız",
                                "target_lang_sense_clarification": "dış baskılardan etkilenmeyen"
                            },
                            {
                                "target_lang_word": "koşulsuz",
                                "target_lang_sense_clarification": "şartlara bağlı olmayan"
                            },
                            {
                                "target_lang_word": "bağımsız",
                                "target_lang_sense_clarification": "hiçbir etki altında kalmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bef9a3e-c3ba-3aa5-b1c9-5fe8231a1646",
                    "sense_definition": "Lacking proper respect or reverence; disrespectful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young courtiers grew increasingly wicked and <w>irrespective</w> toward the elder statesmen.",
                            "target_lang_translations": {
                                "tr": "Genç saray mensupları, kıdemli devlet adamlarına karşı giderek daha kötü niyetli ve <w>saygısız</w> hale geldi."
                            }
                        },
                        {
                            "text": "His rebellious followers were condemned for their <w>irrespective</w> behavior before the prince.",
                            "target_lang_translations": {
                                "tr": "İsyankar takipçileri, prensin huzurundaki <w>hürmetsiz</w> davranışları nedeniyle kınandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "disrespectful"
                    ],
                    "antonyms": [
                        "respectful"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer in contemporary use."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Gereken saygıyı göstermeyen; saygısız, hürmetsiz (eski dilde)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "saygısız",
                                "target_lang_sense_clarification": "hürmetsiz, edep dışı"
                            },
                            {
                                "target_lang_word": "hürmetsiz",
                                "target_lang_sense_clarification": "büyüklere saygı göstermeyen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
