                        "cross_references": [
                            {
                                "target_word": "Fettabsaugung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a213ee-4b0e-3e71-b677-28abbc5baf4a",
                                        "entry_id": "ab39f596-2951-3029-9f2b-ad6dab289d16",
                                        "glosses": [
                                            "Absaugen von überflüssigem Fettgewebe"
                                        ],
                                        "tags": [
                                            "Schönheitschirurgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649c4dc9-30f9-4dba-b4a9-d9aecb567fc7",
                                                "sense_id": "d4a213ee-4b0e-3e71-b677-28abbc5baf4a",
                                                "text": "Durch die Fettabsaugung hat sie mehrere Kilo verloren."
                                            },
                                            {
                                                "example_id": "d2a66081-7edd-4122-9164-3bfdc53cd411",
                                                "sense_id": "d4a213ee-4b0e-3e71-b677-28abbc5baf4a",
                                                "text": "„So saßen wir in der Küche seines Bungalows, tranken Veuve Cliquot und redeten über Fettabsaugung, Schönheitsideale und Facelifting.“"
                                            }
                                        ],
