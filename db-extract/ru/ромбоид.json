                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e458d744-58f7-3385-934d-263a6f5a72b7",
                                        "entry_id": "4f606379-2509-35d2-96f4-65f8c5d95679",
                                        "glosses": [
                                            "Volume à six faces rhomboédriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f4f894-e48c-4770-a1f5-0bc3b0136d62",
                                                "sense_id": "e458d744-58f7-3385-934d-263a6f5a72b7",
                                                "text": "Le plus intéressant ici n’est pas, je crois, le trapèze ou la table tétrapode, équilibrée en tout cas, mais le rhombe et le rhomboïde."
                                            }
                                        ]
                                    },
