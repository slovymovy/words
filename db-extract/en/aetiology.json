                    },
                    {
                        "translation_id": "429b7397-7ed8-4dad-9526-bea927f1f178",
                        "source_entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                        "source_sense_description": "study of causes or origins",
                        "target_lang_word": "etiologie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etiologie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e36c3d7f-ef15-3c49-883a-79ee5a41a47b",
                                        "entry_id": "702f2bd9-610b-3e0f-bdda-74d20b0a656b",
                                        "glosses": [
                                            "onderdeel van de pathologie dat zich bezighoudt met de oorzaken van ziekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6795396-d5fd-4127-8f55-d2d13b4edd33",
                                                "sense_id": "e36c3d7f-ef15-3c49-883a-79ee5a41a47b",
                                                "text": "Bij de etiologie kijk je naar de persoonlijke ziektegeschiedenis, naar psychische en sociale factoren, die op hun beurt weer van invloed zijn op het biologische substraat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077c65ca-e67d-3aff-942d-38479096bc38",
                                        "entry_id": "702f2bd9-610b-3e0f-bdda-74d20b0a656b",
                                        "glosses": [
                                            "leer van de oorzaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa9ccb2-dd2c-439f-89f2-17e20b9778dd",
                                                "sense_id": "077c65ca-e67d-3aff-942d-38479096bc38",
                                                "text": "Niet iedereen zal weten wat een ‘bijna pathologische hypermnesie’ of een ‘etiologie van de terreur’ is – soms staan er wel drie van deze termen op één bladzijde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "858b8265-90a8-4837-9059-10ea2dea6b52",
                        "source_entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                        "source_sense_description": "study of causes or origins",
                        "target_lang_word": "étiologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étiologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08670529-2c50-3232-be76-c9cb65b3cee8",
                                        "entry_id": "0ebd702c-d60c-3675-96ed-e0ef1173d974",
                                        "glosses": [
                                            "Partie de la médecine qui traite des diverses causes des faits biologiques et spécialement des maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b68955ea-77da-4819-a0b3-ef971166c5fd",
                                                "sense_id": "08670529-2c50-3232-be76-c9cb65b3cee8",
                                                "text": "Moins elle se livrera à des spéculations sur l’étiologie de la maladie devant un étranger, moins elle donnera prise à la suspicion que les affirmations de N’Da auraient pu provoquer."
                                            },
                                            {
                                                "example_id": "2eac258e-d38c-415a-a20a-a4259a4b74d4",
                                                "sense_id": "08670529-2c50-3232-be76-c9cb65b3cee8",
                                                "text": "Hahnemann rattachait la luèse aux effets de la syphilis. Depuis, l’étiologie de la luèse s'est considérablement élargie. Parmi les facteurs déclenchants, on trouve souvent des intoxications diverses à l'alcool, aux drogues et aux médicaments."
                                            },
                                            {
                                                "example_id": "5ce9941c-c3a8-46ac-801f-fec08a16d5f3",
                                                "sense_id": "08670529-2c50-3232-be76-c9cb65b3cee8",
                                                "text": "— Sans doute, presque tout demeure à faire pour passer d'une symptomatique à une véritable étiologie."
                                            },
                                            {
                                                "example_id": "5cac093b-0044-4d94-aca1-6d91d067e03a",
                                                "sense_id": "08670529-2c50-3232-be76-c9cb65b3cee8",
                                                "text": "Montaigne s'amuse à lister les différents diagnostics et traitements posés pour une même maladie. Autant d'étiologies, de posologies, de médications que de médecins!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fdbf047-bbc0-33ef-a9e7-a96e9a0309a9",
                                        "entry_id": "0ebd702c-d60c-3675-96ed-e0ef1173d974",
                                        "glosses": [
                                            "Étude de la genèse des organes et des fonctions d’un corps vivant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54ec1608-8327-33fc-99e2-3ba0273451ef",
                                        "entry_id": "0ebd702c-d60c-3675-96ed-e0ef1173d974",
                                        "glosses": [
                                            "Étude de l’ensemble des causes d’un phénomène."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7378b726-670e-49d5-8a3d-d0c646bf3112",
                        "source_entry_id": "b6bfd2b6-1d44-3ab5-a6d4-e08b93f7d74f",
                        "source_sense_description": "study of causes or origins",
                        "target_lang_word": "Ätiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
