                ],
                "senses": [
                    {
                        "sense_id": "21d8ea21-207e-30e7-8afe-f453fbcf7286",
                        "entry_id": "2fb9ac6e-c970-36ab-9cab-51a227aebede",
                        "glosses": [
                            "Universaliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b5a1f4-309f-471e-9b0c-e20758f7a4d7",
                                "sense_id": "21d8ea21-207e-30e7-8afe-f453fbcf7286",
                                "text": "Sauf qu'il ya des moments où le caractère fatal et universel du drame qui se joue sur le plan historique permet à la poésie de se réuniversaliser, comme le montre l'exemple d'Eluard militant de la Résistance et parlant alors au nom de tous."
                            },
                            {
                                "example_id": "ea826b95-dbd5-4234-b04c-dde25ee4b5b5",
                                "sense_id": "21d8ea21-207e-30e7-8afe-f453fbcf7286",
                                "text": "A peine constituée à partir de l'intériorisation d'un universel vécu comme expérience familiale, cette singularité, improductive à ce stade, va trouver à se réuniversaliser sous l'effet conjugué, parce qu'identique du point de vue de la structure et du contenu, de l'Art et de la névrose."
                            }
                        ]
                    }
                ],
