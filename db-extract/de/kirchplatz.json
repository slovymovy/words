                "senses": [
                    {
                        "sense_id": "7e92adb4-d8d9-3256-9086-516e9ec0ce56",
                        "entry_id": "262842ed-1cfa-3c57-a3ca-d668f6b1936c",
                        "glosses": [
                            "unmittelbar an eine Kirche¹ angrenzender Platz¹"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e48fb6-b5cb-400f-93da-d6e7969f3d5c",
                                "sense_id": "7e92adb4-d8d9-3256-9086-516e9ec0ce56",
                                "text": "„In einer Nacht vor vielen Jahren träumte ich, ich wäre draußen auf dem Kirchplatz in Münsterschwarzach, alle Glocken läuteten feierlich, und Menschen strömten von überall her in die Kirche.“"
                            },
                            {
                                "example_id": "3235398f-72c3-4208-91d3-5e8e7bf1dfe7",
                                "sense_id": "7e92adb4-d8d9-3256-9086-516e9ec0ce56",
                                "text": "„Halb Dondorf erwartete das Brautpaar mit Glückwünschen draußen auf dem Kirchplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
