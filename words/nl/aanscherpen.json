    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a66ece5-a25a-39e3-87c8-6720e91b6ac8",
                    "sense_definition": "Fysiek scherper maken van een voorwerp.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scherp_maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moet het mes goed <w>aanscherpen</w> voor het snijden van het vlees.",
                            "target_lang_translations": {
                                "fr": "Il doit bien <w>aiguiser</w> le couteau avant de couper la viande."
                            }
                        },
                        {
                            "text": "Je moet een potlood <w>aanscherpen</w> om er weer netjes mee te kunnen schrijven.",
                            "target_lang_translations": {
                                "fr": "Il faut <w>tailler</w> un crayon pour pouvoir réécrire proprement avec."
                            }
                        }
                    ],
                    "synonyms": [
                        "scherpen",
                        "slijpen"
                    ],
                    "common_phrases": [
                        "een potlood aanscherpen",
                        "een mes aanscherpen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rendre un objet physiquement plus tranchant ou pointu."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "aiguiser",
                                "target_lang_sense_clarification": "d'un couteau ou d'une lame"
                            },
                            {
                                "target_lang_word": "tailler",
                                "target_lang_sense_clarification": "d'un crayon"
                            },
                            {
                                "target_lang_word": "affûter",
                                "target_lang_sense_clarification": "d'un outil ou d'une lame"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "027429b3-f6f7-3a6c-8814-6e0be91f2c67",
                    "sense_definition": "Strenger, duidelijker of effectiever maken (van regels, beleid of eisen).",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intensiveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering wil de regels <w>aanscherpen</w> om de veiligheid te vergroten.",
                            "target_lang_translations": {
                                "fr": "Le gouvernement veut <w>durcir</w> les règles pour accroître la sécurité."
                            }
                        },
                        {
                            "text": "Na het incident besloot de school het beleid streng <w>aan</w> te <w>scherpen</w>.",
                            "target_lang_translations": {
                                "fr": "Après l'incident, l'école a décidé de <w>renforcer</w> sévèrement sa politique."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstrengen",
                        "intensiveren"
                    ],
                    "antonyms": [
                        "versoepelen"
                    ],
                    "common_phrases": [
                        "de regels aanscherpen",
                        "het beleid aanscherpen",
                        "de eisen aanscherpen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rendre des règles, des politiques ou des exigences plus strictes, claires ou efficaces."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "durcir",
                                "target_lang_sense_clarification": "des règles ou des mesures"
                            },
                            {
                                "target_lang_word": "renforcer",
                                "target_lang_sense_clarification": "des contrôles ou des exigences"
                            },
                            {
                                "target_lang_word": "resserrer",
                                "target_lang_sense_clarification": "des critères ou une politique"
                            }
                        ]
                    }
                }
            ]
        }
    ]
