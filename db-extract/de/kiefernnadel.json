                    {
                        "sense_id": "3be32f2d-3e88-3f50-9a0f-472b8bb0f5d7",
                        "entry_id": "3992f7ca-ff8f-37f3-8a59-7c439df35af4",
                        "glosses": [
                            "Nadel der Kiefer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8655b485-5a97-408c-a4eb-a70b888c84bb",
                                "sense_id": "3be32f2d-3e88-3f50-9a0f-472b8bb0f5d7",
                                "text": "Die langen Kiefernnadeln wurden mit der Zeit gelblich braun und begannen abzufallen."
                            },
                            {
                                "example_id": "5c89cf75-04c0-4835-9f9e-980694cc9b42",
                                "sense_id": "3be32f2d-3e88-3f50-9a0f-472b8bb0f5d7",
                                "text": "„Die Terrasse glänzte im Regen, die Marmorfläche war von Kiefernnadeln bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
