{
    "word_family": [
        "entangle",
        "tangle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e45e22e-35a4-3ddb-a51c-c829e73f5930",
                    "sense_definition": "The state of being deeply involved in a complex or difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "involvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to avoid any <w>entanglement</w> in the ongoing financial scandal.",
                            "target_lang_translations": {
                                "es": "El político intentó evitar cualquier <w>implicación</w> en el escándalo financiero en curso."
                            }
                        },
                        {
                            "text": "His <w>entanglement</w> in the complex legal case lasted for several years.",
                            "target_lang_translations": {
                                "es": "Su <w>enredo</w> en el complejo caso judicial se prolongó durante varios años."
                            }
                        }
                    ],
                    "synonyms": [
                        "involvement",
                        "complication"
                    ],
                    "common_phrases": [
                        "political entanglement",
                        "legal entanglement"
                    ],
                    "target_lang_definitions": {
                        "es": "Estado de estar profundamente involucrado o implicado en una situación compleja o difícil."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "enredo",
                                "target_lang_sense_clarification": "situación complicada o confusa"
                            },
                            {
                                "target_lang_word": "implicación",
                                "target_lang_sense_clarification": "involucramiento en un asunto"
                            },
                            {
                                "target_lang_word": "embrollo",
                                "target_lang_sense_clarification": "asunto enrevesado o conflictivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d1e4bde-bef3-37fc-b956-024579bae8f0",
                    "sense_definition": "A romantic or sexual relationship with another person.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to end their romantic <w>entanglement</w> after many months of uncertainty.",
                            "target_lang_translations": {
                                "es": "Decidieron poner fin a su <w>romance</w> tras muchos meses de incertidumbre."
                            }
                        },
                        {
                            "text": "He wanted to keep his private <w>entanglement</w> away from the public eye.",
                            "target_lang_translations": {
                                "es": "Quería mantener su <w>lío</w> privado lejos de la atención pública."
                            }
                        }
                    ],
                    "synonyms": [
                        "affair",
                        "relationship"
                    ],
                    "common_phrases": [
                        "romantic entanglement"
                    ],
                    "target_lang_definitions": {
                        "es": "Relación romántica o sexual con otra persona, a menudo complicada o secreta."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "romance",
                                "target_lang_sense_clarification": "relación amorosa"
                            },
                            {
                                "target_lang_word": "lío",
                                "target_lang_sense_clarification": "relación amorosa informal o complicada"
                            },
                            {
                                "target_lang_word": "enredo",
                                "target_lang_sense_clarification": "aventura amorosa o amorío"
                            },
                            {
                                "target_lang_word": "amorío",
                                "target_lang_sense_clarification": "relación romántica pasajera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fad75319-5f15-3de5-a26c-e59880f53166",
                    "sense_definition": "A physical phenomenon where particles remain connected such that the state of one affects the other regardless of distance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quantum <w>entanglement</w> is a fundamental concept in modern particle physics.",
                            "target_lang_translations": {
                                "es": "El <w>entrelazamiento</w> cuántico es un concepto fundamental en la física de partículas moderna."
                            }
                        },
                        {
                            "text": "Scientists are studying <w>entanglement</w> to develop faster communication technologies.",
                            "target_lang_translations": {
                                "es": "Los científicos están estudiando el <w>entrelazamiento</w> para desarrollar tecnologías de comunicación más rápidas."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quantum entanglement"
                    ],
                    "target_lang_definitions": {
                        "es": "Fenómeno físico en el que partículas permanecen conectadas de modo que el estado de una afecta a la otra independientemente de la distancia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "entrelazamiento",
                                "target_lang_sense_clarification": "física cuántica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a01bc512-7826-3bac-9c72-e462f6f5615d",
                    "sense_definition": "A physical barrier or obstacle designed to slow down an enemy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers cleared the barbed wire <w>entanglement</w> before advancing toward the fort.",
                            "target_lang_translations": {
                                "es": "Los soldados despejaron la <w>alambrada</w> de púas antes de avanzar hacia el fuerte."
                            }
                        },
                        {
                            "text": "The defensive <w>entanglement</w> successfully delayed the enemy infantry.",
                            "target_lang_translations": {
                                "es": "El <w>obstáculo defensivo</w> retrasó con éxito a la infantería enemiga."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstruction",
                        "barrier"
                    ],
                    "common_phrases": [
                        "defensive entanglement"
                    ],
                    "target_lang_definitions": {
                        "es": "Barrera física u obstáculo diseñado para frenar el avance de fuerzas enemigas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "alambrada",
                                "target_lang_sense_clarification": "obstáculo de alambre de espino"
                            },
                            {
                                "target_lang_word": "obstáculo defensivo",
                                "target_lang_sense_clarification": "barrera militar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}