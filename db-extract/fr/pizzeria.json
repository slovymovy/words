                "senses": [
                    {
                        "sense_id": "9ce703c8-3ebf-3342-a4cc-1467e5296e82",
                        "entry_id": "b2e9b2c0-e554-365f-ad74-40258de36123",
                        "glosses": [
                            "Restaurant où l’on sert principalement des pizzas et autres plats italiens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaec96ba-2249-4e97-8d53-0623bab8d6e0",
                                "sense_id": "9ce703c8-3ebf-3342-a4cc-1467e5296e82",
                                "text": "Il avait l’air de bonne humeur, il proposa des les emmener dîner à la pizzeria de la rue voisine."
                            },
                            {
                                "example_id": "e103e5a1-05d4-4bb0-ab7b-4c08ed9e1705",
                                "sense_id": "9ce703c8-3ebf-3342-a4cc-1467e5296e82",
                                "text": "Il y avait beaucoup de monde dans la rue piétonne, à cause de l’heure et de l’endroit : les cinémas dégorgeaient leur public aux yeux fatigués dans les pizzerias, « couscous » et pseudo-grecs, et réciproquement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2189d31-f67a-4851-ba56-b2c487b9ce98",
                        "source_entry_id": "b2e9b2c0-e554-365f-ad74-40258de36123",
                        "source_sense_id": "9ce703c8-3ebf-3342-a4cc-1467e5296e82",
                        "source_sense_description": "Restaurant",
                        "target_lang_word": "Pizzeria",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pizzeria",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e48fbf6e-c0db-3e43-9edd-36cd788a6825",
                                        "entry_id": "e1da2253-ad9c-30d8-8080-5bae317b640c",
                                        "glosses": [
                                            "Restaurant, in dem vorwiegend Pizzen angeboten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43cebf1a-abe9-4390-96e2-6155a4ba2802",
                                                "sense_id": "e48fbf6e-c0db-3e43-9edd-36cd788a6825",
                                                "text": "„Die herausgeputzte Innenstadt wird von Pizzerien und Trattorien dominiert.“"
                                            },
                                            {
                                                "example_id": "d213892f-fa1a-4d05-9f17-34765404250d",
                                                "sense_id": "e48fbf6e-c0db-3e43-9edd-36cd788a6825",
                                                "text": "„Wir gehen um zwei Ecken, in eine Pizzeria.“"
                                            },
                                            {
                                                "example_id": "b113042b-1afd-46b0-850c-f5fdb14e6a4d",
                                                "sense_id": "e48fbf6e-c0db-3e43-9edd-36cd788a6825",
                                                "text": "„Der lustigste Ausspruch, den ich hierzulande je hörte, fiel vor ein paar Jahren, als ich mit ein paar Freunden in einer leicht überteuerten Pizzeria zusammensaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
