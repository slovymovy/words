                ],
                "senses": [
                    {
                        "sense_id": "09b5a15a-2cc0-3574-b39d-577a1288e3a6",
                        "entry_id": "3f78bf8f-205e-38fa-97a5-c7e54da15abb",
                        "glosses": [
                            "einfach gestalteter Kapellenbau, der aus Natursteinen errichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98b291f4-caab-42bd-90a3-e5578369ee79",
                                "sense_id": "09b5a15a-2cc0-3574-b39d-577a1288e3a6",
                                "text": "„Für die kirchliche Trauung stehen Ihnen im Freilichtmuseum vier historische Bauten zur Verfügung: die Fachwerkkirche aus Ederbringhausen, die Natursteinkapelle aus Lollar, die Fachwerkkirche aus Kohlgrund und die Fackwerkkirche aus Nierhörlen.“"
                            },
                            {
                                "example_id": "9dd256d5-88d7-4198-81ce-c087bafddd56",
                                "sense_id": "09b5a15a-2cc0-3574-b39d-577a1288e3a6",
                                "text": "„Neben einem Besuch des neu gestalteten Archäologischen Museums kann man auch das Innere des Ganggrabes erforschen, auf dessen Spitze eine mittelalterliche Natursteinkapelle thront.“"
                            },
                            {
                                "example_id": "bab99786-226b-4731-95ed-af7749a2f627",
                                "sense_id": "09b5a15a-2cc0-3574-b39d-577a1288e3a6",
                                "text": "„Die Vareler Schloßkirche steht an der höchsten Stelle Varels, wie schon vorher eine kleine hölzerne Natursteinkapelle.“"
                            },
                            {
                                "example_id": "93c366be-b29b-4eb5-a6ac-54c762d76921",
                                "sense_id": "09b5a15a-2cc0-3574-b39d-577a1288e3a6",
                                "text": "„An den Hängen scheinen viele unverputzte Natursteinkapellen zu stehen. Tatsächlich handelt es sich aber um ehemalige Wohnhäuser. Sie ähneln mykenischen Kuppelgräbern oder auch apulischen Trulli.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
