                    {
                        "form_id": "e06311c1-2ade-4ea0-a3e8-1d08ca898059",
                        "entry_id": "410e8128-e116-3f76-934a-869a737b7190",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Nachzügler"
                    },
                    {
                        "form_id": "0d23dbc3-a624-4d9f-bc6f-ba2d48660f68",
                        "entry_id": "410e8128-e116-3f76-934a-869a737b7190",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nachzügler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                        "entry_id": "410e8128-e116-3f76-934a-869a737b7190",
                        "glosses": [
                            "eine Person, die mit Abstand als letzte oder sehr spät an einem Treffpunkt erscheint, hinter anderen zurückbleibt (auch im übertragenen Sinne für Gegenstände und Konzepte benutzt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ed2879-95eb-4a68-a1aa-4d9638012a47",
                                "sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                                "text": "„An einem ausgebombten Feldlazarett sammelt die Besatzung eine Schar Nachzügler auf, unter ihnen einen britischen Arzt und Soldaten des freien Frankreichs.“"
                            },
                            {
                                "example_id": "c9ce3249-bac2-46ce-b755-8f3732d87379",
                                "sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                                "text": "„Die Bundesrepublik spielte dabei zunächst die Rolle eines Nachzüglers, weil sie aufgrund deutschlandpolitischer Orthodoxien nur schwer aus den Konfliktmustern des Kalten Kriegs herausfinden konnte.“"
                            },
                            {
                                "example_id": "43869d3f-1085-458e-89ee-65fa3f63dd60",
                                "sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                                "text": "„Er kam in der Schule an, als sich gerade die letzten Nachzügler durch das Schultor zwängten.“"
                            },
                            {
                                "example_id": "3dcb513a-0593-429c-a516-68715be6f585",
                                "sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                                "text": "„Ein paar Nachzügler kamen angeschlichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96ce80fb-0067-3148-bc84-b16190ae960a",
                        "entry_id": "410e8128-e116-3f76-934a-869a737b7190",
                        "glosses": [
                            "ein in der Geburtenfolge mit Abstand spät gekommenes Kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bda52ad5-8f16-4154-b618-2071dfccf667",
                                "sense_id": "96ce80fb-0067-3148-bc84-b16190ae960a",
                                "text": "„Mit einem Abstand von fünf Jahren zum nächst älteren Geschwister gilt das jüngste Kind schon als Nachzügler.“"
                            },
                            {
                                "example_id": "3f661302-ecc7-4b25-adef-e3ce9d7268a6",
                                "sense_id": "96ce80fb-0067-3148-bc84-b16190ae960a",
                                "text": "„Ebba brachte einen Nachzügler zur Welt, ein Mädchen, das den Namen Álva erhielt, benannt nach Tóvó oder Tórálvur, wie er im Kirchenbuch verzeichnet stand.“"
                            },
                            {
                                "example_id": "a3102b82-3a41-4995-b029-52d60267e936",
                                "sense_id": "96ce80fb-0067-3148-bc84-b16190ae960a",
                                "text": "„Der Nachzügler Fried war fünf Jahre später zur Welt gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82de289c-8ccc-4efd-9b68-fce9126eec9d",
                        "source_entry_id": "410e8128-e116-3f76-934a-869a737b7190",
                        "source_sense_id": "2ca3bb55-37b2-3716-b8cf-75376322cf4d",
                        "source_sense_description": "eine Person, die mit Abstand als letzte oder sehr spät an einem Treffpunkt erscheint",
                        "target_lang_word": "latecomer",
