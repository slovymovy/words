                    },
                    {
                        "translation_id": "40c368b2-1dc2-4f31-bec9-0719ab6fbf91",
                        "source_entry_id": "9470bfc7-4790-3614-9826-3662573d51c9",
                        "source_sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                        "source_sense_description": "Chemie: Glasgefäß, das man zur Destillation benutzt",
                        "target_lang_word": "distillation flask",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7528952d-750d-43c5-bf9a-c3164e8adaa5",
                        "source_entry_id": "9470bfc7-4790-3614-9826-3662573d51c9",
                        "source_sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                        "source_sense_description": "Chemie: Glasgefäß, das man zur Destillation benutzt",
                        "target_lang_word": "alembic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alembic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "034cf9d1-9dff-3976-b141-91af15ef92c9",
                                        "entry_id": "fcee0c50-cc4e-39a3-bb1c-c756835db307",
                                        "glosses": [
                                            "An early chemical apparatus, consisting of two retorts connected by a tube, used to purify substances by distillation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90117098-8b9c-4cee-b80c-549b9b375240",
                                                "sense_id": "034cf9d1-9dff-3976-b141-91af15ef92c9",
                                                "text": "Ideal beauty is not the mind’s creation: it is real beauty, refined and purified in the mind’s alembic, from the alloy which always more or less accompanies it in our mixed and imperfect nature."
                                            },
                                            {
                                                "example_id": "db65ef3f-c371-487d-bd95-1d77f2b47ed3",
                                                "sense_id": "034cf9d1-9dff-3976-b141-91af15ef92c9",
                                                "text": "Thus is Art, a nature passed through the alembic of man."
                                            },
                                            {
                                                "example_id": "07ecfdac-38e1-467f-8702-6cad83cce2c0",
                                                "sense_id": "034cf9d1-9dff-3976-b141-91af15ef92c9",
                                                "text": "The great physiologist Schwann, for instance, who died in 1882, maintained that there was an insurmountable barrier between us and those whom Michelet calls our inferior brethren. To him animals were alembics and electric batteries; mechanics, physics, and chemistry could account for all their manifestations."
                                            },
                                            {
                                                "example_id": "878e3267-b744-466a-8d1c-ba11e6e57b1b",
                                                "sense_id": "034cf9d1-9dff-3976-b141-91af15ef92c9",
                                                "text": "We of all magical precipitates out of Europe’s groaning, clouded alembic, we are the thinnest, the most dangerous, the handiest to secular uses —"
                                            },
                                            {
                                                "example_id": "d4845586-43fe-4259-b966-e8d071b9fbbd",
                                                "sense_id": "034cf9d1-9dff-3976-b141-91af15ef92c9",
                                                "text": "We’ll need to get you a copy of the charter, a beginner’s alembic, maybe a complementary silver dagger… and that’s not even counting whether or not we have any beginner-level books on disciplines you’re interested in!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d92de223-dc06-43d6-9833-3b069bfab70e",
                        "source_entry_id": "9470bfc7-4790-3614-9826-3662573d51c9",
                        "source_sense_id": "b04fa6d7-d557-351f-ad70-99969ec97782",
                        "source_sense_description": "Chemie: Glasgefäß, das man zur Destillation benutzt",
                        "target_lang_word": "alambic",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alambic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c734792-872d-383c-bfc6-3ef3abbf8e68",
                                        "entry_id": "adf44765-e4dc-3e5f-9751-b386c49f0bb3",
                                        "glosses": [
                                            "Appareil qui sert à distiller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ddde979-a365-4af2-9ffb-9c8cfb063e47",
                                                "sense_id": "5c734792-872d-383c-bfc6-3ef3abbf8e68",
                                                "text": "Lorsqu'on veut faire de l'eau-de-vie avec des marcs de raisin, on se sert d'un simple alambic ordinaire. On chauffe les matières dans une chaudière en cuivre, et les vapeurs qui se produisent passent dans un tube contourné en spirale, ou serpentin ; ce tube, plongé dans un vase plein d'eau froide que l'on renouvelle au fur et à mesure, condense les vapeurs."
                                            },
                                            {
                                                "example_id": "c0d0089d-0c3a-4565-8460-18040602c2dc",
                                                "sense_id": "5c734792-872d-383c-bfc6-3ef3abbf8e68",
                                                "text": "La lumière, entrant par les vitres, chauffait la pièce, miroitait sur les landiers de fer, accroupis au fond de l’âtre, sur la tête de l’alambic et sur les bassinoires de cuivre, alignées sur des rayons et qui, soigneusement astiquées pour la circonstance, flamboyaient dans l’ombre comme des soleils."
                                            },
                                            {
                                                "example_id": "11907bac-b89e-463f-83b7-d35afd321838",
                                                "sense_id": "5c734792-872d-383c-bfc6-3ef3abbf8e68",
                                                "text": "Ce ne sont point des herses ou des rouleaux qu'on voit à la porte des demeures, mais des appareils à sulfater, des fouloirs, des foudres, des pompes, des alambics."
                                            },
                                            {
                                                "example_id": "41ad1397-f1b9-42cc-82b2-df72c6f0e369",
                                                "sense_id": "5c734792-872d-383c-bfc6-3ef3abbf8e68",
                                                "text": "Cette eau-de-vie a toujours un goût d'empyreume, causé par une certaine quantité de marc ou de lie qui s'est attachée aux parois intérieures de l’alambic, et qui a été en partie décomposée par le calorique."
                                            },
                                            {
                                                "example_id": "dc30cfe2-f5a8-4b96-b958-62bf4e5a35be",
                                                "sense_id": "5c734792-872d-383c-bfc6-3ef3abbf8e68",
                                                "text": "Les nez en flûtes d’alambic se reculaient prudemment pour n’être pas tranchés au vol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32cf3ea7-03fd-35c2-a262-4a256b922244",
                                        "entry_id": "adf44765-e4dc-3e5f-9751-b386c49f0bb3",
                                        "glosses": [
                                            "Processus qui décante une affaire ou une situation délicate."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc059626-0973-4d87-8851-91924b861e8a",
                                                "sense_id": "32cf3ea7-03fd-35c2-a262-4a256b922244",
                                                "text": "Deux cents ans après la dernière invasion lombarde, il n'existe pas encore de nation italienne ; mais les éléments essentiels qui la composeront sont dans l’alambic, et les alliages postérieurs n'y ajouteront rien d'essentiel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7793a06b-2ae4-3fd4-802f-2639d21f9cd2",
                                        "entry_id": "adf44765-e4dc-3e5f-9751-b386c49f0bb3",
                                        "glosses": [
                                            "Simulie."
                                        ],
                                        "tags": [
                                            "Provence"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c250fc14-834b-39c2-ad83-0469a4914f9f",
                                        "entry_id": "adf44765-e4dc-3e5f-9751-b386c49f0bb3",
                                        "glosses": [
                                            "Cafetière destinée à préparer le café en le posant sur une source de chaleur ^([1]) ^([2])."
                                        ],
                                        "tags": [
                                            "Nord de la France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a335905e-669d-4075-b8b3-9671e52ecb53",
                                                "sense_id": "c250fc14-834b-39c2-ad83-0469a4914f9f",
                                                "text": "Par ce contact momentané, l'eau recueille les principes solubles du café. Tous ces appareils à infusion sont vulgaires, depuis la Dubelloy en fer-blanc ou en porcelaine, cafetière à deux compartiments superposés, qu'on appelle improprement alambic, jusqu'aux ingénieux procédés de salon dus à M. Pénant, par application de la théorie de M. Babinet, qui consiste à faire traverser le café, en deux sens opposés, par l'eau bouillante mise en mouvement sous l'influence de sa propre vapeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
