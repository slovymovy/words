                        "examples": [
                            {
                                "example_id": "43b6d5c9-ee81-44f3-8f5f-3a6a87dfb6cf",
                                "sense_id": "4269f531-d745-39a1-964a-dbb7a9fe7ab6",
                                "text": "„Leon Brack, beliebt und gefürchtet wegen seines chaotischen Arbeitsstils, schonte sich selbst am wenigsten, und deshalb fiel es ihm leicht, die Mitarbeiter zu scheuchen.“"
                            },
                            {
                                "example_id": "95bc44db-99fa-4a9f-9ecc-96dc6fe8f3c3",
                                "sense_id": "4269f531-d745-39a1-964a-dbb7a9fe7ab6",
                                "text": "„Ein zweites wichtiges Merkmal seines Arbeitsstils war die Fähigkeit, seine Gedanken klar zu formulieren.“"
                            }
                        ],
