                        "form": "die Bewusstseinszustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                        "entry_id": "c1afe5e4-0b11-3699-98c6-77b1593eddd4",
                        "glosses": [
                            "Zustand, der das aktuelle Niveau des mentalen und physiologischen Bewusstseins einer Person (ihre Wahrnehmung, Wachheit und Reaktionsfähigkeit) beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a965cdbf-3e25-42ff-8132-22c44d00e46c",
                                "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                                "text": "„Der Bewusstseinszustand eines Menschen ist die Grundlage seiner Wahrnehmung.“"
                            },
                            {
                                "example_id": "2fbe92a5-64fa-4296-b3dc-6cd421d0425a",
                                "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                                "text": "„Meditation ist eine exzellente Geistesschulung, die mich in einen ruhigeren, klareren Bewusstseinszustand führt.“"
                            },
                            {
                                "example_id": "5d89fbf1-fd34-450c-b021-a5b1d13f1ed2",
                                "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                                "text": "„Die Trance ist ein willentlich herbeigeführter tiefentspannter Bewusstseinszustand, in den Du einen Raum zwischen dem Diesseits kreierst.“"
                            },
                            {
                                "example_id": "17049b4b-6aba-493b-b0b5-0489d486289f",
                                "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                                "text": "„Indem du in deine Gedanken, Gefühle und lebhafte Fantasie abdriftest, befindest du dich regelmäßig in einem anderen Bewusstseinszustand.“"
                            },
                            {
                                "example_id": "5af15964-b588-4a90-8881-1c2599929cff",
                                "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                                "text": "„Dieser Bewusstseinszustand ist nicht nur unglaublich heilsam und regenerierend, sondern ebnet uns auch einen Weg, um mit tiefer liegenden Ebenen unseres Selbst in Kontakt zu kommen und eine von äußeren Zuständen unabhängige Glückseligkeit zu erfahren.“"
                            },
                            {
                                "example_id": "5fc706af-2e1d-46a7-b30e-35b08bccbb1b",
                                "sense_id": "50b16057-50d0-3530-9f7a-6a2dc3162bab",
                                "text": "Tibetische Buddhisten gehen davon aus, dass dies eine direkte Übertragung eines Bewusstseinszustandes durch einen Lehrer ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
