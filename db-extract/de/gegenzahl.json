                "senses": [
                    {
                        "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                        "entry_id": "d4a473c8-35ca-342c-b5ae-dbdf3ff4cf06",
                        "glosses": [
                            "Zahl, die zu einer gegebenen Zahl den gleichen Betrag, aber ein differierendes Vorzeichen aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ba0bbd-c641-4e99-b2a1-c903b29cecc3",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "Die Zahl +5 ist die Gegenzahl zur Zahl -5, die Zahl -5 ist die Gegenzahl zur +5."
                            },
                            {
                                "example_id": "75d821b4-be9d-4872-9256-239c0bdce128",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "Die Summe einer Zahl und deren Gegenzahl ist immer 0."
                            },
                            {
                                "example_id": "3eedfb20-b613-4ebd-b13b-1936f5e714ae",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "„Eine Zahl und ihre Gegenzahl liegen symmetrisch zu 0. D.h. Zahl und Gegenzahl haben den gleichen Abstand vom Nullpunkt.“"
                            },
                            {
                                "example_id": "46e56e18-9288-4779-9724-330ffdb71703",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "„Die natürlichen Zahlen zusammen mit ihren Gegenzahlen und die Null bilden die Menge der ganzen Zahlen ℤ.“"
                            },
                            {
                                "example_id": "6fc7b72f-86f4-4bb3-98d1-16b55ac412f8",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "„Man addiert eine negative Zahl, indem man ihre Gegenzahl subtrahiert.“"
                            },
                            {
                                "example_id": "ed62636b-9b96-41c5-90eb-36f66433041e",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "[Untersuche, ob die folgende Aussage immer stimmt oder nicht. Begründe.] „Die Gegenzahl der Summe zweier Zahlen ist so groß wie die Summe ihrer Gegenzahlen.“"
                            },
                            {
                                "example_id": "5666babf-33cc-4d80-8d59-68ede0c5ab84",
                                "sense_id": "ec9310bb-527a-3060-8a15-d51fe2fdf877",
                                "text": "„Im Bereich der ganzen Zahlen ist -5 die Gegenzahl zu 5 und 3 die Gegenzahl zu -3, allgemein ist die Gegenzahl -a die Zahl, die zu a addiert 0 ergibt: a+(-a)=0 […]. Eine Zahl und ihre Gegenzahl haben den gleichen Betrag, aber unterschiedliches Vorzeichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
