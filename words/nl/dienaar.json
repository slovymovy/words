    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e12c9ba1-1b71-31d5-8e3e-5eb25e38428b",
                    "sense_definition": "iemand die in persoonlijke dienst van een meester is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning werd omringd door een trouwe <w>dienaar</w> die hem overal volgde.",
                            "target_lang_translations": {
                                "en": "The king was surrounded by a loyal <w>servant</w> who followed him everywhere."
                            }
                        },
                        {
                            "text": "Hij werd door zijn eigen <w>dienaren</w> vermoord in zijn eigen paleis.",
                            "target_lang_translations": {
                                "en": "He was murdered by his own <w>servants</w> in his own palace."
                            }
                        }
                    ],
                    "synonyms": [
                        "bediende",
                        "knecht"
                    ],
                    "antonyms": [
                        "meester",
                        "heer"
                    ],
                    "common_phrases": [
                        "trouwe dienaar",
                        "nederige dienaar"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who is in the personal service of a master"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "servant",
                                "target_lang_sense_clarification": "a person performing duties for a master or household"
                            },
                            {
                                "target_lang_word": "attendant",
                                "target_lang_sense_clarification": "someone who waits on or accompanies a person of rank"
                            },
                            {
                                "target_lang_word": "valet",
                                "target_lang_sense_clarification": "a personal male servant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ab22b20-83f1-3c99-aa65-cff2259d1ee7",
                    "sense_definition": "iemand die een hogere macht of een ideaal dient",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toewijding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als <w>dienaar</w> van de wet moet hij altijd rechtvaardig handelen.",
                            "target_lang_translations": {
                                "en": "As a <w>servant</w> of the law, he must always act justly."
                            }
                        },
                        {
                            "text": "De priester beschouwt zichzelf als een nederige <w>dienaar</w> van God.",
                            "target_lang_translations": {
                                "en": "The priest considers himself a humble <w>servant</w> of God."
                            }
                        }
                    ],
                    "synonyms": [
                        "bode"
                    ],
                    "common_phrases": [
                        "dienaar van de wet",
                        "dienaar van God"
                    ],
                    "target_lang_definitions": {
                        "en": "someone who serves a higher power or an ideal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "servant",
                                "target_lang_sense_clarification": "one who serves a cause, God, or the law"
                            },
                            {
                                "target_lang_word": "minister",
                                "target_lang_sense_clarification": "one who acts as an agent for a higher authority"
                            }
                        ]
                    }
                }
            ]
        }
    ]
