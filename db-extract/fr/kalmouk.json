                        "sense_id": "6307a86e-6cf6-3ec7-a6c4-baf325f4a69a",
                        "entry_id": "3a98c296-b008-3b51-b2bf-04be195e7f9a",
                        "glosses": [
                            "Qui concerne les Kalmouks, peuple mongol vivant en Kalmoukie, dans la confédération de Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b2e2eec-a766-45f4-a30b-060c27aac8ef",
                                "sense_id": "6307a86e-6cf6-3ec7-a6c4-baf325f4a69a",
                                "text": "La population, russe, kalmouke et tatare, est d'environ 46000 âmes."
                            },
                            {
                                "example_id": "64189368-b976-40b4-b9a9-27715c221bb7",
                                "sense_id": "6307a86e-6cf6-3ec7-a6c4-baf325f4a69a",
                                "text": "Hongor porte en lui 400 ans de tradition kalmouke. Ce peuple descendant des bergers nomades de Mongolie forme ce qui demeure à ce jour la seule \"nation\" bouddhiste de l'Europe."
                            }
                        ]
                    }
                ],
