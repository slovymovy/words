                "senses": [
                    {
                        "sense_id": "63ebb3af-91c9-3b59-823c-9570f32fe6c6",
                        "entry_id": "571143ba-821b-301d-b19e-240ce2cccfcc",
                        "glosses": [
                            "Préparer de manière intensive un examen ou un concours."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "724fa9ad-8dd5-4e80-83cd-30b8d563291f",
                                "sense_id": "63ebb3af-91c9-3b59-823c-9570f32fe6c6",
                                "text": "Ce système embrigade l'enfant, du moins au niveau du lycée, dans un bachotage permanent qui ne lui laisse aucun répit et très peu d'espace pour son épanouissement personnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "44bef1df-5f52-324c-9143-c93388cfe484",
                        "entry_id": "571143ba-821b-301d-b19e-240ce2cccfcc",
                        "glosses": [
                            "Préparer un examen ou un concours en faisant appel à la mémoire au détriment de la compréhension."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "285dd45a-6804-4adb-a824-33327678f58f",
                                "sense_id": "44bef1df-5f52-324c-9143-c93388cfe484",
                                "text": "Un tel bachotage irait à l'encontre de la construction d'une compétence, qui suppose une adaptation à des situations variées, dont la configuration ne dicte pas immédiatement les opérations à effectuer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64415771-3db1-4c53-a5cd-4f381d5033ec",
                        "source_entry_id": "571143ba-821b-301d-b19e-240ce2cccfcc",
                        "target_lang_word": "cram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12022503-976e-30d3-a2bf-383e1879d28f",
                                        "entry_id": "7eaaa94b-2c9b-3c9f-a984-a26a9085e631",
                                        "glosses": [
                                            "To press, force, or drive, particularly in filling, or in thrusting one thing into another; to stuff; to fill to superfluity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1a66379-d8ff-4ab6-a3c0-58e8e51fcefa",
                                                "sense_id": "12022503-976e-30d3-a2bf-383e1879d28f",
                                                "text": "to cram fruit into a basket; to cram a room with people"
                                            },
                                            {
                                                "example_id": "c778425f-6f02-40b9-817f-e8a29636f9ba",
                                                "sense_id": "12022503-976e-30d3-a2bf-383e1879d28f",
                                                "text": "Are we to blame Livingstone for Tube overcrowding? In part, yes, but as Sir John Eliot had observed in 1955, while Chairman of the London Transport Executive: 'They're not crammed in. They cram themselves in.'"
                                            },
                                            {
                                                "example_id": "02591968-9b01-47a6-8791-9b37e8f1c326",
                                                "sense_id": "12022503-976e-30d3-a2bf-383e1879d28f",
                                                "text": "The storm has passed when I arrive at Southampton Central, but more fun is to come. The station platforms and waiting rooms are crammed with people, many toting enormous amounts of baggage as they have just come off a cruise liner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "233fbace-3622-3570-9197-0d458c913591",
                                        "entry_id": "7eaaa94b-2c9b-3c9f-a984-a26a9085e631",
                                        "glosses": [
                                            "To fill with food to satiety; to stuff."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80de62c9-4872-47a0-9fbb-14877a9bdaf7",
                                                "sense_id": "233fbace-3622-3570-9197-0d458c913591",
                                                "text": "The boy crammed himself with cake"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a6ab8d-1778-3f81-ad91-29b0cc037571",
                                        "entry_id": "7eaaa94b-2c9b-3c9f-a984-a26a9085e631",
                                        "glosses": [
                                            "To put hastily through an extensive course of memorizing or study, as in preparation for an examination."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c569bd19-8777-4b6b-bb5d-411147529113",
                                                "sense_id": "45a6ab8d-1778-3f81-ad91-29b0cc037571",
                                                "text": "A pupil is crammed by his tutor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f31be1c-4a7b-3b11-a7a3-d0614ec5ce0b",
                                        "entry_id": "7eaaa94b-2c9b-3c9f-a984-a26a9085e631",
                                        "glosses": [
                                            "To study hard; to swot."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d9b4fbb-94b8-3cf5-9039-b87b3a957090",
                                        "entry_id": "7eaaa94b-2c9b-3c9f-a984-a26a9085e631",
                                        "glosses": [
                                            "To eat greedily, and to satiety; to stuff oneself."
