                                    {
                                        "sense_id": "1fe2239d-b92c-37b6-8717-7aa1edb8c6e8",
                                        "entry_id": "a41f4918-3b34-356c-86ea-fad09b5a0bb6",
                                        "glosses": [
                                            "A gun."
                                        ],
