                "senses": [
                    {
                        "sense_id": "83b7e891-98fc-3c19-bc65-0cde509041ca",
                        "entry_id": "0073dca0-0e13-3769-b1eb-f62eef6f443b",
                        "glosses": [
                            "standardisiertes Verfahren zum Bewerten und Dokumentieren der Beweglichkeit von Gelenken"
                        ],
                        "tags": [
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "dd8a84cd-feec-4830-92cf-a90c814bf571",
                                "sense_id": "83b7e891-98fc-3c19-bc65-0cde509041ca",
                                "text": "„Bei Verwendung der Neutral-Null-Methode oder Nulldurchgangsmethode wird die maximale Auslenkung des Gelenks aus der Neutralstellung in beide Richtungen in Winkelgraden angegeben, wobei die Neutralstellung mit 0° bezeichnet wird.“"
                            },
                            {
                                "example_id": "b62a2f83-9f3f-4d6f-9a60-03d9cc8ceacd",
                                "sense_id": "83b7e891-98fc-3c19-bc65-0cde509041ca",
                                "text": "„Bei den endoprothetischen Patienten wurde die Gelenkbeweglichkeit bei Reha-Aufnahme und -Entlassung nach der Neutral-Null-Methode (Nulldurchgangsmethode) erhoben.“"
                            },
                            {
                                "example_id": "dce07c9f-609e-4d5c-9ed6-2577449b0f15",
                                "sense_id": "83b7e891-98fc-3c19-bc65-0cde509041ca",
                                "text": "„Die Messung und Dokumentation sollte nach der sog. Nulldurchgangsmethode erfolgen, die sich allmählich international durchgesetzt hat und von deutschen Orthopäden und Rheumatologen ausschließlich benützt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
