                "senses": [
                    {
                        "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                        "entry_id": "3292bff1-8d85-301c-9172-c76e1a6b9913",
                        "glosses": [
                            "Ridiculement petit ou étriqué."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f5c1c2d0-eb2a-4b54-af7a-043a9335360d",
                                "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                                "text": "Il est vraiment riquiqui ton bonhomme ! Tu aurais pu le faire plus gros !"
                            },
                            {
                                "example_id": "48e38818-3dbb-444a-b45f-d68f2eb6eeb5",
                                "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                                "text": "Un spectacle gigantesque dans un théâtre tout riquiqui !"
                            },
                            {
                                "example_id": "3f75f32c-a054-4416-897d-ab4d251bb8c8",
                                "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                                "text": "Soigner la dépendance ne me déplaît pas ; le seul souci, c’est que le salaire est riquiqui et que la clinique se trouve à Carbondale."
                            },
                            {
                                "example_id": "455dda77-33cd-4763-944d-0588402ff89e",
                                "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                                "text": "Hâte que Brest soit à jamais les deuxièmes 😭😭 avec un budget riquiqui à côté de Paris."
                            },
                            {
                                "example_id": "82b2f1f9-96ca-4a36-a188-21ddc27a198e",
                                "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                                "text": "Elle ne veut pas conduire une liste PS riquiqui - et, d’ailleurs, personne ne le veut, c’est le problème -, mais, si le rassemblement est plus large, jusqu’aux écologistes par exemple, elle pourrait faire don de sa personne en janvier."
                            },
                            {
                                "example_id": "719df260-ff74-4769-814f-a9e3aa543f90",
                                "sense_id": "b54c825a-e788-3a75-9ab5-c65917b6b5ea",
                                "text": "Mais même riquiqui, pas question pour l’Église d’accepter de voir les sexes exposés. À partir de 1530, elle oblige à recouvrir d’un voile de pudeur – des feuilles de figuier ou de vigne, déjà utilisées au Moyen Âge dans certaines représentations d’Adam et Ève – les parties génitales des statues et des nus dans les tableaux."
                            }
                        ]
                    }
