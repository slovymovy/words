                                    {
                                        "sense_id": "7b357c6b-1004-3497-b71d-9b3ca3c06988",
                                        "entry_id": "10f88d31-6d09-3303-b8a7-6f9b0ffa6847",
                                        "glosses": [
                                            "topzwaar, een organisatie met een leiding die te groot is voor de omvang van die organisatie"
