                        "glosses": [
                            "Collectivement, descendance de Persée, héros de la mythologie grecque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c16161f1-7854-4e2b-9722-f6b101d8d941",
                                "sense_id": "947ac495-2203-3297-9a85-f08d567bf427",
                                "text": "Pour l’Argos, les aèdes ont beaucoup de chefs à leur disposition et spécialement deux dynasties, les Perséides, à laquelle appartient Héraklès, et les Atrides : il faut y ajouter les héros de la guerre contre Thèbes."
                            }
                        ]
                    }
