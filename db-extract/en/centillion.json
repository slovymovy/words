                                "target_senses": [
                                    {
                                        "sense_id": "4ab8786e-965a-36ce-af11-1d2bb81c2694",
                                        "entry_id": "099c7f7a-2293-384d-88b6-8ec1888cf495",
                                        "glosses": [
                                            "число, равное 10³⁰³ и записываемое в десятичной системе как единица с 303 нулями"
                                        ],
                                        "tags": [
                                            "в США"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ca17c5-0577-40e4-8658-3c6852843977",
                                                "sense_id": "4ab8786e-965a-36ce-af11-1d2bb81c2694",
                                                "text": "Заходящее солнце отсвечивало во множестве кроваво-красных соляных кристаллов, — я определил их количество приблизительно в сто центиллионов — сумма, почти равная бумажной наличности их Германского банка."
                                            },
                                            {
                                                "example_id": "5a65e411-9b84-49f8-b1ac-37789c140f47",
                                                "sense_id": "4ab8786e-965a-36ce-af11-1d2bb81c2694",
                                                "text": "По правилу Шюке, эти три оставшихся латинских числительных дают нам такие названия для чисел как «вигинтиллион», «центиллион» и «миллеиллион»."
                                            },
                                            {
                                                "example_id": "62f37fde-c9a5-40be-af6a-cfa928a81bd9",
                                                "sense_id": "4ab8786e-965a-36ce-af11-1d2bb81c2694",
                                                "text": "А значит, время существования Космоса в его нынешнем виде меньше времени, необходимого, чтобы дождаться события, происходящего раз в центиллион секунд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b47388ba-d57c-3653-8a14-18470f334bbe",
                                        "entry_id": "099c7f7a-2293-384d-88b6-8ec1888cf495",
                                        "glosses": [
                                            "число, равное 10⁶⁰⁰ и записываемое в десятичной системе как единица с 600 нулями"
                                        ],
                                        "tags": [
                                            "в Британии"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b3252e-08d2-4ac2-a5e8-3f3896776f5c",
                                                "sense_id": "b47388ba-d57c-3653-8a14-18470f334bbe",
                                                "text": "Наибольшее число, которым оперируют математики – центиллион. Это 1 с 600 нулями. Любое число свыше центиллиона рассматривается как абстрактное, лежащее в бесконечности."
                                            }
                                        ]
                                    }
                                ]
                            }
