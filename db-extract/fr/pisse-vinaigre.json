                        "sense_id": "b9c08f77-2fcc-3aed-913b-7d6f3726284d",
                        "entry_id": "5eb3748b-e4e2-37af-88b6-c32acbe2e29a",
                        "glosses": [
                            "Personne morose, revêche, sans humour, esprit chagrin."
