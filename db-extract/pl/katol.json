                    }
                ],
                "translations": [
                    {
                        "translation_id": "c263100f-cf65-427b-be93-15e0daf41a38",
                        "source_entry_id": "313249eb-e598-3283-91c0-5b88bb2bc2c3",
                        "source_sense_id": "7418c66c-40a5-3cc3-af53-08a8980d3416",
                        "target_lang_word": "Kathole",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kathole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a6fb747-984b-3168-b798-6b0b66c37e43",
                                        "entry_id": "b18c90df-9114-3488-b506-aae0068a6809",
                                        "glosses": [
                                            "(männliche) Person, die der katholischen Kirche angehört"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "212fe82c-f163-4a11-aa9e-aeac2bc6660e",
                                                "sense_id": "8a6fb747-984b-3168-b798-6b0b66c37e43",
                                                "text": "„Irgendwie war ich zwar sehr angetan von der Idee, hier in einem von Katholen angelegten Bad, und außerdem noch in der Öffentlichkeit, zu wichsen, aber auf der anderen Seite beherrschte mich immer noch dieses starke Schamgefühl.“"
                                            },
                                            {
                                                "example_id": "5ce4a0c1-b321-4533-b8e1-8587b04af4cd",
                                                "sense_id": "8a6fb747-984b-3168-b798-6b0b66c37e43",
                                                "text": "„Als man den schwarzen Ritter untersuchte, hat man ein wenig DNA abgeschabt, von den Zähnen, oder vom Sack – aber wenn die Katholen die Eier nicht als Reliquien ausgeführt haben, müssen sie taube Nüßchen geworden sein. Taugen nicht mehr für Doktorspiele.“"
                                            },
                                            {
                                                "example_id": "745f9bec-e19e-40ba-8548-c82f526543a5",
                                                "sense_id": "8a6fb747-984b-3168-b798-6b0b66c37e43",
                                                "text": "„Bei uns Katholen dürfen nur geweihte Geistespfaffen predigen, und zwar von der Kanzel herab.“"
                                            },
                                            {
                                                "example_id": "5b5d1870-1c53-474d-b46d-3b5b5f50c3b2",
                                                "sense_id": "8a6fb747-984b-3168-b798-6b0b66c37e43",
                                                "text": "„Wieviele katholische Pastoren ihre Schäfchen auf wie vielen heiligen Altären gefickt haben mögen und auf welchen Orgelbänken stiller Emporen wieviele Frauen, Mädchen und Jungen Opfer sexuellen Missbrauchs zölibatärer Katholen geworden sind, darüber wird nicht offen gesprochen.“"
                                            },
                                            {
                                                "example_id": "cea2b604-7223-4a7f-9d14-4c1558c5318a",
                                                "sense_id": "8a6fb747-984b-3168-b798-6b0b66c37e43",
                                                "text": "„Der Kathole sah aus wie ein entkommener Polizistenmisshandler aus den Siebzigerjahren, der aus Angst vor einer politischen Karriere in die Kutte geschlüpft ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
