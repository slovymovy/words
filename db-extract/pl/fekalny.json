                                                "example_id": "3abe5d0b-1e90-4190-8249-da17ab8d7aa9",
                                                "sense_id": "0b5174d1-fc9b-30ae-aa32-deae7640b2d1",
                                                "text": "On forme des engrais excellents avec les matières fécales tant de l’homme que de plusieurs animaux."
                                            },
