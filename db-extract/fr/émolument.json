                "senses": [
                    {
                        "sense_id": "cc2eab0b-278c-330a-b3ae-4a75295cef58",
                        "entry_id": "ecd93a38-7e8f-3cc6-a66a-cf4fc3b9cfc8",
                        "glosses": [
                            "Honoraires des officiers ministériels."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "29e11893-3edc-3a0d-928c-3f75f0900e03",
                        "entry_id": "ecd93a38-7e8f-3cc6-a66a-cf4fc3b9cfc8",
                        "glosses": [
                            "Part des bénéfices de la communauté revenant à chacun des deux époux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6ad1fe57-7cd9-35ac-b0ca-ba1018b2235d",
                        "entry_id": "ecd93a38-7e8f-3cc6-a66a-cf4fc3b9cfc8",
                        "glosses": [
                            "Salaire."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "9db8d27d-7664-4957-b270-2334ed139175",
                                "sense_id": "6ad1fe57-7cd9-35ac-b0ca-ba1018b2235d",
                                "text": "Cela a permis, pendant trois générations, de comprimer les salaires des uns pour gonfler les émoluments des autres."
                            },
                            {
                                "example_id": "7b2d6bc4-8a75-4257-a2b3-a022f395094c",
                                "sense_id": "6ad1fe57-7cd9-35ac-b0ca-ba1018b2235d",
                                "text": "Au faîte de sa gloire, entre Europe 1 et ses autres activités, ses émoluments mensuels dépassaient 50 000 euros net."
                            }
                        ]
                    },
                    {
                        "sense_id": "507d50a3-d0d2-3ee8-90ab-12551c782043",
                        "entry_id": "ecd93a38-7e8f-3cc6-a66a-cf4fc3b9cfc8",
                        "glosses": [
                            "Ensemble des sommes que touche un fonctionnaire quand, à son traitement fixe, soumis à une retenue pour pension civile, viennent s’ajouter des indemnités, des allocations non soumises à cette retenue."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "324a733f-3244-400f-aae5-c382cb38b853",
                                "sense_id": "507d50a3-d0d2-3ee8-90ab-12551c782043",
                                "text": "J’aurai des appointements fixes, tu comprends, des émoluments, comme on dit. Pas de surprises ; ce n’est pas comme avec les récoltes."
                            },
                            {
                                "example_id": "20fa82a9-49c7-4219-beca-5a117d94612f",
                                "sense_id": "507d50a3-d0d2-3ee8-90ab-12551c782043",
                                "text": "Pendant les trois sessions du 13ᵉ Parlement du Bas-Canada, les élus persistent à exiger de scruter le compte des dépenses publiques à la loupe, en particulier les émoluments des employés de l'État, si haut placés soient-ils."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d31a83d-8866-4052-aef8-870aa48267d4",
                        "source_entry_id": "ecd93a38-7e8f-3cc6-a66a-cf4fc3b9cfc8",
                        "source_sense_id": "6ad1fe57-7cd9-35ac-b0ca-ba1018b2235d",
                        "source_sense_description": "Rémunération",
                        "target_lang_word": "emolument",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emolument",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b6b6052-acd7-33ef-aa8a-9ee1337b8153",
                                        "entry_id": "a53b211d-c17e-3393-b219-155362bda333",
                                        "glosses": [
                                            "Payment for employment or an office; compensation for a job, which is usually monetary."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b3006e-ae17-4912-b41d-d7ad4f596efe",
                                                "sense_id": "4b6b6052-acd7-33ef-aa8a-9ee1337b8153",
                                                "text": "No Title of Nobility shall be granted by the United States: And no Person holding any Office of Profit or Trust under them, shall, without the Consent of the Congress, accept of any present, Emolument, Office, or Title, of any kind whatever, from any King, Prince, or foreign State."
                                            },
                                            {
                                                "example_id": "59dda4b1-925c-471b-8043-2ea5398a946e",
                                                "sense_id": "4b6b6052-acd7-33ef-aa8a-9ee1337b8153",
                                                "text": "Even when a mere child I began my travels, and made many tours of discovery into foreign parts and unknown regions of my native city, to the frequent alarm of my parents, and the emolument of the town-crier."
                                            },
                                            {
                                                "example_id": "3c9f6cfd-0d4e-41da-8395-b502cebc283f",
                                                "sense_id": "4b6b6052-acd7-33ef-aa8a-9ee1337b8153",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor [...] had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            },
                                            {
                                                "example_id": "f09b8a0f-bf6a-4356-8d91-54ff2bcbc6b5",
                                                "sense_id": "4b6b6052-acd7-33ef-aa8a-9ee1337b8153",
                                                "text": "Plus, the Department of Justice has argued in the past that SGEs are subject to the emoluments clause, which means they cannot take payments from foreign governments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba811dcb-6dce-3395-a494-e014f4932a09",
                                        "entry_id": "a53b211d-c17e-3393-b219-155362bda333",
                                        "glosses": [
                                            "Payment for employment or an office; compensation for a job, which is usually monetary.",
                                            "Multure to a miller."
                                        ],
