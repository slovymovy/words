                                "target_senses": [
                                    {
                                        "sense_id": "7eb5d9bd-5416-39fa-9952-6967374f39e4",
                                        "entry_id": "b5b238e9-00d7-3ec8-a6f2-591826dc2ecd",
                                        "glosses": [
                                            "Alternative form of omertà."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b1a90fa-040f-4c4e-b000-cecd91af7dff",
                                                "sense_id": "7eb5d9bd-5416-39fa-9952-6967374f39e4",
                                                "text": "Patriarca [Raymond Patriarca Jr.] pleaded guilty in December 1991 to racketeering and conspiracy charges, but he refused to admit he was a member of the Mafia, clinging to his vow of \"omerta\" to the secret organization."
                                            },
                                            {
                                                "example_id": "0288d00e-e205-4edc-b97d-d5e96393c3a8",
                                                "sense_id": "7eb5d9bd-5416-39fa-9952-6967374f39e4",
                                                "text": "There was a time that high-profile killings such as the 1968 assassinations of Robert F[rancis] Kennedy and Martin Luther King Jr. brought passionate cries for limitations on handguns. A bipartisan omerta now smothers the issue."
                                            },
                                            {
                                                "example_id": "e86bc7e4-7a02-4c84-b53a-16ab27b1b26c",
                                                "sense_id": "7eb5d9bd-5416-39fa-9952-6967374f39e4",
                                                "text": "But although her [Carol Thatcher's] agent has invoked that tradition of post-show omerta in her defence, the truth is that few would trust these days to what it is now possibly risky to call Chinese walls."
                                            },
                                            {
                                                "example_id": "a6e6a302-33ac-4d08-b065-bf5942e6bba0",
                                                "sense_id": "7eb5d9bd-5416-39fa-9952-6967374f39e4",
                                                "text": "Over the past ten years, a series of high-profile CEOs have broken unwritten omertas not to address the contentious challenges posed by climate change, human rights, and increased transparency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
