                {
                    "sense_id": "1376f0d3-dc4d-3e66-8582-aa091df4e874",
                    "sense_definition": "Een beschadiging aan een tand of kies veroorzaakt door tandbederf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dental_cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De tandarts moest gisteren een diep <w>gaatje</w> vullen.",
                            "target_lang_translations": {
                                "en": "The dentist had to fill a deep <w>cavity</w> yesterday.",
                                "ru": "Вчера стоматологу пришлось запломбировать глубокую <w>дырку</w>.",
                                "fr": "Le dentiste a dû soigner une <w>carie</w> profonde hier."
                            }
                        },
                        {
                            "text": "Door goed te poetsen, kun je <w>gaatjes</w> voorkomen.",
                            "target_lang_translations": {
