                                                "example_id": "26788cf3-e4a3-4c5e-bd8b-c1ae367dea6f",
                                                "sense_id": "e00958ea-5dfb-308a-ab54-19d29398d290",
                                                "text": "Cette voiture consomme beaucoup d’essence."
                                            },
                                            {
                                                "example_id": "46058d5a-008b-4d3a-8538-92b73f19c8ff",
                                                "sense_id": "e00958ea-5dfb-308a-ab54-19d29398d290",
                                                "text": "Les fournisseurs d'accès à Internet constatent une hausse marquée de la consommation de la bande passante."
                                            },
                                            {
                                                "example_id": "492901f3-99cf-4b03-b998-cccb925f679d",
                                                "sense_id": "e00958ea-5dfb-308a-ab54-19d29398d290",
                                                "text": "Laissé à lui-même, le boutonneux consommait une quantité effarante de pornographie explicite, de haschich marocain et de chips au vinaigre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4edd77cc-f328-3e83-93df-9d04d8fc3b79",
                                        "entry_id": "e66613f0-c73e-3ec3-b5f6-36a20b344a7a",
                                        "glosses": [
