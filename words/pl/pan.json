                                "target_lang_sense_clarification": "мифология"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Pan",
                                "target_lang_sense_clarification": "Greek god of nature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f74a495d-2404-3f0e-98dc-7b9b3c002d88",
