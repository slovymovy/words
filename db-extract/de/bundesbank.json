                "senses": [
                    {
                        "sense_id": "410860fa-45b4-378b-be5b-a87b50329dfe",
                        "entry_id": "8de380c8-a22d-3d7c-93fa-0f096bd1c0e4",
                        "glosses": [
                            "Deutsche Bundesbank; die Zentralbank der Bundesrepublik Deutschland"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "1a59b2a7-9aa8-44f1-a972-77ec6d97fc9e",
                                "sense_id": "410860fa-45b4-378b-be5b-a87b50329dfe",
                                "text": "Die Bundesbank versorgt als Notenbank die Wirtschaft mit Bargeld und sichert die physische Umlauffähigkeit des Bargeldes."
                            },
                            {
                                "example_id": "0bdb799f-3eff-4654-abb6-eb1731264314",
                                "sense_id": "410860fa-45b4-378b-be5b-a87b50329dfe",
                                "text": "Es sei mit einer merklichen Belebung der Wirtschaftsleistung im dritten Quartal zu rechnen, heißt es im Monatsbericht der Bundesbank."
                            },
                            {
                                "example_id": "b5a28d16-86ad-4321-ba64-d9a3f98cb0c0",
                                "sense_id": "410860fa-45b4-378b-be5b-a87b50329dfe",
                                "text": "„Die in die Höhe schießenden Immobilienpreise alarmieren auch die Bundesbank.“"
                            },
                            {
                                "example_id": "6b7ecd87-e195-41f4-af8f-05c033aa41db",
                                "sense_id": "410860fa-45b4-378b-be5b-a87b50329dfe",
                                "text": "„Mittlerweile kaufen unter anderem die EZB oder die Bundesbank Yuan als Reservewährung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
