            "senses": [
                {
                    "sense_id": "2e3f8ecb-be69-3674-8291-187417337efa",
                    "sense_definition": "Kurzer Gottesdienst oder religiöse Feier, meist außerhalb der regulären Hauptgottesdienste",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gottesdienst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden Sonntagabend versammeln sich die Dorfbewohner in der kleinen Kapelle zu einer kurzen <w>Andacht</w>."
                        },
                        {
                            "text": "Der Pfarrer wird heute vor dem gemeinsamen Abendessen eine feierliche <w>Andacht</w> halten."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "eine Andacht halten",
                        "an einer Andacht teilnehmen"
                    ]
                },
                {
                    "sense_id": "8f77bf92-a7a5-3e52-8189-4b33b1df9094",
                    "sense_definition": "Innere religiöse Sammlung und tiefe Ergriffenheit beim Gebet oder Betrachten des Göttlichen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "versunkenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Gläubigen knieten nieder und verharrten für einige Minuten in stiller <w>Andacht</w>."
                        },
                        {
                            "text": "Mit tiefer <w>Andacht</w> lauschte die Gemeinde den feierlichen Worten des Bischofs."
                        }
                    ],
                    "synonyms": [
                        "Frömmigkeit",
                        "Ehrfurcht"
                    ],
                    "common_phrases": [
