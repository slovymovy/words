                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1057f389-d2aa-4366-bd7b-a821387ce68b",
                                "sense_id": "ccec8f3f-0116-3aea-8853-8af352e6cff0",
                                "text": "Le processus est intuable. Je ne peux plus redémarrer le PC sans bidouiller."
                            },
                            {
                                "example_id": "0fffa6b8-f9db-48dd-912c-4d3471eff9d6",
                                "sense_id": "ccec8f3f-0116-3aea-8853-8af352e6cff0",
                                "text": "Les processus intuables sont monnaie courante avec Vista."
                            }
                        ]
                    }
