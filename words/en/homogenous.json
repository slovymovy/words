{
    "word_family": [
        "homogeneity",
        "homogenize",
        "homogenization"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46b59d41-819d-3e65-bc00-310afc41806b",
                    "sense_definition": "Consisting of parts or elements that are all of the same kind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uniformity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>homogenous</w> group of students shared similar cultural backgrounds and interests.",
                            "target_lang_translations": {
                                "zh": "这群<w>同质的</w>学生有着相似的文化背景和兴趣。"
                            }
                        },
                        {
                            "text": "The mixture became <w>homogenous</w> after being stirred for several minutes.",
                            "target_lang_translations": {
                                "zh": "搅拌几分钟后，混合物变得<w>均匀</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "由相同种类或性质的成分组成，同质的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同质的",
                                "target_lang_sense_clarification": "指事物在性质、成分或结构上完全相同。"
                            },
                            {
                                "target_lang_word": "均匀的",
                                "target_lang_sense_clarification": "指混合物各部分分布一致，没有差异。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a371c27-4d7b-3bb4-907a-630313b23358",
                    "sense_definition": "Having the same genetic structure or origin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These two species are <w>homogenous</w> in their fundamental genetic makeup.",
                            "target_lang_translations": {
                                "zh": "这两个物种在基本的遗传构成上是<w>同源的</w>。"
                            }
                        },
                        {
                            "text": "The researchers studied <w>homogenous</w> populations to track specific evolutionary traits.",
                            "target_lang_translations": {
                                "zh": "研究人员通过研究<w>同质的</w>种群来追踪特定的进化特征。"
                            }
                        }
                    ],
                    "synonyms": [
                        "homologous"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有相同的遗传结构或起源。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "同源的",
                                "target_lang_sense_clarification": "指在生物学上具有共同的起源或遗传基础。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}