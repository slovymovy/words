                                "target_senses": [
                                    {
                                        "sense_id": "9ae99c18-21bb-3a73-96db-1bf6710dd2c2",
                                        "entry_id": "6087f0b8-f1a9-33aa-99ea-0d270df6fd30",
                                        "glosses": [
                                            "odborník v zeměpise, geograf"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1fb5a0e-078d-4d1f-98c9-008a206172df",
                        "source_entry_id": "1749d7ff-daad-3af0-834f-10be5bb6f5a5",
                        "source_sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
                        "target_lang_word": "géographe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géographe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17285d61-8ea5-31e9-9b79-cea1031efc96",
                                        "entry_id": "a859c4fe-5ca4-3f7f-be6d-6360dbba6c05",
                                        "glosses": [
                                            "Personne qui étudie la géographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c470be5-a886-41b3-8e28-6a46bf9d6c8a",
                                                "sense_id": "17285d61-8ea5-31e9-9b79-cea1031efc96",
                                                "text": "J’avais toujours soupçonné les géographes de ne savoir ce qu’ils disent lorsqu’ils placent le champ de bataille de Munda dans le pays des Bastuli-Poeni, près de la moderne Monda, à quelque deux lieues au nord de Marbella."
                                            },
                                            {
                                                "example_id": "d803b498-22c2-44d0-90db-5284d6dae7b9",
                                                "sense_id": "17285d61-8ea5-31e9-9b79-cea1031efc96",
                                                "text": "Avant de faire l’analyse du tableau comparatif des principales opinions émises par les savans et les géographes sur la population du globe, il faut partager tous les pays qui le composent en deux classes."
                                            },
                                            {
                                                "example_id": "24db9cb2-f5ae-4b0e-8d74-6b6ca970d794",
                                                "sense_id": "17285d61-8ea5-31e9-9b79-cea1031efc96",
                                                "text": "L’île [Jan Mayen] fut visitée, dix ans plus tard, par « La Manche », navire français commandé par l’Amiral Bienaimé, alors capitaine de vaisseau, accompagné du géographe Ch. Rabot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5c67439-6f34-492c-bd84-f373d4155355",
                        "source_entry_id": "1749d7ff-daad-3af0-834f-10be5bb6f5a5",
                        "source_sense_id": "e80ee816-0243-3626-baac-5d1adc4b30bd",
