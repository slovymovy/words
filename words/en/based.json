{
    "word_family": [
        "base",
        "baseless",
        "basic",
        "basement",
        "basis",
        "debase"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c193e9f2-8424-32e5-b59c-9b9379da3821",
                    "sense_definition": "The past participle of <w>base</w>; modeled on, developed from, or using something as a source.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "derived_from",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new movie is <w>based</w> on a famous novel.",
                            "target_lang_translations": {
                                "ru": "Новый фильм <w>основан</w> на известном романе.",
                                "tr": "Yeni film ünlü bir romandan <w>uyarlanmıştır</w>."
                            }
                        },
                        {
                            "text": "Her opinion is <w>based</w> on years of scientific research.",
                            "target_lang_translations": {
                                "ru": "Ее мнение <w>основано</w> на годах научных исследований.",
                                "tr": "Onun fikri yıllar süren bilimsel araştırmalara <w>dayanmaktadır</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "based on",
                        "based upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от <w>base</w>; смоделированный по образцу, развитый из чего-либо или использующий что-либо в качестве источника.",
                        "tr": "Bir şeyden model alınarak, geliştirilerek veya bir şeyi kaynak olarak kullanarak oluşturulmuş."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основанный",
                                "target_lang_sense_clarification": "созданный на базе чего-либо"
                            },
                            {
                                "target_lang_word": "созданный на основе",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dayanan",
                                "target_lang_sense_clarification": "bir şeye temellenmiş"
                            },
                            {
                                "target_lang_word": "dayalı",
                                "target_lang_sense_clarification": "bir esasa bağlı olan"
                            },
                            {
                                "target_lang_word": "uyarlanan",
                                "target_lang_sense_clarification": "bir eserden yola çıkılarak yapılmış"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e9c1a81-90e8-31cf-ae5c-dd7c92a4e173",
                    "sense_definition": "The past participle of <w>base</w>; having a main office, home, or center of operations in a specific place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technology company is <w>based</w> in California.",
                            "target_lang_translations": {
                                "ru": "Технологическая компания <w>базируется</w> в Калифорнии.",
                                "tr": "Teknoloji şirketinin merkezi Kaliforniya'da <w>bulunmaktadır</w>."
                            }
                        },
                        {
                            "text": "Although he travels often, he is <w>based</w> in London.",
                            "target_lang_translations": {
                                "ru": "Хотя он часто путешествует, он <w>базируется</w> в Лондоне.",
                                "tr": "Sık sık seyahat etmesine rağmen Londra'da <w>yerleşiktir</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "based in",
                        "based out of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от <w>base</w>; имеющий главный офис, дом или центр деятельности в определенном месте.",
                        "tr": "Merkezi, ana ofisi veya yaşam alanı belirli bir yerde bulunan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "базирующийся",
                                "target_lang_sense_clarification": "расположенный (об организации или человеке)"
                            },
                            {
                                "target_lang_word": "расположенный",
                                "target_lang_sense_clarification": "находящийся в определенном месте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "merkezli",
                                "target_lang_sense_clarification": "ana merkezi bir yerde olan"
                            },
                            {
                                "target_lang_word": "yerleşik",
                                "target_lang_sense_clarification": "bir yerde bulunan veya faaliyet gösteren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "56c3bdb2-3e2d-38bc-af7f-faa1a9d03a47",
                    "sense_definition": "Having a foundation or underlying support; often used in compound words to describe the primary component or method.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "standard_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They presented a soundly <w>based</w> argument to the committee.",
                            "target_lang_translations": {
                                "ru": "Они представили комитету хорошо <w>обоснованный</w> аргумент.",
                                "tr": "Komiteye sağlam bir şekilde <w>temellendirilmiş</w> bir argüman sundular."
                            }
                        },
                        {
                            "text": "We need a broad-<w>based</w> approach to solve this complex issue.",
                            "target_lang_translations": {
                                "ru": "Нам нужен подход, имеющий широкую <w>основу</w>, для решения этой сложной проблемы.",
                                "tr": "Bu karmaşık sorunu çözmek için geniş <w>tabanlı</w> bir yaklaşıma ihtiyacımız var."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soundly based",
                        "broad-based"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий фундамент или базовую поддержку; часто используется в сложных словах для описания основного компонента или метода.",
                        "tr": "Temeli veya alt yapısı olan; genellikle bileşik kelimelerde ana bileşeni veya yöntemi tanımlamak için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обоснованный",
                                "target_lang_sense_clarification": "имеющий веские основания"
                            },
                            {
                                "target_lang_word": "имеющий основу",
                                "target_lang_sense_clarification": "в составе сложных слов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tabanlı",
                                "target_lang_sense_clarification": "temelinde bir şey yatan"
                            },
                            {
                                "target_lang_word": "temelli",
                                "target_lang_sense_clarification": "dayanağı olan"
                            },
                            {
                                "target_lang_word": "bazlı",
                                "target_lang_sense_clarification": "esas alınan ögeye göre düzenlenmiş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e291c8f3-359e-3824-ae38-0487a3891b12",
                    "sense_definition": "Authentic and true to oneself, without worrying about how others perceive one's personality or behavior.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is so <w>based</w> because he wears whatever he wants regardless of trends.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>базированный</w>, потому что носит что хочет, не обращая внимания на тренды.",
                                "tr": "Trendlere bakmaksızın ne isterse giydiği için çok <w>kendine sadık</w> biri."
                            }
                        },
                        {
                            "text": "You have to stay positive and stay <w>based</w> even when people criticize you.",
                            "target_lang_translations": {
                                "ru": "Нужно сохранять позитив и оставаться <w>базированным</w>, даже когда люди критикуют тебя.",
                                "tr": "İnsanlar seni eleştirse bile pozitif kalmalı ve <w>çizgini bozmamalısın</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "maverick"
                    ],
                    "antonyms": [
                        "cringe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аутентичный и верный себе, не беспокоящийся о том, как другие воспринимают его личность или поведение.",
                        "tr": "Başkalarının kendi kişiliğini veya davranışlarını nasıl algıladığını umursamayan, özgün ve kendine sadık."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "базированный",
                                "target_lang_sense_clarification": "сленг: аутентичный, крутой"
                            },
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "сленг: высшая похвала"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kendi gibi",
                                "target_lang_sense_clarification": "argo: özgün, başkalarını takmayan"
                            },
                            {
                                "target_lang_word": "kral",
                                "target_lang_sense_clarification": "argo: kendine sadık, duruşu olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37768ada-6ff4-329b-8a4e-17528791011a",
                    "sense_definition": "Admirable, courageous, or praiseworthy, especially for expressing controversial opinions or rejecting social norms.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His refusal to apologize for his beliefs was seen as <w>based</w> by his followers.",
                            "target_lang_translations": {
                                "ru": "Его отказ извиняться за свои убеждения был воспринят его последователями как <w>база</w>.",
                                "tr": "İnançları için özür dilemeyi reddetmesi, takipçileri tarafından <w>kral hareket</w> olarak görüldü."
                            }
                        },
                        {
                            "text": "That was a incredibly <w>based</w> take on the political situation.",
                            "target_lang_translations": {
                                "ru": "Это было невероятно <w>базированное</w> мнение о политической ситуации.",
                                "tr": "Bu, siyasi durum hakkında inanılmaz derecede <w>cesur</w> bir yorumdu."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwoke"
                    ],
                    "antonyms": [
                        "cringe",
                        "unbased"
                    ],
                    "common_phrases": [
                        "based and redpilled"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восхитительный, смелый или достойный похвалы, особенно за выражение спорных мнений или отказ от социальных норм.",
                        "tr": "Özellikle tartışmalı fikirleri dile getirdiği veya toplumsal kuralları reddettiği için takdire şayan, cesur veya övgüye değer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "базированный",
                                "target_lang_sense_clarification": "сленг: смелый, правильный"
                            },
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "сленг: одобрение мнения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kral hareket",
                                "target_lang_sense_clarification": "argo: cesur ve takdire şayan"
                            },
                            {
                                "target_lang_word": "doğru söze ne denir",
                                "target_lang_sense_clarification": "argo: takdir toplayan fikir"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "4594da54-33be-3f7a-a6d8-f3fb0cc19e2a",
                    "sense_definition": "Used to express emphatic agreement or approval, often regarding a controversial statement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_intj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You think we should lower taxes? <w>Based</w>.",
                            "target_lang_translations": {
                                "ru": "Ты думаешь, нам стоит снизить налоги? <w>База</w>.",
                                "tr": "Vergileri düşürmemiz gerektiğini mi düşünüyorsun? <w>Helal</w>."
                            }
                        },
                        {
                            "text": "He actually said that to the boss? <w>Based</w>.",
                            "target_lang_translations": {
                                "ru": "Он реально сказал это боссу? <w>База</w>.",
                                "tr": "Bunu gerçekten patrona mı söyledi? <w>Aynen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "damn straight",
                        "word",
                        "right on"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения решительного согласия или одобрения, часто в отношении спорного утверждения.",
                        "tr": "Özellikle tartışmalı bir ifadeye yönelik güçlü bir onay veya katılım bildirmek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "сленг: абсолютное согласие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aynen",
                                "target_lang_sense_clarification": "argo: tam olarak katıldığını belirtir"
                            },
                            {
                                "target_lang_word": "heval",
                                "target_lang_sense_clarification": "argo: onay bildirme"
                            },
                            {
                                "target_lang_word": "helal",
                                "target_lang_sense_clarification": "argo: takdir ve onay nidası"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}