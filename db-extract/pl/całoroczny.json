                                    {
                                        "sense_id": "79119832-3c51-3f05-ba90-58cee19bb0a2",
                                        "entry_id": "f1de897f-dc2f-3cb3-bf85-6ac504b97515",
                                        "glosses": [
                                            "das gesamte Jahr über, durchgehend von Januar bis Dezember; 365 Tage lang; alle vier Jahreszeiten überdauernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82eadb5d-edb7-46e1-a500-375531ae1434",
                                                "sense_id": "79119832-3c51-3f05-ba90-58cee19bb0a2",
                                                "text": "Die Eisdiele am Marktplatz hat ganzjährig geöffnet."
                                            },
                                            {
                                                "example_id": "a3c1391d-da0e-488f-93cc-ccdccb452eb8",
                                                "sense_id": "79119832-3c51-3f05-ba90-58cee19bb0a2",
                                                "text": "„Nahe dem Äquator gedeihen Bäume in strahlender Sonne, heftigem Regen und ganzjähriger Wärme.“"
                                            },
                                            {
                                                "example_id": "08f076cf-5236-4f5d-9196-b1a565d8711d",
                                                "sense_id": "79119832-3c51-3f05-ba90-58cee19bb0a2",
                                                "text": "„Auf der österreichischen Roten Liste der gefährdeten Tierarten wird der Frauennerfling aufgeführt, in zahlreichen Landesfischereiverordnungen in dem Land ist er als ganzjährig geschont gelistet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
