                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0da06547-14a1-38d9-bc73-46efcd10738f",
                                        "entry_id": "546204ea-f63a-3125-8384-f3c4d484635e",
                                        "glosses": [
                                            "Pays d’Afrique, entouré du Nigeria au nord-ouest, du Tchad au nord-est, de la République centrafricaine à l’est, du Congo au sud-est, du Gabon et de la Guinée équatoriale au sud, et du golfe de Guinée au sud-ouest, et dont la capitale est Yaoundé."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1290ded-0193-4ab8-b4f3-758c2ff384b0",
                                                "sense_id": "0da06547-14a1-38d9-bc73-46efcd10738f",
                                                "text": "L’objectif de la France était d’ailleurs de procéder au plus vite à la dégermanisation du Cameroun. Le Père Jules Douvry fut confirmé administrateur apostolique du Cameroun durante bello le 3 février 1917."
                                            },
                                            {
                                                "example_id": "6d0c25f3-c41a-41bc-b2b6-36b11e3e7582",
                                                "sense_id": "0da06547-14a1-38d9-bc73-46efcd10738f",
                                                "text": "C'est dans ce cercle de personnages politiques réservés et non de personnalités politiciennes et paradeuses qu'il convient de rechercher le profil du remplaçant que Paul Biya prépare pour le Cameroun », précise le politologue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "695902fb-a5ef-453c-84d8-664adfe8a05e",
                        "source_entry_id": "dfee87ec-b6a9-3313-bc89-154599cd31e9",
                        "source_sense_id": "d4b053fa-b136-3452-bdf5-2fa094965ea5",
                        "source_sense_description": "country in Central Africa",
                        "target_lang_word": "Kamerun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kamerun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                        "entry_id": "c05e610a-dfad-3c0d-9717-a228e2b2d499",
                                        "glosses": [
                                            "ein Land in Zentralafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a1d27c-7f64-4086-b789-e4f296ac0058",
                                                "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                                "text": "Kamerun war früher eine deutsche Kolonie."
                                            },
                                            {
                                                "example_id": "6a71c72a-4adf-44c2-bb0e-5ae14681a15e",
                                                "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                                "text": "Jaunde ist die Hauptstadt von Kamerun."
                                            },
                                            {
                                                "example_id": "8d1aea06-360b-4972-bf3b-d33092730949",
                                                "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                                "text": "„Ethnisch gliedert sich Kamerun in 286 verschiedenen Volks- und Sprachgruppen.“"
                                            },
                                            {
                                                "example_id": "fa0ad7da-f558-4f01-9e41-f3d4786ee54d",
                                                "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                                "text": "„Viele Klassenräume in Kamerun sind mit Schulbänken ausgestattet, die am Boden fixiert sind.“"
                                            },
                                            {
                                                "example_id": "5452f0dc-2a1d-40ce-83d4-a4564e6c2176",
                                                "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                                "text": "„In Kamerun wurde auch eine Flaggenpost eingeführt (Boten mit Flaggen von Dorf zu Dorf), die aber im Wesentlichen amtlichen Zwecken diente.“"
                                            },
                                            {
                                                "example_id": "5f588b59-b1d5-42bb-8423-b083b0ea2071",
                                                "sense_id": "4e3e51ea-6920-39a3-ada6-6e92fa9a34c2",
                                                "text": "„Der hatte 1884 mit anderen politischen Anführern die Souveränität Kameruns dem Kaiserreich übertragen – es war die Geburtsstunde der deutschen Kolonie Kamerun gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
