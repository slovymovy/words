                                    {
                                        "sense_id": "2d8d0290-6add-3f3c-8a90-c1a238636c83",
                                        "entry_id": "8e70666e-6829-3068-b544-13a8b21d8d33",
                                        "glosses": [
                                            "van buiten, niet van hier, buitenlands"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fadd494-62c9-3c8c-8cba-1563556f24f2",
                                        "entry_id": "8e70666e-6829-3068-b544-13a8b21d8d33",
                                        "glosses": [
                                            "gek, onwerkelijk; een vreemd gevoel"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9f511d0-a070-3ad4-b116-077bf6d26e47",
                                        "entry_id": "8e70666e-6829-3068-b544-13a8b21d8d33",
                                        "glosses": [
                                            "niet bekend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf90f641-2770-438b-af18-490d87e4abd5",
                                                "sense_id": "c9f511d0-a070-3ad4-b116-077bf6d26e47",
                                                "text": "Het is mij vreemd."
                                            },
                                            {
                                                "example_id": "d42b91c3-b9c5-4143-8f35-13252e4a6a50",
                                                "sense_id": "c9f511d0-a070-3ad4-b116-077bf6d26e47",
                                                "text": "Vlak na de ontvangst van Harolds telegram begon Teresa te dromen over iets wat vreemd was voor iemand die altijd in zo'n dorre streek had gewoond."
                                            },
                                            {
                                                "example_id": "0e7f5726-c5ed-4aad-b1b1-dc078137f8b7",
                                                "sense_id": "c9f511d0-a070-3ad4-b116-077bf6d26e47",
                                                "text": "Vandaag zou ik de woestijn intrekken, een dorre vlakte die mij totaal vreemd was."
                                            },
                                            {
                                                "example_id": "9ee94a99-1975-4a4d-be14-a1c3edbb0572",
                                                "sense_id": "c9f511d0-a070-3ad4-b116-077bf6d26e47",
                                                "text": "'God weet dat we het nodig hebben dat jij schildertl' Het was vreemd om te bedenken dat er zulke stormen door Europa raasden, want in Arazuelo was het relatief rustig."
                                            },
                                            {
                                                "example_id": "f136d9b7-6197-41a0-9782-ad0ab05d9a17",
                                                "sense_id": "c9f511d0-a070-3ad4-b116-077bf6d26e47",
                                                "text": "Desondanks hing er een vreemd gevoel van twijfel in de lucht, de cyclische hoop dat alles gauw achter de rug zou zijn, dat de republikeinse regering het verzet zou organiseren tegen deze nationalistische rebellen en hun buitenlandse bondgenoten, die steeds grotere delen van het land in handen kregen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cbb79f8-bc4b-43a4-9840-0e4512912f93",
                        "source_entry_id": "ee8d25b8-5827-31a7-9c99-e5de80d26270",
                        "source_sense_id": "7c3411de-bc5a-3a95-b53d-a76c2e3568a5",
                        "target_lang_word": "странно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "странно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "66ba2b9b-d448-32fa-a32d-b46434c76729",
                                        "entry_id": "b6076f0c-5e89-3c83-9e65-e9a6686e0b58",
                                        "glosses": [
                                            "наречие к странный; вызывая недоумение; не так, как ожидалось, не так как всегда, удивительно или подозрительно"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b8dcbcb-9ae2-40f6-b6ce-5aafbd532823",
                                                "sense_id": "66ba2b9b-d448-32fa-a32d-b46434c76729",
                                                "text": "Посмотрел он на меня как-то странно, соскочил с подоконника и стал ходить по своему кабинетику взад-вперед."
                                            },
                                            {
                                                "example_id": "02d56ff2-3a06-4837-a598-a8ebb31ec658",
                                                "sense_id": "66ba2b9b-d448-32fa-a32d-b46434c76729",
                                                "text": "Его, между прочим, называли в семье не Вася, и не папа, и не Василий Петрович, его называли очень странно и даже несколько необычно, его называли Василек."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6595977-496a-3399-afb2-c4877db60362",
                                        "entry_id": "b6076f0c-5e89-3c83-9e65-e9a6686e0b58",
                                        "glosses": [
                                            "оценка какой-либо ситуации, чьих-либо действий как вызывающих удивление, недоумение, представляющихся необычными, непонятными"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f10bc2-3bee-44be-bff0-adc6dc245c96",
                                                "sense_id": "a6595977-496a-3399-afb2-c4877db60362",
                                                "text": "Я прислушался к своему телу. Как ни странно, ничего не болело… и тут внезапно я вспомнил то, что произошло…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
