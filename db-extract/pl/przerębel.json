                                                "example_id": "f3ac5e46-922a-403a-9d2c-20bd49e13f6b",
                                                "sense_id": "fcb15164-038a-3c37-847d-4790473b67fa",
                                                "text": "Во куда надо идти!"
                                            }
                                        ]
