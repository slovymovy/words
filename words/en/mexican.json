    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4bb7990-d4fa-31f9-b980-51679ffd7fdc",
                    "sense_definition": "Of, from, or pertaining to the country of Mexico.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_mexico_country",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves eating spicy <w>Mexican</w> food.",
                            "target_lang_translations": {
                                "ru": "Она любит есть острую <w>мексиканскую</w> еду.",
                                "zh": "她喜欢吃辣的<w>墨西哥</w>菜。"
                            }
                        },
                        {
                            "text": "The <w>Mexican</w> flag has green, white, and red stripes.",
                            "target_lang_translations": {
                                "ru": "<w>Мексиканский</w> флаг имеет зеленые, белые и красные полосы.",
                                "zh": "<w>墨西哥</w>国旗有绿、白、红三色条纹。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Mexican food",
                        "Mexican culture",
                        "Mexican border"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к стране Мексика, происходящий из неё или связанный с ней.",
                        "zh": "指墨西哥国家的，或与该国有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мексиканский",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "墨西哥的",
                                "target_lang_sense_clarification": "形容词，指代国家"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14ab01c4-7f3f-3eeb-b798-ced9f41d74fa",
                    "sense_definition": "Of or pertaining to the Mexica people (Aztecs).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_mexica_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Mexican</w> empire was vast before the arrival of Europeans.",
                            "target_lang_translations": {
                                "ru": "<w>Ацтекская</w> империя была огромной до прибытия европейцев.",
                                "zh": "在欧洲人到达之前，<w>阿兹特克</w>帝国非常辽阔。"
                            }
                        },
                        {
                            "text": "Many <w>Mexican</w> artifacts are displayed in the museum.",
                            "target_lang_translations": {
                                "ru": "Многие <w>мексиканские</w> артефакты выставлены в музее.",
                                "zh": "博物馆里陈列着许多<w>阿兹特克</w>文物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mexica",
                        "Aztec"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к народу мешика (ацтекам).",
                        "zh": "指墨西加人（阿兹特克人）的，或与他们有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
