                    },
                    {
                        "sense_id": "02b4590d-6a95-3114-a670-54f57a7a343a",
                        "entry_id": "84fa6f9a-973b-33ab-a6cf-491d70b2d46a",
                        "glosses": [
                            "Débris d’animaux morts, ordure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02b9b171-ad3f-40ca-8d23-5c350a343e10",
                                "sense_id": "02b4590d-6a95-3114-a670-54f57a7a343a",
                                "text": "Il préfère la chair vivante à la morte, et cependant il dévore les voieries les plus infectes."
                            }
                        ]
                    },
                    {
                        "sense_id": "74dfce33-92b3-30c2-b647-d038acda04af",
                        "entry_id": "84fa6f9a-973b-33ab-a6cf-491d70b2d46a",
                        "glosses": [
                            "Variante orthographique de voirie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37d79c7-c0f9-47fc-9748-1def4474ca8f",
                                "sense_id": "74dfce33-92b3-30c2-b647-d038acda04af",
                                "text": "Sur une distance de 4 mètres en retrait de l’alignement au débouché sur la voierie, la pente de la rampe de devra pas excéder 5 p. 100."
                            },
                            {
                                "example_id": "cca69bba-c3fe-41d8-ab37-eb0ac0bb80c8",
                                "sense_id": "74dfce33-92b3-30c2-b647-d038acda04af",
                                "text": "Les acheteurs auront ainsi, par exemple, la possibilité de passer un seul marché de travaux pour le terrassement, les travaux d’enrobés, le marquage et la signalisation afin de procéder à la réfection de la voierie ou encore un seul marché de travaux avec une entreprise générale de construction pour la réfection d’un bâtiment nécessitant des travaux de maçonnerie, d’électricité, de plomberie, de charpente, de peinture, de revêtements de sols, de menuiserie, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df86d7d4-95fa-4b75-9b71-52598eacc0a0",
                        "source_entry_id": "84fa6f9a-973b-33ab-a6cf-491d70b2d46a",
                        "source_sense_description": "Lieu où l’on dépose les charognes ou les cadavres (Sens 1)",
                        "target_lang_word": "Massengrab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massengrab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                        "entry_id": "49ecdf60-4a1b-3418-8d75-bb4e4134f80c",
                                        "glosses": [
                                            "Grab, das mit zahlreichen, oftmals nicht eingesargten Leichen gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a99a76-2ca7-4412-8c5c-bf03f2b378e5",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Die Täter vergruben tausende Leichen in Massengräbern.“"
                                            },
                                            {
                                                "example_id": "72aa8f35-e715-4969-baaa-9fd57e4f1926",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Das Mahnmal im Tiergarten beim Bahnhofsgelände von Lüneburg erinnert an ein Massengrab von 256 KZ-Häftlingen, deren Transport aus einem Außenlager des KZ Neuengamme in Wilhelmshaven am 7. April 1945 bombardiert wurde.“"
                                            },
                                            {
                                                "example_id": "fbddeb50-7cda-4f92-9498-d6afd5128d33",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„In Winniza waren wieder Massengräber entdeckt worden.“"
                                            },
                                            {
                                                "example_id": "98d0b0eb-34c9-4d90-961f-012b50f931cb",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Die Entdeckung eines Massengrabes - Zeugnis eines Massakers, das kapverdischen Nachbarn zugeschrieben wurde - gab ihm die Gelegenheit, den Hass innerhalb der Bevölkerung zu schüren und somit seine eigene Macht zu festigen.“"
                                            },
                                            {
                                                "example_id": "ef15ce1d-3322-437a-ba09-88619dde1ad5",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„‚Der Fund diverser Massengräber im Norden des Landes könnte unsere Versöhnungspolitik auf die schwerste Probe seit der Unabhängigkeit stellen‘, sagte Ithana gestern während einer ministeriellen Erklärung im Parlament. Da die namibische Botschaft in Südafrika weiterhin Anrufe von Personen erhalte, die Auskunft über den Standort bisher unbekannter Massengräber geben wollten, sei zu erwarten, dass sich weitere dieser Gräber finden würden.“"
                                            },
                                            {
                                                "example_id": "9235dffb-4b66-407d-a6a1-4a34af069d94",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Historiker vermuten auf dem Grundstück in Jamlitz im Landkreis Dahme-Spreewald das letzte unbekannte Massengrab mit bis zu 700 Häftlingen, die im Februar 1945 ermordet worden waren.“"
                                            },
                                            {
                                                "example_id": "a9091bc8-786f-47b2-8b23-b18a5c203921",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Zudem braucht es zur Öffnung eines Massengrabs die Zustimmung der regionalen Behörden und aller Angehörigen.“"
                                            },
                                            {
                                                "example_id": "b3fddf7b-f6eb-470b-909f-a00ce2484f88",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Unweit der ostbosnischen Kleinstadt Srebrenica haben diese Woche Vorbereitungsarbeiten für die Exhumierungen aus dem womöglich größten Massengrab mit Opfern des Massakers vom Juli 1995 begonnen.“"
                                            },
                                            {
                                                "example_id": "29cbe04c-78be-40b0-b044-f346ef35a4b8",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Unweit der bosnischen Hauptstadt Sarajevo sind zwei Massengräber entdeckt worden. Nachdem am Montag die Ausgrabungen aus einem Massengrab in der Ortschaft Djurdjevac (Gemeinde Hadzici) begonnen hatten, wurde etwa 150 bis 20 Meter weiter nun ein weiteres Massengrab gefunden, berichtete der TV-Sender FTV am heutigen Donnerstag unter Berufung auf Ferida Nidzic vom Verband für die Suche nach Vermissten.“"
                                            },
                                            {
                                                "example_id": "c45ea1c5-51d9-49b8-9a6a-1dd8bd35d569",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Im Stadtteil Tahura hoben Anwohner ein Massengrab für 22 Afrikaner aus, die offensichtlich von Gaddafi-Milizen rekrutiert worden waren.“"
                                            },
                                            {
                                                "example_id": "78690907-d221-46fc-9bbb-6167be35524a",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Ermittler des libyschen Übergangsrates haben in der Hauptstadt Tripolis ein Massengrab mit mehr als 1200 Leichen aus dem Jahr 1996 gefunden.“"
                                            },
                                            {
                                                "example_id": "f4230b49-effd-4d10-8a92-2207347e6a82",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Menschenrechtsgruppen haben in der westirakischen Provinz Anbar drei Massengräber mit insgesamt rund 1400 Leichen gefunden.“"
                                            },
                                            {
                                                "example_id": "5122c79a-957d-4416-a5f5-e083466392e4",
                                                "sense_id": "391a2712-7b59-31f2-9f3a-2ff710a9b14a",
                                                "text": "„Türkische Bauarbeiter haben auf dem ehemaligen Gelände einer paramilitärischen Einheit ein Massengrab mit den Leichen mutmasslicher kurdischer Rebellen entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8396fdd-9862-4656-8e1f-8ba16a5759fd",
                        "source_entry_id": "84fa6f9a-973b-33ab-a6cf-491d70b2d46a",
