                "senses": [
                    {
                        "sense_id": "450daaae-39f7-3154-9ef6-8fc96d99b67b",
                        "entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "glosses": [
                            "A rolling down."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c86a5243-d6c2-38a0-b9d6-dc889d77b2dc",
                        "entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "glosses": [
                            "A descent, especially one that passes through a series of revolutions, or by succession."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fab36a9b-6ace-35c8-bf82-522c57eefdf0",
                        "entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "glosses": [
                            "The transference of a right to a successor, or of a power from one body to another."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ef3054a7-c563-3b27-a14f-83876e47843b",
                        "entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "glosses": [
                            "Degeneration."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "1d819d6b-b0ca-48de-9c53-cccb607fbb30",
                                "sense_id": "ef3054a7-c563-3b27-a14f-83876e47843b",
                                "text": "It is quite disheartening to witness the devolution of our nation's political discourse over the past several years."
                            },
                            {
                                "example_id": "d019ec55-fe8b-47d5-8c3b-4336ac577c4b",
                                "sense_id": "ef3054a7-c563-3b27-a14f-83876e47843b",
                                "text": "He is the place where the devolution from Heaven and the evolution from earth meet."
                            }
                        ]
                    },
                    {
                        "sense_id": "81d6f66d-34c9-3c9b-8792-0047c9781305",
                        "entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "glosses": [
                            "The transfer of some powers and the delegation of some functions from a central government to local government (e.g. from the U.K. parliament to Scottish parliament and Welsh assembly)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1219e3ec-7c20-428b-a836-1ab07675354a",
                                "sense_id": "81d6f66d-34c9-3c9b-8792-0047c9781305",
                                "text": "The question of whether England should receive devolution like Scotland and Wales have has dogged British politics for years."
                            },
                            {
                                "example_id": "e1a1a15e-afbd-4ac2-bfad-2e3fb414c292",
                                "sense_id": "81d6f66d-34c9-3c9b-8792-0047c9781305",
                                "text": "Governments like devolution because it gives ministers someone else to blame for problems."
                            },
                            {
                                "example_id": "74cd0ba3-1e52-4d9f-bd48-8317cdfd3849",
                                "sense_id": "81d6f66d-34c9-3c9b-8792-0047c9781305",
                                "text": "By the 1974 general election, the Scottish National Party (SNP) were polling at 30% and there were growing calls for devolution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a44b742-eb3e-41dd-88f3-6f8db6d566fb",
                        "source_entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "source_sense_description": "a rolling down",
                        "target_lang_word": "neergang",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neergang",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36f7cc6b-f181-34e6-a769-d11cbadbc040",
                                        "entry_id": "cf1e5a89-4bdd-36e7-a4c4-af811762671e",
                                        "glosses": [
                                            "het naar beneden gaan"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eda49125-4245-3eeb-93d3-f3c7c1f78043",
                                        "entry_id": "cf1e5a89-4bdd-36e7-a4c4-af811762671e",
                                        "glosses": [
                                            "het minder worden, het afgaan"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b1b6ad-46e2-4607-8a78-9f21afcd22bb",
                                                "sense_id": "eda49125-4245-3eeb-93d3-f3c7c1f78043",
                                                "text": "Maar is de bron van het probleem niet dat miljoenen mensen wereldwijd ervan dromen om vroeg of laat Venetië te bezoeken? ‘Venetië is uniek in de wereld, het is een mirakel van menselijk vernuft, zoals de piramiden’, zegt Matteo Secchi. Hij laat zien hoe zijn haar op zijn armen overeind komt terwijl hij erover praat: ‘Venetië is een legende. Maar ik ween wanneer ik de neergang van mijn stad zie. We moeten een oplossing vinden. Iedereen is welkom hier, maar niet allemaal op hetzelfde moment.’"
                                            },
                                            {
                                                "example_id": "50206d77-84c1-42ca-a041-69135ee3d399",
                                                "sense_id": "eda49125-4245-3eeb-93d3-f3c7c1f78043",
                                                "text": "De neergang in inkomsten was al jaren geleden te voorspellen, zegt Bert Scholtens, hoogleraar Duurzame economie aan de Rijksuniversiteit Groningen. \"Helaas zijn de aardgasbaten al die jaren nauwelijks gebruikt om zorg te dragen voor alternatieve energiebronnen, of om nieuwe verdiencapaciteit op te bouwen. Onze beleidsmakers zijn herhaaldelijk op dit probleem gewezen, maar hebben nooit gekozen voor een fundamentele koerswijziging.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d34b660-85e2-458c-8e14-2b83c018b16e",
                        "source_entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
                        "source_sense_description": "a rolling down",
                        "target_lang_word": "dévolution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dévolution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d9df634-3f24-3c60-9ba0-32fcef94ca7c",
                                        "entry_id": "f6d3485f-36df-3bf9-9495-dd800bd5a9e7",
                                        "glosses": [
                                            "Transfert, transmission d’un bien, d’une succession, d’un avantage, etc., qui se fait d’une personne à une autre en vertu d’un droit dévolu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6949c28f-fa6f-4810-b13a-ca38bea15e15",
                                                "sense_id": "4d9df634-3f24-3c60-9ba0-32fcef94ca7c",
                                                "text": "Il y eut dévolution de la ligne paternelle à la ligne maternelle."
                                            },
                                            {
                                                "example_id": "ad4b9312-d454-4205-bbc7-09502bf6893d",
                                                "sense_id": "4d9df634-3f24-3c60-9ba0-32fcef94ca7c",
                                                "text": "Les biens de celui qui meurt sans héritier passent à l’État par dévolution, s’il n’existe pas de testament."
                                            },
                                            {
                                                "example_id": "3f35a611-ae1c-4713-82a5-ea7c86c2f162",
                                                "sense_id": "4d9df634-3f24-3c60-9ba0-32fcef94ca7c",
                                                "text": "C’est en ce dernier cas qu’intervient le droit de dévolution : c’est le droit du supérieur de pourvoir lui-même à un bénéfice, au cas où le collateur ordinaire a violé les règles imposées à la désignation du bénéficier."
                                            },
                                            {
                                                "example_id": "5b4eae8c-4582-496b-8920-7f5fe42fed22",
                                                "sense_id": "4d9df634-3f24-3c60-9ba0-32fcef94ca7c",
                                                "text": "Officiellement, la position successorale de Claude ne présentait que des conséquences civiles sur la dévolution du patrimoine de l’empereur, mais en réalité elle entraînait des implications politiques claires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98d5a09f-475e-36d4-9234-cc3f706d064a",
                                        "entry_id": "f6d3485f-36df-3bf9-9495-dd800bd5a9e7",
                                        "glosses": [
                                            "Acte par lequel un enseignant fait accepter à l’élève la responsabilité d’une situation d’apprentissage ou d’un problème et accepte lui-même les conséquences de ce transfert."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e078b94a-b842-4687-8238-0e57fbe5df2c",
                        "source_entry_id": "b15fafd2-d658-3047-9543-273ecd3f3c3c",
