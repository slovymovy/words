                                        "entry_id": "1f9964c9-0b0b-32ef-9b08-693f2b943967",
                                        "glosses": [
                                            "The study of UFOs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e440119-2f5b-45a4-bef6-9313aa9bec16",
                                                "sense_id": "d963b0bd-472e-3f13-8c33-bdfccb22e13a",
                                                "text": "I'm an expert in my field\nUfology, yes, it's all real\nAncient aliens, it's all true\nI'm an expert just like you"
                                            }
                                        ]
                                    }
                                ]
                            }
