                "senses": [
                    {
                        "sense_id": "ebd58e8d-12c6-39ce-a23d-dd1cd589d07a",
                        "entry_id": "dfad6fd5-693b-31f2-822c-9c0d4c3f885c",
                        "glosses": [
                            "Künstler, der musikalische Werke schafft"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "3fb1e3a6-49e9-4499-865f-d4c2d6dca2ec",
                                "sense_id": "ebd58e8d-12c6-39ce-a23d-dd1cd589d07a",
                                "text": "„Der Lehrer erkannte, dass der scheue Junge neben dem Piano auch eine Gabe für die Komposition hatte und schickte ihn zu Eduard Marxsen, einem bekannten Tondichter, dem Brahms später sein zweites Klavierkonzert widmete.“"
                            },
                            {
                                "example_id": "80df0f30-574a-4fcf-a04a-afffd2c3bce9",
                                "sense_id": "ebd58e8d-12c6-39ce-a23d-dd1cd589d07a",
                                "text": "„Und doch hatten diese beiden, als was für Abschaum sie auch galten, noch geachtete Stellungen inne, wenn man sie mit andern großen Tondichtern vergleicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
