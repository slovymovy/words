                        "nl": "Vrij van vreemde materialen of verontreinigende stoffen; niet vermengd met iets anders."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "без примесей"
                            },
                            {
                                "target_lang_word": "беспримесный",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "puur",
                                "target_lang_sense_clarification": "onvermengd"
                            },
                            {
                                "target_lang_word": "zuiver",
                                "target_lang_sense_clarification": "zonder onzuiverheden"
                            },
                            {
                                "target_lang_word": "onverontreinigd",
