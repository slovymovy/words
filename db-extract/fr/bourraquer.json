                        "glosses": [
                            "Pêcher à la bourraque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f8e4c3-b27d-4020-b379-169dd24a1e65",
                                "sense_id": "7058c9d9-6146-328b-95a0-794fae3d8c4e",
                                "text": "J'ai beau me lever dès potron minet, bourraquer dans les mares ou sur le grand rocher, tendre mes lignes sur les bancs de sable, bien « bouétés » au gros ver, je ne ramasse guère que quelques brins de bouquet, ou de ci, de là, quand les crabes veulent bien ne point me les disputer, quelques méchants picots au goût de papier buvard."
                            }
                        ]
                    }
