                                "text": "ювенильная вода : eau cornée."
                            },
                            {
                                "example_id": "f26159c4-27ba-4dc9-83af-51c57357bcde",
                                "sense_id": "301c88ba-5c93-399a-8871-0cdf66c15bd9",
