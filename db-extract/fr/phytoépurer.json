                "senses": [
                    {
                        "sense_id": "194c00f9-69f1-3e10-a4c3-b49fb0366572",
                        "entry_id": "438ff9bb-e3ca-3c78-abcf-07e7c2658e4c",
                        "glosses": [
                            "Épurer grâce aux plantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdf726c-6dee-478e-9517-07c32fd1164a",
                                "sense_id": "194c00f9-69f1-3e10-a4c3-b49fb0366572",
                                "text": "Sur le site tout ce qui peut l'être est trié, recyclé, composté, phytoépuré..."
                            },
                            {
                                "example_id": "b53b8f90-22af-4f43-80a7-004d239a3dd5",
                                "sense_id": "194c00f9-69f1-3e10-a4c3-b49fb0366572",
                                "text": "Après, libre à toi de phytoépurer ou non, tant que tu as une fosse et une boîte à graisse tu es en règle."
                            },
                            {
                                "example_id": "eba25bad-b88d-4d04-b6b4-849a0080e20f",
                                "sense_id": "194c00f9-69f1-3e10-a4c3-b49fb0366572",
                                "text": "L'idée est donc de phytoépurer ces eaux avant qu'elles ne contaminent les prairies inondables."
                            }
                        ]
                    }
