                        "entry_id": "311442f9-ce78-352a-968b-5c1c463b87da",
                        "glosses": [
                            "Relatif aux Colombiens d’origine africaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fa24dbd-cb34-4775-a3a5-f14ffc7a4b96",
                                "sense_id": "c80f7020-f6ba-30a5-a7d9-86bb19fc6855",
                                "text": "75 % de la population afrocolombienne du pays perçoit des salaires plus bas que le minimum légal et leur espérance de vie est de 20% inférieure à la moyenne nationale."
                            },
                            {
                                "example_id": "beea2d19-b8da-4593-9ad2-41548f0989c7",
                                "sense_id": "c80f7020-f6ba-30a5-a7d9-86bb19fc6855",
                                "text": "La cumbia, rythme afrocolombien, mélangée à l’électro, est en train d’envahir les pistes de danse un peu partout sur la planète."
                            }
                        ]
                    }
