    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33e7712d-39b1-355f-8d17-5bd820c6fa1f",
                    "sense_definition": "Being a first occurrence or event",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "first",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship sank on its <w>maiden</w> voyage.",
                            "target_lang_translations": {
                                "tr": "Gemi, <w>ilk</w> seferinde battı."
                            }
                        },
                        {
                            "text": "The athlete celebrated his <w>maiden</w> victory in the championship.",
                            "target_lang_translations": {
                                "tr": "Sporcu, şampiyonadaki <w>ilk</w> zaferini kutladı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maiden voyage",
                        "maiden speech"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin ilk kez gerçekleşmesi veya yapılması durumu"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ilk",
                                "target_lang_sense_clarification": "Bir dizinin başlangıcını ifade eder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c18637fe-51ea-3af4-ab59-440d9cea8f9c",
                    "sense_definition": "Being a cricket over in which no runs are scored",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bowler delivered a perfect <w>maiden</w> over.",
                            "target_lang_translations": {
                                "tr": "Atıcı, kusursuz bir <w>sayısız over</w> gerçekleştirdi."
                            }
                        },
                        {
                            "text": "He bowled three <w>maiden</w> overs during the match.",
                            "target_lang_translations": {
                                "tr": "Maç sırasında üç <w>sayısız over</w> attı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maiden over"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in cricket-playing countries"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Krikette sayı verilmeden tamamlanan oyun serisi"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sayısız over",
                                "target_lang_sense_clarification": "Kriket terimi olarak sayı alınamayan oyun bölümü"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acd43f18-747a-3117-a01b-fb03fb15c63b",
                    "sense_definition": "A girl or an unmarried young woman",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "woman",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>maiden</w> walked through the forest.",
                            "target_lang_translations": {
                                "tr": "Genç <w>kız</w> ormanın içinden yürüdü."
                            }
                        },
                        {
                            "text": "In the old story, a <w>maiden</w> waited for her true love.",
                            "target_lang_translations": {
                                "tr": "Eski hikâyede, bir <w>genç kız</w> gerçek aşkını bekliyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "maid",
                        "damsel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literature or fairy tales"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Genç kız veya evlenmemiş genç kadın"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bakire",
                                "target_lang_sense_clarification": "Cinsel deneyimi olmayan genç kadın"
                            },
                            {
                                "target_lang_word": "genç kız",
                                "target_lang_sense_clarification": "Edebi veya masalsı anlatımlarda kullanılan ifade"
                            }
                        ]
                    },
                    "common_phrases": [
                        "fair maiden"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76b38be2-f4d1-3a87-b5e7-896c15b26f2e",
                    "sense_definition": "One of the three aspects of the goddess in Wicca representing a young woman",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "deity",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "The goddess is honored as the <w>Maiden</w> in the spring.",
                            "target_lang_translations": {
                                "tr": "Tanrıça, baharda <w>Genç Kız</w> olarak onurlandırılır."
                            }
                        },
                        {
                            "text": "Wiccans often worship the <w>Maiden</w>, Mother, and Crone.",
                            "target_lang_translations": {
                                "tr": "Wicca inancına sahip olanlar sıklıkla <w>Genç Kız</w>, Anne ve İhtiyar Kadın'a taparlar."
                            }
                        }
                    ],
                    "antonyms": [
                        "Master"
                    ],
                    "target_lang_definitions": {
                        "tr": "Wicca inancında tanrıçanın genç kadın yönünü temsil eden figür"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Genç Kız",
                                "target_lang_sense_clarification": "Tanrıçanın üçlü formundaki gençlik evresi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0465f492-13c7-3293-89af-6cf2754ceb70",
