    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c7a13983-72e7-3d0f-9fed-270a9e810b20",
                "word": "eyeless",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "913e8ac0-a586-3587-af2b-f0ee49b0da23",
                        "entry_id": "c7a13983-72e7-3d0f-9fed-270a9e810b20",
                        "glosses": [
                            "Having no eyes (organs of sight)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b06c6b6-9462-4bad-a45a-141f32e118b9",
                                "sense_id": "913e8ac0-a586-3587-af2b-f0ee49b0da23",
                                "text": "Huge eyeless crabs roam the ocean floor around hydrothermal vents."
                            },
                            {
                                "example_id": "775e8cfa-d544-4abb-a9d8-bbbeaefd0392",
                                "sense_id": "913e8ac0-a586-3587-af2b-f0ee49b0da23",
                                "text": "I held out my hand, and the horrible, soft-spoken, eyeless creature gripped it in a moment like a vise. I was so much startled that I struggled to withdraw; but the blind man pulled me close up to him with a single action of his arm."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bb0bc3c-d2de-3382-b217-4b0a0b3f5861",
                        "entry_id": "c7a13983-72e7-3d0f-9fed-270a9e810b20",
                        "glosses": [
                            "Having no sight; blind."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ff542176-afa8-38d2-88c3-2d0dd13512c9",
                        "entry_id": "c7a13983-72e7-3d0f-9fed-270a9e810b20",
                        "glosses": [
                            "Having no eye: having no hole."
                        ],
                        "tags": [
                            "not-comparable",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "228be7b3-5d33-46e6-a944-da351318fa8e",
                                "sense_id": "ff542176-afa8-38d2-88c3-2d0dd13512c9",
                                "text": "eyeless needle"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7492d2aa-0771-4d1a-acce-05e92338b2a2",
                        "source_entry_id": "c7a13983-72e7-3d0f-9fed-270a9e810b20",
                        "source_sense_description": "having no eyes",
                        "target_lang_word": "augenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "augenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0bfc67-3c2e-3ad4-8c17-9c215a652ee4",
                                        "entry_id": "0070babd-db9a-3202-b8e8-84ac987aaae9",
                                        "glosses": [
                                            "keine Augen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5769c14b-7430-415f-8f00-b34910695390",
                                                "sense_id": "9d0bfc67-3c2e-3ad4-8c17-9c215a652ee4",
                                                "text": "„Und Tritt Balls fing an, mit dieser fetten, augenlosen und gründlich zerschnippelten Leiche zu vögeln, rammelte hart in ihre tote Pussy und dann zog er ihn raus und spritzte mitten in ihr aufgerissenes Maul, tot wie sie war.“"
                                            },
                                            {
                                                "example_id": "b434de80-ffbe-4f62-a85a-651bcc9303ca",
                                                "sense_id": "9d0bfc67-3c2e-3ad4-8c17-9c215a652ee4",
                                                "text": "„Es ernährte sich wohl von den augenlosen Fischen, Fledermäusen und Ratten in der Höhle, sicherlich auch von den gewöhnlichen Fischen, die bei jedem Hochwasser des Green River hereingespült werden, die ihn über verborgene Wege mit den Gewässern in der Höhle verbinden.“"
                                            },
                                            {
                                                "example_id": "03bcd887-e713-4bf4-bf47-945cbe5487da",
                                                "sense_id": "9d0bfc67-3c2e-3ad4-8c17-9c215a652ee4",
                                                "text": "„Mir stockte vor Entsetzen der Atem, als ich um eine Kurve bog und eine augenlose Gestalt vor mir stehen sah, die ihre knochigen Arme nach mir ausstreckte - das Ganze wirkte umso grässlicher, da der Leichnam, obgleich ansonsten menschlich, mir gleich drei Arme entgegenreckte.“"
                                            },
                                            {
                                                "example_id": "bb60096e-c8f2-4a51-be24-6b86355f7e32",
                                                "sense_id": "9d0bfc67-3c2e-3ad4-8c17-9c215a652ee4",
                                                "text": "„Jeder einzelne, ob Mann, Frau oder Kind, war augenlos in diesem brodelnden Turm.“"
                                            },
                                            {
                                                "example_id": "dd9af50d-80df-4875-bf7b-87a2a958d78c",
                                                "sense_id": "9d0bfc67-3c2e-3ad4-8c17-9c215a652ee4",
                                                "text": "„Dabei bot sich ihren Blicken icht als die von den Lichtkegeln angestrahlten Rücken und Gliedmaßen der unmittelbar voranschreitenden Albinos, sodass die drei Erdenmänner sich alsbald selbst vorkamen wie ein untrennbarer Bestandteil jenes augenlosen und geheimnisvollen Heerbanns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
