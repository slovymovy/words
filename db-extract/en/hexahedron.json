                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexaèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8617b3ce-b453-3517-8339-b57cff4a0baf",
                                        "entry_id": "f7f60d40-dd09-37b1-ba6e-811313bd38c5",
                                        "glosses": [
                                            "Qui a six faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fd2d4fb-8c21-4ee9-8b3b-ded958fc0165",
                                                "sense_id": "8617b3ce-b453-3517-8339-b57cff4a0baf",
                                                "text": "Ce sel cristallise en prismes hexaèdres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hexaèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                        "entry_id": "4734ec4d-f0c0-38ec-a7e9-8edf2bb02e75",
                                        "glosses": [
                                            "Polyèdre à six faces, pouvant être régulier comme le cube, ou semi-régulier comme, par exemple, la pyramide à base pentagonale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28272e36-f435-4711-b406-3fb8a9637e39",
                                                "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                                "text": "Un dé à jouer est un hexaèdre."
                                            },
                                            {
                                                "example_id": "294ef05e-2998-414e-a282-9543bd87d947",
                                                "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                                "text": "Je jouissais tranquillement des pirouettes fantastiques de la lumière sur les cristaux de glace suspendus à une hauteur infinie dans l’atmosphère, ou sur les hexaèdres microscopiques de la neige."
                                            },
                                            {
                                                "example_id": "0f88b647-d3b9-46e4-baea-77ca4f369489",
                                                "sense_id": "af9676c3-a9d7-31ea-8253-417c46326a28",
                                                "text": "Alors que le nez est simplement indiqué par une planchette étroite, deux cylindres saillants d’environ huit centimètres forment les deux yeux, un hexaèdre, un peu plus bas, la bouche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afc429b6-ba1b-488b-9b57-74c9095a45cc",
                        "source_entry_id": "e44579d9-0238-33a8-9fab-11f835dd164f",
                        "source_sense_id": "e3c3f4ec-6dae-39f7-9a23-0fdb20d44dc7",
