                        ],
                        "examples": [
                            {
                                "example_id": "8e872c62-98b4-4073-a482-2e9f0e05437e",
                                "sense_id": "65ad9596-f2d0-3a5d-9d91-ce7bfd7566c1",
                                "text": "Mitterand lernt, nicht nur den Inhalt eines Gedankenks klar zu formulieren, sondern auch die ihm angemessene Ausdrucksform zu finden. Wie jeder Junge versucht er sich in ein paar Gedichten, doch später wird er mit seinen Büchern in Frankreich als Literat anerkannt und kann von den Tantiemen leben."
                            }
                        ]
                    }
