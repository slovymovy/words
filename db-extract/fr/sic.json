                    {
                        "translation_id": "4a6e1b36-647a-4298-8a38-146ebae55ec0",
                        "source_entry_id": "aef7af5f-de80-38bf-ba34-0b1a2b427eb6",
                        "source_sense_id": "f463660e-b7f3-34cd-9ddd-f788ff52ddb1",
                        "source_sense_description": "Textuellement",
                        "target_lang_word": "так",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "так",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "26801582-d64e-33a1-a4b6-fbd5ec0270d9",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "мест. нареч. указанным способом, образом действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454e22d7-1475-4773-8a35-6afed90424b2",
                                                "sense_id": "26801582-d64e-33a1-a4b6-fbd5ec0270d9",
                                                "text": "Они поступили именно так."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c6813f-2166-312d-a4f3-f22f97574b55",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "мест. нареч. (c союзами что, как) указывает на признак или действие и на его сильную степень проявления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba1c43c-eef4-4d5e-8cf3-040664b9e980",
                                                "sense_id": "54c6813f-2166-312d-a4f3-f22f97574b55",
                                                "text": "Это было так давно, что все успели забыть."
                                            },
                                            {
                                                "example_id": "e38afb63-4cbd-4af3-9a1f-056732bfea7d",
                                                "sense_id": "54c6813f-2166-312d-a4f3-f22f97574b55",
                                                "text": "Не так страшен чёрт, как его малюют."
                                            },
                                            {
                                                "example_id": "91b8ed00-9622-420e-b242-c2d7a9f04fc7",
                                                "sense_id": "54c6813f-2166-312d-a4f3-f22f97574b55",
                                                "text": "Он так вырос, что не прошёл в дверь."
                                            },
                                            {
                                                "example_id": "9c88db9e-083d-4443-af2b-0a17c200a8a5",
                                                "sense_id": "54c6813f-2166-312d-a4f3-f22f97574b55",
                                                "text": "Крикнул так, что все притихли."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a3e27f-3d03-38ba-8d00-620517824c40",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "мест. нареч. просто, без последствий и осложнений"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84a619d4-b620-4214-b7d9-49d20947a47b",
                                                "sense_id": "08a3e27f-3d03-38ba-8d00-620517824c40",
                                                "text": "Это тебе так не сойдёт с рук."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe2032a-38b8-3aa4-b198-fc6ecd49ff86",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "частица указывает на сильную степень проявления признака или действия; выражает удивление, а с частицей не — противопоставление"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "566ed8d1-88a4-412b-89ee-b2462c2a9f4f",
                                                "sense_id": "abe2032a-38b8-3aa4-b198-fc6ecd49ff86",
                                                "text": "Это было так давно."
                                            },
                                            {
                                                "example_id": "0f9ad3b4-57c4-4ef5-b96c-c4899d9a4f37",
                                                "sense_id": "abe2032a-38b8-3aa4-b198-fc6ecd49ff86",
                                                "text": "Он так вырос."
                                            },
                                            {
                                                "example_id": "1be4c361-8ef3-4e74-ae13-789ebd7542b3",
                                                "sense_id": "abe2032a-38b8-3aa4-b198-fc6ecd49ff86",
                                                "text": "Так крикнул."
                                            },
                                            {
                                                "example_id": "80fd1a73-86be-4865-a73e-0f100382da4c",
                                                "sense_id": "abe2032a-38b8-3aa4-b198-fc6ecd49ff86",
                                                "text": "Чёрт не так страшен (как кажется)."
                                            },
                                            {
                                                "example_id": "25bf99fe-3b3a-48ee-9aa5-7d0739440e30",
                                                "sense_id": "abe2032a-38b8-3aa4-b198-fc6ecd49ff86",
                                                "text": "Едь не так быстро (как сейчас)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90b9353-46bb-35a9-931b-e78edf85c711",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "частица выражает ожидание продолжения"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "991fc619-ae60-40c4-9860-4fa34aa27a66",
                                                "sense_id": "f90b9353-46bb-35a9-931b-e78edf85c711",
                                                "text": "— Машина была зелёная. — Так. — И за рулём была женщина."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08efb82-4cfc-36a6-aaad-cf75fd626835",
                                        "entry_id": "ed9f0cfe-4cc8-3a66-9a2a-5575a62ce8b6",
                                        "glosses": [
                                            "частица выражает уточнение, иллюстрирующее предыдущую фразу"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e23b6e48-70cc-4812-b941-6d2ad5685da6",
                                                "sense_id": "d08efb82-4cfc-36a6-aaad-cf75fd626835",
                                                "text": "На правобережье Днестра готы поселились среди гето-даков ещё во время первой миграционной волны, датируемой второй половиной II в. Так, Иордан сообщает о крупных вторжениях северодунайских племён в пределы Римской империи уже в 248 и 251 гг."
                                            },
                                            {
                                                "example_id": "66011143-ae08-4abb-ab13-87da827b45d4",
                                                "sense_id": "d08efb82-4cfc-36a6-aaad-cf75fd626835",
                                                "text": "Несмотря на взлёты и падения в турнирной таблице, столичные клубы не испытывают проблем с финансами. Клуб из Москвы традиционно является достаточно привлекательным «брэндом» для отечественных, а иногда и зарубежных спонсоров. Так, например, «Спартак», девятикратный чемпион России, долгие годы был «торговой маркой» отечественных нефтяных компаний."
                                            }
                                        ]
                                    },
