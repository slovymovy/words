{
    "word_family": [
        "plunge",
        "plunger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4ce2756-251e-3843-99bd-f8bf8077c5ad",
                    "sense_definition": "present participle and gerund of <w>plunge</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver is <w>plunging</w> into the deep blue water.",
                            "target_lang_translations": {
                                "cs": "Potápěč se <w>ponořuje</w> do hluboké modré vody."
                            }
                        },
                        {
                            "text": "She was <w>plunging</w> her hands into the cold bucket of ice.",
                            "target_lang_translations": {
                                "cs": "Zabořila své ruce do studeného kbelíku s ledem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí a gerundium slovesa ponořit se nebo vrhnout se"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ponořující se",
                                "target_lang_sense_clarification": "ve smyslu vnoření do kapaliny"
                            },
                            {
                                "target_lang_word": "vrhající se",
                                "target_lang_sense_clarification": "ve smyslu prudkého pohybu vpřed"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fc26328d-cd7e-3db0-b8d3-31a3382b29f9",
                    "sense_definition": "That descends steeply.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers looked down at the <w>plunging</w> cliffs below them.",
                            "target_lang_translations": {
                                "cs": "Turisté se dívali dolů na <w>strmé</w> útesy pod sebou."
                            }
                        },
                        {
                            "text": "The road follows a <w>plunging</w> path down the side of the mountain.",
                            "target_lang_translations": {
                                "cs": "Cesta vede <w>prudce klesající</w> stezkou po úbočí hory."
                            }
                        }
                    ],
                    "synonyms": [
                        "steep",
                        "precipitous"
                    ],
                    "antonyms": [
                        "gentle"
                    ],
                    "target_lang_definitions": {
                        "cs": "prudce klesající nebo strmý"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strmý",
                                "target_lang_sense_clarification": "o terénu nebo cestě"
                            },
                            {
                                "target_lang_word": "prudce klesající",
                                "target_lang_sense_clarification": "popisující sklon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1075c76f-5b6a-3f9c-9ce1-52e2a6dd87d7",
                    "sense_definition": "Very low-cut.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a dress with a <w>plunging</w> neckline to the party.",
                            "target_lang_translations": {
                                "cs": "Na večírek si oblékla šaty s <w>hlubokým</w> výstřihem."
                            }
                        },
                        {
                            "text": "The fashion show featured many gowns with <w>plunging</w> backs.",
                            "target_lang_translations": {
                                "cs": "Módní přehlídka představila mnoho rób s <w>hlubokým</w> výstřihem na zádech."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plunging neckline"
                    ],
                    "target_lang_definitions": {
                        "cs": "velmi hluboký (o výstřihu)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hluboký",
                                "target_lang_sense_clarification": "o výstřihu šatů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "324b6e7b-060c-38c9-9c3b-8c7a2a0cceaa",
                    "sense_definition": "Aimed from higher ground, as fire upon an enemy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers used <w>plunging</w> fire to attack the camp in the valley.",
                            "target_lang_translations": {
                                "cs": "Vojáci použili <w>strmou</w> palbu k útoku na tábor v údolí."
                            }
                        },
                        {
                            "text": "From the hilltop, they maintained a <w>plunging</w> attack on the enemy lines.",
                            "target_lang_translations": {
                                "cs": "Z vrcholu kopce udržovali <w>strmý</w> útok na nepřátelské linie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plunging fire"
                    ],
                    "target_lang_definitions": {
                        "cs": "vedený shora dolů (o střelbě)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "strmý",
                                "target_lang_sense_clarification": "o úhlu střelby"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "425b1720-9025-3149-b2d8-53531d4dd49c",
                    "sense_definition": "An occurrence of putting or sinking under water or other fluid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>plunging</w> of the bucket into the well brought up fresh water.",
                            "target_lang_translations": {
                                "cs": "Náhlé <w>ponoření</w> vědra do studny přineslo čerstvou vodu."
                            }
                        },
                        {
                            "text": "After the <w>plunging</w> of the metal into the oil, it cooled rapidly.",
                            "target_lang_translations": {
                                "cs": "Po <w>ponoření</w> kovu do oleje se rychle ochladil."
                            }
                        }
                    ],
                    "synonyms": [
                        "immersion",
                        "submersion"
                    ],
                    "target_lang_definitions": {
                        "cs": "akt ponoření nebo vnoření do kapaliny"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ponoření",
                                "target_lang_sense_clarification": "obecný akt vnoření"
                            },
                            {
                                "target_lang_word": "vnoření",
                                "target_lang_sense_clarification": "technický nebo fyzikální akt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f98365d-82ce-3a5c-8945-3fc53f7d24a3",
                    "sense_definition": "A headlong violent motion like that of a horse trying to throw its rider.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider struggled to stay on as the horse began its wild <w>plungings</w>.",
                            "target_lang_translations": {
                                "cs": "Jezdec se snažil udržet v sedle, zatímco kůň začal divoce <w>vyhazovat</w>."
                            }
                        },
                        {
                            "text": "The horse's <w>plungings</w> made it impossible for anyone to approach safely.",
                            "target_lang_translations": {
                                "cs": "Kvůli <w>vzpínání</w> koně se k němu nikdo nemohl bezpečně přiblížit."
                            }
                        }
                    ],
                    "synonyms": [
                        "bucking"
                    ],
                    "target_lang_definitions": {
                        "cs": "prudký, nekontrolovaný pohyb (např. koně)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vzpínání",
                                "target_lang_sense_clarification": "pohyb koně"
                            },
                            {
                                "target_lang_word": "vyhazování",
                                "target_lang_sense_clarification": "pohyb koně zadníma nohama"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}