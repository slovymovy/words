                                "target_senses": [
                                    {
                                        "sense_id": "c8d6831e-6621-3192-bc90-a928ec84c18d",
                                        "entry_id": "6d7d1a0c-884b-336c-bcc9-02fba1e1eca8",
                                        "glosses": [
                                            "The state of being responsible, accountable, or answerable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1718101c-7da4-4291-bce9-76e0ef25790b",
                                                "sense_id": "c8d6831e-6621-3192-bc90-a928ec84c18d",
                                                "text": "Responsibility is a heavy burden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7ceee7-d661-31f0-a0c3-4fcd9657fdf1",
                                        "entry_id": "6d7d1a0c-884b-336c-bcc9-02fba1e1eca8",
                                        "glosses": [
                                            "The state of being liable, culpable, or responsible for something in particular."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1910303-db6e-4180-8510-7f1ee995618f",
                                                "sense_id": "9f7ceee7-d661-31f0-a0c3-4fcd9657fdf1",
                                                "text": "After all, it is undeniable that the B.R. standard coach scored highly in comparative trials with other European railway vehicles on the Continent a few years ago, so that B.R. civil engineers must share responsibility for any defects in its behaviour over here."
                                            },
                                            {
                                                "example_id": "ee37885f-bb26-4844-9382-130717fcfd41",
                                                "sense_id": "9f7ceee7-d661-31f0-a0c3-4fcd9657fdf1",
                                                "text": "The vast majority of American Jews not only greatly dislike President Trump but also believe he has made them less safe: according to a May 2019 poll, nearly three-quarters of Jewish voters believe American Jews are less secure under Trump than they were before, 71 percent disapprove of Trump’s overall job performance, and nearly 60 percent believe that he bears at least some responsibility for the synagogue shootings carried out by white nationalists in Pittsburgh and Poway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8555b56e-1f94-3544-a0e9-69ef278e7ebc",
                                        "entry_id": "6d7d1a0c-884b-336c-bcc9-02fba1e1eca8",
                                        "glosses": [
                                            "A duty, obligation or liability for which someone is held accountable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e098b0b-3278-4718-a70a-338d40e194f9",
                                                "sense_id": "8555b56e-1f94-3544-a0e9-69ef278e7ebc",
                                                "text": "Why didn't you clean the house? That was your responsibility!"
                                            },
                                            {
                                                "example_id": "cb2046b3-dd5c-4fd9-87f6-fdb6e7334f1e",
                                                "sense_id": "8555b56e-1f94-3544-a0e9-69ef278e7ebc",
                                                "text": "The responsibility of the great states is to serve and not to dominate the world"
                                            },
                                            {
                                                "example_id": "ff6fac07-cbce-4d94-ba8e-dbfc25f5f3bd",
                                                "sense_id": "8555b56e-1f94-3544-a0e9-69ef278e7ebc",
                                                "text": "If parents, teachers, and ministers conducted their responsibilities by following the ratings, children would have a steady diet of ice cream, school holidays, and no Sunday school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8464cd56-0f2a-3083-a6b3-0b74afb0d77e",
                                        "entry_id": "6d7d1a0c-884b-336c-bcc9-02fba1e1eca8",
                                        "glosses": [
                                            "A duty, obligation or liability for which someone is held accountable.",
                                            "The obligation to carry forward an assigned task to a successful conclusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "599b4bd3-0d12-3f5a-88a1-7e866edd4628",
                                        "entry_id": "6d7d1a0c-884b-336c-bcc9-02fba1e1eca8",
                                        "glosses": [
                                            "A duty, obligation or liability for which someone is held accountable.",
                                            "The obligation for the proper custody, care, and safekeeping of property or funds entrusted to someone’s possession or supervision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
