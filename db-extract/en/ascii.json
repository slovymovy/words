                                "target_senses": [
                                    {
                                        "sense_id": "d54614ea-4645-3711-8ebd-03b5ddbbb220",
                                        "entry_id": "10d29ac0-2184-3101-92b0-cddccd9edc21",
                                        "glosses": [
                                            "genormter Code für die Darstellung von Zeichen"
                                        ],
