                            "British",
                            "dialectal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b868f7e9-4cbb-32e3-a7ba-854ebc98dc9a",
                        "entry_id": "30616976-1cf1-394a-9ff1-4bfd7171a1e3",
                        "glosses": [
