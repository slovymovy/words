                "senses": [
                    {
                        "sense_id": "b823b8f0-c617-3d76-9107-3f7c8517c04a",
                        "entry_id": "34b5d86f-a154-3a1b-8ca7-bb89cb2a89a8",
                        "glosses": [
                            "ein großformatiger Baustein aus Beton, Leichtbeton oder Bimsbeton, der senkrecht zur Lagerfläche in seinem Inneren Luftkammern aufweist"
                        ],
                        "tags": [
                            "Kurzform für Hohlblockstein"
                        ],
                        "examples": [
                            {
                                "example_id": "e36bdbf1-63a1-4fc1-8bd8-8547d0c35ed6",
                                "sense_id": "b823b8f0-c617-3d76-9107-3f7c8517c04a",
                                "text": "\"Hohlblock […] ist ein fünfseitig geschlossener Mauerstein aus Beton mit Kammern senkrecht zur Lagerfläche […].\""
                            },
                            {
                                "example_id": "2004709a-214a-4598-ae41-355bb4b47594",
                                "sense_id": "b823b8f0-c617-3d76-9107-3f7c8517c04a",
                                "text": "Zuerst legen wir den Ziegelsteinkranz (kein Schamott) auf dem Boden trocken aus und passen den Hohlblock passend dazu ein."
                            },
                            {
                                "example_id": "01d3aee8-f01b-4a25-ba20-2d0fefb8e911",
                                "sense_id": "b823b8f0-c617-3d76-9107-3f7c8517c04a",
                                "text": "Auf einer Schnellstraße fährt man durch Industriegebiete und Wohnsiedlungen im Hohlblockstil."
                            }
                        ],
