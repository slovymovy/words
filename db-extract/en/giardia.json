                        ],
                        "examples": [
                            {
                                "example_id": "b3960a17-d3da-46d3-be1e-ff4a29f34b66",
                                "sense_id": "6181d227-92a3-34b0-a76c-85e4da6215e7",
                                "text": "Some of those that have been found in swimming pools are viruses such as hepatitis A, bacteria such as Pseudomonas aeruginosa, which can produce severe ear ache, and the parasite giardia, which can cause a nasty stomach upset."
                            },
                            {
                                "example_id": "fdbf030f-e469-49c2-83fe-6d0ade8cb26e",
                                "sense_id": "6181d227-92a3-34b0-a76c-85e4da6215e7",
                                "text": "As soon as the immune system has generated antibodies against one coat, giardia switches to another."
                            }
                        ]
                    },
