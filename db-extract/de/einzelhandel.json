                    {
                        "translation_id": "7d9919d5-2a1a-48cb-993d-375a0ae12cce",
                        "source_entry_id": "7047fde1-c8c9-3738-9469-e52278f011e1",
                        "source_sense_id": "b32f2a8a-f1fb-3c45-a524-5a09e7070b31",
                        "source_sense_description": "der Verkauf von Waren direkt an den Verbraucher",
                        "target_lang_word": "detailhandel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "detailhandel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f117b04e-e1f9-3885-9692-bb3efc276097",
                                        "entry_id": "5250fa92-8eb3-39b4-b71f-9aaccd83dbfd",
                                        "glosses": [
                                            "de handel die tastbare producten direct aan consumenten verkoopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40693651-a7a6-466b-950b-e8ba8aa61fdf",
                                                "sense_id": "f117b04e-e1f9-3885-9692-bb3efc276097",
                                                "text": "Bij ruim 20 procent van geïnspecteerde horecabedrijven en de detailhandel wordt de wet niet nageleefd. Het gaat daarbij om overtredingen als “illegale tewerkstelling, onderbetaling en te lang werken”. Dat meldt de Inspectie SZW dinsdag op basis van een onderzoek van 1.914 horecaondernemingen en 1.326 winkels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b34755-8be3-33c0-8170-f5d58bfb23e9",
                                        "entry_id": "5250fa92-8eb3-39b4-b71f-9aaccd83dbfd",
                                        "glosses": [
                                            "een bedrijf dat tastbare producten direct aan consumenten verkoopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290d1bac-54f1-4366-aafb-772b82931021",
                                                "sense_id": "25b34755-8be3-33c0-8170-f5d58bfb23e9",
                                                "text": "De boekhandel, de slager, de bakker maar ook de supermarkt behoren tot de detailhandel."
                                            },
                                            {
                                                "example_id": "a9c0392f-d9a8-4057-86a7-b49e6a6f3fac",
                                                "sense_id": "25b34755-8be3-33c0-8170-f5d58bfb23e9",
                                                "text": "De rechter is het daar niet mee eens en wijst erop dat de darkstore 24 uur per dag actief is, en dat feitelijk sprake is van een opslag- en distributiecentrum. Ook is het geen detailhandel omdat winkelend publiek de darkstore niet in en uit kan lopen om zelf producten te kiezen en kopen, redeneert de rechter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
