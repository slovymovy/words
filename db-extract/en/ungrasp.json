                "senses": [
                    {
                        "sense_id": "9912c78c-57a8-3e7f-bfba-c7af88e29f91",
                        "entry_id": "d6391f99-cde6-3af8-bd44-89774f31f520",
                        "glosses": [
                            "To release one's grasp on; to let go of."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb0b14d-95ea-413c-a0ce-403286e84db6",
                                "sense_id": "9912c78c-57a8-3e7f-bfba-c7af88e29f91",
                                "text": "Cling to one person : ungrasp your hold of all other persons and things."
                            },
                            {
                                "example_id": "bb75d5f2-1bec-4f52-b500-e30a1d49d411",
                                "sense_id": "9912c78c-57a8-3e7f-bfba-c7af88e29f91",
                                "text": "Have they explained in terms the revivifying process by which the dead, cold hand of winter ungrasps its victims, to wear once more the charming glow of summer life ?"
                            },
                            {
                                "example_id": "aecd134d-85a3-4846-bb15-5a134e1a6b07",
                                "sense_id": "9912c78c-57a8-3e7f-bfba-c7af88e29f91",
                                "text": "Will death ungrasp his hard-locked treasure, when I shout in his deaf ear and say, Restore My stolen gold, and give me back my gems?"
                            },
                            {
                                "example_id": "fa3b6649-adcf-46e9-a339-7a0f41dae484",
                                "sense_id": "9912c78c-57a8-3e7f-bfba-c7af88e29f91",
                                "text": "Ungrasp your ankles; lie down in the original position and repeat another time for 10 seconds."
                            }
                        ]
                    }
                ],
