{
    "word_family": [
        "łubiany",
        "łubka",
        "łubek",
        "łubin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66f120f6-ee54-3bbf-9630-10c8f0617d96",
                    "sense_definition": "płat kory zdarty z drzewa, najczęściej lipowego, używany dawniej w rzemiośle",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rzemieślnik ostrożnie zdejmował <w>łub</w> ze ściętej lipy, aby przygotować go do suszenia.",
                            "target_lang_translations": {
                                "ru": "Ремесленник осторожно снимал <w>луб</w> со срубленной липы, чтобы подготовить его к сушке."
                            }
                        },
                        {
                            "text": "Dawniej elastyczny <w>łub</w> stanowił podstawowy materiał do wyrobu prostych naczyń.",
                            "target_lang_translations": {
                                "ru": "В старину гибкий <w>лубок</w> служил основным материалом для изготовления простой утвари."
                            }
                        }
                    ],
                    "synonyms": [
                        "kora"
                    ],
                    "common_phrases": [
                        "lipowy łub"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "określenie historyczne, tradycyjne rzemiosło"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "пласт древесной коры (обычно липовой), снятый со ствола и использовавшийся в ремесле"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "луб",
                                "target_lang_sense_clarification": "кора дерева, подкорье"
                            },
                            {
                                "target_lang_word": "лубок",
                                "target_lang_sense_clarification": "кусок, пласт коры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87bf1e57-09cd-3fa0-812b-ae7531c34390",
                    "sense_definition": "kosz, pojemnik lub pudełko wykonane z pasów kory",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przedmiot_z_kory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kobiety zbierały świeże jagody prosto w lekki, pleciony <w>łub</w>.",
                            "target_lang_translations": {
                                "ru": "Женщины собирали свежие ягоды прямо в лёгкое плетеное <w>лукошко</w>."
                            }
                        },
                        {
                            "text": "Na targu stał stary wieśniak, oferując owoce wsypane w tradycyjny <w>łub</w>.",
                            "target_lang_translations": {
                                "ru": "На рынке стоял пожилой крестьянин, продавая фрукты, насыпанные в традиционную <w>лубянку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "łubianka"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "wyraz rzadki, dawny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "корзина, короб или сосуд, изготовленный из полос древесной коры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лукошко",
                                "target_lang_sense_clarification": "корзина из лыка или бересты"
                            },
                            {
                                "target_lang_word": "лубянка",
                                "target_lang_sense_clarification": "короб, лубяная корзинка"
                            },
                            {
                                "target_lang_word": "короб",
                                "target_lang_sense_clarification": "изделие из коры или щепы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d7ffcb5-2323-37af-876f-f9430e752c0d",
                    "sense_definition": "zadaszenie lub budka z kory na saniach albo na wozie, chroniąca podróżnych przed niepogodą",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pojazd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W czasie zamieci podróżni schronili się pod szerokim <w>łubem</w> sań.",
                            "target_lang_translations": {
                                "ru": "Во время метели путники укрылись под широким <w>лубяным верхом</w> саней."
                            }
                        },
                        {
                            "text": "Zimowe sanie zrobione z drewna miały solidny <w>łub</w> chroniący przed wiatrem.",
                            "target_lang_translations": {
                                "ru": "Зимние деревянные сани имели прочную <w>будку</w>, защищающую от ветра."
                            }
                        }
                    ],
                    "synonyms": [
                        "buda"
                    ],
                    "common_phrases": [
                        "łub na saniach"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dotyczy dawnych pojazdów konnych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "навес или крытый верх повозки либо саней, сделанный из коры для защиты от непогоды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лубяной верх",
                                "target_lang_sense_clarification": "крыша, навес саней или повозки"
                            },
                            {
                                "target_lang_word": "кибитка",
                                "target_lang_sense_clarification": "крытый верх повозки/саней"
                            },
                            {
                                "target_lang_word": "будка",
                                "target_lang_sense_clarification": "навес на возке или санях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a873a2d7-9a35-3eb7-899f-14a87688bb6d",
                    "sense_definition": "dawny kryty wóz konny z budą z kory",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pojazd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed dworkiem zatrzymał się ciężki, zakurzony <w>łub</w> zaprzężony w cztery konie.",
                            "target_lang_translations": {
                                "ru": "Перед усадьбой остановилась тяжёлая, запылённая <w>кибитка</w>, запряжённая четвёркой лошадей."
                            }
                        },
                        {
                            "text": "Służba przez całe popołudnie ładowała bagaże na podróżny <w>łub</w>.",
                            "target_lang_translations": {
                                "ru": "Слуги весь день грузили багаж на дорожную <w>повозку</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dawny typ pojazdu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "старинная конная повозка с крытым верхом из коры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кибитка",
                                "target_lang_sense_clarification": "крытая повозка или сани"
                            },
                            {
                                "target_lang_word": "лубяная повозка",
                                "target_lang_sense_clarification": "повозка с лубяным верхом"
                            },
                            {
                                "target_lang_word": "возок",
                                "target_lang_sense_clarification": "крытый дорожный экипаж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbcd0d11-122b-3629-b4f5-91dfc03a7749",
                    "sense_definition": "obręcz z cienkiej kory używana dawniej jako usztywnienie kobiecego nakrycia głowy w stroju ludowym",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przedmiot_z_kory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czepiec panny młodej został starannie upięty na specjalnym <w>łubie</w>.",
                            "target_lang_translations": {
                                "ru": "Чепец невесты был аккуратно закреплён на специальном лубяном <w>каркасе</w>."
                            }
                        },
                        {
                            "text": "W muzealnej gablocie pokazano haftowany czepiec oraz podtrzymujący go dawny <w>łub</w>.",
                            "target_lang_translations": {
                                "ru": "В музейной витрине был выставлен вышитый чепец и поддерживающий его старинный <w>лубок</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "element dawnego stroju ludowego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "обруч из тонкой коры, использовавшийся для придания формы и жесткости женскому народному головному убору"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кичка",
                                "target_lang_sense_clarification": "лубяная основа под чепец или повойник"
                            },
                            {
                                "target_lang_word": "лубок",
                                "target_lang_sense_clarification": "обруч или каркас из коры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}