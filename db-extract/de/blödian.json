                ],
                "senses": [
                    {
                        "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                        "entry_id": "9cca6c6b-336d-33ab-97b4-145099de777d",
                        "glosses": [
                            "dummer Mensch"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "783beffb-578d-4c30-bdea-b94cc00ce6a6",
                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                "text": "„Auf dem Plakat ist ein Blödian in Hippie-Outfit zusehen, der seine zu einem Victory-Zeichen gespreizten Finger mit Aufschnitt umwickelt hat.“"
                            },
                            {
                                "example_id": "59e8a379-194a-4dda-8305-ec410757fb7f",
                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                "text": "„Er hatte einen enormen Misthaufen von Blödian dabei.“"
                            },
                            {
                                "example_id": "632afa89-63c7-4584-a8e1-3b2fb79132b0",
                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                "text": "„Aber wie es so geht – hin und wieder tauchte doch mal ein richtig ausgekochter Blödian auf – einer, der neunzig Prozent seines Lebens seiner Wirbelsäule verdankte – und fing immer wieder damit an, bis schließlich sogar Mr. McAllister es nicht länger mit anhören konnte.“"
                            },
                            {
                                "example_id": "422975ab-8cce-4b24-8773-1f483e0da20f",
                                "sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                                "text": "„Dieser Blödian in der Feldkommandantur wußte ja nicht einmal, wo die Straße gesperrt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2d5197c-1e1b-41cc-b2e3-a92e3c0ae618",
                        "source_entry_id": "9cca6c6b-336d-33ab-97b4-145099de777d",
                        "source_sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                        "source_sense_description": "abwertend: dummer Mensch",
                        "target_lang_word": "idiot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person of low general intelligence."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6128c31-8a73-4b7c-81e6-5593c6a7045c",
                                                "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                                "text": "Only an idiot would fail this exam."
                                            },
                                            {
                                                "example_id": "508bfb32-043f-48be-957d-116415cb8e3a",
                                                "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                                "text": "After failing a hat-trick of exams, the teacher called him an idiot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person who makes stupid decisions; a fool."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0bb3dd6-682e-468d-91b8-e646d373b678",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "He thought people who don't like cricket are idiots. He later got into fights with people who like footabll."
                                            },
                                            {
                                                "example_id": "2b758441-1b8a-4e2c-a2d5-c49b480c7a83",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "We think that people who cycle without a helmet are idiots."
                                            },
                                            {
                                                "example_id": "ce90f186-69c0-4498-b756-6399e93b8679",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "“He’s an idiot – in terms of saying that. Everybody knows this. Everybody knows it. Nobody doubts it,” Biden said."
                                            },
                                            {
                                                "example_id": "7b8285ec-e4fa-4269-a273-e4e76cef8485",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "“One of the things that you write so beautifully, and your stuff is so fun to read, but you write about Trump, quote, ‘The way that you build a truly vicious nationalist movement is to wed a relatively small core of belligerent idiots to a much larger group of opportunists and spineless fellow travelers whose primary function is to turn a blind eye to things,’” Kennedy said, reading Taibbi’s own writing back to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person of the lowest intellectual standing, a person who lacks the capacity to develop beyond the mental age of a normal four-year-old; a person with an IQ below 30."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed94fe7c-d445-4c4b-96b1-9293a559b9dd",
                                                "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                                "text": "Idiots were thought to be peculiarly under the care of the Deity, and it was believed that those who treated them kindly would be blessed."
                                            },
                                            {
                                                "example_id": "e449e471-554f-408e-a706-0595f64c12f5",
                                                "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                                "text": "It is an offence for a man to have unlawful sexual intercourse with a woman whom he knows to be an idiot or imbecile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d199d7ae-0277-3c21-9db9-d05f42baf0ce",
                                        "entry_id": "ff137029-fa92-3de5-9556-09a8586bbf0e",
                                        "glosses": [
                                            "Idiotic, stupid."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e079bb2-f91b-4251-aefa-ae544d857388",
                        "source_entry_id": "9cca6c6b-336d-33ab-97b4-145099de777d",
                        "source_sense_id": "4c29dd07-09e9-34b5-bbd2-b1481ff5caba",
                        "source_sense_description": "abwertend: dummer Mensch",
                        "target_lang_word": "imbécile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imbécile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37aebd5f-f92e-307e-95ac-dd0063f45402",
                                        "entry_id": "a4510fe7-efd3-3556-99d9-78d6fa5f54e8",
                                        "glosses": [
                                            "Qui est peu capable de raisonner, de comprendre et d’agir judicieusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30b6885-994c-49b2-af69-91f8ea0b1bdf",
                                                "sense_id": "37aebd5f-f92e-307e-95ac-dd0063f45402",
                                                "text": "Donner des démentis est à la portée du premier imbécile venu. C'est une forme de l’idémisme, de l'automatisme mental. Mais réfuter une objection ! Voilà qui n'est pas votre fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9c01b54-c2c1-3933-97e4-82e9406fd94c",
                                        "entry_id": "a4510fe7-efd3-3556-99d9-78d6fa5f54e8",
                                        "glosses": [
                                            "Dont les facultés physiques et intellectuelles sont faibles par nature ou par suite des infirmités ou de l’âge."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a47333-5890-4f6d-a04d-2cfa7c8c80fe",
                                                "sense_id": "a9c01b54-c2c1-3933-97e4-82e9406fd94c",
                                                "text": "M. de Védelle, vous le savez bien, est à peu près imbécile. Que deviendrai-je, grand Dieu ! avec un pareil homme !"
                                            },
                                            {
                                                "example_id": "0d772a5b-067d-4bd0-81af-40864d599e12",
                                                "sense_id": "a9c01b54-c2c1-3933-97e4-82e9406fd94c",
                                                "text": "Et l’enfance au berceau, la vieillesse imbécile."
                                            },
                                            {
                                                "example_id": "632c99c1-daef-412d-a553-2d1be9ddbb22",
                                                "sense_id": "a9c01b54-c2c1-3933-97e4-82e9406fd94c",
                                                "text": "Pourquoi l’homme seul est-il sujet à devenir imbécile ? N’est-ce point qu’il retourne ainsi dans son état primitif, et que, tandis que la bête, qui n’a rien acquis et qui n’a rien non plus à perdre, reste toujours avec son instinct, l’homme reperdant par la vieillesse ou d’autres accidents tout ce que sa perfectibilité lui avait fait acquérir, retombe ainsi plus bas que la bête même ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22978072-a989-38d4-8662-7ff40414bb25",
                                        "entry_id": "a4510fe7-efd3-3556-99d9-78d6fa5f54e8",
                                        "glosses": [
                                            "Dont les facultés sont affaiblies à la suite d'un choc émotionnel."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4371590-2e67-4cad-89ed-babd1980fcc0",
                                                "sense_id": "22978072-a989-38d4-8662-7ff40414bb25",
                                                "text": "Le vétérinaire était imbécile d’effroi. Il se mit à marcher dans l’écurie comme un pantin, soulevant la queue d’une vache par réminiscence professionnelle, et regardant son frère avec des yeux sans expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee566268-9b05-334e-84c8-1f97df0df67f",
                                        "entry_id": "a4510fe7-efd3-3556-99d9-78d6fa5f54e8",
                                        "glosses": [
                                            "Idiot, stupide, qui manque d’intelligence."
                                        ],
                                        "tags": [
                                            "En parlant d’un comportement",
                                            "d’une action"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f699184-a67f-4a4c-b2bd-eaa3c104e15e",
                                                "sense_id": "ee566268-9b05-334e-84c8-1f97df0df67f",
                                                "text": "Au vrai j’entrevoyais que le conflit politique était le même en tous pays, et qu’il n’était autre qu’une révolte des esclaves contre les maîtres, chose qu’il fallait attendre, après cette tuerie imbécile."
                                            },
                                            {
                                                "example_id": "d490b035-f598-4b82-b104-5c7e923fd569",
                                                "sense_id": "ee566268-9b05-334e-84c8-1f97df0df67f",
                                                "text": "Car nous vivons, il n’en faut point douter, une époque particulièrement imbécile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imbécile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                                        "entry_id": "251cc636-5482-3f54-b034-b571fc59e0c3",
                                        "glosses": [
                                            "Personne qui manque de capacité de compréhension ou qui n’est pas capable d’agir judicieusement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f1a1e1-d3dc-4614-946c-2d998bad8d2d",
                                                "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                                                "text": "C’était d’abord la duègne Barbara qui grondait cet imbécile de Pierrot d’avoir, le maladroit, laissé tomber la boîte à perruque."
                                            },
                                            {
                                                "example_id": "9c7c2f75-c125-4c01-995e-f355fc6bb19a",
                                                "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                                                "text": "N’est-il pas raisonnable de penser que les gens qui ne boivent jamais de vin, naïfs ou systématiques, sont des imbéciles ou des hypocrites ; des imbéciles, c’est-à-dire des hommes ne connaissant ni l’humanité ni la nature, des artistes repoussant les moyens traditionnels de l’art ; ouvriers blasphémant la mécanique."
                                            },
                                            {
                                                "example_id": "e0626442-1471-43e6-92b4-212e3afe34fa",
                                                "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                                                "text": "[…], et le lendemain il faisait signer à son Conseil municipal d’abord, à ses administrés ensuite, une pétition contre cet imbécile de maître d’école qu’il fallait absolument et au plus vite faire f… le camp du pays."
                                            },
                                            {
                                                "example_id": "1a58a629-c614-4219-8319-633ac32a7a53",
                                                "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                                                "text": "Imbécile de Grubb, – maugréait-il, fouillant en vain ses poches. – Il avait bien besoin de garder ma boite… avec sa maudite habitude de vous « faire » vos allumettes."
                                            },
                                            {
                                                "example_id": "9f0d831b-15a2-4178-93a5-4718340f53f6",
                                                "sense_id": "25443e1f-101d-3b9d-b615-cf5c60a046b7",
                                                "text": "Ma chère Hélène,\nTa sœur est vraiment une imbécile de première ! Je me déteste ! Moi qui croyais faire une bonne action et me rendre utile, j'ai commis encore une erreur monumentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e4c8082-9581-33a6-9d4f-e79321253f3f",
                                        "entry_id": "251cc636-5482-3f54-b034-b571fc59e0c3",
                                        "glosses": [
                                            "Personne atteinte d'imbécillité."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14037e41-d4bb-42df-9363-c2505d1a65e1",
                                                "sense_id": "0e4c8082-9581-33a6-9d4f-e79321253f3f",
                                                "text": "Louis XVI n'était pas précisément tel qu'on s'était attaché à le peindre pour l’avilir : ce n'était ni l’imbécile abruti qu'on exposait au mépris du peuple, ni l'honnête homme bon et sensible que préconisaient ses amis."
                                            },
                                            {
                                                "example_id": "b1578a25-0644-4d2c-b395-08708ce15db9",
                                                "sense_id": "0e4c8082-9581-33a6-9d4f-e79321253f3f",
                                                "text": "Ce pauvre homme n’avait pas une idée. Je lui voyais un effrayant geste d’imbécile quand on lisait aux journaux quelque grand massacre ; il riait comme peut rire un cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59be0417-0598-3ede-8a11-2d84e6d30156",
                                        "entry_id": "251cc636-5482-3f54-b034-b571fc59e0c3",
                                        "glosses": [
                                            "Personne sotte, dont l’attitude ou les propos relèvent de l’idiotie."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b51b0a4-beea-443c-a135-27b5177d8d14",
                                                "sense_id": "59be0417-0598-3ede-8a11-2d84e6d30156",
                                                "text": "Comme je ne leur adressais jamais la parole, parce que leur vue seule suffisait à m’ écœurer, ils me prenaient pour un enfant arriéré, et me demandaient : « Comment je m’appelle, moi ? » Un jour, j’ai répondu à l’un d’eux, avec une lenteur et une douceur extrêmes : « Im-bé-ci-le ». Mon père m’a souffleté ; mais j’avais produit mon petit effet, je vous assure."
                                            },
                                            {
                                                "example_id": "ecbb6d09-9d75-4571-a961-48d6b57ba947",
                                                "sense_id": "59be0417-0598-3ede-8a11-2d84e6d30156",
                                                "text": "Mr Balfour écrivait jadis : « Il est regrettable que seuls les enthousiastes puissent émouvoir les peuples, car les enthousiastes sont presque toujours des imbéciles. »"
                                            },
                                            {
                                                "example_id": "2d9a4e48-f507-42f5-9b83-d54cf02d7ef7",
                                                "sense_id": "59be0417-0598-3ede-8a11-2d84e6d30156",
                                                "text": "Du reste, ce dîner ne nous ennuya pas, il est parfois très doux de causer avec des imbéciles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
