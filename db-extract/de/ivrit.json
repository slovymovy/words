                "senses": [
                    {
                        "sense_id": "f3d81b3f-0166-3dfd-aeae-ea283e4ac405",
                        "entry_id": "eb6527bb-d97d-3bf8-b618-2c2a84961f2e",
                        "glosses": [
                            "alternative Schreibweise von Iwrit"
