                ],
                "senses": [
                    {
                        "sense_id": "8b807c56-a760-3873-aab1-b2d099012834",
                        "entry_id": "af792535-666c-3831-ac27-022f376f4299",
                        "glosses": [
                            "Stelle, die hell ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efddbf3-75c6-47f4-8829-7ffb5dad0bf7",
                                "sense_id": "8b807c56-a760-3873-aab1-b2d099012834",
                                "text": "„Doch drinnen im Wald mit seinen nur selten durch Lichtflecken durchbrochenen Schatten blieb es kühl.“"
                            },
                            {
                                "example_id": "55b7ad63-2318-43d9-a6d5-c694c6b9cf93",
                                "sense_id": "8b807c56-a760-3873-aab1-b2d099012834",
                                "text": "„Grelle Lichtflecke schoben sich blitzartig vor seine Vision und löschten die Scheußlichkeit aus.“"
                            },
                            {
                                "example_id": "e3a8e05d-6feb-472b-b7d1-d72c760f2986",
                                "sense_id": "8b807c56-a760-3873-aab1-b2d099012834",
                                "text": "„Der Lichtfleck über ihnen wurde schwächer und schrumpfte zu einem Punkt zusammen.“"
                            },
                            {
                                "example_id": "2bb0424f-db4a-4417-b510-7c9a6e10458a",
                                "sense_id": "8b807c56-a760-3873-aab1-b2d099012834",
                                "text": "„Kleine Lichtflecken prallen von einem hin- und herschwingenden polierten Silberpendel ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
