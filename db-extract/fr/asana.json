                "entry_id": "89a01920-ea06-3fd2-a06d-f88796ded69f",
                "word": "asana",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9869fc8f-d6e5-4e8f-8533-409fe74ee5d1",
                        "entry_id": "89a01920-ea06-3fd2-a06d-f88796ded69f",
                        "tags": [
                            "plural"
                        ],
                        "form": "asanas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "479c31a6-1dd4-384d-a176-039af123fd38",
                        "entry_id": "89a01920-ea06-3fd2-a06d-f88796ded69f",
                        "glosses": [
                            "Exercice de hatha yoga consistant en une position immobile du corps, un mouvement, ou en une combinaison des deux."
                        ],
                        "tags": [
                            "Yoga"
                        ],
                        "examples": [
                            {
                                "example_id": "db12a3f6-12f6-406a-959e-b4a263a79ab2",
                                "sense_id": "479c31a6-1dd4-384d-a176-039af123fd38",
                                "text": "C’est une asana qui favorise l’élasticité."
                            },
                            {
                                "example_id": "3ffedae9-4f3b-4f6d-ad6e-9b4d5d456065",
                                "sense_id": "479c31a6-1dd4-384d-a176-039af123fd38",
                                "text": "Un asana est une posture qui s’effectue lentement à la façon d’une œuvre d’art."
                            },
                            {
                                "example_id": "292d8bcc-ee8f-4ee2-a093-610c97f7f4f5",
                                "sense_id": "479c31a6-1dd4-384d-a176-039af123fd38",
                                "text": "Dans la foulée des effets d'échauffement de surya namaskar, les asanas debout sont la famille d’asanas la plus sécurisante pour l'échauffement et l'ouverture du corps tout entier en vue d’asanas à venir plus complexes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ef01264-c533-4a7a-a11a-6badb3c0e07a",
                        "source_entry_id": "89a01920-ea06-3fd2-a06d-f88796ded69f",
                        "source_sense_id": "479c31a6-1dd4-384d-a176-039af123fd38",
                        "target_lang_word": "Asana",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asana",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9df432-facc-3f60-a9c8-41816f137a55",
                                        "entry_id": "f906636b-cd84-3841-b3cc-f737ff2020bf",
                                        "glosses": [
                                            "für längere Zeit gehaltene (statische) oder in fließenden Bewegungen ausgeführte (dynamische) Körperhaltung /Körperübung, die der Kräftigung, Flexibilität, Entspannung oder Vorbereitung auf die Meditation dient oder als Körperhaltung während der Meditation verwendet wird"
                                        ],
                                        "tags": [
                                            "Yoga"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810c8984-e77b-4d47-a650-a0e31cc4b34b",
                                                "sense_id": "ab9df432-facc-3f60-a9c8-41816f137a55",
                                                "text": "„Rund 3 Millionen Deutsche bringen regelmäßig mithilfe von ‚Asanas‘, also bestimmten Yoga-Übungen, ihren Körper und Geist in Einklang.“"
                                            },
                                            {
                                                "example_id": "c77019ad-4c7c-45d5-8cf6-1f05f441bc9c",
                                                "sense_id": "ab9df432-facc-3f60-a9c8-41816f137a55",
                                                "text": "„In der Regel atmest du durch die Nase und versuchst, die Asanas synchron mit deiner Atmung auszuführen.“"
                                            },
                                            {
                                                "example_id": "c44fabdf-29e3-4bbf-95de-908cd23c0b69",
                                                "sense_id": "ab9df432-facc-3f60-a9c8-41816f137a55",
                                                "text": "„Zudem ist es wissenschaftlich nachgewiesen, dass eine Asana mindestens 5 Atemzüge gehalten werden sollte, um deren Wirkung auf allen Ebenen voll zu entfalten.“"
                                            },
                                            {
                                                "example_id": "fcd06a22-429d-4835-b2da-3aab8b1e4e4c",
                                                "sense_id": "ab9df432-facc-3f60-a9c8-41816f137a55",
                                                "text": "„Es werden erlernt und geübt: weiterführende Haltungen (Asana) in Verbindung mit spezieller Atemführung, Konzentrationstechniken zur Meditationsvorbereitung und Tiefenentspannungstechniken (Yoga nidra).“"
                                            },
                                            {
                                                "example_id": "5a1ff1c7-b634-4a3b-8ab6-8ee9d7d897b3",
                                                "sense_id": "ab9df432-facc-3f60-a9c8-41816f137a55",
                                                "text": "„Damit Ihnen Yoga wirklich gut tut, arbeiten unsere Kursleiter stets mit anatomisch korrekten Ausrichtungsprinzipien, um Sie sicher in die einzelnen Körperhaltungen (Asana) hinein und wieder heraus zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
