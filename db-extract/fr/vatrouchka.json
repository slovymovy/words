                ],
                "senses": [
                    {
                        "sense_id": "59f27f25-beeb-36c2-a3aa-0d122f95a02d",
                        "entry_id": "2b505566-a45b-3c66-8c1b-6f367949fdd6",
                        "glosses": [
                            "Gâteau au fromage blanc d’origine ukrainienne et russe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d870b74e-daf4-4047-93cf-146548c335ee",
                                "sense_id": "59f27f25-beeb-36c2-a3aa-0d122f95a02d",
                                "text": "Elle se leva, changea les assiettes et apporta le dessert : une vatrouchka un peu desséchée."
                            },
                            {
                                "example_id": "9b878766-a9f3-40b9-9691-3805c1eb3224",
                                "sense_id": "59f27f25-beeb-36c2-a3aa-0d122f95a02d",
                                "text": "Le maître d’hôtel …, s’inclina et débita le menu.\n— À l’ordinaire pour Son Altesse impériale. Autrement oukha, soupe de poissons avec pommes de terre et okrochka accompagné d’esturgeon bouilli à laquelle on ajoutera un kéfir. Au préalable seront servis des harengs marinés, du caviar, des concombres à l’aigre-doux. Enfin, en dessert, un vatrouchka au fromage blanc et fruits confits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e83f9e59-17ea-4690-ad30-a0d0a950758f",
                        "source_entry_id": "2b505566-a45b-3c66-8c1b-6f367949fdd6",
                        "source_sense_id": "59f27f25-beeb-36c2-a3aa-0d122f95a02d",
                        "target_lang_word": "vatrushka",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vatrushka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                        "entry_id": "a56f720f-23fe-3f33-8f4b-2efa179982e8",
                                        "glosses": [
                                            "A sort of small, round pastry filled with cottage cheese, popular in Eastern Europe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "634cd1f3-1c80-408b-b5ba-3280e17ad8da",
                                                "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                                "text": "Her ladyship was reduced to the pitiable choice of yesterday’s croissants or one of the nine different kinds of rolls, milk breads, sweet breads, scones, pancakes, vatrushki, kalachi, ponchiki, rogaliki and bulochki whose delicious, new-baked smell was wafting all over the house."
                                            },
                                            {
                                                "example_id": "23c0f4b0-c93b-47a0-a596-322b11f3579e",
                                                "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                                "text": "Bake about 25 minutes or until lightly browned and cooked. Cool on a rack. Yield: About four dozen vatrushki"
                                            },
                                            {
                                                "example_id": "9a3fdb0f-b894-42bd-b6c2-ff63f4cd5358",
                                                "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                                "text": "Bake for 15–20 minutes, or until the vatrushki are golden."
                                            },
                                            {
                                                "example_id": "b9d6bc80-f735-4526-9a12-5d3614ff218a",
                                                "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                                "text": "But at night when they came to see me in the Ural, when they had knocked back huge amounts of Kunzevskaya and Stolichnaya and devoured piles of piroshki, oladyi, vatrushki, and bulochki with zimmes, they spoke French, English, kissed hands and paid compliments, knew the wittiest toasts, and fiddled their Russian souls inside out in order to dance on the most crooked roofs of the most Eastern shtetl at dawn."
                                            },
                                            {
                                                "example_id": "390ae524-b200-42e5-80da-0cd1475c48a7",
                                                "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                                "text": "“You look wonderful,” he said, unable to hold his tongue. / “So do you,” she replied with an amused smile, “but I think you raided the fat end of Vasily’s wardrobe. He has a thin end which he uses when he’s off the vatrushki and vodka.”"
                                            },
                                            {
                                                "example_id": "b4993db0-933d-46a6-9c16-47e6b63438af",
                                                "sense_id": "84746d09-e36b-31f4-969c-93016395b061",
                                                "text": "Typically, vatrushki are made from a yeasted wheat flour dough enriched with butter, eggs, and sugar rather like brioche, shaped into a flattened round that is pinched up and then filled with tvorog—a kind of farmer’s curd cheese similar to German quark or Italian ricotta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
