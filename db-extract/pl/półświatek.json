                    {
                        "translation_id": "ad27cc5c-0b86-462c-a19a-9c642e943f4c",
                        "source_entry_id": "1bcdc015-4313-3887-8279-b429bc138304",
                        "source_sense_id": "2d2dd9cd-aa84-315a-bea1-af99024f28fc",
                        "target_lang_word": "demi-monde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-monde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "657820cb-0286-3e12-a82e-37335e0b1493",
                                        "entry_id": "c0fc0c3d-1364-3993-9fc5-ef9cc0152d75",
                                        "glosses": [
                                            "Marges de la bonne société, mais fréquentées par celle-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83eae8dd-966c-4e24-8f5b-0ad2db2da933",
                                                "sense_id": "657820cb-0286-3e12-a82e-37335e0b1493",
                                                "text": "[…] qu’un homme riche, un « client sérieux », ait l’air de trouver agréable la femme qu’ils accompagnent, vous les voyez disparaître sous un prétexte quelconque, et céder la place sans se fâcher. Et vous comprenez alors (trop tard) à qui vous avez eu affaire… Santos Iturria ne pouvait pas supporter ces hommes du demi-monde."
                                            },
                                            {
                                                "example_id": "514a8de0-3596-49f9-965e-ccb31434bbde",
                                                "sense_id": "657820cb-0286-3e12-a82e-37335e0b1493",
                                                "text": "Dans la Maison des amis du zoo s’était retrouvé l’habituel mélange francfortois d’anciennes fortunes et de nouveaux riches, de magnats de la presse et de célébrités de la télévision, du sport et du demi-monde qui avaient contribué à ce que l’association ait un toit au-dessus de sa tête."
                                            },
                                            {
                                                "example_id": "7f27427e-44c9-4837-bffb-61deba6c0d30",
                                                "sense_id": "657820cb-0286-3e12-a82e-37335e0b1493",
                                                "text": "Maupassant a dépeint le demi-monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b7a4290-5188-3bdd-8baa-0de9acd77de1",
                                        "entry_id": "c0fc0c3d-1364-3993-9fc5-ef9cc0152d75",
                                        "glosses": [
                                            "Milieu constitué autour de femmes légères, souvent vénales ou entretenues par les hommes du monde."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb842063-35f3-4f8c-b7fc-e04a2869f60b",
                                                "sense_id": "2b7a4290-5188-3bdd-8baa-0de9acd77de1",
                                                "text": "Dans Mam’zelle Nitouche, fort de son expérience, Hervé créa l’archétype du personnage double, à la fois Célestin pour les cocottes du demi-monde et Floridor pour les grenouilles de bénitier de matines et de vêpres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
