                                                "sense_id": "aabd1094-0cc2-3533-9446-08907c89b656",
                                                "text": "No amount of fetish wear or powerful looking garments can make a domme out of a woman who hasn't worked on her power and grace within."
                                            },
                                            {
                                                "example_id": "0aa1739f-3740-4318-a8b8-8c0ef2e59d86",
                                                "sense_id": "aabd1094-0cc2-3533-9446-08907c89b656",
                                                "text": "Something dommes know is that fear can be controlled — and even used to your advantage."
                                            },
                                            {
                                                "example_id": "0a2f05a4-6a43-438a-801d-c4ae87a5a6d4",
                                                "sense_id": "aabd1094-0cc2-3533-9446-08907c89b656",
                                                "text": "Leather and rubber fetish has always been popular but there’s a massive need for dommes who specialise in foot and shoe worship; there are just not enough of us to go around."
                                            }
                                        ]
                                    }
