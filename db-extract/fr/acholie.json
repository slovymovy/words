                        "form": "acholies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1209c78-efda-3600-aed2-aa112d487a72",
                        "entry_id": "61de123e-c2dd-34c5-a55f-a5092a97cbde",
                        "glosses": [
                            "Arrêt ou diminution notable de la sécrétion biliaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf78f4b3-a638-4ed0-8914-e23081cedc41",
                                "sense_id": "c1209c78-efda-3600-aed2-aa112d487a72",
                                "text": "Quand la bile est sécrétée en trop grande abondance, cet état se nomme polycholie. Le mot acholie désigne une disposition contraire, mais qui n’est pas moins nuisible à la conservation de la santé."
                            },
                            {
                                "example_id": "83573a7f-5fc7-4dd9-a722-ccdd65e3f3b7",
                                "sense_id": "c1209c78-efda-3600-aed2-aa112d487a72",
                                "text": "L’acholie totale peut également survenir en cas d’hépatite, surtout au cours des premiers jours ou lors d’une récidive, et s’observe dans 1/5ème des cas."
                            }
                        ]
                    }
                ],
                "translations": [
