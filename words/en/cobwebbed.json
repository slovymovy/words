{
    "word_family": [
        "cobweb",
        "cobwebby"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1d39526e-6d3a-3d89-90f4-b14fc33ef4b8",
                    "sense_definition": "Covered with cobwebs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We climbed into the dark, <w>cobwebbed</w> attic to look for the old photo albums.",
                            "target_lang_translations": {
                                "de": "Wir stiegen auf den dunklen, <w>von Spinnweben bedeckten</w> Dachboden, um nach den alten Fotoalben zu suchen."
                            }
                        },
                        {
                            "text": "The paint was peeling, and the antique furniture was dusty and <w>cobwebbed</w>.",
                            "target_lang_translations": {
                                "de": "Die Farbe blätterte ab und die antiken Möbel waren staubig und <w>voller Spinnweben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cobwebby"
                    ],
                    "common_phrases": [
                        "cobwebbed attic",
                        "cobwebbed corner"
                    ],
                    "target_lang_definitions": {
                        "de": "Voll von Spinnweben; mit Spinnweben bedeckt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "spinnwebig",
                                "target_lang_sense_clarification": "voller Spinnweben"
                            },
                            {
                                "target_lang_word": "voller Spinnweben",
                                "target_lang_sense_clarification": "mit Spinnweben bedeckt"
                            },
                            {
                                "target_lang_word": "von Spinnweben bedeckt",
                                "target_lang_sense_clarification": "physisch mit Spinnweben überzogen"
                            },
                            {
                                "target_lang_word": "verwebt",
                                "target_lang_sense_clarification": "eingesponnen oder mit Netzen überzogen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "320c7414-51ec-3fa6-8fbe-fa3cf8f1ea70",
                    "sense_definition": "Old, outdated, or neglected, like something left untouched for a long time.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outdated_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company struggled to modernize because of its <w>cobwebbed</w> administrative procedures.",
                            "target_lang_translations": {
                                "de": "Das Unternehmen tat sich schwer mit der Modernisierung aufgrund seiner <w>verstaubten</w> Verwaltungsverfahren."
                            }
                        },
                        {
                            "text": "He relied on <w>cobwebbed</w> theories that had long been disproven by modern researchers.",
                            "target_lang_translations": {
                                "de": "Er stützte sich auf <w>veraltete</w> Theorien, die von modernen Forschern längst widerlegt worden waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "aged",
                        "hoary",
                        "obsolete",
                        "old"
                    ],
                    "common_phrases": [
                        "cobwebbed ideas",
                        "cobwebbed rules"
                    ],
                    "target_lang_definitions": {
                        "de": "Alt, verstaubt, veraltet oder lange Zeit vernachlässigt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verstaubt",
                                "target_lang_sense_clarification": "im übertragenen Sinne: überholt, altmodisch"
                            },
                            {
                                "target_lang_word": "veraltet",
                                "target_lang_sense_clarification": "nicht mehr zeitgemäß"
                            },
                            {
                                "target_lang_word": "angestaubt",
                                "target_lang_sense_clarification": "leicht überholt oder antiquiert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}