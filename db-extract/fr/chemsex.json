                                                "example_id": "0b5d3e74-3e4c-46f4-bca2-d740990d24e4",
                                                "sense_id": "150404ba-0774-33cf-a520-d3ab473cd9a5",
                                                "text": "I have redonned my jeans, but the atmosphere at the next place will not require me to wear anything more than my underwear at most. We are going to a chemsex party."
                                            }
                                        ]
                                    }
                                ]
                            }
