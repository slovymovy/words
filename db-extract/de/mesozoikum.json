                "senses": [
                    {
                        "sense_id": "be676895-c3ab-3612-b2e6-262e7fe3b2ac",
                        "entry_id": "9f22a09e-c144-34a7-8596-12b409d75019",
                        "glosses": [
                            "geologische Ära (von ca. 248 Mill. bis ca. 66 Mill. Jahren), Erdmittelalter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee356c1e-0572-4388-b4f1-6ef01f2ed417",
                                "sense_id": "be676895-c3ab-3612-b2e6-262e7fe3b2ac",
                                "text": "„Das Mesozoikum begann mit einer noch unbekannten Katastrophe bei der 90% aller Tier- und Pflanzenarten ausstarben. Dies machte den Weg frei für eine völlig neuartige Tier- und Pflanzenwelt. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "158be2bd-b675-4768-8fc2-1cf35f0a7b69",
                        "source_entry_id": "9f22a09e-c144-34a7-8596-12b409d75019",
                        "source_sense_id": "be676895-c3ab-3612-b2e6-262e7fe3b2ac",
                        "target_lang_word": "Mesozoic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mesozoic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd4dac9f-4e20-31e9-8a6b-92721be7949e",
                                        "entry_id": "e60b8624-c270-35b9-a3a3-127123788dd3",
                                        "glosses": [
                                            "Of a geologic era within the Phanerozoic eon that comprises the Triassic, Jurassic and Cretaceous periods from about 230 to 65 million years ago, when life on earth was dominated by reptiles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Mesozoic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                        "entry_id": "9092788e-357e-3850-ad88-abc4112416e3",
                                        "glosses": [
                                            "The Mesozoic era."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dcf22e3-0726-4c9e-a801-65628c93bb00",
                                                "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                                "text": "The whole history of the earth is divided into five eras, with corresponding rock-systems. These are: 1. Archæan or Eozoic¹ era, embodied in the Laurentian system; 2. Palæozoic² era, embodied in the Palæozoic or Primary system; 3. Mesozoic³ era, recorded in the Secondary system; 4. Cenozoic,⁴ recorded in the Tertiary and Quaternary systems; and, 5. The Psychozoic era, or era of Mind, recorded in the recent system."
                                            },
                                            {
                                                "example_id": "43ef6be4-4898-4380-aa19-9d636e044d5e",
                                                "sense_id": "f9dcbbcf-3928-3e07-8198-af9e50a3b21e",
                                                "text": "The Mesozoic landscape of southeastern Utah can tell us much about the past, and it's one of the most intriguing and beautiful landscapes on Earth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86e9b521-9912-44e5-9ebc-207cd65d7072",
                        "source_entry_id": "9f22a09e-c144-34a7-8596-12b409d75019",
                        "source_sense_id": "be676895-c3ab-3612-b2e6-262e7fe3b2ac",
