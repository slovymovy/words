                "senses": [
                    {
                        "sense_id": "23217c16-3fb2-30c8-97a0-82b053a86aa4",
                        "entry_id": "d78a2ffa-fdda-360b-bc47-703c2b78b424",
                        "glosses": [
                            "Être prééminent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b8a0b40-747f-4f39-93bc-e401ccc1c7ef",
                                "sense_id": "23217c16-3fb2-30c8-97a0-82b053a86aa4",
                                "text": "Lorsque l'un d'eux tend à prééminer arbitrairement, lorsqu'il s'asservit égoïstement les autres, il y a désordre."
                            },
                            {
                                "example_id": "cc6ecb2a-4f41-44ba-abe7-24bc419c3150",
                                "sense_id": "23217c16-3fb2-30c8-97a0-82b053a86aa4",
                                "text": "Mais même dans ses actes amicaux, il conservait ses habitudes d'autorité, son désir de prééminer."
                            },
                            {
                                "example_id": "9846e021-da61-4204-8ed5-d38a7025aa02",
                                "sense_id": "23217c16-3fb2-30c8-97a0-82b053a86aa4",
                                "text": "La hiérarchie ecclésiastiquc doit toujours prééminer d'honneur et de juridiction sur la hiérarchie religieuse."
                            }
                        ]
                    }
