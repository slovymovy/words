                                    {
                                        "sense_id": "79995c99-2773-3e87-a794-844fe2263d75",
                                        "entry_id": "4bf3651a-e814-39cb-a2e2-adad697f3a7d",
                                        "glosses": [
                                            "technische Einrichtung zum Ablassen von Flüssigkeiten und Gasen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7dc1379-af92-4fc9-b695-9156ab4f1abb",
                                                "sense_id": "79995c99-2773-3e87-a794-844fe2263d75",
                                                "text": "Das Fass hat keinen Ablass."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b4fcafa-f2ab-3471-b92f-ac0e8e9c32b7",
                                        "entry_id": "4bf3651a-e814-39cb-a2e2-adad697f3a7d",
                                        "glosses": [
                                            "Erlass oder Nachlass von Bußstrafen (nicht aber von Sünden) für Lebende oder Verstorbene, der als von Gott geschenkt durch die Kirche vermittelt wird"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4909ef35-eb43-48db-9bb7-5ccd5d61e388",
                                                "sense_id": "7b4fcafa-f2ab-3471-b92f-ac0e8e9c32b7",
                                                "text": "Johann Tetzel verkaufte jede Menge Ablässe."
                                            },
                                            {
                                                "example_id": "d5d278ac-f7e9-4fae-88b7-059836c823b2",
                                                "sense_id": "7b4fcafa-f2ab-3471-b92f-ac0e8e9c32b7",
                                                "text": "\"Ablaß (Indulgenz), ursprünglich Nachlaß einer von der Kirche auferlegten Bußleistung.\""
                                            },
                                            {
                                                "example_id": "a710cdb9-836c-45e5-aff4-75e6e7afb79a",
                                                "sense_id": "7b4fcafa-f2ab-3471-b92f-ac0e8e9c32b7",
                                                "text": "„Welche Sprengkraft davon ausging, verdeutlicht die Tatsache, dass eine Ablasskampagne Martin Luther auf den Plan rief, ein Ablass mittelbar die Reformation auslöste.“"
                                            },
                                            {
                                                "example_id": "ffd235bd-6166-49e7-9f02-20ccdc221087",
                                                "sense_id": "7b4fcafa-f2ab-3471-b92f-ac0e8e9c32b7",
                                                "text": "„Hinzu kamen 3000 Dukaten an Organisationskosten für den Ablass, mit dem das Geld in den Territorien Albrechts eingeworben werden sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46919b77-8f4d-4870-9756-7530991273c0",
                        "source_entry_id": "9a8b78a0-bae7-3d34-9ba1-5f7dac00a8ac",
                        "source_sense_id": "c47c134a-5533-3454-be41-35e68acdf7d8",
                        "source_sense_description": "een kwijtschelding van tijdelijke straffen die men zou moeten ondergaan na het sterven..",
                        "target_lang_word": "indulgence",
