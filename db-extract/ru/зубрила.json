                    }
                ],
                "senses": [
                    {
                        "sense_id": "6dafd88b-d735-3f09-a230-dce1ee8d407a",
                        "entry_id": "ddb50243-d436-3def-8dfa-cec858eaf2cb",
                        "glosses": [
                            "школьн., презр. тот, кто добивается результатов зубрёжкой, путём бессмысленного заучивания чего-либо наизусть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbb9012d-4379-48a9-bcae-cbe06c335659",
                                "sense_id": "6dafd88b-d735-3f09-a230-dce1ee8d407a",
                                "text": "Чтобы избежать «кола», зубрила каждый вечер так старался, что на него и жалко и забавно было смотреть."
                            },
                            {
                                "example_id": "4d1de2a4-044b-4f84-966e-f16bc6c6b66a",
                                "sense_id": "6dafd88b-d735-3f09-a230-dce1ee8d407a",
                                "text": "Это был чистюля, зубрила, первый ученик, маменькин сынок…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bca0099-abed-4cd0-8591-1ed770495d41",
                        "source_entry_id": "ddb50243-d436-3def-8dfa-cec858eaf2cb",
                        "source_sense_id": "6dafd88b-d735-3f09-a230-dce1ee8d407a",
                        "target_lang_word": "crammer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crammer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a912f3-9f4f-35c5-b94a-700837d7b6a7",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "One who crams or stuffs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "635ee498-a736-49d1-ae2c-5ab423994862",
                                                "sense_id": "95a912f3-9f4f-35c5-b94a-700837d7b6a7",
                                                "text": "The pigeon crammers of Paris took mouthfuls of grain and water and spat it into the mouth of a pigeon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c20e3c3-46a6-343b-b4d9-3a30418946b8",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "A book used for accelerated study in preparation for an examination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4923243-f83a-32c6-893a-68dc017538bb",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "A student who studies hard for an examination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a166e1b2-9dfc-33f3-a7cf-c6c8eeea6d3d",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "A teacher who aids such a student."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d098147-4def-3163-9200-e7096e1bbb05",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "A school whose speciality is helping students to pass certain examinations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "272de2d1-a063-3e3f-bf53-a3d461226649",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "A liar."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987fff0d-2902-4b7a-afb8-c3c69852c79c",
                                                "sense_id": "272de2d1-a063-3e3f-bf53-a3d461226649",
                                                "text": "Look here; do you mean to call me a crammer?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb64ebb1-5506-3565-8544-edd5952c1cc6",
                                        "entry_id": "d0714332-ef9b-346a-a2f4-b18cd0d9828d",
                                        "glosses": [
                                            "A lie."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db279746-5f49-4a92-89d1-e64560f4c0fa",
                                                "sense_id": "bb64ebb1-5506-3565-8544-edd5952c1cc6",
                                                "text": "I'm afraid he wouldn't mind telling crammers about it if he was questioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e3c1157-f93d-44b8-a485-0a11fbe6f8ba",
                        "source_entry_id": "ddb50243-d436-3def-8dfa-cec858eaf2cb",
                        "source_sense_id": "6dafd88b-d735-3f09-a230-dce1ee8d407a",
                        "target_lang_word": "bachoteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bachoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32a0ef03-25c2-39e4-a73d-b8716e269b3e",
                                        "entry_id": "6a77a398-437b-3892-8532-ae54e194859b",
                                        "glosses": [
                                            "Batelier qui conduit un bachot."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e8c8d3-1999-46a5-9062-fb507f2243cd",
                                                "sense_id": "32a0ef03-25c2-39e4-a73d-b8716e269b3e",
                                                "text": "Il ya douze bateaux, avec pour chaque bateau un porteur de la lance et un bachoteur (le rameur), portant chacun une ceinture rouge ou une ceinture bleue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bachoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc68f9d4-8a67-3d59-8201-613d9d93cb4b",
                                        "entry_id": "f6430bf9-bb1a-3258-8837-8d6727b0b783",
                                        "glosses": [
                                            "Celui qui prépare un examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f393a6c-303b-4dbf-b303-cc1ef428fe2e",
                                                "sense_id": "fc68f9d4-8a67-3d59-8201-613d9d93cb4b",
                                                "text": "Le spectre des attitudes est large, du bachoteur archi-préparé avec cinq pages de question sur un cahier milimétré, au parfait dilettante se disant « après tout, on verra bien ! »"
                                            },
                                            {
                                                "example_id": "9a8e9b5f-1652-4227-bc24-d244ff319be1",
                                                "sense_id": "fc68f9d4-8a67-3d59-8201-613d9d93cb4b",
                                                "text": "Avec un objectif en tête, en se fixant des priorités et en dosant ses efforts, on fait souvent mieux, et avec une vie bien plus agréable, que la bachoteuse du premier rang qui a appris le bouquin par cœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ac6107f-14b6-449b-b9b2-8e98b0032325",
                        "source_entry_id": "ddb50243-d436-3def-8dfa-cec858eaf2cb",
                        "source_sense_id": "6dafd88b-d735-3f09-a230-dce1ee8d407a",
                        "target_lang_word": "bûcheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bûcheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee841db-8bc8-3d35-a7cc-703d9ceb8951",
                                        "entry_id": "fb628fcf-e6d9-302e-bd76-8c89f66456ed",
                                        "glosses": [
                                            "Celui qui travaille beaucoup dans le domaine intellectuel."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58633f6d-173f-432c-869b-ce2ba35a5dce",
                                                "sense_id": "4ee841db-8bc8-3d35-a7cc-703d9ceb8951",
                                                "text": "Paillardin. — Ah ! en voilà un qui ne pense pas à la gaudriole. C’est un bûcheur qui ne songe qu’à piocher sa philosophie !"
                                            },
                                            {
                                                "example_id": "fee49c2d-241e-4789-849d-79a183dcd681",
                                                "sense_id": "4ee841db-8bc8-3d35-a7cc-703d9ceb8951",
                                                "text": "Je ne ressemblais en rien à ces enfants qui sont toujours premiers en faisant semblant de ne se donner aucun mal. J’étais un « bûcheur » et m’en faisais gloire : un bûcheur, rien que cela."
                                            },
                                            {
                                                "example_id": "44839ede-ef0f-4d06-b4f8-c5767b8ab1be",
                                                "sense_id": "4ee841db-8bc8-3d35-a7cc-703d9ceb8951",
                                                "text": "Il en était déjà ainsi quand il fréquentait le lycée. On le prenait pour un bûcheur parce qu'il était toujours enfermé dans sa chambre."
                                            },
                                            {
                                                "example_id": "3bc74c13-1215-4c84-8f64-720b1d551d34",
                                                "sense_id": "4ee841db-8bc8-3d35-a7cc-703d9ceb8951",
                                                "text": "Trois jours de privation de vacances sanctionnèrent sa « désastreuse conduite » ; en revanche, il obtenait la deuxième place au classement d’études, derrière le Brestois Braval, bûcheur d’une rare endurance, doué pour le travail manuel, discipliné, sinon servile, bien qu’il eût choisi l’École de Tulle, « cette pépinière de brebis galeuses »."
                                            }
                                        ]
                                    }
