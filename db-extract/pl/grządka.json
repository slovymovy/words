                    {
                        "translation_id": "08ecd971-fbea-4794-b564-d94eda844eb0",
                        "source_entry_id": "165ddda9-d83f-3e42-bb7e-70897f920ce5",
                        "source_sense_id": "7809d742-c8fd-3f15-a26e-eacc4ecdb113",
                        "source_sense_description": "kleine Stange, auf der Vögel sitzen können",
                        "target_lang_word": "Stange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50290ab3-3cac-3330-b45f-71d4409f6238",
                                        "entry_id": "a9bb0b2f-6492-3024-b30d-c2e4c7595cc1",
                                        "glosses": [
                                            "länglicher Gegenstand meist aus Holz oder Metall, gerades Bauelement zur Kraftübertragung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec3d992a-5a86-49b2-9b13-0c00e78e31bc",
                                                "sense_id": "50290ab3-3cac-3330-b45f-71d4409f6238",
                                                "text": "Ich habe noch ein paar Stangen aus Holz, die wir zum Abstützen des Garagendaches nehmen können."
                                            },
                                            {
                                                "example_id": "4d1b217a-b8eb-475e-82a7-d8b79b574374",
                                                "sense_id": "50290ab3-3cac-3330-b45f-71d4409f6238",
                                                "text": "„Aber der dürre lange Tote war Morten Sise, der Kapitän selber, und da er zeit seines Lebens ein sonderbarer Kauz gewesen war, wollte er auch jetzt im Meere bleiben, wo es ihm immer am besten gefallen hatte, und wie sehr man auch mit Stangen und Widerhaken an ihm zerrte, er gab nicht nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3db39421-fdbc-3146-930f-09871669c46c",
                                        "entry_id": "a9bb0b2f-6492-3024-b30d-c2e4c7595cc1",
                                        "glosses": [
                                            "Gegenstand in länglicher Form"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e2e1e5-7126-4e42-ae00-6c7836ace46c",
                                                "sense_id": "3db39421-fdbc-3146-930f-09871669c46c",
                                                "text": "Schau, das ist eine Stange Dynamit."
                                            },
                                            {
                                                "example_id": "ecbd22b1-7f44-42d0-9fc5-8a09fdac250c",
                                                "sense_id": "3db39421-fdbc-3146-930f-09871669c46c",
                                                "text": "„Unsere Fenster waren hoch und hatten zur Sicherheit senkrechte schmiedeeiserne Stangen, aber keine Querstangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7feab8ae-3b03-375d-b3b6-f1914fa21923",
                                        "entry_id": "a9bb0b2f-6492-3024-b30d-c2e4c7595cc1",
                                        "glosses": [
                                            "mehrere Gegenstände, die verpackt der Form von [2] ähneln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "641b7e0f-2074-46fa-b2a8-159eb8b8f2ce",
                                                "sense_id": "7feab8ae-3b03-375d-b3b6-f1914fa21923",
                                                "text": "Kauf doch gleich eine ganze Stange."
                                            },
                                            {
                                                "example_id": "f48beb20-f265-4716-b5e9-e12c9c4e752f",
                                                "sense_id": "7feab8ae-3b03-375d-b3b6-f1914fa21923",
                                                "text": "„Vorsorglich hatte er eine Stange Gauloises mitgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0700fe99-49df-384a-83a5-b20f66c33b99",
                                        "entry_id": "a9bb0b2f-6492-3024-b30d-c2e4c7595cc1",
                                        "glosses": [
                                            "ein besonderes Bierglas, die Kölner Stange"
                                        ],
                                        "tags": [
                                            "Kölsch"
                                        ],
                                        "examples": [
