                                        "sense_id": "b9cadf50-351a-3cf2-a80c-d5ad90e9fbd5",
                                        "entry_id": "936fa025-7c33-39b2-a75d-a456643c7e59",
                                        "glosses": [
                                            "Qui est dangereux ; où il y a du péril."
                                        ],
