                    {
                        "sense_id": "ad7b9299-0827-37c5-9e69-8460a3566b55",
                        "entry_id": "1f797c95-97ab-3759-9fd0-23a25cab8554",
                        "glosses": [
                            "to darken, to become dark"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7f8c7f28-d12b-4099-8322-4abfad038fa1",
                                "sense_id": "ad7b9299-0827-37c5-9e69-8460a3566b55",
                                "text": "У меня́ потемне́ло в глаза́х.",
                                "translation": "Everything went dark before my eyes.",
                                "english": "Everything went dark before my eyes."
                            },
                            {
                                "example_id": "7fe9bff6-cdc0-4c0a-b821-406089386c85",
                                "sense_id": "ad7b9299-0827-37c5-9e69-8460a3566b55",
                                "text": "Бума́жная воро́нка внизу́ и сбо́ку, где текла́ струя́, промо́кла и потемне́ла.",
                                "translation": "The paper funnel, at the bottom and the side, where the trickle of scent ran, became wet and dark.",
                                "english": "The paper funnel, at the bottom and the side, where the trickle of scent ran, became wet and dark."
                            }
                        ]
                    }
