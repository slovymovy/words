        "fr-extract.jsonl": [
            {
                "entry_id": "e21d9756-4393-3813-b90f-ec45cdf564f1",
                "word": "evzone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a5bca06-b4cb-4eb9-bb11-52d3161c66e9",
                        "entry_id": "e21d9756-4393-3813-b90f-ec45cdf564f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "evzones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b19439b8-616a-3df8-bb43-d4ffedba05b2",
                        "entry_id": "e21d9756-4393-3813-b90f-ec45cdf564f1",
                        "glosses": [
                            "Fantassin grec de l'infanterie légère, dont la tenue de parade est principalement caractérisée par le port d'un jupon court, appelé fustanelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6a49b1-baf7-4664-a28d-c906a0e70487",
                                "sense_id": "b19439b8-616a-3df8-bb43-d4ffedba05b2",
                                "text": "Les evzones gardent le Parlement grec et la maison présidentielle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5ec1dd4-5713-4979-ab8d-50e13d63cd19",
                        "source_entry_id": "e21d9756-4393-3813-b90f-ec45cdf564f1",
                        "source_sense_id": "b19439b8-616a-3df8-bb43-d4ffedba05b2",
                        "target_lang_word": "evzone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evzone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28dff327-5389-3b0c-901b-4342654b3797",
                                        "entry_id": "cca9411a-9d6e-3457-a055-653617daa699",
                                        "glosses": [
                                            "A member of the Greek presidential guard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62b61e69-dd2f-3168-8a70-1c4594116dd8",
                                        "entry_id": "cca9411a-9d6e-3457-a055-653617daa699",
                                        "glosses": [
                                            "An infantryman of a select corps of the Greek army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b819a3a7-14fd-4fd5-95f9-bdf1cc690812",
                                                "sense_id": "62b61e69-dd2f-3168-8a70-1c4594116dd8",
                                                "text": "The soldiers seen at various stations belong to the corps of the Greek army that proved itself most effective in the recent war, the Evzonoi."
                                            },
                                            {
                                                "example_id": "a6711868-2b3a-4ba6-b197-f9b98eb25e32",
                                                "sense_id": "62b61e69-dd2f-3168-8a70-1c4594116dd8",
                                                "text": "The best-paid Greek soldiers are the Evzonoi, their pay amounting to 12 lepta a day extra (that is to say, to 27 lepta net)."
                                            },
                                            {
                                                "example_id": "e3b5b4cd-a4c4-490b-b83f-1719332cfabf",
                                                "sense_id": "62b61e69-dd2f-3168-8a70-1c4594116dd8",
                                                "text": "All this time little bands of rounded-up Evzones and men of the other regiment of the garrison were being brought in, together with news of the French losses."
                                            },
                                            {
                                                "example_id": "6089e61d-b8f5-4244-9715-17d7b31d8643",
                                                "sense_id": "62b61e69-dd2f-3168-8a70-1c4594116dd8",
                                                "text": "That's an evzone on our cover this month — and an evzone, as you probably know, is a Greek soldier of a certain kind. Recruited from mountain districts of Greece, the evzones make up rifle units in the Greek Army — but are better known to tourists as the skirted lads who make up the Royal Palace Guard."
                                            },
                                            {
                                                "example_id": "c3e79ecb-8867-47d9-bc46-8d79019c4040",
                                                "sense_id": "62b61e69-dd2f-3168-8a70-1c4594116dd8",
                                                "text": "The Evzones not only halted the invasion, but drove the Italians out of Greece and, by the onset of winter, occupied the southern quarter of Albania."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e59d6bcf-119a-4f4e-a95b-6bad28430dde",
                        "source_entry_id": "e21d9756-4393-3813-b90f-ec45cdf564f1",
                        "source_sense_id": "b19439b8-616a-3df8-bb43-d4ffedba05b2",
