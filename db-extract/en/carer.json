                                        "entry_id": "b1877084-34cc-3af6-b5ce-04e2d14d3d46",
                                        "glosses": [
                                            "weibliche Person, die die Aufgabe hat, eine oder mehrere andere Personen zu begleiten, pflegen oder ihnen zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554d2838-0767-4d21-98a8-fd3cbaabb5e5",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "Den Erfolg unseres Unternehmens haben wir vor allem unseren Betreuerinnen in der Marketing-Abteilung zu verdanken."
                                            },
                                            {
                                                "example_id": "02498a31-30da-4d3f-bba5-f8f1390276ac",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "„Als die Betreuerin auch Kratzspuren am Schloss mit Zahlencode entdeckte, informierte sie die Polizei.“"
                                            },
                                            {
                                                "example_id": "5d2fd524-f0ab-44d2-aa21-091c001d7e78",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "„Hin und wieder besucht ihn eine Betreuerin.“"
                                            },
                                            {
                                                "example_id": "81923f5f-0542-4e19-a32c-b9bbb575522d",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "Sie ist eine Betreuerin von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
