    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4733ef66-16c7-3526-9923-e457c951ea71",
                    "sense_definition": "Avancer vers quelqu'un ou quelque chose et arriver à proximité de lui ; se rapprocher dans l'espace.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "se rapprocher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train <w>approche</w> de la gare, il faut se préparer."
                        },
                        {
                            "text": "Quand l'orage <w>approchait</w>, nous sommes rentrés à la maison."
                        },
                        {
                            "text": "Nous <w>approchons</w> de la ville, on voit déjà les lumières."
                        }
                    ],
                    "synonyms": [
                        "se rapprocher"
                    ],
                    "antonyms": [
                        "s'éloigner"
                    ],
                    "common_phrases": [
                        "approcher de la ville",
                        "approcher de la gare"
                    ]
                },
                {
                    "sense_id": "04f1831a-fd3f-3346-bfdb-a6ee8c20ae3a",
                    "sense_definition": "Se rapprocher de quelqu'un ou de quelque chose, aller près de lui (forme pronominale : s'approcher).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "se rapprocher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'<w>approche</w> du comptoir pour commander un café."
                        },
                        {
                            "text": "Le chat s'<w>approche</w> doucement de la fenêtre."
                        },
                        {
                            "text": "Les enfants se sont <w>approchés</w> du lit sans faire de bruit."
                        }
                    ],
                    "synonyms": [
                        "se rapprocher"
                    ],
                    "antonyms": [
                        "s'éloigner"
                    ]
                },
                {
                    "sense_id": "63f473a1-78f0-347b-b313-5ae075a9b6dc",
                    "sense_definition": "Devenir proche dans le temps, être sur le point d'arriver (en parlant d'un moment, d'une date, d'un événement).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "devenir proche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vacances <w>approchent</w> et les enfants sont de plus en plus impatients."
                        },
                        {
                            "text": "Le moment <w>approche</w> où il faudra prendre une décision."
                        }
                    ],
                    "common_phrases": [
                        "le moment approche",
                        "la date approche",
                        "la fin approche"
                    ]
                },
                {
                    "sense_id": "56c0ab8e-aa93-37d9-85d6-84b7fc9bd305",
                    "sense_definition": "Mettre un objet ou une personne près de quelqu'un ou de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mettre près",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Approche</w> ta chaise de la table, on va manger."
                        },
                        {
                            "text": "Elle <w>approche</w> le fauteuil de la fenêtre pour mieux lire."
                        },
                        {
                            "text": "Il <w>approche</w> une chaise pour s'asseoir près de nous."
                        }
                    ],
                    "synonyms": [
                        "rapprocher"
                    ],
                    "antonyms": [
                        "éloigner"
                    ],
                    "common_phrases": [
                        "approcher une chaise",
                        "approcher la table"
                    ]
                },
                {
                    "sense_id": "b6caebc3-a618-333d-b4b4-9abb3362f353",
                    "sense_definition": "Se trouver ou se placer près de quelqu'un, venir à son contact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aborder quelqu'un",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien est agressif : personne n'ose l'<w>approcher</w>."
                        },
                        {
                            "text": "Empêchez cet homme de m'<w>approcher</w>, il me fait peur."
                        }
                    ]
                },
                {
                    "sense_id": "5df2716b-2e3c-3996-9902-e62e0057ad31",
                    "sense_definition": "Aborder quelqu'un ; avoir un accès facile auprès de lui pour lui parler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aborder quelqu'un",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a du mal à <w>approcher</w> les gens quand il est timide."
                        },
                        {
                            "text": "Le directeur est très occupé : on ne peut pas l'<w>approcher</w> facilement."
                        }
                    ],
                    "synonyms": [
                        "aborder"
                    ]
                },
                {
                    "sense_id": "e4dbe60e-3bc9-3741-967c-27cc0dd6af8a",
                    "sense_definition": "Être près de réussir ou de trouver la bonne réponse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce n'est pas tout à fait exact, mais tu <w>approches</w>."
                        },
                        {
                            "text": "Après des mois de travail, l'équipe <w>approche</w> enfin du but."
                        }
                    ],
                    "common_phrases": [
                        "approcher du but"
                    ]
                },
                {
                    "sense_id": "aed5bd02-2e20-37ea-a9ef-53403fc89175",
                    "sense_definition": "Avoir de la ressemblance ou un rapport étroit avec quelque chose ; s'en rapprocher par la qualité ou la nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son style <w>approche</w> de celui des grands écrivains classiques."
                        },
                        {
                            "text": "Rien n'<w>approche</w> de la beauté de ce paysage au lever du soleil."
                        }
                    ],
                    "synonyms": [
                        "ressembler"
                    ],
                    "common_phrases": [
                        "approcher de la perfection"
                    ]
                },
                {
                    "sense_id": "7c0f4d1d-31c8-3cb4-b2aa-fe8542ff6029",
                    "sense_definition": "Déterminer une valeur de façon approximative, sans calcul exact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On peut <w>approcher</w> le poids du chargement en mesurant son volume."
                        },
                        {
                            "text": "Les chercheurs <w>approchent</w> la valeur exacte grâce à un calcul simplifié."
                        }
                    ],
                    "synonyms": [
                        "estimer",
                        "évaluer"
                    ]
                },
                {
                    "sense_id": "f7b7b159-1860-3668-98a5-c94a261ed92e",
                    "sense_definition": "Admettre quelqu'un dans son entourage proche, dans son intimité.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "aborder quelqu'un",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le roi <w>approche</w> de lui quelques conseillers de confiance."
                        },
                        {
                            "text": "Le prince a <w>approché</w> de sa personne les hommes les plus fidèles."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "emploi vieilli, surtout dans la langue classique ou littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "e4973648-df7b-3549-aa6f-6df4adbc1367",
                    "sense_definition": "Faire paraître plus proche, en parlant d'un instrument d'optique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mettre près",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette lunette <w>approche</w> les objets lointains."
                        },
                        {
                            "text": "Les jumelles <w>approchent</w> l'image du paysage de façon spectaculaire."
                        }
                    ],
                    "synonyms": [
                        "rapprocher"
                    ],
                    "antonyms": [
                        "éloigner"
                    ]
                }
            ]
        }
    ]
