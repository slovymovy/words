                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Irish usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mała, prymitywnie wykonana łódź.",
                        "zh": "一种小型、制作粗糙的船。"
