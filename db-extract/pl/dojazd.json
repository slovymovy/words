                                        "sense_id": "f4bdcacb-ec1c-3c9e-bb51-92337107f285",
                                        "entry_id": "30a37808-5a1b-3eb2-8e76-b695e5b097de",
                                        "glosses": [
                                            "travel between home and workplace"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5c7429-45af-4696-bd1a-dcb482b360c5",
                                                "sense_id": "f4bdcacb-ec1c-3c9e-bb51-92337107f285",
                                                "text": "The poet Geoffrey Grigson added an atmospheric 1950s gloss on these bizarre commutings [of seeds]: 'between Swindon and London you may see them often enough during the summer, the sunlight through the carriage window catching them as they float about in the thin smoke of cigarettes'."
                                            },
                                            {
                                                "example_id": "8e9c1ec0-ca78-4a2f-9650-98149dc51d5e",
                                                "sense_id": "f4bdcacb-ec1c-3c9e-bb51-92337107f285",
                                                "text": "It was cheaper to build both railways and suburbs to the south, and commuting - which Charles Pearson called 'oscillating' - began between the village of Greenwich and London Bridge. (The term 'commuting' is from America, and did not become established in Britain until the 1940s)."
                                            }
                                        ]
                                    },
