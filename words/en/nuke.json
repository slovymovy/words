                        {
                            "text": "The fleet included several <w>nukes</w> capable of staying underwater for months.",
                            "target_lang_translations": {
                                "ru": "В состав флота входило несколько <w>атомоходов</w>, способных оставаться под водой месяцами."
                            }
                        }
                    ],
                    "synonyms": [
                        "nuclear submarine"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "naval jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Судно (корабль или подводная лодка) с ядерной силовой установкой."
                    },
