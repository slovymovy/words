            "senses": [
                {
                    "sense_id": "f9c1b965-2f36-3290-b2c7-283d9899b694",
                    "sense_definition": "odnoszący się do drzewa oliwnego lub jego owocu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drzewo_owoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ogrodzie rosło stare drzewo <w>oliwne</w>, dające przyjemny chłód w upalny dzień.",
                            "target_lang_translations": {
                                "en": "An old <w>olive</w> tree grew in the garden, providing a pleasant cool on a hot day."
                            }
                        },
                        {
                            "text": "W Grecji widzieliśmy rozległy gaj <w>oliwny</w>, ciągnący się aż po horyzont.",
                            "target_lang_translations": {
                                "en": "In Greece, we saw a vast <w>olive</w> grove stretching all the way to the horizon."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gaj oliwny",
                        "drzewo oliwne",
                        "gałązka oliwna"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to the olive tree or its fruit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "olive",
                                "target_lang_sense_clarification": "tree or fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34043ded-e3f7-305f-a541-14e2b220e900",
                    "sense_definition": "odnoszący się do oliwy, zasilany nią lub przeznaczony do jej przechowywania",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oliwa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starożytnym pokoju paliła się mała lampka <w>oliwna</w>, dając ciepłe światło.",
                            "target_lang_translations": {
                                "en": "A small <w>oil</w> lamp burned in the ancient room, giving off a warm light."
                            }
                        },
                        {
                            "text": "Kupiliśmy ceramiczny dzbanuszek <w>oliwny</w> na lokalnym targu we Włoszech.",
                            "target_lang_translations": {
                                "en": "We bought a ceramic <w>olive oil</w> jug at a local market in Italy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lampka oliwna"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to olive oil, powered by it, or intended for holding it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oil",
                                "target_lang_sense_clarification": "e.g., oil lamp"
                            },
                            {
                                "target_lang_word": "olive-oil",
                                "target_lang_sense_clarification": "containing or used for olive oil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fbbe0f9-b5e6-3710-a1b3-c9a2a608885a",
                    "sense_definition": "mający odcień ciemnozielony z żółtawym lub szarym zabarwieniem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kolor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W auli zawieszono eleganckie <w>oliwne</w> kotary, które pasowały do jasnych ścian.",
                            "target_lang_translations": {
                                "en": "Elegant <w>olive-green</w> curtains were hung in the hall, matching the light-colored walls."
                            }
                        },
                        {
                            "text": "Żołnierz nosił mundur o barwie <w>oliwnej</w>, idealnie maskujący w leśnym terenie.",
                            "target_lang_translations": {
                                "en": "The soldier wore an <w>olive</w>-colored uniform that blended in perfectly with the woodland terrain."
                            }
                        }
                    ],
                    "synonyms": [
                        "oliwkowy"
                    ],
                    "common_phrases": [
                        "kolor oliwny"
                    ],
                    "target_lang_definitions": {
                        "en": "having a dark green colour with a yellowish or greyish tint"
                    },
                    "translations": {
