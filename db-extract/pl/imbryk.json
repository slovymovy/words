                    {
                        "translation_id": "8f47c87f-ffa0-4682-9d59-5192213eb077",
                        "source_entry_id": "41854882-350d-3b26-b7e8-8c38d6f17d7b",
                        "source_sense_id": "81f4db29-b025-3101-b14b-b4c4366cabf9",
                        "target_lang_word": "чайник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чайник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d64d869-183a-3b66-93cb-1718444cfa57",
                                        "entry_id": "145cf26e-80a0-3fbc-981e-fbf0cd7a7ba0",
                                        "glosses": [
                                            "предмет посуды; сосуд с носиком и ручкой, используемый для кипячения воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ef89a9-1391-4c86-ac11-45875286a38c",
                                                "sense_id": "0d64d869-183a-3b66-93cb-1718444cfa57",
                                                "text": "Чайник со свистком."
                                            },
                                            {
                                                "example_id": "44ae8462-ae8e-46bc-a1f9-b595f5aec9f9",
                                                "sense_id": "0d64d869-183a-3b66-93cb-1718444cfa57",
                                                "text": "Электрический чайник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354ba652-32ff-3eef-bf4d-3260eef39a52",
                                        "entry_id": "145cf26e-80a0-3fbc-981e-fbf0cd7a7ba0",
                                        "glosses": [
                                            "предмет посуды; керамический сосуд с носиком и ручкой, используемый для заваривания чая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e875c24-5eb0-49ff-b311-bfb89633c54b",
                                                "sense_id": "354ba652-32ff-3eef-bf4d-3260eef39a52",
                                                "text": "Смеркалось; на столе блистая // Шипел вечерний самовар, // Китайской чайник нагревая; // Под ним клубился легкой пар."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f19ca141-cbf6-38aa-aec6-37b2748fad94",
                                        "entry_id": "145cf26e-80a0-3fbc-981e-fbf0cd7a7ba0",
                                        "glosses": [
                                            "количество жидкости, равное объёму таких сосудов"
                                        ],
                                        "tags": [
                                            "чего."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d65d31d-5fe1-4dc4-aded-dc0e7883e089",
                                                "sense_id": "f19ca141-cbf6-38aa-aec6-37b2748fad94",
                                                "text": "Ресторан брал за фунт хлеба и чайник воды два рубля."
                                            },
                                            {
                                                "example_id": "daa1b4d3-1f19-47c8-b36e-ea10f574aebb",
                                                "sense_id": "f19ca141-cbf6-38aa-aec6-37b2748fad94",
                                                "text": "Она приносила кастрюлю манной каши и чайник кипятка .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чайник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                        "entry_id": "f853cbcb-bc6b-3920-888b-2a725c92402e",
                                        "glosses": [
                                            "перен., разг., шутл. неопытный человек; новичок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8a1e2b-aa94-484f-af3f-647da56a1ee2",
                                                "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                                "text": "Ему, похоже, стало немного стыдно, что брать опасного вора идут какие-то «чайники», да к тому же связанные обязательством не пугать честных граждан."
                                            },
                                            {
                                                "example_id": "38270000-edf3-42fd-87be-7c352eaab9dd",
                                                "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                                "text": "Чайниками курсантов называют потому, что они ещё не приняли присягу."
                                            },
                                            {
                                                "example_id": "b62fde2e-1323-4336-bbba-f70d65ff2473",
                                                "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                                "text": "Его, как и всякого профессионала — а уж в ветеринарной магии он был достойный ученик Тарараха, — раздражали советы «чайника»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
