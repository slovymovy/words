                ],
                "senses": [
                    {
                        "sense_id": "fdd5f410-c584-3d3d-8ff3-ad4d6c626a39",
                        "entry_id": "c6034a56-27e8-341e-9d3a-f876c19c3b88",
                        "glosses": [
                            "A person who objects to something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f447d4b5-0eb1-4965-8252-e5f024fb5a18",
                                "sense_id": "fdd5f410-c584-3d3d-8ff3-ad4d6c626a39",
                                "text": "\"It would be amusing, sir, to shut these various objectors up in a room and let them settle it among themselves.\""
                            },
                            {
                                "example_id": "b014c110-6f28-4530-985e-1b017c287039",
                                "sense_id": "fdd5f410-c584-3d3d-8ff3-ad4d6c626a39",
                                "text": "The Fife County Council, and other objectors, were successful in July [1950] in obtaining an interim interdict against this decision, but the Court of Session withdrew the interdict in January, and it was then stated that a civil court had no jurisdiction in the matter."
                            },
                            {
                                "example_id": "24323a36-0248-437b-957a-510b93ef2774",
                                "sense_id": "fdd5f410-c584-3d3d-8ff3-ad4d6c626a39",
                                "text": "But almost always such words are irreversibly established before the objectors learn of their existence, and the objections are hardly more than academic exercises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c37b778-4288-48cc-a448-5b1cbdc84872",
                        "source_entry_id": "c6034a56-27e8-341e-9d3a-f876c19c3b88",
