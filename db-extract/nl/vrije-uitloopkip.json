                            {
                                "example_id": "3937c93e-1417-43bb-b7aa-7e9c67b2de0a",
                                "sense_id": "ea8fcc6c-06d4-30d3-97cd-3ce761de4fef",
                                "text": "Piet’s kippen zijn vrije-uitloopkippen, waarvan mensen de eieren kopen omdat die kippen buiten vrij rond zouden hebben gescharreld. Nu bleven die kippen binnen in de stal, maar vreemd genoeg gingen de eieren toch nog gewoon als vrije-uitloopeieren de deur uit: \"Dat moet van de wet\", zegt Baars."
                            }
                        ]
                    }
