{
    "word_family": [
        "plopper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "afb9184b-f851-37eb-b9ea-d69cb52c54cf",
                    "sense_definition": "To make the sound of an object dropping into a body of liquid",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stone <w>plopped</w> into the pond with a soft splash.",
                            "target_lang_translations": {
                                "cs": "Kámen <w>žbluňkl</w> do rybníka s tichým šplouchnutím."
                            }
                        },
                        {
                            "text": "Watch the pebble as it <w>plopped</w> into the deep water.",
                            "target_lang_translations": {
                                "cs": "Sleduj ten kamínek, jak <w>žbluňkl</w> do hluboké vody."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydat zvuk jako předmět dopadající do kapaliny"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žbluňknout",
                                "target_lang_sense_clarification": "zvuk dopadu do vody"
                            },
                            {
                                "target_lang_word": "plesknout",
                                "target_lang_sense_clarification": "zvuk dopadu na hladinu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d2491ba-33e8-3780-83b0-00d113ec573f",
                    "sense_definition": "To land heavily or loosely",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>plopped</w> down on the sofa after a long day at work.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém dni v práci <w>žuchl</w> na pohovku."
                            }
                        },
                        {
                            "text": "She <w>plopped</w> her heavy bag onto the kitchen table.",
                            "target_lang_translations": {
                                "cs": "<w>Hodila</w> svou těžkou tašku na kuchyňský stůl."
                            }
                        }
                    ],
                    "synonyms": [
                        "drop",
                        "collapse"
                    ],
                    "common_phrases": [
                        "plop down"
                    ],
                    "target_lang_definitions": {
                        "cs": "Těžce nebo neopatrně dosednout či položit"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žuchnout",
                                "target_lang_sense_clarification": "těžce dosednout"
                            },
                            {
                                "target_lang_word": "hodit",
                                "target_lang_sense_clarification": "neopatrně položit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b2c3be3-7c45-346c-a7be-002d0bcba133",
                    "sense_definition": "To defecate",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>plopped</w> on the grass during our morning walk.",
                            "target_lang_translations": {
                                "cs": "Pes si během naší ranní procházky <w>vykonal potřebu</w> na trávě."
                            }
                        },
                        {
                            "text": "He had to <w>plop</w> quickly before the meeting started.",
                            "target_lang_translations": {
                                "cs": "Musel si rychle <w>odskočit</w>, než začala schůzka."
                            }
                        }
                    ],
                    "synonyms": [
                        "defecate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyměšovat (eufemismus)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vykonat potřebu",
                                "target_lang_sense_clarification": "eufemistické vyjádření"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "65dfbd3d-ffd6-36ea-b7bb-05cc4726e8ff",
                    "sense_definition": "A sound or action like liquid hitting a hard surface, or an object falling into a body of water",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the <w>plop</w> of a fish jumping in the lake.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem <w>žbluňknutí</w> ryby vyskakující z jezera."
                            }
                        },
                        {
                            "text": "The rain made a steady <w>plop</w> against the window pane.",
                            "target_lang_translations": {
                                "cs": "Déšť vydával o okenní tabuli pravidelné <w>pleskání</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "splash"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk nebo akce dopadu do kapaliny"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žbluňknutí",
                                "target_lang_sense_clarification": "zvuk dopadu do vody"
                            },
                            {
                                "target_lang_word": "plesknutí",
                                "target_lang_sense_clarification": "zvuk dopadu na hladinu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "290c896d-6153-3eb1-b41b-c9b637f414dc",
                    "sense_definition": "Excrement",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a small <w>plop</w> left on the sidewalk by the dog.",
                            "target_lang_translations": {
                                "cs": "Na chodníku po psovi zbyla malá <w>hromádka</w>."
                            }
                        },
                        {
                            "text": "He stepped in a <w>plop</w> while walking through the field.",
                            "target_lang_translations": {
                                "cs": "Při chůzi přes pole šlápl do <w>hromádky</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "feces",
                        "dung"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Výkaly (eufemismus)"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hromádka",
                                "target_lang_sense_clarification": "eufemistické označení pro exkrement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "51808f33-6718-336f-a64c-be85c3108270",
                    "sense_definition": "Indicating the sound of something plopping",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball hit the water with a loud <w>plop</w>.",
                            "target_lang_translations": {
                                "cs": "Míč dopadl do vody s hlasitým <w>žbluňk</w>."
                            }
                        },
                        {
                            "text": "He dropped the coin and it made a <w>plop</w> in the fountain.",
                            "target_lang_translations": {
                                "cs": "Upustil minci a ta ve fontáně udělala <w>žbluňk</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Citoslovce vyjadřující zvuk dopadu do vody"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žbluňk",
                                "target_lang_sense_clarification": "citoslovce dopadu"
                            }
                        ]
                    }
                }
            ]
        },
        {
