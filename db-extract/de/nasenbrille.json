                                        "sense_id": "dbbc98de-8fa0-3b1a-bc89-32f4d882c660",
                                        "entry_id": "22a48670-bcab-3a7c-b5af-1ed566936983",
                                        "glosses": [
                                            "A novelty pair of horn-rimmed glasses with attached eyebrows, plastic nose, and bushy mustache, caricaturing Groucho Marx."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644079dd-cf64-40e3-b189-2191fb3fb8c6",
                                                "sense_id": "dbbc98de-8fa0-3b1a-bc89-32f4d882c660",
                                                "text": "Vonnegut did not write the book, and the photo on the book jacket of Trout looked suspiciously like Farmer, wearing Boss Mule work gloves, beagle puss and mustache, sunglasses, mufflers, etc."
                                            },
                                            {
                                                "example_id": "0580ec5a-2716-4f5f-80b5-5e8d12013758",
                                                "sense_id": "dbbc98de-8fa0-3b1a-bc89-32f4d882c660",
                                                "text": "The punchline: a bewildered Ung wearing a beaglepuss and trying to type with a rubber chicken […]"
                                            },
                                            {
                                                "example_id": "18e874b7-f54d-4e8f-b14f-e31fb6fb6b84",
                                                "sense_id": "dbbc98de-8fa0-3b1a-bc89-32f4d882c660",
                                                "text": "Julian Assange personally reads every document to be published, types it up and formats it on his laptop while wearing a beaglepuss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
