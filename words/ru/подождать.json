                {
                    "sense_id": "6f3038f6-506a-3a91-aeed-0d86239eaa11",
                    "sense_definition": "Не начинать действовать сразу, отложить действие на некоторое время.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С принятием окончательного решения лучше <w>подождать</w>.",
                            "target_lang_translations": {
                                "en": "It is better to <w>wait</w> with the final decision.",
                                "nl": "Met het nemen van een definitief besluit kun je beter even <w>wachten</w>.",
                                "pl": "Z podjęciem ostatecznej decyzji lepiej <w>poczekać</w>.",
                                "de": "Mit der endgültigen Entscheidung sollte man besser <w>abwarten</w>.",
                                "fr": "Il vaut mieux <w>attendre</w> avant de prendre une décision finale.",
                                "it": "È meglio <w>aspettare</w> prima di prendere una decisione definitiva.",
                                "cs": "S přijetím konečného rozhodnutí je lepší <w>počkat</w>.",
                                "tr": "Nihai kararı vermeden önce <w>beklemek</w> daha iyi.",
                                "es": "Es mejor <w>esperar</w> para tomar la decisión final.",
                                "zh": "做出最终决定前最好<w>等一等</w>。"
                            }
                        },
                        {
                            "text": "Не торопись отправлять письмо, стоит <w>подождать</w> до утра.",
                            "target_lang_translations": {
                                "en": "Don't rush to send the letter, it is worth <w>waiting</w> until morning.",
                                "nl": "Haast je niet om de brief te versturen, het is beter om tot de ochtend te <w>wachten</w>.",
                                "pl": "Nie spiesz się z wysłaniem listu, warto <w>poczekać</w> do rana.",
                                "de": "Beeil dich nicht mit dem Abschicken des Briefes, es lohnt sich, bis morgen früh zu <w>warten</w>.",
                                "fr": "Ne te presse pas d'envoyer la lettre, il vaut mieux <w>attendre</w> jusqu'à demain matin.",
                                "it": "Non avere fretta di inviare la lettera, vale la pena <w>aspettare</w> fino al mattino.",
                                "cs": "Nespěchej s odesláním dopisu, stojí za to <w>počkat</w> do rána.",
                                "tr": "Mektubu göndermek için acele etme, sabaha kadar <w>beklemeye</w> değer.",
                                "es": "No te apresures a enviar la carta, vale la pena <w>esperar</w> hasta la mañana.",
                                "zh": "别急着发邮件，最好<w>暂缓</w>到明天早上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "повременить",
                        "погодить"
                    ],
                    "antonyms": [
