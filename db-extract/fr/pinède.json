                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029e7e65-e13b-4d41-8559-ce2ee470f95c",
                                                "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                                "text": "Это был частый сосняк, росший на песчаном грунте."
                                            },
                                            {
                                                "example_id": "1fe9c0f8-4382-4fdc-b477-8a90f3587746",
                                                "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                                "text": "Вспоминался из детства темный с просинью сосняк, дорога и на ней яркая-яркая красная рубаха: ехал мужик верхом на лошади."
                                            },
                                            {
                                                "example_id": "39be42e4-ab15-435c-9a6c-0ac797114a78",
                                                "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                                "text": "Там, в кедрачах, вот уже второй месяц работал передвижной лесопункт, вырубающий мачтовый сосняк и кедры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a14d55c-4519-3419-98d5-595882b78f28",
                                        "entry_id": "a78ff0a1-e602-37e4-8f39-5ea9e1c892fd",
                                        "glosses": [
                                            "сосновые брёвна, доски"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa109e14-0007-4f18-af05-3e46a0248667",
                                                "sense_id": "7a14d55c-4519-3419-98d5-595882b78f28",
                                                "text": "Приходят по весне какие-то люди, валят сосняк поровней, ошкуривают…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
