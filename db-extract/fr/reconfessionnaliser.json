                "senses": [
                    {
                        "sense_id": "4b759043-b047-316f-a5ba-f42b5ededfce",
                        "entry_id": "12adec77-4295-35d2-9843-a5d1c62a2a2a",
                        "glosses": [
                            "Confessionnaliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406e21d1-7e04-4aab-879a-c33e54d15ce5",
                                "sense_id": "4b759043-b047-316f-a5ba-f42b5ededfce",
                                "text": "Le discours théologique tendra à se reconfessionnaliser lorsqu'il cherchera moins à renouveler la tradition qu'à la préserver de toute dissolution culturelle."
                            },
                            {
                                "example_id": "d1b62905-f29e-4bdb-a7a8-972048bcbaf4",
                                "sense_id": "4b759043-b047-316f-a5ba-f42b5ededfce",
                                "text": "Cette fidélité au Devoir de Mémoire n'est pas partagée par les autorités hospitalières de Perpignan, son pays natal, qui ont choisi pour ce 90e anniversaire de reconfessionnaliser le Centre hospitalier Maréchal Joffre en Centre hospitalier St-Jean."
                            }
                        ]
                    }
