                        "entry_id": "4126aa95-d1e8-30a9-86df-b47d7532b2a6",
                        "glosses": [
                            "Élément ordinal, correspondant au cardinal vingt-cinq. L’élément placé au rang dont le numéro est vingt-cinq (25)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc68f96e-9f38-4f34-a12c-6b029ede8006",
                                "sense_id": "ecdac1c3-ba39-365a-ba91-4f6f982c2ea6",
                                "text": "Le vingt-cinquième précède le vingt-sixième et suit le vingt-quatrième."
                            }
                        ]
                    },
                    {
                        "sense_id": "c51c13c2-ca8e-3b86-9cb4-8df2c44b1d47",
                        "entry_id": "4126aa95-d1e8-30a9-86df-b47d7532b2a6",
                        "glosses": [
                            "Fraction obtenue en divisant vingt-cinq fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb75d6d2-b471-474c-a8bf-bf4e94393560",
                                "sense_id": "c51c13c2-ca8e-3b86-9cb4-8df2c44b1d47",
                                "text": "Donnez-moi le vingt-cinquième de ce gâteau."
                            }
                        ]
                    }
