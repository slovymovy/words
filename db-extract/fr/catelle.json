                        "entry_id": "631edb91-9e13-3c68-b534-e5f68987fdb8",
                        "glosses": [
                            "Carreau de céramique, brique vernissée, utilisé comme revêtement de mur."
                        ],
                        "tags": [
                            "Suisse",
                            "Savoie"
                        ],
                        "examples": [
                            {
                                "example_id": "a04a1b4a-285f-491d-a0b5-5450409a9304",
                                "sense_id": "5671785c-6994-3a36-8900-0eb5aaa4f26e",
                                "text": "J’allonge un pourboire et emprunte un couloir aux catelles tenues par du Scotch."
                            },
                            {
                                "example_id": "a467fe60-369e-4180-8730-bdcc215c63f8",
                                "sense_id": "5671785c-6994-3a36-8900-0eb5aaa4f26e",
                                "text": "Il me reste encore 32 catelles à poser dans la cuisine avant ce soir."
                            },
                            {
                                "example_id": "4bdd7543-cd4a-4f46-8dc0-aa66fcfb7759",
                                "sense_id": "5671785c-6994-3a36-8900-0eb5aaa4f26e",
                                "text": "Un fourneau, un poêle de catelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b3a65dc-bfc4-3902-8930-bd9db5bd9b6a",
                        "entry_id": "631edb91-9e13-3c68-b534-e5f68987fdb8",
                        "glosses": [
                            "Poulie et corde dont on se sert dans les granges pour élever les gerbes qu’on place sur le soli."
                        ],
                        "tags": [
                            "Arpitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "999818c5-d895-493f-adf8-66535860490e",
                                "sense_id": "7b3a65dc-bfc4-3902-8930-bd9db5bd9b6a",
                                "text": "Celui qui est en bas jette alors les cordes par dessus la «charge», l’autre s’agenouille et passe les cordes dans les «catelles», puis se lève pour tirer […]."
                            }
                        ]
                    }
