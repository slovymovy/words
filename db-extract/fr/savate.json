        "fr-extract.jsonl": [
            {
                "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                "word": "savate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf5c0c7f-7319-4258-9ee1-95be6bf81ef5",
                        "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "tags": [
                            "plural"
                        ],
                        "form": "savates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bad0a9d-a82e-3340-ae5a-5f0f28592d91",
                        "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "glosses": [
                            "Vieille pantoufle, vieux soulier très usé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a4a82b-9eac-4aa3-98e6-0ad107ad4378",
                                "sense_id": "5bad0a9d-a82e-3340-ae5a-5f0f28592d91",
                                "text": "Le nom de famille de ce fonctionnaire était Savatkine. Déjà au nom on voit qu’il a été formé, jadis, d’une savate ; mais quand, à quelle époque et de quelle façon est-il venu, de cette savate, cela, personne n’en savait rien."
                            },
                            {
                                "example_id": "9cb7bc8d-6d72-4af5-bf70-1285efba4767",
                                "sense_id": "5bad0a9d-a82e-3340-ae5a-5f0f28592d91",
                                "text": "Elle avait les pieds nus dans des savates et Émilienne remarqua que ces pieds étaient sales, comme la maison où tout était en désordre."
                            },
                            {
                                "example_id": "9b55234a-56ef-49f1-b370-cb3f49ebf9b5",
                                "sense_id": "5bad0a9d-a82e-3340-ae5a-5f0f28592d91",
                                "text": "Traîner la savate."
                            },
                            {
                                "example_id": "111a7124-a1ea-4674-898a-5a091f801e36",
                                "sense_id": "5bad0a9d-a82e-3340-ae5a-5f0f28592d91",
                                "text": "Les traîneurs de savates à teint bronzé et longue chemise de nuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffc256cb-974d-32a6-9c9f-44da4d06534e",
                        "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "glosses": [
                            "Sport de combat où le pied joue le principal rôle."
                        ],
                        "tags": [
                            "Savate"
                        ],
                        "examples": [
                            {
                                "example_id": "becfd286-ca22-4e91-9014-f87f576eedc5",
                                "sense_id": "ffc256cb-974d-32a6-9c9f-44da4d06534e",
                                "text": "Gaby Irvoas confiait il y a quelques jours : « Cette saison s'est fort bien terminée pour nos jeunes savateuses et savateurs. Depuis plusieurs années, l'école de savate de la MJC présente des compétiteurs et compétitrices jusqu'en finale du championnat de France."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1ee861a-cd98-36ff-926c-53859814729f",
                        "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "glosses": [
                            "Réglisse en gros bâton."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f85baeb7-91eb-3af2-9188-5c992c8414ad",
                        "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "glosses": [
                            "Tongs, dites savates deux doigts."
                        ],
                        "tags": [
                            "La Réunion"
                        ],
                        "examples": [
                            {
                                "example_id": "fb296cd1-a502-4d6b-a158-c92c0dd86625",
                                "sense_id": "f85baeb7-91eb-3af2-9188-5c992c8414ad",
                                "text": "Sa mère n’attendit pas la suite. Elle disparut dans la cuisine. Lentement. Traînant tristement ses vieilles savates sur le carrelage en damier noir et blanc."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1e32fe5-064c-3990-b94a-f9659a3e79ce",
                        "entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "glosses": [
                            "Pièce de bois solidaire au navire, que l'on place en dessous pour permettre de glisser lors de la mise à l'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "723a0412-3d97-4701-84ef-4ae442545af6",
                                "sense_id": "b1e32fe5-064c-3990-b94a-f9659a3e79ce",
                                "text": "La savate ou bordage de 5 à 6 centimètres d'épaisseur , garantit le frottement du doublage de la fausse quille contre les traverses et la coulisse , à la mise à l'eau ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8be6596f-5b49-4f13-bbdc-900ca94ae981",
                        "source_entry_id": "7696a3cd-97e6-38cd-8ee5-11adb341f64b",
                        "source_sense_description": "Vieille chaussure",
                        "target_lang_word": "отопок",
