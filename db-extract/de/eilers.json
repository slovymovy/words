                ],
                "senses": [
                    {
                        "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                        "entry_id": "4c3b1df6-3f95-3b4d-816d-9c37d7427aba",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b2521d-8780-486d-a2e7-f5115d3f474d",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Frau Eilers ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4658c2dd-7d2b-4fd2-830e-00db47336e6e",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Herr Eilers wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4eed18fa-00a8-479d-b4c1-f170cd7fa4d8",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Die Eilers kommen heute aus dem Emsland."
                            },
                            {
                                "example_id": "cf3b512d-5350-4125-8ff7-84779799965f",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Der Eilers trägt nie die Schals, die die Eilers ihm strickt."
                            },
                            {
                                "example_id": "efc47ee0-ae05-4498-a9af-9a6b801c8743",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eilers kommt, geht der Herr Eilers.“"
                            },
                            {
                                "example_id": "a673c352-3e60-4961-9cb6-9061378334c0",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Eilers kommt und geht."
                            },
                            {
                                "example_id": "db7b161b-1722-4d43-9481-a3405a9d2554",
                                "sense_id": "8d1bf93e-7af5-3452-9111-4a1b98c5614c",
                                "text": "Eilersens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
