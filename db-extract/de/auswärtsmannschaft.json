                "senses": [
                    {
                        "sense_id": "215956d0-0255-3912-be69-a212e9a79632",
                        "entry_id": "d369e492-a5e8-3730-b628-5dd8b51f6269",
                        "glosses": [
                            "Mannschaft, die für ein Spiel zu Gast im Stadion oder Spielstätte der gegnerischen Mannschaft ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40bf457e-432f-4236-b3ae-b91f4b4aea1a",
                                "sense_id": "215956d0-0255-3912-be69-a212e9a79632",
                                "text": "In den USA wird in Einzelspielen die Auswärtsmannschaft zuerst genannt."
                            },
                            {
                                "example_id": "bf7f1a42-bdfd-4dc6-9ebe-008c1ec26a4d",
                                "sense_id": "215956d0-0255-3912-be69-a212e9a79632",
                                "text": "Die Auswärtsmannschaft wird einen Tag vor dem Match anreisen, um sich einzugewöhnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7dee9ab-5d32-4764-a2ea-01216b8304ea",
                        "source_entry_id": "d369e492-a5e8-3730-b628-5dd8b51f6269",
                        "source_sense_id": "215956d0-0255-3912-be69-a212e9a79632",
                        "source_sense_description": "Mannschaft, die für ein Spiel zu Gast im Stadion oder Spielstätte der gegnerischen Mannschaft ist",
                        "target_lang_word": "away team",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "away team",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7708e0a6-a6be-3374-b61a-156d0eef50f1",
                                        "entry_id": "8518ff76-d8e4-38f7-89c2-e819d08728be",
                                        "glosses": [
                                            "The visiting team; the team that is playing away from home."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729efe98-75a5-496c-b27c-2a13509fea33",
                                                "sense_id": "7708e0a6-a6be-3374-b61a-156d0eef50f1",
                                                "text": "Comparisons were made between the home and away team's number of fouls and violations."
                                            },
                                            {
                                                "example_id": "9ad4b659-0e35-402e-89eb-7ee5e9aa102d",
                                                "sense_id": "7708e0a6-a6be-3374-b61a-156d0eef50f1",
                                                "text": "During this analysis, it became apparent that the home team seemed to be receiving proportionately greater generosity from the referee than the away team."
                                            },
                                            {
                                                "example_id": "27e5b270-e098-4b68-b21b-e9d49dfaa5bd",
                                                "sense_id": "7708e0a6-a6be-3374-b61a-156d0eef50f1",
                                                "text": "They also echo Jennett (1984), in using a variable measuring away team market size."
                                            },
                                            {
                                                "example_id": "2bc44ed9-daa9-4d05-b68d-33a53d77d5ad",
                                                "sense_id": "7708e0a6-a6be-3374-b61a-156d0eef50f1",
                                                "text": "In 56 games, the home team was favored and the away team won."
                                            },
                                            {
                                                "example_id": "452d8132-903b-477d-8eeb-f5c339e13b42",
                                                "sense_id": "7708e0a6-a6be-3374-b61a-156d0eef50f1",
                                                "text": "He found no differences between home and away team performances when spectators cheered before the start of a play."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b37f1b37-c8c1-458d-90fc-1e7194fedb47",
                        "source_entry_id": "d369e492-a5e8-3730-b628-5dd8b51f6269",
                        "source_sense_id": "215956d0-0255-3912-be69-a212e9a79632",
