                    {
                        "translation_id": "18a81e73-8915-4f90-a9c6-b52dbbcdc5ac",
                        "source_entry_id": "79ef37e0-75d4-390a-918f-d97ec840741a",
                        "source_sense_id": "145a2e90-765d-3c65-a2e3-1cf8ee7d5e61",
                        "source_sense_description": "Medizin: Spezialist auf dem Gebiet der Virologie",
                        "target_lang_word": "viroloog",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viroloog",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9508a821-a34e-31e2-be28-9f7a0fbe44be",
                                        "entry_id": "61c21210-163a-38e5-ab81-f56d23e8482f",
                                        "glosses": [
                                            "deskundige op het gebied van virussen en virusziekten"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c342d221-3bbd-47b3-9ba4-1c2bdbef9d5f",
                                                "sense_id": "9508a821-a34e-31e2-be28-9f7a0fbe44be",
                                                "text": "'Ministers, leg dit eens uit?' Met die pertinente vraag deelt viroloog Marc Van Ranst op Facebook een document van het Duitse voedselagentschap waaruit blijkt dat het eind juli al op de hoogte was van fipronil in Belgische eieren."
                                            },
                                            {
                                                "example_id": "541e1b22-08ca-4227-b3c2-00061f465672",
                                                "sense_id": "9508a821-a34e-31e2-be28-9f7a0fbe44be",
                                                "text": "Alle leerkrachten zouden zich vanaf volgend jaar moeten laten inenten tegen de griep. Daarvoor pleit de Nederlandse viroloog en influenza-expert, prof. dr. Ab Osterhaus, meldt De Telegraaf."
                                            },
                                            {
                                                "example_id": "84b50164-af9a-4255-b2aa-bd5e8feec5e3",
                                                "sense_id": "9508a821-a34e-31e2-be28-9f7a0fbe44be",
                                                "text": "De Volkskrant kreeg exclusief inzage in de uitgebreide databank van ICIJ. Volgens het dagblad staan in de databank van het ICIJ-collectief, die de periode van 2012 tot 2018 bestrijkt, ongeveer driehonderd artikelen van zeker 750 Nederlandse wetenschappers die bij Omics publiceerden. Onder hen zijn ook bekende wetenschappers, zoals farmaceut Jaap Goudsmit en viroloog Ab Osterhaus, vaak als laatste auteur in artikelen van medewerkers of promovendi."
                                            },
                                            {
                                                "example_id": "d0f61ae8-c008-4c46-8758-c96ca96d00bf",
                                                "sense_id": "9508a821-a34e-31e2-be28-9f7a0fbe44be",
                                                "text": "Minister Kuipers van Volksgezondheid roept de sectoren in de samenleving op zich voor te bereiden op een nieuwe golf coronabesmettingen in het najaar. \"Maak je eigen plan\", zegt hij in een gesprek met NOS. Hij reageert daarmee op de kritiek die ziekenhuisdirecteuren, virologen en wetenschappers vanmorgen uitten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
