                                    {
                                        "sense_id": "577ff517-befb-3ed1-b8af-f60e1aadb248",
                                        "entry_id": "d2e23a51-eb01-3adc-bb10-babeaf3a9797",
                                        "glosses": [
                                            "tuin met voornamelijk rozen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13e6cda-6973-462b-b363-d69760092d55",
                                                "sense_id": "577ff517-befb-3ed1-b8af-f60e1aadb248",
                                                "text": "Ze lopen aandoenlijk hand in hand door de Rozentuin van het Witte Huis. Al snel leert May echter dat je met vrienden als Trump geen vijanden nodig hebt."
                                            },
                                            {
                                                "example_id": "21638c15-d1e3-428c-837e-d92eca7834b7",
                                                "sense_id": "577ff517-befb-3ed1-b8af-f60e1aadb248",
                                                "text": "Volgend jaar, tijdens het 140-jarig jubileum van het merk pakken ze groots uit. Dan wordt de beroemde rozentuin van Chateau Mailmaison heropend. Het horloge en juwelenmerk heeft de befaamde rozentuin geadopteerd en is deze aan het herstellen."
                                            },
                                            {
                                                "example_id": "bb1f59b7-622e-462e-8283-2fc8fd77d9f3",
                                                "sense_id": "577ff517-befb-3ed1-b8af-f60e1aadb248",
                                                "text": "Terwijl ik goedkeurend met mijn vinger langs de vergulde lambrisering streek, de dikte voelde van de stof van de zware, oker overgordijnen en de stoel wegschoof om de openslaande deuren te openen naar het terras, dat uitzicht bood op de rozentuin, of wat daarvan over was, en de vijver met de defecte fontein, bedacht ik dat ik nog tijd genoeg zou hebben om deze kamer en detail te beschrijven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5cce9e7-42d0-4748-a914-0149852534d8",
                        "source_entry_id": "d25f731c-917a-3ebd-a689-34506bd83f8b",
                        "source_sense_id": "e6c188f2-d11b-32ee-9288-35b1a82f4ced",
