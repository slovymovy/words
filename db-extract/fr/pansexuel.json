                "entry_id": "cc1a386f-d148-3253-9a28-4656e9dd7d02",
                "word": "pansexuel",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "90564c9a-ec66-4b23-85c6-fbb6ded0868a",
                        "entry_id": "cc1a386f-d148-3253-9a28-4656e9dd7d02",
                        "tags": [
