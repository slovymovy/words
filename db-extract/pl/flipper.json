                            {
                                "example_id": "739539b2-3cd3-4d4c-b877-06084d5d828d",
                                "sense_id": "4db76e3b-2839-3f01-b3fd-302fa49afc47",
                                "text": "Na wagary często uciekaliśmy na flippery."
