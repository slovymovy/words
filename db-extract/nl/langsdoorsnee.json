                        "glosses": [
                            "weergave van het snijvlak als je iets in de lengte in tweeën zou delen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec587c7d-f459-4ef5-bdff-0c214533ce9c",
                                "sense_id": "435853ef-8573-398c-a2e4-96b97103c6fd",
                                "text": "De langsdoorsneden en de opstanden van de vier gevels maken het mogelijk om zich een beeld te vormen van de tijdens de twee restauratiecampagnes getransformeerde en gerestaureerde ruimten."
                            },
                            {
                                "example_id": "b888825b-c92b-46d6-9634-1ff65046b323",
                                "sense_id": "435853ef-8573-398c-a2e4-96b97103c6fd",
                                "text": "Naast de hydrograaf zijn ook de waterhoogtes op langsdoorsnedes gevraagd."
                            },
                            {
                                "example_id": "e1892a39-f51a-4e66-8ad1-933dd52cc7f2",
                                "sense_id": "435853ef-8573-398c-a2e4-96b97103c6fd",
                                "text": "Fig. 54 toont de langsdoorsnee van de twee eerste traveeën van dit koor en fig. 55 het grondplan dezer beide traveeën."
                            }
                        ]
