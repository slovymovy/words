                    {
                        "translation_id": "00cca97a-f7bc-499d-a5f3-182ee8e4a44f",
                        "source_entry_id": "753aeceb-63f1-341d-977e-e14b25ee1d93",
                        "source_sense_id": "f5121c5f-6a9f-30ae-beaa-a4e2d37791c1",
