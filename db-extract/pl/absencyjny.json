                                                "sense_id": "7f08a9c0-45d6-321f-aa46-3df75b7bcdbd",
                                                "text": "Er war epileptisch und seine Absenzen waren sehr häufig."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7a495d81-107d-3b83-90b9-f13e6694be5c",
