                        "tags": [
                            "metaphorisch"
                        ],
                        "examples": [
                            {
                                "example_id": "4b1cadbc-5126-412a-8b09-fa27eb392138",
                                "sense_id": "43d401b2-cce3-32e0-a647-0fcbba16bc53",
                                "text": "„In der Schweiz ist in den vergangenen Jahren die Einkommensschere nicht weiter aufgegangen.“"
                            },
                            {
                                "example_id": "8b5455c5-96a1-4d11-b0bc-0c3f4dd1f617",
                                "sense_id": "43d401b2-cce3-32e0-a647-0fcbba16bc53",
                                "text": "„In der Ayub-Ära öffnete sich die Einkommensschere zwischen den urbanen Eliten als den Hauptnutznießern der Wirtschaftspolitik und der einfachen Bevölkerung, die unter den steigenden Lebenshaltungskosten litt, in eklatanter Weise.“"
                            }
                        ],
