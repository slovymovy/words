                "senses": [
                    {
                        "sense_id": "fe865fcc-bdef-354e-be79-40410d5c2ddd",
                        "entry_id": "3d92e5ea-202f-3d3b-a90b-3ef408cd1cef",
                        "glosses": [
                            "festgelegte Ordnung, die vom Parlament, der Regierung oder einer sonstigen Behörde eines (deutschen oder österreichischen) Bundeslandes erlassen wurde und für dieses Bundesland gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d777051-8208-4248-8ec9-c74369e35ebb",
                                "sense_id": "fe865fcc-bdef-354e-be79-40410d5c2ddd",
                                "text": "„Nach baden-württembergischen Landesrecht kann es beispielsweise genügen, wenn ein Arzt die Fixierung anordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac9674d7-ad93-3cb9-b8e8-a8337fe9bf45",
                        "entry_id": "3d92e5ea-202f-3d3b-a90b-3ef408cd1cef",
                        "glosses": [
                            "festgelegte Ordnung, die vom Parlament, der Regierung oder einer sonstigen Behörde der Schweizerischen Eidgenossenschaft erlassen wurde und für die gesamte Schweiz gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa9e481-2e5f-4bb6-9750-075bc7e04d81",
                                "sense_id": "ac9674d7-ad93-3cb9-b8e8-a8337fe9bf45",
                                "text": "„Landesrecht“ gemäß der Systematischen Rechtssammlung der Schweizer Regierung, im Gegensatz zum internationalen Recht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
