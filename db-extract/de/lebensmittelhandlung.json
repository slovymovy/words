                "senses": [
                    {
                        "sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                        "entry_id": "a3fc0ac2-326a-3f7a-babe-6739b9605063",
                        "glosses": [
                            "ein Geschäft, in dem hauptsächlich Lebensmittel verkauft werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5779fb2b-ed84-4841-9a98-3889ca3cadd3",
                                "sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                                "text": "„Ein bekanntestes Markenzeichen der Lebensmittelhandlung der Familie Schreiber am Markt, im sogenannten Schreiberschen Haus, war der selbst gebrannte Weinbrand.“"
                            },
                            {
                                "example_id": "339fbcb0-d79b-4f82-8981-8d18aefe9d1d",
                                "sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                                "text": "„Der Betreiber einer Lebensmittelhandlung ging in Konkurs.“"
                            },
                            {
                                "example_id": "f57bcf10-cd3d-4408-b33a-13c4ea47c389",
                                "sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                                "text": "„Im Prozess gegen die beiden Geschäftsführer der Frankfurter koscheren Lebensmittelhandlung »Aviv«, denen vorgeworfen wird, herkömmliches Fleisch als koscher etikettiert und verkauft zu haben, war der 65-Jährige als Sachverständiger geladen.“"
                            },
                            {
                                "example_id": "82c1aa50-3c61-4d68-914b-bf4b9ce62372",
                                "sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                                "text": "„Der Gemeinderat beschließt einstimmig, für die Lebensmittelhandlung Höpperger eine Nahversorgungsförderung in der Höhe von 10 % des Landesförderbetrages, höchstens € 1.000,00, zu gewähren.“"
                            },
                            {
                                "example_id": "be316d4c-1220-40d5-8632-9b003c9bd74d",
                                "sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                                "text": "„Ab dem 10. Februar 1966 wurde das Geschäft als Lebensmittelhandlung von Frau Aurelia Boldischar weitergeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a1a74dc-d21c-4aeb-8de4-dad0e85fcdc3",
                        "source_entry_id": "a3fc0ac2-326a-3f7a-babe-6739b9605063",
                        "source_sense_id": "9f793913-58bc-3792-a1c4-470d35184534",
                        "source_sense_description": "ein Geschäft, in dem hauptsächlich Lebensmittel verkauft werden",
                        "target_lang_word": "grocery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grocery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "065c4ee6-58e4-3069-9d4e-bc30a0e76c40",
                                        "entry_id": "490cbb9b-50df-3262-b7d7-e7f7bc21ce0c",
                                        "glosses": [
                                            "Retail foodstuffs and other household supplies."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "083ed479-862e-4fbe-9a7f-436b97386337",
                                                "sense_id": "065c4ee6-58e4-3069-9d4e-bc30a0e76c40",
                                                "text": "1776: Adam Smith, The Wealth of Nations\nWhere ten thousand pounds can be employed in the grocery trade, the wages of the grocer's labour make but a very trifling addition..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91aafea6-4751-3bf9-9404-ec53a0e9f09e",
                                        "entry_id": "490cbb9b-50df-3262-b7d7-e7f7bc21ce0c",
                                        "glosses": [
                                            "A shop or store that sells groceries; a grocery store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a5db64-9e34-46d0-82ab-00f64cad4f03",
                                                "sense_id": "91aafea6-4751-3bf9-9404-ec53a0e9f09e",
                                                "text": "1854: Henry David Thoreau, Walden\nI observed that the vitals of the village were the grocery, the bar-room, the post-office, and the bank..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grocery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45543a88-755d-3855-b20e-fe4105425f4b",
                                        "entry_id": "20824f32-f0a9-334e-a3b0-949c8143795f",
                                        "glosses": [
                                            "To go grocery shopping."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "152f8d34-21c9-462d-8b98-f532825a4bb2",
                                                "sense_id": "45543a88-755d-3855-b20e-fe4105425f4b",
                                                "text": "We shopped and groceried on a cash basis, determined on that from the start."
                                            },
                                            {
                                                "example_id": "02bb4d89-c5cd-41ff-bf49-ec1a639d33a9",
                                                "sense_id": "45543a88-755d-3855-b20e-fe4105425f4b",
                                                "text": "The thought of grocerying so casually at Seessel's evokes a giggle from Shirley"
                                            },
                                            {
                                                "example_id": "2a518bf3-89b4-4265-b435-78a796fd6d65",
                                                "sense_id": "45543a88-755d-3855-b20e-fe4105425f4b",
                                                "text": "I was dependent upon others for grocerying and getting to doctor appointments."
                                            },
                                            {
                                                "example_id": "b61ee826-791c-4cb1-918f-d17b5a50f493",
                                                "sense_id": "45543a88-755d-3855-b20e-fe4105425f4b",
                                                "text": "Sample usage: \"If you're going grocerying, pick up some GMO — you know, Goat's Milk, Organic. But it has to be non-GMO GMO.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68825f90-3c13-313b-a52f-54f8aa934f23",
                                        "entry_id": "20824f32-f0a9-334e-a3b0-949c8143795f",
                                        "glosses": [
                                            "To furnish with groceries."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a595e622-c917-4626-9618-d88057c1155c",
                                                "sense_id": "68825f90-3c13-313b-a52f-54f8aa934f23",
                                                "text": "Fifty-eight years of grocerying hotels, restaurants and institutions that feed many people"
                                            },
                                            {
                                                "example_id": "07571bf7-0b24-48be-a436-8738774c2e8c",
                                                "sense_id": "68825f90-3c13-313b-a52f-54f8aa934f23",
                                                "text": "What freedom to be iced, fueled, and groceried for two weeks and running toward a reef you truly love"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa6233a6-84df-40ad-b9dd-03fab86bfcdc",
