                {
                    "sense_id": "f15aa0d3-2b62-3a69-93bf-01623c13f3bd",
                    "sense_definition": "Caractère de ce qui est mince, délié ou composé d'éléments minuscules.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>finesse</w> de ce fil de soie permet de tisser des vêtements très doux.",
                            "target_lang_translations": {
                                "en": "The <w>fineness</w> of this silk thread makes it possible to weave very soft garments.",
                                "ru": "<w>Тонкость</w> этой шёлковой нити позволяет ткать очень мягкую одежду.",
                                "de": "Die <w>Feinheit</w> dieses Seidenfadens ermöglicht es, sehr weiche Kleidungsstücke zu weben.",
                                "es": "La <w>finura</w> de este hilo de seda permite tejer prendas muy suaves.",
                                "zh": "这种蚕丝线的<w>细度</w>极高，能织出非常柔软的衣物。"
                            }
                        },
                        {
                            "text": "La <w>finesse</w> du sable de cette plage le rend doux comme de la farine.",
                            "target_lang_translations": {
                                "en": "The <w>fineness</w> of this beach's sand makes it as soft as flour.",
                                "ru": "<w>Мелкость</w> песка на этом пляже делает его мягким, как мука.",
                                "de": "Die <w>Feinkörnigkeit</w> des Sandes an diesem Strand macht ihn so weich wie Mehl.",
                                "es": "La <w>finura</w> de la arena de esta playa la vuelve suave como la harina.",
                                "zh": "这片海滩的沙子<w>粒度</w>很细，摸起来柔软得像面粉。"
                            }
                        }
