                        "glosses": [
                            "хим. способность одного и того же вещества кристаллизоваться в различных формах"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "105f6f4d-428a-3834-b1b3-a0d7e0fc2862",
                        "entry_id": "51e9a4e7-5e8e-3bdb-bf09-d0ca8446604f",
