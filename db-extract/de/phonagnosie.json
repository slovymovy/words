                "senses": [
                    {
                        "sense_id": "96db25cc-e0e6-3764-8fbc-c22d4cd1aa44",
                        "entry_id": "b7b9e1c1-6457-37da-9193-b34e67b9647a",
                        "glosses": [
                            "die Unfähigkeit, die Identität von Personen anhand ihrer Stimme zu erkennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25b8c36-8b8d-47d9-b9ed-b4ee8da035d7",
                                "sense_id": "96db25cc-e0e6-3764-8fbc-c22d4cd1aa44",
                                "text": "Das Phänomen der Phonagnosie ist noch nicht wirklich erforscht."
                            },
                            {
                                "example_id": "e55af64c-cde8-46cd-9905-5d4781139b50",
                                "sense_id": "96db25cc-e0e6-3764-8fbc-c22d4cd1aa44",
                                "text": "„Die Phonagnosie […] ist eine selektive auditive Agnosie für das Erkennen von Stimmen.“"
                            },
                            {
                                "example_id": "c427fde0-ccf6-4714-9fff-9a8206e65fb3",
                                "sense_id": "96db25cc-e0e6-3764-8fbc-c22d4cd1aa44",
                                "text": "„Weitere Defizite, deren Beziehungen zu den genannten klassischen neuropsychologischen Syndromen noch nicht hinreichend geklärt ist, sind die Phonagnosie und die auditive Affektagnosie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
