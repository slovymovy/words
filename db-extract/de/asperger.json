                        ],
                        "form": "dem Asperger"
                    },
                    {
                        "form_id": "4bf0c178-5fbd-4a21-b311-5f25d39c0060",
                        "entry_id": "74096816-d491-309e-ba6c-00ec092a5006",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Asperger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "730d0f6d-27cb-31f2-9875-83b48508ad38",
                        "entry_id": "74096816-d491-309e-ba6c-00ec092a5006",
                        "glosses": [
                            "Kurzform für das Asperger-Syndrom, einer speziellen, eher milden Form des Autismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e148faea-63d2-4ce0-9bf1-47be9ed29692",
                                "sense_id": "730d0f6d-27cb-31f2-9875-83b48508ad38",
                                "text": "„London (AFP) Die schottische Sängerin Susan Boyle, die durch eine Talentshow über Nacht zum Star geworden ist, leidet nach eigenen Angaben unter dem Asperger-Syndrom, einer Form von Autismus. Nachdem sie jahrelang wegen ihrer Lernschwäche gehänselt worden sei, habe sie vor einem Jahr endlich die Diagnose Asperger bekommen, sagte Boyle in einem am Sonntag veröffentlichten Interview mit der britischen Zeitung ‚The Observer‘. Als Kind sei ihr hingegen gesagt worden, sie habe einen Hirnschaden.“"
                            },
                            {
                                "example_id": "0f767031-e5aa-42bc-9538-b74d4177aac7",
                                "sense_id": "730d0f6d-27cb-31f2-9875-83b48508ad38",
                                "text": "„In der Fernsehserie Big Bang Theory wird dem Nerd ein Denkmal gesetzt. Im Silicon Valley scheint Asperger schon fast zum Gencode eines erfolgreichen Unternehmers zu gehören. The Geek Syndrome nannte das Technologiemagazin Wired den Asperger-Autismus einmal, das Computerfreak-Syndrom. Microsoft-Gründer Bill Gates werden autistische Züge zugeschrieben.“"
                            },
                            {
                                "example_id": "bb0b3907-afd0-48e3-8914-c9bdbe76b0fb",
                                "sense_id": "730d0f6d-27cb-31f2-9875-83b48508ad38",
                                "text": "„In der Regel sind Menschen mit Asperger ausserordentlich intelligent, vielfach verfügen sie über eine ausgeprägte Inselbegabung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c8c2873-2e56-40c9-b936-87b98b48503e",
