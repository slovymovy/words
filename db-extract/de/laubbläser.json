                ],
                "senses": [
                    {
                        "sense_id": "ae2b2ed3-fda4-3423-8485-75e228e955e1",
                        "entry_id": "3e81679b-16b8-3f62-852d-f084e77299d4",
                        "glosses": [
                            "Maschine, die einen Luftstrom erzeugt, mit dem Laub am Boden zusammengeblasen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0ba82c-0cfc-4b68-b9cb-19b5094c8077",
                                "sense_id": "ae2b2ed3-fda4-3423-8485-75e228e955e1",
                                "text": "Im Herbst sind in der ganzen Stadt die Laubbläser zu hören."
                            },
                            {
                                "example_id": "2f2ee546-58f5-4d57-98b1-62526cbd9469",
                                "sense_id": "ae2b2ed3-fda4-3423-8485-75e228e955e1",
                                "text": "„Wenn, nur zum Beispiel, eine Regierung diese brüllenden Laubbläser verbieten würde, oder die mit ihnen verwandten Motorheckenscheren, das könnte man schon unterstützen.“"
                            },
                            {
                                "example_id": "363ec75e-b111-4027-b8ad-45c017ff3e10",
                                "sense_id": "ae2b2ed3-fda4-3423-8485-75e228e955e1",
                                "text": "„Laubsauger und –bläser sind laut, produzieren Abgase und töten die Kleinstlebewesen im Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "049ee108-cbc2-4797-8cf1-d1a6ca56d822",
                        "source_entry_id": "3e81679b-16b8-3f62-852d-f084e77299d4",
                        "source_sense_id": "ae2b2ed3-fda4-3423-8485-75e228e955e1",
                        "source_sense_description": "Maschine, die einen Luftstrom erzeugt, mit dem Laub am Boden zusammengeblasen wird",
                        "target_lang_word": "leaf blower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leaf blower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59f08334-7462-3e6c-bb89-d5b0797b9602",
                                        "entry_id": "aea754cc-569d-30a3-9461-25e6308ca12c",
                                        "glosses": [
                                            "A motorized garden tool that propels air out of a nozzle to move leaves and other debris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629c9612-9f56-48d9-8364-a63aa94dd2d8",
                                                "sense_id": "59f08334-7462-3e6c-bb89-d5b0797b9602",
                                                "text": "[…] the leaf blower? Like the Davy Crockett, it is something that should have never been invented. To subjectively paraphrase Shakespeare, a noisy, consumer-grade leaf blower is a device used “by an idiot, full of sound and fury, and that does almost nothing.”"
                                            }
                                        ]
                                    }
                                ]
