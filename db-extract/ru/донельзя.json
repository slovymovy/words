        "ru-extract.jsonl": [
            {
                "entry_id": "8cb73a22-a8a9-3d1c-a865-09534ee16dde",
                "word": "донельзя",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "abbdd98c-a077-349d-8c6d-8d0f1816c739",
                        "entry_id": "8cb73a22-a8a9-3d1c-a865-09534ee16dde",
                        "glosses": [
                            "разг. до предела возможного, в крайней степени, очень"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dfeb112-d475-4efc-bd4f-625f6676ec2a",
                                "sense_id": "abbdd98c-a077-349d-8c6d-8d0f1816c739",
                                "text": "Донельзя постыли мне тина и прах; // Мне там в золотых погулять бы полях: // Туда призывают и ветер и гром, // Перун прилетает оттуда послом."
                            },
                            {
                                "example_id": "803faaaf-2b4f-4e99-afa2-eac84fa812fd",
                                "sense_id": "abbdd98c-a077-349d-8c6d-8d0f1816c739",
                                "text": "Последняя фраза разозлила меня донельзя, и я принялась интенсивно мотать головой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af51f6ca-fec1-4b45-83d6-397be34a0de6",
                        "source_entry_id": "8cb73a22-a8a9-3d1c-a865-09534ee16dde",
                        "source_sense_id": "abbdd98c-a077-349d-8c6d-8d0f1816c739",
                        "target_lang_word": "au plus haut point",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au plus haut point",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f5e6353-7efe-3993-91e7-77a4a5a0aaa1",
                                        "entry_id": "01032169-52de-31c4-8925-773c930c5b12",
                                        "glosses": [
                                            "Au maximum de ce qui peut exister."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4c772f-3d63-48d5-9275-21f13a2f945f",
                                                "sense_id": "4f5e6353-7efe-3993-91e7-77a4a5a0aaa1",
                                                "text": "La flatterie fait partie de cette Éloquence tant célébrée, et davantage encore de la Médecine, et au plus haut point de la Poésie."
                                            },
                                            {
                                                "example_id": "3c419573-9603-4664-b6bb-d89c5f638abf",
                                                "sense_id": "4f5e6353-7efe-3993-91e7-77a4a5a0aaa1",
                                                "text": "On ne s’étonnera donc pas que l’astronome de Greenwich eût été choisi pour opérer dans la circonstance suivante qui intéressait au plus haut point la science sélénographique."
                                            },
                                            {
                                                "example_id": "5c3926bd-4928-467d-a218-1f6233a89dcb",
                                                "sense_id": "4f5e6353-7efe-3993-91e7-77a4a5a0aaa1",
                                                "text": "Il importait au plus haut point, pour les mêmes raisons, que les budgets des années ultérieures connussent une heureuse fortune."
                                            },
                                            {
                                                "example_id": "ed4b7716-1606-4cb9-95ba-a5e512f94a88",
                                                "sense_id": "4f5e6353-7efe-3993-91e7-77a4a5a0aaa1",
                                                "text": "L'accident de la petite Colette dont ils ne savaient rien les alarmait au plus haut point."
                                            },
                                            {
                                                "example_id": "ff55a1b6-5a6e-4d0c-b67d-c9c5b292ae8f",
                                                "sense_id": "4f5e6353-7efe-3993-91e7-77a4a5a0aaa1",
                                                "text": "Morange expira bruyamment. Décidément, la fête tournait au désastre et ce petit merdeux de Mescalero l’agaçait au plus haut point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9337eda5-4924-4116-a269-e5dff619a1be",
                        "source_entry_id": "8cb73a22-a8a9-3d1c-a865-09534ee16dde",
                        "source_sense_id": "abbdd98c-a077-349d-8c6d-8d0f1816c739",
                        "target_lang_word": "à l'extrême",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9f23063b-4b7b-4b79-9cad-c32cd3915a0f",
                        "source_entry_id": "8cb73a22-a8a9-3d1c-a865-09534ee16dde",
                        "source_sense_id": "abbdd98c-a077-349d-8c6d-8d0f1816c739",
                        "target_lang_word": "outre mesure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outre mesure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                        "entry_id": "a59415fd-4a75-3056-87a7-3acda782482a",
                                        "glosses": [
                                            "Avec excès, déraisonnablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "832e1862-e36d-4663-8183-a07beba3ca87",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "Au bout d’une demi-heure, Lucien, se voyant décidément reçu avec une froideur marquée, se trouva à l’égard de la belle madame Grandet dans la situation d’un connaisseur qui marchande un tableau médiocre : tant qu’il compte l’avoir pour quelques louis, il s’exagère ses beautés ; les prétentions du vendeur s’élèvent-elles outre mesure, le tableau devient ridicule aux yeux du connaisseur, il ne voit plus que des défauts, et n’y songe que pour s’en moquer."
                                            },
                                            {
                                                "example_id": "6d70678d-bc3f-4942-8ba5-07f6a900c0e5",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "Je ne puis m’empêcher de dire combien j’ai vu de souffrances peu connues et courageusement portées par une race d’hommes toujours dédaignée ou honorée outre mesure, selon que les nations la trouvent utile ou nécessaire."
                                            },
                                            {
                                                "example_id": "2cc9c602-6c7b-4043-95b7-d8d9d9a15054",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "C'était le frère de Sylvie qui nous rejoignait avec cette bonne gaieté rustique, suite obligée d'une nuit de fête, que des rafraîchissements nombreux avaient développée outre mesure."
                                            },
                                            {
                                                "example_id": "2ede7c08-f3df-44ef-b1f7-a708ac29fa64",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "– Le corps n’a pas été retrouvé, ce qui d’ailleurs ne saurait nous surprendre outre mesure."
                                            },
                                            {
                                                "example_id": "4939cf7a-cfc5-4cbd-a33a-bf816f3b95c5",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "– Je suis tout à fait étonné.\n– Je ne le suis pas outre mesure, dit Anne."
                                            },
                                            {
                                                "example_id": "713d6d59-1231-4ff5-9a8a-588fe61322be",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "Les Bruxellois habitués des négociations difficiles, n’auront probablement pas été outre mesure surpris par l’épisode chaotique de ce week-end."
                                            },
                                            {
                                                "example_id": "4dd113d9-551a-4e51-8e52-d445c27bb297",
                                                "sense_id": "2b164eb1-d780-38ba-91a4-0f8a4cb7e480",
                                                "text": "La présence de Mescaleros n’inquiétait pas outre mesure les Navajos. Dans le passé, ils avaient parfois eu maille à partir avec eux, mais depuis leur exil commun, à Bosque-Redondo, les choses s’étaient considérablement apaisées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
