                                "target_senses": [
                                    {
                                        "sense_id": "ccb8f3a5-87a9-3ee4-b885-236d6e6b04cb",
                                        "entry_id": "0f650a67-218f-38cd-a232-40c5528fe15d",
                                        "glosses": [
                                            "von Honigbienen hergestelltes, antibiotisch wirkendes Stoffgemisch, das zur Abdichtung der Nisthöhle verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7cd4abc-433e-4d89-93aa-2f74d15c3609",
                                                "sense_id": "ccb8f3a5-87a9-3ee4-b885-236d6e6b04cb",
                                                "text": "Honig, Gelée Royale, Propolis oder auch Bienengift sind seit Jahrtausenden bewährte Heilmittel."
                                            },
                                            {
                                                "example_id": "a674daba-b7f1-47da-b9cc-8ca0b741febb",
                                                "sense_id": "ccb8f3a5-87a9-3ee4-b885-236d6e6b04cb",
                                                "text": "Propolis findet heutzutage häufig in der Kosmetik und in der Naturheilkunde Anwendung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
