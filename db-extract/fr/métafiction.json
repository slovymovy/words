                                "target_senses": [
                                    {
                                        "sense_id": "89ef2110-25f2-3bc1-8cd3-b27d73215f73",
                                        "entry_id": "79d852f0-8587-3e0a-906d-53fe4fb0ff07",
                                        "glosses": [
                                            "A form of self-referential literature concerned with the art and devices of fiction itself."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8838252e-cd5c-4e1b-ba84-ad2ee7d0506b",
                                                "sense_id": "89ef2110-25f2-3bc1-8cd3-b27d73215f73",
                                                "text": "Julian Barnes's Flaubert's Parrot (1984) and Peter Ackroyd's Hawksmoor and Chatterton may be described as accomplished examples of historiographic metafiction, the kind of self-conscious, heavily parodic and experimental historical […]"
                                            },
                                            {
                                                "example_id": "4e803cb8-7175-45e2-a330-833f61b7bf7e",
                                                "sense_id": "89ef2110-25f2-3bc1-8cd3-b27d73215f73",
                                                "text": "In the previous chapter, I presented a heuristic explanation of the development of metafiction. In this chapter, I turn to some texts written before the 1980s to demonstrate that the binary between realism and metafiction is not fixed."
                                            }
                                        ]
                                    }
                                ]
                            }
