                    {
                        "translation_id": "d13c5fec-1052-41bf-9797-7dceb23d17bb",
                        "source_entry_id": "45f635dc-4f99-3117-a710-ec637f1d62a0",
                        "source_sense_id": "2b98c822-773f-3a5a-957e-28953c11f1e7",
