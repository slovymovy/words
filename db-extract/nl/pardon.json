                                "sense_id": "f01f3980-b962-32ce-8103-8269902bd8d4",
                                "text": "De minister wilde geen pardon geven voor de overtreders."
                            },
                            {
                                "example_id": "acfeebb5-64d0-4feb-bc6e-a21ac63bdb57",
                                "sense_id": "f01f3980-b962-32ce-8103-8269902bd8d4",
                                "text": "Er was geen pardon, hij zou ter plekke worden doodgeschoten."
                            }
