                                "target_senses": [
                                    {
                                        "sense_id": "598875b4-92c1-3f31-877c-e84b40ca087d",
                                        "entry_id": "fa9675c5-4e25-350f-9d91-a5665605afdd",
                                        "glosses": [
                                            "dispositivo fisico rotante, costituito essenzialmente da una ruota in rotazione intorno al proprio asse, che, per effetto della legge di conservazione del momento angolare, tende a mantenere il suo asse di rotazione orientato in una direzione fissa indipendentemente da qualunque movimento della struttura esterna"
                                        ],
