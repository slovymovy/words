                        "entry_id": "071e1c4f-d5a6-36dd-991b-4d91c3f3bc11",
                        "glosses": [
                            "Gebirgspass im Südschwarzwald zwischen dem Dreisamtal im Raum Freiburg im Norden und dem oberen Wiesental im Süden"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "721af351-2645-4d73-ae93-7c8003f2520c",
                                "sense_id": "db9d9d5c-de21-37fd-a199-fc20d7940b65",
                                "text": "„Als wir Freiburg erreichten, bogen wir ab in Richtung Titisee, Kirchzarten zum Notschrei.“"
                            },
                            {
                                "example_id": "01da9016-1472-43f1-8fa7-8dc11e9d6bbc",
                                "sense_id": "db9d9d5c-de21-37fd-a199-fc20d7940b65",
                                "text": "„Am Notschrei beginnen zwei wunderschöne Loipen, sowohl für Klassiker als auch für Skater.“"
                            }
                        ],
