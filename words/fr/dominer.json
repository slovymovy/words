                },
                {
                    "sense_id": "5ae6362e-d4fa-3dc1-84c9-729309983dad",
                    "sense_definition": "Prévaloir, être le sentiment, l'élément ou l'idée la plus marquante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preponderance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une vive inquiétude semblait <w>dominer</w> dans l'esprit de tous les participants réunis."
                        },
                        {
                            "text": "Dans ce tableau abstrait, la couleur bleue <w>domine</w> largement l'ensemble de la toile."
                        }
                    ]
                },
                {
                    "sense_id": "59c77276-3732-39ee-9f26-99d0c90b5cc3",
                    "sense_definition": "Garder le contrôle de ses émotions, de ses impulsions ou de son comportement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maitrise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la vive provocation, il a su se <w>dominer</w> et garder son calme."
                        },
                        {
                            "text": "Elle respirait profondément pour tenter de se <w>dominer</w> avant d'entrer sur scène."
                        }
                    ],
                    "common_phrases": [
                        "savoir se dominer",
                        "apprendre à se dominer"
                    ],
                    "synonyms": [
                        "se maîtriser",
                        "se contrôler"
                    ]
                },
                {
                    "sense_id": "03eb4442-2b90-3f60-91de-8f2ffa71c22d",
                    "sense_definition": "Connaître parfaitement une matière, en maîtriser tous les aspects théoriques ou pratiques.",
