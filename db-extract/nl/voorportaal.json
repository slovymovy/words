                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e1b11e-cc9c-3e28-97ac-b67824268147",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "A small entrance hall, antechamber, passage, or room between the outer door and the main hall, lobby, or interior of a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7406d798-4d17-4117-96c5-1d6c3197bc23",
                                                "sense_id": "c2e1b11e-cc9c-3e28-97ac-b67824268147",
                                                "text": "Lydia's voice was heard in the vestibule; the door was thrown open, and she ran into the room."
                                            },
                                            {
                                                "example_id": "82f05326-7f61-41c3-beb0-176ad2101810",
                                                "sense_id": "c2e1b11e-cc9c-3e28-97ac-b67824268147",
                                                "text": "The purpose of the vestibule, at least in western Europe, was not to provide a resting-place for penitents, but to deaden the noise outside."
                                            },
                                            {
                                                "example_id": "0c19e97e-bb51-4fb8-b876-43355a62d79d",
                                                "sense_id": "c2e1b11e-cc9c-3e28-97ac-b67824268147",
                                                "text": "Some instinct warned Armitage that what was taking place was not a thing for unfortified eyes to see, so he brushed back the crowd with authority as he unlocked the vestibule door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af557c15-ca2f-3a53-9fd1-32375a03f956",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "A small entrance hall, antechamber, passage, or room between the outer door and the main hall, lobby, or interior of a building.",
                                            "A large entrance hall in a temple or palace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc2b16c0-a0bb-3fd5-9b5d-33ea6d289836",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "A small entrance hall, antechamber, passage, or room between the outer door and the main hall, lobby, or interior of a building.",
                                            "An enclosed entrance at the end of a railway passenger car."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd885730-0f68-445a-a216-7828b8ac21e2",
                                                "sense_id": "dc2b16c0-a0bb-3fd5-9b5d-33ea6d289836",
                                                "text": "The exit side of the front vestibule contains a sliding door."
                                            },
                                            {
                                                "example_id": "b4c7e40d-6b6b-4941-a142-813fd97ecaad",
                                                "sense_id": "dc2b16c0-a0bb-3fd5-9b5d-33ea6d289836",
                                                "text": "The units have transverse seats, two and three astride the passageway with single or double longitudinal seats alongside the two entrance vestibules in each car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c995ac-1c87-3a92-961d-759a3ce31a49",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "Any of a number of body cavities or channels, serving as or resembling an entrance to another bodily space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea69e8af-9e9f-4cd0-9e36-45354bba9645",
                                                "sense_id": "32c995ac-1c87-3a92-961d-759a3ce31a49",
                                                "text": "The membrane of the vestibule in this animal is thrown into three folds. The margins of these folds, looking towards the vestibule, are approximated, and, following the law which is now known to regulate the formation of hollow tubes, doubtless unite and coalesce in the next higher species of fish."
                                            },
                                            {
                                                "example_id": "5bd7f1cd-de73-46ab-a5c0-43ac8b75fe18",
                                                "sense_id": "32c995ac-1c87-3a92-961d-759a3ce31a49",
                                                "text": "The Vestibule (vestibulum nasi). — The paired vestibule may be considered an antechamber to the nasal fossa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09143886-9eb6-3c87-948c-1b83a1da69b5",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "Any of a number of body cavities or channels, serving as or resembling an entrance to another bodily space.",
                                            "The central cavity of the bony labyrinth of the inner ear or the parts (such as the saccule and utricle) of the membranous labyrinth that it contains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9ba6fbe-9ffd-3130-8be8-c59eb8081f0b",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "Any of a number of body cavities or channels, serving as or resembling an entrance to another bodily space.",
                                            "The part of the left ventricle below the aortic orifice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19523940-f639-3c9b-bbb7-ca2d889b6f34",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "Any of a number of body cavities or channels, serving as or resembling an entrance to another bodily space.",
                                            "The part of the mouth outside the teeth and gums."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ddd3aa0-8b34-486b-9577-d6fd264b1861",
                                                "sense_id": "19523940-f639-3c9b-bbb7-ca2d889b6f34",
                                                "text": "The incision of the mucosa over the premaxilla is traced a millimetre or two from the furrow that marks the bottom of the barely-defined vestibule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f6d31f1-7131-31b9-b2de-23fe743f3d22",
                                        "entry_id": "0b0b67f7-741a-38f3-9eed-9f77283bf089",
                                        "glosses": [
                                            "Any of a number of body cavities or channels, serving as or resembling an entrance to another bodily space.",
                                            "Clipping of vulval vestibule: the space in the vulva between the labia minora and into which both the urethra and vagina open."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81fe69a3-2d7c-4d82-ad40-b9e0b1d57f0e",
                                                "sense_id": "2f6d31f1-7131-31b9-b2de-23fe743f3d22",
                                                "text": "She spread her labia further, both sets of lips protecting the vestibule, the delicate area between them."
                                            }
