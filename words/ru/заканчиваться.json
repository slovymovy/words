{
    "word_family": [
        "конец",
        "окончание",
        "закончить",
        "окончить",
        "конечный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ac8eb41-b45a-383b-8bda-7c4ed216bf6e",
                    "sense_definition": "Приходить к завершению, прекращать свое действие или существование.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "завершение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Урок <w>заканчивается</w> через пять минут.",
                            "target_lang_translations": {
                                "en": "The lesson <w>ends</w> in five minutes."
                            }
                        },
                        {
                            "text": "Наш отпуск скоро <w>заканчивается</w>.",
                            "target_lang_translations": {
                                "en": "Our vacation is <w>coming to an end</w> soon."
                            }
                        }
                    ],
                    "synonyms": [
                        "кончаться",
                        "оканчиваться",
                        "завершаться",
                        "приходить к концу",
                        "подходить к концу"
                    ],
                    "antonyms": [
                        "начинаться",
                        "стартовать"
                    ],
                    "common_phrases": [
                        "заканчивается день",
                        "заканчивается работа"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach a conclusion, stop an action, or cease to exist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "To come to an end or conclude."
                            },
                            {
                                "target_lang_word": "be over",
                                "target_lang_sense_clarification": "To have finished or concluded."
                            },
                            {
                                "target_lang_word": "come to an end",
                                "target_lang_sense_clarification": "To stop or cease continuing."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca23964-8d68-3cdf-b915-d4b9f1404d58",
                    "sense_definition": "Иссякать, подходить к пределу своего количества.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "исчерпание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас <w>заканчиваются</w> деньги на поездку.",
                            "target_lang_translations": {
                                "en": "We are <w>running out of</w> money for the trip."
                            }
                        },
                        {
                            "text": "Терпение у учителя <w>заканчивается</w>.",
                            "target_lang_translations": {
                                "en": "The teacher's patience is <w>running out</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "заканчиваются силы",
                        "заканчивается терпение"
                    ],
                    "target_lang_definitions": {
                        "en": "To run out of something; to reach the limit of a supply."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run out",
                                "target_lang_sense_clarification": "To have no more of something left."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b37369dd-a475-38c1-9f0b-84b6f33b2f19",
                    "sense_definition": "Иметь своим пределом или границей что-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "граница",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта дорога <w>заканчивается</w> у самого леса.",
                            "target_lang_translations": {
                                "en": "This road <w>ends</w> right at the forest."
                            }
                        },
                        {
                            "text": "Предложение <w>заканчивается</w> точкой.",
                            "target_lang_translations": {
                                "en": "The sentence <w>ends</w> with a period."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have a limit or boundary at a certain point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "To terminate at a specific point or location."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7a5a0c5-b64c-3277-9d49-c2d7ce0e64dc",
                    "sense_definition": "Страдательная форма глагола <w>заканчивать</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "пассив",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Строительство дома <w>заканчивается</w> рабочими в срок.",
                            "target_lang_translations": {
                                "en": "The construction of the house is <w>being completed</w> by the workers on time."
                            }
                        },
                        {
                            "text": "Работа <w>заканчивается</w> специалистами по графику.",
                            "target_lang_translations": {
                                "en": "The work is <w>being finished</w> by the specialists according to the schedule."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive form of the verb 'to finish' or 'to complete'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be finished",
                                "target_lang_sense_clarification": "To be brought to completion by someone."
                            },
                            {
                                "target_lang_word": "be completed",
                                "target_lang_sense_clarification": "To have the work on something finished."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}