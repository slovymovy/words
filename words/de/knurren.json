{
    "word_family": [
        "Geknurre",
        "Knurrer",
        "Knurrhahn"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ca20b8c-1f7a-3df7-aba5-7dd2587e5c29",
                    "sense_definition": "ein dumpfes, drohendes Geräusch erzeugen (besonders von Hunden oder anderen Tieren)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als sich der Fremde dem Gartenzaun näherte, begann der Hund leise zu <w>knurren</w>."
                        },
                        {
                            "text": "Die Raubkatze blieb im Schatten stehen und <w>knurrte</w> warnend in unsere Richtung."
                        }
                    ],
                    "common_phrases": [
                        "drohend knurren",
                        "leise knurren"
                    ]
                },
                {
                    "sense_id": "bc674c28-1096-3930-995f-99f95d07cf5e",
                    "sense_definition": "ein gurgelndes Geräusch im Bauch oder Magen machen, meist als Zeichen von Hunger",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weil ich das Frühstück verpasst hatte, <w>knurrte</w> mein Magen während der gesamten Vorlesung."
                        },
                        {
                            "text": "Mitten im ruhigen Prüfungsraum fing sein Bauch laut an zu <w>knurren</w>."
                        }
                    ],
                    "common_phrases": [
                        "der Magen knurrt"
                    ]
                },
                {
                    "sense_id": "fe0be1a6-40c3-3ba4-a702-d120fc9bc5eb",
                    "sense_definition": "mit mürrischer, unfreundlicher und tiefer Stimme sprechen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "laut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf meine höfliche Frage nach dem Weg <w>knurrte</w> der Mann nur eine knappe Antwort."
                        },
                        {
                            "text": "„Lass mich in Ruhe“, <w>knurrte</w> er, ohne vom Bildschirm aufzusehen."
                        }
                    ],
                    "common_phrases": [
                        "eine Antwort knurren"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                    "sense_definition": "dumpfes, grollendes oder vibrierendes Geräusch",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "laut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plötzlich hörten die Wanderer im dichten Gebüsch ein tiefes, bedrohliches <w>Knurren</w>."
                        },
                        {
                            "text": "Das laute <w>Knurren</w> in seinem Bauch verriet allen Anwesenden seinen großen Hunger."
                        }
                    ],
                    "synonyms": [
                        "Geknurre"
                    ],
                    "common_phrases": [
                        "ein tiefes Knurren",
                        "ein leises Knurren"
                    ]
                }
            ]
        }
    ]
}