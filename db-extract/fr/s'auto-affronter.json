                "senses": [
                    {
                        "sense_id": "d274f192-b8e5-32fe-9d3b-a6a76108d670",
                        "entry_id": "17c2d273-2ddb-393b-b062-4089039bae8a",
                        "glosses": [
                            "S’affronter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb828c51-73a3-4c3c-a0f8-8217b3116def",
                                "sense_id": "d274f192-b8e5-32fe-9d3b-a6a76108d670",
                                "text": "Si je pouvais m'auto-affronter je le ferais depuis un bail."
                            },
                            {
                                "example_id": "adb6322c-fa92-47a6-b015-838079bce4b2",
                                "sense_id": "d274f192-b8e5-32fe-9d3b-a6a76108d670",
                                "text": "Les petits St Doulchiens, avides d'en découdre, ont donc décider de s'auto-affronter dans un 3x3."
                            },
                            {
                                "example_id": "502f47d2-7605-4207-9033-43fc8f2dbbf3",
                                "sense_id": "d274f192-b8e5-32fe-9d3b-a6a76108d670",
                                "text": "Si tu n'as pas de partenaire, on devra tirer au sort. La raison est que tu ne peux pas t'auto-affronter si tu venais à gagner le tournoi."
                            }
                        ]
                    }
