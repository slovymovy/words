                                    {
                                        "sense_id": "205c2b65-158c-3d0b-a7e7-c86416a5fecd",
                                        "entry_id": "14f42414-85a9-393c-a163-5d75f43aed3c",
                                        "glosses": [
                                            "für einen Krieg gerüstet, vorbereitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b11f63-aa1f-49c2-8621-39f4c3de6281",
                                                "sense_id": "205c2b65-158c-3d0b-a7e7-c86416a5fecd",
                                                "text": "„Die Wehrmacht wurde angewiesen, bis zum 1. Oktober 1938 kriegsbereit zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "019dad7b-c753-4e6c-bea5-7dded94861e3",
                        "source_entry_id": "240fb3b2-50a6-3b61-b069-b82c9bf91505",
                        "source_sense_id": "7a624ff7-f251-3f6f-9265-219376f90e27",
                        "target_lang_word": "kriegstüchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kriegstüchtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13110574-8434-3437-a456-9aaf7a0849db",
                                        "entry_id": "eeaf619d-e8fb-3aa1-b2d6-c25c10659187",
                                        "glosses": [
                                            "gerüstet für einen Krieg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3224d695-e111-41f5-bf20-84416bf67285",
                                                "sense_id": "13110574-8434-3437-a456-9aaf7a0849db",
                                                "text": "„Verteidigungsminister Boris Pistorius (SPD) hat einen ‚Mentalitätswechsel‘ der Deutschen in Sicherheitsfragen gefordert. ‚Wir müssen uns wieder an den Gedanken gewöhnen, dass die Gefahr eines Krieges in Europa drohen könnte‘, sagte Pistorius in der ZDF-Sendung Berlin direkt. ‚Und das heißt: Wir müssen kriegstüchtig werden. Wir müssen wehrhaft sein. Und die Bundeswehr und die Gesellschaft dafür aufstellen.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c737b90-f6e4-344c-822a-823ca38bb881",
                                        "entry_id": "eeaf619d-e8fb-3aa1-b2d6-c25c10659187",
                                        "glosses": [
                                            "versiert in der Kriegsführung, kampferprobt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabdaa4d-83e5-4f35-a57f-6a664c8d472e",
                                                "sense_id": "6c737b90-f6e4-344c-822a-823ca38bb881",
                                                "text": "„Daraus entwickelte sich ein Weltbild, demzufolge alle Völker in einem dauernden ‚Kampf ums Dasein‘ verstrickt seien, den nur die Stärksten überleben würden, also jene Völker, die am kriegstüchtigsten waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
