                                    {
                                        "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                        "entry_id": "2befab2b-37a1-372b-be1e-938c18ced2b1",
                                        "glosses": [
                                            "Flugzeug, bei dem ein Raketentriebwerk für den Vortrieb sorgt; das über einen Raketenantrieb verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607cc470-553b-4e3c-b257-5b26f4683b74",
                                                "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                                "text": "„Zwei Jahre später, am 20. Juni 1939, manövrierte Warsitz als erster Mensch den funktionstüchtigen Vorläufer des Düsenflugzeugs Heinkel He 178, das Raketenflugzeug Heinkel He 176, durch die Lüfte.“"
                                            },
                                            {
                                                "example_id": "1b0060fb-0ef2-4a1b-a6f6-908a2d4133eb",
                                                "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                                "text": "„Mit Hyperschallgeschwindigkeit nach Australien gleiten: Das DLR entwickelt ein Raketenflugzeug für Interkontinentalflüge.“"
                                            },
                                            {
                                                "example_id": "c0262647-4572-4f13-bc06-8d63026d3117",
                                                "sense_id": "71046432-fad5-3cf9-ad0e-2f8dbfa7a5ff",
                                                "text": "„Der europäische Luftfahrtkonzern EADS hat am Sonntag Pläne für ein neues Raketenflugzeug präsentiert, das in einigen Jahrzehnten in nur zweieinhalb Stunden von Paris nach Tokio fliegen soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
