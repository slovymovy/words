                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa1660c8-97fb-4fde-a9d2-8e2612bac974",
                        "source_entry_id": "9cc7e33b-f150-3010-a5e5-c8ce6706f686",
                        "source_sense_id": "6a1beca5-457e-315c-88fd-eebb3fc826b0",
                        "target_lang_word": "Bokononism",
