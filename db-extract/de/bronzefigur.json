                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21fa0673-e1ea-4f56-83a0-d1678e127a91",
                                "sense_id": "31af3641-3da3-33a0-9073-c5c0a36e7e59",
                                "text": "„Der stehende Mann ist eine Bronzefigur, nackt, die braune Haut fleckig von Flechten und angelaufenen Stellen; seine Füße sind auf einen Sockel geschraubt, der vom Gestrüpp neben dem Pfad überwuchert ist.“"
                            },
                            {
                                "example_id": "cda92db6-4227-4749-8ae8-3575c964d6bc",
                                "sense_id": "31af3641-3da3-33a0-9073-c5c0a36e7e59",
                                "text": "„Chang wartete, bis die Ampel grün wurde, und trat dann auf die Bronzefigur zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
