                                        "entry_id": "0fdb8517-81e7-3b28-a64e-4accb0ff23cc",
                                        "glosses": [
                                            "jedes Jahr; von Jahr zu Jahr; Jahr für Jahr"
                                        ],
                                        "tags": [],
