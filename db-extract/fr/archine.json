                    {
                        "translation_id": "1d483470-a2b6-4ffc-8e3e-d40309eb11f9",
                        "source_entry_id": "1361cec0-f019-33d4-8a9d-0e2a0fd71c92",
                        "source_sense_id": "1422337f-7a7a-33c5-b19c-3eb1639f3be3",
