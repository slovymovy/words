                ],
                "senses": [
                    {
                        "sense_id": "027ac1a0-1631-3705-8e8d-68d2ab9de543",
                        "entry_id": "79ca0b08-6a11-3b34-a1c2-94db42528d35",
                        "glosses": [
                            "niederösterreichische Marktgemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afab179d-3227-4947-8297-3b42def7eab6",
                                "sense_id": "027ac1a0-1631-3705-8e8d-68d2ab9de543",
                                "text": "Der Großteil der vier Millionen Objekte umfassenden Kunstsammlung wird am Herbst nicht mehr in der Hauptstadt, sondern in Himberg gelagert."
                            },
                            {
                                "example_id": "c158e837-ff09-4952-a8ab-69af92bca86e",
                                "sense_id": "027ac1a0-1631-3705-8e8d-68d2ab9de543",
                                "text": "Beim Abbruch würden die Baustoffe getrennt, da sie weitestgehend im eigenen Recyclingwerk in Himberg wiederverwertet werden, heißt es."
                            },
                            {
                                "example_id": "1f8cb593-3418-4ecb-9105-131f1d57329a",
                                "sense_id": "027ac1a0-1631-3705-8e8d-68d2ab9de543",
                                "text": "Bierflaschen mit einer brennbaren Flüssigkeit wurden in Himberg angezündet und gegen die Mauer einer Asylunterkunft geworfen."
                            },
                            {
                                "example_id": "b2023f33-9fd6-4d98-b5e5-bef2f8aa1a72",
                                "sense_id": "027ac1a0-1631-3705-8e8d-68d2ab9de543",
                                "text": "Von Himberg in die anderen Ortschaften verkehren nur selten Busse."
                            },
                            {
                                "example_id": "30d57e25-69db-4370-9203-e06a71b478c4",
                                "sense_id": "027ac1a0-1631-3705-8e8d-68d2ab9de543",
                                "text": "Der Vater gründete erst kürzlich, gemeinsam mit dem Bobteam von Katrin Beierl, einen eigenen Verein in Himberg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
