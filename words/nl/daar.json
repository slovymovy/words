                                "ru": "Это ничего в <w>этом</w> не меняет.",
                                "pl": "To w niczym <w>temu</w> nie umniejsza.",
                                "de": "Das tut <w>dem</w> ansonsten keinen Abbruch.",
                                "fr": "Cela n'enlève rien à <w>cela</w>.",
                                "it": "Questo non toglie nulla a <w>ciò</w>.",
                                "cs": "To na <w>tom</w> nic nemění.",
                                "tr": "Bu durum <w>bunu</w> hiç değiştirmez.",
                                "es": "Eso no le resta valor en <w>absoluto</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to add emphasis or as a filler word, often without a literal meaning of place.",
                        "ru": "Используется для усиления или как слово-паразит, часто без буквального значения места.",
                        "pl": "Używane w celu podkreślenia znaczenia lub jako słowo wypełniające, często bez dosłownego znaczenia miejsca.",
                        "de": "Wird zur Betonung in einem Satz oder als Füllwort verwendet, ohne die wörtliche Bedeutung eines Ortes.",
                        "fr": "Utilisé pour insister ou comme mot de remplissage, souvent sans signification littérale de lieu.",
                        "it": "Usato per dare enfasi o come riempitivo in una frase, senza un significato letterale di luogo.",
                        "cs": "Používá se pro zdůraznění nebo jako výplňkové slovo, často bez doslovného místního významu.",
                        "tr": "Cümlede vurgu yapmak için veya dolgu sözcüğü olarak kullanılır; gerçek bir yer anlamı taşımaz.",
                        "es": "Se utiliza para dar énfasis en una oración o como palabra de relleno, sin un significado literal de lugar."
                    },
