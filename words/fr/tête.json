    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cf40a55-a41f-3603-94c5-8b64413f82c7",
                    "sense_definition": "Partie supérieure ou antérieure du corps humain et animal, contenant le cerveau et les principaux organes des sens.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai souvent mal à la <w>tête</w> quand je travaille trop longtemps sur l'ordinateur."
                        },
                        {
                            "text": "Le médecin a examiné sa <w>tête</w> après sa chute dans les escaliers."
                        }
                    ],
                    "synonyms": [
                        "boule",
                        "caboche"
                    ],
                    "antonyms": [
                        "pied"
                    ],
                    "common_phrases": [
                        "mal à la tête",
                        "de la tête aux pieds",
                        "baisser la tête",
                        "hocher la tête"
                    ]
                },
                {
                    "sense_id": "b849bdb3-f7a4-3c65-b0ef-6a5d7263c658",
                    "sense_definition": "Visage, mine ou physionomie d'une personne reflétant souvent une émotion.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourquoi fais-tu cette <w>tête</w> depuis que nous sommes arrivés à la fête ?"
                        },
                        {
                            "text": "Il a fait une drôle de <w>tête</w> en apprenant la nouvelle de leur départ."
                        }
                    ],
                    "synonyms": [
                        "gueule",
                        "tronche"
                    ],
                    "common_phrases": [
                        "faire la tête",
                        "drôle de tête"
                    ]
                },
                {
                    "sense_id": "e80e6e50-64dc-3a9e-89c8-9097ad1bc4ba",
                    "sense_definition": "Siège de la réflexion, de l'esprit, du jugement ou de la mémoire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut garder la <w>tête</w> froide face aux difficultés inattendues de ce projet."
                        },
                        {
                            "text": "Cette chanson entraînante me reste dans la <w>tête</w> depuis ce matin."
                        }
                    ],
                    "synonyms": [
                        "ciboulot"
                    ],
                    "common_phrases": [
                        "garder la tête froide",
                        "perdre la tête",
                        "avoir en tête"
                    ]
                },
                {
                    "sense_id": "a6604484-8ec7-333a-8695-629934af7fef",
                    "sense_definition": "Personne qui dirige une organisation, ou élément qui se trouve au premier rang d'un ensemble en mouvement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est désormais à la <w>tête</w> d'une grande entreprise internationale d'informatique."
                        },
                        {
                            "text": "Le coureur français s'est installé à la <w>tête</w> du peloton dès le début de l'épreuve."
                        }
                    ],
                    "synonyms": [
                        "chef"
                    ],
                    "antonyms": [
                        "arrière",
                        "queue"
                    ],
                    "common_phrases": [
                        "à la tête de",
                        "prendre la tête",
                        "tête de file"
                    ]
                },
                {
                    "sense_id": "3c3ce727-6d66-3b71-8f3b-3821d214c728",
                    "sense_definition": "Extrémité renflée ou élargie de certains objets allongés comme un clou ou une épingle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Frappe délicatement sur la <w>tête</w> du clou pour ne pas fendre la planche en bois."
                        },
                        {
                            "text": "La <w>tête</w> de cette vis est abîmée, il est impossible de la retirer facilement."
                        }
                    ],
                    "common_phrases": [
                        "tête de clou",
                        "tête d'épingle"
                    ]
                },
                {
                    "sense_id": "6b47186a-c95e-3b42-b633-9d17e7dd65fe",
                    "sense_definition": "Au football, geste consistant à frapper le ballon avec la tête.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'attaquant a marqué un superbe but d'une <w>tête</w> plongeante juste avant la mi-temps."
                        },
                        {
                            "text": "Le défenseur a repoussé le ballon de la <w>tête</w> pour sauver son équipe."
                        }
                    ],
                    "common_phrases": [
                        "coup de tête",
                        "but de la tête"
                    ]
                }
            ]
        }
    ]
