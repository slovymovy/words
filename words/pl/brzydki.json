                        "piękny",
                        "śliczny",
                        "estetyczny"
                    ],
                    "common_phrases": [
                        "brzydkie kaczątko",
                        "brzydki zapach",
                        "brzydki kolor"
                    ],
                    "target_lang_definitions": {
