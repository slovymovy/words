                "senses": [
                    {
                        "sense_id": "942f7088-d26e-3ace-981f-d438f20c9787",
                        "entry_id": "f1c2e339-0f41-3fb6-a336-41dd4f052840",
                        "glosses": [
                            "разг. состояние по значению гл. спать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40334c53-07a0-4200-b1f2-eb8a8ff9bcf1",
                                "sense_id": "942f7088-d26e-3ace-981f-d438f20c9787",
                                "text": "А нельзя и без мебельки; на полу уж какое спанье; разве от бедности."
                            },
                            {
                                "example_id": "fcb844f6-d02b-4e31-866d-b55b836b5574",
                                "sense_id": "942f7088-d26e-3ace-981f-d438f20c9787",
                                "text": "А после в огне раззолоченных зал, // забыв привычку спанья, // всю ночь напролет провести, // глаза // уткнув в желтоглазый коньяк."
                            }
                        ]
                    }
