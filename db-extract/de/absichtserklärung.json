                ],
                "senses": [
                    {
                        "sense_id": "039bb329-2560-391f-8adf-342e7f45e716",
                        "entry_id": "96b0ef8f-f022-3f53-b635-22c54457d75f",
                        "glosses": [
                            "Erklärung eines Verhandlungspartners, die das Interesse an Verhandlungen über eine Absicht und am Abschluss eines Vertrages darüber ausdrückt, aber keine rechtliche Bindungswirkung hat"
                        ],
                        "tags": [
                            "Wirtschaft, Politik"
                        ],
                        "examples": [
                            {
                                "example_id": "47971662-a6d6-4733-a023-6cfd12e559e5",
                                "sense_id": "039bb329-2560-391f-8adf-342e7f45e716",
                                "text": "„Zusammen mit ihrer niederländischen Kollegin Jeanine Hennis-Plasschaert unterzeichnete von der Leyen eine Absichtserklärung, um das deutsche Seebataillon bis 2018 schrittweise in die niederländische Marine zu integrieren.“"
                            },
                            {
                                "example_id": "a7881588-57f0-4b0f-ac89-6d7e1481f4a4",
                                "sense_id": "039bb329-2560-391f-8adf-342e7f45e716",
                                "text": "„Wie in Tokio aus Regierungskreisen verlautete und am Donnerstag in japanischen Medien berichtet wurde, will die japanische Regierung eine entsprechende Absichtserklärung beim Treffen der Internationalen Walfangkommission im September in Slowenien abgeben.“"
                            },
                            {
                                "example_id": "ea7cefe6-ffda-444a-85c2-2e7961a9a3d4",
                                "sense_id": "039bb329-2560-391f-8adf-342e7f45e716",
                                "text": "„13 Regionen haben sich um eine Wasserstoff-Station für Brennstoffzellenfahrzeuge beworben und viele Absichtserklärungen potentieller Autokäufer vorgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
