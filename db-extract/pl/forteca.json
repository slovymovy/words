                    {
                        "translation_id": "88d211df-d829-45b7-abb9-c430001c9eee",
                        "source_entry_id": "6ec106c0-f580-3d26-8483-489e83b9a117",
                        "source_sense_id": "1b90eecc-abe7-324d-b180-f96ff5d1ca04",
                        "target_lang_word": "Festung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Festung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc32d0ee-bbd6-3be7-b2f1-68df8860b76a",
                                        "entry_id": "7a8c0a6f-6536-3412-8969-7f33774c6e9f",
                                        "glosses": [
                                            "ein durch Wehranlagen stark befestigter, militärisch bedeutender Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4c8843b-61ef-434c-8e48-9b90a9202bd7",
                                                "sense_id": "bc32d0ee-bbd6-3be7-b2f1-68df8860b76a",
                                                "text": "„Hier war es. Da stand sie. Diese steinernen Löwen, jetzt kopflos, haben sie angeblickt. Diese Festung, einst uneinnehmbar, ein Steinhaufen jetzt, war das letzte, was sie sah.“"
                                            },
                                            {
                                                "example_id": "b82a92fc-4438-4627-b9a1-54652ef97635",
                                                "sense_id": "bc32d0ee-bbd6-3be7-b2f1-68df8860b76a",
                                                "text": "„Er wählte diesen Standort nahe am Meer, weil die Kanonen der Festung dann portugiesische Schiffe, die dort ankerten, vor den Holländern schützen konnten.“"
                                            },
                                            {
                                                "example_id": "43453fa0-91b0-4deb-b43e-c28227883523",
                                                "sense_id": "bc32d0ee-bbd6-3be7-b2f1-68df8860b76a",
                                                "text": "„Entlang der Uferpromenade gelangen Sie rheinaufwärts zur Talstation der Seilbahn über den Rhein, mit der schnell die Festung Ehrenbreitstein erreicht werden kann.“"
                                            },
                                            {
                                                "example_id": "978318d6-8ce6-4754-9792-d01e6bd5d541",
                                                "sense_id": "bc32d0ee-bbd6-3be7-b2f1-68df8860b76a",
                                                "text": "„Der kalte Sprühregen begann wieder zu fallen und hüllte die Festung in graue Schleier ein.“"
                                            },
                                            {
                                                "example_id": "08a5c8ce-75aa-4ce9-bd86-197b0d77fdf9",
                                                "sense_id": "bc32d0ee-bbd6-3be7-b2f1-68df8860b76a",
                                                "text": "„Die schwimmenden Festungen Mark Antons werden gleich von mehreren feindlichen Quinqueremen umzingelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
