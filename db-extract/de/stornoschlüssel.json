                        "entry_id": "5be16881-0e24-351c-8282-bbd851062861",
                        "glosses": [
                            "a key that must be inserted into a cash register to allow for cancellation of already booked entries, held by a supervisor or trustworthy employee in order to prevent fraud"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
