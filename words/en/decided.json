            "senses": [
                {
                    "sense_id": "7f3d0a62-b0d7-336a-acaa-703168313b8c",
                    "sense_definition": "Simple past and past participle of <w>decide</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>decided</w> to wear the red dress to the party.",
                            "target_lang_translations": {
                                "ru": "Она <w>решила</w> надеть красное платье на вечеринку.",
                                "zh": "她<w>决定</w>穿那件红裙子去参加聚会。"
                            }
                        },
                        {
                            "text": "We have finally <w>decided</w> on a name for the new baby.",
                            "target_lang_translations": {
                                "ru": "Мы наконец <w>определились</w> с именем для новорожденного.",
                                "zh": "我们终于为新生儿<w>选定</w>了名字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "decided to",
                        "decided against",
                        "decided on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола decide (решать).",
                        "zh": "动词 decide（决定，选定）的过去式和过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решил",
