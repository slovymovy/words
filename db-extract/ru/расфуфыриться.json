                    },
                    {
                        "translation_id": "8f0d560a-9488-4603-98ac-81ca887681f0",
                        "source_entry_id": "1e326ab8-b988-3af5-9fb7-c1568fe36733",
                        "source_sense_description": "разодеться",
                        "target_lang_word": "aufbrezeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aufbrezeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                        "entry_id": "c50a6309-1c64-3fde-b8b0-b8321947d9ca",
                                        "glosses": [
                                            "sich oder jemand/etwas attraktiv, vielleicht auch übertrieben, herrichten"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54654392-bd85-4f40-918d-48e5db6f61af",
                                                "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                                "text": "„»Du meinst also, ich sollte mich nicht ein bisschen aufbrezeln?«“"
                                            },
                                            {
                                                "example_id": "533e4245-4fd7-4f3b-8b05-2ba64dd1601a",
                                                "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                                "text": "„Ich möchte mich für Ayden aufbrezeln!“"
                                            },
                                            {
                                                "example_id": "90c75a39-e0ed-47b9-9fc9-c4efa3782b98",
                                                "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                                "text": "„Eines Tages also kommt Vinny Funaro, ein aufgebrezelter Italiener aus New Jersey.“"
                                            },
                                            {
                                                "example_id": "31b9634e-85f8-4141-ad67-4f6524984195",
                                                "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                                "text": "Sie hat sich ganz schön aufgebrezelt."
                                            },
                                            {
                                                "example_id": "3b7cdb73-a077-487c-a25a-4dbfdc0699b4",
                                                "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                                "text": "„Der bergsüchtige Stadtmensch hat die Wahl zwischen bodenständigen Gasthäusern und Stadtheurigen, szenigen Après-Ski-Hütten und stylish aufgebrezelten Edellokalitäten.“"
                                            },
                                            {
                                                "example_id": "e9c50c88-38ec-4619-98ff-61bf64920b9b",
                                                "sense_id": "ce11c062-97fc-3664-82a1-a474915a2c65",
                                                "text": "„Ein wirkliches Café, in dem sich die Männer des Ortes trafen, wie man das hier kannte, und kein aufgebrezeltes Kaffeehaus, das sich dem Westen anbiederte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
