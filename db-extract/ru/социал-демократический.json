                                        "entry_id": "33463ebe-4b44-3e28-8dc3-d6dc8e8fc687",
                                        "glosses": [
                                            "der Sozialdemokratie (welche den Sozialismus und die Demokratie verbinden soll) angehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8e5f09-b7bc-4a18-8721-bf4b6c027510",
                                                "sense_id": "91e6e58b-63c0-3761-beca-507868f02eb2",
                                                "text": "Mein Vater wuchs in einem nationalsozialistischen Umfeld auf, ich jedoch durfte in einem sozialdemokratischen Umfeld aufwachsen."
                                            },
                                            {
                                                "example_id": "85bb6173-2818-4d1b-9d17-50d9550a534d",
                                                "sense_id": "91e6e58b-63c0-3761-beca-507868f02eb2",
                                                "text": "„Auch sozialdemokratische Arbeiter ließ die Faszination des Militärischen nicht unberührt.“"
                                            }
