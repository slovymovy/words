                                    {
                                        "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                        "entry_id": "9a0f94c0-8b11-3a3e-8085-cc70b9075f1d",
                                        "glosses": [
                                            "Belohnung (meist Geldbetrag), die der Finder für die Rückgabe eines gefundenen Gutes bekommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b2cb08-5ddc-4ecc-9b7a-e5bd1bf9a546",
                                                "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                                "text": "Wenn jemand etwas Wertvolles gefunden und zurückgegeben hat, dann steht ihm ein angemessener Finderlohn zu."
                                            },
                                            {
                                                "example_id": "b2cf6328-8037-45a1-8153-a8113ec3e38a",
                                                "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                                "text": "„Und wenn's eine Million gewesen wäre, er hätte sie gegen Finderlohn abgegeben.“"
                                            },
                                            {
                                                "example_id": "914351b7-50f5-4b5d-a941-4bde79a58058",
                                                "sense_id": "91db5c71-d2b4-3fa5-bec5-6153856e19cb",
                                                "text": "„Petra hat im Papierkorb des Vaters einen 20-DM-Schein entdeckt und verlangt, als sie ihn ihrem Vater gibt, 10 Prozent Finderlohn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
