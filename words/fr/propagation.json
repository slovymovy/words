    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55a90c04-63a4-3e14-a1e0-e2ccc00b03dc",
                    "sense_definition": "Diffusion ou dissémination rapide et étendue d'un phénomène, d'une maladie, d'une information ou d'une idée.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les autorités sanitaires surveillent de près la <w>propagation</w> rapide de cette nouvelle maladie contagieuse."
                        },
                        {
                            "text": "Sur les réseaux sociaux, la <w>propagation</w> des fausses nouvelles se fait souvent en quelques minutes."
                        }
                    ],
                    "synonyms": [
                        "diffusion",
                        "dissémination",
                        "transmission"
                    ],
                    "antonyms": [
                        "endiguement",
                        "arrêt"
                    ],
                    "common_phrases": [
                        "propagation du virus",
                        "vitesse de propagation",
                        "propagation des rumeurs"
                    ]
                },
                {
                    "sense_id": "76836f2e-0c39-323f-93a6-3175e51416d5",
                    "sense_definition": "Déplacement ou transmission dans un milieu matériel ou dans le vide d'un phénomène physique tel qu'une onde, le son ou la lumière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>propagation</w> du son est nettement plus lente que celle de la lumière dans l'atmosphère terrestre."
                        },
                        {
                            "text": "Ce nouveau matériau isolant permet de freiner efficacement la <w>propagation</w> des vibrations mécaniques."
                        }
                    ],
                    "synonyms": [
                        "rayonnement",
                        "transmission"
                    ],
                    "antonyms": [
                        "absorption",
                        "atténuation"
                    ],
                    "common_phrases": [
                        "propagation du son",
                        "propagation des ondes"
                    ]
                },
                {
                    "sense_id": "ab73e38b-ac57-37cc-9835-6e3226ffdb96",
                    "sense_definition": "Multiplication naturelle ou artificielle des organismes vivants, en particulier des végétaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier pratique la <w>propagation</w> par bouturage pour obtenir rapidement de nouveaux plants d'arbustes."
                        },
                        {
                            "text": "L'introduction de cette espèce végétale envahissante menace la survie des plantes locales par sa <w>propagation</w> excessive."
                        }
                    ],
                    "synonyms": [
                        "multiplication",
                        "reproduction"
                    ],
                    "common_phrases": [
                        "propagation des plantes",
                        "propagation par bouturage"
                    ]
                }
            ]
        }
    ]
