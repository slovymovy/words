                "senses": [
                    {
                        "sense_id": "2cd9dbe1-a124-33dd-bfd7-2abb59940b24",
                        "entry_id": "127fd73d-e41f-34af-a005-2c0131eec8c3",
                        "glosses": [
                            "allgemein: Benennung von Luft in einer Gegend oder mit einem kennzeichnenden Charakter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "848669ae-d944-42c0-829f-aba0faac70cb",
                                "sense_id": "2cd9dbe1-a124-33dd-bfd7-2abb59940b24",
                                "text": "„In einer Luftkammer des Forschungszentrums Jülich haben drei Probanden unterschiedliche Luftarten getestet: Südseeluft, Bergluft und Stadtluft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6b845bf-ba09-33f2-8fae-be556d4c54a2",
                        "entry_id": "127fd73d-e41f-34af-a005-2c0131eec8c3",
                        "glosses": [
                            "fachsprachlich: Benennung eines bestimmten Luftstromes in einer technischen Anlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "355d6539-d54c-4087-86e8-3591f210530f",
                                "sense_id": "c6b845bf-ba09-33f2-8fae-be556d4c54a2",
                                "text": "Die Luftart kennzeichnet in der Lüftungs- und Klimatechnik die verschiedenen Luftströme hinsichtlich der Verwendung oder Bestimmung."
                            },
                            {
                                "example_id": "67e2bda4-52fb-4e73-8e55-110ddfc7456e",
                                "sense_id": "c6b845bf-ba09-33f2-8fae-be556d4c54a2",
                                "text": "„ Im folgenden sind die verschiedenen Luftarten zusammengestellt.“"
                            },
                            {
                                "example_id": "39f8ca5d-7cf9-4830-aa49-ae70650ca002",
                                "sense_id": "c6b845bf-ba09-33f2-8fae-be556d4c54a2",
                                "text": "„Die Außenluft ist eine der grundlegenden Luftarten in der Lüftungstechnik und Klimatechnik.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fe883958-f0b0-3700-bfbc-a1d3acf071cf",
                        "entry_id": "127fd73d-e41f-34af-a005-2c0131eec8c3",
                        "glosses": [
                            "Luftarten sind die Gase in Luft"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "b01cc1f0-101a-44f7-801e-2cd9fb5fd54f",
                                "sense_id": "fe883958-f0b0-3700-bfbc-a1d3acf071cf",
                                "text": "„Im engeren Sinne nennt man jedoch \"Gase\" oder Luftarten nur solche luftförmige Körper, welche unter gewöhnlichen Druck- und Temperaturverhältnissen als Flüssigkeiten nicht bestehen können, wie Sauerstoff, Stickstoff und die aus beiden gemischte atmosphärische Luft, Wasserstoff, Chlor, Stickoxyd, Kohlenoxyd, Kohlensäure, Schwefelwasserstoff, Ammoniak u. v. a., im Gegensatz zu den Dämpfen, welche luftförmige Körper sind, die unter gewöhnlichen Verhältnissen auch im flüssigen Zustand existieren, wie Wasser-, Alkohol-, Äther-, Bromdampf u. a.“"
                            },
                            {
                                "example_id": "3c64241e-5f4c-4559-b53a-cbf7161271c6",
                                "sense_id": "fe883958-f0b0-3700-bfbc-a1d3acf071cf",
                                "text": "„Atmungsapparate ermöglichen das Arbeiten in Räumen, die mit zur Atmung ungeeigneten Luftarten erfüllt sind.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
