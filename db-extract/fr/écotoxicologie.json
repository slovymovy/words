        "fr-extract.jsonl": [
            {
                "entry_id": "55001de2-421a-35c2-9daf-6afa0f91f348",
                "word": "écotoxicologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ab7a42e1-03c7-32a2-b92c-1605c5f2f452",
                        "entry_id": "55001de2-421a-35c2-9daf-6afa0f91f348",
                        "glosses": [
                            "Branche de la toxicologie qui étudie des effets des substances polluantes sur les espèces, les populations et les environnements naturels."
                        ],
                        "tags": [
                            "Sciences de l’environnement",
                            "Toxicologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2c8d19cc-9a12-4a6e-877e-3d0554bf4a77",
                                "sense_id": "ab7a42e1-03c7-32a2-b92c-1605c5f2f452",
                                "text": "La réalisation d’essais d’écotoxicologie à principalement pour but de répondre aux exigences réglementaires françaises ou européennes (biocide, REACH, CLP, FDS,…), ou de communiquer sur l’innocuité de la substance ou du produit testé (label écologique, Ecolabel, Ecocert, …)."
                            },
                            {
                                "example_id": "79450ebc-f17a-4d4d-ad93-0877af5447fe",
                                "sense_id": "ab7a42e1-03c7-32a2-b92c-1605c5f2f452",
                                "text": "L’écotoxicologie est une discipline à l'interface entre l’écologie et la toxicologie, née de la reconnaissance du fait qu’un nombre croissant de toxiques ont contaminé et continuent à contaminer toute la biosphère."
                            }
                        ]
                    }
                ],
