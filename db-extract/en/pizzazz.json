                                                "example_id": "ff629377-0c4a-44c5-8856-ef10def1c66e",
                                                "sense_id": "cd055239-6a25-337f-9915-554fceb86ef6",
                                                "text": "In der Frühe ertönten drei Pfiffe."
                                            },
                                            {
                                                "example_id": "73e721c8-10fb-43a4-98fc-c6a0793ed3e2",
                                                "sense_id": "cd055239-6a25-337f-9915-554fceb86ef6",
                                                "text": "Sie haben mir auch den Pfiff gelehrt,",
                                                "translation": "Die anzeigt, wo Schätze verborgen sind. (aus Heinrich Heine: „Waldeinsamkeit“ Internet-Beleg)"
                                            },
                                            {
                                                "example_id": "a2c5d669-a4f3-4fb6-9c50-9c8a5ae8b1cf",
                                                "sense_id": "cd055239-6a25-337f-9915-554fceb86ef6",
                                                "text": "„Keine Minute mehr, und der Pfiff der Lokomotive schrillte durch die Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b6a2e63-5391-381d-84a4-de78350f7aca",
                                        "entry_id": "9bcc7658-3f14-32b1-bae5-bee69510b54b",
                                        "glosses": [
                                            "ein Trick, ein besonderer Reiz an etwas"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365f8c19-b10e-4cab-bd51-b8b54585793f",
                                                "sense_id": "5b6a2e63-5391-381d-84a4-de78350f7aca",
                                                "text": "„Pfiff hatte die Sache vom ersten Takt an mit einem hellwachen Museumsorchester.“ (www.oper-frankfurt.de Internet-Beleg)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
