                                        "sense_id": "fa844db1-ad4f-3f86-a585-151057b943de",
                                        "entry_id": "cd1ab83b-fb02-3217-9fb2-a791bd43eb64",
                                        "glosses": [
                                            "Synonyme de anulingus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4160fa1f-325d-447a-a888-de5404967885",
                                                "sense_id": "fa844db1-ad4f-3f86-a585-151057b943de",
                                                "text": "Ne faites pas feuille de rose à vos domestiques. C’est un service que vous pouvez leur demander mais qu’il est plus convenable de ne pas leur rendre."
                                            },
                                            {
                                                "example_id": "512abce2-e5bd-4bb3-b78d-77d0d5ff0130",
                                                "sense_id": "fa844db1-ad4f-3f86-a585-151057b943de",
                                                "text": "Par ailleurs, une pratique proche comme l’anulingus (et potentiellement plus vectrice de dégoût) a pu être dédramatisée en parlant de « feuille de rose » : peut- être est-ce une simple question de vocabulaire ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4889177f-d38f-381f-be7b-1e017ea1cf4c",
                                        "entry_id": "cd1ab83b-fb02-3217-9fb2-a791bd43eb64",
                                        "glosses": [
                                            "Synonyme de anomie pelure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c9c042-3be3-420f-8f85-0f84fb9be6ff",
                                                "sense_id": "4889177f-d38f-381f-be7b-1e017ea1cf4c",
                                                "text": "Anomia ephippium, Feuille de rose, encore appelée anomie, éclair, estafette, huître nacrée, luisette, pelure d'oignon : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91a4f0ec-cf66-4379-aee4-5762feb7e6c5",
                        "source_entry_id": "d0b30979-e0a3-30fa-9f2d-de26652ce0a9",
                        "source_sense_id": "2fbb69fd-542b-3dd6-a24e-7a9e90ad3fdc",
                        "source_sense_description": "bepaald soort vastgehecht oesterachtig schelpdier met een onregelmatige vorm, Anomia ephippium",
                        "target_lang_word": "pelure d’oignon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelure d’oignon",
