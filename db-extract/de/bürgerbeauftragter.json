                "senses": [
                    {
                        "sense_id": "52ae4a1c-c588-38d0-8a3b-733f0d28e597",
                        "entry_id": "80262baf-031d-34f9-826f-2ccd994684d6",
                        "glosses": [
                            "unabhängig agierende (männliche) Person, die häufig von einem Parlament gewählt wird und dem Petitionsausschuss angegliedert ist und deren Aufgabe es ist, die Bürger bei der Wahrnehmung ihrer Rechte gegenüber der öffentlichen Verwaltung zu unterstützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816ee18c-539f-4d8a-965d-3f12617cdfd5",
                                "sense_id": "52ae4a1c-c588-38d0-8a3b-733f0d28e597",
                                "text": "„Binnen Minuten gerät so eine holprige Beratung über die Drucksache 1189, das Gesetz über die Rechtsverhältnisse der Parlamentarischen Staatssekretäre und des Bürgerbeauftragten, zur Schlammschlacht“."
                            },
                            {
                                "example_id": "992bac44-e2e4-412b-b282-0b7ae90a6ec9",
                                "sense_id": "52ae4a1c-c588-38d0-8a3b-733f0d28e597",
                                "text": "„Er sah sich einst von der Stasi bespitzelt, wurde dann – zu Unrecht – selbst als Spitzel bezichtigt und steigt nun als Überläufer zum Dank für seine entscheidende Stimme zum Bürgerbeauftragten des neuen Landes auf.“"
                            },
                            {
                                "example_id": "344eb6f6-b9a9-4f4a-979b-c9a3be3a5c86",
                                "sense_id": "52ae4a1c-c588-38d0-8a3b-733f0d28e597",
                                "text": "„Formal ist dieser einzige Bürgerbeauftragte in der Bundesrepublik ein Hilfsorgan des Petitionsausschusses des Parlaments, folglich diesem untergeordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
