                ],
                "senses": [
                    {
                        "sense_id": "d4beb02d-7d0c-377e-99f0-0cca0290eb7e",
                        "entry_id": "0e729c2e-21ca-3f00-994b-820f74cf805c",
                        "glosses": [
                            "Höherwerden des (materiellen) Wertes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48bb0d4c-726e-4661-b666-59a1d9178068",
                                "sense_id": "d4beb02d-7d0c-377e-99f0-0cca0290eb7e",
                                "text": "„Immobilien unterliegen langfristig einer Wertsteigerung, die hauptsächlich aus zwei Faktoren gespeist wird: Grund und Boden sind knapp und können nicht vermehrt werden, trotz steigenden Bedarfs.“"
                            },
                            {
                                "example_id": "d0f146ce-e682-4518-82e2-de1d883a30c6",
                                "sense_id": "d4beb02d-7d0c-377e-99f0-0cca0290eb7e",
                                "text": "„Aktienkurse bilden die Wertsteigerung zwar über längere Zeiträume zuverlässig ab, sie eignen sich aber nicht, um den Erfolg kurzfristiger operativer Maßnahmen zu messen.“"
                            },
                            {
                                "example_id": "f26b4fac-4120-4796-b8c1-a61b08278e67",
                                "sense_id": "d4beb02d-7d0c-377e-99f0-0cca0290eb7e",
                                "text": "„Unbestritten bleibt, dass die Forderung nach finanzieller Wertsteigerung für das Unternehmen heute wichtiger ist denn je.“"
                            },
                            {
                                "example_id": "c02ef3cc-d1c4-4ee5-9335-79ea23ed6e98",
                                "sense_id": "d4beb02d-7d0c-377e-99f0-0cca0290eb7e",
                                "text": "„Unter Investoren in diesem Sinne sind sowohl gewerbliche Immobilieninvestoren als auch Privatpersonen zu verstehen, die in Immobilien investieren mit dem vorrangigen Ziel, Wertsteigerungen der Immobilien als Gewinnquelle zu erschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
