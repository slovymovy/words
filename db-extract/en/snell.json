                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "215f7c46-24f4-498a-b6fa-0ae7d63d5a3f",
                        "entry_id": "5be163f3-5499-3f58-ab24-bf92aef14841",
                        "tags": [
