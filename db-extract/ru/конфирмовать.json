                                            "Manglish",
                                            "Singlish",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "567c64e3-0e3c-4f3b-bca0-360ab75c8f24",
                                                "sense_id": "cd693b70-329d-3e8d-b3ab-6ae3d5a2406f",
                                                "text": "This is confirm not my handwriting."
                                            },
                                            {
                                                "example_id": "919dfb2c-9e30-45e7-9c89-508ddd2b1ded",
                                                "sense_id": "cd693b70-329d-3e8d-b3ab-6ae3d5a2406f",
