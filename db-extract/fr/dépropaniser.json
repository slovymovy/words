                "senses": [
                    {
                        "sense_id": "a68b29a4-8145-3fe3-bcfa-d57cf3709551",
                        "entry_id": "26459793-99fd-3ab9-bd2e-ed84670fa25e",
                        "glosses": [
                            "Enlever le propane (du pétrole ou d’un produit pétrolier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143c86c4-d5c3-44b6-9a24-0dfd2ad697bd",
                                "sense_id": "a68b29a4-8145-3fe3-bcfa-d57cf3709551",
                                "text": "Ce dernier est obtenu soit en ajoutant le gaz liquéfié (propane, butane) à l’huile, soit en se servant de celle-ci pour dépropaniser un gaz."
                            },
                            {
                                "example_id": "4968f748-615e-409b-9625-fdd25a2b3223",
                                "sense_id": "a68b29a4-8145-3fe3-bcfa-d57cf3709551",
                                "text": "On ne « débutanise » qu’une partie de l'essence – qu’on ajoute ensuite à la fraction seulement « dépropanisée » pour que les produits livrés à la consommation répondent à quelques spécifications et offrent notamment une certaine tension de vapeur à température fixe, par exemple 0,7 ou 0,8 kg à 38° (Ch. Berthelot)."
                            }
                        ]
                    }
