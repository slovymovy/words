                                                "example_id": "003493c2-bc4a-481b-bff3-3b9149000eac",
                                                "sense_id": "467b27cd-61e8-34f9-ba1b-68e2e0add339",
                                                "text": "Seine zwiebelförmige Nase hatte Größe und Form einer Rübe."
                                            },
