{
    "word_family": [
        "tar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f81d535d-a921-3946-89eb-d22063155368",
                    "sense_definition": "To delay; to be late or tardy in beginning or doing anything.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train will <w>tarry</w> at the station due to unexpected technical issues.",
                            "target_lang_translations": {
                                "zh": "由于意外的技术问题，火车将在车站<w>耽搁</w>。",
                                "pl": "Pociąg <w>zabawi</w> na stacji dłużej z powodu nieoczekiwanych problemów technicznych."
                            }
                        },
                        {
                            "text": "Do not <w>tarry</w> if you want to arrive on time for the meeting.",
                            "target_lang_translations": {
                                "zh": "如果你想准时参加会议，就不要<w>迟延</w>。",
                                "pl": "Nie <w>zwlekaj</w>, jeśli chcesz dotrzeć na spotkanie na czas."
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "procrastinate"
                    ],
                    "antonyms": [
                        "go",
                        "leave"
                    ],
                    "common_phrases": [
                        "do not tarry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "耽搁；迟延；在做某事时拖延。",
                        "pl": "Opóźniać się; zwlekać z rozpoczęciem lub wykonaniem czegoś."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "耽搁",
                                "target_lang_sense_clarification": "指因某种原因而停滞或延迟。"
                            },
                            {
                                "target_lang_word": "迟延",
                                "target_lang_sense_clarification": "指推迟时间，较为正式。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zwlekać",
                                "target_lang_sense_clarification": "odwlekanie wykonania jakiejś czynności w czasie"
                            },
                            {
                                "target_lang_word": "ociągać się",
                                "target_lang_sense_clarification": "powolne działanie lub niechęć do rozpoczęcia czegoś"
                            },
                            {
                                "target_lang_word": "opóźniać się",
                                "target_lang_sense_clarification": "bycie spóźnionym w stosunku do planu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63b66698-9b49-3844-b2b2-e15ba0c71776",
                    "sense_definition": "To stay somewhere temporarily.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers decided to <w>tarry</w> in the small village for a few days.",
                            "target_lang_translations": {
                                "zh": "旅行者们决定在那个小村庄<w>逗留</w>几天。",
                                "pl": "Podróżni postanowili <w>zatrzymać się</w> w małej wiosce na kilka dni."
                            }
                        },
                        {
                            "text": "He <w>tarried</w> in the city while waiting for his business affairs to conclude.",
                            "target_lang_translations": {
                                "zh": "他在城里<w>盘桓</w>，等待他的事务处理完毕。",
                                "pl": "<w>Zabawił</w> w mieście, czekając na zakończenie swoich spraw biznesowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "sojourn",
                        "stay"
                    ],
                    "antonyms": [
                        "leave"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "逗留；暂时居住在某处。",
                        "pl": "Zatrzymywać się gdzieś tymczasowo; przebywać w jakimś miejscu przez pewien czas."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "逗留",
                                "target_lang_sense_clarification": "指在某地暂时停留。"
                            },
                            {
                                "target_lang_word": "盘桓",
                                "target_lang_sense_clarification": "指徘徊或逗留，多用于文学语境。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zabawić",
                                "target_lang_sense_clarification": "przebywać w jakimś miejscu przez pewien czas"
                            },
                            {
                                "target_lang_word": "zatrzymać się",
                                "target_lang_sense_clarification": "przerwać podróż lub pobyt w danym miejscu"
                            },
                            {
                                "target_lang_word": "przebywać",
                                "target_lang_sense_clarification": "znajdować się w jakimś miejscu przez dłuższy czas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c76162f2-756b-3cd1-8876-22bca04f1ecb",
                    "sense_definition": "A sojourn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their brief <w>tarry</w> in the mountains was refreshing.",
                            "target_lang_translations": {
                                "zh": "他们在山里的短暂<w>逗留</w>令人心旷神怡。",
                                "pl": "Ich krótki <w>pobyt</w> w górach był orzeźwiający."
                            }
                        },
                        {
                            "text": "After a long <w>tarry</w> abroad, he finally returned home.",
                            "target_lang_translations": {
                                "zh": "在国外长期<w>逗留</w>后，他终于回到了家。",
                                "pl": "Po długim <w>pobycie</w> za granicą w końcu wrócił do domu."
                            }
                        }
                    ],
                    "synonyms": [
                        "stay",
                        "sojourn"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "逗留；暂住。",
                        "pl": "Tymczasowy pobyt w jakimś miejscu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "逗留",
                                "target_lang_sense_clarification": "指在某地停留的时间。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pobyt",
                                "target_lang_sense_clarification": "czas spędzony w danym miejscu"
                            },
                            {
                                "target_lang_word": "postój",
                                "target_lang_sense_clarification": "krótkotrwałe zatrzymanie się w trakcie podróży"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2d5e570-56df-3537-821c-e11c82fe3635",
                    "sense_definition": "Resembling tar.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tar_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road emitted a strong <w>tarry</w> smell under the hot summer sun.",
                            "target_lang_translations": {
                                "zh": "在炎炎夏日下，道路散发出浓烈的<w>焦油味</w>。",
                                "pl": "Droga wydzielała silny, <w>smolisty</w> zapach w gorącym letnim słońcu."
                            }
                        },
                        {
                            "text": "He noticed a <w>tarry</w> residue on his boots after walking through the construction site.",
                            "target_lang_translations": {
                                "zh": "走过建筑工地后，他发现靴子上沾有<w>焦油状</w>的残留物。",
                                "pl": "Zauważył <w>smolisty</w> osad na butach po przejściu przez plac budowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "pitchy"
                    ],
                    "common_phrases": [
                        "tarry scent"
                    ],
                    "target_lang_definitions": {
                        "zh": "像焦油的；有焦油味的。",
                        "pl": "Przypominający smołę; mający cechy lub zapach smoły."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "焦油状的",
                                "target_lang_sense_clarification": "形容物质外观或质地像焦油。"
                            },
                            {
                                "target_lang_word": "有焦油味的",
                                "target_lang_sense_clarification": "形容气味像焦油。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "smolisty",
                                "target_lang_sense_clarification": "mający konsystencję lub wygląd smoły"
                            },
                            {
                                "target_lang_word": "o zapachu smoły",
                                "target_lang_sense_clarification": "opisujący charakterystyczny, ostry zapach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fc546537-b4b4-3e47-bb8c-e0caa7a4616c",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Tarry</w> is our new neighbor.",
                            "target_lang_translations": {
                                "zh": "<w>塔里</w>先生是我们新来的邻居。",
                                "pl": "Pan <w>Tarry</w> jest naszym nowym sąsiadem."
                            }
                        },
                        {
                            "text": "The <w>Tarrys</w> are hosting a dinner party this evening.",
                            "target_lang_translations": {
                                "zh": "<w>塔里</w>一家今晚要举办晚宴。",
                                "pl": "Państwo <w>Tarry</w> wydają dziś wieczorem kolację."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "姓氏。",
                        "pl": "Nazwisko."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "塔里",
                                "target_lang_sense_clarification": "用于音译该姓氏。"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Tarry",
                                "target_lang_sense_clarification": "transkrypcja nazwiska własnego"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}