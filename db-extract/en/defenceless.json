                "senses": [
                    {
                        "sense_id": "c3ae0f61-945a-3bd7-bd65-0a946e4b5b8c",
                        "entry_id": "426c08ae-7405-3272-bea0-f1e387ed6df3",
                        "glosses": [
                            "Without defence; undefended."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "21581c24-a7c4-43e6-8b0d-fa1e0e079aea",
                                "sense_id": "c3ae0f61-945a-3bd7-bd65-0a946e4b5b8c",
                                "text": "Blind, deaf, and paralysed, the old man was defenceless; and the robbers easily stole all of his money."
                            },
                            {
                                "example_id": "7f62b577-1ac7-4bef-9c53-e17e109f5f76",
                                "sense_id": "c3ae0f61-945a-3bd7-bd65-0a946e4b5b8c",
                                "text": "The hawk, foul murderer of defenceless birds, has sighted the chicken on the bare patch."
                            },
                            {
                                "example_id": "f423607c-69be-4c6e-96e8-1a4dbe423a60",
                                "sense_id": "c3ae0f61-945a-3bd7-bd65-0a946e4b5b8c",
                                "text": "Railway engines have been attacked with gunfire by raiding aircraft on both sides of the Channel and the impression has grown up that they are defenceless monsters to be pestered with impunity. The first engine to disprove this vainglorious theory was, we are glad to note, a British one. [The locomotive boiler exploded, causing the aircraft to crash.]"
                            }
                        ]
                    }
                ],
