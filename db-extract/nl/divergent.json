                                "target_senses": [
                                    {
                                        "sense_id": "698491d5-0b6b-3eff-936d-78068d249edc",
                                        "entry_id": "41a5b7bf-e61b-37c7-9e59-0c6ff8f87a97",
                                        "glosses": [
                                            "Growing further apart; diverging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b93a161-6116-413c-bedc-e91328f9b8af",
                                                "sense_id": "698491d5-0b6b-3eff-936d-78068d249edc",
                                                "text": "Divergent thinking and transformations are, of course, no novel phenomena. They have always occurred in the translation process, but perhaps we have not been fully aware of them, or have not been able to categorise them with sufficient precision until now."
                                            },
                                            {
                                                "example_id": "7be5b3a7-d294-41a6-a763-fe342fc762da",
                                                "sense_id": "698491d5-0b6b-3eff-936d-78068d249edc",
                                                "text": "Four zebras stood despondent facing divergent directions like an old European film or a '90s band photo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db1991bb-37c3-3694-954a-7c299c1cfeb4",
                                        "entry_id": "41a5b7bf-e61b-37c7-9e59-0c6ff8f87a97",
                                        "glosses": [
                                            "(said of a sequence or series) Diverging; not approaching a limit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "355544da-f859-3ca1-9e27-b1e4b75db89f",
