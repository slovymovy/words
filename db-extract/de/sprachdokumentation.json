                "senses": [
                    {
                        "sense_id": "29ebb110-4ca4-37a3-b4b2-b283a11b201e",
                        "entry_id": "500d8f49-a1db-3b85-bfaa-cd9cdfc2f923",
                        "glosses": [
                            "das Zusammenstellen und Ordnen von Texten und Beschreibungen zu einer Sprache oder zu Sprachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec44702e-9cdc-47b8-81a6-1bdb5efc9e98",
                                "sense_id": "29ebb110-4ca4-37a3-b4b2-b283a11b201e",
                                "text": "„Das Projekt der Sprachdokumentation wurde maßgeblich von der VW-Stiftung gefördert, die ihren Sitz in Hannover hat.“"
                            },
                            {
                                "example_id": "bcd5b09e-b0c7-45ae-b1fc-e47a048b1e33",
                                "sense_id": "29ebb110-4ca4-37a3-b4b2-b283a11b201e",
                                "text": "„Sprachdokumentation beschäftigt sich in erster Linie mit Dokumentation und Deskription.“"
                            },
                            {
                                "example_id": "c1be3450-5915-4a30-ada4-eec47c8b1f45",
                                "sense_id": "29ebb110-4ca4-37a3-b4b2-b283a11b201e",
                                "text": "„Das Ziel des Masterstudiengangs Sprachdokumentation und Korpuslinguistik ist es, Studierenden einen theoretischen und praktischen Einstieg in die selbstständige Erforschung der Lexik, Grammatik und Phonetik gesprochener Sprache zu ermöglichen“"
                            },
                            {
                                "example_id": "84567647-f872-407b-aabf-15259d509016",
                                "sense_id": "29ebb110-4ca4-37a3-b4b2-b283a11b201e",
                                "text": "„Für die Sprachdokumentation in Leitstellen und Befehlsstellen der Polizei gelten folgende Grundsätze:…“"
                            },
                            {
                                "example_id": "3e2159cb-31c2-4073-a4c0-ea521c64d687",
                                "sense_id": "29ebb110-4ca4-37a3-b4b2-b283a11b201e",
                                "text": "„\"Das ist echte Pionierarbeit\", lautet das Urteil von Nikolaus Himmelmann, \"und ein unglaublicher Schub für die Sprachdokumentation in technologischer Hinsicht.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
