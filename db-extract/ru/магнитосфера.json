                        "source_sense_id": "3c316a7a-e10c-3db6-a2d6-7ce1e138947c",
                        "target_lang_word": "Magnetosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnetosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                                        "entry_id": "e7ada7ed-0738-31f9-812e-9a44455d52a9",
                                        "glosses": [
                                            "das Raumgebiet um einen Planeten oder Stern, in dem das Magnetfeld des Objektes dominiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1914388-1baa-4748-bcb7-b1f0039e8738",
                                                "sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                                                "text": "„Die Magnetosphäre der Erde ist typisch für die Magnetosphären von Planeten mit eigenem Magnetfeld.“"
                                            },
                                            {
                                                "example_id": "0ae325e4-6dda-4669-ba2d-4848bc0ef165",
                                                "sense_id": "a4de3fb5-517b-3835-b08d-998246f1479c",
                                                "text": "„Polarlichter entstehen, wenn elektrisch geladene Teilchen aus der Magnetosphäre (hauptsächlich Elektronen, aber auch Protonen) auf Sauerstoff- und Stickstoffatome in den oberen Schichten der Erdatmosphäre treffen und diese ionisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5146511b-ad5c-4b6b-9a24-db5abf2607c4",
                        "source_entry_id": "fbffc64e-c64f-3518-aa9f-50323cda4ef4",
                        "source_sense_id": "3c316a7a-e10c-3db6-a2d6-7ce1e138947c",
                        "target_lang_word": "magnetosfeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetosfeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3b1fde9a-1137-3dd7-ad41-434a56ada67d",
                                        "entry_id": "73fccf15-7d7b-311e-b00e-e37432eaea6a",
                                        "glosses": [
                                            "een zone rond een planeet met een magneetveld die daardoor beschermd wordt tegen de zonnewind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b78f787-7f27-4d69-8b43-6dfe9b2088a3",
                                                "sense_id": "3b1fde9a-1137-3dd7-ad41-434a56ada67d",
                                                "text": "Zonder magnetosfeer zou het leven op aarde blootstaan aan vernietigende straling."
                                            }
