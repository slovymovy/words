                    {
                        "sense_id": "4e979032-7df2-3695-a64b-479275eeedf3",
                        "entry_id": "37d63cf2-aaba-3ec9-a193-6ebfa990cfe5",
                        "glosses": [
                            "To freeze again."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9e40ae20-d91f-4116-af1c-95105ceb08d7",
                                "sense_id": "4e979032-7df2-3695-a64b-479275eeedf3",
                                "text": "We've had another cold snap and the lake has refrozen."
                            },
                            {
                                "example_id": "6f217f9a-e74e-4dea-b813-959a370f55ce",
                                "sense_id": "4e979032-7df2-3695-a64b-479275eeedf3",
                                "text": "Successive falls of snow had thawed, or partially thawed, seeped into the ballast and, as temperatures dropped again, refrozen."
                            },
                            {
                                "example_id": "5a8c0635-3bef-4fee-85d4-dc3c1151ecca",
                                "sense_id": "4e979032-7df2-3695-a64b-479275eeedf3",
                                "text": "It's not a good idea to refreeze raw meat once it has been thawed."
                            }
                        ]
                    }
