                                    {
                                        "sense_id": "8cac72dc-23b2-3dfc-a6fc-97f3c0a3081e",
                                        "entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
                                        "glosses": [
                                            "The act of despairing or becoming desperate; a giving up of hope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf22fdf-8d5c-47ed-a424-0665275093e1",
                                                "sense_id": "8cac72dc-23b2-3dfc-a6fc-97f3c0a3081e",
                                                "text": "in desperation"
                                            },
                                            {
                                                "example_id": "faa410ac-03f2-4ce7-b442-cf2cfa38bd93",
                                                "sense_id": "8cac72dc-23b2-3dfc-a6fc-97f3c0a3081e",
                                                "text": "utter desperation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b61cfb9-5246-30b5-889b-5f1b13fb7c29",
                                        "entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
                                        "glosses": [
                                            "A state of despair, or utter hopelessness; abandonment of hope."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33693d11-26fb-40cb-b932-bb18ef4c8b94",
                                                "sense_id": "1b61cfb9-5246-30b5-889b-5f1b13fb7c29",
                                                "text": "The mass of men lead lives of quiet desperation. What is called resignation is confirmed desperation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "455c595b-03f2-3cab-8a43-6506ab2fe929",
                                        "entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
                                        "glosses": [
                                            "Reckless fury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2073da55-21e6-344c-a7a4-e40ba0f6f1a8",
                                        "entry_id": "e00f73a0-c4b7-3497-a78c-51e9a615fbee",
                                        "glosses": [
                                            "Ellipsis of bladder desperation."
                                        ],
                                        "tags": [
                                            "abbreviation",
