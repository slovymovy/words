                "forms": [],
                "senses": [
                    {
                        "sense_id": "296b77e6-47ab-3535-934e-39b39e83cb33",
                        "entry_id": "220d175a-3cf6-3fb6-b6e8-ac23c9793719",
                        "glosses": [
                            "pływający, zakotwiczony znak nawigacyjny zaokrąglonego kształtu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "03b93dde-b11e-35d2-bff8-24d756f8d463",
                        "entry_id": "220d175a-3cf6-3fb6-b6e8-ac23c9793719",
                        "glosses": [
                            "element sieci rybackiej służący do utrzymywanie jej we właściwej pozycji"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a24822b-4ac2-4dd1-a004-a38086e494f5",
                        "source_entry_id": "220d175a-3cf6-3fb6-b6e8-ac23c9793719",
                        "source_sense_id": "296b77e6-47ab-3535-934e-39b39e83cb33",
                        "target_lang_word": "Boje",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Boje",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24c56693-b03c-38ea-9f75-b0b96fd72db3",
                                        "entry_id": "fb01cf0d-1bc5-3469-ad15-a5885b21a04b",
                                        "glosses": [
                                            "schwimmender Körper, der (am Grund verankert) dem Festmachen von Schiffen oder Booten dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98f23596-9382-4e27-84fc-8cd42e4be507",
                                                "sense_id": "24c56693-b03c-38ea-9f75-b0b96fd72db3",
                                                "text": "„Privatbesitzern von Bojen wird empfohlen, ihre Boje und die Kette, alle 2-4 J. auf Abnützung und eventuelle Schäden zu überprüfen.“"
                                            },
                                            {
                                                "example_id": "881a0ba9-df98-461b-bf4e-14a1c83682dc",
                                                "sense_id": "24c56693-b03c-38ea-9f75-b0b96fd72db3",
                                                "text": "„Der Hall kam wieder, höher jetzt, klagend und verschwebend, als läute eine unsichtbare Boje warnend im Nebenmeer.“"
                                            },
                                            {
                                                "example_id": "9a9cf9e7-c809-40a6-8d8c-c5da8557f83b",
                                                "sense_id": "24c56693-b03c-38ea-9f75-b0b96fd72db3",
                                                "text": "„Sie ging zur Nordseite, vorbei an Pontons und Bootsschuppen, roten Bojen, die in den Wellen tanzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d9e48ba-e01e-3d33-a631-6774bbd78ab5",
                                        "entry_id": "fb01cf0d-1bc5-3469-ad15-a5885b21a04b",
                                        "glosses": [
                                            "(nicht verankerte) Treibboje (beispielsweise als Instrumententräger für die Forschung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7563ca-5845-41d6-b687-185a162f464a",
                                                "sense_id": "0d9e48ba-e01e-3d33-a631-6774bbd78ab5",
                                                "text": "„Eine Treibboje ist eine Boje ohne Befestigung am Grund. Weitere gebräuchliche Bezeichnungen sind Drifter, Driftboje, Float(er) und Floating Drifter. Treibbojen werden bei der Meeresforschung, aber auch in Binnengewässern eingesetzt, um Messdaten wie beispielsweise Meeresströmungsverhältnisse, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5d4c387-8b99-38ee-aae4-5c851c3b458a",
                                        "entry_id": "fb01cf0d-1bc5-3469-ad15-a5885b21a04b",
                                        "glosses": [
                                            "als Markierung für den Anker eines Schiffes/Bootes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd916b26-b40c-4352-a3b7-efa6b57e46b4",
                                                "sense_id": "c5d4c387-8b99-38ee-aae4-5c851c3b458a",
                                                "text": "„Die Ankerboje wird am Anker befestigt, ein Rollenaufzug ähnlich dem eines Staubsaugerkabels verkürzt das Gurtband auf die jeweilige Wassertiefe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "96b72e06-4754-35cf-aded-f99d671bb310",
                                        "entry_id": "fb01cf0d-1bc5-3469-ad15-a5885b21a04b",
                                        "glosses": [
                                            "schwimmende (meist verankerte) Seezeichen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04e4c0f-bbca-40ea-92b2-7d089763a3b9",
                                                "sense_id": "96b72e06-4754-35cf-aded-f99d671bb310",
                                                "text": "Seezeichen: „Es handelt sich um verschiedene Arten von Bojen, Tonnen und Landmarken, wie Leuchttürme, Richtfeuer, Leitfeuer und Quermarkenfeuer, die den Verkehr auf See regeln. Sie sind in farbig gekennzeichnet und die wichtigsten sind auch in den Seekarten eingezeichnet.“"
                                            },
                                            {
                                                "example_id": "7a7d74e9-032e-4545-ba36-27a447c25473",
                                                "sense_id": "96b72e06-4754-35cf-aded-f99d671bb310",
                                                "text": "„Mit der Gelassenheit eines Buddhas schaukelt das Kind an der Wasseroberfläche wie eine große Boje und lässt sich von den Wellen treiben, die seine Mutter in ihrer Erziehungswut hochwirbelt.“"
                                            },
                                            {
                                                "example_id": "51a49fb8-e0ca-421d-a834-d340bd5d1cc8",
                                                "sense_id": "96b72e06-4754-35cf-aded-f99d671bb310",
                                                "text": "„Dann bog er nach rechts und hielt direkt auf die gelben Bojen zu, die auf der schimmernden Wasseroberfläche der Lagune undeutlich auszumachen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a2689dd6-45d3-356f-814b-6a82a9019e13",
                                        "entry_id": "fb01cf0d-1bc5-3469-ad15-a5885b21a04b",
                                        "glosses": [
                                            "technische Einrichtung im Inneren eines Schwimmkörpers zur Ortung, Analyse und Wasseraufbereitung rundum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e8f121-4650-4c14-a2cf-102dc7c7b97e",
                                                "sense_id": "a2689dd6-45d3-356f-814b-6a82a9019e13",
                                                "text": "„Sonarbojen werden zur U-Bootortung oder zur Ortung anderer Schallquellen unter Wasser eingesetzt. Hierzu werden die Sonarbojen üblicherweise von einem Flugzeug oder einem Hubschrauber in einem vorgegebenen Zielgebiet abgeworfen. Durch den Aufschlag auf die Wasseroberfläche wird ein Hydrophon aktiviert und sinkt an einem Draht auf eine vorgegebene Tiefe. Die von der Boje empfangenen Signale des Hydrophons werden anschließend beispielsweise an das Flugzeug oder den Hubschrauber oder an eine andere zentrale Stelle zur Auswertung gesendet.“"
                                            },
                                            {
                                                "example_id": "729d9786-6348-40de-b24a-863afc3c9878",
                                                "sense_id": "a2689dd6-45d3-356f-814b-6a82a9019e13",
                                                "text": "„Die Lebensdauer der autonomen Bojen hängt von der Batterielebensdauer und den Eisverhältnissen ab.[…] Die Bojen wurden meist in einem geordneten Muster mit Abständen bis zu 100km ausgelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc9ef44d-9db1-4120-b519-7cb20a0aded3",
                        "source_entry_id": "220d175a-3cf6-3fb6-b6e8-ac23c9793719",
                        "source_sense_id": "03b93dde-b11e-35d2-bff8-24d756f8d463",
                        "target_lang_word": "Schwimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8cf4f5-e29a-3a16-9320-9a9490cc7dd4",
                                        "entry_id": "c82c67c4-4fc2-3fa0-82e2-903df903787c",
                                        "glosses": [
                                            "schwimmender Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b392e20-cfc3-46f1-8307-af7eba488a31",
                                                "sense_id": "5c8cf4f5-e29a-3a16-9320-9a9490cc7dd4",
                                                "text": "Die Wettkämpfe der Schwimmer versprechen spannend zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                        "entry_id": "c82c67c4-4fc2-3fa0-82e2-903df903787c",
                                        "glosses": [
                                            "ein Auftriebskörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8d35bf-18be-4d1f-a296-2a3df17d473b",
                                                "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                                "text": "Zwei Schwimmer geben dem Wasserflugzeug den nötigen Auftrieb."
                                            },
                                            {
                                                "example_id": "eacbb05e-335d-40e8-9dab-1abad3c23285",
                                                "sense_id": "9e460871-6c4e-389c-8a81-3a0822d1a7c6",
                                                "text": "„Der Schwimmer hüpfte hin und wieder an die Oberfläche, und die Leine wurde schlaff.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
