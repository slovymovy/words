                                "target_senses": [
                                    {
                                        "sense_id": "b5277043-ade7-3b3f-afc8-a9800c59963d",
                                        "entry_id": "16c9a587-0735-30dc-85ea-93a0ac9936bd",
                                        "glosses": [
                                            "The activity of taking part in a dance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49f23268-f2a3-320b-bbdb-2d6024cd2aa8",
                                        "entry_id": "16c9a587-0735-30dc-85ea-93a0ac9936bd",
                                        "glosses": [
                                            "A dance club in France."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81c4320e-0f16-4569-b5df-3a1028bfb6a1",
                                                "sense_id": "49f23268-f2a3-320b-bbdb-2d6024cd2aa8",
                                                "text": "New dancings pervaded the length and breadth of Montmartre in order to suit the taste of foreign patrons."
                                            },
                                            {
                                                "example_id": "00273bcf-13ab-472f-b98c-e0620bb42d8f",
                                                "sense_id": "49f23268-f2a3-320b-bbdb-2d6024cd2aa8",
                                                "text": "Different dancings also attracted different crowds. Indeed, the diversity of dancers throughout the city makes drawing a detailed portrait of them difficult."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dancing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7469af6-46cb-342b-8fa4-20af2d182dae",
                                        "entry_id": "710d9c70-9940-3bce-9d6e-792506e8ba87",
                                        "glosses": [
                                            "present participle and gerund of dance"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23f7caf6-b5db-4ec9-9a03-b0f6cfb6365d",
                        "source_entry_id": "3f99b77e-b10d-3004-bb57-cab7ccc84fc3",
                        "target_lang_word": "dancing",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dancing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                        "entry_id": "afbd5132-232c-3c39-b805-87b0ef342f20",
                                        "glosses": [
                                            "Établissement public conçu pour danser."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f338e672-a76f-4c1e-815d-a4a5bcfc313d",
                                                "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                                "text": "Les Berlinois de la Société ne fréquentent jamais ce dancing vulgaire où la jeunesse brune et les « sous-offs » de la garnison fraternisent."
                                            },
                                            {
                                                "example_id": "02777674-0f2d-4829-bbfd-4d4ace635e71",
                                                "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                                "text": "Deux des Allemands leur ont parlé d’un dancing curieux où l’on trouve des taxi-boys."
                                            },
                                            {
                                                "example_id": "5b061bea-8b28-4a8d-b4cb-d4cd4850b583",
                                                "sense_id": "370e6785-edc5-376d-8c19-44e44d1c1365",
                                                "text": "Lorsqu'il a racheté ce petit dancing, en 1986, ce n'était qu'un modeste « parquet » où les sexagénaires des villages entre Narbonne et Béziers aimaient se retrouver le samedi soir pour danser le tango et la valse au rythme d'un orchestre local. L'endroit était franchement has been et la clientèle s'amenuisait. « Le Gentleman » était, à l'époque, une espèce de construction provisoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
