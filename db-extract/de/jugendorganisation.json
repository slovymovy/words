                "senses": [
                    {
                        "sense_id": "a41f0ddf-431c-30f7-b793-83cfbc84f0dd",
                        "entry_id": "d8ea332c-7053-33b3-84af-2cfa77add4c0",
                        "glosses": [
                            "Einrichtung oder Organisation speziell für Jugendliche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb51bba9-169e-43a5-9380-621da1e962f1",
                                "sense_id": "a41f0ddf-431c-30f7-b793-83cfbc84f0dd",
                                "text": "„Vor zwei Wochen brannte das Anton-Schmaus-Haus (ASH) der Jugendorganisation Falken in Neukölln.“"
                            },
                            {
                                "example_id": "94416481-0b0e-4db7-8381-f7e06fc678f3",
                                "sense_id": "a41f0ddf-431c-30f7-b793-83cfbc84f0dd",
                                "text": "„Dennoch nahm ihr politischer Einfluss in den vergangenen Jahrzehnten beträchtlich zu, und zwar nicht nur über eigene Parteien, sondern auch über deren militante Flügel und Jugendorganisationen.“"
                            },
                            {
                                "example_id": "fa6c98ff-515a-4b79-a38e-35a6e812271c",
                                "sense_id": "a41f0ddf-431c-30f7-b793-83cfbc84f0dd",
                                "text": "„Nach ghanaischem Vorbild gründete er eine eigene Jugendorganisation der NDP, die im Wesentlichen für die von der Partei ausgehende Einschüchterung und Gewalt verantwortlich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
