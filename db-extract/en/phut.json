                    {
                        "sense_id": "e8a6c28b-54f3-36be-adc5-6a52bccceda3",
                        "entry_id": "fa2663c4-989d-33fc-8424-5fd32c25dfa1",
                        "glosses": [
                            "A representation of the sound resembling the release of a blast of steam or exhaust gas; a representation of the sound of a fast but small puff of wind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84366438-db4f-49ed-8de2-89d7622c31a6",
                                "sense_id": "e8a6c28b-54f3-36be-adc5-6a52bccceda3",
                                "text": "\"Phut.\" Something whipped into the ground beside him and there was a pinpoint flash from the cabin. \"B-o-i-n-g-g-g.\" There was another flash and the bullet hit the rail and whined off into the night."
                            },
                            {
                                "example_id": "55a88051-d040-47d4-aefd-54b7228a0355",
                                "sense_id": "e8a6c28b-54f3-36be-adc5-6a52bccceda3",
                                "text": "Then she heard the phut-phut-phut of an unfamiliar boat engine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
