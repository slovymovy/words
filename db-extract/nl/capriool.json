                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49ba8f63-b2be-3c5f-84bc-48cb9085be84",
                                        "entry_id": "c2267bd6-f84e-38f7-b543-4a9899fa99bc",
                                        "glosses": [
                                            "kunstvoller Luftsprung italienischer Tänzer"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6f7d01-278b-466c-9ab7-3ebaba4e7df8",
                                                "sense_id": "49ba8f63-b2be-3c5f-84bc-48cb9085be84",
                                                "text": "Die Tänzer schlugen Kapriolen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee504d63-314a-335a-a03b-71153defecf8",
                                        "entry_id": "c2267bd6-f84e-38f7-b543-4a9899fa99bc",
                                        "glosses": [
                                            "lustiger Sprung oder artistische Vorführung im Zirkus oder Varieté"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1881c43c-6b23-393c-8c37-fce6e7d069db",
                                        "entry_id": "c2267bd6-f84e-38f7-b543-4a9899fa99bc",
                                        "glosses": [
                                            "ein übermütiger Streich oder verrückter Einfall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e210d317-e572-426a-946d-4a9790360782",
                                                "sense_id": "1881c43c-6b23-393c-8c37-fce6e7d069db",
                                                "text": "Deine Kapriolen habe ich langsam satt!"
                                            },
                                            {
                                                "example_id": "1020127d-62f7-4a60-b181-4e35d8e9bd07",
                                                "sense_id": "1881c43c-6b23-393c-8c37-fce6e7d069db",
                                                "text": "„Wer einmal Leuten zugehört hat, die engagiert die abwegigsten Mythen vertreten, wird die Einlassungen von Wielands Don Sylvio/Pedrillo nicht mehr als nur der Unterhaltung wegen ersonnene Kapriolen lesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "73730d8a-2f81-3ba5-9c5b-c742c8aa5cf1",
                                        "entry_id": "c2267bd6-f84e-38f7-b543-4a9899fa99bc",
                                        "glosses": [
                                            "eine besondere Sprung-Übung der Hohen Schule in der klassischen Reitkunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd368415-7884-4fdd-aa1b-e16b29bdfa29",
                                                "sense_id": "73730d8a-2f81-3ba5-9c5b-c742c8aa5cf1",
                                                "text": "An der Kapriole solltest du noch etwas feilen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2563cb70-1e1f-420c-b507-ddc716dcff88",
                        "source_entry_id": "a4b64665-93d1-3a28-9b5e-7e5c6d2d60b9",
                        "source_sense_id": "d97b048e-2337-3ee1-a3b1-459c57ae19e4",
                        "source_sense_description": "paardensprong",
                        "target_lang_word": "shenanigan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shenanigan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                                        "entry_id": "ab302818-c73f-3930-a330-2fa047f9212b",
                                        "glosses": [
                                            "singular of shenanigans: a deceitful confidence trick; also, an act of mischief; a prank, a trick; an act of mischievous play, especially by children."
                                        ],
                                        "tags": [
                                            "countable",
                                            "form-of",
                                            "in-plural",
                                            "informal",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a65fff05-be5c-4c21-b72c-5f854d1cd3de",
                                                "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                                                "text": "I spotted his next shenanigan—saw it coming—and so avoided being fooled."
                                            },
                                            {
                                                "example_id": "e63985f9-4ede-4484-a977-37ade5f0e37c",
                                                "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                                                "text": "He then would state some of the principles of the party; First of all he would have them know it was on the square! and why was it on the square? Why? Because it didn't intend to \"come the shenanigan\"—that was it!"
                                            },
                                            {
                                                "example_id": "87b58585-7436-4867-9a28-95bbf938f3ad",
                                                "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                                                "text": "Abstrusus–In your answers to correspondence last week is given a definition to which I must except: An Irish word which you write ‘shenanigan’ is defined as being synonymous with our English word ‘humbug,’ thus depriving the natives of ‘the Breast-pin of the Ocean’ of the credit of great shrewdness in the use of the word."
                                            },
                                            {
                                                "example_id": "8763d4c0-7b46-4247-be16-21a01692a333",
                                                "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                                                "text": "We have a host of eagle-eyed natives, who will stand by the polls, and see that no shenanigan is played."
                                            },
                                            {
                                                "example_id": "f8e8a2fb-968c-4b17-b717-a99b9d159c30",
                                                "sense_id": "c2a6c0d4-e3ad-32a7-86dd-a712dcecaa89",
                                                "text": "A longtime friend of [Ann] Richards and co-conspirator in many a shenanigan and act of political skulduggery, she [Liz Carpenter] had decided early in the fall to act on her conviction that something important had gone out of politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b963b6d-c6b3-3ec4-9aa3-c8bab588effd",
                                        "entry_id": "ab302818-c73f-3930-a330-2fa047f9212b",
                                        "glosses": [
                                            "Dishonest, underhanded, or unscrupulous activities or behaviour; skulduggery, trickery; also, mischievous behaviour or play; high jinks."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e2ce2ce-ccd1-489c-bcd8-8364e974139a",
                                                "sense_id": "3b963b6d-c6b3-3ec4-9aa3-c8bab588effd",
                                                "text": "One of Professor [John] Moon's most astonishing \"experiments,\" consisted of holding a watch suspended from a short chain at arm's length, and allowing anyone in the pit to pull pistol and \"blaze away\" at the word \"fire,\" whereupon the watch would most unconscionably disappear. An individual who had attended several evenings and witnessed the \"experiment,\" suspected, in the classic language of the times, that there was something of \"shenanigan\" in it."
                                            },
                                            {
                                                "example_id": "de2e05e0-47e1-4acf-b858-e70ad29b08a9",
                                                "sense_id": "3b963b6d-c6b3-3ec4-9aa3-c8bab588effd",
                                                "text": "There are stories still told how money was used and promised, but from the best knowledge I can acquire, I think this is not true. If sharp practice was played, and \"shenanigan\" was used, we, to-day, looking back upon those times, cannot say that evil has come of it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shenanigan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1094e4a-b657-34fb-a817-01139c48b0cc",
                                        "entry_id": "5a4dc44b-e464-3978-a46c-3ae213b8d78e",
                                        "glosses": [
                                            "To play a deceitful confidence trick on (someone); to swindle, to trick; also, to carry out an act of mischief on (someone); to prank."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397dc9f8-5758-40e0-8ad0-14abe273cbd4",
                                                "sense_id": "d1094e4a-b657-34fb-a817-01139c48b0cc",
                                                "text": "The habit of \"shenaniganing\" has become so disgracefully common at Union college that some of the right minded students have passed resolutions condemning the practice in unqualified terms. We are happy to inform the friends of Michigan University that this unmusical word, which, translated means the use of artificial aids, in examinations, is almost wholly unknown here."
                                            },
                                            {
                                                "example_id": "05e624e9-ddcc-44b4-9d7e-6c7cbdc4e3f5",
                                                "sense_id": "d1094e4a-b657-34fb-a817-01139c48b0cc",
                                                "text": "I must have looked sceptical regarding the squirrel, as I informed him that I had not much appetite just then; but he assured me he was not \"shenan-neganning\" me, and that the dish would prove a delicacy."
                                            },
                                            {
                                                "example_id": "9521ce0a-3ba7-46e7-8331-343ca0065b18",
                                                "sense_id": "d1094e4a-b657-34fb-a817-01139c48b0cc",
                                                "text": "Gosh, I never was so shenaniganned in all my life."
                                            },
                                            {
                                                "example_id": "70b99e6c-72c3-4f3f-8ca0-b57c19310426",
                                                "sense_id": "d1094e4a-b657-34fb-a817-01139c48b0cc",
                                                "text": "Then Jim, the man that was in charge of the booths, […] says, \"It's too large. It has to be a regular size.\" I said, \"Look, it can't go back, and we have the place reserved. I've already paid for it.\" I don't know, he shenaniganed something."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e17318ee-f5be-3234-b6e2-edc3c6d3073e",
                                        "entry_id": "5a4dc44b-e464-3978-a46c-3ae213b8d78e",
                                        "glosses": [
                                            "To play a deceitful confidence trick; also, to carry out an act of mischief."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1190db5e-b36f-46a8-bc85-a85f51b25a37",
                                                "sense_id": "e17318ee-f5be-3234-b6e2-edc3c6d3073e",
                                                "text": "Then after much shenaniganing around over a period of several weeks […] we came into the committee room after this \"night study\" which I understand too place, and some of the Members had the bill we are now considering in a mimeographed form and some of us did not have it."
                                            },
                                            {
                                                "example_id": "7e1ea6bc-19de-4bfe-a60d-92c14aecf449",
                                                "sense_id": "e17318ee-f5be-3234-b6e2-edc3c6d3073e",
                                                "text": "Was it merely a ruse to ensure that the people during that period of 12 months got used to the idea that the workshop would close, and gradually reconciled themselves to it? It does not look as if they have, but I suggest that that is one reason the Government shenaniganed around with the people of Wanganui."
                                            },
                                            {
                                                "example_id": "04b54df9-8bed-4c1f-9684-aff0e95df7d1",
                                                "sense_id": "e17318ee-f5be-3234-b6e2-edc3c6d3073e",
                                                "text": "I'm just shenaniganning with you. Keep your hair in your face and your mouth shut and it will be fine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4fdfb76-dab2-4548-bf4a-c9157bea7722",
                        "source_entry_id": "a4b64665-93d1-3a28-9b5e-7e5c6d2d60b9",
                        "source_sense_id": "d97b048e-2337-3ee1-a3b1-459c57ae19e4",
                        "source_sense_description": "paardensprong",
                        "target_lang_word": "cabriole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabriole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e84a32c-8bc8-3de9-b71d-238bc27a39d9",
                                        "entry_id": "a1f33d34-f0f8-31bd-b688-ae1c199d9892",
                                        "glosses": [
                                            "Saut d’une personne qui s’élève ou se retourne sur elle-même avec agilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9277ebe2-4f12-41b3-b769-c70a25dd5450",
                                                "sense_id": "9e84a32c-8bc8-3de9-b71d-238bc27a39d9",
                                                "text": "Faire la cabriole, une cabriole, des cabrioles."
                                            },
                                            {
                                                "example_id": "6a595398-bb20-4596-bc7d-764f39e46d15",
                                                "sense_id": "9e84a32c-8bc8-3de9-b71d-238bc27a39d9",
                                                "text": "Moi, je me plie à leurs fantaisies sans discuter. Je marche à quatre pattes ; je fais des cabrioles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0eb9cf5-ca6f-35ad-8bb0-827c00f9dfc2",
                                        "entry_id": "a1f33d34-f0f8-31bd-b688-ae1c199d9892",
                                        "glosses": [
                                            "Faire une cabriole involontaire, lors d’une chute."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "100a78b4-9085-4bb1-b5ed-ef0672dc6788",
                                                "sense_id": "f0eb9cf5-ca6f-35ad-8bb0-827c00f9dfc2",
                                                "text": "– Ah! monsieur veut parler de ma cabriole dans la crevasse, répondit Coutet?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b75d2aaf-73c0-38f7-bf5b-20ecd686f6cf",
                                        "entry_id": "a1f33d34-f0f8-31bd-b688-ae1c199d9892",
                                        "glosses": [
                                            "Saut que le cheval exécute lorsque, étant en l’air, le devant et le derrière à la même hauteur, il détache la ruade ; capriole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d10b942-2da0-410c-bb25-7f8253fca66c",
                                                "sense_id": "b75d2aaf-73c0-38f7-bf5b-20ecd686f6cf",
                                                "text": "La cabriole ou capriole diffère de la croupade et de la ballottade, en ce que cet air de manège est plus élevé que ceux-ci, et que le cheval n'avance de son saut que d'environ trente à trente-cinq centimètres, ou même qu'il le fait sur place, imitant ainsi le saut de la chèvre, d'où lui vient, du reste, le nom ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c23819-aee4-325a-98ea-b0c9af446810",
                                        "entry_id": "a1f33d34-f0f8-31bd-b688-ae1c199d9892",
                                        "glosses": [
                                            "Grimaces, plaisanterie dont on se sert comme d’une échappatoire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ee9fdf-f723-4956-9068-9ca7d60c8930",
                                                "sense_id": "96c23819-aee4-325a-98ea-b0c9af446810",
                                                "text": "Il s’en est tiré par une cabriole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6b073f0-9d84-33ad-81f3-5ad5d3ae7601",
                                        "entry_id": "a1f33d34-f0f8-31bd-b688-ae1c199d9892",
                                        "glosses": [
                                            "Chambre."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631de602-9081-4168-ab84-cb46afecf86c",
                                                "sense_id": "a6b073f0-9d84-33ad-81f3-5ad5d3ae7601",
                                                "text": "Rincer une cabriole veut dire dévaliser une chambre."
                                            }
