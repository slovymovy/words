                },
                {
                    "sense_id": "9ce4e57f-64c2-3bfe-b04a-51f9afdaaed2",
                    "sense_definition": "Region or locality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You won't find many bears in these <w>diggings</w> anymore.",
                            "target_lang_translations": {
                                "ru": "В этих <w>краях</w> медведей больше особо не встретишь.",
                                "tr": "Artık bu <w>civarda</w> pek fazla ayı bulamazsın."
                            }
                        },
                        {
                            "text": "He is a stranger to these <w>diggings</w> and does not know the roads.",
                            "target_lang_translations": {
                                "ru": "Он чужак в этих <w>местах</w> и не знает дорог.",
                                "tr": "O bu <w>tarafların</w> yabancısıdır ve yolları bilmez."
                            }
                        }
                    ],
