                        "cross_references": [
                            {
                                "target_word": "anhédonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7e6ed3-4e05-3006-a15d-07b0b4a9dc2b",
                                        "entry_id": "b982d004-6f4e-3f71-92a2-a3275de2c607",
                                        "glosses": [
                                            "Incapacité à éprouver du plaisir dans des situations ordinaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17359138-f6ac-40a7-a071-c62420ee66a1",
                                                "sense_id": "9e7e6ed3-4e05-3006-a15d-07b0b4a9dc2b",
                                                "text": "« L’anhédonie, soit la perte de plaisir à faire des activités qui nous font d’habitude du bien, est un des symptômes fondamentaux de la dépression », explique le psychiatre Boris Chaumette."
                                            },
                                            {
                                                "example_id": "7a84dfc2-9238-455d-95c9-53c58493a3f9",
                                                "sense_id": "9e7e6ed3-4e05-3006-a15d-07b0b4a9dc2b",
                                                "text": "C’est ainsi que l’apathie et l’anhédonie ont fait l’objet de nombreux travaux, tout d'abord dans le cadre de la schizophrénie et de maladies neurologiques comme la maladie de Parkinson et la maladie d’Alzheimer, puis plus récemment dans celui de la dépression."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
