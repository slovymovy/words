                                "example_id": "c32602bb-652f-49eb-9917-ae68b0fe7b7b",
                                "sense_id": "68a0f950-40cc-3f9d-80d3-6d8a116e4ae9",
                                "text": "Do we really have to euthanatize my hamster?",
                                "translation": "Müssen wir meinen Hamster wirklich einschläfern?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
