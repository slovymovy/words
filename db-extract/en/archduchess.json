                        "tags": [
                            "plural"
                        ],
                        "form": "archduchesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "303aec57-cf56-3fff-98c1-9a42af86a8a7",
                        "entry_id": "d1e30861-9d85-33f0-ab4b-c7a0705258e4",
                        "glosses": [
                            "A daughter or granddaughter of the Emperor of Austria-Hungary, or the wife of a son or grandson of the Emperor of Austria-Hungary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4c7a1b-a391-402e-8918-b2272ebe7aa7",
                                "sense_id": "303aec57-cf56-3fff-98c1-9a42af86a8a7",
                                "text": "If that weren’t enough, in 1993 she married Karl von Habsburg, otherwise known as Archduke Karl of Austria, Prince Royal of Hungary and Bohemia, and the couple set up home in Salzburg, producing two archduchesses and an archduke."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a259d51-f9bc-4f60-b027-b511c1323158",
                        "source_entry_id": "d1e30861-9d85-33f0-ab4b-c7a0705258e4",
                        "source_sense_id": "303aec57-cf56-3fff-98c1-9a42af86a8a7",
                        "source_sense_description": "daughter or granddaughter of the Emperor of Austria-Hungary",
                        "target_lang_word": "arcivévodkyně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arcivévodkyně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "514497a2-b982-3b64-90f0-493aab436642",
                                        "entry_id": "33dcfa74-d009-3d96-88f3-22465303683b",
                                        "glosses": [
                                            "titul příslušnice habsburského rodu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feb1bb36-226c-46fb-992b-59c583014685",
                                                "sense_id": "514497a2-b982-3b64-90f0-493aab436642",
                                                "text": "Padly i titule knížecí, hraběcí, baronské — a arcivévodové zmizeli vůbec a také arcivévodkyně. Těch litujeme nejméně."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efbf0d8c-4864-412c-8015-81244fefd352",
                        "source_entry_id": "d1e30861-9d85-33f0-ab4b-c7a0705258e4",
                        "source_sense_id": "303aec57-cf56-3fff-98c1-9a42af86a8a7",
                        "source_sense_description": "daughter or granddaughter of the Emperor of Austria-Hungary",
                        "target_lang_word": "aartshertogin",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aartshertogin",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "84f25274-ea52-31c2-82ec-c895a0478b85",
                                        "entry_id": "51beaafd-6456-366e-bea2-107dd99db6bd",
                                        "glosses": [
                                            "adellijke titel, vrouw van een aartshertog"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "116b1636-f937-4319-9142-e807807000cb",
                                                "sense_id": "84f25274-ea52-31c2-82ec-c895a0478b85",
                                                "text": "Maar zijn herinnering aan het verblijf op het jacht werd toch in de eerste plaats gekleurd door het lenige lichaam van de aartshertogin van Luxemburg, die er in een bont gezelschap van Hollywoodacteurs, Duitse en Spaanse adel, een wereldberoemde operadiva en een bekende mediatycoon en scheepsmagnaat haar achttiende verjaardag had gevierd."
                                            },
                                            {
                                                "example_id": "88562eba-d5e1-490d-8341-fb7b95bf0b9c",
                                                "sense_id": "84f25274-ea52-31c2-82ec-c895a0478b85",
                                                "text": "Op zijn vlucht terug naar Nederland waren zijn gedachten om de vijf minuten afgedwaald naar de onverzadigbare aartshertogin, en elke keer voelde hij zijn oogleden zwaar worden en dommelde hij een paar minuten weg."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
