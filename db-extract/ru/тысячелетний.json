                                    },
                                    {
                                        "sense_id": "c8b59364-9ea7-34a7-b8c8-c77130a36c41",
                                        "entry_id": "fc7e0fc5-7eb2-35cd-a321-9f88abef4d79",
                                        "glosses": [
                                            "trwający tysiąc lat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45d2b48a-ec18-4ea6-af61-8634661c49cf",
                                                "sense_id": "c8b59364-9ea7-34a7-b8c8-c77130a36c41",
                                                "text": "Teofil też dobrze go znał i dlatego wiedział, że wódz Tysiącletniej Rzeszy był dziwakiem"
                                            }
                                        ],
