                "senses": [
                    {
                        "sense_id": "44142d13-4e22-3856-862f-e655aeab348d",
                        "entry_id": "22d5f182-35d9-3591-91be-b5c576dbf9c9",
                        "glosses": [
                            "botsing met een voertuig, ongeval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff43bdc9-4e7a-4707-a7ab-c61c8bd81cbe",
                                "sense_id": "44142d13-4e22-3856-862f-e655aeab348d",
                                "text": "Na de aanrijding zat er een grote deuk in de bak van de vrachtauto maar er waren gelukkig geen gewonden of doden te betreuren."
                            },
                            {
                                "example_id": "abc35dc8-215d-4626-bf64-777ae953e742",
                                "sense_id": "44142d13-4e22-3856-862f-e655aeab348d",
                                "text": "Om een aanrijding te voorkomen, week ik uit naar links, slipte een beetje, en op dat moment doemde er in de bocht een tegemoetkomende vrachtwagen op."
                            },
                            {
                                "example_id": "d09f704d-62ff-4af4-98d3-0e629201cbbf",
                                "sense_id": "44142d13-4e22-3856-862f-e655aeab348d",
                                "text": "'Diederich Schulz heeft zijn nek gebroken tijdens een wandeling door de bergen bij Pirna en Peter Wulka werd slachtoffer van een aanrijding."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d586fa7-afb0-415b-b32b-2820296a553f",
                        "source_entry_id": "22d5f182-35d9-3591-91be-b5c576dbf9c9",
                        "source_sense_id": "44142d13-4e22-3856-862f-e655aeab348d",
                        "source_sense_description": "botsing met een voertuig",
                        "target_lang_word": "Zusammenstoß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenstoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8390e74-a1c8-38a2-b460-ec53dc2efc9b",
                                        "entry_id": "f388e5e1-aff7-316f-af14-001044abaca0",
                                        "glosses": [
                                            "das ungewollte Aufeinanderprallen von sich bewegenden Fahrzeugen oder Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bd894ce-686b-4096-aa5d-9eb77bfc78c0",
                                                "sense_id": "f8390e74-a1c8-38a2-b460-ec53dc2efc9b",
                                                "text": "Es gibt immer mehr Zusammenstöße von Skifahrern, die mit schwersten Verletzungen oder sogar tödlich enden."
                                            },
                                            {
                                                "example_id": "9854ca60-c467-4d7b-bc77-fee15b186d89",
                                                "sense_id": "f8390e74-a1c8-38a2-b460-ec53dc2efc9b",
                                                "text": "Der Zusammenstoß der Flugzeuge war eine Folge der Übermüdung des Fluglotsen."
                                            },
                                            {
                                                "example_id": "14b38669-7e57-4a55-8bb2-975654928610",
                                                "sense_id": "f8390e74-a1c8-38a2-b460-ec53dc2efc9b",
                                                "text": "„Dann fiel mir der tragische Zusammenstoß bei Willdon wieder ein und all die Menschen, die jetzt Grund zur Trauer hatten, und ich war abermals den Tränen nahe.“"
                                            },
                                            {
                                                "example_id": "e114fbd5-8705-4abd-bedd-35179149d4fa",
                                                "sense_id": "f8390e74-a1c8-38a2-b460-ec53dc2efc9b",
                                                "text": "„Nach einem Zusammenstoß mit einem Paragleiter ist am Samstagnachmittag auf der Hohen Wand [---] ein 61-jähriger Drachenflieger abgestürzt.“"
                                            },
                                            {
                                                "example_id": "dc327524-1afe-42c1-a581-922ade7b0cb2",
                                                "sense_id": "f8390e74-a1c8-38a2-b460-ec53dc2efc9b",
                                                "text": "„Immer wieder lehnten die Pfadfinder ein großes rotes A gegen eine der Nummern, wenn ein Motordefekt, ein Zusammenstoß oder Headlong Corner ein neues Opfer gefordert hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b855c37c-20ef-3237-b6e8-3e9174a2f87c",
                                        "entry_id": "f388e5e1-aff7-316f-af14-001044abaca0",
                                        "glosses": [
                                            "Streit, heftige ausgefochtene Meinungsverschiedenheit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0e9f2b-7b49-4148-9b53-701dd378b046",
                                                "sense_id": "b855c37c-20ef-3237-b6e8-3e9174a2f87c",
                                                "text": "Wir hatten letztes Jahr einen unerfreulichen Zusammenstoß mit unseren Nachbarn wegen der Schneeräumpflicht. Jetzt reden wir gar nicht mehr miteinander."
                                            },
                                            {
                                                "example_id": "86deac42-d4ed-4cf7-ad32-3727ee1e2f57",
                                                "sense_id": "b855c37c-20ef-3237-b6e8-3e9174a2f87c",
                                                "text": "„Im Südwesten Chinas ist es zu Zusammenstößen zwischen Tibetern und chinesischen Sicherheitskräften gekommen. Ausgelöst wurden die Unruhen von der Selbstverbrennung eines tibetischen Mannes.“"
                                            },
                                            {
                                                "example_id": "45a64736-007d-424d-a64f-9c40f16089ee",
                                                "sense_id": "b855c37c-20ef-3237-b6e8-3e9174a2f87c",
                                                "text": "„Gleichzeitig organisierten sie in den Städten, in denen sie die Mehrheit hatten, gewaltige Massenkundgebungen, die oft genug zu blutigen Zusammenstößen mit tschechischen Demonstranten führten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd4c07bc-eb24-432c-acbe-a155d01db598",
                        "source_entry_id": "22d5f182-35d9-3591-91be-b5c576dbf9c9",
