        "fr-extract.jsonl": [
            {
                "entry_id": "b1941c40-2aeb-354f-9832-cff61c848f3b",
                "word": "ahurissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f60d7b26-b0b0-491f-b0d9-f208f1b7fde4",
                        "entry_id": "b1941c40-2aeb-354f-9832-cff61c848f3b",
                        "tags": [
                            "plural"
                        ],
                        "form": "ahurissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80662dc0-7e10-3937-9c1a-56333edb364a",
                        "entry_id": "b1941c40-2aeb-354f-9832-cff61c848f3b",
                        "glosses": [
                            "État d’une personne ahurie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6e1e5741-b5ef-402e-bbc1-9dd7be4a1d66",
                                "sense_id": "80662dc0-7e10-3937-9c1a-56333edb364a",
                                "text": "Les chefs de gare ne savaient auquel entendre, les hommes d'équipe étaient dans l'ahurissement. A chaque halte nouvelle, c'était une débandade."
                            },
                            {
                                "example_id": "af1e7aca-1fa8-4406-81f6-ce5104de8ba0",
                                "sense_id": "80662dc0-7e10-3937-9c1a-56333edb364a",
                                "text": "[…]; puis il céda à l'aphasie, s'accota au placard, les bras collés aux cuisses, image vivante de l'animal assailli par un invincible ahurissement."
                            },
                            {
                                "example_id": "623424c9-a515-4205-894b-71efc94d2874",
                                "sense_id": "80662dc0-7e10-3937-9c1a-56333edb364a",
                                "text": "On y distingue aussi un ahurissement à la Chariot, que les désinvoltures montmartroises et 'tout-parisiennes n'ont que masqué; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b06b1aa1-fa1c-4022-ae12-548430924883",
                        "source_entry_id": "b1941c40-2aeb-354f-9832-cff61c848f3b",
                        "source_sense_id": "80662dc0-7e10-3937-9c1a-56333edb364a",
                        "target_lang_word": "Verblüffung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verblüffung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                        "entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
                                        "glosses": [
                                            "das Verblüfftsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0403c31-c752-48a0-b339-3d001ad4f91f",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Die Verblüffung stand ihm ins Gesicht geschrieben."
                                            },
                                            {
                                                "example_id": "6562d9b7-2fd2-477b-873e-984916cc22cd",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Sie schien die Verblüffung ihres Angestellten nicht zu verstehen."
                                            },
                                            {
                                                "example_id": "b973adfb-e8b1-40b6-b0c3-60953aa0a2e2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Weil er von der Feier bereits wusste, musste er seine Verblüffung vorheucheln."
                                            },
                                            {
                                                "example_id": "158271fb-c364-4b4f-8d91-98b0a9a320f9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Zu ihrer großen Verblüffung stellte sie fest, dass zu diesem Begriff kein Eintrag im Wörterbuch existierte."
                                            },
                                            {
                                                "example_id": "d71fdd03-8cda-4ea1-86d4-0d6479d9eff9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Es fiel mir nicht schwer, ihr Freude zu machen durch eine große Verblüffung über die völlige Auffrischung ihres Haushalts.“"
                                            },
                                            {
                                                "example_id": "ef427031-dff6-46b9-b440-55449c833fd7",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Milde Verblüffung steht in Lampes Gesicht, als er den Digestor gründlich mustert.“"
                                            },
                                            {
                                                "example_id": "41160c7a-85d5-4001-b3d8-11653d15bed2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Eine Minute verging in allgemeiner Verblüffung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
