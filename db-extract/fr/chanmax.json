                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25afee03-574d-4356-ac35-a718b2222d61",
                                                "sense_id": "dd294d90-7474-308e-9f18-1c4ee04481cf",
                                                "text": "Genuine cowards follow wicked people and cannot reliably sustain any virtue."
                                            },
                                            {
                                                "example_id": "161ea16a-e728-417b-8d54-47709d885a32",
                                                "sense_id": "dd294d90-7474-308e-9f18-1c4ee04481cf",
                                                "text": "The wicked flee when no man pursueth: but the righteous are bolde as a lyon."
                                            },
                                            {
                                                "example_id": "5a96a642-8b75-4e15-8269-c4d5d649502f",
                                                "sense_id": "dd294d90-7474-308e-9f18-1c4ee04481cf",
                                                "text": "“Yes,” replied she; “and the saddest part of it all is that she is not marrying the man she loves. Oh, it is terrible. Marrying from a sense of duty! I think it is perfectly wicked, and I told her so.”"
                                            },
                                            {
                                                "example_id": "4dbfc1cc-cb7e-4947-b82c-a209372913c4",
                                                "sense_id": "dd294d90-7474-308e-9f18-1c4ee04481cf",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            },
                                            {
                                                "example_id": "4894e06c-57ac-49aa-8af8-09ac76d2bc52",
                                                "sense_id": "dd294d90-7474-308e-9f18-1c4ee04481cf",
                                                "text": "What a wicked game to play, to make me feel this way / What a wicked thing to do, to let me dream of you / What a wicked thing to say, you never felt this way"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a2d62d-23c1-348d-a883-2f8f86b1c6d5",
                                        "entry_id": "38bf1336-b867-3fb0-8623-450aa6fe610b",
                                        "glosses": [
                                            "Harsh; severe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37cb2687-c97d-48b7-b0ac-10dea588bc91",
                                                "sense_id": "e1a2d62d-23c1-348d-a883-2f8f86b1c6d5",
                                                "text": "wicked wind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5eef875e-db13-373d-8c84-d441470c56c1",
                                        "entry_id": "38bf1336-b867-3fb0-8623-450aa6fe610b",
                                        "glosses": [
                                            "Excellent; awesome; masterful."
