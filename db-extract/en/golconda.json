                "translations": [
                    {
                        "translation_id": "12a48ae2-94da-4bc1-89dc-e32e21a50224",
                        "source_entry_id": "ff2f8ba3-0403-31ed-9e5e-bd817c2de02d",
                        "source_sense_description": "ruined city in Telangana, India",
                        "target_lang_word": "Golconde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golconde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c9939a1-ca0b-340e-802c-6523487d70a5",
                                        "entry_id": "a2100631-ef0a-3649-b95b-0bc92e6e9624",
                                        "glosses": [
                                            "Ancienne capitale du royaume du même nom, située dans l'État indien du Télangana, autrefois célèbre pour ses mines de diamants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df9a66b0-6491-446b-84ac-6c9d97cf6a72",
                                                "sense_id": "0c9939a1-ca0b-340e-802c-6523487d70a5",
                                                "text": "Plus loin est le petit fort de Paliacate, appartenant aux Hollandais ; c’est de là qu’ils vont acheter des diamants dans la nababie de Golconde."
                                            },
                                            {
                                                "example_id": "5a33b4b9-27ad-43d2-b695-989a6362ed7e",
                                                "sense_id": "0c9939a1-ca0b-340e-802c-6523487d70a5",
                                                "text": "« Elle juge que le sien est mieux. C’est à voir… Le mien aussi était mieux. Mais Colombe pense que le Balabi est une perle de Golconde… »"
                                            },
                                            {
                                                "example_id": "58fc1a9b-2002-4bd7-af1f-daad4f214504",
                                                "sense_id": "0c9939a1-ca0b-340e-802c-6523487d70a5",
                                                "text": "Tes yeux sont mon Pérou ma Golconde mes Indes"
                                            },
                                            {
                                                "example_id": "f5a28828-9c56-40f9-8b96-a62c39566ecf",
                                                "sense_id": "0c9939a1-ca0b-340e-802c-6523487d70a5",
                                                "text": "Il faut payer ceux qu’on aime. Plus on aime, plus il faut payer cher. Mais il y en a qui, voulant donner les trésors de Golconde, n’ont à leur disposition que cinquante baïoques. Comme tu es mon fils, je sais que tu ne te moqueras jamais de ceux-là."
                                            },
                                            {
                                                "example_id": "7f90524a-7039-431a-ae3f-f938cd0f1c13",
                                                "sense_id": "0c9939a1-ca0b-340e-802c-6523487d70a5",
                                                "text": "Je donnerai tous les trésors de Golconde pour une belle paire de fesses !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
