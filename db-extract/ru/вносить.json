                    },
                    {
                        "sense_id": "db82328b-71d3-3131-8d20-7720dc0944f1",
                        "entry_id": "9b0f9ce2-3d22-3840-9a2f-3ecc22d282b3",
                        "glosses": [
                            "to bring in / about, to cause, to introduce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5d665d-e0ab-4e87-ab21-e12fec236e3a",
                                "sense_id": "db82328b-71d3-3131-8d20-7720dc0944f1",
                                "text": "вноси́ть разла́д в семью́",
                                "translation": "to cause dissension in the family",
                                "english": "to cause dissension in the family"
                            },
                            {
                                "example_id": "aef66109-f71f-4e8a-a47a-2681c944977d",
                                "sense_id": "db82328b-71d3-3131-8d20-7720dc0944f1",
                                "text": "вноси́ть оши́бку",
                                "translation": "to introduce an error",
                                "english": "to introduce an error"
                            },
                            {
                                "example_id": "26de2c97-5075-44d7-8610-0b7095a25b09",
                                "sense_id": "db82328b-71d3-3131-8d20-7720dc0944f1",
                                "text": "вноси́ть оживле́ние",
                                "translation": "to brighten up",
                                "english": "to brighten up"
                            },
                            {
                                "example_id": "645a4ffd-59fe-4525-ae62-45741cc28398",
                                "sense_id": "db82328b-71d3-3131-8d20-7720dc0944f1",
                                "text": "вноси́ть беспоря́док",
                                "translation": "to cause disorder, to bring about disorder",
                                "english": "to cause disorder, to bring about disorder"
                            }
                        ]
                    },
                    {
                        "sense_id": "f8f1cc8d-ad9c-3372-aacd-0326ec0650c7",
                        "entry_id": "9b0f9ce2-3d22-3840-9a2f-3ecc22d282b3",
                        "glosses": [
                            "to enter, to include, to insert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a1b067d-319f-4320-af49-9bd3978f91de",
                                "sense_id": "f8f1cc8d-ad9c-3372-aacd-0326ec0650c7",
                                "text": "вноси́ть усоверше́нствование",
                                "translation": "to introduce an improvement",
                                "english": "to introduce an improvement"
                            },
                            {
                                "example_id": "3788fcb6-bc7b-4211-be54-745b14b9693d",
                                "sense_id": "f8f1cc8d-ad9c-3372-aacd-0326ec0650c7",
                                "text": "вноси́ть измене́ния",
                                "translation": "to make alterations / changes",
                                "english": "to make alterations / changes"
                            },
                            {
                                "example_id": "24cc6b0b-8f89-4516-b9af-3093026611de",
                                "sense_id": "f8f1cc8d-ad9c-3372-aacd-0326ec0650c7",
                                "text": "вноси́ть попра́вки",
                                "translation": "to insert / introduce amendments (into)",
                                "english": "to insert / introduce amendments (into)"
                            },
                            {
                                "example_id": "988dd4d9-8b7b-4538-ac51-9cc8cf72786d",
                                "sense_id": "f8f1cc8d-ad9c-3372-aacd-0326ec0650c7",
                                "text": "вноси́ть в спи́сок",
                                "translation": "to enter in the list, to put on the list, enroll",
                                "english": "to enter in the list, to put on the list, enroll"
                            }
                        ]
                    },
