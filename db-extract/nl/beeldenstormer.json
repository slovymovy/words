                                "target_senses": [
                                    {
                                        "sense_id": "9abf6035-f153-3d16-8822-4e9238a1f4c3",
                                        "entry_id": "10615ac7-01b2-3290-8b99-f8b7487a299f",
                                        "glosses": [
                                            "Destructor de imágenes, en especial refiriéndose a los secuaces de León III, el Isáurico, que prohibió el culto de las imágenes sagradas en el año 726."
                                        ],
                                        "tags": [
                                            "se usa también como sustantivo"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03183e8c-f61d-371e-ab18-9105daf41a1f",
                                        "entry_id": "10615ac7-01b2-3290-8b99-f8b7487a299f",
                                        "glosses": [
                                            "Por extensión, se aplica a ciertas sectas protestantes."
                                        ],
                                        "tags": [
                                            "se usa también como sustantivo"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "013618d8-4a20-3281-945d-e6f1403a18bb",
                                        "entry_id": "10615ac7-01b2-3290-8b99-f8b7487a299f",
                                        "glosses": [
                                            "Se aplica al rebelde que desconoce normas, maestros y autoridades."
                                        ],
                                        "tags": [
                                            "se usa también como sustantivo"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
