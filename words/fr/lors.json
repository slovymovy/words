                        "dès lors",
                        "depuis lors",
                        "pour lors"
                    ]
                },
                {
                    "sense_id": "a6ccf91c-cfd6-336a-a668-5f7f5ed01fd3",
                    "sense_definition": "Quand, au moment où ; employé autrefois en deux mots dans la locution « lors que ».",
