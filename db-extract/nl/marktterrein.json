                    {
                        "sense_id": "4d7023ae-2f62-3a76-8e07-430da598f52c",
                        "entry_id": "0480d25b-38b1-32fe-a631-d5799d5c67e3",
                        "glosses": [
                            "een openbare plek, zoals een plein of terrein, waar markt wordt gehouden, met name voor de handel in goederen en diensten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ff64d74-ea32-45ea-8a63-1ab597d53b56",
                                "sense_id": "4d7023ae-2f62-3a76-8e07-430da598f52c",
                                "text": "Hier aan de voorkant van het marktterrein waren de kramen het duurst vanwege de reusachtige aanloop, en hier stonden de handelaren die hij kende."
                            },
                            {
                                "example_id": "968de1d5-b975-4657-8f21-063c871b567c",
                                "sense_id": "4d7023ae-2f62-3a76-8e07-430da598f52c",
                                "text": "En toen hij opkeek was hij in het hart van het marktterrein beland, daar waar het gros van de handelaren zich verzamelde, waar de dieren stonden die geschikt waren voor de slacht, die voldoende vlees aan de botten hadden en gunstig genoeg geprijsd waren om de koper in staat te stellen een redelijke verkoopprijs te bepalen en tegelijkertijd een gezond bedrijfsresultaat te boeken."
                            }
                        ]
                    }
