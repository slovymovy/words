                "senses": [
                    {
                        "sense_id": "08dd7dee-7b61-3e85-b116-7bc6150215ab",
                        "entry_id": "78fb65ff-412c-37c4-b6be-123de3d1c805",
                        "glosses": [
                            "Friser les cheveux et les mettre en boucles."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "14d3623b-ea90-4cdd-8c8d-d4fa4ae25f09",
                                "sense_id": "08dd7dee-7b61-3e85-b116-7bc6150215ab",
                                "text": "Il se peignait chaque matin, calamistrait ses fines moustaches, s’habillait peut-être à Londres et se parfumait avec discrétion. Il représenta le dandysme républicain dans le grand ministère, avec M. Antonin Proust."
                            },
                            {
                                "example_id": "ec3ce114-695f-4f1f-9a14-4202718d6055",
                                "sense_id": "08dd7dee-7b61-3e85-b116-7bc6150215ab",
                                "text": "Il soigne sa toilette, il se calamistre le poil."
                            },
                            {
                                "example_id": "8d0393f6-111a-41da-a5ec-c6123179dbb6",
                                "sense_id": "08dd7dee-7b61-3e85-b116-7bc6150215ab",
                                "text": "Désormais, il calamistrait ses cheveux noirs, ramenés vers l’arrière. Il les ordonnait avec soin : deux ailes de choucas rayonnant sur les tempes à partir d’un sillon médian."
                            }
                        ]
                    }
                ],
