                "senses": [
                    {
                        "sense_id": "403a8c2e-1b4c-3723-822d-995cca6e65b6",
                        "entry_id": "66650062-2752-35b3-8345-61a13ec9852b",
                        "glosses": [
                            "Vorrichtung aus Kunststoff zum Abdecken oder Verschließen oberhalb von Etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e47f7d-34d0-4cb2-b3f6-0b5e12b3df96",
                                "sense_id": "403a8c2e-1b4c-3723-822d-995cca6e65b6",
                                "text": "„Haben auch Sie einen Kunststoffdeckel, den Sie entwickeln und produzieren lassen wollen ?“"
                            },
                            {
                                "example_id": "90f96436-5e29-46de-8ca5-4395fd7e913f",
                                "sense_id": "403a8c2e-1b4c-3723-822d-995cca6e65b6",
                                "text": "„Praktische Versandrohre mit Kunststoffdeckel und -boden, besonders stabil durch diagonale Wicklung und Klebung.“"
                            },
                            {
                                "example_id": "9c6679dd-0e39-42bb-b322-89eff6d888fa",
                                "sense_id": "403a8c2e-1b4c-3723-822d-995cca6e65b6",
                                "text": "„Kunststoffdeckel für Suppenschalen, Eintopfschalen oder Kaffeebecher finden Sie hier bei gastroline24.de. Besonders in Altenpflegeheimen/ Seniorenheimen oder Krankenhäuser finden die Kunststoffdeckel Anwendung.“"
                            },
                            {
                                "example_id": "d2e0b7aa-69c4-49b5-ab41-013af32b9eb2",
                                "sense_id": "403a8c2e-1b4c-3723-822d-995cca6e65b6",
                                "text": "Der breite Silikonboden sorgt für Standfestigkeit. Praktisch mit dicht schließendem Kunststoffdeckel. Ideal für Transport und Vorrat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
