                    {
                        "sense_id": "5d2cb187-9ad1-3535-974c-ae5e2c32b8c3",
                        "entry_id": "6223815f-256b-3416-8cb7-4aa7aa83e5f9",
                        "glosses": [
                            "Meriting, worthy (reward, punishment etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9976e1d-aa85-47ea-ad09-298bc0b28dbe",
                                "sense_id": "5d2cb187-9ad1-3535-974c-ae5e2c32b8c3",
                                "text": "In the midst of a world war many centenaries pass unnoticed, but one which fell on August 2, namely, the opening of Fenchurch Street station, is deserving of record."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fae2ec6a-c27e-4042-a683-e46d59903205",
                        "source_entry_id": "6223815f-256b-3416-8cb7-4aa7aa83e5f9",
                        "source_sense_description": "worthy of reward or praise",
                        "target_lang_word": "loffelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
