{
    "word_family": [
        "dismayed",
        "dismaying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48110e1d-c82a-30fe-abc2-f23c0f061566",
                    "sense_definition": "A sudden or complete loss of courage and firmness in the face of trouble or danger; a feeling of disappointment and distress.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked in <w>dismay</w> at the destruction of the town caused by the hurricane.",
                            "target_lang_translations": {
                                "ru": "Он со <w>смятением</w> смотрел на разрушения в городе, вызванные ураганом."
                            }
                        },
                        {
                            "text": "The news of the sudden budget cuts was met with <w>dismay</w> by the entire staff.",
                            "target_lang_translations": {
                                "ru": "Новость о внезапном сокращении бюджета была встречена всем персоналом с <w>тревогой</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "consternation"
                    ],
                    "antonyms": [
                        "encouragement",
                        "satisfaction"
                    ],
                    "common_phrases": [
                        "look in dismay",
                        "to someone's dismay",
                        "express dismay",
                        "deep dismay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная или полная потеря мужества и твердости перед лицом беды или опасности; чувство разочарования и тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смятение",
                                "target_lang_sense_clarification": "состояние сильного волнения и растерянности"
                            },
                            {
                                "target_lang_word": "тревога",
                                "target_lang_sense_clarification": "чувство беспокойства и ожидания беды"
                            },
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "подавленное состояние духа"
                            },
                            {
                                "target_lang_word": "испуг",
                                "target_lang_sense_clarification": "внезапное чувство страха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62cdbba9-a066-3b74-8684-c4db6eb5ae5b",
                    "sense_definition": "A state of ruin or a condition that causes overwhelming fear or loss of spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins stood as a silent <w>dismay</w> to the once great civilization.",
                            "target_lang_translations": {
                                "ru": "Древние руины стояли как безмолвное свидетельство <w>запустения</w> некогда великой цивилизации."
                            }
                        },
                        {
                            "text": "The sheer <w>dismay</w> of the battlefield left the young soldiers speechless.",
                            "target_lang_translations": {
                                "ru": "Сам <w>ужас</w> поля боя лишил молодых солдат дара речи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to describe a condition of ruin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние разрухи или условие, вызывающее подавляющий страх или упадок духа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "состояние крайнего страха или разрухи"
                            },
                            {
                                "target_lang_word": "запустение",
                                "target_lang_sense_clarification": "состояние разрухи, вызывающее печаль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfc704a7-3f12-36b4-95f4-8d0efec65315",
                    "sense_definition": "To cause someone to feel concern, distress, or a loss of courage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to discourage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complexity of the new regulations might <w>dismay</w> even the most experienced lawyers.",
                            "target_lang_translations": {
                                "ru": "Сложность новых правил может <w>обескуражить</w> даже самых опытных юристов."
                            }
                        },
                        {
                            "text": "It did not <w>dismay</w> her to find that she had to start the project over.",
                            "target_lang_translations": {
                                "ru": "Ее не <w>расстроило</w> то, что ей пришлось начинать проект заново."
                            }
                        }
                    ],
                    "synonyms": [
                        "daunt",
                        "appall",
                        "terrify"
                    ],
                    "antonyms": [
                        "encourage",
                        "hearten"
                    ],
                    "common_phrases": [
                        "dismay the opposition",
                        "not be dismayed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо почувствовать беспокойство, тревогу или потерю мужества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "приводить в состояние волнения"
                            },
                            {
                                "target_lang_word": "ужасать",
                                "target_lang_sense_clarification": "вызывать чувство сильного страха"
                            },
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "лишать уверенности или желания действовать"
                            },
                            {
                                "target_lang_word": "приводить в уныние",
                                "target_lang_sense_clarification": "заставлять терять бодрость духа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3056caa-657b-3d5c-bd5f-a834eca5e1c5",
                    "sense_definition": "To completely subdue, disquiet, or render someone powerless or lifeless.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "to discourage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>dismay</w> yourself for this minor setback in your career.",
                            "target_lang_translations": {
                                "ru": "Не <w>изводите</w> себя из-за этой незначительной неудачи в карьере."
                            }
                        },
                        {
                            "text": "The harsh winter winds seemed to <w>dismay</w> the very spirit of the travelers.",
                            "target_lang_translations": {
                                "ru": "Казалось, суровые зимние ветры <w>сокрушают</w> сам дух путешественников."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "meaning to subdue or render lifeless"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью подавить, обеспокоить или лишить кого-либо сил или жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угнетать",
                                "target_lang_sense_clarification": "лишать сил и воли к жизни"
                            },
                            {
                                "target_lang_word": "сокрушать",
                                "target_lang_sense_clarification": "полностью подавлять дух"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b34f5327-0163-3585-a4e7-fef649c21eb5",
                    "sense_definition": "To become filled with fright or to experience a sudden loss of spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "to discourage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers did not <w>dismay</w> at the sight of the approaching army.",
                            "target_lang_translations": {
                                "ru": "Солдаты не <w>ужаснулись</w> при виде приближающейся армии."
                            }
                        },
                        {
                            "text": "He told his followers to <w>dismay</w> not, for victory was near.",
                            "target_lang_translations": {
                                "ru": "Он велел своим последователям не <w>падать духом</w>, ибо победа была близка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "intransitive use meaning to take fright"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполниться страхом или испытать внезапную потерю духа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасаться",
                                "target_lang_sense_clarification": "приходить в состояние сильного страха"
                            },
                            {
                                "target_lang_word": "падать духом",
                                "target_lang_sense_clarification": "терять мужество и надежду"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}