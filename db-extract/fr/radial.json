                "senses": [
                    {
                        "sense_id": "7238c2ba-47ff-3cfd-b6e7-ded0b19a2cd5",
                        "entry_id": "cc0471c5-ad71-3731-b447-21e2a3df9234",
                        "glosses": [
                            "Qui a rapport au radius."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c04bcdcf-86f4-3d42-8a3e-19056c1e0e42",
                        "entry_id": "cc0471c5-ad71-3731-b447-21e2a3df9234",
                        "glosses": [
                            "Du côté de la main ou de l’avant-bras proche du radius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eadbf91-a36f-4afc-af2b-aee5b6fed7c2",
                                "sense_id": "c04bcdcf-86f4-3d42-8a3e-19056c1e0e42",
                                "text": "Statistiquement, c’est habituellement du côté ulnaire que cette artère dominante est retrouvée pour l’index et le troisième doigt, du côté radial pour les quatrième et cinquième doigts."
                            },
                            {
                                "example_id": "98ac3b44-adca-4e5c-bb7e-270343f207ac",
                                "sense_id": "c04bcdcf-86f4-3d42-8a3e-19056c1e0e42",
                                "text": "Le nerf radial."
                            },
                            {
                                "example_id": "2c886602-a6c5-4a7e-b99b-005f579d38d5",
                                "sense_id": "c04bcdcf-86f4-3d42-8a3e-19056c1e0e42",
                                "text": "La veine radiale."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5801d27-ba7e-38ed-b400-376fb0c28cb5",
                        "entry_id": "cc0471c5-ad71-3731-b447-21e2a3df9234",
                        "glosses": [
                            "Relatif au rayon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794f7d47-ebcc-4d08-a790-578a513473c4",
                                "sense_id": "a5801d27-ba7e-38ed-b400-376fb0c28cb5",
                                "text": "Néanmoins, la croissance radiale moyenne annuelle des arbres multicaules à faible de nombre de tiges apparaît quantitativement comparable à celle des arbres à tronc unique."
                            }
                        ]
                    },
                    {
                        "sense_id": "75833270-47a6-307c-8c32-f16ae68164d5",
                        "entry_id": "cc0471c5-ad71-3731-b447-21e2a3df9234",
                        "glosses": [
                            "Qualifie un pneumatique qui est muni d’une carcasse constituée de brins orientés comme le rayon de la roue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864429f2-f736-47f6-be27-10b795b32577",
                                "sense_id": "75833270-47a6-307c-8c32-f16ae68164d5",
                                "text": "Michelin est à l’origine du pneu radial."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4d30600-9ba1-4d1a-a1d4-cf589ddbd8d9",
                        "source_entry_id": "cc0471c5-ad71-3731-b447-21e2a3df9234",
