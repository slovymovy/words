                                        "entry_id": "bf43402f-35c1-3319-96f8-39298b989dc2",
                                        "glosses": [
                                            "этногр. народный весенний праздник у татар и башкир, посвящённый окончанию весенних полевых работ"
                                        ],
                                        "tags": [],
