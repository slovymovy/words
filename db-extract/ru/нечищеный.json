                ],
                "senses": [
                    {
                        "sense_id": "e40cb2f2-40f3-3679-9d34-a605c97567ee",
                        "entry_id": "301b7e08-310d-31f9-8b43-9f4a831966a9",
                        "glosses": [
                            "такой, который не был подвергнут чистке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af884701-7a5f-412d-bac5-cee1ca958e2a",
                                "sense_id": "e40cb2f2-40f3-3679-9d34-a605c97567ee",
                                "text": "Вон и фрак-то нечищеный принес, весь в мелу, словно из лабаза."
                            },
                            {
                                "example_id": "652dac0e-2534-4ba2-adf1-7d0a582eaf0a",
                                "sense_id": "e40cb2f2-40f3-3679-9d34-a605c97567ee",
                                "text": "Все напоминало ему полузабытую прежнюю жизнь: и запах овчин от тулупа, и домашний вид нечищеных лошадей, и какой-нибудь петух в слободе, горланящий с погребицы."
                            },
                            {
                                "example_id": "78d52f3a-8e67-4d2c-88c7-3bed179cfaeb",
                                "sense_id": "e40cb2f2-40f3-3679-9d34-a605c97567ee",
                                "text": "Так и прослужил до конца с нечищеной бляхой."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1c2f11e-39d3-3010-8ea4-056158fef2c7",
                        "entry_id": "301b7e08-310d-31f9-8b43-9f4a831966a9",
                        "glosses": [
                            "такой, который не был подвергнут очистке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0718e733-10b8-4628-8f2f-d1619e548ed8",
                                "sense_id": "d1c2f11e-39d3-3010-8ea4-056158fef2c7",
                                "text": "То бананы я есть не буду, хочу апельсины чищеные. Потом только апельсины нечищеные."
                            }
                        ]
                    }
                ],
