                            {
                                "target_word": "minachtend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "927856bc-1ea9-33a7-af08-882675032bc0",
                                        "entry_id": "2a256ab6-e450-31db-83da-02e194aacbe8",
                                        "glosses": [
                                            "zonder respect"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66557de-3590-4874-b8a9-baf8b8464c69",
                                                "sense_id": "927856bc-1ea9-33a7-af08-882675032bc0",
                                                "text": "Ik moet vooral mijn mond houden tijdens het kijken. Woensdag, bij Real - Manchester City waagde ik te vragen wie 'die witten' waren. Mijn zoontje zuchtte: ,,Je ziet heel veel mensen in het wit op de tribune, dus dat is de ploeg die thuis speelt, Real. Mijn dochter met onverholen minachtende blik: ,,Weet je niet dat het uittenue van Manchester geel is? Thuis spelen ze in blauw. Als je me niet gelooft, google je maar."
                                            },
                                            {
                                                "example_id": "97e75e0f-caad-41cb-97a0-8da7abb8caaa",
                                                "sense_id": "927856bc-1ea9-33a7-af08-882675032bc0",
                                                "text": "Soms begrijp ik de beslissingen van mijn mensen ook niet. Dit geeft juist misverstanden”, erkende Uilenberg, die de minachtende woorden na afloop van Utrecht-assistent John van Loen over Nijhuis sterk afwees."
                                            },
                                            {
                                                "example_id": "3c4035c0-af09-480a-a1cc-6b7c1691bb29",
                                                "sense_id": "927856bc-1ea9-33a7-af08-882675032bc0",
                                                "text": "PvdA-Kamerlid Ronald Plasterk beticht VVD-lijsttrekker en premier Mark Rutte van een minachtende houding. Plasterk deed dat woensdag bij Knevel en Van den Brink."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3708f93a-44b0-4b13-935c-fcc399c5251c",
                        "source_entry_id": "739c82b0-f8c8-3848-9b4d-ee55ba6003d1",
                        "source_sense_id": "53e72097-2a5d-3697-b0ba-53b104edec4a",
                        "target_lang_word": "geringschattend",
                        "target_lang_code": "nl",
