                        "entry_id": "24eaae59-815f-3b0b-a750-605fe08d5ced",
                        "glosses": [
                            "Gürtel beziehungsweise Ring von (verhältnismäßig wohlhabenden) Vororten in der Umgebung einer Großstadt, in der viele Pendler, welche in der Großstadt arbeiten, ihren Wohnsitz haben"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4bc6f289-bb73-4225-b5bc-88ff0a245aba",
                                "sense_id": "246476de-7370-3865-be98-d20edbd65580",
                                "text": "Die Orte des Berliner Speckgürtels liegen im Land Brandenburg."
                            },
                            {
                                "example_id": "3b7f852e-18fe-4530-bbff-e5a2e08af72e",
                                "sense_id": "246476de-7370-3865-be98-d20edbd65580",
                                "text": "„Orte wie Germering bilden den Speckgürtel einer Großstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
