                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ee5dfd-e802-483f-a96a-6aa4a1ce6aaa",
                                                "sense_id": "98494e16-52fb-3de5-a8ef-8be82dfc8d04",
                                                "text": "Подмосковные депутаты хотят компенсировать оплату за коммунальные услуги ветеранам."
                                            }
