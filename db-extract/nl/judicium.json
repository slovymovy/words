                    {
                        "translation_id": "7abcb2f7-7862-48c3-ac0e-8a7f811fee7a",
                        "source_entry_id": "6a1f15da-6b9a-3eab-8e4e-3dd315e9c4dc",
                        "target_lang_word": "judgment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judgment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32905fb2-ce71-3daa-a2df-4d6ca0578bb2",
                                        "entry_id": "d4134685-420a-3086-b9b4-349caea89fd2",
                                        "glosses": [
                                            "The act of judging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df425b3-c22d-4d53-a885-3e08ce30de7b",
                                                "sense_id": "32905fb2-ce71-3daa-a2df-4d6ca0578bb2",
                                                "text": "The key to the situation was judgment of the role the railways could play in modern times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                        "entry_id": "d4134685-420a-3086-b9b4-349caea89fd2",
                                        "glosses": [
                                            "The power or faculty of performing such operations; especially, when unqualified, the faculty of judging or deciding rightly, justly, or wisely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba02022a-b43c-48ec-b153-a32c1213077d",
                                                "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                                "text": "a man of judgment / a man of good judgment"
                                            },
                                            {
                                                "example_id": "28ce0ff2-675a-4784-8ce6-87aea4128c9a",
                                                "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                                "text": "a politician without judgment"
                                            },
                                            {
                                                "example_id": "f46ffb0a-018b-4149-bf85-13f0065c9512",
                                                "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                                "text": "Hermia. I would my father look'd but with my eyes. Theseus. Rather your eyes must with his judgment look."
                                            },
                                            {
                                                "example_id": "cd9d9cdd-510f-4e58-810a-0d31f21eae65",
                                                "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                                "text": "He shall judge thy people with righteousness and thy poor with judgment."
                                            },
                                            {
                                                "example_id": "70ff4913-5ee2-410e-b77d-79338e02ebfe",
                                                "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                                "text": "[T]he person presented shall be tried and examined by the judgment of learned men of the church; […]"
                                            },
                                            {
                                                "example_id": "f5d2c15c-4c5f-40a0-a095-154f15331489",
                                                "sense_id": "043e8ec4-8632-37f4-8c8f-8fa2d0c60635",
                                                "text": "We determined that the car driver’s transportation of multiple teen passengers, limited driving experience, and likely impairment from effects of cannabis at the time of the crash adversely affected her judgment of the danger of entering the intersection in front of the approaching combination vehicle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81437d2-afae-33e3-9494-95d00adf7b67",
                                        "entry_id": "d4134685-420a-3086-b9b4-349caea89fd2",
                                        "glosses": [
                                            "The conclusion or result of judging; an opinion; a decision."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e9dbf2e-cc78-476a-a3a4-6479545e7768",
                                                "sense_id": "e81437d2-afae-33e3-9494-95d00adf7b67",
                                                "text": "She in my judgment was as fair as you."
                                            },
                                            {
                                                "example_id": "a1470a04-9dc5-4c9b-9fb1-dcf287d3681f",
                                                "sense_id": "e81437d2-afae-33e3-9494-95d00adf7b67",
                                                "text": "Not from the stars do I my judgment pluck;\nAnd yet methinks I have astronomy […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d385381-8e9c-3f67-b728-d28064db2f62",
                                        "entry_id": "d4134685-420a-3086-b9b4-349caea89fd2",
                                        "glosses": [
                                            "The act of determining, as in courts of law, what is conformable to law and justice; also, the determination, decision, or sentence of a court, or of a judge."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881e02cc-c201-4288-b324-229c2cb85505",
                                                "sense_id": "3d385381-8e9c-3f67-b728-d28064db2f62",
                                                "text": "In judgments between the Rich and the Poor: it is not to be considered what the poor man needs, but what is his own"
                                            },
                                            {
                                                "example_id": "3fef1028-b16c-4c03-a7f7-a98882ed1f86",
                                                "sense_id": "3d385381-8e9c-3f67-b728-d28064db2f62",
                                                "text": "Most heartily I do beseech the court To give the judgment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "815447e7-95e6-3df9-8c7f-dbca80ac310a",
                                        "entry_id": "d4134685-420a-3086-b9b4-349caea89fd2",
                                        "glosses": [
                                            "The final award; the last sentence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
