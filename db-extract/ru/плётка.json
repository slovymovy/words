                "translations": [
                    {
                        "translation_id": "681092b1-c241-4e7a-942f-e8da8b37a3ed",
                        "source_entry_id": "b84dc0ce-2f68-3c8d-9daf-2f725592035d",
                        "source_sense_description": "кнут",
                        "target_lang_word": "lash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afd28a5a-2723-3fdf-b778-a17f4021b056",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "The thong or braided cord of a whip, with which the blow is given."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a797bae-d90f-46e4-9785-d391698ab804",
                                                "sense_id": "afd28a5a-2723-3fdf-b778-a17f4021b056",
                                                "text": "I observed that your whip wanted a lash to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d25f357-bd94-3302-85e5-c368800ef4b4",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "A leash in which an animal is caught or held; hence, a snare."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "100568ae-83fd-3693-a2c0-14b304aa7feb",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "A stroke with a whip, or anything pliant and tough, often given as a punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e951db4b-a8d0-4a1b-8a26-ab8ba95d6f5b",
                                                "sense_id": "100568ae-83fd-3693-a2c0-14b304aa7feb",
                                                "text": "The culprit received thirty-nine lashes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e40f0f6a-4fab-35b8-ad93-43e059796e01",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "A quick and violent sweeping movement, as of an animal's tail; a swish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96322812-c5db-3686-9631-3e5a28a766dd",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "A stroke of satire or sarcasm; an expression or retort that cuts or gives pain; a cut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82375330-64c0-4260-a3a1-6b8ed809c914",
                                                "sense_id": "96322812-c5db-3686-9631-3e5a28a766dd",
                                                "text": "The moral is a lash at the vanity of arrogating that to ourselves which succeeds well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "658a2824-ec2e-3048-afd7-36988ce0753a",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "A hair growing from the edge of the eyelid; an eyelash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2215fca-243b-49cc-9ebf-cc7ce2e47953",
                                                "sense_id": "658a2824-ec2e-3048-afd7-36988ce0753a",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64cd8848-5e0a-35d7-ab8c-464016b75039",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "In carpet weaving, a group of strings for lifting simultaneously certain yarns, to form the figure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19ae4a74-b60a-36b0-816e-e4c4f66406c3",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "Flowering plants of genus Blepharis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17066c1a-2dcc-36ec-bfe4-fdfe8e514b91",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "An attempt; a go at something."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Ireland",
                                            "New-Zealand",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9abbbdb1-1da9-4d90-924c-fdf630350794",
                                                "sense_id": "17066c1a-2dcc-36ec-bfe4-fdfe8e514b91",
                                                "text": "I'll have a lash."
                                            },
                                            {
                                                "example_id": "81670b0d-24aa-404f-a6de-ebef75b1aa31",
                                                "sense_id": "17066c1a-2dcc-36ec-bfe4-fdfe8e514b91",
                                                "text": "Much-loved characters living on after their author’s death is not so unusual these days. Every second bloke in possession of a keyboard seems to have had a lash at a James Bond thriller, including Kingsley Amis, John Gardner, Raymond Benson, Jeffery Deaver, William Boyd, Anthony Horowitz, Christopher Wood and Sebastian Faulks."
                                            },
                                            {
                                                "example_id": "786a852e-6415-4ccb-9d6f-c7e641bb5b62",
                                                "sense_id": "17066c1a-2dcc-36ec-bfe4-fdfe8e514b91",
                                                "text": "“I felt I’d go out and grab the bull by the horns and give it a good lash and I’m very pleased to come away with second in my very first Diamond League final.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fbbaeed-2df1-382c-b1b0-fc0c750650dd",
                                        "entry_id": "cdbd880c-6f78-3594-a413-4c8e59664cae",
                                        "glosses": [
                                            "A quantity, a great number or amount (e.g. of rain or milk)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee2374c-d969-43a4-8466-4ba3a85f9284",
                                                "sense_id": "3fbbaeed-2df1-382c-b1b0-fc0c750650dd",
                                                "text": "the Ayrshire cow gives a lash of milk on comparatively bare pasture"
                                            },
                                            {
                                                "example_id": "0650dfe1-8e69-4df1-8cc0-5a76043097a9",
                                                "sense_id": "3fbbaeed-2df1-382c-b1b0-fc0c750650dd",
                                                "text": "The oaks cry oot beneath November's lashes, But not for all the months[…]"
                                            },
                                            {
                                                "example_id": "cba20406-75b5-4d71-b4b6-ca32d79f7a03",
                                                "sense_id": "3fbbaeed-2df1-382c-b1b0-fc0c750650dd",
                                                "text": "... put a lash of scepticism in his tone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37c010d8-5893-3453-8513-e02e4f4cc344",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To strike with a lash; to whip or scourge with a lash, or with something like one."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6872eb1-7cc7-4f40-93a0-7c953fe783e9",
                                                "sense_id": "37c010d8-5893-3453-8513-e02e4f4cc344",
                                                "text": "We lash the pupil, and defraud the ward"
                                            },
                                            {
                                                "example_id": "4c10ddb3-c595-425d-9ba6-0091ef6ca383",
                                                "sense_id": "37c010d8-5893-3453-8513-e02e4f4cc344",
                                                "text": "A lesbian who was lashed as a teenager for saying she was gay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5637e969-848c-37aa-91e9-88fbbf29cf46",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To strike forcibly and quickly, as with a lash; to beat, or beat upon, with a motion like that of a lash."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605af9c3-0def-4219-86da-bcb7d287a319",
                                                "sense_id": "5637e969-848c-37aa-91e9-88fbbf29cf46",
                                                "text": "Carlo Ancelotti's out-of-sorts team struggled to hit the target in the first half as Bolton threatened with Matthew Taylor lashing just wide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e566497-64b9-3f51-97d7-a0a46cd67d26",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To throw out with a jerk or quickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ef14ae-1223-4caa-85ab-61845405c2c4",
                                                "sense_id": "8e566497-64b9-3f51-97d7-a0a46cd67d26",
                                                "text": "He falls, and lashing up his heels, his rider throws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7cf5a9d-c732-301a-bf27-406a09b06109",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To scold; or to satirize; to censure with severity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f00d1f5-4409-3719-9f6f-58cd6df1d643",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To ply the whip; to strike."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4a19324-5757-393a-8ebd-b71c8ddd789c",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To strike vigorously; to let fly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd165108-7f97-42a6-a0ab-88bd99dafc2f",
                                                "sense_id": "b4a19324-5757-393a-8ebd-b71c8ddd789c",
                                                "text": "In the final minute of six added on, Colombia would undo their good work, though, Pérez fumbling the ball allowing Hemp to lash into the empty net."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf40b991-eb9a-39c0-a88e-91d5505fe6a5",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To utter censure or sarcastic language."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e920d2-1cfb-4f61-bb73-10a4a730f9ab",
                                                "sense_id": "cf40b991-eb9a-39c0-a88e-91d5505fe6a5",
                                                "text": "To laugh at follies, or to lash at vice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb6e0e0b-ea20-368e-b8c7-90f17f370bd3",
                                        "entry_id": "601b1186-c115-39b2-93da-b1e2ff19f470",
                                        "glosses": [
                                            "To fall heavily, especially in the phrase lash down."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ef0a36-4227-4640-95d1-def1faaaeac7",
                                                "sense_id": "eb6e0e0b-ea20-368e-b8c7-90f17f370bd3",
                                                "text": "With rain lashing across the ground at kick-off and every man in Auckland seemingly either English-born or supporting Scotland, Eden Park was transformed into Murrayfield in March."
