                "senses": [
                    {
                        "sense_id": "e44297ba-ee6b-3e15-a7cf-b4249032e654",
                        "entry_id": "57d0505e-f6e6-313b-a0c4-b66ae87c3b6a",
                        "glosses": [
                            "roter Farbton, rötliche Färbung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e58894-4d11-4982-914d-bfc9b5cbfada",
                                "sense_id": "e44297ba-ee6b-3e15-a7cf-b4249032e654",
                                "text": "„Solange die Pflanze atmet, leuchtet sie, dabei dominieren zwei Rottöne.“"
                            },
                            {
                                "example_id": "08135583-7684-4860-b9c7-9d82485b2d75",
                                "sense_id": "e44297ba-ee6b-3e15-a7cf-b4249032e654",
                                "text": "„Die frühesten erhaltenen gefärbten Stoffe in der europäischen Geschichte, datierbar auf das Ende des 4. Jahrtausends vor Christus, weisen allesamt Rottöne auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
