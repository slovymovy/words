                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22de5406-bc29-43dd-85cf-75b5eb4bd23b",
                                "sense_id": "b1989752-9b36-364b-b932-6bbb0aa6c819",
                                "text": "Mölkky, le jeu de quille finlandais qui fait de l’ombre à la pétanque"
                            },
                            {
                                "example_id": "59c9a643-baeb-41f6-97dc-de95234340fe",
                                "sense_id": "b1989752-9b36-364b-b932-6bbb0aa6c819",
                                "text": "Les visiteurs peuvent venir y jouer gratuitement à des jeux en bois et des jeux bretons, passe-trappe, mikado géant, mölkki."
                            },
                            {
                                "example_id": "35329be2-9f3f-4466-a441-f0ae8f80ee6b",
                                "sense_id": "b1989752-9b36-364b-b932-6bbb0aa6c819",
                                "text": "Craon, petite ville d’à peine 4 500 habitants en Mayenne, va accueillir un événement d’envergure nationale : l’Open de France de Mölkky 2023."
