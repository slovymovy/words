                                    {
                                        "sense_id": "1157ed4e-2a98-39fa-888d-dd8bd24c3e99",
                                        "entry_id": "ddb37dd3-f13a-3b0d-b3b3-9a6f41317b14",
                                        "glosses": [
                                            "Konzept, Plan, Übersicht für eine ausführlichere Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fea4c9-b672-4858-ae58-f08f64f7b0b8",
                                                "sense_id": "1157ed4e-2a98-39fa-888d-dd8bd24c3e99",
                                                "text": "Eine erste Exposition für das Buch liegt schon vor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69837b52-31c8-3c8e-8373-a5cdf8bfc93f",
                                        "entry_id": "ddb37dd3-f13a-3b0d-b3b3-9a6f41317b14",
                                        "glosses": [
                                            "Einführung des Zuschauers in ein Drama"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9818e68-8aae-4b56-a4f3-5a57734d5d36",
                                                "sense_id": "69837b52-31c8-3c8e-8373-a5cdf8bfc93f",
                                                "text": "„Die Exposition vermittelt, idealtypisch am Anfang des Dramas, vor dem ersten situationsverändernden Handlungsmoment, das Wissen um die in der Vergangenheit liegenden und die Gegenwart bestimmenden Voraussetzungen und Gegebenheiten, auf denen die folgende konflikthafte Handlung beruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a0c871da-dbea-3dec-acd9-c948c30ae6a7",
                                        "entry_id": "ddb37dd3-f13a-3b0d-b3b3-9a6f41317b14",
                                        "glosses": [
                                            "einleitender Teil eines Musikstücks"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5123e4f-8ae2-490d-b58e-0aec6e0f5b46",
                                                "sense_id": "a0c871da-dbea-3dec-acd9-c948c30ae6a7",
                                                "text": "„Die erste Durchführung einer Fuge heißt Exposition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a1b0e936-ea24-30bd-8ddf-d0ff7a1284e5",
                                        "entry_id": "ddb37dd3-f13a-3b0d-b3b3-9a6f41317b14",
                                        "glosses": [
                                            "Veranstaltung, um bestimmte Dinge einem Publikum bekannt zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf46da82-d064-4ab0-8fd4-dac48b6c7d6d",
                                                "sense_id": "a1b0e936-ea24-30bd-8ddf-d0ff7a1284e5",
                                                "text": "Auf der Exposition kann man die neuesten Maschinen kennenlernen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "410a01b2-731b-3793-8766-51ada55615fd",
                                        "entry_id": "ddb37dd3-f13a-3b0d-b3b3-9a6f41317b14",
                                        "glosses": [
                                            "der Zustand, einer bestimmten wirkenden (oft schädlichen) Einflussgröße ausgesetzt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b98c7f-4e4b-4740-9e56-d3f193908aaa",
                                                "sense_id": "410a01b2-731b-3793-8766-51ada55615fd",
                                                "text": "„Neben der Abschätzung lokaler oder regionaler Stoffeinträge gilt es, unter Berücksichtigung von Stoff- und Umwelteigenschaften sowie Verteilungs-, Festlegungs- und Abbaukinetiken, die schutzbezogene Exposition zu bestimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
