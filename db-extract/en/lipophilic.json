{
    "word": "lipophilic",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d20dd848-263e-3126-9ef3-6525ad471f73",
                "word": "lipophilic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7561ce7e-c665-3fce-9ff0-229f3d00be6c",
                        "entry_id": "d20dd848-263e-3126-9ef3-6525ad471f73",
                        "glosses": [
                            "Having the quality of dissolving in lipids; typically composed of mostly nonpolar bonds."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd0bdf25-5cac-4b37-9367-9695cd3d8ff0",
                        "source_entry_id": "d20dd848-263e-3126-9ef3-6525ad471f73",
                        "source_sense_id": "7561ce7e-c665-3fce-9ff0-229f3d00be6c",
                        "source_sense_description": "having the quality of dissolving in lipids",
                        "target_lang_word": "liposoluble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liposoluble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "191ce090-a0a7-327f-b656-173d5ee277eb",
                                        "entry_id": "88be0da4-c979-3a7a-9eb5-e614a6453b8a",
                                        "glosses": [
                                            "Qualifie un corps chimique soluble dans les lipides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24954b0c-f629-4351-9ad5-711be31ceed9",
                                                "sense_id": "191ce090-a0a7-327f-b656-173d5ee277eb",
                                                "text": "Considérant que le produit est une préparation contenant du narasin qui est un ionophore polyéther liposoluble produit par fermentation d’une souche de Streptomyces aureofaciens ; […]."
                                            },
                                            {
                                                "example_id": "a978959a-7f2e-426c-9dc1-2cfbcfbf0ce1",
                                                "sense_id": "191ce090-a0a7-327f-b656-173d5ee277eb",
                                                "text": "Les médicaments très liposolubles ont plus d'affinité pour le tissu adipeux. Ainsi, les médicaments liposolubles quittent plus rapidement le sang pour pénétrer dans les tissus que les substances hydrosolubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94342eb1-c380-31e3-a53c-e9a9e2ad33ca",
                                        "entry_id": "88be0da4-c979-3a7a-9eb5-e614a6453b8a",
                                        "glosses": [
                                            "Qualifie certaines vitamines (vitamines A, D, E et K ) qui ont cette propriété."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8eaaefb-1d2d-4bff-8c8b-e11274d5949b",
                                                "sense_id": "94342eb1-c380-31e3-a53c-e9a9e2ad33ca",
                                                "text": "La vitamine D liposoluble est très stable. Elle n’est pas détruite par la chaleur ou par l’oxydation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b73b7895-3ee9-4505-bc9b-c8449c43ef52",
                        "source_entry_id": "d20dd848-263e-3126-9ef3-6525ad471f73",
                        "source_sense_id": "7561ce7e-c665-3fce-9ff0-229f3d00be6c",
                        "source_sense_description": "having the quality of dissolving in lipids",
                        "target_lang_word": "lipophil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lipophil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eea33a7-998f-3383-b83e-ff5bcc67cdda",
                                        "entry_id": "a733304b-9689-31e2-87d3-035241dbc5fc",
                                        "glosses": [
                                            "im Fett löslich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0794f53f-2665-4cbf-b714-cd8f0fda7687",
                                                "sense_id": "8eea33a7-998f-3383-b83e-ff5bcc67cdda",
                                                "text": "Er stützt sich auf die Hypothese, dass Borrelien ein fettliebendes (lipophiles) Toxin produzieren."
                                            },
                                            {
                                                "example_id": "48470004-660b-4db8-b5a8-be42541572fb",
                                                "sense_id": "8eea33a7-998f-3383-b83e-ff5bcc67cdda",
                                                "text": "Lipophile und hydrophile Farbstoffe reichern sich nach ihrer Löslichkeit in unterschiedlichen Kompartimenten an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4926d356-97df-3b6a-a335-51e6304cce00",
                                        "entry_id": "a733304b-9689-31e2-87d3-035241dbc5fc",
                                        "glosses": [
                                            "zur extremen Anlagerung von Fett neigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e225ab8-f087-4653-9069-4e677eaa0a67",
                                                "sense_id": "4926d356-97df-3b6a-a335-51e6304cce00",
                                                "text": "In Abhängigkeit von Lipophilie und pKa-Wert werden Anästhetika im lipophilen Gewebe aufgenommen, sodass vor allem bei Injektion in das Fettgewebe mit einer starken Anreicherung unmittelbar an der Injektionsstelle gerechnet werden muss."
                                            },
                                            {
                                                "example_id": "3f79766c-3bfc-41f0-8307-6fb772f0eb5a",
                                                "sense_id": "4926d356-97df-3b6a-a335-51e6304cce00",
                                                "text": "Nach 1948 entwickelte sich bei Frauen über 40 Jahren und einer Gewichtszunahme von über 25 kg eine lipophile Dystrophie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7924a8da-b1bd-4fab-818d-f3c2005cd073",
                        "source_entry_id": "d20dd848-263e-3126-9ef3-6525ad471f73",
                        "source_sense_id": "7561ce7e-c665-3fce-9ff0-229f3d00be6c",
                        "source_sense_description": "having the quality of dissolving in lipids",
                        "target_lang_word": "fettlöslich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fettlöslich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5226fc1e-5d37-35a3-a5b6-aa98699dc71b",
                                        "entry_id": "c1e104f1-ae3c-3af4-bb7c-28653eec3d8c",
                                        "glosses": [
                                            "in Fett löslich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23888b77-694d-46e3-9049-8865373f95d9",
                                                "sense_id": "5226fc1e-5d37-35a3-a5b6-aa98699dc71b",
                                                "text": "Die Eselsbrücke heißt „EDEKA“, um sich die vier fettlöslichen Vitamine E, D, K und A zu merken."
                                            },
                                            {
                                                "example_id": "afe0ad53-f854-4b2e-927e-ff40dc04f5d9",
                                                "sense_id": "5226fc1e-5d37-35a3-a5b6-aa98699dc71b",
                                                "text": "Milch liefert Kalium, Magnesium und Jod, fettlösliche Vitamine und mehr Kalzium als jedes andere Lebensmittel."
                                            },
                                            {
                                                "example_id": "5287577c-da82-4188-b3ec-02cfaac119a3",
                                                "sense_id": "5226fc1e-5d37-35a3-a5b6-aa98699dc71b",
                                                "text": "Wasser zu trinken wäre also das Falsche, da der für die Schärfe zuständige Bestandteil Capsaicin zwar alkohol- und fettlöslich, aber eben nicht wasserlöslich ist."
                                            },
                                            {
                                                "example_id": "4801734a-2611-42b6-a9e1-da786d88a125",
                                                "sense_id": "5226fc1e-5d37-35a3-a5b6-aa98699dc71b",
                                                "text": "Dotter enthält u.a. Protein, Fett, Phosphor und Kalzium; seine gelbe Farbe verdankt er fettlöslichen Karotinoiden (wie sie auch den Safran und damit wieder den Kuchen gelb färben)."
                                            },
                                            {
                                                "example_id": "6c7a9c9f-8435-4c40-b2b6-da13f8535a28",
                                                "sense_id": "5226fc1e-5d37-35a3-a5b6-aa98699dc71b",
                                                "text": "Den fettlöslichen Schmutz nimmt das flüssige Kohlendioxid auf; wasserlösliche Stoffe können darin nicht gelöst werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
