                ],
                "senses": [
                    {
                        "sense_id": "a505dd51-13f6-347b-bb1f-8d948ab64a99",
                        "entry_id": "6c59b9fd-e731-3802-9622-09995e984752",
                        "glosses": [
                            "narzędzie do czerpania płynów lub materiałów sypkich, zwykle w formie naczynia z trzonkiem lub uchwytem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea38c5ee-2443-44b1-bbd2-483bdbd57147",
                                "sense_id": "a505dd51-13f6-347b-bb1f-8d948ab64a99",
                                "text": "Pasterze górscy ornamentowali czerpaki, które nie tylko służyły do picia żętycy, ale i odmierzały ilość mleka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "39bc176d-2013-3d45-b77a-002e1edb7a64",
                        "entry_id": "6c59b9fd-e731-3802-9622-09995e984752",
                        "glosses": [
                            "część robocza maszyny lub urządzenia, która służy do czerpania, zagarniania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71fa5c85-b6b0-4fb3-b2b1-c37080e9fef3",
                                "sense_id": "39bc176d-2013-3d45-b77a-002e1edb7a64",
                                "text": "Maszyna podjeżdżała, opuszczała czerpak i „bagrowała” ziemię"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d898c38-5d48-4909-b2f6-276a52e58306",
                        "source_entry_id": "6c59b9fd-e731-3802-9622-09995e984752",
                        "source_sense_id": "a505dd51-13f6-347b-bb1f-8d948ab64a99",
                        "target_lang_word": "черпак",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "черпак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "219c95cc-34fc-321f-b011-22c2fd871e40",
                                        "entry_id": "43ee7f91-6bba-3bce-834e-8f07318cb5da",
                                        "glosses": [
                                            "разг. большая, объёмом от 100 мл и более, разливательная ложка, с длинной ручкой, используемая для разливания супов, компотов, молока и др. и раздачи некоторых вторых блюд из посуды для приготовления (бака, бачка, кастрюли) в посуду для употребления еды (тарелки, миски, чашки)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afaaeede-02aa-412a-8e12-9ff22b66298b",
                                                "sense_id": "219c95cc-34fc-321f-b011-22c2fd871e40",
                                                "text": "Была у него и особая длинная ложка — «черпак», в форме лодочки с высокими бортиками, чтобы ею извлекать то, что требовалось, из недра этой своеобразной походной кухни."
                                            },
                                            {
                                                "example_id": "14640db7-0b8c-479f-8a55-0cb457c3c066",
                                                "sense_id": "219c95cc-34fc-321f-b011-22c2fd871e40",
                                                "text": "Пищу разливала я: всё было приготовлено прекрасно, но забыли длинную разливательную ложку (черпак), поэтому я черпала кастрюлей, вследствие чего первые солдаты получили довольно жидкий суп."
                                            },
                                            {
                                                "example_id": "cb0fdf32-531a-4430-af3e-d90f4785f362",
                                                "sense_id": "219c95cc-34fc-321f-b011-22c2fd871e40",
                                                "text": "Эконом-содержатель по счёту принимал матросские бачки для супа, чугунные котлы, кружки, весы с гирями, черпаки, оловянные блюда, посуду для офицерского стола."
                                            },
                                            {
                                                "example_id": "3c14beca-bdaf-4cfc-8798-e8c261628dfb",
                                                "sense_id": "219c95cc-34fc-321f-b011-22c2fd871e40",
                                                "text": "А повар Байрам из Азербайджана (он готовил и раздавал обед на лесосеке) однажды вместо одного черпака каши положил в мою миску два."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7146eb87-c2d4-37a3-b038-9108af52d6e4",
                                        "entry_id": "43ee7f91-6bba-3bce-834e-8f07318cb5da",
                                        "glosses": [
                                            "рег. приспособление для черпания (зачерпывания, вычерпывания), представляющее собой ковш на длинной рукоятке или без неё"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37eb0fde-76fa-456f-aead-cab0fe10edbf",
                                                "sense_id": "7146eb87-c2d4-37a3-b038-9108af52d6e4",
                                                "text": "— Хорошо… Не забудьте черпаки для воды. Как шитик?"
                                            },
                                            {
                                                "example_id": "e6dfe702-4f8e-4b32-a220-225bf0824477",
                                                "sense_id": "7146eb87-c2d4-37a3-b038-9108af52d6e4",
                                                "text": "Около журчейка лежал черпак, красиво сделанный из бересты. ❬…❭ И ясно представились заботливые руки крестьянина, его добрая улыбка, с которой он, напившись, клал черпак на полянку для всякого, кому он мог понадобиться."
                                            },
                                            {
                                                "example_id": "41cd1f3a-ff39-4c4f-a709-a0a06788aeaa",
                                                "sense_id": "7146eb87-c2d4-37a3-b038-9108af52d6e4",
                                                "text": "Набрав воды, Варвара повесила жестяной черпак с длинным шестом на деревянную стойку у колоды, из которой поили лошадей, и стала прилаживать коромысло к вёдрам."
                                            },
                                            {
                                                "example_id": "c14ac45f-e825-421a-9ebc-d0a85ef45097",
                                                "sense_id": "7146eb87-c2d4-37a3-b038-9108af52d6e4",
                                                "text": "Один из сыновей взял черпак, сделанный из тугого оленьего рога и переплетённый лахтачьим ремнём."
                                            },
                                            {
                                                "example_id": "65ada1db-1773-4396-96e8-60c6edf6eb97",
                                                "sense_id": "7146eb87-c2d4-37a3-b038-9108af52d6e4",
                                                "text": "Размешав в небольшой деревянной кадке с водой эвкалиптовое масло и забросив туда же деревянный черпак, Василий зашёл в парну́ю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e29c5da-b28f-33de-a9c2-c6e4015aef37",
                                        "entry_id": "43ee7f91-6bba-3bce-834e-8f07318cb5da",
                                        "glosses": [
                                            "спец. приспособление с металлической сеткой на черенке для удаления кусков льда из проруби"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e188396a-2196-48dd-9c9e-5d23ae4ad2f5",
                                                "sense_id": "7e29c5da-b28f-33de-a9c2-c6e4015aef37",
                                                "text": "К стволу ивы прислонён лом, в снег черенком во́ткнут черпак с металлической сеткой — колотый лёд выхватывать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51298aa4-a67b-35ea-9771-01dea4b76891",
                                        "entry_id": "43ee7f91-6bba-3bce-834e-8f07318cb5da",
                                        "glosses": [
                                            "техн. часть землеройной машины, механизма экскаватора, драги и т. п. в форме ковша, предназначенная для выемки грунта или какой-либо массы (руды, угля и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64fb507-ab58-4d20-9cf1-88f8aac7d859",
                                                "sense_id": "51298aa4-a67b-35ea-9771-01dea4b76891",
                                                "text": "Вместе с лотом погружаются особо устроенный глубоководный термометр и черпаки для поднятия проб воды, распределённые по проволоке на различных расстояниях, чтобы при одном измерении сразу получить материал с различных глубин."
                                            },
                                            {
                                                "example_id": "78bfdecc-cdda-4fd1-ab6a-870a5f7e0bbb",
                                                "sense_id": "51298aa4-a67b-35ea-9771-01dea4b76891",
                                                "text": "Черпаки непрерывно подают породу внутрь драги на промывочную машину. ❬…❭ Каждый черпак весит сто десять пудов — это пустой, а захватывает он 13 1/2 куб. футов мокрого песку. ❬…❭ И если в черпак попадёт со дна пруда платиновый самородок с лошадиную голову, — ему дорога тоже в отвал. ❬…❭ Попадают в черпак каменные глыбы такой величины, что вся драга задрожит от натуги."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "черпак",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                        "entry_id": "55d7e626-a50c-3515-91ed-0e3a685b4782",
                                        "glosses": [
                                            "воен. жарг. военнослужащий срочной службы, отслуживший определённый срок, обычно полгода или от года до полутора лет (в разных родах войск и частях — по-разному)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a9c131-50d9-41a0-92ed-03dd657dd740",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "Черпак — солдат, прослуживший от 1 года до 1,5 лет."
                                            },
                                            {
                                                "example_id": "d896d49f-9f6d-4f2f-94f8-2f6cc2a23c97",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "Чача — самогон. Черпак — солдат, отдавший родине год жизни. Чех — чеченец."
                                            },
                                            {
                                                "example_id": "c139f543-c360-4da9-914f-0eea1c32f05b",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "Если раньше молодой солдат больше всего боялся «черпака», или «деда», то есть старшего, чем он, всего на год, то теперь к «дедовщине» подключились офицеры."
                                            },
                                            {
                                                "example_id": "3658d146-d5ec-4a74-aa0b-dc74e0164aa7",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "«Дедовщина» — У нас нет сложного деления: «запах», «слон», «черпак», «дед», «дембель» **. ** Звания «слон», «черпак», «дед» и «дембель» присваиваются каждые полгода службы."
                                            },
                                            {
                                                "example_id": "152602f2-5776-4a08-aa2e-0bd4b1d4f195",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "Череп, черпак — солдат, который отслужил свыше полугода."
                                            },
                                            {
                                                "example_id": "80cd28f9-b234-4678-b3c8-185145742d4f",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "Дембеля и «деды» спят на панцирной сетке, «черпаки», «слоны» и «духи» посередине, на железном стыке. ❬…❭ — А ты сколько служишь? Год? «Черпак». Тогда лежи пока. С тобой потом разберёмся."
                                            },
                                            {
                                                "example_id": "ca9dac63-c0d6-4f0e-a319-83014a7cbcbd",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "[twower, муж] 4) Черпак (череп) — военнослужащий, прослуживший от одного года до полутора лет. ❬…❭ [boxing12, муж] Актуальная тема)) У нас в ВВ была немного другие названия: слон — котёл (от слова «котлы» — часы, т. е. считает дни до дома деда), черпак — «фазан»."
                                            },
                                            {
                                                "example_id": "4bb844f1-d8bb-4ddb-96d9-355666913aee",
                                                "sense_id": "1885a2f6-b2d0-3441-abcf-0f92efacd8c2",
                                                "text": "— Длинный, иди, тебя Казюля зовёт. // Казюля — водитель комдива. Маленький ушастый наголо бритый черпак. Отслужил год, но из-за своей должности, которая давала ему возможность то подбомбить, то приторговать, имел кое-какой авторитет. Сидит, пьёт чай. Ещё два-три водилы с ним."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
