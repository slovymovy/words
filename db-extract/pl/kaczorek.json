                "senses": [
                    {
                        "sense_id": "5cee10fe-fbe8-3471-94b9-91b16d74d480",
                        "entry_id": "3c0d276f-043b-3db8-a07c-4493d56ee46e",
                        "glosses": [
                            "od kaczor"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "34656b6e-185b-43a0-9a67-e4c4dd425dbe",
                                "sense_id": "5cee10fe-fbe8-3471-94b9-91b16d74d480",
                                "text": "Potem, bez przesady, nudy święte... polowania niema, ale ja próżnować nie lubię... to sobie, panie dzieju, jastrzębie strzelam, to szelmę lisa tropię, to pojadę na błoto kaczorka upatrzę... i tak przejdzie... przejdzie jakoś do upałów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5baee9df-f931-3e34-b911-8a1ae39b7c93",
                        "entry_id": "3c0d276f-043b-3db8-a07c-4493d56ee46e",
                        "glosses": [
                            "mały kaczor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93295aca-aea8-4bd6-95dc-88a5bee51985",
                                "sense_id": "5baee9df-f931-3e34-b911-8a1ae39b7c93",
                                "text": "— To wstyd istny! — zawołał młody kaczorek! — Patrzcie na to szare, szkaradne kaczę!"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "263550e7-20a6-3890-8068-f58a963c5ff2",
                        "entry_id": "3c0d276f-043b-3db8-a07c-4493d56ee46e",
                        "glosses": [
                            "Adrianichthys kruyti Weber, słodkowodna ryba z rodziny kaczorkowatych, zagrożona wyginięciem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a7f90b-5cc9-4b38-abe7-b6c650632825",
                                "sense_id": "263550e7-20a6-3890-8068-f58a963c5ff2",
                                "text": "Nie wolno łowić kaczorków, ryby te są pod ochroną."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
