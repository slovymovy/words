                            }
                        ]
                    },
                    {
                        "translation_id": "184e0fe3-4229-4357-b624-6a5ff1334f4c",
                        "source_entry_id": "a1600eda-11d5-355a-a0e7-63f32d6f1b30",
                        "target_lang_word": "Futter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Futter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                        "entry_id": "b67e6550-c58c-3ed8-a652-5417f406bfab",
                                        "glosses": [
                                            "Nahrung der Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b5dc97-867a-4059-9c50-173e22c39a42",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "Hast du den Schweinen heute schon Futter gegeben?"
                                            },
                                            {
                                                "example_id": "7126d9ee-59df-4d3f-8074-f0719035d845",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "Im Nest schreien die um Futter bettelnden Jungvögel."
                                            },
                                            {
                                                "example_id": "b6e0e42b-5dd4-4d10-929f-1b8663ace94c",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "Sie sind eigentlich immer auf der Suche nach Futter."
                                            },
                                            {
                                                "example_id": "65ad83d6-e359-49bf-ad78-e9fff3e077f7",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "„Und zu der Sorge wegen der Kutscher war die Sorge um das Futter gekommen.“"
                                            },
                                            {
                                                "example_id": "032bad0c-abf1-49be-bb99-255e9e3c4b1d",
                                                "sense_id": "c9b49456-a684-33f3-8c05-2c102623d190",
                                                "text": "„Abends sahen sie sich auf Bauernhöfen nach Übernachtungsmöglichkeiten um, und tatsächlich fand sich jedes Mal eine Scheune und etwas Futter für die Pferde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b85a2c95-a900-398a-a3ba-c266d0325a90",
                                        "entry_id": "b67e6550-c58c-3ed8-a652-5417f406bfab",
                                        "glosses": [
                                            "Essen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e2ad607-74dd-40c8-9979-2222bbecb02a",
                                                "sense_id": "b85a2c95-a900-398a-a3ba-c266d0325a90",
                                                "text": "Karl steht gut im Futter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "07945180-8d75-3ffc-ad46-075508ab271b",
                                        "entry_id": "b67e6550-c58c-3ed8-a652-5417f406bfab",
                                        "glosses": [
                                            "geistige Nahrung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d16aaa84-f665-4c24-8457-61872643b747",
                                                "sense_id": "07945180-8d75-3ffc-ad46-075508ab271b",
                                                "text": "Er braucht Futter fürs Hirn."
                                            },
                                            {
                                                "example_id": "6b3ea0e7-596b-464d-a7b6-4644f601c383",
                                                "sense_id": "07945180-8d75-3ffc-ad46-075508ab271b",
                                                "text": "„Im letzten Sommer hatte er auf der Suche nach literarischem Futter begonnen, Briefe und Fotos zu studieren, die sich in den fast vierzig Jahren in Connecticut angesammelt hatten, woraus sich schon bald »eine Erinnerungsübung« entwickelte: Um einem neuen Biografen besser helfen zu können, begann er eine zusammengeschusterte Schilderung seines Lebens zu schreiben –»ohne sich über Sätze, Wiederholungen oder leeres Gerede Gedanken zu machen. Viel angenehmer. Und nützlich«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Futter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "367329b6-f36f-348f-9e71-b27d30164b23",
                                        "entry_id": "5baf551e-9e5c-3881-85b3-692872c2f003",
                                        "glosses": [
                                            "Stoff auf der Innenseite von Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a47cf86-f2e1-4fe3-bf77-2833c6076f88",
                                                "sense_id": "367329b6-f36f-348f-9e71-b27d30164b23",
                                                "text": "Das Futter in meiner Jacke geht kaputt."
                                            },
                                            {
                                                "example_id": "6af1fd5b-3077-491c-b846-31139540f8f4",
                                                "sense_id": "367329b6-f36f-348f-9e71-b27d30164b23",
                                                "text": "„Sie antwortete mir, sie könne nur daran denken, mich glücklich zu machen, wenn sie selbst dabei glücklich werde, und werde mir schreiben, was ich dazu tun könne; den Brief werde sie zwischen Futter und Überzug der Kapuze des Dominos einnähen, und deshalb solle ich diesen erst am folgenden Tag holen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f451f13e-c901-36cb-8a3a-1f7d0b233d58",
                                        "entry_id": "5baf551e-9e5c-3881-85b3-692872c2f003",
                                        "glosses": [
                                            "die Ausfüllung von Zwischenräumen bei Türen, Fenstern, Mauern oder ähnlichen Bauteilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf38ff21-616d-4b78-9c47-5b5b20a320cb",
                                                "sense_id": "f451f13e-c901-36cb-8a3a-1f7d0b233d58",
                                                "text": "Das Futter der Tür ist die Verkleidung der inneren, seitlichen Wandflächen, das kann zum Beispiel eine Blockzarge sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d25bc99b-70ea-372d-b170-8f8f94e61191",
                                        "entry_id": "5baf551e-9e5c-3881-85b3-692872c2f003",
                                        "glosses": [
                                            "eine Einspannvorrichtung an Maschinen für Werkzeuge oder Werkteile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9cd924a-bf04-455f-81d5-2b1d1043e1b0",
                                                "sense_id": "d25bc99b-70ea-372d-b170-8f8f94e61191",
                                                "text": "Vorne an der Bohrmaschine, ist am unteren Ende ein geriffelter Ring. Den mit der linken Hand festhalten, dann das Futter mit der rechten nach rechts drehen. Wenn der Zwischenraum groß genug ist, den Bohrer herausnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4c2701f-7702-454c-a3d7-e767d940d15c",
                        "source_entry_id": "a1600eda-11d5-355a-a0e7-63f32d6f1b30",
                        "target_lang_word": "Fütterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fütterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                        "entry_id": "f8093725-c644-3902-9173-e5a34194b0bc",
                                        "glosses": [
                                            "die Versorgung von einem oder mehreren Tieren mit Nahrung (= Futter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094dd158-6106-4de7-965f-c480485dc53b",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Die Fütterungvon Wild im Winter durch Jäger ist in Deutschland umstritten."
                                            },
                                            {
                                                "example_id": "4a3ecea0-ad88-4397-adc6-d494238c27c9",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "In einem dritten Versuch kombinierte Pawlow die Fütterung mit dem Klingelzeichen, und auch hier war eine vermehrte Speichelbildung zu beobachten."
                                            },
                                            {
                                                "example_id": "e41f1f75-5881-489e-bd32-7a2154a25868",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "\"Wir werden die [Wisent-]Herde aber auch weiter managen müssen\", erklärt Johannes Röhl. \"Dazu gehört vor allem eine Fütterung im Winter.\""
                                            },
                                            {
                                                "example_id": "8355fd86-e512-4e8c-b031-36018d1a2af8",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Kritisch [für das Klima] sind Viehhaltung und weltweit wachsender Fleischkonsum auch wegen des zunehmenden Bedarfs an Soja für die Fütterung. Für den Soja-Anbau werden Regenwälder abgeholzt."
                                            },
                                            {
                                                "example_id": "21e06f42-0609-4d63-92ae-0238ded940b2",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Zur Fütterung ihrer Jungen fliegen sie [die Mauersegler] bei schlechten Wetterbedingungen zur Nahrungssuche bis zu 100 Kilometer vom Nest weg und können bei günstigen Windverhältnissen dabei einen Zweistundenrhythmus einhalten."
                                            },
                                            {
                                                "example_id": "0037dd44-783a-4693-9c64-57e6e868420d",
                                                "sense_id": "147f2651-8851-38a9-85ca-c87d8e074a32",
                                                "text": "Die Rohfütterung bietet gegenüber der Fütterung mit Fertigfutter keine ernährungsphysiologischen Vorteile und birgt neben der Gefahr einer Mangelernährung auch mikrobiologische Risiken sowohl für die roh gefütterten Tiere als auch die mit ihnen zusammen lebenden Menschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "934c7cb0-10a0-3c3a-8ae2-89b7b5f342ea",
                                        "entry_id": "f8093725-c644-3902-9173-e5a34194b0bc",
                                        "glosses": [
                                            "das wärmende Fleece in einer Jacke, einem Mantel oder einem Schlafsack, was unter dem Futter eingenäht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d59f59-2063-4503-ba98-ec57338815e8",
                                                "sense_id": "934c7cb0-10a0-3c3a-8ae2-89b7b5f342ea",
                                                "text": "Die Qualität der Fütterung bestimmt, ob der Schlafsack im Winter benutzbar ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dd55706-99b2-42d4-8902-1b739af783ac",
                        "source_entry_id": "a1600eda-11d5-355a-a0e7-63f32d6f1b30",
                        "target_lang_word": "doublure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doublure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad0898a-6612-3ef6-b8fe-5b045912d3c9",
                                        "entry_id": "40549126-7eb4-3c6c-ae09-35a0cedde757",
                                        "glosses": [
                                            "Étoffe ou toute autre matière dont une autre est doublée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f35993a-9ba5-4486-9f90-6804a64023e7",
                                                "sense_id": "1ad0898a-6612-3ef6-b8fe-5b045912d3c9",
                                                "text": "Le vêtement renfermait des papiers dans la doublure. Mais, quelle que fût sa curiosité, l’obscurité était trop profonde pour qu’il les sortît de leur cachette et les examinât."
                                            },
                                            {
                                                "example_id": "3a2a1718-7dff-41aa-ad65-4f2479097a63",
                                                "sense_id": "1ad0898a-6612-3ef6-b8fe-5b045912d3c9",
                                                "text": "Au fond de sa poche, un œuf d’agace, pourri, cassé qui poissait la doublure et empestait."
                                            },
                                            {
                                                "example_id": "cc65dd6c-d213-431d-b4ca-c13a355d4455",
                                                "sense_id": "1ad0898a-6612-3ef6-b8fe-5b045912d3c9",
                                                "text": "Dirait-il que le mouvement de la marche avait révélé la doublure de ce vêtement — était-ce de la castorette ? —, outre une jupe de tweed qui descendait jusqu’au genou ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76dc79be-9b5d-36cd-84fa-16d7b2fb25cc",
                                        "entry_id": "40549126-7eb4-3c6c-ae09-35a0cedde757",
                                        "glosses": [
                                            "Acteurs et actrices qui remplacent les chefs d’emplois dans leurs rôles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c7a1a56-85b0-4e30-abb9-ab61f2d6b5cf",
                                                "sense_id": "76dc79be-9b5d-36cd-84fa-16d7b2fb25cc",
                                                "text": "Ce comédien est la doublure d’un tel."
                                            },
                                            {
                                                "example_id": "097a1ce9-ed45-47fa-bbd2-35d384e6b24b",
                                                "sense_id": "76dc79be-9b5d-36cd-84fa-16d7b2fb25cc",
                                                "text": "Dans la troupe, ce fut une consternation générale. Pas tellement à cause de ce que Manola était sympa, mais parce que chacun avait réalisé subitement qu’il n’avait pas encore de doublure, qu’il faudrait trouver une autre grande vedette pour prendre le rôle […] et qu’il faudrait au moins un mois avant de reprendre le spectacle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53b0f92e-8392-334c-b851-fcd498212dbe",
                                        "entry_id": "40549126-7eb4-3c6c-ae09-35a0cedde757",
                                        "glosses": [
                                            "Acteurs et actrices qui remplacent les chefs d’emplois dans leurs rôles.",
                                            "Double, pâle copie."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02d3da22-36da-4e2b-ab34-facb8b5aae09",
                                                "sense_id": "53b0f92e-8392-334c-b851-fcd498212dbe",
                                                "text": "Cet homme n’est que la doublure de cet autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a3e7c6-411b-30f2-af9e-c6ea7a3d3d24",
                                        "entry_id": "40549126-7eb4-3c6c-ae09-35a0cedde757",
                                        "glosses": [
                                            "Répliques d’une scène dans une autre langue."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe24a1fa-369e-4c7b-a8c4-29b037c7d250",
                                                "sense_id": "88a3e7c6-411b-30f2-af9e-c6ea7a3d3d24",
                                                "text": "Elle a également réalisé les doublures voix pour plusieurs séries sur Netflix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e974ef55-8d59-3775-b051-1b224946bd03",
                                        "entry_id": "40549126-7eb4-3c6c-ae09-35a0cedde757",
                                        "glosses": [
                                            "Remplaçant, dans une corrida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc5a193-7490-45f4-bb3f-20010ada3965",
                                                "sense_id": "e974ef55-8d59-3775-b051-1b224946bd03",
                                                "text": "Ce spectacle n’a pas d’entr’acte, rien ne le suspend, pas même la mort d’un torero. Comme nous l’avons dit, les doublures sont là tout habillées et armées en cas d’accidents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
