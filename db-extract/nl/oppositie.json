                                                "sense_id": "cae5c5ce-d170-3c4d-921a-6122155feca1",
                                                "text": "La oposición volvió a acusar al gobierno de corrupción."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5b89b305-76b4-3560-ab1c-cc65c7906879",
                                        "entry_id": "aac7cd82-09fe-3f77-a108-fe26042d575c",
