                ],
                "senses": [
                    {
                        "sense_id": "c4f12bd0-94b1-3d4b-820f-58c899791094",
                        "entry_id": "07be8e7c-17ca-3d80-afe0-d410757dbeca",
                        "glosses": [
                            "Gefäß"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "2b576f9e-d886-4331-830a-008131af4345",
                                "sense_id": "c4f12bd0-94b1-3d4b-820f-58c899791094",
                                "text": "„Aus der Füllerde der Grube stammen zahlreiche Scherben der jüngeren Linienbandkeramik, die sich zum Teil zu einem Kumpf ergänzen ließen, eine Feuersteinklinge mit Lackpatina und wenig Holzkohle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7ef8a5b9-7c9d-339e-b1dd-1cc357566a3a",
                        "entry_id": "07be8e7c-17ca-3d80-afe0-d410757dbeca",
                        "glosses": [
                            "am Gürtel getragenes Gefäß, in dem der Wetzstein feucht gehalten wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "f714e135-10a1-41eb-b70c-89248cea9035",
                                "sense_id": "7ef8a5b9-7c9d-339e-b1dd-1cc357566a3a",
                                "text": "„So zieht aus seinem Kumpf, Mit Wasser gefüllt, Der Mäher den Wetzstein; […]“"
                            },
                            {
                                "example_id": "b8fd701d-26bb-4af9-88c3-e44e59e9c706",
                                "sense_id": "7ef8a5b9-7c9d-339e-b1dd-1cc357566a3a",
                                "text": "„Der Vater bekam einen Wetzstein, kein Mäher hat jemals einen besseren in seinen Kumpf gesteckt, und eine Sense, wie keine jemals durch das Gras gezogen worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
