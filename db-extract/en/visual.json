                                    {
                                        "sense_id": "52480753-54cb-35fd-acb7-db4db3b65b74",
                                        "entry_id": "293d9475-e8c8-3cee-a4d8-30c16e3c9f15",
                                        "glosses": [
                                            "Relatif à la vue ou à la vision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7b04e70-5838-452b-a738-1e8fcd069a3b",
                                                "sense_id": "52480753-54cb-35fd-acb7-db4db3b65b74",
                                                "text": "Il a été prouvé que la privation de sommeil entraîne une baisse de la résistance aux distractibilités visuelle et auditive (Harrison et Horne, 2000b)."
                                            },
                                            {
                                                "example_id": "3cc8d835-e61e-4ae0-9229-1d332ab10f1c",
                                                "sense_id": "52480753-54cb-35fd-acb7-db4db3b65b74",
                                                "text": "L’impact visuel est nettement plus fort que prévu, regrette la maire [DVD], Michèle Quellard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                        "entry_id": "293d9475-e8c8-3cee-a4d8-30c16e3c9f15",
                                        "glosses": [
                                            "De vue, de vision."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85171f8-49ba-4e86-b19f-7c599a1911aa",
                                                "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                                "text": "Axe visuel, Ligne droite qui, passant par le centre de la cornée transparente, va aboutir au fond de l’œil."
                                            },
                                            {
                                                "example_id": "fdfbd177-6ac1-46e9-8ad9-c5a03dbe86ea",
                                                "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                                "text": "Angle visuel : Angle que forment entre eux les rayons extrêmes envoyés vers l’œil par un corps."
                                            },
                                            {
                                                "example_id": "e28aae43-2263-4b54-ae9e-2ae81bc72163",
                                                "sense_id": "50f0cc91-ee0d-32bd-8c53-e1425cab53ac",
                                                "text": "Horizon visuel : Étendue embrassée par le regard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "visuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa71883c-2cfd-384f-9f24-18726a734f73",
                                        "entry_id": "f2cfd75d-e5f2-39e1-9753-d1a915e120db",
                                        "glosses": [
                                            "Document présenté à une assemblée pendant un exposé pour illustrer celui-ci, ou le rendre plus clair ou plus éloquent."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "597e6eb7-1ae6-4947-b68f-654bc8cc1d46",
                                                "sense_id": "aa71883c-2cfd-384f-9f24-18726a734f73",
                                                "text": "Certains orateurs illustrent leur exposé par des documents — que les publicistes actuels nomment (à la mode américaine) des « visuels »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334d2202-0792-3785-95be-a693a580cf48",
