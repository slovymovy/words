                        "source_sense_id": "5fa3e08b-4596-3aa6-9733-6c1abece70a5",
                        "source_sense_description": "fürs Erste, erst einmal, unter dem Vorbehalt, dass es sich ändern wird",
                        "target_lang_word": "pour le moment",
