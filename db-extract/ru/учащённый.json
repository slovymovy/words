                                    {
                                        "sense_id": "f5c46102-e569-3b61-8266-3fc93f83df87",
                                        "entry_id": "76635837-af33-3044-b623-e97a405b9103",
                                        "glosses": [
                                            "Ellipsis of rapid chess."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdbe73c-041f-4fcc-83dd-743c559d89d1",
                                                "sense_id": "f5c46102-e569-3b61-8266-3fc93f83df87",
                                                "text": "In these rapid games we had just twenty-five minutes each to make all our moves, a far cry from traditional chess, where games can last up to seven hours."
                                            },
                                            {
                                                "example_id": "297d0921-0da0-4d40-960b-5d63091fcb62",
                                                "sense_id": "f5c46102-e569-3b61-8266-3fc93f83df87",
                                                "text": "In order to avoid misunderstanding, I must note that I object to the attempts to displace normal chess with fast play, not rapid or blitz in general. I love them both, and, if I were to choose which to play, classic or rapid, I would choose rapid."
                                            },
                                            {
                                                "example_id": "2935e312-5413-4308-81f8-cb1b20a1a86d",
                                                "sense_id": "f5c46102-e569-3b61-8266-3fc93f83df87",
                                                "text": "I haven’t played against Wesley So—I’ve played him a bunch online in rapid games, but not in classical rounds."
                                            }
