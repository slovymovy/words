                ],
                "senses": [
                    {
                        "sense_id": "42398e24-e88c-3c91-8b65-6686347b3cde",
                        "entry_id": "8488aa71-df26-37b7-8048-78f0a9d84239",
                        "glosses": [
                            "pierwsza, podstawowa przyczyna czegoś"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "42fff3b9-25c1-40a1-a4ca-76f69debe1ab",
                                "sense_id": "42398e24-e88c-3c91-8b65-6686347b3cde",
                                "text": "Ludzie, którzy doświadczyli osobiście tego rodzaju przypadków, są absolutnie przekonani, że widzieli to coś w rzeczywistości. Natomiast uczeni twierdzą, że praprzyczyna tych przywidzeń ukryta jest w ludzkim mózgu"
                            },
                            {
                                "example_id": "3eb67f84-9012-4e70-9ef0-39f2af71bf3a",
                                "sense_id": "42398e24-e88c-3c91-8b65-6686347b3cde",
                                "text": "W filozofii zachodniej zadaniem metafizyki było poznanie praprzyczyny i pierwszej zasady wszechrzeczy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c262cad-073d-4234-b178-847e649bcee2",
                        "source_entry_id": "8488aa71-df26-37b7-8048-78f0a9d84239",
                        "source_sense_id": "42398e24-e88c-3c91-8b65-6686347b3cde",
                        "target_lang_word": "первопричина",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "первопричина",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3554ab9-a53d-33e2-aca9-dc84cf36a4c0",
                                        "entry_id": "418fe2e9-d55e-34c0-a773-a839078e7130",
                                        "glosses": [
                                            "основная, исходная, первая причина чего-либо"
                                        ],
                                        "tags": [
                                            "обычно книжн."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c35dc23-e479-4ca3-8d59-c918dc4c8f15",
                                                "sense_id": "a3554ab9-a53d-33e2-aca9-dc84cf36a4c0",
                                                "text": ".. что мы познаём или высказываем о первой причине, это скорее мы сами, чем первопричина; ибо последняя выше всякого познания и высказывания!"
                                            },
                                            {
                                                "example_id": "b8c97804-7ed5-444e-8720-c73ccd7d2639",
                                                "sense_id": "a3554ab9-a53d-33e2-aca9-dc84cf36a4c0",
                                                "text": "Ибо Бог есть первопричина, духовная основа всей жизни и, отрицая эту высшую Мощь в нас, мы, истинно, произносим хулу на Духа Святого; утрачивая путь и связь с Высшим, ведущим Началом, ввергаемся в бездну хаоса, служа отбросом для переработки. ❬…❭ И раз Он есть всё, то, значит, Он не только первопричина, но и следствие."
                                            },
                                            {
                                                "example_id": "df47cfb9-84fd-4350-86c4-7cab4b7a1d95",
                                                "sense_id": "a3554ab9-a53d-33e2-aca9-dc84cf36a4c0",
                                                "text": "Одной из первопричин конфронтации между двумя супердержавами ― Советским Союзом и США являлась борьба за приоритет в создании атомной бомбы и за овладение немецким ракетным наследством."
                                            },
                                            {
                                                "example_id": "8160f221-9624-4c78-9215-c1050fb1f443",
                                                "sense_id": "a3554ab9-a53d-33e2-aca9-dc84cf36a4c0",
                                                "text": "«Главным свойством этого неуживчивого характера, я бы сказал, первопричиной этой неуживчивости была не какая-нибудь там склочность его натуры, а основополагающая черта его личности, для обозначения которой я не могу подобрать никакого другого слова, кроме старомодного, уже почти вышедшего из употребления: донкихотство»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
