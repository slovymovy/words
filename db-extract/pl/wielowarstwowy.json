                                            {
                                                "example_id": "50713c01-6a59-4b68-a1d9-c00ec118e746",
                                                "sense_id": "0bd7cef4-42e3-3be5-96a5-a4fa7c889d7b",
                                                "text": "Der Zellaufbau der Haut ist mehrschichtig."
