                "senses": [
                    {
                        "sense_id": "b602e7b2-344f-311c-b229-e57b22a44b10",
                        "entry_id": "b277845a-7a5f-3bed-b01e-ae0e349325e9",
                        "glosses": [
                            "Mesure de capacité qui était en usage dans les colonies espagnoles d’Amérique du Sud."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d7cbfd9-ce09-45c0-88b6-a1c7394d1114",
                                "sense_id": "b602e7b2-344f-311c-b229-e57b22a44b10",
                                "text": "Aux environs de la Ville de Moquaquos, dans un terrein très-petit on recueille tous les ans 100000 botiches de vin qui font plus de trois millions deux cent pintes, mesure de Paris, qui, à vingt cinq réaux la botiche, donnent quatre cent mille piastres, c’est-à-dire, à présent un million six cent mille livres, monnoye de France."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c8115a6-2815-3ef9-9bbd-5ed712e8309d",
                        "entry_id": "b277845a-7a5f-3bed-b01e-ae0e349325e9",
                        "glosses": [
                            "Récipient de cette capacité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a49a3a9c-ae22-4547-8052-1b9ad76cb347",
                                "sense_id": "6c8115a6-2815-3ef9-9bbd-5ed712e8309d",
                                "text": "J’achetai plusieurs botiches d’eau-de-vie, quelques paniers de dattes, et je laissai arriver pour Lima avec une de ces brumes épaisses si fréquentes sur la côte, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "c28f14ac-b253-3839-baf7-77601464056d",
                        "entry_id": "b277845a-7a5f-3bed-b01e-ae0e349325e9",
                        "glosses": [
                            "Récipient utilisé au cours des vendanges, pour transporter le raisin de la vigne au pressoir."
                        ],
                        "tags": [
                            "Régionalisme",
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "728f6431-9307-4856-8cb5-fddd8694f266",
                                "sense_id": "c28f14ac-b253-3839-baf7-77601464056d",
                                "text": "Riesling et Pinots semblent les plus affectés par la pourriture, les muscats, sylvaners et gewurztraminers résistant un peu plus pour le moment. Les peaux sont souvent très fines, les grappes écatent parfois dans la main quand on les cueille, et il n’est pas rare de voir des botiches pleines de raisin dont les jus de goutte atteignent la mi-hauteur."
                            }
                        ]
                    }
