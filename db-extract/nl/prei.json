                                "target_senses": [
                                    {
                                        "sense_id": "2754b3a5-6135-3e76-8b15-afaa9b66bb7d",
                                        "entry_id": "6748e3b2-04da-3051-b48f-c0d2d355c3e0",
                                        "glosses": [
                                            "Gemüsesorte aus der Gattung Allium in der Familie der Lauchgewächse (Alliaceae)"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "178122aa-176a-4b52-80d9-0596487ce8f1",
                                                "sense_id": "2754b3a5-6135-3e76-8b15-afaa9b66bb7d",
                                                "text": "Um Lauch als Gemüsebeilage zuzubereiten, schneidet man ihn in Ringe und dünstet ihn dann."
                                            },
                                            {
                                                "example_id": "a529105f-6cda-468d-b719-384fb6ca33c3",
                                                "sense_id": "2754b3a5-6135-3e76-8b15-afaa9b66bb7d",
                                                "text": "„Einen Moment lang stand ich da und betrachtete den Esstisch, an dem Clay und ich an jenem unerträglich heißen Sonntagnachmittag Lauch geschnitten und Kartofeln geschält hatten.“"
                                            },
                                            {
                                                "example_id": "eda28702-087d-45df-b9ad-70a5e18ee687",
                                                "sense_id": "2754b3a5-6135-3e76-8b15-afaa9b66bb7d",
                                                "text": "„Bis zum Ende der Gartensaison wird der Lauch groß und stark.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc6a4a49-55e6-3c3e-9d5a-db6c2011e805",
                                        "entry_id": "6748e3b2-04da-3051-b48f-c0d2d355c3e0",
                                        "glosses": [
                                            "Bezeichnung für verschiedene Lauchgewächse der Gattung Allium, zum Beispiel Porree (siehe [1]), Knoblauch, Rokambolle"
                                        ],
                                        "tags": [
                                            "Plural 1"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f805b8c-98b9-37a4-a54c-f146926eb7b5",
                                        "entry_id": "6748e3b2-04da-3051-b48f-c0d2d355c3e0",
                                        "glosses": [
                                            "jemand, der sich seltsam oder peinlich verhält; schwache, einfältige Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e412fd59-9180-4d31-a3eb-09c586028ca2",
                                                "sense_id": "3f805b8c-98b9-37a4-a54c-f146926eb7b5",
                                                "text": "„‚Hey, nein, das ist meine Flasche, du Lauch, nimm die mir nicht weg, ich hab Durst‘, lallte ich vollkommen dicht.“"
                                            },
                                            {
                                                "example_id": "8a2c166b-9037-465f-8fab-0518319b3652",
                                                "sense_id": "3f805b8c-98b9-37a4-a54c-f146926eb7b5",
                                                "text": "„‚Lauch, Digga!‘ raunt er, während er in Spannerhaltung durchs Fenster des billigen Lüneburger Motels das mutmaßliche Liebespaar beobachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc35a5eb-ef9c-368e-8773-ab5ae72a72ff",
                                        "entry_id": "b4a1d3c7-cdc5-3463-b5e3-3160c2ccb089",
                                        "glosses": [
                                            "Fluss in Frankreich, linker Nebenfluss der Ill, entsteht in den Vogesen und mündet bei Colmar, circa 53 km Länge, in einem Teilbereich seit 1894 gestaut zum Lauchsee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb6f2a3a-68ac-49fa-8cc0-bf29c72ab5ee",
                                                "sense_id": "fc35a5eb-ef9c-368e-8773-ab5ae72a72ff",
                                                "text": "In Colmar liegen malerische, blumengeschmückte Fachwerkhäuschen an dem Flüsschen Lauch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
