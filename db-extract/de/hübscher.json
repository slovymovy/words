                ],
                "senses": [
                    {
                        "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                        "entry_id": "16fc826a-19db-3b11-9902-aa5fd5b61030",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9427eb8-8b73-439a-bcf3-e270b8e3edfe",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Hübscher das Schmücken von Weihnachtsbäumen."
                            },
                            {
                                "example_id": "151b730c-14be-4118-9268-e33b07df1151",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Frau Hübscher ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c5dfc3b6-f7ec-41b8-a2bf-68586eff66f7",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Herr Hübscher wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "226c19fc-b739-436e-ad3f-44203939cf39",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Die Hübschers kommen heute von Fehmarn."
                            },
                            {
                                "example_id": "be182fcc-cb2e-4732-ad40-f9e5fb65fc16",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Der Hübscher trägt nie die Schals, die die Hübscher ihm strickt."
                            },
                            {
                                "example_id": "af062fe9-841b-48a9-88f0-275550dbc4a8",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hübscher kommt, geht der Herr Hübscher.“"
                            },
                            {
                                "example_id": "e5d3bfa5-44fc-43ab-8edc-8b8c76dfd62a",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Hübscher kommt und geht."
                            },
                            {
                                "example_id": "d203ab02-d9f1-4fac-a844-0e120a762b20",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "Hübschers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e9885bc4-ec8c-4831-976c-dd84efe807a0",
                                "sense_id": "8491d99a-080f-3086-a14f-8d7a11ab3313",
                                "text": "An verregneten Herbsttagen ist Familie Hübschers liebste Beschäftigung das Bemalen von Hühnereiern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
