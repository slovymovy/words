                        "entry_id": "5c5d749e-4a41-308f-9874-e9340ba29f37",
                        "glosses": [
                            "A person who transported goods, usually with a horse and cart."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "270a5886-8aa4-4de9-a01d-fcb0856ebff3",
                                "sense_id": "5c38f7f6-12df-30a1-8f26-ec9515467a1b",
                                "text": "Nine main depots and a number of sub-depots are involved and the carmen, after leaving their depots, were entirely under a controller's instructions."
                            },
                            {
                                "example_id": "15f4deb1-9e73-41f7-a729-77c62666d247",
                                "sense_id": "5c38f7f6-12df-30a1-8f26-ec9515467a1b",
                                "text": "In this book, journalist and researcher Christer Holmgren explains why the murders were never cleared up and names the East End carman Charles Lechmere as the culprit behind both series of murders."
                            },
                            {
                                "example_id": "7550d0b8-fc47-4929-866f-9a7f91de35d7",
                                "sense_id": "5c38f7f6-12df-30a1-8f26-ec9515467a1b",
                                "text": "The witnesses for the day; two Inspector plods, the peeler who’d been patrolling Baker’s Row when informed of the murder; Charles Cross, the carman who’d done the telling after discovering Nichols dead; William Nichols, the slag’s grieving husband, and others."
                            }
                        ]
                    }
