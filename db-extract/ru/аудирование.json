                                        "entry_id": "9b5fa354-a919-3f6b-87be-b6fa91a18bf0",
                                        "glosses": [
                                            "Of something or someone that listens."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0983beb-5e15-43f6-b495-1da2af02eab3",
                                                "sense_id": "7715feaf-c900-3e65-a73d-bf6d12dae162",
                                                "text": "Any listening person can tell she's lying."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f845e2ea-c946-3d75-8b48-4f338342b30d",
                                        "entry_id": "9b5fa354-a919-3f6b-87be-b6fa91a18bf0",
                                        "glosses": [
                                            "Of something that is used in order to hear or to improve the ability to hear."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f60d48f-e932-48f1-bd8e-5495f83cbacd",
                                                "sense_id": "f845e2ea-c946-3d75-8b48-4f338342b30d",
                                                "text": "He could hear better when he used his listening device."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28a84e1c-4464-3322-9300-8bd3a08287f5",
                                        "entry_id": "9b5fa354-a919-3f6b-87be-b6fa91a18bf0",
                                        "glosses": [
                                            "Of an action that is performed with caution and attention to sounds."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18228746-0ea3-4d8e-836b-dc29c685a769",
                                                "sense_id": "28a84e1c-4464-3322-9300-8bd3a08287f5",
                                                "text": "The safest cover lay close under the wall of the cañon, and here through the dense thickets Venters made his slow, listening advance toward the oval."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "listening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21f1a014-3073-3bf3-8f31-96c5ed1c1693",
                                        "entry_id": "bad2f0b3-28c5-3bd9-9039-c80807cd5576",
                                        "glosses": [
                                            "present participle and gerund of listen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a08959cb-7419-4011-8b59-1a494504cf39",
                                                "sense_id": "21f1a014-3073-3bf3-8f31-96c5ed1c1693",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "listening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68500559-7ac6-3140-aff6-4b9da6b30b71",
                                        "entry_id": "affc7b97-6df8-3415-8e14-27c19516d81a",
                                        "glosses": [
                                            "An act by which something or somebody is listened to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d1b08bb-f1aa-4a82-b6e2-9d6f8373b610",
                                                "sense_id": "68500559-7ac6-3140-aff6-4b9da6b30b71",
                                                "text": "This symphony grows on me more and more with each listening."
                                            },
                                            {
                                                "example_id": "d019a9b5-3da1-4f63-a4e7-6e9a7b49fc50",
                                                "sense_id": "68500559-7ac6-3140-aff6-4b9da6b30b71",
                                                "text": "It is an album that rewards multiple listenings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8adc604-363f-3783-b5aa-21aab83c2d59",
                                        "entry_id": "affc7b97-6df8-3415-8e14-27c19516d81a",
                                        "glosses": [
                                            "An educational exercise involving listening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee188dc9-ebe8-40db-83c4-92fac6fd9e97",
                                                "sense_id": "d8adc604-363f-3783-b5aa-21aab83c2d59",
                                                "text": "OK, students, today we're going to do a couple of listenings about the environment, then a reading about crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cce0b3a-639f-3de4-876a-5f5781146600",
                                        "entry_id": "affc7b97-6df8-3415-8e14-27c19516d81a",
