                            {
                                "example_id": "b21f2d18-1407-462b-8782-a74615b9ed5a",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„Derzeit wohnen laut Sozialbehörde 28.957 Menschen in öffentlichen Unterkünften, darunter 4.442 Wohnungslose, 15.112 wohnberechtigte Zuwanderer und 9.403 Zuwanderer, die noch keine eigene Wohnung anmieten dürfen.“"
                            },
                            {
                                "example_id": "b2d90487-3a05-44cb-97fa-e3cd87e01c87",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„Dem I. Wohnungsbaugesetz zufolge waren Personen wohnberechtigt, deren Einkommen die Pflichtversicherungsgrenze für Angestellte nicht überstieg, was den weit überwiegenden Anteil der Bevölkerung einschloss.“"
                            },
                            {
                                "example_id": "b2d26a45-a95a-4836-8f05-9f410dcbb870",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„Auch die mit dem II. Wohnungsbaugesetz eingeführten Einkommensgrenzen waren so weit gefasst, dass ca. drei Viertel der Haushalte wohnberechtigt waren.“"
                            },
                            {
                                "example_id": "257ae0a7-ac0e-47c3-bec0-4fa8713d3218",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„1978 waren noch 47% und 1999 nur noch ca. 37% aller Haushalte wohnberechtigt“ […]."
                            },
                            {
                                "example_id": "1c3b3488-d345-4145-bd49-f36f053f4d50",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„Jahrzehntelang wurden die Einkommensgrenzen für die Wohnberechtigung nicht angehoben, während die Einkommen kräftig stiegen. Waren früher rund 70 Prozent der Bevölkerung im Prinzip wohnberechtigt, sind es jetzt nur noch 30 Prozent, sagt Riedl.“"
                            },
                            {
                                "example_id": "e6265d99-2e08-4e28-b0e8-8578368148a8",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„DSW-Generalsekretär Bachmann verwies gestern darauf, daß 1992 in den alten Bundesländern nur für ungefähr zehn Prozent aller wohnberechtigten Studenten öffentlich geförderte Wohnplätze zur Verfügung standen.“"
                            },
                            {
                                "example_id": "6944b5f2-ffb2-4a35-b399-6adf47f1f610",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "[München – Stadtbezirksbudget:] „Je wohnberechtigter Person im Viertel überweist das Rathaus zwei Euro pro Jahr.“"
                            },
                            {
                                "example_id": "6a7de9df-b29f-424c-90ff-60dd12cd74ba",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "[München:] „Der Ausländeranteil, gemessen an sogenannten wohnberechtigten Personen, wird um fünf Prozentpunkte auf 32,9 Prozent ansteigen.“"
                            },
                            {
                                "example_id": "3674e00f-4024-4920-ba8f-7726392d961c",
                                "sense_id": "6f1d0478-6110-3cea-9280-737957a062bd",
                                "text": "„Fürstenfeldbruck will einigen wohnberechtigten ehemaligen Flüchtlingen den Umzug in städtische Neubauten ermöglichen und damit der Unterbringungspflicht nachkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
