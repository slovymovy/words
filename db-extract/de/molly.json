                        "glosses": [
                            "ein kleiner, Fisch in der Gattung Poecilia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b77ac7-6465-4672-a5af-f01d489da6b7",
                                "sense_id": "a87004e1-ad42-315a-bddc-75ee66a23c41",
                                "text": "Wenn bei der Haltung die grundsätzlichsten Bedürfnisse des Molly befriedigt werden, zeigt er sich als quirliger Fisch, den zu beobachten es viel Freude macht."
                            },
                            {
                                "example_id": "b62f5a33-c590-4aa2-aae3-bf842d66487a",
                                "sense_id": "a87004e1-ad42-315a-bddc-75ee66a23c41",
                                "text": "Der Molly gehört zur Unterfamilie der lebendgebärenden Zahnkarpfen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1004f2a5-039d-36aa-b560-968c4363e1bd",
                        "entry_id": "aa4b3d9d-2caa-365a-b256-4e0c8c9e88d7",
                        "glosses": [
                            "Droge aus künstlich hergestellten Amphetaminderivaten, die zumeist in Form von Tabletten konsumiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca3ad47-d21a-4ec0-895e-fcb7271feff2",
                                "sense_id": "1004f2a5-039d-36aa-b560-968c4363e1bd",
                                "text": "„Er hat immer Molly und Tabak dabei und ist jederzeit bereit zu teilen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
