                    {
                        "sense_id": "70a84755-19fe-365e-b035-be9fd9aa3d51",
                        "entry_id": "c1102576-1938-3453-83e8-293a40b00a70",
                        "glosses": [
                            "To remove the tiles from."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b755bb1c-47d8-4da8-a3a8-7d97f9943ebe",
                                "sense_id": "70a84755-19fe-365e-b035-be9fd9aa3d51",
                                "text": "But before they went, Sir W. Batten and my lady did begin to taunt them, but the rogues answered them as high as themselves, and swore they would come again, and called me rogue and rebel, and they would bring the sheriff and untile his house, before he should harbour a rebel in his house, and that they would be here again shortly."
                            },
                            {
                                "example_id": "d333e7bb-3ae7-4108-89d1-67b8ea5eae98",
                                "sense_id": "70a84755-19fe-365e-b035-be9fd9aa3d51",
                                "text": "As soon as he arrived, he prepared to force his way into the house, but it was found so impracticable that at length they were obliged to untile part of the roof, from whence a person descended, and opened the door to those who did not choose so dangerous an entrance as that through which he had passed."
                            }
                        ]
                    }
