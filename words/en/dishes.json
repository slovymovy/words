                                "ru": "Шеф-повар <w>разливает</w> суп ожидающим клиентам.",
                                "zh": "厨师把汤<w>盛</w>给等待的顾客。"
                            }
                        },
                        {
                            "text": "She often <w>dishes</w> up a delicious meal for her family on Sundays.",
                            "target_lang_translations": {
                                "ru": "Она часто <w>подаёт</w> вкусный обед своей семье по воскресеньям.",
                                "zh": "她经常在周日为家人<w>端上</w>美味的饭菜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dish out",
                        "dish up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола 'dish' в третьем лице единственного числа: раскладывает еду или подает на стол.",
                        "zh": "动词 dish 的第三人称单数形式，指分发食物或盛菜上桌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскладывает",
                                "target_lang_sense_clarification": "еду по тарелкам"
                            },
                            {
                                "target_lang_word": "подаёт",
                                "target_lang_sense_clarification": "на стол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盛",
                                "target_lang_sense_clarification": "指把食物装入容器"
                            },
                            {
                                "target_lang_word": "分发",
                                "target_lang_sense_clarification": "指将食物分配给他人"
