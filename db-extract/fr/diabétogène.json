                        "glosses": [
                            "Qualifie ce qui peut aggraver ou provoquer le diabète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f521606-a849-4556-954c-94420336a0bd",
                                "sense_id": "01abf315-a8b7-313e-bc17-da012051df7e",
                                "text": "L’hypoglycémie est alors responsable d’une riposte endogène qui ajoute son effet diabétogène à celui des apports glucidiques ou à l’évolution spontanée du diabète."
                            },
                            {
                                "example_id": "1a37a8b4-adf3-479f-9d51-9531ba9d73b5",
                                "sense_id": "01abf315-a8b7-313e-bc17-da012051df7e",
                                "text": "C’est en troublant ce mécanisme que la caféine ou la théophylline diminuerait l’insulino-sécrétion normalement suscitée par l’hyperglycémie et serait diabétogène."
                            }
                        ]
                    }
