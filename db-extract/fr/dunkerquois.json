                        "sense_id": "f13ba464-5683-3365-8798-a94747ae3e02",
                        "entry_id": "abf5bcef-7608-3048-9648-9d446fc8b70a",
                        "glosses": [
                            "Relatif à Dunkerque, commune française située dans le département du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a330aeb8-832c-4974-b331-79042c77f7ea",
                                "sense_id": "f13ba464-5683-3365-8798-a94747ae3e02",
                                "text": "Elle est anglaise avec une grand-mère dunkerquoise, mais la « gentilité » de la classe moyenne britannique et son souci d’imiter les raffinements du grand monde ont depuis longtemps effacé Dunkerque."
                            },
                            {
                                "example_id": "854b373f-abb5-4368-b802-4c6b6c89c1ed",
                                "sense_id": "f13ba464-5683-3365-8798-a94747ae3e02",
                                "text": "Des pyramidiots, il y en a beaucoup. Beaucoup trop, diraient certaines mauvaises langues, mais sans eux, il faut bien avouer que les internets seraient encore plus calmes qu’un dimanche après-midi dunkerquois."
                            }
                        ]
                    }
