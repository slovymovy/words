                        "sense_id": "49d7c5e4-c642-3f45-b42c-9019ac25cecc",
                        "entry_id": "da7e49c0-ff00-39b1-9522-a813fd43cef7",
                        "glosses": [
                            "Qu’on ne peut pas bâtir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad42e41-34ac-4b45-a869-24dee116e72e",
                                "sense_id": "49d7c5e4-c642-3f45-b42c-9019ac25cecc",
                                "text": "Depuis qu’il s’enfonce sous les pierres,\n cherchant la merveille des cristaux\n qui bâtiraient l’imbâtissable,\n — le maçon a perdu ses mains."
                            },
                            {
                                "example_id": "861a9820-9739-40fe-b804-7768a552a8f0",
                                "sense_id": "49d7c5e4-c642-3f45-b42c-9019ac25cecc",
                                "text": "Le château imbâtissable"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7c8d91d-37dc-36f5-97bb-1020c05dbc92",
                        "entry_id": "da7e49c0-ff00-39b1-9522-a813fd43cef7",
                        "glosses": [
                            "Sur quoi on ne peut rien bâtir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd5d702-39df-4e62-9477-ef090905dce3",
                                "sense_id": "c7c8d91d-37dc-36f5-97bb-1020c05dbc92",
                                "text": "En regard de la science et du progrès, ce ne sont que zones insalubres, inexploitables et imbâtissables."
                            },
                            {
                                "example_id": "447f7363-5840-43e8-8b02-217f510719d3",
                                "sense_id": "c7c8d91d-37dc-36f5-97bb-1020c05dbc92",
                                "text": "C’est aussi une ville religieuse, dont les faubourgs resteront imbâtissables, jusqu’à la Révolution et la remise en cause des maisons religieuses."
                            },
                            {
                                "example_id": "2d9c52e9-4e19-4660-87bd-9fedb6bd49d9",
                                "sense_id": "c7c8d91d-37dc-36f5-97bb-1020c05dbc92",
                                "text": "… secondé par son fils Michel, qui, sorti de l’École Centrale de de Paris, avait préconisé la mise en place de tirants pour assurer la stabilité du bâtiment sur un terrain considéré, depuis toujours, comme imbâtissable."
                            }
                        ]
                    }
