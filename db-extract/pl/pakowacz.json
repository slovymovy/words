                    {
                        "translation_id": "850b4f49-1de7-4bcc-87b7-1290ab564311",
                        "source_entry_id": "ac2075e3-22d4-3ad7-bb6d-e624641b490a",
                        "source_sense_id": "9113e5d7-bd3a-3b5c-bc26-2a39b598ebb5",
