                    {
                        "sense_id": "599d67ee-eb99-3e75-97d0-627909ced0f7",
                        "entry_id": "30e9ab0b-74d2-339c-af70-e2ade3bc80f1",
                        "glosses": [
                            "Dont la structure se compose de petites lames, de lamelles"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0d2d1e-ba7e-4cb8-a461-6e822d4ca4a5",
                                "sense_id": "599d67ee-eb99-3e75-97d0-627909ced0f7",
                                "text": "Le diaspore, de structure analogue (l'aluminium remplaçant le fer), se présente en cristaux lamellaires parfaitement clivables (parfois taillés pour la bijouterie, malgré leur fragilité) donnant des lamelles flexibles, et en agrégats écailleux."
                            },
                            {
                                "example_id": "c7476548-2c38-49f6-b60e-02fa10c10f0b",
                                "sense_id": "599d67ee-eb99-3e75-97d0-627909ced0f7",
                                "text": "L’autre stratégie consiste à diminuer l’activité du lithium métallique de l’anode en le remplaçant par un matériau d’intercalation pour les ions Li⁺, généralement du graphite, forme lamellaire du carbone."
                            }
                        ]
                    }
