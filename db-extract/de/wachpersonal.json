                        "glosses": [
                            "Personengruppe, die zur Wache gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a14d3bf0-4e0f-4213-807c-b85460ddfc7f",
                                "sense_id": "29bf2987-adae-30a5-be18-a8e43d649515",
                                "text": "„Vielmehr habe sich zumindest das Wachpersonal äußerst korrekt verhalten, bis auf einen Mann und eine Wächterin, die beide offenbar aus Prinzip die französischen Häftlinge schikanierten.“"
                            },
                            {
                                "example_id": "8ee70db7-31d7-47a0-84d0-a3a6f7e4b8b3",
                                "sense_id": "29bf2987-adae-30a5-be18-a8e43d649515",
                                "text": "„Als Angehörige von Nkomos Wachpersonal ermordet wurden und es offenkundig war, dass die Fünfte Brigade es auf sein Leben abgesehen hatte, floh der ZAPU-Chef am 7. März 1983 über die Grenze nach Botswana und von dort nach Großbritannien, wo er sich mehrere Jahre lang aufhielt.“"
                            }
                        ],
