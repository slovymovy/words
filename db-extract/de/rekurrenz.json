                "senses": [
                    {
                        "sense_id": "cebdc341-41a4-3e1a-bd64-755a110564c8",
                        "entry_id": "f0f3798b-31d1-332a-8148-12d0227147aa",
                        "glosses": [
                            "Wiederholung sprachlicher Einheiten im Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38e1ed46-b311-4b67-a7a8-ba5d03618a2f",
                                "sense_id": "cebdc341-41a4-3e1a-bd64-755a110564c8",
                                "text": "In einem Text über Haustierhaltung werden semantische Merkmale (Seme) wie [+belebt], [+männlich], [+weiblich] in den Bedeutungen der erwähnten Tiere mehrfach vorkommen und so zum semantischen Zusammenhalt (Isotopie) des Textes beitragen."
                            },
                            {
                                "example_id": "109fd0ae-be28-4497-ac0c-36eb49a8be0c",
                                "sense_id": "cebdc341-41a4-3e1a-bd64-755a110564c8",
                                "text": "Auch die Rekurrenz grammatischer Einheiten (z.B. des gleichen Tempus) kann zum Zusammenhalt der Sätze in Texten beitragen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b3c590e1-c3cf-3efb-a401-0f6ea3a93551",
                        "entry_id": "f0f3798b-31d1-332a-8148-12d0227147aa",
                        "glosses": [
                            "Wiederholung, mehrfaches Vorkommen von Krankheiten, Symptomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11091fa1-22d8-461b-94dd-31cb87619084",
                                "sense_id": "b3c590e1-c3cf-3efb-a401-0f6ea3a93551",
                                "text": "In der Medizin wird das erneute Auftreten von Symptomen auch als Rekurrenz bezeichnet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
