                ],
                "senses": [
                    {
                        "sense_id": "31147c33-9f9b-3c6e-a448-d994177a30fe",
                        "entry_id": "fd4ea084-499e-347b-8c19-4b77db829c2c",
                        "glosses": [
                            "die kleinste Zelle der Gesellschaft, bestehend aus Eltern und Kindern"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a212bd6e-c526-45df-8f36-c42577f71ffd",
                                "sense_id": "31147c33-9f9b-3c6e-a448-d994177a30fe",
                                "text": "Die Kernfamilie aus dem Deutschland der 1950er und 1960er Jahre ist immer seltener anzutreffen."
                            },
                            {
                                "example_id": "8543d68e-56af-47d1-9731-bc96ab436825",
                                "sense_id": "31147c33-9f9b-3c6e-a448-d994177a30fe",
                                "text": "Die Kernfamilie besteht zumeist aus Vater, Mutter und deren Kindern."
                            },
                            {
                                "example_id": "2414f31f-184d-4904-9364-1218f8781f44",
                                "sense_id": "31147c33-9f9b-3c6e-a448-d994177a30fe",
                                "text": "„Nun waren sie zu sechst im Kohlgrunder Zimmer; die kleine Kernfamilie, dazu die Mutter und nun auch die beiden Pflegekinder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62c73482-bd03-4332-bafd-662f240eda46",
                        "source_entry_id": "fd4ea084-499e-347b-8c19-4b77db829c2c",
                        "source_sense_id": "31147c33-9f9b-3c6e-a448-d994177a30fe",
                        "source_sense_description": "Soziologie: die kleinste Zelle der Gesellschaft, bestehend aus Eltern und Kindern",
                        "target_lang_word": "nuclear family",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuclear family",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "171d1e81-8880-3fd3-bd58-76674d25093d",
                                        "entry_id": "085c75d7-6260-3980-8009-655323302357",
                                        "glosses": [
                                            "A family unit consisting of two parents (traditionally a mother and a father) and their children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d751ef5-58b7-4ab7-834f-6a48304e8db7",
                                                "sense_id": "171d1e81-8880-3fd3-bd58-76674d25093d",
                                                "text": "The initial result of that fragmentation, the nuclear family, didn’t seem so bad. But then, because the nuclear family is so brittle, the fragmentation continued. In many sectors of society, nuclear families fragmented into single-parent families, single-parent families into chaotic families or no families."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91370ebd-9dbd-4b97-854c-4ae0b4007c17",
                        "source_entry_id": "fd4ea084-499e-347b-8c19-4b77db829c2c",
                        "source_sense_id": "31147c33-9f9b-3c6e-a448-d994177a30fe",
                        "source_sense_description": "Soziologie: die kleinste Zelle der Gesellschaft, bestehend aus Eltern und Kindern",
                        "target_lang_word": "famille nucléaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "famille nucléaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "574b3dcd-4aa6-3b24-99ff-c4c80bb4eb56",
                                        "entry_id": "7640f0cf-e544-3497-9f6c-bd02fb5c807f",
                                        "glosses": [
                                            "Famille constituée de deux parents (traditionnellement un père et une mère) et de leurs enfants."
                                        ],
                                        "tags": [
                                            "Sociologie de la famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17639af6-9dfd-4e5d-9093-9199669edea1",
                                                "sense_id": "574b3dcd-4aa6-3b24-99ff-c4c80bb4eb56",
                                                "text": "L’installation dans les grandes villes s’est souvent accompagnée d’une réduction de la famille à sa plus simple expression, la famille nucléaire."
                                            },
                                            {
                                                "example_id": "987c5454-5a8b-4255-a83a-1c69640d6ab1",
                                                "sense_id": "574b3dcd-4aa6-3b24-99ff-c4c80bb4eb56",
                                                "text": "Une famille nucléaire, le clan familial élargi, un groupe d’amis plus conséquent, les voisins du quartier ou les collègues de bureau… Pour les humains, vivre dans une société à plusieurs niveaux apparaît comme une évidence."
                                            },
                                            {
                                                "example_id": "9d205ee2-94e3-4b69-bc38-d2fd74c623d3",
                                                "sense_id": "574b3dcd-4aa6-3b24-99ff-c4c80bb4eb56",
                                                "text": "Les réunions de famille continuent de rythmer la vie sociale, particulièrement pendant les fêtes de fin d'année. Mais les liens familiaux d'aujourd'hui sont-ils les mêmes que ceux d'hier ? Familles mono ou homoparentales, familles recomposées... La famille nucléaire traditionnelle a-t-elle vécu ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6837ad37-4c83-496b-8607-ce71db442b7f",
                        "source_entry_id": "fd4ea084-499e-347b-8c19-4b77db829c2c",
