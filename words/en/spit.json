    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c186ee8-bfcf-3d44-9c66-49d69f702d41",
                    "sense_definition": "To eject saliva or another substance from the mouth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sem_saliva",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dentist asked him to <w>spit</w> into the small basin.",
                            "target_lang_translations": {
                                "ru": "Стоматолог попросил его <w>сплюнуть</w> в маленькую миску.",
                                "zh": "牙医让他往小盆里<w>吐</w>。"
                            }
                        },
                        {
                            "text": "She tasted the sour milk and immediately <w>spat</w> it out.",
                            "target_lang_translations": {
                                "ru": "Она попробовала кислое молоко и тут же <w>выплюнула</w> его.",
                                "zh": "她尝了尝酸掉的牛奶，立刻就<w>吐</w>了出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expectorate"
                    ],
                    "common_phrases": [
                        "spit it out",
                        "spit up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрасывать слюну или другое вещество изо рта.",
                        "zh": "从嘴里吐出唾液或其他物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плевать",
                                "target_lang_sense_clarification": "выбрасывать слюну"
                            },
                            {
                                "target_lang_word": "плюнуть",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "сплёвывать",
                                "target_lang_sense_clarification": "периодическое действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吐",
                                "target_lang_sense_clarification": "从嘴里排出"
                            },
                            {
                                "target_lang_word": "吐痰",
                                "target_lang_sense_clarification": "吐出唾液"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6408a74-c7f6-3c0f-aa2e-6bcf5c841478",
                    "sense_definition": "To rain or snow very lightly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sem_rain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You do not need an umbrella because it is only <w>spitting</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе не нужен зонт, потому что дождь только <w>накрапывает</w>.",
                                "zh": "你不需要带伞，因为只是在<w>飘雨</w>。"
                            }
                        },
                        {
                            "text": "The sky turned grey and it began to <w>spit</w> with rain.",
                            "target_lang_translations": {
                                "ru": "Небо посерело, и начал <w>накрапывать</w> дождь.",
                                "zh": "天空变灰了，开始<w>下起</w>了毛毛雨。"
                            }
