                    ],
                    "common_phrases": [
                        "вывести формулу",
                        "вывести закон",
                        "вывести правило"
                    ],
                    "target_lang_definitions": {
                        "en": "To reach a logical conclusion or obtain a formula through reasoning",
                        "nl": "Tot een logische conclusie komen of een formule afleiden op basis van redenering"
                    },
                    "translations": {
