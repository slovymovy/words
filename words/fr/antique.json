        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "00d35d7b-3f47-3548-a7f4-e96cf95cc0ad",
                    "sense_definition": "Qui a existé durant l'Antiquité ou qui appartient à cette époque de l'histoire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "epoque",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves étudient l'histoire de la civilisation <w>antique</w> en classe."
                        },
                        {
                            "text": "Ce festival de musique se déroule chaque été dans un théâtre <w>antique</w>."
                        }
                    ],
                    "antonyms": [
                        "moderne"
                    ],
                    "common_phrases": [
