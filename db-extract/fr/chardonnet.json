                        "entry_id": "d6274d29-e998-35d0-9ca7-ac6236180496",
                        "glosses": [
                            "Variante graphique ancienne du cépage chardonnay."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0dce3697-a72b-4e8e-99c4-cce6d5932ae4",
                                "sense_id": "197f2dda-759e-378c-aaa7-8ebdaff3938d",
                                "text": "Des plantations faites à cette époque ont très bien réussi. On ne connaît, à proprement parler, que deux plants, le bourguignon pour les vins rouges, et le chardonnet pour les blancs."
                            }
                        ]
