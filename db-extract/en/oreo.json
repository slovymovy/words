        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3c12e146-cf2f-37c6-9567-5eec5edac57d",
                "word": "Oreo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5f9f738a-5418-48eb-95e0-d52cb6b3b726",
                        "entry_id": "3c12e146-cf2f-37c6-9567-5eec5edac57d",
                        "tags": [
                            "plural"
                        ],
                        "form": "Oreos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1cf70b6-f5f9-3a6e-a21b-dfce00af26c6",
                        "entry_id": "3c12e146-cf2f-37c6-9567-5eec5edac57d",
                        "glosses": [
                            "A cookie made of two wafers joined with a sugary filling, particularly a Nabisco cookie with two alkalized cocoa-powder wafers around a white creme filling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f50c1d9-8dd1-47b6-90df-8d81e56264de",
                                "sense_id": "a1cf70b6-f5f9-3a6e-a21b-dfce00af26c6",
                                "text": "The Oreo is really an antidepressant drug disguised as a cookie. You lost your job? Eat a bag of Oreos[…] There are two ways to eat Oreos. Kids like to pull the chocolate wafers apart and eat the sweat, creamy middle first. Adults dunk them in milk."
                            },
                            {
                                "example_id": "794bda32-b8ad-490c-ac98-a6e569502f3b",
                                "sense_id": "a1cf70b6-f5f9-3a6e-a21b-dfce00af26c6",
                                "text": "While Oreo cream may not appear to possess fluid-like properties, it is considered a \"yield stress fluid\"\"—a soft solid when unperturbed that can start to flow under enough stress[…] Curious as to whether other had explored the connection between Oreos and rheology, Owens found mention of a 2016 Princeton University study in which physicists first reported that indeed, when twisting Oreos by hand, the cream almost always came off on one wafer."
                            }
                        ]
                    },
                    {
                        "sense_id": "52f750d3-677a-3cbc-995a-688b5d3844f7",
                        "entry_id": "3c12e146-cf2f-37c6-9567-5eec5edac57d",
                        "glosses": [
                            "A black person who has overly assimilated into white culture, a black race traitor."
                        ],
                        "tags": [
                            "US",
                            "derogatory",
                            "ethnic",
                            "slur"
                        ],
                        "examples": [
                            {
                                "example_id": "cce4de55-48ea-4c2d-bf3d-b736fda35a8a",
                                "sense_id": "52f750d3-677a-3cbc-995a-688b5d3844f7",
                                "text": "She's a pure Oreo. You know, like the cookie, black outside and white inside."
                            },
                            {
                                "example_id": "aef9fd36-80c6-4a34-92c1-ed096a8cfd33",
                                "sense_id": "52f750d3-677a-3cbc-995a-688b5d3844f7",
                                "text": "Growing up in white suburbs and attending elite schools and institutions of higher learning, black American prince and princesses are immersed in Anglo (often WASP) culture and emerge with modes of speech, behavior and grooming that brand them as \"Oreos,\" black on the outside and white in the middle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27a32722-7503-4cb3-9683-65bcfb3976e8",
                        "source_entry_id": "3c12e146-cf2f-37c6-9567-5eec5edac57d",
                        "source_sense_description": "Nabisco cookie brand",
                        "target_lang_word": "Oreo",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
