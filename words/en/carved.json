    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99fa9979-2401-394a-ae71-ddf7a85b1c14",
                    "sense_definition": "Simple past and past participle of <w>carve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully <w>carved</w> a small bird out of a piece of soap.",
                            "target_lang_translations": {
                                "ru": "Он аккуратно <w>вырезал</w> маленькую птичку из куска мыла.",
                                "fr": "Il a soigneusement <w>sculpté</w> un petit oiseau dans un morceau de savon."
                            }
                        },
                        {
                            "text": "The ancient river <w>carved</w> a path through the mountains.",
                            "target_lang_translations": {
                                "ru": "Древняя река <w>прорезала</w> путь сквозь горы.",
                                "fr": "La rivière ancienne a <w>creusé</w> un chemin à travers les montagnes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carved out",
                        "carved in stone",
                        "carved up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>carve</w>.",
                        "fr": "Passé et participe passé du verbe sculpter ou tailler."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырезал",
                                "target_lang_sense_clarification": "создал фигуру из материала (дерева, мыла)"
                            },
                            {
                                "target_lang_word": "высек",
                                "target_lang_sense_clarification": "создал из твердого материала (камня)"
                            },
                            {
                                "target_lang_word": "прорезал",
                                "target_lang_sense_clarification": "создал путь или углубление"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "a sculpté",
                                "target_lang_sense_clarification": "créer une forme dans un matériau comme le bois ou le savon"
                            },
                            {
                                "target_lang_word": "a taillé",
                                "target_lang_sense_clarification": "donner une forme en coupant ou en enlevant de la matière"
                            },
                            {
                                "target_lang_word": "a creusé",
                                "target_lang_sense_clarification": "créer un passage ou un sillon dans le sol ou la roche"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ebdf6705-d7d5-3a82-8ecc-d3f5e520dc6c",
                    "sense_definition": "Shaped or decorated by cutting a material such as wood or stone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourist bought a <w>carved</w> wooden mask as a souvenir.",
                            "target_lang_translations": {
                                "ru": "Турист купил <w>резную</w> деревянную маску в качестве сувенира.",
                                "fr": "Le touriste a acheté un masque en bois <w>sculpté</w> en guise de souvenir."
                            }
                        },
                        {
                            "text": "We admired the <w>carved</w> stone pillars at the entrance of the temple.",
                            "target_lang_translations": {
                                "ru": "Мы любовались <w>резными</w> каменными колоннами у входа в храм.",
                                "fr": "Nous avons admiré les colonnes en pierre <w>taillées</w> à l'entrée du temple."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpted",
                        "chiseled",
                        "engraved"
                    ],
                    "antonyms": [
                        "uncarved",
                        "rough"
                    ],
                    "common_phrases": [
                        "carved wood",
                        "hand carved",
                        "carved stone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий форму или украшенный путем резки материала, такого как дерево или камень.",
                        "fr": "Façonné ou décoré par la taille d'un matériau tel que le bois ou la pierre."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резной",
                                "target_lang_sense_clarification": "украшенный резьбой"
                            },
                            {
                                "target_lang_word": "вырезанный",
                                "target_lang_sense_clarification": "сделанный посредством резки"
                            },
                            {
                                "target_lang_word": "высеченный",
                                "target_lang_sense_clarification": "сделанный из камня"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sculpté",
                                "target_lang_sense_clarification": "qui a été travaillé pour obtenir une forme artistique"
                            },
                            {
                                "target_lang_word": "taillé",
                                "target_lang_sense_clarification": "qui a été façonné par la coupe"
                            },
                            {
                                "target_lang_word": "ciselé",
                                "target_lang_sense_clarification": "décoré avec précision et finesse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
