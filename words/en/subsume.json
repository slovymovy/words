{
    "word_family": [
        "subsumption",
        "subsumptive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a691a38-9dd9-3cf3-a785-4ba020308bc3",
                    "sense_definition": "To include, absorb, or contain something within a larger or more comprehensive group, category, or rule.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new legislation will <w>subsume</w> several earlier acts into a single unified framework."
                        },
                        {
                            "text": "Many small independent businesses fear being <w>subsumed</w> by giant multinational corporations."
                        }
                    ],
                    "common_phrases": [
                        "be subsumed under",
                        "be subsumed into",
                        "subsume under a category"
                    ]
                },
                {
                    "sense_id": "5c442aaa-ff6e-345f-8c6a-c89aba8cc61d",
                    "sense_definition": "To consider, classify, or analyze an individual instance or occurrence as falling under a general rule, law, or principle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "inclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge attempted to <w>subsume</w> the unusual case under existing constitutional principles."
                        },
                        {
                            "text": "Philosophers often try to <w>subsume</w> particular moral duties under one overarching ethical imperative."
                        }
                    ],
                    "synonyms": [
                        "colligate"
                    ],
                    "common_phrases": [
                        "subsume under a rule",
                        "subsume under a principle"
                    ]
                }
            ]
        }
    ]
