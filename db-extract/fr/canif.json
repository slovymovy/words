        "fr-extract.jsonl": [
            {
                "entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                "word": "canif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b80bc5c4-add5-43ca-8fe6-99b89af39972",
                        "entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                        "tags": [
                            "plural"
                        ],
                        "form": "canifs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                        "entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                        "glosses": [
                            "Petit couteau formé d’une ou de plusieurs lames d’acier qui se replient dans le manche. Couteau de poche."
                        ],
                        "tags": [
                            "Coutellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "2950ab20-f2dd-4deb-83b2-54b9b03c5c1c",
                                "sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                                "text": "Mais, monsieur, M. le comte votre prédécesseur, dans l’intérêt du pouvoir, il bûchait son fauteuil avec son canif pour faire croire qu’il travaillait."
                            },
                            {
                                "example_id": "693502bb-f416-4fd6-afa5-bb85334b4595",
                                "sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                                "text": "Pour moi, il y a plusieurs choses qui me font envie, comme les grands cahiers à dessin, les peintures et les compas du Magasin Wimphen, ou les canifs à douze lames de l’armurerie."
                            },
                            {
                                "example_id": "1b8df925-16b3-40ce-bfc5-93b3b4edf330",
                                "sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                                "text": "En tant que surveillants, nous n'étions pas autorisés à franchir la porte d'entrée avec des récipients en verre, des chewing-gums, des canifs dont la lame mesurait plus de cinq centimètres, des journaux, des magazines, des bipeurs, des téléphones portables ou, bien sûr, nos pistolets et autres armes personnelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35385b58-445d-4bf1-918d-e6a33f7b9a67",
                        "source_entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                        "source_sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                        "target_lang_word": "Taschenmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taschenmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                        "entry_id": "884ca9c7-c46b-3840-a238-64bff29716aa",
                                        "glosses": [
                                            "ein Messer, dessen Klinge zum gefahrlosen Transport in den Griff eingeklappt werden kann und das oft weitere Funktionen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b79c7f8c-b27f-4466-ad97-ecfa71e408e4",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Mein Taschenmesser ist mit seinen vielen Funktionen ein kleiner Werkzeugkasten."
                                            },
                                            {
                                                "example_id": "8a91d6dc-1120-4461-a6ec-0f3884f247b6",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "„Mit seinem Taschenmesser ratschte Bertram so energisch über die Verpackung, dass ich schon um den Inhalt fürchtete.“"
                                            },
                                            {
                                                "example_id": "35bec946-f256-4ce7-b7d1-bfabd4ced2a2",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Einer der Mobber greift den 14jährigen körperlich an. Der zieht ein Taschenmesser, das er seit Wochen mit in die Schule gebracht hat. Zu seiner Verteidigung, wie er sagt."
                                            },
                                            {
                                                "example_id": "75cf8879-cdb6-428f-8e86-aa55e1e0352a",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "Besondere Erwähnung verdient das Taschenmesser. Natürlich passt es in so gut wie jede Tasche, aber es hat selbst eine. Seine Klinge lässt sich in die taschenähnliche Vertiefung im Griff klappen, weshalb es auch Klappmesser heißt."
                                            },
                                            {
                                                "example_id": "48183c20-937b-4a92-9bd4-8772c621d240",
                                                "sense_id": "a59e8db0-2775-3d1f-83fc-614335017912",
                                                "text": "„Da saß ich und trällerte oder schrieb auf weiße Birkenrinde oder schnitzte etwas mit meinem Taschenmesser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "130669fe-3264-4ec8-804e-c251d3e2bb13",
                        "source_entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                        "source_sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                        "target_lang_word": "Taschenfeitel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8cbdfa37-5ff8-4e0a-9a36-93e3119e52d0",
                        "source_entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                        "source_sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                        "target_lang_word": "pocketknife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pocketknife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                        "entry_id": "2a27e5f9-2bd2-39d6-92cb-d6e4cc1a0479",
                                        "glosses": [
                                            "A knife small enough for carrying safely and handily in a pocket; usually a folding knife (with blades or tools that the user can fold or retract into the handle)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c8f5066-538e-41bf-b0a7-1351fbb50c3c",
                                                "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                                "text": "Jimmy had a pocketknife, and he wandered into the drawing-room with it one day, alone, and reduced ten thousand dollars' worth of furniture to an indeterminable value in rather less than three-quarters of an hour."
                                            },
                                            {
                                                "example_id": "c8f956b6-e4a6-4613-ada9-d220d7209598",
                                                "sense_id": "1c6f385b-443d-3f21-8ffb-e150a6fce205",
                                                "text": "The Army, the Navy, the Maritime Commission, and Lend-Lease demanded more and more pocketknives — for demolition kits, medical kits, aviators’ kits, electricians’ kits; knives with tools, knives with marlin spikes. The pocketknife attained a new status — as indispensable equipment for all men in uniform."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9091da2-b234-4428-9b59-edecc95c2841",
                        "source_entry_id": "811f5867-75fb-3b45-84ad-29359c695caf",
                        "source_sense_id": "36eb64a9-3665-3bf4-bc97-87073c6001e2",
                        "target_lang_word": "penknife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penknife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede2c6b3-9963-327e-8ce9-871619ca9479",
                                        "entry_id": "5ce42abe-6ee1-3b80-bda1-ae9ce499b229",
                                        "glosses": [
                                            "A small pocketknife; (loosely) any pocketknife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93c7f31-0eeb-4d6d-9821-01b12d57e657",
                                                "sense_id": "ede2c6b3-9963-327e-8ce9-871619ca9479",
                                                "text": "The logical distinction between genus and species can, of course, apply to any objects whatsoever. Thus, for example, the genus knife may be divided into several species, such as penknife, table knife, bread knife, razor, etc. We might define the penknife as a knife small enough to be carried in the pocket, with foldable, sheathable elements, characterized by the feature that one blade at least is always suitable for sharpening pencils and erasing ink spots. We are quite sure in which features all the members of a certain species agree, notwithstanding possible individual characteristics, say a monogram on one penknife, or a corkscrew in another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f6039e-10a9-3301-83d0-b01dc901f2b1",
                                        "entry_id": "5ce42abe-6ee1-3b80-bda1-ae9ce499b229",
                                        "glosses": [
                                            "A small knife designed for safe and convenient storage, typically in the form of a miniature clasp-knife, or with blade retractable into the handle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ff8355-fa17-4f67-b27c-18089fa8bee3",
                                                "sense_id": "14f6039e-10a9-3301-83d0-b01dc901f2b1",
                                                "text": "Presently the man took a reed pen from his satchel, and trimmed it with a little ivory knife, carved in the semblance of a fish.\n\"Oh, what a beauty!\" cried Dan.\n \"’Ware fingers! That blade is perilous sharp. I made it myself of the best Low Country crossbow steel. And so, too, this fish. When his back-fin travels to his tail — so — he swallows up the blade, even as the whale swallowed Gaffer Jonah.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e5e8e2-30e0-3471-af44-d02aeeaa1940",
                                        "entry_id": "5ce42abe-6ee1-3b80-bda1-ae9ce499b229",
                                        "glosses": [
                                            "A small knife for cutting the points of quill feathers or reeds into nibs to provide or repair writing implements, early versions were commonly small sheath knives."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d00eab5a-9930-446b-b08d-77ece116cc8d",
                                                "sense_id": "56e5e8e2-30e0-3471-af44-d02aeeaa1940",
                                                "text": "Every sin is damning without Christ. \"The wages of sin is death\". It is no great difference, if a man be killed, whether it be by a sword or a penknife. The least sin violates the whole law. He that offendeth in one point, is guilty of all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penknife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d53aa3c-86d1-32f0-b21d-bdcd8e86204e",
                                        "entry_id": "5aa6d366-9b04-3ab2-b2f9-8b4f4a64846e",
                                        "glosses": [
                                            "To cut or carve with a penknife."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
