                                "sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                                "text": "Ta sofa wspaniale wkomponowała się w nasze mieszkanie."
                            },
                            {
                                "example_id": "eaa091cd-4f5c-4ab2-9368-602a6dfbf181",
                                "sense_id": "5bce6948-6258-338c-8899-13145c08beee",
                                "text": "To wspaniale, że się nie poddajesz!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2a019ce-815e-4c95-857a-3623072ec581",
