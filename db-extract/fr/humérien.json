                        ],
                        "examples": [
                            {
                                "example_id": "432b7413-abc9-466b-adff-bbf85ea90648",
                                "sense_id": "ec06566e-0616-3190-a8fa-6bae34c70add",
                                "text": "Le grand pectoral (sterno-humérien) ; il s’attache au sternum, à la portion sternale de la clavicule et aux sept premières côtes."
                            },
                            {
                                "example_id": "21ddba04-82c2-4881-881c-e357ece2b1cc",
                                "sense_id": "ec06566e-0616-3190-a8fa-6bae34c70add",
                                "text": "La portion du tronc se subdivise de son côté en trois autres : une brachio-dermienne, une scapulo-dermienne, et une gastro-humérienne."
                            }
                        ]
