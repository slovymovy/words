                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для работы в полевых условиях компания закупила <w>мобильный</w> мини-завод.",
                            "target_lang_translations": {
                                "en": "The company purchased a <w>mobile</w> mini-factory for field operations."
                            }
                        },
                        {
                            "text": "Этот <w>мобильный</w> пункт питания можно быстро перевезти в другой район города.",
                            "target_lang_translations": {
                                "en": "This <w>mobile</w> food station can be quickly moved to another part of the city."
                            }
