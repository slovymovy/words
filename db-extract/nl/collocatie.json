                        "examples": [
                            {
                                "example_id": "476281be-2c77-4ae7-b060-2a8d81465d49",
                                "sense_id": "ebc3ccf2-c27a-3f69-84c9-d7151aa6b44f",
                                "text": "Het is met name moeilijk om de woordvolgorde van een dergelijke collocatie te wijzigen zonder meteen ook het idiomatische karakter ervan aan te tasten."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6340d29-3948-3299-9dab-0b7a29b65145",
                        "entry_id": "d70ff4fa-fc54-39df-90e7-96ae5a338217",
                        "glosses": [
                            "aanwijzing van de volgorde van schuldeisers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55c97fef-68da-4a6e-a1d5-a7b9a941399a",
                                "sense_id": "b6340d29-3948-3299-9dab-0b7a29b65145",
                                "text": "Liever dan een verzoek tot collocatie van een schuldenaar mede te ondertekenen, hoopte Petrus Lemmens in 1789 op een andere manier een financieel geschil op te lossen."
                            }
                        ]
                    },
                    {
                        "sense_id": "97a9b0f5-8ea8-3cf2-905b-eb7f5c26ebb8",
                        "entry_id": "d70ff4fa-fc54-39df-90e7-96ae5a338217",
                        "glosses": [
                            "juridisch afgedwongen opname in een psychiatrische inrichting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20f5d4c-d69e-4073-8e94-0e51ed760572",
                                "sense_id": "97a9b0f5-8ea8-3cf2-905b-eb7f5c26ebb8",
                                "text": "De wet op de collocatie wordt toegepast zonder dat er sprake moet zijn van een misdrijf."
                            }
                        ]
                    }
                ],
