            }
        ],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "3ae03a50-39dd-3c2c-a83c-35c7f4fb5c44",
                "word": "indraaien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "794356b2-d902-30d7-adee-6f928cb72e41",
                        "entry_id": "3ae03a50-39dd-3c2c-a83c-35c7f4fb5c44",
                        "glosses": [
                            "met een draaibeweging naar binnen gaan"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "edc2acf2-5a45-43a6-898e-f02c06f4cb39",
                                "sense_id": "794356b2-d902-30d7-adee-6f928cb72e41",
                                "text": "DOLF SEEGERS: Er werd één op één gedekt. Kuif stond klaar om de corner te nemen. Met zijn linkervoet, vanaf rechts. Indraaiend. Dat was de afspraak. En dan maar hopen dat er iemand met zijn hoofd tegenaan liep. Hij nam een aanloop en ik dacht: die komt niet uit met zijn passen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bd0f929-3f31-39b4-a38f-1c46bfabfe0a",
                        "entry_id": "3ae03a50-39dd-3c2c-a83c-35c7f4fb5c44",
                        "glosses": [
                            "het vastdraaien van schroeven"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "243621c4-b46e-4c11-8610-73b1d9cb6f40",
                                "sense_id": "2bd0f929-3f31-39b4-a38f-1c46bfabfe0a",
                                "text": "Mensen zijn - met technologische hulp - nog steeds de beste en creatiefste probleemoplossers, vinden ze bij Mini. En omdat de lopende band tegenwoordig geen rij identieke auto’s uitspuugt, maar auto’s op bestelling in elkaar puzzelt, is de wendbaarheid van de mens nog nodig. Een schroefje indraaien kan niet elke keer op dezelfde manier; automatiseren heeft dan geen zin."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d8607a8-bcc2-3e49-9607-1856945b6bda",
                        "entry_id": "3ae03a50-39dd-3c2c-a83c-35c7f4fb5c44",
                        "glosses": [
                            "het monteren van een lamp in een fitting"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "060aa1de-6ba9-427a-adc7-eaed023e5cb8",
                                "sense_id": "6d8607a8-bcc2-3e49-9607-1856945b6bda",
                                "text": "Vermeulen bezit vier panden aan de Lijnmarkt en kan er van rentenieren. Dat doet hij niet op afstand. „Hij komt hier nog zelf nieuwe lampjes indraaien”, zegt Engeline Stalenhoef van de tassenwinkel Bag-It op nummer 44. „Hij is echt ‘mister Lijnmarkt’.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b505e70e-292b-4a3d-810d-965edc311393",
                        "source_entry_id": "3ae03a50-39dd-3c2c-a83c-35c7f4fb5c44",
                        "source_sense_id": "794356b2-d902-30d7-adee-6f928cb72e41",
                        "source_sense_description": "met een draaibeweging naar binnen gaan",
                        "target_lang_word": "turn in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turn in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "669bfc3d-1102-3075-afe9-832646c54560",
                                        "entry_id": "fc642d16-ab0d-368f-b918-fd80f77f6b92",
                                        "glosses": [
                                            "To submit something; to give."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4417a830-7b44-4810-9821-e1680311cbae",
                                                "sense_id": "669bfc3d-1102-3075-afe9-832646c54560",
                                                "text": "He turned in his paperwork to the main office."
                                            },
                                            {
                                                "example_id": "b75044ef-5865-4c00-9167-33f5bb507dd9",
                                                "sense_id": "669bfc3d-1102-3075-afe9-832646c54560",
                                                "text": "The actors turned in a formulaic performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b994ad6-4d87-39c1-96a2-b911133c7bc0",
                                        "entry_id": "fc642d16-ab0d-368f-b918-fd80f77f6b92",
                                        "glosses": [
                                            "To relinquish; give up; to tell on someone to the authorities (especially to turn someone in)."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde5d38e-e1a4-4f87-8c12-3e140cac3578",
                                                "sense_id": "6b994ad6-4d87-39c1-96a2-b911133c7bc0",
                                                "text": "The thief finally turned himself in at the police station."
                                            },
                                            {
                                                "example_id": "1131ca7b-9360-4ed1-a51a-5f627eeb8af7",
                                                "sense_id": "6b994ad6-4d87-39c1-96a2-b911133c7bc0",
                                                "text": "My nosy next-door neighbor turned me in for building my garage without a permit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc48f54-2130-3c2f-a520-0631ed102adf",
                                        "entry_id": "fc642d16-ab0d-368f-b918-fd80f77f6b92",
                                        "glosses": [
                                            "To go to bed; to retire to bed."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4d3663-6c01-45a5-8432-e214540cbecb",
                                                "sense_id": "9fc48f54-2130-3c2f-a520-0631ed102adf",
                                                "text": "I'm tired, so I think I'll turn in early tonight."
                                            },
                                            {
                                                "example_id": "721a17ab-5943-4b76-82e4-63d47c7c430c",
                                                "sense_id": "9fc48f54-2130-3c2f-a520-0631ed102adf",
                                                "text": "\"Landlord,\" said I, \"tell him to stash his tomahawk there, or pipe, or whatever you call it; tell him to stop smoking, in short, and I will turn in with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23506fea-72bc-3846-b4db-49f56821d60d",
                                        "entry_id": "fc642d16-ab0d-368f-b918-fd80f77f6b92",
                                        "glosses": [
                                            "To convert a goal using a turning motion of the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c959697-eea3-4a87-a839-95b6070b17e4",
                                                "sense_id": "23506fea-72bc-3846-b4db-49f56821d60d",
                                                "text": "At that point Leicester were playing with drive and ambition but they were undone by two goals in three minutes. First, Vieira turned in a rebound after the defender Souleymane Bamba had blocked David Silva's shot on the line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce7a9941-b4c1-3116-95d9-6edabbcea931",
                                        "entry_id": "fc642d16-ab0d-368f-b918-fd80f77f6b92",
                                        "glosses": [
                                            "To reverse the ends of threads and insert them back into the piece being woven so they do not protrude and eventually unravel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
