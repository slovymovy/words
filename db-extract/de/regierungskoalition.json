                ],
                "senses": [
                    {
                        "sense_id": "c784b853-037e-3390-808a-394e90f57727",
                        "entry_id": "7343a6d8-422a-333d-b389-fc1ed6931555",
                        "glosses": [
                            "ein Zusammenschluss mehrerer politischer Parteien, die gemeinsam eine Regierung stellen, wenn keine Partei allein die dafür erforderliche Mehrheit an Wählerstimmen erhalten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d06d5f-b781-4ad9-a264-1f18cedfd087",
                                "sense_id": "c784b853-037e-3390-808a-394e90f57727",
                                "text": "Eine Regierungskoalition muss nicht zwingend ausschließlich aus den Parteien mit den meisten Wählerstimmen bestehen, sie wird aber im Allgemeinen von der stärksten Partei geführt."
                            },
                            {
                                "example_id": "ab8cfc6e-0e65-4be8-b96f-56dc5c947f39",
                                "sense_id": "c784b853-037e-3390-808a-394e90f57727",
                                "text": "„Die Regierungskoalition bröckelt: Präsident Kasavubu beginnt sich auf Rat westlicher Diplomaten von ihm zu distanzieren.“"
                            },
                            {
                                "example_id": "ddce9cc8-344d-496c-aaad-257499a0b513",
                                "sense_id": "c784b853-037e-3390-808a-394e90f57727",
                                "text": "„Erst als die Regierungskoalition die Panik im Lande sah, ging sie umstandslos daran, die AKWs abzuschalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
