                                            {
                                                "example_id": "0df7b2b4-20df-4e4a-8119-3d910db621e6",
                                                "sense_id": "a39d5546-86f2-386a-97e7-1ce28535cc09",
                                                "text": "Mit einem Joker hat man beim Canasta gute Karten."
                                            }
