    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a9ed691d-32e6-3c4a-890f-786403b56efb",
                "word": "raconteur",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "27815d71-d47d-4343-b502-93be4cc9b3da",
                        "entry_id": "a9ed691d-32e6-3c4a-890f-786403b56efb",
                        "tags": [
                            "plural"
                        ],
                        "form": "raconteurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                        "entry_id": "a9ed691d-32e6-3c4a-890f-786403b56efb",
                        "glosses": [
                            "A storyteller, especially a person noted for telling stories with skill and wit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0158857-4ac0-448e-9946-1150dae33896",
                                "sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                                "text": "He was tempted to try the last door—to look into the room of evil fame; but he reflected that this would be indiscreet, since Colonel Capadose handled the brush—as a raconteur—with such freedom. There might be a ghost and there might not; but the Colonel himself, he inclined to think, was the most mystifying figure in the house."
                            },
                            {
                                "example_id": "c0cbdc01-eb66-4ce1-86dd-09c416898772",
                                "sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                                "text": "It is notoriously possible for the author of a fictitious narrative to become, after a time, unable to distinguish it from a statement of actual facts. There is a case on record in which a learned judge communicated to the Psychical Society in perfect good faith a ghost story, all the principal features of which were proved to be imaginary. They had their origin in his own talent as a distinguished raconteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efb40695-fc6b-4a46-b51f-0986b08e170a",
                        "source_entry_id": "a9ed691d-32e6-3c4a-890f-786403b56efb",
                        "source_sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                        "source_sense_description": "storyteller",
                        "target_lang_word": "vypravěč",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vypravěč",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "51f4786d-e882-352b-bd9a-772a699d262d",
                                        "entry_id": "80a95c18-8723-3fcd-a5e0-da0995413cc5",
                                        "glosses": [
                                            "muž, který vypráví"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd84b891-5fb1-4ffe-b95c-a01fa1294e92",
                                                "sense_id": "51f4786d-e882-352b-bd9a-772a699d262d",
                                                "text": "Vypravěč nemluví toliko slovy. Kde se nedostává slovního bohatství, je přece možno vypomoci si posunky, mimikou obličeje, modulací hlasu. Líčí-li vypravěč něco pochmurného, ztlumí hlas, šeptá."
                                            },
                                            {
                                                "example_id": "964d9b58-ac2a-4897-9a18-376f4017de06",
                                                "sense_id": "51f4786d-e882-352b-bd9a-772a699d262d",
                                                "text": "Vypravěčův sloh je zcela prostý, bez zvláštního patosu a velmi těkavý."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051cefad-b1e4-436b-8a01-83ee7cbdcae1",
                        "source_entry_id": "a9ed691d-32e6-3c4a-890f-786403b56efb",
                        "source_sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                        "source_sense_description": "storyteller",
                        "target_lang_word": "raconteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
