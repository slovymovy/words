                ],
                "senses": [
                    {
                        "sense_id": "40ba2c7d-f117-335f-a552-d889e0e02fb1",
                        "entry_id": "9b35c4ca-fe40-353d-a6bf-30146d51f720",
                        "glosses": [
                            "Lager, in dem Personen vorübergehend untergebracht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e66246e5-273f-46f5-85da-119455ef9c08",
                                "sense_id": "40ba2c7d-f117-335f-a552-d889e0e02fb1",
                                "text": "„Hier werden in einem Durchgangslager noch die Personalien der Kinder aufgenommen, bevor sie getrennt werden in diejenigen, die Verwandte in Westdeutschland oder der DDR haben, und diejenigen, wie Joachim, ohne Angehörige.“"
                            },
                            {
                                "example_id": "7fa2e51f-ea06-453a-989d-8b771b7188ee",
                                "sense_id": "40ba2c7d-f117-335f-a552-d889e0e02fb1",
                                "text": "„Ein Teil des großen Durchgangslagers von Millionen wurde kurz vorher evakuiert.“"
                            },
                            {
                                "example_id": "688b30c7-838d-4ca0-a3d4-6ac8a23714e6",
                                "sense_id": "40ba2c7d-f117-335f-a552-d889e0e02fb1",
                                "text": "„Im Durchgangslager Friedland, eingerichtet Ende September, wurden bis Jahresschluss 553000 Flüchtlinge registriert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
