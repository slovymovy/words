                "senses": [
                    {
                        "sense_id": "fe8c5504-300c-35de-bf3b-4f841dd872a5",
                        "entry_id": "cb0d20dd-0ef7-386a-8541-58d3f2df5453",
                        "glosses": [
                            "устар. или диал. стрелять из лука, метать, бросать, швырять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73375bc0-0968-4fee-ac5b-80fbb2504c8f",
                                "sense_id": "fe8c5504-300c-35de-bf3b-4f841dd872a5",
                                "text": "Никто искуснее и легче её не лукал копьём, не бросал огромного камня."
                            },
                            {
                                "example_id": "db283174-9f86-4ef4-bd93-fefa0517416f",
                                "sense_id": "fe8c5504-300c-35de-bf3b-4f841dd872a5",
                                "text": "Без того молчал, да невмоготу уж приходится. Бранятся, ругаются, грязью лукают… Всё же я человек!"
                            }
                        ]
                    }
                ],
