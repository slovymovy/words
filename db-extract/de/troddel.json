                "senses": [
                    {
                        "sense_id": "df7e7117-d103-3dd4-b39e-09dab8a98eae",
                        "entry_id": "3d8f2f57-362f-3207-87b4-0cf5e9531d5e",
                        "glosses": [
                            "Bündel von gleichartigen, hängenden Fäden, die am oberen Ende zusammengebunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7d125a-e6a4-47db-9cb5-6d8231a8789d",
                                "sense_id": "df7e7117-d103-3dd4-b39e-09dab8a98eae",
                                "text": "An dieser hellgrauen Wollmütze sind drei kleine graue Troddel, einer obendrauf an einem langen Band, zudem an jeder Ohrenklappe einer an einem sehr kurzen, dicken Wollfaden."
                            },
                            {
                                "example_id": "9812fbb5-4dc9-44f6-bb5c-879d5635f2c4",
                                "sense_id": "df7e7117-d103-3dd4-b39e-09dab8a98eae",
                                "text": "„Sie kleiden sich in Röcke aus Biber- und Murmeltierfellen und Rentier- und Elchhäuten, die unten mit Troddeln verziert sind.“"
                            },
                            {
                                "example_id": "3f56fb85-3eab-4c1e-8e7f-284252f3b556",
                                "sense_id": "df7e7117-d103-3dd4-b39e-09dab8a98eae",
                                "text": "„Er trug ein luftiges Schuhwerk, einfarbige Strümpfe und eine Dauisten-Kutte mit blauen Troddeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
