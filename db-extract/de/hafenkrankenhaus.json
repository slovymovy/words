                ],
                "senses": [
                    {
                        "sense_id": "04d844cc-98d0-357c-bfd5-c3930252b4f3",
                        "entry_id": "1f38630a-02de-381b-b577-acdc0cae6cdd",
                        "glosses": [
                            "in der Nähe vom Hamburger Hafen (in St. Pauli) liegendes ehemaliges Krankenhaus (Einrichtung, in der Kranke und Verletzte behandelt werden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f408afff-8c13-493a-82d6-11fde19289fe",
                                "sense_id": "04d844cc-98d0-357c-bfd5-c3930252b4f3",
                                "text": "„Lodernde Flammen, beißender Qualm, Feuerwehrmänner versuchen, fünf brennende Autos am ehemaligen Hafenkrankenhaus zu löschen.“"
                            },
                            {
                                "example_id": "dd958f72-dab3-495d-aca4-e4d5f00e8860",
                                "sense_id": "04d844cc-98d0-357c-bfd5-c3930252b4f3",
                                "text": "„Die Senatorin steht seit Monaten unter Druck: Auf ihr Konto geht die umstrittene Schließung des Hafenkrankenhauses in St. Pauli.“"
                            },
                            {
                                "example_id": "0e34dbad-4366-476e-b352-8fef4993287f",
                                "sense_id": "04d844cc-98d0-357c-bfd5-c3930252b4f3",
                                "text": "„Einwohner des Stadtteils St. Pauli halten das Hafenkrankenhaus besetzt - aus Protest gegen die Schließung der Klinik und die Verarmung ihres Viertels.“"
                            },
                            {
                                "example_id": "22ad0761-b57f-46fe-96c6-fa00968e5561",
                                "sense_id": "04d844cc-98d0-357c-bfd5-c3930252b4f3",
                                "text": "„Nach dem bereits im Vorjahr begründeten Institut für Schiffs- und Tropenkrankheiten in Hamburg (heute Bernhard-Nocht-Institut) nimmt auch das neue Hafenkrankenhaus seinen vollständigen Betrieb auf.“"
                            },
                            {
                                "example_id": "b24cba21-4bee-43ad-9245-30990aa2efbe",
                                "sense_id": "04d844cc-98d0-357c-bfd5-c3930252b4f3",
                                "text": "„Die Chirurgen im Hafenkrankenhaus sind Spezialisten für Messerwunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
