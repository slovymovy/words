                ],
                "senses": [
                    {
                        "sense_id": "932b675c-3097-3b83-bc46-b2c436921fdf",
                        "entry_id": "61cdc1ab-071f-356a-a5f5-5106b8921059",
                        "glosses": [
                            "Ausgangspunkt, Ursprung oder Verursacher eines akustischen Signals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c64642-aa47-4b44-b3d7-f4fb3822cc41",
                                "sense_id": "932b675c-3097-3b83-bc46-b2c436921fdf",
                                "text": "„Das Kind muss Gelegenheit erhalten, Erfahrungswerte über die Ausbreitung von Schallwellen zu sammeln. Das Ziel ist bereits erreicht, wenn es Geräuschquellen nach den drei Kategorien ‚nah’ – ‚entfernter’ – ‚weit entfernt’ unterscheiden kann.“"
                            },
                            {
                                "example_id": "f1ad625f-8a84-4a3b-aa4f-76559a1a5cee",
                                "sense_id": "932b675c-3097-3b83-bc46-b2c436921fdf",
                                "text": "„Mikrofone nehmen zunächst Signale auf, die von einer Geräuschquelle ausgehen.“"
                            },
                            {
                                "example_id": "5d811e34-4c8d-494c-8e3d-d62227b63af4",
                                "sense_id": "932b675c-3097-3b83-bc46-b2c436921fdf",
                                "text": "„Beim stehenden Fahrzeug mit laufendem Motor treten nur die ersten drei Geräuschbeiträge, beim fahrenden Fahrzeug alle fünf Geräuschbeiträge gemeinsam auf. Auf die Geräuschquellen wird dabei hingewiesen.“"
                            },
                            {
                                "example_id": "0bb94854-b38a-40f7-b456-5bc43780573c",
                                "sense_id": "932b675c-3097-3b83-bc46-b2c436921fdf",
                                "text": "„Durch welche Methoden eine Geräuschquelle im Raum lokalisiert werden kann, ist hierbei die Hauptfragestellung, die bearbeitet werden soll.“"
                            },
                            {
                                "example_id": "4f1b89c4-d823-4078-8eae-31d97c421170",
                                "sense_id": "932b675c-3097-3b83-bc46-b2c436921fdf",
                                "text": "„Stammt das Geräusch tatsächlich von einem Beutetier, stürzt sich die Eule kopfüber in die Dunkelheit, immer darauf bedacht, sämtliche Sinne auf die Geräuschquelle zu konzentrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
