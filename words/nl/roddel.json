{
    "word_family": [
        "roddelen",
        "roddelaar",
        "roddelpers",
        "roddeltante",
        "roddelblad"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb3ba139-1421-3ac3-99b4-de30b5d979d3",
                    "sense_definition": "het praten over andere mensen, vaak op een negatieve of onware manier",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sociale interactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik luister liever niet naar die gemene <w>roddel</w> over onze nieuwe buurman.",
                            "target_lang_translations": {
                                "en": "I'd rather not listen to that mean <w>gossip</w> about our new neighbor."
                            }
                        },
                        {
                            "text": "In dit kleine dorp verspreidt een <w>roddel</w> zich helaas erg snel.",
                            "target_lang_translations": {
                                "en": "In this small village, a <w>rumor</w> unfortunately spreads very quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterklap",
                        "gerucht",
                        "kwaadsprekerij"
                    ],
                    "common_phrases": [
                        "een gemene roddel",
                        "roddel en achterklap"
                    ],
                    "target_lang_definitions": {
                        "en": "talking about other people, often in a negative or untrue way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "idle talk about someone's private matters"
                            },
                            {
                                "target_lang_word": "rumor",
                                "target_lang_sense_clarification": "a statement of questionable accuracy spread by word of mouth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "816c16a0-c697-3370-822a-e7b07e82ac44",
                    "sense_definition": "het kwaadspreken over iemand achter diens rug om",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sociale interactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ergst zijn de <w>roddels</w>, het kwaadaardige gegons van mensen die anderen willen kwetsen.",
                            "target_lang_translations": {
                                "en": "The worst are the <w>gossip</w>, the malicious buzzing of people who want to hurt others."
                            }
                        },
                        {
                            "text": "Zij probeert haar reputatie te beschermen tegen elke valse <w>roddel</w>.",
                            "target_lang_translations": {
                                "en": "She tries to protect her reputation against every false <w>rumor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterklap",
                        "kwaadsprekerij"
                    ],
                    "common_phrases": [
                        "valse roddels"
                    ],
                    "target_lang_definitions": {
                        "en": "speaking ill of someone behind their back"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "malicious talk about others"
                            },
                            {
                                "target_lang_word": "slander",
                                "target_lang_sense_clarification": "false and damaging statements about someone"
                            },
                            {
                                "target_lang_word": "backbiting",
                                "target_lang_sense_clarification": "spiteful talk about a person who is not present"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70fb748d-0bb3-35b4-95e1-56ae8c189441",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>roddelen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>roddel</w> nooit over mijn collega's omdat ik dat onprofessioneel vind.",
                            "target_lang_translations": {
                                "en": "I never <w>gossip</w> about my colleagues because I find it unprofessional."
                            }
                        },
                        {
                            "text": "Soms <w>roddel</w> ik per ongeluk mee als het gezellig is.",
                            "target_lang_translations": {
                                "en": "Sometimes I accidentally join in the <w>gossip</w> when things are social."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present tense of 'to gossip'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "to talk about others' private business"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1038ece8-8fbf-389f-8170-871cf8374b56",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>roddelen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>roddel</w> je over je beste vriendin als ze er niet bij is?",
                            "target_lang_translations": {
                                "en": "Why do you <w>gossip</w> about your best friend when she's not around?"
                            }
                        },
                        {
                            "text": "Als je <w>roddel</w> je over anderen, verliezen mensen hun vertrouwen in jou.",
                            "target_lang_translations": {
                                "en": "If you <w>gossip</w> about others, people lose their trust in you."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present (inverted)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present tense of 'to gossip' (used in questions or after 'je')"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "to talk about others' private business"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0e787aa-3245-355e-a5f0-5e9244a2ddc0",
                    "sense_definition": "gebiedende wijs van <w>roddelen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Roddel</w> niet over zaken waar je eigenlijk niets van afweet.",
                            "target_lang_translations": {
                                "en": "Don't <w>gossip</w> about things you actually know nothing about."
                            }
                        },
                        {
                            "text": "Stop daarmee en <w>roddel</w> liever over iets positiefs!",
                            "target_lang_translations": {
                                "en": "Stop that and <w>gossip</w> about something positive instead!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to gossip'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "to talk about others' private business"
                            }
                        ]
                    }
                }
            ]
        }
    ]
