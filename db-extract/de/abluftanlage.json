                "senses": [
                    {
                        "sense_id": "e5594644-1f8f-32ec-b11d-f2252f2e302b",
                        "entry_id": "a3a5f637-570e-35e9-9430-05fa46e4b071",
                        "glosses": [
                            "technische Einrichtung, mit welcher Luft aus geschlossenen Räumen abgesaugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc94af65-3c8c-4c54-8e88-8508ad7cd189",
                                "sense_id": "e5594644-1f8f-32ec-b11d-f2252f2e302b",
                                "text": "„Ein von außen bereits wahrnehmbarer intensiver Speisegeruch deutet nicht nur auf ein vielleicht schmackhaftes Essensangebot hin, sondern auf eine nicht regelmäßig gereinigte und gewartete Abluftanlage mit den oben beschriebenen Problemen.“"
                            },
                            {
                                "example_id": "c65d6db1-14e0-465f-a2c5-1085e6979418",
                                "sense_id": "e5594644-1f8f-32ec-b11d-f2252f2e302b",
                                "text": "„Wenn somit die Abluftanlage 350m³ in der Stunde leistet, dann sollte die Zuluftanlage nicht mehr als 250 bis maximal 300m³ in der Stunde leisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
