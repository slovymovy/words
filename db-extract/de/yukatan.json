                        "glosses": [
                            "Halbinsel im Norden Zentralamerikas; trennt den Golf von Mexiko vom Karibischem Meer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f9f4564-32d6-4126-b445-4b3a9980d165",
                                "sense_id": "1276b3f9-2a8b-30ee-a332-d7ff59eeecef",
                                "text": "„Die letzte Stadt der Itzá auf einer Insel in einem See des Petén wurde erst 1697 erobert, um einen Camino Real als Landverbindung zwischen Yukatan und Guatemala zu ermöglichen.“"
                            }
