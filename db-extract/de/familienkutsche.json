                "senses": [
                    {
                        "sense_id": "b0701ed2-da03-387f-8138-729aa7ebe555",
                        "entry_id": "2021d986-a2cb-391b-a070-21582bae134e",
                        "glosses": [
                            "großes, geräumiges Auto, welches besonders für Familien geeignet ist"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "82b7d05a-da8e-4dcc-845f-241de0f6ccf9",
                                "sense_id": "b0701ed2-da03-387f-8138-729aa7ebe555",
                                "text": "Weil er zweifacher Vater geworden war, kaufte er sich eine Familienkutsche."
                            },
                            {
                                "example_id": "7c8abba5-e077-4b3b-8d34-4e6400982f8c",
                                "sense_id": "b0701ed2-da03-387f-8138-729aa7ebe555",
                                "text": "„Ich brauche eine neue Familienkutsche: die alte Kiste kommt nicht mehr durch den TÜV.“"
                            },
                            {
                                "example_id": "59fc0b38-ca70-46d9-ae1d-9e494108c6c3",
                                "sense_id": "b0701ed2-da03-387f-8138-729aa7ebe555",
                                "text": "Mit Schrägheck, großer Kofferraumklappe und variablem Innenraum, revolutioniert der R16 1965 die Welt der Familienkutsche."
                            },
                            {
                                "example_id": "318d48e1-14c9-4887-bf5f-defbe8af3180",
                                "sense_id": "b0701ed2-da03-387f-8138-729aa7ebe555",
                                "text": "Mit der Entstehung des integrierten Autokonzerns - der vom Kleinwagen über \"Familienkutschen\", von Premium-Autos und Sportwagen bis zum Lastwagen die gesamte Modellpalette im Angebot hat - geht der große Traum von VW-Aufsichtsratschef Ferdinand Piech in Erfüllung."
                            },
                            {
                                "example_id": "690753dd-3809-4dac-b348-67d0612fee11",
                                "sense_id": "b0701ed2-da03-387f-8138-729aa7ebe555",
                                "text": "Auf den Beifahrersitzen saßen Mütter, die nirgends außer hier, in der vom Gatten chauffierten Familienkutsche, ihrer häuslichen Pflichten entbunden waren und es sich erlauben konnten, auf die hübsche Szenerie der Collegestadt hinauszustarren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
