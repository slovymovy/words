                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3281b6a9-d783-4284-9b52-44f3e75ffb6d",
                        "source_entry_id": "f94bfbdb-a089-37df-8241-317e05594bda",
                        "source_sense_id": "3a92784d-dd23-3af0-99f3-f5b130dc2e9e",
                        "source_sense_description": "de daad van het slopen, afbreken",
                        "target_lang_word": "Abbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                        "entry_id": "b5730822-9f72-33b1-a552-8bf8543277a6",
                                        "glosses": [
                                            "das Beenden von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06584b2b-5957-4413-ace8-2b3b17964443",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "Vor und während eines Krieges kommt es häufig zum Abbruch der diplomatischen Beziehungen."
                                            },
                                            {
                                                "example_id": "49959999-95d6-47c4-a5b7-f9192613a77e",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "„Sie hatte zu viele Horrorgeschichten über misslungene Abtreibungen gehört, um einen Abbruch in Erwägung zu ziehen.“"
                                            },
                                            {
                                                "example_id": "faba8c59-2a20-4378-bb06-02818f09d82f",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "„Wer sich […] für den Abbruch entscheidet, muss vorher ein Pflichtgespräch in einer Beratungsstelle führen.“"
                                            },
                                            {
                                                "example_id": "31a482ad-636e-4b8f-81fe-9f510a4eb3de",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "„An anderthalb Tagen in der Woche macht sie […] Abbrüche – sowohl medikamentös als auch mit der sogenannten Absaugmethode.“"
                                            },
                                            {
                                                "example_id": "edd9d85c-7d32-49d3-9a5d-f62fedeaf33a",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "„[…] nicht nur Frauen in Baden-Württemberg müssen häufig einen längeren Anreiseweg in Kauf nehmen, um einen Arzt oder eine Ärztin zu finden, die einen Abbruch vornimmt.“"
                                            },
                                            {
                                                "example_id": "bd46862f-f7b7-4f81-afc3-61331859f184",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "Die Eingabe einer Null führte zum Abbruch des Programms."
                                            },
                                            {
                                                "example_id": "5ddc5efd-3ff2-4816-88f6-36acffc2e75c",
                                                "sense_id": "5313f66f-6404-3456-903f-28c2d1cc5754",
                                                "text": "„Mündliche Rede ist selbstverständlich immer von Abbrüchen durchsetzt und nie direkt in schriftliche Sprache übersetzbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d68d137-7df2-3f41-b38f-86ca25707bd5",
                                        "entry_id": "b5730822-9f72-33b1-a552-8bf8543277a6",
                                        "glosses": [
                                            "das Abbauen oder Zerlegen von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5884fe09-620e-4c14-965e-2aa599276d90",
                                                "sense_id": "9d68d137-7df2-3f41-b38f-86ca25707bd5",
                                                "text": "Nach dem Unwetter blieb uns nur eine Lösung: Abbruch der Zelte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bf274ab7-fd65-3ddc-81b8-a26df7097679",
                                        "entry_id": "b5730822-9f72-33b1-a552-8bf8543277a6",
                                        "glosses": [
                                            "ein Schaden, Beeinträchtigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958355b7-ad3c-449e-a0dc-7c50f4f67fae",
                                                "sense_id": "bf274ab7-fd65-3ddc-81b8-a26df7097679",
                                                "text": "Unserem guten Verhältnis soll das keinen Abbruch tun."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b9cac83f-ea65-33f9-9d36-a80aec4523e0",
                                        "entry_id": "b5730822-9f72-33b1-a552-8bf8543277a6",
                                        "glosses": [
                                            "ein Rückbau, Abriss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22545bce-9d02-4db9-81fa-5f63b80a64e2",
                                                "sense_id": "b9cac83f-ea65-33f9-9d36-a80aec4523e0",
                                                "text": "Der Schornstein erlitt das Schicksal seiner Brüder, es kam zum Abbruch."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "5f147da9-4522-3261-8880-07c0d8edddb9",
                                        "entry_id": "b5730822-9f72-33b1-a552-8bf8543277a6",
                                        "glosses": [
                                            "eine Geländestufe; scharfe, markant ausgeprägte Kante im Gelände"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a201653-590c-476b-9f1d-dd404a0714b0",
                                                "sense_id": "5f147da9-4522-3261-8880-07c0d8edddb9",
                                                "text": "Vorsicht, gehe nicht so dicht am Abbruch entlang!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "905a02e9-423d-41d8-aeb2-d66b0e8fe355",
                        "source_entry_id": "f94bfbdb-a089-37df-8241-317e05594bda",
                        "source_sense_id": "3a92784d-dd23-3af0-99f3-f5b130dc2e9e",
                        "source_sense_description": "de daad van het slopen, afbreken",
                        "target_lang_word": "Abriss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abriss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e710e9ea-6e37-34fe-a28c-434eefa79c0c",
                                        "entry_id": "6cbc908a-4b08-3ce4-a127-e552ffe87f30",
                                        "glosses": [
                                            "bewusste, geplante Zerstörung (zum Beispiel eines Gebäudes)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6f8452-b8d6-49b3-95f6-243a9f152f2f",
                                                "sense_id": "e710e9ea-6e37-34fe-a28c-434eefa79c0c",
                                                "text": "Der Abriss des baufälligen Hauses wäre die beste Lösung."
                                            },
                                            {
                                                "example_id": "faf6ae68-5d8c-49ca-b02b-dbe9f0604b90",
                                                "sense_id": "e710e9ea-6e37-34fe-a28c-434eefa79c0c",
                                                "text": "„Der Abriss seines Hauses fiel ironischerweise mit seinem Besuch 2005 zusammen.“"
                                            },
                                            {
                                                "example_id": "a5e16fe4-8aee-4142-96b1-70920881c774",
                                                "sense_id": "e710e9ea-6e37-34fe-a28c-434eefa79c0c",
                                                "text": "„Als sie von dem bevorstehenden Abriss des Tram erfuhren, strömten die Bewohner von Stadtland dort zusammen.“"
                                            },
                                            {
                                                "example_id": "93890437-703e-48f0-aeae-4b0d13ba0718",
                                                "sense_id": "e710e9ea-6e37-34fe-a28c-434eefa79c0c",
                                                "text": "„Der mit Spannung erwartete Abriss des Anlaufturms der Inselbergschanze in Brotterode im Thüringer Wald ist gescheitert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cecbbd4-d0d2-3010-8465-a3221aa6763c",
                                        "entry_id": "6cbc908a-4b08-3ce4-a127-e552ffe87f30",
                                        "glosses": [
                                            "Teil eines Gegenstandes (meist einer Eintrittskarte oder Ähnlichem), der zur Entwertung abgerissen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afed1ad5-1947-475d-934d-9e0dc01b615c",
                                                "sense_id": "8cecbbd4-d0d2-3010-8465-a3221aa6763c",
                                                "text": "Jede Eintrittskarte der Rolle besitzt einen perforierten Abriss."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3d564aa-bd76-31b8-bd43-a6dac1cbb601",
                                        "entry_id": "6cbc908a-4b08-3ce4-a127-e552ffe87f30",
                                        "glosses": [
                                            "knappe, kurze Zusammenfassung (zum Beispiel einer Geschichte, eines Textes oder Ähnlichem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef8d4be-7c17-40dc-bb6d-97023fafc877",
                                                "sense_id": "e3d564aa-bd76-31b8-bd43-a6dac1cbb601",
                                                "text": "Geben Sie mir bitte einen kurzen Abriss des Sachverhalts."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4ebffac1-4edb-3b92-9d44-628a46e8ef72",
                                        "entry_id": "6cbc908a-4b08-3ce4-a127-e552ffe87f30",
                                        "glosses": [
                                            "unverschämt hohe Forderung nach einem bestimmten Preis"
                                        ],
                                        "tags": [
                                            "schweizerisch; Plural ungebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0348d6ad-7049-448d-aacd-6ffc1e80521b",
                                                "sense_id": "4ebffac1-4edb-3b92-9d44-628a46e8ef72",
                                                "text": "„Die 30 Stutz Parkgebühren waren ‹reiner Abriss›.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "933b96fb-5b98-3372-989b-0391e2c2e36d",
                                        "entry_id": "6cbc908a-4b08-3ce4-a127-e552ffe87f30",
                                        "glosses": [
                                            "Zeichnung eines Umrisses"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
