                                    },
                                    {
                                        "sense_id": "00f85ab3-371b-3d21-bbfb-57890358c762",
                                        "entry_id": "8f0776e1-2fd2-39ef-b516-aaa631249455",
                                        "glosses": [
                                            "een manier om huidcellen van de bovenste huidlaag te verwijderen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7791dba-adf1-4714-9626-44c593127d56",
                                                "sense_id": "00f85ab3-371b-3d21-bbfb-57890358c762",
                                                "text": "'Exfoliëren is de perfecte manier om de huid in een perfecte conditie te brengen en een egale evenwichtige structuur te bekomen. De nieuwste lichting gezichtsscrubs zijn zeer zacht en bevatten fruitzuren, vitamines en fruitextracten. Zo'n zuivere en natuurlijke exfoliant mag je twee keer per week gebruiken. Een exfoliant gebruik je na het reinigen en voor het hydrateren.'"
                                            },
                                            {
                                                "example_id": "32188ea6-a4d8-451f-bb06-0a1d1408fd27",
                                                "sense_id": "00f85ab3-371b-3d21-bbfb-57890358c762",
                                                "text": "Heb je een fletste teint nu de bruine kleur wegtrekt? Exfoliëren en hydrateren helpt. De nieuwe Refinishing Facial van ESTEE LAUDER verwijdert droge en dode huidcellen, maakt poriën minder zichtbaar en verbetert de huidtextuur. Het resultaat: een heldere en zachte huid."
                                            }
                                        ]
                                    }
