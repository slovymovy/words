                        "cross_references": [
                            {
                                "target_word": "Juliette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                        "entry_id": "e44a786f-9423-317b-b63e-68dcb9247451",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d39a1cd-65fb-402a-b39a-40c9c6746539",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "— Ça vous intéresse donc, vous, de savoir comment une femme s’appelle ?… Drôle de curiosité !… Elle s’appelle Juliette Roux…"
                                            },
                                            {
                                                "example_id": "16f07bac-93df-46ba-a485-7e0cd00a44d7",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "– Juliette, murmura M. Chavanais comme si le prénom de son amie contenait une longue explication.\n– Je vous écoute.\n– Juliette, reprit-il encore plus bas.\n– Eh bien, oui ?\n– Juliette…\n– Vous ne savez dire que cela.\n– C’est le plus beau prénom…"
                                            },
                                            {
                                                "example_id": "a80e5b4c-dc83-493e-a2a6-7b1706af4100",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "Il glissa, en vrillant sur lui-même, et vit Juliette armer son bras pour un second coup."
                                            },
                                            {
                                                "example_id": "44fba7fe-cda8-48b5-81e3-b6ad9d9bb85c",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "Les rôlistes sont ouverts et tolérants pour la plupart, mais aussi un peu conservateurs par leur histoire, précise Juliette Lancel, chercheuse indépendante en histoire."
                                            },
                                            {
                                                "example_id": "fe761b18-ca11-41b7-9709-9eb9696e979c",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "Aujourd’hui, la fondatrice de Appelle ta Jacqueline est entourée d’une équipe de six jeunes filles — Élina, Lilirose, Melly, Juliette, Jade et Tlali —, âgées de 14 ans à 19 ans, toutes très impliquées dans l’avenir à construire à cette généreuse initiative qui repose sur les valeurs de partage, de solidarité, d’écoute et d’entraide."
                                            }
                                        ]
                                    }
                                ]
