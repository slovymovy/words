                "senses": [
                    {
                        "sense_id": "a32981dc-b081-3b19-b657-ca59e5f4e6f9",
                        "entry_id": "5a213841-bb75-3947-948d-ac04c8403dab",
                        "glosses": [
                            "Arranger une cheminée de telle sorte qu’elle ne fume plus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ccbde36-7451-422d-8e00-07cb09824f21",
                                "sense_id": "a32981dc-b081-3b19-b657-ca59e5f4e6f9",
                                "text": "Le brevet d’invention de quinze ans, dont la demande a été déposée, le 9 janvier 1866, au secrétariat de la préfecture du département de l’Orne, par le sieur Brière (Jules), fabricant de poteries au secrétariat de la préfecture du département de l’Orne, par le sieur Brière (Jules), fabricant de poteries, à Alençon, pour un système d’appareil pour défumer les cheminées."
                            },
                            {
                                "example_id": "76ade9cf-24d7-418d-a2a6-38f2ddb9a5cf",
                                "sense_id": "a32981dc-b081-3b19-b657-ca59e5f4e6f9",
                                "text": "Et puis, charrier le bois, le fendre, défumer, soigner les bêtes, confectionner des manches d’outil avec des branches de noisetier ou de frêne, faire nos balais avec des bouquets de bruyère ou de sorgho..., le temps suivait son cours sans laisser de vides, sans laisser la moindre trace d’ennui."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5fd9bf4-e558-3639-bfb8-d1a708b99c2d",
                        "entry_id": "5a213841-bb75-3947-948d-ac04c8403dab",
                        "glosses": [
                            "Arrêter de fumer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a8e30d-35c9-4627-b0e3-c897047e05e2",
                                "sense_id": "c5fd9bf4-e558-3639-bfb8-d1a708b99c2d",
                                "text": "À mon tour de défumer !"
                            }
                        ]
                    }
                ],
