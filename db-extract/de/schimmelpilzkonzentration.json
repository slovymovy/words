                "senses": [
                    {
                        "sense_id": "6b7929e3-be8a-3bc1-805f-bca00462189c",
                        "entry_id": "9873db3d-7a3e-325e-ac47-d825d5c0ee5b",
                        "glosses": [
                            "Konzentration von Schimmelpilzen und deren Luftsporen in der Raumluft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff44fb3-cb5f-4478-ae4a-af8055bb057f",
                                "sense_id": "6b7929e3-be8a-3bc1-805f-bca00462189c",
                                "text": "„Die Luftsporenmenge wird in koloniebildende Einheiten KBE / m³ Luft angegeben. Es wird empfohlen, sich bei der Luftsporenmessung im Innenraum nach dem „Verfahren zur Bestimmung der Schimmelpilzkonzentration in der Luft am Arbeitsplatz“ -TRBA 430- zu richten “"
                            },
                            {
                                "example_id": "873ddfc6-8ab8-4d9a-9596-86731fc42179",
                                "sense_id": "6b7929e3-be8a-3bc1-805f-bca00462189c",
                                "text": "„Schimmelpilzkonzentrationen und Artenmessung, die einzusetzende persönliche Schutzausrüstung sowie die Planung einer fachgerechten Schimmelpilzschadenbeseitigung sind ebenfalls Inhalt, aber nicht Hauptbestandteil des Merkblattes.“"
                            },
                            {
                                "example_id": "0de8503e-14c9-4dbe-a0fb-9bd4061a6b74",
                                "sense_id": "6b7929e3-be8a-3bc1-805f-bca00462189c",
                                "text": "„Bei diesen umweltepidemiologischen Studien konnte jedoch keine Dosis-Wirkung-Beziehung zwischen der gemessenen Schimmelpilzkonzentration und der Intensität bzw. Anzahl der gesundheitlichen Probleme festgestellt werden.“"
                            },
                            {
                                "example_id": "7d1d4bc9-a0ea-4040-8b4e-3dad94f1e1b2",
                                "sense_id": "6b7929e3-be8a-3bc1-805f-bca00462189c",
                                "text": "„Berufsgenossenschaftliches Institut für Arbeitssicherheit-BIA- No. 9420 \"Verfahren zur Bestimmung der Schimmelpilzkonzentration in der Luft am Arbeitsplatz\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
