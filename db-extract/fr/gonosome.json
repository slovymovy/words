                        "glosses": [
                            "Chromosome impliqué dans la détermination du sexe d’un individu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c3644d-3323-45b0-b7ef-f3ab0b43d2d8",
                                "sense_id": "7938b606-d4b8-3702-9162-6a1b110916a2",
                                "text": "Chez 25 des 28 intersexes dont on a étudié le caryotype, on a constaté la présence de 38 chromosomes, dont 36 autosomes et 2 gonosomes X.\n Chez les 3 autres intersexes, qui présentaient d'ailleurs aussi une hypoplasie utérine, on a remarqué l'existence de 39 chromosomes, dont 36 autosomes et 3 gonosomes représentés par XXY."
                            }
