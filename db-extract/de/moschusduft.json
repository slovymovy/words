                "senses": [
                    {
                        "sense_id": "d75ca48a-e99e-3f78-8fe6-2d2a49fe83f6",
                        "entry_id": "532cbae9-5714-3f1b-a453-8f9e50eea5c8",
                        "glosses": [
                            "Duft von Moschus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20d8b516-d5ce-4c73-812a-2c4469cd9fb8",
                                "sense_id": "d75ca48a-e99e-3f78-8fe6-2d2a49fe83f6",
                                "text": "„Der Moschusduft und die komplexe Morphologie ihrer Vagina faszinierten ihn.“"
                            },
                            {
                                "example_id": "69939175-5e20-4bf8-b595-827836199a89",
                                "sense_id": "d75ca48a-e99e-3f78-8fe6-2d2a49fe83f6",
                                "text": "„Als ich mich ihm näherte, um ihn zu beruhigen, roch ich den Kardamom in seinem Atem und den Moschusduft von getrocknetem Schweiß.“"
                            },
                            {
                                "example_id": "56a927ca-9a3a-4327-b421-090d93f813ef",
                                "sense_id": "d75ca48a-e99e-3f78-8fe6-2d2a49fe83f6",
                                "text": "„Durch das dünne Baumwollgewebe drang der heiße, kräftige Moschusduft, den ihr junger Frauenkörper nach einem schwülen Tag verströmte, den sie fast vollständig auf den Beinen oder in der Hocke mit Zubereiten und Servieren von Essen verbracht hatte.“"
                            },
                            {
                                "example_id": "d0f6257a-5104-4d60-bdc3-f67aaae04cc4",
                                "sense_id": "d75ca48a-e99e-3f78-8fe6-2d2a49fe83f6",
                                "text": "„›Ist alles okay mit Ihnen?‹, fragt Raphael, und aus der Nähe riecht er nach Aftershave mit Moschusduft.“"
                            },
                            {
                                "example_id": "acbb7fb7-60af-4a8e-bd0a-46e406d19a64",
                                "sense_id": "d75ca48a-e99e-3f78-8fe6-2d2a49fe83f6",
                                "text": "„Er schloss auf und atmete die Gerüche von Möbelpolitur und Lack, Leim, Hobel- und Sägespänen und Bretterstapeln ein sowie den seltsamen, mysteriösen Moschusduft der alten, abgelebten Stücke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
