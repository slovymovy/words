                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4635078-ae1e-4ea3-aa05-cf9fbf1ec7c6",
                                                "sense_id": "8127ea1e-f567-3d02-b234-4f17a9a624e0",
                                                "text": "Антипыч только руку протянул было, чтобы погладить её, она вдруг как вскочит и лапами на плечи― и чмок и чмок его: и в нос, и в щёки, и в самые губы."
                                            }
                                        ]
                                    }
