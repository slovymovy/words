                        "cross_references": [
                            {
                                "target_word": "recentism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0b13b4a-077e-366c-aa4c-aab0ec388469",
                                        "entry_id": "16437d65-529a-31c3-abe7-008cd9f95cc4",
                                        "glosses": [
                                            "A focus on recent events to the exclusion of history."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1303909-c46c-4dbc-9e26-61ee6d3a240d",
                                                "sense_id": "b0b13b4a-077e-366c-aa4c-aab0ec388469",
                                                "text": "I grant that I might here be suffering from \"recentism\" — that is, attributing too-great significance to very recent events."
                                            },
                                            {
                                                "example_id": "f02db49c-b35a-4074-b66b-2a0b723d8564",
                                                "sense_id": "b0b13b4a-077e-366c-aa4c-aab0ec388469",
                                                "text": "[…]the tendency in the discipline of international relations to bolster endemic ethnocentrism with temporal short-sightedness – the flaws of parochialism and recentism[…]"
                                            },
                                            {
                                                "example_id": "798d44b8-5776-4969-b848-ad0e30fc3d90",
                                                "sense_id": "b0b13b4a-077e-366c-aa4c-aab0ec388469",
                                                "text": "Those who are persuaded by the breakup argument are victims of “recentism” — they are unduly influenced by the recent past and not sufficiently cognizant of previous history[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
