                "senses": [
                    {
                        "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                        "entry_id": "e7c8b4a1-1d96-3357-9814-237b268ebf60",
                        "glosses": [
                            "das Abtrennen, Aussondern von etwas aus einer Menge, Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e254576b-a9b7-4342-87fe-0dc8849f8ab2",
                                "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                                "text": "„Siemens kündigte zudem die Ausgliederung des zum Zuggeschäft gehörenden Bereichs Intelligent Traffic Systems (ITS) bis zum Ende des Geschäftsjahrs 2021 an.“"
                            },
                            {
                                "example_id": "938ff5da-85f2-4dfe-8966-54d6d8c8172e",
                                "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                                "text": "„Es soll sich nicht um eine Ausgliederung der einzelnen Sparten, sondern lediglich um eine vertragliche Übertragung von Rechten auf die GmbH mit Pachtvereinbarungen handeln.“"
                            },
                            {
                                "example_id": "4ebd285c-48f9-4766-a705-9081c14e91c6",
                                "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                                "text": "„Die außerordentliche Hauptversammlung des FC Bayern München hat die Ausgliederung des Fußball-Bereiches in eine Kapitalgesellschaft vollzogen.“"
                            },
                            {
                                "example_id": "3f751bc0-4879-44ac-9b1f-ebb33b4ae375",
                                "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                                "text": "„Der Umbruch, in dem sich Ceconomy seit der Ausgliederung aus dem Großhandelskonzern Metro befindet, steht stellvertretend für die Sorgen vieler stationärer Händler.“"
                            },
                            {
                                "example_id": "963a1c1c-9901-48b7-a03c-c476271c0be7",
                                "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                                "text": "„Der größte Kurstreiber bleibe aber die Bewertungsfantasie aus Ausgliederungen wie der des Lkw-Geschäfts im kommenden Jahr.“"
                            },
                            {
                                "example_id": "cbf0be11-63f9-4d2b-9b0a-3dc92c0960df",
                                "sense_id": "334d2ee7-2daa-33b2-8422-d5bf1cc1780a",
                                "text": "„Im Geschäftsjahr 2009 machte NXP unter anderem wegen Ausgliederungen nur noch einen Umsatz von 3,8 Milliarden Dollar und musste einen Nettoverlust von 161 Millionen Dollar hinnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
