                "senses": [
                    {
                        "sense_id": "592a755a-33df-302d-b185-0022fd00b7cc",
                        "entry_id": "44656302-8d76-3f52-b81f-450e2fb2520c",
                        "glosses": [
                            "Gruft für eine Familie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc4ab028-fc43-4b9d-92e6-865abbedd100",
                                "sense_id": "592a755a-33df-302d-b185-0022fd00b7cc",
                                "text": "„Er ruht in der Familiengruft auf dem Friedhof von Vallombrun.“"
                            },
                            {
                                "example_id": "080649cf-58e5-4eec-8069-79cd1dd7890f",
                                "sense_id": "592a755a-33df-302d-b185-0022fd00b7cc",
                                "text": "„Rothe sitzt auf einem Hügel, der einmal die Familiengruft seiner Vorfahren gewesen ist.“"
                            },
                            {
                                "example_id": "fbbf1a66-c949-4e94-ae53-869e14b4fd7e",
                                "sense_id": "592a755a-33df-302d-b185-0022fd00b7cc",
                                "text": "„Der junge Admiral, den man auf diese ungewöhnliche Weise zu konservieren gehofft hatte, um ihn in der väterlichen Familiengruft mit allen Ehren zu bestatten, war in völlige Verwesung übergegangen.“"
                            },
                            {
                                "example_id": "af9b2e65-ed14-49c1-a12e-a06f991446b8",
                                "sense_id": "592a755a-33df-302d-b185-0022fd00b7cc",
                                "text": "„Ursprünglich hatte Frau Mondtraut mit Simen Tjing darüber gesprochen, daß das Kind nicht zur Familiengruft mitgenommen werden sollte, einmal, weil es noch kein volles Jahr alt sei, und zweitens, weil die alte Liu erklärt hatte, die Fontanellen des Kindes seien noch nicht zugewachsen, auch könne der Kleine bei seiner Ängstlichkeit auf dem weiten Wege zur Grabstätte leicht erschrecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
