                                    {
                                        "sense_id": "fb6ca3bd-429d-35a3-ad8a-3a923ecd8a87",
                                        "entry_id": "5465c48b-caa8-3b04-8ba3-e90a5e14750c",
                                        "glosses": [
                                            "Leaving secretly of without explanation"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
