                                        "glosses": [
                                            "jemandem oder etwas gegenüber lautstarke Zustimmung (Jubel) zum Ausdruck bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18bac1a3-4a30-459c-b42e-51120f4c5013",
                                                "sense_id": "15979338-8f5a-33ab-886f-f9abefd33b9b",
                                                "text": "„An anderen Abenden verwandelte sich das Lokal in eine laute, verqualmte Höhle, in der sich Ehemänner um den Fernseher an der Bar drängten und die Los Angeles Dodgers entweder bejubelten oder beschimpften.“"
                                            },
                                            {
                                                "example_id": "4fd5a480-8883-46a4-8b19-dc6f2f8d27ba",
                                                "sense_id": "15979338-8f5a-33ab-886f-f9abefd33b9b",
                                                "text": "„Beide bestritten ihre Wettkämpfe am gleichen Tag, und beide gingen daraus als bejubelte Sieger hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
