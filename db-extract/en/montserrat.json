                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5727e1-0648-484f-8eca-f3262c9f6226",
                                                "sense_id": "0b95a583-9410-3f51-9d4b-55ca3ebc10ee",
                                                "text": "Die gebirgige Insel Montserrat gehört zum inneren vulkanischen Bogen der Inseln über dem Winde (Kleine Antillen)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
