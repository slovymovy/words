                "senses": [
                    {
                        "sense_id": "6d9417db-0243-3dca-aeb9-93aa512822a5",
                        "entry_id": "e3d59c33-87b7-3cf8-904f-27e53f8a6ed9",
                        "glosses": [
                            "Session de formation de haut niveau dispensée par un artiste dont l’autorité est reconnue dans une discipline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebae52a3-f0a0-4a64-af9b-b5a5dfb57d74",
                                "sense_id": "6d9417db-0243-3dca-aeb9-93aa512822a5",
                                "text": "L’organisation était efficace, chaque masterclasse durait environ 50 à 60 min pendant cinq jours."
                            },
                            {
                                "example_id": "97836bac-6d34-4c78-9e0e-50c86518d75d",
                                "sense_id": "6d9417db-0243-3dca-aeb9-93aa512822a5",
                                "text": "Victor avait déjà fait l’expérience de lui parler d’un réalisateur ou d’un film qu’il appréciait et de subir le lendemain une sorte de masterclasse par Louis qui lui expliquait ce que Victor lui avait dit la veille."
                            },
                            {
                                "example_id": "e7123003-498c-46f2-9d71-4ec8d7ae32c3",
                                "sense_id": "6d9417db-0243-3dca-aeb9-93aa512822a5",
                                "text": "Les donateurs obtiendront, en contrepartie et selon l’étendue de leur générosité, un accès au studio de podcast de la Gaîté Lyrique, un coaching par des professionnels du secteur (les réalisateurs Théo Boulenger et Camille Juzeau, notamment) pour mener à bien leur projet podcastique, ainsi que des places pour des masterclasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c63098da-ff40-3ce2-a52f-bf6b82907f25",
                        "entry_id": "e3d59c33-87b7-3cf8-904f-27e53f8a6ed9",
                        "glosses": [
                            "Action ou performance virtuose démontrant la maitrise brillante d’un sujet par une personne."
                        ],
