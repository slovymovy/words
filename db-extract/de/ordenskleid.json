                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87fe8b56-de63-4bbb-860f-8ba88bef10e7",
                                                "sense_id": "7b5c4ade-7396-36f2-88b0-83caa970ef8f",
                                                "text": "By force of habit, he dressed for work even though it was holiday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d50de8-d449-3981-bbb9-5cf518117669",
                                        "entry_id": "b1f47610-2229-3655-a4a7-cb2a25b3b3a4",
