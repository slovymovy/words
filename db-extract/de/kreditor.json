                                        "entry_id": "4421369e-ccfb-32f8-9a2d-0c5b54d76318",
                                        "glosses": [
                                            "Relatif à la dette envers des institutions qui prêtent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14dd4b78-ccc3-47e0-8d46-d21a67b37778",
                                                "sense_id": "5e35a287-a03e-364f-a7fa-e74bc1053fab",
                                                "text": "Un pays se trouvant en position créditrice devra participer à l’élimination des déséquilibres dans l’ensemble de la zone."
                                            },
                                            {
                                                "example_id": "d9364d6e-3847-448c-b4b4-5ff347a3ada0",
                                                "sense_id": "5e35a287-a03e-364f-a7fa-e74bc1053fab",
                                                "text": "Compte créditeur, compte qui établit le crédit."
                                            },
                                            {
                                                "example_id": "8098940a-f7eb-4a7d-a6bd-583f42a4faca",
                                                "sense_id": "5e35a287-a03e-364f-a7fa-e74bc1053fab",
                                                "text": "Solde créditeur, solde d’un compte où la balance est du côté de l’actif (positive)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "créditeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8eed379b-a4c7-3462-859c-79798f4553ef",
                                        "entry_id": "cfe6f9b3-84ad-3084-87c6-cee152311fd8",
                                        "glosses": [
                                            "Créancier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef117f26-c61d-4538-8bac-674d02c76c54",
                                                "sense_id": "8eed379b-a4c7-3462-859c-79798f4553ef",
                                                "text": "La deuxième espèce de créances comprend les valeurs portant des signatures de tiers et escomptés par le créditeur."
                                            }
                                        ]
                                    }
