                "senses": [
                    {
                        "sense_id": "1f3f41cd-bcf3-3f76-8b02-0675321dd7a2",
                        "entry_id": "5f0d6791-3389-3dd5-b424-b2b758f7e788",
                        "glosses": [
                            "Rendre proche de la CGT."
                        ],
                        "tags": [
                            "Syndicalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "19e7e6c3-e055-4320-97cd-8b41d25c27ac",
                                "sense_id": "1f3f41cd-bcf3-3f76-8b02-0675321dd7a2",
                                "text": "Cependant, en dépit des exigences financières et de contextes l’entraînant parfois à cégétiser son comportement, le « musicien du culte » ne peut pas être uniquement cynique."
                            },
                            {
                                "example_id": "b55287ad-8642-45f7-acc5-55d61307cf66",
                                "sense_id": "1f3f41cd-bcf3-3f76-8b02-0675321dd7a2",
                                "text": "Christine n'a plus de boulot, Frédéric est au placard...relégué aux poubelles au propre et au figuré, Jean-Bernard tente d'évangéliser ou plutôt de cégétiser ces proies rêvées pour le défilé du 1ᵉʳ mai, la vente de l'Huma dimanche et du regretté Pif-le-Chien (j'en rajoute un peu)!"
                            },
                            {
                                "example_id": "a2963071-2b48-49a1-95d8-21069d56a471",
                                "sense_id": "1f3f41cd-bcf3-3f76-8b02-0675321dd7a2",
                                "text": "C'est idiot de se cégétiser alors que la CGT est morte."
                            }
                        ]
                    }
