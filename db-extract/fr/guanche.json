                        "glosses": [
                            "Relatif à l’ancienne population de l’île de Ténérife."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6315df80-a3b8-43e2-a164-877688d2e9fb",
                                "sense_id": "b319a963-58c5-37ce-be94-084e49d88840",
                                "text": "La possession de ce paradis terrestre a été ardemment convoitée et vaillamment défendue; et c’est la région que nous venons de parcourir, saturée de sang guanche et espagnol, qui fut le théâtre de la lutte acharnée qui se termina par la soumission de l’île."
                            }
                        ]
                    }
                ],
