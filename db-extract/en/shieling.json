                        "examples": [
                            {
                                "example_id": "7aad9ed5-eb25-491d-ab92-a0c968dc67e6",
                                "sense_id": "014d7e23-0a34-3cf0-ba5f-94dcc5f48f01",
                                "text": "The cattle at Mosfell were kept in a shieling, and Thordis stayed there while the Thing took place."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbb90984-d4ca-3fcf-aac9-14146f950d9a",
                        "entry_id": "9d28963d-5ef7-3b18-b1ec-94236f15a576",
                        "glosses": [
                            "A shepherd's hut or shack."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4bb5816-6386-4d3a-9abd-31b67acaad60",
                                "sense_id": "fbb90984-d4ca-3fcf-aac9-14146f950d9a",
                                "text": "And what are twenty beds, when all the drovers,\nAnd all the shieling herdsmen from Bengorach,\nMust have a lair provided for the night."
                            },
                            {
                                "example_id": "71904097-9485-42c0-9be6-b1c821157def",
                                "sense_id": "fbb90984-d4ca-3fcf-aac9-14146f950d9a",
                                "text": "Cabins and shielings had been torn down and burned."
                            }
                        ]
