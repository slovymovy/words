                "forms": [],
                "senses": [
                    {
                        "sense_id": "c448faca-b755-313d-8a2f-5186335d4e23",
                        "entry_id": "ace51f3a-8368-3ee9-a1ce-fdf80973bc3a",
                        "glosses": [
                            "A male given name from Hebrew, variant of John."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79076094-747f-456b-ac8a-0acf3f0a71de",
                                "sense_id": "c448faca-b755-313d-8a2f-5186335d4e23",
                                "text": "In that Summer of 1909 the simple souls who even then desired to simplify the English tongue, had, of course, no cognizance of little Jon, or they would have claimed him for a disciple. But one can be too simple in this life, for his real name was Jolyon, and his living father and dead half-brother had usurped of old the other shortenings, Jo and Jolly. As a fact little Jon had done his best to conform to convention and spell himself first Jhon, then John; not till his father had explained the sheer necessity, had he spelled his name Jon."
                            }
                        ]
                    },
                    {
                        "sense_id": "33725777-c66a-3d05-b986-0d9221320c85",
                        "entry_id": "ace51f3a-8368-3ee9-a1ce-fdf80973bc3a",
                        "glosses": [
                            "A diminutive of the male given name Jonathan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0fdd790-b4be-44ee-8913-56151cc49656",
                                "sense_id": "33725777-c66a-3d05-b986-0d9221320c85",
                                "text": "\"I suppose I ought to call you Uncle Jack now.\" \"Please don't. My name is Jonathan, and I've never had a nickname. Doesn't go with my character. So, Uncle Jon - if you must.\""
                            },
                            {
                                "example_id": "d44c0f4d-dd01-4c1f-9136-f36bf5baace8",
                                "sense_id": "33725777-c66a-3d05-b986-0d9221320c85",
                                "text": "Inundated with anti-Semitic tweets and frustrated by Twitter's initial response, New York Times editor Jon Weisman is packing up and leaving the social media platform."
                            }
                        ]
                    }
                ],
