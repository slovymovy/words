                "senses": [
                    {
                        "sense_id": "424f0df4-4e87-3c86-848c-4b6c8c737d7d",
                        "entry_id": "85b79ad3-611c-3209-bdfd-ae9201dff97a",
                        "glosses": [
                            "Détruire par un cataclysme, ou à la manière d’un cataclysme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b8cbc9-8f48-4e5b-9efa-ff6e803561e9",
                                "sense_id": "424f0df4-4e87-3c86-848c-4b6c8c737d7d",
                                "text": "Si la vigne disparaît, l’Aude est complètement «cataclysmée»."
                            },
                            {
                                "example_id": "192dbbdf-180c-40cd-a3d2-2c47fb00c04a",
                                "sense_id": "424f0df4-4e87-3c86-848c-4b6c8c737d7d",
                                "text": "Chapitre three Dans lequel il continue de cataclysmer, voire d’apocalypser à tout berzingue"
                            },
                            {
                                "example_id": "03f4fe33-57cd-422b-b796-6745419f7312",
                                "sense_id": "424f0df4-4e87-3c86-848c-4b6c8c737d7d",
                                "text": "Mais j’ignorais qu’on ne pouvait pas cataclysmer un Sentimonstre, moi !"
                            },
                            {
                                "example_id": "08d3c8af-0bc5-4d7f-b34c-10a88f2fb3e3",
                                "sense_id": "424f0df4-4e87-3c86-848c-4b6c8c737d7d",
                                "text": "Je reprends un bon bol d’air et, adoptant un crawl dans le plus pur style Laure Manaudou, j’essaie de mettre le plus de distance possible entre moi et ce foutu camping-car qui ne va pas tarder à cataclysmer."
                            }
                        ]
                    }
