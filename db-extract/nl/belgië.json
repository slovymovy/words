                                "target_senses": [
                                    {
                                        "sense_id": "6c2b0707-7cab-3269-9ad5-2e83350ba94b",
                                        "entry_id": "9245257b-62ac-390b-98dc-47e748d81c87",
                                        "glosses": [
                                            "Land im Westen von Mitteleuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "993be6eb-9b83-42a9-8c20-68c10d30349e",
                                                "sense_id": "6c2b0707-7cab-3269-9ad5-2e83350ba94b",
                                                "text": "Über Belgien weiß ich eigentlich fast gar nichts."
                                            },
                                            {
                                                "example_id": "a812ea50-d31c-4617-9dfc-6c6fab483144",
                                                "sense_id": "6c2b0707-7cab-3269-9ad5-2e83350ba94b",
                                                "text": "Brüssel ist die Hauptstadt von Belgien."
                                            },
                                            {
                                                "example_id": "c3b0d167-d918-4815-8d5f-d49493bc4d1d",
                                                "sense_id": "6c2b0707-7cab-3269-9ad5-2e83350ba94b",
                                                "text": "„Das Belgien der Nachkriegszeit erlebte einen wirtschaftlichen Aufschwung, welcher später vor allem durch die Wahl Brüssels als Standort für die Zentralbehörden der EU und der NATO verstärkt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23e21a31-68a9-4582-9222-fe0263ab90bd",
                        "source_entry_id": "0e3b44e9-426c-339f-ac15-f4284c32ea8c",
                        "source_sense_id": "2a348b8f-3eae-3fde-8127-731fbe01b2f0",
                        "target_lang_word": "Belgium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
