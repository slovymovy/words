                                            {
                                                "example_id": "4e428e6d-bb3f-463b-ae65-1dde02d2c0d3",
                                                "sense_id": "347dad14-9e7f-3c03-a5b9-691c5faf8013",
                                                "text": "Candles, in fact, are an essential ingredient in many spells. They can be used as either the focus of the spell or as a component that sets the spell's overall mood and tone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a7c4c3e-dec4-3168-8ddf-fffbf5603b9f",
                                        "entry_id": "87ef95fd-4bd7-30ca-9253-552e02a19412",
                                        "glosses": [
                                            "The centre of an older fish's scale, which is the point where a younger fish's scale starts to grow from."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "focus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aefed87-5ef7-3e2a-84a2-4a356e4593d8",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To cause (rays of light, etc) to converge at a single point."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff07e6b-efe6-485e-90ed-86fc23627ee1",
                                                "sense_id": "6aefed87-5ef7-3e2a-84a2-4a356e4593d8",
                                                "text": "The difficulties of focussing colour-light signals on curved tracks to ensure maximum sighting distance were underlined in the recent official report [...] on a low-speed collision at Newcastle Central on July 25, 1960, between an unfitted freight and a diesel-hauled passenger train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d96a044-3d2f-33b3-af7c-711ab1416b96",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To adjust (a lens, an optical instrument) in order to position an image with respect to the focal plane."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80a284d-6439-4746-ac20-ac9e5a9426cf",
                                                "sense_id": "2d96a044-3d2f-33b3-af7c-711ab1416b96",
                                                "text": "You'll need to focus the microscope carefully in order to capture the full detail of this surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To adjust itself or be adjusted such that light from a scene converges appropriately to create a clear image."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "665a2bc4-ae14-4dee-8edd-379cc1944e84",
                                                "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                                                "text": "I can't get the lens to focus."
                                            },
                                            {
                                                "example_id": "acae7729-50aa-4041-9e9e-29a83596734d",
                                                "sense_id": "5003dc27-d68f-3dcd-967b-038260598e68",
                                                "text": "The camera focuses automatically on the subject's eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10589904-3649-3428-8016-8515e8ca2594",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To direct attention, effort, or energy to a particular audience or task."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9d7eff9-5bb3-4c05-b740-5ac9f2bf9f7b",
                                                "sense_id": "10589904-3649-3428-8016-8515e8ca2594",
                                                "text": "The president focused her remarks on the newcomers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8f4c9a-7c28-3890-be40-c9d11d2b3011",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To concentrate one’s attention."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f65e68-e1f7-45d4-a6d4-b8aba75c63e4",
                                                "sense_id": "5f8f4c9a-7c28-3890-be40-c9d11d2b3011",
                                                "text": "If you're going to beat your competitors, you need to focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22dd6464-fa30-3657-abd9-e0a4b1da5590",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To concentrate one's attention on something; to have as one's central point of interest, concern, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ab811bd-0a1d-4e63-b7fd-573a3a29529b",
                                                "sense_id": "22dd6464-fa30-3657-abd9-e0a4b1da5590",
                                                "text": "I have to focus on my work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da39fddf-1f7b-3ec6-9f4c-32cdc81860e5",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To transfer the input focus to (a visual element), so that it receives subsequent input."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32a50ada-4170-43c3-83c2-f800b933d13b",
                                                "sense_id": "da39fddf-1f7b-3ec6-9f4c-32cdc81860e5",
                                                "text": "The text box won't receive the user's keystrokes unless you explicitly focus it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63abe1bd-8ef7-3bf9-b011-4c80fa77a0de",
                                        "entry_id": "20c1a649-19ec-344d-ad88-c36bfcb6e292",
                                        "glosses": [
                                            "To aggregate figures of accounts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b213aa1e-fdfc-42a4-add8-60e8c77367aa",
                                                "sense_id": "63abe1bd-8ef7-3bf9-b011-4c80fa77a0de",
                                                "text": "Whole pages of it are filled with masses of figures, generally single numbers added up in batches, and then the totals added in batches again, as though he were \"focusing\" some account, as the auditors put it."
