                ],
                "senses": [
                    {
                        "sense_id": "028ca9fd-ad4b-3488-b171-da51b139eb59",
                        "entry_id": "6a73eb72-fc1e-3ee2-8f5e-dab4aac062be",
                        "glosses": [
                            "Attraper, saisir, prendre."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "37d5d4a8-1346-326f-90a5-d10d8733e1c7",
                        "entry_id": "6a73eb72-fc1e-3ee2-8f5e-dab4aac062be",
                        "glosses": [
                            "Arrêter, appréhender (quelqu’un)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "956b60f2-4cd3-497e-9a5b-309bc78d8e0c",
                                "sense_id": "37d5d4a8-1346-326f-90a5-d10d8733e1c7",
                                "text": "– Ah ! je vous vois venir, mon malin, répondit Pierre Manas ; vous voulez me faire arquepincer, n’est-ce pas ? avouez-le tout de suite."
                            },
                            {
                                "example_id": "555d036b-ad89-42d1-8c53-b8d8f798b3d6",
                                "sense_id": "37d5d4a8-1346-326f-90a5-d10d8733e1c7",
                                "text": "- Si vous arquepincez la môme Coras, embarque-la en souplesse, sans publicité, et mets-la-moi au frais en m’attendant ; isolement complet, vu ?"
                            },
                            {
                                "example_id": "a7661cb5-a550-4427-b9d2-f89ad47d07c9",
                                "sense_id": "37d5d4a8-1346-326f-90a5-d10d8733e1c7",
                                "text": "Il se dit qu’il n'aura aucun mal à arquepincer les deux caroubleurs et réfléchit seulement pour savoir en quelle prison il pourra bien les boucler."
                            }
                        ]
                    }
