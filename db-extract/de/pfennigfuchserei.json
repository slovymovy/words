                "senses": [
                    {
                        "sense_id": "00f819b6-d16e-3a07-aeba-cfcc60f5a8c7",
                        "entry_id": "8b228813-6e35-3057-a598-9a542f6ff3b7",
                        "glosses": [
                            "Einstellung/Haltung, äußerst geizig zu sein, auf übertriebene Weise sparsam zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baad7022-132d-4056-a13f-1e9c562aa845",
                                "sense_id": "00f819b6-d16e-3a07-aeba-cfcc60f5a8c7",
                                "text": "„Sie stand zwar noch ganz am Anfang ihres Lehrgangs, spürte jedoch instinktiv, dass Ivys Pfennigfuchserei der falsche Weg war.“"
                            },
                            {
                                "example_id": "89234070-37b7-4f23-92bb-4540f4c73a9a",
                                "sense_id": "00f819b6-d16e-3a07-aeba-cfcc60f5a8c7",
                                "text": "„Genaugenommen nervte ihn ihre peinlich genaue Pfennigfuchserei, nach jedem Einkauf musste er ein paar Minuten seiner wertvollen Lebenszeit dafür opfern, mit ihr zusammen verschiedene Supermarktrechnungen zu kontrollieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
