                "senses": [
                    {
                        "sense_id": "d8f070c6-343d-3ae3-9ff6-131283954cc4",
                        "entry_id": "68668bf2-fdef-3138-b129-7b8d60016a7b",
                        "glosses": [
                            "Antwort auf Kritik in Form von Kritik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85fb6fe-a853-4cd5-8489-fe6aebb1970d",
                                "sense_id": "d8f070c6-343d-3ae3-9ff6-131283954cc4",
                                "text": "„Kein Wunder also, dass Kritik am Liberalismus, die sich dezisionistischer Muster bedient …, typischerweise heftige Gegenkritik hervorruft.“"
                            },
                            {
                                "example_id": "1a3ac08a-fb12-46e9-bc50-9d9b6af2a30b",
                                "sense_id": "d8f070c6-343d-3ae3-9ff6-131283954cc4",
                                "text": "„Wir haben auch diesen Vortheil, daß, wenn indessen auch eine Gegencritik erscheint, die Rezension der Metaphysik einstweilen dem Publicum eine Unterhaltung macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
