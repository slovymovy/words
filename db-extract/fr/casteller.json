                    {
                        "sense_id": "c12a3d65-bd83-37ee-9983-1d4e86df2c80",
                        "entry_id": "9f4a9cfc-5ba9-3d34-b6f2-5ffcc016eddc",
                        "glosses": [
                            "Participant à la construction d'un castell, tour humaine catalane traditionnelle, et élément constitutif de celui-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8d7ebd-f0ef-4863-8384-61c0109c65d3",
                                "sense_id": "c12a3d65-bd83-37ee-9983-1d4e86df2c80",
                                "text": "Un à un, tels de petits singes habiles, les castellers grimpent vers le sommet de la pyramide, jusqu'à ce que le dernier, un gamin de 7-8 ans, agite sa petite main une fois en haut."
                            },
                            {
                                "example_id": "5a628edb-828c-49d2-b474-492351d21906",
                                "sense_id": "c12a3d65-bd83-37ee-9983-1d4e86df2c80",
                                "text": "Les castellers formés en véritables équipes ou sociétés se livrent des duels épiques, souvent remportés par la colla Vella Xiquets, originaire de Valls."
                            },
                            {
                                "example_id": "5c85abd6-e8fe-4ef8-ae0c-a497d0f98ee4",
                                "sense_id": "c12a3d65-bd83-37ee-9983-1d4e86df2c80",
                                "text": "Au premier coup d'œil, les castells (châteaux) ont l'air d'un simple jeu, mais les castellers, eux, pratiquent leur art avec autant de sérieux que des sportifs de haut niveau."
                            }
                        ]
                    }
                ],
