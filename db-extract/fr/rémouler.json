                ],
                "senses": [
                    {
                        "sense_id": "31f35fa2-3578-3e6a-9be1-3dab5299443d",
                        "entry_id": "267be218-1870-39cd-92b3-fc4f96019275",
                        "glosses": [
                            "Aiguiser (des couteaux, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e10c54d2-f86f-4661-acf4-7bc48eb7597e",
                                "sense_id": "31f35fa2-3578-3e6a-9be1-3dab5299443d",
                                "text": "Oppose-toi à ce que personne y mette la main ; je ne demande que le temps de faire rémouler ma serpette, et j'arrive."
                            },
                            {
                                "example_id": "54e35479-4a20-4c17-a35c-23c7c9538eb3",
                                "sense_id": "31f35fa2-3578-3e6a-9be1-3dab5299443d",
                                "text": "Même une lame en céramique se désaffute, il faut donc rémouler ou redonner une forme parfaite à cette lame à l’aide d’une meule à pédale, que tourne la grande roue…"
                            },
                            {
                                "example_id": "75c99dbe-5ce8-44b0-8372-487eb82221a2",
                                "sense_id": "31f35fa2-3578-3e6a-9be1-3dab5299443d",
                                "text": "Ce qui me rappelle le rémouleur de mon enfance, le type qui passait dans les villages avec son fourbi à rémouler, une sorte de tricycle."
                            }
                        ]
                    }
                ],
