                        "source_sense_id": "df939818-d5cb-328c-bb02-c857df469139",
                        "source_sense_description": "estimate, judgment or opinion",
                        "target_lang_word": "Mutmaßung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mutmaßung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03dddf2e-758d-3a67-81b6-c6d40ff2d85e",
                                        "entry_id": "83272ea0-beef-32b5-ba15-5a890e5e6184",
                                        "glosses": [
                                            "ungesicherte Erkenntnis oder Annahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24cbb2e2-858b-4ac7-90d4-df553a047017",
                                                "sense_id": "03dddf2e-758d-3a67-81b6-c6d40ff2d85e",
                                                "text": "„Oder in die Frage werden Mutmaßungen eingekleidet, die dem Publikum quasi en passant als Tatsachen untergejubelt werden.“"
                                            },
                                            {
                                                "example_id": "038b73a6-3ce6-4594-8c6c-5d1353af608a",
                                                "sense_id": "03dddf2e-758d-3a67-81b6-c6d40ff2d85e",
                                                "text": "„Nach dem, was mir der Marchese Triulzi gesagt hatte, war ich überzeugt, daß Barbaro, als er meinte, man könne sie für Geld haben, nur eine Mutmaßung ausgesprochen hatte.“"
                                            },
                                            {
                                                "example_id": "18c9c1d0-955f-4b1c-8af2-58838d30bc20",
                                                "sense_id": "03dddf2e-758d-3a67-81b6-c6d40ff2d85e",
                                                "text": "„Diese Zeilen sagen mehr als alle anderen Mutmaßungen: man hatte nicht ohne Grund um das Leben Galileo Galileis gebangt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41057666-f108-4066-bf24-cc6e552fdad6",
                        "source_entry_id": "6db56bb3-8c82-33b0-9ef3-b231f9a660fb",
                        "source_sense_id": "df939818-d5cb-328c-bb02-c857df469139",
