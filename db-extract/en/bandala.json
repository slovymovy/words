        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "efa4feef-1c71-3b72-baaa-4dce7ff3f58e",
                "word": "bandala",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "63abc065-2fea-4498-b861-ef18b084d728",
                        "entry_id": "efa4feef-1c71-3b72-baaa-4dce7ff3f58e",
                        "tags": [
                            "plural"
                        ],
                        "form": "bandalas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "928c07e1-eb8c-3852-99c5-89b3cb581a54",
                        "entry_id": "efa4feef-1c71-3b72-baaa-4dce7ff3f58e",
                        "glosses": [
                            "A fabric made in Manila from the older leaf sheaths of the abaca (Musa textilis)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bab5a7cf-2cbf-472f-8a28-20fa004393a1",
                                "sense_id": "928c07e1-eb8c-3852-99c5-89b3cb581a54",
                                "text": "The fibers of the inner petioles, which are softer but not so strong as the outer, are called tupus, and sold with bandala, or mixed with tapis and used in the native weaving."
                            },
                            {
                                "example_id": "b9e65648-76ee-4974-9e91-d0f2cb4c8439",
                                "sense_id": "928c07e1-eb8c-3852-99c5-89b3cb581a54",
                                "text": "Itermediate textile fibers beween lupis and bandala, known as tupus among other names, were also produced and sold, though rarely in great quantities."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ba6d8d9-87c0-331f-a845-a54376be054c",
                        "entry_id": "efa4feef-1c71-3b72-baaa-4dce7ff3f58e",
                        "glosses": [
                            "A system imposed by the Spanish colonial government in the Philippines in the early 17th century which required farmers to sell their products to the government for extremely low prices, and sometimes without ever being paid."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bfd449a5-76f7-43e5-8240-fee122e808c6",
                                "sense_id": "9ba6d8d9-87c0-331f-a845-a54376be054c",
                                "text": "Another exploitative device was instituted by Governor Sebastian Hurtado de Corcuera during the first half of the seventeenth century . This was the bandala."
                            },
                            {
                                "example_id": "285f6bac-7fcb-4838-9114-40e51c55ba5f",
                                "sense_id": "9ba6d8d9-87c0-331f-a845-a54376be054c",
                                "text": "Under the bandala, the sale of the crops and other products of the Filipinos was centralized and controlled by the Spanish authorities."
                            },
                            {
                                "example_id": "201dfd48-b022-4c3d-b56c-1cf6ad05da92",
                                "sense_id": "9ba6d8d9-87c0-331f-a845-a54376be054c",
                                "text": "The province of Pampanga, because of its closeness to Manila, suffered most from the polo services and the bandala since its rice produce and timber were in great demand."
                            },
                            {
                                "example_id": "dc0d714f-e7b0-4409-a047-14a0424972d0",
                                "sense_id": "9ba6d8d9-87c0-331f-a845-a54376be054c",
                                "text": "Doing so then allows us to understand how new colonial institutions adopted these preexisting forms of power, relying on debt to mobilize labor within the repartimiento, bandala, and tribute systems."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "60fd63f1-9507-3263-b78c-56138aed9111",
                "word": "Bandala",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a8b3cf6a-331b-4911-846e-3446fc3df09f",
