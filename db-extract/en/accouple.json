                                                "sense_id": "56262fec-a9c1-3921-aa5d-bf6f215f31cf",
                                                "text": "„Den darin enthaltenen Text kann man aufteilen, aber auch wieder zusammenfügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "461d98a7-6f88-3cf1-839d-20c85c45cf36",
