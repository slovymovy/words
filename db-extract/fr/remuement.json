                        "form_id": "d30aef20-7858-4d39-a4e7-dd2de0a5dd8b",
                        "entry_id": "d1586ffb-b76a-30f2-ac47-0da412e1a1e9",
                        "tags": [],
                        "form": "remûment"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a397d1d1-491d-3b3b-97dd-78a183d92c51",
                        "entry_id": "d1586ffb-b76a-30f2-ac47-0da412e1a1e9",
                        "glosses": [
                            "Action de ce qui remue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ea7f05-2940-431c-bc2a-8e7d21dea21c",
                                "sense_id": "a397d1d1-491d-3b3b-97dd-78a183d92c51",
                                "text": "Souvent nous nous arrêtions au milieu d’une phrase, parce qu’il nous avait semblé entendre un craquement, un pas, un remuement insolite…"
                            },
                            {
                                "example_id": "de0f8dea-1f25-44ad-9642-caffdee0c05b",
                                "sense_id": "a397d1d1-491d-3b3b-97dd-78a183d92c51",
                                "text": "La voix se taisait, et je m’apercevais au remuement de ses lèvres qu’elle continuait intérieurement l’air commencé à haute voix."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4542974-d59c-3b82-9e55-b53dd81827a7",
                        "entry_id": "d1586ffb-b76a-30f2-ac47-0da412e1a1e9",
                        "glosses": [
                            "Transport d’une grande quantité de terre d’un lieu à un autre."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "027e855b-06cd-347d-b935-2a88bc2e7538",
                        "entry_id": "d1586ffb-b76a-30f2-ac47-0da412e1a1e9",
                        "glosses": [
                            "Agitation, changement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fc7b7fb8-d26c-48a8-a1a3-744c4cfc51c1",
                                "sense_id": "027e855b-06cd-347d-b935-2a88bc2e7538",
                                "text": "Les enfants aiment le bruit et le remuement."
                            },
                            {
                                "example_id": "c715b220-2c40-4ab6-a220-02f7f9a2941d",
                                "sense_id": "027e855b-06cd-347d-b935-2a88bc2e7538",
                                "text": "Alors, avec un grand remuement de chaises, un froufrou d’endimanchement, une expansion d’enfants rieurs devant la table mise, tous ces bourgeois heureux s’installaient autour des petits pâtés symétriquement empilés sur le réchaud d’argent."
                            },
                            {
                                "example_id": "ed00c0b9-8c23-4db3-8751-748f86ed43e0",
                                "sense_id": "027e855b-06cd-347d-b935-2a88bc2e7538",
                                "text": "Il entendit d’abord du remuement dans la petite chambre que Julien occupait à côté de la leur, puis la porte s’ouvrit et la mère entra sans faire de bruit."
                            },
                            {
                                "example_id": "34a00d46-5f77-4d87-bffd-ae2e2a7dd391",
                                "sense_id": "027e855b-06cd-347d-b935-2a88bc2e7538",
                                "text": "A travers ses graves pensées, il entendait le remuement de sa belle-mère dans la salle de bains."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bfac233-d7db-3b9d-8967-4a3c0d0e7dea",
                        "entry_id": "d1586ffb-b76a-30f2-ac47-0da412e1a1e9",
                        "glosses": [
                            "Agitation, trouble excité dans un état, dans un pays, dans une maison."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "51b2929e-9f47-4a7a-b0c3-38bf8116edb4",
                                "sense_id": "3bfac233-d7db-3b9d-8967-4a3c0d0e7dea",
                                "text": "Son arrivée a causé beaucoup de remuement dans la maison."
                            },
                            {
                                "example_id": "899c329a-5e9c-4c66-9d7d-7fd820af887b",
                                "sense_id": "3bfac233-d7db-3b9d-8967-4a3c0d0e7dea",
                                "text": "Causer du remuement."
                            },
                            {
                                "example_id": "725d5251-d145-47cd-b3fe-54c2d8a3c781",
                                "sense_id": "3bfac233-d7db-3b9d-8967-4a3c0d0e7dea",
                                "text": "Il y a eu de grands remuements dans cette province."
                            }
                        ]
                    }
                ],
