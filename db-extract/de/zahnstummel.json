                "senses": [
                    {
                        "sense_id": "976c9e17-279a-3a37-82bd-8b5681207066",
                        "entry_id": "1c7553d3-c9c7-3075-8cf6-57ae4d3863db",
                        "glosses": [
                            "übrig gebliebener Rest eines Zahns"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c91978-3dfa-42a0-83d4-7dfacdcc822e",
                                "sense_id": "976c9e17-279a-3a37-82bd-8b5681207066",
                                "text": "„Unter einem blechernen Giebel, in einer Puppenstube hinter Glas hockt die Wahrsagerin, eine alte Frau mit zottigem Haar, ein paar Zahnstummel im grinsenden Mund.“"
                            },
                            {
                                "example_id": "242937aa-bbef-4df7-a7b9-f361d60d680c",
                                "sense_id": "976c9e17-279a-3a37-82bd-8b5681207066",
                                "text": "„Er hatte nur noch völlig abgenutzte Zahnstummel im Mund, und es hatte ihm die Hände gekrümmt und den Körper schief verzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56303bf5-b803-41ca-9610-6fcd1da5d0ee",
                        "source_entry_id": "1c7553d3-c9c7-3075-8cf6-57ae4d3863db",
                        "source_sense_id": "976c9e17-279a-3a37-82bd-8b5681207066",
                        "source_sense_description": "übrig gebliebener Rest eines Zahns",
                        "target_lang_word": "chicot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chicot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5d59ef9-34e5-324f-9cee-459415e25204",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "Ce qui reste hors de terre d’un arbre cassé par le vent ou coupé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9b07cc-48fc-4045-8476-d5e560f33f80",
                                                "sense_id": "c5d59ef9-34e5-324f-9cee-459415e25204",
                                                "text": "Quelques troncs verts avaient été coupés et utilisés comme pièces de charpente ; des chicots secs, sciés et fendus, avaient alimenté tout un hiver le grand poêle de fonte ; mais le sol était encore recouvert d’un chaos de souches, de racines entremêlées, d’arbres couchés à terre, trop pourris pour brûler, d’autres arbres morts mais toujours debout au milieu d’un taillis d’aunes."
                                            },
                                            {
                                                "example_id": "0bf8d98b-2b9b-4a28-889f-70379cacbdbd",
                                                "sense_id": "c5d59ef9-34e5-324f-9cee-459415e25204",
                                                "text": "Des pignons s’effritent comme de vieux chicots, une étable n’est plus qu’un amas de pierrailles."
                                            },
                                            {
                                                "example_id": "a5e2bee7-93c8-479c-8a76-e12740d8ab77",
                                                "sense_id": "c5d59ef9-34e5-324f-9cee-459415e25204",
                                                "text": "Ici et là, la serpe légère a tranché une gaule trop hardie et qui obstrue le ciel, amputé un chicot qui pourrait servir de perchoir."
                                            },
                                            {
                                                "example_id": "494c1456-5d67-4ea0-b416-6ff3fee13e08",
                                                "sense_id": "c5d59ef9-34e5-324f-9cee-459415e25204",
                                                "text": "Au tournant d’un virage en coude, des baraques délabrées et abandonnées, quelques carcasses de voitures rouillées, des chaloupes trouées, des chicots d’arbres morts dans le marais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293d3a9e-532a-30c2-bd4f-0fabe1619755",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "Meuble représentant un tronc d’arbre écoté dans les armoiries. Il est généralement représenté sans racines ni faîte avec des couples de branches coupées disposées de part et d’autre du tronc de manière symétrique. Il est représenté en pal sinon, on doit préciser sa position. À rapprocher de écot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e6715d-3fc2-4461-80e7-535207716cd0",
                                                "sense_id": "293d3a9e-532a-30c2-bd4f-0fabe1619755",
                                                "text": "D’azur aux trois chicots d’argent posés en fasce et rangés en pal, qui est de la commune de Saint-Arnoult de Seine-Maritime → voir illustration « armoiries avec 3 chicots »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a851715e-8bf8-36cc-8c4c-f3fb08f1d1f2",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "Petit morceau de bois rompu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed298e4a-5375-4d7f-9a4b-7a73a3c379c9",
                                                "sense_id": "a851715e-8bf8-36cc-8c4c-f3fb08f1d1f2",
                                                "text": "Les gardes veillent encore et enjoignent aux facteurs de veiller à ce que dans un temps de neige, les ouvriers dégarnissent bien les souches, pour ne pas faire une mauvaise coupe, et à ce qu’ils aient également l’attention de bien débuissonner, et de ne pas laisser de vieux chicots ni estocs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f034401-7a57-38c4-b640-3338a1124b8f",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "Blessure du pied, faite par un chicot."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7e7ab7a-8251-39cb-a4a4-26d381a89833",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "Morceau qui reste d’une dent rompue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52e6a21a-6a8d-4878-9d05-7b402c5edab0",
                                                "sense_id": "b7e7ab7a-8251-39cb-a4a4-26d381a89833",
                                                "text": "Il y avait des expositions de dents de toutes espèces, des blanches, des jaunes, des bleuâtres, des noires, des chicots de toutes formes, les uns débordant sur la lèvre, les autres battant en retraite dans les gencives."
                                            },
                                            {
                                                "example_id": "75f05813-2e39-49b1-973f-8f12137b7feb",
                                                "sense_id": "b7e7ab7a-8251-39cb-a4a4-26d381a89833",
                                                "text": "Il renversait la tête en arrière, avec un ait d’embarras comique. Nous apercevions les trous de son nez et sa bouche noire, pleine de chicots."
                                            },
                                            {
                                                "example_id": "b3f7f762-aec7-4f1e-bcca-a6c14cbad05b",
                                                "sense_id": "b7e7ab7a-8251-39cb-a4a4-26d381a89833",
                                                "text": "Mais le couteau, plus étroit que la masse qui sert à en assurer la chute, offre l'apparence dérisoire d'un taille-crayons; mieux, d'un chicot tranchant qui meublerait à lui seul la mâchoire d'un requin."
                                            },
                                            {
                                                "example_id": "90be5bb1-0cb4-4f4b-ae16-a7165d4a2164",
                                                "sense_id": "b7e7ab7a-8251-39cb-a4a4-26d381a89833",
                                                "text": "L’idée de pouvoir respirer lui permettait de lutter victorieusement contre l’affreuse grimace de cette bouche qui dévoilait jusqu’à la gencive ses chicots et ses dents pourries."
                                            },
                                            {
                                                "example_id": "847fbc32-44fa-435a-b4d2-26bb9d16192b",
                                                "sense_id": "b7e7ab7a-8251-39cb-a4a4-26d381a89833",
                                                "text": "Il se tut encore puis se mit à ricaner. Je détournai les yeux pour ne pas voir les deux chicots qu’il a gardés sur le devant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8752dae8-7424-38a2-8aed-629be68f8aa0",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "Ce qui reste à la base des anciens murs d’un édifice."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb3d0e2-af32-4dc3-8e07-99d5c670e168",
                                                "sense_id": "8752dae8-7424-38a2-8aed-629be68f8aa0",
                                                "text": "Le lieu, quoique très abrité par les frondaisons, était cependant aéré des vents du nord. Il avait, dans le temps, contenu une bergerie dont il restait encore quelques chicots de murs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1620e377-a31b-3159-ba6c-7031732c22a7",
                                        "entry_id": "b6e925e3-b5c0-3760-bfed-1bb70aa3a2d5",
                                        "glosses": [
                                            "En géomorphologie, type descriptif de formes d'érosion de certaines roches notamment granitoïdes ou carbonatées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
