                "senses": [
                    {
                        "sense_id": "05a26856-5ed9-368e-b6aa-23a39bee5dd0",
                        "entry_id": "ceea4126-bb01-3c7a-b588-6d5a4547920b",
                        "glosses": [
                            "Point médian de la suture naso-frontale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71c0c28-0618-45d2-b732-80ba15ca9741",
                                "sense_id": "05a26856-5ed9-368e-b6aa-23a39bee5dd0",
                                "text": "Faites une incision de 1,5 cm située à la partie haute du canthus interne (pointillés) et centrée sur le nasion."
                            },
                            {
                                "example_id": "a93131ce-33f1-49f1-908d-81c57293c6d3",
                                "sense_id": "05a26856-5ed9-368e-b6aa-23a39bee5dd0",
                                "text": "Tenez, essayez. Posez bien là, sur le nasion, le petit point de rencontre des sutures des os nasaux et frontal. Ça tient bien, n’est-ce pas, comme fait pour y placer notre instrument. La nature est belle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c79ff7f6-f2f0-4b67-9154-06ea3de5fa8c",
                        "source_entry_id": "ceea4126-bb01-3c7a-b588-6d5a4547920b",
                        "source_sense_id": "05a26856-5ed9-368e-b6aa-23a39bee5dd0",
