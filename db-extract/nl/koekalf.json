                        ],
                        "examples": [
                            {
                                "example_id": "52adbc2f-1166-4ec0-bb2d-dfe954a3ac1b",
                                "sense_id": "b65c9a8a-f853-33d5-83a7-247c587a9c55",
                                "text": "\"Melkkoeien moeten ieder jaar een kalfje krijgen om hun melkproductie op gang te houden. De koekalfjes zijn geld waard omdat ze melk kunnen gaan produceren, maar de stierkalfjes hebben minder waarde. Te lichte stierkalfjes zijn economisch niet rendabel en worden daarom meteen gedood.\""
                            },
                            {
                                "example_id": "fefeafcb-0bef-4fb1-b37d-e79a7d184ef3",
                                "sense_id": "b65c9a8a-f853-33d5-83a7-247c587a9c55",
                                "text": "Opwindender nog is Richmans jacht op de rode koekalveren die onontbeerlijk zijn voor een oud zuiveringsritueel dat nodig is om de Tempelberg te kunnen betreden."
                            }
                        ]
                    }
