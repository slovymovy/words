                        "entry_id": "9eaa9043-738f-3f35-81de-512fffa4a6eb",
                        "glosses": [
                            "jeden z rosyjskich pisarzy inteligenckich z lat 20., którzy poparli rewolucję październikową i późniejszą politykę bolszewików"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5642f131-a398-450d-a976-b49a69aa5e65",
                                "sense_id": "32fb6417-ba75-31b0-941c-896872990d75",
                                "text": "Wystarczało to komunistom i ich „poputczykom”, którzy wywierali w owych latach znaczny wpływ w wielu krajach europejskich"
                            }
                        ],
