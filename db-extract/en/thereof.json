                    {
                        "translation_id": "bee4b35b-9905-44a5-92e8-e46dda2395a3",
                        "source_entry_id": "23de073d-ad7c-3831-955f-2788d182e02c",
                        "source_sense_description": "of this, that, or it",
                        "target_lang_word": "davon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "davon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d082ca3-fdeb-3bda-8554-98dd03c5192d",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf einen bestimmten Ort; Entfernung ab da oder Ablösung, Trennung, Befreiung von dort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d23c7db-8b16-4b31-8ab4-18ee8547de68",
                                                "sense_id": "6d082ca3-fdeb-3bda-8554-98dd03c5192d",
                                                "text": "Viele Kilometer davon entfernt sahen wir das Unwetter."
                                            },
                                            {
                                                "example_id": "448b83ab-138e-4108-b9dd-b752bacc0e3c",
                                                "sense_id": "6d082ca3-fdeb-3bda-8554-98dd03c5192d",
                                                "text": "Der Hund war auf und davon."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b7b062c-691a-3a9e-a514-63bfe47066dc",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf einen bestimmten, abgesonderten Teil von etwas Zusammengehörigem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36451b73-591d-4d0c-ac67-97adbd7df4f4",
                                                "sense_id": "7b7b062c-691a-3a9e-a514-63bfe47066dc",
                                                "text": "Der erste Teil davon war besonders mühsam."
                                            },
                                            {
                                                "example_id": "36f52dfc-7544-4616-a9d8-8ac327ec5cde",
                                                "sense_id": "7b7b062c-691a-3a9e-a514-63bfe47066dc",
                                                "text": "Möchtest du vielleicht etwas davon abhaben?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2cca43f1-d562-3678-93d3-3ee8ff4150e3",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf Grund und Ursache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5c11753-a6f5-43ae-b4ad-652dd276ac6f",
                                                "sense_id": "2cca43f1-d562-3678-93d3-3ee8ff4150e3",
                                                "text": "Das kommt davon, dass du dir zu wenig Mühe gegeben hast."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5a746afc-daba-3771-a2ec-ca430c2477ef",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf das Material, die Komponenten, aus denen etwas gemacht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f46e73a1-a61e-46ff-b311-7d76645e0e96",
                                                "sense_id": "5a746afc-daba-3771-a2ec-ca430c2477ef",
                                                "text": "Schöne Wolle! Ich stricke dir Handschuhe davon."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1d280f6a-cf27-3f53-a36d-f990bc06e8c6",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf Verhältnisse, Zustände, Ereignisse, Handlungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9befdd3a-0ee8-4b47-a82b-9b6e1f7c1421",
                                                "sense_id": "1d280f6a-cf27-3f53-a36d-f990bc06e8c6",
                                                "text": "Davon haben wir nichts gewusst."
                                            },
                                            {
                                                "example_id": "2bb4e9a4-7f19-47b8-9acf-d12d3fe1ce55",
                                                "sense_id": "1d280f6a-cf27-3f53-a36d-f990bc06e8c6",
                                                "text": "[COVID-19-Pandemie:] „»Frauen in Führungspositionen leisten einen unverhältnismäßig guten Job im Umgang mit der Pandemie. Warum gibt es nicht mehr davon?«, fragt CNN.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "94685b73-ec59-326c-a129-66234b2c07d9",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf etwas, das sich in Sichtweite befindet, auf das man zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51835e19-5a46-4676-9c04-342843a25cda",
                                                "sense_id": "94685b73-ec59-326c-a129-66234b2c07d9",
                                                "text": "Ich hätte gern ein Stück davon."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "281fa3ba-c79a-3d5f-a71c-2908eb5ad5de",
                                        "entry_id": "aeed8fc8-f4fa-3f41-8b92-80da129864ee",
                                        "glosses": [
                                            "Bezugnahme auf Abstraktes"
                                        ],
                                        "tags": [
                                            "regional auch trennbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f05a49b9-5e4b-4fff-bf34-2b51f0dff81a",
                                                "sense_id": "281fa3ba-c79a-3d5f-a71c-2908eb5ad5de",
                                                "text": "trennbar: Da weiß ich nix von."
                                            },
                                            {
                                                "example_id": "cfd8a6a3-6160-4e61-9268-9a34d256707f",
                                                "sense_id": "281fa3ba-c79a-3d5f-a71c-2908eb5ad5de",
                                                "text": "trennbar: Da kann ich nichts von."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64997824-c4b0-4dfe-8d1b-dc41d8d7928d",
