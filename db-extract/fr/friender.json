                "senses": [
                    {
                        "sense_id": "e1699f64-b17c-3f10-89bc-5e9e0a093070",
                        "entry_id": "86119fc9-74f3-3ec3-a47a-777d73f0c2e3",
                        "glosses": [
                            "Inclure dans la liste de ses amis, sur un réseau social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb8440e-d586-470e-a06c-e12af9d82e18",
                                "sense_id": "e1699f64-b17c-3f10-89bc-5e9e0a093070",
                                "text": "Ils ont friendé un certain nombre de gens, parfois quelques uns de vos amis, et très peu de monde les a friendés en retour."
                            },
                            {
                                "example_id": "4907066f-d5d4-4a1c-9457-ebfae1719c1e",
                                "sense_id": "e1699f64-b17c-3f10-89bc-5e9e0a093070",
                                "text": "Merci de m'avoir friendée, je vais faire de même !"
                            },
                            {
                                "example_id": "6ed58dfc-0c32-42e4-a495-af24a9f44d3b",
                                "sense_id": "e1699f64-b17c-3f10-89bc-5e9e0a093070",
                                "text": "C'est vrai que ça fait bizarre, vu que je n'ai qu'une seule amie francophone friendée sur mon LJ, de voir que finalement, on est toutes au même endroit."
                            }
                        ]
                    }
