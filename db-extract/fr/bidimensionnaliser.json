                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668aa9fd-3e24-4dfc-932d-5667d9287342",
                                "sense_id": "9cab7e53-0fbc-3061-822a-4086cbaf5bb1",
                                "text": "Un effet stabilisant, lié à une décroissance des perturbations selon la direction de l'axe de rotation ; ainsi la rotation tend à bidimensionnaliser l'écoulement."
