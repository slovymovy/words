                                        "sense_id": "89b9fab5-9626-36dc-9066-ef5fe5d3a841",
                                        "entry_id": "39f18861-53b2-3f11-8676-f54d0a2a309b",
                                        "glosses": [
                                            "Qui est renvoyé par réflexion irrégulière."
