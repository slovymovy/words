                    {
                        "form_id": "ee5b4ceb-03db-4d26-baa9-1da501758cd7",
                        "entry_id": "c3b0bc04-14e3-36e8-b3a7-028f6c51d1a0",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "покачну́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a95d4e7-fb11-3976-bf82-855016fba8f5",
                        "entry_id": "c3b0bc04-14e3-36e8-b3a7-028f6c51d1a0",
                        "glosses": [
                            "качнуться слегка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b36eea68-070f-43ab-b0a8-7d8007275a52",
                                "sense_id": "1a95d4e7-fb11-3976-bf82-855016fba8f5",
                                "text": "Мы были уж на середине, в самой быстрине, когда она вдруг на седле покачнулась."
                            },
                            {
                                "example_id": "b7aed8b5-7bd2-4047-af51-319fced3402f",
                                "sense_id": "1a95d4e7-fb11-3976-bf82-855016fba8f5",
                                "text": "Князев успел зафиксировать тот факт, что Петрович больше не жилец на этом свете: одна пуля угодила Горохову в живот, а другая прямо в сердце; он покачнулся и упал."
                            }
                        ]
                    },
                    {
                        "sense_id": "e35156fa-72bc-3f70-8dc6-162e3e6642ae",
                        "entry_id": "c3b0bc04-14e3-36e8-b3a7-028f6c51d1a0",
                        "glosses": [
                            "разг. покривиться, покоситься"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389edf63-8302-4815-8dcd-6300e208a76f",
                                "sense_id": "e35156fa-72bc-3f70-8dc6-162e3e6642ae",
                                "text": "Крест, о котором говорилось выше, еще стоял на месте, но уже покачнулся."
                            },
                            {
                                "example_id": "f684512e-2e16-49d5-a074-2ebe6bb4fd61",
                                "sense_id": "e35156fa-72bc-3f70-8dc6-162e3e6642ae",
                                "text": "Трамбовка в жидком грунте не удалась, и столб осел в сторону, покачнулся."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ccd9717-287e-3a5e-a96f-801aa94fb502",
                        "entry_id": "c3b0bc04-14e3-36e8-b3a7-028f6c51d1a0",
                        "glosses": [
                            "перен., разг. пошатнуться, стать менее устойчивым, надёжным; измениться к худшему"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d168e46-06bf-40bc-b162-6f6be5dd67a2",
                                "sense_id": "2ccd9717-287e-3a5e-a96f-801aa94fb502",
                                "text": "Здоровье его, кажется, немного покачнулось."
                            }
                        ]
                    }
                ],
