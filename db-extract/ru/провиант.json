                    {
                        "translation_id": "137149f8-8957-48a6-8a20-2386458fd48b",
                        "source_entry_id": "023d8eaa-c01f-39f2-aead-9011e734051d",
                        "source_sense_id": "47540c20-dd11-398c-af61-0383a5ef0532",
                        "target_lang_word": "provision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41556717-d1ad-3c2f-ad93-7851e1804584",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "An item of goods or supplies, especially food, obtained for future use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "044dc8f1-7701-4169-8d65-0be85f893ad2",
                                                "sense_id": "41556717-d1ad-3c2f-ad93-7851e1804584",
                                                "text": "[H]e hath preſerued all points of Humanity, in taking Order, and making Proviſion for the Releefe of Strangers diſtreſſed; whereof you have taſted."
                                            },
                                            {
                                                "example_id": "f3822ab4-59ec-4f71-9e03-77bb6a7c7da3",
                                                "sense_id": "41556717-d1ad-3c2f-ad93-7851e1804584",
                                                "text": "[Noah] Began to build a Veſſel of huge bulk, / Meaſur'd by Cubit, length, and breadth, and highth, / Smeared round with Pitch, and in the ſide a dore, / Contriv'd, and of proviſions laid in large / For Man and Beaſt: [...]"
                                            },
                                            {
                                                "example_id": "57cf00f0-09bc-422c-a5de-c7a0937a3e3d",
                                                "sense_id": "41556717-d1ad-3c2f-ad93-7851e1804584",
                                                "text": "We have an infirm ſhip's company, and but five months proviſion, which muſt ſerve us to China unleſs we get a ſupply at Guam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "879d482f-bf18-38b5-a4b7-bca0ea59fdbb",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "The act of providing, or making previous preparation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe9c996-ee93-43b1-b5ad-9f2b9efc4b76",
                                                "sense_id": "879d482f-bf18-38b5-a4b7-bca0ea59fdbb",
                                                "text": "Fiue dayes we do allot thee for prouision,\nTo shield thee from disasters of the world,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb3200f2-795b-3645-8450-cc6525890e67",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "Money set aside for a future event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7208fbd-5670-41e3-8144-93a09f759acc",
                                                "sense_id": "bb3200f2-795b-3645-8450-cc6525890e67",
                                                "text": "And as congressional Republicans were passing a very unpopular Trump agenda bill last month, Vice President JD Vance argued that its historic expansion of Immigration and Customs Enforcement and new immigration enforcement provisions were so important that “everything else” was “immaterial.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f274ecc-3384-36da-8cb3-b96a50fcc4b8",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "A liability or contra account to recognise likely future adverse events associated with current transactions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29bef25c-2283-4015-bfa4-44d395ba2276",
                                                "sense_id": "8f274ecc-3384-36da-8cb3-b96a50fcc4b8",
                                                "text": "We increased our provision for bad debts on credit sales going into the recession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83eb8a0a-9d7d-3b02-9bc9-fc0866558a0c",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "A clause in a legal instrument, a law, etc., providing for a particular matter; stipulation; proviso."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65997da4-149d-4697-a02e-69c6122017bd",
                                                "sense_id": "83eb8a0a-9d7d-3b02-9bc9-fc0866558a0c",
                                                "text": "An arrest shall be made in accordance with the provisions of this Act."
                                            },
                                            {
                                                "example_id": "ce2103f2-3ffa-4b62-8266-f8bae2274ab0",
                                                "sense_id": "83eb8a0a-9d7d-3b02-9bc9-fc0866558a0c",
                                                "text": "Almost half of MEPs wanted to remove the new provisions' to expand the use of megatrucks but an amendment to do that failed to pass by just six votes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f7c68e-72bd-3d07-a3fc-8532a4ee1528",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "Regular induction into a benefice, comprehending nomination, collation, and installation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "967454ce-6ffe-3fcc-bdf4-b8e4a47eea16",
                                        "entry_id": "581a3b7a-2feb-3a3c-bb33-add9e4175f6e",
                                        "glosses": [
                                            "A nomination by the pope to a benefice before it became vacant, depriving the patron of his right of presentation."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2bef3f9-1e0f-4c09-8c6d-f868bcb1380b",
                                                "sense_id": "967454ce-6ffe-3fcc-bdf4-b8e4a47eea16",
                                                "text": "a papal provision"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "provision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3772f11c-835f-3e21-8726-606aa9806fcb",
                                        "entry_id": "1e810d14-6fb6-3b7c-b812-604f0499fe5e",
                                        "glosses": [
                                            "To supply with provisions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4490606-bf95-45f4-9142-c152626ba2f3",
                                                "sense_id": "3772f11c-835f-3e21-8726-606aa9806fcb",
                                                "text": "to provision an army"
                                            },
                                            {
                                                "example_id": "5e8070eb-e2d9-4221-ab8b-77ccb41456a1",
                                                "sense_id": "3772f11c-835f-3e21-8726-606aa9806fcb",
                                                "text": "We had soon touched land in the same place as before and set to provision the blockhouse. All three made the first journey, heavily laden, and tossed our stores over the palisade."
                                            },
                                            {
                                                "example_id": "942e7c97-fd01-410b-9670-c0ea0c62e61a",
                                                "sense_id": "3772f11c-835f-3e21-8726-606aa9806fcb",
                                                "text": "An emancipated slave must be provisioned by the master."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29df8aa-e15f-3427-b0dc-ae33848c5153",
                                        "entry_id": "1e810d14-6fb6-3b7c-b812-604f0499fe5e",
                                        "glosses": [
                                            "To supply (a user) with an account, resources, etc. so that they can use a system; to install the necessary software on a bare-bones system so it can be used for a specific purpose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c6b5081-6b13-46d6-89fd-02767596c3c0",
                                                "sense_id": "a29df8aa-e15f-3427-b0dc-ae33848c5153",
                                                "text": "A solution is to provision new systems on a private network where they can receive updates, patches, and secure configurations from an internal repository before being placed into a production network."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
