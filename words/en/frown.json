{
    "word_family": [
        "frowningly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0da77da0-21dd-32da-afa2-0d3ddec55086",
                    "sense_definition": "To contract the brow or wrinkle the forehead, often to show concentration, displeasure, or worry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "facial expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She began to <w>frown</w> in concentration as she tried to solve the difficult math problem.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>хмуриться</w> от сосредоточенности, пытаясь решить сложную математическую задачу."
                            }
                        },
                        {
                            "text": "The teacher would often <w>frown</w> at the students when they were being too noisy in class.",
                            "target_lang_translations": {
                                "ru": "Учитель часто <w>хмурился</w>, глядя на учеников, когда они слишком шумели в классе."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl"
                    ],
                    "antonyms": [
                        "smile"
                    ],
                    "common_phrases": [
                        "frown at someone",
                        "frown in concentration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдвигать брови или морщить лоб, часто выражая сосредоточенность, недовольство или беспокойство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмуриться",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "нахмуриться",
                                "target_lang_sense_clarification": "совершить действие"
                            },
                            {
                                "target_lang_word": "хмурить брови",
                                "target_lang_sense_clarification": "выражение лица"
                            },
                            {
                                "target_lang_word": "насупиться",
                                "target_lang_sense_clarification": "принять угрюмый вид"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ef4f980-b901-3028-b2ab-f4b909b3c76c",
                    "sense_definition": "To disapprove of something or to look upon it with disfavor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disapproval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using mobile phones during the formal dinner is generally <w>frowned</w> upon by the hosts.",
                            "target_lang_translations": {
                                "ru": "Использование мобильных телефонов во время официального ужина обычно <w>не одобряется</w> хозяевами."
                            }
                        },
                        {
                            "text": "The company tends to <w>frown</w> on employees who consistently arrive late to morning meetings.",
                            "target_lang_translations": {
                                "ru": "Компания склонна <w>отрицательно относиться</w> к сотрудникам, которые постоянно опаздывают на утренние совещания."
                            }
                        }
                    ],
                    "antonyms": [
                        "approve",
                        "encourage"
                    ],
                    "common_phrases": [
                        "frown upon",
                        "frown on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не одобрять что-либо или относиться к чему-либо с неприязнью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не одобрять",
                                "target_lang_sense_clarification": "выражать неодобрение"
                            },
                            {
                                "target_lang_word": "относиться отрицательно",
                                "target_lang_sense_clarification": "выражать дискомфорт или несогласие"
                            },
                            {
                                "target_lang_word": "смотреть косо",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1998d435-7d16-38bb-b0b5-6f2de0590871",
                    "sense_definition": "To express a specific feeling or message through the act of frowning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>frowned</w> his disagreement when the manager proposed the new budget cuts.",
                            "target_lang_translations": {
                                "ru": "Он <w>выразил</w> свое несогласие <w>хмурым видом</w>, когда менеджер предложил новое сокращение бюджета."
                            }
                        },
                        {
                            "text": "The director <w>frowned</w> his disapproval at the actor who forgot his lines again.",
                            "target_lang_translations": {
                                "ru": "Режиссер <w>нахмурился</w> в знак неодобрения в сторону актера, который снова забыл свои слова."
                            }
                        }
                    ],
                    "common_phrases": [
                        "frown one's disapproval",
                        "frown one's displeasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать определенное чувство или сообщение через нахмуривание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражать недовольство хмурым видом",
                                "target_lang_sense_clarification": "через мимику"
                            },
                            {
                                "target_lang_word": "нахмуриться в знак",
                                "target_lang_sense_clarification": "показать отношение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "460a69f6-6b35-396c-be7f-ed22fdcc6628",
                    "sense_definition": "A facial expression characterized by wrinkling the forehead and bringing the eyebrows together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "facial expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A deep <w>frown</w> appeared on his face as he read the confusing letter.",
                            "target_lang_translations": {
                                "ru": "На его лице появилось выражение <w>глубокого недовольства</w>, когда он читал это запутанное письмо."
                            }
                        },
                        {
                            "text": "She noticed a slight <w>frown</w> of worry on her mother's forehead during the conversation.",
                            "target_lang_translations": {
                                "ru": "Во время разговора она заметила на лбу матери легкую <w>морщинку</w> беспокойства."
                            }
                        }
                    ],
                    "synonyms": [
                        "scowl"
                    ],
                    "antonyms": [
                        "smile"
                    ],
                    "common_phrases": [
                        "slight frown",
                        "deep frown",
                        "frown of worry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение лица, характеризующееся сморщенным лбом и сведенными бровями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хмурый взгляд",
                                "target_lang_sense_clarification": "выражение глаз и лица"
                            },
                            {
                                "target_lang_word": "нахмуренные брови",
                                "target_lang_sense_clarification": "физическое проявление"
                            },
                            {
                                "target_lang_word": "гримаса недовольства",
                                "target_lang_sense_clarification": "выражение лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a53b53fe-3ce5-349a-bbb6-a3ede76a2536",
                    "sense_definition": "Any look or facial movement that conveys disapproval, displeasure, or a rebuke.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disapproval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boss gave him a stern <w>frown</w> when he walked into the office an hour late.",
                            "target_lang_translations": {
                                "ru": "Начальник одарил его <w>строгим взглядом</w>, когда тот вошел в офис с часовым опозданием."
                            }
                        },
                        {
                            "text": "Her silent <w>frown</w> was enough to tell him that she did not like the idea.",
                            "target_lang_translations": {
                                "ru": "Ее молчаливого <w>хмурого взгляда</w> было достаточно, чтобы понять: идея ей не понравилась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stern frown",
                        "silent frown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой взгляд или движение лица, передающее неодобрение, неудовольствие или упрек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недовольная мина",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "строгий взгляд",
                                "target_lang_sense_clarification": "выражение упрека"
                            },
                            {
                                "target_lang_word": "хмурое лицо",
                                "target_lang_sense_clarification": "общий вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}