                "senses": [
                    {
                        "sense_id": "1e3f677e-0139-3dc0-b9b0-cfb3334cf34d",
                        "entry_id": "f47b5e4d-9e8e-37b1-9bce-eb0a1eee974f",
                        "glosses": [
                            "regelmäßige Geldzahlungen der Altersvorsorge an Parlamentsabgeordnete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306b5ed0-8d9b-4003-a87d-e985c550b54f",
                                "sense_id": "1e3f677e-0139-3dc0-b9b0-cfb3334cf34d",
                                "text": "„Dazu ist für \"Landtagler\" ausverhandelt, daß es grundsätzlich keine Abgeordnetenpension mehr geben soll.“"
                            },
                            {
                                "example_id": "ed4b5759-8f95-4caf-9e3e-d1afdb17a1a8",
                                "sense_id": "1e3f677e-0139-3dc0-b9b0-cfb3334cf34d",
                                "text": "„Oettinger erhielt große Zustimmung für seine Erklärung, dass im Falle seiner Wahl mit ihm der Abbau der Abgeordnetenpensionen zu machen sei.“"
                            },
                            {
                                "example_id": "525534a8-cbe2-4f83-9a63-90bbb0e1b166",
                                "sense_id": "1e3f677e-0139-3dc0-b9b0-cfb3334cf34d",
                                "text": "„Ex-Parlamentarier im Rentenalter bekommen zudem eine Abgeordnetenpension, die sich ebenfalls nach den Jahren im Bundestag richtet.“"
                            },
                            {
                                "example_id": "c530129b-8f8d-4b13-ad84-06bfc4fb7678",
                                "sense_id": "1e3f677e-0139-3dc0-b9b0-cfb3334cf34d",
                                "text": "„Anspruch auf eine Abgeordnetenpension, so bestimmt es das Abgeordnetengesetz, besteht erst nach sechs Jahren Zugehörigkeit.“"
                            },
                            {
                                "example_id": "55049dce-5801-44d2-83b2-f8cd503ebe98",
                                "sense_id": "1e3f677e-0139-3dc0-b9b0-cfb3334cf34d",
                                "text": "„Und zwar, dass die Reform der Abgeordnetenpensionen nur für künftige Abgeordnete gelten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
