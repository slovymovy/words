                "senses": [
                    {
                        "sense_id": "c9cb328e-73a8-3eb1-8ab4-2ca6ed445340",
                        "entry_id": "5129fd33-b24f-368d-bd9f-49dc449fb1d4",
                        "glosses": [
                            "Faire quitter la crèche à (du bétail)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe66075-580e-4db1-9c5e-01102790aae2",
                                "sense_id": "c9cb328e-73a8-3eb1-8ab4-2ca6ed445340",
                                "text": "D’autre part, certains exploitants (les plus engagés dans la production fromagère) apprécient peu de devoir attendre la montée du troupeau de village sur le communal pour « décrécher » leurs vaches."
                            },
                            {
                                "example_id": "aca3d328-c521-48b2-833c-f0f40e4174df",
                                "sense_id": "c9cb328e-73a8-3eb1-8ab4-2ca6ed445340",
                                "text": "Les narcisses, ils les cueillent au petit matin, avant même de décrécher les vaches (peut-être cela leur permet-il de braconner)."
                            }
                        ]
                    }
