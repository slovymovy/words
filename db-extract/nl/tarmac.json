                        "examples": [
                            {
                                "example_id": "5904886e-3d7a-4276-bb52-55862ed82fc4",
                                "sense_id": "cd2f0ef9-7191-3cc8-80d6-568693fb0940",
                                "text": "Hoe prozaïsch, hoe weinig metafysisch is de grenservaring van de asielzoeker die strandt op Schiphol, die even zijn voeten mag warmen op de drempel van een ander leven, maar al snel op zijn half opgewarmde voeten wandelen gestuurd wordt, het tarmac op, het vliegtuig in."
                            }
                        ]
                    },
