                ],
                "senses": [
                    {
                        "sense_id": "c47ae728-735b-3303-94c6-91785363890f",
                        "entry_id": "805be2fc-9844-3124-9fec-67aea5f07b7b",
                        "glosses": [
                            "Provoquer la cirrhose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc6cba3-65a2-477e-a31d-a1cf7f101c06",
                                "sense_id": "c47ae728-735b-3303-94c6-91785363890f",
                                "text": "Devenir obèse de l’âme, gorger son corps de plaisirs, « cirrhoser » son cœur de voluptés, avoir l’âme toute grasse d’envies impardonnables…"
                            },
                            {
                                "example_id": "514a2cf2-e17d-480e-8aae-beed53c3c92d",
                                "sense_id": "c47ae728-735b-3303-94c6-91785363890f",
                                "text": "Dans son sommeil, il s’était roulé jusque-là et avait continué à boire. Sans cesser. À s’en fissurer la panse, à s’en cirrhoser le foie, à m’en cirrhoser la foi."
                            },
                            {
                                "example_id": "9d5a31bb-2971-4774-9125-6d0a25eb1d4b",
                                "sense_id": "c47ae728-735b-3303-94c6-91785363890f",
                                "text": "Un foie malade, c’est une foie qui s’est cirrhosé !"
                            }
                        ]
                    }
