                                    },
                                    {
                                        "sense_id": "4e0a55c3-71c8-3ca2-be34-0053b30d8795",
                                        "entry_id": "12503837-cfcf-3442-baec-c42790034b4c",
                                        "glosses": [
                                            "A group of products or services sold together as a unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541721b1-8940-4c48-aebc-e7c26ab93f35",
                                                "sense_id": "4e0a55c3-71c8-3ca2-be34-0053b30d8795",
                                                "text": "This software bundle includes a wordprocessor, a spreadsheet, and two games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbabf75d-3fad-3571-8238-bf651e56451c",
                                        "entry_id": "12503837-cfcf-3442-baec-c42790034b4c",
                                        "glosses": [
                                            "A large amount, especially of money."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "414fdd98-229a-42fa-bc22-f39588ca5b87",
                                                "sense_id": "bbabf75d-3fad-3571-8238-bf651e56451c",
                                                "text": "The inventor of that gizmo must have made a bundle."
                                            },
                                            {
                                                "example_id": "ed513cd2-33b3-48aa-927b-a2a3d5a374bb",
                                                "sense_id": "bbabf75d-3fad-3571-8238-bf651e56451c",
                                                "text": "I mean it's nothing for him to go to the races, do a bundle, and come home laughing and joking like nothing's happened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e42b88-9efe-3ab4-bf6f-e6f6de603c2c",
                                        "entry_id": "12503837-cfcf-3442-baec-c42790034b4c",
                                        "glosses": [
