            {
                "entry_id": "91fe05d0-51e9-32cc-8369-2fc5aed7f459",
                "word": "bekennend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac694d70-3caf-3386-aaec-9c688abf4f7b",
                        "entry_id": "91fe05d0-51e9-32cc-8369-2fc5aed7f459",
                        "glosses": [
                            "van een persoon dat hij erkent iets verkeerds gedaan te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "292c3d03-d4d0-4e0d-9804-f555581ddb34",
                                "sense_id": "ac694d70-3caf-3386-aaec-9c688abf4f7b",
                                "text": "De officier van justitie zou dan vooraf via de advocaten afspraken kunnen maken met bekennende verdachten over de hoogte van de straf. De rechter beslist dan over deze afspraak. Het voordeel is dat het strafrechtelijk onderzoek en het strafproces dan korter kunnen worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac087c41-bcb1-370f-8218-ea45aec58fe9",
                        "entry_id": "91fe05d0-51e9-32cc-8369-2fc5aed7f459",
                        "glosses": [
                            "van een verklaring dat men daarin toegeeft iets verkeerds gedaan te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9485b2-b267-48e6-bf1a-9cc2241a4684",
                                "sense_id": "ac087c41-bcb1-370f-8218-ea45aec58fe9",
                                "text": "Een psychiater heeft de verdachte inmiddels verminderd toerekeningsvatbaar verklaard. Volgens zijn raadsman lijdt hij aan psychoses. Dat de verdachte eerder een bekennende verklaring heeft afgelegd, die hij later weer ontkrachtte, moet volgens hem in dat verband worden gezien."
                            }
                        ]
                    }
