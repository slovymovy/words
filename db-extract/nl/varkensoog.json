                        "examples": [
                            {
                                "example_id": "8d7721f7-30d9-4732-b92b-177c5edc225c",
                                "sense_id": "f8d8c9d2-5bda-3456-939a-d764d6e388aa",
                                "text": "De spleetjes van haar varkensogen met gezwollen oogleden gingen nauwelijks open."
                            },
                            {
                                "example_id": "acf9943a-29b5-4472-9eb9-34e435ff64da",
                                "sense_id": "f8d8c9d2-5bda-3456-939a-d764d6e388aa",
                                "text": "Die geuzennaam veranderde echter in de jaren zestig van de ontzuiling en ontkerkelijking tot een vies woord in de mond van afvalligen als Maarten ’t Hart. ”Griffermeerd”, ”kalvinistisch”: „herenboeren in zwarte pakken (…) harde verweerde koppen afgedekt met een zwart zijden pet. Voor deze mensen is het calvinisme uitgedacht, deze mannen met dunne lippen, met varkensoogjes en vlekkerige rode wangen.”"
                            }
                        ]
                    }
