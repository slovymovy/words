                                        "glosses": [
                                            "Personne qui en remplace une autre dans une fonction, dans une occupation quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18dfc51d-493e-449b-8ffe-035cbb8bed33",
                                                "sense_id": "fbb5ebe6-547c-3bb8-916b-6e3c8802111f",
                                                "text": "La remplaçante de Mme Jupillon, partie pour aller tenir une épicerie à Bar-sur-Aube, la nouvelle crémière lui passait son mauvais lait, […]"
