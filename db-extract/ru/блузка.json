                                        "entry_id": "45695e26-e9ec-3add-a06f-0e7c188e0c76",
                                        "glosses": [
                                            "horní samostatná část ženskéhoho oděvu z lehké látky"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c951bd-68fd-4331-824c-6a5bb62d9bb5",
                                                "sense_id": "8c388baa-1ec2-3ffb-b82c-fd58fa8b5dfb",
                                                "text": "To se ví, dali jsme do novin, že se našla ženská mrtvola, stáří asi dvacet pět let, šedivá sukně a proužkovaná blůza, a jestli se nějaká služebná asi dva měsíce pohřešuje, tak ať se to oznámí na policii."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9965cd87-c8d4-325a-a665-45fcc4b502a7",
                                        "entry_id": "45695e26-e9ec-3add-a06f-0e7c188e0c76",
                                        "glosses": [
                                            "kabát od pracovního nebo sportovního oděvu nebo uniformy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497cbd16-e1c5-495f-a778-fb29ba94327f",
                                                "sense_id": "9965cd87-c8d4-325a-a665-45fcc4b502a7",
                                                "text": "Ohromná blůza se záplatami na loktech, zamaštěná a špinavá, klátila se na Švejkovi jako kabát na hastrošovi."
                                            }
                                        ]
                                    }
