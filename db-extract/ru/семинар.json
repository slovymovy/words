                    },
                    {
                        "translation_id": "b178a30e-a625-4edf-85fe-e40d19bff216",
                        "source_entry_id": "7a6295f0-d426-3fdb-9c4f-351ee9cc1e72",
                        "source_sense_id": "15291572-fced-3cf7-b4f1-5b55589e40c6",
                        "target_lang_word": "講座",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cef647bc-7277-4ccc-8cf5-42103314ec31",
                        "source_entry_id": "7a6295f0-d426-3fdb-9c4f-351ee9cc1e72",
                        "source_sense_id": "15291572-fced-3cf7-b4f1-5b55589e40c6",
                        "target_lang_word": "讲座",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "98c2ec3c-7430-4e86-8173-7d895e02592e",
                        "source_entry_id": "7a6295f0-d426-3fdb-9c4f-351ee9cc1e72",
                        "source_sense_id": "15291572-fced-3cf7-b4f1-5b55589e40c6",
                        "target_lang_word": "séminaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séminaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "241d89ca-c726-37a6-8878-d5802de4a844",
                                        "entry_id": "8a5aeb4e-365b-30e5-aad3-24d293ed8cf2",
                                        "glosses": [
                                            "Établissement religieux où l’on prépare les jeunes clercs à recevoir les ordres sacrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e0e8aef-5992-4b0b-a3fa-822c41eaccba",
                                                "sense_id": "241d89ca-c726-37a6-8878-d5802de4a844",
                                                "text": "Le prix des matières premières étant peu considérable, la procure d'un séminaire pourrait livrer les pains d’autel à meilleur marché que ne le font les laïques , et ce serait un revenu net et assuré, que l'on pourrait appliquer à la fondation de quelques bourses."
                                            },
                                            {
                                                "example_id": "b410b1d5-1d38-4f89-a72e-274abd367c84",
                                                "sense_id": "241d89ca-c726-37a6-8878-d5802de4a844",
                                                "text": "Malgré de sensibles défauts, malgré l’humilité de son origine, ce fils de paysans et de pauvres marins, couvert du triple ridicule d’échappé de séminaire, de clerc défroqué, de cuistre endurci, on l’a tout d’abord accueilli, écouté, choyé même, uniquement parce qu’on trouvait dans sa voix des accents sincères."
                                            },
                                            {
                                                "example_id": "dcd3d224-a15e-4575-b4d2-30c62ea3b34b",
                                                "sense_id": "241d89ca-c726-37a6-8878-d5802de4a844",
                                                "text": "Le séminaire était une prison dont les gardiens portaient des robes de bure."
                                            },
                                            {
                                                "example_id": "5f68285c-c21d-406e-a188-e8cc30a3a416",
                                                "sense_id": "241d89ca-c726-37a6-8878-d5802de4a844",
                                                "text": "Le séminaire de tel diocèse, de Saint-Sulpice, de missions étrangères."
                                            },
                                            {
                                                "example_id": "e96783b8-f272-477e-9d54-5142ac5f5fd1",
                                                "sense_id": "241d89ca-c726-37a6-8878-d5802de4a844",
                                                "text": "Petit séminaire, établissement religieux d’enseignement secondaire, où l’on élève les enfants principalement en vue du recrutement du clergé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004f13bf-5286-3d73-818e-124da0046c2a",
                                        "entry_id": "8a5aeb4e-365b-30e5-aad3-24d293ed8cf2",
                                        "glosses": [
                                            "Ensemble des ecclésiastiques et des élèves qui demeurent dans un séminaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c66d4241-d0e9-48ba-9867-ad8c150c2224",
                                                "sense_id": "004f13bf-5286-3d73-818e-124da0046c2a",
                                                "text": "Tout le séminaire assistait à ce sermon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0c810bd-3aad-3aa3-8271-e4e18ffb78ae",
                                        "entry_id": "8a5aeb4e-365b-30e5-aad3-24d293ed8cf2",
                                        "glosses": [
                                            "Temps déterminé qu’on doit passer dans un séminaire pour être admis aux ordres sacrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4233a769-a307-4479-b3a5-6888f9eb0bdf",
                                                "sense_id": "f0c810bd-3aad-3aa3-8271-e4e18ffb78ae",
                                                "text": "Il commence, il finit son séminaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16d254a-2199-35df-8070-57a3fc755a16",
                                        "entry_id": "8a5aeb4e-365b-30e5-aad3-24d293ed8cf2",
                                        "glosses": [
                                            "Établissement où l’on se forme à une profession quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67e483b7-5653-49fd-88a2-c29d68d7d76c",
                                                "sense_id": "b16d254a-2199-35df-8070-57a3fc755a16",
                                                "text": "Cette école est un séminaire de bon officiers."
                                            },
                                            {
                                                "example_id": "67382f45-d946-4b3c-9de4-e72b8f2c9ee8",
                                                "sense_id": "b16d254a-2199-35df-8070-57a3fc755a16",
                                                "text": "Cet établissement est un séminaire d’excellents ouvriers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7049a78-2f61-3be6-8dad-60316adffd1c",
                                        "entry_id": "8a5aeb4e-365b-30e5-aad3-24d293ed8cf2",
                                        "glosses": [
                                            "Groupe d'étudiants suivant un enseignement sur un thème particulier ou effectuant un travail pratique de recherche sous la direction d'un enseignant ; ensemble des séances de ce groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0fadbfb-fcb9-433a-9538-d67111d07f2a",
                                                "sense_id": "b7049a78-2f61-3be6-8dad-60316adffd1c",
                                                "text": "Je n’ai jamais rien appris à l’université, alors que durant les deux premières années du séminaire de Devereux, je n’ai fait qu’apprendre. En deux ans, j’ai comblé cinq ans de vacuité universitaire"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4236809d-e63a-35e6-9d1c-5ccbfc850e16",
                                        "entry_id": "8a5aeb4e-365b-30e5-aad3-24d293ed8cf2",
                                        "glosses": [
                                            "Réunion de professionnels en vue de l’étude d’un sujet particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a0770e-bb90-4aa4-a9ab-889b26cdd181",
                                                "sense_id": "4236809d-e63a-35e6-9d1c-5ccbfc850e16",
                                                "text": "Au début des années 30, ce qui ne se nommait pas encore colloque, séminaire ou symposium, mais tout bêtement débat, commençait à prospérer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
