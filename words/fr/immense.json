                {
                    "sense_id": "86b6a1a6-eae3-3fa6-9dbf-6d982a2e89ed",
                    "sense_definition": "Qui est sans borne, sans limite ou d'une grandeur infinie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "infini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les philosophes s'interrogent souvent sur la nature d'un univers <w>immense</w> et sans fin.",
                            "target_lang_translations": {
                                "en": "Philosophers often wonder about the nature of a <w>boundless</w> universe without end.",
                                "ru": "Философы часто размышляют о природе <w>безграничной</w> Вселенной, не имеющей конца.",
                                "nl": "Filosofen piekeren vaak over de aard van een <w>grenzeloos</w> heelal zonder einde.",
                                "de": "Philosophen grübeln oft über die Natur eines <w>grenzenlosen</w> Universums, das kein Ende hat.",
                                "pl": "Filozofowie często zastanawiają się nad naturą <w>bezkresnego</w> wszechświata.",
                                "it": "I filosofi si interrogano spesso sulla natura di un universo <w>sconfinato</w> e senza fine.",
                                "cs": "Filozofové se často zamýšlejí nad povahou <w>nekonečného</w> vesmíru bez konce.",
                                "tr": "Filozoflar çoğu zaman bu <w>sonsuz</w> ve bitmeyen evrenin doğasını sorgular.",
                                "es": "Los filósofos se preguntan a menudo por la naturaleza de un universo <w>inmenso</w> y sin fin.",
                                "zh": "哲学家们常常思考一个<w>无限</w>而没有尽头的宇宙的本质。"
                            }
                        },
                        {
                            "text": "Pour de nombreux croyants, Dieu est un être <w>immense</w> qui dépasse l'entendement humain.",
                            "target_lang_translations": {
                                "en": "For many believers, God is an <w>infinite</w> being who surpasses human understanding.",
                                "ru": "Для многих верующих Бог — <w>бесконечное</w> существо, которое превосходит человеческое понимание.",
                                "nl": "Voor veel gelovigen is God een <w>oneindig</w> wezen dat het menselijk begrip te boven gaat.",
                                "de": "Für viele Gläubige ist Gott ein <w>unermessliches</w> Wesen, das den menschlichen Verstand übersteigt.",
                                "pl": "Dla wielu wierzących Bóg jest <w>nieskończoną</w> istotą, która przekracza ludzkie pojęcie.",
                                "it": "Per molti credenti Dio è un essere <w>immenso</w> che supera la comprensione umana.",
                                "cs": "Pro mnohé věřící je Bůh <w>nekonečná</w> bytost, která přesahuje lidské chápání.",
                                "tr": "Pek çok inanana göre Tanrı, insan aklının kavrayışını aşan <w>sonsuz</w> bir varlıktır.",
                                "es": "Para muchos creyentes, Dios es un ser <w>infinito</w> que trasciende la comprensión humana.",
                                "zh": "对许多信徒来说，上帝是一个<w>无限</w>的存在，超越了人类的理解。"
                            }
                        }
