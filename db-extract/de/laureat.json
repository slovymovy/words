                "senses": [
                    {
                        "sense_id": "8392c431-d888-3613-b0e2-30cbb89930c7",
                        "entry_id": "87e858d8-3f11-3541-a168-f7fe220c1394",
                        "glosses": [
                            "Wissenschaftler oder Künstler, der mit einem Preis ausgezeichnet worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d1213fc-0ca5-4f4c-8514-1f4a5e8b35f7",
                                "sense_id": "8392c431-d888-3613-b0e2-30cbb89930c7",
                                "text": "„Die jungen Wissenschaftler begegnen acht Laureaten des Alfred-Nobel-Gedächtnispreises, der weltweit höchsten Auszeichnung der Wirtschaftswissenschaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ac3b1a72-5d4c-3131-98e7-df21b5aa2e46",
                        "entry_id": "87e858d8-3f11-3541-a168-f7fe220c1394",
                        "glosses": [
                            "jemand, der eine öffentliche Auszeichnung erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "062afec8-a66d-4997-88aa-0eba7b49c91b",
                                "sense_id": "ac3b1a72-5d4c-3131-98e7-df21b5aa2e46",
                                "text": "Am 15. September 2011 haben 3 Laureaten des 9. Internationalen Rotary Wettbewerbs in Moskau ein Konzert im Generalkonsulat der Russischen Föderation in Bonn gegeben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d66fc2c6-c909-466d-8aa3-1e09cb54fad7",
                        "source_entry_id": "87e858d8-3f11-3541-a168-f7fe220c1394",
                        "source_sense_id": "8392c431-d888-3613-b0e2-30cbb89930c7",
                        "source_sense_description": "Wissenschaftler oder Künstler, der mit einem Preis ausgezeichnet worden ist",
