{
    "word_family": [
        "quadrilaterally",
        "lateral"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36915711-38b7-395c-a729-3d99093b4aad",
                    "sense_definition": "A flat geometric shape or polygon with four straight sides and four angles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry_four_sided",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A square is a special kind of <w>quadrilateral</w> with equal sides.",
                            "target_lang_translations": {
                                "zh": "正方形是一种边长相等的特殊<w>四边形</w>。"
                            }
                        },
                        {
                            "text": "The geometry teacher asked the students to calculate the internal angles of a <w>quadrilateral</w>.",
                            "target_lang_translations": {
                                "zh": "几何老师让学生计算一个<w>四边形</w>的内角。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quadrangle",
                        "tetragon"
                    ],
                    "common_phrases": [
                        "irregular quadrilateral",
                        "convex quadrilateral"
                    ],
                    "target_lang_definitions": {
                        "zh": "有四条直边和四个角的平面几何图形或多边形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四边形",
                                "target_lang_sense_clarification": "几何学名词，指有四条边的平面图形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc0282c-7117-3249-b563-0ed9b08799df",
                    "sense_definition": "A defensive military area protected by four fortified strongholds supporting one another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Austrian army retreated into the defensive <w>quadrilateral</w> after the battle.",
                            "target_lang_translations": {
                                "zh": "战后，奥地利军队撤退到了防御性的<w>四角防区</w>内。"
                            }
                        },
                        {
                            "text": "The Venetian <w>quadrilateral</w> comprised four key fortresses located across the northern plains.",
                            "target_lang_translations": {
                                "zh": "威尼斯<w>四角防区</w>由分布在北部平原的四个关键要塞组成。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "由四个相互策应的要塞防护的军事防御区域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四角防区",
                                "target_lang_sense_clarification": "军事防御体系，由四个要塞组成的区域"
                            },
                            {
                                "target_lang_word": "四要塞要区",
                                "target_lang_sense_clarification": "由四个防御要塞构成的防御阵地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bd112b9e-5341-333e-9870-b7bff5b9e533",
                    "sense_definition": "Having four sides or four edges.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry_four_sided",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed a <w>quadrilateral</w> courtyard surrounded by concrete walkways.",
                            "target_lang_translations": {
                                "zh": "建筑师设计了一个被混凝土步道环绕的<w>四边形</w>庭院。"
                            }
                        },
                        {
                            "text": "Each student drew a <w>quadrilateral</w> figure on their graph paper.",
                            "target_lang_translations": {
                                "zh": "每个学生都在坐标纸上画了一个<w>四边</w>图形。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quadrilateral shape",
                        "quadrilateral figure"
                    ],
                    "target_lang_definitions": {
                        "zh": "有四条边或四条棱的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "四边的",
                                "target_lang_sense_clarification": "具有四条边的"
                            },
                            {
                                "target_lang_word": "四边形的",
                                "target_lang_sense_clarification": "呈四边形形状的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}