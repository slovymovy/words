                {
                    "sense_id": "ed94aaa0-4a19-3f6f-9085-eb022647a973",
                    "sense_definition": "In a manner that happens before the expected or natural time; too soon.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>prematurely</w> announce the new product before it was ready.",
                            "target_lang_translations": {
                                "zh": "公司决定在产品准备好之前<w>过早地</w>发布了新产品。"
                            }
                        },
                        {
                            "text": "He <w>prematurely</w> ended the meeting because he felt early departure was necessary.",
                            "target_lang_translations": {
                                "zh": "他因为觉得有必要早点离开，所以<w>提前</w>结束了会议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "early",
                        "untimely"
                    ],
                    "antonyms": [
                        "belatedly"
                    ],
                    "common_phrases": [
                        "prematurely end",
                        "prematurely announce"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在预期或自然时间之前发生，即过早地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "过早地",
