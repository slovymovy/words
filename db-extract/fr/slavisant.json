                "senses": [
                    {
                        "sense_id": "0f60b969-d888-300b-93ab-f87680cacc8b",
                        "entry_id": "23c189c1-528d-33e4-89d4-e6bf080fcd3b",
                        "glosses": [
                            "linguist specialized in Slavic languages"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "90b6d521-cb06-4929-8d39-15dda0f0b3e2",
                                "sense_id": "0f60b969-d888-300b-93ab-f87680cacc8b",
                                "text": "Les slavisants, qui, au cours de ces dernières 20 annés, se sont occupés ou s'occupent des questions de la naissance, de la filiation et de la reconstruction des textes vieux-slaves, se trouvent fréquemment embarrassés par le grand nombre de variantes des différents textes.",
                                "translation": "Slavic scholars, who, over the past 20 years, have dealt with or are dealing with questions about the birth, ancestry, and the reconstruction of Old Slavic texts, frequently find themselves embarrassed by the large number of variants of different texts.",
                                "english": "Slavic scholars, who, over the past 20 years, have dealt with or are dealing with questions about the birth, ancestry, and the reconstruction of Old Slavic texts, frequently find themselves embarrassed by the large number of variants of different texts."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
