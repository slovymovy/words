                ],
                "senses": [
                    {
                        "sense_id": "c6f5d400-bd34-36fa-b4fe-3b711155bbfc",
                        "entry_id": "a84a61bd-ac3e-3850-9eb0-c83bc2b9446c",
                        "glosses": [
                            "Fait de dénigrer, médisance."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "17b452d5-1131-4de2-a60a-6d1509af25c0",
                                "sense_id": "c6f5d400-bd34-36fa-b4fe-3b711155bbfc",
                                "text": "A certains soirs, aucun n’osait s’en aller, à la pensée du débinage qui suivrait son départ !"
                            },
                            {
                                "example_id": "cb8cff9a-8ff0-44cb-85e4-d1365eee16e2",
                                "sense_id": "c6f5d400-bd34-36fa-b4fe-3b711155bbfc",
                                "text": "Il lui arrivait de se livrer à des énormités de débinage, qui risquaient de le rendre odieux ; parfois, c’étaient des enfantillages qui lui donnaient une pointe de ridicule."
                            },
                            {
                                "example_id": "b20f0bfd-f484-4364-a58c-629df6a69e81",
                                "sense_id": "c6f5d400-bd34-36fa-b4fe-3b711155bbfc",
                                "text": "Montaigne a bien reconnu, même glosé, sa tendance au \"débinage\" de soi."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3cd7608-4cc7-3b3b-b436-2be2afbb5c8a",
                        "entry_id": "a84a61bd-ac3e-3850-9eb0-c83bc2b9446c",
                        "glosses": [
                            "Fait de révéler à un non-magicien le secret d’un tour."
                        ],
                        "tags": [
                            "Prestidigitation"
                        ],
                        "examples": [
                            {
                                "example_id": "408608c2-edb3-4485-9aaf-44dca6010c47",
                                "sense_id": "f3cd7608-4cc7-3b3b-b436-2be2afbb5c8a",
                                "text": "Le débinage peut être volontaire en violation de la règle déontologique en usage dans ce domaine ou involontaire par maladresse en ratant l’exécution du tour."
                            }
                        ]
                    },
                    {
                        "sense_id": "1460158e-f999-380c-9c1a-f11e2c4817ce",
                        "entry_id": "a84a61bd-ac3e-3850-9eb0-c83bc2b9446c",
                        "glosses": [
                            "Le fait de donner à la vigne un second binage, pour en enlever les mauvaises herbes."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "a250b314-85a9-4764-8773-6667fce675a3",
                                "sense_id": "1460158e-f999-380c-9c1a-f11e2c4817ce",
                                "text": "Le bio marque le grand retour du travail mécanique : labourage, décavaillonnage (retirer la terre sous les ceps), « débinage interceps » avec des lames fixées au tracteur où à la main comme avant !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
