                ],
                "senses": [
                    {
                        "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                        "entry_id": "ffa87e67-77cc-3a8b-80b0-d9520f37d061",
                        "glosses": [
                            "bewegendes, innerlich erregendes Lied, das jemandes Schicksal/Leben widerspiegelt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "0f715725-2d4b-46db-9179-50c993e04a9f",
                                "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                                "text": "„Wie eine gehauchte Schicksalsmelodie verhallt der Satz in die beinah atemlose Stille.“"
                            },
                            {
                                "example_id": "4f8d514c-49dc-46bb-8b4b-7137b7ff3e56",
                                "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                                "text": "„So klingt der Blues dann irgendwie wie eine Schicksalsmelodie und lässt den Hörer deutlich fühlen, wie Emotionen in ihm wühlen.“"
                            },
                            {
                                "example_id": "23b0dd4e-e2e7-4085-a0a9-c0b7057d542f",
                                "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                                "text": "„Da Sven sein bisheriges Leben fast dauerfrustriert verbracht hatte, war Heavy Metal zu seiner Schicksalsmelodie geworden.“"
                            },
                            {
                                "example_id": "80efc95b-fbcc-4d0c-9aa9-936526892176",
                                "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                                "text": "„Kleine Schicksalsmelodie, deinen Noten entspringt Poesie, manchmal laut, mal sehnsuchtsvoll, suchst meine Seele, in Dur und Moll.“"
                            },
                            {
                                "example_id": "c1db6aa3-2df7-488a-bc95-09eb1f8975d6",
                                "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                                "text": "„Bald erklingt die Musik, eine Melodie, die ihnen Schicksalsmelodie geworden ist.“"
                            },
                            {
                                "example_id": "b74868da-607d-43e0-8e06-453cf0fb64be",
                                "sense_id": "3c6d96a1-3466-30a6-b940-d0cb9bae9679",
                                "text": "„Die Schicksalsmelodie meines Lebens spielte schlagartig traurige Musik, nachdem du mich aus deinem Leben verbannt hattest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
