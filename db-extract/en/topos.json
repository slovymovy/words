                    {
                        "translation_id": "daec978c-5243-4fd4-9bfd-221e4a1f88f3",
                        "source_entry_id": "871df609-1987-3649-bd8e-3ae0fe792a6e",
                        "source_sense_description": "literary theme",
                        "target_lang_word": "Topos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Topos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb5fb691-af92-3f68-8533-5ae8a4d5ebab",
                                        "entry_id": "8f5c9609-6b21-34ab-a58c-fc836b1172f1",
                                        "glosses": [
                                            "feststehendes, durchgängiges Schema/Argumentationsmuster/Bild/Motiv oder Ähnliches"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba6f7822-14c9-4acc-b9b5-5179d7354090",
                                                "sense_id": "fb5fb691-af92-3f68-8533-5ae8a4d5ebab",
                                                "text": "„Um das Ganze dann der Situation anzupassen, in der Fabius zunächst ausschliesslich mit den Samniten kämpft, wird der gallische Topos einfach auf sie übertragen.“"
                                            },
                                            {
                                                "example_id": "f8d709b1-b452-4e28-9042-e1931afdba89",
                                                "sense_id": "fb5fb691-af92-3f68-8533-5ae8a4d5ebab",
                                                "text": "„Kein anderer Erdteil wurde aus europäischer Perspektive so eng mit einem einzigen Topos verbunden.“"
                                            },
                                            {
                                                "example_id": "6347e4fa-fd7d-4818-ae05-12d11d7400bd",
                                                "sense_id": "fb5fb691-af92-3f68-8533-5ae8a4d5ebab",
                                                "text": "„Sie erzählte ihrem Sohn später dann im amerikanischen Pittsburgh zeitlebens idealisierte Geschichten aus ihrem Dorfleben, die sich an die nationalrevolutionären Topoi der Verklärung des Gewöhnlichen angelehnt haben.“"
                                            },
                                            {
                                                "example_id": "bf02789c-8bf7-4cc0-83df-4285877564d9",
                                                "sense_id": "fb5fb691-af92-3f68-8533-5ae8a4d5ebab",
                                                "text": "„Die Topos-Forschung hat lange Zeit ausschließlich auf die einzelnen Topoi geschaut.“"
                                            },
                                            {
                                                "example_id": "d272427f-dda7-4cd8-81d1-08cf6a4261fc",
                                                "sense_id": "fb5fb691-af92-3f68-8533-5ae8a4d5ebab",
                                                "text": "„Es sind die ewig selben Topoi, die ewig selben Bilder, die ewig selben Stereotype, die hier zitiert und wiederholt werden, als hätten sie keine Vorgeschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
