        "fr-extract.jsonl": [
            {
                "entry_id": "d6dacad5-dd10-38a3-963a-a0facefaafa4",
                "word": "bigarrure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6dd3d373-2595-4477-8ba4-70aa7ac1a982",
                        "entry_id": "d6dacad5-dd10-38a3-963a-a0facefaafa4",
                        "tags": [
                            "plural"
                        ],
                        "form": "bigarrures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f434d86-0dbf-3ed7-ad20-5ac7a27206ae",
                        "entry_id": "d6dacad5-dd10-38a3-963a-a0facefaafa4",
                        "glosses": [
                            "Juxtaposition de couleurs tranchantes ou mal assorties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc47bcae-6faa-4fb6-b9af-a87b822b5e1c",
                                "sense_id": "0f434d86-0dbf-3ed7-ad20-5ac7a27206ae",
                                "text": "Les musaraignes, petites souris microscopiques, grosses comme une noisette, se hasardaient hors de leur trou, et dessinaient sur le sol de capricieuses bigarrures du bout de leur petite queue pointue."
                            },
                            {
                                "example_id": "802f3be5-bad9-4cdb-b017-5bcbb7d286a0",
                                "sense_id": "0f434d86-0dbf-3ed7-ad20-5ac7a27206ae",
                                "text": "Là, c’était une bigarrure extraordinaire de couleurs, des rouges, des jaunes, des bleus qui détonnaient, toute une débauche d’arc-en-ciel dans l’or éclatant des cadres."
                            },
                            {
                                "example_id": "921065d5-a6fb-49d7-9ddd-5b6f07fc6a99",
                                "sense_id": "0f434d86-0dbf-3ed7-ad20-5ac7a27206ae",
                                "text": "Dans les rues, la veille encore animées par la bigarrure des costumes, où retentissaient les cris des marchands et les pas des chevaux, s’étendaient maintenant la solitude et le silence."
                            },
                            {
                                "example_id": "79d70cbb-2092-41aa-8d60-e173618aeaaf",
                                "sense_id": "0f434d86-0dbf-3ed7-ad20-5ac7a27206ae",
                                "text": "Les Persans aiment surtout la bigarrure en leurs habits ; car leur justaucorps est d’une couleur, leur veste d’une autre, leurs chausses d’une autre, et leurs souliers, particulièrement ceux des femmes, sont ou verts, ou rouges, ou jaunes, ou violets."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a830bbb-8660-3fa3-a632-e322df69b39c",
                        "entry_id": "d6dacad5-dd10-38a3-963a-a0facefaafa4",
                        "glosses": [
                            "Mélange d’éléments disparates."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6f5438df-47c7-4240-90d8-c7a708988d94",
                                "sense_id": "6a830bbb-8660-3fa3-a632-e322df69b39c",
                                "text": "Ce pacte était un bienfait : il faisait disparaître, avec l'ancienne division territoriales, cette bigarrure de coutumes locales qui rendait en quelque sorte les provinces étrangères les unes aux autres, et perpétuait sur certains points des inimitiés d’origine féodale."
                            },
                            {
                                "example_id": "d8849ad1-2524-404f-b696-b09dac7a3c2d",
                                "sense_id": "6a830bbb-8660-3fa3-a632-e322df69b39c",
                                "text": "L’homme, en tout et partout, n’est que rapiècement et bigarrure."
                            },
                            {
                                "example_id": "2a308b12-17a1-4600-87ec-86b54d12b511",
                                "sense_id": "6a830bbb-8660-3fa3-a632-e322df69b39c",
                                "text": "La pièce voisine était tapissée de livres, mêlés et contradictoires comme toutes ces fièvres dont la bigarrure fait mon âme."
                            },
                            {
                                "example_id": "bf4b2295-0522-4b53-a99d-59ed80cb91d9",
                                "sense_id": "6a830bbb-8660-3fa3-a632-e322df69b39c",
                                "text": "Dès le 17 juin 1789, les États généraux, dont le but était de tendre au roi le miroir où contempler la bigarrure d’une société d’ordres, se donnent à eux-mêmes le nom d’Assemblé nationale et déclarent la représentation « une et indivisible »."
                            },
                            {
                                "example_id": "5e75d836-60ae-4ba0-be5a-3a16d4f134c5",
                                "sense_id": "6a830bbb-8660-3fa3-a632-e322df69b39c",
                                "text": "L’oreille de Roudine ne s’offensait guère de la bigarrure du langage qui coulait des lèvres de Daria Michaëlowna."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
