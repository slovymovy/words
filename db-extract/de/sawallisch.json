                "senses": [
                    {
                        "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                        "entry_id": "0eefde43-4fc1-360a-959f-b4c29da0af0c",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f0f997d-27f8-4fd0-b115-f4ccbb51a622",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Frau Sawallisch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4952f726-ad35-4224-ae83-1692ac6bc76f",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Herr Sawallisch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e0f9b549-c753-416d-9672-35c78a057c48",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Die Sawallischs fahren heute nach Brüssel."
                            },
                            {
                                "example_id": "fc41eed6-97e5-4207-b31c-cde5353e9cfd",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Der Sawallisch trägt nie die Pullover, die die Sawallisch ihm strickt."
                            },
                            {
                                "example_id": "cff08831-adeb-4668-a0d4-33fc7c548805",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sawallisch kommt, geht der Herr Sawallisch.“"
                            },
                            {
                                "example_id": "1ced4b58-5160-48af-a4f2-462ced1be3b1",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Sawallisch kommt und geht."
                            },
                            {
                                "example_id": "f2bccd2a-7569-4775-a5c3-7a9079281543",
                                "sense_id": "50e826cc-2bdf-36ab-b670-98f83e27af66",
                                "text": "Sawallischs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
