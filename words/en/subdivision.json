{
    "word_family": [
        "divide",
        "division",
        "divisible",
        "subdivide"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50f11b35-860a-36f3-9780-993beb61e6b5",
                    "sense_definition": "The act of dividing something into smaller parts that has already been divided, or one of those parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administrative <w>subdivision</w> of the country into smaller districts helped improve local governance.",
                            "target_lang_translations": {
                                "ru": "Административное <w>подразделение</w> страны на более мелкие районы помогло улучшить местное управление."
                            }
                        },
                        {
                            "text": "Each major category in the report has a further <w>subdivision</w> to provide more specific details.",
                            "target_lang_translations": {
                                "ru": "Каждая основная категория в отчете имеет дальнейшее <w>подразделение</w> для предоставления более конкретных деталей."
                            }
                        }
                    ],
                    "synonyms": [
                        "subset",
                        "subgroup",
                        "section"
                    ],
                    "antonyms": [
                        "whole",
                        "total"
                    ],
                    "common_phrases": [
                        "administrative subdivision",
                        "further subdivision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по разделению чего-либо на более мелкие части, которые уже были разделены, или одна из таких частей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подразделение",
                                "target_lang_sense_clarification": "часть более крупного объекта или структуры"
                            },
                            {
                                "target_lang_word": "подраздел",
                                "target_lang_sense_clarification": "часть раздела в тексте или классификации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5312fcc-fb67-3fae-aedb-e6981d862502",
                    "sense_definition": "An area of land divided into plots for sale, especially one with a group of houses built by the same developer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "housing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are building a new <w>subdivision</w> with over fifty family homes just outside the city.",
                            "target_lang_translations": {
                                "ru": "Они строят новый <w>жилой комплекс</w> с более чем пятьюдесятью семейными домами прямо за городом."
                            }
                        },
                        {
                            "text": "Living in a quiet <w>subdivision</w> is perfect for families who want a safe neighborhood.",
                            "target_lang_translations": {
                                "ru": "Жизнь в тихом <w>микрорайоне</w> идеально подходит для семей, которые хотят безопасного соседства."
                            }
                        }
                    ],
                    "synonyms": [
                        "housing estate",
                        "development",
                        "neighborhood"
                    ],
                    "common_phrases": [
                        "residential subdivision",
                        "new subdivision",
                        "housing subdivision"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in North America and the Philippines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, разделенный на лоты для продажи, особенно с группой домов, построенных одним застройщиком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилой комплекс",
                                "target_lang_sense_clarification": "группа домов на одном участке"
                            },
                            {
                                "target_lang_word": "микрорайон",
                                "target_lang_sense_clarification": "часть города с жилой застройкой"
                            },
                            {
                                "target_lang_word": "коттеджный поселок",
                                "target_lang_sense_clarification": "загородная застройка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "515fbfa2-ca71-3640-a28b-5e0acfd1cf48",
                    "sense_definition": "To organize or separate something into smaller, more manageable pieces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect began <w>subdivisioning</w> the large floor plan into individual office spaces.",
                            "target_lang_translations": {
                                "ru": "Архитектор начал <w>подразделять</w> большой план этажа на отдельные офисные помещения."
                            }
                        },
                        {
                            "text": "By <w>subdivisioning</w> the project into phases, the team managed to meet the tight deadline.",
                            "target_lang_translations": {
                                "ru": "Благодаря <w>дроблению</w> проекта на этапы, команде удалось уложиться в сжатые сроки."
                            }
                        }
                    ],
                    "synonyms": [
                        "subdivide",
                        "partition",
                        "segment"
                    ],
                    "antonyms": [
                        "combine",
                        "unify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовывать или разделять что-либо на более мелкие, удобные для управления части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подразделять",
                                "target_lang_sense_clarification": "делить на более мелкие категории"
                            },
                            {
                                "target_lang_word": "дробить",
                                "target_lang_sense_clarification": "разделять на мелкие фрагменты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}