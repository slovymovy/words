                "senses": [
                    {
                        "sense_id": "304e21b4-b893-3f89-b19b-00869518044b",
                        "entry_id": "8d03c79f-cf55-3993-b171-07658fd0b47f",
                        "glosses": [
                            "Ausflug auf's Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54edf4c7-fe3a-455b-9c6d-ea67ba3b267b",
                                "sense_id": "304e21b4-b893-3f89-b19b-00869518044b",
                                "text": "Die Familie unternahm eine Landpartie zur Großmutter in der Heide."
                            },
                            {
                                "example_id": "2e82306f-c980-4320-9ced-bd5c7a405e7e",
                                "sense_id": "304e21b4-b893-3f89-b19b-00869518044b",
                                "text": "„Mein Gesicht war immer noch nass von der verregneten Landpartie und kurz war ich besorgt, ob die Tropfen auf meiner Stirn eventuell zu einer Verfälschung des Untersuchungsergebnisses führen könnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4be2a20-e785-4fd0-96d3-312b19af2c1e",
                        "source_entry_id": "8d03c79f-cf55-3993-b171-07658fd0b47f",
                        "source_sense_id": "304e21b4-b893-3f89-b19b-00869518044b",
                        "target_lang_word": "country outing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "74989d15-16f4-4dab-89ea-59bf78fbc999",
                        "source_entry_id": "8d03c79f-cf55-3993-b171-07658fd0b47f",
                        "source_sense_id": "304e21b4-b893-3f89-b19b-00869518044b",
                        "target_lang_word": "partie de campagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partie de campagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e2eb23-a42b-32da-b2d3-5e26047c949a",
                                        "entry_id": "2b87ff11-116b-336e-b868-ed36eea495cf",
                                        "glosses": [
                                            "Sortie, promenade à la campagne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49a2e2a6-6cf3-4a01-9d00-5bd43d217dab",
                                                "sense_id": "d6e2eb23-a42b-32da-b2d3-5e26047c949a",
                                                "text": "C'est une vraye partie de campagne, dit le Comte : il faut que vous soyez bien sure de ma soumission, pour m'y embarquer. N'est-ce point aussi me dire adroitement que vous vous ennuiez ici, […]."
                                            },
                                            {
                                                "example_id": "02420f72-1a84-4546-bca5-a68153e67fe9",
                                                "sense_id": "d6e2eb23-a42b-32da-b2d3-5e26047c949a",
                                                "text": "Quelques jours après la partie de campagne de Saint Germain, Armand rentrait chez lui le soir et allait s'habiller pour se rendre chez madame Delarue, dont c'était le jour de réception."
                                            },
                                            {
                                                "example_id": "a3c566de-9c93-47fb-b4ec-5c44177f2f5c",
                                                "sense_id": "d6e2eb23-a42b-32da-b2d3-5e26047c949a",
                                                "text": "[…], il fut convenu qu’ils feraient à quatre une joyeuse partie de campagne, et qu’après un pique-nique on passerait indolemment l’après-midi sous les arbres et dans les fougères des bois situés entre Ashford et Maidstone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "733ee3dd-15ec-4c01-958b-31c6ffe7971e",
                        "source_entry_id": "8d03c79f-cf55-3993-b171-07658fd0b47f",
                        "source_sense_id": "304e21b4-b893-3f89-b19b-00869518044b",
                        "target_lang_word": "excursion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excursion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                        "entry_id": "c3c183ec-dac4-30f4-b9f7-1525a16ffd7a",
                                        "glosses": [
                                            "Course au dehors, promenade de recherche, de découverte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0584c9e-d696-4c03-85d0-e83b2edb47db",
                                                "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                                "text": "Le docteur Barth se détache de ses compagnons, fait une excursion à la ville d'Agbadès, et rejoint l'expédition, qui se remet en marche le 12 décembre."
                                            },
                                            {
                                                "example_id": "89288da1-303f-4232-bb4a-51223f80ea1b",
                                                "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                                "text": "Il alla faire une excursion au-dessus de l’Hudson et de l’East River ; il s’éleva à plusieurs reprises, comme pour voir par-delà les lointains bleus."
                                            },
                                            {
                                                "example_id": "66eb9998-3fac-487b-866d-8e8604adcd99",
                                                "sense_id": "44f95996-cbe7-3a0f-a724-f8feb4b638d0",
                                                "text": "Nous finîmes par arriver à un lac immense entouré de collines et de tori pittoresques. On venait y faire de petites excursions en bateau ou en pédalo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa08ff4-cfd7-30a4-a2ce-9b14683d62e6",
                                        "entry_id": "c3c183ec-dac4-30f4-b9f7-1525a16ffd7a",
                                        "glosses": [
                                            "Digression."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f00ffb5-777d-411b-93f3-57c599ec0a6a",
                                                "sense_id": "afa08ff4-cfd7-30a4-a2ce-9b14683d62e6",
                                                "text": "Faire une excursion, de fréquentes excursions hors de son sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef8dac5c-438d-3cf8-8b4c-5d235cacf265",
                                        "entry_id": "c3c183ec-dac4-30f4-b9f7-1525a16ffd7a",
                                        "glosses": [
                                            "Variation temporaire d’une grandeur en dehors de sa valeur habituelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08465073-737a-43a2-b01c-6b3c6c328c61",
                                                "sense_id": "ef8dac5c-438d-3cf8-8b4c-5d235cacf265",
                                                "text": "L’écran montre que l’excursion du diaphragme est nulle dans les inspirations profondes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
