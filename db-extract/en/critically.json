                "senses": [
                    {
                        "sense_id": "a802693a-2623-3009-a347-201f9e422341",
                        "entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "glosses": [
                            "In a critical manner; with, or in terms of, criticism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec882442-2db4-4576-a70c-a8f6367f7589",
                                "sense_id": "a802693a-2623-3009-a347-201f9e422341",
                                "text": "I looked critically at the frayed carpet of the hotel room."
                            },
                            {
                                "example_id": "e639217f-fc36-4010-8395-fc3baa667189",
                                "sense_id": "a802693a-2623-3009-a347-201f9e422341",
                                "text": "Girard critically examines Nietzsche's central contention that Christianity is a religion of sublimated vengeance or ressentiment and contents that although Nietzsche is half right about Christians he remains dangerously naive about violence itself."
                            }
                        ]
                    },
                    {
                        "sense_id": "8474527e-eb0d-3f56-a69f-f904a25302a9",
                        "entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "glosses": [
                            "In terms of critique, review, of or by critics"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed484c9a-79be-44ac-ace5-30d99f3f6718",
                                "sense_id": "8474527e-eb0d-3f56-a69f-f904a25302a9",
                                "text": "a critically applauded film"
                            }
                        ]
                    },
                    {
                        "sense_id": "780c96fe-6193-369e-b61b-21b2f401f883",
                        "entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "glosses": [
                            "With close discernment; accurately; exactly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b80b08c-0af6-4805-a79d-1f0df55d2bbc",
                                "sense_id": "780c96fe-6193-369e-b61b-21b2f401f883",
                                "text": "Thus difficult it is to underſtand the purity of Engliſh, and critically to diſcern not only good Writers from bad, and a proper ſtile from a corrupt, but alſo to diſtinguiſh that which is pure in a good Author, from that which is vicious and corrupt in him."
                            }
                        ]
                    },
                    {
                        "sense_id": "0487928d-be2a-330c-a9b8-1f0de993fadd",
                        "entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "glosses": [
                            "At a crisis or critical time; in a situation, place, or condition of decisive consequence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ad6e68-b093-48fe-b31c-d054705a1d01",
                                "sense_id": "0487928d-be2a-330c-a9b8-1f0de993fadd",
                                "text": "a fortification critically situated"
                            },
                            {
                                "example_id": "e19bbabb-f7d5-4990-96c9-755ab2877473",
                                "sense_id": "0487928d-be2a-330c-a9b8-1f0de993fadd",
                                "text": "Coming critically the night before the session."
                            }
                        ]
                    },
                    {
                        "sense_id": "78d1186d-76a7-35b2-ae94-557a0e979c92",
                        "entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "glosses": [
                            "Requiring immediate attention; likely to cause a collapse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2e80b1-6a0e-4f40-b616-8caa732721b7",
                                "sense_id": "78d1186d-76a7-35b2-ae94-557a0e979c92",
                                "text": "critically ill"
                            },
                            {
                                "example_id": "a76b635a-e923-485d-888a-8e4904e081af",
                                "sense_id": "78d1186d-76a7-35b2-ae94-557a0e979c92",
                                "text": "critically injured"
                            },
                            {
                                "example_id": "fae42887-5da8-4818-9bf2-cc03e84b9d3a",
                                "sense_id": "78d1186d-76a7-35b2-ae94-557a0e979c92",
                                "text": "critically endangered"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e0161a9-129c-4b7a-8088-7422bd6ad92f",
                        "source_entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "source_sense_description": "in a critical manner, with criticism",
                        "target_lang_word": "kriticky",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kriticky",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "09717f66-9c5d-3ee2-ae58-c5d30a7c6b05",
                                        "entry_id": "7303a5ad-b97b-3dad-bd42-dc28e57cdebc",
                                        "glosses": [
                                            "kritickým způsobem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63261180-0658-4250-aa36-1b3790a6a8ab",
                                                "sense_id": "09717f66-9c5d-3ee2-ae58-c5d30a7c6b05",
                                                "text": "Zkusme se na její působení podívat poněkud méně kriticky — je to přece jenom také člověk, máma od dětí…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "390bc586-ad88-4516-8516-c9fd1f94012f",
                        "source_entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
                        "source_sense_description": "in a critical manner, with criticism",
                        "target_lang_word": "kritiek",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kritiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8be027-731b-3702-9439-c7d39224e542",
                                        "entry_id": "7360fce0-74ea-3860-92bc-84c3ee15d514",
                                        "glosses": [
                                            "uitingen waarmee bepaald gedrag, een bepaalde zienswijze e.d. van anderen worden veroordeeld of in twijfel getrokken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca348c6-b2b6-424e-9850-cff085e16b1b",
                                                "sense_id": "5e8be027-731b-3702-9439-c7d39224e542",
                                                "text": "Er kwam zware kritiek op het optreden van de troepen."
                                            },
                                            {
                                                "example_id": "20698b5a-3f00-4bf8-98ca-534d5ae06b62",
                                                "sense_id": "5e8be027-731b-3702-9439-c7d39224e542",
                                                "text": "Het vertrek van een reeks hooggeplaatste functionarissen werd op 5 juli ingeluid door minister van Financiën Rishi Sunak en gezondheidsminister Sajid Javid. Het tweetal uitte bij hun vertrek felle kritiek op Johnson. Ze schreven in een verklaring dat de overheid geen \"goed, competent en serieus werk\" verricht."
                                            },
                                            {
                                                "example_id": "6d8c7117-479c-44f0-8521-143d4a234d92",
                                                "sense_id": "5e8be027-731b-3702-9439-c7d39224e542",
                                                "text": "Paus Franciscus, geboren als Jorge Mario Bergoglio, schudde het Vaticaan op en kwam op voor de zwakkeren in de samenleving. Maar kritiek was er ook, onder meer uit conservatieve hoek"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "231c0eb8-a561-30d5-896f-1d35bfb4e2f9",
                                        "entry_id": "7360fce0-74ea-3860-92bc-84c3ee15d514",
                                        "glosses": [
                                            "een document dat kunstzinnig commentaar levert op een optreden, tentoonstelling, boek, film of andere kunstuiting"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e766aceb-c3fa-43ec-862c-02799932b430",
                                                "sense_id": "231c0eb8-a561-30d5-896f-1d35bfb4e2f9",
                                                "text": "Heb je de kritieken gelezen? Ze zijn erg positief."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kritiek",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d04a5a0e-7197-30bd-935f-e192bf9dd7c3",
                                        "entry_id": "a1c8c059-7f64-3f0f-97f4-a51ab64fae5f",
                                        "glosses": [
                                            "op het scherp van de snede, met onzekere uitkomst, cruciaal voor de toekomst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331df252-842b-42e1-bad5-c8f5a0878456",
                                                "sense_id": "d04a5a0e-7197-30bd-935f-e192bf9dd7c3",
                                                "text": "De kritieke situatie in het buurland zorgde voor grote onrust."
                                            },
                                            {
                                                "example_id": "157da133-87ea-40a3-ab23-c8a55547093c",
                                                "sense_id": "d04a5a0e-7197-30bd-935f-e192bf9dd7c3",
                                                "text": "De meest kritieke fase is daarmee voorbij, meldt de brandweer, die 950 brandweerlieden inzette. De vlammen worden geblust met behulp van vliegtoestellen. Er blijven nog 520 brandweerlieden in het gebied om de brand verder te controleren. Hulpdiensten spreken van een \"megabrand\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f244e2b-b546-36fd-b84b-be81d4d2282c",
                                        "entry_id": "a1c8c059-7f64-3f0f-97f4-a51ab64fae5f",
                                        "glosses": [
                                            "zeer hachelijk, met groot gevaar voor leven of verdere gezondheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60cd4cb8-bbed-4c30-a8af-4aa1af74b4d0",
                                                "sense_id": "9f244e2b-b546-36fd-b84b-be81d4d2282c",
                                                "text": "De aangereden voetganger is in kritieke staat in het ziekenhuis opgenomen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0057de5c-6c52-4ffe-9819-cbd73881ceba",
                        "source_entry_id": "28a320ac-b4ec-3f3b-86ba-28bc72efc8ab",
