                "senses": [
                    {
                        "sense_id": "9f0eadc8-0f75-3b79-a659-7fe545179156",
                        "entry_id": "6f0315cc-8aba-35fd-8dab-58e1481bcb63",
                        "glosses": [
                            "Wissenschaftler, der sich mit Fragestellungen auf dem Gebiet der Sinnesphysiologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "599b0146-3fc0-448c-b26a-83c38ecd36e4",
                                "sense_id": "9f0eadc8-0f75-3b79-a659-7fe545179156",
                                "text": "Ernst Mach war ein österreichischer Physiker, Sinnesphysiologe, Philosoph und Wissenschaftstheoretiker sowie ein Pionier der gerade entstehenden Wissenschaftsgeschichte."
                            },
                            {
                                "example_id": "b63d3207-a8c6-44b4-9ec3-abc1541fc04c",
                                "sense_id": "9f0eadc8-0f75-3b79-a659-7fe545179156",
                                "text": "„Der US-Sinnesphysiologe David Julius und der libanesisch-amerikanische Molekularbiologe Ardem Patapoutian erhalten den Medizin-Nobelpreis.“"
                            },
                            {
                                "example_id": "401a57ed-9414-486f-8ae0-d4fca73341b6",
                                "sense_id": "9f0eadc8-0f75-3b79-a659-7fe545179156",
                                "text": "„Der Utrechter Sinnesphysiologe und Pionier der Reaktionszeitforschung Franciscus Cornelis Donders erforschte die Farbtüchtigkeit der Bahnbeamten seines Landes (1875; 1877).“"
                            },
                            {
                                "example_id": "1ea912e6-e309-4631-9543-3cdb69a936e3",
                                "sense_id": "9f0eadc8-0f75-3b79-a659-7fe545179156",
                                "text": "„Wolf-Dieter Keidel (* 14. Dezember 1917 in Gaimersheim; † 17. Januar 2011 in Bayreuth) war ein deutscher Mediziner und Sinnesphysiologe.“"
                            },
                            {
                                "example_id": "0e6f382d-60e5-4f59-9119-c91e26d5e199",
                                "sense_id": "9f0eadc8-0f75-3b79-a659-7fe545179156",
                                "text": "„Sinnesphysiologe Steffen Michler ist als Sommelier bei internationalen Weinwettbewerben und Veranstaltungen gefragt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
