                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea012fe7-cd3f-4e24-a794-d054b6243fdd",
                        "entry_id": "1a673852-e262-383b-a7c3-05f544d613d2",
                        "tags": [
                            "plural"
                        ],
                        "form": "dioptres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e583e377-e0a9-3bb3-a003-2f543f087140",
                        "entry_id": "1a673852-e262-383b-a7c3-05f544d613d2",
                        "glosses": [
                            "Surface séparant deux milieux transparents ayant chacun un indice de réfraction différent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca476bb-258f-48cd-8552-9564bfa13a84",
                                "sense_id": "e583e377-e0a9-3bb3-a003-2f543f087140",
                                "text": "Une partie de la lumière est réfléchie à la surface du dioptre et l’autre partie est réfractée lors de son passage dans l’autre milieu."
                            },
                            {
                                "example_id": "f0b30981-da53-435e-aa47-5dbbef9b4a66",
                                "sense_id": "e583e377-e0a9-3bb3-a003-2f543f087140",
                                "text": "Le contrôle des rayons de courbure — et en conséquence des vergences — des dioptres d’un verre ophtalmique sphérique ou torique sont faites avec un sphéromètre ou un toromètre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8ff24b0-22e8-4a5e-930e-b5a615505123",
                        "source_entry_id": "1a673852-e262-383b-a7c3-05f544d613d2",
                        "source_sense_id": "e583e377-e0a9-3bb3-a003-2f543f087140",
                        "target_lang_word": "interface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b811e37e-07dd-3e49-a8c5-c7d57f35532b",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "The point of interconnection or contact between entities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094c12be-677e-44ca-92bf-608686a86c61",
                                                "sense_id": "b811e37e-07dd-3e49-a8c5-c7d57f35532b",
                                                "text": "Public relations firms often serve as the interface between a company and the press."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2b917c5-4394-399f-b37c-0fae9d844695",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "A thin layer or boundary between different substances or two phases of a single substance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29b0bead-2052-4677-bb30-bc43f7c80176",
                                                "sense_id": "e2b917c5-4394-399f-b37c-0fae9d844695",
                                                "text": "If water and oil are mixed together, they tend to separate, and at equilibrium they are in different strata with an oil-water interface in between."
                                            },
                                            {
                                                "example_id": "cdb27d7d-b87a-47cc-992b-d15a6005aa25",
                                                "sense_id": "e2b917c5-4394-399f-b37c-0fae9d844695",
                                                "text": "The surface of a lake is a water-air interface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e72a7a5-6de0-38fe-a5ad-5183021d3080",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "The point of interconnection between systems or subsystems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab51664-2335-4c59-b266-05d43cc1f3ad",
                                                "sense_id": "2e72a7a5-6de0-38fe-a5ad-5183021d3080",
                                                "text": "The data is sent over the air interface to the remote system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f418df-cc8a-3a50-ba9e-5484bc4c23bd",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "The connection between a user and a machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ec36bec-ab70-4b81-8616-8dd7282e5456",
                                                "sense_id": "e3f418df-cc8a-3a50-ba9e-5484bc4c23bd",
                                                "text": "The options are selected via the user interface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4b3e5c-6f5d-3fd2-8521-9a877d75de02",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "The connection between parts of software; also the public or published sections of an object or module."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5678fe-aeba-4fea-8579-f35c76b95253",
                                                "sense_id": "ba4b3e5c-6f5d-3fd2-8521-9a877d75de02",
                                                "text": "This interface is implemented by several Java classes."
                                            },
                                            {
                                                "example_id": "963c3b67-e4a8-48dd-956e-67d522d95cc5",
                                                "sense_id": "ba4b3e5c-6f5d-3fd2-8521-9a877d75de02",
                                                "text": "Traits are somewhat between an interface and a mixin, as an interface contains only method signatures, while a trait includes also the full method definitions; on the other side mixins include method definitions, but they can also carry state through attributes, while traits usually don't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a47227-bc1d-3dc2-bd1c-b19f1c841ddd",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "In object-oriented programming, a piece of code defining a set of operations that other code must implement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd2fcbf-d4a2-4067-a016-91a1ab8f57bd",
                                                "sense_id": "88a47227-bc1d-3dc2-bd1c-b19f1c841ddd",
                                                "text": "The Audio and Video classes both implement the IPlayable interface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf62b2cd-60cf-381e-a1c8-ac6d83c164b2",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "In some languages, a block of code declaring the interface (point of interconnection) between a class and code that interacts with it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37debf90-8fd6-3874-96e7-ff71b4408281",
                                        "entry_id": "1ace712a-c70b-34bd-9b16-2f66beb79ad2",
                                        "glosses": [
                                            "The internal surface of a coiled protein (compare exoface)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
