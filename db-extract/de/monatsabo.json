                    {
                        "sense_id": "fe17b5a5-234b-3196-b23e-ac71fe59d232",
                        "entry_id": "c6b33bd1-1dfb-3bcf-8051-923b913570be",
                        "glosses": [
                            "Monatsabonnement; Abonnement, das einen Monat Gültigkeit hat"
                        ],
                        "tags": [
                            "Kurzwort für"
                        ],
                        "examples": [
                            {
                                "example_id": "70fa65e6-e1af-4de5-9be8-2097f3224218",
                                "sense_id": "fe17b5a5-234b-3196-b23e-ac71fe59d232",
                                "text": "„Es gibt eine große Auswahl an Cloud-gestützten Datenanalysen, die im Monatsabo gebucht werden können.“"
                            },
                            {
                                "example_id": "3045b061-bc5b-4604-a3a7-acc4f87c5646",
                                "sense_id": "fe17b5a5-234b-3196-b23e-ac71fe59d232",
                                "text": "„Die Bezahlung, die in dem Säckchen auf ihn wartete, würde ausreichen, eine Wohnung und ein Bett zu finanzieren plus ein Monatsabo Kaffee in seiner Lieblingsbar.“"
                            },
                            {
                                "example_id": "25978826-7be1-433a-b979-701d3ad25b5f",
                                "sense_id": "fe17b5a5-234b-3196-b23e-ac71fe59d232",
                                "text": "„Man zahlt nicht mehr pro Minute, sondern meist pro Film oder kauft sich für 29 Euro ein Monatsabo – wenn nicht sogar viel günstiger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
