                        ],
                        "form": "die Schlafsäle"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                        "entry_id": "69c4b130-ed20-35b3-be51-74a7e0199bad",
                        "glosses": [
                            "größerer Raum mit Schlafgelegenheit für relativ viele Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba04a82-67a3-4c70-84e8-297a967babe1",
                                "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                                "text": "„Ich habe mich im Schlafsaal eingebucht.“"
                            },
                            {
                                "example_id": "21eea498-c5bc-4568-ab12-05b3b9b49c5d",
                                "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                                "text": "„Die Nächte im Schlafsaal sind oft unruhig.“"
                            },
                            {
                                "example_id": "7c5f9d3f-ff95-468c-b2c6-8d7c2bdb5d31",
                                "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                                "text": "„So wie jetzt hier, hatte er an jenem Tag am Fenster des Schlafsaals gestanden.“"
                            },
                            {
                                "example_id": "12b05611-738e-4f2b-a055-d644da6abcdc",
                                "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                                "text": "„Da führte er mich etwas verärgert und zum großen Erstaunen meiner Mitschüler, mit denen ich im gleichen Schlafsaal wohnte, in die Dogmatikklasse.“"
                            },
                            {
                                "example_id": "b0d1bb7a-0d1a-48ec-99e7-bc3dd435d4c4",
                                "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                                "text": "„Im Schneidersitz saß Warlam Babinitsch in einer Ecke des überfüllten Schlafsaals auf dem dreckigen Betonboden und verbarg mit seinem Körper die Gegenstände, die er vor sich ausgebreitet hatte.“"
                            },
                            {
                                "example_id": "29978d48-2105-4983-91b6-738673416131",
                                "sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
                                "text": "„Die Schlafsäle, an denen sie vorbeikamen, waren vollgestopft mit Kindern, um die 40 pro Raum, die nichts am Leib hatten außer einem dreckigen Hemdchen oder einer dreckigen Unterhose, aber offenbar niemals beides.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7e18802-2b20-4647-824a-0239102085d1",
                        "source_entry_id": "69c4b130-ed20-35b3-be51-74a7e0199bad",
                        "source_sense_id": "8af3637a-5a78-30c8-8fea-34ee96e13edd",
