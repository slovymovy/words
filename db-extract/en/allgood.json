                        "sense_id": "f36412f8-ef18-3007-a4bd-59d3b203fb4a",
                        "entry_id": "c2d76166-4a76-3c56-9560-97d6073f7f10",
                        "glosses": [
                            "Alternative form of all-good."
                        ],
                        "tags": [
                            "alt-of",
