                    {
                        "translation_id": "0c296c2f-ea72-48fd-b227-b3cf915a61de",
                        "source_entry_id": "c0584bc7-920c-31f5-a881-e6215f61e93e",
                        "source_sense_id": "66a0a064-ef52-30fa-924f-e3db9b4de74e",
