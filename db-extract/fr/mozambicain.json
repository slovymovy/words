                "senses": [
                    {
                        "sense_id": "aca2303e-a7ce-317e-83fb-3adbda4b36c9",
                        "entry_id": "edc88ab0-7da0-34a6-8ba2-9a8cb75ce2f9",
                        "glosses": [
                            "Habitant ou originaire de Mozambique ^([1]) ^([2])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30549b25-ebdb-48ac-87ca-445a44992ea3",
                                "sense_id": "aca2303e-a7ce-317e-83fb-3adbda4b36c9",
                                "text": "Ce Mozambicain de 45 ans, vêtu d’un T-shirt sale, d’un pantalon déchiré et de chaussures éraflées, coupe des arbres illégalement, sans porter ni casque, ni protections auditives, ni lunettes de sécurité. Des centaines de souches autour de lui témoignent de son dur labeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64580741-29e8-4aa9-a02d-a2a850840a9a",
                        "source_entry_id": "edc88ab0-7da0-34a6-8ba2-9a8cb75ce2f9",
                        "source_sense_id": "aca2303e-a7ce-317e-83fb-3adbda4b36c9",
                        "target_lang_word": "Mosambikaner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mosambikaner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0118db00-569e-36e2-8336-1caa6b30b45c",
                                        "entry_id": "77edd9ae-c353-38f7-9f95-821bc7dad306",
                                        "glosses": [
                                            "Staatsbürger von Mosambik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78a22fd8-1607-4db3-bc97-77e889375cc2",
                                                "sense_id": "0118db00-569e-36e2-8336-1caa6b30b45c",
                                                "text": "Der Mosambikaner vom Kiosk an der Ecke grüßt stets sehr freundlich."
                                            },
                                            {
                                                "example_id": "dd3d9019-c591-4b5b-97d5-f7300e5db901",
                                                "sense_id": "0118db00-569e-36e2-8336-1caa6b30b45c",
                                                "text": "„Nur Machels mahnende Worte, nicht denselben Fehler zu begehen wie die Mosambikaner und die Siedler mitsamt ihrem Know-how zu vertreiben, ermöglichten nach 1980 die Versöhnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be17d5e3-8253-4aed-9960-e9bb2c43bf4d",
