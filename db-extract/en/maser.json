                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c332fa9-b815-4205-a2c6-e3625c299d01",
                                                "sense_id": "8ae3d0a0-902d-3733-b1c5-0a622e31a857",
                                                "text": "Der Maser wurde lange vor dem Laser erfunden."
                                            },
                                            {
                                                "example_id": "d46aef67-d454-43b4-9678-751d6ae486a0",
                                                "sense_id": "8ae3d0a0-902d-3733-b1c5-0a622e31a857",
                                                "text": "Während der Maser auf den Mikrowellenbereich beschränkt ist, arbeitet der Laser im Infrarot und in den sich daran anschließenden, noch kürzeren Spektralbereichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
