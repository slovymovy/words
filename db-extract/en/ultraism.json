        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                "word": "ultraism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4d3e73be-df72-4520-9506-1b1f0bc51c06",
                        "entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                        "tags": [
                            "plural"
                        ],
                        "form": "ultraisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f47e0757-065d-3d94-a55c-d776a6885ba5",
                        "entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                        "glosses": [
                            "Radicalism or political extremism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8faf55fd-9a8f-4a26-aa1e-41cb642b63c0",
                                "sense_id": "f47e0757-065d-3d94-a55c-d776a6885ba5",
                                "text": "We glory in such ultraism—the ultraism which says that “all men are created equal—[…]the ultraism which treats man as an intelligent and immortal being, and not as an article of merchandize and traffic—[…]"
                            },
                            {
                                "example_id": "2b2b9cd2-d57f-4374-82e8-79244507ee2b",
                                "sense_id": "f47e0757-065d-3d94-a55c-d776a6885ba5",
                                "text": "With all that tendency to ultraism said to prevail at present, it may be doubted whether evangelists might not even now be found who, though in health, would require no such license for such a liberty; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "8bede0c8-ab1c-31e4-9c06-362d99efca20",
                        "entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                        "glosses": [
                            "A Spanish poetic movement opposed to modernism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "108feebc-06fd-433b-ba0b-09838d87b1a5",
                                "sense_id": "8bede0c8-ab1c-31e4-9c06-362d99efca20",
                                "text": "The eight young signers of this “Ultra manifesto” could not have known at the time how accurate and prescient their declaration was. Spanish ultraism, born as a movement with that document, would be distinguished, ironically, by its indiscriminate and eclectic borrowings from the other European vanguard tendencies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b451de1-84f5-46d8-84a8-c4cff6651f5f",
                        "source_entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
                        "source_sense_description": "Spanish poetic movement",
                        "target_lang_word": "ultraïsme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraïsme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b8f2524-5ab6-3390-8abe-a790584f81d7",
                                        "entry_id": "31ec4ec8-da61-3230-bac9-4ec1ee247e67",
                                        "glosses": [
                                            "Idéologie ou attitude extrémiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "596c5b1a-a842-4f11-a85f-40acf50f94e9",
                                                "sense_id": "6b8f2524-5ab6-3390-8abe-a790584f81d7",
                                                "text": "Les livres anglais sur l’Italie comme le voyage d’Exeton et l’Edinburg Review (X, 365) sont écrits dans les principes de l’ultraïsme le plus amusant. On croit entendre nos missionnaires de 1818."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c585836-1820-31d2-b453-6efb75786c1b",
                                        "entry_id": "31ec4ec8-da61-3230-bac9-4ec1ee247e67",
                                        "glosses": [
                                            "Mouvement poétique espagnol créé en 1918 par Guillermo de Torre, utilisant des mots rares et des métaphores."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d1aea0-2885-45b7-9ab2-4d29b673bad9",
                        "source_entry_id": "97e93efa-b1d8-3e1b-b3d8-94de22237f9e",
