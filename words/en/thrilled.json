                {
                    "sense_id": "02de1814-4b2f-3585-9445-1e053eb03693",
                    "sense_definition": "Extremely excited, happy, or delighted about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was absolutely <w>thrilled</w> to bits when she found out she won the competition.",
                            "target_lang_translations": {
                                "ru": "Она была просто <w>вне себя от радости</w>, когда узнала, что выиграла конкурс.",
                                "fr": "Elle était absolument <w>ravie</w> lorsqu'elle a appris qu'elle avait gagné le concours."
                            }
                        },
                        {
                            "text": "The young boy was <w>thrilled</w> to meet his favorite superhero at the theme park.",
                            "target_lang_translations": {
                                "ru": "Мальчик был <w>в восторге</w> от встречи со своим любимым супергероем в тематическом парке.",
                                "fr": "Le jeune garçon était <w>ravi</w> de rencontrer son super-héros préféré au parc d'attractions."
                            }
                        }
                    ],
                    "synonyms": [
                        "ecstatic",
                        "elated",
                        "overjoyed",
                        "delighted"
                    ],
                    "antonyms": [
                        "disappointed",
                        "depressed",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "thrilled to bits",
                        "absolutely thrilled",
                        "thrilled with results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно взволнованный, счастливый или довольный чем-либо.",
                        "fr": "Extrêmement enthousiaste, heureux ou ravi de quelque chose."
                    },
