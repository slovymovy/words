                ],
                "senses": [
                    {
                        "sense_id": "58cf439d-587d-3fe3-b9ab-3421a506eaa9",
                        "entry_id": "001dfd12-74a4-3227-bca0-8638a0dd3637",
                        "glosses": [
                            "Gegenstand, der einen Text/Texte in einer bestimmten Schrift enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e77d24-ec4e-4587-b770-b984d49192f3",
                                "sense_id": "58cf439d-587d-3fe3-b9ab-3421a506eaa9",
                                "text": "„Die Bleiplatte von Magliano gehört zu den wichtigsten Schriftdenkmälern des Etruskischen (…).“"
                            },
                            {
                                "example_id": "55327258-e627-44f9-8204-807981eb9418",
                                "sense_id": "58cf439d-587d-3fe3-b9ab-3421a506eaa9",
                                "text": "„Es scheint schon über der Erhaltung des Elamischen ein Unstern gewaltet zu haben, denn wir besitzen aus nachachämenidischer Zeit keine elamischen Schriftdenkmäler mehr, obwohl man annehmen darf, daß die Sprache noch bis gegen Ende des ersten christlichen Jahrtausends lebte! -.“"
                            },
                            {
                                "example_id": "b77f706f-5056-4a7f-9241-0cde0daba380",
                                "sense_id": "58cf439d-587d-3fe3-b9ab-3421a506eaa9",
                                "text": "„Für die Etymologie der Wörter hat eine frühe Fixierung einer bestimmten Wortform in den alten Schriftdenkmälern entscheidende Bedeutung.“"
                            },
                            {
                                "example_id": "2e90b93a-b7d5-422e-8cdc-4d577f7c73d2",
                                "sense_id": "58cf439d-587d-3fe3-b9ab-3421a506eaa9",
                                "text": "„Das älteste vorhandene Schriftdenkmal über diese sagenhafte Geschicke Rolands ist das irrtümlich dem \"Erzbischof\" Turpin zu Rheims (Ende des 12. Jahrhunderts) zugeschriebene Buch: Turpini historia de vita Caroli Magui et Rolandi, das nachweislich am Schlusse des 11. Jahrhunderts schon in Spanien bekannt war und von dort aus erst nach Frankreich gebracht wurde.“"
                            },
                            {
                                "example_id": "222d197f-e6f3-4b5a-9e63-e3cfcf9e8115",
                                "sense_id": "58cf439d-587d-3fe3-b9ab-3421a506eaa9",
                                "text": "„Um 1530 entsteht das älteste sorbische Schriftdenkmal: der „Burger Eyd Wendisch“, der Bürgereid von Bautzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
