                "senses": [
                    {
                        "sense_id": "5838feb8-f177-3d5d-b681-20db4333d887",
                        "entry_id": "cfd22273-3e2e-39f6-901b-354143239772",
                        "glosses": [
                            "aus Papier hergestelltes Flugobjekt ohne eigenen Antrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "609517c0-4059-4035-8796-2a8f99c8ac11",
                                "sense_id": "5838feb8-f177-3d5d-b681-20db4333d887",
                                "text": "Viele Pioniere der Luftfahrt haben mit Papierfliegern experimentiert."
                            },
                            {
                                "example_id": "f97ab5f8-285c-4e75-bdda-478308c835b3",
                                "sense_id": "5838feb8-f177-3d5d-b681-20db4333d887",
                                "text": "„Ein Papierflieger, auf den von Kinderhand ein paar Zeilen gekritzelt waren, hat am Samstag die Polizeiinspektion Bogenhausen alarmiert.“"
                            },
                            {
                                "example_id": "87ecfd03-02ea-49af-82ed-322f99fe3db7",
                                "sense_id": "5838feb8-f177-3d5d-b681-20db4333d887",
                                "text": "„Die Aula war überfüllt, das Rauchverbot wurde lustvoll übertreten, Bierflaschen kreisten, Papierflieger aus den Flugblättern der Konkurrenz durchbrachen die gegnerischen Linien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
