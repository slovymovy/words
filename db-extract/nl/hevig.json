                ],
                "senses": [
                    {
                        "sense_id": "3da8930e-13de-3202-a3fd-e2ad050c46c2",
                        "entry_id": "9296ab96-929c-3b21-9bf3-1f771baf3b28",
                        "glosses": [
                            "sterk in mate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e0deb3-702e-4849-8c36-a42cc871bf78",
                                "sense_id": "3da8930e-13de-3202-a3fd-e2ad050c46c2",
                                "text": "De regen werd gevolgd door een nog hevigere stortbui."
                            },
                            {
                                "example_id": "2cf03782-bd62-4b01-8548-98fe4f449f56",
                                "sense_id": "3da8930e-13de-3202-a3fd-e2ad050c46c2",
                                "text": "Doordat ik op Mount Whitney een verschrikkelijke nacht in hevig onweer had doorgebracht wilde ik zo snel mogelijk de bergen uit om bij te komen in een hotel in Independence, het dichtstbijzijnde dorp."
                            },
                            {
                                "example_id": "6f3fa29c-86ca-4c8a-bc2d-9350b59121ef",
                                "sense_id": "3da8930e-13de-3202-a3fd-e2ad050c46c2",
                                "text": "Ze herinnert zich hoe koud ze het had toen ze langs de gracht naar de schouwburg liep, hoe hevig haar nekhaartjes prikten."
                            },
                            {
                                "example_id": "be5d43cd-ba7f-4744-a6b9-053985d87c69",
                                "sense_id": "3da8930e-13de-3202-a3fd-e2ad050c46c2",
                                "text": "Op het moment dat ik hevig ontroerd sta te snikken, komt er een in het zwart geklede oude dame de keuken van het hotel binnen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac9bb789-e429-4794-afa0-8d505c632494",
                        "source_entry_id": "9296ab96-929c-3b21-9bf3-1f771baf3b28",
                        "source_sense_id": "3da8930e-13de-3202-a3fd-e2ad050c46c2",
