                "senses": [
                    {
                        "sense_id": "398611f9-df6b-31b0-bb85-4c80866054ff",
                        "entry_id": "5ce24068-5f34-363c-bb72-a8740c3d5f88",
                        "glosses": [
                            "Asservir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82d199e-d441-40a6-b5bd-c550c78991a0",
                                "sense_id": "398611f9-df6b-31b0-bb85-4c80866054ff",
                                "text": "Eh! bon.peuple gaulois, ne voyez-vous pas un roi vaincu qui se soumet au citoyen victorieux ; qui se soumet jusqu'au moment où il pourra vous réasservir?"
                            },
                            {
                                "example_id": "d93cce73-9170-408d-a078-302f60da35b7",
                                "sense_id": "398611f9-df6b-31b0-bb85-4c80866054ff",
                                "text": "La cour n'en est pas déconcertée ; elle change de système et tâche d'égarer le peuple qu'elle n'a pu réasservir à force ouverte."
                            }
                        ]
                    }
                ],
