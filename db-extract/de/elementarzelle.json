                "senses": [
                    {
                        "sense_id": "ca2c0e2f-1036-3df8-a038-34b8f7311d59",
                        "entry_id": "1ca15500-65b5-3c43-8821-465d1a0e8fe7",
                        "glosses": [
                            "ein herausgeschnittenes Gitterelement, das sich im Kristallgitter periodisch nach allen Richtungen fortsetzt"
                        ],
                        "tags": [
                            "Werkstoffkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "808b3bf4-f875-46e0-a79c-92c5e3553885",
                                "sense_id": "ca2c0e2f-1036-3df8-a038-34b8f7311d59",
                                "text": "Die Elementarzelle hat einen Gitterpunkt an jeder ihren Ecken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b49c9ad7-6ab4-4733-9e60-980332ba9785",
                        "source_entry_id": "1ca15500-65b5-3c43-8821-465d1a0e8fe7",
                        "source_sense_id": "ca2c0e2f-1036-3df8-a038-34b8f7311d59",
                        "source_sense_description": "herausgeschnittenes Gitterelement, das sich im Kristallgitter nach allen Richtungen fortsetzt",
                        "target_lang_word": "maille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "484dcdaf-1595-3b14-bc67-3542b548886a",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Chacune des boucles que forment des fils croisés ou noués en un point et qui constituent un tissu plus ou moins lâche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe73141-553f-4eca-88ca-578f4aa60886",
                                                "sense_id": "484dcdaf-1595-3b14-bc67-3542b548886a",
                                                "text": "Son pied gauche, dont l’orteil rongeait la chaussette dix fois raccommodée, déchiquetant les mailles et creusant sa trouée, le faisait souffrir cruellement."
                                            },
                                            {
                                                "example_id": "2419a7fd-ae8d-48ba-9857-8ecf614e2ae9",
                                                "sense_id": "484dcdaf-1595-3b14-bc67-3542b548886a",
                                                "text": "La survie de la langue bretonne, qui était son obsession, avait selon lui tenu seulement à une maille filée dans le tricot jacobin de la législation scolaire, un oubli de Jules Ferry, qui n’avait songé à imposer l’obligation qu’à partir de six ans."
                                            },
                                            {
                                                "example_id": "540ef47c-6593-4b18-a247-f12725a0c2f1",
                                                "sense_id": "484dcdaf-1595-3b14-bc67-3542b548886a",
                                                "text": "Il y a une maille rompue à votre bas."
                                            },
                                            {
                                                "example_id": "048c844d-2c41-4a13-a3e0-309e878416c0",
                                                "sense_id": "484dcdaf-1595-3b14-bc67-3542b548886a",
                                                "text": "Deux mailles de ce bas ont coulé."
                                            },
                                            {
                                                "example_id": "ae9de82c-79b5-414a-9bb0-2617df92a2e8",
                                                "sense_id": "484dcdaf-1595-3b14-bc67-3542b548886a",
                                                "text": "Reprendre, relever une maille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e69e9a3-8888-3fd8-9ec3-4f2f2270e69f",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Nœuds faits de corde, de fil, etc., dans les filets. Trame d’un filet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14773fb1-2dd1-41fa-bb0d-67de1bac4d0f",
                                                "sense_id": "8e69e9a3-8888-3fd8-9ec3-4f2f2270e69f",
                                                "text": "Il y a plusieurs mailles rompues à ce filet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6c4f6b8-0732-3f5c-b26e-778dd52c4485",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Ouverture que les nœuds d’un tricot ou d’un filet laissent entre eux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799a4772-2ead-45cb-a47a-1d1703dbd237",
                                                "sense_id": "f6c4f6b8-0732-3f5c-b26e-778dd52c4485",
                                                "text": "Les mailles de ce filet sont trop grandes, trop larges."
                                            },
                                            {
                                                "example_id": "4d2d7cd3-e1e4-420e-b162-4a4b84331c25",
                                                "sense_id": "f6c4f6b8-0732-3f5c-b26e-778dd52c4485",
                                                "text": "Il comprenait pourquoi il y a des escarpolettes, des hamacs, et projetait de s’en monter un avec des filets de pêcheur, qu’un de ses gardes avait saisis parce qu’ils n’avaient pas la largeur de maille."
                                            },
                                            {
                                                "example_id": "1d3380c4-b557-4e8d-99b2-3bde6ad8deae",
                                                "sense_id": "f6c4f6b8-0732-3f5c-b26e-778dd52c4485",
                                                "text": "Passer entre les mailles du filet : Échapper à une surveillance, à des règles, à des prescriptions qui vous sont imposées."
                                            },
                                            {
                                                "example_id": "d9be84fa-c4d4-485e-a1aa-ed688ec033e2",
                                                "sense_id": "f6c4f6b8-0732-3f5c-b26e-778dd52c4485",
                                                "text": "Une bombe aurait-elle pu passer les mailles du filet de sécurité à Roissy-Charles de Gaulle, si la piste de l’attentat se confirmait ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3a05ca-273d-3e92-adbc-4cb9bdf72f2b",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Ouverture pratiquée dans les lisses du métier à tisser, et qui sert à recevoir les fils de la chaîne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a01358b-cf0b-4be6-bc80-3ded32afe511",
                                                "sense_id": "7d3a05ca-273d-3e92-adbc-4cb9bdf72f2b",
                                                "text": "Maille à nœuds, à crochets, à coulisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8daf21f-c153-3499-ad91-9ae88ee82f58",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Élément d'une chaîne métallique, maillon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74ec03f1-b6fb-3cca-b1bb-68470c4ebca1",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Marques, des taches qui paraissent sur les plumes du perdreau, lorsqu’il devient fort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb646a70-28b6-324b-81da-dcc1bfe89e4d",
                                        "entry_id": "f158db15-4d43-3d12-8f98-88e0a4e4a791",
                                        "glosses": [
                                            "Aspect chatoyant de la face d’une planche dont la face principale est débitée suivant le plan radial de l’arbre, dans certaines essences de bois."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
