                        "zh": [
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "因共同血统、历史、文化或语言而形成的人群共同体"
                            },
                            {
                                "target_lang_word": "国民",
                                "target_lang_sense_clarification": "指一个国家的全体人民时常用"
                            },
                            {
                                "target_lang_word": "全国人民",
                                "target_lang_sense_clarification": "强调整个国家的人民"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "658799ce-b4ba-3888-8dbe-989a6e33561c",
                    "sense_definition": "An Indigenous people in North America and their federally recognized territory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Cherokee <w>Nation</w> has its own laws and government systems.",
