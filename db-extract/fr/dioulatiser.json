                "senses": [
                    {
                        "sense_id": "d730fc2c-792d-369e-96b7-ccc433ce2944",
                        "entry_id": "087920cc-5bb5-3663-af26-f2e274452113",
                        "glosses": [
                            "Donner un caractère dioula à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61056a5b-266d-40bd-8d2f-cb62ce42863b",
                                "sense_id": "d730fc2c-792d-369e-96b7-ccc433ce2944",
                                "text": "Il semblerait que des villages aient délibérément «dioulatisé» leur nom pour faire allégeance aux troupes de Samory Touré."
                            },
                            {
                                "example_id": "19f8c664-21ab-45af-95d9-e5e3dc2dd7b4",
                                "sense_id": "d730fc2c-792d-369e-96b7-ccc433ce2944",
                                "text": "L'homme dans un français fortement dioulatisé tente de me faire comprendre le bien fondé de sa démarche."
                            },
                            {
                                "example_id": "1de68d0b-3ff4-47ac-8740-eb42c1715c58",
                                "sense_id": "d730fc2c-792d-369e-96b7-ccc433ce2944",
                                "text": "Pratiquement toute la population urbaine a « dioulatisé » son nom, les Sorho se font appeler Coulibaly et les Yéo sont devenus Ouattara."
                            }
                        ]
                    }
