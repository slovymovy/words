                "senses": [
                    {
                        "sense_id": "f914f827-a2a4-3948-a1b7-0d2f93f71dd8",
                        "entry_id": "e4293c74-fe8e-3ad2-ab91-a08fee9507ba",
                        "glosses": [
                            "stark zuckerhaltiger Brotaufstrich aus den Zapfen von Nadelbäumen, dem in der Naturheilkunde gesundheitsfördernde Wirkung zugesprochen wird"
                        ],
                        "tags": [
                            "ukrainische und sibirische Kulinarik"
                        ],
                        "examples": [
                            {
                                "example_id": "7b27ec6b-a5c5-415a-b649-b9f9c8100c43",
                                "sense_id": "f914f827-a2a4-3948-a1b7-0d2f93f71dd8",
                                "text": "„Oder du hättest eine Frühstückspension am Baikalsee und wärst in ganz Russland berühmt für deine Tannenzapfenmarmelade.“"
                            },
                            {
                                "example_id": "f10a217b-0313-48ca-8ad2-2fbb586a4c73",
                                "sense_id": "f914f827-a2a4-3948-a1b7-0d2f93f71dd8",
                                "text": "„Sie sind klein, lieben selbst gekochte Tannenzapfenmarmelade und leben friedlich mitten in einem Berg.“"
                            },
                            {
                                "example_id": "2fb4223f-f17b-4cc6-9543-5b54542f1bdd",
                                "sense_id": "f914f827-a2a4-3948-a1b7-0d2f93f71dd8",
                                "text": "„Tannenzapfenmarmelade ist eine leckere und gesunde Delikatesse, die Sie mit Ihren eigenen Händen kochen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
