                        ],
                        "examples": [
                            {
                                "example_id": "b848d92c-bd73-474e-8ad0-3581b4d92b24",
                                "sense_id": "5dd37dc1-7138-3401-9fb7-19e2a304dabf",
                                "text": "Herr Pötschke hat sich in die Kapitale aufgemacht, um dort für seine Produkte zu werben."
                            },
                            {
                                "example_id": "5ee3dec4-66b7-40a4-aacc-b52e166b03fd",
                                "sense_id": "5dd37dc1-7138-3401-9fb7-19e2a304dabf",
                                "text": "„Ein anderer großer Strom, der Dnjepr, verbindet Russland zudem mit dem Schwarzen Meer - an dessen Gestaden Konstantinopel liegt, die Kapitale des reichen byzantinischen Imperiums.“"
                            },
                            {
                                "example_id": "675e1e8f-ba4a-4cae-95eb-fd9b1aa6cb90",
                                "sense_id": "5dd37dc1-7138-3401-9fb7-19e2a304dabf",
                                "text": "„Es ist die Kapitale von Französisch-Äquatorialafrika, einer großen Kolonie der Franzosen nordwestlich des Kongo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
