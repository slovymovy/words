                        "examples": [
                            {
                                "example_id": "082831ba-fe2e-4bee-90ca-071413aee329",
                                "sense_id": "a82c611d-a552-3171-9f4c-967660640b33",
                                "text": "Computers kunnen al een tijdje heel aardig objecten op een foto herkennen, maar dat is niet genoeg om een fotobijschrift te schrijven: de computer moet ook begrijpen wat de dingen op de foto met elkaar te maken hebben. Ook moet de computer zinnen kunnen schrijven in normale mensentaal."
                            },
                            {
                                "example_id": "5b0f04fc-225f-4aaa-8a7a-2055b9d5750b",
                                "sense_id": "a82c611d-a552-3171-9f4c-967660640b33",
                                "text": "Het fotobijschrift van Diesel: 'Brother, ik zal je heel hard missen. Ik ben sprakeloos. De hemel heeft er een nieuwe engel bijgekregen. Rust in vrede.'"
                            },
                            {
                                "example_id": "c018541d-fea7-4e45-8f90-b125aafa38d2",
                                "sense_id": "a82c611d-a552-3171-9f4c-967660640b33",
                                "text": "De Volkskrant meldde vorige week in een fotobijschrift en in een artikel begin september dat prins Willem-Alexander twee boerderijen op het landgoed wil laten slopen. Volgens de RVD is de koningin eigenaar van het landgoed, en heeft zij, en niet Willem-Alexander de aanvraag voor een sloopvergunning ingediend."
                            }
                        ]
                    }
