                ],
                "senses": [
                    {
                        "sense_id": "cfea4cd4-b348-3b0c-8f02-67c25d12e591",
                        "entry_id": "2970fd39-bd18-39c5-9fec-e69c9420df31",
                        "glosses": [
                            "Remontée mécanique pour skieurs. Le principe consiste à passer entre les jambes une perche terminée par une rondelle. La perche est tractée par un câble et tire le skieur, ce dernier glissant sur la neige le long du terrain."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "47783393-3288-43ee-b38c-8c8c10f9b64d",
                                "sense_id": "cfea4cd4-b348-3b0c-8f02-67c25d12e591",
                                "text": "Un skieur montant une pente en ligne droite avec un tire-fesse à vitesse constante vérifie le principe d’inertie car les forces qui s’exercent sur le skieur se compensent (poids, réaction du support, frottements et tension du tire-fesse)."
                            },
                            {
                                "example_id": "37cd1506-9432-48f4-9981-c43b084a6a76",
                                "sense_id": "cfea4cd4-b348-3b0c-8f02-67c25d12e591",
                                "text": "Il faut faire la queue pendant dix minutes au tire-fesse !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20610ec6-aacb-4efe-9630-cc576612ae48",
                        "source_entry_id": "2970fd39-bd18-39c5-9fec-e69c9420df31",
                        "source_sense_id": "cfea4cd4-b348-3b0c-8f02-67c25d12e591",
                        "target_lang_word": "Skilift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skilift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4eefe5d6-9fc9-3cc6-96e7-a39460b07006",
                                        "entry_id": "a2b91dd3-bf4c-30bf-9fc6-beba7c39ec59",
                                        "glosses": [
                                            "eine Seilbahn, mit der Skifahrer mit Skiern befördert werden"
                                        ],
                                        "tags": [
                                            "Wintersport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a47458f-be14-4e4f-aebd-25d4fcf1de79",
                                                "sense_id": "4eefe5d6-9fc9-3cc6-96e7-a39460b07006",
                                                "text": "Skilifte sind bei Umweltschützern nicht sehr beliebt, bei den Wintersportlern jedoch hochwillkommen."
                                            },
                                            {
                                                "example_id": "97beec0a-1b2b-42e9-ae8c-2ad30f2044e4",
                                                "sense_id": "4eefe5d6-9fc9-3cc6-96e7-a39460b07006",
                                                "text": "„In Schruns gab es weder Skilifte noch Seilbahnen; nur Holzabfuhrwerke und Viehsteige, die durch verschiedene Täler ins Hochgebirge führten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
