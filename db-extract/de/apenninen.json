                ],
                "senses": [
                    {
                        "sense_id": "266e0764-7458-3246-817c-39b306ecbf4b",
                        "entry_id": "22a4c997-a46b-3d9c-bec1-53277c7779c8",
                        "glosses": [
                            "Gebirgszug, der weite Teile Italiens längs durchzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017eaff3-d9de-4367-bd84-d55c35700ec9",
                                "sense_id": "266e0764-7458-3246-817c-39b306ecbf4b",
                                "text": "„Das Schattenbild des roͤmiſchen Imperators, das ſich diesſeits der Apenninen erhalten, leiſtet der Welt jezt unendlich mehr Gutes, als ſein ſchreckhaftes Urbild im alten Rom — denn es haͤlt ein nuͤtzliches Staatsſyſtem durch Eintracht zuſammen: jenes druͤckte die thaͤtigſten Kraͤfte der Menſchheit in einer ſclaviſchen Einfoͤrmigkeit darnieder.“"
                            },
                            {
                                "example_id": "8e96c368-181c-4d59-9fa7-619150b5a2ba",
                                "sense_id": "266e0764-7458-3246-817c-39b306ecbf4b",
                                "text": "„Die Apenninen sind mir ein merkwürdiges Stück Welt.“"
                            },
                            {
                                "example_id": "07a9a920-ab72-4b43-95f7-7c538f6045fa",
                                "sense_id": "266e0764-7458-3246-817c-39b306ecbf4b",
                                "text": "„Denn als Mylady aufſtand, und uns durch das Gedraͤnge zum Hauptaltar folgte, uͤberließ ſie ſich ihren tollen Launen, ohne die mindeſte Ruͤckſicht, als ſtuͤnden wir allein auf den Apenninen.“"
                            },
                            {
                                "example_id": "0ecd49a7-4880-49f9-8f21-a3505a660991",
                                "sense_id": "266e0764-7458-3246-817c-39b306ecbf4b",
                                "text": "„Die Ursache des Bebens erklären die Wissenschaftler mit einem Driften der Apenninen in Richtung der Alpen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
