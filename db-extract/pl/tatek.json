                            {
                                "example_id": "c2830682-0982-4828-85a2-9bc788b57457",
                                "sense_id": "f3d16dec-cca0-372e-9ec1-2d029733548e",
                                "text": "Parobek szeptał mu w samo ucho: / — Tatku, wójt chce się z wami rozmówić"
                            },
                            {
                                "example_id": "ca9ffaec-7cfa-4760-8b26-e2f3d4aaa673",
                                "sense_id": "f3d16dec-cca0-372e-9ec1-2d029733548e",
                                "text": "— Tatku! Tatku! proszę Tatki! / Stało się coś okropnego! / Staś otworzył do szufladki, / I zabrał moje okładki; / I powiada że to jego"
                            }
                        ],
