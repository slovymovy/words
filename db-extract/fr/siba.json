                    {
                        "sense_id": "27ba9b13-6ae7-30b7-8bae-b045e7077ddd",
                        "entry_id": "281e3740-a15e-3c59-a2c2-df0d50ceec48",
                        "glosses": [
                            "Ancien État princier dans l’Himachal Pradesh."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "9f317dc0-e246-43b3-8365-da1c7da1b8aa",
                                "sense_id": "27ba9b13-6ae7-30b7-8bae-b045e7077ddd",
                                "text": "Siba, (Géog. mod.) province de l’empire du Mogol. Elle est bornée au nord par celle de Nagracut, au midi par celles de Gor & de Jamba, au levant par le grand Tibet, & au couchant par la province de Pengap. On voit dans sa partie septentrionale le lac d’où sort le Gange, & dans sa partie méridionale se trouve la ville & le petit royaume de Sirinagar."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
