                        "translation_id": "c7b36877-6ad7-423b-a836-d6f1be0e9d53",
                        "source_entry_id": "f3ea7d26-979a-3cdd-bb84-76586bf30253",
                        "source_sense_id": "e5ebd652-ec38-3950-8ab7-20dd2e87bc8e",
                        "source_sense_description": "fruchtlose, sinnlose Arbeit",
                        "target_lang_word": "travail de Sisyphe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "travail de Sisyphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb0ad47-b231-3d11-be8d-f1d7646e13f1",
                                        "entry_id": "f708ac2a-2c80-3105-880d-183563b5088b",
                                        "glosses": [
                                            "Travail interminable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1542bf26-835e-499f-9787-c02ea3960921",
                                                "sense_id": "2fb0ad47-b231-3d11-be8d-f1d7646e13f1",
                                                "text": "— Ça va être un travail de Sisyphe, et puis je ne sais pas à quoi il ressemble !"
                                            },
                                            {
                                                "example_id": "1ae373cb-790b-43c8-a194-9ecdf844a271",
                                                "sense_id": "2fb0ad47-b231-3d11-be8d-f1d7646e13f1",
                                                "text": "Soit poursuivre une « lutte active et dure » contre l’océan en continuant à renforcer le front de mer par des enrochements et des apports réguliers de sable – un travail de Sisyphe. Soit se résoudre à « relocaliser »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
