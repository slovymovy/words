                        ]
                    },
                    {
                        "translation_id": "d9b61043-d8e0-4e62-8226-8f5fc95c22a6",
                        "source_entry_id": "2cbf95d5-9ec8-3f4d-b9f9-e779bcbd6f10",
                        "source_sense_id": "017f08ee-6fe5-3adb-a154-5972ea21b66f",
                        "source_sense_description": "Laie, der einen besonderen liturgischen Dienst ausübt",
                        "target_lang_word": "acoliet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acoliet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f087b1a1-edcf-3ebf-8659-3352626c0b28",
                                        "entry_id": "448af58e-8f69-3562-9cf9-61cd9e963940",
                                        "glosses": [
                                            "in de Rooms-katholieke Kerk een misdienaar die ouder is dan 16 jaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1692db0c-240f-4176-bc37-662260feaeb8",
                                                "sense_id": "f087b1a1-edcf-3ebf-8659-3352626c0b28",
                                                "text": "Een salesiaan van wie bekend was dat hij leerlingen van een jongensinternaat misbruikt had, is in juli 2007 door toenmalig aartsbisschop Simonis aangesteld als acoliet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "508d5c1c-d385-3227-81cb-d36dd4d3d0c7",
                                        "entry_id": "448af58e-8f69-3562-9cf9-61cd9e963940",
                                        "glosses": [
                                            "aanhanger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db2b7bf-380e-4dcc-be4f-f0c8cc91d4c7",
                                                "sense_id": "508d5c1c-d385-3227-81cb-d36dd4d3d0c7",
                                                "text": "Dat is niet de eerste Argentijnse film die indruk maakt met zijn scherpe analyse van de recente geschiedenis van het land. Twee jaar geleden liet Juan José Campanella in zijn film El secreto de sus ojos (‘Het geheim in hun ogen’) zien hoe straffeloos de acolieten van de militaire junta indertijd hun misdaden konden begaan – al schenkt hij de kijker aan het slot wel de genade van de poëtische gerechtigheid."
                                            },
                                            {
                                                "example_id": "81b802e5-f04e-4567-a326-98389f05546a",
                                                "sense_id": "508d5c1c-d385-3227-81cb-d36dd4d3d0c7",
                                                "text": "Inmiddels heeft Trump een loyalist aangesteld als hoofd van de federale mediawaakhond, heeft hij een rechtszaak aangespannen tegen CBS wegens „Kamala-vriendelijke montage”, en houden zijn acolieten hoorzittingen die ‘systematische vooringenomenheid’ van de publieke omroep moeten aantonen. De platforms van Trumps tech-vriendjes worden ondertussen gevrijwaard van bemoeienis. Vrijheid van meningsuiting voor de onzen, vergelding voor de anderen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
