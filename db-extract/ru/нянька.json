                        "entry_id": "18139435-3c99-34c6-8f18-93ca2dd73f0e",
                        "glosses": [
                            "diminutive of ня́ня (njánja, “nurse, nanny, babysitter”)"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "38f70777-c085-4591-9d4f-4914fd52245c",
                                "sense_id": "3d0ccaf9-7347-355f-bb03-ffa25240bf7f",
                                "text": "У семи́ ня́нек дитя́ без гла́за.",
                                "translation": "Too many cooks spoil the broth. / Everybody's business is nobody's business.",
                                "english": "Too many cooks spoil the broth. / Everybody's business is nobody's business."
                            },
                            {
                                "example_id": "151a3f86-8db4-4ef3-afce-aca71eb4bdb4",
                                "sense_id": "3d0ccaf9-7347-355f-bb03-ffa25240bf7f",
                                "text": "Ня́нька забо́тится о двух младе́нцах.",
                                "translation": "A (young) nanny looks after two infants.",
                                "english": "A (young) nanny looks after two infants."
                            }
                        ]
                    }
