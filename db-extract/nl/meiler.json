                        "glosses": [
                            "een met plaggen van de lucht afsluitbare houtstapel voor het branden van houtskool"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14487d8e-30be-4170-9807-f30f85cdf7ba",
                                "sense_id": "9ca4141d-14e0-3b18-af23-f559e5c873ea",
                                "text": "Het moment waarop een brandende meiler van de lucht afgesloten moet worden luistert erg nauw."
