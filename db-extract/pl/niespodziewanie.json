                "senses": [
                    {
                        "sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                        "entry_id": "b6e8a112-d44e-3906-b017-a6a537e87c10",
                        "glosses": [
                            "w sposób nieoczekiwany, niespodziewany, powodujący zaskoczenie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2890fae1-cf35-4733-a73b-ab774b818032",
                                "sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                                "text": "Wody zalewu niespodziewanie zaczęły występować z brzegów."
                            },
                            {
                                "example_id": "8674cdfa-866a-496c-ac42-93bd4690b0c2",
                                "sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                                "text": "Niespodziewanie położyła rękę na jego udzie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a88bef66-fba3-4684-baa0-caf19c70612a",
                        "source_entry_id": "b6e8a112-d44e-3906-b017-a6a537e87c10",
                        "source_sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                        "target_lang_word": "unexpectedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexpectedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                        "entry_id": "72175067-63da-3c54-a05e-1de7d45e321c",
                                        "glosses": [
                                            "In an unexpected manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d095c36-5026-4cd2-83af-63c47a289fd5",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Near-synonyms: against expectations, against all odds, surprisingly"
                                            },
                                            {
                                                "example_id": "8cf6fecf-97a8-4b26-8697-bff936162838",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "[…] she was startled by unexpectedly meeting her husband, who was coming to seek her."
                                            },
                                            {
                                                "example_id": "38b175cb-f4be-4ff2-8de1-b1e407b3dc97",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Other evidence of former ownerships such as notice-boards, number plates, and makers' plates, are often discovered unexpectedly."
                                            },
                                            {
                                                "example_id": "4ac4a871-d192-4892-ad79-18cc1f480fce",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Texas House Democrats’ historic quorum break unexpectedly ended Thursday evening when at least three new Democrats returned to the floor, paving the way for state Republicans to pass restrictive voting legislation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be16667d-004f-4dfd-aef7-d21c43efab47",
                        "source_entry_id": "b6e8a112-d44e-3906-b017-a6a537e87c10",
                        "source_sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                        "target_lang_word": "out of the blue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "out of the blue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62887912-de42-3ed8-8c9b-dacb18ee2a11",
                                        "entry_id": "272069a3-0263-38cb-b004-a2eb8212ea04",
                                        "glosses": [
                                            "Unexpectedly; without warning or preparation."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f29e1ca8-11ff-442c-8343-3d254ef11c27",
                                                "sense_id": "62887912-de42-3ed8-8c9b-dacb18ee2a11",
                                                "text": "After I hadn’t heard from her in six months, she called me out of the blue to meet for lunch."
                                            },
                                            {
                                                "example_id": "7bbed41a-a83a-4175-90cc-bb6d154ae9c0",
                                                "sense_id": "62887912-de42-3ed8-8c9b-dacb18ee2a11",
                                                "text": "I really can't understand how something like this could simply pop up out of the blue."
                                            },
                                            {
                                                "example_id": "c844460f-97f9-4bc7-8eba-8a60ad36de7e",
                                                "sense_id": "62887912-de42-3ed8-8c9b-dacb18ee2a11",
                                                "text": "I deckhanded on a fish boat for four years and knew no fisherman likes to be called out of the blue and have his numbers demanded!"
                                            },
                                            {
                                                "example_id": "5252a699-d28c-4c29-9531-70dcb790c9b4",
                                                "sense_id": "62887912-de42-3ed8-8c9b-dacb18ee2a11",
                                                "text": "Just as it appeared Arsenal had taken the sting out of the tie, Johnson produced a moment of outrageous quality, thundering a bullet of a left foot shot out of the blue and into the top left-hand corner of Wojciech Szczesny's net with the Pole grasping at thin air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2665fb60-7d11-4937-a49c-51b3f2022c4c",
                        "source_entry_id": "b6e8a112-d44e-3906-b017-a6a537e87c10",
                        "source_sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                        "target_lang_word": "sans crier gare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans crier gare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                        "entry_id": "5596fdff-b73d-331d-8242-270ae236fade",
                                        "glosses": [
                                            "Sans prévenir ; subitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d86df6-4d95-4a9d-8e7a-fd82a157eaa4",
                                                "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                                "text": "— Conviens, mon cher, qu’on ne tombe pas chez une femme à six heures du matin, sans avoir fait crier gare la veille au soir."
                                            },
                                            {
                                                "example_id": "86c64595-78f9-4292-a286-dc8caad86b1f",
                                                "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                                "text": "Le jeune Alsacien était pâle comme un mort. Mais n’est-ce pas l’un des aspects que prend le bonheur, dans les âmes fortes, quand il y entre sans avoir crié : gare !…"
                                            },
                                            {
                                                "example_id": "852fd776-2dde-4dec-9ade-179230c7ec3f",
                                                "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                                "text": "À ce moment, la guerre tomba brutalement, sans crier gare. Le deuxième jour de mobilisation, Fagerolle se vit jeté dans un wagon à bestiaux, parmi les vomissures et les gueulements patriotiques d’un certain nombre de citoyens français."
                                            },
                                            {
                                                "example_id": "914465fd-86a5-4ba6-a842-5c388aab26a2",
                                                "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                                "text": "C’est tout justement ce jour-là, vers les quatre heures, que l’oncle Jules et la tante Rose arrivèrent sans crier gare, dans une jardinière qu’ils avaient louée à un maraîcher de Saint-Marcel."
                                            },
                                            {
                                                "example_id": "a9996ff2-6ee7-4881-9b72-9e40a1e04250",
                                                "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                                "text": "En 1955, nous étions sous le choc de la “réconciliation” soviéto-yougoslave. Sans crier gare, la troïka moscovite avait débarqué à Belgrade pour se jeter dans les bras de Tito et le couvrir de fleurs."
                                            },
                                            {
                                                "example_id": "03382eb2-c974-41bf-b4ea-0d2ccfbb0191",
                                                "sense_id": "88b1d37c-9e15-3f6d-b48c-f6c0de4394fc",
                                                "text": "Point commun entre les deux mesures : elles sont apparues sans crier gare dans le programme des candidats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d2ff8ca-0c39-4324-a866-351c0467acda",
                        "source_entry_id": "b6e8a112-d44e-3906-b017-a6a537e87c10",
                        "source_sense_id": "11947963-9b72-3474-91df-c5356cbb20e9",
                        "target_lang_word": "surprenamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surprenamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "634f59b9-6dff-3e92-83e2-ae89403eaef6",
                                        "entry_id": "6b4380ad-2cf2-32af-95e0-ce5e8fe0ae83",
                                        "glosses": [
                                            "D’une façon surprenante, à un degré surprenant."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429cef85-ae9d-4324-89a6-c4992656dbcf",
                                                "sense_id": "634f59b9-6dff-3e92-83e2-ae89403eaef6",
                                                "text": "M’est avis que son arrivée à bord coïncide bien surprenamment avec la disparition du vieux."
                                            },
                                            {
                                                "example_id": "d9f578ee-73bb-4d1d-a30b-42dfa27677de",
                                                "sense_id": "634f59b9-6dff-3e92-83e2-ae89403eaef6",
                                                "text": "Si Radio-Canada, surprenamment rapide, allait soudain s’écrier: « C’est dit. On le prend votre projet? »"
                                            },
                                            {
                                                "example_id": "1e1081dd-4b52-4d10-93ad-4ae21b6b1901",
                                                "sense_id": "634f59b9-6dff-3e92-83e2-ae89403eaef6",
                                                "text": "Avec ses 50.000 habitants, cette ville [Chieng-Maï] est surprenamment civilisée ; les routes y sont plus développées qu’à Bangkok ; on y comptait 500 bicyclettes en 1904 !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ebffac5-d4c6-40b1-8c72-76d5697b4d39",
