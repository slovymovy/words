{
    "word_family": [
        "kiszkowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3280524a-dac8-3c7e-a328-81f961534dd7",
                    "sense_definition": "rodzaj wędliny podrobowej, kaszanka lub wyrób garmażeryjny w jelicie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na obiad zjedliśmy smażoną <w>kiszkę</w> z cebulą i chlebem.",
                            "target_lang_translations": {
                                "ru": "На обед мы съели жареную <w>кровяную колбасу</w> с луком и хлебом."
                            }
                        },
                        {
                            "text": "W wiejskim sklepie kupiłem dwie pęta świeżej swojskiej <w>kiszki</w>.",
                            "target_lang_translations": {
                                "ru": "В деревенском магазине я купил два колечка свежей домашней <w>кровянки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kiszka kaszana"
                    ],
                    "common_phrases": [
                        "kiszka ziemniaczana",
                        "smażona kiszka"
                    ],
                    "target_lang_definitions": {
                        "ru": "вид колбасного изделия из субпродуктов в кишке (кровяная или крупяная колбаса)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишка",
                                "target_lang_sense_clarification": "кровяная или крупяная колбаса"
                            },
                            {
                                "target_lang_word": "кровяная колбаса",
                                "target_lang_sense_clarification": "кулинарное изделие"
                            },
                            {
                                "target_lang_word": "кровянка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11ecae22-545d-34be-9e31-b30b3a3d6e7e",
                    "sense_definition": "przewód pokarmowy, jelito u człowieka lub zwierzęcia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od rana burczało mu w <w>kiszkach</w> z wielkiego głodu.",
                            "target_lang_translations": {
                                "ru": "С самого утра у него от сильного голода урчало в <w>кишках</w>."
                            }
                        },
                        {
                            "text": "Lekarz wyjaśnił, jak działa <w>kiszka</w> stolcowa w układzie pokarmowym.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, как функционирует прямая <w>кишка</w> в пищеварительной системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "jelito"
                    ],
                    "common_phrases": [
                        "kiszka stolcowa",
                        "marsza w kiszkach"
                    ],
                    "target_lang_definitions": {
                        "ru": "пищеварительный тракт, кишка у человека или животного"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кишка",
                                "target_lang_sense_clarification": "орган пищеварения"
                            },
                            {
                                "target_lang_word": "кишечник",
                                "target_lang_sense_clarification": "орган пищеварительного тракта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ee1e99c-10c7-3832-b92e-5f7cecb816fe",
                    "sense_definition": "regionalna potrawa z tartych ziemniaków zapiekanych w jelicie wieprzowym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tradycyjna <w>kiszka</w> ziemniaczana to popularny przysmak kuchni podlaskiej.",
                            "target_lang_translations": {
                                "ru": "Традиционная картофельная <w>кишка</w> — популярное лакомство подляшской кухни."
                            }
                        },
                        {
                            "text": "Gospodyni podała gorącą <w>kiszkę</w> prosto z pieca ze skwarkami.",
                            "target_lang_translations": {
                                "ru": "Хозяйка подала горячую <w>кишку</w> прямо из печи со шкварками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kiszka ziemniaczana"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Podlasie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "традиционное блюдо из тёртого картофеля, запечённого в свиной кишке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картофельная кишка",
                                "target_lang_sense_clarification": "кулинарное блюдо"
                            },
                            {
                                "target_lang_word": "кишка",
                                "target_lang_sense_clarification": "картофельная колбаса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "570e0d40-a500-35f4-b71a-dd1e1e54d14a",
                    "sense_definition": "gumowa dętka koła rowerowego lub samochodowego",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przedmioty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas jazdy na rowerze pękła mu <w>kiszka</w> w tylnym kole.",
                            "target_lang_translations": {
                                "ru": "Во время езды на велосипеде у него лопнула <w>камера</w> в заднем колесе."
                            }
                        },
                        {
                            "text": "Muszę kupić nową <w>kiszkę</w> do koła, bo stara jest dziurawa.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новую <w>камеру</w> для колеса, потому что старая дырявая."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potocznie o dętce"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "резиновая камера велосипедного или автомобильного колеса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "камера",
                                "target_lang_sense_clarification": "шинная камера колеса"
                            },
                            {
                                "target_lang_word": "кишка",
                                "target_lang_sense_clarification": "разговорное о камере шины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9078ca36-178a-36eb-b16b-293b6c6d6abe",
                    "sense_definition": "zsiadłe mleko",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W upalny dzień gospodarz pił zimną <w>kiszkę</w> do obiadu.",
                            "target_lang_translations": {
                                "ru": "В жаркий день хозяин пил холодную <w>простоквашу</w> за обедом."
                            }
                        },
                        {
                            "text": "Babcia nalała do kubków świeżą, gęstą <w>kiszkę</w>.",
                            "target_lang_translations": {
                                "ru": "Бабушка налила в кружки свежую, густую <w>простоквашу</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Śląsk Cieszyński i Górny Śląsk"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "простокваша, кислое молоко"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простокваша",
                                "target_lang_sense_clarification": "кисломолочный продукт"
                            },
                            {
                                "target_lang_word": "кислое молоко",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8080d3f-bb2b-3129-adf8-7430633abb2c",
                    "sense_definition": "skórzany wałek lub worek wypchany włosiem",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przedmioty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szczelinę pod oknem uszczelniono dawną, wypchaną sierścią <w>kiszką</w>.",
                            "target_lang_translations": {
                                "ru": "Щель под окном заделали старым, набитым шерстью <w>валиком</w>."
                            }
                        },
                        {
                            "text": "Na starej ławie leżała podłużna, skórzana <w>kiszka</w> pełna końskiego włosia.",
                            "target_lang_translations": {
                                "ru": "На старой скамье лежал продолговатый кожаный <w>валик</w>, набитый конским волосом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dawne znaczenie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "кожаный или матерчатый валик, набитый шерстью или волосом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валик",
                                "target_lang_sense_clarification": "набивной продолговатый мешок или подушка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
