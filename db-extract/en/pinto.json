                                        "entry_id": "6d90016e-1d9c-31bf-980f-71307e127e5f",
                                        "glosses": [
                                            "auf Fell oder Stoff größere unregelmäßige Punkte oder (z.B. bei Kühen) Flächen aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0eea15-fb9b-40ba-875c-93606aef3c81",
                                                "sense_id": "bbab4f4a-58b7-3d7f-9e85-e5851571075a",
                                                "text": "Gefleckt an der Brust ließ sich der Vogel eindeutig als Singdrossel identifizieren."
                                            },
                                            {
                                                "example_id": "358ed9d8-13c2-4fd2-929c-63adb840dd68",
                                                "sense_id": "bbab4f4a-58b7-3d7f-9e85-e5851571075a",
                                                "text": "Wegen ihrer Allergie war ihre Haut im Gesicht ganz rötlich gefleckt."
                                            },
                                            {
                                                "example_id": "d1e43e33-07cf-4670-a61f-6cd1a05db754",
                                                "sense_id": "bbab4f4a-58b7-3d7f-9e85-e5851571075a",
                                                "text": "\"Raus aus dem Zelt, schneller, stellt euch in einer Reihe auf, schneller!\" Wir stolpern übereinander. Der Offizier in gefleckter Uniform brüllt. Stöße mit der Kalaschnikow in die Rippen."
                                            },
                                            {
                                                "example_id": "e737704b-587f-4620-9d94-93063e0a2722",
                                                "sense_id": "bbab4f4a-58b7-3d7f-9e85-e5851571075a",
                                                "text": "Als Erstes greift Din-Fu beherzt in einen engmaschigen Stahlkorb und zaubert eine dunkelbraun-gefleckte Schlange ans Licht."
                                            },
                                            {
                                                "example_id": "cbd6c2f8-39bf-4f07-95b3-0b74f08c3f9e",
                                                "sense_id": "bbab4f4a-58b7-3d7f-9e85-e5851571075a",
                                                "text": "Meine Favoritin blüht Anfang April, hat sich aber wegen der langen Kälte verspätet: die Gefleckte Schachblume. Es gibt keine ihresgleichen, sie, das kleine Liliengewächs, ist die ganz große Ausnahme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
