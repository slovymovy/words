                            {
                                "target_lang_word": "迪斯科",
                                "target_lang_sense_clarification": "音乐风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24af2a55-7884-3f85-aadb-f1b8ef8398f3",
                    "sense_definition": "A nightclub or venue where people dance to recorded pop music.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "place_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go to a <w>disco</w> to celebrate her birthday.",
                            "target_lang_translations": {
                                "ru": "Мы решили пойти на <w>дискотеку</w>, чтобы отпраздновать её день рождения.",
                                "zh": "我们决定去<w>迪斯科舞厅</w>庆祝她的生日。"
                            }
                        },
                        {
                            "text": "He met his friends at the local <w>disco</w> on Saturday night.",
                            "target_lang_translations": {
                                "ru": "В субботу вечером он встретился с друзьями на местной <w>дискотеке</w>.",
                                "zh": "周六晚上，他在当地的<w>迪斯科舞厅</w>和朋友们见了面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nightclub",
                        "club"
                    ],
                    "common_phrases": [
                        "at the disco",
                        "go to a disco"
