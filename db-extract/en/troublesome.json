                "senses": [
                    {
                        "sense_id": "462769e5-40f8-31bf-858b-c36b1f24bd9e",
                        "entry_id": "64de4703-371f-3d05-ace5-360ecbfe8d4c",
                        "glosses": [
                            "Causing trouble or anxiety."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1053abf0-63e7-4599-af6f-37f1a5f22aef",
                                "sense_id": "462769e5-40f8-31bf-858b-c36b1f24bd9e",
                                "text": "The computer has been very troublesome for me. It never works when I need to use it."
                            },
                            {
                                "example_id": "1a3f1254-640e-48f6-b423-72753fd1308e",
                                "sense_id": "462769e5-40f8-31bf-858b-c36b1f24bd9e",
                                "text": "As was the case with the \"Merchant Navy\" locomotives, some of these features have proved troublesome, and this in turn at times has reflected on performance as well as on maintenance."
                            },
                            {
                                "example_id": "c3c745cb-a9e6-4236-a2e7-95728755a496",
                                "sense_id": "462769e5-40f8-31bf-858b-c36b1f24bd9e",
                                "text": "The problem is that the likes of Shapps and his boss Boris Johnson are eager for a fight with the unions. They are being deliberately provocative, so they can portray railway workers as 'troublesome trots'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbc6e885-b9ca-4331-807f-ef20cc1382bf",
                        "source_entry_id": "64de4703-371f-3d05-ace5-360ecbfe8d4c",
                        "source_sense_id": "462769e5-40f8-31bf-858b-c36b1f24bd9e",
                        "source_sense_description": "giving trouble",
                        "target_lang_word": "gênant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gênant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9031e06b-4e86-394d-9002-d83dbf00086d",
                                        "entry_id": "99926081-c5ff-3a40-b14f-ed52cd9f52bd",
                                        "glosses": [
                                            "Qui gêne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8287f944-cc1a-41d7-aecd-2424306d47a0",
                                                "sense_id": "9031e06b-4e86-394d-9002-d83dbf00086d",
                                                "text": "Règle générale : un homme oublie toujours très-vite sa conduite passée, quand il lui serait gênant de s’en souvenir."
                                            },
                                            {
                                                "example_id": "2b0ffd14-14e9-44f5-a17c-b73f96e2f748",
                                                "sense_id": "9031e06b-4e86-394d-9002-d83dbf00086d",
                                                "text": "Hendri Venter, 62 ans, a capturé des images d’un lion en train de secouer sa crinière afin de se débarrasser de mouches gênantes."
                                            },
                                            {
                                                "example_id": "f600a9a3-197d-4a4d-adf7-582bc5bd476a",
                                                "sense_id": "9031e06b-4e86-394d-9002-d83dbf00086d",
                                                "text": "On ne peut pas les embarquer dans une histoire où le weekend va coûter 1 000 balles, parce que c’est gênant de leur imposer, c’est gênant de leur faire envie, et c’est gênant de les entendre dire non."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eca0277-3307-3507-bc98-728c9ed11555",
                                        "entry_id": "99926081-c5ff-3a40-b14f-ed52cd9f52bd",
                                        "glosses": [
                                            "Embarrassant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d48588-a25f-4477-ba36-7ee1c3e2b2f1",
                                                "sense_id": "1eca0277-3307-3507-bc98-728c9ed11555",
                                                "text": "Jusqu’à présent, Trump n’a pas commenté l’attaque. Son silence devient gênant pour les républicains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gênant",
                                "target_lang_code": "fr",
                                "target_senses": [
