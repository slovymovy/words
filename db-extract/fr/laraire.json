                "senses": [
                    {
                        "sense_id": "107400ec-958b-3c9d-88d6-9281f0b42f36",
                        "entry_id": "5f54a2a3-737e-3f57-8e48-dd89c3ce4111",
                        "glosses": [
                            "Autel, dans l’intérieur de la maison, où l’on honorait les dieux lares."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "3bf7ad8a-d7cf-4558-9c82-eade7c748e9a",
                                "sense_id": "107400ec-958b-3c9d-88d6-9281f0b42f36",
                                "text": "Les Romains pouvaient, dans les laraires, rendre des honneurs divins à leurs ancêtres."
                            },
                            {
                                "example_id": "e5c39f9a-4723-4d1a-bf55-bf66e8ce27b1",
                                "sense_id": "107400ec-958b-3c9d-88d6-9281f0b42f36",
                                "text": "D’un côté, la crèche manifeste, dans une scénographie verticale édifiante, la supériorité du christianisme sur les religions orientales, incarnées par les rois mages ; de l’autre, le laraire juxtapose sans hiérarchie les statuettes des Lares avec d’autres dieux d’origines variées."
                            },
                            {
                                "example_id": "207aa62d-ec04-4ca6-a283-5154d527ae71",
                                "sense_id": "107400ec-958b-3c9d-88d6-9281f0b42f36",
                                "text": "Cent ans après [sa mort], la statue de Marc-Aurèle se voyait dans un grand nombre de laraires …"
                            }
                        ]
                    }
                ],
