                    {
                        "sense_id": "a9a866f7-7775-3ab6-b63d-095694ae69f6",
                        "entry_id": "0468e9e3-1a7e-384f-9466-c71695429245",
                        "glosses": [
                            "Voiturette à deux places, roulant sur trois ou quatre roues."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0f28e257-35f9-4ff1-a2aa-66a0b3188fea",
                                "sense_id": "a9a866f7-7775-3ab6-b63d-095694ae69f6",
                                "text": "C’est un agréable roman moderniste que M. Louis Léon Martin a publié sous le titre : Le jeune homme au cyclecar."
                            },
                            {
                                "example_id": "b675ecea-5bdf-4d8e-9bfb-6cf66912d29d",
                                "sense_id": "a9a866f7-7775-3ab6-b63d-095694ae69f6",
                                "text": "Le cyclecar se répandait de plus en plus, voiture légère (inférieure à 350 kg) mais quand même pleine de puissance pour pouvoir faire partie des épreuves sur route."
                            },
                            {
                                "example_id": "dbadefe6-2725-401b-9e31-cb8916d2b891",
                                "sense_id": "a9a866f7-7775-3ab6-b63d-095694ae69f6",
                                "text": "Les vacances d’été sont en avance grâce au talent de Jacques Tati : son film les Vacances de M. Hulot fait rire les Français qui veulent bien se reconnaître dans ce célibataire excentrique qui fait le jeune homme au volant de son cyclecar Amilcar."
                            }
                        ]
                    }
                ],
