                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc850948-620f-38ff-989a-2a9762f3c228",
                                        "entry_id": "fd6cb680-9d81-382e-a31a-0b9c2317c85f",
                                        "glosses": [
                                            "The act of waiving, or not insisting on, some right, claim, or privilege."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a89a51d1-c24f-30a1-b6e1-9080db4065b4",
                                        "entry_id": "fd6cb680-9d81-382e-a31a-0b9c2317c85f",
                                        "glosses": [
                                            "A legal document removing some requirement, such as waiving a right (giving it up) or a waiver of liability (agreeing to hold someone blameless)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60069310-50db-48e0-8cb4-19d888227c19",
                                                "sense_id": "a89a51d1-c24f-30a1-b6e1-9080db4065b4",
                                                "text": "I had to sign a waiver when I went skydiving, agreeing not to sue even if something went wrong."
                                            },
                                            {
                                                "example_id": "f608ed6c-485f-4c1c-b8d2-23bbe21e69ad",
                                                "sense_id": "a89a51d1-c24f-30a1-b6e1-9080db4065b4",
                                                "text": "Sandy Alomar Jr. cleared waivers and was outrighted to Class AA Binghamton in preparation for his promotion when rosters expand Saturday."
                                            },
                                            {
                                                "example_id": "20fce2f9-6903-4c9c-9e8c-e80156c3dd50",
                                                "sense_id": "a89a51d1-c24f-30a1-b6e1-9080db4065b4",
                                                "text": "Growth Energy sent the entire report to the E.P.A., but the summary it provided with its formal waiver request — and uses in press materials — said that when using E15 and E20, “there were no significant changes in vehicle tailpipe emissions, vehicle drivability or small nonroad engine emissions as ethanol content increased.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aa3cfc1-5a05-3a45-887a-ad3d14a291f1",
                                        "entry_id": "fd6cb680-9d81-382e-a31a-0b9c2317c85f",
                                        "glosses": [
                                            "Something that releases a person from a requirement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "175b7c5d-d369-403e-83b0-e69f9a97dc9b",
                                                "sense_id": "7aa3cfc1-5a05-3a45-887a-ad3d14a291f1",
                                                "text": "I needed a waiver from the department head to take the course because I didn't technically have the prerequisite courses."
                                            },
                                            {
                                                "example_id": "40d1e542-8cc0-49ec-870a-efb182861de6",
                                                "sense_id": "7aa3cfc1-5a05-3a45-887a-ad3d14a291f1",
                                                "text": "I needed a waiver from the zoning board for the house because the lot was so small, but they let me build because it was next to the park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b70cd46-17ad-3af2-95e5-9fbf314c771b",
                                        "entry_id": "fd6cb680-9d81-382e-a31a-0b9c2317c85f",
                                        "glosses": [
                                            "The process of waiving or outlawing a person."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "waiver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b99fb40-c46f-32d9-b4ac-42033162f899",
                                        "entry_id": "bf5617c9-06a7-341c-8da4-cdf0af7200ce",
                                        "glosses": [
                                            "To waive (to relinquish, to forego)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
