                        "entry_id": "2481af59-4eba-3f80-9a52-af8013ed967c",
                        "glosses": [
                            "Qui est fainéant."
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "122b9e8d-d0f8-4650-b5b1-a8ba6596477f",
                                "sense_id": "3ff6a2a9-2cdd-3b09-ac52-1bdd88655193",
                                "text": "Une étrange langueur s’était coulée dans mes membres, une espèce de fatalité feignasse me collait la cervelle aux os du crâne… Je me suis installé dans mon destin pourri."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a0c5fe9b-d984-3ee3-89d6-1edcc99b1225",
                "word": "feignasse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a4a63c0-e697-4c16-8a33-96e782f0b57a",
