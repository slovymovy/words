                                        "sense_id": "6c17671b-4048-35c2-8ef9-9ca1e8920c1e",
                                        "entry_id": "a07f958a-a071-3191-a225-00c71deee4c9",
                                        "glosses": [
                                            "Fonds de terre, soit noble, soit roturier, exempt de tous les droits et devoirs féodaux."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33d33338-991c-4119-8382-a7dcdce78392",
                                                "sense_id": "6c17671b-4048-35c2-8ef9-9ca1e8920c1e",
                                                "text": "Vous savez que rien n’était plus commun, dans les anciens temps, que la conversion des alleux en fiefs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33ca0890-263d-46a9-aa97-b0c069127ab7",
                        "source_entry_id": "46f74c04-cc51-3dc0-8933-1f0aebf71e3c",
                        "source_sense_id": "0f02d645-d744-3166-8318-da1e15f6a7b4",
