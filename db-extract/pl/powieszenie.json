                                            "Unprotected and exposed to capture."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2165370a-846c-3bd4-a70d-8870bb5b879a",
                                        "entry_id": "6b9167f2-a923-389f-bc54-fa082fd95f14",
                                        "glosses": [
                                            "Hittable; poorly executed by the pitcher, hence relatively easy to hit."
