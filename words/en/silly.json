                            {
                                "target_lang_word": "drollig",
                                "target_lang_sense_clarification": "auf eine niedliche oder komische Weise amüsant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "894dfbb1-46d5-3515-9139-aa2526e134a7",
                    "sense_definition": "Showing a lack of good judgment or common sense; thoughtless.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "foolishness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>silly</w> mistake to leave your keys inside the car.",
                            "target_lang_translations": {
                                "ru": "Это была <w>глупая</w> ошибка — оставить ключи внутри машины.",
                                "tr": "Anahtarlarını arabanın içinde bırakmak <w>aptalca</w> bir hataydı.",
                                "de": "Es war ein <w>dummer</w> Fehler, die Schlüssel im Auto zu lassen."
                            }
                        },
                        {
                            "text": "Don't be <w>silly</w>, there is no such thing as ghosts in the attic.",
                            "target_lang_translations": {
                                "ru": "Не <w>глупи</w>, на чердаке не бывает никаких привидений.",
                                "tr": "<w>Saçmalama</w>, tavan arasında hayalet diye bir şey yoktur.",
                                "de": "Sei nicht <w>albern</w>, es gibt keine Gespenster auf dem Dachboden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly mistake",
                        "don't be silly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Демонстрирующий отсутствие здравого смысла или рассудительности; безрассудный.",
                        "tr": "Sağduyu veya iyi muhakeme eksikliği gösteren; düşüncesiz.",
                        "de": "Mangel an gesundem Menschenverstand oder Urteilsvermögen zeigend; unüberlegt."
                    },
