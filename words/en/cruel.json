{
    "word_family": [
        "cruelty",
        "cruelly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "527d85d7-1083-3eab-8309-4dd1f7bcaf1b",
                    "sense_definition": "Intentionally causing or reveling in pain and suffering; merciless, heartless.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causing_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cruel</w> king laughed at the suffering of his people.",
                            "target_lang_translations": {
                                "ru": "<w>Жестокий</w> король смеялся над страданиями своего народа.",
                                "zh": "那个<w>残忍的</w>国王对百姓的苦难发笑。",
                                "es": "El <w>cruel</w> rey se reía del sufrimiento de su pueblo."
                            }
                        },
                        {
                            "text": "It is <w>cruel</w> to keep a large dog in such a small cage.",
                            "target_lang_translations": {
                                "ru": "Держать большую собаку в такой маленькой клетке — <w>жестоко</w>.",
                                "zh": "让一只大狗待在这么小的笼子里太<w>残忍</w>了。",
                                "es": "Es <w>cruel</w> mantener a un perro grande en una jaula tan pequeña."
                            }
                        }
                    ],
                    "synonyms": [
                        "sadistic",
                        "brutal",
                        "mean",
                        "unkind"
                    ],
                    "antonyms": [
                        "merciful"
                    ],
                    "common_phrases": [
                        "cruel joke",
                        "cruel punishment",
                        "cruel to animals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно причиняющий боль или наслаждающийся страданиями; безжалостный, бессердечный.",
                        "zh": "故意造成或欣赏他人的痛苦与折磨的；残忍的，冷酷无情的。",
                        "es": "Que causa dolor y sufrimiento intencionadamente; despiadado, sin corazón."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "причиняющий боль"
                            },
                            {
                                "target_lang_word": "бессердечный",
                                "target_lang_sense_clarification": "не имеющий сочувствия"
                            },
                            {
                                "target_lang_word": "безжалостный",
                                "target_lang_sense_clarification": "не знающий жалости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "残忍",
                                "target_lang_sense_clarification": "故意让人受苦、没有同情心"
                            },
                            {
                                "target_lang_word": "无情",
                                "target_lang_sense_clarification": "冷酷无情"
                            },
                            {
                                "target_lang_word": "狠心",
                                "target_lang_sense_clarification": "狠毒，不留情面"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cruel",
                                "target_lang_sense_clarification": "que goza del sufrimiento ajeno"
                            },
                            {
                                "target_lang_word": "despiadado",
                                "target_lang_sense_clarification": "que no muestra piedad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce622be9-cd09-3c71-9e33-054d28b0854c",
                    "sense_definition": "Harsh; severe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harsh_conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a very <w>cruel</w> winter this year with freezing temperatures.",
                            "target_lang_translations": {
                                "ru": "В этом году у нас была очень <w>суровая</w> зима с морозами.",
                                "zh": "今年我们经历了一个非常<w>严酷的</w>冬天，气温降到了冰点以下。",
                                "es": "Tuvimos un invierno muy <w>duro</w> este año con temperaturas bajo cero."
                            }
                        },
                        {
                            "text": "Fate played a <w>cruel</w> trick on him just when he thought he was safe.",
                            "target_lang_translations": {
                                "ru": "Судьба сыграла с ним <w>жестокую</w> шутку как раз тогда, когда он думал, что находится в безопасности.",
                                "zh": "就在他以为自己已经安全的时候，命运跟他开了一个<w>残酷的</w>玩笑。",
                                "es": "El destino le jugó una <w>cruel</w> pasada justo cuando pensaba que estaba a salvo."
                            }
                        }
                    ],
                    "synonyms": [
                        "brutal"
                    ],
                    "common_phrases": [
                        "cruel winter",
                        "cruel world",
                        "cruel fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Суровый; тяжкий; беспощадный (о погоде, условиях или судьбе).",
                        "zh": "严厉而难以承受的；苛刻的，恶劣的，常用于天气、处境或命运。",
                        "es": "Áspero, severo o difícil de soportar (referido a condiciones, clima o destino)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о климате или условиях"
                            },
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "беспощадный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严酷",
                                "target_lang_sense_clarification": "指天气、环境等很恶劣"
                            },
                            {
                                "target_lang_word": "残酷",
                                "target_lang_sense_clarification": "指命运、现实等无情而痛苦"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "duro",
                                "target_lang_sense_clarification": "difícil de soportar"
                            },
                            {
                                "target_lang_word": "cruel",
                                "target_lang_sense_clarification": "arduo y doloroso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a4a94e-47ec-330e-a709-b42a84b0aa85",
                    "sense_definition": "Cool; awesome; neat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new car looks absolutely <w>cruel</w> with those shiny wheels.",
                            "target_lang_translations": {
                                "ru": "Эта новая машина с этими блестящими колесами выглядит просто <w>круто</w>.",
                                "zh": "那辆新车配上那些闪亮的轮子，看起来简直太<w>酷</w>了。",
                                "es": "Ese coche nuevo se ve absolutamente <w>guay</w> con esas llantas brillantes."
                            }
                        },
                        {
                            "text": "He thought his new jacket was <w>cruel</w>, but nobody else liked it.",
                            "target_lang_translations": {
                                "ru": "Он считал, что его новая куртка <w>крутая</w>, но больше она никому не понравилась.",
                                "zh": "他觉得自己的新夹克很<w>酷</w>，可别人都不喜欢。",
                                "es": "Él pensaba que su chaqueta nueva era <w>chula</w>, pero a nadie más le gustó."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крутой; отличный; классный (сленг).",
                        "zh": "很酷、很棒、很吸引人的（俚语，且较过时）。",
                        "es": "Genial, excelente, muy bueno (jerga)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酷",
                                "target_lang_sense_clarification": "俚语，表示很时髦、很厉害"
                            },
                            {
                                "target_lang_word": "很棒",
                                "target_lang_sense_clarification": "口语，表示很不错"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "guay",
                                "target_lang_sense_clarification": "coloquial, excelente"
                            },
                            {
                                "target_lang_word": "chulo",
                                "target_lang_sense_clarification": "coloquial, atractivo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8d82b0b-bfa9-3465-a946-6011b71f66bb",
                    "sense_definition": "To spoil or ruin one's chance of success.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden rainstorm <w>cruelled</w> our plans for a beach picnic.",
                            "target_lang_translations": {
                                "ru": "Внезапный ливень <w>сорвал</w> наши планы на пикник на пляже.",
                                "zh": "突如其来的暴雨<w>毁掉了</w>我们去海滩野餐的计划。",
                                "es": "La repentina tormenta <w>arruinó</w> nuestros planes para un picnic en la playa."
                            }
                        },
                        {
                            "text": "A bad injury <w>cruelled</w> his chances of playing in the final match.",
                            "target_lang_translations": {
                                "ru": "Серьезная травма <w>погубила</w> его шансы сыграть в финальном матче.",
                                "zh": "一次严重的受伤<w>断送了</w>他参加决赛的机会。",
                                "es": "Una mala lesión <w>arruinó</w> sus posibilidades de jugar en el partido final."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australian and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испортить или разрушить шансы на успех.",
                        "zh": "破坏或葬送成功的机会；使计划落空。",
                        "es": "Arruinar o estropear las posibilidades de éxito de alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорвать",
                                "target_lang_sense_clarification": "планы"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "шансы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毁掉",
                                "target_lang_sense_clarification": "使计划等落空"
                            },
                            {
                                "target_lang_word": "断送",
                                "target_lang_sense_clarification": "使机会彻底失去"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "arruinar",
                                "target_lang_sense_clarification": "estropear planes o planes"
                            },
                            {
                                "target_lang_word": "echar a perder",
                                "target_lang_sense_clarification": "frase hecha para arruinar algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13bb87de-64b5-339b-b799-e046b0039cda",
                    "sense_definition": "To violently provoke a child in the belief that this will make them more assertive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The anthropologist studied the practice of <w>cruelling</w> in the remote tribe.",
                            "target_lang_translations": {
                                "ru": "Антрополог изучал практику <w>ожесточения</w> в отдаленном племени.",
                                "zh": "那位人类学家研究了那个偏远部落里<w>故意刺激孩子</w>的做法。",
                                "es": "El antropólogo estudió la práctica de <w>endurecer</w> a los niños en la tribu remota."
                            }
                        },
                        {
                            "text": "Some cultures believe that <w>cruelling</w> a child prepares them for a harsh life.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах считают, что <w>ожесточение</w> ребенка готовит его к суровой жизни.",
                                "zh": "有些文化认为，<w>故意刺激孩子</w>能让他们为艰苦的生活做好准备。",
                                "es": "Algunas culturas creen que <w>endurecer</w> a un niño lo prepara para una vida difícil."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "anthropological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно провоцировать ребенка, чтобы воспитать в нем стойкость или агрессию.",
                        "zh": "故意以激烈方式刺激孩子，认为这样能让他们变得更强硬或更有攻击性。",
                        "es": "Provocar intencionadamente a un niño para intentar hacerlo más fuerte o agresivo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожесточать",
                                "target_lang_sense_clarification": "делать жестоким"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "故意刺激孩子",
                                "target_lang_sense_clarification": "在民族志语境中，指通过激烈刺激来让孩子更强硬"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "endurecer",
                                "target_lang_sense_clarification": "hacer a alguien más fuerte ante la adversidad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "be6d3d8b-1b43-3f1a-9796-ac52b807139b",
                    "sense_definition": "To a great degree; terribly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My back has been aching something <w>cruel</w> all day long.",
                            "target_lang_translations": {
                                "ru": "У меня весь день <w>ужасно</w> болела спина.",
                                "zh": "我的背一整天都疼得<w>厉害</w>。",
                                "es": "Me ha estado doliendo la espalda <w>terriblemente</w> todo el día."
                            }
                        },
                        {
                            "text": "He treats his staff <w>cruel</w> when he is in a bad mood.",
                            "target_lang_translations": {
                                "ru": "Он обращается со своими сотрудниками <w>жестоко</w>, когда он в плохом настроении.",
                                "zh": "他心情不好时，对员工的态度<w>非常</w>差。",
                                "es": "Trata a su personal <w>cruelmente</w> cuando está de mal humor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "something cruel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В сильной степени; ужасно.",
                        "zh": "到很大程度；非常，厉害地（口语，有方言色彩）。",
                        "es": "En gran medida; terriblemente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "очень сильно"
                            },
                            {
                                "target_lang_word": "жестоко",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厉害",
                                "target_lang_sense_clarification": "口语，表示程度很高"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "表示非常、特别"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "terriblemente",
                                "target_lang_sense_clarification": "en grado extremo"
                            },
                            {
                                "target_lang_word": "muchísimo",
                                "target_lang_sense_clarification": "en gran cantidad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d52d4f15-6d57-3cfc-ba70-264d09e3e422",
                    "sense_definition": "Alternative form of crewel (a type of embroidery yarn).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought some fine <w>cruel</w> to finish her embroidery project.",
                            "target_lang_translations": {
                                "ru": "Она купила качественный <w>гарус</w>, чтобы закончить свою вышивку.",
                                "zh": "她买了一些上好的<w>绣线</w>来完成她的刺绣作品。",
                                "es": "Ella compró un poco de <w>lana</w> fina para terminar su proyecto de bordado."
                            }
                        },
                        {
                            "text": "The pattern required a specific shade of <w>cruel</w> that was hard to find.",
                            "target_lang_translations": {
                                "ru": "Для узора требовался особый оттенок <w>гаруса</w>, который было трудно найти.",
                                "zh": "这个图案需要一种很难找到的特定颜色的<w>绣线</w>。",
                                "es": "El patrón requería un tono específico de <w>lana</w> que era difícil de encontrar."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of crewel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Альтернативное написание слова crewel (вид шерстяной пряжи).",
                        "zh": "crewel 的另一种拼写，指一种用于刺绣的毛线。",
                        "es": "Tipo de hilo de lana utilizado para bordar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гарус",
                                "target_lang_sense_clarification": "пряжа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绣线",
                                "target_lang_sense_clarification": "用于刺绣的线"
                            },
                            {
                                "target_lang_word": "刺绣毛线",
                                "target_lang_sense_clarification": "一种较粗的刺绣用毛线"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lana para bordar",
                                "target_lang_sense_clarification": "hilo específico para bordado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}