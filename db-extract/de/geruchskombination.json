                "senses": [
                    {
                        "sense_id": "43c04f3f-0bb9-30ee-aa8c-494f77cc2d8c",
                        "entry_id": "454283d4-ccdd-3193-b406-c4e6c3f607d6",
                        "glosses": [
                            "die Verbindung, Verknüpfung, Zusammenfügung von Geruchsstoffen oder von Gerüchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a1eb21c-3a69-444a-83be-c1598e42b097",
                                "sense_id": "43c04f3f-0bb9-30ee-aa8c-494f77cc2d8c",
                                "text": "„In die Geruchskombination aus brennendem Abfall und Autoabgasen mischt sich jetzt auch der Duft von gebratenem Fleisch, das an mobilen Imbissständen verkauft wird.“"
                            },
                            {
                                "example_id": "cecd5b5b-c893-400b-90b8-d44c8a74750e",
                                "sense_id": "43c04f3f-0bb9-30ee-aa8c-494f77cc2d8c",
                                "text": "„Eine faszinierende Geruchskombination aus ätherischen Ölen, die Ihre Sinne tanzen lässt.“"
                            },
                            {
                                "example_id": "a01d2ed7-d709-4078-9207-9c3a312db19a",
                                "sense_id": "43c04f3f-0bb9-30ee-aa8c-494f77cc2d8c",
                                "text": "„Die Geruchskombination aus Orange, Mirabelle und Apfel mit einem Hauch von Vanille und weißen Rosen lädt zum Verführen ein. Und so lieben es doch die Männer, oder nicht ;) ?“"
                            },
                            {
                                "example_id": "f951041c-c803-40c3-bdc4-c03959b2d155",
                                "sense_id": "43c04f3f-0bb9-30ee-aa8c-494f77cc2d8c",
                                "text": "„Der Hund lernt, nach einer bestimmten Geruchskombination, die der bestimmte Gegenstand innehat, zu suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
