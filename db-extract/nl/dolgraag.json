                            {
                                "example_id": "bcf9b407-bb87-4729-b1ec-f391966967b4",
                                "sense_id": "a9e5fdba-7011-3cb9-bfed-b4103e6a48f2",
                                "text": "Bij het eerstvolgende open veldje aan het water gooiden we onze spullen neer. Ik wilde dolgraag een keer verse vis vangen en op een kampvuurtje grillen."
                            },
                            {
                                "example_id": "9cb7a4d4-d378-4f7c-bf36-a2b4b92224d3",
                                "sense_id": "a9e5fdba-7011-3cb9-bfed-b4103e6a48f2",
                                "text": "En zij had dolgraag willen geloven dat hij begrip had voor hun situatie, hoe uniek die was, hoe lastig, maar de aandacht waard."
                            }
                        ]
                    }
                ],
