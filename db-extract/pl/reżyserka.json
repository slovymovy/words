                                        "glosses": [
                                            "žena řídící produkci filmu nebo divadelní hry apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80332196-fce0-488d-9391-8a4e62918400",
                                                "sense_id": "9d741318-06f5-3b78-b94c-097ebf465e43",
                                                "text": "Paní režisérce jsme položili pár otázek k jejímu novému filmu."
                                            }
