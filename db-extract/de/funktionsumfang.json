                "senses": [
                    {
                        "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                        "entry_id": "e92a4111-5aea-3cc8-b099-ba82fca72588",
                        "glosses": [
                            "Menge der zu leistenden Aufgaben eines Gerätes/einer Software"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "eefab0dd-dba1-4d37-a18c-6dbd5935c31f",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Smartphones gelten als Hosentaschen-Computer: Sie sind klein, leicht und haben einen immensen Funktionsumfang.“"
                            },
                            {
                                "example_id": "cd64fe73-17a7-4865-b146-2b9a0ad675d9",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "Bei Bedarf kann man den Funktionsumfang der Software durch Add-ons erweitern."
                            },
                            {
                                "example_id": "fe54c7ab-d81a-4767-acf4-89e05944372b",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Für eine kostenlose App ist der Funktionsumfang beachtlich.“"
                            },
                            {
                                "example_id": "549ea00f-c83f-4063-b8e3-36de5f51a885",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Die kostenlose App eines großen Sportartikel-Herstellers bietet einen Funktionsumfang, den man sonst nur von teuren Fitness-Apps kennt,“ […]."
                            },
                            {
                                "example_id": "b843aabf-8755-4cc3-a065-beff629bfd2b",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Man muss sich mit der App genauer beschäftigen, um den Funktionsumfang wirklich komplett zu nutzen.“"
                            },
                            {
                                "example_id": "1ccedf84-157c-4b5f-bf13-71f8144314a5",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "[Über Bildbearbeitungssoftware] „Der Funktionsumfang der kostenlosen Version ist allerdings relativ begrenzt.“"
                            },
                            {
                                "example_id": "fac0af3d-8a46-44e7-b574-9af2580f17fc",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "[Über Bildbearbeitungssoftware] „Hinsichtlich der Systemanforderungen ist das Programm vergleichsweise anspruchsvoll, was aber aufgrund des großen Funktionsumfangs allerdings nicht verwunderlich ist.“"
                            },
                            {
                                "example_id": "12c17fef-4124-4852-8736-e80debfed4f8",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Am einfachsten gelingt das mit dem Programm TinkerTool System 7 (20 €), in dessen Testbetrieb Sie sechsmal den vollen Funktionsumfang nutzen können.“"
                            },
                            {
                                "example_id": "41f12010-36a9-4e97-8234-ff298c91f2a8",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Home-Editionen gibt es schon seit Windows XP und bis heute zeichnen sie sich durch besonders mageren Funktionsumfang aus.“"
                            },
                            {
                                "example_id": "207d8693-7dab-4063-b7a2-1f4b11cb8b01",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Die beliebte Chat-App WeChat, ursprünglich ein Klon von WhatsApp, ist seinem amerikanischen Vorbild mittlerweile im Funktionsumfang klar überlegen.“"
                            },
                            {
                                "example_id": "688f5368-bd66-4f94-bc42-8a51a4ce270b",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Der Funktionsumfang kann individuell konfiguriert werden, da es möglich ist, Funktionen einzeln zu aktivieren.“"
                            },
                            {
                                "example_id": "e29bda93-c14a-4443-a761-dfa5d4ef451b",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Generell können Hersteller in Hinblick auf den Funktionsumfang vieles selbst entscheiden.“"
                            },
                            {
                                "example_id": "7ad06801-2639-448c-8993-693e2b9e8644",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Dafür hat der Hersteller Hak5 den Funktionsumfang erweitert.“"
                            },
                            {
                                "example_id": "e8636403-cd51-4db0-981c-061e22318a2f",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Als kostenloses Pendant zu Microsoft Office bietet LibreOffice einen ähnlich großen Funktionsumfang.“"
                            },
                            {
                                "example_id": "4d73d1c7-8c47-415c-9d7b-1691a59e6cae",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Mit OpenOffice steht eine Gratis-Software zur Verfügung, welche einen ähnlichen Funktionsumfang hat.“"
                            },
                            {
                                "example_id": "e20b3208-a482-4072-b7c5-d8509a55fa3c",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "Ich denke, dass 70% des Funktionsumfangs einer Tabellenkalkulation von den Anwendern nie genutzt wird."
                            },
                            {
                                "example_id": "976bb167-3624-4146-b5e2-9967ce4aedfe",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Von Drittanbietern gibt es populäre Dateimanager mit größerem Funktionsumfang, wie etwa der freie WinSCP oder Shareware-Dateimanager Total Commander,“ […]."
                            },
                            {
                                "example_id": "2a87d1a0-57ea-4243-9c95-8cbbf4c0c464",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Die für einen nicht-kommerziellen Einsatz verfügbare SketchUp Make-Version (2017 eingestellt) läuft 30 Tage mit dem vollen Funktionsumfang der SketchUp Pro-Version und danach mit reduziertem Funktionsumfang weiter.“"
                            },
                            {
                                "example_id": "1c04cd0c-6570-4bbd-8a0a-96fde7c1b16e",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Trotz einiger Gemeinsamkeiten haben Kryptowährungen unterschiedliche Fähigkeiten. Insbesondere Ethereum und einige neuere Währungen werben mit einem größeren Funktionsumfang als Bitcoin, der weit über das einfache Bezahlen hinausgeht.“"
                            },
                            {
                                "example_id": "76382d46-0ced-4ab3-b19e-ee629692e638",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "[…] „Bislang ist es das beste Gerät auf dem Markt. Zudem: der Funktionsumfang ist ungeschlagen.“"
                            },
                            {
                                "example_id": "98804af1-dfc6-453f-ace7-23cf657c61df",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Tipps zur Ausstattung bei DAB+ Radios – Die Modelle unterscheiden sich bei den Bedienfunktionen, in der Ausführung und beim Funktionsumfang.“"
                            },
                            {
                                "example_id": "cc19c42c-7f14-4e91-b16a-f8da8a141886",
                                "sense_id": "8105b4f2-2249-3593-863f-7a6691502db2",
                                "text": "„Suchen Sie nach einem bestimmten Funktionsumfang, dann müssen Sie zwangsläufig mehr Geld ausgeben – “[…]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
