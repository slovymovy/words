                "senses": [
                    {
                        "sense_id": "07d1a82b-1463-38ea-997c-54081462583b",
                        "entry_id": "a6b855c1-427c-36e0-859d-1bd04891f704",
                        "glosses": [
                            "Qui cause des ravages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee8f86c-9b40-43a1-88bc-1975f7b7a46e",
                                "sense_id": "07d1a82b-1463-38ea-997c-54081462583b",
                                "text": "On l’oublie un peu, mais les scientifiques de la Santé publique sont davantage des experts en prévention, plutôt habitués à lutter contre le tabagisme et l’obésité qu’à traquer un ennemi mortel, ravageur et invisible."
                            },
                            {
                                "example_id": "7a7882b7-19dc-4d5d-acd0-1beb406cbbb1",
                                "sense_id": "07d1a82b-1463-38ea-997c-54081462583b",
                                "text": "Monsieur Hulot a bousculé tous les usages du tennis, avec son service ravageur, mais sa victoire ne lui a pas fait gagner un pouce dans l’approche de la jolie blonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1b2b055-db69-3890-894d-9380f8879783",
                        "entry_id": "a6b855c1-427c-36e0-859d-1bd04891f704",
                        "glosses": [
                            "Qui cause des ravages, en parlant d'animaux nuisibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5e2047-0d93-45eb-a8c9-7943c3b6ef1e",
                                "sense_id": "f1b2b055-db69-3890-894d-9380f8879783",
                                "text": "Un sanglier ravageur."
                            },
                            {
                                "example_id": "6ff331ea-bf6f-4a62-99f1-ac939a395e04",
                                "sense_id": "f1b2b055-db69-3890-894d-9380f8879783",
                                "text": "Les insectes ravageurs du blé."
                            }
                        ]
                    },
                    {
                        "sense_id": "33b74a21-a541-3a33-8dde-d63c6bbc8a5d",
                        "entry_id": "a6b855c1-427c-36e0-859d-1bd04891f704",
                        "glosses": [
                            "Particulièrement séduisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deea9288-14f3-4474-b8b4-afe93e0147a9",
                                "sense_id": "33b74a21-a541-3a33-8dde-d63c6bbc8a5d",
                                "text": "Un sourire ravageur."
                            }
                        ]
                    }
