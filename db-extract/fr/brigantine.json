                                "example_id": "e4784c10-ef81-40b6-9573-51b220f112d4",
                                "sense_id": "f653e281-2cc0-3f51-bc27-6da778f40db6",
                                "text": "Le capitaine don Orteva se trouva dès lors sous le vent du navire, masqué par la brigantine."
                            },
                            {
                                "example_id": "c70a4926-1af7-4faa-9af2-b85c2e8b2b17",
                                "sense_id": "f653e281-2cc0-3f51-bc27-6da778f40db6",
                                "text": "[…], ce sont de grandes chaloupes ne dépassant pas dix mètres, pourvues d’un seul mât au premier tiers, et d’une brigantine surmontée d’un hunier."
                            }
                        ]
                    },
