                        "sense_id": "5cf763d4-0368-3eb3-8cd8-9163cac87ec3",
                        "entry_id": "b2086a0a-bf32-38e3-bef3-97855a181b61",
                        "glosses": [
                            "Archaic form of bun (“sweetened bread roll”)."
                        ],
                        "tags": [
                            "alt-of",
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d5ecda7e-5e70-47aa-9811-737cf735b531",
                                "sense_id": "5cf763d4-0368-3eb3-8cd8-9163cac87ec3",
                                "text": "Such is the general hurry and confusion in the principal streets, such as Castle Street, Lord Street, Pool Lane, Paradise Street, &c. that often passengers take up a bunn, a cake, or some fruit, as they pass the shop of a confectioner or fruit-seller, without stopping, and throw in the pay without inquiring the price."
                            },
                            {
                                "example_id": "41db1adc-2fd9-4760-a197-d1bce66e26a2",
                                "sense_id": "5cf763d4-0368-3eb3-8cd8-9163cac87ec3",
                                "text": "\"Oh,\" she replied, \"when I came to think of it, I saw, that you were right. I thought, 'twas quite likely it would draw a blank. Crust, the baker, offered me what I gave for it, and a sheet of bunns, to boot, and I let him have it, three weeks ago. […]"
                            }
                        ]
                    }
