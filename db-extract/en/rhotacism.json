                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f6b93a0-4449-4cc7-bb09-9924f86d674a",
                                                "sense_id": "768d0e10-5ed2-3b06-91a0-9447bb183dd1",
                                                "text": "Или возьмем знаменитый латинский ротацизм, когда звук z якобы внезапно (в историческом масштабе) перешел в r."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b2ffa8b-210d-3e10-aaa8-8bf854f329cd",
                                        "entry_id": "45774a36-2ca7-3c94-9605-411a22f42beb",
                                        "glosses": [
                                            "мед. нарушение произношения звука [р]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c3ed2ed-f489-437f-a81b-fd3836678fbf",
                                                "sense_id": "6b2ffa8b-210d-3e10-aaa8-8bf854f329cd",
                                                "text": "Подобным же образом выделяется губно-губной ротацизм (так называемое «кучерское» «р», образуемое вибрацией обеих губ)."
                                            }
                                        ]
                                    }
                                ]
                            }
