                    },
                    {
                        "form_id": "e955cd5d-7939-44eb-866b-aab948f5595c",
                        "entry_id": "e8c9c51e-19a5-3693-964e-18f7c65a8a38",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unwissbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                        "entry_id": "e8c9c51e-19a5-3693-964e-18f7c65a8a38",
                        "glosses": [
                            "so, dass es nicht gekannt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf5210e-51d4-45bd-a8c1-c3dc8cfdaed8",
                                "sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                                "text": "„Daß gar kein Wissbares, daß nichts unwissbar sei, / Ist einerlei im Sinn, im Ausdruck zweierlei.“"
                            },
                            {
                                "example_id": "8724003e-2dd2-4031-8144-dc99997f7abb",
                                "sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                                "text": "„Philosophieren besteht in der vollen Offenheit für das an den Grenzen des Wissens sich unwissbar Zeigende.“"
                            },
                            {
                                "example_id": "eecd4818-73e6-4ece-84c5-ffc55ac0985a",
                                "sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                                "text": "„Und plötzlich merkst Du, wie groß die Welt ist, wie unsagbar, undenkbar und unwissbar groß.“"
                            },
                            {
                                "example_id": "1f0ab849-28ed-4a69-a1a1-a55aab398964",
                                "sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                                "text": "„Problematischer Idealismus. These: dass die von uns unabhängige Welt unwissbar sei.“"
                            },
                            {
                                "example_id": "519aa50a-5fdc-41fb-bfb3-bd9a003b4526",
                                "sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                                "text": "„… für unterschiedliche Typen physikalischer Begriffe wird eine reale Referenz bestritten oder für unwissbar gehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cb15186-34a9-472f-b52e-84dffb37167c",
                        "source_entry_id": "e8c9c51e-19a5-3693-964e-18f7c65a8a38",
                        "source_sense_id": "f382b413-3308-3e4d-ab0c-38d5d8ac5564",
                        "source_sense_description": "so, dass es nicht gekannt werden kann",
                        "target_lang_word": "unknowable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unknowable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "533e7828-2298-30a9-a67e-d03d41c62265",
                                        "entry_id": "e66d0e63-a62b-3da1-b586-49e480dc151b",
                                        "glosses": [
                                            "Not knowable; not able to be known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2ef210-16f3-4653-a5fc-c90e2e242e73",
                                                "sense_id": "533e7828-2298-30a9-a67e-d03d41c62265",
                                                "text": "Number fourteen: Some of the things you need to know are things that are unknowable."
                                            },
                                            {
                                                "example_id": "92dbdd91-9852-4053-b455-61d696023fa2",
                                                "sense_id": "533e7828-2298-30a9-a67e-d03d41c62265",
                                                "text": "The mascot for the manosphere, Andrew Tate, believes that women belong at home, are a man’s property, and shouldn’t be able to drive. And an unknowable amount of young men are following this rhetoric through sites like Reddit, 4chan, and YouTube. But once they fall down the rabbit hole of the manosphere, is there any getting out?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unknowable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba57d00a-e70c-38de-8e02-97c82d783650",
                                        "entry_id": "887bd742-e0f4-382e-aac3-963eaa8ff76b",
                                        "glosses": [
                                            "Something that cannot be known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d55587-d5b7-4186-9150-c644e5a31e25",
                                                "sense_id": "ba57d00a-e70c-38de-8e02-97c82d783650",
                                                "text": "That night I think of other unknowables. How much love does one need in a lifetime? Is there a quantity of brain space that is allocated to love? And for those of us who have loved less, does this space become occupied by something else? Like cricket, or religion, perhaps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
