        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4ba8188-2df5-30dd-9086-7aeaebc416e0",
                    "sense_definition": "The Christian sacrament in which consecrated bread and wine are consumed in remembrance of Jesus; the Eucharist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire family gathered at the cathedral to celebrate her first <w>communion</w>."
                        },
                        {
                            "text": "The priest invited all church members forward to receive <w>communion</w> during the service."
                        }
                    ],
                    "synonyms": [
                        "sacrament"
                    ],
                    "common_phrases": [
                        "holy communion",
                        "first communion",
                        "receive communion",
                        "take communion"
                    ]
                },
                {
                    "sense_id": "b373e07b-3790-30a6-8ec7-fdb2763724e7",
                    "sense_definition": "A deep sharing or joining together of intimate thoughts, feelings, or spirits; close rapport.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a quiet sense of <w>communion</w> with nature while walking in the forest."
                        },
                        {
                            "text": "The two poets shared an unspoken intellectual <w>communion</w> that lasted for decades."
                        }
                    ],
                    "common_phrases": [
                        "communion with nature"
                    ]
                },
                {
                    "sense_id": "3bd97e47-3760-3dc7-b30b-b1704209bcbf",
                    "sense_definition": "A body of Christians who share common religious beliefs and ecclesiastical fellowship; a denomination or federation of churches.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worldwide Anglican <w>communion</w> consists of millions of members across several continents."
                        },
                        {
                            "text": "Differences over church governance threatened to fracture the global <w>communion</w>."
                        }
                    ],
                    "common_phrases": [
                        "anglican communion"
                    ]
                },
                {
                    "sense_id": "b29f34c7-f070-3598-80af-c923c4e6654f",
                    "sense_definition": "Mutual recognition and religious fellowship between different Christian churches or between an individual and a church.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local parish remained in full <w>communion</w> with the Holy See."
                        },
                        {
                            "text": "Scholars debated whether the two separated churches could ever reenter into full <w>communion</w>."
                        }
                    ],
                    "common_phrases": [
                        "full communion",
                        "in communion with"
                    ]
                }
            ]
        },
