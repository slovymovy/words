                "senses": [
                    {
                        "sense_id": "e9dbac4b-1b8b-32cd-bd64-22b69ebcf767",
                        "entry_id": "2b776902-88ec-3798-adc5-da9f729dc1e1",
                        "glosses": [
                            "russisch für Ausweis, Passierschein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc00ba85-827d-4524-8183-8a6a23feefbd",
                                "sense_id": "e9dbac4b-1b8b-32cd-bd64-22b69ebcf767",
                                "text": "„›Das ist ein Propusk von einem Oberst des NKWD, der uns ermächtigt, Eier zu besorgen. Was sagst du jetzt?‹ ›Hast du auch einen von Stalin, der dich ermächtigt, dir den Hintern abzuwischen?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b1d2239-75b5-4de5-b3a2-53a0d08c395a",
                        "source_entry_id": "2b776902-88ec-3798-adc5-da9f729dc1e1",
                        "source_sense_id": "e9dbac4b-1b8b-32cd-bd64-22b69ebcf767",
                        "source_sense_description": "russisch für Ausweis, Passierschein",
                        "target_lang_word": "пропуск",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пропуск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cda76f3b-325b-3f50-a94c-031e5d8f17aa",
                                        "entry_id": "abcbc0f2-1f69-3fc7-a739-ba0ae26288ab",
                                        "glosses": [
                                            "действие по значению гл. пропускать (пропустить)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e69c9e76-3416-4443-bf4f-93cf95b221ed",
                                                "sense_id": "cda76f3b-325b-3f50-a94c-031e5d8f17aa",
                                                "text": "В итоге диспетчер может принять решение о задержке груза в пути или, наоборот, о скорейшем пропуске состава."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f897e6e-4c44-3c4f-b9a1-01786ed87b98",
                                        "entry_id": "abcbc0f2-1f69-3fc7-a739-ba0ae26288ab",
                                        "glosses": [
                                            "упущение, исключение, невыполнение или отсутствие чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd7e87f3-a9d6-42e1-ad5e-bcd192b0b6e9",
                                                "sense_id": "9f897e6e-4c44-3c4f-b9a1-01786ed87b98",
                                                "text": "Поэтому пропуск срока подачи кассационной жалобы, неявка в судебное заседание и т. п. далеко не всегда могут быть причиной убытков доверителя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa90abd5-1014-3c65-b2d7-c49df70a17e2",
                                        "entry_id": "abcbc0f2-1f69-3fc7-a739-ba0ae26288ab",
                                        "glosses": [
                                            "непосещение (учебных занятий и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e4b21c-b5f1-4b40-a9da-2cb54b9ade05",
                                                "sense_id": "fa90abd5-1014-3c65-b2d7-c49df70a17e2",
                                                "text": "У Сашки школа, свекровь не допустит пропуска занятий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93677955-023f-3bde-9182-99492f0275dc",
                                        "entry_id": "abcbc0f2-1f69-3fc7-a739-ba0ae26288ab",
                                        "glosses": [
                                            "пустое, незаполненное место, также место с пропущенным, удалённым фрагментом (текста и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8820ee-670a-464e-987b-e4883575a375",
                                                "sense_id": "93677955-023f-3bde-9182-99492f0275dc",
                                                "text": "Эти старые переводы не точны, иногда содержат сознательные искажения и значительные пропуски."
                                            },
                                            {
                                                "example_id": "c28b3e51-2e5d-4460-938e-0e64a59f86b5",
                                                "sense_id": "93677955-023f-3bde-9182-99492f0275dc",
                                                "text": "Андрей отвернулся от окна и поглядел на стену тамбура, где была панель с двумя пыльными циферблатами и надписью «проверять каждые…» (дальше был пропуск)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пропуск",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c512c515-8819-3fae-b042-8b8210795d67",
                                        "entry_id": "e39cfd54-6f3a-321a-adec-c5c845b275e0",
                                        "glosses": [
                                            "документ на право входа, въезда куда-либо, прохода, проезда через что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a1ac60f-5e9a-4c73-8cf8-e7c767845722",
                                                "sense_id": "c512c515-8819-3fae-b042-8b8210795d67",
                                                "text": "Даже если кто-нибудь и заказал бы ему пропуск, то он всё равно бы его не получил ― нет же паспорта."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
