                                "target_senses": [
                                    {
                                        "sense_id": "fcfec0b0-7545-38b0-82c4-545ae60aab20",
                                        "entry_id": "f6a34a88-0d38-3cd1-b662-7f6d1221917c",
                                        "glosses": [
                                            "мифол. обвитый двумя змеями жезл греческого бога Гермеса (у римлян — Меркурия), который обладает способностью примирять"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac1d1c9-f5cd-413b-87d6-767fa4b26a2a",
                                                "sense_id": "fcfec0b0-7545-38b0-82c4-545ae60aab20",
                                                "text": "Перевернув испорченный лист, он снова нарисовал Марину, какой воображал её, дал в руку кадуцей Меркурия, приписал крылышки на ногах и вдруг вспомнил слова Безбедова об «отвлекающей точке»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4343efea-8ba3-3f68-8529-b028fd926ae7",
                                        "entry_id": "f6a34a88-0d38-3cd1-b662-7f6d1221917c",
                                        "glosses": [
                                            "истор. жезл глашатая, парламентария, торгового посла у древних греков и римлян"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d60f30d-9671-457f-8d90-51092e60f944",
                                                "sense_id": "4343efea-8ba3-3f68-8529-b028fd926ae7",
                                                "text": "Кадуцей — жезл глашатая, парламентария и торгового посла у древних греков и римлян."
                                            }
                                        ]
                                    }
                                ]
                            }
