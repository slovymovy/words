                        ],
                        "examples": [
                            {
                                "example_id": "6c5dac18-f75a-4aee-a5e7-3cfc6b14d857",
                                "sense_id": "aca6f3e4-889e-3999-9b1d-4bf8054983e1",
                                "text": "Na 2010 was de Tour behekst voor Contador. Nooit meer zou hij op volle oorlogssterkte zijn. Hij viel daarna meer dan dat hij kon aanvallen, maar tegen beter weten in bleef hij beuken in de rit naar Foix, waarin hij stootte op Barguil, een grote fan van… Contador."
                            }
