                        "cross_references": [
                            {
                                "target_word": "individuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4952f25-4ecd-3da3-8081-e3bb4af38245",
                                        "entry_id": "b901f547-e343-3ed8-ab8c-2efae0ad85ba",
                                        "glosses": [
                                            "Qui est de l’individu ; qui appartient à l’individu."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a41090e-8082-4a6d-9f3c-28c338fe0f90",
                                                "sense_id": "f4952f25-4ecd-3da3-8081-e3bb4af38245",
                                                "text": "Qualité individuelle."
                                            },
                                            {
                                                "example_id": "bf6cdc70-c9c2-4502-8b82-e94f6c858d25",
                                                "sense_id": "f4952f25-4ecd-3da3-8081-e3bb4af38245",
                                                "text": "Chez le vertébré comme chez l’annelé, nous voyons d’ailleurs les fils ressembler au père ou à la mère, aux différences individuelles près."
                                            },
                                            {
                                                "example_id": "811ff801-0b98-4bf6-90aa-73ca8c8b11d2",
                                                "sense_id": "f4952f25-4ecd-3da3-8081-e3bb4af38245",
                                                "text": "La propriété individuelle était encore très peu développée. Il y a cinquante ans, les rares propriétaires fonciers étaient de chorfa, des zaouïas, des dignitaires du makhzen qui avaient obtenu leurs terres par dahir chérifien."
                                            },
                                            {
                                                "example_id": "7bc3528b-4a7f-4eaa-a805-2350245153b9",
                                                "sense_id": "f4952f25-4ecd-3da3-8081-e3bb4af38245",
                                                "text": "Bien sûr, il y a encore beaucoup de courage individuel, mais ce ne sont pas ces gens-là qui donnent sa direction à la vie de la société."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daccb9b2-3f74-3eb7-a888-8d6ac18aab7a",
                                        "entry_id": "b901f547-e343-3ed8-ab8c-2efae0ad85ba",
                                        "glosses": [
                                            "Qui concerne chaque personne ou une seule personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdfc22f-10d0-48aa-bad8-eb7e8d4c9b40",
                                                "sense_id": "daccb9b2-3f74-3eb7-a888-8d6ac18aab7a",
                                                "text": "Dans le camp adverse, les Munichois chassent très haut les Bianconeri, quasiment en marquage individuel."
                                            },
                                            {
                                                "example_id": "9f15b8ca-e353-4f4a-ade8-1a1f7f801839",
                                                "sense_id": "daccb9b2-3f74-3eb7-a888-8d6ac18aab7a",
                                                "text": "En choisissant un exemple hypothétique qui marque les esprits, les chercheurs tentent de démontrer que les choix individuels peuvent avoir d’importantes conséquences sur la planète."
                                            },
                                            {
                                                "example_id": "71ac0eb2-8880-45fa-9178-ca0d1b10c4c1",
                                                "sense_id": "daccb9b2-3f74-3eb7-a888-8d6ac18aab7a",
                                                "text": "Être ultra-resserré sans la balle et déployé avec, une stratégie qui permet de combler les lacunes individuelles quand le ballon est perdu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a271ff6c-3add-3127-ae0a-e52ba7420dc0",
                                        "entry_id": "b901f547-e343-3ed8-ab8c-2efae0ad85ba",
                                        "glosses": [
                                            "Destiné à l’usage d’une seule personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "329bf47f-c798-4b34-8a79-144b8492c5ab",
                                                "sense_id": "a271ff6c-3add-3127-ae0a-e52ba7420dc0",
                                                "text": "Pour être plus écologiques, à l’avenir, au lieu d’avoir des voitures individuelles, nous aurons des vélos individuels !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "individuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0857022c-1b17-316c-b02f-4e916f5cdafb",
                                        "entry_id": "1d561eb1-5a32-3665-bdd7-c65760081251",
                                        "glosses": [
                                            "Dimension de l’expérience qui se rapporte uniquement à un individu, par opposition à une collectivité."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853481fb-0b96-47a8-bd31-6af0bad54738",
                                                "sense_id": "0857022c-1b17-316c-b02f-4e916f5cdafb",
                                                "text": "Partir de l'individuel n'est-il pas le chemin le plus court pour toucher à l'universel?"
                                            },
                                            {
                                                "example_id": "caf45bd7-7896-4f2b-95ca-d8075d393a46",
                                                "sense_id": "0857022c-1b17-316c-b02f-4e916f5cdafb",
                                                "text": "… la préférence pour l'individuel au détriment du collectif est reconnue par tous les observateurs comme une « tendance lourde » de nos sociétés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8ecc33-c2f2-3f27-b300-012b418f6252",
                                        "entry_id": "1d561eb1-5a32-3665-bdd7-c65760081251",
                                        "glosses": [
                                            "Course sportive où le classement est individuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c9ecfea-beca-473d-b46e-c513d5626920",
                                                "sense_id": "1d8ecc33-c2f2-3f27-b300-012b418f6252",
                                                "text": "La première course de la saison, un individuel de 20 km, à Kontiolahti (Finlande), n’a pas souri au clan français, mardi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
