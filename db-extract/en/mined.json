            {
                "entry_id": "71dbf094-ddfa-30b3-9575-05cb37ae7d97",
                "word": "mined",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "22a1187f-010e-4eb4-9cd4-004f9659030f",
                        "entry_id": "71dbf094-ddfa-30b3-9575-05cb37ae7d97",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more mined"
                    },
                    {
                        "form_id": "83c66495-2db9-4113-bc8c-44581ef203bd",
                        "entry_id": "71dbf094-ddfa-30b3-9575-05cb37ae7d97",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most mined"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                        "entry_id": "71dbf094-ddfa-30b3-9575-05cb37ae7d97",
                        "glosses": [
                            "That has been mined (in various senses)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbec913b-e209-4ceb-928a-5484436188ff",
                                "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                                "text": "The mined block is added to the \"blockchain\", a big, unbreakable ledger that lives on the bitcoin network and serves as a record of all transactions."
                            },
                            {
                                "example_id": "6266dae3-254b-46aa-8d5b-6e3f0aaaaf67",
                                "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                                "text": "Fifteen years after the end of one of Africa's longest wars, Angola remains one of the world's most heavily mined countries. Swaths of Angola are still littered with land mines, some produced decades ago in countries that no longer exist."
                            },
                            {
                                "example_id": "f3792f5a-e5e1-493e-87ac-ed9dd7d8a41c",
                                "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                                "text": "The Federal Trade Commission (FTC) ruled in 2018 that lab-grown diamonds are included in the same definitional universe as mined diamonds but warned against the use of terms like \"natural\" in marketing that confused the two categories."
                            },
                            {
                                "example_id": "e3b6579b-b249-4673-8a9b-7fac3c924109",
                                "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                                "text": "Some diamond industry analysts believe artificial diamonds are about to become their own market, separate from that for the traditional – and more exclusive – one for mined diamonds."
                            },
                            {
                                "example_id": "35e2fb90-0701-459d-8c07-16ba619a3237",
                                "sense_id": "b9a43c30-ec36-3527-b829-c6ad8bfec9e4",
                                "text": "In a year and a half of conflict, land mines — along with unexploded bombs, artillery shells and other deadly byproducts of war — have contaminated a swath of Ukraine roughly the size of Florida or Uruguay. It has become the world's most mined country."
                            }
                        ]
                    }
