                                "target_senses": [
                                    {
                                        "sense_id": "7a65a6a8-6292-374e-a906-3762a8028021",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "The state or condition of being useful; usefulness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71749d4d-8649-4bdc-87dd-fea82b5c30e1",
                                                "sense_id": "7a65a6a8-6292-374e-a906-3762a8028021",
                                                "text": "\"The profession has its utility, but I should be sorry to see any friend of mine belonging to it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761989e9-0664-327b-941d-e41d42bbb520",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "Something that is useful."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "001093da-0c60-4321-a670-8c5850c715c3",
                                                "sense_id": "761989e9-0664-327b-941d-e41d42bbb520",
                                                "text": "Undoubtedly it can be said that the humble 0-6-0 has been the backbone for general service, or general utility on British railways right from their earliest days, and is likely to remain so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86ca3871-f762-3841-9b8b-e3e963c48862",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "The ability of a commodity to satisfy needs or wants; the satisfaction experienced by the consumer of that commodity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f76e18e3-c5da-3d18-8542-8883e2a8c2f2",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "Well-being, satisfaction, pleasure, or happiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90ae043b-6215-3b39-ae76-9e816743fce4",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "A commodity or service provided on a continuous basis by a physical infrastructure network, such as electricity, water supply or sewerage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b670780-0f5e-453d-9313-6a2c1f235a4b",
                                                "sense_id": "90ae043b-6215-3b39-ae76-9e816743fce4",
                                                "text": "Elsewhere, utility diversion works are still scheduled to continue, with work to move a gas main on Drummond Street set to begin in early 2025."
                                            },
                                            {
                                                "example_id": "e65c5167-210a-491d-b1d2-546adfd4e2d2",
                                                "sense_id": "90ae043b-6215-3b39-ae76-9e816743fce4",
                                                "text": "The 'slab track' system negates the need to divert utilities such as gas pipes and telecoms cables by only digging down to a depth of 30cm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7460e0-ff5f-33b6-86b6-d20a42844832",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "A natural or legal monopoly distributer of such a utility; or, the securities of such a provider."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c360cf4a-5768-37f5-8fb2-c099b0899f27",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "A software program other than a game; one that is useful or creative rather than merely entertaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c5751ec-8586-447c-8dae-65d0d176e1ac",
                                                "sense_id": "c360cf4a-5768-37f5-8fb2-c099b0899f27",
                                                "text": "a graphics utility; a music utility"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4952f9b-41d7-3a89-ab69-013f2f36b513",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "A software program designed to perform a single task or a small range of tasks, often to help manage and tune computer hardware, an operating system, or application software."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db38f7a3-f1ae-47c0-8e8a-87f1028056e8",
                                                "sense_id": "b4952f9b-41d7-3a89-ab69-013f2f36b513",
                                                "text": "Holonyms: app, application, program"
                                            },
                                            {
                                                "example_id": "37af7b59-0a8f-4448-b066-0e9931402ccd",
                                                "sense_id": "b4952f9b-41d7-3a89-ab69-013f2f36b513",
                                                "text": "I've bought a new disk utility that can recover deleted files."
                                            },
                                            {
                                                "example_id": "40d5df4a-10a0-4c12-9cd2-c69bb661f29b",
                                                "sense_id": "b4952f9b-41d7-3a89-ab69-013f2f36b513",
                                                "text": "The system includes an 8080 and a Z80 assembler, a Tektronix format downloader and other utilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15a19444-80fa-3624-99b5-60f1ad6f39e4",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "The ability to play multiple positions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65060148-8835-360b-8a77-f3245991d53f",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "A coupé utility, or ute; an automobile with an open tray or bed behind the passenger cabin."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a4d9523-125d-4455-9458-8e5d0ecef244",
                                                "sense_id": "65060148-8835-360b-8a77-f3245991d53f",
                                                "text": "Tim Archer got into the utility and drove[.] The car was a 1946 Chevrolet, somewhat battered by four years of station use, a sturdy practical vehicle with a coupé front seat and an open truck body behind."
                                            }
                                        ]
                                    }
                                ]
