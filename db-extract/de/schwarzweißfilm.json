                "senses": [
                    {
                        "sense_id": "220ccabf-1db6-33f7-af39-ea9ad68d3cc6",
                        "entry_id": "2746f108-81ce-37b9-98f8-6a55aef42a95",
                        "glosses": [
                            "ein Film, der nur in schwarzen und weißen Tönen, das heißt in Graustufen, gedreht wurde"
                        ],
                        "tags": [
                            "Kinematografie"
                        ],
                        "examples": [
                            {
                                "example_id": "c6d4cd4c-c8a9-420b-8146-d19bcd16896c",
                                "sense_id": "220ccabf-1db6-33f7-af39-ea9ad68d3cc6",
                                "text": "„Vergleichbar mit Farbfilm findet sich der Begriff Schwarzweißfilm auch für die Abfolge von bewegten Bildern aus den Farben Weiß, Schwarz und ihren Mischfarben, zum Beispiel als Kinofilm oder sonstiges Produkt der Filmkunst, aber auch im Schwarz-Weiß-Fernsehen.“"
                            },
                            {
                                "example_id": "154f63cc-1f0f-427c-aa6b-0eb7ba2e9b1d",
                                "sense_id": "220ccabf-1db6-33f7-af39-ea9ad68d3cc6",
                                "text": "„Ich habe mir eine Kassette auf häuslicher Mattscheibe angeschaut; in Kinos läuft der Schwarzweißfilm schon lange nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
