                                            {
                                                "example_id": "42ac176d-1893-4961-9f08-a43198990d4b",
                                                "sense_id": "cbb70ab1-f413-3229-8bb8-69321599d044",
                                                "text": "Caracas biedt u historische bezienswaardigheden, wolkenkrabbers en een bruisend uitgaansleven."
