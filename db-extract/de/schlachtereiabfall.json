                ],
                "senses": [
                    {
                        "sense_id": "52c54511-e2fa-3e20-b85e-4adc409ccbec",
                        "entry_id": "349284f2-9bee-300b-8ed5-7531b7b0c0d0",
                        "glosses": [
                            "nicht zum Verzehr geeigneter Rest, der in einer Schlachterei anfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd57786-defe-4584-94f1-86d2e146b221",
                                "sense_id": "52c54511-e2fa-3e20-b85e-4adc409ccbec",
                                "text": "„Sie haben noch reichlich Leimreste, und dieser Leim ist im Gegensatz zu späteren Ausgaben gelblich braun und wurde vermutlich aus Schlachtereiabfällen hergestellt.“"
                            },
                            {
                                "example_id": "e8d81b52-faea-44d1-b923-666c0a7845f7",
                                "sense_id": "52c54511-e2fa-3e20-b85e-4adc409ccbec",
                                "text": "„Wie auf einem Bild der Polizei zu sehen ist, sind große Mengen Schlachtereiabfall auf der Fahrbahn verteilt worden.“"
                            },
                            {
                                "example_id": "b7c45340-809e-4a50-b025-f6bbc1640290",
                                "sense_id": "52c54511-e2fa-3e20-b85e-4adc409ccbec",
                                "text": "„Beim Bootshaus wurden die Aale einige Jahre lang mit Schlachtereiabfall vom Schlachthof in Nykøbing und gehackten Salzwasserfischen aus dem Fjord gefüttert.“"
                            },
                            {
                                "example_id": "4a42bcb4-2399-4ee9-82df-b8ac5c4cc018",
                                "sense_id": "52c54511-e2fa-3e20-b85e-4adc409ccbec",
                                "text": "„Beispielweise könnten das Getreidestroh - sonst auf den Feldern abgebrannt - und Schlachtereiabfälle - sonst in den Evros gekippt - zusammen kompostiert werden.“"
                            },
                            {
                                "example_id": "4329a91a-cfcd-4bd4-9bab-a1cd32e36c0f",
                                "sense_id": "52c54511-e2fa-3e20-b85e-4adc409ccbec",
                                "text": "„Für die Kompostierung nicht geeignet sind Verpackungsabfälle aller Art, Aschen, Knochen, Schlachtereiabfälle, große Mengen an Fleisch-, Fisch- und Wurstresten, Kehricht, Staubsaugerbeutel, Hygieneartikel, Windeln, Textilien, Gummi, Zigarettenkippen, künstliches Katzenstreu, Bauschutt, sämtliche Problemstoffe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
