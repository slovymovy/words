                                "target_senses": [
                                    {
                                        "sense_id": "8950ccbe-5f44-306e-9c88-af56bdcbd69f",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "In mammals, a sheet of muscle separating the thorax from the abdomen, contracted and relaxed in respiration to draw air into and expel air from the lungs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a8232aa-6c96-4c0d-8584-05dc73eff902",
                                                "sense_id": "8950ccbe-5f44-306e-9c88-af56bdcbd69f",
                                                "text": "thoracic diaphragm"
                                            },
                                            {
                                                "example_id": "2ff737ee-af4b-4b94-b068-c23544387a6a",
                                                "sense_id": "8950ccbe-5f44-306e-9c88-af56bdcbd69f",
                                                "text": "pulmonary diaphragm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0260dc-209a-3955-9d14-dd54283a5e94",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "Any of various membranes or sheets of muscle or ligament which separate one cavity from another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53ee451e-27f9-3ce1-84cf-adccfc91e590",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "A contraceptive device consisting of a flexible cup, used to cover the cervix during intercourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83520051-ae68-4938-9fc0-8a7f2b098387",
                                                "sense_id": "53ee451e-27f9-3ce1-84cf-adccfc91e590",
                                                "text": "cervical diaphragm"
                                            },
                                            {
                                                "example_id": "1c66d5be-ffa2-4b6a-a567-42f7bfacf2df",
                                                "sense_id": "53ee451e-27f9-3ce1-84cf-adccfc91e590",
                                                "text": "contraceptive diaphragm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57bb4b4e-78ea-305e-a6e3-32289c44fd53",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "A flexible membrane separating two chambers and fixed around its periphery that distends into one or other chamber as the difference in the pressure in the chambers varies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee6b796-5391-4657-a855-4bd0ab173ed8",
                                                "sense_id": "57bb4b4e-78ea-305e-a6e3-32289c44fd53",
                                                "text": "There also were five broken panes of glass on the two huge, rubberlike diaphragms that equalize air pressure within the dome as the artificial atmosphere expands and contracts with temperature variations, he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a149a9-111d-3d47-bb92-250353f5eba9",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "In a speaker, the thin, semi-rigid membrane which vibrates to produce sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae6b23d8-5072-4e49-b80d-accda0ecb3c2",
                                                "sense_id": "e5a149a9-111d-3d47-bb92-250353f5eba9",
                                                "text": "acoustic diaphragm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1abf71ff-a9aa-3f8b-9b70-30215fc331b4",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "A thin opaque structure with a central aperture, used to limit the passage of light into a camera or similar device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "969d8c83-ca2e-374a-a1b7-1ac0d4d329de",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "A permeable or semipermeable membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a296d70-0fbc-4f37-a7bf-a8e431145d8c",
                                                "sense_id": "969d8c83-ca2e-374a-a1b7-1ac0d4d329de",
                                                "text": "The mass of liquid transported through a porous diaphragm in a given time is directly proportional to the current."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03837e44-55d8-39ed-b436-12ba6e26d282",
                                        "entry_id": "963379b6-bfbd-3021-aa89-869fc85eaa4f",
                                        "glosses": [
                                            "A floor slab, metal wall panel, roof panel or the like, having a sufficiently large in-plane shear stiffness and sufficient strength to transmit horizontal forces to resisting systems."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
