                "senses": [
                    {
                        "sense_id": "62b51b15-c0f3-343f-8d25-dde6886d399a",
                        "entry_id": "cd4119a1-76bb-3b3d-aa05-7c8568342634",
                        "glosses": [
                            "westliches Ufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "001f9ed6-aed6-4e3f-a965-32c340c855f6",
                                "sense_id": "62b51b15-c0f3-343f-8d25-dde6886d399a",
                                "text": "„Am Westufer des an Krokodilen, Nilpferden und Pelikanen so reichen Chamo-Sees wachsen gewaltige Bananenstauden, und Abertausende Mangobäume tragen üppige Früchte, die von Kindern und Frauen am Wegesrand angeboten werden.“"
                            },
                            {
                                "example_id": "0bcb7690-5fc5-4344-ae0d-fb188776161d",
                                "sense_id": "62b51b15-c0f3-343f-8d25-dde6886d399a",
                                "text": "„Allmählich verbreiterte sich der Fluß, und wenig später standen die Siedler am Westufer des Grant-Sees, der ringsum von Bäumen eingefaßt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
