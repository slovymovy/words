                ],
                "senses": [
                    {
                        "sense_id": "54d8b156-c959-3f29-8698-6a50898557d8",
                        "entry_id": "5c56a8ea-6a7d-387e-bc51-3e12f8acd04e",
                        "glosses": [
                            "Dispositif d’accouplement direct de deux pièces mécaniques par dents et rainures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126bad46-bd7d-431e-a93d-f4c0ec7fd87e",
                                "sense_id": "54d8b156-c959-3f29-8698-6a50898557d8",
                                "text": "C’est, en somme, une roue libre mécanique qu’un crabotage vient normalement bloquer. Le crabot baladeur est en relation avec la pédale de débrayage qui agit d’ailleurs, de la façon normale, sur l’embrayage."
                            },
                            {
                                "example_id": "b38bd2c1-4207-4e71-baa8-a5ca7e7537d1",
                                "sense_id": "54d8b156-c959-3f29-8698-6a50898557d8",
                                "text": "Il inspecte le relief du sol, puis manœuvre le Ford, les pneus s’enduisent d’une boue collante, il enclenche le crabot, met le 4x4 en travers et descend à reculons dans le bas-côté, s’enfonce au pas dans la végétation …."
                            },
                            {
                                "example_id": "2e1c292d-a6d2-4fcd-bb8e-f2a32ac01e72",
                                "sense_id": "54d8b156-c959-3f29-8698-6a50898557d8",
                                "text": "Grâce à son association aux moteurs électriques, la boîte de vitesses multimodes à crabot, sans embrayage, permet un démarrage 100% électrique, et réduit les ruptures d’accélération lors des changements de rapports."
                            }
                        ]
                    }
