                        "form": "more suppositious"
                    },
                    {
                        "form_id": "877f63a4-4cc6-48aa-a667-75252b3615c8",
                        "entry_id": "00865b0e-ce7c-3bf9-a889-8c19b85a331b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most suppositious"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c833f6fd-c809-398b-b0e6-c32877031126",
                        "entry_id": "00865b0e-ce7c-3bf9-a889-8c19b85a331b",
                        "glosses": [
                            "Spurious; substituted for the genuine, counterfeit; fake."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d97eb7e-69f4-402d-bfb0-60fcfced506a",
                                "sense_id": "c833f6fd-c809-398b-b0e6-c32877031126",
                                "text": "[…] who knowes not how false, how suppositious, the writings and Epistles of the auncient Popes are iustly esteemed?"
                            },
                            {
                                "example_id": "c6dd2c01-363d-4b86-acd4-dae7e3cc8c97",
                                "sense_id": "c833f6fd-c809-398b-b0e6-c32877031126",
                                "text": "[…] a hen teaches this language with equal ease to the ducklings, she has hatched from suppositious eggs, and educates as her own offspring […]"
                            },
                            {
                                "example_id": "66018bb4-5866-444b-bfda-c0f071540b44",
                                "sense_id": "c833f6fd-c809-398b-b0e6-c32877031126",
                                "text": "[…] unfortunately for you, the real Faber and the suppositious Faber, alias Draycott, were much alike in one respect. They gave way to drinking bouts at regular intervals."
                            }
                        ]
                    },
                    {
                        "sense_id": "89734961-eb73-315a-8ccf-95f8a6667572",
                        "entry_id": "00865b0e-ce7c-3bf9-a889-8c19b85a331b",
                        "glosses": [
                            "Imaginary; fictitious, pretended to exist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f93a00-ddd3-44e3-921a-032844341f2d",
                                "sense_id": "89734961-eb73-315a-8ccf-95f8a6667572",
                                "text": "At rehearsals the actor tossed an entirely imaginary cloak about his shoulders as though it were heavy brocade, courteously removed a hat made of air, and seriously set out on a suppositious table a non-existent dinner, after sedulously cooking it on a kitchen range that was a chair."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea9100cd-7b5b-3354-921f-22f5b99a83d5",
                        "entry_id": "00865b0e-ce7c-3bf9-a889-8c19b85a331b",
                        "glosses": [
                            "Hypothetical, based on supposition; conjectural."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccdb7335-5def-4a18-8e3b-fc88ce9ed9c5",
                                "sense_id": "ea9100cd-7b5b-3354-921f-22f5b99a83d5",
                                "text": "Near-synonyms: assumed, presumed, presumptive, putative, supposed; apparent, likely"
                            },
                            {
                                "example_id": "341bddbd-a5db-48ff-a1a9-aecac54657b1",
                                "sense_id": "ea9100cd-7b5b-3354-921f-22f5b99a83d5",
                                "text": "Look, Dr. Lanning, let me present you with a suppositious case. Supposing we had a politician who was interested in defeating a reform candidate at any cost and while investigating his private life came across oddities such as I have just mentioned."
                            }
                        ]
                    }
                ],
