                            },
                            {
                                "example_id": "b22d4b60-ea03-432e-a25b-f798e3160b91",
                                "sense_id": "5607a9a7-cfca-32aa-89fd-a09b5bb34aec",
                                "text": "Het vliegkampschipje wordt gebruikt voor training en oefeningen met gevechtsvliegtuigen.",
                                "translation": "The aircraft carrier is used for training and exercises with combat aircraft.",
                                "english": "The aircraft carrier is used for training and exercises with combat aircraft."
