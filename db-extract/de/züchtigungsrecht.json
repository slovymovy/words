                "senses": [
                    {
                        "sense_id": "4501c6d1-af15-37f7-829c-5b51422fcee8",
                        "entry_id": "fbe907d9-afb3-3b07-94ff-064141935b20",
                        "glosses": [
                            "Recht zur Züchtigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4eaa8e-8934-4b53-ae15-be4b94bfb0fa",
                                "sense_id": "4501c6d1-af15-37f7-829c-5b51422fcee8",
                                "text": "„Neben Passgesetzen, welche die Freizügigkeit der schwarzen Bevölkerung einschränkten, wurde 1910 der Masters and Servants Act verabschiedet, der dem Arbeitgeber, meist dem Farmer, eine patrimoniale Gewalt über seine Untergebenen bis hin zum Züchtigungsrecht einräumte und das unerlaubte Verlassen der Arbeitsstätte zu einem kriminellen Akt erklärte.“"
                            },
                            {
                                "example_id": "3d245619-2afd-4202-a4a7-0cbb86143537",
                                "sense_id": "4501c6d1-af15-37f7-829c-5b51422fcee8",
                                "text": "„Die preußische Gesindeordnung war seit 1810 in mehreren Schritten liberalisiert worden, und den Gutsherren kam schon länger kein Züchtigungsrecht mehr zu, aber von ernsthaften Arbeitnehmerrechten konnte keine Rede sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
