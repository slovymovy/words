                            {
                                "example_id": "2b3673ce-b5ce-420f-9284-69adf2c5c45b",
                                "sense_id": "0e44eb7b-2c35-3f06-bb53-e676bd3c181e",
                                "text": "Viele aus der Großstadt kommen zur Entspannung nach Carantec."
                            },
                            {
                                "example_id": "f9680e3d-3497-4df1-96bf-f63a4235a9bc",
                                "sense_id": "0e44eb7b-2c35-3f06-bb53-e676bd3c181e",
                                "text": "Wer Carantec nicht mag, dem wird Landéda auch nicht gefallen."
                            }
                        ],
