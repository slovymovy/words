                "forms": [],
                "senses": [
                    {
                        "sense_id": "f31a21ad-a949-305b-8ec7-e65809acd2a4",
                        "entry_id": "8da716c4-dec2-3834-9aac-54cfd9f63d15",
                        "glosses": [
                            "Having all the flowers alike in terms of the stamens and pistils."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5cfe3076-69b2-4c44-ad53-947da655a284",
                                "sense_id": "f31a21ad-a949-305b-8ec7-e65809acd2a4",
                                "text": "In Hottonia, a Primulaceous genus of two species, the European one has heterogonous dimorphism for cross-fertilization: the American one has homogonous showy flowers with only the general chance for intercrossing, and earlier flowers which are cleistogamous for self-fertilization."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ddc5146-b323-3853-8677-a6a87b5334e0",
                        "entry_id": "8da716c4-dec2-3834-9aac-54cfd9f63d15",
                        "glosses": [
                            "Existing on a continuum; able to be transformed one into another by means of continuous change."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff6017b1-13ea-4328-a7aa-a21277ddab2c",
                                "sense_id": "0ddc5146-b323-3853-8677-a6a87b5334e0",
                                "text": "Time and an instant, space and a point, boundary and the bounded, are not homogeneous, but nevertheless cognate or \"homogonous\"."
                            },
                            {
                                "example_id": "2d3b9fb6-7fca-414d-ad81-af2eade2654a",
                                "sense_id": "0ddc5146-b323-3853-8677-a6a87b5334e0",
                                "text": "This concept of \"change as homogonous variation” is arguably the most profound and most problematic for Plato."
                            }
                        ]
                    }
                ],
