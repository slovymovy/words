                        "examples": [
                            {
                                "example_id": "af4891c4-0b66-4d8e-baa3-973f5ab18f74",
                                "sense_id": "bfeacf45-a0c9-3c81-950b-e4065b2e6895",
                                "text": "Une cellule photoréceptrice."
                            },
                            {
                                "example_id": "827ce180-9595-4458-8338-264c59dbf531",
                                "sense_id": "bfeacf45-a0c9-3c81-950b-e4065b2e6895",
                                "text": "Les neurones photorécepteurs convertissent, par un processus photochimique, l'énergie lumineuse en un signal neurochimique."
                            }
                        ]
                    }
                ],
