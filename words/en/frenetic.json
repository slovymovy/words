{
    "word_family": [
        "frenzy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe3f1057-d12a-3783-85c4-dc7e94e06746",
                    "sense_definition": "Characterized by fast, energetic, and often disorganized activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "energy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>frenetic</w> pace of the city life eventually became too much for him.",
                            "target_lang_translations": {
                                "ru": "<w>Бешеный</w> темп городской жизни в итоге стал для него невыносимым."
                            }
                        },
                        {
                            "text": "They worked at a <w>frenetic</w> speed to finish the project before the deadline.",
                            "target_lang_translations": {
                                "ru": "Они работали с <w>лихорадочной</w> скоростью, чтобы закончить проект до дедлайна."
                            }
                        }
                    ],
                    "synonyms": [
                        "frantic",
                        "frenzied"
                    ],
                    "common_phrases": [
                        "frenetic pace",
                        "frenetic energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся быстрым, лихорадочным, бурным и часто хаотичным темпом или деятельностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "очень быстрый, стремительный"
                            },
                            {
                                "target_lang_word": "лихорадочный",
                                "target_lang_sense_clarification": "суетливый, хаотично-активный"
                            },
                            {
                                "target_lang_word": "неистовый",
                                "target_lang_sense_clarification": "бурный, безудержный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "377efa18-f5c7-3b67-9203-43bbb5fb67d0",
                    "sense_definition": "Relating to a state of mental derangement or insanity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "madness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient exhibited <w>frenetic</w> behavior that concerned the medical staff.",
                            "target_lang_translations": {
                                "ru": "Пациент демонстрировал <w>буйное</w> поведение, которое встревожило медицинский персонал."
                            }
                        },
                        {
                            "text": "His <w>frenetic</w> ramblings made it difficult to understand what he was trying to say.",
                            "target_lang_translations": {
                                "ru": "Его <w>безумное</w> бормотание мешало понять, что именно он пытался сказать."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely dated or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к состоянию психического расстройства, безумия или буйства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "сумасшедший, невменяемый"
                            },
                            {
                                "target_lang_word": "буйный",
                                "target_lang_sense_clarification": "неистовый в помешательстве"
                            },
                            {
                                "target_lang_word": "вне себя",
                                "target_lang_sense_clarification": "в состоянии крайнего исступления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9011b7ed-9a17-34f1-aaa7-9306d9bf3c81",
                    "sense_definition": "A person who is in a state of extreme, uncontrolled energy or madness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "madness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The asylum was filled with <w>frenetics</w> who could not be calmed.",
                            "target_lang_translations": {
                                "ru": "Лечебница была переполнена <w>буйнопомешанными</w>, которых никак не удавалось успокоить."
                            }
                        },
                        {
                            "text": "He acted like a <w>frenetic</w> during the argument, shouting without reason.",
                            "target_lang_translations": {
                                "ru": "Во время спора он вел себя как <w>безумец</w>, крича без всякой причины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, находящийся в состоянии буйства, крайнего возбуждения или помешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумец",
                                "target_lang_sense_clarification": "сумасшедший"
                            },
                            {
                                "target_lang_word": "буйнопомешанный",
                                "target_lang_sense_clarification": "буйный душевнобольной"
                            },
                            {
                                "target_lang_word": "неистовствующий",
                                "target_lang_sense_clarification": "человек в неистовстве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}