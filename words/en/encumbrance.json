    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cefc2883-5844-3533-ac09-2e28d1dbef24",
                    "sense_definition": "A burdensome impediment, hindrance, or physical load that makes action or movement difficult.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He traveled light without any unnecessary <w>encumbrance</w> to slow him down."
                        },
                        {
                            "text": "Heavy winter boots proved to be a severe <w>encumbrance</w> during the long hike."
                        }
                    ],
                    "synonyms": [
                        "encumberment"
                    ],
                    "common_phrases": [
                        "without encumbrance",
                        "free of encumbrance"
                    ]
                },
                {
                    "sense_id": "5db7864d-d9ba-3323-9a1f-3369a23cbb0c",
                    "sense_definition": "The state or condition of being burdened or obstructed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project suffered from continuous <w>encumbrance</w> by bureaucracy and slow approvals."
                        },
                        {
                            "text": "She wanted a life lived in freedom, away from emotional <w>encumbrance</w>."
                        }
                    ],
                    "synonyms": [
                        "encumberment"
                    ],
                    "antonyms": [
                        "unencumbrance"
                    ]
                },
                {
                    "sense_id": "8e2cf5e1-08ed-30e6-90f1-aec5d3636d5d",
                    "sense_definition": "A legal claim, charge, or liability attached to property, such as a lien or mortgage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_liability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer confirmed that the real estate was sold free and clear of any <w>encumbrance</w>."
                        },
                        {
                            "text": "An existing mortgage represents a significant <w>encumbrance</w> on the estate."
                        }
                    ],
                    "common_phrases": [
                        "free of all encumbrances"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "470b0538-b36b-38f6-83dd-b153fc39a9d9",
                    "sense_definition": "To attach a legal claim, liability, or burden to property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_liability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The debtor attempted to <w>encumbrance</w> the property before filing for bankruptcy."
                        },
                        {
                            "text": "Lenders will rarely agree to <w>encumbrance</w> an asset that has uncertain value."
                        }
                    ]
                }
            ]
        }
    ]
