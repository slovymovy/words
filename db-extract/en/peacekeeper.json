                "forms": [
                    {
                        "form_id": "b627f066-1fef-4a84-95f4-4983188229f2",
                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "tags": [
                            "plural"
                        ],
                        "form": "peacekeepers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b96680d3-0f2e-3d4b-b45c-2994d369f75d",
                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "glosses": [
                            "One that preserves the peace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66af21ea-6408-48b6-8198-cba63e5b3b7e",
                                "sense_id": "b96680d3-0f2e-3d4b-b45c-2994d369f75d",
                                "text": "Roughly 1200 years ago, the turians were invited to join the Citadel Council to fulfill the role of galactic peacekeepers. The turians have the largest fleet in Citadel space, and they make up the single largest portion of the Council's military forces."
                            }
                        ]
                    },
                    {
                        "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "glosses": [
                            "A member of a military force charged with peacekeeping duties in a troublespot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e962c55-8728-4811-97d6-611910fd9aad",
                                "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                "text": "The grainy footage showed the peacekeepers first bound and beaten, then hooded and dead, hanging by the neck from a wooden ceiling beam. ."
                            },
                            {
                                "example_id": "7353b710-d615-4155-be1f-2962ca36f5fc",
                                "sense_id": "65cdd5f6-3e07-32f2-a4bc-542a44b8fcd4",
                                "text": "Dozens of NATO peacekeepers were injured after they were attacked by ethnic Serbs in northern Kosovo, during protests over the installation of ethnically Albanian mayors."
                            }
                        ]
                    },
                    {
                        "sense_id": "de1a298f-57e5-3a3c-865e-ac9ef42adc1a",
                        "entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "glosses": [
                            "An officer of the peace (police officer) in a force run by a Canadian aboriginal community."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1504ee19-b18f-4d2d-9d3c-ec287d534e3f",
                        "source_entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "source_sense_description": "one that preserves the peace",
                        "target_lang_word": "миротво́рец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "миротво́рец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "00f23a40-3ac0-375c-b43b-0cc1269b6bfc",
                                        "entry_id": "408d8688-8844-336a-bd7c-7324ac3b20c0",
                                        "glosses": [
                                            "тот, кто способствует примирению, устанавливает мир"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c687bc5-6a5c-4914-a758-551a45901fef",
                                                "sense_id": "00f23a40-3ac0-375c-b43b-0cc1269b6bfc",
                                                "text": "Счастливы миротворцы, потому что они будут названы сыновьями Бога."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "991be082-a468-4d4d-a9ab-9a9c1f860073",
                        "source_entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "source_sense_description": "member of a military force charged with peacekeeping duties",
                        "target_lang_word": "gardien de la paix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardien de la paix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d5182ac-6fa4-37e3-86ce-a83b58f0b16c",
                                        "entry_id": "dcbd1983-b267-3725-a43b-d6d57c347757",
                                        "glosses": [
                                            "Agent de police armé qui est chargé de maintenir le bon ordre dans les lieux publics, ou personne ayant le grade associé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e924f0-a279-421f-9445-bfbba2dd9e6c",
                                                "sense_id": "2d5182ac-6fa4-37e3-86ce-a83b58f0b16c",
                                                "text": "Le municipal de rigueur, métamorphosé en gardien de la paix, se tient là dans le but de maintenir l’intégrité de la queue."
                                            },
                                            {
                                                "example_id": "687f9fb8-a091-42aa-90fb-8c4d9dd9cfb0",
                                                "sense_id": "2d5182ac-6fa4-37e3-86ce-a83b58f0b16c",
                                                "text": "Mais au moment où Cœur-de-Lion prenait Thermidor dans ses bras pour franchir la porte, il trouva à qui parler. Un gardien de la paix s’écria :\n- On ne passe pas !"
                                            },
                                            {
                                                "example_id": "d63a54f3-3697-4505-af6f-2a5557cb5973",
                                                "sense_id": "2d5182ac-6fa4-37e3-86ce-a83b58f0b16c",
                                                "text": "Deux gardiens de la paix firent un signe au patron qui gourmanda les retardataires."
                                            },
                                            {
                                                "example_id": "2a17fe65-1c80-44a4-b571-3f48f6601dd7",
                                                "sense_id": "2d5182ac-6fa4-37e3-86ce-a83b58f0b16c",
                                                "text": "Il faut reconnaître que le pays recèle un tas de gars comme lui, convaincus que la loi, c’est pour les autres ; des gars tellement sûrs de leur impunité que la vue d’un gardien de la paix est perçue, chez eux, comme une anomalie, un vague « déjà vu »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ae8622a-b560-4cc9-aca3-0b3d0c92e7b4",
                        "source_entry_id": "de584278-cb40-3371-a7f4-3a13ccc67a46",
                        "source_sense_description": "member of a military force charged with peacekeeping duties",
                        "target_lang_word": "gardienne de la paix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardienne de la paix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c34f3d3-5956-3d84-91b7-fdcb3bb8709e",
                                        "entry_id": "1e5fcce5-d49b-3e16-88ac-34275aa22171",
                                        "glosses": [
                                            "Agent de police féminin armé qui est chargé de maintenir le bon ordre dans les lieux publics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bcec323-a1ca-437a-b9bb-85bd969baf13",
                                                "sense_id": "2c34f3d3-5956-3d84-91b7-fdcb3bb8709e",
                                                "text": "C'est peut-être pour cela que la gardienne de la paix s'y rendit seule, avec en poche le permis de communiquer transmis par le juge d'application des peines."
                                            },
                                            {
                                                "example_id": "2f70d6cb-2b2a-42e7-a842-93c15e502f59",
                                                "sense_id": "2c34f3d3-5956-3d84-91b7-fdcb3bb8709e",
                                                "text": "Une jeune gardienne de la paix terminait de faire son compte rendu, calepin en main."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
