    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                "word": "prolepsis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2f67e96a-6819-41e7-85a3-64823c57f353",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "tags": [
                            "plural"
                        ],
                        "form": "prolepses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5423d8ac-7897-3dac-a63c-1ed337f32ce3",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "glosses": [
                            "The assignment of something to a period of time that precedes it."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "319a2e66-7ae8-379d-ab74-2b2188ba7c20",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "glosses": [
                            "The anticipation of an objection to an argument."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "609012ea-d16d-4950-b32a-53933fd4c706",
                                "sense_id": "319a2e66-7ae8-379d-ab74-2b2188ba7c20",
                                "text": "Prolepsis makes objections; then replies;\nAnd wisely thus anticipates surprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c0dc5a9-6c9b-35a4-8952-bf160c72d527",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "glosses": [
                            "A construction that consists of placing an element in a syntactic unit before that to which it would logically correspond."
                        ],
                        "tags": [
                            "countable",
                            "rhetoric",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "54da4dcd-f6c6-3ccc-af43-62e9c9a2d803",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "glosses": [
                            "A so-called \\\"preconception\\\", i.e., a pre-theoretical notion which can lead to true knowledge of the world."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8be20778-8ba2-4fca-a9ad-a34f9d169f38",
                                "sense_id": "54da4dcd-f6c6-3ccc-af43-62e9c9a2d803",
                                "text": "Point (1) seems to imply that one may have a false judgement because of a mismatch between different criteria for truth. For example, my sensation is paired with a prolepsis of a horse, therefore I make an assertion that ‘there is a horse’, which upon further inspection may turn out to be a cow."
                            }
                        ]
                    },
                    {
                        "sense_id": "014c62af-07a6-3d4d-8a66-ff371e48b22c",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "glosses": [
                            "Growth in which lateral branches develop from a lateral meristem, after the formation of a bud or following a period of dormancy, when the lateral meristem is split from a terminal meristem."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6ea6c9bd-a34a-3bb1-8c6d-8b24eed57232",
                        "entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "glosses": [
                            "The practice of placing information about the ending of a story near the beginning, as a literary device."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bfb387c6-4002-44a9-a12b-e500f10a9ae1",
                                "sense_id": "6ea6c9bd-a34a-3bb1-8c6d-8b24eed57232",
                                "text": "[…] [Edmund] Plovvden being of the Romiſh perſvvaſion, ſome Setters trapanned him (pardon the prolepſis) to hear Maſſe: But aftervvards Plovvden underſtanding, that the pretender to Officiate vvas no Prieſt, but a meer Lay-man (on deſigne to make a diſcovering) Oh! The caſe is altered quoth Plovvden: No Priest, no Maſſe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6011b0e1-817b-4ead-92e7-87780970429b",
                        "source_entry_id": "84f135fa-9b4a-3787-b78d-febee5f7158b",
                        "source_sense_description": "(rhetoric) the anticipation of an objection to an argument",
                        "target_lang_word": "prolepse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolepse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61e52908-0e78-3b28-8c7b-1aa891d6ea58",
                                        "entry_id": "d3686f67-2ef4-3225-bd4e-9ee9f0df747c",
                                        "glosses": [
                                            "Figure de style par laquelle on va au-devant des objections de l’adversaire."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab495c8-d831-4f52-969c-6072108886d8",
                                                "sense_id": "61e52908-0e78-3b28-8c7b-1aa891d6ea58",
                                                "text": "La prolepse est l’une des figures de construction qui présente le plus d'intérêt, du fait de la complexité de l’héritage qu’elle véhicule et de la difficulté qu’éprouvent les grammairiens à concilier les différentes traditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b5a3be3-016e-31a1-8952-fc870822e73f",
                                        "entry_id": "d3686f67-2ef4-3225-bd4e-9ee9f0df747c",
                                        "glosses": [
                                            "Anticipation, prénotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e548377-526c-4476-82ab-b071b297d7a0",
                                                "sense_id": "5b5a3be3-016e-31a1-8952-fc870822e73f",
                                                "text": "Épicure nomme prolepse ou prénotion, la trace laissée en notre corps et en notre esprit par une suite d'images identiques répétées plusieurs fois ou un souvenir des impressions passées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca1e3f25-6953-309e-ab58-d216fdad397b",
                                        "entry_id": "d3686f67-2ef4-3225-bd4e-9ee9f0df747c",
                                        "glosses": [
                                            "Fait de placer un mot dans la proposition qui précède celle où il devrait normalement figurer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
