                        "source_entry_id": "fc08d675-3974-3c69-9e48-c57eb0c0d11e",
                        "target_lang_word": "Verstärkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstärkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd9e791f-05f0-363e-89e7-e263529650fb",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "technische Vorrichtung zur Erhöhung der Stabilität oder Verbesserung der Designeigenschaften zum Beispiel bei Gebäuden, Maschinen, Fahrzeugen und Kleidern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6980f0f-bd65-4707-bcf5-863f494f4507",
                                                "sense_id": "bd9e791f-05f0-363e-89e7-e263529650fb",
                                                "text": "Die Rückbank ließ sich nicht umlegen, da zum Kofferraum hin verkreuzte Streben als Verstärkung verbaut waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "zusätzliches Personal, das für eine bestimmte Aufgabe bereitgestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38d5edfe-0495-4545-8eb5-0c29843cb976",
                                                "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                                "text": "Da die Front bröckelte mussten immer neue Truppen als Verstärkung abgestellt werden."
                                            },
                                            {
                                                "example_id": "705ac011-4cd8-431d-87f5-b831c92fe94a",
                                                "sense_id": "9bbc1e7c-bc67-3918-ada3-7ac137f26698",
                                                "text": "„Durch diesen Korridor kam hin und wieder Verstärkung, aber der Abwehrkampf der Wehrmacht war aussichtslos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5fd3ec68-e051-30b5-b973-3d0574e733c0",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "Vergrößerung der Amplitude, zum Beispiel Erhöhung der Lautstärke von Geräuschen"
                                        ],
                                        "tags": [
                                            "bezogen auf Wellen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db16ed4-1f5f-4d7f-abbc-e131e22857ab",
                                                "sense_id": "5fd3ec68-e051-30b5-b973-3d0574e733c0",
                                                "text": "Da die Schwingungen den Passanten einen Gleichschritt aufzwangen kam es zu einer bedrohlichen Verstärkung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "982568d0-e796-37b3-9723-5c936b3f578c",
                                        "entry_id": "6a4a28b0-0a5d-3f64-9a13-ca32a4861f5f",
                                        "glosses": [
                                            "Intensivierung, Zunahme, Verdichtung"
                                        ],
                                        "tags": [
                                            "Verkehr",
                                            "Handel",
                                            "Beziehungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ab3fee3-58ee-4321-842f-1d0f3b996075",
                                                "sense_id": "982568d0-e796-37b3-9723-5c936b3f578c",
                                                "text": "Durch den Abbau von Zöllen kam es zu einer Verstärkung des internationalen Handels."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "808c38aa-8d74-43ae-8916-afe090efa57d",
                        "source_entry_id": "fc08d675-3974-3c69-9e48-c57eb0c0d11e",
                        "target_lang_word": "Unterstützung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterstützung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                        "entry_id": "0117c5ad-d7fb-30ba-8e29-bff4cdeea477",
                                        "glosses": [
                                            "Hilfe oder Mithilfe von jemandem (oder im übertragenen Sinne auch von etwas)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb827330-0572-46d5-862b-5e18b621df36",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "Wir rechnen mit Ihrer Unterstützung."
                                            },
                                            {
                                                "example_id": "6c1e7c91-d7ab-4eab-b2fa-54d9c0275b15",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Vermutlich wäre es nicht so gekommen, hätte es nicht die vielen Zeitungsberichte gegeben, die Empörung im ganzen Land über den Tod des jungen Mannes und die Unterstützung der anderen Rechtswissenschaftler.“"
                                            },
                                            {
                                                "example_id": "a69e1f37-ebd3-45d6-8a3b-846400e34637",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Rachel und Simon stellten ihre Unterstützung und ihre positive Einstellung zu meinem Afrika-Trip zur Schau und ich tat alles, um mich selbstbewusst und optimistisch zu zeigen.“"
                                            },
                                            {
                                                "example_id": "8a983ab6-d519-49a5-8eba-1038df068488",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Dem Exilpräsidenten war bis in das Jahr 1942 hinein nicht klar, wie viele Deutsche man abschieben könne, denn er wusste natürlich, dass die Tschechen die Unterstützung der Großmächte, jedenfalls ihre Duldung, für die Vertreibung brauchten.“"
                                            },
                                            {
                                                "example_id": "dd6c8636-9068-4d35-a94c-f0e4e2b88fc1",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Da verweigert der deutschnationale und reiche jüdische Emigrant Oppenheim dem um Unterstützung bittenden Ludwig Kern jede Hilfe, und der Klinikarzt Beer wird für ihn und seine Geliebte zum uneigennützigen Lebensretter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8049e61b-d5d0-3792-9a7e-4fee1c26d15c",
                                        "entry_id": "0117c5ad-d7fb-30ba-8e29-bff4cdeea477",
                                        "glosses": [
                                            "technische Stütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ca0dd5-f748-4914-ba31-0d1e7f7be3ed",
                                                "sense_id": "8049e61b-d5d0-3792-9a7e-4fee1c26d15c",
                                                "text": "Nach dem Erdbeben braucht das Gebäude eine Unterstützung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "84e7444b-6d6f-3470-b211-93921a382061",
                                        "entry_id": "0117c5ad-d7fb-30ba-8e29-bff4cdeea477",
                                        "glosses": [
                                            "Beihilfe vom Staat in Form von Geldzahlungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d886cb-a5a8-41d9-810a-427695783818",
                                                "sense_id": "84e7444b-6d6f-3470-b211-93921a382061",
                                                "text": "Er lebt nur von der Unterstützung."
                                            },
                                            {
                                                "example_id": "551c9816-619f-4440-a657-5d26c51f2c56",
                                                "sense_id": "84e7444b-6d6f-3470-b211-93921a382061",
                                                "text": "„Sie bekamen ihre finanzielle Unterstützung und fuhren gleich in den Supermarkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
