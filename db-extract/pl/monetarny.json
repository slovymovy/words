                                        "glosses": [
                                            "geldlich, auf die Währung bezogen, das Geld betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8559801a-fb91-4804-b153-d4ee8cf712c0",
                                                "sense_id": "8c4350f0-32e2-33f6-8fad-b43a96ae024f",
                                                "text": "Monetär sieht es bei mir zur Zeit ziemlich schlecht aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9f77435-0848-4268-b25e-7c9454f372ec",
                        "source_entry_id": "73963d29-e52d-30d5-a98d-98af79feec37",
