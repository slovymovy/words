                ],
                "senses": [
                    {
                        "sense_id": "a27954b7-2fbe-3e36-a1fb-64f7eafa2ccd",
                        "entry_id": "7e0df176-f86a-3014-a57a-864aaadf7b0d",
                        "glosses": [
                            "a small tree"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab469ef9-48e7-4fb6-8339-45a480b7e2c3",
                                "sense_id": "a27954b7-2fbe-3e36-a1fb-64f7eafa2ccd",
                                "text": "At one extreme, the two plots in Malaysia are in tall, evergreen forest; have no regular dry season; and include over 800 tree and treelet species each."
                            },
                            {
                                "example_id": "3f2281d5-4da9-4563-8c6f-0a13fd70a3ea",
                                "sense_id": "a27954b7-2fbe-3e36-a1fb-64f7eafa2ccd",
                                "text": "The people are sorely in need of firewood, and not being far-seeing enough to realize what a menace it is to the country to denude it so unscientifically, they have razed every treelet."
                            },
                            {
                                "example_id": "9a0fd265-701b-4f94-a466-17efb6d23291",
                                "sense_id": "a27954b7-2fbe-3e36-a1fb-64f7eafa2ccd",
                                "text": "A single tiny treelet broke the plain just at the skyline of the rise."
                            },
                            {
                                "example_id": "c6e046ce-2497-47e4-9e07-ab798b99c0a7",
                                "sense_id": "a27954b7-2fbe-3e36-a1fb-64f7eafa2ccd",
                                "text": "Once a redbird shot confidently down from above on half-closed wing, caught sight of these intruders, brought up with a swish of feathers, and eyed them gravely for some time from a neighbouring treelet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a27b6d06-f503-4160-a5e7-cad3026e9c4c",
                        "source_entry_id": "7e0df176-f86a-3014-a57a-864aaadf7b0d",
                        "source_sense_id": "a27954b7-2fbe-3e36-a1fb-64f7eafa2ccd",
