                            }
                        },
                        {
                            "text": "Zijn <w>hese</w> gefluister was nauwelijks te verstaan in de drukke kamer.",
                            "target_lang_translations": {
                                "en": "His <w>husky</w> whispering was barely audible in the busy room."
                            }
                        }
                    ],
                    "synonyms": [
                        "schor"
                    ],
                    "common_phrases": [
                        "een hese stem"
                    ],
                    "target_lang_definitions": {
