                        "sense_id": "85ca1e23-502d-36ff-b8b9-0b693a0ca693",
                        "entry_id": "4dabfcbc-956d-3a09-b1c8-26866db98a41",
                        "glosses": [
                            "toxisches Alkaloid, das im Goldregen (Zytisus) und anderen Hülsenfrüchtlern vorkommt und Zytisismus verursachen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b82605-16eb-4220-b680-506e272e22f3",
                                "sense_id": "85ca1e23-502d-36ff-b8b9-0b693a0ca693",
                                "text": "„Cytisin ist eine starke Base; es schmeckt schwach kaustisch, zersetzt die Ammoniaksalze schon in der Kälte und fällt die Erden und schweren Metalloxyde.“"
                            },
                            {
                                "example_id": "bb2388d8-3fa7-4c70-bef2-5b69f6a17c4a",
                                "sense_id": "85ca1e23-502d-36ff-b8b9-0b693a0ca693",
                                "text": "„Das Cytisin, welches im Goldregen und in zahlreichen anderen Cytisus- sowie Sophora-Arten aufgefunden wurde, hat die Formel C₁₁H₁₄ON₂.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
