                {
                    "sense_id": "a6f324ec-b7d3-3361-99d8-4d873b72af2c",
                    "sense_definition": "To touch or tap someone gently, usually under the chin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "touching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He smiled and <w>chucked</w> the baby under the chin.",
                            "target_lang_translations": {
                                "ru": "Он улыбнулся и <w>потрепал</w> ребенка за подбородок.",
                                "zh": "他微笑着<w>轻拍</w>了下婴儿的下巴。"
                            }
                        },
                        {
                            "text": "She affectionately <w>chucked</w> him under the chin.",
                            "target_lang_translations": {
                                "ru": "Она ласково <w>потрепала</w> его за подбородок.",
                                "zh": "她亲昵地<w>轻拍</w>了他的下巴。"
                            }
                        }
