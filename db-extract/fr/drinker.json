                "senses": [
                    {
                        "sense_id": "e7518497-fe23-3e2f-ac64-200edd1c1847",
                        "entry_id": "2bae5fbb-74d6-34f3-91b0-615092f0a217",
                        "glosses": [
                            "Boire, en parlant d'une boisson festive."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "77d6e67f-cbfd-4c5f-b618-36306b1571ea",
                                "sense_id": "e7518497-fe23-3e2f-ac64-200edd1c1847",
                                "text": "Peu impressionnés par les reliefs congolocartonpâte de ce faux décor d'une version sindbadienne du roi Lion, les bandes de copains et de copines drinkent et s’enjaillent dans un joli vacarme."
                            },
                            {
                                "example_id": "23ecc290-beb2-4241-a72b-a95a1e24d86c",
                                "sense_id": "e7518497-fe23-3e2f-ac64-200edd1c1847",
                                "text": "[…] O Mobutu et Tchombé drinkent leurs verres dans des night-clubs sombres de Kalina."
                            },
                            {
                                "example_id": "d126efba-fe31-44a9-a0a8-25bfc15a3ec2",
                                "sense_id": "e7518497-fe23-3e2f-ac64-200edd1c1847",
                                "text": "Drinkons moult apéros, renforcés par Dédé auquel je remets Psûké pour qu'il l'illustre."
                            }
                        ]
                    }
