                "senses": [
                    {
                        "sense_id": "a9107739-5609-3d73-bece-c6f2ef7837a9",
                        "entry_id": "ebf7b9df-e7e0-32ec-a5c2-153adb92e22b",
                        "glosses": [
                            "Opération consistant en l’implantation, au cœur ou au voisinage d’une tumeur, d’éléments radioactifs tumoricides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20994b13-07e6-4f42-8ca6-086819cb33ec",
                                "sense_id": "a9107739-5609-3d73-bece-c6f2ef7837a9",
                                "text": "La curiethérapie endobronchique consiste à placer, lors d’une fibroscopie, un ou plusieurs cathéters en regard d’une lésion tumorale."
                            },
                            {
                                "example_id": "79a5e386-bedc-43f0-9eda-3c078d2242a7",
                                "sense_id": "a9107739-5609-3d73-bece-c6f2ef7837a9",
                                "text": "« J’étais partie à Lille toute la semaine. Après ma chimio, je suis une curiethérapie. Et quand je suis rentrée hier, Engie m’avait coupé le courant. Ils m’ont laissé le gaz. »"
                            }
                        ]
                    }
                ],
