                                "target_senses": [
                                    {
                                        "sense_id": "565b1933-62c2-3f3d-8aa7-acfafcad6485",
                                        "entry_id": "d10582e4-0eb8-3cb6-8222-1e06f5d178f9",
                                        "glosses": [
                                            "de mate waarin iets bestand is tegen beschadiging; hoe krachtig en stevig iets is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b600cd6-96e3-410a-bc38-42c3366928ae",
                                                "sense_id": "565b1933-62c2-3f3d-8aa7-acfafcad6485",
                                                "text": "De afgelopen twee jaar hebben Boskalis en opdrachtgever ProRail overlegd hoe het probleem opgelost moet worden. Nu gaat de aannemer vier centimeter beton aan de onderzijde van het brugdek weghalen. Dat heeft geen invloed op de stevigheid van de brug. Hoeveel dat gaat kosten, wil ProRail niet zeggen."
                                            },
                                            {
                                                "example_id": "02675e76-ebd9-4bc0-a46d-877b2684a696",
                                                "sense_id": "565b1933-62c2-3f3d-8aa7-acfafcad6485",
                                                "text": "Het principe is simpel. Om de paar centimeter injecteert een speciale machine een kunstgrasvezeltje. \"Daarna doet de natuur z'n werk. De wortels van het gewone gras groeien als het ware om de kunstgrasvezel heen en zorgen zo voor meer stevigheid van het veld.\""
                                            }
                                        ]
                                    }
