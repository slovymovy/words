                        "entry_id": "aaa53e25-76fe-3723-8b3e-7acaf7ea2742",
                        "glosses": [
                            "Pertaining to, or caused by, gravity or gravitation."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8433df69-1a10-48e1-bf67-9a47b2245fd8",
                                "sense_id": "e38f9e74-6fc2-39a1-8588-802df5ae3cc0",
                                "text": "Unlike most moons of the solar system, ours has the heft, the gravitational gravitas, to pull itself into a sphere."
                            }
                        ]
