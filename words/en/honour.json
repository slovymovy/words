                    "sense_id": "c2f59af8-4314-3aaa-a7df-9e68ba1b39ae",
                    "sense_definition": "A female given name from English, a less common spelling of <w>Honor</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_variant",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My great-grandmother was named <w>Honour</w>, representing the virtue she was expected to uphold.",
                            "target_lang_translations": {
                                "ru": "Мою прабабушку звали <w>Онор</w>, что олицетворяло добродетель, которую она должна была хранить.",
                                "tr": "Büyük büyükannemin adı <w>Honour</w>'dı ve koruması beklenen erdemi temsil ediyordu."
                            }
                        },
                        {
                            "text": "<w>Honour</w> is a beautiful name that has become quite rare in modern times.",
                            "target_lang_translations": {
                                "ru": "<w>Онор</w> — красивое имя, которое стало довольно редким в наше время.",
                                "tr": "<w>Honour</w>, modern zamanlarda oldukça nadir hale gelen güzel bir isimdir."
