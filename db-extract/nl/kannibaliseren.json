                "senses": [
                    {
                        "sense_id": "0e03523c-0335-32bf-af4e-c7a3d7fa34dc",
                        "entry_id": "50e1b3cd-8c83-3937-9825-059d10c3aba0",
                        "glosses": [
                            "to cannibalise (eat (parts of) another of one's own species)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "53311954-2ee1-4330-a437-9f5a43ce3df1",
                                "sense_id": "0e03523c-0335-32bf-af4e-c7a3d7fa34dc",
                                "text": "Daar de mannetjes 95% van hun tijd op het nest zitten en dus weinig tijd hebben om buitenshuis te fourageren, kannibaliseren ze eitjes uit hun eigen nest: gemideld ^([sic – meaning gemiddeld]) 36 per dag.",
                                "translation": "Since the males spend 95% of their time on the nest and therefore have little time to forage outside, they cannibalize eggs from their own nest: an average of 36 per day.",
                                "english": "Since the males spend 95% of their time on the nest and therefore have little time to forage outside, they cannibalize eggs from their own nest: an average of 36 per day."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a56601-b9af-330e-86cd-ae987a02f890",
                        "entry_id": "50e1b3cd-8c83-3937-9825-059d10c3aba0",
                        "glosses": [
                            "to cannibalise (remove parts of (a machine, etc) for use in other similar machines)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f0a412f-6fbb-4047-961c-99ed844ac9ac",
                                "sense_id": "d2a56601-b9af-330e-86cd-ae987a02f890",
                                "text": "Van die Neptunes vliegt er nog maar een. De rest is zoals het in vaktermen heet gekannibaliseerd; onderdelen die niet meer te krijgen zijn zijn er vanaf gesloopt om andere toestellen in de lucht te houden.",
                                "translation": "Only one of those Neptunes is still flying. The rest have been, as it's called in technical jargon, cannibalized; parts that are no longer available are scrapped off to keep other aircraft in the air.",
                                "english": "Only one of those Neptunes is still flying. The rest have been, as it's called in technical jargon, cannibalized; parts that are no longer available are scrapped off to keep other aircraft in the air."
                            }
                        ]
                    },
                    {
                        "sense_id": "487a090d-0cc4-33f7-9aeb-6427c7f0c412",
                        "entry_id": "50e1b3cd-8c83-3937-9825-059d10c3aba0",
                        "glosses": [
                            "to cannibalise (reduce sales or market share (for one of one's own products) by introducing another)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9b68c219-402a-4092-ae4c-87c4ed1fee7c",
                                "sense_id": "487a090d-0cc4-33f7-9aeb-6427c7f0c412",
                                "text": "Is de kans niet groot dat V8 zusterzenders SBS 6 en Net5 zal kannibaliseren, er kijkers zal wegtrekken?",
                                "translation": "Isn't there a good chance that V8 will cannibalize sister channels SBS 6 and Net5 and draw away viewers?",
                                "english": "Isn't there a good chance that V8 will cannibalize sister channels SBS 6 and Net5 and draw away viewers?"
                            }
                        ]
                    }
                ],
