                    "sense_id": "46372084-d16d-37d9-a6ad-ef8196dd3879",
                    "sense_definition": "Par malchance ou d'une manière regrettable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "regret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je voulais venir à votre fête hier soir, mais <w>malheureusement</w> j'étais très malade.",
                            "target_lang_translations": {
                                "en": "I wanted to come to your party last night, but <w>unfortunately</w> I was very ill.",
                                "ru": "Я хотел прийти на вашу вечеринку вчера вечером, но <w>к сожалению</w> я был очень болен.",
                                "nl": "Ik wilde gisteravond naar jullie feestje komen, maar <w>helaas</w> was ik erg ziek.",
                                "de": "Ich wollte gestern Abend zu eurer Feier kommen, aber <w>leider</w> war ich sehr krank.",
                                "pl": "Chciałem wpaść na wasze przyjęcie wczoraj wieczorem, ale <w>niestety</w> byłem bardzo chory.",
                                "it": "Volevo venire alla vostra festa ieri sera, ma <w>purtroppo</w> stavo molto male.",
                                "cs": "Včera večer jsem chtěl přijít na vaši oslavu, ale <w>bohužel</w> jsem byl velmi nemocný.",
                                "tr": "Dün akşam partinize gelmek istiyordum ama <w>maalesef</w> çok hastaydım.",
                                "es": "Quería ir a su fiesta anoche, pero <w>desgraciadamente</w> estaba muy enfermo.",
                                "zh": "我昨晚本想来参加你们的聚会，<w>可惜</w>我病得很厉害。"
                            }
                        },
                        {
                            "text": "<w>Malheureusement</w>, le train a eu plus d'une heure de retard à cause de la neige.",
                            "target_lang_translations": {
                                "en": "<w>Unfortunately</w>, the train was more than an hour late because of the snow.",
                                "ru": "<w>К сожалению</w>, поезд опоздал больше чем на час из-за снега.",
                                "nl": "<w>Helaas</w> had de trein vanwege de sneeuw meer dan een uur vertraging.",
                                "de": "<w>Leider</w> hatte der Zug wegen des Schnees mehr als eine Stunde Verspätung.",
                                "pl": "<w>Niestety</w>, pociąg miał ponad godzinę opóźnienia z powodu śniegu.",
                                "it": "<w>Purtroppo</w> il treno ha avuto più di un'ora di ritardo a causa della neve.",
                                "cs": "<w>Bohužel</w> vlak kvůli sněhu měl zpoždění víc než hodinu.",
                                "tr": "<w>Maalesef</w>, kar yüzünden tren bir saatten fazla gecikti.",
                                "es": "<w>Desgraciadamente</w>, el tren tuvo más de una hora de retraso a causa de la nieve.",
                                "zh": "<w>可惜</w>的是，火车因为下雪晚点了一个多小时。"
                            }
                        }
                    ],
                    "synonyms": [
