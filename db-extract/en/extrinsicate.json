                "senses": [
                    {
                        "sense_id": "60143f56-9fcc-31db-b76f-6da4bf7c8eb3",
                        "entry_id": "9968e919-2744-3922-82ce-e21a8185fe0c",
                        "glosses": [
                            "To make extrinsic; to separate out or externalize."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bdecace-7827-4c98-914f-bdd17dcb177e",
                                "sense_id": "60143f56-9fcc-31db-b76f-6da4bf7c8eb3",
                                "text": "Duke Savell notwithstanding, upon these great emergencyes, seemed, though with small hopes of any good effects, willing to extrinsicate his desire in a business which so much conceirned his Prince."
                            },
                            {
                                "example_id": "65d96f13-3c1b-423a-8068-bbdd22d46454",
                                "sense_id": "60143f56-9fcc-31db-b76f-6da4bf7c8eb3",
                                "text": "God was free to create or not create, that is, to extrinsicate the Word or not, as he chose, and, having resolved to extrinsicate the Word, he was still free to give it the highest possible extrinsication or not, as it pleased himself."
                            },
                            {
                                "example_id": "a677365c-96be-4f22-83aa-e00a6fddb705",
                                "sense_id": "60143f56-9fcc-31db-b76f-6da4bf7c8eb3",
                                "text": "The qualities which make a man a saint—faith, an indomitable will, a passion for self-sacrifice—are not those that extrinsicate themselves in striking bodily stigmata."
                            },
                            {
                                "example_id": "e5613ea8-bca6-4ab3-a899-ec1c4bd4d1de",
                                "sense_id": "60143f56-9fcc-31db-b76f-6da4bf7c8eb3",
                                "text": "It is a solution that, by placing full confidence in Christ's capacity to feel and understand pain, fear and desolation, in a word, all the negative elements that man may experience on earth, allows Hopkins to find hope, consolation, and ultimate salvation, allows this poet-priest to explicate and extrinsicate his own personal and poetic presence, solely in the presence and immanence of Christ:"
                            }
                        ]
                    }
