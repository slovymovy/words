                "senses": [
                    {
                        "sense_id": "1fa63c31-978d-35c3-a271-e6e4c8dde8f1",
                        "entry_id": "ddf5ffa7-0070-37a2-a6a3-8567f507ab2f",
                        "glosses": [
                            "Jouer une sorte d’air particulier au Nivernais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c532d9-4a9d-4dfe-9670-9158d7febd67",
                                "sense_id": "1fa63c31-978d-35c3-a271-e6e4c8dde8f1",
                                "text": "Le flûteux était remonté sur son trône et tiaulait le baiser préliminaire [à la bourrée]."
                            }
                        ]
                    },
                    {
                        "sense_id": "53382a3c-7f88-31ca-baf7-caea227e9845",
                        "entry_id": "ddf5ffa7-0070-37a2-a6a3-8567f507ab2f",
                        "glosses": [
                            "Chanter pour soutenir le travail des bœufs attelés à la charrue."
                        ],
                        "tags": [
                            "Nivernais"
                        ],
                        "examples": [
                            {
                                "example_id": "8be2635b-1dc5-413e-adec-e27368287fe2",
                                "sense_id": "53382a3c-7f88-31ca-baf7-caea227e9845",
                                "text": "Un homme de charrue qui ne sait pas « tiauler » ses bœufs n’a pas le chic de sa profession, il manque même d’une qualité indispensable s’il faut en croire le Fleta, ce curieux traité de jurisprudence anglo-normande du XIIIᵉ siècle."
                            },
                            {
                                "example_id": "20a5054d-b8bb-4581-a90b-298f91d5b1fb",
                                "sense_id": "53382a3c-7f88-31ca-baf7-caea227e9845",
                                "text": "Par le soupirail grillagé passent une branche d'arbre et une voix de femme aigre et lente. Une bouvière solitaire et qui tiaule."
                            }
                        ]
                    }
                ],
