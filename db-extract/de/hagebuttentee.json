                            {
                                "example_id": "9bcbfdc5-0fa0-4a23-a106-2e6ae78e5ae8",
                                "sense_id": "a65c7f98-85cd-3551-b54d-dc7ff4ee4eee",
                                "text": "Als Kind habe ich gerne Hagebuttentee getrunken."
                            },
                            {
                                "example_id": "f0f4c1de-cdb8-49be-b37c-3ec2a65484a0",
                                "sense_id": "a65c7f98-85cd-3551-b54d-dc7ff4ee4eee",
                                "text": "„Obwohl Sonntag war, gab es frische Brötchen und hausgemachte Marmelade und etwas Käse und zwei gekochte Eier, und Papa trank starken Kaffee, und ich trank Hagebuttentee.“"
                            }
                        ],
