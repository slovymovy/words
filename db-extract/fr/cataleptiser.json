                "senses": [
                    {
                        "sense_id": "e91bf804-f465-3060-a329-0e6e6d75159a",
                        "entry_id": "11c4ea78-f117-31d4-87b0-f34035b0c3ec",
                        "glosses": [
                            "Faire passer dans un état cataleptique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1ae68df-c1ba-457f-9aa9-3e71314712eb",
                                "sense_id": "e91bf804-f465-3060-a329-0e6e6d75159a",
                                "text": "Je me fais relire par les enfants quelques chapitres de Bovet, tandis que Zozo (le chat) se fait cataleptiser sur mon duvet."
                            },
                            {
                                "example_id": "2b9c3c00-13a2-4d50-b729-63896e4a9b28",
                                "sense_id": "e91bf804-f465-3060-a329-0e6e6d75159a",
                                "text": "Tout le monde connaît le moyen de cataleptiser un coq."
                            },
                            {
                                "example_id": "2115963b-ad2b-4c3d-a026-6f14214fc401",
                                "sense_id": "e91bf804-f465-3060-a329-0e6e6d75159a",
                                "text": "Quand le petit goéland se confond avec la couleur des rochers, il a eu besoin de percevoir le cri d'un autre pour se cataleptiser."
                            }
                        ]
                    }
                ],
