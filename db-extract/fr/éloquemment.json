                    {
                        "sense_id": "9eb0f73e-e6b6-322f-8e84-7f69107cce4d",
                        "entry_id": "a29746d1-8975-3a51-85e5-d71fd8932219",
                        "glosses": [
                            "Avec éloquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa4951d-1b47-4fa8-9f39-74dd7c7763bf",
                                "sense_id": "9eb0f73e-e6b6-322f-8e84-7f69107cce4d",
                                "text": "Il a éloquemment parlé."
                            },
                            {
                                "example_id": "d28c165c-c91a-45bf-b10a-a8b6e8ebf8e3",
                                "sense_id": "9eb0f73e-e6b6-322f-8e84-7f69107cce4d",
                                "text": "Il a plaidé éloquemment."
                            },
                            {
                                "example_id": "75a567c1-c231-47ca-aac7-10ae8677ca21",
                                "sense_id": "9eb0f73e-e6b6-322f-8e84-7f69107cce4d",
                                "text": "Que de bonnes doctrines j’ai reçues de toi, grand homme ! et comme tu me fis voir, par raisons éloquemment déduites, que le travail était fait pour les sots !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e702995e-d86d-45b0-af9b-da760fd178b5",
                        "source_entry_id": "a29746d1-8975-3a51-85e5-d71fd8932219",
                        "source_sense_id": "9eb0f73e-e6b6-322f-8e84-7f69107cce4d",
                        "target_lang_word": "eloquently",
