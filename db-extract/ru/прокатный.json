                "senses": [
                    {
                        "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                        "entry_id": "cd5f8a3a-032c-3069-91e8-c6811af233cf",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительными прокат, прокатка; предназначенный, служащий для прокатки; изготовленный путем прокатки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6acbd8c2-faef-4990-b0ca-28e8fc1d7800",
                                "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                                "text": "Прокатное производство."
                            },
                            {
                                "example_id": "9a4c2d4c-9f5d-4469-8858-01255fa82ca2",
                                "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                                "text": "Прокатный цех."
                            },
                            {
                                "example_id": "da880e6c-3b81-42d7-b3bb-6bed82128a48",
                                "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                                "text": "Прокатные металлические изделия."
                            },
                            {
                                "example_id": "6aea8c1a-d985-4ddb-aa37-aee587ef16e4",
                                "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                                "text": "Прокатный стан."
                            },
                            {
                                "example_id": "7221f15d-c49f-4cf9-9411-0369661d379a",
                                "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                                "text": "Прокатные валки."
                            },
                            {
                                "example_id": "5444b425-75d7-447f-9bbe-cf27ce14dc28",
                                "sense_id": "81705ab6-2330-35b3-a4ca-35c9efe0fe6c",
                                "text": "Эта машина приводила в движение и воздуходувки, и прокатные станки, и все машины токарного цеха."
                            }
                        ]
                    }
