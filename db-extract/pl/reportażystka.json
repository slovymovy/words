                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47161c73-a087-4501-a1d4-2cf6427bb7f2",
                                "sense_id": "b223279c-d22e-3d76-8cd4-fcf5acff09ab",
                                "text": "Teksty tej reportażystki tłumaczono m.in. na czeski i ukraiński."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eebf11ab-8d47-4c35-80c4-6199abd85bbb",
                        "source_entry_id": "d6ed569c-2d29-33b8-88f9-b74875413362",
                        "source_sense_id": "b223279c-d22e-3d76-8cd4-fcf5acff09ab",
                        "target_lang_word": "Reporterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reporterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c56e9e3e-eef1-38ec-a890-3d01f35f020f",
                                        "entry_id": "2caa4092-b439-3ff8-8c3f-6d8e61423123",
                                        "glosses": [
                                            "Journalistin, die am Ort des Geschehens (oder zumindest in dessen Nähe) ist, über das sie berichtet"
                                        ],
                                        "tags": [
                                            "Journalismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "350a493e-edd6-4119-ad0f-42a0e86e62fd",
                                                "sense_id": "c56e9e3e-eef1-38ec-a890-3d01f35f020f",
                                                "text": "„Die Reporterin achtet ihre Bitte zwar, veröffentlicht aber trotzdem einige Details, die sie aus zuverlässigen Quellen weiß.“"
                                            },
                                            {
                                                "example_id": "94e667c6-68e7-4a35-a5ee-b7bc696fe2ab",
                                                "sense_id": "c56e9e3e-eef1-38ec-a890-3d01f35f020f",
                                                "text": "„Tatsächlich hat sich Earnest gar nicht eingemischt, sondern so zurückhaltend wie möglich auf die Frage einer Reporterin geantwortet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
