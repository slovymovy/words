                                        "examples": [
                                            {
                                                "example_id": "54dd3b2e-f1a7-4eaf-a843-dc6384364592",
                                                "sense_id": "2b0f7fb8-8302-3b6d-ac38-4fb02ad0936d",
                                                "text": "Le chef de l’État s’est refusé à gracier cet assassin."
                                            },
                                            {
                                                "example_id": "754e0d0a-7377-4c4f-872f-1c133b4390cf",
                                                "sense_id": "2b0f7fb8-8302-3b6d-ac38-4fb02ad0936d",
                                                "text": "Le roi vous fait donc grâce ?\n — Non, dit le duc, et je ne crois pas que Louis XIII ait plus jamais l'occasion de gracier ou d'enfermer qui que ce soit."
