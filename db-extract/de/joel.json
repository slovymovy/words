                                        "sense_id": "4a84ddfb-6160-3cf2-bc95-eaf670dad535",
                                        "entry_id": "3ca147c0-ae67-379a-8c2e-745960925454",
                                        "glosses": [
                                            "A minor prophet, a son of Samuel, and other Old Testament persons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebecb604-214e-45fe-9e80-7d888714f673",
                                                "sense_id": "4a84ddfb-6160-3cf2-bc95-eaf670dad535",
