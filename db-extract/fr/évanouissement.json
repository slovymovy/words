        "fr-extract.jsonl": [
            {
                "entry_id": "de2a34b7-d2fd-3943-a627-91d59ac604b7",
                "word": "évanouissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "631400a9-da17-4127-a8b8-81f363f5edfa",
                        "entry_id": "de2a34b7-d2fd-3943-a627-91d59ac604b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "évanouissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "782d8989-6fe5-3fd4-aac5-9c70520b024e",
                        "entry_id": "de2a34b7-d2fd-3943-a627-91d59ac604b7",
                        "glosses": [
                            "Perte de connaissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e22905e-4149-4273-b832-fec78ca2bd80",
                                "sense_id": "782d8989-6fe5-3fd4-aac5-9c70520b024e",
                                "text": "Il se réveilla d’un sommeil agité et entrecoupé par les impressions confuses qui accompagnent toujours un long évanouissement."
                            },
                            {
                                "example_id": "b4af2281-b004-4129-9647-279b5a4b1e7b",
                                "sense_id": "782d8989-6fe5-3fd4-aac5-9c70520b024e",
                                "text": "Les femmes de la cour donnaient des signes de ravissement, penchées au bord de leurs loges, et tentaient même l’évanouissement le plus flatteur."
                            },
                            {
                                "example_id": "7a77d062-c3c2-40cc-a9ad-a160b9565edd",
                                "sense_id": "782d8989-6fe5-3fd4-aac5-9c70520b024e",
                                "text": "Pour couronner le tout, mon avocat se laisse aller sur son banc, tombe en faiblesse, et ne revient de son évanouissement qu'après avoir bu un verre de vinaigre des quatre-voleurs."
                            },
                            {
                                "example_id": "b22d3bdf-7bb4-41ed-9147-c843ae72033f",
                                "sense_id": "782d8989-6fe5-3fd4-aac5-9c70520b024e",
                                "text": "— Et puis, mon ami, puisque vous me forcez à tout vous dire, je vous avoue que moi-même je ne me porte pas très bien. J’ai eu des évanouissements, j’ai consulté. Enfin, d’un jour à l’autre, je peux disparaître."
                            },
                            {
                                "example_id": "744b17e4-2e92-4c06-aec6-16e8dfe4f4e4",
                                "sense_id": "782d8989-6fe5-3fd4-aac5-9c70520b024e",
                                "text": "Il y a plus de vingt ans, un soir qu’il traversait la place d’Italie, Giacometti fut renversé par une auto. Blessé, la jambe tordue, dans l’évanouissement lucide où il était tombé, il ressentit d’abord une espèce de joie « Enfin quelque chose m’arrive ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "4924eed5-5b5e-3d96-afeb-aff45a934d36",
                        "entry_id": "de2a34b7-d2fd-3943-a627-91d59ac604b7",
                        "glosses": [
                            "Disparition progressive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df6b6ae6-876e-4c45-8670-e9cf3f7dc467",
                                "sense_id": "4924eed5-5b5e-3d96-afeb-aff45a934d36",
                                "text": "L’évanouissement de ses illusions."
                            }
                        ]
                    },
                    {
                        "sense_id": "18179c70-4f0f-3f25-bc6f-80f3ece11ccb",
                        "entry_id": "de2a34b7-d2fd-3943-a627-91d59ac604b7",
                        "glosses": [
                            "Élimination d'une grandeur permettant de simplifier une équation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "724e6abe-9f10-4a02-9afb-a9f63d727483",
                                "sense_id": "18179c70-4f0f-3f25-bc6f-80f3ece11ccb",
                                "text": "L’évanouissement d’une inconnue, d’une quantité, d’un dénominateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "1478c888-3097-3e76-92f8-74a69850c860",
