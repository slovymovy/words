                ],
                "senses": [
                    {
                        "sense_id": "3e816ea0-232e-3508-8b48-23968d1fa13b",
                        "entry_id": "004c9dd2-9a42-3204-af62-1b30074f906b",
                        "glosses": [
                            "быть соседом, жить в соседстве с кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1136d816-c066-4987-89ba-e6dc41096e7e",
                                "sense_id": "3e816ea0-232e-3508-8b48-23968d1fa13b",
                                "text": "Едва ли не впервые я соседствовал, сосуществовал с немалым чиновником, близко наблюдал его трудовой распорядок."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcd19aa6-7705-380e-bd93-d587881622d6",
                        "entry_id": "004c9dd2-9a42-3204-af62-1b30074f906b",
                        "glosses": [
                            "находиться, располагаться или происходить, иметь место рядом, поблизости, вместе с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203203ad-f644-4efa-9f46-88f47c019241",
                                "sense_id": "fcd19aa6-7705-380e-bd93-d587881622d6",
                                "text": "С этими чисто восточными лакомствами соседствовали европейские ― петербургский шоколад и московские конфеты."
                            },
                            {
                                "example_id": "134ca886-bbbf-46b8-9eb1-b1338309c7d0",
                                "sense_id": "fcd19aa6-7705-380e-bd93-d587881622d6",
                                "text": "Романский стиль отличается крайней разнородностью своих проявлений, смелые поиски нового соседствуют с глубоко отсталыми формами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef52e7c3-3367-4011-9fff-6bafe05efed0",
                        "source_entry_id": "004c9dd2-9a42-3204-af62-1b30074f906b",
                        "source_sense_description": "быть соседом, жить в соседстве с кем-либо",
                        "target_lang_word": "estar vecino",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "897783d1-be36-49ba-a971-a90bbbbccb60",
                        "source_entry_id": "004c9dd2-9a42-3204-af62-1b30074f906b",
                        "source_sense_description": "быть соседом, жить в соседстве с кем-либо",
                        "target_lang_word": "voisiner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voisiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec130df8-1085-3b67-a05e-c2ab3ef4bb37",
                                        "entry_id": "974ca247-6611-3f48-a329-d503b5f3fc2d",
                                        "glosses": [
                                            "Visiter familièrement ses voisins."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d15a611-c433-4002-8d31-6b72e836d511",
                                                "sense_id": "ec130df8-1085-3b67-a05e-c2ab3ef4bb37",
                                                "text": "Il s’était exempté de voisiner, en prétextant de ses occupations, de ses habitudes et de sa santé, qui ne lui permettaient pas, disait-il, de revenir la nuit par une route le long de laquelle brouillassait la Thune."
                                            },
                                            {
                                                "example_id": "a0315d5d-aa12-44e3-bfd7-d384ee5a4bf6",
                                                "sense_id": "ec130df8-1085-3b67-a05e-c2ab3ef4bb37",
                                                "text": "— Comme madame Marneffe est une femme très comme il faut, la femme d’un employé, que tu peux la voir sans te compromettre, reprit le baron, je voudrais te voir voisiner avec elle."
                                            },
                                            {
                                                "example_id": "63825787-fa32-4dba-9229-9a2044cf7b00",
                                                "sense_id": "ec130df8-1085-3b67-a05e-c2ab3ef4bb37",
                                                "text": "On y vit un peu comme dans une petite ville de province, car on y voisine beaucoup et on se met volontiers sur les portes pour regarder les passants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5711c74d-3f01-3bc8-91df-4d479e94f567",
                                        "entry_id": "974ca247-6611-3f48-a329-d503b5f3fc2d",
                                        "glosses": [
                                            "Se trouver situé près de, être placé à côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93718d15-6a86-423b-a373-71b4c87b7988",
                                                "sense_id": "5711c74d-3f01-3bc8-91df-4d479e94f567",
                                                "text": "Trois croix voisinaient avec celle qui marquait la tombe d'un matelot autrichien."
                                            },
                                            {
                                                "example_id": "df62674d-7ccc-46a5-a5f6-bf315b6d2e87",
                                                "sense_id": "5711c74d-3f01-3bc8-91df-4d479e94f567",
                                                "text": "Pataud alla s’attaquer à un panier vide qui voisinait, dans le fond de la cabane, avec des râteaux et des pelles."
                                            },
                                            {
                                                "example_id": "5e6f948b-7d2e-477f-a0cd-b35f718f82c2",
                                                "sense_id": "5711c74d-3f01-3bc8-91df-4d479e94f567",
                                                "text": "23 janvier 1941 – Il y avait le premier vicaire de Sainte-Clot, sa panoplie de lavettes enfouies dans une satinette d’église ; il voisinait avec la bigote en chef qui voisinait avec M. de Bersac qui habite rue Las Cases, grand aristo distingué, Homo nordicus type, qui voisinait avec une blonde de mœurs incertaines et de seins provocants, qui voisinait avec un affreux petit Môssieu bien sale, qui voisinait avec nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
