                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ace7b7ab-9338-3a14-a3da-e98dad019512",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to go (past), to leave (behind), to cross, to make it (across)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "00c716e1-5eb6-47d0-89cb-5a669d9e9797",
                                "sense_id": "ace7b7ab-9338-3a14-a3da-e98dad019512",
                                "text": "маши́на едва́ проскочи́ла перекрёсток",
                                "translation": "the car just barely crossed the intersection",
                                "english": "the car just barely crossed the intersection"
                            }
                        ]
                    },
                    {
                        "sense_id": "fdd51c1f-501c-3fdf-8025-d952a7d16b64",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to miss, to overshoot"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a6780389-0513-4b3a-aaaf-fa5545f371be",
                                "sense_id": "fdd51c1f-501c-3fdf-8025-d952a7d16b64",
                                "text": "проскочи́ть свою́ остано́вку",
                                "translation": "to miss one's stop",
                                "english": "to miss one's stop"
                            },
                            {
                                "example_id": "ccefb851-e938-4cb9-8548-2ad7f01e722e",
                                "sense_id": "fdd51c1f-501c-3fdf-8025-d952a7d16b64",
                                "text": "проскочи́ть поворо́т с магистра́ли",
                                "translation": "to miss/overshoot the exit from the highway",
                                "english": "to miss/overshoot the exit from the highway"
                            }
                        ]
                    },
                    {
                        "sense_id": "33a4ec78-b12a-32be-aa11-f310f5182077",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to fall (through, between)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2bd660f5-d3f6-3136-83d6-130bc78fc7c5",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to slip in, to sneak in, to slip (into), to sneak (into)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "723d23d7-7789-3498-a4f4-308212619911",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to manage to become (someone), to manage to get (somewhere)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "41f441fa-2c6c-4720-a828-e6c385f4d424",
                                "sense_id": "723d23d7-7789-3498-a4f4-308212619911",
                                "text": "проскочи́ть в нача́льники",
                                "translation": "to manage to become a boss",
                                "english": "to manage to become a boss"
                            },
                            {
                                "example_id": "18584595-e7bf-48e8-ad0a-9732831462be",
                                "sense_id": "723d23d7-7789-3498-a4f4-308212619911",
                                "text": "проскочи́ть в университе́т",
                                "translation": "to manage to enter the university",
                                "english": "to manage to enter the university"
                            },
                            {
                                "example_id": "f88900c2-3604-4cb1-9c64-dc06a06942bc",
                                "sense_id": "723d23d7-7789-3498-a4f4-308212619911",
                                "text": "проскочи́ть в да́мки (о ша́шке)",
                                "translation": "to manage to get crowned",
                                "english": "to manage to get crowned"
                            }
                        ]
                    },
                    {
                        "sense_id": "8f0893be-1ab3-37d2-a19d-9d6083de2b74",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to make it (through), to manage, to cope (with), to hurdle"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6da0e635-436b-4cfe-be7d-acec28138b4d",
                                "sense_id": "8f0893be-1ab3-37d2-a19d-9d6083de2b74",
                                "text": "сам не зна́ю, как я проскочи́л (че́рез) экза́мен",
                                "translation": "I don't know myself how I made it through the exam",
                                "english": "I don't know myself how I made it through the exam"
                            }
                        ]
                    },
                    {
                        "sense_id": "c631fba5-6b0c-3164-83af-b3ce4530f42e",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to slip out"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b76539c9-b382-4b32-a7e4-ba62feaae38c",
                                "sense_id": "c631fba5-6b0c-3164-83af-b3ce4530f42e",
                                "text": "как э́та информа́ция могла́ проскочи́ть в пре́ссу?",
                                "translation": "how could this information have leaked [slipped out] into the press?",
                                "english": "how could this information have leaked [slipped out] into the press?"
                            },
                            {
                                "example_id": "04645e35-6da2-404c-b3bb-c003d5172999",
                                "sense_id": "c631fba5-6b0c-3164-83af-b3ce4530f42e",
                                "text": "проскочи́ло мно́го оши́бок",
                                "translation": "many errors have crept / slipped in",
                                "english": "many errors have crept / slipped in"
                            }
                        ]
                    },
                    {
                        "sense_id": "20ba0ae4-8562-3dea-adcb-f41ce04c9cb2",
                        "entry_id": "5a9ed1a8-1e74-33fd-b52c-b41766161ad3",
                        "glosses": [
                            "to slip by, to pass quickly"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "48aa3dd5-4e50-4547-8a4a-bbb7ee15698f",
                                "sense_id": "20ba0ae4-8562-3dea-adcb-f41ce04c9cb2",
                                "text": "ле́то проскочи́ло незаме́тно",
                                "translation": "the summer slipped by before we [they, etc] knew it",
                                "english": "the summer slipped by before we [they, etc] knew it"
                            }
                        ]
                    }
