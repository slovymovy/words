                "senses": [
                    {
                        "sense_id": "cb4dcda0-ec77-3f94-8925-0186bc709de9",
                        "entry_id": "86b2455a-648e-3026-81cb-986b4f59063c",
                        "glosses": [
                            "sensatie wekkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665de2d5-d2d4-4149-8a6d-191ab1c82956",
                                "sense_id": "cb4dcda0-ec77-3f94-8925-0186bc709de9",
                                "text": "Wij staan bekend om onze sensationele koffie"
                            },
                            {
                                "example_id": "7d7f8da4-f173-4eb2-8e52-7edcb7fa8119",
                                "sense_id": "cb4dcda0-ec77-3f94-8925-0186bc709de9",
                                "text": "De centrale hal was voorzien van een sensationele kroonluchter, die amechtig antiek hing te zijn. `Een van onze pronkstukken,' zei de majordomus, die alles merkte, dus ook dat de lamp mij was opgevallen. 'Alleen erg lastig in het onderhoud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9872db67-7038-4eb4-a96b-18f563b9fecb",
                        "source_entry_id": "86b2455a-648e-3026-81cb-986b4f59063c",
                        "source_sense_id": "cb4dcda0-ec77-3f94-8925-0186bc709de9",
                        "target_lang_word": "sensationell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensationell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad57116-5511-3a03-9cfd-65bec58ad8b4",
                                        "entry_id": "c25721e9-9297-36d8-b007-3c8c2545d955",
                                        "glosses": [
                                            "unerwartet und so, dass es Aufsehen erregt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c42d7b-fc3d-4002-b603-3ca55a30d987",
                                                "sense_id": "5ad57116-5511-3a03-9cfd-65bec58ad8b4",
                                                "text": "Der Erfolg dieses Produktes ist einfach sensationell."
                                            },
                                            {
                                                "example_id": "b3c01094-d099-44d5-a1db-666393373158",
                                                "sense_id": "5ad57116-5511-3a03-9cfd-65bec58ad8b4",
                                                "text": "Sensationell an Busbice's Beobachtungen ist, dass der Roboter keine zusätzlichen Programme hat, die sein Verhalten steuern."
                                            },
                                            {
                                                "example_id": "81db6a97-38cf-44d7-a039-4523c0a34d9d",
                                                "sense_id": "5ad57116-5511-3a03-9cfd-65bec58ad8b4",
                                                "text": "Zu einer wirklich sensationellen archäologischen Entdeckung kam es Ende des vergangenen Jahres in Mainz. Beim Ausschachten für einen großen Hotel-Neubau nahe am Rheinufer stieß man auf die Reste mehrerer Schiffe aus spätrömischer Zeit."
                                            },
                                            {
                                                "example_id": "58a05a1b-40e1-42fd-85aa-632d232f180b",
                                                "sense_id": "5ad57116-5511-3a03-9cfd-65bec58ad8b4",
                                                "text": "Es handelt sich wohl um einen der sensationellsten «Scheunenfunde», die jemals in der Autogeschichte gemacht wurden. Dutzende von legendären Oldtimern haben in Westfrankreich in Garagen und Unterständen ein halbes Jahrhundert in einer Art Dornröschenschlaf verbracht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
