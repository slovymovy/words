                "senses": [
                    {
                        "sense_id": "604aa925-d28e-39ee-a994-2fa92ebe1472",
                        "entry_id": "237be519-f25d-3434-a96d-2dcc4b9e1cda",
                        "glosses": [
                            "ein Träger (Vektor), der einen Impfstoff in Körperzellen bringt, der vom Typ Adenovirus ist und besonders bearbeitet wurde, um nicht selbst Krankheiten zu übertragen"
                        ],
                        "tags": [
                            "Virologie"
                        ],
                        "examples": [
                            {
                                "example_id": "49f4a09b-af79-40e9-9deb-816c2c5bbb55",
                                "sense_id": "604aa925-d28e-39ee-a994-2fa92ebe1472",
                                "text": "„Die vorliegende Erfindung betrifft neue Adenovirusvektoren zur Verwendung bei der Gentherapie, die dazu bestimmt sind, die Erzeugung von replikationskompetenten Adenoviren (RCA) während der in vitro-Vermehrung und der klinischen Verwendung zu verhindern.“"
                            },
                            {
                                "example_id": "d93eaa41-23b3-413d-8c66-a8b3b8b0e6e0",
                                "sense_id": "604aa925-d28e-39ee-a994-2fa92ebe1472",
                                "text": "Die DNA eines spezifischen Gens kann in einen Adenovirusvektor übertragen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
