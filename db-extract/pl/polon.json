                    {
                        "translation_id": "dddbea85-6cc4-4065-830a-4561f2f6d947",
                        "source_entry_id": "53f39a6a-4dde-3bcc-8009-4eda066a6ef0",
                        "source_sense_id": "6c4253da-dae7-370f-9a33-791d940856bc",
