                ],
                "senses": [
                    {
                        "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                        "entry_id": "18b26463-92e4-376a-9722-f88519c7ba95",
                        "glosses": [
                            "Grab, in dem die Urne mit der Asche eines Verstorbenen beigesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10a3e82-a79e-43ae-a03a-23e76c52b31a",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Ein Urnengrab ist in der Regel deutlich kleiner als ein Sarggrab.“"
                            },
                            {
                                "example_id": "c8156b26-5b2a-4beb-af9f-95288c0bb23b",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "[Schlagzeile:] »Urnengräber aus der Bronzezeit geplündert«"
                            },
                            {
                                "example_id": "1900c835-c4cf-4fd5-9904-6bd09818ba10",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "[Delémont/Schweiz:] „Auf dem Gemeindegebiet wurden 15 Urnengräber aus der Bronzezeit gefunden.“"
                            },
                            {
                                "example_id": "644e0e19-e775-4a45-baf1-fb153f5b6820",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "[Imst/Österreich:] „Eine erste Besiedlung der Region für die Bronzezeit ist durch Urnengräber belegt.“"
                            },
                            {
                                "example_id": "b58117b9-7d1d-4e67-9891-01d4a9c5e3ae",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Die Bestattungskultur ändert sich in Deutschland. Der Trend geht weg vom Erdgrab, hin zum Urnengrab oder der Bestattung im Friedwald.“"
                            },
                            {
                                "example_id": "7ee02e59-c21c-45bb-8bc3-4ba9a6455a2b",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Anonyme Bestattungen und das Urnengrab auf der Wiese nehmen zu.“"
                            },
                            {
                                "example_id": "70aa0d97-c55c-4e51-902e-8db2fdf36b31",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Große Familiengräber sind heute weniger gefragt, umso mehr kleinere Urnengräber, die ebenso liebevoll gestaltet werden können.“"
                            },
                            {
                                "example_id": "d2ab0bbc-8cd3-4924-90f8-fb73d21fba93",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Urnengräber lassen sich direkt nach der Beisetzung komplett bepflanzen.“"
                            },
                            {
                                "example_id": "c8286b72-ce6d-4685-b778-464252fb726d",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Nur fünf Prozent der jährlich etwa 600 Toten in Eisenach möchten nicht verbrannt werden. Deshalb dominieren Urnengräber – einzelne, Familiengräber oder Gemeinschaftsanlagen.“"
                            },
                            {
                                "example_id": "3b564db2-6ba7-4758-9808-9467e8007df7",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "[Monte Grappa:] „Mehr als 12.000 italienische und 10.000 österreichische Soldaten ruhen hier. Für die namentlich bekannten Toten gibt es Urnengräber.“"
                            },
                            {
                                "example_id": "0d006d8f-3817-4297-ae58-fc597853b643",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Nun können Menschen und Tiere auch über den Tod hinaus miteinander verbunden bleiben, in einem gemeinsamen Urnengrab.“"
                            },
                            {
                                "example_id": "052aa742-2fca-4c51-9c8b-e150e1fa8718",
                                "sense_id": "9df54f56-2993-3346-b5c8-df65b3c91772",
                                "text": "„Die Kosten für ein Urnengrab (von der Wandnische bis zum begrüntes Flachgrab) liegen bei der Bestattung Wien zwischen 500 und 700 Euro für eine Nutzungsdauer von zehn Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
