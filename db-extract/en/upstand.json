                                        "entry_id": "57d6d706-080c-3c0d-984f-75f1e19da345",
                                        "glosses": [
                                            "Ce qui garnit, orne ou renforce le bord de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2170e226-8829-424d-895d-24bdb4da9235",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "Le massif dioritique de Lesterps, que la route de Bussière-Boffy recoupe transversalement sur 3 kilomètres, est en disposition synclinale : les gneiss plongent sous la diorite aussi bien à l'Ouest, près de Lesterps, que sur la bordure est."
                                            },
                                            {
                                                "example_id": "af431720-53c3-4c3e-ab04-6058ebb2dfbe",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "La bordure d’un bas-relief."
                                            },
                                            {
                                                "example_id": "03f6bc8a-e495-4e6a-b4cf-765f8859a51c",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "La bordure d’une tapisserie."
                                            },
                                            {
                                                "example_id": "42920551-ab61-4de9-b723-31bce6300d31",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "La bordure d’un chapeau, d’un soulier."
                                            },
                                            {
                                                "example_id": "4dee8e7d-0c99-4aa8-95bb-a988e167c507",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "Bordure de galon."
                                            },
                                            {
                                                "example_id": "991067ea-c970-4783-a896-214bd29f0ab8",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "Les bordures d’un parterre."
                                            },
                                            {
                                                "example_id": "d3b3648c-d332-46f7-8b82-694374a50fa7",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "Bordure de buis, de gazon, de fraisiers, de lavande, etc."
                                            },
                                            {
                                                "example_id": "e3420f33-01b6-42d4-b562-93038ec68dfc",
                                                "sense_id": "b10293b7-7bcb-3fd4-8cc9-f5a00a655c6f",
                                                "text": "De temps en temps un rayon d’aurore, ou un verre de gin, c’est là ce qu’on appelle le bonheur. Une mince bordure de bien autour de l’immense suaire du mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbb6c66-3d14-367f-9274-418c222f3157",
                                        "entry_id": "57d6d706-080c-3c0d-984f-75f1e19da345",
                                        "glosses": [
                                            "Ce qui garnit, orne ou renforce le bord de quelque chose.",
                                            "Bord inférieur d'une voile déployée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e3b83ac-d44d-38e0-87d8-10ba49ba93af",
                                        "entry_id": "57d6d706-080c-3c0d-984f-75f1e19da345",
                                        "glosses": [
                                            "Brisure qui entoure l’écu et dont la couleur est toujours différente de l’émail du champ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
