                "pos": "noun",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "7afc0e62-17b4-484e-9b9b-32ead2a547cf",
                        "entry_id": "39742d33-bb97-3083-b20e-da95c9039193",
                        "tags": [
                            "transcription"
                        ],
                        "form": "vʹjuga"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "decaed90-2a07-3a1a-93e1-b283579ea399",
                        "entry_id": "39742d33-bb97-3083-b20e-da95c9039193",
                        "glosses": [
                            "heftiger Schneesturm, Schneegestöber"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e11827a-ffa8-46a7-ae0d-c524253b8841",
                        "source_entry_id": "39742d33-bb97-3083-b20e-da95c9039193",
                        "source_sense_id": "decaed90-2a07-3a1a-93e1-b283579ea399",
                        "source_sense_description": "Meteorologie: heftiger Schneesturm, Schneegestöber",
                        "target_lang_word": "Schneesturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneesturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                        "entry_id": "319741ee-4acd-388c-af52-90be2a168f48",
                                        "glosses": [
                                            "starker Schneefall bei Wind, Sturm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beeb612e-3d93-4328-84f7-bd10f6c36bf8",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "Bei den Schneestürmen brach Chaos auf den Straßen aus."
                                            },
                                            {
                                                "example_id": "c95794f4-c13c-4248-a5ea-42f7a66ba438",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Als ich unten im Zentrum ankam, war der Schneefall zu einem undurchdringlichen Schneesturm angewachsen.“"
                                            },
                                            {
                                                "example_id": "4b027378-4db4-44e3-ab06-57d886fa8359",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Am Dienstag kam ein Schneesturm auf, und am Freitag hatten wir rodelfrei.“"
                                            },
                                            {
                                                "example_id": "dd9d1b34-6084-4135-9e16-07dfa0d4a409",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Dass das Leben in der Kolonie auch seine Schattenseiten hatte, lässt sich erahnen, wenn Perley schreibt, es gebe selten mehr als vier Schneestürme im Jahr.“"
                                            },
                                            {
                                                "example_id": "55f9997d-649b-4c55-9ac2-b612634f7534",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Die telephonischen Verbindungen zwischen uns und Munau waren seit ein paar Tagen unterbrochen, ohne daß wir wußten, ob der Schneesturm oder der Feind daran schuld war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea1e912c-9a89-4ea5-af8e-e2baf07e1c9d",
                        "source_entry_id": "39742d33-bb97-3083-b20e-da95c9039193",
                        "source_sense_id": "decaed90-2a07-3a1a-93e1-b283579ea399",
                        "source_sense_description": "Meteorologie: heftiger Schneesturm, Schneegestöber",
                        "target_lang_word": "Schneegestöber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneegestöber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be659e84-4134-3908-aa59-fa2d7bdc2fb9",
                                        "entry_id": "7270fd03-0573-3ba5-a40a-d510a380b45f",
                                        "glosses": [
                                            "relativ heftiger, windgetriebener Schneefall in ständig wechselnden Richtungen"
                                        ],
                                        "tags": [
                                            "Wetter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "301bcb97-db4a-4acf-9e96-1365283a487c",
                                                "sense_id": "be659e84-4134-3908-aa59-fa2d7bdc2fb9",
                                                "text": "Wir gerieten in heftiges Schneegestöber."
                                            },
                                            {
                                                "example_id": "122c958a-e942-44e1-82c9-61bdf3d6bcd1",
                                                "sense_id": "be659e84-4134-3908-aa59-fa2d7bdc2fb9",
                                                "text": "„Im leuchtenden Schneegestöber kam er morgens in Johns Jaranga gestolpert.“"
                                            },
                                            {
                                                "example_id": "634c277d-fe0d-4f0a-9741-c3f0501f3a9d",
                                                "sense_id": "be659e84-4134-3908-aa59-fa2d7bdc2fb9",
                                                "text": "„Schneefall wird zu Schneegestöber, und Schneetreiben wandelt sich in Schneesturm.“"
                                            },
                                            {
                                                "example_id": "b9cac517-cbe6-4baa-aef7-eb387451adbf",
                                                "sense_id": "be659e84-4134-3908-aa59-fa2d7bdc2fb9",
                                                "text": "„Mit Kanonen bei Eis und Schneegestöber Krieg zu spielen, ist reine Unvernunft.“"
                                            },
                                            {
                                                "example_id": "3781d9ef-cac3-4eea-80d8-221250a5fa4b",
                                                "sense_id": "be659e84-4134-3908-aa59-fa2d7bdc2fb9",
                                                "text": "„Der zweite Schlitten glitt im Schneegestöber fast lautlos an ihnen vorüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fa6dd76-5739-3303-b9d1-b0f39beb4ba2",
                                        "entry_id": "7270fd03-0573-3ba5-a40a-d510a380b45f",
                                        "glosses": [
                                            "Schicht-Dessert aus Himbeeren, Schlagsahne und Meringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b280a4-74f1-407e-bfe7-99dbed85c551",
                                                "sense_id": "7fa6dd76-5739-3303-b9d1-b0f39beb4ba2",
                                                "text": "„Schneegestöber ist schnell und leicht zubereitet und hat dabei einfach etwas Edles.“"
                                            },
                                            {
                                                "example_id": "b603a6ea-41ee-4ada-bdf6-2cfb55274916",
                                                "sense_id": "7fa6dd76-5739-3303-b9d1-b0f39beb4ba2",
                                                "text": "„Christel Rong aus Schallstadt bereitet für Gäste gerne ein Schneegestöber vor.“"
                                            },
                                            {
                                                "example_id": "e4b400d5-1007-4829-aa61-9e06c285d70c",
                                                "sense_id": "7fa6dd76-5739-3303-b9d1-b0f39beb4ba2",
                                                "text": "„Dann kam Oma mit dem Essen: Frühlingsrollen, Sommersalat […] und als Nachtisch zuckersüßes Schneegestöber!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
