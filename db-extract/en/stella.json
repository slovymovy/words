                                            {
                                                "example_id": "babd6be6-f73a-4dde-a86f-7f642a53e7cd",
                                                "sense_id": "5542b06e-4149-3443-97bd-35e4c0b523e4",
                                                "text": "« C’est un classique », a lâché Estelle Nze Minko, la capitaine de l’équipe de France de handball, au sortir de sa promenade de santé face à l’Espagne (36-23), mercredi."
                                            },
                                            {
                                                "example_id": "4fdffe01-f46a-461a-9651-946bae8d48fc",
                                                "sense_id": "5542b06e-4149-3443-97bd-35e4c0b523e4",
                                                "text": "La députée de Mayotte, Estelle Youssouffa, a dénoncé l’« indifférence générale » face au « cycle de vendetta » sur l’île."
                                            },
                                            {
                                                "example_id": "1efc63c9-ac23-497f-ad85-af59be9811b2",
                                                "sense_id": "5542b06e-4149-3443-97bd-35e4c0b523e4",
                                                "text": "Tiens, c’est du tursan, le vin préféré de Paul, remarqua Estelle en regardant la bouteille que tenait Valère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
