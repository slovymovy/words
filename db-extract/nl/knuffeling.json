                "senses": [
                    {
                        "sense_id": "8bf6ff1f-b837-3e9f-8c0e-7aaf4dc8442b",
                        "entry_id": "7cc4b9bc-7d3b-3cb5-b6ef-15f280d8d671",
                        "glosses": [
                            "een liefdevolle, troostende omhelzing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9ee42d-6808-498b-8428-45725a83051d",
                                "sense_id": "8bf6ff1f-b837-3e9f-8c0e-7aaf4dc8442b",
                                "text": "Dat is mevrouw Ten Braak - je weet wel - stelde daarna m'n moeder voor. En ik was natuurlijk niet zo stom om te zeggen; Aangenaam; maar nestelde me bij moeder, en onderging de extra-knuffeling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1ce1845-6520-41d2-b62d-8383ca9e8b08",
                        "source_entry_id": "7cc4b9bc-7d3b-3cb5-b6ef-15f280d8d671",
                        "source_sense_id": "8bf6ff1f-b837-3e9f-8c0e-7aaf4dc8442b",
                        "target_lang_word": "hug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4564250-7c1a-3e3a-bff1-bcd83a94c78c",
                                        "entry_id": "edfbba53-db93-3990-a3bf-201e387e2beb",
                                        "glosses": [
                                            "A close embrace, especially when charged with an emotion such as affection, joy, relief, lust, anger, aggression, compassion, and the like, as opposed to being characterized by formality, equivocation or ambivalence (a half-embrace or \\\"little hug\\\")."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48cd265a-3654-3690-8390-9dfec2857625",
                                        "entry_id": "edfbba53-db93-3990-a3bf-201e387e2beb",
                                        "glosses": [
                                            "A particular grip in wrestling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                                        "entry_id": "54f17242-feb8-3471-8497-740b8adbf04c",
                                        "glosses": [
                                            "To crouch; to huddle as with cold."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0eef31-5f4d-4480-8fad-5ee62c0148a7",
                                                "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                                                "text": "They had a slight breast work, and they hugged down behind it and waited."
                                            },
                                            {
                                                "example_id": "89c87d93-9ef4-4432-a60c-f9d674cc3dd3",
                                                "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                                                "text": "That is why they are so little known and never explored. During the day, when a Chilean cruiser nosed around uncomfortably close, the little sloop would be hugged under the lee of one of the islands, sail lowered and anchor dropped."
                                            },
                                            {
                                                "example_id": "4d511686-da33-4957-ae30-4b846dc21c04",
                                                "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                                                "text": "bright rocks whose stain of emerald or quartz shaft of shine the starfish hugged beneath the tide ."
                                            },
                                            {
                                                "example_id": "e50ade4b-9413-430a-aea5-54e653c8f01b",
                                                "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                                                "text": "She put her feet on a rung and hugged down against her knees, making herself even smaller."
                                            },
                                            {
                                                "example_id": "36f37968-65d8-40a1-b733-5f098adb468f",
                                                "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                                                "text": "Zhai Tingshen stood at the window upstairs, his black eyes staring intently at the figure that was tightly hugged below."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c583e454-c626-330a-9205-fbd04eb28a50",
                                        "entry_id": "54f17242-feb8-3471-8497-740b8adbf04c",
                                        "glosses": [
                                            "To cling closely together."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a4ebb71-f36d-3108-81e5-545ee7328223",
                                        "entry_id": "54f17242-feb8-3471-8497-740b8adbf04c",
                                        "glosses": [
                                            "To embrace by holding closely, especially in the arms."
                                        ],
                                        "tags": [
                                            "reciprocal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff23041-bf0f-4052-b52e-e4a07259ca4c",
                                                "sense_id": "0a4ebb71-f36d-3108-81e5-545ee7328223",
                                                "text": "Billy hugged Danny until he felt better."
                                            },
                                            {
                                                "example_id": "8197dbe2-cbed-4662-a9e6-10e4356f8be6",
                                                "sense_id": "0a4ebb71-f36d-3108-81e5-545ee7328223",
                                                "text": "They hugged for what seemed like an eternity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "062cdcf7-2395-3593-a7c9-349c10288722",
                                        "entry_id": "54f17242-feb8-3471-8497-740b8adbf04c",
                                        "glosses": [
                                            "To stay close to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efde182-035f-4485-813d-973c59897990",
                                                "sense_id": "062cdcf7-2395-3593-a7c9-349c10288722",
                                                "text": "to hug the shore, to hug the coastline"
                                            },
                                            {
                                                "example_id": "b0b20d0d-bc65-451b-9f83-3f0723c92a91",
                                                "sense_id": "062cdcf7-2395-3593-a7c9-349c10288722",
                                                "text": "We toted in the wood and got the fire going nice and comfortable. Lord James still set in one of the chairs and Applegate had cabbaged the other and was hugging the stove."
                                            },
                                            {
                                                "example_id": "ae99df20-3973-49fd-8455-3eb3ed91d909",
                                                "sense_id": "062cdcf7-2395-3593-a7c9-349c10288722",
                                                "text": "Gourock also boasted a pier railway, although its pier hugged the shore rather than jutting into the bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e08d0587-8a28-3d81-8357-f0e30c405c1c",
                                        "entry_id": "54f17242-feb8-3471-8497-740b8adbf04c",
                                        "glosses": [
                                            "To hold fast; to cling to; to cherish."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd01f70c-ed9e-4457-8e27-d00feb1094a2",
                                                "sense_id": "e08d0587-8a28-3d81-8357-f0e30c405c1c",
                                                "text": "We hug intellectual deformities, if they bear our names"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
