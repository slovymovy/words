                ],
                "senses": [
                    {
                        "sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                        "entry_id": "8d3f4893-e81a-3b67-b0be-8201fe69cbef",
                        "glosses": [
                            "verlangsamte Darstellung einer Filmsequenz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed24188e-e69a-40de-a521-a896077e7311",
                                "sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                                "text": "Besonders dramatische Szenen werden oft in Zeitlupe gezeigt."
                            },
                            {
                                "example_id": "8a019b47-69a2-4bbd-b9e2-b50cd37758f4",
                                "sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                                "text": "„Alles sah sehr anders aus als im Westen und ein wenig so wie in Zeitlupe oder wie in einem Traum ohne Farben.“"
                            },
                            {
                                "example_id": "a76605ea-d497-43a8-a484-757de4f616dc",
                                "sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                                "text": "„Wir lassen unsere Kinder los auf ein suboptimales System, das sich nur in Zeitlupe verbessert.“"
                            },
                            {
                                "example_id": "fc8cc274-4df7-45f8-a8c0-c2facac9e6f7",
                                "sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                                "text": "„Wie in Zeitlupe zog sie sich an und hatte dabei das Gefühl, ihr Bauch gehöre nicht mehr zu ihr.“"
                            },
                            {
                                "example_id": "0321b085-b04e-4f13-acba-445270eea32e",
                                "sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
                                "text": "„Er bleibt eine Weile regungslos auf dem Klvierhocker sitzen, bevor er sich in Zeitlupe die Schuhe anzieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e11fc7e3-59ee-4f62-95f2-0deabf15aab8",
                        "source_entry_id": "8d3f4893-e81a-3b67-b0be-8201fe69cbef",
                        "source_sense_id": "694c8e5d-1ecc-3fbd-ae94-4733eaf65efc",
