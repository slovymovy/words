                "senses": [
                    {
                        "sense_id": "6d6386a8-d293-3dec-8a26-9b3f52ca0753",
                        "entry_id": "aa6affe3-7476-3ea8-b69c-1a9eb696cacf",
                        "glosses": [
                            "aufgrund sozialer Merkmale definierte Gruppe innerhalb einer Gesellschaft"
                        ],
                        "tags": [
                            "Soziologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c424db54-7009-403f-af67-9dcc39e40575",
                                "sense_id": "6d6386a8-d293-3dec-8a26-9b3f52ca0753",
                                "text": "„Zuständig für die Nahrungsbeschaffung der Bevölkerung waren in allen Gesellschaftsschichten in der Regel Frauen, mitunter auch Kinder, aber nur ausnahmsweise Männer.“"
                            },
                            {
                                "example_id": "1d44d642-3b6f-4fb2-8f8f-069b183d10c6",
                                "sense_id": "6d6386a8-d293-3dec-8a26-9b3f52ca0753",
                                "text": "„Die Tatsache, dass die Öffentlichkeit den Mörder von Salman Taseer als Held feierte, sagt viel aus über die geistige Verfasstheit breiter Gesellschaftsschichten und erklärt, weshalb Einzelpersonen der religiös-extremistischen Rhetorik kaum entgegentreten können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
