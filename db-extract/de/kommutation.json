                "senses": [
                    {
                        "sense_id": "bc359cbe-02bd-3243-a6f0-adfb9c648ac7",
                        "entry_id": "827c6419-62f5-3d60-8fff-2d8000602a24",
                        "glosses": [
                            "Ersetzung einer sprachlichen Einheit durch eine andere, die als äquivalent angesehen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584c68a9-0e2d-4797-bd62-11fb13f6b5f1",
                                "sense_id": "bc359cbe-02bd-3243-a6f0-adfb9c648ac7",
                                "text": "„Die Feststellung der Phoneme beziehungsweise der im Morphikon (Lexikon) zugrundeliegenden Segmente geht aus von der Überlegung, daß eine Korrelation von Ausdruckseinheiten zu einer Korrelation von Inhaltseinheiten in Beziehung steht (Kommutationen), so daß die Invarianten der Ausdrucksebene (Phoneme) durch Kommutationsproben ermittelt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
