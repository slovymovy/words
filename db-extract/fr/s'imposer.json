                ],
                "senses": [
                    {
                        "sense_id": "b737f10c-ed48-3e9e-af66-1924c88cf5be",
                        "entry_id": "b937adeb-056a-3054-bcb9-5f79bffe2c64",
                        "glosses": [
                            "Imposer ses convictions, sa domination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774e34cc-42cd-4bf8-83bf-96ba5fae0b65",
                                "sense_id": "b737f10c-ed48-3e9e-af66-1924c88cf5be",
                                "text": "C'est probablement pendant son malheureux séjour à New-York que s'imposa à lui la certitude d'être différent des autres et de ne pouvoir plus rien y changer."
                            },
                            {
                                "example_id": "c2595d45-8ccd-4f15-b442-4ec0cd612ea9",
                                "sense_id": "b737f10c-ed48-3e9e-af66-1924c88cf5be",
                                "text": "Après l’euphorie des festivités du samedi et les nombreuses manifestations de joie dans les rues de plusieurs grandes villes américaines, la dure réalité s’est imposée rapidement."
                            },
                            {
                                "example_id": "e48e65a2-5b8f-452e-953d-b14c63d5c037",
                                "sense_id": "b737f10c-ed48-3e9e-af66-1924c88cf5be",
                                "text": "Les femmes qui ont réussi à s’imposer à la tête des entreprises de médias sont des ultras : ultracompétentes, ultraconvaincantes, ultradéterminées."
                            }
                        ]
                    }
