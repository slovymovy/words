{
    "word_family": [
        "доход",
        "доходность"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94691383-2d8d-3f77-b5e1-458354f75f00",
                    "sense_definition": "Приносящий значительную прибыль или финансовую выгоду.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "profitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был очень <w>доходный</w> бизнес, который быстро приносил деньги.",
                            "target_lang_translations": {
                                "tr": "Bu, hızlı bir şekilde para getiren çok <w>kârlı</w> bir işti."
                            }
                        },
                        {
                            "text": "Инвестор искал <w>доходный</w> проект для вложения своих сбережений.",
                            "target_lang_translations": {
                                "tr": "Yatırımcı, birikimlerini değerlendirmek için <w>kazançlı</w> bir proje arıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "прибыльный",
                        "выгодный",
                        "рентабельный"
                    ],
                    "antonyms": [
                        "убыточный",
                        "нерентабельный"
                    ],
                    "common_phrases": [
                        "доходный бизнес",
                        "доходный проект"
                    ],
                    "target_lang_definitions": {
                        "tr": "Önemli miktarda kâr veya finansal kazanç getiren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kârlı",
                                "target_lang_sense_clarification": "Finansal kazanç sağlayan, verimli."
                            },
                            {
                                "target_lang_word": "kazançlı",
                                "target_lang_sense_clarification": "Getirisi yüksek olan, avantajlı."
                            },
                            {
                                "target_lang_word": "rantabl",
                                "target_lang_sense_clarification": "Ekonomik açıdan verimli ve kâr getiren."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53898cbc-c89e-3732-9226-2bf650f14146",
                    "sense_definition": "Относящийся к доходам или связанный с их получением.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Государство пересмотрело <w>доходную</w> часть бюджета на следующий год.",
                            "target_lang_translations": {
                                "tr": "Devlet, gelecek yılın bütçesinin <w>gelir</w> kalemlerini yeniden gözden geçirdi."
                            }
                        },
                        {
                            "text": "Необходимо укрепить <w>доходную</w> базу местного самоуправления.",
                            "target_lang_translations": {
                                "tr": "Yerel yönetimin <w>gelir</w> tabanını güçlendirmek gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "приходный",
                        "коммерческий"
                    ],
                    "antonyms": [
                        "расходный",
                        "некоммерческий"
                    ],
                    "common_phrases": [
                        "доходная часть",
                        "доходная база"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gelirlerle ilgili veya gelir elde etme süreciyle bağlantılı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gelir",
                                "target_lang_sense_clarification": "Bütçe veya mali tablolar bağlamında gelir kalemlerini ifade eder."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03606281-519e-3e59-bb23-5ab5bbf877f7",
                    "sense_definition": "Используемый для получения дохода.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "profitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В девятнадцатом веке этот <w>доходный</w> дом приносил владельцу огромные средства.",
                            "target_lang_translations": {
                                "tr": "On dokuzuncu yüzyılda bu <w>kiralık konut binası</w> sahibine büyük miktarda para kazandırırdı."
                            }
                        },
                        {
                            "text": "Старинный <w>доходный</w> дом был отреставрирован и превращен в современный отель.",
                            "target_lang_translations": {
                                "tr": "Tarihi <w>kiralık konut binası</w> restore edilerek modern bir otele dönüştürüldü."
                            }
                        }
                    ],
                    "antonyms": [
                        "бесприбыльный"
                    ],
                    "common_phrases": [
                        "доходный дом"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Часто используется в историческом контексте для обозначения зданий."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kira geliri elde etmek amacıyla inşa edilmiş veya kullanılan bina."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kiralık konut binası",
                                "target_lang_sense_clarification": "Tarihsel bağlamda kira geliri getiren büyük apartmanlar için kullanılır."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}