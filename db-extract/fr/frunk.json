                                "target_senses": [
                                    {
                                        "sense_id": "1a7ded29-6020-37b7-a1cc-d6ac43c707d1",
                                        "entry_id": "f3ec7552-79e4-38d6-b171-a6860e60ebc2",
                                        "glosses": [
                                            "A trunk (boot, storage compartment) located at the front rather than the rear of a car."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6726ccc5-787e-49c8-abb7-b545dc165128",
                                                "sense_id": "1a7ded29-6020-37b7-a1cc-d6ac43c707d1",
                                                "text": "The Model S, showing off both its traditional trunk and its surprising \"frunk.\""
                                            },
                                            {
                                                "example_id": "d17ac036-c016-4e67-b5a7-0204d55294c3",
                                                "sense_id": "1a7ded29-6020-37b7-a1cc-d6ac43c707d1",
                                                "text": "I pop the trunk of the Porsche and find ...the engine. […] I walk around the front of the car, pop the other trunk—the frunk?—and discover a tire iron nestled next to the spare."
                                            },
                                            {
                                                "example_id": "ec824fab-4621-4ab3-a4f7-7698d25e29af",
                                                "sense_id": "1a7ded29-6020-37b7-a1cc-d6ac43c707d1",
                                                "text": "[…] a rear cargo area that's more like that of a hatchback than the trunk of a sedan, and a \"frunk\" where the engine isn't. It's also theoretically safer than a dinosaur-burner, at least in a frontal collision, because the frunk provides a long crumple zone in the front […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
