                        "débat chaleureux"
                    ]
                },
                {
                    "sense_id": "ef66cf08-bd19-3f1c-98b2-9560e1782509",
                    "sense_definition": "Qualifie un vin riche en alcool qui procure en bouche une impression agréable de chaleur.",
