                                            {
                                                "example_id": "fe3690b7-b519-4391-b90c-ba3edad7fb4f",
                                                "sense_id": "8de4e621-e6fb-3cca-ad48-d34ca676f1cb",
                                                "text": "Mam nadzieję, że owego żmiję Tuhaj-bejowicza Bóg wyda w twoje ręce albo Nowowiejskiego, nad którego krzywdą szczerze boleję."
                                            }
