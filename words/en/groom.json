{
    "word_family": [
        "groomer",
        "grooming",
        "well-groomed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81def9c3-835f-3b19-9953-7f3efd636e0b",
                    "sense_definition": "A man who is about to be married or has just been married.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>groom</w> looked very nervous as he waited for the bride at the altar.",
                            "target_lang_translations": {
                                "ru": "<w>Жених</w> выглядел очень взволнованным, ожидая невесту у алтаря."
                            }
                        },
                        {
                            "text": "Friends and family gathered to celebrate with the happy bride and <w>groom</w>.",
                            "target_lang_translations": {
                                "ru": "Друзья и семья собрались, чтобы отпраздновать событие вместе со счастливыми невестой и <w>женихом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bridegroom"
                    ],
                    "antonyms": [
                        "bride"
                    ],
                    "common_phrases": [
                        "bride and groom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, который собирается жениться или только что женился."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жених",
                                "target_lang_sense_clarification": "на свадьбе"
                            },
                            {
                                "target_lang_word": "новобрачный",
                                "target_lang_sense_clarification": "только что вступивший в брак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4f3489f-8cc9-3637-a903-7473754cec66",
                    "sense_definition": "A person, especially a man, whose job is to take care of horses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "horse care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>groom</w> spent the entire morning brushing the horses and cleaning the stables.",
                            "target_lang_translations": {
                                "ru": "<w>Конюх</w> провел все утро, чистя лошадей и убирая конюшни."
                            }
                        },
                        {
                            "text": "A professional <w>horse</w> <w>groom</w> must understand the health and dietary needs of the animals.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>конюх</w> должен понимать потребности животных в здоровье и питании."
                            }
                        }
                    ],
                    "synonyms": [
                        "horsekeeper",
                        "ostler"
                    ],
                    "common_phrases": [
                        "horse groom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, в обязанности которого входит уход за лошадьми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конюх",
                                "target_lang_sense_clarification": "работник, ухаживающий за лошадьми"
                            },
                            {
                                "target_lang_word": "грум",
                                "target_lang_sense_clarification": "профессиональный помощник по уходу за лошадьми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "519ab7cb-327c-3f00-9702-241e69411e76",
                    "sense_definition": "The act of brushing or cleaning an animal, such as a dog or horse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give the mare a quick <w>groom</w> before you take her out for the ride.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>почисти</w> кобылу, прежде чем выводить ее на прогулку."
                            }
                        },
                        {
                            "text": "The dog felt much better after a thorough <w>groom</w> to remove the loose fur.",
                            "target_lang_translations": {
                                "ru": "Собака почувствовала себя гораздо лучше после тщательной <w>чистки</w> для удаления лишней шерсти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick groom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс чистки или расчесывания животного, например собаки или лошади."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистка",
                                "target_lang_sense_clarification": "уход за шерстью животного"
                            },
                            {
                                "target_lang_word": "груминг",
                                "target_lang_sense_clarification": "профессиональный уход за внешним видом животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd014090-1d2b-38b6-98d1-387d7a9ae9e2",
                    "sense_definition": "An officer or servant in a royal household.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "servant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>groom</w> of the chamber was responsible for the private rooms of the king.",
                            "target_lang_translations": {
                                "ru": "<w>Камердинер</w> опочивальни отвечал за личные покои короля."
                            }
                        },
                        {
                            "text": "Historical records mention the <w>groom</w> of the stole as a position of high trust.",
                            "target_lang_translations": {
                                "ru": "Исторические записи упоминают <w>грума</w> королевского гардероба как должность, пользующуюся высоким доверием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groom of the chamber"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical royal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Офицер или слуга в королевском доме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грум",
                                "target_lang_sense_clarification": "придворный чин или слуга"
                            },
                            {
                                "target_lang_word": "камердинер",
                                "target_lang_sense_clarification": "личный слуга при дворе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ad9debd-1a61-3113-86bf-0070491249d2",
                    "sense_definition": "To clean and maintain one's own physical appearance and clothing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personal care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He takes a long time to <w>groom</w> himself every morning before going to work.",
                            "target_lang_translations": {
                                "ru": "Каждое утро перед работой он долго <w>приводит себя в порядок</w>."
                            }
                        },
                        {
                            "text": "It is important to <w>groom</w> yourself properly for a professional job interview.",
                            "target_lang_translations": {
                                "ru": "Важно <w>выглядеть опрятно</w> на профессиональном собеседовании."
                            }
                        }
                    ],
                    "synonyms": [
                        "primp"
                    ],
                    "common_phrases": [
                        "groom yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить в порядок свой внешний вид и одежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить себя в порядок",
                                "target_lang_sense_clarification": "ухаживать за внешностью"
                            },
                            {
                                "target_lang_word": "холить",
                                "target_lang_sense_clarification": "тщательно ухаживать за собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "893bb2ae-ad3c-3071-b547-ffdb5117243a",
                    "sense_definition": "To clean or brush an animal, especially a horse or a pet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stable hands <w>groom</w> the horses every day to keep their coats shiny.",
                            "target_lang_translations": {
                                "ru": "Работники конюшни каждый день <w>чистят</w> лошадей, чтобы их шерсть блестела."
                            }
                        },
                        {
                            "text": "You should <w>groom</w> a dog regularly to prevent its fur from matting.",
                            "target_lang_translations": {
                                "ru": "Собаку нужно регулярно <w>вычесывать</w>, чтобы ее шерсть не сваливалась."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groom a dog",
                        "groom a horse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистить или расчесывать животное, особенно лошадь или домашнего питомца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистить",
                                "target_lang_sense_clarification": "шерсть животного"
                            },
                            {
                                "target_lang_word": "вычесывать",
                                "target_lang_sense_clarification": "шерсть питомца"
                            },
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "за внешним видом животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76bb505f-410e-3f98-bd1c-8b9a71ea69c1",
                    "sense_definition": "To prepare or train someone for a specific role, position, or future career.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is starting to <w>groom</w> her for a senior management position.",
                            "target_lang_translations": {
                                "ru": "Компания начинает <w>готовить</w> ее к должности в высшем руководстве."
                            }
                        },
                        {
                            "text": "He was <w>groomed</w> for success from a very young age by his ambitious parents.",
                            "target_lang_translations": {
                                "ru": "Амбициозные родители с самого раннего возраста <w>готовили</w> его к успеху."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groom for success",
                        "groom for a position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить или обучать кого-либо для определенной роли, должности или будущей карьеры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовить",
                                "target_lang_sense_clarification": "к определенной должности"
                            },
                            {
                                "target_lang_word": "натаскивать",
                                "target_lang_sense_clarification": "обучать для карьеры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83004db4-e1c3-3e80-8753-eb45d94b875f",
                    "sense_definition": "To prepare a surface, such as a ski slope, by smoothing or packing down snow.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maintenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The resort uses heavy machinery to <w>groom</w> the slopes before the skiers arrive.",
                            "target_lang_translations": {
                                "ru": "Курорт использует тяжелую технику, чтобы <w>подготовить</w> склоны до прибытия лыжников."
                            }
                        },
                        {
                            "text": "Freshly <w>groomed</w> trails provide the best conditions for cross-country skiing.",
                            "target_lang_translations": {
                                "ru": "Свеже<w>подготовленные</w> трассы обеспечивают лучшие условия для беговых лыж."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groom the slopes",
                        "groomed trails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготавливать поверхность, например лыжный склон, путем разравнивания или уплотнения снега."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трамбовать",
                                "target_lang_sense_clarification": "снег на склоне"
                            },
                            {
                                "target_lang_word": "разравнивать",
                                "target_lang_sense_clarification": "лыжную трассу"
                            },
                            {
                                "target_lang_word": "готовить",
                                "target_lang_sense_clarification": "трассу ратраком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ca6fc17-b044-3829-946b-582701f4a309",
                    "sense_definition": "In software development, to review, update, and prioritize tasks in a backlog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "software development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team meets once a week to <w>groom</w> the backlog and ensure tasks are clear.",
                            "target_lang_translations": {
                                "ru": "Команда встречается раз в неделю, чтобы <w>прогрумить</w> бэклог и убедиться, что задачи ясны."
                            }
                        },
                        {
                            "text": "We need to <w>groom</w> the product backlog before the next sprint planning session.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>уточнить</w> бэклог продукта перед следующим планированием спринта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "groom the backlog"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon in agile development"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В разработке программного обеспечения: просматривать, обновлять и приоритизировать задачи в бэклоге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грумить",
                                "target_lang_sense_clarification": "проводить очистку бэклога"
                            },
                            {
                                "target_lang_word": "уточнять",
                                "target_lang_sense_clarification": "задачи в бэклоге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "574a5a5d-9024-3279-a586-fabbfa5e0a62",
                    "sense_definition": "To build a relationship with a child or vulnerable person to exploit or abuse them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exploitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The predator used social media to <w>groom</w> his victims over several months.",
                            "target_lang_translations": {
                                "ru": "Хищник использовал социальные сети, чтобы <w>входить в доверие</w> к своим жертвам в течение нескольких месяцев."
                            }
                        },
                        {
                            "text": "Parents are warned about how criminals <w>groom</w> children online through fake profiles.",
                            "target_lang_translations": {
                                "ru": "Родителей предупреждают о том, как преступники <w>обрабатывают</w> детей в интернете через поддельные профили."
                            }
                        }
                    ],
                    "common_phrases": [
                        "online grooming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать доверительные отношения с ребенком или уязвимым человеком с целью эксплуатации или насилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "входить в доверие",
                                "target_lang_sense_clarification": "с целью эксплуатации"
                            },
                            {
                                "target_lang_word": "груминг",
                                "target_lang_sense_clarification": "психологическая подготовка жертвы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "78225799-47c4-3736-8096-2422a597ba4b",
                    "sense_definition": "An English surname that originally referred to a servant or horse-tender.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Groom</w> has lived in this neighborhood for over thirty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Грум</w> живет в этом районе уже более тридцати лет."
                            }
                        },
                        {
                            "text": "The name <w>Groom</w> is quite common in certain parts of England.",
                            "target_lang_translations": {
                                "ru": "Фамилия <w>Грум</w> довольно распространена в некоторых частях Англии."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, которая изначально относилась к слуге или конюху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грум",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97ed7856-2815-39a7-b338-5e0260694bd6",
                    "sense_definition": "A small town located in Carson County, Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through <w>Groom</w> while traveling across the Texas Panhandle.",
                            "target_lang_translations": {
                                "ru": "Мы проезжали через <w>Грум</w>, путешествуя по северному Техасу."
                            }
                        },
                        {
                            "text": "The town of <w>Groom</w> is known for its large roadside cross.",
                            "target_lang_translations": {
                                "ru": "Город <w>Грум</w> известен своим огромным придорожным крестом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город, расположенный в округе Карсон, штат Техас."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Грум",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}