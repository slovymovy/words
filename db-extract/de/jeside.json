                "senses": [
                    {
                        "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                        "entry_id": "107c0198-0a47-310c-ad31-fb1a17708726",
                        "glosses": [
                            "Anhänger einer alten monotheistischen Glaubensgemeinschaft im Vorderen Orient (Jesidentum)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc65d5a-68e2-43be-b520-e5bf89070b37",
                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                "text": "Wie auch in anderen Religionen glauben die Jesiden daran, dass das Leben nach dem Tod nicht endet."
                            },
                            {
                                "example_id": "a18d53c3-8451-4e3a-a4f0-15879659d41b",
                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                "text": "Kann man zum Jesidentum konvertieren oder wird man als Jeside geboren?"
                            },
                            {
                                "example_id": "0908437f-611c-4715-8606-ea6c89bbf439",
                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                "text": "Jesiden glauben an die Reinkarnation: Die Seele eines Verstorbenen lebt in einem anderen Geschöpf weiter. Das kann ein Tier sein oder ein Mensch, ein Jeside oder Angehöriger einer anderen Glaubensgemeinschaft."
                            },
                            {
                                "example_id": "49a9a795-15c9-4224-9523-dd361a7496ba",
                                "sense_id": "8f27ec44-0b45-3b3d-baab-d699cbbb5193",
                                "text": "„Wir blieben bei den Jesiden länger, als wir vorgesehen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
