        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "42dd3f01-c778-3b94-9c12-7f2bd09ac72e",
                "word": "subcategory",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "35232a4b-3a96-4398-87cc-2d5840cc3a2d",
                        "entry_id": "42dd3f01-c778-3b94-9c12-7f2bd09ac72e",
                        "tags": [
                            "plural"
                        ],
                        "form": "subcategories"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5a27ad9-3d7e-3bb2-b48a-5817628077f4",
                        "entry_id": "42dd3f01-c778-3b94-9c12-7f2bd09ac72e",
                        "glosses": [
                            "With respect to a given category; a narrower category."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba4bfc8-49d1-4778-a242-144617b0ba78",
                                "sense_id": "a5a27ad9-3d7e-3bb2-b48a-5817628077f4",
                                "text": "The moment subcategories of the overall population are denied rights, the rights of all are threatened."
                            },
                            {
                                "example_id": "250eac5b-4419-4083-a861-9cc7671b9b93",
                                "sense_id": "a5a27ad9-3d7e-3bb2-b48a-5817628077f4",
                                "text": "I have categories within subcategories because I get so many submissions about poop and potty training."
                            },
                            {
                                "example_id": "eeae24d0-5e39-4b95-b956-fb06f4275727",
                                "sense_id": "a5a27ad9-3d7e-3bb2-b48a-5817628077f4",
                                "text": "On the other hand, the label of “feminist” is beginning to feel more like a subcategory on Netflix – an algorithmic signpost – than a meaningful description of art."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b247ec0-1f16-3a53-8e00-3688ae83e170",
                        "entry_id": "42dd3f01-c778-3b94-9c12-7f2bd09ac72e",
                        "glosses": [
                            "A subclass of a category which is itself a category, whose arrows are a restriction of the arrows of the parent category, and whose composition rule is a restriction of the parent category's."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
