                        "sense_id": "42a34aa1-a248-37d5-a5a7-18ba07912663",
                        "entry_id": "d7bded8d-18ea-3519-9544-c7763e0c48d6",
                        "glosses": [
                            "murarz będący specjalistą w zakresie tynkowania"
                        ],
                        "tags": [
                            "professional"
                        ],
                        "examples": [
                            {
                                "example_id": "fad06f4b-6f13-418d-a155-278e5acf3ca7",
                                "sense_id": "42a34aa1-a248-37d5-a5a7-18ba07912663",
                                "text": "Elementarną umiejętnością tynkarza jest samodzielne sporządzenie zapraw tynkarskich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
