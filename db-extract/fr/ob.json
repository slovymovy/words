                        "entry_id": "080ca407-c71c-3ca9-b1fe-5669590f31e1",
                        "glosses": [
                            "Fleuve de Sibérie, qui se jette dans l’océan Arctique."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "9ffdceef-4718-4a54-9b06-efc7ff334625",
                                "sense_id": "bfb92ddf-440b-33ae-959a-1f7773536497",
                                "text": "– Ce n’est pas possible. Au-delà de l’Ob, il n’y a rien."
                            }
                        ]
                    }
                ],
                "translations": [
