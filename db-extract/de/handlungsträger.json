                "senses": [
                    {
                        "sense_id": "2a749b16-8ac6-3dc3-9b48-3ed32a6784b9",
                        "entry_id": "cd07735b-f211-3cc9-bf44-2963b93742b4",
                        "glosses": [
                            "Person in einem literarischen Text, die für die Handlung von Bedeutung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583144d2-43a3-479e-ab42-8ca0e0004681",
                                "sense_id": "2a749b16-8ac6-3dc3-9b48-3ed32a6784b9",
                                "text": "„In der im Schlussteil berichteten Lebensgeschichte Watelets wird erzählt, dass wesentliche Handlungsträger des Romans eine gemeinsame Vorgeschichte haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26da7469-44c4-3c0f-b9bf-c76c3df86954",
                        "entry_id": "cd07735b-f211-3cc9-bf44-2963b93742b4",
                        "glosses": [
                            "Komponente in einem literarischen Text, die für die Handlung von Bedeutung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7eb7fd7-4745-4d57-9882-aea5469c2fe3",
                                "sense_id": "26da7469-44c4-3c0f-b9bf-c76c3df86954",
                                "text": "„Der üppige Garten mit Mammutbäumen, Riesenfarnen und fleischfressenden Pflanzen, den der in Spanien umgekommene junge Dichter Sebastian Venable angelegt hat, ist hier nicht Kulisse, sondern Handlungsträger.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0295f090-cc18-379f-8b95-6fe7b45408dc",
                        "entry_id": "cd07735b-f211-3cc9-bf44-2963b93742b4",
                        "glosses": [
                            "Person, die auf ein Geschehen maßgeblich einwirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10498231-5146-4fee-9c1b-0ca9dd1e66b2",
                                "sense_id": "0295f090-cc18-379f-8b95-6fe7b45408dc",
                                "text": "„Die Kritik bezieht sich hier auf die politische Einstellung der gesellschaftlichen Handlungsträger, die gerade über die kritische Analyse ihrer Diskursnormen erkennbar wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
