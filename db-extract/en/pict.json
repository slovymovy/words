                                    {
                                        "sense_id": "a830fea0-7814-32f6-a114-f1265a8d57fb",
                                        "entry_id": "ca18364b-1fe4-353e-adc2-846c39995c1d",
                                        "glosses": [
                                            "Membre du peuple picte, ayant habité dans la région actuelle de l'Écosse durant l'Antiquité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5232c59-2b13-43ef-8510-05b3c6967351",
                                                "sense_id": "a830fea0-7814-32f6-a114-f1265a8d57fb",
                                                "text": "Espérait-il courber le front de cette petite-fille des Pictes et des Scots, héritière naturelle des montagnards des Grampians qui défiaient jadis l’envahisseur romain et arrêtaient la marche triomphale de ses légions invaincues ?"
                                            },
                                            {
                                                "example_id": "55d4b077-47ef-48d8-85d8-ca0aaea71563",
                                                "sense_id": "a830fea0-7814-32f6-a114-f1265a8d57fb",
                                                "text": "Non, Obélix, pas de doute, nous avons affaire à un Picte venu de la lointaine Calédonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49019765-f73f-4423-a395-0dd6a3095403",
                        "source_entry_id": "c1a4be64-09fa-31dc-a775-fd3b528f1c22",
                        "source_sense_id": "2de1f4c4-3e01-37b0-b8b5-450946a98ed5",
                        "source_sense_description": "member of an ancient people of northern and central Scotland",
                        "target_lang_word": "Pikte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pikte",
