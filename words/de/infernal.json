{
    "word_family": [
        "Inferno",
        "infernalisch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c22501db-a468-30f1-bc68-6a8277db8ef7",
                    "sense_definition": "in extremem, kaum erträglichem Maße ausgeprägt; höllisch oder ohrenbetäubend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensivierend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Baumaschinen vor der Tür machen seit heute früh einen <w>infernalen</w> Krach.",
                            "target_lang_translations": {
                                "en": "The construction machinery outside the front door has been making an <w>infernal</w> racket since early this morning."
                            }
                        },
                        {
                            "text": "Nach dem langen Konzert litt er tagelang unter <w>infernalen</w> Kopfschmerzen.",
                            "target_lang_translations": {
                                "en": "After the long concert, he suffered from <w>hellish</w> headaches for days."
                            }
                        }
                    ],
                    "synonyms": [
                        "höllisch",
                        "unerträglich"
                    ],
                    "common_phrases": [
                        "infernaler Krach",
                        "infernaler Lärm",
                        "infernale Schmerzen"
                    ],
                    "target_lang_definitions": {
                        "en": "manifested to an extreme, barely bearable degree; hellish, unbearable, or deafening"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infernal",
                                "target_lang_sense_clarification": "extremely irritating or unbearable, often used of noise or pain"
                            },
                            {
                                "target_lang_word": "hellish",
                                "target_lang_sense_clarification": "intensely severe or unbearable"
                            },
                            {
                                "target_lang_word": "unbearable",
                                "target_lang_sense_clarification": "too extreme to endure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99dd54b5-2b15-3ccf-be50-2e703efe1cec",
                    "sense_definition": "an die Schrecken der Hölle erinnernd; von verheerendem, grauenvollem oder katastrophalem Ausmaß",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "katastrophisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der Explosion im Chemiepark bot sich den Rettungskräften ein <w>infernales</w> Bild.",
                            "target_lang_translations": {
                                "en": "After the explosion at the chemical park, the rescue workers were met with an <w>infernal</w> scene."
                            }
                        },
                        {
                            "text": "In der brennenden Altstadt spielten sich während des Sturms wahrhaft <w>infernale</w> Szenen ab.",
                            "target_lang_translations": {
                                "en": "Truly <w>apocalyptic</w> scenes played out in the burning old town during the storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "grauenhaft",
                        "teuflisch"
                    ],
                    "antonyms": [
                        "himmlisch"
                    ],
                    "common_phrases": [
                        "infernale Szenen",
                        "infernales Bild"
                    ],
                    "target_lang_definitions": {
                        "en": "reminiscent of the horrors of hell; devastating, horrific, or catastrophic in scale"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infernal",
                                "target_lang_sense_clarification": "relating to hell or reminiscent of hellfire and destruction"
                            },
                            {
                                "target_lang_word": "nightmarish",
                                "target_lang_sense_clarification": "terrifying and chaotic, resembling a horror scene"
                            },
                            {
                                "target_lang_word": "apocalyptic",
                                "target_lang_sense_clarification": "suggesting total destruction or catastrophe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}