                    {
                        "sense_id": "85553033-123a-3aff-9e6f-b093f0ae5bf4",
                        "entry_id": "731358cc-efaa-30bc-88c7-d8a5172cdc62",
                        "glosses": [
                            "Réunion religieuse de plusieurs cités grecques, puis par le suite union politique et militaire."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "15d763c3-87ea-46b0-9282-6e5bce24f17e",
                                "sense_id": "85553033-123a-3aff-9e6f-b093f0ae5bf4",
                                "text": "Il paraît avoir existé une amphictyonie à Argos, qui rattachait au culte d'Apollon Pythien le peuple de cette ville et ceux de Lacédémone et de Messénie, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "80e811e1-b063-3fcb-a511-ceccc4a8ffd0",
                        "entry_id": "731358cc-efaa-30bc-88c7-d8a5172cdc62",
                        "glosses": [
                            "Droit qu'avaient certaines villes grecques d’envoyer un député au conseil des amphictyons."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ebf2b54b-d189-30f9-b361-0d7d468e6695",
                        "entry_id": "731358cc-efaa-30bc-88c7-d8a5172cdc62",
                        "glosses": [
                            "Dignité des amphictyons."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0ed56a37-8328-3771-ae46-f7489c4853be",
                        "entry_id": "731358cc-efaa-30bc-88c7-d8a5172cdc62",
                        "glosses": [
                            "Lieu où se tenait l’assemblée des amphictyons."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "88b0d846-2e2a-4bdd-b84c-7ed6279d0aea",
                                "sense_id": "0ed56a37-8328-3771-ae46-f7489c4853be",
                                "text": "En grec, le sens général du mot amphictyonie est : réunion de voisins, de cités voisines."
                            }
                        ]
                    }
