                        "tags": [],
                        "examples": [
                            {
                                "example_id": "794d99ff-5f18-401f-825b-4fdf9872cd95",
                                "sense_id": "7a7175e9-0e77-3f73-83d1-b3867741aea9",
                                "text": "„Im Dunkelmodus hebt sich die Hintergrundfarbe des Buttons kaum vom Bildschirmhintergrund ab.“"
                            },
                            {
                                "example_id": "9327f6b8-d786-4ed8-80d6-b2ba807089bf",
                                "sense_id": "7a7175e9-0e77-3f73-83d1-b3867741aea9",
                                "text": "„Ich will ein Foto von dir knipsen und es auf meinem Handy als Bildschirmhintergrund einstellen.“"
                            },
                            {
                                "example_id": "1a5f4ef8-0066-4b15-855f-bea38bbecddd",
                                "sense_id": "7a7175e9-0e77-3f73-83d1-b3867741aea9",
                                "text": "„Das Foto, das sie als Bildschirmhintergrund verwendete, war letztes Jahr auf ihrer Abenteuerreise entstanden.“"
                            }
                        ],
