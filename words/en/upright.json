                        {
                            "text": "Players stood in front of the <w>upright</w> to insert their coins.",
                            "target_lang_translations": {
                                "ru": "Игроки стояли перед <w>автоматом</w>, чтобы опустить монеты.",
                                "zh": "玩家站在<w>立式街机</w>前投币。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened jargon used by arcade enthusiasts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальный корпус игрового автомата.",
                        "zh": "立式街机游戏机柜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертикальный игровой автомат",
                                "target_lang_sense_clarification": "тип корпуса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立式街机",
                                "target_lang_sense_clarification": "游戏设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "503fe983-024f-320c-a443-61a7873f0347",
                    "sense_definition": "An upright vacuum cleaner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers using an <w>upright</w> because it is easier on her back than a canister model.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает использовать <w>вертикальный пылесос</w>, потому что от него меньше устает спина, чем от обычного.",
                                "zh": "她更喜欢用<w>立式吸尘器</w>，因为它比卧式吸尘器对背部更友好。"
                            }
                        },
                        {
                            "text": "The closet was just big enough to store the new <w>upright</w>.",
                            "target_lang_translations": {
                                "ru": "Шкаф был как раз достаточного размера, чтобы вместить новый <w>вертикальный пылесос</w>.",
                                "zh": "壁橱刚好够放下那台新的<w>立式吸尘器</w>。"
