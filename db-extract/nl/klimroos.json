                    },
                    {
                        "translation_id": "3c7f7db2-9549-423e-b4aa-a8fb7b62d396",
                        "source_entry_id": "52bbc505-a97c-3103-89ae-a479b3707eae",
                        "source_sense_id": "3fe3c03b-5f33-3614-992a-e4247bb0f1c7",
                        "source_sense_description": "groep van krachtig groeiende rozen, die met hun kruipende, lange, soepele takken 5-6 m hoog in bomen en tegen muren op kunnen klimmen",
                        "target_lang_word": "rambler rose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rambler rose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f3d0384-8cb8-3526-a9dc-994dc902adf6",
                                        "entry_id": "03b85bbc-3635-3cd0-a436-ae6dc1ac2141",
                                        "glosses": [
                                            "Any group of garden roses, often hybrids of Rosa wichuraiana or Rosa multiflora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bf7c8fd-5aa2-4f9a-ac65-5957ce197aec",
                                                "sense_id": "9f3d0384-8cb8-3526-a9dc-994dc902adf6",
                                                "text": "Its flowers are of a soft shade of pale rose, and although it is not strictly speaking a Rambler Rose, yet it is sufficiently vigorous to make a good hedge or to plant as isolated bushes."
                                            },
                                            {
                                                "example_id": "fa490ce8-c56e-4dae-b724-1d8cc4c247ae",
                                                "sense_id": "9f3d0384-8cb8-3526-a9dc-994dc902adf6",
                                                "text": "The habit for a Rambler Rose is perfect, and it will grow 20 feet or more in a light and airy way, and will bloom all the way from the ground upwards."
                                            },
                                            {
                                                "example_id": "efb42d4a-406c-482f-81d6-5975d1a81540",
                                                "sense_id": "9f3d0384-8cb8-3526-a9dc-994dc902adf6",
                                                "text": "By general consent no man has done so much to bring into common use the various varieties of the climbing or rambler rose as Mr. M. H. Walsh."
                                            },
                                            {
                                                "example_id": "46b15d05-0ac0-47a9-8d47-82548166fdb2",
                                                "sense_id": "9f3d0384-8cb8-3526-a9dc-994dc902adf6",
                                                "text": "If there is room for only one rambler rose, include this one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
