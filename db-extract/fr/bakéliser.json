                        "glosses": [
                            "Renforcer en utilisant de la bakélite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "780607c4-0280-40a6-85d2-df965e2c2f89",
                                "sense_id": "ada33ec6-52bc-3119-a8cb-b02d2a597d86",
                                "text": "Il était donc nécessaire de faire bakéliser des skis neufs, bien secs, bien secs, d'une manière intime et durable."
                            },
                            {
                                "example_id": "17c485f2-3699-49b1-96f3-faf427203016",
                                "sense_id": "ada33ec6-52bc-3119-a8cb-b02d2a597d86",
                                "text": "Un coup de feuille de papier collé dessus pour liaisonner le tout et retrouver un aspect correct, un coup d'Epoxy pour bakéliser le papier et le rendre très rigide et insensible à l'humidité, quelques fentes judicieusement placées pour laisser passer les branches de l'araignée et voilà !"
                            }
                        ]
                    }
