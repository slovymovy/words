                    "frequency": "Low",
                    "semantic_group_id": "alter_image",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government attempted to <w>airbrush</w> controversial historical events from the new textbooks."
                        },
                        {
                            "text": "He tended to <w>airbrush</w> past failures whenever he described his business career."
                        }
                    ],
                    "common_phrases": [
                        "airbrush from history"
                    ]
                },
                {
                    "sense_id": "dad2b097-0b51-38b3-b2b4-2a9ce9b140e7",
                    "sense_definition": "To apply paint or color using an airbrush tool.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "painting_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>airbrush</w> the motorcycle helmet with custom flame designs."
                        },
                        {
                            "text": "She learned how to <w>airbrush</w> fine gradients onto miniature figures."
