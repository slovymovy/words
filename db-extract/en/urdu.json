                    {
                        "translation_id": "103dff2d-a252-4e4d-89d0-11fa87e27b6e",
                        "source_entry_id": "44276eaf-20cd-34d6-984a-3c2a0f1757d1",
                        "source_sense_id": "5e98b52d-58cb-325e-8262-0a6561f81016",
                        "source_sense_description": "the Indo-Iranian language",
                        "target_lang_word": "Urdu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urdu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                        "entry_id": "17ddd8e2-eae1-37a0-b808-511793306de4",
                                        "glosses": [
                                            "indogermanische Sprache; Amtssprache in Pakistan und einigen indischen Bundesstaaten; eng mit Hindi verwandt, vergleiche Hindustani"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4ee510a-04fa-49cb-8b9c-853f33e50c64",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "Über die Deutsche Welle heisst es zum Beispiel, dass 1200 Mitarbeiter aus 60 Ländern Programme in 30 Sprachen in den Äther schicken, darunter in Amharisch und Urdu."
                                            },
                                            {
                                                "example_id": "a5681a90-6471-40f2-bc15-3e9cf6726622",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Noch heute werden seine in Urdu verfassten Gedichte als große Klassiker dieser Sprache angesehen.“"
                                            },
                                            {
                                                "example_id": "09babf4e-7ac8-46c4-a0f5-e7e953be5f99",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Persisch war die Amtssprache des Reichs, daneben entwickelte sich Urdu als Volkssprache.“"
                                            },
                                            {
                                                "example_id": "b0b57e68-084f-455d-b0a7-bb6883014223",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Sie sprechen kaum noch Kaschmiri, sondern stattdessen Punjabi-Dialekte; auch Urdu wird als Sprache, die soziale Mobilität erlaubt, bevorzugt.“"
                                            },
                                            {
                                                "example_id": "ab3a48b8-2561-4d0d-a174-3a63b0e3ef5f",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Smite unterhielt sich auf Urdu mit Azzam, so laut, dass dessen Männer, die sich in etwa zwanzig Metern Entfernung postiert hatten, ihn noch hören konnten.“"
                                            },
                                            {
                                                "example_id": "bc2edcee-3c7e-45ee-bb51-12ac15f4d5b3",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Manche gaben sich als kürzlich in Not geratene Angestellte aus und radebrechten in höflichem Urdu, um die angesichts der bodenlosen Gier halb nackter Kinder und erschöpfter, blinder alter Frauen verhärteten Herzen zu erweichen.“"
                                            },
                                            {
                                                "example_id": "82540acb-9d54-4e98-acde-5897ab9c892a",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Abgesehen von einem Afghanen, der als Dolmetscher und Führer fungierte, sprach kein einziger Puschto, Dari oder auch Urdu.“"
                                            },
                                            {
                                                "example_id": "5f82ea13-eb03-4670-affd-e57b3974cd4f",
                                                "sense_id": "7a180732-a419-3b04-bb2f-c3880d6c09fb",
                                                "text": "„Außerdem beherrschte er die beiden gängigen Sprachen in Pakistan: Punjabi und Urdu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
