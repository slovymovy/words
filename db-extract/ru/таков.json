                        "form": "таковы́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "525ea77f-2052-3ee6-ab79-607caf1644f4",
                        "entry_id": "e34d00d1-6579-30aa-9de4-6b92f9c80ef2",
                        "glosses": [
                            "like that, like this (sometimes translated as simply \\\"that\\\"/\\\"those\\\"\\\" or \\\"this\\\"/\\\"these\\\")"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adae062d-e328-45a4-8b9d-506ed15d49b2",
                                "sense_id": "525ea77f-2052-3ee6-ab79-607caf1644f4",
                                "text": "и был тако́в",
                                "translation": "and took off / and off he went / and was gone",
                                "english": "and took off / and off he went / and was gone"
                            },
                            {
                                "example_id": "e65c279e-0e94-4835-9d65-7bde1351c271",
                                "sense_id": "525ea77f-2052-3ee6-ab79-607caf1644f4",
                                "text": "Все́ ко́шки таковы́.",
                                "translation": "All cats are like that.",
                                "english": "All cats are like that."
                            },
                            {
                                "example_id": "1c576bb8-e1c5-4d22-a259-920165465ce8",
                                "sense_id": "525ea77f-2052-3ee6-ab79-607caf1644f4",
                                "text": "Вопро́с тако́в: заче́м они́ э́то де́лают?",
                                "translation": "The question is, why are they doing this?",
                                "english": "The question is, why are they doing this?"
                            },
                            {
                                "example_id": "abe92893-42c6-4bd2-a98d-7342e5a4e6fe",
                                "sense_id": "525ea77f-2052-3ee6-ab79-607caf1644f4",
                                "text": "Таковы́ фа́кты.",
                                "translation": "Such are the facts.",
                                "english": "Such are the facts."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c1c359d-3caf-337e-a58f-97a01c9f0f8a",
                        "entry_id": "e34d00d1-6579-30aa-9de4-6b92f9c80ef2",
                        "glosses": [
                            "such (in such a way that the following clause is true)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac2accc-8de0-41da-9a36-ae2fc4ddf195",
                                "sense_id": "2c1c359d-3caf-337e-a58f-97a01c9f0f8a",
                                "text": "Ситуа́ция такова́, что э́то невозмо́жно.",
                                "translation": "The situation is such that this is not possible.",
                                "english": "The situation is such that this is not possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcd2e419-ed9d-3e6d-9d4a-83443e708be8",
                        "entry_id": "e34d00d1-6579-30aa-9de4-6b92f9c80ef2",
                        "glosses": [
                            "as, the way (in the way described in the following clause)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a063a3f-40b6-4052-a68d-a3b3bdb3cb30",
                                "sense_id": "fcd2e419-ed9d-3e6d-9d4a-83443e708be8",
                                "text": "Фа́кты таковы́, как я их изложи́л.",
                                "translation": "The facts are as I have presented them.",
                                "english": "The facts are as I have presented them."
                            },
                            {
                                "example_id": "dcccec91-8e09-4cfe-9875-6db174b66168",
                                "sense_id": "fcd2e419-ed9d-3e6d-9d4a-83443e708be8",
                                "text": "Мир тако́в, како́в он есть.",
                                "translation": "The world is the way it is.",
                                "english": "The world is the way it is."
                            }
                        ]
                    }
                ],
                "translations": [],
