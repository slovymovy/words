                ],
                "senses": [
                    {
                        "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                        "entry_id": "772ac195-f745-3d3d-bf77-48873fed2ee2",
                        "glosses": [
                            "Bereich einer Stadt um den Bahnhof herum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "021d79e1-83e8-44b6-8a4b-6f526fe2f063",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„Bahnhofsviertel stehen im Ruf, unheimlich und ein bisschen schmuddelig zu sein.“"
                            },
                            {
                                "example_id": "5b9048bb-37af-425f-bb98-b7aa4b25d30a",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„In Alexandrias Bahnhofsviertel herrscht dichtes Gedränge. Vor dem historischen Bahnhof preisen Händler ihre Waren an – Plastikspielzeug, Sonnenbrillen, Getränkedosen.“"
                            },
                            {
                                "example_id": "abada4d8-0339-4a1f-a797-bbe615484174",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "[…] der Münchner Hauptbahnhof und das ganze Bahnhofsviertel [ist] bei einem hohen Ausländeranteil immer auch ein Anziehungspunkt für Angehörige sozialer Randgruppen und ein kritischer Brennpunkt der Alkohol- und Drogenszene."
                            },
                            {
                                "example_id": "91e3d32c-fe2e-4bf2-b078-6b5739f95c66",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„Stewardessen einer Fluggesellschaft haben dieses Jahr Alarm geschlagen. Sie wollten nicht mehr angepöbelt werden im Münchner Bahnhofsviertel, wenn sie von ihrem Dienst kamen oder noch was trinken wollten abends.“"
                            },
                            {
                                "example_id": "a26fcc2e-7b90-421e-9b82-da85fcd891c3",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„Oskar Schindler, Unternehmer und Retter von mehr als 1200 Juden in Polen, lebte nach dem Zweiten Weltkrieg einsam und verarmt in einer kleinen Wohnung im Frankfurter Bahnhofsviertel.“"
                            },
                            {
                                "example_id": "ac7c184b-7b05-405f-bf34-858b9766d463",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„Das Museumsufer ist nur ein Kilometer vom Hauptbahnhof entfernt (Gehzeit 12 - 15 Minuten). Auf der Strecke muss man durch das berüchtigte Bahnhofsviertel. Zur belebten, hellen Tageszeit ist das aber in der Regel kein Problem.“"
                            },
                            {
                                "example_id": "47fe9760-8f6b-4b64-bb13-88d11f87df6a",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„Die einfache Bestellung macht Legal Highs vor allem für Menschen auf dem Land attraktiv. Für diesen Rausch muss man keinen Dealer kennen oder sich im Bahnhofsviertel der nächstgelegenen Großstadt herumtreiben.“"
                            },
                            {
                                "example_id": "a54d31eb-e848-46f7-a716-219a3a63e60a",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„Als im 19. Jahrhundert die Bedeutung der Kölner Hafenanlage zurück ging, avancierte der Stadtteil zum neuen Bahnhofsviertel.“"
                            },
                            {
                                "example_id": "006df3c9-bbb6-4a22-acc2-d174c7d2e0de",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„[ein Beamter eines Ordnungsamts:] 'Wie sollen wir denn entscheiden, welche von den 20 Spielhallen in einem Bahnhofsviertel schließen muss und welche nicht?'“"
                            },
                            {
                                "example_id": "9419d3b2-f509-434b-b58e-0d6e8c14c08e",
                                "sense_id": "49154ae0-9755-375e-b746-d9dcca53f17d",
                                "text": "„[Leipzig] nimmt gemeinsam mit Düsseldorf und München an einer Bürgerbefragung des Verbundprojekts »Sicherheit im Bahnhofsviertel« teil, die am Montag beginnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
