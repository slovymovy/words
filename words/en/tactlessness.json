                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Apologizing for his recent <w>tactlessness</w> was necessary after the awkward meeting.",
                            "target_lang_translations": {
