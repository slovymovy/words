                "senses": [
                    {
                        "sense_id": "b52c9bfb-9655-345f-aa82-0a5175f04011",
                        "entry_id": "d56f9a3e-81f2-30ea-9794-f9b30e00663d",
                        "glosses": [
                            "Celui, celle qui appartient à la race dont on fait remonter l’origine à Sem."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "950587b5-5cd8-4668-8964-5d4cf0219850",
                                "sense_id": "b52c9bfb-9655-345f-aa82-0a5175f04011",
                                "text": "C'est uniquement sur des données historiques et linguistiques que se fonde Moïse pour déterminer les groupements ethniques qui descendent de Sem, de Cham et de Japhet : les Sémites, pasteurs nomades, les Chamites sédentaires et les fils de Japhet, ancêtres des races caucasiques."
                            },
                            {
                                "example_id": "3d8c0536-8fa3-47de-af92-3e3fabb0ed33",
                                "sense_id": "b52c9bfb-9655-345f-aa82-0a5175f04011",
                                "text": "Les Sémites de l'Ouest, appelés ainsi pour les distinguer de leurs congénères orientaux, Babyloniens et Assyriens, représentent (…) divers peuples ou groupes de peuples, établis au Proche Orient plusieurs millénaires avant l'ère chrétienne."
                            }
                        ]
                    }
