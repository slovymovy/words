                ],
                "senses": [
                    {
                        "sense_id": "10c9327a-25d6-3a9c-a8c4-3ff426eaf53c",
                        "entry_id": "9454ddc6-4039-309b-b5a3-e40734df27de",
                        "glosses": [
                            "S’aimer mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbc45432-c9b1-49b5-9118-ace73b89493b",
                                "sense_id": "10c9327a-25d6-3a9c-a8c4-3ff426eaf53c",
                                "text": "Des règles de conduite pour le ménage : Comment l’homme et la femme doivent-ils s’entre-aimer sans blâme?"
                            },
                            {
                                "example_id": "509b4f83-658a-48c4-949c-893719fa7971",
                                "sense_id": "10c9327a-25d6-3a9c-a8c4-3ff426eaf53c",
                                "text": "Pendant vingt siècles, ils ont été exhortés à s’entre-aimer, mais contraints à s’entre-haïr : ils ne pouvaient survivre qu’à ce prix."
                            },
                            {
                                "example_id": "d76f7ed1-156f-4a9a-9ecb-af6fdbdddc1b",
                                "sense_id": "10c9327a-25d6-3a9c-a8c4-3ff426eaf53c",
                                "text": "S’entre-aimer pas assez rend le produit plus rare, et donc, bien plus cher ! Et s’entre-aimer pas du tout anéantit le marché."
                            }
                        ]
                    }
