                        "cross_references": [
                            {
                                "target_word": "hippo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f23aba58-82ff-3c6f-8165-c866587db685",
                                        "entry_id": "c76fee00-3423-3a91-92a3-097d57128480",
                                        "glosses": [
                                            "Clipping of hippopotamus."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5afda04-aaf8-4f4c-89ad-6cae38e09f3f",
                                                "sense_id": "f23aba58-82ff-3c6f-8165-c866587db685",
                                                "text": "There was an old hippo that had the bad habit of getting out on the bank and roaming at night over the station grounds."
                                            },
                                            {
                                                "example_id": "17fb1219-0e46-4be6-a1d5-d7a8a402d61c",
                                                "sense_id": "f23aba58-82ff-3c6f-8165-c866587db685",
                                                "text": "\"I've seen them buryin' a chief up the Aruwimi River, and they ate a hippo that must have weighed as much as a tribe.\""
                                            },
                                            {
                                                "example_id": "29d49edb-c1e1-44e0-a7bd-bfac126f5e2f",
                                                "sense_id": "f23aba58-82ff-3c6f-8165-c866587db685",
                                                "text": "The Eastern Cape village whose dam has been taken over by a hippo will decide next week what happens to the animal."
                                            },
                                            {
                                                "example_id": "8d3bdbb3-a146-4680-8f9e-cc6dd002ec20",
                                                "sense_id": "f23aba58-82ff-3c6f-8165-c866587db685",
                                                "text": "A group of hippos is called a bloat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09be8b81-e7fc-3741-98a3-7e770c8bc30d",
                                        "entry_id": "c76fee00-3423-3a91-92a3-097d57128480",
