                                "target_senses": [
                                    {
                                        "sense_id": "6db58929-bb64-3101-a619-67b1928ce13e",
                                        "entry_id": "bb6291ec-fe64-3aab-8b93-3d1d42f40175",
                                        "glosses": [
                                            "znak označující konec určité sekvence"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e22bac4c-fab0-498e-bab3-0f23f0428513",
                                                "sense_id": "6db58929-bb64-3101-a619-67b1928ce13e",
                                                "text": "Python používá nové řádky jako terminátor příkazů."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185652e8-6a3f-3e39-8596-aeaeedc64d03",
                                        "entry_id": "bb6291ec-fe64-3aab-8b93-3d1d42f40175",
                                        "glosses": [
                                            "rozhraní mezi sluncem osvětlenou a neosvětlenou částí kosmického tělesa"
                                        ],
                                        "tags": [
                                            "v astronomii"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620d9ea2-f5fa-462a-8be7-3371c2233bc2",
                                                "sense_id": "185652e8-6a3f-3e39-8596-aeaeedc64d03",
                                                "text": "„Jasně,“ uchechtla se Markéta, „ale terminátor má víc významů a zrovna teď mluvim o rozhraní mezi ozářenou a neozářenou polokoulí planety. Takzvanej sluneční terminátor.“"
                                            },
                                            {
                                                "example_id": "bcfb2e8b-b9ab-479b-b9eb-0b30ada96790",
                                                "sense_id": "185652e8-6a3f-3e39-8596-aeaeedc64d03",
                                                "text": "Poruchy v příjmu nastávají, když se řetěz retranslačních stanic dostane do oblasti terminátoru. Když je část retranslačních stanic ještě ve stínu a nad ostatními vychází slunce..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4722d861-8e81-38e1-8e8c-899a691e24fd",
                                        "entry_id": "bb6291ec-fe64-3aab-8b93-3d1d42f40175",
                                        "glosses": [
                                            "úsek DNA značící konec genu, jenž ukončuje transkripci"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eb1119f-7634-49bb-a569-8dee9e807328",
                                                "sense_id": "4722d861-8e81-38e1-8e8c-899a691e24fd",
                                                "text": "Promotor a terminátor mají význam pro správné připojení a odpojení RNA-polymerasy a ostatních proteinů, které se účastní při transkripci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6f98d3-09be-3e2a-92ed-05a911c1a68f",
                                        "entry_id": "bb6291ec-fe64-3aab-8b93-3d1d42f40175",
                                        "glosses": [
                                            "součástka pro zakončení kabelů počítačových sítí"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375b889e-dfca-471a-b734-1629cb627dbe",
                                                "sense_id": "fe6f98d3-09be-3e2a-92ed-05a911c1a68f",
                                                "text": "Koaxiální sběrnice je vystavená stejným potenciálním problémům s téčky a terminátory jako tenký Ethernet. Pokud terminátor chybí, síť alespoň částečně vypadne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
