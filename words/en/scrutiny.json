{
    "word_family": [
        "scrutinize",
        "inscrutable",
        "scrutinizer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7924f4ac-daa7-34cd-8d50-aa51f29adef4",
                    "sense_definition": "Careful and thorough inspection, observation, or examination of a person, situation, or object.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's financial records have recently come under close <w>scrutiny</w>.",
                            "target_lang_translations": {
                                "ru": "Финансовые отчеты политика недавно подверглись пристальной <w>проверке</w>."
                            }
                        },
                        {
                            "text": "Her theory is interesting, but it does not stand up to scientific <w>scrutiny</w>.",
                            "target_lang_translations": {
                                "ru": "Ее теория интересна, но она не выдерживает научной <w>критики</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "examination",
                        "inspection",
                        "investigation",
                        "study",
                        "probe",
                        "inquiry"
                    ],
                    "common_phrases": [
                        "come under scrutiny",
                        "close scrutiny",
                        "public scrutiny",
                        "bear scrutiny",
                        "stand up to scrutiny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательное и детальное изучение, наблюдение или проверка человека, ситуации или объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщательная проверка",
                                "target_lang_sense_clarification": "детальный осмотр или инспекция"
                            },
                            {
                                "target_lang_word": "пристальное внимание",
                                "target_lang_sense_clarification": "интенсивное изучение со стороны общественности или властей"
                            },
                            {
                                "target_lang_word": "исследование",
                                "target_lang_sense_clarification": "глубокий анализ или изучение"
                            },
                            {
                                "target_lang_word": "рассмотрение",
                                "target_lang_sense_clarification": "официальное изучение дела или вопроса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b630d9c7-2304-3d8d-b30d-cb5ba5082f03",
                    "sense_definition": "An official examination of votes cast in an election to verify their validity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee ordered a <w>scrutiny</w> of the ballot papers after the close result.",
                            "target_lang_translations": {
                                "ru": "Комитет распорядился провести <w>пересчет</w> избирательных бюллетеней после получения близких результатов."
                            }
                        },
                        {
                            "text": "During the <w>scrutiny</w>, several invalid votes were discovered and discarded.",
                            "target_lang_translations": {
                                "ru": "В ходе <w>проверки</w> было обнаружено и отсеяно несколько недействительных голосов."
                            }
                        }
                    ],
                    "synonyms": [
                        "examination",
                        "inspection"
                    ],
                    "common_phrases": [
                        "scrutiny of the poll",
                        "demand a scrutiny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная проверка поданных на выборах голосов для подтверждения их действительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересчёт голосов",
                                "target_lang_sense_clarification": "с целью проверки правильности"
                            },
                            {
                                "target_lang_word": "проверка правильности голосования",
                                "target_lang_sense_clarification": "официальная процедура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7acfefd-c42f-3c67-a972-318fe3621c15",
                    "sense_definition": "A formal examination of catechumens preparing for baptism, traditionally held during Lent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop presided over the <w>scrutiny</w> of the candidates before the Easter ceremony.",
                            "target_lang_translations": {
                                "ru": "Епископ руководил <w>испытанием</w> кандидатов перед пасхальной церемонией."
                            }
                        },
                        {
                            "text": "Each <w>scrutiny</w> was designed to strengthen the faith of those preparing for baptism.",
                            "target_lang_translations": {
                                "ru": "Каждое <w>испытание</w> было призвано укрепить веру тех, кто готовился к крещению."
                            }
                        }
                    ],
                    "synonyms": [
                        "examination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное испытание оглашенных (катехуменов), готовящихся к крещению, традиционно проводимое во время Великого поста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытание",
                                "target_lang_sense_clarification": "религиозный обряд перед крещением"
                            },
                            {
                                "target_lang_word": "скрутиниум",
                                "target_lang_sense_clarification": "специальный литургический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}