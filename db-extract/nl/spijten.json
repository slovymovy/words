                "senses": [
                    {
                        "sense_id": "17a82177-98b4-33c2-965a-4cccdc25078d",
                        "entry_id": "a55a02a9-d503-3d8b-9b7a-0bd91371ea04",
                        "glosses": [
                            "berouw veroorzaken"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "12181dd6-feae-45e8-a32d-689b8b5dc3ad",
                                "sense_id": "17a82177-98b4-33c2-965a-4cccdc25078d",
                                "text": "Het speet hem dat hij de verjaardag van zijn vrouw niet bij kon wonen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a60e174-feba-3597-9cb2-65234aa14d80",
                        "entry_id": "a55a02a9-d503-3d8b-9b7a-0bd91371ea04",
                        "glosses": [
                            "ergernis bezorgen, boos of verdrietig maken"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3a09a0b6-3a89-4c09-9e87-bbd31e7f2242",
                                "sense_id": "9a60e174-feba-3597-9cb2-65234aa14d80",
                                "text": "Mijne stellige weigering en de begeesterde woorden, welke ik ertoe bezigde, schenen hem te spijten; (…)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "614e165d-bdba-4f33-a4be-e450d0e94d63",
                        "source_entry_id": "a55a02a9-d503-3d8b-9b7a-0bd91371ea04",
                        "source_sense_id": "17a82177-98b4-33c2-965a-4cccdc25078d",
