                                                "example_id": "9d493ba7-cb11-4788-9e67-b87e61b2adb4",
                                                "sense_id": "71db8ec3-5bd8-371e-b873-39ada3b39a1e",
                                                "text": "По жилету лежала изящная цепочка, с множеством мельчайших брелоков."
                                            },
