                        "examples": [
                            {
                                "example_id": "7e0b947a-479e-4c1f-a841-29cd0e847f4c",
                                "sense_id": "883193a0-e2ac-3167-9195-5fe866e7d242",
                                "text": "Niels Bohr is de grondlegger van de kwantummechanica"
                            },
                            {
                                "example_id": "75f61e52-3ef5-44bc-bd85-45e315fda220",
                                "sense_id": "883193a0-e2ac-3167-9195-5fe866e7d242",
                                "text": "Scrambler vertelde dat hij erg geïnspireerd was door de legendarische Grandma Gatewood, de grondlegger van de ultra-light beweging, om met een zo licht mogelijke uitrusting te lopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "323fa1a0-e951-47a8-8cf3-5079cde06033",
                        "source_entry_id": "f702c918-5492-32c0-b0ea-ca493aa497ea",
                        "source_sense_id": "883193a0-e2ac-3167-9195-5fe866e7d242",
                        "target_lang_word": "Gründer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gründer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec9110c3-2e94-3131-874a-542c18ce15f4",
                                        "entry_id": "4b191231-17b7-3482-a273-c7ae695d9142",
                                        "glosses": [
                                            "jemand, der etwas (zum Beispiel eine Organisation, einen Verlag oder eine Stadt, ein Start-up) ins Leben ruft, gründet oder gegründet hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5940790b-bc45-4f27-9426-5b830d53cd3f",
                                                "sense_id": "ec9110c3-2e94-3131-874a-542c18ce15f4",
                                                "text": "Der Verlag ist nach seinem Gründer Axel Springer benannt."
                                            },
                                            {
                                                "example_id": "b1395236-cdf5-438b-ac96-37fdf33459e9",
                                                "sense_id": "ec9110c3-2e94-3131-874a-542c18ce15f4",
                                                "text": "„Eigenkapital der Gründer: Die Gründer sollten in der Lage sein, möglichst viel des Kapitalbedarfs selbst aufzubringen.“"
                                            },
                                            {
                                                "example_id": "335b1c21-d889-456b-b58f-737828b1f875",
                                                "sense_id": "ec9110c3-2e94-3131-874a-542c18ce15f4",
                                                "text": "„Erzherzog Eugen war der letzte Deutschmeister (von 1894 bis 1923) und Gründer eines Waisenhauses im niederösterreichischen Unterdambach, das heute nicht mehr existiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5b2847c-2492-4150-b03b-45d2d1cb42c2",
                        "source_entry_id": "f702c918-5492-32c0-b0ea-ca493aa497ea",
                        "source_sense_id": "883193a0-e2ac-3167-9195-5fe866e7d242",
                        "target_lang_word": "founder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "founder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c287a6-3850-34bf-8b46-dbb17d649543",
                                        "entry_id": "50367ce8-2bbb-34a3-9bc3-64d80190b8a0",
                                        "glosses": [
                                            "One who founds or establishes (a company, project, organisation, state, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd5afba-db6a-4f1c-88fd-95e79eb1b004",
                                                "sense_id": "b2c287a6-3850-34bf-8b46-dbb17d649543",
                                                "text": "The founder of Facebook is Mark Zuckerberg."
                                            },
                                            {
                                                "example_id": "aa57b302-31c0-4bbd-92ca-e01a7fccc009",
                                                "sense_id": "b2c287a6-3850-34bf-8b46-dbb17d649543",
                                                "text": "As to eleemoſynary corporations, by the dotation the founder and his heirs are of common right the legal viſitors, to ſee that that property is rightly employed, which would otherwiſe have deſcended to the viſitor himſelf: […]"
                                            },
                                            {
                                                "example_id": "525d6418-a3fb-4043-830d-6b30321c5bb9",
                                                "sense_id": "b2c287a6-3850-34bf-8b46-dbb17d649543",
                                                "text": "Young people love to idolize their predecessors. [Steve] Jobs was Silicon Valley's idol of choice for decades, but to the next generation of startup founders, his legacy feels about as old as Web 1.0."
                                            },
                                            {
                                                "example_id": "029d6ab3-c857-4f13-8d1b-0b5ccf4cc393",
                                                "sense_id": "b2c287a6-3850-34bf-8b46-dbb17d649543",
                                                "text": "Chris Printup, a founder of the streetwear brand Born X Raised, which became a fixture on the Los Angeles fashion scene, died on Wednesday morning at a hospital in Albuquerque. He was 42."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                                        "entry_id": "50367ce8-2bbb-34a3-9bc3-64d80190b8a0",
                                        "glosses": [
                                            "A common ancestor of some population (especially one with a certain genetic mutation)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45637e81-0ed9-4b13-8dbc-806733972829",
                                                "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                                                "text": "a founder population"
                                            },
                                            {
                                                "example_id": "a1ce4e37-663a-47a1-8a29-16ce43778782",
                                                "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                                                "text": "the founder effect"
                                            },
                                            {
                                                "example_id": "83facedb-898c-4825-93a9-72b64ee092b6",
                                                "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                                                "text": "The sickle cell mutation today can be found in five different haplotypes, leading to the conclusion that the mutation appeared independently five times in five different founders."
                                            },
                                            {
                                                "example_id": "abc100b6-cbf3-46c9-aa4d-bbc120d0a801",
                                                "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                                                "text": "Among the Ashkenazi Jews in the positive group, 81 percent had one of the three founder mutations, suggesting that 23andMe's test could be helpful for them."
                                            },
                                            {
                                                "example_id": "569beb63-1ec5-49fe-a21d-f6055e727751",
                                                "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                                                "text": "The gene mutation is likely to have come from a founder individual who lived at least 250 years ago, the paper published in the European Journal of Human Genetics said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "founder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a71b830-fe0f-323e-a704-ebe35234a75e",
                                        "entry_id": "379416f3-072f-30dc-bdbd-57c793380a6e",
                                        "glosses": [
                                            "The iron worker in charge of the blast furnace and the smelting operation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8f9fbaa-8fb7-47ad-8baf-0c6de8a08645",
                                                "sense_id": "2a71b830-fe0f-323e-a704-ebe35234a75e",
                                                "text": "The term 'founder' was applied in the British iron industry long afterwards to the ironworker in charge of the blast furnace and the smelting operation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8860939a-0903-30da-b8a2-d2ba3090428f",
                                        "entry_id": "379416f3-072f-30dc-bdbd-57c793380a6e",
                                        "glosses": [
                                            "One who casts metals in various forms; a caster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29695ab9-114c-453a-8154-08b9ed9f8b21",
                                                "sense_id": "8860939a-0903-30da-b8a2-d2ba3090428f",
                                                "text": "a founder of cannon, bells, hardware, or printing types"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "founder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "105910b9-744f-3fd6-939d-3f0473afb42c",
                                        "entry_id": "c1823149-1bd5-39c9-b2ed-b5997b14475d",
                                        "glosses": [
                                            "A severe laminitis of a horse, caused by untreated internal inflammation in the hooves."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "founder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5f53a4-a1ad-3f2d-8f87-59f13fad9c42",
                                        "entry_id": "32eac038-b0e7-346c-991a-210dc7fb5564",
                                        "glosses": [
                                            "To flood with water and sink."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7968992-9a2d-450d-8f91-b12a6cc6e6fb",
                                                "sense_id": "fa5f53a4-a1ad-3f2d-8f87-59f13fad9c42",
                                                "text": "We were not much more than a quarter of an hour out of our ship but we saw her sink, and then I understood for the first time what was meant by a ship foundering in the sea."
                                            },
                                            {
                                                "example_id": "c9ad0870-3abf-4552-b82f-6741ffb95a61",
                                                "sense_id": "fa5f53a4-a1ad-3f2d-8f87-59f13fad9c42",
                                                "text": "This ended, in prolonged solemn tones, like the continual tolling of a bell in a ship that is foundering at sea in a fog—in such tones he commenced reading the following hymn;(...)"
                                            },
                                            {
                                                "example_id": "bdc3a324-af24-46c5-8e62-bb4f4212e9a9",
                                                "sense_id": "fa5f53a4-a1ad-3f2d-8f87-59f13fad9c42",
                                                "text": "Amongst the battleships, things are rather different. Barham led a valiant charge, but suffered for it; she will founder under tow in the Thames estuary shallows, eventually being refloated and refitted after the war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7147160-0737-3e1d-aee0-2cfbc6abfd0e",
                                        "entry_id": "32eac038-b0e7-346c-991a-210dc7fb5564",
                                        "glosses": [
                                            "To fall; to stumble and go lame."
                                        ],
                                        "tags": [
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04ad69d5-5492-3b51-afd1-92ce2516f8f6",
                                        "entry_id": "32eac038-b0e7-346c-991a-210dc7fb5564",
                                        "glosses": [
                                            "To fail; to miscarry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffe8d99d-f27d-4456-8f0e-ec3b5487ed54",
                                                "sense_id": "04ad69d5-5492-3b51-afd1-92ce2516f8f6",
                                                "text": "All his tricks founder."
                                            },
                                            {
                                                "example_id": "6166126b-186f-47c1-8a2a-0203a3ab7619",
                                                "sense_id": "04ad69d5-5492-3b51-afd1-92ce2516f8f6",
                                                "text": "The other ambitions, and much of Prescott's plan, foundered just south of Hatfield that October, when a GNER express derailed on a shattered rail […], plunging the railway into a crisis that led to private track owner Railtrack being put into administration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba60a2e-45bc-37be-872b-aed0425fc4b5",
                                        "entry_id": "32eac038-b0e7-346c-991a-210dc7fb5564",
                                        "glosses": [
                                            "To cause to flood and sink, as a ship."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e860289-6940-4233-b9f4-e4558e2d7a89",
                                                "sense_id": "4ba60a2e-45bc-37be-872b-aed0425fc4b5",
                                                "text": "We found a strong Tide setting out of the Streights to the Northward, and like to founder our Ship."
                                            },
                                            {
                                                "example_id": "dec3a504-1014-447a-824b-fc4819694ee4",
                                                "sense_id": "4ba60a2e-45bc-37be-872b-aed0425fc4b5",
                                                "text": "I was amazed when we came among the breakers (which to me seemed large enough to founder our ship), to see with what wondrous dexterity they carried us through them, and ran their canoes on the top of one of those rolling waves […]"
                                            },
                                            {
                                                "example_id": "7f57f30e-a742-4072-ab5f-d4d5f7f02b6b",
                                                "sense_id": "4ba60a2e-45bc-37be-872b-aed0425fc4b5",
                                                "text": "1932, Hart Crane, \"From haunts of Proserpine\" (Review of Green River: A Poem for Rafinesque, James Whaler\nBut still more disastrous was the storm which foundered his ship in Long Island Sound, swallowing within call of shore his fifty boxes of scientific equipment, his books, manuscripts and funds, the results of years of devoted labor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d345f23e-ecda-3d29-9380-9192417f887e",
                                        "entry_id": "32eac038-b0e7-346c-991a-210dc7fb5564",
                                        "glosses": [
                                            "To disable or lame (a horse) by causing internal inflammation and soreness in the feet or limbs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7e55006-5b9a-4c59-9c42-8a921fd478d9",
                        "source_entry_id": "f702c918-5492-32c0-b0ea-ca493aa497ea",
                        "source_sense_id": "883193a0-e2ac-3167-9195-5fe866e7d242",
                        "target_lang_word": "fondateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32021023-1491-3cca-b9dc-eb1db749c051",
                                        "entry_id": "04a4c632-b10c-3813-b129-521e6583112b",
                                        "glosses": [
                                            "Celui qui a fondé, a posé les bases de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9847be4-f6b3-4765-9149-30b2618c142a",
                                                "sense_id": "32021023-1491-3cca-b9dc-eb1db749c051",
                                                "text": "Non loin de Lixy, dit-il, est le ravin de Bonval...; à la fonte des neiges, ou à la suite des orages, ce torrent devient formidable on a trouvé quelquefois dans son lit desséché, des médailles romaines petit bronze à l’effigie de Constantin ou de Licinius que quelques personnes ont dit être le fondateur de Lixy."
                                            },
                                            {
                                                "example_id": "ba4b2e40-4de1-4efa-b3cc-b2ce725876e3",
                                                "sense_id": "32021023-1491-3cca-b9dc-eb1db749c051",
                                                "text": "Le système de Buffon sera surtout repris par le plus grand hippiatre de l’époque, le fondateur de la science vétérinaire, l’écuyer le plus célèbre de son temps : Claude Bourgelat."
                                            },
                                            {
                                                "example_id": "3e8b409b-7665-4fce-b606-0e5c1dccefbc",
                                                "sense_id": "32021023-1491-3cca-b9dc-eb1db749c051",
                                                "text": "Que reste-t-il donc aujourd'hui de leur héritage, que reste-t-il donc du nassérisme et du baasisme, après le drame de leurs fondateurs, après leur tumultueux rapprochement et leur douloureuse séparation ? A la vérité, presque rien et presque tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e102401-2797-3513-9a74-402feb8d0a18",
                                        "entry_id": "04a4c632-b10c-3813-b129-521e6583112b",
                                        "glosses": [
                                            "Ceux qui fondent des lits dans un hôpital, des bourses dans un collège, des messes dans une église, des prix dans une académie, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8ee566-208a-4a1b-8b34-ea67d5e6fdbd",
                                                "sense_id": "8e102401-2797-3513-9a74-402feb8d0a18",
                                                "text": "Autre Mandement […], le 23. Juin 1543. pour empécher que lesdits Mahé & du Hamel ne se qualifiassent Fondateurs de ladite Eglise de Moulines, ni même vendiquassent aucuns droits en ladite Eglise, au préjudice des droits, prérogatives & preéminences de ladite Eglise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
