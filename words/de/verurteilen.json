                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das gerechte <w>Verurteilen</w> von Straftaten liegt allein in der Verantwortung der Gerichte."
