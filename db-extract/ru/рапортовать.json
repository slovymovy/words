                        "examples": [
                            {
                                "example_id": "a0015348-2244-4a42-a35f-65b63c8c629a",
                                "sense_id": "682cefff-5d4f-3745-98d5-acc4bc53b077",
                                "text": "Се́меро вошли́, толка́ясь в у́зком прохо́де. У пе́рвого нашло́сь сме́лости рапортова́ть о благополу́чии Черемша́нского райо́на, и Кури́лов усмехну́лся де́тской лёгкости, с како́ю тот совра́л.",
                                "translation": "Leonid Leonov",
                                "english": "Leonid Leonov"
                            }
                        ]
                    }
                ],
