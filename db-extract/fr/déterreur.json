                                        "entry_id": "c930125a-a491-360c-a3b5-0ce2e5deae59",
                                        "glosses": [
                                            "jemand, der widerrechtlich etwas aus einem Grab entnimmt; jemand, der Grabraub begeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb09b63f-608a-4f6c-b9ff-6f38ac81a588",
                                                "sense_id": "44d5d79e-b91c-3a86-8951-4a02f928eb04",
                                                "text": "„Sie sollten vor allem verhindern, daß Grabräuber sich an den kostbaren Beigaben zu schaffen machten.“"
                                            },
                                            {
                                                "example_id": "0d6caf26-9ce9-43ad-b871-87d8b474e1ba",
                                                "sense_id": "44d5d79e-b91c-3a86-8951-4a02f928eb04",
                                                "text": "„Du bist kein Grabräuber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
