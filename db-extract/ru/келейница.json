                "senses": [
                    {
                        "sense_id": "cf690a06-82fd-3287-9977-1051958b9fcc",
                        "entry_id": "29677616-db95-3a53-83dc-8d28245fb21d",
                        "glosses": [
                            "истор. прислужница при игуменье и некоторых других монахинях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0937f5-c1e1-4d5a-b2f7-794fb2add27c",
                                "sense_id": "cf690a06-82fd-3287-9977-1051958b9fcc",
                                "text": "Потом, в конце 80-х годов, выяснилось, что в миру она была его келейницей."
                            }
                        ]
                    },
                    {
                        "sense_id": "09e27818-c365-370d-b24c-8481329372d3",
                        "entry_id": "29677616-db95-3a53-83dc-8d28245fb21d",
                        "glosses": [
                            "истор. женск. к келейник; женщина, живущая в монашеской келье, в скиту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "103a4b97-aea1-40dd-8f55-cb5bc78481f1",
                                "sense_id": "09e27818-c365-370d-b24c-8481329372d3",
                                "text": "Царь велел выгнать из монастырей всех непостриженных, и в женских монастырях келейницам быть только людям старого возраста; всех девиц, проживавших в монастырях, под именем родственниц, велено выдавать замуж, а вперед постригать в монахини не ранее сорока лет."
                            }
                        ]
                    }
