                ],
                "senses": [
                    {
                        "sense_id": "4f46c60f-0620-3104-9c06-efbdfb1e2129",
                        "entry_id": "1584e053-216f-3d08-a061-acd7c880d9b8",
                        "glosses": [
                            "Rendre brun ou plus brun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84bf5e73-e358-4068-a715-88c05a50cb47",
                                "sense_id": "4f46c60f-0620-3104-9c06-efbdfb1e2129",
                                "text": "Et moi seul j'aurai vu se lever cette aurore\nDans la tiède fraîcheur d'un matin embruni."
                            },
                            {
                                "example_id": "73cb028f-ce99-4213-bc03-3a7f8b8d7d65",
                                "sense_id": "4f46c60f-0620-3104-9c06-efbdfb1e2129",
                                "text": "Là, le raisin embrunissait dans les vignes basses, à cause de l’eau qui était tombée."
                            }
                        ]
                    },
                    {
                        "sense_id": "1776c4b0-2e48-37ef-920f-0782070b67b0",
                        "entry_id": "1584e053-216f-3d08-a061-acd7c880d9b8",
                        "glosses": [
                            "Devenir brun ou plus brun."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "72087856-fcec-407b-ae00-2da4c884488d",
                                "sense_id": "1776c4b0-2e48-37ef-920f-0782070b67b0",
                                "text": "Puis il reprit sa route, car maintenant, au haut de la montée, dans l’ovale des frondaisons, s’embrunissait la perle humide et dorée du soir."
                            }
                        ]
                    }
                ],
