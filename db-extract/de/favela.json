                    {
                        "sense_id": "2b949879-0e01-3b23-b3d8-6cb8c8841506",
                        "entry_id": "7204f212-e865-300e-8c51-eb7bf12de529",
                        "glosses": [
                            "Elendsviertel am Rande südamerikanischer, insbesondere brasilianischer Städte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f58284f-2b1b-4a9e-8d85-7c216705a7cb",
                                "sense_id": "2b949879-0e01-3b23-b3d8-6cb8c8841506",
                                "text": "„Das Maracanã-Stadion wird für 400 Millionen Euro umgebaut, von Drogenbossen kontrollierte Favelas werden befriedet, Straßen und Hafengegend aufwendig ausgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0a6dd3b-b1ac-46fe-838f-91cc098f5116",
                        "source_entry_id": "7204f212-e865-300e-8c51-eb7bf12de529",
                        "source_sense_id": "2b949879-0e01-3b23-b3d8-6cb8c8841506",
                        "source_sense_description": "Elendsviertel am Rande südamerikanischer, insbesondere brasilianischer Städte",
                        "target_lang_word": "favela",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favela",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1250a207-8160-3453-b957-5875d4afc6fb",
                                        "entry_id": "ec52a3d1-9219-3541-8931-4a7714a48758",
                                        "glosses": [
                                            "A slum or shantytown, especially in Brazil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d51b2f2e-70f1-4f6d-a0a1-2ebee462d538",
                                                "sense_id": "1250a207-8160-3453-b957-5875d4afc6fb",
                                                "text": "The favela is now the model for most of the world's cities, as vast numbers of people continue to migrate to them in order to survive."
                                            },
                                            {
                                                "example_id": "4f7b089d-5edb-4856-a5bd-4025dadeb14a",
                                                "sense_id": "1250a207-8160-3453-b957-5875d4afc6fb",
                                                "text": "security forces in November of 2010 stormed one of the city's most notorious favelas, the complex of the Morro do Alemão in the northern zone of the city"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a2d3cc-ddb8-4c76-b861-ad6c33bebd4e",
                        "source_entry_id": "7204f212-e865-300e-8c51-eb7bf12de529",
                        "source_sense_id": "2b949879-0e01-3b23-b3d8-6cb8c8841506",
                        "source_sense_description": "Elendsviertel am Rande südamerikanischer, insbesondere brasilianischer Städte",
                        "target_lang_word": "favela",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favela",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                        "entry_id": "2dcab1fc-84ce-30de-b762-1090697e7b0b",
                                        "glosses": [
                                            "Bidonville brésilien."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25645734-144b-41e0-82a8-e36625b6cb42",
                                                "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                                "text": "Dans la perspective des Jeux olympiques, Rio de Janeiro « pacifie » ses favelas, un euphémisme qui masque la nature ambiguë d’une politique conduite à la pointe du fusil."
                                            },
                                            {
                                                "example_id": "920db013-2266-4662-af57-a7e664e34b27",
                                                "sense_id": "aa8638dd-33ee-3e61-8c36-98ecb4919d1a",
                                                "text": "Le Brésil, où la violence et la corruption règnent en maîtres, réussira-t-il à se distinguer autrement que par le futebol et ses favelas?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3af88cf5-a66d-4f4d-a923-c956180e78ce",
                        "source_entry_id": "7204f212-e865-300e-8c51-eb7bf12de529",
                        "source_sense_id": "2b949879-0e01-3b23-b3d8-6cb8c8841506",
                        "source_sense_description": "Elendsviertel am Rande südamerikanischer, insbesondere brasilianischer Städte",
                        "target_lang_word": "favela",
