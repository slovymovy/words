    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fb13b6fc-7d3e-3e89-b676-a39b28044d58",
                "word": "Brunhild",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0177b57c-903e-3522-b88e-60c4e8122929",
                        "entry_id": "fb13b6fc-7d3e-3e89-b676-a39b28044d58",
                        "glosses": [
                            "A shieldmaiden and valkyrie in Germanic mythology, a main character in the Nibelungenlied, Völsunga saga, and some poems of the Poetic Edda."
                        ],
                        "tags": [
                            "Germanic"
                        ],
                        "examples": [
                            {
                                "example_id": "f29b5041-0629-41ac-95b1-b54a4e5acca4",
                                "sense_id": "0177b57c-903e-3522-b88e-60c4e8122929",
                                "text": "Brunhild is a complex figure, indeed. In Hebbel's trilogy, Brunhild is one of the figures who spans both levels, those of history and myth."
                            },
                            {
                                "example_id": "087595eb-bd31-48fd-9c91-b7d07d9b80aa",
                                "sense_id": "0177b57c-903e-3522-b88e-60c4e8122929",
                                "text": "In manuscripts A and B,^([of the Nibelungenlied]) the smiles of Gunther, Siegfried, and Brunhild are recognized as expressions of power and are greeted with the appropriate responses of retaliation, subjugation, or subjugation followed by retaliation."
                            },
                            {
                                "example_id": "239bd004-b43f-49c7-b00f-28340e542c29",
                                "sense_id": "0177b57c-903e-3522-b88e-60c4e8122929",
                                "text": "Brunhild resembles Minerva in her martial tastes, physical appearance, and wisdom; but her anger and resentment when Sigurd forgets her for Gudrun is like the wrath of Œnone, whom Paris deserts to woo Helen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1475458-9234-3252-b01d-d6a85a8ae8bb",
                        "entry_id": "fb13b6fc-7d3e-3e89-b676-a39b28044d58",
                        "glosses": [
                            "A female given name from German."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8362139a-0f53-3856-b448-44cc38c4a570",
                        "entry_id": "fb13b6fc-7d3e-3e89-b676-a39b28044d58",
                        "glosses": [
                            "A female given name from German.",
                            "Queen Brunhilda of Austrasia, wife of Sigebert I, who later ruled Austrasia and Burgundy as regent."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4429a504-7bb8-4ccf-a469-cb4de9243808",
                                "sense_id": "8362139a-0f53-3856-b448-44cc38c4a570",
                                "text": "Unlike some contemporary queens who converted their husbands to orthodox belief, Brunhild was an Arian Christian who was converted to orthodoxy when she married Sigebert."
                            },
                            {
                                "example_id": "da34190d-c66d-45ad-92f6-825b91c56131",
                                "sense_id": "8362139a-0f53-3856-b448-44cc38c4a570",
                                "text": "One of the rare women who came to great power in the early medieval world was Brunhild, daughter of the Visigothic king Athanagild and reputedly a girl of mesmerising beauty."
                            },
                            {
                                "example_id": "2e50397b-95c3-49bf-a740-f3c2eeedf6bc",
                                "sense_id": "8362139a-0f53-3856-b448-44cc38c4a570",
                                "text": "In the Histories, Brunhild and Fredegund appear as political adversaries and moral opposites. Gregory encouraged his audience to compare the two queens by emphasising their differences. He said nothing bad of Brunhild, yet he accused Fredegund of a great many crimes, including murder, sacrilege, witchcraft and treason."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3bf4f68-dfde-32fc-a9e3-cfd93aacfe02",
                        "entry_id": "fb13b6fc-7d3e-3e89-b676-a39b28044d58",
                        "glosses": [
                            "123 Brunhild, a main belt asteroid, named after the mythological figure."
                        ],
                        "tags": [],
                        "examples": []
                    }
