                        "en": "First person singular present tense of the verb <w>roepen</w>.",
                        "fr": "Première personne du singulier du présent de l'indicatif du verbe roepen (appeler, crier)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звать",
                                "target_lang_sense_clarification": "обращаться голосом"
                            },
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "издавать громкий звук"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to use one's voice to summon or attract attention"
                            },
                            {
