                    {
                        "form_id": "f3322d3a-9821-461e-9e86-ffa5f20cd61b",
                        "entry_id": "4a0ecd90-5eaa-3192-b427-609508c7d7df",
                        "tags": [
                            "feminine"
                        ],
                        "form": "trisaïeule"
