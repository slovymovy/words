                "senses": [
                    {
                        "sense_id": "76a29f3c-35f2-35b6-8136-2606573e52bd",
                        "entry_id": "f799ffc5-8f96-3cb2-bfbb-fd4540ec6c8f",
                        "glosses": [
                            "Surface sur laquelle le peintre applique une couche d'enduit, de peinture ou de vernis."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "1be6ab0b-3b08-48b7-b4b4-419a2927a022",
                                "sense_id": "76a29f3c-35f2-35b6-8136-2606573e52bd",
                                "text": "Chaque outil apporte une autre nature de formes et une autre modulation de la couleur. Et il n’y a pas que les outils, il y a aussi la matière, plus ou moins fluide ou pâteuse, et le subjectile, plus ou moins lisse ou rugueux."
                            },
                            {
                                "example_id": "03b8b460-30f7-4b5c-bf95-2a50a3ffe2f2",
                                "sense_id": "76a29f3c-35f2-35b6-8136-2606573e52bd",
                                "text": "Pour la première couche, le subjectile s'identifie au matériau qui est appelé à recevoir le système de peintures."
                            }
                        ]
                    },
                    {
                        "sense_id": "99d69759-e73a-38ed-b1cd-cf84c047ad99",
                        "entry_id": "f799ffc5-8f96-3cb2-bfbb-fd4540ec6c8f",
                        "glosses": [
                            "Support sur lequel sont appliqués les matériaux de façade des panneaux de signalisation routière rétroréfléchissants ou non."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
