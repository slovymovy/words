                ],
                "senses": [
                    {
                        "sense_id": "d321dbd4-28c2-39f2-8024-92997d84d78d",
                        "entry_id": "f5635f78-021d-32fc-8e1b-d9c733443f57",
                        "glosses": [
                            "osoba potrafiąca mówić bez poruszania ustami, przez co wydaje się, że głos pochodzi od innej osoby lub przedmiotu"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "15b43d87-c069-4ff0-9d55-4245772e5b34",
                                "sense_id": "d321dbd4-28c2-39f2-8024-92997d84d78d",
                                "text": "Brzuchomówcy bardzo często używają rekwizytów, takich jak lalki, z którymi udają rozmowę."
                            },
                            {
                                "example_id": "ec53463e-fe8a-4f97-8e79-83dfd89bb490",
                                "sense_id": "d321dbd4-28c2-39f2-8024-92997d84d78d",
                                "text": "Z zapisów historycznych wynika, że pierwsi brzuchomówcy pojawili się około 2000 lat p.n.e. w Egipcie. Byli kapłanami, którzy strzegli sekretów tej sztuki przed plebsem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9864f401-f4b2-4f4b-95bd-423a8b593a87",
                        "source_entry_id": "f5635f78-021d-32fc-8e1b-d9c733443f57",
                        "source_sense_id": "d321dbd4-28c2-39f2-8024-92997d84d78d",
                        "target_lang_word": "ventriloquist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventriloquist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "132a4b2a-cd7b-3d3f-9477-f8bed8974128",
                                        "entry_id": "cb4cf8e6-a077-34f2-a4ca-5a347183470b",
                                        "glosses": [
                                            "A person, especially an entertainer, who practices ventriloquism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f94aefe-a9ef-4da1-ae32-1bfc3fe798fc",
                                                "sense_id": "132a4b2a-cd7b-3d3f-9477-f8bed8974128",
                                                "text": "Most ridiculous is the discomfiture which attends the opponents of predication, who, like the ventriloquist Eurycles, have the voice that answers them in their own breast."
                                            },
                                            {
                                                "example_id": "18545216-f7ff-4aa0-b5eb-14a78f19a147",
                                                "sense_id": "132a4b2a-cd7b-3d3f-9477-f8bed8974128",
                                                "text": "\"Oh, I am a ventriloquist,\" said the little man. \"I can throw the sound of my voice wherever I wish, so that you thought it was coming out of the Head. […]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
