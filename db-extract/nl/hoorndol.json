                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f39a2ee-271f-4022-b3ae-c231c09b285c",
                                "sense_id": "ffb482e6-4008-32a0-b83b-38718803ce9f",
                                "text": "Politici die na ontslag thuis op de bank zitten met wachtgeld, maken kiezers hoorndol. Beter om het afbreukrisico van politici te compenseren met een regeling voor terugkeer naar de oude werkgever. Stel een ‘burgerschapsverlof’ in, betoogt hoogleraar bestuurskunde Mark Bovens."
                            }
                        ]
                    },
                    {
                        "sense_id": "89646e09-b211-37c4-af95-3485684e39b5",
                        "entry_id": "bf11afcb-58d2-3d08-9cc6-fa7fea9673cd",
                        "glosses": [
                            "helemaal gek door verwarring"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fecaef0-aef5-4e4c-b10b-9daf6ab16271",
                                "sense_id": "89646e09-b211-37c4-af95-3485684e39b5",
                                "text": "Hoorndol worden ze in de zorg van de mededingingsautoriteit. 'Koudwatervrees', zegt Don. 'Doe je huiswerk; er is heel veel mogelijk.'"
                            },
                            {
                                "example_id": "c42627d2-2237-4f5d-8b77-c8677406e2ed",
                                "sense_id": "89646e09-b211-37c4-af95-3485684e39b5",
                                "text": "Jongeman... ik-word-zo-langzamerhand-hoorndol-van-jou!'"
                            }
                        ]
                    }
