                "senses": [
                    {
                        "sense_id": "c4379bad-9ce3-3d90-8415-7a227d4135e3",
                        "entry_id": "e1b182c0-48d4-370c-bc5d-f2ab34087a83",
                        "glosses": [
                            "Abhängigkeit einer Person von Alkohol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb2a505-5fc7-4ebf-a8ed-2b4c30fabcbb",
                                "sense_id": "c4379bad-9ce3-3d90-8415-7a227d4135e3",
                                "text": "„Ein Jahr später heirateten sie, aber nach drei Jahren scheiterte die Ehe an seinen Alkoholproblemen.“"
                            },
                            {
                                "example_id": "8cebb0ef-5a2f-48dd-af86-8aee147a1237",
                                "sense_id": "c4379bad-9ce3-3d90-8415-7a227d4135e3",
                                "text": "„Aber selbst Rollstuhlfahrer können den Führerschein verlieren, wenn es aussieht, als hätten sie ein Alkoholproblem.“"
                            },
                            {
                                "example_id": "216acb38-7587-47c4-b739-8ac9ce13e60b",
                                "sense_id": "c4379bad-9ce3-3d90-8415-7a227d4135e3",
                                "text": "„Umgekehrt erschwert es genau das, das eigene Alkoholproblem zu erkennen: Solange das Trinken den Job nicht beeinträchtigt, können sie ja gar kein Problem haben, argumentieren deshalb viele.“"
                            },
                            {
                                "example_id": "091b299f-ceae-4182-84b3-549167a37860",
                                "sense_id": "c4379bad-9ce3-3d90-8415-7a227d4135e3",
                                "text": "„Nach dem, was Elma so über Halla erfahren hatte, musste sie ein Alkoholproblem gehabt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
