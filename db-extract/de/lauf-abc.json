                ],
                "senses": [
                    {
                        "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                        "entry_id": "81767c87-bb5c-3b06-a108-290a94576c0d",
                        "glosses": [
                            "(meist im Rahmen des Lauftrainings ausgeübte) systematische Abfolge technischer und koordinativer Übungen zur Verbesserung des Laufstils und der Bewegungseffizienz"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b212498e-1354-4115-a626-567161a5fe5b",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Achtung: für Interessierte wird zusätzlich Lauf-ABC angeboten, hierzu treffen wir uns bereits um 18:15 Uhr zum Warmlaufen, ab ca. 18:30 Uhr Lauf-ABC im Stadion, während sich die Anderen warmlaufen, anschließend gemeinsames Intervall-Training auf der Bahn.“"
                            },
                            {
                                "example_id": "4f02a4b9-9753-4b40-a20a-963b64df1aba",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Achtung: heute kein Lauf-ABC vorab, es wird wieder am Donnerstag angeboten!“"
                            },
                            {
                                "example_id": "f5447558-1920-4616-af7d-6ed4f38033f7",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Lauft nach dem Lauf-ABC 20-30 min. im normalen Dauerlauftempo zu einem Anstieg (Hügel, Brücke, Unterführung, …), den ihr 8x rund 80m kraftvoll, technisch-sauber (submaximal) hinaufsprintet.“"
                            },
                            {
                                "example_id": "9ad237b4-fecf-4486-913d-b4f7094bd789",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Um Ihre Füße zu stärken, können Sie spezifische Übungen wie das Lauf-ABC mit Hopserläufen oder Sprungläufen sowie Seilspringen in Ihr Training integrieren.“"
                            },
                            {
                                "example_id": "38f1cdfc-f941-4786-9835-8a15d9cf24aa",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Achten Sie gerade beim Lauf-ABC auf Ihre Körperhaltung und vermeiden Sie Überlastungen, indem Sie in kurzer Zeit zu viel erreichen wollen.“"
                            },
                            {
                                "example_id": "35937572-175a-4abd-bfd8-b6a5dc4c6c85",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Neben dem Radfahren und dem Schwimmen - nach Anleitung durch Charles (bzw. mit Plänen von Alex Richter) - stand zweimal Lauf-ABC am Strand und einmal Stabitraining mit Thomas auf dem Programm.“"
                            },
                            {
                                "example_id": "a4488b3a-99c0-4a73-99e1-b99475cccb48",
                                "sense_id": "7b30828e-a12d-3915-af30-a194da366a01",
                                "text": "„Zur Verbesserung der Lauftechnik lohnt sich das Lauf-ABC ins Training einzubeziehen, zum Beispiel Kniehebeläufe auf Tempo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
