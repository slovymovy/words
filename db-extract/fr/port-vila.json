                "translations": [
                    {
                        "translation_id": "71880adf-7aaa-4889-b87f-180320f22aac",
                        "source_entry_id": "01ecf4f7-fc09-3cf1-9acd-7f2ce2d00476",
                        "target_lang_word": "Port Vila",
