                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для этого механизма нам понадобится винт, у которого <w>правая</w> резьба.",
                            "target_lang_translations": {
