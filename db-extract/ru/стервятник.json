                    {
                        "translation_id": "bb519ec8-96a7-4cec-91ab-c02253e13aac",
                        "source_entry_id": "db4ed83d-97bd-35e0-b953-e987b00ee9a3",
                        "source_sense_description": "стервятник обыкновенный",
                        "target_lang_word": "percnoptère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "percnoptère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "19cf2cf6-f1bf-381c-b77e-131965786397",
                                        "entry_id": "6a904b7a-9824-3001-9916-b2d3ba19185d",
                                        "glosses": [
                                            "Vautour de l’Ancien Monde qui a la face jaune, le bec long, mince et jaune (le bout parfois noir), le plumage blanc sauf pour l’extrémité des ailes qui est noire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63da1ea5-f175-4237-9ad7-13a73e421d04",
                                                "sense_id": "19cf2cf6-f1bf-381c-b77e-131965786397",
                                                "text": "Le percnoptère d’Égypte se nourrit de cadavres d’animaux et de déchets divers ; migrateur, il arrive fin février en France pour se reproduire, niche en moyenne montagne dans un trou garni de laine et de poils situé dans les parois rocheuses, et repart mi-septembre passer l’hiver en Afrique tropicale."
                                            },
                                            {
                                                "example_id": "7fa82071-1a73-49e3-9865-39f3bd076bc7",
                                                "sense_id": "19cf2cf6-f1bf-381c-b77e-131965786397",
                                                "text": "Des percnoptères hideux et purulents se dandinent lourdement en cherchant quelque dégoûtante pâture."
                                            },
                                            {
                                                "example_id": "c5641ffa-af6f-4993-b0bc-ce873a7d6df5",
                                                "sense_id": "19cf2cf6-f1bf-381c-b77e-131965786397",
                                                "text": "La ligne haute tension d’électricité de Port-Soudan (le principal port du Soudan) sur la mer Rouge vient d’être neutralisée. Depuis sa construction dans les années 1950, cette ligne est connue pour être la cause de mortalité de centaines, voire de milliers de Vautours percnoptères Neophron percnopterus, espèce en voie de disparition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
