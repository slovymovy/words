{
    "word_family": [
        "disputable",
        "disputation",
        "disputatious",
        "disputant",
        "undisputed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f83c5e6e-f584-3681-abfb-f7a210e24da5",
                    "sense_definition": "to argue against a claim or proposal; to discuss the pros and cons of something",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "argue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local residents decided to <w>dispute</w> the proposal because it lacked scientific evidence.",
                            "target_lang_translations": {
                                "ru": "Местные жители решили <w>оспорить</w> это предложение, так как в нем отсутствовали научные доказательства."
                            }
                        },
                        {
                            "text": "It is difficult to <w>dispute</w> the facts when they are presented so clearly.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>оспаривать</w> факты, когда они представлены так ясно."
                            }
                        }
                    ],
                    "synonyms": [
                        "debate",
                        "discuss",
                        "wrangle"
                    ],
                    "common_phrases": [
                        "dispute the proposal",
                        "dispute the facts"
                    ],
                    "target_lang_definitions": {
                        "ru": "оспаривать утверждение или предложение; обсуждать плюсы и минусы чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "выступать против предложения или заявления"
                            },
                            {
                                "target_lang_word": "дискутировать",
                                "target_lang_sense_clarification": "обсуждать различные точки зрения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f9ae66a-3181-3a23-bcb6-3e70faf32b30",
                    "sense_definition": "to question the truth or validity of a statement or authority",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "argue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer began to <w>dispute</w> the validity of the witness's testimony during the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат начал <w>оспаривать</w> достоверность показаний свидетеля во время судебного процесса."
                            }
                        },
                        {
                            "text": "Few people would <w>dispute</w> the claim that education is essential for success.",
                            "target_lang_translations": {
                                "ru": "Мало кто стал бы <w>подвергать сомнению</w> утверждение о том, что образование необходимо для успеха."
                            }
                        }
                    ],
                    "synonyms": [
                        "challenge",
                        "contest",
                        "deny",
                        "question"
                    ],
                    "common_phrases": [
                        "dispute the claim",
                        "dispute the validity"
                    ],
                    "target_lang_definitions": {
                        "ru": "ставить под сомнение истинность или законность заявления или авторитета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "подвергать сомнению достоверность или законность"
                            },
                            {
                                "target_lang_word": "подвергать сомнению",
                                "target_lang_sense_clarification": "выражать недоверие к факту или праву"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d76cab59-24b7-3afb-9a32-7875aa25390e",
                    "sense_definition": "to fight or compete for control of something, such as territory",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two armies continued to <w>dispute</w> the territory for several months.",
                            "target_lang_translations": {
                                "ru": "Две армии продолжали <w>оспаривать</w> территорию в течение нескольких месяцев."
                            }
                        },
                        {
                            "text": "They had to <w>dispute</w> every inch of ground during the difficult retreat.",
                            "target_lang_translations": {
                                "ru": "Им приходилось <w>отвоевывать</w> каждый дюйм земли во время трудного отступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "contest",
                        "fight"
                    ],
                    "common_phrases": [
                        "dispute the territory",
                        "dispute the ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "сражаться или соревноваться за контроль над чем-либо, например, территорией"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "бороться за обладание чем-либо"
                            },
                            {
                                "target_lang_word": "вести спор",
                                "target_lang_sense_clarification": "вступать в борьбу за территорию или позицию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b120a2c6-c238-305a-883a-6003400ae47d",
                    "sense_definition": "to resist or struggle against a feeling or situation",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>dispute</w> his grief by focusing entirely on his work.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>бороться</w> со своим горем, полностью сосредоточившись на работе."
                            }
                        },
                        {
                            "text": "You must learn to <w>dispute</w> it like a man and move forward.",
                            "target_lang_translations": {
                                "ru": "Ты должен научиться <w>противостоять</w> этому как мужчина и двигаться дальше."
                            }
                        }
                    ],
                    "synonyms": [
                        "resist",
                        "oppose"
                    ],
                    "common_phrases": [
                        "dispute the grief"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сопротивляться или бороться с чувством или ситуацией"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "противостоять внутреннему чувству или горю"
                            },
                            {
                                "target_lang_word": "сопротивляться",
                                "target_lang_sense_clarification": "не поддаваться обстоятельствам"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f870b4fb-daff-3383-80e6-8898140c6929",
                    "sense_definition": "an argument or disagreement, especially an official one between organizations or countries",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long-running labor <w>dispute</w> finally ended after a week of intense negotiations.",
                            "target_lang_translations": {
                                "ru": "Затянувшийся трудовой <w>спор</w> наконец завершился после недели напряженных переговоров."
                            }
                        },
                        {
                            "text": "The two nations are currently involved in a bitter territorial <w>dispute</w>.",
                            "target_lang_translations": {
                                "ru": "В настоящее время две страны вовлечены в ожесточенный территориальный <w>конфликт</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disagreement",
                        "conflict",
                        "controversy",
                        "quarrel"
                    ],
                    "antonyms": [
                        "agreement",
                        "accord",
                        "resolution",
                        "harmony"
                    ],
                    "common_phrases": [
                        "labor dispute",
                        "territorial dispute",
                        "legal dispute"
                    ],
                    "target_lang_definitions": {
                        "ru": "аргументированное разногласие, особенно официальное между организациями или странами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "официальное или юридическое разногласие"
                            },
                            {
                                "target_lang_word": "конфликт",
                                "target_lang_sense_clarification": "серьезное столкновение интересов"
                            },
                            {
                                "target_lang_word": "тяжба",
                                "target_lang_sense_clarification": "длительный правовой спор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2697075-8d6a-3675-a1d2-d5d84c2c2b6d",
                    "sense_definition": "a verbal controversy or heated debate between individuals",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholars were often found in profound <w>dispute</w> over minor historical details.",
                            "target_lang_translations": {
                                "ru": "Ученых часто заставали за глубоким <w>спором</w> по поводу незначительных исторических деталей."
                            }
                        },
                        {
                            "text": "A sudden <w>dispute</w> broke out between the neighbors regarding the fence.",
                            "target_lang_translations": {
                                "ru": "Между соседями внезапно вспыхнула <w>ссора</w> из-за забора."
                            }
                        }
                    ],
                    "synonyms": [
                        "altercation",
                        "debate",
                        "wrangle",
                        "spat"
                    ],
                    "antonyms": [
                        "concord",
                        "union",
                        "assent"
                    ],
                    "common_phrases": [
                        "profound dispute",
                        "bitter dispute"
                    ],
                    "target_lang_definitions": {
                        "ru": "словесная полемика или жаркий спор между людьми"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спор",
                                "target_lang_sense_clarification": "словесное состязание или обсуждение"
                            },
                            {
                                "target_lang_word": "диспут",
                                "target_lang_sense_clarification": "публичное обсуждение или научный спор"
                            },
                            {
                                "target_lang_word": "полемика",
                                "target_lang_sense_clarification": "книжный или научный спор"
                            },
                            {
                                "target_lang_word": "ссора",
                                "target_lang_sense_clarification": "резкое ухудшение отношений, перепалка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}