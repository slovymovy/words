                    {
                        "translation_id": "6655e6c5-6d53-4624-8a8b-f7a7b9e4876a",
                        "source_entry_id": "5f5272c4-a35b-336a-b508-2cb5921c768c",
                        "source_sense_id": "17d157ad-7520-3bc6-826a-709c5e53b9c9",
                        "target_lang_word": "good afternoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "good afternoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448bdd47-8515-3c9d-89fe-c6efd6f1fc56",
                                        "entry_id": "ab839eb4-da4a-3976-9d6f-e7da73fad6c2",
                                        "glosses": [
                                            "A greeting or farewell said in the afternoon."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd23618-e9a9-4960-ad34-852aa13f968a",
                                                "sense_id": "448bdd47-8515-3c9d-89fe-c6efd6f1fc56",
                                                "text": "Good afternoon everyone and thank you for coming to our special meeting today."
                                            },
                                            {
                                                "example_id": "8bb9b5f3-cfc9-462e-a297-4f462d10e81b",
                                                "sense_id": "448bdd47-8515-3c9d-89fe-c6efd6f1fc56",
                                                "text": "Jeeves: Good afternoon, madam.\nLandlady: Don't you good afternoon me. I'm a respectable woman.\nJeeves: I have no reason to doubt it, madam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3c25f46-6ff0-4ae1-a682-34e1988b11cc",
                        "source_entry_id": "5f5272c4-a35b-336a-b508-2cb5921c768c",
                        "source_sense_id": "17d157ad-7520-3bc6-826a-709c5e53b9c9",
                        "target_lang_word": "bonjour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonjour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a97d2140-a369-3955-8ca8-22fbce6312ed",
                                        "entry_id": "23cccf66-1930-37fc-bd99-488cc8e3c373",
                                        "glosses": [
                                            "Formule de salutation utilisée lorsqu’on rencontre quelqu’un."
                                        ],
                                        "tags": [],
                                        "note": "En France, selon le moment de la journée, on utilisera bonjour ou bonsoir. En revanche, bonjour est utilisé dans les deux cas au Québec",
                                        "examples": [
                                            {
                                                "example_id": "89a8a802-c5e7-441c-a6da-0a1dc2999dba",
                                                "sense_id": "a97d2140-a369-3955-8ca8-22fbce6312ed",
                                                "text": "Bonjour, monsieur le Président."
                                            },
                                            {
                                                "example_id": "df1490c9-32f6-4c27-ad38-b316bd228e24",
                                                "sense_id": "a97d2140-a369-3955-8ca8-22fbce6312ed",
                                                "text": "Bonjour, mon ami."
                                            },
                                            {
                                                "example_id": "52fc2ddc-f5d4-4691-9a0a-355424e396c8",
                                                "sense_id": "a97d2140-a369-3955-8ca8-22fbce6312ed",
                                                "text": "Cependant la prairie s’était peuplée. D’un pré à l’autre, on disait : « Bonjour » ou « Beau temps » ; c’était tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40d3d2e3-f5b4-3645-834c-cd8f904c51eb",
                                        "entry_id": "23cccf66-1930-37fc-bd99-488cc8e3c373",
                                        "glosses": [
                                            "Formulation de salutation utilisée lorsqu’on quitte quelqu’un dans la journée comme on dirait bonne journée, ou la nuit bonsoir, bonne soirée."
                                        ],
                                        "tags": [],
                                        "note": "Emploi courant au Québec mais devenu très rare en France, quoique consigné dans le Trésor de la langue française ou le Grand Larousse de la langue française",
                                        "examples": [
                                            {
                                                "example_id": "6656ef3d-3261-45cd-8a43-5642b356ddb1",
                                                "sense_id": "40d3d2e3-f5b4-3645-834c-cd8f904c51eb",
                                                "text": "S’élançant vivement dans la voiture, il prit les rênes, donnant à Pierre à peine le temps de se placer près de lui, et lança le cheval au grand trot.\n– Bonjour, monsieur Charles !\n– Adieu, mes enfants !\n– Bonjour, monsieur Pierre !\n– Bon voyage ! bonne santé !\n– Que le bon Dieu vous conduise !"
                                            },
                                            {
                                                "example_id": "f8e76ce4-683b-463f-8b3c-9a7e5e5bb76d",
                                                "sense_id": "40d3d2e3-f5b4-3645-834c-cd8f904c51eb",
                                                "text": "Bien le bonjour !"
                                            },
                                            {
                                                "example_id": "358edcbf-1d5b-427b-92ea-1e41b386f47f",
                                                "sense_id": "40d3d2e3-f5b4-3645-834c-cd8f904c51eb",
                                                "text": "Bonjour, Germain ; j’emmène Petit-Pierre afin de vous forcer d’aller à Fourche. C’est un gage que je vous garde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706270c8-6e4c-3ac2-863b-eefe995c9db3",
                                        "entry_id": "23cccf66-1930-37fc-bd99-488cc8e3c373",
                                        "glosses": [
                                            "Interjection marquant une réticence, un refus, un jugement de médiocrité."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba252379-9054-451a-af03-f8b11f532e76",
                                                "sense_id": "706270c8-6e4c-3ac2-863b-eefe995c9db3",
                                                "text": "Un verre ça va, trois verres, bonjour les dégâts."
                                            },
                                            {
                                                "example_id": "b991aa69-3f10-45ea-9132-f15d7d1ad9b0",
                                                "sense_id": "706270c8-6e4c-3ac2-863b-eefe995c9db3",
                                                "text": "Une fois, à une exécution, je m’approche d’une fille. Pour rigoler, je lui fais : « Vous êtes de la famille du pendu ? »… C’était sa sœur. Bonjour l’approche !"
                                            },
                                            {
                                                "example_id": "5b133715-b804-4691-af9d-876f0985c32f",
                                                "sense_id": "706270c8-6e4c-3ac2-863b-eefe995c9db3",
                                                "text": "Tu as tort, disait-elle, elle va s'y habituer, et après, bonjour !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "766e6c35-21cb-3dcd-b0ad-87001e573e4c",
                                        "entry_id": "23cccf66-1930-37fc-bd99-488cc8e3c373",
                                        "glosses": [
                                            "Formule de politesse utilisée lorsqu’on quitte quelqu’un au téléphone :"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50192525-03f9-3704-bc09-e03cbe222bcb",
                                        "entry_id": "23cccf66-1930-37fc-bd99-488cc8e3c373",
                                        "glosses": [
                                            "Formule de politesse utilisée lorsqu’on quitte quelqu’un au téléphone :",
                                            "Par formalisme, à la place de au revoir, puisque l’on ne peut pas voir son interlocuteur au téléphone ou que l’on ne l’a jamais rencontré ; ou éventuellement, pour signifier à son interlocuteur que l’on n’a pas envie de le revoir, alors qu’il s’attendait à la formule courante au revoir."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bonjour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e87b1e0-358c-370f-a0bf-627ce43e28e8",
                                        "entry_id": "96343d3f-f6bb-39ab-a7f6-bf8de2caa4b9",
                                        "glosses": [
                                            "Salutation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9910e9a2-881e-4ab6-935a-7dcd6a830452",
                                                "sense_id": "7e87b1e0-358c-370f-a0bf-627ce43e28e8",
                                                "text": "Que le soleil est beau quand tout frais il se lève,\nComme une explosion nous lançant son bonjour !\n— Bienheureux celui-là qui peut avec amour\nSaluer son coucher plus glorieux qu’un rêve !"
                                            },
                                            {
                                                "example_id": "0fd915f6-1de9-47f2-8b81-1175aa502260",
                                                "sense_id": "7e87b1e0-358c-370f-a0bf-627ce43e28e8",
                                                "text": "Tu passeras le bonjour à ta mère."
                                            },
                                            {
                                                "example_id": "17e5430d-4a95-417a-807d-57656dd919ec",
                                                "sense_id": "7e87b1e0-358c-370f-a0bf-627ce43e28e8",
                                                "text": "des petits garçons m’ont dit le bonjour si doucement qu’il me servira pour des semaines."
                                            },
                                            {
                                                "example_id": "d89be1d0-1d2a-4231-bb88-419b1e642a38",
                                                "sense_id": "7e87b1e0-358c-370f-a0bf-627ce43e28e8",
                                                "text": "« Le bonjour vous va, Philibert. On me disait que vous étiez malade, mais vous avez bon air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
