                "senses": [
                    {
                        "sense_id": "8b95e168-898e-3f2b-8581-daf7debd2368",
                        "entry_id": "453074a6-1d9f-3286-8d1b-4859ac9f60fa",
                        "glosses": [
                            "Charger en carbonates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "007fbca2-d61f-4f7d-b7db-187762802eb8",
                                "sense_id": "8b95e168-898e-3f2b-8581-daf7debd2368",
                                "text": "Le mécanisme Snap-Lock facile à utiliser permet de maintenir en place la bouteille à carbonatiser d'une simple pression d'un bouton."
                            },
                            {
                                "example_id": "df5724ae-66c2-4214-8b4e-32f24365aafe",
                                "sense_id": "8b95e168-898e-3f2b-8581-daf7debd2368",
                                "text": "Il est conseillé de laisser les sols liés au ciment durcir voire carbonatiser pendant au moins 3 à 4 semaines afin d'obtenir la résistance exigée."
                            },
                            {
                                "example_id": "f71121af-6d91-4be2-8691-a115ee7af398",
                                "sense_id": "8b95e168-898e-3f2b-8581-daf7debd2368",
                                "text": "Les fissures peuvent carbonatiser relativement vite et les chlorides peuvent pénétrer facilement."
                            },
                            {
                                "example_id": "d6062170-1252-44e3-8e96-460cdade76f8",
                                "sense_id": "8b95e168-898e-3f2b-8581-daf7debd2368",
                                "text": "Les principaux centres d'émission de CO₂, recensés par Bonijoly et al. (2003), bien qu’incomplets, ont également été injectés dans un mini SIG sous ArcMap, permettant de mettre en évidence la non-cohérence entre la distribution géographique des centres d’émission CO₂ et les occurrences de roches susceptibles de se carbonatiser."
                            }
                        ]
                    }
