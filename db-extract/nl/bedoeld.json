                "senses": [
                    {
                        "sense_id": "cd716cb3-01c5-3deb-bd70-3d2f18c8aa96",
                        "entry_id": "6d74c474-ae6c-3f3d-9398-4d303b35ef72",
                        "glosses": [
                            "voltooid deelwoord van bedoelen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6984fcad-71a2-4967-b392-c66af27f1e2b",
                                "sense_id": "cd716cb3-01c5-3deb-bd70-3d2f18c8aa96",
                                "text": "Er steeg een geluidje op uit de hut, een diepe zucht, en nog een en nog een, en eindelijk begreep Olive wat Teresa had bedoeld, wat ze niet had durven zeggen, bang om haar de naakte waarheid te vertellen, en waarom ze haar hiernaartoe had gestuurd, zodat ze het met eigen ogen kon zien."
                            },
                            {
                                "example_id": "cc140533-bab6-4a5f-b958-ca7f4c856abd",
                                "sense_id": "cd716cb3-01c5-3deb-bd70-3d2f18c8aa96",
                                "text": "Over deze demonische stenen koppen valt niet meer te zeggen dan dat ze ooit bedoeld waren om boze geesten af te weren die al dan niet uit de Seine tevoorschijn schoten, eerst een misleidende damp die langzaam maar zeker een gedaante aanneemt: eerst de benen, dan de romp, dan het hoofd waar geen enkel zintuiglijk orgaan aan valt af te zien maar waar wel een weerzinwekkend gesmak van klinkt."
                            }
                        ]
                    }
