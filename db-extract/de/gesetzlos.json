                                        "sense_id": "f2d8c943-12a1-3623-805e-baa9e251e35b",
                                        "entry_id": "e313af54-858e-3e15-a3e6-e7310cdf1d2a",
                                        "glosses": [
                                            "Prohibited by law; unlawful, illegal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c4f9a7d-eabd-42e9-af79-d5f674b33e71",
                                                "sense_id": "f2d8c943-12a1-3623-805e-baa9e251e35b",
                                                "text": "This countrey ſwarmes with vile outragious men,\nThat liue by rapine and by lawleſſe ſpoile,\nFit ſouldiers for the wicked Tamburlaine."
                                            },
                                            {
                                                "example_id": "2b9cedb8-a3d9-4c4a-80e9-229f862459cc",
                                                "sense_id": "f2d8c943-12a1-3623-805e-baa9e251e35b",
                                                "text": "For ſure the Gods / Are not devoid of wiſdom, but perceive / What oaths are lawleſs and by force extorted."
                                            },
                                            {
                                                "example_id": "67a6e69c-0a96-4ec8-92fc-e99d508ec3e8",
                                                "sense_id": "f2d8c943-12a1-3623-805e-baa9e251e35b",
                                                "text": "“We’re in a moment in this country where transgender people in this country are under attack in lawless ways,” said Chase Strangio, an attorney with the American Civil Liberties Union who represented transgender teens at the high court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377c0f82-5ee7-318b-8bbc-b8f6c2f9c36f",
                                        "entry_id": "e313af54-858e-3e15-a3e6-e7310cdf1d2a",
                                        "glosses": [
                                            "Not restrained by the law or by discipline; disorderly, unruly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe9da7e-1dfe-4579-9c94-c41b193cd760",
                                                "sense_id": "377c0f82-5ee7-318b-8bbc-b8f6c2f9c36f",
                                                "text": "On why leaving lawless places and leaving pseudovirtuous groups is loving such places and groups"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
