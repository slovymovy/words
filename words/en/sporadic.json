{
    "word_family": [
        "sporadically",
        "sporadicity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f8c9fcbd-bbe7-3f11-9ff8-340ab8f639d3",
                    "sense_definition": "Rare and scattered in occurrence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team showed only <w>sporadic</w> moments of brilliance during the long match.",
                            "target_lang_translations": {
                                "zh": "在那场漫长的比赛中，该队只展现出<w>零星</w>的闪光时刻。"
                            }
                        },
                        {
                            "text": "There was <w>sporadic</w> gunfire throughout the night in the distant city.",
                            "target_lang_translations": {
                                "zh": "远处的城市整夜都有<w>零星</w>的枪声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intermittent",
                        "occasional",
                        "infrequent"
                    ],
                    "antonyms": [
                        "frequent",
                        "constant",
                        "continuous"
                    ],
                    "common_phrases": [
                        "sporadic moments",
                        "sporadic gunfire",
                        "sporadic rain"
                    ],
                    "target_lang_definitions": {
                        "zh": "指发生频率低且分布零散的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "零星的",
                                "target_lang_sense_clarification": "形容事物零散、不集中。"
                            },
                            {
                                "target_lang_word": "断断续续的",
                                "target_lang_sense_clarification": "形容时有时无，不连续。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb30590a-7c4b-3fc2-8a61-93bd9a449cd4",
                    "sense_definition": "Exhibiting random behavior; patternless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer system experienced <w>sporadic</w> errors that were difficult to diagnose.",
                            "target_lang_translations": {
                                "zh": "计算机系统出现了难以诊断的<w>不规律</w>错误。"
                            }
                        },
                        {
                            "text": "He made <w>sporadic</w> attempts to fix the broken machine without a clear plan.",
                            "target_lang_translations": {
                                "zh": "他没有明确的计划，只是<w>断断续续</w>地尝试修理那台坏掉的机器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "erratic",
                        "random",
                        "irregular"
                    ],
                    "antonyms": [
                        "consistent",
                        "regular"
                    ],
                    "common_phrases": [
                        "sporadic errors",
                        "sporadic attempts"
                    ],
                    "target_lang_definitions": {
                        "zh": "指行为随机、缺乏规律的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不规律的",
                                "target_lang_sense_clarification": "形容缺乏固定模式或节奏。"
                            },
                            {
                                "target_lang_word": "无规律的",
                                "target_lang_sense_clarification": "强调完全没有可循的模式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b2b954e-dc7f-37e8-8e65-3e3a35dbbbca",
                    "sense_definition": "Occurring in isolated instances rather than as a widespread epidemic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor reported a <w>sporadic</w> case of the virus in the local community.",
                            "target_lang_translations": {
                                "zh": "医生报告了当地社区出现的一例<w>散发</w>性病毒病例。"
                            }
                        },
                        {
                            "text": "Health officials confirmed that the infection remains <w>sporadic</w> and is not spreading rapidly.",
                            "target_lang_translations": {
                                "zh": "卫生官员证实，该感染仍处于<w>散发</w>状态，并未迅速蔓延。"
                            }
                        }
                    ],
                    "synonyms": [
                        "isolated",
                        "scattered"
                    ],
                    "antonyms": [
                        "epidemic",
                        "widespread"
                    ],
                    "common_phrases": [
                        "sporadic case",
                        "sporadic infection"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在医学上表现为孤立的、非流行性的病例。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "散发的",
                                "target_lang_sense_clarification": "医学术语，指病例零星出现，未形成流行。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb471d55-63f2-3c57-9817-108bcb29cf62",
                    "sense_definition": "Not belonging to any infinite family; an exception to an otherwise orderly classification.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In group theory, the monster group is a famous <w>sporadic</w> group.",
                            "target_lang_translations": {
                                "zh": "在群论中，魔群是一个著名的<w>孤立</w>群。"
                            }
                        },
                        {
                            "text": "The researcher identified a <w>sporadic</w> element that did not fit the established periodic pattern.",
                            "target_lang_translations": {
                                "zh": "研究人员发现了一个不符合既定周期规律的<w>例外</w>元素。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exceptional",
                        "anomalous"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不属于任何特定分类体系的例外情况。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "孤立的",
                                "target_lang_sense_clarification": "指不属于任何已知类别的特殊个体。"
                            },
                            {
                                "target_lang_word": "例外的",
                                "target_lang_sense_clarification": "指不符合常规分类的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}