                    {
                        "sense_id": "c5ead7e0-1e4d-378a-80fd-ff549d436023",
                        "entry_id": "c1aff59a-f355-3d57-b7eb-f2fe2253e23b",
                        "glosses": [
                            "schlechtes, minderwertiges Auto"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "57d5988c-30a0-4d82-91df-3254c79e5e97",
                                "sense_id": "c5ead7e0-1e4d-378a-80fd-ff549d436023",
                                "text": "„Eines stand auf jeden Fall fest: wenn er mir einen Wagen geliehen hätte, dann wäre es eine Scheißkarre gewesen und außerdem geklaut.“"
                            },
                            {
                                "example_id": "89f190d6-300c-40fa-a47b-4af32f446fd0",
                                "sense_id": "c5ead7e0-1e4d-378a-80fd-ff549d436023",
                                "text": "„Die Scheißkarre brennt ja.“"
                            },
                            {
                                "example_id": "3cecf92e-075a-4889-99e0-b396c9905853",
                                "sense_id": "c5ead7e0-1e4d-378a-80fd-ff549d436023",
                                "text": "„Aber sie konnten den Autodefibrillator so oft ansetzen, wie sie wollten, die Scheißkarre sprang einfach nicht an; zudem verspürten weder meine Eltern noch ich den Wunsch, in die von ausgewürgten Körperflüssigkeiten verpestete Kiste zurückzusteigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
