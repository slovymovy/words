                    {
                        "sense_id": "2df71198-ecb0-3fc7-8232-362bb137543b",
                        "entry_id": "2d300a1f-fbe6-3bae-a35d-8b6af5fe3f74",
                        "glosses": [
                            "maypole (garlanded pole put up for May Day, e.g. on a village square)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e560201e-bf71-4ecb-8475-0b44b3300987",
                                "sense_id": "2df71198-ecb0-3fc7-8232-362bb137543b",
                                "text": "Sie kannte die Tradition, dass junge Männer in ihre Nachbardörfer schleichen und dort Maibäume stehlen. Mitgemacht hatte sie nie. Sie wusste auch nicht so genau, warum Menschen überhaupt Bäume anmalen und aufstellen […]",
                                "translation": "She knew the tradition that young men sneak into their neighbor villages and steal maypoles there. She had never participated. Also she didn't know very well why people paint end erect trees at all […]",
                                "english": "She knew the tradition that young men sneak into their neighbor villages and steal maypoles there. She had never participated. Also she didn't know very well why people paint end erect trees at all […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "81b6f250-c3c2-3f81-9055-abcf02ea86dd",
                        "entry_id": "2d300a1f-fbe6-3bae-a35d-8b6af5fe3f74",
                        "glosses": [
                            "a garlanded young birch tree that a young man puts up in front of the house of his sweetheart during the night before May Day"
                        ],
                        "tags": [
                            "Rhineland",
                            "masculine",
                            "strong"
