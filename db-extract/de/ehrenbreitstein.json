                ],
                "senses": [
                    {
                        "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                        "entry_id": "887ca2ed-7285-36b3-9416-d68aaea4b374",
                        "glosses": [
                            "ein rechtsrheinischer Stadtteil von Koblenz"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "8a6b6556-9bed-43da-97ed-d8f49a188a7f",
                                "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                                "text": "Die alte Residenzstadt Ehrenbreitstein wurde 1937 nach Koblenz eingemeindet."
                            },
                            {
                                "example_id": "f69a714a-99da-44d9-924c-a40eff25d52f",
                                "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                                "text": "„Schließlich wurde 1937 die selbständige Stadt und das Amt Ehrenbreitstein, zu dem die umliegenden rechtsrheinischen Gemeinden gehörten, durch die Nationalsozialisten zwangseingemeindet und zu einem Stadtteil von Koblenz.“"
                            },
                            {
                                "example_id": "7c76feda-0c10-40cb-bd2e-39c2329cb06b",
                                "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                                "text": "\"Die Verteidigung von Ehrenbreitstein sollte von einer Kompanie des Landes-Pionier-Regiments Nr. 12 durchgeführt werden. Oberfeldwebel Willi Lindner … ein Koblenzer, allgemein bekannt als Mundartdichter und Karnevalist, hatte den Befehl, die Rheinstraße von Ehrenbreitstein nach Urbar mit drei Unteroffizieren, siebzehn Mann, drei Panzerfäusten und zwei leichten Maschinengewehren gegen die amerikanischen Divisionen zu sichern. … Jeglicher Widerstand wäre sinnlos gewesen. Die Verteidiger ergaben sich dem ersten Stoßtrupp, der jedoch nicht weiter in Ehrenbreitstein eindrang."
                            },
                            {
                                "example_id": "936673a5-9bf4-4155-bb50-e883a4055634",
                                "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                                "text": "„Ehrenbreitstein soll im alten Glanz erstehen.“"
                            },
                            {
                                "example_id": "4eb41f58-f47c-40cb-9384-52e7dca790fb",
                                "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                                "text": "„In Ehrenbreitstein setzte uns der Bosch an der Bushaltestelle vorm Bahnhof ab.“"
                            },
                            {
                                "example_id": "c8d72ad0-1fe2-413a-bce5-e21d2faca6bd",
                                "sense_id": "e6050ebc-87be-3dd1-9152-a9a454ce862f",
                                "text": "„Am 7. Mai ist Abfahrt in Erfurt, über Gießen und Wetzlar geht es nach Ehrenbreitstein gegenüber von Koblenz, wo die La Roches leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
