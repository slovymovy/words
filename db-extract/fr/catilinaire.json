                                        "glosses": [
                                            "Pertaining to Catiline, the Roman conspirator who attempted to overthrow the Roman Empire; resembling Catiline's conspiracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ac671f-858b-4b7d-9b8a-5c0d2af3ad38",
                                                "sense_id": "8e2f02ca-487f-30de-af2b-1d7a33a94e83",
                                                "text": "Catilinarian conspiracy"
                                            },
                                            {
                                                "example_id": "80aaa315-b443-4722-a552-b10e3ac28947",
                                                "sense_id": "8e2f02ca-487f-30de-af2b-1d7a33a94e83",
                                                "text": "Catilinarian War"
                                            },
                                            {
                                                "example_id": "6a847860-800f-475f-b8da-cd73c060d701",
                                                "sense_id": "8e2f02ca-487f-30de-af2b-1d7a33a94e83",
                                                "text": "We cannot execrate the conspirators who murdered Cæsar as we would do those who might now plot the death of a tyrant; nor can we deal as heavily with the murderers of Cæsar as we would have done then with Catilinarian conspirators in Rome, had Catiline's conspiracy succeeded."
                                            }
                                        ]
                                    }
                                ]
                            }
