    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "39aeb404-dbc2-3cf2-996c-cab454551fe9",
                    "sense_definition": "Sert à exprimer l'admiration, l'étonnement ou une vive surprise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ouah</w>, ce gâteau au chocolat a l'air vraiment délicieux !"
                        },
                        {
                            "text": "Elle a regardé le paysage depuis le sommet et a dit : <w>ouah</w>, c'est magnifique !"
                        }
                    ],
                    "synonyms": [
                        "waouh",
                        "oh"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "614b7edf-c465-3ba2-b0ce-648c0a05f4f9",
                    "sense_definition": "Imite le cri ou l'aboiement d'un chien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aboiement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit chien aboie joyeusement en faisant <w>ouah</w> quand son maître rentre."
                        },
                        {
                            "text": "L'enfant s'amusait à répéter <w>ouah</w> pour imiter son animal de compagnie."
                        }
                    ],
                    "synonyms": [
