                    {
                        "translation_id": "0c4c0c9c-980a-49b0-8537-a4774a864449",
                        "source_entry_id": "38c90d64-1661-3906-9e25-d00bd8045d88",
                        "source_sense_description": "комар",
                        "target_lang_word": "Mücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56ab75c4-e7a5-3197-bc36-f7fc384d954d",
                                        "entry_id": "ccfa6d3a-3e52-31a5-b9d9-888817fbcc37",
                                        "glosses": [
                                            "kleines zweiflügliges Stechinsekt (Diptera, Unterordnung Nematocera), besonders Stechmücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf88899a-d8a2-4775-b025-ccba5ca46be6",
                                                "sense_id": "56ab75c4-e7a5-3197-bc36-f7fc384d954d",
                                                "text": "Eine Mücke hat mich letzte Nacht gestochen."
                                            },
                                            {
                                                "example_id": "2e3738bd-4480-4921-a386-d103335c2b5d",
                                                "sense_id": "56ab75c4-e7a5-3197-bc36-f7fc384d954d",
                                                "text": "„Bald klebten an meiner Windschutzscheibe innen mehr Mücken als tote Insekten vorne an meinem Kühlergrill.“"
                                            },
                                            {
                                                "example_id": "7ce6dffb-4475-4b63-a7d3-40064e7edea9",
                                                "sense_id": "56ab75c4-e7a5-3197-bc36-f7fc384d954d",
                                                "text": "„Er wunderte sich über den Standort, nahm aber an, die Mücken seien auf dem Wasser weniger lästig als an Land.“"
                                            },
                                            {
                                                "example_id": "0926980d-5f63-4e3c-96e7-cd82b2d33360",
                                                "sense_id": "56ab75c4-e7a5-3197-bc36-f7fc384d954d",
                                                "text": "„Ich habe auch die Insekten und die Fliegen und die Mücken bemerkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ef70cec-4669-3a4d-8955-3bb1c219b8fc",
                                        "entry_id": "ccfa6d3a-3e52-31a5-b9d9-888817fbcc37",
                                        "glosses": [
                                            "kleine oder unwichtige Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2859649-221c-45e3-8e66-bdc0e7fa80c7",
                                                "sense_id": "6ef70cec-4669-3a4d-8955-3bb1c219b8fc",
                                                "text": "Sie nannten ihn Mücke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
