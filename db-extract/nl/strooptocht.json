        "nl-extract.jsonl": [
            {
                "entry_id": "1cc9e345-348f-37d9-bc38-c1b334243e9b",
                "word": "strooptocht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "75328a7f-673b-473c-9847-ed4e1c29e1a3",
                        "entry_id": "1cc9e345-348f-37d9-bc38-c1b334243e9b",
                        "tags": [
                            "plural"
                        ],
                        "form": "strooptochten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9454b81-41e0-3978-8424-9fba2d190e37",
                        "entry_id": "1cc9e345-348f-37d9-bc38-c1b334243e9b",
                        "glosses": [
                            "een tocht die ondernomen wordt om een streek leeg te roven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f25ee8-d463-4d8b-aef8-28348962c8d4",
                                "sense_id": "b9454b81-41e0-3978-8424-9fba2d190e37",
                                "text": "Uit het gescheurde karton kwamen drie kleinere pakjes tevoorschijn. Het eerste herkende Robbie meteen aan de vorm van het vloeipapier, waarmee het was omwikkeld. Het was de zilveren heupflacon die Breukhout tijdens hun strooptochten bij herhaling uit zijn binnenzak viste om een slok whisky te nemen."
                            },
                            {
                                "example_id": "a495a24b-a79a-4511-9bf7-2d7450926f10",
                                "sense_id": "b9454b81-41e0-3978-8424-9fba2d190e37",
                                "text": "Zodra de Duitsers arriveerden, verliet de moeder van oom Arnold van Heek met een koffertje 's nachts het huis. Vanuit de Hooge Boekel werden de strooptochten van de SD in Enschede en omstreken georganiseerd. Het was de verzamelplek van alle spullen die de Duitsers in de wijde omgeving bij elkaar roofden."
                            },
                            {
                                "example_id": "28046fb9-9094-4fc5-8ac9-3c909bfbd2e6",
                                "sense_id": "b9454b81-41e0-3978-8424-9fba2d190e37",
                                "text": "Later werd er nog een verdachte aangehouden die drie jassen van een rek bij een kledingwinkel had gestolen. Een agent spotte de dief en greep direct in. Daarnaast werden er nog twee verdachten aangehouden voor diefstal. Zij werden na een strooptocht van bijna een uur met diverse kledingstukken uit verschillende winkels gepakt. Alle verdachten zijn naar het arrestantencomplex in Borne overgebracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "328a2ec2-a868-3ee1-9f1e-e1c3c0983505",
                        "entry_id": "1cc9e345-348f-37d9-bc38-c1b334243e9b",
                        "glosses": [
                            "tocht die ondernomen wordt om dingen te vinden die men wil hebben"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "610099c6-a866-4885-bfa3-b8980edbff72",
                                "sense_id": "328a2ec2-a868-3ee1-9f1e-e1c3c0983505",
                                "text": "De strooptocht van de fotograaf om het leven te vangen in dat ene ‘beslissende moment’, het motto van Cartier-Bresson, is niet bij iedereen een streefdoel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84e724bb-10ea-4246-9099-24a74cabf266",
                        "source_entry_id": "1cc9e345-348f-37d9-bc38-c1b334243e9b",
                        "source_sense_id": "b9454b81-41e0-3978-8424-9fba2d190e37",
                        "source_sense_description": "rooftocht",
                        "target_lang_word": "raid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "A quick hostile or predatory incursion or invasion in a battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd2c82a-500b-493a-9c12-03e660926dd3",
                                                "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                                                "text": "Marauding chief! his sole delight / The moonlight raid, the morning fight."
                                            },
                                            {
                                                "example_id": "aa179b6f-3f0b-4b34-becd-01ab335adf36",
                                                "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                                                "text": "There are permanent conquests, temporary occupation, and occasional raids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An attack or invasion for the purpose of making arrests, seizing property, or plundering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b21622b0-1367-4cc9-bcab-579bf7158ba1",
                                                "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                                "text": "a police raid of a narcotics factory"
                                            },
                                            {
                                                "example_id": "ea096cae-271a-4bd4-adf4-622402042171",
                                                "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                                "text": "a raid of contractors on the public treasury"
                                            },
                                            {
                                                "example_id": "3c9ebcca-34b5-451a-b7d7-a32eedad3487",
                                                "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                                "text": "For Lothian and Borders Police, the early-morning raid had come at the end one of biggest investigations carried out by the force, which had originally presented a dossier of evidence on the murder of Jodi Jones to the Edinburgh procurator-fiscal, William Gallagher, on 25 November last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5751eb3d-44e4-3d93-a9e2-5d7812897c15",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An attacking movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a08824-5387-4c0f-8be1-9d263bd8b55c",
                                                "sense_id": "5751eb3d-44e4-3d93-a9e2-5d7812897c15",
                                                "text": "The athletic Walker, one of Tottenham's more effective attacking elements with his raids from right-back, made a timely intervention after Rose had been dispossessed and even Aaron Lennon was needed to provide an interception in the danger zone to foil another attempt by the Russians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An activity initiated at or towards the end of a live broadcast by the broadcaster that sends its viewers to a different broadcast, primarily intended to boost the viewership of the receiving broadcaster. This is frequently accompanied by a message in the form of a hashtag that is posted in the broadcast's chat by the viewers."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12510d2c-180e-459b-966f-834670a4d5de",
                                                "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                                                "text": "Now that Twitch is making raids an official part of the platform, however, some streamers think the new feature will make it easier to participate in the positive aspects of raiding."
                                            },
                                            {
                                                "example_id": "e3b36658-0093-4967-a2b4-b32901ee4a26",
                                                "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                                                "text": "Now streamers can use a new feature that lets their viewers join a raid then drive traffic to another streamer with just a click."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c84ab9-8871-3f8c-b42c-3d8bf694b38b",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "A large group in a massively multiplayer online game, consisting of multiple parties who team up to defeat a powerful enemy."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "957eaa73-c868-3143-9ead-f5dd0f243c6b",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An event involving a group of users, often using bots and scripts, who join a server to harm it or harass its members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162d50de-57dd-40cf-8846-da65a97ac668",
                                                "sense_id": "957eaa73-c868-3143-9ead-f5dd0f243c6b",
                                                "text": "I used the tools discord gave me to prevent raids but he somehow knows a bypass, I use bots and they do help prevent it but just having him ping 90 guys once makes people bash me for an entire hour."
                                            },
                                            {
                                                "example_id": "eb81a46a-059f-4604-929a-fefc565af40a",
                                                "sense_id": "957eaa73-c868-3143-9ead-f5dd0f243c6b",
                                                "text": "Raids are a problem on Guilded. I have been in many servers that have been raided by a user with an account gen or even just some users looking to cause trouble and ruin the communities for us [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                        "entry_id": "9dd04e0d-3d2d-3512-aa26-d9d663ffe70d",
                                        "glosses": [
                                            "To engage in a raid against."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a4ecc1-2302-447c-82ce-e8c0c0de8b63",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "The police raided the gambling den."
                                            },
                                            {
                                                "example_id": "4d5c8f8b-dde5-4f5f-a108-ee794e2fab5b",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "The soldiers raided the village and burned it down."
                                            },
                                            {
                                                "example_id": "10478980-3a24-4c84-84c6-1dc1269beb73",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "A group of mobsters raided an art museum and stole a bunch of paintings."
                                            },
                                            {
                                                "example_id": "03685b44-5799-492e-ba7e-7640c6f6a217",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "Someone has been banned from Discord for raiding a server."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d415cfe3-e8d2-300c-a52f-e04ed2ab2866",
                                        "entry_id": "9dd04e0d-3d2d-3512-aa26-d9d663ffe70d",
                                        "glosses": [
                                            "To lure from another; to entice away from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26ee00d4-79d4-31d6-bce8-eff2ad6f5a58",
                                        "entry_id": "9dd04e0d-3d2d-3512-aa26-d9d663ffe70d",
                                        "glosses": [
                                            "To indulge oneself by taking from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900c6a50-347c-4c7d-a5e1-1be38d103259",
                                                "sense_id": "26ee00d4-79d4-31d6-bce8-eff2ad6f5a58",
                                                "text": "I raided the fridge for snacks."
                                            }
