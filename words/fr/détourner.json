{
    "word_family": [
        "détour",
        "détournement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7818851-8531-37cb-a8ea-64473c3083a5",
                    "sense_definition": "Changer ou faire dévier la trajectoire ou l'itinéraire normal d'une chose, d'un fluide ou d'un moyen de transport.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour protéger le village des inondations, les ouvriers ont dû <w>détourner</w> le cours de la rivière."
                        },
                        {
                            "text": "En raison de la tempête, la compagnie a décidé de <w>détourner</w> le vol vers un autre aéroport."
                        }
                    ],
                    "synonyms": [
                        "dévier",
                        "réorienter"
                    ],
                    "antonyms": [
                        "maintenir"
                    ],
                    "common_phrases": [
                        "détourner la circulation",
                        "détourner un vol",
                        "détourner le cours"
                    ]
                },
                {
                    "sense_id": "8036a60d-ca40-3852-bfc9-1711d8142c72",
                    "sense_definition": "Diriger ses yeux ou sa vue ailleurs pour ne pas voir quelque chose de gênant ou de pénible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à cette scène particulièrement gênante, il a immédiatement préféré <w>détourner</w> le regard."
                        },
                        {
                            "text": "Elle a essayé de ne pas <w>détourner</w> les yeux pendant qu'il lui parlait franchement."
                        }
                    ],
                    "synonyms": [
                        "baisser",
                        "fuir"
                    ],
                    "antonyms": [
                        "fixer"
                    ],
                    "common_phrases": [
                        "détourner le regard",
                        "détourner les yeux"
                    ]
                },
                {
                    "sense_id": "93898e62-20ff-397c-87e3-e9485cef3297",
                    "sense_definition": "Écarter la concentration ou l'esprit de quelqu'un de ce qui l'occupait ; distraire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bruit soudain dans le couloir a suffi à <w>détourner</w> mon attention pendant l'épreuve."
                        },
                        {
                            "text": "Les enfants inventent souvent des histoires amusantes pour <w>détourner</w> l'attention de leurs parents."
                        }
                    ],
                    "synonyms": [
                        "déconcentrer",
                        "distraire"
                    ],
                    "antonyms": [
                        "concentrer",
                        "focaliser"
                    ],
                    "common_phrases": [
                        "détourner l'attention"
                    ]
                },
                {
                    "sense_id": "01ecfb67-0384-337e-a343-42d7c9e6bfc6",
                    "sense_definition": "S'approprier illicitement des fonds, des biens ou des ressources confiés pour un autre usage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "infraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ancien comptable a été condamné après avoir <w>détourné</w> des fonds publics pendant plusieurs mois."
                        },
                        {
                            "text": "Les enquêteurs cherchent à comprendre comment le suspect a pu <w>détourner</w> de l'argent si facilement."
                        }
                    ],
                    "synonyms": [
                        "dérober",
                        "escroquer",
                        "soustraire"
                    ],
                    "antonyms": [
                        "restituer"
                    ],
                    "common_phrases": [
                        "détourner de l'argent",
                        "détourner des fonds"
                    ]
                },
                {
                    "sense_id": "bbba11e4-678c-38bd-ba2e-95dda0b367ea",
                    "sense_definition": "Prendre de force ou sous la menace le contrôle d'un véhicule de transport, en particulier un aéronef.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "infraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un groupe armé a tenté de <w>détourner</w> un avion reliant deux capitales européennes."
                        },
                        {
                            "text": "L'équipage a gardé son calme pendant que les assaillants menaçaient de <w>détourner</w> l'appareil."
                        }
                    ],
                    "synonyms": [
                        "pirater"
                    ],
                    "common_phrases": [
                        "détourner un avion"
                    ]
                },
                {
                    "sense_id": "0f94c78f-92bf-3c3d-a365-3a6ba4fc4dc2",
                    "sense_definition": "Employer un mot, un objet ou une œuvre dans un but ou un sens différent de son intention première.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette artiste aime <w>détourner</w> un objet du quotidien pour en faire une œuvre satirique."
                        },
                        {
                            "text": "Le publicitaire a choisi de <w>détourner</w> le sens d'un proverbe très populaire pour sa campagne."
                        }
                    ],
                    "synonyms": [
                        "réapproprier",
                        "transformer"
                    ],
                    "common_phrases": [
                        "détourner le sens",
                        "détourner un objet"
                    ]
                },
                {
                    "sense_id": "65ef9494-64bb-32c5-aadc-0482fc6f3c5a",
                    "sense_definition": "Dissuader quelqu'un de poursuivre une idée, une action ou un projet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les nombreuses difficultés, rien ne semblait pouvoir le <w>détourner</w> de sa vocation."
                        },
                        {
                            "text": "Ses amis ont vainement tenté de la <w>détourner</w> de ce projet risqué et coûteux."
                        }
                    ],
                    "synonyms": [
                        "dissuader",
                        "écarter"
                    ],
                    "antonyms": [
                        "encourager",
                        "inciter"
                    ],
                    "common_phrases": [
                        "détourner du droit chemin"
                    ]
                }
            ]
        }
    ]
}