                    {
                        "sense_id": "4ea38d34-0ee1-32f8-913b-e103270bf23d",
                        "entry_id": "59ad8bbe-5e8b-3292-8434-f061fc464704",
                        "glosses": [
                            "zijn ware aard verloren hebbend (en als zodanig afkeurenswaardig)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a668318-dc72-400d-bfa3-a44cd1eb64db",
                                "sense_id": "4ea38d34-0ee1-32f8-913b-e103270bf23d",
                                "text": "De nazi's beschouwden moderne kunst van o.a. Paul Klee als ontaard"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0047ad4d-29cf-4f50-8d52-41f0bbdd3fc8",
                        "source_entry_id": "59ad8bbe-5e8b-3292-8434-f061fc464704",
                        "source_sense_id": "4ea38d34-0ee1-32f8-913b-e103270bf23d",
                        "target_lang_word": "entartet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entartet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22b8e865-f542-390c-a0cf-a592df062211",
                                        "entry_id": "3d978c57-ad89-3ce2-9ad3-1ced0718ef81",
                                        "glosses": [
                                            "von der Norm in negativer Weise abweichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285cce95-4984-47d0-b1e8-4cfc44fd9148",
                                                "sense_id": "22b8e865-f542-390c-a0cf-a592df062211",
                                                "text": "Während der Zeit des Nationalsozialismus wurde jüdische Kunst als entartet abgetan."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cc20496-5403-38cc-aa82-6747b90f4f45",
                                        "entry_id": "3d978c57-ad89-3ce2-9ad3-1ced0718ef81",
                                        "glosses": [
                                            "mehrere Eigenzustände zu einem Eigenwert besitzend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2edd15f-affc-4299-84e8-64b3ce640278",
                                                "sense_id": "4cc20496-5403-38cc-aa82-6747b90f4f45",
                                                "text": "Die Energieniveaus im Wasserstoffatom sind entartet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8488b69b-4b0d-3a3e-b50c-0dd6e838bc1a",
                                        "entry_id": "3d978c57-ad89-3ce2-9ad3-1ced0718ef81",
                                        "glosses": [
                                            "von strukturellen Eigenschaften, die für ein mathematisches Objekt als normal erachtet werden, abweichend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8a2642-c46f-4ddd-823a-ebbabead9da4",
                                                "sense_id": "8488b69b-4b0d-3a3e-b50c-0dd6e838bc1a",
                                                "text": "„Im Falle einer reellwertigen Funktion kann mithilfe der Hesse-Matrix festgestellt werden, ob es sich um einen entarteten kritischen Punkt handelt.“"
                                            },
                                            {
                                                "example_id": "24215020-d051-49fc-a486-33ecc352a328",
                                                "sense_id": "8488b69b-4b0d-3a3e-b50c-0dd6e838bc1a",
                                                "text": "Eine symmetrische Bilinearform auf einem K-Vektorraum V heißt entartet, wenn ein 0 ne u∈V existiert, so dass s(u,v)=0_K für alle v∈V."
                                            },
                                            {
                                                "example_id": "e9774656-1595-42da-96ee-349be4c86f0f",
                                                "sense_id": "8488b69b-4b0d-3a3e-b50c-0dd6e838bc1a",
                                                "text": "„Liegt der Punkt auf dem Umkreis des gleichseitigen Dreiecks, so erhält man ein entartetes Dreieck und die Länge der längsten Verbindungsstrecke entspricht der Summe der Längen der beiden kürzeren Verbindungsstrecken.“"
                                            },
                                            {
                                                "example_id": "3e74b17a-7a73-406e-a98a-81ebb557fe56",
                                                "sense_id": "8488b69b-4b0d-3a3e-b50c-0dd6e838bc1a",
                                                "text": "„Im euklidischen Falle K = 0 kann ein Orthoschem entweder als punktförmig entartetes elliptisches Orthoschem oder als geeignetes Auffangorthoschem eines hyperbolischen asymptotischen Orthoschems bezüglich des Fernpunktes aufgefasst werden, so dass es ausreicht, jeweils nur die elliptischen und hyperbolischen r-dimensionalen Fälle zu untersuchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
