                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Link</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Линк</w> примет вас в своем кабинете сейчас.",
                                "zh": "<w>林克</w>先生现在在办公室见你。"
                            }
                        },
                        {
                            "text": "The <w>Link</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Линк</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>林克</w>一家在这个镇上已经住了好几代人了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Линк",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "林克",
