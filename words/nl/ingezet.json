                    "sense_definition": "Voltooid deelwoord van <w>inzetten</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie heeft extra agenten <w>ingezet</w> tijdens de demonstratie.",
                            "target_lang_translations": {
                                "en": "The police <w>deployed</w> extra officers during the demonstration.",
                                "ru": "Полиция <w>задействовала</w> дополнительных полицейских во время демонстрации.",
                                "pl": "Policja <w>skierowała do akcji</w> dodatkowych funkcjonariuszy podczas demonstracji."
                            }
                        },
                        {
                            "text": "Hij heeft zich jarenlang <w>ingezet</w> voor het goede doel.",
                            "target_lang_translations": {
                                "en": "He <w>dedicated</w> himself to the charity for years.",
                                "ru": "Он годами <w>посвящал себя</w> благотворительности.",
                                "pl": "Przez lata <w>angażował się</w> w działalność charytatywną."
                            }
