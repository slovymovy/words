                "senses": [
                    {
                        "sense_id": "7287e525-505b-3e2b-8161-b24155e82130",
                        "entry_id": "82ab5052-9c42-3649-94d7-ea85181989b5",
                        "glosses": [
                            "Schweiß als Folge von Fieber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f19c85e6-bdac-4331-b087-1a079a5980c3",
                                "sense_id": "7287e525-505b-3e2b-8161-b24155e82130",
                                "text": "„Und während dieser Unterbrechung des Alltags, als ich drei Tage und Nächte in Fieberschweiß gebadet darniederlag, geschah es, dass ich mittels eines visionären Brückenschlags über den trennenden Ozean hinweg abermals Anteil am sonderbaren Reiseweg von Vater Sevich nahm.“"
                            },
                            {
                                "example_id": "9fcbaa77-987c-4ec0-975c-7d1664fb9c51",
                                "sense_id": "7287e525-505b-3e2b-8161-b24155e82130",
                                "text": "„Plötzlich löst sich meine Haut ab, meine Gefäße platzen auf und Blut sickert heraus. Es bedeckt meinen Körper wie Fieberschweiß und läuft mir in den Mund, in den Hals, in die Lunge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
