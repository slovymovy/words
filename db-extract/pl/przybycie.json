                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b281d46-3110-4d64-b016-2df0478ee285",
                        "source_entry_id": "6d0243dd-9492-3d75-8f2e-8931364e7e44",
                        "source_sense_id": "d8d5a8a3-ad76-3ac1-b5bd-02f9854aaf94",
                        "target_lang_word": "прибытие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прибытие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "39aecedf-51d9-3a93-8522-cdb990d6193c",
                                        "entry_id": "36ae90da-4def-3073-b0c2-348bf7df418e",
                                        "glosses": [
                                            "действие по значению гл. прибывать, прибыть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d388d075-db2e-46ec-bac9-e45b79275e0b",
                                                "sense_id": "39aecedf-51d9-3a93-8522-cdb990d6193c",
                                                "text": "Он пришёл прежде меня, и один из поляков описывал мне подробно его прибытие."
                                            },
                                            {
                                                "example_id": "5753d225-4eac-4c8a-9cd2-ebdd7c80ce1c",
                                                "sense_id": "39aecedf-51d9-3a93-8522-cdb990d6193c",
                                                "text": "Хорошо, что вы поспешили своим прибытием, а то Владимир Васильич настоятельно было приказывал послать исполнение о шестом выговоре и о предании вас суду."
                                            },
                                            {
                                                "example_id": "3afe40d9-517f-4d73-bb4f-80a40e8b3d1a",
                                                "sense_id": "39aecedf-51d9-3a93-8522-cdb990d6193c",
                                                "text": "Приезжает и Анфиса Петровна Луковицына с дочерью своей, по муже Симиас, дамой, обладающей лицом аквамаринового цвета. Прибытие их проходит, однако ж, незамеченным."
                                            },
                                            {
                                                "example_id": "6d37b882-cd12-42a4-a36d-da3111a9b290",
                                                "sense_id": "39aecedf-51d9-3a93-8522-cdb990d6193c",
                                                "text": "Услышав о прибытии графа, он проворно пробежал гостиную и, вышедши в залу, остановился невдалеке от дверей из лакейской."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a73e187-7ad2-31aa-9d5c-cba4f8cef185",
                                        "entry_id": "36ae90da-4def-3073-b0c2-348bf7df418e",
                                        "glosses": [
                                            "результат такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12f5091-aa33-4e38-a3cf-98c940be57d1",
                                                "sense_id": "3a73e187-7ad2-31aa-9d5c-cba4f8cef185",
                                                "text": "Я рад прибытию Стефана, Фортуната и Ахаика: они восполнили для меня отсутствие ваше, ибо они мой и ваш дух успокоили. Почитайте таковых."
                                            },
                                            {
                                                "example_id": "9831dfca-c634-495a-8ab8-32e7a0582baa",
                                                "sense_id": "3a73e187-7ad2-31aa-9d5c-cba4f8cef185",
                                                "text": "Прибытие этих незваных и неожиданных гостей наделало много огорчений Софье Николавне."
                                            },
                                            {
                                                "example_id": "013c1fb8-34cc-471a-b9f0-738b94e5a0e0",
                                                "sense_id": "3a73e187-7ad2-31aa-9d5c-cba4f8cef185",
                                                "text": "Вот настоящая цель неожиданного прибытия парохода к нашему берегу."
                                            },
                                            {
                                                "example_id": "52a489d9-bd7c-4df4-b50b-94fc2cef811b",
                                                "sense_id": "3a73e187-7ad2-31aa-9d5c-cba4f8cef185",
                                                "text": "Григорий поставил на пол гусей, которые крикнули с радости и тотчас же оставили на полу знаки своего прибытия, а Настя подошла с своей тарелкой к барину."
                                            },
                                            {
                                                "example_id": "c8d3dafa-a0ec-4732-9de3-d75918ebfde7",
                                                "sense_id": "3a73e187-7ad2-31aa-9d5c-cba4f8cef185",
                                                "text": "Гром был 2-го сентября и 12-го сентября, так же 2 сентября река Мщара разлилась с прибытием воды от дождей, так как бывает весной разлитие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
