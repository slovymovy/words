                        ],
                        "examples": [
                            {
                                "example_id": "1cda41ab-86c7-42dc-96eb-fe820eee96bc",
                                "sense_id": "d772d3c5-2fab-34f8-9321-fe5c4898d022",
                                "text": "Le « Gorille » voyait difficilement un type traficouiller les centraux téléphoniques, où les initiés eux-mêmes s'y perdent."
                            },
                            {
                                "example_id": "3f546b1b-2347-4858-aef8-b9108bcd6e9d",
                                "sense_id": "d772d3c5-2fab-34f8-9321-fe5c4898d022",
                                "text": "Oops à force de traficouiller dans les dossiers ... j'ai dû appuyer sur le bouton \"Reset All\"."
                            },
                            {
                                "example_id": "7b9a1dc6-871b-4dbc-8886-3dee2b8b3afe",
                                "sense_id": "d772d3c5-2fab-34f8-9321-fe5c4898d022",
                                "text": "Elle est faite pour leur OS mais je pense que tu peux la traficouiller pour en faire ce que tu veux ;)."
                            }
                        ]
                    }
