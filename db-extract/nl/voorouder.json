                ],
                "senses": [
                    {
                        "sense_id": "913629be-ee02-3c74-9cac-220516933255",
                        "entry_id": "3dea6e8a-7f29-33b2-925b-b4589d46d665",
                        "glosses": [
                            "iemand van wie men afstamt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1172554e-5f8a-4ebb-bbec-a1bc3c00bf32",
                                "sense_id": "913629be-ee02-3c74-9cac-220516933255",
                                "text": "De familie Van Rechteren Limpurg is al eeuwen verbonden met de Grote Kerk. In de crypte onder de kerk rusten 26 voorouders van de graaf. Sinds 1875 geldt het mausoleum aan de Gravenallee als laatste rustplaats voor overleden leden van de grafelijke familie. Graaf Adolph wordt daar morgen als veertiende familielid bijgezet."
                            },
                            {
                                "example_id": "b416c04d-dd42-4c9c-9311-475113174f67",
                                "sense_id": "913629be-ee02-3c74-9cac-220516933255",
                                "text": "Vanavond werd ik verplicht om naast graaf Bryston plaats te nemen, een pretentieuze blaaskaak die zeer weinig aan het hof is geweest. Hij is de bestuurder van een of ander godverlaten moerasland in het noorden en verkeert blijkbaar in de veronderstelling dat hij, vanwege de loyaliteit van zijn voorouders aan het koningshuis, over de koninklijke familie mag zeggen wat hij wil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fef2ef5-d80e-4cd2-9498-d6567b539739",
                        "source_entry_id": "3dea6e8a-7f29-33b2-925b-b4589d46d665",
                        "source_sense_id": "913629be-ee02-3c74-9cac-220516933255",
                        "source_sense_description": "iemand van wie afgestammen wordt",
                        "target_lang_word": "Vorfahr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorfahr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce20825-2f06-38c4-a825-e112db276afc",
                                        "entry_id": "9ccf4fd3-fffe-3b0b-ade1-d3024eb15db9",
                                        "glosses": [
                                            "Lebewesen männlichen oder weiblichen Geschlechts, von denen ein jüngeres Lebewesen abstammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c17ac9f-ca38-4eda-91bc-a5c8b4ad4496",
                                                "sense_id": "6ce20825-2f06-38c4-a825-e112db276afc",
                                                "text": "Meine Vorfahren stammen aus Hessen."
                                            },
                                            {
                                                "example_id": "97173331-70eb-476e-947e-074278574f94",
                                                "sense_id": "6ce20825-2f06-38c4-a825-e112db276afc",
                                                "text": "„Bereits die älteste Version des Landnahmebuchs nennt rund 400 Pioniere mit Namen, beschreibt bei manchen sogar, woher sie stammen, wer ihre Vorfahren waren und wo genau sie sich auf Island ansiedeln.“"
                                            },
                                            {
                                                "example_id": "8e990cf4-400b-4058-afa1-4313dc938089",
                                                "sense_id": "6ce20825-2f06-38c4-a825-e112db276afc",
                                                "text": "„Ihre Vorfahren wurden brutal dezimiert.“"
                                            },
                                            {
                                                "example_id": "55c4f385-2b20-414b-b830-9c4b2e94c49f",
                                                "sense_id": "6ce20825-2f06-38c4-a825-e112db276afc",
                                                "text": "„Flugpionier Erich Henneberger, dessen Vorfahren aus Randersacker stammten, nahm ein tragisches Ende in der früheren Kolonie Deutsch-Ostafrika. Er starb beim Absturz des Flugzeuges am 15. November 1914, […].“"
                                            },
                                            {
                                                "example_id": "db52cafa-5165-43ba-867f-3b2d6ed0111c",
                                                "sense_id": "6ce20825-2f06-38c4-a825-e112db276afc",
                                                "text": "„Es war nämlich einer der Vorfahren des Marquis, der Graf Hugues de Sade, der am Anfang des 14. Jahrhunderts jene unsterblich gewordene Laura zur Frau nahm, die Petrarca zu seinen schmerzlich-sehnsüchtigen Sonetten inspiriert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03e1cbc8-b63c-4db5-b93e-0e10bcf684f6",
                        "source_entry_id": "3dea6e8a-7f29-33b2-925b-b4589d46d665",
                        "source_sense_id": "913629be-ee02-3c74-9cac-220516933255",
                        "source_sense_description": "iemand van wie afgestammen wordt",
                        "target_lang_word": "ancestor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancestor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a20d92fb-5d7b-3130-b11d-94f1ae6d9ae7",
                                        "entry_id": "d6dcd856-6daa-38d2-9f11-e722ccf113a0",
                                        "glosses": [
                                            "One from whom a person is descended, whether on the father's or mother's side, at any distance of time; a progenitor; a forefather; a forebear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b539c862-9991-4a40-b157-2835d7079546",
                                                "sense_id": "a20d92fb-5d7b-3130-b11d-94f1ae6d9ae7",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine. The machine gun is so much more lethal than the bow and arrow that comparisons are meaningless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a74516a-4b48-330c-b836-40bd7fd5c0c1",
                                        "entry_id": "d6dcd856-6daa-38d2-9f11-e722ccf113a0",
                                        "glosses": [
                                            "An earlier type; a progenitor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "667264d6-3b06-4ef0-9f7a-1957301901f2",
                                                "sense_id": "9a74516a-4b48-330c-b836-40bd7fd5c0c1",
                                                "text": "This fossil animal is regarded as the ancestor of the horse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd37e4b8-40dd-37d1-a86c-243e031d343e",
                                        "entry_id": "d6dcd856-6daa-38d2-9f11-e722ccf113a0",
                                        "glosses": [
                                            "One from whom an estate has descended;—the correlative of heir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5f7e716-fa2b-36d5-b9a4-54deefb73585",
                                        "entry_id": "d6dcd856-6daa-38d2-9f11-e722ccf113a0",
                                        "glosses": [
                                            "One who had the same role or function in former times."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d6947bc-f234-485f-b46f-bf00df5fa94d",
                                                "sense_id": "f5f7e716-fa2b-36d5-b9a4-54deefb73585",
                                                "text": "The Magpies are unbeaten and enjoying their best run since 1994, although few would have thought the class of 2011 would come close to emulating their ancestors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b271bb8-4c62-35da-9359-374eeb041e2a",
                                        "entry_id": "d6dcd856-6daa-38d2-9f11-e722ccf113a0",
                                        "glosses": [
                                            "A word or phrase which serves as the origin of a term in another language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ancestor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93177f7-a6d3-32e6-b7ed-37e85ccf1ba1",
                                        "entry_id": "5676292b-a6f7-35b7-b89d-57d006e5779b",
                                        "glosses": [
                                            "To be an ancestor of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "390511fa-f66a-4e5d-8e6b-7420c52a0e6a",
                                                "sense_id": "e93177f7-a6d3-32e6-b7ed-37e85ccf1ba1",
                                                "text": "Her own grandfather had been a Virginian, a descendant of Pocahontas, of course, Pocahontas having been created by Divine Providence for the specific purpose of ancestoring Virginians."
                                            },
                                            {
                                                "example_id": "8e25735f-5cd7-45a0-877f-11eee9a4365d",
                                                "sense_id": "e93177f7-a6d3-32e6-b7ed-37e85ccf1ba1",
                                                "text": "But he could have completed it: Lucas Quintus Carothers McCaslin Beauchamp. Last surviving sone and child of Tomey's Terrel and Tennie Beauchamp. March 17, 1874 except that there was no need: not Lucius Quintus &c &c &c, but Lucas Quintus, not refusing to be called Lucius, because he simply eliminated that word from the name; not denying, declining the name itself, because he used three quarters of it; but simply taking the name and changing, altering it, making it no longer the white man's but his own , by himself composed, himself selfprogenitive and nominate, by himself ancestored, as, for all the old ledgers recorded to the contrary, old Carothers himself was"
                                            },
                                            {
                                                "example_id": "5cdc69d7-5492-4cf6-b918-9234609ae571",
                                                "sense_id": "e93177f7-a6d3-32e6-b7ed-37e85ccf1ba1",
                                                "text": "The human population of this earth is descended from a most adaptable population, that which originated living matter and then proceeded through continuous specific change to become the population that ancestored man."
                                            },
                                            {
                                                "example_id": "e3196230-d1e2-4c9f-9fa0-ca17d651f40f",
                                                "sense_id": "e93177f7-a6d3-32e6-b7ed-37e85ccf1ba1",
                                                "text": "How, that is, could ancestoring Elizabeth become a relational property of James's, when there was, when Elizabeth began to exist, no James to have this property?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e1ae373-5817-41b8-85a7-a196786a74e7",
                        "source_entry_id": "3dea6e8a-7f29-33b2-925b-b4589d46d665",
                        "source_sense_id": "913629be-ee02-3c74-9cac-220516933255",
                        "source_sense_description": "iemand van wie afgestammen wordt",
                        "target_lang_word": "ancêtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancêtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a92d8e61-54cf-3e62-8504-0e21bcf1d1a3",
                                        "entry_id": "71c3b98a-99c9-3b36-846f-ff6a12a98f89",
                                        "glosses": [
                                            "Celui ou celle de qui l’on descend par son père ou sa mère."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8502cec7-b0e3-4a15-8725-a32d82a3082e",
                                                "sense_id": "a92d8e61-54cf-3e62-8504-0e21bcf1d1a3",
                                                "text": "Le culte de l’ancêtre doit beaucoup à l’intérêt commercial. En se proclamant descendants de l’inventrice du camembert, les petits-enfants de Marie Harel s’attribuaient un label d’authenticité et de tradition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9be8c9f9-fd05-3f84-939a-c96cbaa1c7bf",
                                        "entry_id": "71c3b98a-99c9-3b36-846f-ff6a12a98f89",
                                        "glosses": [
                                            "Ceux qui sont au-dessus du degré de grand-parent."
                                        ],
                                        "tags": [
                                            "Famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f485c413-0496-4ac6-8b99-d76bb62451ea",
                                                "sense_id": "9be8c9f9-fd05-3f84-939a-c96cbaa1c7bf",
                                                "text": "Il faut toujours bien prendre garde que le Juif du Moyen Âge, devenu si résigné, ressemble beaucoup plus au chrétien qu’à ses ancêtres."
                                            },
                                            {
                                                "example_id": "1d862eb1-0b7e-4670-81b8-51553fa14953",
                                                "sense_id": "9be8c9f9-fd05-3f84-939a-c96cbaa1c7bf",
                                                "text": "En apparence, ce turbulent apôtre des lumières fait contraste avec ses ancêtres confits en dévotion et abondants en patenôtres."
                                            },
                                            {
                                                "example_id": "c0c07ef7-040e-469a-b024-beffafc1f314",
                                                "sense_id": "9be8c9f9-fd05-3f84-939a-c96cbaa1c7bf",
                                                "text": "C’est un passe-temps aux veillées de dresser les généalogies et le tableau des fautes, des aventures des ancêtres."
                                            },
                                            {
                                                "example_id": "72510142-d3f4-4151-8911-f79826ee9599",
                                                "sense_id": "9be8c9f9-fd05-3f84-939a-c96cbaa1c7bf",
                                                "text": "Il marche sur les traces de ses ancêtres."
                                            },
                                            {
                                                "example_id": "fb7d47b5-b6cb-4bec-bcb2-5effad547a1c",
                                                "sense_id": "9be8c9f9-fd05-3f84-939a-c96cbaa1c7bf",
                                                "text": "Marguerite sa fille avait, comme toute sa famille, les cheveux très noirs, les traits un peu épais et le teint mat qu’on attribuait à une ancêtre sépharade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72d2bd8f-d2cf-361a-8d8f-d961a57e0e5c",
                                        "entry_id": "71c3b98a-99c9-3b36-846f-ff6a12a98f89",
                                        "glosses": [
                                            "Tous ceux qui nous ont devancés, encore que nous ne soyons pas de leur ethnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1814c700-f495-4544-8f4f-7c3b0413df32",
                                                "sense_id": "72d2bd8f-d2cf-361a-8d8f-d961a57e0e5c",
                                                "text": "A peu de distance de Dinant, en Belgique, dans la vallée de la Lesse, il existe un assez grand nombre de ces grottes qui ont dû servir d’habitation ou de refuge à nos ancêtres ; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e23d445-a7c0-305f-a1ae-cdec1727f1a4",
                                        "entry_id": "71c3b98a-99c9-3b36-846f-ff6a12a98f89",
                                        "glosses": [
                                            "Personne âgée, du troisième âge."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2699ebe3-3d2f-4f49-95d0-84c9e0ac4dda",
                                                "sense_id": "8e23d445-a7c0-305f-a1ae-cdec1727f1a4",
                                                "text": "Il va se calmer l’ancêtre, là, qu’il râle tout le temps ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0409b5c6-fb53-3b38-b6fa-4ae55d5de147",
                                        "entry_id": "71c3b98a-99c9-3b36-846f-ff6a12a98f89",
                                        "glosses": [
                                            "Ce qui a précédé quelque chose d’autre dans l’histoire."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67e01800-4045-496a-9bbb-937b0a48e32d",
                                                "sense_id": "0409b5c6-fb53-3b38-b6fa-4ae55d5de147",
                                                "text": "Le théâtre, c’est un petit peu l’ancêtre du cinéma."
                                            },
                                            {
                                                "example_id": "699df4de-d3af-4c47-890c-ede13b9ffe39",
                                                "sense_id": "0409b5c6-fb53-3b38-b6fa-4ae55d5de147",
                                                "text": "Ces gens étaient les ancêtres de nos Madoff à nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
