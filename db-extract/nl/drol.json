                        "target_lang_word": "Scheiße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheiße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c305eab-8eab-3d97-9534-d48e9ce3bfc1",
                                        "entry_id": "1f3f2639-ed0e-3089-bb5e-336d18526d65",
                                        "glosses": [
                                            "als Schimpfwort beziehungsweise Fluch verwendeter fäkalsprachlicher Ausdruck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8052b9bb-9c03-4a64-b78f-cb1ba8a8f4aa",
                                                "sense_id": "1c305eab-8eab-3d97-9534-d48e9ce3bfc1",
                                                "text": "Scheiße! Habe ich mir doch mit dem Hammer auf den Daumen gehauen!"
                                            },
                                            {
                                                "example_id": "4abca522-edae-4364-9ca8-5ef836458bfb",
                                                "sense_id": "1c305eab-8eab-3d97-9534-d48e9ce3bfc1",
                                                "text": "Oh Scheiße!"
                                            },
                                            {
                                                "example_id": "6915eabe-5f41-4c5f-b040-e1766bc6a92c",
                                                "sense_id": "1c305eab-8eab-3d97-9534-d48e9ce3bfc1",
                                                "text": "Ach du Scheiße!"
                                            },
                                            {
                                                "example_id": "dfc88f26-a666-40e6-bdcd-868d2110699c",
                                                "sense_id": "1c305eab-8eab-3d97-9534-d48e9ce3bfc1",
                                                "text": "Verdammte Scheiße!"
                                            },
                                            {
                                                "example_id": "54b3fd15-3184-4684-b260-bfa037536df5",
                                                "sense_id": "1c305eab-8eab-3d97-9534-d48e9ce3bfc1",
                                                "text": "So'ne Scheiße!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Scheiße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12becdd1-4992-3d85-a7af-dd08607f7cff",
                                        "entry_id": "416a9f97-d2bd-3d2a-9675-411f5593e7b3",
                                        "glosses": [
                                            "meist feste Ausscheidung des Darmes, Kot"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, vulgär"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01b97bd9-e39c-4976-b722-e1d557848864",
                                                "sense_id": "12becdd1-4992-3d85-a7af-dd08607f7cff",
                                                "text": "Die Scheiße stinkt fürchterlich."
                                            },
                                            {
                                                "example_id": "a149ff17-56b8-4c27-bc95-073d42206503",
                                                "sense_id": "12becdd1-4992-3d85-a7af-dd08607f7cff",
                                                "text": "„Und überall liegt Scheiße, man muss eigentlich schweben.“"
                                            },
                                            {
                                                "example_id": "ef2be8c5-86dc-4f1f-84f5-078003976436",
                                                "sense_id": "12becdd1-4992-3d85-a7af-dd08607f7cff",
                                                "text": "„Es hatte alles keinen Zweck, ich streifte die Scheiße vom Schuh, setzte mich wieder in den Sattel und begann die Abfahrt.“"
                                            },
                                            {
                                                "example_id": "99d062db-21f9-46bb-afb0-b831af569be5",
                                                "sense_id": "12becdd1-4992-3d85-a7af-dd08607f7cff",
                                                "text": "„Ich hatte plötzlich am linken Handballen ein wenig Scheiße.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f9424c2-dcf7-30a7-80fb-c1f7559a16a7",
                                        "entry_id": "416a9f97-d2bd-3d2a-9675-411f5593e7b3",
                                        "glosses": [
                                            "etwas Schlechtes, Wertloses, Unsinniges Schwierigkeiten"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, vulgär",
                                            "oder auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67763d77-ace5-433d-a036-c2fea165ea1e",
                                                "sense_id": "2f9424c2-dcf7-30a7-80fb-c1f7559a16a7",
                                                "text": "Das Gerät war schon nach 2 Wochen kaputt. Da habe ich wirklich Scheiße gekauft!"
                                            },
                                            {
                                                "example_id": "06149573-1011-42d2-8f85-96abcda11eab",
                                                "sense_id": "2f9424c2-dcf7-30a7-80fb-c1f7559a16a7",
                                                "text": "So eine Scheiße hör ich mir nicht länger an!"
                                            },
                                            {
                                                "example_id": "5e24fc19-c8e3-465e-a9aa-89d6978f92e6",
                                                "sense_id": "2f9424c2-dcf7-30a7-80fb-c1f7559a16a7",
                                                "text": "Gestern ist nur Scheiße passiert!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41528be9-27ac-40dd-9b43-8fe7fa74cdcd",
                        "source_entry_id": "d13119ea-0be9-35c4-85a7-7daab012d838",
                        "source_sense_id": "f695f66e-4f45-3c5f-af98-6bf12f049c67",
                        "source_sense_description": "uitwerpsel, ontlasting",
                        "target_lang_word": "turd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                        "entry_id": "b3b3a346-de69-3357-bdf2-84e8980d3b58",
                                        "glosses": [
                                            "A piece of solid feces."
                                        ],
                                        "tags": [
                                            "informal",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee5eab2-08e1-4c3e-90a3-9648a3cdffc6",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "Ugh, there are turds in the toilet that haven’t been flushed away."
                                            },
                                            {
                                                "example_id": "0d29a3f1-a8ca-425e-9283-c6925540cae8",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "Thy teeth more comely than two dirty rakes are, / Thy breath is stronger than a douzen jakes are. / A fart for all perfumes, a turd for roses / Smell men but thee, they wish them selves all noses."
                                            },
                                            {
                                                "example_id": "364c3b90-881e-431a-9720-cfcb3948102b",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "How gladly would I have ſtopt the filthy mouth of that long-tongued fellow with a turd!"
                                            },
                                            {
                                                "example_id": "4de773ce-27c8-46a8-803c-44daa3e5678e",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "[H]e's nea in a Banter by my Saul, gin ye had bean bye when he wreet, ye wold ha ſeen his Face furrow'd lik a dry Cow-Turd, an his Eyn as keen as an Engliſh Bull-Dog, an his Back as high as a Camels, ſo grat was his Wrath, an now he be a Soldier it be tan Times bigger."
                                            },
                                            {
                                                "example_id": "cd954412-3f6b-4506-bd66-d15f8174e422",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "When he met with any of them upon the Street, he would never fail to put ſome Trick or other upon them; ſometimes putting a fry'd Turd in their graduate Hoods; […] One Day that the Theologians were appointed all to meet in the Sorbonne, he made a Barbonneſa Tart, made of Store of Garlick, Galbanum, Aſſa fœtida, Caſtoreum, Dogs Turds very warm; which he ſteep'd, temper'd, and liquify'd in the corrupt Matter of pocky Biles and peſtiferous Botches; and, very early in the Morning, therewith anointed all the Lattices and Grates of the Sorbonne in ſuch ſort, that the Devil could not have endured it."
                                            },
                                            {
                                                "example_id": "b11882f7-cc50-4d8b-bd73-6307b0777790",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "[…] just as Snitter felt himself exhausted and unable to do more, Rowf's rump slid suddenly forward as smoothly as a turd from a healthy anus […]"
                                            },
                                            {
                                                "example_id": "be4c394b-d0de-4f07-930d-df041e3caa1a",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "Thus, an insect that has evolved the useful disguise of looking very much like a piece of dung in order to damp the enthusiasm of any non-coprophagous predator is clearly on to a good thing but, as Stephen Jay Gould has wisely observed, what is the adaptive value in looking only 5 per cent like a turd?"
                                            },
                                            {
                                                "example_id": "4a25ec4b-f097-4a39-9d78-695724adca11",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "Hell, as bird number 697 they could have looked like old turds and I still would have got excited."
                                            },
                                            {
                                                "example_id": "73f6436d-c5dc-4c68-ab78-6430257e1040",
                                                "sense_id": "3d1c068b-0417-3285-be51-8778ebd25c9d",
                                                "text": "The sausage on my plate could have been a turd, it tasted like a turd, it smelled like a turd, it had the texture of a turd. In fact, thinking about it, it probably was a turd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1079ad-c876-3d7c-8d95-d5e9fc97f931",
                                        "entry_id": "b3b3a346-de69-3357-bdf2-84e8980d3b58",
                                        "glosses": [
                                            "A worthless person or thing."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7913eaf-6eca-46fd-920a-e8ec87ae239c",
                                                "sense_id": "aa1079ad-c876-3d7c-8d95-d5e9fc97f931",
                                                "text": "Last year, he arrested some crankhead turd, brings him down to the station. The guy's cuffed and Fred sets him down on the bench in the booking room. Now you know Fred, right? Not an abusive guy. Never even talks smack to suspects. Well, this turd, he starts kicking and shouting, […]"
                                            },
                                            {
                                                "example_id": "291074eb-2b7c-4a0d-a64a-37fc1e7e69e0",
                                                "sense_id": "aa1079ad-c876-3d7c-8d95-d5e9fc97f931",
                                                "text": "\"Don't be a turd,\" Freddi says. \"Don't be a Tones Turd.\" / \"If telling the truth makes a man a turd, then a turd I shall be.\" / \"Yeah,\" Freddi says. \"You'll go down in history. Tones the Truth-Telling Turd. Kids will learn about you in school.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "245a1bad-756e-3558-999e-20a446d50573",
                                        "entry_id": "77790bca-2341-381d-bd58-ca95b152bb73",
                                        "glosses": [
                                            "To defecate."
                                        ],
                                        "tags": [
                                            "rare",
                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdb3548-152c-4530-bd60-521eb9c2bd41",
                                                "sense_id": "245a1bad-756e-3558-999e-20a446d50573",
                                                "text": "You ought to see that owlet […] . We brought it to table and it turded in F's salad, it sits on your finger and squeaks like Peggy does when she gets tipsy."
                                            },
                                            {
                                                "example_id": "55c13265-686e-44ce-b7f3-9a89756d23db",
                                                "sense_id": "245a1bad-756e-3558-999e-20a446d50573",
                                                "text": "[P]iano dropped chords like a Wolfean horse turding in the steamy Brooklyn winter morn"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
