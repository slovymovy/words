                        "glosses": [
                            "Prononcer de façon gutturale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12636161-d8bf-45fe-9b15-de029baa5a70",
                                "sense_id": "dabf28e2-ad6b-3dcc-a550-393d5dfbce6d",
                                "text": "(...) une délicatesse d'oreille qui le met en état d'apprécier et de reproduire les moindres nuances de la phonétique portugaise, à coup sûr l'une des plus difficiles à maîtriser, ce phonéticien habile a néanmoins une tendance à gutturaliser les nasales portugaises, tout à fait comme dans le nord du pays."
                            },
                            {
                                "example_id": "c005735b-c4ae-4a55-9572-2e2a21368ec7",
                                "sense_id": "dabf28e2-ad6b-3dcc-a550-393d5dfbce6d",
                                "text": "Cette consonne peut se mouiller (py), se nasaliser (mp), se labialiser (pw) et se gutturaliser (kp)."
                            }
                        ]
                    }
