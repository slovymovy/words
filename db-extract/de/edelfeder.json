                "senses": [
                    {
                        "sense_id": "c8bc5cdd-8e7d-31a8-9a9d-6afcdab00abb",
                        "entry_id": "45449ab6-7643-33d7-8319-685c9dbe6a0d",
                        "glosses": [
                            "besonders anspruchsvoll und kultiviert Schreibender (Branchenjargon)"
                        ],
                        "tags": [
                            "Journalismus"
                        ],
                        "examples": [
                            {
                                "example_id": "d02d0ad9-0214-4fdd-9569-acdd926ad25b",
                                "sense_id": "c8bc5cdd-8e7d-31a8-9a9d-6afcdab00abb",
                                "text": "„Als Edelfeder und ‚Allzweckwaffe‘ schreibt er über alles, was interessant ist und teuer kommt: Politik, Wirtschaft, Erfolgspsychologie, Motor-Luxus (autorevue), Hi-Tech und Kunst.“"
                            },
                            {
                                "example_id": "a022d5ef-2d1a-4751-a599-78655b14497d",
                                "sense_id": "c8bc5cdd-8e7d-31a8-9a9d-6afcdab00abb",
                                "text": "„Sie hält sich einiges darauf zugute, auch sprachlich an der Spitze zu marschieren und noch bessere Edelfedern zu beschäftigen als etwa die ‚Frankfurter Allgemeine‘ (FAZ).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83f94822-bd94-3cfc-9d30-c495b7d0ac8f",
                        "entry_id": "45449ab6-7643-33d7-8319-685c9dbe6a0d",
                        "glosses": [
                            "hochwertiger, wertvoller Füller (Schreibgerät)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d168246-f4a6-4bb4-a5bd-e2948bfcfb75",
                                "sense_id": "83f94822-bd94-3cfc-9d30-c495b7d0ac8f",
                                "text": "„Eine Füllfeder besteht bei edlen Modellen aus Gold, die kugelförmige Spitze aber immer aus einem sehr harten Material, meist Iridium. Dieses Kügelchen soll über lange Zeit seine Form behalten – manche Edelfedern werden ja über Generationen weitergegeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
