                    },
                    {
                        "translation_id": "9561ad0f-ff29-4356-bc03-71953dfdc106",
                        "source_entry_id": "951de336-37a1-3799-97db-8549ab9c1fb7",
                        "source_sense_id": "1a8ef861-4018-3b86-9f33-a1a24d124a26",
                        "source_sense_description": "outside; beyond; outside of",
                        "target_lang_word": "hors",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hors",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e217c5f9-4fcf-3b8b-90d4-5f44fed4001d",
                                        "entry_id": "8a1bf04e-4ea2-3f26-9deb-684fe84e911e",
                                        "glosses": [
                                            "Préposition servant à marquer l’exclusion du lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c56537e1-fec4-44d0-a975-f66c33288570",
                                                "sense_id": "e217c5f9-4fcf-3b8b-90d4-5f44fed4001d",
                                                "text": "Hors barrière."
                                            },
                                            {
                                                "example_id": "35832a23-596b-49dc-a9b5-5e1ec37aa97d",
                                                "sense_id": "e217c5f9-4fcf-3b8b-90d4-5f44fed4001d",
                                                "text": "Hors la ville."
                                            },
                                            {
                                                "example_id": "a3669e49-9d31-46d4-b17b-b71e8d5836ed",
                                                "sense_id": "e217c5f9-4fcf-3b8b-90d4-5f44fed4001d",
                                                "text": "Muni même d’un pain de savon, il prit, sur le bord d’un cours d’eau, hors la ville, son premier bain depuis seize mois."
                                            },
                                            {
                                                "example_id": "be3487b8-d6b6-490d-b1fa-d9ea52724347",
                                                "sense_id": "e217c5f9-4fcf-3b8b-90d4-5f44fed4001d",
                                                "text": "Mettre quelqu’un hors la loi : formule qui a été employée dans des actes arbitraires par lesquels on proscrivait en telle sorte que les proscrits devaient être envoyés au supplice sans jugement dès que leur identité avait été reconnue."
                                            },
                                            {
                                                "example_id": "15085dd0-13bc-4130-9b9c-306cf647513e",
                                                "sense_id": "e217c5f9-4fcf-3b8b-90d4-5f44fed4001d",
                                                "text": "Un gouvernement qui met hors la loi est un gouvernement tyrannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "014b4131-cf8c-3482-8ab4-7076d2901eb6",
                                        "entry_id": "8a1bf04e-4ea2-3f26-9deb-684fe84e911e",
                                        "glosses": [
                                            "Excepté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60fdd79-7b5c-4498-ad4e-b8fadd8334f2",
                                                "sense_id": "014b4131-cf8c-3482-8ab4-7076d2901eb6",
                                                "text": "Tout son courage l’avait quitté dès qu’il n’avait plus eu à craindre le danger de rencontrer un homme; tout avait disparu de son coeur, hors l’amour."
                                            },
                                            {
                                                "example_id": "901eda33-c3ef-45ab-b852-d56aed0a45a9",
                                                "sense_id": "014b4131-cf8c-3482-8ab4-7076d2901eb6",
                                                "text": "Ils y sont tous allés, hors deux ou trois."
                                            },
                                            {
                                                "example_id": "50834137-ca7f-43f0-ac74-0278fed13027",
                                                "sense_id": "014b4131-cf8c-3482-8ab4-7076d2901eb6",
                                                "text": "Hors cela, je suis de votre sentiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "788d450b-ba4d-37a3-a740-c1ed67dfa8ec",
                                        "entry_id": "8a1bf04e-4ea2-3f26-9deb-684fe84e911e",
                                        "glosses": [
                                            "Il s’employait devant les verbes à l’infinitif avec la préposition de et devant les autres modes verbaux avec la particule que. On dit aujourd’hui loin de et sauf que."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215b81c4-9a6c-47a6-965c-4fadf85475d4",
                                                "sense_id": "788d450b-ba4d-37a3-a740-c1ed67dfa8ec",
                                                "text": "Hors de le battre, il ne pouvait le traiter plus mal."
                                            },
                                            {
                                                "example_id": "caa750b7-a0e8-4713-9897-c11dbcf4e9a5",
                                                "sense_id": "788d450b-ba4d-37a3-a740-c1ed67dfa8ec",
                                                "text": "Il lui a fait toutes sortes de mauvais traitements, hors qu’il ne l’a pas battu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                        "entry_id": "8a1bf04e-4ea2-3f26-9deb-684fe84e911e",
                                        "glosses": [
                                            "Marque toujours l’exclusion de la chose indiquée par le complément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a0b999-d1e1-4195-b576-7059eb65a1d9",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Elle n’avait pas complètement perdu connaissance, mais elle était hors d'état de parler. Elle grelottait, et ses dents claquaient."
                                            },
                                            {
                                                "example_id": "c0d34f80-cc40-4df5-86b0-a00b527203b0",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Mettre hors de cour et de procès : renvoyer les parties, ou une des parties, parce qu’il n’y a pas lieu de prononcer juridiquement, parce qu’il n’y a pas sujet de plaider."
                                            },
                                            {
                                                "example_id": "2848f18f-6091-4a9c-8e31-bfcfc193539a",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Mettre hors de cause : déclarer qu’une personne ne doit point être partie au procès."
                                            },
                                            {
                                                "example_id": "3941d22d-91e9-4695-93ca-1f3d388a9d0a",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Hors d’embarras."
                                            },
                                            {
                                                "example_id": "95911678-ee17-42f5-8796-274baa5e470a",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Hors de danger, de péril, etc."
                                            },
                                            {
                                                "example_id": "a79b2018-7f08-46de-8d06-5eb75879dcd2",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Il est hors d’état de nuire."
                                            },
                                            {
                                                "example_id": "bbca57b1-bb51-4de0-be98-15c5bb24bd07",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Hors de proportion."
                                            },
                                            {
                                                "example_id": "7c17bde7-3456-47c6-83e6-90e4c2ef552b",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Hors de doute."
                                            },
                                            {
                                                "example_id": "e06b5b1c-2158-44ce-96df-d966c7d883ba",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Hors d’haleine."
                                            },
                                            {
                                                "example_id": "0c1cbc4c-b9d4-449d-b00f-bf889207b6d8",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Tout est hors de prix."
                                            },
                                            {
                                                "example_id": "987a8c3c-c5e9-47a8-8775-3c80ec13275d",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Être hors de soi : se dit d’une personne violemment agitée par quelque passion."
                                            },
                                            {
                                                "example_id": "e5218178-e1cd-4a12-a992-cc3688cf0c80",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Cela le met hors de lui."
                                            },
                                            {
                                                "example_id": "7d89ef9a-be39-4b3c-890d-c4bb9be7366b",
                                                "sense_id": "4a4599c9-9340-3d63-b539-add64309f684",
                                                "text": "Ce malade est hors d’affaire : il ne court plus aucun danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d36ef5fa-e708-3a9b-9d5f-d5835054390b",
                                        "entry_id": "8a1bf04e-4ea2-3f26-9deb-684fe84e911e",
                                        "glosses": [
                                            "Quelquefois préposition de temps et sert à marquer l’exclusion du temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9757da37-4455-4703-aeaf-38afd831db47",
                                                "sense_id": "d36ef5fa-e708-3a9b-9d5f-d5835054390b",
                                                "text": "Cela est hors de saison, ou hors saison."
                                            },
                                            {
                                                "example_id": "62decaa7-d0ce-4d8c-b124-606cbae4ec86",
                                                "sense_id": "d36ef5fa-e708-3a9b-9d5f-d5835054390b",
                                                "text": "Nous voilà hors de l’hiver, hors de la canicule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hors",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f496aefd-f025-38b1-8547-8945214b3a21",
                                        "entry_id": "18ba4e0d-a162-3be0-bc28-5f6af49409ed",
                                        "glosses": [
                                            "Variante orthographique de or."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2870854e-876a-4eda-bf8f-8aef8c4a4e88",
                                                "sense_id": "f496aefd-f025-38b1-8547-8945214b3a21",
                                                "text": "Nous sommes dans la zone des bassins à flot et nécessairement il faut bien permettre aux bateaux d'accéder. Hors dans le cas d'un pont fixe ordinaire, le pont qui relie le quai de Bacalan à la rue Achard représenterait un obstacle infranchissable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
