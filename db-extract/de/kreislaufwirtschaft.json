                                        "sense_id": "1cbc6e1b-648e-39bd-9625-bcaacec64631",
                                        "entry_id": "a1ab4fb5-d0e3-3b63-93cd-dc361c4e22f1",
                                        "glosses": [
                                            "An industrial economy that aims to reduce waste and pollution by means of reuse, recycling, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf4e52f0-25dc-448c-adfe-71d1f589a747",
                        "source_entry_id": "8ed70596-9e83-371a-86e5-b1f1095b8269",
                        "source_sense_id": "89083dd2-537a-3b3e-bc1c-6c4403fa374f",
                        "source_sense_description": "Wirtschaft, die durch Wiederverwendung, Reparatur und Recycling die Ziele verfolgt, den Ressourceneinsatzes, die Abfälle, Emissionen und den Energieverbrauch weitgehend zu minimieren",
                        "target_lang_word": "économie circulaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "économie circulaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57352bb9-1c47-327b-af77-4366f48989cb",
                                        "entry_id": "293b7894-3d8d-364e-9d5a-06daf7a7b4c0",
                                        "glosses": [
                                            "Organisation d’activités économiques et sociales recourant à des modes de production, de consommation et d’échange fondés sur l’écoconception, la réparation, le réemploi et le recyclage, et visant à diminuer les ressources utilisées ainsi que les dommages causés à l’environnement."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Sciences de l’environnement",
                                            "Politiques publiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4265d728-8529-4748-9254-fcf47a48ee38",
                                                "sense_id": "57352bb9-1c47-327b-af77-4366f48989cb",
                                                "text": "Transformer les déchets des uns en ressources pour les autres : face à la raréfaction des ressources naturelles, l’économie circulaire propose un modèle de production simple et porteur de promesses."
                                            },
                                            {
                                                "example_id": "55e51f53-cafc-4990-aa53-acf9a35f908a",
                                                "sense_id": "57352bb9-1c47-327b-af77-4366f48989cb",
                                                "text": "Construire en terre, avec une matière issue des chantiers du métro par exemple, c’est mettre en œuvre un principe d’économie circulaire."
                                            },
                                            {
                                                "example_id": "ea8a3cc3-6614-49bb-b75f-963781d76254",
                                                "sense_id": "57352bb9-1c47-327b-af77-4366f48989cb",
                                                "text": "Le projet consiste au développement d’une pratique du réemploi in situ, pour réduire les déchets, lutter contre les gaspillages et développer l’économie circulaire dans le secteur du bâtiment."
                                            },
                                            {
                                                "example_id": "4b0fb04a-a298-42d1-b06b-929395cbc9b2",
                                                "sense_id": "57352bb9-1c47-327b-af77-4366f48989cb",
                                                "text": "Ce label a pour vocation de développer l’économie circulaire dans le domaine de la construction et de l’aménagement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
