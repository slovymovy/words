                "senses": [
                    {
                        "sense_id": "4c4f46e1-a1e7-3e5c-a5de-2f18cef65bf9",
                        "entry_id": "b4ff6a1a-6ac0-32be-9cf4-51736842aafb",
                        "glosses": [
                            "Großstadt in Spanien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a731a22-1cbf-4460-a8b1-21cbadfd54b5",
                                "sense_id": "4c4f46e1-a1e7-3e5c-a5de-2f18cef65bf9",
                                "text": "„Später hatte er sich an der Universität von Salamanca dem Studium des bürgerlichen und kanonischen Rechts gewidmet.“"
                            },
                            {
                                "example_id": "d72146b3-f1b5-4068-8dd9-5862d305f8cc",
                                "sense_id": "4c4f46e1-a1e7-3e5c-a5de-2f18cef65bf9",
                                "text": "„Der Dominikanermönch Vitoria lehrte an der Universität von Salamanca und verfasste unter anderem die zwei Traktate De Indis und De Iure belli Hispanorum in barbaros (beide 1532).“"
                            },
                            {
                                "example_id": "e372a2fb-f913-4e95-8b4f-ed59ee771b5d",
                                "sense_id": "4c4f46e1-a1e7-3e5c-a5de-2f18cef65bf9",
                                "text": "„Den 14- oder 15-Jährigen schickte der Vater zur weiteren Ausbildung wohl nach Salamanca, wo dessen Stiefschwester Inés Gómez de Paz mit ihrem Mann, dem Schreiber Francisco Núñez de Valera lebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
