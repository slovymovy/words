{
    "word_family": [
        "costumer",
        "costumier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "961a1dc7-0601-3f4d-9d58-bc539efab46a",
                    "sense_definition": "An outfit worn to create the appearance of a particular person, animal, or character, often for a party or performance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a funny clown <w>costume</w> to the birthday party.",
                            "target_lang_translations": {
                                "ru": "Он надел смешной <w>костюм</w> клоуна на день рождения.",
                                "zh": "他穿了一套滑稽的<w>小丑服</w>去参加生日派对。"
                            }
                        },
                        {
                            "text": "The children made their own <w>costumes</w> for the school play.",
                            "target_lang_translations": {
                                "ru": "Дети сами сделали себе <w>костюмы</w> для школьного спектакля.",
                                "zh": "孩子们为学校的演出自己制作了<w>戏服</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outfit",
                        "getup"
                    ],
                    "common_phrases": [
                        "Halloween costume",
                        "costume party",
                        "wear a costume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наряд, который носят, чтобы создать образ определенного человека, животного или персонажа, часто для вечеринки или представления.",
                        "zh": "为参加派对或表演而穿的，旨在塑造特定人物、动物或角色形象的服装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "маскарадный или театральный"
                            },
                            {
                                "target_lang_word": "наряд",
                                "target_lang_sense_clarification": "праздничная одежда или образ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏服",
                                "target_lang_sense_clarification": "用于表演的服装"
                            },
                            {
                                "target_lang_word": "装扮",
                                "target_lang_sense_clarification": "用于派对或节日扮演角色的服装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0424e08e-0cf2-30a8-bc34-110ad8a2a8bf",
                    "sense_definition": "The clothes worn by people from a particular place or during a particular historical period.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancers performed in traditional folk <w>costumes</w>.",
                            "target_lang_translations": {
                                "ru": "Танцоры выступали в традиционных народных <w>костюмах</w>.",
                                "zh": "舞者们穿着传统的<w>民族服装</w>进行表演。"
                            }
                        },
                        {
                            "text": "The museum displays <w>costumes</w> from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "В музее выставлены <w>костюмы</w> восемнадцатого века.",
                                "zh": "博物馆里陈列着十八世纪的<w>服饰</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "national costume",
                        "traditional costume",
                        "period costume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одежда, которую носят люди из определенной местности или в определенный исторический период.",
                        "zh": "特定地区或特定历史时期人们所穿的服饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "национальный или исторический"
                            },
                            {
                                "target_lang_word": "наряд",
                                "target_lang_sense_clarification": "одеяние, одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民族服装",
                                "target_lang_sense_clarification": "特定地区的传统服饰"
                            },
                            {
                                "target_lang_word": "古装",
                                "target_lang_sense_clarification": "特定历史时期的服饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60f4d8dc-bf7d-3a07-9912-5e96233fbcb0",
                    "sense_definition": "A piece of clothing worn for swimming.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't forget to pack your swimming <w>costume</w> for the holiday.",
                            "target_lang_translations": {
                                "ru": "Не забудь взять с собой <w>купальный костюм</w> в отпуск.",
                                "zh": "别忘了带上你的<w>泳装</w>去度假。"
                            }
                        },
                        {
                            "text": "She bought a new <w>costume</w> for the beach.",
                            "target_lang_translations": {
                                "ru": "Она купила новый <w>купальник</w> для пляжа.",
                                "zh": "她为去海滩买了一件新<w>泳衣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swimming costume"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет одежды, предназначенный для плавания.",
                        "zh": "用于游泳的服装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купальник",
                                "target_lang_sense_clarification": "женский купальный костюм"
                            },
                            {
                                "target_lang_word": "купальный костюм",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泳装",
                                "target_lang_sense_clarification": "通用的游泳服装"
                            },
                            {
                                "target_lang_word": "泳衣",
                                "target_lang_sense_clarification": "女性游泳服装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb747efc-ad06-3e9f-a152-de453fce4e41",
                    "sense_definition": "A set of clothes appropriate for a particular occasion, especially a woman's suit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bride wore a grey going-away <w>costume</w>.",
                            "target_lang_translations": {
                                "ru": "Невеста была в сером дорожном <w>костюме</w>.",
                                "zh": "新娘穿了一套灰色的出门<w>套装</w>。"
                            }
                        },
                        {
                            "text": "She arrived in a stylish riding <w>costume</w>.",
                            "target_lang_translations": {
                                "ru": "Она прибыла в стильном <w>костюме</w> для верховой езды.",
                                "zh": "她穿着一身时髦的骑马<w>服饰</w>到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outfit"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комплект одежды, подходящий для определенного случая, особенно женский костюм.",
                        "zh": "适合特定场合的一套衣服，尤指女性套装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюм",
                                "target_lang_sense_clarification": "женский комплект (жакет и юбка)"
                            },
                            {
                                "target_lang_word": "ансамбль",
                                "target_lang_sense_clarification": "комплект одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "套装",
                                "target_lang_sense_clarification": "成套的女性服装"
                            },
                            {
                                "target_lang_word": "服饰",
                                "target_lang_sense_clarification": "特定场合的整套搭配"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1772e170-60bb-3faf-9cbe-60a62ee3d097",
                    "sense_definition": "To dress someone in a specific set of clothes, especially for a play or film.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play was <w>costumed</w> in Victorian style.",
                            "target_lang_translations": {
                                "ru": "Пьеса была <w>костюмирована</w> в викторианском стиле.",
                                "zh": "这部戏的<w>装扮</w>采用了维多利亚风格。"
                            }
                        },
                        {
                            "text": "They <w>costumed</w> the actors to look like aliens.",
                            "target_lang_translations": {
                                "ru": "Они <w>нарядили</w> актеров так, чтобы те были похожи на инопланетян.",
                                "zh": "他们把演员<w>装扮</w>得看起来像外星人一样。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одевать кого-либо в определенную одежду, особенно для спектакля или фильма.",
                        "zh": "为某人穿上特定的服装，尤指为戏剧或电影角色进行装扮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюмировать",
                                "target_lang_sense_clarification": "обеспечивать костюмами"
                            },
                            {
                                "target_lang_word": "наряжать",
                                "target_lang_sense_clarification": "одевать в наряд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装扮",
                                "target_lang_sense_clarification": "为角色设计或穿戴服装"
                            },
                            {
                                "target_lang_word": "提供戏服",
                                "target_lang_sense_clarification": "为演出准备服装"
                            }
                        ]
                    }
                }
            ]
        }
    ]
