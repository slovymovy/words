{
    "word_family": [
        "strekken",
        "uitgestrekt",
        "uitstrekking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e2f9bc1-a661-3719-993e-c294ba5bf18b",
                    "sense_definition": "jezelf of een lichaamsdeel zo lang mogelijk maken door het te rekken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysiek_rekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag op kantoor is het heerlijk om je even goed <w>uit</w> te <w>strekken</w>.",
                            "target_lang_translations": {
                                "en": "After a long day at the office, it's wonderful to <w>stretch out</w> properly for a moment."
                            }
                        },
                        {
                            "text": "Als hij zijn arm <w>uitstrekt</w>, kan hij net bij de bovenste plank van de kast.",
                            "target_lang_translations": {
                                "en": "If he <w>extends</w> his arm, he can just reach the top shelf of the cupboard."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de armen uitstrekken",
                        "je benen uitstrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To make yourself or a body part as long as possible by stretching it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch out",
                                "target_lang_sense_clarification": "of the body or limbs"
                            },
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to straighten a limb"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aff9e2a4-6ccd-32e3-82ad-f70369f96fde",
                    "sense_definition": "een bepaalde oppervlakte in de ruimte of een periode in de tijd beslaan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bereik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het prachtige bos <w>strekt</w> zich <w>uit</w> over vele kilometers langs de kust.",
                            "target_lang_translations": {
                                "en": "The beautiful forest <w>extends</w> for many kilometers along the coast."
                            }
                        },
                        {
                            "text": "De onderhandelingen over het nieuwe contract <w>strekten</w> zich <w>uit</w> over meerdere maanden.",
                            "target_lang_translations": {
                                "en": "The negotiations for the new contract <w>stretched out</w> over several months."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitspreiden"
                    ],
                    "common_phrases": [
                        "zich ver uitstrekken",
                        "zich over jaren uitstrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover a certain area in space or a period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to cover space or time"
                            },
                            {
                                "target_lang_word": "stretch out",
                                "target_lang_sense_clarification": "to span across an area"
                            },
                            {
                                "target_lang_word": "span",
                                "target_lang_sense_clarification": "to cover a distance or period"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86d32155-e9cb-397c-b9c8-fa836f83b76c",
                    "sense_definition": "iets in de lengte of breedte vergroten of ontvouwen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_rekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeiders moesten het zeil voorzichtig <w>uitstrekken</w> om de hele lading te bedekken.",
                            "target_lang_translations": {
                                "en": "The workers had to carefully <w>stretch out</w> the tarp to cover the entire load."
                            }
                        },
                        {
                            "text": "Je kunt dit materiaal gemakkelijk <w>uitstrekken</w> zonder dat het scheurt.",
                            "target_lang_translations": {
                                "en": "You can easily <w>stretch</w> this material without it tearing."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitspreiden"
                    ],
                    "common_phrases": [
                        "een kleed uitstrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To increase or unfold something in length or width."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch out",
                                "target_lang_sense_clarification": "to unfold or pull tight"
                            },
                            {
                                "target_lang_word": "spread out",
                                "target_lang_sense_clarification": "to unfold over a surface"
                            },
                            {
                                "target_lang_word": "extend",
                                "target_lang_sense_clarification": "to increase in extent"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}