                    },
                    {
                        "translation_id": "7b8afd7c-7433-4bbd-993e-83fe3bde0b5b",
                        "source_entry_id": "343c12f7-d6ad-3c38-b918-5f8b428e8be6",
                        "source_sense_id": "baf168a7-b264-3262-93ec-f477a92da2cd",
                        "target_lang_word": "Semiotik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Semiotik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Zeichensystemen aller Art (zum Beispiel: Bilderschrift, Gestik, Formeln, Sprache, Verkehrszeichen) befasst und versucht, sie zu beschreiben und zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf626e8-ef4f-45f3-bf78-17cb4e1c6701",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "Im Verkehrsunterricht lernt man die Semiotik der Straße, das heißt alle Verkehrszeichen. Im Unterschied dazu stehen die Verkehrsregeln, die nicht die Semiotik betreffen."
                                            },
                                            {
                                                "example_id": "9b0998b3-ab81-41db-b696-cd60a951417b",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Die Semiotik untersucht alle kulturellen Prozesse als Kommunikationsprozesse.“"
                                            },
                                            {
                                                "example_id": "23ce2dba-9cde-41bb-8b0b-9d1de2e8fa61",
                                                "sense_id": "7cddafe6-9998-3812-93cf-c10e680a4bac",
                                                "text": "„Der Gegenstandsbereich der Semiotik - letztlich eine Art und Weise der Erweiterung unserer Wahrnehmung der Welt - ist der Austausch jedweder Nachrichten und der Zeichensysteme, die ihnen zugrunde liegen […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                        "entry_id": "c8b3ad5e-826c-3212-91d9-0921fb3c0e14",
                                        "glosses": [
                                            "Lehre von den Anzeichen für eine Erkrankung oder Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c83a899-bf74-4bc1-8893-7adbed93534b",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Semiotik ist die Lehre von den Zeichen des widernatürlichen Zustandes.“"
                                            },
                                            {
                                                "example_id": "d621bf6f-e018-4937-930d-55ee7a3e82bd",
                                                "sense_id": "f21b8665-2207-3a4d-b005-fb411feb3e2f",
                                                "text": "„Die Lehre, welche die einzelnen Zeichen auf ihre Ursachen, oder auf die ihnen entsprechenden Veränderungen des lebenden Körpers zurückführt, und dabei das Verhältnis der einzelnen Zeichen unter einander berücksichtigt, ist die Semiotik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "181233e0-4db8-4376-a575-a907ade35c9d",
                        "source_entry_id": "343c12f7-d6ad-3c38-b918-5f8b428e8be6",
                        "source_sense_id": "baf168a7-b264-3262-93ec-f477a92da2cd",
