                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salvadoran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10006e01-396b-3a33-acef-31c46ee61d5c",
                                        "entry_id": "23f92e64-1f54-31bb-8bf0-94f80310fb88",
                                        "glosses": [
                                            "A person from El Salvador or of Salvadoran descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebf800a-5c68-4e5f-b588-b870f5cdb415",
                                                "sense_id": "10006e01-396b-3a33-acef-31c46ee61d5c",
                                                "text": "Under Biden, a Trump-era decision to end TPS for Salvadorans was rescinded after a group of Latino officials pleaded with the outgoing president to continue TPS for people from those countries with “meritorious cases,” citing “horrific levels of violence that surged in recent years” in Ecuador, along with the oppression of the Ortega regime that has controlled Nicaragua for decades and “political and environmental conditions” in El Salvador."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Salvadoran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e4b039-eeb8-3cf2-9a80-6b00bf886905",
                                        "entry_id": "cf6bdf07-b9f2-37f3-b247-425a329124e2",
                                        "glosses": [
                                            "Of, from, or pertaining to El Salvador or the Salvadoran people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f06aa6-ca8b-4fa9-9ba2-071efd7a2c08",
                                                "sense_id": "a4e4b039-eeb8-3cf2-9a80-6b00bf886905",
                                                "text": "People will fill the plazas of the country tumultuously, like a river in the rainy season, to pay tribute to these brothers of ours who died for the sake of peace, to these brothers who were born in Spain but were more Salvadoran than their assassins, that pack of criminals with no patriotism in their hearts."
                                            },
                                            {
                                                "example_id": "6d511c95-96b0-4819-9895-b722b6b08bfa",
                                                "sense_id": "a4e4b039-eeb8-3cf2-9a80-6b00bf886905",
                                                "text": "I’d been pushing some shopping carts around the grocery store’s parking lot with a coworker, a guy named Rafa, a big Salvadoran dude."
                                            },
                                            {
                                                "example_id": "71dfecef-aacb-44a0-b97e-862828ad032b",
                                                "sense_id": "a4e4b039-eeb8-3cf2-9a80-6b00bf886905",
                                                "text": "The executive order specifically named Tren de Aragua and the Salvadoran MS-13 gang, citing their “campaigns of violence and terror in the United States and internationally” as threats to “the stability of the international order in the Western Hemisphere.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
