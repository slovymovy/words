                "senses": [
                    {
                        "sense_id": "083cfe05-7e6d-31ed-abb1-0a20619f71c3",
                        "entry_id": "a557b656-52f5-3422-a881-12d4b477751b",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a336d70b-80ba-4bae-a05e-255a81a07bd3",
                                "sense_id": "083cfe05-7e6d-31ed-abb1-0a20619f71c3",
                                "text": "C'est très intime. Mécrire. Ou médire. Méditer par devers-soi."
                            },
                            {
                                "example_id": "c8ff6c58-82d6-4a01-8eb1-d1888ae4c74f",
                                "sense_id": "083cfe05-7e6d-31ed-abb1-0a20619f71c3",
                                "text": "Dire contre soi, contrécrire, mécrire enfin (on n’oubliera pas que Beckett, qui fit cette expérience dans la prose, eut le prix Nobel !)."
                            },
                            {
                                "example_id": "c06ac892-d3e6-4d8f-bc07-f4c6aa3cd585",
                                "sense_id": "083cfe05-7e6d-31ed-abb1-0a20619f71c3",
                                "text": "Ecrire/mécrire (poétique et antipoétique chez Denis Roche"
                            }
                        ]
                    }
