                    {
                        "translation_id": "96f69053-1be1-440d-9bba-7f490ac40293",
                        "source_entry_id": "bb252d9e-6887-3e6c-aebe-bf7fd8309338",
                        "source_sense_description": "have a monopoly",
                        "target_lang_word": "accaparer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accaparer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f420c54-af03-3653-b7a8-70a519f3353a",
                                        "entry_id": "c0855a2d-be2f-3580-a913-196a8235b37f",
                                        "glosses": [
                                            "Acheter ou retenir une quantité considérable d’une denrée, d’une marchandise, pour la rendre plus chère en la rendant plus rare, et se faire ainsi seul le maître de la vente et du prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35cc0ebc-e984-4339-b43d-4a9c1ad82257",
                                                "sense_id": "4f420c54-af03-3653-b7a8-70a519f3353a",
                                                "text": "Et ils ont cherché à accaparer, chacun pour soi, la plus grande quantité de jouissances possible, sans s'occuper des intérêts d'autrui."
                                            },
                                            {
                                                "example_id": "d77065b0-847d-438e-bd92-edb3dc337353",
                                                "sense_id": "4f420c54-af03-3653-b7a8-70a519f3353a",
                                                "text": "On l’accusait d’avoir accaparé tous les blés de la province."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf613c8-6b1d-3df8-be52-b2a7bade2b8a",
                                        "entry_id": "c0855a2d-be2f-3580-a913-196a8235b37f",
                                        "glosses": [
                                            "S'assurer par des sollicitations, par la brigue, etc., en parlant des voix, des suffrages."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92bfdf31-5c2c-3ffd-9276-e7d98cbbe241",
                                        "entry_id": "c0855a2d-be2f-3580-a913-196a8235b37f",
                                        "glosses": [
                                            "S’emparer de quelqu’un ou de quelque chose pour son propre profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e82a7b8-7cec-4808-a1a0-aa67d10b1c3c",
                                                "sense_id": "92bfdf31-5c2c-3ffd-9276-e7d98cbbe241",
                                                "text": "Hervé pâlit, deux heures durant, sur ces problèmes et, n'en trouvant point la solution, il s'en alla diner à son cercle où il tomba sur l’inévitable Pibrac qui ne manqua pas de l’accaparer."
                                            },
                                            {
                                                "example_id": "d8e14c12-3fd4-4bc3-b4a1-9879b5da9a29",
                                                "sense_id": "92bfdf31-5c2c-3ffd-9276-e7d98cbbe241",
                                                "text": "Pendant toute une période, la motocyclette accapara à tel point l’esprit de Bert qu’il resta indifférent au nouveau genre d’exercice et de délassement que recherchait l’impatience humaine."
                                            },
                                            {
                                                "example_id": "3da8771d-bad3-4673-b499-4b856b5e3d04",
                                                "sense_id": "92bfdf31-5c2c-3ffd-9276-e7d98cbbe241",
                                                "text": "Elle accaparait de ses trémolos douloureux notre petit monde rétréci où nous étions en train de merdouiller en chœur par sa faute."
                                            },
                                            {
                                                "example_id": "8ba036c0-9cd4-44ca-a31a-518667d8b9da",
                                                "sense_id": "92bfdf31-5c2c-3ffd-9276-e7d98cbbe241",
                                                "text": "Il accaparait tous les flacons de parfumerie pour mettre ses échantillons de baryte, ses sulfates, sels, magnésie, coraux, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
