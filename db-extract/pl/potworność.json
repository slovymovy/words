                "translations": [
                    {
                        "translation_id": "949fa2ff-b6f4-4cbc-b659-3025e64d3e4a",
                        "source_entry_id": "544b966d-a791-3ceb-b6ea-e0b46ec274a0",
                        "source_sense_id": "99321815-ded4-3298-a818-34e21bd56da8",
                        "target_lang_word": "atrociousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrociousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30544e31-7e48-3be6-92c1-cd19133c2a8c",
                                        "entry_id": "54d6f33e-b36b-3a51-aa78-609e4e5cc093",
                                        "glosses": [
                                            "The state or quality of being atrocious."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5eb669d-f910-459e-9f84-6105def04cdf",
                                                "sense_id": "30544e31-7e48-3be6-92c1-cd19133c2a8c",
                                                "text": "1689, Francis Grant, Lord Cullen, The Loyalists Reasons for His Giving Obedience, and Swearing Allegiance, to the Present Government, Edinburgh: J. Reid, pp. 34-35,\nIf there be joyned to [injustice] an other vice […] , if it be frequent and habitual, in a Person of perfect Age, all these Aggravations augment its Atrociousness."
                                            },
                                            {
                                                "example_id": "032bd0a5-da9e-43c8-9b63-1b9916e60228",
                                                "sense_id": "30544e31-7e48-3be6-92c1-cd19133c2a8c",
                                                "text": "The atrociousness of a crime, depends greatly upon the nature, character, and condition of the victim. […] To steal bread from a full man, is theft; to steal it from a starving man, is both theft and murder."
                                            },
                                            {
                                                "example_id": "5e5540ee-2a4a-4f4a-92e9-d657e422ce30",
                                                "sense_id": "30544e31-7e48-3be6-92c1-cd19133c2a8c",
                                                "text": "[…] as the day dawned, the atrociousness of his conduct became apparent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccb0f4b0-ae7e-492d-98eb-8bdc8da08705",
                        "source_entry_id": "544b966d-a791-3ceb-b6ea-e0b46ec274a0",
                        "source_sense_id": "99321815-ded4-3298-a818-34e21bd56da8",
                        "target_lang_word": "atrocité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrocité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39ec41bf-d6d3-33af-99a6-a45c33ea7d23",
                                        "entry_id": "82dbc2b1-4f89-388b-a9c8-2e78e3a8ed2e",
                                        "glosses": [
                                            "Extrême cruauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7de7e296-4544-4b62-8dbc-4dee54422f96",
                                                "sense_id": "39ec41bf-d6d3-33af-99a6-a45c33ea7d23",
                                                "text": "Le vieux tyran, pour garder sa puissance, n’est plus à une atrocité près."
                                            },
                                            {
                                                "example_id": "6058f6b3-a606-4877-9138-f2b337b57780",
                                                "sense_id": "39ec41bf-d6d3-33af-99a6-a45c33ea7d23",
                                                "text": "L’atrocité d’un supplice, d’un tyran."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5536e34e-c8bb-31b6-9051-731b51bc8908",
                                        "entry_id": "82dbc2b1-4f89-388b-a9c8-2e78e3a8ed2e",
                                        "glosses": [
                                            "Action très cruelle."
                                        ],
                                        "tags": [],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "5e982419-b169-46ae-a3c3-43990866ef17",
                                                "sense_id": "5536e34e-c8bb-31b6-9051-731b51bc8908",
                                                "text": "Commettre des atrocités."
                                            },
                                            {
                                                "example_id": "2c5aa6ae-fd2e-4132-ad82-b9c9bb9c40ac",
                                                "sense_id": "5536e34e-c8bb-31b6-9051-731b51bc8908",
                                                "text": "L’armée d’invasion se livra à mille atrocités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed234a27-5b4b-37ed-87cf-dda145c8f9c1",
                                        "entry_id": "82dbc2b1-4f89-388b-a9c8-2e78e3a8ed2e",
                                        "glosses": [
                                            "Propos blessants ou calomnieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1f7d5d6-db45-4bfa-b40f-d959e1bca7b0",
                                                "sense_id": "ed234a27-5b4b-37ed-87cf-dda145c8f9c1",
                                                "text": "Il ne cesse de débiter des atrocités sur tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e18050bb-2caa-4505-be4c-7522c595fa0e",
                        "source_entry_id": "544b966d-a791-3ceb-b6ea-e0b46ec274a0",
                        "source_sense_id": "99321815-ded4-3298-a818-34e21bd56da8",
                        "target_lang_word": "monstruosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monstruosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                                        "glosses": [
                                            "Caractère de ce qui est monstrueux. Anomalie grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1a6313-d715-476c-b006-cb72b80bb295",
                                                "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                                                "text": "Comment expliquer la monstruosité de ces actes ?"
                                            },
                                            {
                                                "example_id": "c264072a-258f-4364-95ce-57bd975a51fa",
                                                "sense_id": "11f8581c-d2e6-3b51-861b-685840ed11ce",
                                                "text": "Léodagan : Vous êtes marié, comme moi ; vous savez que la monstruosité peut prendre des formes très diverses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                                        "glosses": [
                                            "Personne ou chose monstrueuse."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30f319ab-44e6-4c1b-b16e-a9b7eb0dc11a",
                                                "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                                "text": "Un des clous du spectacle est l'exhibition de ces deux sœurs Josepha que dame nature s'est plu à lier de si étroite manière. Ces sortes de monstruosités, n'ayant rien à voir avec l'art dramatique, on me permettra de n'en point parler davantage."
                                            },
                                            {
                                                "example_id": "9ed63ae2-a542-4919-a450-51964ce02553",
                                                "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                                "text": "On en vient à lui attribuer presque toutes les malformations, presque toutes les monstruosités ; c’est l’âge d’or de la tératologie syphilitique."
                                            },
                                            {
                                                "example_id": "7a99ba81-0761-4abe-83e5-0789caf2f4ff",
                                                "sense_id": "bd3c4a8a-4be4-35eb-ada7-8443ec1c9ca0",
                                                "text": "Mais ces propos me paraissent reposer sur une vision complètement « enchantée » de la concurrence, comme s’il était encore possible de croire qu’un « marché sain » est en mesure de nous sauver des monstruosités qu’il a lui-même engendrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                                        "entry_id": "d2343ec6-5c32-312c-aaf9-35cd1f8a19fc",
                                        "glosses": [
                                            "Ce qui suscite l’indignation, la réprobation, ce qui choque la raison ou la bienséance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e80e192-aa00-45e6-9672-b476ad363f9d",
                                                "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                                                "text": "Il prend plaisir à choquer mes parents en proférant des monstruosités."
                                            },
                                            {
                                                "example_id": "755a5066-d4ae-4844-bb0b-e010ae7b661b",
                                                "sense_id": "f801c681-6b10-32bc-bb11-b6746485dbd0",
                                                "text": "Depuis que je vais dans la haute société, j’ai rencontré des monstruosités habillées de satin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
