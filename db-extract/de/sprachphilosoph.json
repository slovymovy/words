                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877f7e54-b91a-4e69-b4bf-e5e378f45c0e",
                                                "sense_id": "05afe5c8-32c1-319a-8872-2d45baf27ffc",
                                                "text": "Op de achtergrond van deze opvatting over geloofstaal speelt het denken van Ludwig Wittgenstein een duidelijke rol. Volgens deze postmoderne taalfilosoof is de betekenis van een woord dat wat er met dat woord gedaan wordt."
                                            },
                                            {
                                                "example_id": "1d52a245-b69b-4133-8a40-b6e8bed6da62",
                                                "sense_id": "05afe5c8-32c1-319a-8872-2d45baf27ffc",
                                                "text": "Wetenschappers in de literatuur. Werden we eerder dit jaar al verrast door een biografische roman van David Leavitt over de briljante wiskundige Ramanujan, nu ligt er zowaar een nog betere voor over een briljante taalfilosoof."
                                            }
                                        ]
                                    }
