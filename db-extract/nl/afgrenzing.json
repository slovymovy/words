                        "examples": [
                            {
                                "example_id": "68ce8290-703d-449e-a1cf-24c6d1220492",
                                "sense_id": "cec9d8a0-6679-3229-b47d-74dfb0d16108",
                                "text": "Natuurlijk, Rotterdam en Amsterdam hebben al ervaring opgedaan met deelgemeenten en stadsdelen. Maar deze hebben volgens velen tot te veel bestuurlijke drukte en onvoldoende duidelijke afgrenzing van taken en bevoegdheden gezorgd."
                            },
                            {
                                "example_id": "92c28ca5-a43f-4b8e-a104-9844ab394e99",
                                "sense_id": "cec9d8a0-6679-3229-b47d-74dfb0d16108",
                                "text": "De afgrenzingen tussen groepen kunnen van land tot land enorm verschillen."
                            },
                            {
                                "example_id": "1b6b0aed-e3ee-4699-8229-ac3c9af3dbbe",
                                "sense_id": "cec9d8a0-6679-3229-b47d-74dfb0d16108",
                                "text": "Nationale identiteit opvatten als een middel tot afgrenzing, een eigenschap om anderen uit te sluiten en tot vijand te maken vindt hij gevaarlijk."
                            }
                        ]
                    }
