                    {
                        "sense_id": "4edd4934-a6ae-3251-8b10-2250780c8274",
                        "entry_id": "9186295a-be9a-38c8-a243-8d8fc5808c34",
                        "glosses": [
                            "vermehrte Adrenalinausschüttung (als Folge eines Erregungszustandes oder einer Stresssituation), die zu erhöhtem Blutdruck und gesteigerter Herztätigkeit führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "942b4f29-1778-4e91-981d-728d9c8673ef",
                                "sense_id": "4edd4934-a6ae-3251-8b10-2250780c8274",
                                "text": "„Ich hatte sogar das Gefühl, als verlangte er geradezu danach, dass ich ihn schlage, nur damit er einen ordentlichen Adrenalinstoß bekommt.“"
                            },
                            {
                                "example_id": "47454f56-7157-4425-93c5-04a91b83019b",
                                "sense_id": "4edd4934-a6ae-3251-8b10-2250780c8274",
                                "text": "„Ein Erinnerungsblitz an eine ähnliche Szene ließ einen Adrenalinstoß durch ihren Körper schießen; sie trat mit den Füßen aus und bekam Kontakt mit dem Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
