                        "entry_id": "91a1a8f0-7797-3fe4-830c-14e70e00204e",
                        "glosses": [
                            "Membre ou partisan de l’Action démocratique du Québec (1994-2012)."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "03fc7ba1-0770-4b08-bac9-9230594bb165",
                                "sense_id": "7086d6b9-e2cb-3bde-8818-ec835f054925",
                                "text": "Au cours de la campagne, il a demandé à M. Boisclair de se désister, critiquant l’absence de véritable débat électoral en raison de l’absence des libéraux et des adéquistes."
                            },
                            {
                                "example_id": "bb1f2739-e9e3-42bd-afb0-7a79e9c3a60a",
                                "sense_id": "7086d6b9-e2cb-3bde-8818-ec835f054925",
                                "text": "Quant aux adéquistes, bon nombre sont en réalité des « orphelins de Bouchard », et ils seraient sans doute ravis de retrouver leur père."
                            }
                        ]
                    },
                    {
                        "sense_id": "25819206-5df0-3696-a9bc-b96559858f31",
                        "entry_id": "91a1a8f0-7797-3fe4-830c-14e70e00204e",
