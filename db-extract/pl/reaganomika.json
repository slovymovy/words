                        "glosses": [
                            "polityka gospodarcza prowadzona w USA za prezydentury Ronalda Reagana, cechująca się obniżaniem podatków, zmniejszaniem wydatków budżetowych, ograniczaniem ingerencji państwa w gospodarkę i ograniczaniem inflacji przez kontrolę ilości pieniędzy w obiegu"
                        ],
