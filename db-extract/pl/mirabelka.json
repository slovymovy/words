                    {
                        "sense_id": "1bd965b8-9b5f-32a2-ab4f-c8f4c5da2c22",
                        "entry_id": "cd36bdb8-d3ce-3ffd-8ff5-6b3052bfc5ca",
                        "glosses": [
                            "odmiana śliwy domowej o małych żółtych owocach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13280f8-9bc8-4e40-a225-858a8b794610",
                                "sense_id": "1bd965b8-9b5f-32a2-ab4f-c8f4c5da2c22",
                                "text": "W owocach mirabelki miąższ łatwo odchodzi od pestki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "720b60e4-e245-3f7d-b504-cbea2d94ea92",
                        "entry_id": "cd36bdb8-d3ce-3ffd-8ff5-6b3052bfc5ca",
