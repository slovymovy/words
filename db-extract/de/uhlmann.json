                ],
                "senses": [
                    {
                        "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                        "entry_id": "f1705701-23fc-3a7c-a352-a2c13eb29aea",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "487f95e9-1c5e-4b1f-adec-049f2dff7db2",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Frau Uhlmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a7626540-14f5-4918-a9fa-2c088aabcc81",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Herr Uhlmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f0d1253f-e733-4150-80f2-6affebed4520",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Die Uhlmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9ecb8ba2-1416-42cf-9a54-562519ed0e58",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Der Uhlmann trägt nie die Schals, die die Uhlmann ihm strickt."
                            },
                            {
                                "example_id": "10f18106-b6e7-40dd-9f83-91d238599576",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Uhlmann kommt, geht der Herr Uhlmann.“"
                            },
                            {
                                "example_id": "5f08bfbc-e3e1-4cca-8764-9604da1db987",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Uhlmann kommt und geht."
                            },
                            {
                                "example_id": "4f259d52-8868-40c8-b856-c5322e9901ac",
                                "sense_id": "7c8a7e32-69f7-32f3-b864-1c923f078809",
                                "text": "Uhlmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
