    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0139cff6-df96-3433-bc41-c97453f12221",
                "word": "usufructuary",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1e6b769-1041-35ff-b246-81a513861049",
                        "entry_id": "0139cff6-df96-3433-bc41-c97453f12221",
                        "glosses": [
                            "Of or pertaining to a usufruct."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "26114e07-2c6b-4d2b-8700-32beedf1aa01",
                                "sense_id": "e1e6b769-1041-35ff-b246-81a513861049",
                                "text": "By this longobard Law the Tenant had only a uſufructuary poſſeſſion of the Fee, the Lord reſerving the propriety or Dominum directum to himself."
                            },
                            {
                                "example_id": "4ce9f101-ac3d-4f8f-a652-9be7dbfb727c",
                                "sense_id": "e1e6b769-1041-35ff-b246-81a513861049",
                                "text": "[T]he French are not ſo ſcruplous; but in the abſoluteſt Monarchy of Europe, plainly declare that their King hath but a uſufructuary right to his Kingdom, and the Territories belonging thereunto, or that he can any way charge them with his debts, or alienate, or diſpoſe of them; without the conſent of the States of France, […]"
                            },
                            {
                                "example_id": "036fb367-ec05-4027-8004-f6f15a46a488",
                                "sense_id": "e1e6b769-1041-35ff-b246-81a513861049",
                                "text": "While water itself is personal property, a water right is a real property interest, a so-called usufructurary right, a right to use water from a specific source for a specific use."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59416036-0cf8-4204-8326-30c1046a528a",
                        "source_entry_id": "0139cff6-df96-3433-bc41-c97453f12221",
                        "source_sense_id": "e1e6b769-1041-35ff-b246-81a513861049",
                        "source_sense_description": "of or pertaining to a usufruct",
                        "target_lang_word": "usufructuaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usufructuaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dea0e3d-00b4-33f6-b2ce-ef6d43c3a6fe",
                                        "entry_id": "74622d7f-5250-3c2f-9938-5e0abc1e71d3",
                                        "glosses": [
                                            "Qui a rapport à un usufruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5c2a379-5db1-482b-8c89-6401e8fd484e",
                                                "sense_id": "3dea0e3d-00b4-33f6-b2ce-ef6d43c3a6fe",
                                                "text": "Obligation de l’usufruitier : (…) À la fin de l’usufruit, il doit restituer la chose usufructuaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b904a9a-2dc6-3cbd-b731-b329336301a3",
                                        "entry_id": "74622d7f-5250-3c2f-9938-5e0abc1e71d3",
                                        "glosses": [
                                            "Qui ne donne que la faculté de jouir des fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b0707a9-df96-4ec6-a058-88051e217642",
                                                "sense_id": "1b904a9a-2dc6-3cbd-b731-b329336301a3",
                                                "text": "Ils ont conclu que les premiers habitants autochtones qui vivaient sur cette terre depuis des temps immémoriaux ne détenaient aucun droit de propriété réelle, mais jouissaient plutôt simplement d’un «droit personnel et usufructuaire», qui constituait une servitude sur le titre de propriété de la Couronne, lequel aurait été absolu en l’absence de celui-ci."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "usufructuaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80fff68a-8563-3b49-bd36-d1f8f1715f22",
                                        "entry_id": "76053374-1875-3766-98e2-7aee06b9aa75",
                                        "glosses": [
                                            "Usufruitier"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d974ede5-c885-4616-a7fd-7e1a0aa17833",
                                                "sense_id": "80fff68a-8563-3b49-bd36-d1f8f1715f22",
                                                "text": "Francois, pere et legitime administrateur et usufructuaire de notre tres cher et tres amé filz le dauphin, duc et Sr propriétaire des pays et duché de Bretaigne, a tous presens et advenir, salut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a3e1301-6fa8-4bad-9e6b-42400683d3c4",
                        "source_entry_id": "0139cff6-df96-3433-bc41-c97453f12221",
