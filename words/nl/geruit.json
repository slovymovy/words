                                "target_lang_word": "остеклённый",
                                "target_lang_sense_clarification": "со вставленными стёклами"
                            },
                            {
                                "target_lang_word": "с переплётом",
                                "target_lang_sense_clarification": "с решётчатыми стёклами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
