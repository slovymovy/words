                                            "Used other than figuratively or idiomatically: see break, open."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58f8be52-2af2-42d7-ad09-c6ae744c892f",
                                                "sense_id": "4e9ee0e9-7519-3eb0-b3f1-fc14d833a1f1",
                                                "text": "Lacking a corkscrew, he broke the bottle open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a6f9a5-e3ed-32b8-bc41-b4a7d05fd2e0",
                                        "entry_id": "a00e6003-5a3c-3818-b768-80f8f4a72ef4",
                                        "glosses": [
                                            "To make a breakthrough on a mystery or problem; to cause a breakthrough to be made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863516f3-4af8-4741-b07c-9bf67ee94762",
                                                "sense_id": "d6a6f9a5-e3ed-32b8-bc41-b4a7d05fd2e0",
                                                "text": "I think I broke this case open."
                                            },
                                            {
                                                "example_id": "f39fea8c-cbfb-4dd3-af4a-087e1407d809",
                                                "sense_id": "d6a6f9a5-e3ed-32b8-bc41-b4a7d05fd2e0",
                                                "text": "The new evidence has broken this case open."
                                            }
                                        ]
