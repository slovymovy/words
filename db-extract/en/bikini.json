                    {
                        "translation_id": "5c2e5086-1387-4adb-b4c2-310e60f6eb2a",
                        "source_entry_id": "b769b982-b6aa-3c7a-b5e2-942bc1c15a6f",
                        "source_sense_id": "10cd3e2b-d2b8-3e71-b169-3501fad2e5cc",
                        "source_sense_description": "zweiteilige Badebekleidung für Damen",
                        "target_lang_word": "Bikini",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bikini",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                        "entry_id": "25adb8c6-2760-3f77-817f-f435baea6693",
                                        "glosses": [
                                            "zweiteilige Badebekleidung für Damen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5235bdc2-cb04-47b3-bc7d-de9870a1d4fb",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Sie kramte ihren Bikini aus einem Koffer und seine Badehose – es war so warm.“"
                                            },
                                            {
                                                "example_id": "9d51aa75-31cf-4904-927d-288df1ef14e2",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Sie zog Renate mit sich fort: ‚Kommst du mit baden?‘ ‚Hab’ keinen Bikini mit.‘“"
                                            },
                                            {
                                                "example_id": "5fcc5940-6cd9-485d-bfee-408b243b92f7",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Im Bad hing gelb Susannes Bikini.“"
                                            },
                                            {
                                                "example_id": "b8efaa33-4a0a-4c55-903c-4b371a17c7b7",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Der Bikini ist ein ‚Nichts aus Stoff, das immer noch Frauen auf der ganzen Welt begeistert, wie etwa die Französin Brigitte: ‚Für mich gehört der Bikini am Strand dazu. Ein Synonym für Ferien, Freiheit. Und es gibt so wunderschöne Bikinis – das ist auch ein Synonym für Jugend für mich!‘“"
                                            },
                                            {
                                                "example_id": "0c686644-ded9-4e04-9d96-9903d8233d82",
                                                "sense_id": "85e30479-04bf-33bc-949f-950f21083a08",
                                                "text": "„Ach, hätte ich doch nur das Bikini dabei – ein kühles Bad an diesem wildromantischen Ort wäre traumhaft, denke ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
