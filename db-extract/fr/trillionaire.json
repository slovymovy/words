                            {
                                "example_id": "49c00385-1cd6-49c5-9f54-4c5a36755ec6",
                                "sense_id": "9bf33031-3cf2-391f-92a1-0f4447897b94",
                                "text": "Elon Musk est sur la bonne voie pour devenir le premier trillionaire de l’histoire de l’humanité. D’ici 2024, son compte en banque pourrait comptabiliser un million de millions de dollars."
                            }
                        ]
                    }
