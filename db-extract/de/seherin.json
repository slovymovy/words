                    {
                        "sense_id": "90ef89f3-8835-368c-b952-4731a006c22d",
                        "entry_id": "dfbc02fc-df5f-3f87-9d7f-56d7eea76a56",
                        "glosses": [
                            "eine weibliche Person, der zugeschrieben wird, übernatürliche Dinge wahrzunehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8b009d-525c-4503-870f-e7f6de13db8a",
                                "sense_id": "90ef89f3-8835-368c-b952-4731a006c22d",
                                "text": "Die Seherin konnte als einzige wissen, wo sich das Portemonnaie befindet."
                            },
                            {
                                "example_id": "b8a33dfb-628b-48a9-be64-a4ff77cbbd62",
                                "sense_id": "90ef89f3-8835-368c-b952-4731a006c22d",
                                "text": "„Bald zieht eine völva von Hof zu Hof, eine heidnische Seherin.“"
                            },
                            {
                                "example_id": "084a77fd-c548-4cfb-bb76-d122d285c5f8",
                                "sense_id": "90ef89f3-8835-368c-b952-4731a006c22d",
                                "text": "„Die Seherin musste befragt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
