                    {
                        "translation_id": "565acc5f-87ce-49ff-8e94-61297c721b9c",
                        "source_entry_id": "5ff0df1b-ec6d-38aa-b6e1-40679118b9b7",
                        "source_sense_description": "Experiencing stupefaction",
                        "target_lang_word": "betäubt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betäubt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c94342b1-3664-358c-9dfc-b2f4421bef72",
                                        "entry_id": "7804ade6-84bb-3a0f-b1f1-692849dd1269",
                                        "glosses": [
                                            "(mittels eines Betäubungsmittels oder Ähnliches) gegen Schmerzen unempfindlich gemacht oder in einen künstlichen Schlaf versetzt"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da71130-220d-4432-9cc8-b8d5d8d77866",
                                                "sense_id": "c94342b1-3664-358c-9dfc-b2f4421bef72",
                                                "text": "„Auch Videos von \"betrunkenen, betäubten, bewusstlosen oder schlafenden Personen\" sind nicht erlaubt.“"
                                            },
                                            {
                                                "example_id": "543d8e09-18cc-4132-8416-28e239aab6c5",
                                                "sense_id": "c94342b1-3664-358c-9dfc-b2f4421bef72",
                                                "text": "„Nicht alle Mädchen nämlich konnten bislang identifiziert werden, da der Täter die Gesichter der betäubten Patientinnen oftmals mit Tüchern abdeckte.“"
                                            },
                                            {
                                                "example_id": "f4d5e3d7-eb22-4b05-bbad-85c240e28be2",
                                                "sense_id": "c94342b1-3664-358c-9dfc-b2f4421bef72",
                                                "text": "„Die Anklage warf dem Mediziner «grobe Fahrlässigkeit» vor, weil er seinen betäubten Patienten unter anderem aus den Augen gelassen haben soll.“"
                                            },
                                            {
                                                "example_id": "811aa34f-ffac-469f-9116-d84dcdbd5b8b",
                                                "sense_id": "c94342b1-3664-358c-9dfc-b2f4421bef72",
                                                "text": "„Die nur lokal betäubten Patienten gehen sechs Stunden nach dem minimal invasiven Eingriff nach Hause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7785381c-0fbb-3ac9-ae8f-73dfe1f6bee8",
                                        "entry_id": "7804ade6-84bb-3a0f-b1f1-692849dd1269",
                                        "glosses": [
                                            "physisch und psychisch vorübergehend (leicht) eingeschränkt/gedämpft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f734c9-77f8-49e5-b853-560064cd7d55",
                                                "sense_id": "7785381c-0fbb-3ac9-ae8f-73dfe1f6bee8",
                                                "text": "„Niedergeschlagen und halb betäubt stützte ich meine Ellenbogen auf die Brüstung des vergitterten Zellenfensters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
