                        "examples": [
                            {
                                "example_id": "1647976e-0a5c-4b0e-9a4b-31e536ea5d49",
                                "sense_id": "a648cd29-7b2f-38a3-a9f3-ad19c823cfe9",
                                "text": "Anaïs pétrissait son grand mouchoir, puis le dépliait pour le refroisser à nouveau."
                            },
                            {
                                "example_id": "ba0d43d4-1e87-4658-a5d5-b0b22d4ef45a",
                                "sense_id": "a648cd29-7b2f-38a3-a9f3-ad19c823cfe9",
                                "text": "Souvent, elle faisait et refaisait ces gestes qu’on ne fait pas en public : elle froissait et refroissait sa jupe entre ses cuisses."
                            }
                        ]
                    }
