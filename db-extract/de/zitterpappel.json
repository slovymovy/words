                "senses": [
                    {
                        "sense_id": "ae1f8263-fc6e-3f5f-a8ff-3f3f9292050b",
                        "entry_id": "e2499f10-2cc6-3b02-a3e8-906d2d8655b9",
                        "glosses": [
                            "Ein Laubbaum aus der Gattung der Pappeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e61506-8eb4-4022-9e3a-4e709c2d33dd",
                                "sense_id": "ae1f8263-fc6e-3f5f-a8ff-3f3f9292050b",
                                "text": "Die Bezeichnung Zitterpappel hat etwas mit den Bewegungen der Blätter im Wind zu tun."
                            },
                            {
                                "example_id": "f42d377a-4bb9-42af-acda-6bbe760098cc",
                                "sense_id": "ae1f8263-fc6e-3f5f-a8ff-3f3f9292050b",
                                "text": "„Ich hatte erwartet, den Garten halb zugewachsen vorzufinden, jetzt, wo sich niemand darum kümmerte, aber so war es nicht, die Kiefernhecke war schön und dicht, der Rasen frei von Löwenzahn, die Zitterpappel schlank und wohlfrisiert, auch wenn sie inzwischen ebenso hoch war wie die Fahnenstange.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
