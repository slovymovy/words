                        "glosses": [
                            "The act of drawing near; an approach."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b9ff1863-b42a-4dba-a28d-895ee8546178",
                                "sense_id": "0d645325-f25b-3104-91ba-0f0f857c237e",
                                "text": "From this same Principle also […] proceeds […] the appropinquation of two floating bodies, as Bubbles, Corks, Sticks, Straws, &c. one towards another."
                            },
                            {
                                "example_id": "fae0de6d-e4ec-4fe7-a48b-6656d1c43081",
                                "sense_id": "0d645325-f25b-3104-91ba-0f0f857c237e",
                                "text": "Surely, this operation hath this millenary doctrine had upon the hearts of men, that, though they are thereupon apt to expect an appropinquation of their Saviour for their happy advantage, yet they resolutely put off the thought of his coming to the general judgment of the world for many generations."
                            }
                        ]
                    }
