                    "frequency": "High",
                    "semantic_group_id": "person_insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He treats his employees like <w>scum</w> and refuses to pay them fairly.",
                            "target_lang_translations": {
                                "ru": "Он обращается со своими сотрудниками как с <w>отребьем</w> и отказывается платить им по справедливости.",
                                "es": "Trata a sus empleados como a <w>escoria</w> y se niega a pagarles justamente."
                            }
                        },
                        {
                            "text": "The police arrested the <w>scum</w> responsible for the violent attack.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала <w>подонков</w>, ответственных за это жестокое нападение.",
