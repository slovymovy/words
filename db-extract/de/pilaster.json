                    {
                        "translation_id": "e4ded329-489b-4483-8557-bc67304c4c22",
                        "source_entry_id": "e6a5107b-ec38-3e72-a862-8ec213bef54d",
                        "source_sense_id": "4302869b-ba6d-327e-bd05-cd76c93ee35d",
                        "source_sense_description": "Architektur: teilweise in den Mauerverbund integrierter Pfeiler mit Basis und Kapitell",
                        "target_lang_word": "pilastre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilastre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1273bc4b-12ea-3441-a427-d3c9e39d5357",
                                        "entry_id": "f0d575a4-8baa-37a2-ac5c-d7993c3726da",
                                        "glosses": [
                                            "Pilier carré, auquel on donne les mêmes proportions et les mêmes ornements qu’aux colonnes et qui ordinairement est engagé dans un mur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f522ede-0aac-470d-9c58-f8be257b763d",
                                                "sense_id": "1273bc4b-12ea-3441-a427-d3c9e39d5357",
                                                "text": "Celle-ci divise en deux l’assise de panneresses originale qui, à gauche du pilastre, se poursuit (entière)."
                                            },
                                            {
                                                "example_id": "6d619211-aaf3-45cd-b785-0c400cde3590",
                                                "sense_id": "1273bc4b-12ea-3441-a427-d3c9e39d5357",
                                                "text": "Combien de balcons en ferronnerie, de mascarons, de pilastres nous restituent l’image de ce que fut cette cité au XVIᵉ, au XVIIᵉ, au XVIIIᵉ siècle."
                                            },
                                            {
                                                "example_id": "383f24df-d14a-4c44-9832-1f2c26e9b7b2",
                                                "sense_id": "1273bc4b-12ea-3441-a427-d3c9e39d5357",
                                                "text": "Il visita la Grande Galerie dont il détailla la splendeur, la parqueterie, les pilastres de marbre, les bronzes et les antiques qui paraissaient s'aboucher à travers les trois cent cinquante-sept miroirs."
                                            },
                                            {
                                                "example_id": "9ceb7cb6-8f47-457d-9edd-d9154874c683",
                                                "sense_id": "1273bc4b-12ea-3441-a427-d3c9e39d5357",
                                                "text": "Pour bien faire, il faudrait que d'habiles architectes présidassent aux plus chétifs bâtiments. C'est une grande erreur de croire qu'il n'y ait que les colonnes et les pilastres, que les temples et les palais qui soient du ressort de l'architecture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
