                    {
                        "translation_id": "3cb236bc-2bb5-4bb0-bfe3-5c429da76d5a",
                        "source_entry_id": "03565126-7de7-3699-b68f-ed26c23a8d99",
                        "source_sense_id": "7a8251cc-f4d1-3058-8813-8418d35ee549",
                        "target_lang_word": "polyglotte",
