                                    }
                                ]
                            },
                            {
                                "target_word": "épaississant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "887dcb46-e423-38ba-b92b-ca8955596eba",
                                        "entry_id": "7a3b7565-44aa-395d-b9e6-f2d913149254",
                                        "glosses": [
                                            "Substance destinée à épaissir les préparations alimentaires liquides aqueuses, telles que les soupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc5008d-6268-43e9-bbf6-69b81c3834ef",
                                                "sense_id": "887dcb46-e423-38ba-b92b-ca8955596eba",
                                                "text": "Si le phénomène persiste de manière importante, demandez conseil à votre médecin pour changer le lait ou utiliser un épaississant."
                                            },
                                            {
                                                "example_id": "a102150e-85a1-438a-a466-603a7db9ec30",
                                                "sense_id": "887dcb46-e423-38ba-b92b-ca8955596eba",
                                                "text": "Les extraits d’algues, en particulier les carraghénanes, sont utilisés comme épaississants ou gélifiants dans les desserts lactés, les soupes, les glaces pour ne nommer que ceux-là."
                                            }
                                        ]
                                    }
                                ]
                            },
