                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb2284b4-c822-4d42-80e9-2a97c18f9329",
                                                "sense_id": "f0d961a9-03dc-36d6-a89e-496b932b8975",
                                                "text": "Generativity is a broad property of systems that denotes the capacity of agents within them to connect to others and produce unanticipated outcomes and change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b55e8e7-a472-39dd-b1ae-edb853fee8b1",
                                        "entry_id": "8d7c0fc5-3078-37ec-b0d0-237b3f576002",
                                        "glosses": [
                                            "The ability to transcend personal interests to provide care and concern for younger and older generations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58607474-814f-4cac-a4b5-eea166a02609",
                                                "sense_id": "7b55e8e7-a472-39dd-b1ae-edb853fee8b1",
                                                "text": "Most broadly, Erikson (1975) considers generativity to mean any caring activity that contributes to the spirit of future generations, such as the generation of new or more mature persons, products, ideas, or works of art."
                                            }
