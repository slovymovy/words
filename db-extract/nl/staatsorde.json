                        "sense_id": "f35d59ea-da73-398c-8633-4b5126f69301",
                        "entry_id": "d159800f-adec-3093-a608-49408a687f30",
                        "glosses": [
                            "wijze waarop de overheid van een land is georganiseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8cebc21-ad83-4ccf-9c77-4e09d0e36182",
                                "sense_id": "f35d59ea-da73-398c-8633-4b5126f69301",
                                "text": "Nadat Paulus melding gemaakt heeft van de bijzondere plichten, wil hij nu dat allen in het algemeen vermaand worden om rustig de staatsorde in ere te houden, aan de wetten onderdanig te zijn, en de magistraten te gehoorzamen."
                            }
                        ]
                    },
                    {
                        "sense_id": "97b1152c-f914-30b7-8b3f-fd37692bd507",
                        "entry_id": "d159800f-adec-3093-a608-49408a687f30",
                        "glosses": [
                            "rust en orde in een land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7238e3d3-220b-4aac-9178-e5c6ced3a7ee",
                                "sense_id": "97b1152c-f914-30b7-8b3f-fd37692bd507",
                                "text": "De wijsgeer Plato zei dat het vragen van rente de stabiliteit van een staat zou aantasten. De bewakers van de staatsorde zouden er corrupt van worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2adec30-ac9d-31fe-8673-37b9633ec2e4",
                        "entry_id": "d159800f-adec-3093-a608-49408a687f30",
                        "glosses": [
                            "onderscheiding die de nationale overheid verleent aan mensen die een uitzonderlijke prestatie hebben geleverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00d37da3-5916-4270-bf4d-ccdfa66e6931",
                                "sense_id": "a2adec30-ac9d-31fe-8673-37b9633ec2e4",
                                "text": "Op 4 april 1892 ging de Orde van Oranje-Nassau als nieuwe Nederlandse staatsorde haar eerste levensjaar in."
                            }
                        ]
                    }
