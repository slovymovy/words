                        "examples": [
                            {
                                "example_id": "aa07fc5f-4b76-489f-a26c-455f335cdd89",
                                "sense_id": "28e77a1c-408b-39c5-904f-f98815901216",
                                "text": "Het systeem van dijkaanleg bestond uit het verhogen c.q. versterken van de langs de rivier gelegen oeverwalgronden en de aanleg van dwarsdijken (sytwenden) haaks op de oeverwal of rivierdijk en van achterdijken (beringen) die tezamen het water uit de kommen moesten weren."
                            },
                            {
                                "example_id": "a9890a69-57b1-4a4b-babd-f2cbe80adca5",
                                "sense_id": "28e77a1c-408b-39c5-904f-f98815901216",
                                "text": "⧖ Bij inpoldering van een vóórliggend schor werden de bedijkers door den Soeverein gemachtigd den thans nutteloozen achterdijk in bezit te nemen en te slechten."
                            }
                        ]
                    }
