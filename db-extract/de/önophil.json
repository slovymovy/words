                    }
                ],
                "senses": [
                    {
                        "sense_id": "0dfad64c-fe4d-336c-921e-6516dcf5d3e3",
                        "entry_id": "e4e61dbc-1a87-357a-8a55-9c7080ce4274",
                        "glosses": [
                            "oenophilic, vinophilic"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddcb4d0e-7a1c-4b50-9014-539a6e86f33b",
                                "sense_id": "0dfad64c-fe4d-336c-921e-6516dcf5d3e3",
                                "text": "Wir sind aus dem Kampf um eine bessere Weinberichterstattung als Sieger hervorgegangen, wir haben viel zum enormen Interesse beigetragen, das der Wein heute geniesst, wir haben önophile Leidenschaften ausgelöst."
                            },
                            {
                                "example_id": "0b04d4cc-3ac5-4a87-88ed-57de5517c24f",
                                "sense_id": "0dfad64c-fe4d-336c-921e-6516dcf5d3e3",
                                "text": "Patron Guillaume Dupré ist kein Unbekannter in önophilen Kreisen. Der Önologe aus Bordeaux – Markenzeichen: Bart und ein in die Stirn fallender Scheitel – hat mit dem „Coinstot Vino“bereits^([sic]) sein drittes erfolgreiches Weinlokal an der Seine eröffnet."
                            }
                        ]
                    }
