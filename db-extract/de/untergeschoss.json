                                "target_senses": [
                                    {
                                        "sense_id": "185966eb-c9a5-315d-88f3-ba7cdb8cba99",
                                        "entry_id": "19e94232-e869-3bb0-ac3c-444f59b07886",
                                        "glosses": [
                                            "A floor of a building below ground level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54fabc50-39d1-412e-bc6d-d4c99acf02f8",
                                                "sense_id": "185966eb-c9a5-315d-88f3-ba7cdb8cba99",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48a29515-874a-315d-987f-38b631af1d67",
                                        "entry_id": "19e94232-e869-3bb0-ac3c-444f59b07886",
                                        "glosses": [
                                            "A floor of a building below ground level.",
                                            "Ellipsis of semi-basement, a floor mostly below grade"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b3a36e2-69b2-3758-9c52-2f1d9dd4d01b",
                                        "entry_id": "19e94232-e869-3bb0-ac3c-444f59b07886",
                                        "glosses": [
                                            "A mass of igneous or metamorphic rock forming the foundation over which a platform of sedimentary rocks is laid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b46b329-5985-33d2-8477-90237863d877",
