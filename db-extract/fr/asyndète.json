                "senses": [
                    {
                        "sense_id": "52a5a12a-6ff3-3fab-b06a-d0509721f4bf",
                        "entry_id": "d2d4132e-7d81-3bde-92d2-1eea8a3f1568",
                        "glosses": [
                            "Suppression des particules de coordination ou des conjonctions, et par extension de toute liaison attendue ou logique, dans l’ordre grammatical ou sémantique, telle : bon pied, bon œil."
                        ],
                        "tags": [
                            "rhetoric"
                        ],
                        "examples": [
                            {
                                "example_id": "d20a2b61-eca7-4fb3-8d33-6058c7c6017d",
                                "sense_id": "52a5a12a-6ff3-3fab-b06a-d0509721f4bf",
                                "text": "Les raisons qui ont amené les auteurs à employer l’asyndète doivent être étudiées séparément pour l’oeuvre de chaque auteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
