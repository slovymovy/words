                        "translation_id": "a3258b02-e86a-4510-925a-835b41def9ed",
                        "source_entry_id": "8042c9cb-d6fc-33ad-aa0e-aa67607d563a",
                        "source_sense_id": "4fab38ca-95ab-3689-b344-190a38b423f7",
