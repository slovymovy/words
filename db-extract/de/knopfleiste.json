                "senses": [
                    {
                        "sense_id": "1ed941f4-6b88-380b-b391-0acaa5341805",
                        "entry_id": "24e5a4e8-7256-3cac-a35a-475238edef94",
                        "glosses": [
                            "längliches, mit Knöpfen versehenes Stoffstück an Hosen und Hemden an der zu schließenden Seite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c832ba9-605c-458f-8687-7f0c085d30a7",
                                "sense_id": "1ed941f4-6b88-380b-b391-0acaa5341805",
                                "text": "„Er kleidet sich im Alltag europäisch, in Jeans und weichen Mokassins, das Hemd ist weit aufgeknöpft, eine Sonnenbrille in die Knopfleiste eingehakt, die krausen Haare meistens zum Zopf gebunden.“"
                            },
                            {
                                "example_id": "caffeb55-7742-42b5-bbbd-2f948e82d391",
                                "sense_id": "1ed941f4-6b88-380b-b391-0acaa5341805",
                                "text": "„Erst beim Aufknöpfen der Hose werde der Besitzer mit dem dezenten Schriftzug an der inneren Knopfleiste an ihre Herkunft erinnert, grinst Brenninkmeijer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
