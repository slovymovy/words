                    {
                        "translation_id": "4cc506df-6978-4a0e-8256-439b6c822899",
                        "source_entry_id": "647fef5a-94f2-329f-b21d-f9df280434ad",
                        "source_sense_id": "668e9986-5cb2-3bc1-9dc9-16c0936d0a58",
                        "target_lang_word": "surdité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surdité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                        "entry_id": "3d78ce1f-8dda-3512-a3c1-e0c8557eb6a9",
                                        "glosses": [
                                            "Perte ou diminution notable du sens de l’ouïe."
                                        ],
                                        "tags": [
                                            "Nosologie",
                                            "Handicap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9577b298-265e-4416-82ac-cb0b8bdec264",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Il est atteint de surdité depuis sa naissance, ce qui a provoqué son mutisme : qui n’entend pas ne peut que difficilement apprendre à parler."
                                            },
                                            {
                                                "example_id": "9c68914d-99af-4cb7-abdd-59be7df838a4",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Sa surdité augmente : ses proches doivent lui parler de plus en plus fort pour qu’il les entende."
                                            },
                                            {
                                                "example_id": "8eafb2af-968a-4e98-a875-811950557dd3",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "« Vous êtes peut-être affligée de surdité intermittente, répondit insolemment M. de Charlus. »"
                                            },
                                            {
                                                "example_id": "6f6a5eeb-1468-4a25-a035-8d32b9f8d11d",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Il connaissait, par sa propre expérience, la profondeur, la surdité du sommeil chez les hommes sains qui peinent depuis l’aube au crépuscule."
                                            },
                                            {
                                                "example_id": "117db97d-5d68-4b61-a1c7-5fcaa9656f92",
                                                "sense_id": "1345d19a-e7ca-3f82-ab8d-2cf3229a28b1",
                                                "text": "Bien que les surdités syndromiques ne représentent que 10 à 15 % (Marlin & Denoyelle, 2016), les atteintes associées physiques ou neuro-développementales sont retrouvées chez 30 à 40 % des enfants présentant une surdité (SFORL, 2018)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
