                                "sense_id": "9e2e3ade-c05c-31aa-8604-51e7caa6c774",
                                "text": "In Mineralwasser ist Kohlensäure enthalten."
                            },
                            {
                                "example_id": "bd5af6f3-2e24-4519-a43e-940ef35375c3",
                                "sense_id": "9e2e3ade-c05c-31aa-8604-51e7caa6c774",
                                "text": "„Sie wird unfruchtbar werden; alles Holz und alle Steinkohle wird sich in Kohlensäure verwandeln und kein Lebewesen mehr existieren können.“"
                            }
                        ],
