                        "entry_id": "e6c769ec-9ddd-38e7-9f03-da34dc974659",
                        "glosses": [
                            "een verzamelnaam voor alle mensen ter wereld met al hun onderlinge sociale relaties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9c6ded-fc5c-4c42-959b-ed274a66fd96",
                                "sense_id": "0feb0e94-7872-33a5-b35c-b941c9d3be2a",
                                "text": "Misdaden tegen de mensheid."
                            },
                            {
                                "example_id": "6b7331c5-04fa-4447-9d1c-b9b121e029cd",
                                "sense_id": "0feb0e94-7872-33a5-b35c-b941c9d3be2a",
                                "text": "Koraalriffen zijn van levensbelang voor het leven in de oceanen en daardoor ook voor de mensheid. 25 procent van het zeeleven leeft in en rond koraalriffen. Ze zijn van belang voor de visserij, toerisme en bescherming van kustlijnen tegen erosie en stormen. Het is nog onduidelijk of en wanneer het huidige proces van verbleking stopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9184516e-3cd7-4f70-8d6b-6fc9e6f0323e",
                        "source_entry_id": "e6c769ec-9ddd-38e7-9f03-da34dc974659",
                        "source_sense_id": "0feb0e94-7872-33a5-b35c-b941c9d3be2a",
                        "source_sense_description": "een verzamelnaam voor alle mensen ter wereld met al hun onderlinge sociale relaties",
                        "target_lang_word": "Menschheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Menschheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                        "entry_id": "79d6f553-df19-3c87-aebf-1851903fdfc2",
                                        "glosses": [
                                            "Gesamtheit aller Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a5d002f-7e96-41cc-90fa-f79c1bacba34",
                                                "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                                "text": "Das Problem des Klimawandels betrifft die ganze Menschheit, besonders aber jenen Teil, der in den Entwicklungsländern lebt."
                                            },
                                            {
                                                "example_id": "997899d6-13c2-4e55-8158-3352c9e75dd5",
                                                "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                                "text": "„Die Menschheit hat gelernt, dass Schweigen und Ignoranz keine düsteren Realitäten verändern, und dass nur kritisches Denken, freie Rede und offene Kritik zu Fortschritt führen.“"
                                            },
                                            {
                                                "example_id": "bec460fc-52c8-4a93-8f92-8e6a93f3f144",
                                                "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                                "text": "„Dies ist ein kleiner Schritt für einen Menschen, aber ein gewaltiger Sprung für die Menschheit.“ (Im engl. Original: „That's one small step for [a] man, one giant leap for mankind.“)"
                                            },
                                            {
                                                "example_id": "735d4fa8-3a45-4f53-9faf-40a9b6fd4425",
                                                "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                                "text": "„Wenn überhaupt, dann kann die Menschheit meiner festen Überzeugung nach nur aus Erfahrungen lernen, also aus der Vergangenheit.“"
                                            },
                                            {
                                                "example_id": "3b789206-62b1-416c-a2ac-9c2a5d23a3d9",
                                                "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                                "text": "„In der Zubereitung von Kaffee machte die Menschheit seitdem rasche Fortschritte.“"
                                            },
                                            {
                                                "example_id": "a3c3008a-6f5a-41b4-81ec-328e8b6b92b4",
                                                "sense_id": "47907568-eea3-3f15-8dd1-4ac1a58f1c5e",
                                                "text": "„Erst wenn die Mutigen klug und die Klugen mutig geworden sind, wird das zu spüren sein, was irrtümlicherweise schon oft festgestellt wurde: ein Fortschritt der Menschheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7556c967-46ea-34f6-af75-f746a5b5e479",
                                        "entry_id": "79d6f553-df19-3c87-aebf-1851903fdfc2",
                                        "glosses": [
                                            "Menschsein, Wesen des Menschen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64c91ca4-f926-4f08-bed5-59a7bcddd111",
                                                "sense_id": "7556c967-46ea-34f6-af75-f746a5b5e479",
                                                "text": "„Kritik richtet Rahner auch an eine traditionelle Theologie, die auf dem Hintergrund monophysitischer Tendenzen die Bedeutung der Menschheit Jesu für das Gottesverhältnis des Menschen nicht genügend berücksichtigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7a72ac4-8f4a-43ee-bb07-aff956fcd47d",
                        "source_entry_id": "e6c769ec-9ddd-38e7-9f03-da34dc974659",
                        "source_sense_id": "0feb0e94-7872-33a5-b35c-b941c9d3be2a",
                        "source_sense_description": "een verzamelnaam voor alle mensen ter wereld met al hun onderlinge sociale relaties",
                        "target_lang_word": "humanité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humanité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "523c06f7-027d-3c9b-9ccf-9f7ff1b01dfc",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Nature ou condition humaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdded876-7b60-4c3a-ba03-142eacf3b7a8",
                                                "sense_id": "523c06f7-027d-3c9b-9ccf-9f7ff1b01dfc",
                                                "text": "Les esclaves africains l’avaient bien compris. Ils avaient compris que l’esclavage leur ôterait leur humanité, qu’il ferait d’eux non plus des êtres, mais des choses. Qu’ils aient pris les Blancs pour des cannibales n’a rien de surprenant."
                                            },
                                            {
                                                "example_id": "ed51da2a-ce44-44b3-9b0c-fd152e0dffa6",
                                                "sense_id": "523c06f7-027d-3c9b-9ccf-9f7ff1b01dfc",
                                                "text": "Comment reconnaître dans un adulte un camarade, un être digne de confiance quand sa propre humanité a été déniée, détruite par un être humain ?"
                                            },
                                            {
                                                "example_id": "09e6339c-0270-4c4c-8416-93b2ed2bfe3e",
                                                "sense_id": "523c06f7-027d-3c9b-9ccf-9f7ff1b01dfc",
                                                "text": "Cela est au-dessus de l’humanité : Cela passe la portée des forces ordinaires de l’être humain."
                                            },
                                            {
                                                "example_id": "09c00952-e6d1-4ccb-a8c3-313a4efcb7ff",
                                                "sense_id": "523c06f7-027d-3c9b-9ccf-9f7ff1b01dfc",
                                                "text": "Payer le tribut de l’humanité : Mourir, se laisser aller à quelque faiblesse humaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "309ed66f-9b1b-31b5-ae97-9fb0008133d2",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Genre humain ou espèce humaine ; les êtres humains en général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ffe572-eed3-44f0-bf04-6fa9f73524c1",
                                                "sense_id": "309ed66f-9b1b-31b5-ae97-9fb0008133d2",
                                                "text": "Nous trouvons ici de plus sombres pressentiments ; l’auteur se demande même si notre humanité atteindra sa véritable fin : […]."
                                            },
                                            {
                                                "example_id": "e9f8184e-ca48-4bee-8805-413e3a8923c4",
                                                "sense_id": "309ed66f-9b1b-31b5-ae97-9fb0008133d2",
                                                "text": "Lentement, irrésistiblement, avec ampleur, Bert se rendit compte de l’immense tragédie qui ébranlait l’humanité, et au milieu de laquelle s’écoulait sa petite existence ; […]"
                                            },
                                            {
                                                "example_id": "2d484abd-b965-44e0-8291-b5aa6f5b77a1",
                                                "sense_id": "309ed66f-9b1b-31b5-ae97-9fb0008133d2",
                                                "text": "Ce nouvel enseignement me semble d’autant plus grave qu’il s’adresse à une humanité qui, de son propre chef, se pose aujourd’hui dans le temporel avec une décision inconnue jusqu’à ce jour."
                                            },
                                            {
                                                "example_id": "0f2f6e39-b756-4218-833d-97f942f13da8",
                                                "sense_id": "309ed66f-9b1b-31b5-ae97-9fb0008133d2",
                                                "text": "La science le permet enfin ! Car la nouveauté de ce temps « hiroshimesque » est que l’humanité est capable de suicide par désespoir, comme jadis seulement l’homme individuel. Tout s'assombrit devant l’épée de Damoclès."
                                            },
                                            {
                                                "example_id": "218140d7-c3b5-4f12-bfb1-6473094da40d",
                                                "sense_id": "309ed66f-9b1b-31b5-ae97-9fb0008133d2",
                                                "text": "Haï, Épicure le fut et le sera parce qu’il est un des héros de l’humanité. […]. Et si, à sa suite, l’ensemble de l’épicurisme fut maudit, et calomnié comme libertinage dévergondé, c’est parce qu’il guérit de la peur dont tout pouvoir, religieux ou politique, a besoin !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b83e61a4-6af6-37b2-a48e-91de6ff79c6b",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Une partie seulement du genre humain."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b63a3081-7aba-481a-b2cb-1bb6dde6fed0",
                                                "sense_id": "b83e61a4-6af6-37b2-a48e-91de6ff79c6b",
                                                "text": "Mais Beaumanoir, qui regardait comme un acte de vertu de réprimer tout sentiment d’humanité qui eût pu s’interposer entre lui et son devoir imaginaire, répéta ses ordres."
                                            },
                                            {
                                                "example_id": "a09ba45c-6792-4a0d-99e3-2896d0d3587d",
                                                "sense_id": "b83e61a4-6af6-37b2-a48e-91de6ff79c6b",
                                                "text": "Des garnis sans rideaux, des gargotes, des débits grouillants de vermine occupent — entre les loges des filles — la longueur des façades et une humanité malpropre, hébétée, loqueteuse s’y agite machinalement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd6c52b-2ef1-3d7f-9a4b-2a4f3396deef",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Bonté, sensibilité ou compassion pour les malheurs d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d9ed965-c9e5-4b23-86f8-b39b4258ae99",
                                                "sense_id": "2cd6c52b-2ef1-3d7f-9a4b-2a4f3396deef",
                                                "text": "Or, si je n'avais tardé, par humanité, à prendre les mesures disciplinaires qui s'imposaient, le drame n'aurait sans doute pas éclaté."
                                            },
                                            {
                                                "example_id": "7616051e-3e77-4d00-bcd3-b7f8cc0f8dcf",
                                                "sense_id": "2cd6c52b-2ef1-3d7f-9a4b-2a4f3396deef",
                                                "text": "J'admets même que votre art cauchemardeux et tératologique, faussement ingénu et savamment puéril, possède une valeur de signe, qu'il soit la transcription symboliquement exacte d'une civilisation qui a perdu sa table de valeurs et d'une humanité qui a peur d'elle-même."
                                            },
                                            {
                                                "example_id": "0e818080-fff5-44d2-8f5e-48297d0257bc",
                                                "sense_id": "2cd6c52b-2ef1-3d7f-9a4b-2a4f3396deef",
                                                "text": "Gravement blessés, tombés au pouvoir de l'adversaire, ils craignent pour leur vie mais sont soignés par des mains qui se révèlent fraternelles. Les trois hommes font l'expérience de l’humanité de ceux qu'ils désignaient jusque là par le terme convenu d'ennemi."
                                            },
                                            {
                                                "example_id": "0ffeb6bb-b608-4c1a-b6ca-54b58dd637e3",
                                                "sense_id": "2cd6c52b-2ef1-3d7f-9a4b-2a4f3396deef",
                                                "text": "Le respect des procédures est certes essentiel. C’est ainsi qu’une société arrive à de grandes réalisations. Mais toute directive doit passer par le filtre de l’humanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81bf384c-1267-3032-a1d5-c4659e118715",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Enseignement secondaire en Belgique."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a94f0d-2f7b-479a-bf8e-ff931b0448d9",
                                                "sense_id": "81bf384c-1267-3032-a1d5-c4659e118715",
                                                "text": "On souhaite toujours - ou presque ! - qu’il termine au moins ses humanités et obtienne le CESS. Ça nous rassure. — (Le Ligueur des parents,« On voulait qu’il termine ses humanités, il veut devenir plombier », 29 mai 2013 → lire en ligne)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96b15868-29a1-3c77-a3e6-4585c842e9fd",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Les études que l’on faisait dans les lycées ou les collèges où l’on enseignait les langues et littératures grecques et latines."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22179846-269a-49eb-8022-46f92b0da438",
                                                "sense_id": "96b15868-29a1-3c77-a3e6-4585c842e9fd",
                                                "text": "Dans les années 1980-1990, le lycée a favorisé les sciences au détriment des humanités classiques, ce qui explique pourquoi tout ce qui touche les matières littéraires a chuté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b614d53a-ba7d-3104-933a-dd15d207bac7",
                                        "entry_id": "10b5311e-b274-3176-9e4c-0d2eb5d17c2e",
                                        "glosses": [
                                            "Les études que l’on faisait dans les lycées ou les collèges où l’on enseignait les langues et littératures grecques et latines.",
                                            "Les classes où se donne cet enseignement (rhétorique ou première) inclusivement."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4c7d4d7-d4bf-4af3-a3c7-cb4046acd4e0",
                        "source_entry_id": "e6c769ec-9ddd-38e7-9f03-da34dc974659",
                        "source_sense_id": "0feb0e94-7872-33a5-b35c-b941c9d3be2a",
                        "source_sense_description": "een verzamelnaam voor alle mensen ter wereld met al hun onderlinge sociale relaties",
                        "target_lang_word": "человечество",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "человечество",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1933bed-0043-3426-88b9-65aa50e05ca9",
                                        "entry_id": "0c57d9aa-e0e8-3c85-950e-313cb860e309",
                                        "glosses": [
                                            "собир. все люди, человеческий род; человеческое общество"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4abc67f-850c-46f5-bd05-25e378153773",
                                                "sense_id": "c1933bed-0043-3426-88b9-65aa50e05ca9",
                                                "text": "Байрон бросил односторонний взгляд на мир и природу человечества, потом отвратился от них и погрузился в самого себя."
                                            },
                                            {
                                                "example_id": "b4afacdf-8d3d-4df7-acf0-b92d071523c4",
                                                "sense_id": "c1933bed-0043-3426-88b9-65aa50e05ca9",
                                                "text": "Его насмешки не дышали весёлостию; в них видна была горькая досада против всего человечества!"
                                            },
                                            {
                                                "example_id": "2bc02dc1-665a-4955-9e8e-53d5faa3a9b8",
                                                "sense_id": "c1933bed-0043-3426-88b9-65aa50e05ca9",
                                                "text": "Я предлагаю тост, мы пьём за вечную славу просветителей человечества, знаменитых французских философов и главы их, бессмертного Вольтера."
                                            },
                                            {
                                                "example_id": "34bfac12-4156-437b-8267-40f884c03b0d",
                                                "sense_id": "c1933bed-0043-3426-88b9-65aa50e05ca9",
                                                "text": "Тут были и те молодые люди, которые наружными качествами отличились бы всюду, даже на Страшном суде, когда вся толпа человечества предстанет вместе."
                                            },
                                            {
                                                "example_id": "14d4a9c0-1641-44ba-a89f-5afcafa98487",
                                                "sense_id": "c1933bed-0043-3426-88b9-65aa50e05ca9",
                                                "text": "Что ж делать, человечество нашего века пряные коренья любит."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25958a4d-72c4-38fd-b195-cdd01b89b97d",
                                        "entry_id": "0c57d9aa-e0e8-3c85-950e-313cb860e309",
                                        "glosses": [
                                            "устар. человеколюбие, любовь, милосердие к ближнему"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9891ebff-26bb-491f-b362-7f060eb5e92e",
                                                "sense_id": "25958a4d-72c4-38fd-b195-cdd01b89b97d",
                                                "text": "Не было милосердия, ни человечества: обе стороны в ужасных своих лютостях оправдывались законом мести."
                                            },
                                            {
                                                "example_id": "ca2e7c24-9e4a-4eac-99c8-5c9fb08ce510",
                                                "sense_id": "25958a4d-72c4-38fd-b195-cdd01b89b97d",
                                                "text": "Эти небольшие ростовщики бывают в несколько раз бесчувственней всяких больших, потому что возникают среди бедности и ярко выказываемых нищенских лохмотьев, которых не видит богатый ростовщик, имеющий дело только с приезжающими в каретах. И потому уже слишком рано умирает в душах их всякое чувство человечества."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
