{
    "word_family": [
        "растеряться",
        "растерянность",
        "растерянно",
        "терять",
        "потерять"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "687b40c0-18ac-3d17-9a2f-0f24febb04e1",
                    "sense_definition": "Утративший самообладание, не знающий, как поступить от волнения, страха или смущения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "состояние человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он стоял посреди комнаты, абсолютно <w>растерянный</w> и не понимающий, куда идти.",
                            "target_lang_translations": {
                                "en": "He stood in the middle of the room, absolutely <w>confused</w> and not understanding where to go."
                            }
                        },
                        {
                            "text": "В сложной ситуации важно не оставаться <w>растерянным</w>, а быстро принимать решения.",
                            "target_lang_translations": {
                                "en": "In a difficult situation, it is important not to remain <w>bewildered</w>, but to make decisions quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "обескураженный"
                    ],
                    "antonyms": [
                        "уверенный",
                        "собранный"
                    ],
                    "common_phrases": [
                        "растерянный вид",
                        "выглядеть растерянным"
                    ],
                    "target_lang_definitions": {
                        "en": "Having lost self-control, not knowing what to do due to worry, fear, or embarrassment; confused, bewildered, or lost."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confused",
                                "target_lang_sense_clarification": "unable to think clearly or understand something"
                            },
                            {
                                "target_lang_word": "bewildered",
                                "target_lang_sense_clarification": "completely puzzled or confused"
                            },
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "not knowing what to do or how to react"
                            },
                            {
                                "target_lang_word": "mixed-up",
                                "target_lang_sense_clarification": "confused, muddled, or bewildered"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e0e2102-b26e-35d2-98ea-ba7c391beaeb",
                    "sense_definition": "Выражающий растерянность, замешательство или смущение (о взгляде, голосе, улыбке и т. п.).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "выражение чувств",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она ответила тихим и <w>растерянным</w> голосом, который выдавал её волнение.",
                            "target_lang_translations": {
                                "en": "She answered in a quiet and <w>confused</w> voice that betrayed her agitation."
                            }
                        },
                        {
                            "text": "На его лице появилась <w>растерянная</w> улыбка, когда его неожиданно поздравили коллеги.",
                            "target_lang_translations": {
                                "en": "A <w>bewildered</w> smile appeared on his face when his colleagues unexpectedly congratulated him."
                            }
                        }
                    ],
                    "antonyms": [
                        "уверенный"
                    ],
                    "common_phrases": [
                        "растерянный взгляд",
                        "растерянная улыбка",
                        "растерянный голос"
                    ],
                    "target_lang_definitions": {
                        "en": "Expressing confusion, bewilderment, or embarrassment (of a look, voice, smile, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confused",
                                "target_lang_sense_clarification": "showing a lack of understanding or certainty"
                            },
                            {
                                "target_lang_word": "bewildered",
                                "target_lang_sense_clarification": "expressing complete puzzlement"
                            },
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "showing self-conscious discomfort or confusion"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "864a19e0-e4e6-31dd-b075-5b59f8300f3f",
                    "sense_definition": "Страдательное причастие прошедшего времени от глагола <w>растерять</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все вещи, <w>растерянные</w> во время спешного переезда, так и не удалось найти.",
                            "target_lang_translations": {
                                "en": "All the things <w>lost</w> during the hasty move were never found."
                            }
                        },
                        {
                            "text": "Книги, <w>растерянные</w> по дороге, лежали прямо на траве.",
                            "target_lang_translations": {
                                "en": "The books <w>scattered</w> along the way lay right on the grass."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past passive participle of the verb 'растерять' (to lose, scatter, or drop things over time/along the way)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lost",
                                "target_lang_sense_clarification": "scattered or dropped and unable to be found"
                            },
                            {
                                "target_lang_word": "scattered",
                                "target_lang_sense_clarification": "dropped or left behind in various places"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}