                    }
                ],
                "senses": [
                    {
                        "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                        "entry_id": "a2a6b36b-deec-3c1d-8f9c-040ee70f0165",
                        "glosses": [
                            "die arabische Herrscherfamilie der Haschemiten betreffend, zu ihnen gehörend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9ca318-1c7b-4349-bd01-78fbb0edf629",
                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                "text": "„Der Club mit den verstaubten, alten Ledersesseln und der dunklen Holztäfelung stammte vermutlich noch aus der Zeit, als Glubb Pascha dem haschemitischen Heer britische Disziplin eintrichtern wollte.“"
                            },
                            {
                                "example_id": "3189d4f3-ef5b-48cd-aa58-cf0fc549c27a",
                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                "text": "„Abdullah war ein Sprössling der haschemitischen Königsfamilie aus dem Hidjas – wo die heiligen muslimischen Städte Mekka und Medina liegen –, die im Ersten Weltkrieg auf Seiten der Briten gekämpft hatte.“"
                            },
                            {
                                "example_id": "9fcf414a-7c8f-453c-afa0-8b9b9b6f0412",
                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                "text": "„1970 führten die Flugzeugentführungen der PFLP und die palästinensischen Exzesse in Jordanien zu einer katastrophalen Konfrontation mit dem haschemitischen Regime, die die Widerstandsbewegung nicht gewinnen konnte.“"
                            },
                            {
                                "example_id": "69f4c618-edbd-422a-8744-25f307f61a50",
                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                "text": "„Abeds Vater hatte einen jordanischen Pass aus der Zeit, als das Westjordanland vom haschemitischen Königshaus kontrolliert wurde, also konnte Abed es in Jordanien versuchen.“"
                            },
                            {
                                "example_id": "a51a1465-4398-47c5-a79c-7adb76249552",
                                "sense_id": "f71bb0e9-8ea3-31c7-b946-fd71421d75f2",
                                "text": "„Damit war für den haschemitischen König die Gefahr gebannt, die auch von den moderateren Teilen der PLO für seine Herrschaft ausgegangen war, da die jordanische Bevölkerung infolge von Flucht, Vertreibung und Einwanderung zu diesem Zeitpunkt schon mehrheitlich palästinensisch bzw. palästinensischer Abstammung war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
