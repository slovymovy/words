                        "glosses": [
                            "The condition, or quality, of being mean (any of its definitions)"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d38fe5c9-0784-40d8-a2b3-739c0ee7c6e6",
                                "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                "text": "This figure is of a later date, by the meanness of the workmanship."
                            }
                        ]
                    },
                    {
                        "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                        "glosses": [
                            "A mean act."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebbcd0a9-bf80-41f2-b9f2-5402df66b755",
                                "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                "text": "There are enough meannesses in everyone — ourselves included — to make for us a contemptible world, if we select the meannesses and let our minds dwell upon them."
                            }
                        ]
                    }
                ],
