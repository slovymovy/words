                    "sense_definition": "officieel goedgekeurd of toegelaten door een instantie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "autorisatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij zijn <w>erkende</w> loodgieters die in het bezit zijn van alle benodigde diploma's en vergunningen.",
