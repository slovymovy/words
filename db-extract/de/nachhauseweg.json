                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a35e52b-1c53-3869-bbfe-34190064cc94",
                        "entry_id": "51a050e8-9d8e-370f-9817-416765621229",
                        "glosses": [
                            "Weg nach Hause"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0766656-a4fd-4440-8c35-3f3d30b1fa5c",
                                "sense_id": "9a35e52b-1c53-3869-bbfe-34190064cc94",
                                "text": "„Häufig hatte er mit der Gönnermiene eines spanischen Granden sein letztes Geld für ein fürstliches Trinkgeld verwendet und nicht einmal mehr den Betrag für ein Fahrzeug zum Nachhauseweg besessen.“"
                            },
                            {
                                "example_id": "599b9c71-e485-46ee-bff7-3a2cb8d04e97",
                                "sense_id": "9a35e52b-1c53-3869-bbfe-34190064cc94",
                                "text": "„Auf dem Nachhauseweg, den Blick auf meine Füße gerichtet, während unter meinen Schuhen Kies, Kopfsteinpflaster und Betonplatten abwechselten, ging mir die Sache mit den beiden wieder und wieder durch den Kopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
