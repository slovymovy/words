                                    {
                                        "sense_id": "f030771e-da81-3974-bc16-4d43e18600fd",
                                        "entry_id": "9f1e80ae-a353-34f5-9c34-ed2ddb990c33",
                                        "glosses": [
                                            "A conflict waged only as a battle of words"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64cc377b-ee20-4fad-bb0f-f4d526e158be",
                                                "sense_id": "f030771e-da81-3974-bc16-4d43e18600fd",
                                                "text": "He was left over the coffee with Brayne, the hoary Yankee who believed in all religions, and Valentin, the grizzled Frenchman who believed in none. They could argue with each other, but neither could appeal to him. After a time this “progressive” logomachy had reached a crisis of tedium; Lord Galloway got up also and sought the drawing-room."
                                            }
                                        ]
