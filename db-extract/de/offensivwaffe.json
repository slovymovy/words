                "senses": [
                    {
                        "sense_id": "1259b5df-d238-3949-9e04-4841cb574fca",
                        "entry_id": "3526f4f5-8688-3153-b5c4-71ee951b8701",
                        "glosses": [
                            "Waffe, die besonders für das Ausführen eines Angriffs geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef69b7d-8b0d-4446-9735-b74a81d7369a",
                                "sense_id": "1259b5df-d238-3949-9e04-4841cb574fca",
                                "text": "„Der Panzer war auch für die sowjetische Ideologie wie geschaffen, als Offensivwaffe wie als Massenprodukt von den Montagebändern.“"
                            },
                            {
                                "example_id": "c7e6b44c-828f-4545-a755-12894c76c6aa",
                                "sense_id": "1259b5df-d238-3949-9e04-4841cb574fca",
                                "text": "„Als Teil einer Offensivwaffe wäre das dann aber weder eine ‚defensive Schutzausstattung‘, wie es Gabriel nennt, noch ginge es um einen ‚gemeinsamen Kampf mit der Bundeswehr‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
