                        "source_sense_id": "aacf4c56-e650-3755-b6ad-6aed9f059701",
                        "source_sense_description": "Maut, die für das Befahren einer Innenstadt mit einem Kraftfahrzeug erhoben wird",
                        "target_lang_word": "road pricing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "road pricing",
