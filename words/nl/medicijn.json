                            "target_lang_translations": {
                                "en": "In old stories, the village doctor is sometimes referred to as the <w>physician</w>.",
                                "ru": "В старых рассказах сельского врача иногда называют <w>лекарем</w>.",
                                "pl": "W starych opowieściach lekarz wiejski jest czasem nazywany <w>medykiem</w>.",
                                "de": "In alten Geschichten wird der Dorfarzt manchmal als der <w>Heiler</w> bezeichnet.",
                                "fr": "Dans les vieilles histoires, le médecin du village est parfois désigné comme le <w>guérisseur</w>.",
                                "it": "Nelle vecchie storie, il medico del villaggio viene talvolta indicato come il <w>medico</w>.",
                                "cs": "Ve starých příbězích je vesnický lékař někdy označován jako <w>lékař</w>.",
                                "tr": "Eski hikayelerde köy doktorundan bazen <w>hekim</w> olarak bahsedilir.",
                                "es": "En las historias antiguas, a veces se hace referencia al médico del pueblo como el <w>curandero</w>."
                            }
                        },
                        {
                            "text": "De zieke man riep om de <w>medicijn</w> om hem te komen helpen.",
                            "target_lang_translations": {
                                "en": "The sick man called for the <w>physician</w> to come help him.",
                                "ru": "Больной человек звал <w>лекаря</w>, чтобы тот пришёл ему помочь.",
                                "pl": "Chory człowiek wołał <w>lekarza</w>, aby przyszedł mu pomóc.",
                                "de": "Der kranke Mann rief nach dem <w>Heilkundigen</w>, damit er ihm zu Hilfe komme.",
                                "fr": "L'homme malade appelait le <w>médecin</w> pour qu'il vienne l'aider.",
                                "it": "L'uomo malato invocò il <w>guaritore</w> affinché venisse ad aiutarlo.",
                                "cs": "Nemocný muž volal <w>lékaře</w>, aby mu přišel pomoci.",
                                "tr": "Hasta adam, kendisine yardım etmesi için <w>şifacıyı</w> çağırdı.",
                                "es": "El hombre enfermo llamó al <w>médico</w> para que viniera a ayudarlo."
                            }
