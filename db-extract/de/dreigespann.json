                        "entry_id": "a82a3f9c-35d5-32dd-a784-4fe19e832dd9",
                        "glosses": [
                            "Gespann, bei dem drei Zugtiere verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af946ab5-a56f-428b-bebf-3a4e68ae880e",
                                "sense_id": "67bbf6ed-0108-3caa-8dcb-9092870ce4f9",
                                "text": "„Mit Schreien und Quietschen und Peitschenschwingen suchten die übrigen Dreigespanne zu folgen und wussten sich nicht anders zu helfen, als dass sie auch die Mittelpferde zum Galopp übergehen liessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
