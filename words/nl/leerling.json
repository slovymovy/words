                    "sense_id": "0d3f5cc0-2e28-3a33-84ce-a2d17a500e47",
                    "sense_definition": "iemand die een vak leert in de praktijk of een volgeling van een meester",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onderwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude schilder leerde zijn <w>leerling</w> hoe hij de kleuren moest mengen.",
                            "target_lang_translations": {
                                "en": "The old painter taught his <w>apprentice</w> how to mix the colors.",
                                "ru": "Старый художник учил своего <w>ученика</w> тому, как нужно смешивать цвета."
                            }
                        },
                        {
                            "text": "Als <w>leerling</w> in de bakkerij moet je vroeg in de ochtend beginnen.",
                            "target_lang_translations": {
                                "en": "As an <w>apprentice</w> in the bakery, you have to start early in the morning.",
                                "ru": "Как <w>ученик</w> в пекарне, ты должен начинать работу рано утром."
                            }
                        }
                    ],
                    "synonyms": [
