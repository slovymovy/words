                            {
                                "example_id": "8ebff61c-21f0-4daf-ba0b-8abd11318f32",
                                "sense_id": "77cbe7a3-c348-3e52-9379-d3acdb442e1f",
                                "text": "On appelle en Bresse farréage quatre ou cinq mesures de blé que les métayers retiennent pour payer le maréchal qui forgera et raccommodera pendant l'année les socs et les fers de la charrue."
                            },
                            {
                                "example_id": "19188dbd-37cf-4c4f-9ff1-8095d12959bb",
                                "sense_id": "77cbe7a3-c348-3e52-9379-d3acdb442e1f",
                                "text": "Farréage : Dérive du latin far, blé; redevance en blé laissée par le maître au métayer pour être versée chaque année au forgeron en raison de ses menus services"
                            }
                        ]
