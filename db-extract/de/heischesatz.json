                                        "glosses": [
                                            "A fundamental element; a basic principle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3149a3b1-4254-38ae-9849-51d792a5a3f5",
