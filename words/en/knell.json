                    "frequency": "Low",
                    "semantic_group_id": "bell_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy iron bells began to <w>knell</w> as the procession moved toward the cemetery."
                        },
                        {
                            "text": "The bells <w>knelled</w> throughout the afternoon to honor the passing of the leader."
