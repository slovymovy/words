                        "glosses": [
                            "One who attends horse races or dog races."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f09c0834-3dc5-439b-ac3d-17843842949e",
                                "sense_id": "2a14a0b2-8c99-3d49-b32b-15850ecbaee4",
                                "text": "On December 9, No. 4056, Princess Margaret, worked a racegoers' excursion from Stapleton Road, Bristol, to Newbury Racecourse, via Devizes."
                            },
                            {
                                "example_id": "581fdabb-ac7a-4a3e-b6ed-5f83eb1f87ce",
                                "sense_id": "2a14a0b2-8c99-3d49-b32b-15850ecbaee4",
                                "text": "Many of the racegoers — the ones from New York, at least — said they knew about the governor’s troubles, but they largely chalked them up to politics as usual."
                            },
                            {
                                "example_id": "0704214b-3b6b-4669-af09-7fc49bf55c88",
                                "sense_id": "2a14a0b2-8c99-3d49-b32b-15850ecbaee4",
                                "text": "The line had been forced into spending £500,000 to repair a landslip during the winter at Gotherington, and the railway was only just able to open in time in order to transport racegoers to the annual Cheltenham Festival in March."
                            }
                        ]
                    }
