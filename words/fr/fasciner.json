    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6377796-a35b-37e1-a410-6b71c49ed638",
                    "sense_definition": "Exercer une très vive attraction sur l'esprit, captiver l'attention ou susciter un intérêt irrésistible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attraction_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce mystère continue de <w>fasciner</w> les scientifiques du monde entier."
                        },
                        {
                            "text": "L'immensité de l'univers <w>fascine</w> tous les passionnés d'astronomie depuis des siècles."
                        }
                    ],
                    "synonyms": [
                        "captiver",
                        "passionner",
                        "magnétiser"
                    ],
                    "antonyms": [
                        "ennuyer",
                        "répugner"
                    ],
                    "common_phrases": [
                        "fasciner les foules",
                        "fasciner le public"
                    ]
                },
                {
                    "sense_id": "8622f124-ac7e-3def-85ee-aeaeb61fa480",
                    "sense_definition": "Éblouir, charmer ou séduire au point d'altérer le discernement ou de paralyser la volonté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attraction_mentale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est laissé <w>fasciner</w> par les lumières et le luxe trompeur de la grande ville."
                        },
                        {
                            "text": "Cette oratrice talentueuse a su <w>fasciner</w> son auditoire dès les premières minutes."
                        }
                    ],
                    "synonyms": [
                        "envoûter",
                        "séduire",
                        "éblouir"
                    ],
                    "antonyms": [
                        "désenchanter"
                    ],
                    "common_phrases": [
                        "fasciner par sa beauté",
                        "se laisser fasciner"
                    ]
                },
                {
                    "sense_id": "67685643-b256-3290-8464-811e2b959dfb",
                    "sense_definition": "Immobiliser ou maîtriser un animal par la fixité d'un regard perçant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serpent immobile parvient à <w>fasciner</w> sa proie avant de bondir sur elle."
                        },
                        {
                            "text": "Ce prédateur tente de <w>fasciner</w> les petits oiseaux pour les capturer plus aisément."
                        }
                    ],
                    "synonyms": [
                        "hypnotiser",
                        "méduser"
                    ],
                    "common_phrases": [
                        "fasciner sa proie"
                    ]
                },
                {
                    "sense_id": "190e35bc-4a47-335e-9893-00cd172a9548",
                    "sense_definition": "Garnir, consolider ou protéger un talus ou un retranchement au moyen de fascines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers doivent <w>fasciner</w> la berge du canal pour empêcher les glissements de terrain."
                        },
                        {
                            "text": "Le régiment a décidé de <w>fasciner</w> les fossés afin de consolider les défenses du camp."
                        }
                    ],
                    "common_phrases": [
