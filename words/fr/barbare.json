                        "un traitement barbare",
                        "une coutume barbare"
                    ]
                },
                {
                    "sense_id": "372ca5ab-60d3-3830-87f1-fed8cf81f920",
                    "sense_definition": "Relatif aux peuples situés en dehors du monde gréco-romain dans l'Antiquité.",
