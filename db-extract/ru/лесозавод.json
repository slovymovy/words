                "senses": [
                    {
                        "sense_id": "0d91a843-85e3-3ee5-a616-b7fffa5cca3f",
                        "entry_id": "bcb54f00-5adc-3a1c-9c49-02125805d6c3",
                        "glosses": [
                            "завод, занимающийся обработкой лесоматериалов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99836ef5-a89e-4584-b686-1066c5da857e",
                                "sense_id": "0d91a843-85e3-3ee5-a616-b7fffa5cca3f",
                                "text": "В годы войны в Кировской области на берегу реки возводился лесозавод, ЦЭС."
                            },
                            {
                                "example_id": "f21bf4e4-90cd-4d3b-af26-2d46c3f787f0",
                                "sense_id": "0d91a843-85e3-3ee5-a616-b7fffa5cca3f",
                                "text": "Наша бригада получила назначение на Кемский лесозавод."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de19db25-70b4-4ebe-9212-4b8dddaf844f",
                        "source_entry_id": "bcb54f00-5adc-3a1c-9c49-02125805d6c3",
                        "source_sense_id": "0d91a843-85e3-3ee5-a616-b7fffa5cca3f",
                        "target_lang_word": "lumber mill",
                        "target_lang_code": "en",
