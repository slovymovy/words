                    }
                ],
                "translations": [
                    {
                        "translation_id": "bad32e80-44ad-4120-adc9-e3dc21a2134f",
                        "source_entry_id": "32536bcd-137a-3abe-a310-eb034a7d4144",
                        "source_sense_id": "9f09e793-691b-334d-84c2-6928c43fe104",
                        "target_lang_word": "capacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Pouvoir de réaliser ou de produire quelque chose, en parlant de personnes ou de choses ; aptitude ; faculté ; force ; habileté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "830cf8aa-e583-4845-bedd-439eec05b502",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "Et il y avait du travail pour tous : bonnetiers, mécaniciens, rebrousseurs, formeuses, remailleuses, visiteuses, chacun, homme ou femme, pouvant y trouver un poste correspondant à sa condition et à ses capacités."
                                            },
                                            {
                                                "example_id": "417e005c-f452-4cf2-8b7a-7e28f2fa0cf8",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                                            },
                                            {
                                                "example_id": "eb3dba38-ca96-423c-b7d5-179bea37da65",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "Entraînées par l’enthousiasme démesuré de l’adolescence, elles surestimèrent leurs capacités physiologiques."
                                            },
                                            {
                                                "example_id": "354f36d5-0441-46e0-aad5-519e45aea5f5",
                                                "sense_id": "492890fa-9c23-3af7-ac74-ea8a6600d721",
                                                "text": "Le manichéisme quasi infantile d’Éric Zemmour obère sa capacité future à unir les Français, décrédibilisant résolument sa candidature à la magistrature suprême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7c7140-d533-3458-ba52-448325cccbea",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Quantité d’un contenant, volume, contenance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "976ffeb8-ee9e-4301-b89c-9ff6ef178241",
                                                "sense_id": "8c7c7140-d533-3458-ba52-448325cccbea",
                                                "text": "Cette bouteille a une capacité de 1,5 litres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68824fb2-04f3-30ad-899f-15357d82f4a5",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Production maximale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6446551f-810d-42e9-b7f8-488cf8b2b006",
                                                "sense_id": "68824fb2-04f3-30ad-899f-15357d82f4a5",
                                                "text": "Les Salins du midi exploitent: […]\n— dans l'est, à Varangéville (Meurthe-et-Moselle), une importante saline d’une capacité annuelle de 625 000 tonnes de sel ignigène, ainsi qu’une mine de sel gemme dont la capacité annuelle d’extraction est de 600 000 tonnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7076edc2-f99d-312e-8e25-4b660e15f80a",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Pouvoirs reconnus par la loi à une catégorie d’individus de s’engager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baead617-0bc1-473e-965b-f47cc8d98f2e",
                                                "sense_id": "7076edc2-f99d-312e-8e25-4b660e15f80a",
                                                "text": "Les capacités des femmes mariées ont été largement accrues récemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61805375-8c8d-34d1-82de-b51ed63bbb9b",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Capacité électrique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80c94d4c-a566-4c27-9284-18c615f32850",
                                                "sense_id": "61805375-8c8d-34d1-82de-b51ed63bbb9b",
                                                "text": "Ce condensateur a une capacité de 500 microfarads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1ccc32-5f30-366c-80ad-3165cecc3b88",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Capacité électrique.",
                                            "Le condensateur lui-même."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "649d0566-2b3a-3529-96dd-1fbe214c58f2",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Diplôme, attestation, certificat."
                                        ],
                                        "tags": [
                                            "Formation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "142f6f4e-c2dd-4cd1-a322-88cc68c3cda9",
                                                "sense_id": "649d0566-2b3a-3529-96dd-1fbe214c58f2",
                                                "text": "Il a obtenu sa capacité d’ambulancier, avant de préparer sa capacité de médecine d’urgence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeed9348-3e3c-3885-a78a-ba360e42177b",
                                        "entry_id": "2a8e6fa5-6f30-3085-963b-ae9d90f8f45d",
                                        "glosses": [
                                            "Personnes qui, par leurs compétences, leurs connaissances ou leur position sociale sont en situation d’exercer des fonctions politiques."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb2f391-97f8-4ef8-84ca-a83701b0e913",
                                                "sense_id": "eeed9348-3e3c-3885-a78a-ba360e42177b",
                                                "text": "Il y a eu des personnalités, Champlain, Montcalm, comme aux Indes Lally-Tollendal, ou Dupleix. Mais la masse ne s’y intéressait guère. Et quand nous sommes partis, les capacités sont rentrées en France. Seul le populo est resté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0698b579-a091-4b7c-8ca1-e561686c3900",
                        "source_entry_id": "32536bcd-137a-3abe-a310-eb034a7d4144",
                        "source_sense_id": "9f09e793-691b-334d-84c2-6928c43fe104",
                        "target_lang_word": "volume",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8824f665-983f-312f-846e-65a47db6ef0c",
                                        "entry_id": "41534ecd-fcb5-388c-b3aa-e737d4f0acd7",
                                        "glosses": [
                                            "Ampleur, grosseur d’une masse ; espace occupé par un corps ou celui pouvant être délimité par une ou des surfaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8747657-86a5-4237-83c7-999d80788dab",
                                                "sense_id": "8824f665-983f-312f-846e-65a47db6ef0c",
                                                "text": "Cette bouteille peut contenir un volume d’un litre, c’est-à-dire un décimètre cube."
                                            },
                                            {
                                                "example_id": "a158c38c-4a27-410b-8804-1a12e22bc8d1",
                                                "sense_id": "8824f665-983f-312f-846e-65a47db6ef0c",
                                                "text": "Cette source fournit un volume d’eau considérable."
                                            },
                                            {
                                                "example_id": "2821e18f-df85-4e77-811c-cb3160be8d57",
                                                "sense_id": "8824f665-983f-312f-846e-65a47db6ef0c",
                                                "text": "J’aime donner du volume à mes cheveux."
                                            },
                                            {
                                                "example_id": "68a8f707-44d0-47f6-b493-fcdc1335ac40",
                                                "sense_id": "8824f665-983f-312f-846e-65a47db6ef0c",
                                                "text": "Comptez trois volumes d’eau pour un de riz."
                                            },
                                            {
                                                "example_id": "2459cf30-0146-4cdf-a45e-e923cb107c78",
                                                "sense_id": "8824f665-983f-312f-846e-65a47db6ef0c",
                                                "text": "Des corps de même volume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c9026b-a452-3acc-ad0b-f5063466ab25",
                                        "entry_id": "41534ecd-fcb5-388c-b3aa-e737d4f0acd7",
                                        "glosses": [
                                            "Quantité approximative, notamment dans le commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75cd7b25-af9d-497c-bac7-269a13f95905",
                                                "sense_id": "d4c9026b-a452-3acc-ad0b-f5063466ab25",
                                                "text": "L’entreprise, à plein régime, fournit un volume de quinze produits par jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbd5eeee-5cb5-3778-90b6-17cbc24f7227",
                                        "entry_id": "41534ecd-fcb5-388c-b3aa-e737d4f0acd7",
                                        "glosses": [
                                            "Intensité d’un son, puissance acoustique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d5e017-e25b-49e1-8d50-90355868f288",
                                                "sense_id": "bbd5eeee-5cb5-3778-90b6-17cbc24f7227",
                                                "text": "Cette voix, qui tenait de la basse-taille par son volume, se veloutait comme celle des barytons, et prenait, dans le rire par lequel Philéas accompagnait ses fins de phrases, quelque chose d’argentin."
                                            },
                                            {
                                                "example_id": "43610ffb-737c-4226-b666-7373041c80b3",
                                                "sense_id": "bbd5eeee-5cb5-3778-90b6-17cbc24f7227",
                                                "text": "L’écoute prolongée du baladeur à très haut volume est fortement déconseillée et peut provoquer des lésions irréversibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af8aede-24bf-3a97-b6e0-0914763a23c0",
                                        "entry_id": "41534ecd-fcb5-388c-b3aa-e737d4f0acd7",
                                        "glosses": [
                                            "Ouvrage ou division physique d’un ouvrage relié."
                                        ],
                                        "tags": [
                                            "Livre"
                                        ],
                                        "note": "Lorsqu’on parle d’une division, il y a une nuance avec un tome, qui est une division logique. Quoiqu’un tome puisse constituer un volume, un volume est une division pratique, imposée par la taille",
                                        "examples": [
                                            {
                                                "example_id": "1a48f7d6-f9b9-4964-a6a8-3050d8d7ff31",
                                                "sense_id": "4af8aede-24bf-3a97-b6e0-0914763a23c0",
                                                "text": "À peine eus-je lâché le volume que je regrettai mon geste."
                                            },
                                            {
                                                "example_id": "adaca719-6db2-48e6-8804-48baa2b246d2",
                                                "sense_id": "4af8aede-24bf-3a97-b6e0-0914763a23c0",
                                                "text": "La moindre photographie nous apprend cent fois plus sur le Parthénon qu’un volume consacré à vanter les merveilles de ce monument ; […]."
                                            },
                                            {
                                                "example_id": "a57834cd-76b2-43b9-9f5e-d2cb85388a1f",
                                                "sense_id": "4af8aede-24bf-3a97-b6e0-0914763a23c0",
                                                "text": "Mme de Trémazenc de Capestang possédait une vingtaine de vieux volumes à couvercles de bois, ornés de ciselures de cuivre ; ils retraçaient la vie glorieuse des anciens chevaliers errants toujours au service du faible contre le fort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb1f2314-7d5a-3bba-809b-521a0c195633",
                                        "entry_id": "41534ecd-fcb5-388c-b3aa-e737d4f0acd7",
                                        "glosses": [
                                            "Texte inhabituellement long, particulièrement de la correspondance."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d6e9b41-c36f-4bff-913e-45ceaa0412a6",
                                                "sense_id": "cb1f2314-7d5a-3bba-809b-521a0c195633",
                                                "text": "Une lettre qui est un volume, qui fait un volume."
                                            },
                                            {
                                                "example_id": "301325ac-1f04-4ea3-a552-3b68bb66f6a7",
                                                "sense_id": "cb1f2314-7d5a-3bba-809b-521a0c195633",
                                                "text": "Ils s’écrivent des volumes, de fort longues lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d4c13e-0f7f-3d90-b3c8-d9397b394705",
                                        "entry_id": "41534ecd-fcb5-388c-b3aa-e737d4f0acd7",
                                        "glosses": [
                                            "Quantité d'un produit financier échangé sur un marché financier sur une période donnée."
