                            {
                                "example_id": "7f39a0fa-bcf7-46d0-af70-605a069ec938",
                                "sense_id": "923f087e-ae7e-3b18-9701-b8e5f0b57d4f",
                                "text": "De alomtegenwoordige bewakingscamera's zijn een reden dat ik nooit meer met ongekamde haren de deur durf uit te gaan."
                            },
                            {
                                "example_id": "270c9577-2254-495d-817c-b01aa75a5f6c",
                                "sense_id": "923f087e-ae7e-3b18-9701-b8e5f0b57d4f",
                                "text": "Beiden waren een opluchting, al was het maar omdat mijn alomtegenwoordige moeder dan even de kamer uit moest."
                            }
                        ]
                    }
