                ],
                "senses": [
                    {
                        "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                        "entry_id": "87244a75-5942-39ea-8736-8826df73aa87",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98d0113c-a16a-4839-9f4a-3b35bec61ce2",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Frau Schöller ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "83d70a94-7438-4d57-bc4d-29b9a1ff876b",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Herr Schöller wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f160114b-34e0-475b-be9a-0ac7197c6b6c",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Die Schöllers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c150dd89-579a-4ac0-8923-5b0a77f10051",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Der Schöller trägt nie die Schals, die die Schöller ihm strickt."
                            },
                            {
                                "example_id": "1b828869-1b0e-49c1-a44d-ab10a46ea891",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schöller kommt, geht der Herr Schöller.“"
                            },
                            {
                                "example_id": "37053e07-2da8-4f5e-b93e-e686764ab442",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Schöller kommt und geht."
                            },
                            {
                                "example_id": "5a30439f-b4b3-4026-9ddc-352bc68f99f7",
                                "sense_id": "7b3bde8a-3b57-37f1-8ad7-381f99daca18",
                                "text": "Schöllers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
