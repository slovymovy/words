                    "sense_id": "447a17d7-1d3f-33be-b302-792496cbf911",
                    "sense_definition": "zich zaken met geweld of op onrechtmatige wijze toe-eigenen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diefstal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dieven probeerden de kostbare juwelen uit de kluis te <w>roven</w>.",
                            "target_lang_translations": {
                                "en": "The thieves tried to <w>rob</w> the precious jewels from the safe.",
                                "ru": "Воры пытались <w>украсть</w> драгоценные камни из сейфа."
                            }
                        },
                        {
                            "text": "Zij gingen op pad om schatten te <w>roven</w> uit het oude kasteel.",
                            "target_lang_translations": {
                                "en": "They set out to <w>plunder</w> treasures from the old castle.",
                                "ru": "Они отправились в путь, чтобы <w>разграбить</w> сокровища старого замка."
                            }
                        }
