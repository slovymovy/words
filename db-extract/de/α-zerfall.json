                "senses": [
                    {
                        "sense_id": "351e43a8-1adf-3675-9994-6d8296bc23a9",
                        "entry_id": "73031589-7a29-3413-b39e-130888134e65",
                        "glosses": [
                            "Art des radioaktiven Zerfalls, bei dem der zerfallende Atomkern einen Helium-4-Atomkern, das Alphateilchen, aussendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31cd4425-7e86-40fd-8671-cd7a16339156",
                                "sense_id": "351e43a8-1adf-3675-9994-6d8296bc23a9",
                                "text": "„Ein Beispiel für ein Polonid ist Bleipolonid, das immer in Poloniumproben gefunden wird, da beim α-Zerfall von Polonium Blei entsteht.“"
                            },
                            {
                                "example_id": "eac22e9f-ad79-4a3a-8a69-1e775fad0a2b",
                                "sense_id": "351e43a8-1adf-3675-9994-6d8296bc23a9",
                                "text": "„Die Halbwertszeit dieses α-Zerfalls wurde zunächst auf 510 ± 20 Jahre bestimmt; der heute allgemein akzeptierte Wert ist 432,2 a.“"
                            },
                            {
                                "example_id": "351bfae1-3700-4d78-bd0c-cbcfd879b648",
                                "sense_id": "351e43a8-1adf-3675-9994-6d8296bc23a9",
                                "text": "„Mit diesem fast klassischen Modell kann gut erklärt werden, welche Isotope stabil sind und welche sich noch durch Energieabgabe in ein fester gebundenes (oder zwei) umwandeln können, etwa durch α-Zerfall, β-Zerfall, Kernspaltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
