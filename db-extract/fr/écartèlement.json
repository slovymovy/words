                "entry_id": "f4c4690f-bf99-3297-a5e9-58fd323922ef",
                "word": "écartèlement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "41a83b76-d739-4f3d-bf39-6853db80176f",
                        "entry_id": "f4c4690f-bf99-3297-a5e9-58fd323922ef",
                        "tags": [
