                                                "example_id": "f522e2a9-b071-4803-9b32-83296bcabaed",
                                                "sense_id": "dc33c676-cfe5-3bb5-90a2-4c6ddd8d8e62",
                                                "text": "Dès que je serai arrivé."
                                            },
                                            {
                                                "example_id": "361129db-52e2-402c-9524-eb595a9038a6",
                                                "sense_id": "dc33c676-cfe5-3bb5-90a2-4c6ddd8d8e62",
