                        "examples": [
                            {
                                "example_id": "83c76924-6d48-4bed-85c8-fac32721ffc2",
                                "sense_id": "68bae1ed-e28b-3300-9a5b-8c568dd2e7ba",
                                "text": "„Denn diese Schlepper haben die Hauptarbeit zu verrichten und bekommen auch den Löwenanteil am Ergebnis dieser riesigen Wurzerei.“"
                            },
                            {
                                "example_id": "9dbfa471-f875-4b74-a2d6-54216fc140e4",
                                "sense_id": "68bae1ed-e28b-3300-9a5b-8c568dd2e7ba",
                                "text": "„Die Mitglieder des Bundesrats tun ihre Hauptarbeit in ihren Bundesländern.“"
                            },
                            {
                                "example_id": "c63ff99f-d2e6-4129-be46-55a83c2960a9",
                                "sense_id": "68bae1ed-e28b-3300-9a5b-8c568dd2e7ba",
                                "text": "„Unsere Hauptarbeit besteht übrigens im Melken; am Morgen und am Abend müssen die prallen Euter geleert werden.“"
                            }
                        ],
