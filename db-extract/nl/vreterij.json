                                            {
                                                "example_id": "0fa8990b-0c28-4789-aba7-8f48a9d8bdae",
                                                "sense_id": "a03bb82b-5cd5-335c-b6f2-ddb8b60bc013",
                                                "text": "[…]I have knowne a very good Fiſher angle diligently four or ſix hours in a day, for three or four dayes together for a River Carp, and not have a bite[…]"
                                            },
                                            {
                                                "example_id": "0400a24c-4006-44e8-8641-a200b8ab56fc",
                                                "sense_id": "a03bb82b-5cd5-335c-b6f2-ddb8b60bc013",
                                                "text": "Now trust me when I tell you, young lady, teeth are something you want to take care of. They’re these rare white things that give us pleasure throughout our life. And give us bite. Our inheritance. Our means of survival. Our right to rule. Their enamel is the front line. And that line needs to be won every day."
                                            }
