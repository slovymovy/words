                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalinizm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "863e39da-481e-3cc3-be51-574190679a8a",
                                        "entry_id": "93c705c4-9be6-329f-afb9-61cba89cdb66",
                                        "glosses": [
                                            "ustrój, praktyka rządzenia panująca w ZSRR za czasów Józefa Stalina"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55280fac-8e52-46c8-ab88-ad6753dc4444",
                                                "sense_id": "863e39da-481e-3cc3-be51-574190679a8a",
                                                "text": "Zarówno nazizm, jak i stalinizm były ideologiami i ustrojami totalitarnymi."
                                            },
                                            {
                                                "example_id": "95987097-b36c-4a61-8777-cb8a7378e523",
                                                "sense_id": "863e39da-481e-3cc3-be51-574190679a8a",
                                                "text": "Na konkretne pytanie o stalinizm odpowiadasz, że być może ludzie niekoniecznie lubią towarzysza Stalina (tu ironiu ja poniał), ale tęsknią za dobrym carem. To dlaczego kochają mordercę cara?!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
