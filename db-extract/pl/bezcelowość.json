                                        "glosses": [
                                            "Zustand/Verfassung einer Person, keine Ziele zu haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c3b5e7-fbd4-4a08-b7af-cba75c7dbe29",
                                                "sense_id": "fb762d18-09bc-396d-9aa9-dd7f1a3fcc25",
                                                "text": "„Gerade als sie anfing, ob ihrer Ziellosigkeit zu verzweifeln, keimte in Sylvia eine Idee.“"
