                    },
                    {
                        "translation_id": "8af0372d-81ec-4e1a-8dc8-97c06c692ffe",
                        "source_entry_id": "71fdfd93-24eb-34db-a39d-3c178f4c93c2",
                        "source_sense_id": "5ecd3ce1-3ec6-398c-ad68-837cf07e4931",
