            {
                "entry_id": "1418374c-2345-374b-9e9f-8004852a0914",
                "word": "cuscute",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bbdc992a-b862-4ea5-8b32-3eaf3d29c640",
                        "entry_id": "1418374c-2345-374b-9e9f-8004852a0914",
                        "tags": [
                            "plural"
                        ],
                        "form": "cuscutes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72c67093-388b-36cf-814c-6e96f1f16d56",
                        "entry_id": "1418374c-2345-374b-9e9f-8004852a0914",
                        "glosses": [
                            "Plante dicotylédone holoparasite sans chlorophylle, et sans feuilles, à tiges très déliées jaunâtres ou rougeâtres, grimpantes, avec suçoirs, à petites fleurs claires, et qui croît principalement sur le trèfle, la luzerne et le thym."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d17709b0-a9ba-48e7-b972-5be0cc931a66",
                                "sense_id": "72c67093-388b-36cf-814c-6e96f1f16d56",
                                "text": "La cuscute, nommée teigne dans le pays , infecte trop souvent les luzernes et les semis de vesce; on essaie de la détruire, en enfouissant à la fourche toutes les plantes attaquées; […]."
                            },
                            {
                                "example_id": "0b27e62a-cc59-4bc7-b08d-007cc2f087c4",
                                "sense_id": "72c67093-388b-36cf-814c-6e96f1f16d56",
                                "text": "On avait réussi, à l'aise de trieurs appropriés, à nettoyer de petite Cuscute les graines de Luzerne ou de Trèfle. L'apparition de la grosse Cuscute, dont les graines sont plus grosses a rendu le problème de « décuscutage » plus difficile à résoudre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f543ed6-82e4-330f-b053-69237cdcc514",
                        "entry_id": "1418374c-2345-374b-9e9f-8004852a0914",
                        "glosses": [
                            "Membre du genre Cuscuta de plantes parasitiques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31dc3ed7-6767-4f4a-8c9e-256dd9157b74",
                        "source_entry_id": "1418374c-2345-374b-9e9f-8004852a0914",
                        "target_lang_word": "Seide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10b99cf6-0b49-35cc-8300-be5217f4dc92",
                                        "entry_id": "5f66fb81-0fad-3470-bfa5-0cde1b8faa53",
                                        "glosses": [
                                            "feine Textilfaser, die aus den Kokons der Seidenraupe gewonnen wird"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42cc251-2dac-466e-b47e-dd8dbecee050",
                                                "sense_id": "10b99cf6-0b49-35cc-8300-be5217f4dc92",
                                                "text": "Seide kommt ursprünglich wohl aus China und war eine wichtige Handelsware, die über die Seidenstraße nach Europa transportiert wurde."
                                            },
                                            {
                                                "example_id": "43576707-462d-48d2-a54d-caec3a131ad2",
                                                "sense_id": "10b99cf6-0b49-35cc-8300-be5217f4dc92",
                                                "text": "Als Behausung gräbt sie [die Flick-Flack-Spinne der marokkanischen Wüste] Röhren in den Sand, die sie mit Seide befestigt."
                                            },
                                            {
                                                "example_id": "91b41acf-d724-4220-81fa-07a715c8d288",
                                                "sense_id": "10b99cf6-0b49-35cc-8300-be5217f4dc92",
                                                "text": "Jetzt haben Forscher noch eine andere faszinierende Eigenschaft der Spinnenseide entdeckt - oder vielmehr wiederentdeckt. Denn bereits die alten Römer sollen Seide auf Wunden gelegt haben, damit sie schneller heilen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a150ee9-2258-3c3c-bc04-8852087e29c6",
                                        "entry_id": "5f66fb81-0fad-3470-bfa5-0cde1b8faa53",
                                        "glosses": [
                                            "häufig feines Gewebe, das aus ^([1]) besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1986461-d10c-4163-9251-ec759becc9ef",
                                                "sense_id": "0a150ee9-2258-3c3c-bc04-8852087e29c6",
                                                "text": "Die Bluse ist aus Seide und der Rock aus Leinen."
                                            },
                                            {
                                                "example_id": "65ebd736-ae30-4c93-b258-b2d1b4adab5a",
                                                "sense_id": "0a150ee9-2258-3c3c-bc04-8852087e29c6",
                                                "text": "Und je nachdem, um welchen Stoff es sich handelt, fällt ein Kleidungsstück auch anders. Das bedeutet, abhängig von Gewicht und Stoffstruktur bewegt sich der Stoff anders. Denn ein steifer Jeansstoff hat einen anderen Fall als ein weicher Stoff wie Seide oder Samt."
                                            },
                                            {
                                                "example_id": "9684b33b-dd29-42b6-b131-237f7ab8c775",
                                                "sense_id": "0a150ee9-2258-3c3c-bc04-8852087e29c6",
                                                "text": "Auch heute noch ist gute Seide ein im wahrsten Sinne des Wortes ‚kostbarer Stoff’. Eine ganz besonders begehrte Seide war die aus Zaitun. Glatt, glänzend und eben mit jener seidig glänzenden Oberfläche: Satin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5fea2dc5-e599-3493-8781-1f2eb1a83d18",
                                        "entry_id": "5f66fb81-0fad-3470-bfa5-0cde1b8faa53",
                                        "glosses": [
                                            "parasitische Kletterpflanze aus der Gattung Cuscuta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a263e06c-547b-47ef-aa95-fb022a25f473",
                                                "sense_id": "5fea2dc5-e599-3493-8781-1f2eb1a83d18",
                                                "text": "Die Brennnesseln waren vollständig mit Seide übersponnen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "751726c3-d3db-4bd4-8276-157112da1bb5",
                        "source_entry_id": "1418374c-2345-374b-9e9f-8004852a0914",
                        "target_lang_word": "Teufelszwirn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teufelszwirn",
