                ],
                "senses": [
                    {
                        "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                        "entry_id": "901aba80-30d4-372f-bdd5-6599ddd1d02b",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed023beb-bd2c-4539-bde3-ba090ce22a69",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Frau Peschel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e620fd62-1432-466e-80ba-9ca4880360bc",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Herr Peschel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ed38be8b-7277-42ef-8887-9b09ebe00708",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Die Peschels kommen heute aus den Berner Alpen."
                            },
                            {
                                "example_id": "0fa31390-1271-4260-b24b-5c0911fcabcd",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Der Peschel trägt nie die Schals, die die Peschel ihm strickt."
                            },
                            {
                                "example_id": "03283480-a14a-4371-ba6f-2ffb07ea9013",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Peschel kommt, geht der Herr Peschel.“"
                            },
                            {
                                "example_id": "57d11b4b-e01e-40ea-9c77-3bbb9cfb4e2d",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Peschel kommt und geht."
                            },
                            {
                                "example_id": "396a4cc7-0a06-4088-9994-39cd156bab19",
                                "sense_id": "26f41100-ef4d-3d0f-a1da-5ac59cbcb8ff",
                                "text": "Peschels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
