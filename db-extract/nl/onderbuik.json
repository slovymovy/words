                                "sense_id": "567522ff-895b-349a-9593-df1f1fc2f54e",
                                "text": "De chirurg opereerde in de onderbuik van de patiënt.",
                                "translation": "The surgeon operated in the underbelly of the patient.",
                                "english": "The surgeon operated in the underbelly of the patient."
                            }
