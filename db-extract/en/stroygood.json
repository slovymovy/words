                        "examples": [
                            {
                                "example_id": "9509f0e3-2872-46a8-94d6-3a1cde0d87a9",
                                "sense_id": "b695dda6-d24c-3fb2-b95c-a6a3379f9027",
                                "text": "To this same Turret up they went, and there with syghes behilld / The Oxen lying every where stark dead uppon the feelde / And eeke the cruell stroygood with his bluddy mouth and heare."
                            },
                            {
                                "example_id": "aa42929b-c6ad-4e31-a0b9-92e9b273ee25",
                                "sense_id": "b695dda6-d24c-3fb2-b95c-a6a3379f9027",
                                "text": "[…]If I should destroy and pull down those things which my predecessors have built and ordained, I should not be called a builder and maker, but justly accounted a stroy-good and puller down[…]"
                            },
                            {
                                "example_id": "647fcb90-729a-4694-a6f7-31ca4d50535e",
                                "sense_id": "b695dda6-d24c-3fb2-b95c-a6a3379f9027",
                                "text": "A Drunkard is a meer stroy-good."
                            }
                        ]
                    }
