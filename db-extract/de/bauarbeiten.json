                ],
                "senses": [
                    {
                        "sense_id": "1d1c3731-25c0-3cc2-b83d-76b198b6c8fe",
                        "entry_id": "0b79d854-6286-3531-805b-13bf18f342bd",
                        "glosses": [
                            "Errichtung, Umbau oder Abriss eines Bauwerks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b043b3aa-b60c-474f-b92c-3d94dd39b170",
                                "sense_id": "1d1c3731-25c0-3cc2-b83d-76b198b6c8fe",
                                "text": "Die Bauarbeiten waren in vollem Gange."
                            },
                            {
                                "example_id": "5ac153f0-0f32-49aa-942e-eb42dbb51639",
                                "sense_id": "1d1c3731-25c0-3cc2-b83d-76b198b6c8fe",
                                "text": "Werden Bauarbeiten angekündigt, sollten Sie als Mieter sofort eine Mietminderung prüfen."
                            },
                            {
                                "example_id": "7f4f77d4-beb2-4bd7-87ce-a56d46b62c41",
                                "sense_id": "1d1c3731-25c0-3cc2-b83d-76b198b6c8fe",
                                "text": "„In diesen Tagen beginnen die Bauarbeiten für das vierte Streckengleis zwischen der Verzweigung Hürlistein und Effretikon.“"
                            },
                            {
                                "example_id": "6137d0b4-9b3f-496d-953f-ab921704fb96",
                                "sense_id": "1d1c3731-25c0-3cc2-b83d-76b198b6c8fe",
                                "text": "„Die Bauarbeiten begannen Anfang Juni 1944; geplant war eine Bauzeit von 100 Tagen.“"
                            },
                            {
                                "example_id": "f41e4b82-07df-459c-b782-7f949a9e96ee",
                                "sense_id": "1d1c3731-25c0-3cc2-b83d-76b198b6c8fe",
                                "text": "„Zur Beschleunigung der Bauarbeiten wurden Häftlinge aus dem KZ Dachau angefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
