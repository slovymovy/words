                "senses": [
                    {
                        "sense_id": "dcf715da-b849-31e8-82ad-0a1cc6c180e6",
                        "entry_id": "8e8dcaaf-1720-3833-bf93-b99780857773",
                        "glosses": [
                            "Petit pays d’Afrique orientale, entouré du Rwanda au nord, de la Tanzanie au sud-est, du lac Tanganyika au sud-ouest, et de la République démocratique du Congo à l’ouest. Sa capitale est Gitega."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "caf31027-cbbe-43cb-ad0d-5443303feec1",
                                "sense_id": "dcf715da-b849-31e8-82ad-0a1cc6c180e6",
                                "text": "Dès qu’il a été nommé, la magie de l’effet Mandela a commencé à se produire. Je suis passé au Burundi quelques jours après sa nomination et après qu’il ait tenu son premier discours à Arusha, lorsqu’il s’est présenté aux négociateurs. C’était évident que l’atmosphère avait complètement changé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4011a722-52f1-45e4-8f74-5edd74e45e62",
                        "source_entry_id": "8e8dcaaf-1720-3833-bf93-b99780857773",
                        "source_sense_id": "dcf715da-b849-31e8-82ad-0a1cc6c180e6",
                        "target_lang_word": "Burundi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burundi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2dc59f63-1733-3355-9a89-c306b6210451",
                                        "entry_id": "bdf3415b-5651-3d78-8c86-7e4cc6d70546",
                                        "glosses": [
                                            "Staat in Ostafrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b49f2e5-320b-46ed-8545-26c5e1d4c7dc",
                                                "sense_id": "2dc59f63-1733-3355-9a89-c306b6210451",
                                                "text": "„Burundi ist einer der kleinsten Staaten Afrikas, aber – ebenso wie der Nachbarstaat Ruanda – sehr dicht besiedelt.“"
                                            },
                                            {
                                                "example_id": "1bcc68b2-b052-472b-8d0f-26a05bdc6fde",
                                                "sense_id": "2dc59f63-1733-3355-9a89-c306b6210451",
                                                "text": "Burundi liegt am nördlichen Rand des Tanganjikasees."
                                            },
                                            {
                                                "example_id": "367054a0-6f1a-414d-ab08-7117ef5ce1b0",
                                                "sense_id": "2dc59f63-1733-3355-9a89-c306b6210451",
                                                "text": "Bujumbura ist die Hauptstadt von Burundi."
                                            },
                                            {
                                                "example_id": "6cf02d93-56bf-4152-92d8-acc80d703d53",
                                                "sense_id": "2dc59f63-1733-3355-9a89-c306b6210451",
                                                "text": "„ 1890 wurde Burundi zusammen mit dem heutigen Ruanda der Kolonie Deutsch-Ostafrika angegliedert und ab 1899 als Militärdistrikt verwaltet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
