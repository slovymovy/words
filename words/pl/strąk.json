{
    "word_family": [
        "strączek",
        "strąkowy",
        "strączkowy",
        "strączkowate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "491c131d-55c5-3cff-a8cc-cc4eec6eba63",
                    "sense_definition": "suchy owoc pękający, charakterystyczny dla roślin bobowatych, zawierający nasiona w jednym rzędzie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dojrzały <w>strąk</w> fasoli pęka samoczynnie, rozsypując nasiona po ziemi.",
                            "target_lang_translations": {
                                "ru": "Спелый <w>стручок</w> фасоли лопается сам по себе, рассыпая семена по земле."
                            }
                        },
                        {
                            "text": "W ogrodzie zerwaliśmy niejeden zielony <w>strąk</w> świeżego grochu na obiad.",
                            "target_lang_translations": {
                                "ru": "В огороде мы сорвали к обеду не один зелёный <w>стручок</w> свежего гороха."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zielony strąk",
                        "strąk grochu",
                        "strąk fasoli"
                    ],
                    "target_lang_definitions": {
                        "ru": "сухой раскрывающийся плод, характерный для бобовых растений, содержащий семена в один ряд"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стручок",
                                "target_lang_sense_clarification": "плод гороха, фасоли и т. п. (в обиходном значении)"
                            },
                            {
                                "target_lang_word": "боб",
                                "target_lang_sense_clarification": "плод бобовых растений (в точном ботаническом значении)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d56db868-572b-316b-857f-97fdf61bff40",
                    "sense_definition": "posklejany, przetłuszczony lub mokry kosmyk włosów",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "włosy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po ulewnym deszczu jej mokry <w>strąk</w> włosów opadł prosto na czoło.",
                            "target_lang_translations": {
                                "ru": "После проливного дождя мокрая <w>сосулька</w> волос упала ей прямо на лоб."
                            }
                        },
                        {
                            "text": "Zaniedbany chłopak miał na głowie niejeden tłusty <w>strąk</w> posklejanych włosów.",
                            "target_lang_translations": {
                                "ru": "На голове у неухоженного парня свисали жирные <w>сосульки</w> слипшихся волос."
                            }
                        }
                    ],
                    "synonyms": [
                        "kosmyk",
                        "pasmo"
                    ],
                    "common_phrases": [
                        "tłusty strąk",
                        "mokry strąk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w liczbie mnogiej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "слипшаяся, засаленная или мокрая прядь волос; сосулька (о волосах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосулька",
                                "target_lang_sense_clarification": "о слипшейся или засаленной пряди волос"
                            },
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "слипшийся или свисающий пучок волос"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b3534362-1139-314b-badd-c44bdfdb72e3",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Strąk</w> został wczoraj wybrany na nowego prezesa lokalnego klubu sportowego.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Стронк</w> был вчера избран новым председателем местного спортивного клуба."
                            }
                        },
                        {
                            "text": "Wczoraj spotkałem pana Marcina <w>Strąka</w> na spotkaniu mieszkańców osiedla.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил пана Марцина <w>Стронка</w> на собрании жителей микрорайона."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko męskie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стронк",
                                "target_lang_sense_clarification": "мужская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec6736a9-e827-32dd-b63c-a0cabb261ddb",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Strąk</w> prowadzi od wielu lat małą księgarnię w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Стронк</w> уже много лет держит небольшой книжный магазин в центре города."
                            }
                        },
                        {
                            "text": "Doktor Anna <w>Strąk</w> wygłosiła ciekawy wykład na temat współczesnej medycyny.",
                            "target_lang_translations": {
                                "ru": "Доктор Анна <w>Стронк</w> прочитала интересную лекцию о современной медицине."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko żeńskie nieodmienne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стронк",
                                "target_lang_sense_clarification": "женская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
