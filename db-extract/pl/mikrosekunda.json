                        "examples": [
                            {
                                "example_id": "837f0f20-2a6d-468a-94fb-362282b47035",
                                "sense_id": "bfd74f2a-c8dc-3bdf-b24e-78f82603925f",
                                "text": "Zaobserwowany ostatnio izotop pierwiastka 112 żył zaledwie 240 mikrosekund."
