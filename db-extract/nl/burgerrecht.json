                "senses": [
                    {
                        "sense_id": "10f50d78-b1bd-3ef8-977a-be95e6c6446e",
                        "entry_id": "2c2aea66-51a3-3ab0-8815-e912576c66d2",
                        "glosses": [
                            "een recht dat men geniet als staatsburger van een land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a501d1fc-968f-455a-9c8c-1e84f6ca76eb",
                                "sense_id": "10f50d78-b1bd-3ef8-977a-be95e6c6446e",
                                "text": "Onder de apartheid werden velen van hun burgerrechten beroofd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f309907-25a5-40d2-a6c5-44c7c254317f",
                        "source_entry_id": "2c2aea66-51a3-3ab0-8815-e912576c66d2",
                        "source_sense_id": "10f50d78-b1bd-3ef8-977a-be95e6c6446e",
                        "source_sense_description": "een recht dat men geniet als staatsburger van een land",
                        "target_lang_word": "Bürgerrecht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgerrecht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd88002a-d975-3607-90ba-1b30d5a93e56",
                                        "entry_id": "2b8b7e41-d1f8-3fe0-9f18-1c5a734343a7",
                                        "glosses": [
                                            "Recht, das allen Menschen aufgrund ihrer Eigenschaft als Bürger (eines Staates, einer Gemeinde) zusteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca0a9a2-0f90-42de-9285-602c3a45e09e",
                                                "sense_id": "fd88002a-d975-3607-90ba-1b30d5a93e56",
                                                "text": "„Nero bot den beiden dann großzügig das römische Bürgerrecht an.“"
                                            },
                                            {
                                                "example_id": "7e9a3676-17c0-49e6-8a2e-dc1d3ddf8004",
                                                "sense_id": "fd88002a-d975-3607-90ba-1b30d5a93e56",
                                                "text": "„Wer seine Bürgerrechte in Anspruch nimmt, läuft Gefahr, sich langwierigen Prozessen auszusetzen.“"
                                            },
                                            {
                                                "example_id": "936e80d5-6c55-4c53-a4c2-5ccf9e8a836c",
                                                "sense_id": "fd88002a-d975-3607-90ba-1b30d5a93e56",
                                                "text": "„Nachdem die Juden 1796 unter französischer Besatzung erstmals volle Bürgerrechte erhalten hatten, wurde in der aschkenasischen Gemeinde Amsterdam ein erbitterter Streit um eine politische und religiöse Modernisierung ausgetragen.“"
                                            },
                                            {
                                                "example_id": "b8110500-3a4a-490c-9b74-ddbaea1e4a37",
                                                "sense_id": "fd88002a-d975-3607-90ba-1b30d5a93e56",
                                                "text": "„Als er das Bürgerrecht der Stadt Zürich erhielt, mußte er zur Musterung für den Militärdienst antreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea8ac988-da61-3bbb-83c2-5fb0405d4b21",
                                        "entry_id": "2b8b7e41-d1f8-3fe0-9f18-1c5a734343a7",
                                        "glosses": [
                                            "Menschenrechte, insbesondere bevor sie gesetzlich festgeschrieben sind und noch erkämpft werden müssen"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ee5297-6690-4bb0-a027-88ced9c25268",
                                                "sense_id": "ea8ac988-da61-3bbb-83c2-5fb0405d4b21",
                                                "text": "„Hier sammelten sich jene Mitglieder der FDP, die sich in besonderem Maß für Freiheit und Bürgerrechte einsetzen wollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
