                    {
                        "translation_id": "d366406c-7659-444c-b64e-cbd0de611484",
                        "source_entry_id": "aa154539-2334-3564-abc0-a8afe083e9f9",
                        "source_sense_description": "a plinth or pedestal",
                        "target_lang_word": "пьедеста́л",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пьедеста́л",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3755d023-5a14-3b5b-8d9b-0cf5cc414b86",
                                        "entry_id": "f9ae47ce-ac74-361a-914f-e6094d9712aa",
                                        "glosses": [
                                            "основание, подножие, на котором установлен памятник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35850274-5b1b-4fd8-8c0e-63afe88dbe49",
                                                "sense_id": "3755d023-5a14-3b5b-8d9b-0cf5cc414b86",
                                                "text": "Интересно, что уже в 1997 году памятник Дзержинскому был почищен и поставлен на пьедестал, только не на Лубянке, а в «парке искусств» рядом с ЦДХ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a996d54-4eb3-3096-8ea3-60fe2de5350b",
                                        "entry_id": "f9ae47ce-ac74-361a-914f-e6094d9712aa",
                                        "glosses": [
                                            "спорт. возвышение, на котором производится награждение победителей и призёров соревнований"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de335ff-6456-4848-a342-b303131aeb0b",
                                                "sense_id": "3a996d54-4eb3-3096-8ea3-60fe2de5350b",
                                                "text": "А соперник долго не мог сдержать слез, даже выйдя на награждение и взойдя на пьедестал почёта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "560f6f03-ddd0-36b6-ba96-3ec12b738ae3",
                                        "entry_id": "f9ae47ce-ac74-361a-914f-e6094d9712aa",
                                        "glosses": [
                                            "перен. высокое общественное положение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef667b32-e3b9-4dbf-87fb-17ce405f5f36",
                                                "sense_id": "560f6f03-ddd0-36b6-ba96-3ec12b738ae3",
                                                "text": "Вознести на пьедестал."
                                            },
                                            {
                                                "example_id": "4c525846-35c3-4eb3-adca-7f5bf676de7d",
                                                "sense_id": "560f6f03-ddd0-36b6-ba96-3ec12b738ae3",
                                                "text": "Блеск… довёл его, наконец, до некоторого, весьма высокого и приятного для самолюбия, пьедестала."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1144494e-2c8d-4f6d-8591-345bfedc5f74",
                        "source_entry_id": "aa154539-2334-3564-abc0-a8afe083e9f9",
                        "source_sense_description": "a plinth or pedestal",
                        "target_lang_word": "цо́коль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цо́коль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "418502f5-1fdf-3a57-8a48-2a039b378641",
                                        "entry_id": "0e4812a9-856d-3868-9a76-f9bc69ef0e4a",
                                        "glosses": [
                                            "строит. нижняя, обычно несколько утолщённая часть стены каменного здания, основание сооружения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a8f995-96fc-4d70-9de0-1a5cc28b4814",
                                                "sense_id": "418502f5-1fdf-3a57-8a48-2a039b378641",
                                                "text": "Гранитный цоколь."
                                            },
                                            {
                                                "example_id": "9c6f5637-975a-4e13-bb6a-52716014c3d8",
                                                "sense_id": "418502f5-1fdf-3a57-8a48-2a039b378641",
                                                "text": "Институт, высоко приподнятый над улицей на массивном гранитном цоколе, поразил Люсина своей демократичной доступностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17bb1bdd-9b9e-33a1-8d18-0156387929ab",
                                        "entry_id": "0e4812a9-856d-3868-9a76-f9bc69ef0e4a",
                                        "glosses": [
                                            "архит. нижняя утолщённая часть колонны, пилястры, памятника"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f6a77c5-0e30-4c6c-8e28-ac519a45b139",
                                                "sense_id": "17bb1bdd-9b9e-33a1-8d18-0156387929ab",
                                                "text": "В мраморном лике царственная гордость. Хочется преклонить колени, облобызать цоколь, зарыдать слезами восторга. Тишина, как в храме. Входят на цыпочках."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256c3354-251e-3c48-8c2e-f18b0c76be54",
                                        "entry_id": "0e4812a9-856d-3868-9a76-f9bc69ef0e4a",
                                        "glosses": [
                                            "эл.-техн. часть электрической лампы с электрическими контактами, служащая для ввинчивания лампы в патрон"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556aba48-b6d1-4176-87e8-70a2e374bf13",
                                                "sense_id": "256c3354-251e-3c48-8c2e-f18b0c76be54",
                                                "text": "Очень похожи на ёлочную гирлянду: синий провод и маленькие остренькие лампочки, правда, с чёрными непрозрачными цоколями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf8a154-e351-3767-bd72-10aa9a0fdbb8",
                                        "entry_id": "0e4812a9-856d-3868-9a76-f9bc69ef0e4a",
                                        "glosses": [
                                            "геол. основание; масса горных пород, подстилающая осадочный чехол"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff015cb4-d84f-47e4-9e75-e20f702d1f26",
                                                "sense_id": "ebf8a154-e351-3767-bd72-10aa9a0fdbb8",
                                                "text": "В тектоническом отношении хайтинскую толщу нельзя причленять к древнему архейскому цоколю Сибирской платформы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
