                    },
                    {
                        "translation_id": "dc60648c-654f-4572-8b46-51aadf16d370",
                        "source_entry_id": "708ca8db-66d5-3086-8bc1-a3978e6d3cb1",
                        "source_sense_description": "тот, кто использует популизм, склонен к популизму",
                        "target_lang_word": "Populist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Populist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                        "entry_id": "e2908eec-c167-32c2-b000-0a32c8ffc02f",
                                        "glosses": [
                                            "Person, die ein Anhänger oder Vertreter des Populismus ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e118040c-31f8-4b62-bec9-4016c27c2142",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "In Europa sind eher Populisten am rechten politischen Spektrum erfolgreich, in Lateinamerika stehen sie links von der Mitte."
                                            },
                                            {
                                                "example_id": "78fd6bc3-37b4-49d2-97a8-7f88c37c0e13",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Entweder der Begriff Populist wird in einen neuen Kontext gestellt, oder aber er verschwindet gänzlich.“"
                                            },
                                            {
                                                "example_id": "7ef877cc-31f6-4433-b1ac-1ffce133d77b",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Dann könnte die Stunde des heute noch unbekannten Populisten schlagen.“"
                                            },
                                            {
                                                "example_id": "4c132121-6b08-4df8-99a4-934f945e6845",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Etwas unsicher auch Robert Misik in der Berliner TAZ: War der Populist Haider schwul oder bi? Und was geht uns das an?“"
                                            },
                                            {
                                                "example_id": "6fb52bf8-f967-45f9-8e58-0fb3a883f355",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Eines hat der Sportler Kohl mit dem Populisten Haider gemein: Er hat es mit Halbwahrheiten und perfiden Methoden an die Spitze geschafft.“"
                                            },
                                            {
                                                "example_id": "15dcfdcc-dacc-429b-b8e0-12df6e4d422d",
                                                "sense_id": "1728554a-1d6f-360b-98b2-f7f3f54e0219",
                                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
