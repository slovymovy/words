                                "target_senses": [
                                    {
                                        "sense_id": "3d38b989-3a9e-3aea-9e95-2ed75c0697c8",
                                        "entry_id": "86c7d40d-ac26-399c-9b26-cbc756a356b1",
                                        "glosses": [
                                            "A country in South Asia. Official name: Islamic Republic of Pakistan. Capital: Islamabad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05c602dc-5de3-4d7f-9d1f-56edf3eac5d8",
                                                "sense_id": "3d38b989-3a9e-3aea-9e95-2ed75c0697c8",
                                                "text": "Described by witnesses as a keen cricketer and pubgoer until contacts with Islamic militants radicalized him on a trip to Pakistan, he was ordered to serve at least 14 years for the plot, and for supplying militants in Afghanistan with money and equipment."
                                            },
                                            {
                                                "example_id": "5ae21801-0d49-49c6-b884-a2ee000bb2bb",
                                                "sense_id": "3d38b989-3a9e-3aea-9e95-2ed75c0697c8",
                                                "text": "Sharif at the time said the decision “will save the country precious foreign exchange” and that Pakistan has to “practice austerity.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb85af9a-ece9-4e9b-b036-e7562e5d565a",
                        "source_entry_id": "69154a42-b50e-3c7a-b5a7-60004c7bd15a",
                        "source_sense_id": "dbad2080-b6eb-3e3d-bc55-d189db24fd07",
                        "source_sense_description": "een land in het zuiden van Azië grenzend aan India, Afghanistan, Iran en China. De officiële naam is de Islamitische Republiek Pakistan",
