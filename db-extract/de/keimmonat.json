                                "target_senses": [
                                    {
                                        "sense_id": "c5076b8a-af4b-3e99-b92c-85efdb9a20b7",
                                        "entry_id": "653363b1-9deb-3622-9506-bd7018bb4907",
                                        "glosses": [
                                            "Septième mois du calendrier républicain, qui s’étendait du 21 mars au 20 avril."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c02eb6d-5685-4162-b3b2-319d67eecb1c",
                                                "sense_id": "c5076b8a-af4b-3e99-b92c-85efdb9a20b7",
                                                "text": "[…] une plainte envoyée le 6 germinal an IV à Lazare Hoche […] donne du poids, si besoin est, au récit d'Alice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9edb453-019a-4b00-8468-2bf46053d858",
                        "source_entry_id": "117f627a-00e2-3ae0-b9d9-9a0c1caab63a",
                        "source_sense_id": "6d595178-5711-3e15-bb7d-e4f9379b2e19",
                        "source_sense_description": "siebter Monat des französischen Revolutionskalenders",
                        "target_lang_word": "жерминаль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жерминаль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f8f8cb6b-192a-3602-917f-8dcd3b2efbef",
                                        "entry_id": "5f3fc0f8-5d70-36b6-b4a0-90993bc40d74",
                                        "glosses": [
                                            "истор. седьмой месяц французского республиканского календаря (1793–1805 гг.); соответствует времени с 21 марта по 19 апреля по новому стилю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f93c4f6-0d10-4813-93c8-cd6fb2bc6070",
                                                "sense_id": "f8f8cb6b-192a-3602-917f-8dcd3b2efbef",
                                                "text": "Подобно многим другим героям итальянской легенды, Кекко Руска пас коз в дни своей юности, ― в день 22-го жерминаля 1796 года в горах Гаргаро, близ Савоны, на генуэзском побережье."
                                            },
                                            {
                                                "example_id": "b54a4be1-8c22-4b77-be47-396098496988",
                                                "sense_id": "f8f8cb6b-192a-3602-917f-8dcd3b2efbef",
                                                "text": "Потом будет туманный месяц ― брюмер, а следующий ― месяц и́нея ― фример, потом снежный месяц ― нивоз, месяц ветра ― вонтоз, дождя ― плювиоз, месяц посева ― жерминаль, луговой месяц ― прериаль, цветочный месяц ― флореаль, месяц, дающий тепло, ― термидор, дающий жатву ― мессидор, дающий плоды ― фрюктидор."
                                            },
                                            {
                                                "example_id": "bfb6a94c-df6c-4138-beb1-5e083508bc5a",
                                                "sense_id": "f8f8cb6b-192a-3602-917f-8dcd3b2efbef",
                                                "text": "На каждом выдавливаю грифельком карандаша название по якобинскому календарю: жерминаль, флореаль, термидор…"
                                            },
                                            {
                                                "example_id": "05c10f59-43b0-4bcf-b157-c795e723f272",
                                                "sense_id": "f8f8cb6b-192a-3602-917f-8dcd3b2efbef",
                                                "text": "А третья студентка известна тем, что на вопрос о том, что такое «Жерминаль», ответила: «Главный персонаж романа «Жерминаль»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
