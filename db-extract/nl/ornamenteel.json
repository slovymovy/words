                                        "entry_id": "ba443071-8c58-375e-9a37-970e7ea078f3",
                                        "glosses": [
                                            "Serving as an ornament; having no purpose other than to make more beautiful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680c1090-2c44-4894-8bfe-631b0bc11ff9",
                                                "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                                "text": "Some think it most ornamental to wear their bracelets on their wrists; others, about their ankles."
                                            },
                                            {
                                                "example_id": "bdac60d7-da2e-4ba8-acd7-c53e46b8bfa0",
                                                "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                                "text": "We shall leave to the reader to determine with what judgment we have chosen the several occasions for inserting those ornamental parts of our work."
                                            },
                                            {
                                                "example_id": "0406b388-73fc-42cd-bf00-3934ba29545d",
                                                "sense_id": "f92ba4fc-c781-3208-835f-7a5ef7a2d7bd",
                                                "text": "There were ornamental ponds and shrubs clipped into animal shapes, painted concrete gnomes sitting on mushrooms, pink flamingos standing on one leg[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75596418-e7aa-3852-b70c-55d8764f08ab",
                                        "entry_id": "ba443071-8c58-375e-9a37-970e7ea078f3",
                                        "glosses": [
                                            "Bred for aesthetic or decorative purposes."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "239ef5fd-2e9f-40e1-923c-37a78c973498",
                                                "sense_id": "75596418-e7aa-3852-b70c-55d8764f08ab",
                                                "text": "Those pine trees on the lawn are the fastest-growing ornamentals we could find."
                                            }
                                        ]
                                    }
                                ]
                            },
