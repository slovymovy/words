                ],
                "senses": [
                    {
                        "sense_id": "73872b27-23d0-3c04-91c5-c0b7568b4c27",
                        "entry_id": "1e537a96-4788-31d6-abaf-c14d0841c96a",
                        "glosses": [
                            "город в провинции Хубэй КНР"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f4aa91-cba9-4c53-a6e9-fe79e222786f",
                                "sense_id": "73872b27-23d0-3c04-91c5-c0b7568b4c27",
                                "text": "Одной из самых интересных находок конца XX века является янцзяньский человек, ископаемые останки которого были обнаружены в провинции Хубей в Южном Китае, в сорока километрах от города Ухань."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9876660-bddd-4ea4-a7cf-5440e739197b",
                        "source_entry_id": "1e537a96-4788-31d6-abaf-c14d0841c96a",
                        "source_sense_id": "73872b27-23d0-3c04-91c5-c0b7568b4c27",
                        "source_sense_description": "город в Китае",
                        "target_lang_word": "Wuhan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wuhan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                        "entry_id": "c2eaf371-4bcd-3b4a-b1ce-aa460b63ed8d",
                                        "glosses": [
                                            "A subprovincial city, the provincial capital of Hubei, China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c04f9b6f-52f2-4d6d-8863-259e519c12b5",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "The Committee reports that in consequence of the combined effects of the war and famine added to flood an amount of destitution exists among the population in the Wuhan region which is without parallel in the memory of foreign residents. Now that the refugees are returning to Hankow there is a demand for building materials, clothing and food stuffs."
                                            },
                                            {
                                                "example_id": "adef6b77-c951-4014-9a22-1c33e54fe200",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "The preparatory group for the \"Mao Tse-tung's thought\" Red Guard congress of universities and middle schools in Wuhan has been formed. Its task is to convene the Wuhan Red Guard congress as soon as possible."
                                            },
                                            {
                                                "example_id": "e86c54e2-878a-4171-9622-334165932c72",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "Yet charges that Wuhan was run like an independent kingdom contained an element of truth. Firmly entrenched in Wuhan for more than ten years, the PLA had become accustomed to acting independently."
                                            },
                                            {
                                                "example_id": "ef505c3a-48d1-414f-bc50-77d66f1c281b",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "More than 30 persons, most of them farmers on the verge of starving to death, were convicted of \"counter-revolutionary\" charges at kangaroo court in Wuhan and given sentences ranging from two to 12 years, it was reported from Hongkong February 25.[…]\nWuhan is the collective name of Wuchang, Hankow and Hanyang at the confluence of the Yangtze and Han rivers in Hupei province, central China.\nSome of the farmers were arrested in Wuhan parks where they allegedly spoke against Maoism and the Communist dictatorship, the report said.\nOthers were charged with breaking into a Communist granary in Wuhan, it said."
                                            },
                                            {
                                                "example_id": "c578375b-93a3-4608-a7b3-ffc5534b5170",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "Responsible comrades of the provincial and municipal CCP committees, army units stationed in Wuhan, members of the CCP and revolutionary masses have gone to Chairman Mao's old residence and the site of the Central Peasant's Movement Training School founded by Chairman Mao in Wuchang, to mourn the death of Chairman Mao, the great leader and teacher."
                                            },
                                            {
                                                "example_id": "381d9bdd-b952-4c16-9397-87ab1b39ee90",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "Chinese health authorities on Tuesday said they are investigating 27 cases of viral pneumonia in central Hubei province, amid online speculation that it could be linked to the SARS flu-like virus that killed hundreds of people a decade ago.\nA team of senior health experts were dispatched to the city of Wuhan and were reported by state broadcaster CCTV to be \"conducting relevant inspection and verification work.\""
                                            },
                                            {
                                                "example_id": "0d73207d-7578-4c1e-90fa-16dfbcde58ba",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "Intelligence agencies do not believe the case of three workers from a laboratory in Wuhan, China, who became ill in 2019 can help shed light on whether the Covid-19 pandemic originated from an accidental lab leak, according to a report made public Friday."
                                            },
                                            {
                                                "example_id": "768174d9-219c-4bb1-a6f9-063ad5101ea1",
                                                "sense_id": "11c2b948-752a-32eb-863e-7d25f0d5105c",
                                                "text": "For quotations using this term, see Citations:Wuhan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
