                "entry_id": "9b3259d2-5b5a-3968-9837-34f5396cb55e",
                "word": "synérèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f31cc92a-51b0-4a16-bfff-40a66fed1506",
                        "entry_id": "9b3259d2-5b5a-3968-9837-34f5396cb55e",
                        "tags": [
                            "plural"
                        ],
                        "form": "synérèses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db302f2f-f963-34b2-a3af-09fdc7a0351c",
                        "entry_id": "9b3259d2-5b5a-3968-9837-34f5396cb55e",
                        "glosses": [
                            "Contraction, réunion de deux syllabes en une seule dans un même mot, mais sans aucun changement de lettres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17b83f5d-2124-422b-8716-5a63347133fb",
                                "sense_id": "db302f2f-f963-34b2-a3af-09fdc7a0351c",
                                "text": "Les poètes latins font quelquefois de deux syllabes les mots deerant, Orpheus, etc., par synérèse."
                            },
                            {
                                "example_id": "b6db452d-1dd3-49f3-b84c-7db32e9aa0a1",
                                "sense_id": "db302f2f-f963-34b2-a3af-09fdc7a0351c",
                                "text": "Août qui se dit «out» et Saône qui se prononce «sone», sont deux exemples de synérèse."
                            }
                        ]
                    },
                    {
                        "sense_id": "014fd824-e126-3f1c-b072-e547e0871c92",
                        "entry_id": "9b3259d2-5b5a-3968-9837-34f5396cb55e",
                        "glosses": [
                            "Phénomène de fusion des deux voyelles d’une diphtongue afin de respecter le mètre dans un vers."
                        ],
                        "tags": [
                            "Versification"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "db32b426-c4d7-3197-b97f-1d4a0c424028",
                        "entry_id": "9b3259d2-5b5a-3968-9837-34f5396cb55e",
                        "glosses": [
                            "Transformation lente et progressive d’un gel qui expulse son solvant."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "a8b89a40-aa5c-4057-bf40-20ae88950ca8",
                                "sense_id": "db32b426-c4d7-3197-b97f-1d4a0c424028",
                                "text": "Il est a priori compréhensible que l'addition à un gel de solvants qui diminuent leur degré de solvatation (d’hydratation s’il s'agit d’hydrogels) doive accentuer la synérèse."
                            },
                            {
                                "example_id": "87164e93-2f03-4966-a85c-247bbb79a0ed",
                                "sense_id": "db32b426-c4d7-3197-b97f-1d4a0c424028",
                                "text": "Le gel peut perdre de l'eau par évaporation à sa surface, ou par exsudation de fluide par un processus que l'on appelle « synérèse ». C'est l'une des propriétés caractéristiques d'un gel."
                            }
                        ]
                    }
                ],
