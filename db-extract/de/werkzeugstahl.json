                "senses": [
                    {
                        "sense_id": "6733cf03-b7b1-3482-9c3d-2b04d2b38e0c",
                        "entry_id": "21f70446-7080-35fc-97a6-6ad19c5e1fc7",
                        "glosses": [
                            "besonders verschleißfester Stahl zur Herstellung von Werkzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed8b0bc-f561-428a-9cbb-177ec369b0e3",
                                "sense_id": "6733cf03-b7b1-3482-9c3d-2b04d2b38e0c",
                                "text": "Im Handel gibt es legierten und unlegierten Werkzeugstahl."
                            },
                            {
                                "example_id": "08c92c53-81ec-48bf-9e52-713652fad343",
                                "sense_id": "6733cf03-b7b1-3482-9c3d-2b04d2b38e0c",
                                "text": "„Die Sparte High performace Metals ist globaler Marktführer bei Werkzeugstahl und beschäftigt weltweit 13.700 Mitarbeiter. 2016/17 erzielte die Division 2,7 Milliarden Euro Umsatz, davon die Hälfte außerhalb Europas.“"
                            },
                            {
                                "example_id": "ab2f7d25-fb87-4be9-93ae-123f346da9a5",
                                "sense_id": "6733cf03-b7b1-3482-9c3d-2b04d2b38e0c",
                                "text": "„Neben Rolex gehören auch andere namhafte Schweizer Uhrenhersteller von der Haute Horlogerie abwärts zum Kundenstock von Böhler Edelstahl, das zu den weltweit bedeutendsten Anbietern von Schnellarbeitsstahl, Werkzeugstahl sowie Sonderwerkstoffen zählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
