    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d9637507-a3fa-33b8-acb1-e1db1828e57c",
                "word": "jacketed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e457cc19-2e12-3d79-bc42-3c19133487c3",
                        "entry_id": "d9637507-a3fa-33b8-acb1-e1db1828e57c",
                        "glosses": [
                            "Dressed in a jacket."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9b851a1d-d2a4-4cd7-815d-e9057cbcfb54",
                                "sense_id": "e457cc19-2e12-3d79-bc42-3c19133487c3",
                                "text": "For if a peer come like a porter jacketed,\nRetire he must:—tho’ up he raise his back at it,"
                            },
                            {
                                "example_id": "ff3b9b76-9d1f-47e1-9cf7-3a8b8141ecf9",
                                "sense_id": "e457cc19-2e12-3d79-bc42-3c19133487c3",
                                "text": "1895, Bret Harte, “A Convert of the Mission” first published in Boston Transcript, 10 December, 1895,\nFrom the velvet-jacketed figures lounging motionless in the shadows of the open doorways—so motionless that only the lazy drift of cigarette smoke betokened their breathing—to the reclining peons in the shade of a catalpa, or the squatting Indians in the arroyo—all was sloth and dirt."
                            },
                            {
                                "example_id": "02cfdcfb-e309-4fff-87e2-48742c8d4d82",
                                "sense_id": "e457cc19-2e12-3d79-bc42-3c19133487c3",
                                "text": "The residence of the British Council representative was in a quieter and perhaps more patrician part of Lija than my own. Geoffrey, sitting tied and jacketed next to Ali, who was driving, pointed this out […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "2cdfb00b-d6f1-3e12-802e-f7deb9523937",
                        "entry_id": "d9637507-a3fa-33b8-acb1-e1db1828e57c",
                        "glosses": [
                            "Encased or enclosed inside a jacket."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b2277cd-db15-4094-9bf1-fa3820fa2ce5",
                                "sense_id": "2cdfb00b-d6f1-3e12-802e-f7deb9523937",
                                "text": "One of the advantages of a matrix would be to reduce the cost of our shrapnel by enabling hardened lead balls and round cases to be used in place of the steel-jacketed balls and hexagonal cases..."
                            },
                            {
                                "example_id": "ef63a255-e23f-4aa8-b48c-322bb978566c",
                                "sense_id": "2cdfb00b-d6f1-3e12-802e-f7deb9523937",
                                "text": "The metal can completely jacketed must have iron, steel or wooden jacket completely covering the can, except the mouth."
                            },
                            {
                                "example_id": "6ad02a5e-0f53-4a2f-928b-d50e1cb26da1",
                                "sense_id": "2cdfb00b-d6f1-3e12-802e-f7deb9523937",
                                "text": "Much of the time, when no customers came, he spent reading the yellow-jacketed trash that the library contained. Books of that type you could read at the rate of one an hour."
                            }
                        ]
                    }
