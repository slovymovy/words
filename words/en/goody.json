{
    "word_family": [
        "good",
        "goodness",
        "goody-goody"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6253a448-2fba-3f36-9ed2-1182097adb00",
                    "sense_definition": "A tasty sweet item to eat, especially a piece of candy, a pastry, or a snack.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "treats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children found a basket packed with sweet <w>goodies</w> on the counter.",
                            "target_lang_translations": {
                                "ru": "Дети нашли на стойке корзину, наполненную сладкими <w>лакомствами</w>."
                            }
                        },
                        {
                            "text": "She tucked a delicious baked <w>goody</w> into her lunchbox for dessert.",
                            "target_lang_translations": {
                                "ru": "Она положила в ланчбокс на десерт аппетитную домашнюю <w>вкусняшку</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baked goodies",
                        "delicious goodies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вкусное сладкое угощение, особенно конфета, выпечка или десерт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лакомство",
                                "target_lang_sense_clarification": "сладкая или вкусная еда"
                            },
                            {
                                "target_lang_word": "вкусняшка",
                                "target_lang_sense_clarification": "разговорное название угощения или сладости"
                            },
                            {
                                "target_lang_word": "сладость",
                                "target_lang_sense_clarification": "десерт, кондитерское изделие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8899c55-5f32-3262-84cb-857dacfa3097",
                    "sense_definition": "A desirable bonus, gift, or perk given to someone for free or as part of a promotional package.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "treats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The event organizers handed each attendee a small bag filled with promotional <w>goodies</w>.",
                            "target_lang_translations": {
                                "ru": "Организаторы мероприятия вручили каждому участнику небольшой пакет с рекламными <w>сувенирами</w>."
                            }
                        },
                        {
                            "text": "Every conference guest received a surprising <w>goody</w> at the registration desk.",
                            "target_lang_translations": {
                                "ru": "Каждый гость конференции получил на стойке регистрации неожиданный <w>подарочек</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "goody bag",
                        "free goodies"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "commonly used in plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный бонус, подарок, сувенир или привилегия, предоставляемые бесплатно либо в рамках рекламной акции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подарочек",
                                "target_lang_sense_clarification": "небольшой бесплатный сувенир или презент"
                            },
                            {
                                "target_lang_word": "бонус",
                                "target_lang_sense_clarification": "приятное дополнение или выгода"
                            },
                            {
                                "target_lang_word": "ништяк",
                                "target_lang_sense_clarification": "жаргонное обозначение приятной вещи, подарка или бонуса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42947bd0-3694-38e8-bd83-360e7f74b249",
                    "sense_definition": "A character who is morally righteous and represents good, particularly in stories, films, or wrestling.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In classic action movies, the <w>goody</w> always prevails against the villain.",
                            "target_lang_translations": {
                                "ru": "В классических боевиках <w>положительный герой</w> всегда побеждает злодея."
                            }
                        },
                        {
                            "text": "The crowd cheered wildly whenever the brave <w>goody</w> returned to the wrestling ring.",
                            "target_lang_translations": {
                                "ru": "Толпа неистово ликовала каждый раз, когда отважный <w>хороший парень</w> возвращался на ринг."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal alternative form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положительный персонаж, олицетворяющий добро в кино, литературе или рестлинге; герой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положительный герой",
                                "target_lang_sense_clarification": "персонаж, олицетворяющий добро"
                            },
                            {
                                "target_lang_word": "хороший парень",
                                "target_lang_sense_clarification": "герой, противостоящий злодеям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13eb784e-0a4d-3270-b5d0-8d92c63f2694",
                    "sense_definition": "The most desirable, flavorful, or useful essence extracted or exhausted from something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chewed the bubble gum until she had taken all the <w>goody</w> out of it.",
                            "target_lang_translations": {
                                "ru": "Она жевала жвачку до тех пор, пока из неё не ушёл весь <w>вкус</w>."
                            }
                        },
                        {
                            "text": "Simmer the bones gently to draw all the <w>goody</w> into the warm broth.",
                            "target_lang_translations": {
                                "ru": "Варите кости на медленном огне, чтобы весь <w>сок</w> перешёл в горячий бульон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "all the goody"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая ценная, вкусная или полезная суть, извлекаемая из чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкус",
                                "target_lang_sense_clarification": "насыщенность, смак"
                            },
                            {
                                "target_lang_word": "сок",
                                "target_lang_sense_clarification": "переносно: суть, полезные вещества"
                            },
                            {
                                "target_lang_word": "смак",
                                "target_lang_sense_clarification": "самое приятное или аппетитное свойство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c713bf44-a644-3e06-af01-a6c6d952f147",
                    "sense_definition": "A traditional sweet pudding prepared by boiling pieces of bread in milk with sugar and spices.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmother prepared a comforting bowl of warm <w>goody</w> for the sick child.",
                            "target_lang_translations": {
                                "ru": "Бабушка приготовила для заболевшего ребёнка миску сытного тёплого <w>хлебного пудинга</w>."
                            }
                        },
                        {
                            "text": "Traditional rural recipes often included simple <w>goody</w> made from leftover bread crusts.",
                            "target_lang_translations": {
                                "ru": "Традиционные деревенские рецепты часто включали простой <w>молочно-хлебный пудинг</w> из чёрствых корок."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional dish"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный сладкий десерт или пудинг из кусочков хлеба, сваренных в молоке с сахаром и пряностями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлебный пудинг",
                                "target_lang_sense_clarification": "традиционное сладкое блюдо из хлеба и молока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bc1eaff-32a9-3a90-a4da-06225748dc79",
                    "sense_definition": "A seventeenth-century Puritan courtesy title for an adult married woman of humble social status.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court clerk addressed the witness politely as <w>Goody</w> during the trial.",
                            "target_lang_translations": {
                                "ru": "Во время судебного процесса секретарь вежливо обратился к свидетельнице со словом «<w>гуди</w>»."
                            }
                        },
                        {
                            "text": "Townspeople greeted <w>Goody</w> as she walked toward the meetinghouse on Sunday morning.",
                            "target_lang_translations": {
                                "ru": "Горожане приветствовали <w>добрую женщину</w>, когда та шла к молельному дому в воскресное утро."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical form of address"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливое обращение к замужней женщине незнатного происхождения у пуритан в XVII веке (сокращение от goodwife)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гуди",
                                "target_lang_sense_clarification": "историческое пуританское обращение к замужней женщине"
                            },
                            {
                                "target_lang_word": "добрая женщина",
                                "target_lang_sense_clarification": "вежливое обращение к простолюдинке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e7ef152-ac18-3634-91b6-254a95c9f422",
                    "sense_definition": "A small marine fish of North American Atlantic waters, also called the spot or lafayette.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coastal fisherman caught a small <w>goody</w> alongside several other panfish.",
                            "target_lang_translations": {
                                "ru": "Прибрежный рыбак поймал небольшого <w>пятнистого горбыля</w> вместе с несколькими другими мелкими рыбами."
                            }
                        },
                        {
                            "text": "Anglers often find the silvery <w>goody</w> in shallow waters along the eastern coast.",
                            "target_lang_translations": {
                                "ru": "Рыболовы часто встречают серебристого <w>пятнистого горбыля</w> на мелководье вдоль восточного побережья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "regional US fish name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая морская рыба атлантического побережья Северной Америки; пятнистый горбыль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятнистый горбыль",
                                "target_lang_sense_clarification": "вид рыбы (Leiostomus xanthurus)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "978f634b-f619-3a07-b58d-9e61e1ed0a1d",
                    "sense_definition": "An exclamation expressing childish delight, pleasure, or satisfaction.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>goody</w>, our pizza just arrived!",
                            "target_lang_translations": {
                                "ru": "О, <w>ура</w>, нам как раз привезли пиццу!"
                            }
                        },
                        {
                            "text": "\"<w>Goody</w>! We get an extra day off school this week!\" shouted the boy.",
                            "target_lang_translations": {
                                "ru": "— <w>Класс</w>! У нас на этой неделе будет лишний выходной в школе! — закричал мальчик."
                            }
                        }
                    ],
                    "synonyms": [
                        "yippee"
                    ],
                    "common_phrases": [
                        "oh goody"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often childish or ironic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее детскую радость, восторг или удовольствие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ура",
                                "target_lang_sense_clarification": "выражение восторга и радости"
                            },
                            {
                                "target_lang_word": "здорово",
                                "target_lang_sense_clarification": "разговорное выражение одобрения и радости"
                            },
                            {
                                "target_lang_word": "класс",
                                "target_lang_sense_clarification": "восклицание восторга или удовлетворения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "429fb0a5-5920-3c8b-85dd-bad186d74e70",
                    "sense_definition": "Mawkishly moral, sanctimonious, or displaying an exaggerated and irritating air of virtue; <w>goody-goody</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His peers disliked his overly <w>goody</w> attitude during school events.",
                            "target_lang_translations": {
                                "ru": "Сверстникам не нравилось его чрезмерно <w>паинькино</w> поведение во время школьных мероприятий."
                            }
                        },
                        {
                            "text": "She maintained a strictly <w>goody</w> posture whenever the headmaster entered the room.",
                            "target_lang_translations": {
                                "ru": "Она принимала подчеркнуто <w>благонравный</w> вид каждый раз, когда директор входил в класс."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приторно благонравный, ханжеский, демонстративно выставляющий напоказ свою добродетель; паинька."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ханжеский",
                                "target_lang_sense_clarification": "показно добродетельный"
                            },
                            {
                                "target_lang_word": "паинька",
                                "target_lang_sense_clarification": "приторно послушный или правильный"
                            },
                            {
                                "target_lang_word": "приторно-добродетельный",
                                "target_lang_sense_clarification": "нарочито благонравный"
                            }
                        ]
                    },
                    "common_phrases": [
                        "goody-goody"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "470c30fa-3886-305c-a14c-5032ca669d59",
                    "sense_definition": "An English family surname derived from Old English.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Goody</w> published several influential books on anthropology and social history.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Гуди</w> опубликовал несколько влиятельных книг по антропологии и социальной истории."
                            }
                        },
                        {
                            "text": "The court ordered both Morgan and <w>Goody</w> to pay a fine for the legal mistake.",
                            "target_lang_translations": {
                                "ru": "Суд обязал и Моргана, и <w>Гуди</w> выплатить штраф за юридическую ошибку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "hereditary family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия древнеанглийского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гуди",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b3755f9-fdf5-3413-9588-8538139a5b61",
                    "sense_definition": "An unincorporated settlement situated in Pike County, Kentucky, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Goody</w> on their way to the state park.",
                            "target_lang_translations": {
                                "ru": "Они проехали через небольшой посёлок <w>Гуди</w> по пути в парк штата."
                            }
                        },
                        {
                            "text": "Several families in <w>Goody</w> organized a local festival during the holiday weekend.",
                            "target_lang_translations": {
                                "ru": "Несколько семей в городке <w>Гуди</w> организовали местный фестиваль во время праздничных выходных."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Невключённая территория и поселение в округе Пайк, штат Кентукки, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гуди",
                                "target_lang_sense_clarification": "населённый пункт в США"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c46c7520-3e7f-30a0-b437-2a5b4aa82641",
                    "sense_definition": "A rare unisex personal given name transferred from the surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her parents decided to name their newborn child <w>Goody</w> after an ancestor.",
                            "target_lang_translations": {
                                "ru": "Родители решили назвать новорождённого ребёнка <w>Гуди</w> в честь предка."
                            }
                        },
                        {
                            "text": "Little <w>Goody</w> smiled brightly while playing with building blocks in the nursery.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>Гуди</w> радостно улыбался, играя в кубики в детской комнате."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Редкое гендерно-нейтральное личное имя, образованное от фамилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гуди",
                                "target_lang_sense_clarification": "личное имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}