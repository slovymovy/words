                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My phone is <w>incompatible</w> with the latest version of this app."
                        },
                        {
                            "text": "Their personalities are completely <w>incompatible</w> for a long-term relationship."
                        }
                    ],
                    "synonyms": [
