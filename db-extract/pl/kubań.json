                "translations": [
                    {
                        "translation_id": "e0617b13-fdd1-42ba-b0e2-bbc4e780caed",
                        "source_entry_id": "78c8c0be-f8c9-3015-b756-30ef6dcc67af",
                        "source_sense_id": "36facd3d-f113-36bc-8c1d-550a6d62de9e",
                        "target_lang_word": "Kuban",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuban",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a824f3-b241-3b7b-9165-1e472919b3ac",
                                        "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                                        "glosses": [
                                            "A river in Russia in the North Caucasus. It flows through the Karachay-Cherkessia, Stavropol Krai Krasnodar Krai, and Adygea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2c072e-9069-4e4a-855f-f3af75aba102",
                                                "sense_id": "b2a824f3-b241-3b7b-9165-1e472919b3ac",
                                                "text": "...ex-Imperial officers who came to the Don and the Kuban to take arms against Lenins regime..."
                                            },
                                            {
                                                "example_id": "e348d19c-41e9-486a-b7f0-2ffa1bf825c6",
                                                "sense_id": "b2a824f3-b241-3b7b-9165-1e472919b3ac",
                                                "text": "\"In the 1860s, the lands beyond the Kuban were settled by Black Sea and Line Cossacks from areas populated earlier...\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91440acc-6fd9-3e8c-91f7-c738c55822f9",
                                        "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                                        "glosses": [
                                            "a geographic region of Southern Russia surrounding the Kuban River, on the Black Sea between the Don Steppe, Volga delta and the Caucasus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4ce2cf-ad20-4991-bc96-0059634cb5a7",
                                                "sense_id": "91440acc-6fd9-3e8c-91f7-c738c55822f9",
                                                "text": "1954, United American Ukrainian Organizations Committee of New York\n\"In the south, the Red Army abandoned Krasnodar and all of the Kuban. Nazi forces plunged south into the Caucasian highlands and east to Stalingrad.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2faff2-4741-3745-b7d5-7a0f34816e2a",
                                        "entry_id": "6c55c4bc-899a-3e5f-8893-14453e8fb791",
                                        "glosses": [
                                            "Krasnodar Krai"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d667d88-8265-4d9d-825a-4b73c993b82d",
                                                "sense_id": "2d2faff2-4741-3745-b7d5-7a0f34816e2a",
                                                "text": "\"In 1995, the administration of the Krasnodar Territory, again popularly called the Kuban, adopted the flag of the Kuban Cossacks, with the addition of the territorial coat of arms.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
