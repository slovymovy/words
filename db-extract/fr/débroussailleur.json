                                        "sense_id": "2861e187-3fe6-3e24-8ed7-c9870d187d2a",
                                        "entry_id": "70cae497-f99b-3785-9463-64ea69574f6a",
                                        "glosses": [
                                            "A major league baseball player who has recently come from a small league."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7584941-f9e4-41a6-a947-7c1d80fb6366",
                                                "sense_id": "2861e187-3fe6-3e24-8ed7-c9870d187d2a",
                                                "text": "He was talking about me all the time that day in Boston, standing with the bat boy, making cracks. That's all right but when he called me a busher in front of the whole Yank team and then challenged me, I had to fight."
                                            }
                                        ]
                                    }
                                ]
