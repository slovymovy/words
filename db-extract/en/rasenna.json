                                "example_id": "5784d8a3-9694-4d8b-bd5a-9c94795390ed",
                                "sense_id": "513ba798-7fe1-3c17-a732-21f6a56d6ce7",
                                "text": "The Etruscan people of historical times—the Rasenna—were very likely the result of a gradual fusion of native and immigrant populations."
                            }
