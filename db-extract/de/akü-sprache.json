                    {
                        "sense_id": "7791bfd9-cf51-34a0-b9f1-a0000a55edf5",
                        "entry_id": "4956ddbd-2d8f-3aeb-a365-0f0a42bd8690",
                        "glosses": [
                            "Bezeichnung für eine Sprachverwendung, die eine Vorliebe für Abkürzungen/Kurzwörter aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a986ba2-70af-49e1-a957-51b1f2208720",
                                "sense_id": "7791bfd9-cf51-34a0-b9f1-a0000a55edf5",
                                "text": "„1940 erscheint … ein kurzer Aufsatz …, der der Akü-Sprache wieder weitgehend neutral gegenübersteht…“"
                            },
                            {
                                "example_id": "3dcacbdb-00a1-45d6-bb0d-758f07669a20",
                                "sense_id": "7791bfd9-cf51-34a0-b9f1-a0000a55edf5",
                                "text": "„Diese Eigenschaften fehlen auch jenen Leuten, die unseren Wortschatz mit Hilfe der Akü-Sprache auffüllen wollen.“"
                            },
                            {
                                "example_id": "2d406724-a4ae-438b-a016-099b076fff6f",
                                "sense_id": "7791bfd9-cf51-34a0-b9f1-a0000a55edf5",
                                "text": "„Die in der Gegenwart sehr beliebte Neubildung von Wörtern durch Aneinanderreihung der Anfangssilben oder Anfangsbuchstaben längerer Verbindungen (sogenannte Akü-Sprache = Abkürzungssprache) … dürfte in älterer Zeit kaum eine Rolle gespielt haben…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
