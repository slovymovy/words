                                    {
                                        "sense_id": "9bf6e65c-6a27-331f-bd00-170e87e54588",
                                        "entry_id": "df904e7a-9290-3a66-b6c9-df49d29447b7",
                                        "glosses": [
                                            "A movable cupboard or cabinet designed for storing clothes, particularly as a large piece of bedroom furniture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbdf0fc7-ea67-4ab6-9e36-8f32bd5bb483",
                                                "sense_id": "9bf6e65c-6a27-331f-bd00-170e87e54588",
                                                "text": "A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043f0eea-79cd-3b0a-ba41-c605762e9d72",
                                        "entry_id": "df904e7a-9290-3a66-b6c9-df49d29447b7",
                                        "glosses": [
                                            "A tall built-in cupboard or closet for storing clothes, often including a rail for coat-hangers, and usually located in a bedroom."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e894f3f-5f02-3d51-bfee-f17f38b0b460",
                                        "entry_id": "df904e7a-9290-3a66-b6c9-df49d29447b7",
                                        "glosses": [
                                            "Anything that similarly stores or houses something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d9c8496-b64f-420c-964b-4e5d13bcbce1",
                                                "sense_id": "1e894f3f-5f02-3d51-bfee-f17f38b0b460",
                                                "text": "Now death... crams his store house to the top with bloud,\nMight I now and Andrea in one fight,\nMake vp thy wardroope\nRicher by a knight."
                                            }
                                        ]
                                    },
                                    {
