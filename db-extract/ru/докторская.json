                "senses": [
                    {
                        "sense_id": "549979bf-1af0-3608-a67d-5a74b79f110e",
                        "entry_id": "ee513610-375b-3fa0-9946-ba172cef2fc9",
                        "glosses": [
                            "разг. то же, что докторская диссертация; диссертация доктора наук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e734c06-3bc3-42e3-afff-fdf6203a9d99",
                                "sense_id": "549979bf-1af0-3608-a67d-5a74b79f110e",
                                "text": "Ему несколько раз предлагали защищать докторскую, он только пожимал плечами: зачем, разве он станет больше знать оттого, что получит степень доктора?"
                            },
                            {
                                "example_id": "0cc35b33-682f-4a9a-81ce-4eb0bc271a21",
                                "sense_id": "549979bf-1af0-3608-a67d-5a74b79f110e",
                                "text": "Обе ― и кандидатскую, и докторскую ― я фактически защищал дважды!"
                            }
                        ]
                    },
                    {
                        "sense_id": "03996463-0c91-3319-bbca-2bb3d9d10a68",
                        "entry_id": "ee513610-375b-3fa0-9946-ba172cef2fc9",
                        "glosses": [
                            "разг. то же, что докторская колбаса; один из видов варёной колбасы"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a030e8d3-c300-373e-ba87-3096442b25dd",
                        "entry_id": "ee513610-375b-3fa0-9946-ba172cef2fc9",
                        "glosses": [
                            "разг. кабинет или комната доктора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b4ba2b4-f4b6-4063-9cdf-dffbd776bd90",
                                "sense_id": "a030e8d3-c300-373e-ba87-3096442b25dd",
                                "text": "В Одессе нас выспрашивали в докторской, скидывали одежу всю, оглядывали."
                            }
                        ]
                    }
