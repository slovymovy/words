                "senses": [
                    {
                        "sense_id": "74ca88a8-c31c-3201-ab6d-1162a2de68e5",
                        "entry_id": "41510df1-b16b-3e91-abc2-e4c2b69f64f8",
                        "glosses": [
                            "eine kleine Decke; von der Zierdecke über die Babydecke, die Hundedecke bis zum Türvorleger"
                        ],
                        "tags": [
                            "Swiss German"
                        ],
                        "examples": [
                            {
                                "example_id": "b4c0eab9-7bac-456c-bb0d-3caa28f9aff4",
                                "sense_id": "74ca88a8-c31c-3201-ab6d-1162a2de68e5",
                                "text": "Zu den Käufern zählten die ‹Decheler› aus dem Raume Thunstetten (Bützberg, Bleienbach), unter ihnen auch die Familie Hug. Diese haben dann das Längsgeflecht, die ‹Zetti›, eingeflochten und das Decheli zum Verkauf fertig gemacht. [Türvorlage]"
                            },
                            {
                                "example_id": "eedbe611-fab3-44a8-bc9b-6323fd4b779f",
                                "sense_id": "74ca88a8-c31c-3201-ab6d-1162a2de68e5",
                                "text": "„O wie hets albes im Gattungeli gwohlet, wenn’s ’s Decheli abgelüpft het und nüt meh drinn gsi isch, und wenn er z’Obe heicho isch, guet z’Lun, wi am erste Tag, wo sie gehürotet hei.“"
                            },
                            {
                                "example_id": "2d6c2b7d-9ce5-40bb-93eb-ad2f61fc22e9",
                                "sense_id": "74ca88a8-c31c-3201-ab6d-1162a2de68e5",
                                "text": "„[…], wie ne jungi Mueter ires Chindli aalächlet, wenns verwachet und im Wiegeli inne s Decheli ewägg sporet.“"
                            },
                            {
                                "example_id": "c02a55b4-3326-4857-a732-cca01a41236e",
                                "sense_id": "74ca88a8-c31c-3201-ab6d-1162a2de68e5",
                                "text": "„So wurden alte Tischtücher zerschnitten und Dechli daraus genäht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2a742d93-3232-3876-a67c-b315de606593",
                        "entry_id": "41510df1-b16b-3e91-abc2-e4c2b69f64f8",
