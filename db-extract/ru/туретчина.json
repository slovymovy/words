                "senses": [
                    {
                        "sense_id": "8933c35c-3a6d-32da-83f5-ca043a6db1d9",
                        "entry_id": "99d76da6-33af-3713-a002-a9fe02391624",
                        "glosses": [
                            "разг. турецкие нравы, обычаи, товары и т. п.; всё турецкое (обычно с оттенком неодобрительности)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e43e405f-4a1f-46af-a23f-0f1d68c5a9b0",
                                "sense_id": "8933c35c-3a6d-32da-83f5-ca043a6db1d9",
                                "text": "Аляповатые китайчина с туретчиной времен перестройки ― полиэтилен с цветной бумажкой внутри."
                            }
                        ]
                    },
                    {
                        "sense_id": "327408b0-8192-391d-a563-da9f849e7e16",
                        "entry_id": "99d76da6-33af-3713-a002-a9fe02391624",
                        "glosses": [
                            "разг. турецкая земля, Турция"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dbc4380-1182-4ac2-a8a0-6bffa30a26bb",
                                "sense_id": "327408b0-8192-391d-a563-da9f849e7e16",
                                "text": "Да им у себя на туретчине таких доходов никогда не заработать (в Германии, кстати, тоже)."
                            }
                        ]
                    }
