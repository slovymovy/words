                                        "entry_id": "6b722e4f-90ff-35d6-a71a-d4b399bd0320",
                                        "glosses": [
                                            "Storing the most significant byte of a multibyte number at a higher address than the least significant byte; that is, \\\"little end\\\" first."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f0eadb-b7f9-4301-bf1e-3eb5c5e5b2c3",
                                                "sense_id": "ea5b0b0d-022e-33aa-b9c6-a55aff43409b",
                                                "text": "Most big Unix machines are big-endian, but Intel x86 machines and older Digital machines are little-endian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
