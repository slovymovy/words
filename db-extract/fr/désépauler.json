                "senses": [
                    {
                        "sense_id": "5b0be1f5-1e2c-3252-afb1-beb28dc50412",
                        "entry_id": "e2fadfb4-ad66-3691-8f49-a04c7423e4ad",
                        "glosses": [
                            "Rabaisser (l’arme qu’on avait épaulée)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd59c66-48bf-4402-a125-51ed4df43dec",
                                "sense_id": "5b0be1f5-1e2c-3252-afb1-beb28dc50412",
                                "text": "A cet avantage net en faveur de l'express, s'ajoute pour celui-ci la possibilité de doubler rapidement sans désépauler."
                            },
                            {
                                "example_id": "41f0860d-6b9b-40a7-8dd2-1fc99b3d67ce",
                                "sense_id": "5b0be1f5-1e2c-3252-afb1-beb28dc50412",
                                "text": "Pour du tir sur appui ça peut aller, mais pour le reste c'est pénible car on doit désépauler à chaque coup pour réarmer."
                            },
                            {
                                "example_id": "e2486232-3a0c-48e6-8fcb-42e0741c8c3e",
                                "sense_id": "5b0be1f5-1e2c-3252-afb1-beb28dc50412",
                                "text": "Cette carabine est à réarmement linéaire à pompe ultra doux , aucun besoin de désépauler pour réarmer."
                            }
                        ]
                    }
