                {
                    "sense_id": "c3279d9b-0c3e-3663-8590-bbb490779edd",
                    "sense_definition": "A person who is friendly and enjoys socializing.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was always known as a <w>sociable</w> who loved being the center of attention.",
                            "target_lang_translations": {
                                "ru": "Он всегда был известен как <w>душа компании</w>, который любил быть в центре внимания."
                            }
                        },
                        {
                            "text": "Unlike her quiet sister, she was a true <w>sociable</w>.",
                            "target_lang_translations": {
                                "ru": "В отличие от своей тихой сестры, она была настоящей <w>душой компании</w>."
                            }
