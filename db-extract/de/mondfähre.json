                "senses": [
                    {
                        "sense_id": "8012ac2a-5592-3d6a-80e1-f33c8a798e40",
                        "entry_id": "4beb5110-3aeb-31a2-8c77-fe83f22f4ae2",
                        "glosses": [
                            "Teil eines Raumfahrzeugs, der die Landung auf dem Mond ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc80eb4-d1f8-4e3f-8306-a3a32fab4bae",
                                "sense_id": "8012ac2a-5592-3d6a-80e1-f33c8a798e40",
                                "text": "Als Neil Armstrong die Mondfähre verließ und den Mond betrat, war dies ein großer Augenblick für die gesamte Menschheit."
                            },
                            {
                                "example_id": "a57635bc-4055-45f2-8861-398183565176",
                                "sense_id": "8012ac2a-5592-3d6a-80e1-f33c8a798e40",
                                "text": "„Die Astronauten hecken die Lage der Mondfähre, überprüfen die Systeme und auch ob die Motoren für den Rückstart funktionsbereit sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
