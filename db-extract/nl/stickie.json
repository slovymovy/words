                                        "examples": [
                                            {
                                                "example_id": "2a58b7ae-1a60-44ed-9d85-656224d98799",
                                                "sense_id": "2abe8d53-19c2-3947-a39c-965ad3f148ed",
                                                "text": "Inez called up Camille on the phone repeatedly and had long talks with her; they even talked about his joint, or so Dean claimed."
                                            },
                                            {
                                                "example_id": "8352d9c3-d613-4301-91b7-63a3250217f6",
                                                "sense_id": "2abe8d53-19c2-3947-a39c-965ad3f148ed",
                                                "text": "There I was, going down at last on the star of all those pornographic films that I had been producing in my head since I first laid a hand upon my own joint . . ."
                                            },
                                            {
                                                "example_id": "24571896-d4b6-46eb-a270-0e3d15876222",
                                                "sense_id": "2abe8d53-19c2-3947-a39c-965ad3f148ed",
                                                "text": "\"Good, then,\" I said, my joint about to skeet like a water pistol. I was surprised too. I was known for having supreme dick control, and I could usually last a lot longer than this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9acb02c9-1372-3fe4-aa5e-814dbdf598ff",
