                        {
                            "text": "Met een speciale lepel kun je de pompoen makkelijk <w>hollen</w> voor Halloween.",
                            "target_lang_translations": {
                                "en": "With a special spoon, you can easily <w>scoop out</w> the pumpkin for Halloween."
                            }
                        }
                    ],
                    "antonyms": [
                        "vullen"
                    ],
                    "common_phrases": [
                        "hout hollen"
                    ],
                    "target_lang_definitions": {
