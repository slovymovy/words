    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a979f8d0-c9ba-3848-9077-e018f412ede8",
                    "sense_definition": "Plural form of <w>stocking</w>; close-fitting garments covering the foot and leg.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore black <w>stockings</w> with her elegant evening dress.",
                            "target_lang_translations": {
                                "es": "Llevaba <w>medias</w> negras con su elegante vestido de noche."
                            }
                        },
                        {
                            "text": "Children traditionally hang Christmas <w>stockings</w> by the fireplace hoping for gifts.",
                            "target_lang_translations": {
                                "es": "Los niños tradicionalmente cuelgan <w>calcetines</w> de Navidad junto a la chimenea esperando regalos."
                            }
                        }
                    ],
                    "synonyms": [
                        "hose"
                    ],
                    "common_phrases": [
                        "nylon stockings",
                        "silk stockings",
                        "Christmas stockings"
                    ],
                    "target_lang_definitions": {
                        "es": "Plural de stocking; prendas ajustadas que cubren el pie y la pierna."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "medias",
                                "target_lang_sense_clarification": "prenda que cubre el pie y la pierna"
                            },
                            {
                                "target_lang_word": "calcetines",
                                "target_lang_sense_clarification": "calcetines navideños o prenda similar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3c11d10-bf82-3f2f-9b04-9dde5e086e21",
                    "sense_definition": "A sheer, one-piece garment covering the legs and lower torso; pantyhose or tights.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She noticed a run in her <w>stockings</w> right before the job interview.",
                            "target_lang_translations": {
                                "es": "Notó una carrera en sus <w>medias</w> justo antes de la entrevista de trabajo."
                            }
                        },
                        {
                            "text": "She bought a pair of sheer <w>stockings</w> to wear under her skirt.",
                            "target_lang_translations": {
                                "es": "Compró un par de <w>pantimedias</w> transparentes para ponerse debajo de la falda."
                            }
                        }
                    ],
                    "synonyms": [
                        "pantyhose",
                        "tights"
                    ],
                    "common_phrases": [
                        "pair of stockings"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used loosely or interchangeably with pantyhose"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Prenda fina y elástica de una sola pieza que cubre las piernas y la parte inferior del torso; pantis o medias enteras."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "pantimedias",
                                "target_lang_sense_clarification": "América Latina"
                            },
                            {
                                "target_lang_word": "pantis",
                                "target_lang_sense_clarification": "España y uso general"
                            },
                            {
                                "target_lang_word": "medias",
                                "target_lang_sense_clarification": "medias enteras"
                            }
                        ]
                    }
                }
            ]
        },
        {
