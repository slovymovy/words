                        "sense_id": "647b9e5e-d47a-388f-9e95-523baab93710",
                        "entry_id": "d13a64d9-f3c8-3ea5-8c79-ff39bbae4540",
                        "glosses": [
                            "syllabic abbreviation of универса́льный магази́н самообслу́живания (universálʹnyj magazín samoobslúživanija, “universal self-service store”): supermarket"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3ee016-c883-4f76-8b2d-a420d4066fca",
                                "sense_id": "647b9e5e-d47a-388f-9e95-523baab93710",
                                "text": "Я ответил судьбе тем, что устроился работать грузчиком в универсаме возле дома.",
                                "translation": "My response to fate’s decree was to take a job as a lorry unloader at the supermarket not far from our house.",
                                "english": "My response to fate’s decree was to take a job as a lorry unloader at the supermarket not far from our house."
                            }
                        ]
                    }
                ],
