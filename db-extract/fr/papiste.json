                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "papist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa25d6a-b444-3acf-aa66-91b23cbb5a2b",
                                        "entry_id": "dae7f774-3c6b-3e19-92b6-db20c879cd5a",
                                        "glosses": [
                                            "Roman Catholic."
                                        ],
                                        "tags": [
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e692fb1-f8a3-4fbc-a99d-43e2ea8010cc",
                                                "sense_id": "daa25d6a-b444-3acf-aa66-91b23cbb5a2b",
                                                "text": "However, Menem promptly surprised many observers (and most of his voters) by forming an alliance with Alsogaray, and becoming more papist than the Pope in economic orthodoxy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
