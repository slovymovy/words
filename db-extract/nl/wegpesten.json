                                        "sense_id": "5eff0c9d-c6a4-3712-a814-b816e1cca82d",
                                        "entry_id": "d492a72a-b491-3277-88e0-8dd0d6eda9a7",
                                        "glosses": [
                                            "A miner's hammer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                        "entry_id": "4ebc2c5a-e79c-30e4-a475-ba52b14869fb",
                                        "glosses": [
                                            "To intimidate (someone) as a bully."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2b8c29-6adf-4d98-974c-2e84526bc926",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "You shouldn't bully people for being weak."
                                            },
                                            {
                                                "example_id": "7c28380a-4dc3-40dc-8012-4a0b2c87708a",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "I won't have you bullying us out my own house."
                                            },
                                            {
                                                "example_id": "e891e2b6-e276-430c-97ea-819cfef2979f",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "Bradly's stomach kinked in on itself, thinking of Cora struck silly with that corpse on her hands and the copper bullying the truth out of her."
                                            },
                                            {
                                                "example_id": "15d8a42b-9603-49c8-b2a9-8359c3f4307d",
                                                "sense_id": "79e3106c-ff29-30a5-ba85-4316f17ac9eb",
                                                "text": "United States Sen. Marsha Blackburn on Thursday became the latest member of Congress to visit Taiwan defying pressure from Beijing, saying, \"I will not be bullied by Communist China into turning my back on the island.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bab046d-cbcd-33cc-9a5c-2f55ee1f7e8c",
                                        "entry_id": "4ebc2c5a-e79c-30e4-a475-ba52b14869fb",
                                        "glosses": [
                                            "To act aggressively towards."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b499380-3977-406a-b04f-530415cd0465",
                                                "sense_id": "7bab046d-cbcd-33cc-9a5c-2f55ee1f7e8c",
                                                "text": "The Potters know their strengths and played to them perfectly here, out-muscling Bolton in midfield and bullying the visitors' back-line at every opportunity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                        "entry_id": "f7577292-cbb0-3fa4-823e-d7ac2a62f452",
                                        "glosses": [
                                            "Very good."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39947d63-d03d-417d-b018-a94bde18c462",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "a bully horse"
                                            },
                                            {
                                                "example_id": "ed966cb6-3aa9-4355-8bef-c2e4732a157f",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "To sing a bully song I'll try, / Bully for you, bully for you, / Gay as they make them, here I am, / Bully for you, for you."
                                            },
                                            {
                                                "example_id": "9a3cccdc-780d-4383-8ce9-56f752966c3b",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "He looked down upon the girl beside him—a daughter of the desert walking across the face of a dead world with a son of the jungle. He smiled at the thought. He wished that he had had a sister, and that she had been like this girl. What a bully chum she would have been!"
                                            },
                                            {
                                                "example_id": "1d934ae4-e88d-45d3-9de9-b97288722726",
                                                "sense_id": "643ac161-0995-395d-83b1-f75506bcefaf",
                                                "text": "She is a bully woman, not only a good mother, but a wonderful in-law"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9c4c9e4-44de-3357-8a9f-906eddf2d97a",
                                        "entry_id": "f7577292-cbb0-3fa4-823e-d7ac2a62f452",
                                        "glosses": [
                                            "Jovial and blustering."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334c2a7f-bfd2-49fb-84d8-93ca786df4ca",
                                                "sense_id": "b9c4c9e4-44de-3357-8a9f-906eddf2d97a",
                                                "text": "Bless thee, bully doctor!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bully",
                                "target_lang_code": "en",
                                "target_senses": [
