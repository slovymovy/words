                        "sense_id": "9f258a81-35b5-3ebb-bd92-d4f4cdde5e99",
                        "entry_id": "13356db1-5cd9-391d-a7a0-cc5591b19136",
                        "glosses": [
                            "vanwege het ambt",
                            "door een functionaris uit eigen beweging, niet als onderdeel van het officieel afhandelen van een klacht, aangifte of verzoek"
                        ],
                        "tags": [
                            "in het bijzonder"
                        ],
                        "examples": [
                            {
                                "example_id": "367be201-1cc7-4886-94cf-142200d005e4",
                                "sense_id": "9f258a81-35b5-3ebb-bd92-d4f4cdde5e99",
                                "text": "De burgemeester moet ontvangsten uit bijbanen die hij ambtshalve heeft in de gemeentekas storten."
                            },
                            {
                                "example_id": "b3095ff1-e7c6-4166-b905-179327d27e0c",
                                "sense_id": "9f258a81-35b5-3ebb-bd92-d4f4cdde5e99",
                                "text": "Omdat de parkeerwachter overduidelijk een vergissing had gemaakt, werd de parkeerboete ambtshalve ongedaan gemaakt."
                            }
                        ]
                    }
                ],
                "translations": [
