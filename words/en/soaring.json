{
    "word_family": [
        "soar",
        "soarer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9b803a68-4434-3887-9811-29146d3ff491",
                    "sense_definition": "present participle and gerund of <w>soar</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "flight_rise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle was <w>soaring</w> high above the rocky mountains.",
                            "target_lang_translations": {
                                "nl": "De adelaar was hoog boven de rotsachtige bergen aan het <w>zweven</w>."
                            }
                        },
                        {
                            "text": "They watched the hot air balloon gently <w>soaring</w> into the blue sky.",
                            "target_lang_translations": {
                                "nl": "Ze keken hoe de heteluchtballon rustig de blauwe lucht in <w>steeg</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "soaring above",
                        "soaring through the sky"
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord van soar: hoog stijgend, zwevend of snel oplopend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zwevend",
                                "target_lang_sense_clarification": "in de lucht zweven zonder vleugelslag"
                            },
                            {
                                "target_lang_word": "omhoogstijgend",
                                "target_lang_sense_clarification": "de hoogte ingaand"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "45cc930a-4f34-31ca-a0e5-690d1ff05e80",
                    "sense_definition": "Rising rapidly to a much higher level or value; ascending or towering high",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "flight_rise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Families are struggling to pay their bills because of <w>soaring</w> fuel prices.",
                            "target_lang_translations": {
                                "nl": "Gezinnen hebben moeite om hun rekeningen te betalen door de <w>sterk stijgende</w> brandstofprijzen."
                            }
                        },
                        {
                            "text": "The architect designed a cathedral with <w>soaring</w> arches that impressed everyone.",
                            "target_lang_translations": {
                                "nl": "De architect ontwierp een kathedraal met <w>torenhoge</w> bogen die op iedereen indruk maakten."
                            }
                        }
                    ],
                    "synonyms": [
                        "rising",
                        "escalating",
                        "skyrocketing"
                    ],
                    "antonyms": [
                        "plummeting",
                        "falling"
                    ],
                    "common_phrases": [
                        "soaring prices",
                        "soaring costs",
                        "soaring temperatures"
                    ],
                    "target_lang_definitions": {
                        "nl": "snel stijgend naar een veel hoger niveau of waarde; hoog oprijzend"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "torenhoog",
                                "target_lang_sense_clarification": "zeer hoog oprijzend of enorm gestegen"
                            },
                            {
                                "target_lang_word": "sterk stijgend",
                                "target_lang_sense_clarification": "in snel tempo toenemend van prijzen of kosten"
                            },
                            {
                                "target_lang_word": "de pan uit rijzend",
                                "target_lang_sense_clarification": "figuurlijk, van prijzen of kosten"
                            },
                            {
                                "target_lang_word": "oprijzend",
                                "target_lang_sense_clarification": "architectuur die hoog boven de omgeving uitsteekt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3412119-b51e-3372-9598-c5775bbda319",
                    "sense_definition": "The act of flying high into the air, or rising high in thought and imagination",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flight_rise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glider's graceful <w>soaring</w> captivated the spectators watching from the valley.",
                            "target_lang_translations": {
                                "nl": "Het sierlijke <w>zweven</w> van het zweefvliegtuig betoverde de toeschouwers die vanuit de vallei toekeken."
                            }
                        },
                        {
                            "text": "His philosophical writing revealed the imaginative <w>soarings</w> of a gifted mind.",
                            "target_lang_translations": {
                                "nl": "Zijn filosofische werk onthulde de verbeeldingsrijke <w>vluchten</w> van een begaafde geest."
                            }
                        }
                    ],
                    "synonyms": [
                        "flight",
                        "ascent"
                    ],
                    "target_lang_definitions": {
                        "nl": "de handeling van het hoog door de lucht vliegen of zweven, of het hoog opstijgen in gedachten"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "het zweefvliegen",
                                "target_lang_sense_clarification": "de sport of daad van zweven in de lucht"
                            },
                            {
                                "target_lang_word": "het zweven",
                                "target_lang_sense_clarification": "zonder aandrijving door de lucht bewegen"
                            },
                            {
                                "target_lang_word": "vlucht",
                                "target_lang_sense_clarification": "figuurlijk, van gedachten of verbeelding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}