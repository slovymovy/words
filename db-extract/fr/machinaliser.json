                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a08116f-21df-478b-b52c-41b6b28d72b0",
                                "sense_id": "396c55bd-379f-36fc-a9b4-921546a69a51",
                                "text": "Qui a permis aux terroristes de \"machinaliser\" la paisible religion islamique pour en faire une machine de mort et de terreur?"
                            },
                            {
                                "example_id": "cf033365-e68c-44a2-872f-858122dc099f",
                                "sense_id": "396c55bd-379f-36fc-a9b4-921546a69a51",
                                "text": "En France t'as moins de probabilité qu'en Arabie Saoudite de te faire machinaliser dans un réseau de prostitution."
                            },
                            {
                                "example_id": "9993531a-0c0e-40ce-9a3f-bf2507ca3499",
                                "sense_id": "396c55bd-379f-36fc-a9b4-921546a69a51",
                                "text": "Pourquoi vouloir machinaliser, généraliser que la meilleure façon de jouir de sa vie, d'en profiter à max est de danser, de tout le temps s'amuser ?"
                            }
                        ]
