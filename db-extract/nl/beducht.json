                "senses": [
                    {
                        "sense_id": "a8376bad-a231-34c2-91fa-e2374782e723",
                        "entry_id": "6d48d7d7-95eb-3eb0-ab68-1b2e64dbd005",
                        "glosses": [
                            "~ voor: zich bewust van of bevreesd voor gevaar, dreigend onheil enz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5da11fdc-70dd-4f32-8b3a-c409754f3187",
                                "sense_id": "a8376bad-a231-34c2-91fa-e2374782e723",
                                "text": "De voor uitglijden beduchte oude man schuifelde voorzichtig over het ijs."
                            },
                            {
                                "example_id": "7eb7199a-5b9c-444e-badd-2cfa348d9b70",
                                "sense_id": "a8376bad-a231-34c2-91fa-e2374782e723",
                                "text": "De student durfde het werkstuk niet in te leveren, omdat ze beducht was voor een onvoldoende."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41409805-1bdb-4fac-91a2-f227f51b8493",
                        "source_entry_id": "6d48d7d7-95eb-3eb0-ab68-1b2e64dbd005",
                        "source_sense_id": "a8376bad-a231-34c2-91fa-e2374782e723",
                        "source_sense_description": "zich bewust van of bevreesd voor gevaar of dreigend onheil",
                        "target_lang_word": "apprehensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apprehensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e602083d-74ad-3e39-9949-b1f4aa34868f",
                                        "entry_id": "cf2e1823-0c5f-3854-80a0-39619ceec87e",
                                        "glosses": [
                                            "Anticipating something with anxiety, fear, or doubt; reluctant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "681c7311-1812-429d-8638-17f5ea8991a2",
                                                "sense_id": "e602083d-74ad-3e39-9949-b1f4aa34868f",
                                                "text": "This convinc'd me that there was no going on Shore for us in the Night upon that Coaſt, and how to venture on Shore in the Day was another Queſtion too; for to have fallen into the Hands of any of the Savages, had been as bad as to have fallen into the Hands of Lyons and Tygers; at leaſt we were equally apprehenſive of the Danger of it."
                                            },
                                            {
                                                "example_id": "83a71d25-d17b-4e7d-900e-6ccf797bbeb2",
                                                "sense_id": "e602083d-74ad-3e39-9949-b1f4aa34868f",
                                                "text": "But Claggart's was no vulgar form of the passion. Nor, as directed toward Billy Budd, did it partake of that streak of apprehensive jealousy that marred Saul's visage perturbedly brooding on the comely young David. Claggart's envy struck deeper."
                                            },
                                            {
                                                "example_id": "16e468ab-7a38-4431-b8f3-dc54d043ea58",
                                                "sense_id": "e602083d-74ad-3e39-9949-b1f4aa34868f",
                                                "text": "Never before in his life had Dan Holland feared anything, but now he was apprehensive for the safety of this trim blond creature before him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c4a875-3797-3f2e-b7da-631f76a3600f",
                                        "entry_id": "cf2e1823-0c5f-3854-80a0-39619ceec87e",
                                        "glosses": [
                                            "Perceptive; quick to learn; capable of understanding using one's intellect."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace1d387-68c2-4b72-ba26-33287bb5cf34",
                                                "sense_id": "73c4a875-3797-3f2e-b7da-631f76a3600f",
                                                "text": "More fond of Miracles, than apprehensive of Truth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apprehensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f9a957b-7ec3-36c4-93fe-de30bc4d233c",
                                        "entry_id": "e847b2f4-6f6e-3fec-a26e-4e504629761b",
                                        "glosses": [
                                            "A mood indicating an undesired outcome."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60199e3f-62e3-49b9-8969-ece351d01207",
                                                "sense_id": "0f9a957b-7ec3-36c4-93fe-de30bc4d233c",
                                                "text": "In 16.66 the non-visual apprehensive is used with the third-person."
                                            }
