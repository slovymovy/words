                        "target_lang_word": "esplanade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esplanade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f58c9bca-1641-3a89-bf65-5d1a8f33d89e",
                                        "entry_id": "16d35df3-9114-3a7f-ab22-78cfbb535c76",
                                        "glosses": [
                                            "Espace uni et découvert au-devant d’un édifice, d’une place fortifiée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15da1da-656d-49b1-b28f-86a584b2d62a",
                                                "sense_id": "f58c9bca-1641-3a89-bf65-5d1a8f33d89e",
                                                "text": "Les jeunes gens prennent l'habitude de « giberner » ensemble dans un restaurant de la rue Faber près de l’esplanade des Invalides."
                                            },
                                            {
                                                "example_id": "efa9bf32-5407-4a31-9fb7-27eae90050c3",
                                                "sense_id": "f58c9bca-1641-3a89-bf65-5d1a8f33d89e",
                                                "text": "Ayant dit, M. de Bernage tourna les talons et se lança sur la longue esplanade plantée d’arbres qui borde la colonnade latérale de l’église."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1c6e22a-e73f-476f-89fa-1c00b2318926",
                        "source_entry_id": "966ab1a3-0763-3d92-96fe-e18d9c30e2e5",
                        "source_sense_id": "c3ae14b4-861d-39b8-9517-1ef9ca5c3d69",
                        "source_sense_description": "Freifläche vor einem Gebäude",
                        "target_lang_word": "parvis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parvis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "710d4bf7-7e04-3345-aad9-e0ad26604bd5",
                                        "entry_id": "5c6dc83b-b135-3ad1-83ce-71adda317e81",
                                        "glosses": [
                                            "Place devant la grande porte d’une église, d’une cathédrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b16a19-44e6-4a86-b7d9-b067853704b3",
                                                "sense_id": "710d4bf7-7e04-3345-aad9-e0ad26604bd5",
                                                "text": "Il les vit monter dans un fiacre qui les attendait devant le parvis Notre-Dame."
                                            },
                                            {
                                                "example_id": "2c677595-32a3-4b2d-abff-8530641a70a2",
                                                "sense_id": "710d4bf7-7e04-3345-aad9-e0ad26604bd5",
                                                "text": "Avant la guerre, on avait déjà commencé à construire le nouvel Hôtel-Dieu, mais les bâtiments de l’ancien hôpital attristaient encore le parvis de Notre-Dame."
                                            },
                                            {
                                                "example_id": "a1173867-5bd7-421f-8e8a-54e78e1fa8dc",
                                                "sense_id": "710d4bf7-7e04-3345-aad9-e0ad26604bd5",
                                                "text": "II lut un vieux journal de modes, sortit, fuma un cigare, remonta trois rues, songea qu'il était temps et se dirigea lestement vers le parvis Notre-Dame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                        "entry_id": "5c6dc83b-b135-3ad1-83ce-71adda317e81",
                                        "glosses": [
                                            "Place ou espace dégagé devant un bâtiment public."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93773753-cee6-4a22-a402-5b7d7efd77fb",
                                                "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                                "text": "(...) les membres du Bureau accompagnent S. A. le Bey jusqu’au parvis de l’Hôtel de Ville, tandis que M. le Président de la République demeure quelques instants dans la Salle des Prévôts avec les Membres de la Municipalité."
                                            },
                                            {
                                                "example_id": "e61d623c-477a-42c8-8099-4b9ee3ce9be7",
                                                "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                                "text": "On peut en dire autant de la Piazzetta de Venise, parvis du palais des Doges, dont les bornes son indiquées par le campanile et les colonnes."
                                            },
                                            {
                                                "example_id": "bce0b031-0672-42ca-9a7f-ca88536ae618",
                                                "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                                "text": "L’énorme publicité qu’elle a organisée autour de Pollock est concrétisée par l’impressionnante photo reproduite à des milliers d’exemplaires et qu’on peut voir dominant le parvis Beaubourg."
                                            },
                                            {
                                                "example_id": "7988e794-1eb0-4d82-9f5a-c3284b75561d",
                                                "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                                "text": "(...) lorsque la pergola devient une figure à l’échelle d’un bàtiment public, comme la pergola en lamellé-collé du parvis du lycée international de Sophia-Antipolis, dont les dimensions gigantesques excluent toute végétation à son échelle."
                                            },
                                            {
                                                "example_id": "aebf3025-0261-4c96-9cfa-df9e2949b36d",
                                                "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                                "text": "Tout d’abord quelques gargotes dans les rues alentour qui servent du thé ou des omelettes, puis les lumières de la gare et des régiments de pauvres couchés côte à côte sur l’asphalte de son parvis de plusieurs hectares."
                                            },
                                            {
                                                "example_id": "b6fb60a6-6f8d-4df0-b46c-237f80d114a5",
                                                "sense_id": "34a95a3a-c571-354c-90c2-f5009a2c416c",
                                                "text": "Le très poétique Jarry cycliste, sculpté par Zadkme, a passe quelques années dans la verdure, devant la porte Beucheresse à Laval, avant de rejoindre le parvis de la médiathèque, derrière la mairie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad0d417b-91dd-38bd-85e8-42cd023bdc74",
                                        "entry_id": "5c6dc83b-b135-3ad1-83ce-71adda317e81",
                                        "glosses": [
                                            "(par plaisanterie) Seuil, entrée d'un endroit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78603901-a071-4b68-9417-926445224628",
                                                "sense_id": "ad0d417b-91dd-38bd-85e8-42cd023bdc74",
                                                "text": "Quand ils ont mâchonné quelque temps un ave, d’un coin de bouche à l’autre promené litanies, ou, pour s’entendre braire, chanté vêpres et complies, rien des sacrées paroles ne passe le parvis de leur gueule assoiffée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7cb1c21-ba15-36fd-b5ac-903308542c26",
                                        "entry_id": "5c6dc83b-b135-3ad1-83ce-71adda317e81",
                                        "glosses": [
                                            "Grandes cours qui étaient dans l’ancien temple de Jérusalem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d23fba-596f-4586-9eac-59e53588237b",
                                                "sense_id": "e7cb1c21-ba15-36fd-b5ac-903308542c26",
                                                "text": "Le parvis des gentils, celui où les gentils étaient admis."
                                            },
                                            {
                                                "example_id": "3fa9cb7c-f22e-4714-8561-fb66d015459d",
                                                "sense_id": "e7cb1c21-ba15-36fd-b5ac-903308542c26",
                                                "text": "Le parvis d’Israël, celui où le peuple juif seul avait le droit d’entrer."
                                            },
                                            {
                                                "example_id": "9915b3d2-7396-4d27-983e-79fc5a61a73e",
                                                "sense_id": "e7cb1c21-ba15-36fd-b5ac-903308542c26",
                                                "text": "Le parvis des prêtres, celui qui était réservé aux prêtres."
                                            },
                                            {
                                                "example_id": "58fee399-f786-4c40-ba11-94973636ffc6",
                                                "sense_id": "e7cb1c21-ba15-36fd-b5ac-903308542c26",
                                                "text": "Avant l’édification du temple, il y avait aussi un parvis autour du tabernacle."
                                            }
