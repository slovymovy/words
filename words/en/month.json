                                "tr": "Doktor hastaya <w>adetlerinin</w> düzenini sordu.",
                                "nl": "De arts vroeg de patiënte naar de regelmaat van haar <w>maandstonden</w>.",
                                "pl": "Lekarz zapytał pacjentkę o regularność jej <w>miesiączek</w>.",
                                "de": "Der Arzt fragte die Patientin nach der Regelmäßigkeit ihrer <w>Monatsblutung</w>.",
                                "fr": "Le médecin a interrogé la patiente sur la régularité de ses <w>règles</w>.",
                                "it": "Il medico ha chiesto alla paziente la regolarità delle sue <w>mestruazioni</w>.",
                                "cs": "Lékař se pacientky zeptal na pravidelnost jejích <w>měsíčků</w>.",
                                "es": "El médico le preguntó a la paciente sobre la regularidad de sus <w>reglas</w>."
                            }
                        },
                        {
                            "text": "She felt weak and tired during her <w>months</w>.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала слабость и усталость во время <w>месячных</w>.",
                                "tr": "<w>Regl</w> döneminde kendini halsiz ve yorgun hissediyordu.",
                                "nl": "Ze voelde zich zwak en moe tijdens haar <w>maandstonden</w>.",
                                "pl": "Podczas <w>okresu</w> czuła się słaba i zmęczona.",
                                "de": "Sie fühlte sich während ihrer <w>Tage</w> schwach und müde.",
                                "fr": "Elle se sentait faible et fatiguée pendant ses <w>règles</w>.",
                                "it": "Si sentiva debole e stanca durante le sue <w>mestruazioni</w>.",
                                "cs": "Během svých <w>měsíčků</w> se cítila slabá a unavená.",
                                "es": "Se sentía débil y cansada durante su <w>período</w>."
                            }
