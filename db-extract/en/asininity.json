                    {
                        "translation_id": "60f0681e-446a-4143-8a41-ddb40d2c8f82",
                        "source_entry_id": "3a095bf5-91f2-3cd1-8990-fea6ea30d689",
                        "source_sense_description": "asinine remark, etc.",
                        "target_lang_word": "Eselei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eselei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                        "entry_id": "4937f538-94bf-3a65-97d7-fa086387e53e",
                                        "glosses": [
                                            "törichtes Verhalten, unüberlegte Handlung; dummer Schabernack"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e258b502-191e-49a5-8721-b31fe029e87b",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "„Alles was wir zu thun bewogen ſind[,] iſt Eſelei.“"
                                            },
                                            {
                                                "example_id": "0d7531ad-a444-43a8-8c17-3f1abdba8ba4",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "„Erſt nach längerer Zeit, als er ſchon mit einigem Humor an ſeine Eſelei zurückdachte, that er es trotzdem; aber da war Fenia, — Fiona Iwanowna Betjagin hieß ſie, — bereits wieder nach Zürich abgereiſt.“"
                                            },
                                            {
                                                "example_id": "78714c54-9f77-44f9-a773-5dbb51b0eeb3",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "„Sie sehen: daß es wirklich nicht so schön einfach ist, wie es Ihre Bequemlichkeit und Eselei sich zurechtgemacht haben.“"
                                            },
                                            {
                                                "example_id": "f24270c8-2f14-449f-bc52-7d720b4b5bae",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "„Es war kein zureichender Grund dagewesen für die Panik, die Katharina bei jener Nachricht überkommen hatte. Sie hatte eine Eselei gemacht.“"
                                            },
                                            {
                                                "example_id": "becd66f9-f5eb-41e1-ac71-5233781f6966",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "«Das ist gewiß ein Beweis, daß unser Verdacht eine rechte Eselei war. Ich schwöre dir, mich nie mehr als Kriminalist zu versuchen.»"
                                            },
                                            {
                                                "example_id": "917e8bd4-3237-4110-a526-075cb9d1844e",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "„Marx, der zu den wenigen gehörte, die das russisch geschriebene Buch kannten, bemerkte zu den zitierten Passagen: ‚Schülerhafte Eselei! Blödsinn‘!“"
                                            },
                                            {
                                                "example_id": "c4f15d44-96c2-4be8-b988-a3e27b74aac4",
                                                "sense_id": "01587132-444d-3970-8b1e-cfe9d10b1854",
                                                "text": "„Der hat ebenfalls kein Gesetz gebrochen, aber bei der Erklärung seines Verhaltens so viele Eseleien begangen, dass er mit seiner Salamitaktik ebenso zur unglaubwürdigen Witzfigur geworden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
