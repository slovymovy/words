                    },
                    {
                        "form_id": "3b6cc926-d0d8-4977-8336-19d05341a1e1",
                        "entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                        "tags": [
                            "past"
                        ],
                        "form": "personified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a84ce51f-3d90-39be-8d14-345e4a7d40a3",
                        "entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                        "glosses": [
                            "To be an example of; to have all the attributes of."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0e72a0a0-57b4-4c2d-aa7d-81d96bb9642e",
                                "sense_id": "a84ce51f-3d90-39be-8d14-345e4a7d40a3",
                                "text": "Mozart could be said to personify musical genius."
                            }
                        ]
                    },
                    {
                        "sense_id": "c41afc65-4568-312d-bd89-2dc0eab72d43",
                        "entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                        "glosses": [
                            "To create a representation of (an abstract quality) in the form of a character or persona."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "21950c16-2126-4182-b935-85dc0334045b",
                                "sense_id": "c41afc65-4568-312d-bd89-2dc0eab72d43",
                                "text": "The writer personified death in the form of the Grim Reaper."
                            },
                            {
                                "example_id": "6b6ffcb7-5e0c-447a-a07d-dfd6238eea85",
                                "sense_id": "c41afc65-4568-312d-bd89-2dc0eab72d43",
                                "text": "If ever any of the girls had taken a fancy to personify their good genius, they would certainly have given to his image all they remembered of \"Uncle Frank.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc144165-4ab5-4fa0-8502-ca259d65962b",
                        "source_entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                        "source_sense_description": "to be an example of",
                        "target_lang_word": "personnifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personnifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb60aeb-9bf4-34ce-ad6a-2b83fd80d92f",
                                        "entry_id": "97fbe783-20cf-3098-9b80-f69aab4e816b",
                                        "glosses": [
                                            "Attribuer à une idée ou à une force de la nature la figure, les sentiments, le langage, etc., d’une personne réelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a09a274-aa48-4a10-83ce-0ab1a6d7ddd3",
                                                "sense_id": "8eb60aeb-9bf4-34ce-ad6a-2b83fd80d92f",
                                                "text": "Personnifier la Justice, la Prudence. — Mars personnifiait la Guerre."
                                            },
                                            {
                                                "example_id": "40d8e020-04a9-491d-b16d-2f68a22bed0e",
                                                "sense_id": "8eb60aeb-9bf4-34ce-ad6a-2b83fd80d92f",
                                                "text": "Subitement, ce parfait inconnu – dont son père lui avait annoncé la venue au monde un jour de cavalcade complice dans le veld – personnifiait à lui seul l’origine de tous ses malheurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d267f7b4-8989-3ed1-805c-8226a9450aef",
                                        "entry_id": "97fbe783-20cf-3098-9b80-f69aab4e816b",
                                        "glosses": [
                                            "Offrir dans sa personne l’image d’une vertu ou d’un vice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533762c4-500b-46f7-b09b-b247e7ca89c0",
                                                "sense_id": "d267f7b4-8989-3ed1-805c-8226a9450aef",
                                                "text": "Il doit m’aider dans l’attaque, et c’est lui et ses serviteurs qui personnifieront les bandits dont mon bras valeureux, après avoir changé d’habits, doit délivrer la dame."
                                            },
                                            {
                                                "example_id": "aba57c78-cf06-458b-80e0-685dab879fd9",
                                                "sense_id": "d267f7b4-8989-3ed1-805c-8226a9450aef",
                                                "text": "Chacun d’eux personnifiait en lui ces deux races en présence aux États-Unis, dont la lutte ne finira que par l’extinction complète de l’une au profit de l’autre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c58e822-7893-438f-a2ca-74db2d3055a1",
                        "source_entry_id": "42d07333-6cc1-31f2-be97-2a2d5974cbfc",
                        "source_sense_description": "to be an example of",
                        "target_lang_word": "personifizieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personifizieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a07f15f-a11c-36da-98c2-8041fa6196ef",
                                        "entry_id": "86093d74-8ae8-369d-8325-253e8aff12c0",
                                        "glosses": [
                                            "eine abstrakte Idee als Mensch typischerweise verkörpern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9c8ed8-0016-4231-905b-4bb92db83ecd",
                                                "sense_id": "3a07f15f-a11c-36da-98c2-8041fa6196ef",
                                                "text": "„Georg Karl von Reindl personifiziert den Kampf der Liberalität gegen die Borniertheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ceb4756f-bee0-3429-9c67-6d92b9b9db39",
                                        "entry_id": "86093d74-8ae8-369d-8325-253e8aff12c0",
                                        "glosses": [
                                            "menschliche Eigenschaften auf nichtmenschliche Dinge oder Wesen übertragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3667009a-24d1-4436-bb3e-0a9f469abb59",
                                                "sense_id": "ceb4756f-bee0-3429-9c67-6d92b9b9db39",
                                                "text": "„Denkbar ist natürlich, daß die Menschen diese Maschinen personifizieren und ihnen – nicht vorhandene – Absichten und Gefühle zuschreiben werden – aufgrund einer neuen Mythologie, die aber bereits dem intellektronischen Zeitalter angehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a45539a1-2945-3540-b098-91de18b65c83",
                                        "entry_id": "86093d74-8ae8-369d-8325-253e8aff12c0",
                                        "glosses": [
                                            "etwas auf Einzelpersonen oder bestimmte Gruppe beziehen oder ausrichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "271de0d6-17b5-4864-a2c3-f1b3605248c5",
                                                "sense_id": "a45539a1-2945-3540-b098-91de18b65c83",
                                                "text": "„Es kann leicht angepasst und personifiziert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dc5be769-b3ca-3f71-a091-38b71bad0ea7",
                                        "entry_id": "86093d74-8ae8-369d-8325-253e8aff12c0",
                                        "glosses": [
                                            "jemanden eindeutig erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5416b43b-9a68-44c0-8284-249d1b76a7e4",
                                                "sense_id": "dc5be769-b3ca-3f71-a091-38b71bad0ea7",
                                                "text": "„Christoph Vögeli, Leiter der Zentralstelle Hooliganismus, die bei der Zürcher Stadtpolizei angesiedelt ist, sagt: «Es geht darum, die gewalttätigen und gewaltbereiten Fussballfans aus der Masse und der Anonymität herauszuholen, sie zu personifizieren und zu bestrafen und ihnen den Zugang zu Fussballspielen zu verunmöglichen.»“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
