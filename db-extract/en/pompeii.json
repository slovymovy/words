                                                "sense_id": "f3ca6e31-6973-30ca-adce-18ff74cf50fe",
                                                "text": "Wybuch Wezuwiusza zniszczył starożytne miasto Pompeje."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
