                    "sense_id": "df8a93ab-3136-3792-8f0b-662612768f4c",
                    "sense_definition": "present participle and gerund of <w>tame</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "taming_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The expert is currently <w>taming</w> the wild horse to prepare it for riding.",
                            "target_lang_translations": {
                                "ru": "В настоящее время эксперт <w>приручает</w> дикую лошадь, чтобы подготовить её к верховой езде."
                            }
                        },
                        {
                            "text": "She spent many months <w>taming</w> her garden after years of neglect.",
                            "target_lang_translations": {
                                "ru": "Она потратила много месяцев на то, чтобы <w>привести в порядок</w> свой сад после многих лет запустения."
                            }
                        }
                    ],
                    "synonyms": [
                        "domesticating",
                        "subduing",
                        "mastering"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола tame (приручать, укрощать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приручение",
                                "target_lang_sense_clarification": "процесс превращения дикого животного в домашнее"
                            },
                            {
                                "target_lang_word": "укрощение",
                                "target_lang_sense_clarification": "подчинение своей воле, подавление дикости"
                            },
                            {
                                "target_lang_word": "освоение",
                                "target_lang_sense_clarification": "приведение чего-либо в порядок или под контроль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e66e356-8472-3571-ba65-763eeed79861",
                    "sense_definition": "The process by which a person, animal or thing is tamed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "taming_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>taming</w> of the wilderness was a central theme in early frontier literature.",
                            "target_lang_translations": {
                                "ru": "<w>Покорение</w> дикой природы было центральной темой в ранней литературе о фронтире."
                            }
                        },
                        {
                            "text": "Successful <w>taming</w> of wild animals requires a great deal of patience and consistency.",
                            "target_lang_translations": {
                                "ru": "Успешное <w>приручение</w> диких животных требует огромного терпения и последовательности."
                            }
                        }
                    ],
                    "synonyms": [
                        "domestication",
                        "subjugation"
                    ],
                    "common_phrases": [
                        "taming of the wild",
                        "taming of the shrew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого человек, животное или предмет становится ручным или подконтрольным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приручение",
                                "target_lang_sense_clarification": "о животных"
                            },
                            {
                                "target_lang_word": "укрощение",
                                "target_lang_sense_clarification": "о диких зверях или чувствах"
                            },
                            {
                                "target_lang_word": "покорение",
                                "target_lang_sense_clarification": "о природе или диких землях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
