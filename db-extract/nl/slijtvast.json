                    {
                        "sense_id": "2689bd69-06e1-3747-9280-c5d04f2bd0c0",
                        "entry_id": "1ca437e1-1b42-3b0e-9012-a72747620cef",
                        "glosses": [
                            "heel goed bestand zijn tegen langdurig gebruik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b89da396-b766-4b8a-ba05-9e22296b1709",
                                "sense_id": "2689bd69-06e1-3747-9280-c5d04f2bd0c0",
                                "text": "Asbest is een verzamelnaam voor delfstoffen die bestaan uit microscopisch kleine vezels. Vanwege voortreffelijke brandwerende, isolerende en slijtvaste eigenschappen is het sinds mensenheugenis industrieel verwerkt."
                            },
                            {
                                "example_id": "e25149be-3b6b-4eb2-bd27-0862311c55d7",
                                "sense_id": "2689bd69-06e1-3747-9280-c5d04f2bd0c0",
                                "text": "Nu hebben we de printers zo doorontwikkeld dat we kunnen werken met flexibel materiaal. Deze schoenen zitten lekker, zijn slijtvast en gaan bij wijze van spreken jaren mee.\""
                            }
                        ]
                    }
