                "senses": [
                    {
                        "sense_id": "1f9d34e4-5366-3da9-be01-b01d9b01c104",
                        "entry_id": "36d588db-81ad-3251-bf21-8052b8c60672",
                        "glosses": [
                            "Situé au-dessus de la glotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a1bd210-e112-4b66-b6be-23fb67d3093f",
                                "sense_id": "1f9d34e4-5366-3da9-be01-b01d9b01c104",
                                "text": "Il n’est qu’un élément du système phonatoire, dont le fonctionnement repose sur l’interaction entre trois classes d’organes : les poumons, le pharynx et les cavités supraglottiques (bouche, nez, lèvres, pharynx…)."
                            },
                            {
                                "example_id": "7f20cac8-2484-4140-8cb0-ac0948f3fe13",
                                "sense_id": "1f9d34e4-5366-3da9-be01-b01d9b01c104",
                                "text": "En France, les dispositifs supraglottiques peuvent être utilisés comme une alternative à l’intubation et surtout à la ventilation au masque facial parce qu’ils libèrent les mains de l’opérateur."
                            },
                            {
                                "example_id": "cccd0778-6cb8-44ae-b622-ad3be5fd872e",
                                "sense_id": "1f9d34e4-5366-3da9-be01-b01d9b01c104",
                                "text": "Comme il a déjà été dit, dans le cas des consonnes, l’air ne peut pas circuler librement car il rencontre des obstacles aux niveaux des cordes vocales et des cavités supraglottiques."
                            }
                        ]
                    }
