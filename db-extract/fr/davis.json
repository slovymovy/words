                            {
                                "example_id": "2ce9baf6-80b4-4ac2-8dc3-9501bf591b41",
                                "sense_id": "202f0abc-7eed-31aa-a3ae-d2fb6430a920",
                                "text": "La Polonaise a écarté l’Américaine Sloane Stephens (6-3, 6-2) et défiera au prochain tour une autre Américaine, Lauren Davis."
                            },
                            {
                                "example_id": "6c2fd08b-0ae7-47a9-a250-b55c3b2dc969",
                                "sense_id": "202f0abc-7eed-31aa-a3ae-d2fb6430a920",
                                "text": "Sur le tournage du Retour du Jedi, il perçoit le potentiel d’un jeune acteur anglais, Warwick Davis, qui joue le rôle de l’Ewok Wicket."
                            },
                            {
                                "example_id": "a380e827-ff8e-4996-b088-3487703f624f",
                                "sense_id": "202f0abc-7eed-31aa-a3ae-d2fb6430a920",
                                "text": "La partie a pu reprendre près de deux heures plus tard grâce à l’intervention saluée de Lance Davis, un expert local des abeilles, que les spectateurs, fascinés, ont pu observer en train d’utiliser un aspirateur spécial pour évacuer les abeilles regroupées sur la « spidercam », une caméra télécommandée suspendue au-dessus du court."
                            }
                        ]
                    }
