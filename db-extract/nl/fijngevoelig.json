                ],
                "senses": [
                    {
                        "sense_id": "8b248944-ee2c-3618-936b-e236b4dacb5e",
                        "entry_id": "423db233-d20d-3372-9fee-831f8959ecab",
                        "glosses": [
                            "kies maar zeer kwetsbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43be27b2-8699-4438-bea0-f68e8bd0b140",
                                "sense_id": "8b248944-ee2c-3618-936b-e236b4dacb5e",
                                "text": "Het fijngevoelige en kunstzinnige meisje was snel op haar teentjes getrapt."
                            },
                            {
                                "example_id": "df812df1-3d45-4fee-a693-6e1ea89b058e",
                                "sense_id": "8b248944-ee2c-3618-936b-e236b4dacb5e",
                                "text": "Hij deed alsof hij een fijngevoelige kunstliefhebber was, maar eigenlijk was hij maar een lompe boer met te veel geld."
                            },
                            {
                                "example_id": "b29804e1-78d4-4a99-b1a4-e1c9ae45d08a",
                                "sense_id": "8b248944-ee2c-3618-936b-e236b4dacb5e",
                                "text": "Maar misschien zijn niet alle kapitalisten even fijngevoelig als jij en meneer Wallenberg."
                            },
                            {
                                "example_id": "f384f277-ac31-4095-8cf6-345e267652cd",
                                "sense_id": "8b248944-ee2c-3618-936b-e236b4dacb5e",
                                "text": "Haar vader had zich dus ingelaten met zwartemarkthandelaars en was zijn geld kwijtgeraakt? Ja, zo zou je het, misschien iets minder fijngevoelig, uit kunnen drukken."
                            }
                        ]
                    }
                ],
