                "translations": [
                    {
                        "translation_id": "36b99a9d-7559-4ac4-9587-bfb2feb6ddb9",
                        "source_entry_id": "2efdab80-a82b-36d2-99c6-af9704557b64",
                        "source_sense_id": "9d892a97-2fe6-381c-9751-e699528d9563",
                        "target_lang_word": "surge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e184ffde-0815-31c3-b343-f1d0bb8ce498",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "A sudden transient rush, flood or increase."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15904734-e231-4f75-90af-4db58290cf86",
                                                "sense_id": "e184ffde-0815-31c3-b343-f1d0bb8ce498",
                                                "text": "As President Obama turns his attention once again to filling out a cabinet and writing an Inaugural Address, this much is clear: he should not expect to bask in a surge of national unity, or to witness a crowd of millions overrun the Mall just to say they were there."
                                            },
                                            {
                                                "example_id": "f7b4100c-0f48-4610-9669-e445b9923740",
                                                "sense_id": "e184ffde-0815-31c3-b343-f1d0bb8ce498",
                                                "text": "He felt a surge of excitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cff6fe3-74f9-3940-bc8a-8113858faca2",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "The maximum amplitude of a vehicle's forward/backward oscillation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92a5facc-4126-349f-85ab-633fed52d652",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "A sudden electrical spike or increase of voltage and current."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aeb818b-fb06-4c09-abe7-4fada48c3f51",
                                                "sense_id": "92a5facc-4126-349f-85ab-633fed52d652",
                                                "text": "A power surge at that generator created a blackout across the whole district."
                                            },
                                            {
                                                "example_id": "5402bdea-b856-4267-8185-7f0ab75684a3",
                                                "sense_id": "92a5facc-4126-349f-85ab-633fed52d652",
                                                "text": "When the diesel was being worked full out, the ammeter normally showed about 1,500-1,600 amps, with occasional surges of current at starting or up the steepest gradients to 1,700 or even 1,800 amps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3eaf353-c077-3b25-b7bf-9ae92835b626",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "A momentary reversal of the airflow through the compressor section of a jet engine due to disruption of the airflow entering the engine's air intake, accompanied by loud banging noises, emission of flame, and temporary loss of thrust."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10d97e4d-4457-3ee6-9051-7a7da68cb5c5",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "The swell or heave of the sea (FM 55-501)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3491228-c98a-42ca-87d7-1e44206ba7e3",
                                                "sense_id": "10d97e4d-4457-3ee6-9051-7a7da68cb5c5",
                                                "text": "He that doubteth is like the surge of the sea driven by the wind and tossed."
                                            },
                                            {
                                                "example_id": "5075be21-9b7f-44e1-ad52-e989c83da6d1",
                                                "sense_id": "10d97e4d-4457-3ee6-9051-7a7da68cb5c5",
                                                "text": "He flies aloft, and, with impetuous roar, / Pursues the foaming surges to the shore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ebdd689-8411-344b-88a7-dfe9921c4ed5",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "A deployment in large numbers at short notice."
                                        ],
                                        "tags": [
                                            "US",
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fce5ff85-8aa7-4254-8307-04676feb16e4",
                                                "sense_id": "7ebdd689-8411-344b-88a7-dfe9921c4ed5",
                                                "text": "surge capacity; surge fleet; surge deployment capabilities"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f770b3d-bb3c-3273-85ca-15ca4dc4ee42",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "A spring; a fountain."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d76d1240-1faf-4062-8308-8de853f8b282",
                                                "sense_id": "7f770b3d-bb3c-3273-85ca-15ca4dc4ee42",
                                                "text": "1523-1525, John Bourchier, 2nd Baron Berners, Froissart's Chronicles\nall great rivers are gorged and assembled of various surges and springs of water"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94c85ba9-5562-3795-bbb7-42366307c630",
                                        "entry_id": "09cc1636-1490-3cb5-b2d5-00d333d103fe",
                                        "glosses": [
                                            "The tapered part of a windlass barrel or a capstan, upon which the cable surges, or slips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "surge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ee4c678-c75d-384d-8e8f-ac5f10681ad2",
                                        "entry_id": "d79ec486-6ebf-3572-b07a-4abea3d88434",
                                        "glosses": [
                                            "To rush, flood, or increase suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd3363d-af0c-4b3f-8f4f-958b92c50bd4",
                                                "sense_id": "4ee4c678-c75d-384d-8e8f-ac5f10681ad2",
                                                "text": "Toaster sales surged last year."
                                            },
                                            {
                                                "example_id": "7304be67-3f11-49fb-98fc-a85adcb8cbf0",
                                                "sense_id": "4ee4c678-c75d-384d-8e8f-ac5f10681ad2",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers, of errand not wholly obvious to their fellows, yet of such sort as to call into query alike the nature of their errand and their own relations."
                                            },
                                            {
                                                "example_id": "6244b8cf-c744-4a3e-9c9e-55ad0e6bca72",
                                                "sense_id": "4ee4c678-c75d-384d-8e8f-ac5f10681ad2",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades. At the top of the list of popular herbs are echinacea and ginseng, whereas garlic, St. John's wort, soybean, ephedra and others are also surging in popularity or have been historically prevalent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "777340e8-9e04-3bc0-b39d-78f3fb0ab4e9",
                                        "entry_id": "d79ec486-6ebf-3572-b07a-4abea3d88434",
                                        "glosses": [
                                            "To accelerate forwards, particularly suddenly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4812bda1-2af9-4e1d-9b1c-a7cb39fac365",
                                                "sense_id": "777340e8-9e04-3bc0-b39d-78f3fb0ab4e9",
                                                "text": "A ship surges forwards, sways sideways and heaves up."
                                            },
                                            {
                                                "example_id": "b830cbdb-7442-48ae-a21e-e6285b6a5b43",
                                                "sense_id": "777340e8-9e04-3bc0-b39d-78f3fb0ab4e9",
                                                "text": "Wales began the second half as they ended the first, closing down Montenegro quickly and the pressure told as Bale surged into the box and pulled the ball back for skipper Ramsey, arriving on cue, to double their lead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac0f965-c60e-35f9-9dee-c1c4ebd44e31",
                                        "entry_id": "d79ec486-6ebf-3572-b07a-4abea3d88434",
                                        "glosses": [
                                            "To experience a momentary reversal of airflow through the compressor section due to disruption of intake airflow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15e355a4-b1bd-4d2c-b789-673168098d10",
                                                "sense_id": "1ac0f965-c60e-35f9-9dee-c1c4ebd44e31",
                                                "text": "Use of maximum reverse thrust at low speeds can cause the engine to surge from ingesting its own exhaust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdfd1032-a523-3db1-93a0-77fa4aeecbb6",
                                        "entry_id": "d79ec486-6ebf-3572-b07a-4abea3d88434",
                                        "glosses": [
                                            "To slack off a line."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81ca5baf-9ddf-45af-9802-eb10811d2653",
                        "source_entry_id": "2efdab80-a82b-36d2-99c6-af9704557b64",
                        "source_sense_id": "9d892a97-2fe6-381c-9751-e699528d9563",
                        "target_lang_word": "flood wave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b63589e7-3b3b-4cd1-b5b5-d29a5e23cea0",
                        "source_entry_id": "2efdab80-a82b-36d2-99c6-af9704557b64",
                        "source_sense_id": "9d892a97-2fe6-381c-9751-e699528d9563",
                        "target_lang_word": "flash flood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flash flood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d58546f7-9a77-3e99-969f-137b7fd9692d",
                                        "entry_id": "9be462dc-ff51-329e-989d-2b652f3a7c9d",
                                        "glosses": [
                                            "A sudden, rapid flood, usually of short duration and local impact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319dbf3a-58b3-49c7-bd4f-247890c3a669",
                                                "sense_id": "d58546f7-9a77-3e99-969f-137b7fd9692d",
                                                "text": "One of the most heavily hit regions was Germany’s Ahrweiler district, where flash floods surged through the village of Schuld, washing away six houses and leaving several more on the verge of collapse. The police said at least 50 people had died in Ahrweiler district."
                                            },
                                            {
                                                "example_id": "aa1a32d4-f815-488f-8760-81a5587a3418",
                                                "sense_id": "d58546f7-9a77-3e99-969f-137b7fd9692d",
                                                "text": "The West Highland Line reopened for passengers on July 11, following emergency repair works after more than 1,600 tons of material was washed away by a flash flood on June 25."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1414b036-cffc-4137-be8d-95a8610d8f97",
                        "source_entry_id": "2efdab80-a82b-36d2-99c6-af9704557b64",
                        "source_sense_id": "9d892a97-2fe6-381c-9751-e699528d9563",
                        "target_lang_word": "tidal wave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tidal wave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84e16add-301a-38a6-9ada-78dab01d63a2",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large and sudden rise and fall in the tide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59c53a2e-772f-31ca-8ad0-518fc9827112",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large, sudden, and disastrous wave of water caused by a tremendous disturbance in the ocean; a tsunami. (See Usage notes below.)"
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64682ce8-6949-4dae-b4c7-5399a8688cdd",
                                                "sense_id": "59c53a2e-772f-31ca-8ad0-518fc9827112",
                                                "text": "The last tidal wave here killed twenty and left thousands homeless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19bb7d99-993c-314e-8a00-4ea104c80f24",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A large, sudden inundation of water from the storm surge, or waves of that surge; a sudden surge of river water."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c478e7fb-fe00-47e1-8121-fd0d8006ee39",
                                                "sense_id": "19bb7d99-993c-314e-8a00-4ea104c80f24",
                                                "text": "During the day conditions worsened quickly—for example, a 2-6-0 on the Uckfield line suddenly encountered flood water high enough to enter its ashpan and extinguish its fire—until lock gates up-river at Barcombe gave way and a tidal wave rolled down the valley meeting head-on a spring tide rolling up from the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A sudden and powerful surge."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93e45773-6533-44f6-a591-30084083f3ac",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "As the doors opened, a tidal wave of people flooded into the room."
                                            },
                                            {
                                                "example_id": "55ca3a81-52f6-41e1-a3fa-6eeef0a3edee",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "I was overcome by a tidal wave of emotions."
                                            },
                                            {
                                                "example_id": "53870bf8-e7ba-44ac-a5fd-b805eced5ceb",
                                                "sense_id": "9d1d1eea-662f-3029-a939-298d2cc8fbde",
                                                "text": "But this is no stream, folks. This will be a tidal wave that can swamp our democracy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f6cd86-371d-3ad9-a006-8572505fa30b",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A crest of ocean water; a wave."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb47036b-9fc7-3b57-b19c-a7b1dc9fefef",
                                        "entry_id": "fe515cba-ba74-3415-a5c6-585c11ced740",
                                        "glosses": [
                                            "A crest of ocean water resulting from tidal forces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
