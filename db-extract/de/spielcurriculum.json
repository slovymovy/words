                "senses": [
                    {
                        "sense_id": "01b8725a-0055-37df-9d53-e2e899f20e81",
                        "entry_id": "97c3f59b-8c21-35ad-ab95-b75b9593459a",
                        "glosses": [
                            "lehrplanmäßige Vorgabe der Leit- und Lernziele für die schulische Spielerziehung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eb261a5-cc88-4221-9204-49efc908e0ca",
                                "sense_id": "01b8725a-0055-37df-9d53-e2e899f20e81",
                                "text": "„Dieses Buch über Möglichkeiten des Spielens in der Schule zieht die Summe aus einer langjährigen Spielpraxis und aus theoretischen Überlegungen über Form und Funktionen eines Spielcurriculums.“"
                            },
                            {
                                "example_id": "4af05582-8b86-4261-a815-bdb3aed2a178",
                                "sense_id": "01b8725a-0055-37df-9d53-e2e899f20e81",
                                "text": "„Andererseits werden schwerwiegende Bedenken geltend gemacht gegen Spielcurricula.“"
                            },
                            {
                                "example_id": "c5bbb802-e1bd-47ae-bbbb-1461fcf165a2",
                                "sense_id": "01b8725a-0055-37df-9d53-e2e899f20e81",
                                "text": "„Die Hauptsache bleibt aber, und deshalb ist das Wort Spielcurriculum im Untertitel des Buches irreführend, daß mit diesen Spielen nicht bestimmte Lernziele angesteuert werden, sondern in der Schule Raum geschaffen wird für einen anderen sozialen Umgang.“"
                            },
                            {
                                "example_id": "6b2365c4-619e-4267-bdb0-fdcb24a3acdb",
                                "sense_id": "01b8725a-0055-37df-9d53-e2e899f20e81",
                                "text": "„Nach Daublebsky wirkt die in der Jugendbewegung praktizierte Spielerziehung mit ihren zivilisationsfeindlichen und antirationalen Elementen belastend auf die Einrichtung von Spielcurricula nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
