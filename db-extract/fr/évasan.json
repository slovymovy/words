                        "entry_id": "63d1b722-10d4-38a5-93e4-eb9100a7e4cb",
                        "glosses": [
                            "Évacuation rapide d’un blessé dont la gravité des blessures nécessite des soins dans un laps de temps réduit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f17917f-78fd-4711-a699-aad200ebb17d",
                                "sense_id": "388696c2-f506-371b-9c90-6cb40b35a94b",
                                "text": "Pour des questions de rapidité, une évasan héliportée réussie ne se conçoit qu’avec une excellente coordination des moyens qui passe par la radio."
                            },
                            {
                                "example_id": "aff41218-772b-4040-b2c0-c35475fa81d4",
                                "sense_id": "388696c2-f506-371b-9c90-6cb40b35a94b",
                                "text": "Savoir qu’on en a un sous la main, qu’il peut réaliser des évasans en cas de coup dur, c'est réconfortant."
                            },
                            {
                                "example_id": "6b6bb06e-d599-4dde-8278-c8c688f372f7",
                                "sense_id": "388696c2-f506-371b-9c90-6cb40b35a94b",
                                "text": "Note nᵒ 12s7/3/s. du 5 septembre 1949, qui interdit aux unités de demander directement des évasan."
                            }
                        ]
                    }
