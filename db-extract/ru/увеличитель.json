                        "translation_id": "e1aaa5db-3707-424c-89e3-8d4b544f5883",
                        "source_entry_id": "ec18a612-c3ef-389f-9ab4-15f1fd336459",
                        "source_sense_description": "то, что увеличивает",
                        "target_lang_word": "enlarger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlarger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5036bb5-cde3-3574-8a70-274f56e0e60b",
                                        "entry_id": "5ba89bdc-e117-38cf-9417-2c8f394331ee",
                                        "glosses": [
                                            "Any device that makes something bigger, or makes it appear bigger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a392573b-285e-409d-b5d4-945e4c0bc997",
                                                "sense_id": "c5036bb5-cde3-3574-8a70-274f56e0e60b",
                                                "text": "a penis enlarger"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d16984-909c-3a5c-8cf2-5d15bdc840f2",
                                        "entry_id": "5ba89bdc-e117-38cf-9417-2c8f394331ee",
                                        "glosses": [
                                            "An optical device used to make enlarged prints from a photographic negative"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9986773a-47ef-375e-9271-ca9dde6cb18a",
                                        "entry_id": "5ba89bdc-e117-38cf-9417-2c8f394331ee",
                                        "glosses": [
                                            "One who enlarges."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb57ede-dc8e-4390-8559-70c7864f1159",
                                                "sense_id": "9986773a-47ef-375e-9271-ca9dde6cb18a",
                                                "text": "EUGE´NIUS, who was bishop of Toledo from a. d. 646 to 657, is mentioned under Dracontius as the editor and enlarger of the work by Dracontius upon the Creation."
                                            },
                                            {
                                                "example_id": "9fd0cef6-976b-466a-81b9-e1eed6422471",
                                                "sense_id": "9986773a-47ef-375e-9271-ca9dde6cb18a",
                                                "text": "In like manner the original book closes, at xxix. 1, with a subscription; and a few additional chapters follow, added by the enlarger of the book."
                                            },
                                            {
                                                "example_id": "4ef2a332-6e8a-41e3-9533-f5ca3e2548f2",
                                                "sense_id": "9986773a-47ef-375e-9271-ca9dde6cb18a",
                                                "text": "Muffett’s book was not a recipe book, but the credentials of its author (as well as those of the book’s “enlarger”) put him in the rare position of being a qualified English physician writing for a lay audience on paramedical matters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
