                "senses": [
                    {
                        "sense_id": "06acca6a-3043-3649-8f68-02d41ddea4bc",
                        "entry_id": "301b0ba5-4435-35db-91f8-7a90fa37a082",
                        "glosses": [
                            "Se saouler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "624b2ca5-ffd4-4aab-9e57-bca1765abc80",
                                "sense_id": "06acca6a-3043-3649-8f68-02d41ddea4bc",
                                "text": "Bref c’est pas parce qu’on ne peut pas allez boire l’apéro en terrasse et se fioler au PMU qu’on va stopper nos publications détentes du vendredi."
                            },
                            {
                                "example_id": "af0c7ac6-9be2-4a17-8e16-706b6565f384",
                                "sense_id": "06acca6a-3043-3649-8f68-02d41ddea4bc",
                                "text": "En gros, deux jours de folie au Fil, pour venir se fioler, fréquenter et finir à cacasson la tête dans le bachats."
                            },
                            {
                                "example_id": "4e1c83de-07ae-4971-be12-d25457f9ff04",
                                "sense_id": "06acca6a-3043-3649-8f68-02d41ddea4bc",
                                "text": "Si on peut plus se fioler avec les copains"
                            }
                        ]
                    },
                    {
                        "sense_id": "432cae1f-d837-3608-b7fb-364254515bfb",
                        "entry_id": "301b0ba5-4435-35db-91f8-7a90fa37a082",
                        "glosses": [
                            "Boire."
                        ],
