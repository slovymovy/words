                        "cross_references": [
                            {
                                "target_word": "surrealizm",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "34bd5c75-a8b2-3737-9afc-eb75300d0280",
                                        "entry_id": "26c2a4f4-9643-37e7-96c9-c023a7e0c9ca",
                                        "glosses": [
                                            "kierunek artystyczny w literaturze i sztuce, ukształtowany w latach dwudziestych XX w., w założeniu którego wyrażano swoje wnętrze, podświadomość, wizje, sny, halucynacje itp. w oderwaniu od rzeczywistości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd0c04e-2c75-4f47-bbcb-e50be6aee106",
                                                "sense_id": "34bd5c75-a8b2-3737-9afc-eb75300d0280",
                                                "text": "Kategorie cudowności, fantazji, tajemniczości, grozy i czarnego humoru, charakterystyczne dla surrealizmu, cechują także groteskę, szerszą kategorię artystyczną, obejmującą również ten styl."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "168e7b68-6868-4c6d-a223-b61def6304cf",
                        "source_entry_id": "8a320347-b0aa-301b-8089-740e896cef6a",
                        "source_sense_id": "c2fd41b1-ceec-32dc-85c9-04ff194e64e3",
                        "target_lang_word": "surrealismo",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surrealismo",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa02bbe-ca3e-3114-b6c5-61db346bbebc",
                                        "entry_id": "747eeca0-7c19-3cc0-9f83-b97a4e011a04",
                                        "glosses": [
                                            "movimento artístico e literário nascido em Paris na década de 1920, parte do modernismo"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d601f29c-3da2-46a2-96ad-ea40aee509e7",
                        "source_entry_id": "8a320347-b0aa-301b-8089-740e896cef6a",
                        "source_sense_id": "c2fd41b1-ceec-32dc-85c9-04ff194e64e3",
                        "target_lang_word": "сюрреализм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сюрреализм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1198cb9d-505a-3f4a-a5e3-b8ec27c8df45",
                                        "entry_id": "32e42a42-e2a7-34c5-9e6f-0ccd29707860",
                                        "glosses": [
                                            "искусств. направление в западноевропейском авангардистском искусстве, хронологически сменившее дадаизм, сложившееся в 1920-х гг., объявившее своей задачей воспроизведение потока сознания и подсознания (сновидения, инстинкты, галлюцинации) и своим методом — разрыв логических связей, заменённых свободными ассоциациями; отличается использованием аллюзий и парадоксальных сочетаний предметов, форм и т. д."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261f3d9d-691f-450d-ae6f-44ffa2828f5e",
                                                "sense_id": "1198cb9d-505a-3f4a-a5e3-b8ec27c8df45",
                                                "text": "Ему же принадлежит и второе, более «яркое» определение сюрреализма как «свободного потока сознания, не подконтрольного разуму, не связанного никакими эстетическими или моральными критериями»."
                                            },
                                            {
                                                "example_id": "292bf9eb-4a9b-4712-b561-10e952a2f731",
                                                "sense_id": "1198cb9d-505a-3f4a-a5e3-b8ec27c8df45",
                                                "text": "Повествователь в «Спящем», в полном согласии с мэтрами сюрреализма, которые утверждают, что самой истинной реальностью является реальность сновидения, ибо она иррациональна, а значит ― независима от навязываемых сознанию умозрительных рецептов и клише, фиксирует: «Воображение казалось могущественнее действительности. А может быть, действительность подчинялась воображению спящего, который в эти глубокие ночные часы был в одно и то же время самим собой, и всеми нами, и яхтой, и мигающим маяком, и созвездием Кассиопеи, и мною»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f49d94-0045-3475-aa4d-3f0c2b7de895",
                                        "entry_id": "32e42a42-e2a7-34c5-9e6f-0ccd29707860",
                                        "glosses": [
                                            "перен. абсурдная, иррациональная, парадоксальная ситуация, обстоятельства и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98438035-78dd-48f3-a273-51ad8d73b6de",
                                                "sense_id": "37f49d94-0045-3475-aa4d-3f0c2b7de895",
                                                "text": "Вспомним овацию Лигачёву после его самоотчёта в начале съезда, а вслед за тем поразившее, видимо, всех небольшое число голосов, поданных за него при голосовании в генсеки. Сюрреализм? Вовсе нет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
