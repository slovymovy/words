                                            {
                                                "example_id": "6ca9e245-4bb2-41f6-ad65-eb19dbed7b7f",
                                                "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                                                "text": "to bow and sue for grace with suppliant knee"
                                            },
                                            {
                                                "example_id": "ce0b6386-a455-44ff-8236-3362d2f6e5bc",
                                                "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                                                "text": "Some plaques formed part of a mosaic that covered human life with its varied scenes of peace and war. Here we have warriors, the Cretan erect, and his darker-skinned enemy prostrate and suppliant."
                                            },
                                            {
                                                "example_id": "422a3329-8322-4374-9120-687a767596ea",
                                                "sense_id": "a8d40ca3-5868-34d7-97b5-fbd4898f2913",
                                                "text": "Oedipus, King of my country, you can see our ages who are before your door; some it may be too young for such a journey, and some too old, Priests of Zeus such as I, and these chosen young men; while the rest of the people crowd the market-places with their suppliant branches, for the city stumbles towards death, hardly able to raise up its head"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca47814-94a7-31c8-8ffb-206237bb98e5",
                                        "entry_id": "7e0a5e1d-0dda-34f6-8b16-bf0bc4ef9077",
                                        "glosses": [
                                            "Supplying; auxiliary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c11359b-16c5-4e36-8fa3-4839f9534757",
                                                "sense_id": "9ca47814-94a7-31c8-8ffb-206237bb98e5",
                                                "text": "your levy Must be suppliant"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suppliant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42bf354c-d70f-3c9f-9d2b-b8c41669cafb",
                                        "entry_id": "ee9c555b-b6af-301a-aaf8-b6b0e6d5ede6",
                                        "glosses": [
                                            "One who pleads or requests earnestly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fef2c25b-cfeb-4caf-8f39-3fece1e78f45",
                                                "sense_id": "42bf354c-d70f-3c9f-9d2b-b8c41669cafb",
                                                "text": "In reuerence therefore of the hopes vvhich the Grecians haue repoſed in you, and of the preſence of Iupiter Olympius, in vvhoſe Temple here, vve are in a manner ſuppliants to you, receiue the Mitylenians into league, and ayde vs."
                                            },
                                            {
                                                "example_id": "af852492-8188-4379-b5d0-d503ed1ff315",
                                                "sense_id": "42bf354c-d70f-3c9f-9d2b-b8c41669cafb",
                                                "text": "I touch your beard as a suppliant, embrace your knees, imploring you to have pity on my wretchedness."
                                            }
                                        ]
                                    }
                                ]
                            }
