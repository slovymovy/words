                "senses": [
                    {
                        "sense_id": "87fcccac-af7b-3f2c-b038-45c34d118be1",
                        "entry_id": "45bd065c-72a2-3ae8-9cd3-362e8fcde706",
                        "glosses": [
                            "van een persoon dat deze een slecht gehoor heeft"
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "ac745680-3cf3-4ead-aa74-d76160bea2b4",
                                "sense_id": "87fcccac-af7b-3f2c-b038-45c34d118be1",
                                "text": "Het Rudolf Mees Instituut, waar Ghobrial voor werkt, telt onder zijn leerlingen ruim zestig procent gehoorgestoorde allochtonen. Dat percentage is hoger dan verwacht op grond van de demografische gegevens. Slechtere medische voorzieningen in het land van herkomst, rodehondinfecties, maar ook aangeboren afwijkingen door een huwelijk met een bloedverwant - wat in de islamitische cultuur heel gewoon is - verklaren het hoge percentage."
                            },
                            {
                                "example_id": "aec1fe87-ade7-431d-951b-f1c630ffbd79",
                                "sense_id": "87fcccac-af7b-3f2c-b038-45c34d118be1",
                                "text": "Ook lijkt men tijdelijk gehoorgestoord te zijn, omdat de teksten - ook als er geen verkeer passeert - op veel luidere toon worden uitgesproken dan nodig."
                            }
                        ]
                    }
                ],
