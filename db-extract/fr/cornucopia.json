                        "entry_id": "9cc18b06-7258-3b73-beba-f16af9a7ab10",
                        "glosses": [
                            "Corne d’abondance, emblème et symbole de la fécondité."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a5787bc0-3aa0-41b7-b62e-48441f279072",
                                "sense_id": "e5bb6b33-96eb-3e37-89fc-96d5e684d5de",
                                "text": "Forme ambigüe à la fois pointe phallique et récipient matrice, la cornucopia représente la fécondité."
                            },
                            {
                                "example_id": "b81c1d61-77b0-4b53-a9da-e70d0d75ca59",
                                "sense_id": "e5bb6b33-96eb-3e37-89fc-96d5e684d5de",
                                "text": "Deux cornucopias entrecroisées ornent le devant du coffre."
                            }
                        ]
                    },
                    {
                        "sense_id": "22ee7333-5684-3507-bbe7-a041c7ebf1b7",
                        "entry_id": "9cc18b06-7258-3b73-beba-f16af9a7ab10",
