                "senses": [
                    {
                        "sense_id": "a4acc008-0e49-3513-9dff-36f7c91fd939",
                        "entry_id": "6679c06b-f998-327c-b442-6aef331d6974",
                        "glosses": [
                            "Spannungsgefühl bzw. die Schmerzen beider Mammae (Milchdrüsen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daaa9482-2cef-4070-ad08-67f46d21b749",
                                "sense_id": "a4acc008-0e49-3513-9dff-36f7c91fd939",
                                "text": "„Bei zyklusunabhängigen Mastodynien muss auch an Schmerzen gedacht werden, die mit der eigentlichen Brust nichts selbst zu tun haben, und an stressbedingte Ursachen.“"
                            },
                            {
                                "example_id": "e0fad2ee-5532-4528-bba4-a919d686efe4",
                                "sense_id": "a4acc008-0e49-3513-9dff-36f7c91fd939",
                                "text": "„Wird sie bei ausgeprägten Mastodynien glatt und atonisch, kann dies auf eine neurogene Ursache der Beschwerden hinweisen (Abb. 8).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
