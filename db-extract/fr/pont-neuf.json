                            {
                                "example_id": "d6ed0a74-fcf0-4515-8ccb-cc934cb83cee",
                                "sense_id": "8c96306a-cd1b-3885-97a3-fbbf88ca6af9",
                                "text": "L’étudiant n’avait pas perdu son habitude d’admirer tout haut les reflets du Pont-Neuf sur la Seine, ou la brume de novembre dans les jardins des Tuileries."
                            },
                            {
                                "example_id": "14d247eb-079d-4270-a352-81dd5bf5c421",
                                "sense_id": "8c96306a-cd1b-3885-97a3-fbbf88ca6af9",
                                "text": "Sur la Seine;\nIl en a vu de toutes les couleurs\nIl en a fait couler de l'encre,\nLe Vieux Pont-Neuf."
                            }
                        ]
