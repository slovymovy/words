                },
                {
                    "sense_id": "02756c14-cc32-3078-b9e8-614e72878c7d",
                    "sense_definition": "Mentally deranged, insane, or crazy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was <w>daft</w> and would often talk to the birds in the park.",
                            "target_lang_translations": {
                                "ru": "Старик был <w>не в своем уме</w> и часто разговаривал с птицами в парке."
                            }
                        },
                        {
                            "text": "Some people thought he had gone <w>daft</w> after living alone on the island for years.",
                            "target_lang_translations": {
                                "ru": "Некоторые думали, что он <w>рехнулся</w> после того, как прожил на острове в одиночестве много лет."
                            }
                        }
