                "senses": [
                    {
                        "sense_id": "6772f4df-2a73-3d5d-a1be-f75d682316f8",
                        "entry_id": "f522638c-bb9f-34b9-9020-463de090855b",
                        "glosses": [
                            "Schale aus Plastik"
