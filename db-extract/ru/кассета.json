                    },
                    {
                        "translation_id": "f75bcac2-b048-454c-b1aa-ecdda6e3fd5e",
                        "source_entry_id": "4697e3d8-d3ea-3d8d-a886-e142d021dc83",
                        "source_sense_id": "f95247f3-db74-3bd0-9f63-67900f85b7c2",
                        "target_lang_word": "cassette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cassette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5aa5747-bf2f-307f-bc1e-454b01cb42a0",
                                        "entry_id": "540f8880-79ec-35e8-97f7-d9950e37a03e",
                                        "glosses": [
                                            "Petite boîte où l’on range ordinairement des objets précieux et de peu de volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a62cdd98-6cb3-4a4b-9b57-ed445bef1cec",
                                                "sense_id": "b5aa5747-bf2f-307f-bc1e-454b01cb42a0",
                                                "text": "Rowena ouvrit la petite cassette ornée de ciselures d’argent que lui présentait Rébecca. Elle contenait un collier et des boucles d’oreilles en diamant …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c18eef3f-1efe-3bd3-a283-2d927ae7c906",
                                        "entry_id": "540f8880-79ec-35e8-97f7-d9950e37a03e",
                                        "glosses": [
                                            "Trésor particulier d’un prince, d’un souverain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c779513-6abf-4b2e-bdb6-34c1e3fdfc06",
                                                "sense_id": "c18eef3f-1efe-3bd3-a283-2d927ae7c906",
                                                "text": "Pour le héros de Modeste, cette somme constituait alors une fortune d’autant plus précaire, qu’il dépensait environ cinq ou six mille francs au-delà de ses revenus ; mais la cassette du roi, les fonds secrets du ministère avaient jusqu’alors comblé ces déficits."
                                            },
                                            {
                                                "example_id": "726bab78-986f-49d4-a575-048e07b823f1",
                                                "sense_id": "c18eef3f-1efe-3bd3-a283-2d927ae7c906",
                                                "text": "Le Roi daigna sourire et confirma la donation promise de cent louis sur sa cassette et d’un logement au Louvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f89cd70d-0e8d-36ec-9110-738cfd0bc782",
                                        "entry_id": "540f8880-79ec-35e8-97f7-d9950e37a03e",
                                        "glosses": [
                                            "Petite boîte contenant une bande magnétique sur laquelle on peut enregistrer du son ou de la vidéo ainsi que des programmes informatiques. On l’utilise généralement dans les magnétoscopes, magnétophones et caméscopes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8157a4-909b-45a6-83b5-b9c3dba3ae35",
                                                "sense_id": "f89cd70d-0e8d-36ec-9110-738cfd0bc782",
                                                "text": "Entre 1984 et 1986, dans les volutes de fumée de sa pipe et assis derrière son bureau, Georges a raconté une partie de sa vie sur des cassettes à bande, aujourd’hui au nombre de trente-sept."
                                            },
                                            {
                                                "example_id": "9c3da67b-a544-4b28-97dc-a266222107ce",
                                                "sense_id": "f89cd70d-0e8d-36ec-9110-738cfd0bc782",
                                                "text": "Un large sourire aux lèvres, il tendit à Alex le sachet de plastique qu'il tenait à la main. Gribovitch s'en saisit et regarda à l'intérieur.\n— Une cassette vidéo. Hum. Le produit de votre travail d'enquêteur, agent Orsini ?\n— Non, rétorqua Pitchoune. C'est un film de cul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04bf54d7-860c-3231-a1c4-f4f409169ca8",
                                        "entry_id": "540f8880-79ec-35e8-97f7-d9950e37a03e",
                                        "glosses": [
                                            "Sens dérivé du précédent : discours public, politique, etc., au contenu stéréotypé et convenu, manquant de spontanéité, de sincérité, d'authenticité."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d84e6256-27a9-3343-b0bc-b71923b01564",
                                        "entry_id": "540f8880-79ec-35e8-97f7-d9950e37a03e",
                                        "glosses": [
                                            "Plumier d’écolier."
                                        ],
