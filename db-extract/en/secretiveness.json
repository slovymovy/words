                        "target_lang_word": "Geheimnistuerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimnistuerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48528f60-8e97-3b6b-8184-4d21e243bbe3",
                                        "entry_id": "12d5de12-889b-37ef-a8f3-a8ca57d8493c",
                                        "glosses": [
                                            "Verhalten, bestimmte Dinge geheim zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831542de-b784-4015-b31c-3835787b57f1",
                                                "sense_id": "48528f60-8e97-3b6b-8184-4d21e243bbe3",
                                                "text": "„Durch die Geheimnistuerei der Contessa gewann ich die Überzeugung, daß M. M. einen Geliebten haben müsse, wollte mir aber deswegen keinen Kummer machen.“"
                                            }
