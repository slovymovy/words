                        "entry_id": "853a7c7e-5fcb-3dde-bd65-f914c13fca39",
                        "glosses": [
                            "Sixième jour de la semaine, samedi selon la norme ISO 8601. Forme dialectale du nord de l’Allemagne, principalement en Frise orientale et en Westphalie."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "c2126967-b84a-4290-a4bb-fb0f5c93365c",
                                "sense_id": "da78ae6a-bd06-3c53-8370-2603e040bea2",
                                "text": "Morgen haben wir Satertag.",
                                "translation": "Demain nous sommes samedi."
                            },
                            {
                                "example_id": "18e6e835-0401-4329-9a1e-8e3fe421aada",
                                "sense_id": "da78ae6a-bd06-3c53-8370-2603e040bea2",
                                "text": "Am Satertag gehen wir in die Eisbahn.",
                                "translation": "samedi prochain nous irons à la patinoire."
                            },
                            {
                                "example_id": "f8b80c7c-b475-4d3d-8bcd-b8b8e700547e",
                                "sense_id": "da78ae6a-bd06-3c53-8370-2603e040bea2",
                                "text": "heute ist Satertag, der 12. Juni.",
                                "translation": "Nous sommes aujourd'hui le samedi 12 juin."
                            }
                        ]
                    }
                ],
