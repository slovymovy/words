        "fr-extract.jsonl": [
            {
                "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                "word": "régénération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "118e1cda-aa1a-440b-8736-0742d40304c2",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "tags": [
                            "plural"
                        ],
                        "form": "régénérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4a3d7a1-d022-3e30-ab5b-b1c4b515ae7b",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Reproduction ; reconstitution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9907ac1-8909-4b2e-9886-dd6c1df7d86d",
                                "sense_id": "e4a3d7a1-d022-3e30-ab5b-b1c4b515ae7b",
                                "text": "D’après les agriculteurs, la baisse de la qualité des sols était attribuable à une insuffisance de terre, qui faisait en sorte que la mise en jachère et la régénération des sols étaient impossibles."
                            },
                            {
                                "example_id": "808aadc9-ad6b-4094-bc67-e73a26fcb93d",
                                "sense_id": "e4a3d7a1-d022-3e30-ab5b-b1c4b515ae7b",
                                "text": "Il suffit, dit ce savant chirurgien, d’énoncer les principaux arguments de cette régénération des chairs pour en finir avec une théorie que personne ne soutient aujourd’hui."
                            }
                        ]
                    },
                    {
                        "sense_id": "81f77807-047d-306d-b9da-4e3e47c78ffd",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Réformation ; amélioration ; renouvellement moral."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2b3064aa-9313-4e6e-a423-b1c6448b4f96",
                                "sense_id": "81f77807-047d-306d-b9da-4e3e47c78ffd",
                                "text": "Hélas ! faut-il qu’une entreprise aussi grande que celle de la régénération de l’Angleterre doive reposer sur un pivot si défectueux !"
                            },
                            {
                                "example_id": "38112fb9-807a-4792-8e03-935f6593354d",
                                "sense_id": "81f77807-047d-306d-b9da-4e3e47c78ffd",
                                "text": "Tels furent les commencemens du règne de Louis XVI. Il y avait une espérance universelle de bonheur public, l’attente d’une sorte de régénération pour le royaume, et une confiance sans bornes dans les intentions du jeune roi."
                            },
                            {
                                "example_id": "7a2fb090-886c-4b35-9287-0f95aa7ac6c8",
                                "sense_id": "81f77807-047d-306d-b9da-4e3e47c78ffd",
                                "text": "Le déclin architectural, culturel et social de la ville portugaise de Vila do Conde a été contré grâce à un programme de régénération urbaine innovant et intégré."
                            }
                        ]
                    },
                    {
                        "sense_id": "13acaa84-7390-33b7-9b9f-14a4d8b67d72",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Renaissance, en parlant du baptême."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6ebcfafe-239c-4cbc-a7d4-3d8507705ca8",
                                "sense_id": "13acaa84-7390-33b7-9b9f-14a4d8b67d72",
                                "text": "C’est encore ce qui nous est offert sous cette image si belle et si forte de la régénération."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a91746b-90c3-3a96-8be8-eef91cf35b42",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Surgénération."
                        ],
                        "tags": [
                            "Nucléaire"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "344ce223-c7ad-34e3-9bc9-9564e348e4dc",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Apparition, spontanée ou provoquée, de semis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d45283cc-e4ec-4ced-942d-c39f0fc6ee10",
                                "sense_id": "344ce223-c7ad-34e3-9bc9-9564e348e4dc",
                                "text": "Appliquée sur la durée, la futaie irrégulière offre de grandes surfaces où la régénération est présente ce qui rend la forêt mieux armée pour se reconstruire à moindre coût en cas de catastrophe naturelle (tempête…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f3b60f2-865a-3b24-b151-e10d805588f8",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Utilisation de ce phénomène après exploitation pour renouveler les arbres."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "97a1fb0a-21fe-4f42-8e56-1f1b65e0a006",
                                "sense_id": "2f3b60f2-865a-3b24-b151-e10d805588f8",
                                "text": "En effet, les opérations [de] régénérations^([sic]) sont souvent entreprises en lien avec une glandée. Or les glandées sont irrégulières en zone continentale. Il s’avère ainsi que 2002 et 2003 sont des années au cours desquelles peu d’opérations de régénération ont été entamées."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e7f5df0-6af7-38c4-b498-969203108ae4",
                        "entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "glosses": [
                            "Auto-nettoyage du filtre à particules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05dbccbc-a75f-4061-81e2-f28ec7be6c40",
                                "sense_id": "4e7f5df0-6af7-38c4-b498-969203108ae4",
                                "text": "L’essai n’est pas effectué pendant la régénération du filtre à particules diesel du véhicule"
                            },
                            {
                                "example_id": "06c2ac69-8bbd-45b6-aa06-0d4306474224",
                                "sense_id": "4e7f5df0-6af7-38c4-b498-969203108ae4",
                                "text": "Le troisième paquet prévoit l'introduction de la mesure des émissions en nombre de particules (PN). Il comporte également des dispositions législatives particulières pour les véhicules hybrides ainsi qu'une procédure visant à inclure les démarrages à froid et les épisodes de régénération dans l'essai RDE."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46fbce44-e0cb-44b6-a8d4-0c4042d19b4c",
                        "source_entry_id": "cd29d7f8-12e9-3d94-bd5e-d1b38ab02b7c",
                        "target_lang_word": "regeneration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regeneration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "045540c7-4409-3d53-9bd7-80ce0f3239b8",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "Rebuilding or restructuring; large scale repair or renewal; revitalisation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf50cd12-d43d-48ea-8404-c6fd596ac3d9",
                                                "sense_id": "045540c7-4409-3d53-9bd7-80ce0f3239b8",
                                                "text": "The conversion of so many old industrial buildings into living quarters was a major factor in the regeneration."
                                            },
                                            {
                                                "example_id": "f03f7c66-6092-41cf-98cf-d261ebe2959f",
                                                "sense_id": "045540c7-4409-3d53-9bd7-80ce0f3239b8",
                                                "text": "But the key thing that excites Jolliffe about biochar is that it avoids waste and it can actually give something back to the environment. \"The nice thing is that the biochar doesn't just sit there in a heap,\" she says. \"It's used for soil regeneration. You can spread it on the land and it can not only enhance the soil's capacity to manage moisture, but it also acts as a fertiliser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af31a3c-2483-38c4-b1b0-933c475fa565",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "Spiritual rebirth; the change from a carnal or material life to a pious one"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9a27ba2-5843-3439-b6f1-3bcda9cd5304",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The renewal of the world at the second coming of Christ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c1356ef-5a63-3590-bfae-55707c7bb332",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The process by which a water softener flushes out minerals extracted from the water supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77056d30-bacf-3c99-acc1-70c96f408f5d",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The ability to rapidly heal substantial physical damage to one's body, or to spontaneously restore hit points."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36bd15cf-87ab-46c3-8a70-cf9f1a2ba801",
                                                "sense_id": "77056d30-bacf-3c99-acc1-70c96f408f5d",
                                                "text": "The standard ring of regeneration restores one point of damage per turn (and will eventually replace lost limbs or organs)."
                                            },
                                            {
                                                "example_id": "74d030c6-e290-4411-a798-58fdfcef044e",
                                                "sense_id": "77056d30-bacf-3c99-acc1-70c96f408f5d",
                                                "text": "2003, Bastion Press, E. W. Morton, Out for Blood\nRegeneration does not restore hit points lost from starvation, thirst, or suffocation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab3648f-54e9-3cb9-a1c6-6a11f0fa90c8",
                                        "entry_id": "08d1eaab-095b-36a7-8a3c-05b9f8bcc9f0",
                                        "glosses": [
                                            "The property of a kind of circuit, much used in radio receivers, that allows an electronic signal to be amplified many times through a feedback loop."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
