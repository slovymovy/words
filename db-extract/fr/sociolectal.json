                        "sense_id": "b1483816-8df5-3a6e-b6e3-f26a9abf1fb2",
                        "entry_id": "3c50ce1e-c8c1-3f6a-9cc4-93d9e30f0695",
                        "glosses": [
                            "Relatif au sociolecte, au parlé d’un groupe social."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e3eb83-b4ed-4d74-958c-e5a4441a1a2a",
                                "sense_id": "b1483816-8df5-3a6e-b6e3-f26a9abf1fb2",
                                "text": "Dans un récit particulier le système symbolique manifeste un univers sémantique idiolectal; dans un système de récits le système mythique manifeste un univers sémantique sociolectal."
                            },
                            {
                                "example_id": "b8d1c6d1-d928-48b3-96ba-532bf08673fc",
                                "sense_id": "b1483816-8df5-3a6e-b6e3-f26a9abf1fb2",
                                "text": "Le processus de dévernacularisation dont témoignent les versions III, IV et, surtout, V vise donc à restaurer tant le saupoudrage sociolectal du texte de départ que le genre de rire escompté par Faulkner dans le cadre du topos de l’arroseur arrosé."
                            }
                        ]
                    }
