                "senses": [
                    {
                        "sense_id": "ece1019e-3e26-3510-a743-c9fec43cf8d9",
                        "entry_id": "271b5e4a-a614-34e3-b8fc-46364049432c",
                        "glosses": [
                            "Säule mit Entfernungsangaben, nach denen die Post abrechnete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd6c1ee-96c4-44dd-8067-0b6eaffb72f5",
                                "sense_id": "ece1019e-3e26-3510-a743-c9fec43cf8d9",
                                "text": "„Seit 2012 weist am Kreisverkehr an der Mühlgrabenbrücke wieder eine von einst zwei Postmeilensäulen Eilenburger Reisenden den Weg.“"
                            },
                            {
                                "example_id": "b868e8d4-e13e-4f1c-b5c7-490bbc5b8a89",
                                "sense_id": "ece1019e-3e26-3510-a743-c9fec43cf8d9",
                                "text": "„Freiberg allerdings besitzt als einzige Stadt noch drei original erhaltene Postmeilensäulen.“"
                            },
                            {
                                "example_id": "c68194dc-b53d-427d-9d7f-b9e03de2b430",
                                "sense_id": "ece1019e-3e26-3510-a743-c9fec43cf8d9",
                                "text": "„Wenn Sie durch mitteldeutsche Städte reisen, die einst zum Kurfürstentum Sachsen gehörten, erwecken häufig prächtige Postmeilensäulen Ihre Aufmerksamkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
