                    {
                        "translation_id": "cf6bf24d-53a9-4d64-931e-edfcb7cc4edb",
                        "source_entry_id": "373ba5f7-cd2c-36c9-b295-ce39a129e933",
                        "source_sense_id": "22c88174-ee20-35c8-ad88-c8ac9312b917",
                        "target_lang_word": "soupirail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soupirail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                        "entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                                        "glosses": [
                                            "Ouverture pratiquée à la partie inférieure d’un édifice, pour donner un peu d’air et de jour à une cave, à un sous-sol, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2da39095-6120-4f32-8b4a-2d25c1622af6",
                                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                                "text": "La seule lumière qui l’éclairât filtrait à travers deux soupiraux hors de la portée de la main du prisonnier."
                                            },
                                            {
                                                "example_id": "38c09cc9-f720-4a6c-8c09-b05eacf585b4",
                                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                                "text": "On eût dit des âmes en peine aux soupiraux du purgatoire qui donnent sur l’enfer."
                                            },
                                            {
                                                "example_id": "33532292-6a5e-4292-9d5f-d351a364c1c6",
                                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                                "text": "Ils allaient pénétrer dans la maison, lorsque des coups de feu partirent d'un soupirail ouvert au ras du sol."
                                            },
                                            {
                                                "example_id": "7ca45d59-0a37-4055-a1ca-57ee9c0e7070",
                                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                                "text": "Le prisonnier qui sommeillait, les bras repliés sous la barbe, frissonna et se dressa brusquement, hagard, le coeur battant. Il vit la brume du matin qui coulait par le soupirail."
                                            },
                                            {
                                                "example_id": "6409bd79-1f18-43ba-baba-0a13e460d596",
                                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                                "text": "Sinon, le châtelain de contrebande s’amuse à évoquer d’hypothétiques reclus qu’il retiendrait dans les entrailles sans soupirail de son foirail."
                                            },
                                            {
                                                "example_id": "351ff559-de58-4bb6-98fe-1be53d7a7aa4",
                                                "sense_id": "6dc4affe-a365-3a5a-a0d4-4d9974102567",
                                                "text": "Le tout est éclairé par le brin de lumière naturelle qui passe à travers les soupiraux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b68cfa65-145f-36e5-87ed-aeea40bff0cd",
                                        "entry_id": "442980ae-4a0d-3032-a1e0-40df93bf1533",
                                        "glosses": [
                                            "Ouverture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "468c509f-f7a1-452a-8e13-f5be71bdc772",
                                                "sense_id": "b68cfa65-145f-36e5-87ed-aeea40bff0cd",
                                                "text": "Je me sens transporté et tout enivré de ma propre pensée, comme s’il m'arrivait par un soupirail intérieur une bouffée de parfums chauds."
                                            },
                                            {
                                                "example_id": "e668c1fc-bb03-4bc3-a8eb-3ed4dbe11d35",
                                                "sense_id": "b68cfa65-145f-36e5-87ed-aeea40bff0cd",
                                                "text": "La question est de savoir si c’est servir l’Europe, même libérale, que de la réintroduire par le soupirail du Parlement alors qu’elle [a] été expulsée par la porte du vote populaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
