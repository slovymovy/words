{
    "word_family": [
        "mort",
        "mortal",
        "mortality",
        "mortify"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72de3580-39f9-3de4-bc78-6d0c3bf9effa",
                    "sense_definition": "A building where dead bodies are kept before they are buried or cremated.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "death_facility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital has a <w>mortuary</w> located in the basement for the storage of bodies.",
                            "target_lang_translations": {
                                "zh": "这家医院的地下室设有存放遗体的<w>太平间</w>。"
                            }
                        },
                        {
                            "text": "The family visited the <w>mortuary</w> to identify their relative before the funeral service.",
                            "target_lang_translations": {
                                "zh": "家属在葬礼前去<w>停尸房</w>辨认了亲人的遗体。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "local mortuary",
                        "hospital mortuary"
                    ],
                    "target_lang_definitions": {
                        "zh": "存放遗体以备火化或安葬的场所。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "太平间",
                                "target_lang_sense_clarification": "医院内用于暂时存放遗体的房间。"
                            },
                            {
                                "target_lang_word": "停尸房",
                                "target_lang_sense_clarification": "专门用于停放遗体的场所。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98e6a115-7895-3b1d-ae36-7231d480f9b2",
                    "sense_definition": "A traditional gift or payment given to a parish minister upon the death of a parishioner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, the <w>mortuary</w> was a mandatory fee paid to the church after a death.",
                            "target_lang_translations": {
                                "zh": "在中世纪，<w>丧葬费</w>是人死后必须支付给教会的一笔费用。"
                            }
                        },
                        {
                            "text": "Historical records show that the <w>mortuary</w> was often collected in the form of livestock or goods.",
                            "target_lang_translations": {
                                "zh": "历史记录显示，这种<w>丧葬费</w>通常以牲畜或实物的形式收取。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soulscot"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical ecclesiastical practice."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "中世纪时期教区居民去世后支付给教会的丧葬费或遗赠。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丧葬费",
                                "target_lang_sense_clarification": "指代历史语境下支付给教会的费用。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "546ce0a6-6fed-3eba-90d4-02378762659b",
                    "sense_definition": "Relating to death, funerals, or the burial of the dead.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "death_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tomb contained various <w>mortuary</w> artifacts used in burial rituals.",
                            "target_lang_translations": {
                                "zh": "这座古墓中出土了各种用于葬礼仪式的<w>丧葬</w>文物。"
                            }
                        },
                        {
                            "text": "Archaeologists studied the <w>mortuary</w> practices of the civilization to understand their beliefs about the afterlife.",
                            "target_lang_translations": {
                                "zh": "考古学家通过研究该文明的<w>丧葬</w>习俗，以了解他们对来世的信仰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mortuary rites",
                        "mortuary practices"
                    ],
                    "target_lang_definitions": {
                        "zh": "与死亡、葬礼或安葬相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丧葬的",
                                "target_lang_sense_clarification": "形容与葬礼或处理遗体相关的事务。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}