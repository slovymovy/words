{
    "word_family": [
        "attract",
        "attraction",
        "attractively",
        "attractiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f75b80ca-c2f4-3571-acdf-592d117817c7",
                    "sense_definition": "Pleasing to the eye or mind, especially regarding physical appearance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pleasing_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a very <w>attractive</w> dress to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела очень <w>привлекательное</w> платье на вечеринку.",
                                "tr": "Partiye çok <w>çekici</w> bir elbise giydi.",
                                "zh": "她穿了一件非常<w>好看的</w>裙子去参加聚会。"
                            }
                        },
                        {
                            "text": "He is an <w>attractive</w> man with a kind smile.",
                            "target_lang_translations": {
                                "ru": "Он <w>привлекательный</w> мужчина с доброй улыбкой.",
                                "tr": "O, nazik bir gülümsemeye sahip <w>çekici</w> bir adam.",
                                "zh": "他是一位<w>有吸引力的</w>男士，笑容很和蔼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beautiful",
                        "appealing",
                        "charming",
                        "alluring",
                        "fetching",
                        "pretty",
                        "good-looking"
                    ],
                    "antonyms": [
                        "ugly",
                        "unattractive",
                        "repulsive"
                    ],
                    "common_phrases": [
                        "very attractive",
                        "attractive person",
                        "find someone attractive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятный для глаз или ума, особенно в отношении внешности; вызывающий симпатию.",
                        "tr": "Özellikle fiziksel görünüş açısından göze veya zihne hoş gelen, hoşa giden.",
                        "zh": "指外表或内在令人愉悦，特别是在容貌或外形方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привлекательный",
                                "target_lang_sense_clarification": "общий термин для описания приятной внешности"
                            },
                            {
                                "target_lang_word": "симпатичный",
                                "target_lang_sense_clarification": "миловидный, располагающий к себе (часто о людях)"
                            },
                            {
                                "target_lang_word": "притягательный",
                                "target_lang_sense_clarification": "манящий, обладающий особым шармом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çekici",
                                "target_lang_sense_clarification": "fiziksel görünüş veya genel izlenim için yaygın kullanılır"
                            },
                            {
                                "target_lang_word": "alımlı",
                                "target_lang_sense_clarification": "hoş, göze çarpan güzellikte olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有吸引力的",
                                "target_lang_sense_clarification": "通用的描述，指外表或气质令人喜欢"
                            },
                            {
                                "target_lang_word": "好看的",
                                "target_lang_sense_clarification": "指外表美观，常用于描述人或物品"
                            },
                            {
                                "target_lang_word": "迷人的",
                                "target_lang_sense_clarification": "指具有某种魅力，令人着迷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4aab97d-e5cb-3f81-89b3-49cad08a8cd3",
                    "sense_definition": "Interesting or worth having because of agreeable qualities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pleasing_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made a very <w>attractive</w> offer for the house.",
                            "target_lang_translations": {
                                "ru": "Компания сделала очень <w>привлекательное</w> предложение по покупке дома.",
                                "tr": "Şirket ev için çok <w>cazip</w> bir teklif yaptı.",
                                "zh": "公司为这栋房子开出了一个非常<w>诱人的</w>报价。"
                            }
                        },
                        {
                            "text": "We found an <w>attractive</w> price for the flight tickets.",
                            "target_lang_translations": {
                                "ru": "Мы нашли <w>привлекательную</w> цену на авиабилеты.",
                                "tr": "Uçak biletleri için <w>cazip</w> bir fiyat bulduk.",
                                "zh": "我们找到了一个非常<w>划算的</w>机票价格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "desirable",
                        "tempting",
                        "inviting",
                        "enticing",
                        "appealing"
                    ],
                    "antonyms": [
                        "unattractive",
                        "unenticing"
                    ],
                    "common_phrases": [
                        "attractive offer",
                        "attractive price",
                        "attractive option"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интересный или желаемый благодаря своим положительным качествам или выгоде.",
                        "tr": "Hoş nitelikleri nedeniyle ilgi çekici veya sahip olunmaya değer, avantajlı.",
                        "zh": "指因具备良好的品质或条件而令人感兴趣或值得拥有。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привлекательный",
                                "target_lang_sense_clarification": "о предложении, цене или перспективе"
                            },
                            {
                                "target_lang_word": "заманчивый",
                                "target_lang_sense_clarification": "обещающий удовольствие или выгоду"
                            },
                            {
                                "target_lang_word": "выгодный",
                                "target_lang_sense_clarification": "приносящий пользу или прибыль (о цене/сделке)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cazip",
                                "target_lang_sense_clarification": "teklif, fiyat veya fırsat durumlarında kullanılır"
                            },
                            {
                                "target_lang_word": "cezbedici",
                                "target_lang_sense_clarification": "özendirici veya çekici nitelikte olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱人的",
                                "target_lang_sense_clarification": "指条件或提议非常吸引人，令人难以拒绝"
                            },
                            {
                                "target_lang_word": "划算的",
                                "target_lang_sense_clarification": "指价格或交易条件非常有利"
                            },
                            {
                                "target_lang_word": "有吸引力的",
                                "target_lang_sense_clarification": "指方案、价格或机会具有竞争力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ca9170a-bd2c-3b03-a5bf-96b31ba89205",
                    "sense_definition": "Having the power to pull or draw things closer by physical force.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gravity is an <w>attractive</w> force between two objects.",
                            "target_lang_translations": {
                                "ru": "Гравитация — это <w>притягивающая</w> сила между двумя объектами.",
                                "tr": "Yerçekimi iki nesne arasındaki bir <w>çekim</w> kuvvetidir.",
                                "zh": "重力是两个物体之间的一种<w>吸引</w>力。"
                            }
                        },
                        {
                            "text": "The magnet exerts an <w>attractive</w> pull on the metal.",
                            "target_lang_translations": {
                                "ru": "Магнит оказывает <w>притягивающее</w> воздействие на металл.",
                                "tr": "Mıknatıs metal üzerinde bir <w>çekim</w> uygular.",
                                "zh": "磁铁对金属产生了一种<w>吸引</w>力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnetic"
                    ],
                    "antonyms": [
                        "repulsive"
                    ],
                    "common_phrases": [
                        "attractive force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий способностью притягивать объекты физической силой.",
                        "tr": "Nesneleri fiziksel bir kuvvetle kendisine doğru çekme gücüne sahip olan.",
                        "zh": "指具有通过物理力将物体拉向自身的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притягивающий",
                                "target_lang_sense_clarification": "действующий силой физического притяжения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çekim",
                                "target_lang_sense_clarification": "fiziksel kuvvet bağlamında (örn. çekim kuvveti)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引的",
                                "target_lang_sense_clarification": "指物理上的相互吸引作用"
                            },
                            {
                                "target_lang_word": "引力的",
                                "target_lang_sense_clarification": "专门用于物理学中描述力场"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}