                        "source_sense_id": "7d7a0350-db07-3317-9f93-6f025f2b85a9",
                        "source_sense_description": "Hygiene: Slipeinlage",
                        "target_lang_word": "Slipeinlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slipeinlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43c745b9-a910-3f21-abb9-691fa793490c",
                                        "entry_id": "4fa34dc7-0937-30ca-8492-3df3404c1a40",
                                        "glosses": [
                                            "für Frauen gedachtes Hygieneprodukt aus Zellstoff, das in die Unterhose eingeklebt wird, um dort leichte Feuchtigkeit aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bf1f589-1050-4f1e-9fe2-9d832ba60518",
                                                "sense_id": "43c745b9-a910-3f21-abb9-691fa793490c",
                                                "text": "Slipeinlagen nehmen nur wenig Feuchtigkeit auf, deshalb sind sie als Menstruationsschutz ungeeignet, sie schützen eigentlich hauptsächlich die Unterwäsche vor Verfärbungen."
                                            },
                                            {
                                                "example_id": "7e3474b1-1598-4258-938c-6ae90bc7bce3",
                                                "sense_id": "43c745b9-a910-3f21-abb9-691fa793490c",
                                                "text": "Eine Slipeinlage ist ein guter zusätzlicher Schutz, wenn man Tampons verwendet und trotzdem die weiße Jeans anziehen möchte."
                                            },
                                            {
                                                "example_id": "971d634c-e867-4f0f-9c4f-f71704081376",
                                                "sense_id": "43c745b9-a910-3f21-abb9-691fa793490c",
                                                "text": "Wer ohne Not Slipeinlagen trägt, schafft ein wachstumsfreundliches Klima für schädliche Bakterien."
                                            },
                                            {
                                                "example_id": "f52e587f-d691-4ca1-8158-5bd8773d8f5d",
                                                "sense_id": "43c745b9-a910-3f21-abb9-691fa793490c",
                                                "text": "„Mit Lactobazillen versehene Tampons und Slipeinlagen könnten helfen, schädliche Mikroorganismen im weiblichen Urogenitaltrakt unter Kontrolle zu halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
