{
    "word_family": [
        "recounting",
        "recountal",
        "counter",
        "count"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24360724-34e6-3879-9b32-cd88028e8ca6",
                    "sense_definition": "To tell or narrate a story or series of events in detail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "narrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man <w>recounted</w> the tale of how he caught the big fish many years ago.",
                            "target_lang_translations": {
                                "ru": "Старик <w>рассказал</w> историю о том, как он поймал большую рыбу много лет назад."
                            }
                        },
                        {
                            "text": "She sat down to <w>recount</w> her experiences during the long journey across the continent.",
                            "target_lang_translations": {
                                "ru": "Она присела, чтобы <w>изложить</w> свои впечатления от долгого путешествия через весь континент."
                            }
                        }
                    ],
                    "synonyms": [
                        "narrate",
                        "relate",
                        "tell",
                        "describe"
                    ],
                    "common_phrases": [
                        "recount the events",
                        "recount a story",
                        "recount an experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробно рассказывать или повествовать о событиях или истории."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассказывать",
                                "target_lang_sense_clarification": "повествовать о событиях"
                            },
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "последовательно выражать словами"
                            },
                            {
                                "target_lang_word": "повествовать",
                                "target_lang_sense_clarification": "книжный стиль, детальный рассказ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67c65d35-2553-3a96-8e9a-f069d79d30a8",
                    "sense_definition": "To count something again, especially to verify a previous count.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "counting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official decided to <w>recount</w> the ballots by hand to ensure the election results were accurate.",
                            "target_lang_translations": {
                                "ru": "Чиновник решил <w>пересчитать</w> бюллетени вручную, чтобы убедиться в точности результатов выборов."
                            }
                        },
                        {
                            "text": "Please <w>recount</w> the money in the register before you finish your shift.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>пересчитай</w> деньги в кассе перед окончанием смены."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recount the ballots",
                        "recount the votes",
                        "recount by hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считать что-либо заново, особенно для проверки точности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересчитывать",
                                "target_lang_sense_clarification": "считать заново для проверки"
                            },
                            {
                                "target_lang_word": "пересчитать",
                                "target_lang_sense_clarification": "совершить акт повторного счета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f09d0738-a83e-3a5e-9ab1-fcbfb9c5e7ab",
                    "sense_definition": "To list or enumerate a series of things one by one.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a good habit to <w>recount</w> your blessings every evening before going to sleep.",
                            "target_lang_translations": {
                                "ru": "Хорошая привычка — каждый вечер перед сном <w>перечислять</w> всё хорошее, что есть в твоей жизни."
                            }
                        },
                        {
                            "text": "The witness began to <w>recount</w> the many reasons why the defendant was at the scene.",
                            "target_lang_translations": {
                                "ru": "Свидетель начал <w>перечислять</w> многочисленные причины, по которым подсудимый находился на месте происшествия."
                            }
                        }
                    ],
                    "synonyms": [
                        "enumerate",
                        "list",
                        "rehearse"
                    ],
                    "common_phrases": [
                        "recount your blessings",
                        "recount the reasons"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перечислять ряд вещей одну за другой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перечислять",
                                "target_lang_sense_clarification": "называть по порядку"
                            },
                            {
                                "target_lang_word": "исчислять",
                                "target_lang_sense_clarification": "вести счет, перечислять блага"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "177e787b-ffdd-3633-8998-3bc832e3147a",
                    "sense_definition": "An act of counting something again, particularly votes in an election.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "counting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate requested a formal <w>recount</w> after losing the election by only ten votes.",
                            "target_lang_translations": {
                                "ru": "Кандидат потребовал официального <w>пересчёта</w> после того, как проиграл выборы с разницей всего в десять голосов."
                            }
                        },
                        {
                            "text": "A manual <w>recount</w> of every ballot cast was ordered to resolve the dispute.",
                            "target_lang_translations": {
                                "ru": "Для разрешения спора был назначен ручной <w>пересчёт</w> каждого поданного бюллетеня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "manual recount",
                        "election recount",
                        "request a recount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт повторного подсчета чего-либо, например, голосов на выборах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пересчёт",
                                "target_lang_sense_clarification": "повторный подсчет голосов или предметов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d9c406d-b244-337c-baab-574954ac7b76",
                    "sense_definition": "A spoken or written narration or description of past events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His detailed <w>recount</w> of the accident helped the police understand what had happened.",
                            "target_lang_translations": {
                                "ru": "Его подробный <w>рассказ</w> об аварии помог полиции понять, что произошло."
                            }
                        },
                        {
                            "text": "The book provides a vivid <w>recount</w> of the historical battle from a soldier's perspective.",
                            "target_lang_translations": {
                                "ru": "Книга представляет собой живое <w>описание</w> исторической битвы глазами солдата."
                            }
                        }
                    ],
                    "synonyms": [
                        "account",
                        "narration",
                        "description",
                        "rendering"
                    ],
                    "common_phrases": [
                        "detailed recount",
                        "vivid recount"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устное или письменное описание прошлых событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассказ",
                                "target_lang_sense_clarification": "изложение событий"
                            },
                            {
                                "target_lang_word": "описание",
                                "target_lang_sense_clarification": "детальное изложение фактов"
                            },
                            {
                                "target_lang_word": "пересказ",
                                "target_lang_sense_clarification": "изложение услышанного или случившегося"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}