                    {
                        "sense_id": "090e03b6-0daa-3f0e-894a-81138cabaac4",
                        "entry_id": "7c359ed8-f2f0-3888-80eb-67654656d73e",
                        "glosses": [
                            "betrekking hebbend op de woordenschat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5963976-45d8-4203-a5c4-7ac9d374ff28",
                                "sense_id": "090e03b6-0daa-3f0e-894a-81138cabaac4",
                                "text": "Een lexicaal gat is een woordbetekenis die niet in een bepaalde taal voorkomt. Veel mensen denken dat computer een lexicaal gat is in het Nederlands maar dat is niet zo rekenaar zou een goede vertaling kunnen zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dae076c3-0f84-4631-9b66-603292acc544",
                        "source_entry_id": "7c359ed8-f2f0-3888-80eb-67654656d73e",
                        "source_sense_id": "090e03b6-0daa-3f0e-894a-81138cabaac4",
