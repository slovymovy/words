    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "36b0da8d-d0f2-394f-aba3-165faa35cf9f",
                "word": "Balochistan",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da1ca0f2-6d61-3637-8072-43d04a426eba",
                        "entry_id": "36b0da8d-d0f2-394f-aba3-165faa35cf9f",
                        "glosses": [
                            "A region on the Iranian plateau in south-western Asia, northwest of the Arabian Sea, dominated by desert and mountains, composed of southwestern Pakistan, southeastern Iran and a strip of southwestern Afghanistan; inhabited by the Baloch people."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39d91a77-de08-3554-b314-af4ca791d0ad",
                        "entry_id": "36b0da8d-d0f2-394f-aba3-165faa35cf9f",
                        "glosses": [
                            "A province of Pakistan. Capital: Quetta."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ffb4674-76f8-495c-a7e5-9a76d850d29a",
                        "source_entry_id": "36b0da8d-d0f2-394f-aba3-165faa35cf9f",
                        "source_sense_description": "region on the Iranian plateau in south-western Asia",
                        "target_lang_word": "Baloutchistan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baloutchistan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a371a5-5c8d-394d-bbdc-0779c9220059",
                                        "entry_id": "2af2da72-26e5-3e7c-bac8-ed9015b7a63b",
                                        "glosses": [
                                            "Région asiatique, partagée entre l’Iran à l’ouest, l’Afghanistan au nord, et le Pakistan à l’est."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58406aed-2c5b-3b45-bdac-be7f81d30845",
                                        "entry_id": "2af2da72-26e5-3e7c-bac8-ed9015b7a63b",
                                        "glosses": [
                                            "Province pakistanaise, portion majeure du Baloutchistan se trouvant dans ce pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93187f24-1001-4916-b27b-4df31a6814e8",
                                                "sense_id": "58406aed-2c5b-3b45-bdac-be7f81d30845",
                                                "text": "Les Pachtounes se répartissent entre la province de Khyber Pakhtunkhwa (ancienne Province de la Frontière du Nord-Est), les « Zones tribales », le Baloutchistan et Karachi."
                                            },
                                            {
                                                "example_id": "353e10a2-e2e4-400c-8519-f3eb8154fa7b",
                                                "sense_id": "58406aed-2c5b-3b45-bdac-be7f81d30845",
                                                "text": "Le Baloutchistan est la province la moins peuplée du Pakistan, mais elle est riche en ressources minérales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "459a85a0-822a-4667-978b-4892c3674328",
                        "source_entry_id": "36b0da8d-d0f2-394f-aba3-165faa35cf9f",
                        "source_sense_description": "region on the Iranian plateau in south-western Asia",
                        "target_lang_word": "Belutschistan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belutschistan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f00fbaa-a3c3-3def-a510-cf5ccee86301",
                                        "entry_id": "8141f2c8-ae7d-3dbc-bdea-c23746ddd9f5",
                                        "glosses": [
                                            "geographische Region, die Teile von Afghanistan, Pakistan und dem Iran umfasst, in der die meisten Belutschen angesiedelt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c939976-dcac-4fe3-967c-bf0bc3164aa8",
                                                "sense_id": "1f00fbaa-a3c3-3def-a510-cf5ccee86301",
                                                "text": "Das heutige Belutschistan war damals als Gedrosien bekannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                        "entry_id": "8141f2c8-ae7d-3dbc-bdea-c23746ddd9f5",
                                        "glosses": [
                                            "pakistanische Provinz im Südwesten Pakistans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ece1a5f-9b05-43b0-a16d-00a939972880",
                                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                                "text": "„Während der Westen des Landes (vor allem Belutschistan) durch ein arides Klima geprägt ist, zeichnet sich der übrige Teil durch ein tropisches Klima mit einer Regenzeit in den Sommermonaten und einer Trockenzeit zwischen September und Juni aus.“"
                                            },
                                            {
                                                "example_id": "e13aae6f-f63b-47b8-a364-a2c4dffa8db4",
                                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                                "text": "„Sie ist erst siebzig Jahre alt, aber ein wahrer Künstler hat sie in seinem Hinterhof gemacht und wollte sie als Beutegut aus Belutschistan verkaufen, als die entlaufene Cousine irgendeines minderen Pharaos, die hier gelandet sei.“"
                                            },
                                            {
                                                "example_id": "a935e248-0826-4e56-a4a1-8ee7817e1e85",
                                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                                "text": "„Der Pakistani wechselte das Thema und erzählte dem Amerikaner, dass der ISI neue Belege für indische Zahlungen an die Freiheitsbewegung in Belutschistan habe.“"
                                            },
                                            {
                                                "example_id": "486d1667-0802-46ea-a7b3-0e2da84aeb3a",
                                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                                "text": "„Die meisten Taliban waren eng mit Pakistan verbunden, waren dort aufgewachsen und in Madrassas unterrichtet worden, die der sprunghafte Maulana Fazlur Rehman und seine Jamiat-e-Ulema Islam (JUI) leiteten - eine fundamentalistische Partei, die beträchtlich von den Paschtunen in Belutschistan und der Nordwestprovinz unterstützt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af6cd6bf-e76f-473d-b212-0f4ca3990b3d",
                        "source_entry_id": "36b0da8d-d0f2-394f-aba3-165faa35cf9f",
                        "source_sense_description": "region on the Iranian plateau in south-western Asia",
                        "target_lang_word": "Beludżystan",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beludżystan",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8261e70d-ca2d-3191-8662-cbc36203d4a0",
                                        "entry_id": "56a1f9ad-0d7b-36a5-b322-6543ea1e2a96",
                                        "glosses": [
                                            "kraina historyczna w południowo-zachodniej Azji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05378cb8-1783-4c6e-a5af-827eb7b2d9f8",
                                                "sense_id": "8261e70d-ca2d-3191-8662-cbc36203d4a0",
                                                "text": "Koczownicza ludność Beludżystanu hodowała owce, wielbłądy, kozy i konie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b61a3a59-dc17-3afe-87ed-7118f118b889",
                                        "entry_id": "56a1f9ad-0d7b-36a5-b322-6543ea1e2a96",
                                        "glosses": [
                                            "prowincja w południowo-zachodnim Pakistanie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c77606-e4c3-40aa-bb29-dbe9b23a4741",
                                                "sense_id": "b61a3a59-dc17-3afe-87ed-7118f118b889",
                                                "text": "Komunikacja w Beludżystanie zdaje się być słabo rozwinięta."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
