    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                "word": "contemplative",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "517bf865-6f59-4167-b58b-5dbd533be40c",
                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more contemplative"
                    },
                    {
                        "form_id": "adf33137-eb44-4ed2-b23c-8c9a7451fb46",
                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most contemplative"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fcf16f9-ab09-3131-80c7-f97bc0359696",
                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "glosses": [
                            "Inclined to contemplate; introspective and thoughtful; meditative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef76512-fdcb-4e48-9011-4682e6ade952",
                                "sense_id": "3fcf16f9-ab09-3131-80c7-f97bc0359696",
                                "text": "Compared with the greatest poets, he may be said to be the poet of unpoetical natures, possessed of quiet and contemplative tastes. But unpoetical natures are precisely those which require poetic cultivation. This cultivation Wordsworth is much more fitted to give, than poets who are intrinsically far more poets than he."
                            }
                        ]
                    },
                    {
                        "sense_id": "09578aac-0697-3b4b-a0d6-eaac73c9d337",
                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "glosses": [
                            "Pertaining to a religious contemplative, or a contemplative religious orders, especially the Roman Catholic varieties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeaebed8-cb6e-4b1c-80ee-6e20ae8e86f2",
                                "sense_id": "09578aac-0697-3b4b-a0d6-eaac73c9d337",
                                "text": "Whether the nuns of yore, being of a submissive rather than a stiff-necked generation, habitually bent their contemplative heads to avoid collision with the beams in the low ceilings of the many chambers of their House [...] may be matters of interest to its haunting ghosts (if any), but constitute no item in Miss Twinkleton's half-yearly accounts."
                            }
                        ]
                    },
                    {
                        "sense_id": "b64826fe-8035-3980-97fe-94ecf5be1111",
                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "glosses": [
                            "Relating to, or having the power of, contemplation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3dca54-a16a-4c5f-b878-c854cdd4da4d",
                                "sense_id": "b64826fe-8035-3980-97fe-94ecf5be1111",
                                "text": "contemplative faculties"
                            }
                        ]
                    },
                    {
                        "sense_id": "010ffd1e-a773-3a46-adca-d74e9d33c684",
                        "entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "glosses": [
                            "In a phase of mental activity in which one begins to recognize and acknowledge the maladaptiveness of someone's behavior (such as one's own, or that of a family member or friend); usually with reference to substance use."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cf3b68a-bc8a-458e-91fe-835a93f1b70b",
                        "source_entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "source_sense_description": "inclined to contemplate; introspective and thoughtful; meditative",
                        "target_lang_word": "contemplatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contemplatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                        "entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                                        "glosses": [
                                            "Relatif à la contemplation, à la méditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f016cb-4901-4a0f-9703-c083b76bbf1b",
                                                "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                                "text": "Je vivais à l’écart de la place publique,\nSerein, contemplatif, ténébreux, bucolique..."
                                            },
                                            {
                                                "example_id": "6d28c998-4fb4-49e9-9944-5ccf16650c67",
                                                "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                                "text": "Esprit contemplatif."
                                            },
                                            {
                                                "example_id": "39defe7b-fd61-4a78-a743-49e71c15c03b",
                                                "sense_id": "048fbe5d-8644-3763-bc3d-71bf9e7e081f",
                                                "text": "Une patience divine développée par les mauvais traitements, une concentration continuelle exigée par sa vie contemplative, avaient dépouillé son regard de cette audacieuse fierté qui plaît dans certaines figures, et par laquelle il savait accabler nos Régents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d513eeee-240e-38a3-adab-f4a3a429c8b9",
                                        "entry_id": "ffb41743-f93e-30eb-8c60-3c1baca1a79f",
                                        "glosses": [
                                            "Qualifie une organisation de religieux qui pratiquent la méditation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed6b699f-ae0d-42c9-9da0-0bf86376eb07",
                                                "sense_id": "d513eeee-240e-38a3-adab-f4a3a429c8b9",
                                                "text": "Et quand on pense que le monde se demande à quoi servent les ordres contemplatifs ! s’était écrié Durtal."
                                            },
                                            {
                                                "example_id": "eb08c432-ceff-44d1-bc95-7ad984eedcf3",
                                                "sense_id": "d513eeee-240e-38a3-adab-f4a3a429c8b9",
                                                "text": "Ainsi, Messieurs, les établissements congréganistes de tout genre s’élevaient au chiffre formidable de 20 823. Ce chiffre se décomposait en 16 904 établissements enseignants et 3 919 établissements mixtes, c'est-à-dire enseignants et hospitaliers ou contemplatifs, ou bien purement hospitaliers ou purement contemplatifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contemplatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02023b35-2823-3087-a8b5-049d8c41bb9d",
                                        "entry_id": "249545b1-1e71-3e54-8dde-9ed5ec04d6cf",
                                        "glosses": [
                                            "Celui qui se consacrent à la vie d’oraison et de méditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "075c6981-5589-464d-a2a5-f92a395de7b6",
                                                "sense_id": "02023b35-2823-3087-a8b5-049d8c41bb9d",
                                                "text": "Les extases des contemplatifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26a5273c-e759-4449-9592-6403174d3e2e",
                        "source_entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
                        "source_sense_description": "inclined to contemplate; introspective and thoughtful; meditative",
                        "target_lang_word": "nachdenklich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachdenklich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66782c98-57e9-3376-b59a-ad12225cc95a",
                                        "entry_id": "c17fbbeb-12b1-3b44-85db-0f677ca9bfc1",
                                        "glosses": [
                                            "eigenen Gedanken nachgehend, in Gedanken versunken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855ccb73-9aa8-4731-8d04-5a6a2e862681",
                                                "sense_id": "66782c98-57e9-3376-b59a-ad12225cc95a",
                                                "text": "Auch der nachdenkliche, besonnene Weit-Blick will gelernt sein. Beim Wirtschaftsminister fehlt allerdings der verwegene Drei-Tage-Bart."
                                            },
                                            {
                                                "example_id": "ce2e80bc-d442-41de-b72e-515f1718e255",
                                                "sense_id": "66782c98-57e9-3376-b59a-ad12225cc95a",
                                                "text": "Meine Tochter Katja saß in der Badewanne und machte ein nachdenkliches Gesicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "75443cb5-e4e9-3dcf-916a-15a7b657c606",
                                        "entry_id": "c17fbbeb-12b1-3b44-85db-0f677ca9bfc1",
                                        "glosses": [
                                            "im Wesen zum Nachdenken geneigt, zu Überlegungen neigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb996392-0d37-4b7c-a5ce-da7e73c42fe9",
                                                "sense_id": "75443cb5-e4e9-3dcf-916a-15a7b657c606",
                                                "text": "Keinen schillernden Karrieretypen habe man da erlebt. Eher eine nachdenkliche Persönlichkeit mit „seltener Brillanz“, sagt der heutige Firmenchef Jochen Kienbaum und attestiert Löscher kulturelles Feingefühl."
                                            },
                                            {
                                                "example_id": "e725e36e-38a5-4257-93cd-d6107ce7d9e5",
                                                "sense_id": "75443cb5-e4e9-3dcf-916a-15a7b657c606",
                                                "text": "Das Buch werde zeigen, dass Monroe \"eine wirklich nachdenkliche Person\" gewesen sei, sagte Herausgeberin Courtney Hodell."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2e7e4b11-b4d3-33a4-a991-1007c0e7801d",
                                        "entry_id": "c17fbbeb-12b1-3b44-85db-0f677ca9bfc1",
                                        "glosses": [
                                            "zum Nachdenken anregend/anreizend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8662622c-be28-423e-8088-f0c735e53d96",
                                                "sense_id": "2e7e4b11-b4d3-33a4-a991-1007c0e7801d",
                                                "text": "Dass die Salzburger Regierungsparteien insgesamt fast ein Viertel ihrer Wähler verloren hätten, stimmt Haslauer \"nachdenklich.\""
                                            },
                                            {
                                                "example_id": "39115be6-8026-4588-9667-7e924d5b108b",
                                                "sense_id": "2e7e4b11-b4d3-33a4-a991-1007c0e7801d",
                                                "text": "Wie viel Respekt bringt eine Gesellschaft der nächsten Generation entgegen? Diese Frage sollte nicht nur Politiker, sondern auch Eltern und Pädagogen nachdenklich machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b509c98f-246b-45f1-ba19-5e0470bda935",
                        "source_entry_id": "42534f23-75b3-329c-9904-87015caed3c1",
