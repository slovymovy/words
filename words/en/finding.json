{
    "word_family": [
        "find",
        "finder",
        "found"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "987023b5-cde6-344a-847c-1da79590e5a7",
                    "sense_definition": "The present participle and gerund of <w>find</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>finding</w> it difficult to concentrate with all this noise.",
                            "target_lang_translations": {
                                "ru": "Мне <w>становится</w> трудно сосредоточиться из-за всего этого шума."
                            }
                        },
                        {
                            "text": "<w>Finding</w> a solution to this problem will take some time.",
                            "target_lang_translations": {
                                "ru": "<w>Поиск</w> решения этой проблемы займет некоторое время."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола find (находить)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нахождение",
                                "target_lang_sense_clarification": "процесс поиска или обнаружения"
                            },
                            {
                                "target_lang_word": "поиск",
                                "target_lang_sense_clarification": "процесс обнаружения чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c1af29c-7d2f-3bec-92fa-b6750acfe839",
                    "sense_definition": "The act of discovering something by chance",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>finding</w> of the ancient coins was a lucky accident.",
                            "target_lang_translations": {
                                "ru": "<w>Находка</w> древних монет была счастливой случайностью."
                            }
                        },
                        {
                            "text": "A lucky <w>finding</w> in the attic changed their lives forever.",
                            "target_lang_translations": {
                                "ru": "Удачная <w>находка</w> на чердаке навсегда изменила их жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "serendipity"
                    ],
                    "common_phrases": [
                        "lucky finding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт случайного обнаружения чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "находка",
                                "target_lang_sense_clarification": "случайно обнаруженная вещь"
                            },
                            {
                                "target_lang_word": "обнаружение",
                                "target_lang_sense_clarification": "факт нахождения чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87dcc8af-1d5c-3bdc-94f3-a2a01215f1e4",
                    "sense_definition": "A result of research or an investigation",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The latest research <w>finding</w> suggests that the climate is changing faster than expected.",
                            "target_lang_translations": {
                                "ru": "Последний <w>результат</w> исследования указывает на то, что климат меняется быстрее, чем ожидалось."
                            }
                        },
                        {
                            "text": "The scientist presented a significant <w>finding</w> during the conference.",
                            "target_lang_translations": {
                                "ru": "Ученый представил важное <w>открытие</w> во время конференции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "research finding",
                        "key finding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Результат исследования или расследования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "результат",
                                "target_lang_sense_clarification": "итог исследования"
                            },
                            {
                                "target_lang_word": "вывод",
                                "target_lang_sense_clarification": "заключение на основе данных"
                            },
                            {
                                "target_lang_word": "данные",
                                "target_lang_sense_clarification": "полученные сведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99d79498-0995-3d2d-bc43-05953ea5dba0",
                    "sense_definition": "A formal conclusion by a judge, jury, or regulatory agency on issues of fact",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury reached a <w>finding</w> of fact after three days of deliberation.",
                            "target_lang_translations": {
                                "ru": "Присяжные пришли к <w>заключению</w> по фактам дела после трех дней обсуждения."
                            }
                        },
                        {
                            "text": "The court issued a formal <w>finding</w> regarding the company's liability.",
                            "target_lang_translations": {
                                "ru": "Суд вынес официальное <w>решение</w> относительно ответственности компании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "finding of fact",
                        "legal finding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заключение судьи, присяжных или регулирующего органа по вопросам факта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "судебное постановление"
                            },
                            {
                                "target_lang_word": "заключение",
                                "target_lang_sense_clarification": "официальный вывод суда"
                            },
                            {
                                "target_lang_word": "вердикт",
                                "target_lang_sense_clarification": "решение присяжных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4123e8f-43f6-36d4-a75e-79b029c736cf",
                    "sense_definition": "A self-contained component of assembled jewellery such as a clasp or bead",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a silver <w>finding</w> to repair her favorite necklace.",
                            "target_lang_translations": {
                                "ru": "Она купила серебряную <w>фурнитуру</w>, чтобы починить свое любимое ожерелье."
                            }
                        },
                        {
                            "text": "The jeweler specializes in high-quality jewelry <w>findings</w> and tools.",
                            "target_lang_translations": {
                                "ru": "Ювелир специализируется на высококачественной ювелирной <w>фурнитуре</w> и инструментах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jewelry finding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автономный компонент собранного ювелирного изделия, такой как застежка или бусина"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фурнитура",
                                "target_lang_sense_clarification": "вспомогательные детали украшений"
                            },
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "составная часть изделия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68b0d619-2026-36cc-9d19-16d157cc4fa7",
                    "sense_definition": "Tools or materials used in shoe making or repair",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cobbler ordered new leather <w>findings</w> for the boot repairs.",
                            "target_lang_translations": {
                                "ru": "Сапожник заказал новые кожаные <w>материалы</w> для ремонта ботинок."
                            }
                        },
                        {
                            "text": "He visited the warehouse to purchase shoe <w>findings</w> and pegs.",
                            "target_lang_translations": {
                                "ru": "Он посетил склад, чтобы купить обувную <w>фурнитуру</w> и колышки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoe findings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструменты или материалы, используемые при изготовлении или ремонте обуви"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обувные материалы",
                                "target_lang_sense_clarification": "детали для ремонта обуви"
                            },
                            {
                                "target_lang_word": "фурнитура",
                                "target_lang_sense_clarification": "вспомогательные материалы для обуви"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}