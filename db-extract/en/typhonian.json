                "senses": [
                    {
                        "sense_id": "5ebd6ba5-4861-3388-ae0c-d1760898f66b",
                        "entry_id": "7f2cbc6e-37fd-3edd-8b88-968cb7418f36",
                        "glosses": [
                            "Of or relating to Typhon or, by interpretatio graeca, his Egyptian equivalent Set."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e9814b3-3a46-4ddc-bd1b-512092d598d3",
                                "sense_id": "5ebd6ba5-4861-3388-ae0c-d1760898f66b",
                                "text": "This colour, he remarks, was rare among the Egyptians, though very common among foreigners, and these Typhonian men were sacrificed by the ancient kings at the tomb of Osiris."
                            },
                            {
                                "example_id": "f15b713d-82c1-4380-a2bf-a7c3bfd9bec8",
                                "sense_id": "5ebd6ba5-4861-3388-ae0c-d1760898f66b",
                                "text": "The gods were time-keepers; the first time observed and registered was Sut-Typhonian, and the writer maintains that the Typhonian religion and types are the oldest extant, whether in Egypt or out of it."
                            },
                            {
                                "example_id": "1d367ff2-42ac-4701-a321-2617bf85769c",
                                "sense_id": "5ebd6ba5-4861-3388-ae0c-d1760898f66b",
                                "text": "Set is represented as having the features of a fantastic beast with a thin, curved snout, straight, square-cut ears and a stiff forked tail. This creature cannot with certainty be identified and is commonly called the ‘Typhonian animal’."
                            },
                            {
                                "example_id": "a70fb286-6431-49f9-b4ee-2493e2e35abd",
                                "sense_id": "5ebd6ba5-4861-3388-ae0c-d1760898f66b",
                                "text": "[Typhon continues to address Zeus.] […] May the Typhonian bear spread wide the great gape of its shaggy jaws and harry the Olympian Bear."
                            }
                        ]
                    }
                ],
