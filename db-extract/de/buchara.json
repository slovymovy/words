                            {
                                "example_id": "738059a9-7e85-4a59-8b89-38db45a4e97b",
                                "sense_id": "de2ef651-609e-314c-8a4d-63fe81be2ce5",
                                "text": "„O ja, auch dafür gibt's Belege – Briefwechsel mit verbündeten Gruppierungen in Baku, Taschkent und Buchara.“"
                            },
                            {
                                "example_id": "be07b241-a64a-4b6e-a902-f950f01f9807",
                                "sense_id": "de2ef651-609e-314c-8a4d-63fe81be2ce5",
                                "text": "„Um 1780 schlossen die Durrani ein Abkommen mit dem Amir von Buchara, dem wichtigsten Herrscher Zentralasiens, der den Oxus- (auch: Amu-Darya-)Fluss als Grenze zwischen Zentralasien und dem neuen Paschtunenstaat Afghanistan festlegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
