    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c49ef87c-ef82-3313-ac6f-3da80d9a83f2",
                    "sense_definition": "Of a green hue.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is wearing a <w>green</w> shirt.",
                            "target_lang_translations": {
                                "ru": "На нём <w>зелёная</w> рубашка."
                            }
                        },
                        {
                            "text": "The former flag of Libya is fully <w>green</w>.",
                            "target_lang_translations": {
                                "ru": "Прежний флаг Ливии был полностью <w>зелёным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdant",
                        "vert",
                        "greenish"
                    ],
                    "antonyms": [
                        "nongreen",
                        "ungreen"
                    ],
                    "common_phrases": [
                        "bright green",
                        "dark green",
                        "green leaves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зелёного цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2b1827d-c94e-3d4f-a6d2-0d77814f2f18",
                    "sense_definition": "Environmentally friendly.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "environment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to invest more in <w>green</w> energy to save the planet.",
                            "target_lang_translations": {
                                "ru": "Нам нужно больше инвестировать в <w>экологически чистую</w> энергию, чтобы спасти планету."
                            }
                        },
                        {
                            "text": "The company is trying to adopt more <w>green</w> practices.",
                            "target_lang_translations": {
                                "ru": "Компания старается внедрять больше <w>экологичных</w> методов работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "eco-friendly",
                        "environmentally friendly",
                        "ecological"
                    ],
                    "antonyms": [
                        "antigreen"
                    ],
                    "common_phrases": [
                        "green energy",
                        "green technology",
                        "green investment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Экологически чистый, не наносящий вреда окружающей среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "экологический"
                            },
                            {
                                "target_lang_word": "экологичный",
                                "target_lang_sense_clarification": "безопасный для природы"
                            },
                            {
                                "target_lang_word": "экологически чистый",
                                "target_lang_sense_clarification": "о технологиях или продуктах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82c0e625-99c8-351e-9bf7-e201bd2381b9",
                    "sense_definition": "Overcome with envy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>green</w> with envy when he saw my new car.",
                            "target_lang_translations": {
                                "ru": "Он <w>позеленел</w> от зависти, когда увидел мою новую машину."
                            }
                        },
                        {
                            "text": "She looked <w>green</w> with envy at her sister's success.",
                            "target_lang_translations": {
                                "ru": "Она выглядела <w>позеленевшей</w> от зависти к успеху своей сестры."
                            }
                        }
                    ],
                    "synonyms": [
                        "envious"
                    ],
                    "common_phrases": [
                        "green with envy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охваченный сильной завистью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позеленевший",
                                "target_lang_sense_clarification": "от зависти"
                            },
                            {
                                "target_lang_word": "завистливый",
                                "target_lang_sense_clarification": "испытывающий зависть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea8767a2-8e70-37f9-a866-8e3d2ff14827",
                    "sense_definition": "Inexperienced.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "John is kind of <w>green</w>, so take it easy on him this first week.",
                            "target_lang_translations": {
                                "ru": "Джон ещё довольно <w>зелёный</w>, так что не будь с ним слишком строг в эту первую неделю."
                            }
                        },
                        {
                            "text": "The new recruits are still very <w>green</w> and need more training.",
                            "target_lang_translations": {
                                "ru": "Новобранцы ещё совсем <w>неопытные</w> и нуждаются в дополнительном обучении."
                            }
                        }
                    ],
                    "synonyms": [
                        "inexperienced",
                        "callow",
                        "raw"
                    ],
                    "common_phrases": [
                        "green recruit",
                        "green horn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопытный, начинающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "перен., о человеке"
                            },
                            {
                                "target_lang_word": "неопытный",
                                "target_lang_sense_clarification": "не имеющий навыков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84705a07-2df9-3d5a-bcb9-7e9b31c1f4bd",
                    "sense_definition": "Unripe, said of certain fruits that change color when they ripen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't eat those bananas yet; they are still <w>green</w>.",
                            "target_lang_translations": {
                                "ru": "Не ешь пока эти бананы, они ещё <w>зелёные</w>."
                            }
                        },
                        {
                            "text": "The <w>green</w> apples were too sour to eat.",
                            "target_lang_translations": {
                                "ru": "<w>Неспелые</w> яблоки были слишком кислыми, чтобы их есть."
                            }
                        }
                    ],
                    "antonyms": [
                        "ripe"
                    ],
                    "common_phrases": [
                        "green fruit",
                        "green banana"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспелый, недозрелый (о фруктах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелёный",
                                "target_lang_sense_clarification": "неспелый"
                            },
                            {
                                "target_lang_word": "неспелый",
                                "target_lang_sense_clarification": "о плодах"
                            },
                            {
                                "target_lang_word": "незрелый",
                                "target_lang_sense_clarification": "недозревший"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10504a54-075e-3a8c-8fff-baaf1d486b5a",
                    "sense_definition": "Sickly, unwell.",
