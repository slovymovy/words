                                                "sense_id": "74728f1f-ba1c-38d6-bff7-8f6ba4220e4b",
                                                "text": "Der Kern dieses Kometen ist in der hellen Koma kaum zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c83d960-e6a3-34c2-821e-2c12a74fe25f",
                                        "entry_id": "2d927c5c-3a05-3401-a6e9-546e626661df",
                                        "glosses": [
                                            "ein Abbildungsfehler"
                                        ],
