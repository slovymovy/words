        "fr-extract.jsonl": [
            {
                "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                "word": "volcanique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9e572e6a-2fca-4c09-97d1-bde1856edd62",
                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "volcaniques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                        "glosses": [
                            "Relatif aux volcans et à leur activité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e29e13-d8ea-4588-b757-8c693dccad91",
                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                "text": "Mais, je vous l'avoue, la composition volcanique de ce sol m'inquiète."
                            },
                            {
                                "example_id": "83f93909-e6bd-4956-9ebf-5f711bc3622e",
                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                "text": "Les îles Féroë sont entièrement d'origine volcanique : elles ont surgi de toutes pièces du sein d’Amphitrite et sont, comme l’Islande, constituées de trapp de formation sous-marine."
                            },
                            {
                                "example_id": "fc180e8b-c0b2-42cf-8a3f-ba570a4eee2c",
                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                "text": "Les pentes vertes du mont San Giachinno, au Sud [sic] de l’île, contrastaient étrangement avec la partie Nord [sic], hérissée de petits cônes volcaniques et presque entièrement dépourvue de végétation."
                            },
                            {
                                "example_id": "67261d11-4b25-4aff-9693-7c309a235fa5",
                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                "text": "Au Maroc Nord oriental, les gisements de bentonites sont, en grande partie, liés au complexe volcanique de Gourougou."
                            }
                        ]
                    },
                    {
                        "sense_id": "a07caac5-29b0-352e-9eb4-6017cd55ea25",
                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                        "glosses": [
                            "Qui est creusé de cratères."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "89824398-6abf-4684-8dfd-31e83b27da16",
                                "sense_id": "a07caac5-29b0-352e-9eb4-6017cd55ea25",
                                "text": "Là-dessus notre équipe eut mission d'aller à Souain […]. Une demi-heure après nous étions sur le terrain volcanique et comme lunaire tant de fois décrit, et réellement indes­criptible. Des coups de pouce d'un sculpteur gigantesque dans la glaise séchée, ou bien cet aspect des nids de guêpes, gris et feuilletés."
                            }
                        ]
                    },
                    {
                        "sense_id": "849a2e53-d76e-3cb0-b7cc-8acc57cdcbf8",
                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                        "glosses": [
                            "Qui est ardent, Impétueux, qui est toujours en fermentation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6f255c92-6bab-4f15-bb6a-5f6f810144f4",
                                "sense_id": "849a2e53-d76e-3cb0-b7cc-8acc57cdcbf8",
                                "text": "Une imagination volcanique."
                            }
                        ]
                    },
                    {
                        "sense_id": "28cd93bc-5958-3ea7-9f5c-880826267f72",
                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                        "glosses": [
                            "Qui a un caractère impulsif, explosif."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b3389854-92b3-4c62-9f8f-9b2c69c1b9de",
                                "sense_id": "28cd93bc-5958-3ea7-9f5c-880826267f72",
                                "text": "Le copain de Jalibert ne sort pas de sa meilleure saison de sa carrière, après son passage mouvementé de l’UBB au Racing 92, sur fond de brouille avec le volcanique Christophe Urios."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df511596-02d3-4fe7-b952-11933dae9590",
                        "source_entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                        "source_sense_description": "(Géologie) Relatif aux volcans et à leur activité",
                        "target_lang_word": "vulkanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulkanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                        "entry_id": "f7b0fc17-ce0c-3dcf-8aed-c4b1ef556024",
                                        "glosses": [
                                            "auf Vulkanismus beruhend, von Vulkanen gebildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7858ba-09b2-459e-a6d0-c9fede7df89b",
                                                "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                                "text": "Weder Streiks noch die Terroranschläge des 11. September bewirkten, was vulkanischem Feinstaub in der Stratosphäre gelang: Europa erlebt einen flugzeuglosen Himmel."
                                            },
                                            {
                                                "example_id": "c94f7292-5b45-4bbb-be79-bad4861f6b6f",
                                                "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                                "text": "Kommt man gegen Vicenza, so steigen wieder Hügel von Norden nach Süden auf, sie sind vulkanisch, sagt man, und schließen die Ebene."
                                            },
                                            {
                                                "example_id": "9fca3277-6fb3-454a-8a9a-38b08de51618",
                                                "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                                "text": "„Weiterhin gehört zum Nimbus der vulkanische Ursprung des Berges; er unterstreicht die bereits aus der geographischen Lage resultierende Synthese der Elemente Feuer und Eis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19211025-f1aa-32a6-ab83-0e07211e1158",
                                        "entry_id": "f7b0fc17-ce0c-3dcf-8aed-c4b1ef556024",
                                        "glosses": [
                                            "zu Gefühlsausbrüchen neigend, aufbrausend, leidenschaftlich bewegt"
                                        ],
                                        "tags": [
                                            "figurativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768ad8e5-f954-421d-9342-f4a8f93c89a5",
                                                "sense_id": "19211025-f1aa-32a6-ab83-0e07211e1158",
                                                "text": "Ein Höchstgenuss fürs Auge, ein Triumph der Malkunst: Gelbgraue Gesichter, rosafarbene Schatten, Gewänder, die aus flüssiger Lava zu sein scheinen, derart vulkanisch vibrierend ist die Malerei El Grecos."
                                            },
                                            {
                                                "example_id": "2e39ff22-7a93-4331-a8e0-609b3a48d654",
                                                "sense_id": "19211025-f1aa-32a6-ab83-0e07211e1158",
                                                "text": "Das sammelt eine Wolke von Melancholie auf ihrer Stirne: denn dass das Scheinen Nothwendigkeit ist, hassen solche Naturen mehr als den Tod; und eine solche andauernde Erbitterung darüber macht sie vulkanisch und bedrohlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
