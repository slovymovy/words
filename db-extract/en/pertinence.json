                    },
                    {
                        "translation_id": "45b7ddba-45c1-46c2-8d7c-534883497e14",
                        "source_entry_id": "a7de38f1-c522-3035-8484-3c060ad62e01",
                        "source_sense_id": "356c1ed5-9177-3304-9c4d-0dae5b0018ec",
