                    {
                        "sense_id": "6982623f-88f3-3115-a057-48f79e7286db",
                        "entry_id": "706d2ade-7d21-3a05-8f4c-d077becfe7f0",
                        "glosses": [
                            "Interjektion, die einen Sprung, einen Hüpfer beschreibt oder zu einem Sprung auffordert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee76ad6-8325-4d24-a279-c1747d27fb6f",
                                "sense_id": "6982623f-88f3-3115-a057-48f79e7286db",
                                "text": "Dann sind wir, hops, über den Graben gesprungen."
                            },
                            {
                                "example_id": "55ccc33d-2b76-42a1-b66f-c39a85310731",
                                "sense_id": "6982623f-88f3-3115-a057-48f79e7286db",
                                "text": "Nun trau dich schon! Und hops!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec31892e-0fa7-4af7-af26-384099f537a3",
                        "source_entry_id": "706d2ade-7d21-3a05-8f4c-d077becfe7f0",
                        "source_sense_id": "6982623f-88f3-3115-a057-48f79e7286db",
                        "source_sense_description": "Interjektion, die einen Sprung, einen Hüpfer beschreibt oder zu einem Sprung auffordert",
                        "target_lang_word": "hop",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hop",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a443ae7-ca32-30bd-b638-1a00851bcd52",
                                        "entry_id": "f2fded6c-a646-3d88-b2a2-3822052610bb",
                                        "glosses": [
                                            "Appel pour faire sauter un enfant, un animal ^([1])."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90913977-4ad1-3e51-a15f-1b099ecdd1c2",
                                        "entry_id": "f2fded6c-a646-3d88-b2a2-3822052610bb",
                                        "glosses": [
                                            "Accompagne un saut, un mouvement rapide, un ordre immédiat, un enchaînement rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af9e5b99-07f1-414c-b7e9-005081d990ae",
                                                "sense_id": "90913977-4ad1-3e51-a15f-1b099ecdd1c2",
                                                "text": "Il lie connaissance avec le premier voyageur venu, joue aux cartes, et hop ! Le voilà plumé."
                                            },
                                            {
                                                "example_id": "14b9be38-69ed-46a3-9985-9f7637b78066",
                                                "sense_id": "90913977-4ad1-3e51-a15f-1b099ecdd1c2",
                                                "text": "Aime-t-on la purée toute faite, et pourquoi ? Parce qu’elle est légère ? Parce qu’elle est onctueuse ? Parce qu’elle est si facile à faire : un geste et hop ?"
                                            },
                                            {
                                                "example_id": "c24c1233-dec5-4087-9b5a-baca2a7058b5",
                                                "sense_id": "90913977-4ad1-3e51-a15f-1b099ecdd1c2",
                                                "text": "Et il repartait instantanément vers nous, bras tendus, comme supportant une lourde charge, et les deux genoux qui s'élevaient en rythme de part et d'autre : hop, hop, hop, hop, hop !…"
                                            },
                                            {
                                                "example_id": "3ac7c82f-f82b-47e7-82b0-fad8f8a7047e",
                                                "sense_id": "90913977-4ad1-3e51-a15f-1b099ecdd1c2",
                                                "text": "Alors, hop, un coup de baguette magique et la mer est transformée en montagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
