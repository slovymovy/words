                        "translation_id": "55a58c82-73c8-4a8e-9450-1439af398c5d",
                        "source_entry_id": "f7203d7a-89cf-372a-b4f5-9474c830bd19",
                        "source_sense_id": "299f9534-6441-3a25-93e9-b6c386300b8d",
                        "target_lang_word": "блат",
