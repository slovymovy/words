                "senses": [
                    {
                        "sense_id": "94c6cb16-735f-3312-b840-f92d585ef037",
                        "entry_id": "94fdf717-d202-3ad2-b662-6a53a7366e38",
                        "glosses": [
                            "To promote to the status of lady."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42c5a52-52f4-429e-ad7d-bc2c2b5b8e53",
                                "sense_id": "94c6cb16-735f-3312-b840-f92d585ef037",
                                "text": "We see those begraced and beladied in the Queen's name whom the Prophet doomed to be fried in the fire of the King of Babylon."
                            },
                            {
                                "example_id": "44d45ca2-1367-4238-86d5-fb692365d90c",
                                "sense_id": "94c6cb16-735f-3312-b840-f92d585ef037",
                                "text": "So they beladied me I was red hot with shame. But yesterday They did disdain only to bend their eyes Upon so low a girl."
                            },
                            {
                                "example_id": "82621f64-b483-423c-b7ef-c42e92b4112c",
                                "sense_id": "94c6cb16-735f-3312-b840-f92d585ef037",
                                "text": "Never was I beladied so before. Would evidence of having been called lady More than so many times make me a lady In common law, I wonder."
                            }
                        ]
                    }
                ],
