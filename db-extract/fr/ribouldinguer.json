                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9acfe99c-76ac-3312-b882-01a40901e03b",
                                        "entry_id": "a5bccf0e-d741-3e8b-a5e3-b13ebfd933e5",
                                        "glosses": [
