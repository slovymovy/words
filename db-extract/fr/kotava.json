                "senses": [
                    {
                        "sense_id": "e754fba5-e747-369b-a1cc-33c8c89fd80d",
                        "entry_id": "e163e8d8-5166-3db6-8b01-ea6d6117d951",
                        "glosses": [
                            "Langue construite, créée par Staren Fetcey en 1978."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad5073b-0c98-4f7a-8b1a-1154aedafa42",
                                "sense_id": "e754fba5-e747-369b-a1cc-33c8c89fd80d",
                                "text": "Le kotava est une langue artificielle a priori, avec une grammaire totalement régulière et un lexique sans aucun lien avec les langues naturelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
