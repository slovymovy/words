                "senses": [
                    {
                        "sense_id": "98e5b9e5-28d6-326f-998f-e41d2f7da183",
                        "entry_id": "a78215aa-fa86-3533-953f-c99d44f91939",
                        "glosses": [
                            "Messager, sorte d’appareil qui émet un bip pour appeler un correspondant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d5b3fa-393c-4f03-9d03-241de37c345f",
                                "sense_id": "98e5b9e5-28d6-326f-998f-e41d2f7da183",
                                "text": "Si votre profession nécessite l’usage permanent d’un beeper, il est important de renoncer périodiquement à utiliser votre appareil."
                            },
                            {
                                "example_id": "737a67a2-11b0-40e5-8b68-9d3c0b68a27c",
                                "sense_id": "98e5b9e5-28d6-326f-998f-e41d2f7da183",
                                "text": "Ils ont mesuré l’ampleur de la variation de l’humeur au cours d’une journée en faisant porter aux sujets un beeper et en enregistrant l’intensité de leurs sentiments quand ils étaient appelés par l’intermédiaire de ce beeper."
                            },
                            {
                                "example_id": "9d313b6d-5387-4f8e-974c-9db1d679f7d9",
                                "sense_id": "98e5b9e5-28d6-326f-998f-e41d2f7da183",
                                "text": "Quelle valeur ajoutée a un beeper versus un téléphone ?"
                            }
                        ]
                    },
