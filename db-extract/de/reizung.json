                        ],
                        "form": "die Reizungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38ffaa42-f85e-31e6-8def-bb5bd9d13fd6",
                        "entry_id": "2e720b60-cf01-323b-a710-9f39204affcf",
                        "glosses": [
                            "Ausübung von Sinneseindrücken auf einen Körper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5991deaf-fe38-4b86-9c19-0b40c6d4afb5",
                                "sense_id": "38ffaa42-f85e-31e6-8def-bb5bd9d13fd6",
                                "text": "„Die französische Studie reiht sich in eine Anzahl von Untersuchungen, die Wachkoma-Patienten mittels Reizung verschiedener Nerven einen winzigen Schritt weit ins Leben zurückholen sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff910f2e-e329-3179-b7f3-400aea2e951b",
                        "entry_id": "2e720b60-cf01-323b-a710-9f39204affcf",
                        "glosses": [
                            "Reaktion eines Körpers auf [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72beb942-dd0b-4a49-ad5c-247316130635",
                                "sense_id": "ff910f2e-e329-3179-b7f3-400aea2e951b",
                                "text": "„Der Nationalspieler laboriert an einer Reizung der linken Patellasehne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d7884ec5-3eba-356a-bcfd-2496b4a9298d",
                        "entry_id": "2e720b60-cf01-323b-a710-9f39204affcf",
                        "glosses": [
                            "anziehend wirkendes äußeres Erscheinungsbild"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "3c6b5ebc-c6dc-4377-a179-6ca3fe1b039b",
                                "sense_id": "d7884ec5-3eba-356a-bcfd-2496b4a9298d",
                                "text": "„Kann, liebe Schwester, eine größere Unlust für uns seyn, als daß wir sehen müssen, wie jedermann unsere Reitzungen verachtet, und wie die glückselige Psyche hochmüthig den Vortheil geniesset, daß eine Menge Liebhaber ihr nachlaufen?“"
                            },
                            {
                                "example_id": "b2045e2c-2c2a-468e-bc98-18cf7f45d074",
                                "sense_id": "d7884ec5-3eba-356a-bcfd-2496b4a9298d",
                                "text": "„Wäre den Reisenden zu glauben, so treiben die Männer mit den Reizungen ihrer Frauen und die Mütter mit denen ihrer Töchter Handel.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
