                    {
                        "translation_id": "66b61492-8e3c-4aae-b06d-e940b8871134",
                        "source_entry_id": "72c7c2db-d9e4-353d-b687-1868c98c2551",
                        "source_sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
