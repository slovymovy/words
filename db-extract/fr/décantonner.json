                ],
                "senses": [
                    {
                        "sense_id": "e4ce14f3-3de1-319d-b2fd-b79c88aae525",
                        "entry_id": "21776a6a-ce85-3c53-a01b-d7b8342a0a79",
                        "glosses": [
                            "Changer de lieu de vie, déménager (pour des animaux)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77f44e9c-bcfc-4d32-a309-da60b1565246",
                                "sense_id": "e4ce14f3-3de1-319d-b2fd-b79c88aae525",
                                "text": "La compagnie se décantonne, les jeunes laies errent sans but précis à travers la campagne, provoquant d'importants dégâts dans les cultures et devenant surtout très vulnérables."
                            },
                            {
                                "example_id": "7e1125c8-cc05-4e1f-b79a-345442b11752",
                                "sense_id": "e4ce14f3-3de1-319d-b2fd-b79c88aae525",
                                "text": "Certains jeunes peuvent se décantonner de plusieurs kilomètres en périodes d'émancipation, en début d'automne et en fin d'hiver."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ec86bf8-301d-37f5-8992-d85b62f69fd6",
                        "entry_id": "21776a6a-ce85-3c53-a01b-d7b8342a0a79",
                        "glosses": [
                            "Faire quitter leur territoire habituel de vie à des animaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4296e6b2-6ec8-4641-a284-9026a4bb687f",
                                "sense_id": "8ec86bf8-301d-37f5-8992-d85b62f69fd6",
                                "text": "Le tout est de mettre les sangliers sur pied sans les décantonner et déranger tout le territoire."
                            },
                            {
                                "example_id": "0e0004b3-982a-43a4-bd66-079c4c732aa3",
                                "sense_id": "8ec86bf8-301d-37f5-8992-d85b62f69fd6",
                                "text": "« À la fin de chaque période de chasse, en janvier-février, des compagnies entière de sangliers viennent y trouver refuge », raconte-t-il. Seule solution, « tenter de les décantonner » (les déloger) en détruisant les fourrés."
                            }
                        ]
                    }
                ],
