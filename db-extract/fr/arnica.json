        "fr-extract.jsonl": [
            {
                "entry_id": "41d86771-0fca-37d2-98d7-00163a4b9826",
                "word": "arnica",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "11119a1c-99b8-4fe7-bd8d-aa189bc46eeb",
                        "entry_id": "41d86771-0fca-37d2-98d7-00163a4b9826",
                        "tags": [
                            "plural"
                        ],
                        "form": "arnicas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14f56f50-aed7-3cd0-967e-3328016875c8",
                        "entry_id": "41d86771-0fca-37d2-98d7-00163a4b9826",
                        "glosses": [
                            "Genre de plantes de la famille des composées, à propriétés toniques et stimulantes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da48e29f-d756-4e5c-b933-b97aa6453c0f",
                                "sense_id": "14f56f50-aed7-3cd0-967e-3328016875c8",
                                "text": "Elle le força à se coucher de suite, alla chercher une fiole d’arnica et le pansa, comme s’il se fût agi d’un enfant au berceau."
                            },
                            {
                                "example_id": "443c484e-efcf-44e2-bc76-75f7898b56e2",
                                "sense_id": "14f56f50-aed7-3cd0-967e-3328016875c8",
                                "text": "Elle est obtenue en faisant macérer des fleurs d’arnica, bien connues pour leur action anti-œdème, dans une huile végétale neutre (souvent de tournesol)."
                            },
                            {
                                "example_id": "e11e1b4f-3bac-4cc4-8fb7-9ce5ccfc2e6e",
                                "sense_id": "14f56f50-aed7-3cd0-967e-3328016875c8",
                                "text": "— Il m’effraie, notre pauvre ami. Monsieur Mouche, veuillez ouvrir la fenêtre. Il me semble qu’une compresse d’arnica lui ferait du bien."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecbe7dbe-f510-35ea-a1ce-4ffa8b342e9e",
                        "entry_id": "41d86771-0fca-37d2-98d7-00163a4b9826",
                        "glosses": [
                            "L’arnica des montagnes (espèce de plantes)."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3150150f-6008-4730-b649-d37ef1a7d13d",
                                "sense_id": "ecbe7dbe-f510-35ea-a1ce-4ffa8b342e9e",
                                "text": "À l’époque de ces publications perpétuelles de bilan entre les deux femmes, nous allions à quelques-uns, très souvent, fumer des pipes dans les arnicas de ce flanc de coteau."
                            },
                            {
                                "example_id": "4543bd87-4839-4259-9e5f-7b934123ccc8",
                                "sense_id": "ecbe7dbe-f510-35ea-a1ce-4ffa8b342e9e",
                                "text": "L’arnica (Arnica montana L., famille des Astéracées ou Composées) est une plante vivace qui pousse dans les prairies et les forêts des montagnes de l’Europe centrale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8ba71c9-266a-4901-99bf-36d3d58540bb",
                        "source_entry_id": "41d86771-0fca-37d2-98d7-00163a4b9826",
                        "target_lang_word": "Arnika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arnika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d314abe7-a71e-3b09-b77d-64e054c650fd",
                                        "entry_id": "e71d8a20-da1f-3ded-a589-79e893cc3fcd",
                                        "glosses": [
                                            "Vertreter der Gattung Arnica, die zu der Familie der Korbblütengewächse zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9360d98-214e-4e43-b0c6-1c7fd886e965",
                                                "sense_id": "d314abe7-a71e-3b09-b77d-64e054c650fd",
                                                "text": "Arnikas sind circumboreal verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9076f3d6-02fa-379f-ab44-b3b011b897fc",
                                        "entry_id": "e71d8a20-da1f-3ded-a589-79e893cc3fcd",
                                        "glosses": [
                                            "unter Naturschutz stehende Pflanze, die zur Gattung Arnika^([1]) zählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54a513c-1021-4b1a-990b-989ba9fa4db8",
                                                "sense_id": "9076f3d6-02fa-379f-ab44-b3b011b897fc",
                                                "text": "Die Arnika wurde früher bei vielen Leiden als Heilmittel eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0cdf3a87-000e-37b3-94bc-bc2e14506018",
                                        "entry_id": "e71d8a20-da1f-3ded-a589-79e893cc3fcd",
                                        "glosses": [
                                            "Extrakt aus den Blüten und Wurzeln der Arnika^([2])"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e9ee828-6628-4f2f-bef9-6d9d6f683179",
                                                "sense_id": "0cdf3a87-000e-37b3-94bc-bc2e14506018",
                                                "text": "Arnika wirkt schmerzlindernd und entzündungshemmend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
