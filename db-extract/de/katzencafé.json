                                "target_senses": [
                                    {
                                        "sense_id": "45f777f2-2b3e-3b2c-8d6f-c7486682b2ce",
                                        "entry_id": "e07d9898-d2a4-3996-ad66-02905c05c789",
                                        "glosses": [
                                            "A café that has domestic cats with which the clientele can interact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54386b22-43ae-40d7-90df-3f4c8732c109",
                                                "sense_id": "45f777f2-2b3e-3b2c-8d6f-c7486682b2ce",
                                                "text": "Taiwan opened the world’s first cat cafe in 1998 and Japan followed suit in 2004. Since then, the number of animal cafes has proliferated in Japan, where many people live in apartment buildings that forbid pets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e3bbbfb-7b22-47b6-abcb-70af210347ed",
                        "source_entry_id": "69e27d01-1f36-3523-9fa0-c6a9d0ad5a13",
                        "source_sense_id": "a96fd9a0-6e4a-3be3-b697-f3b3308ea797",
