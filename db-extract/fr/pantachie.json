                        "examples": [
                            {
                                "example_id": "64bd0510-2ec3-4ea7-9674-ae357d4a398e",
                                "sense_id": "e9b29058-6cca-3cbb-a0dd-b2fb7bd3656b",
                                "text": "Cette couronne circulaire est entièrement remplie par la trajectoire, c'est-à-dire que les points de la courbe en question y forment, comme on dit, une pantachie, un ensemble de points dense partout."
                            },
                            {
                                "example_id": "f5accfd7-6e30-4c96-8937-1eb3a6ed847b",
                                "sense_id": "e9b29058-6cca-3cbb-a0dd-b2fb7bd3656b",
                                "text": "La continuité n'étant pas compréhensible, la mécanique analytique décompose en réalité la trajectoire en éléments, c'est-à-dire qu'en vue du calcul elle la recouvre d'une pantachie illimitée de points."
                            }
                        ]
                    }
