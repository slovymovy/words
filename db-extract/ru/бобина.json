                    {
                        "translation_id": "6ebde674-7bda-451b-b77d-54216bdd049e",
                        "source_entry_id": "817f3f26-1715-3cd0-b8be-363dfaeb0810",
                        "target_lang_word": "Spule",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spule",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b05cac9-6224-32e1-9e66-37610d514a7e",
                                        "entry_id": "6c91fbf8-b2b6-33f1-a443-db312127dfee",
                                        "glosses": [
                                            "Rolle, die mit einem Faden umwickelt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8218b995-6d0e-46a6-968e-29ec73a791c4",
                                                "sense_id": "8b05cac9-6224-32e1-9e66-37610d514a7e",
                                                "text": "An der Nähmaschine ist die Spule leer geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                        "entry_id": "6c91fbf8-b2b6-33f1-a443-db312127dfee",
                                        "glosses": [
                                            "aus einem Leiter (meist Kupferdraht) gewickeltes Bauteil, das vor allem wegen seiner Induktivität verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a26295-d8af-4035-a107-485e3fa8e2fa",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "Der Gleichstrom veranlasst die Spule ein Magnetfeld aufzubauen. Die gleichmäßige Bewegung der Spule durch das Magnetfeld verursacht einen Wechselstrom."
                                            },
                                            {
                                                "example_id": "6e9b6502-18f7-4e09-b1b5-a35c58afec88",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Die Spulen werden neu aufgewickelt, erklärt Ulf Kilian.“"
                                            },
                                            {
                                                "example_id": "4fcbcbb7-e954-427b-b629-6b4cd037f603",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Spulen müssen sowohl gewickelt als auch geflochten werden, um bestimmte Wirbelströme zu vermeiden.“"
                                            },
                                            {
                                                "example_id": "a763848f-b4f6-4e34-b538-15810dfa5c02",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Die schwergewichtigen Spulen werden mit nichtmagnetischen Schrauben aus Kunststoff, Edelstahl oder Messing befestigt.“"
                                            },
                                            {
                                                "example_id": "267565d9-a718-40b1-8030-49cc7adbde17",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Die Spule für die Impedanzlinearisierung darf hochohmig ausfallen.“"
                                            },
                                            {
                                                "example_id": "2866adb7-fc7b-4afa-b4c7-1b980c1a4d64",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Die beiden Spulen des Tieftonfilters ordnet man am besten mit größtmöglichem Abstand zueinander an.“"
                                            },
                                            {
                                                "example_id": "c7b4da52-fd1a-4aa7-a454-3d55dc61466d",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Oft kommt es vor, dass man in seiner \"Bastelkiste\" eine Spule ohne Beschriftung findet und man daher die Induktivität der Spule nicht bestimmen kann.“"
                                            },
                                            {
                                                "example_id": "905cf4f9-6720-43fd-ace5-f896b2f881ba",
                                                "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                                                "text": "„Ein Kondensator speichert elektrische Energie und verwandelt diese beim Abfeuern innerhalb von 8 Millisekunden in elektrischen Strom, der in eine Spule geleitet wird. […] Durch das dabei in der Spule entstehende Magnetfeld wird der Magnet aus der Spule geschleudert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be6d1308-3dd9-4ee7-81d0-18abd5469a02",
