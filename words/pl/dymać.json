                            }
                        },
                        {
                            "text": "Niektórzy uważają, że <w>dymać</w> się na pierwszej randce to przesada.",
                            "target_lang_translations": {
                                "ru": "Некоторые считают, что <w>трахаться</w> на первом свидании — это перебор."
                            }
