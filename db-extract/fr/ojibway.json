                                        "sense_id": "23ea3474-d218-3599-8015-0103d0807618",
                                        "entry_id": "1b7efc24-cf55-34b0-9d48-a6498b26089a",
                                        "glosses": [
                                            "Of or pertaining to this people, culture or language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d260f93-e901-4734-98d3-0569d46d0d3a",
                                                "sense_id": "23ea3474-d218-3599-8015-0103d0807618",
                                                "text": "Then for 50 years its story lay dormant — although the Dream Dance remained a component of Ojibwe life both north and south of the Canada-U.S. border until its rediscovery by a Winnipeg historian and her colleagues."
                                            }
                                        ]
