                ],
                "senses": [
                    {
                        "sense_id": "b78d7fc6-267c-354e-b95f-f78d2c686f1e",
                        "entry_id": "569dc505-4125-35f7-aee2-b481467406d8",
                        "glosses": [
                            "eine in Indien gebräuchliche, einem Titel gleichgestellte Anrede für einen gebildeten Inder — entsprechend dem ursprünglichen Sinn der deutschen Anrede „Herr“"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c6e97e48-b69f-4f03-85c0-e2e4721cbd4c",
                                "sense_id": "b78d7fc6-267c-354e-b95f-f78d2c686f1e",
                                "text": "„Früher – vor dem Kriege, da habe ein Sahib hier noch etwas gegolten. Jeder Eingeborene habe ihn ehrfürchtig gegrüßt, jeder Babu habe einen Umweg um ihn gemacht. Aber heute? Heute sei es umgekehrt. Heute müsse der Sahib einen Umweg um den Babu machen, wenn er nicht zum Gaudi aller Vorübergehenden über den Haufen gerannt werden wolle.[…]Die schönen Posten, die vorher alle ein Privileg der Sahibs waren, gehen scharenweise in die Hände der Babus über, der Englishman ist kaum noch geduldet in seinen eigenen Kolonien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d00b3a47-796d-30db-92d4-49f48e5b61cb",
                        "entry_id": "569dc505-4125-35f7-aee2-b481467406d8",
                        "glosses": [
                            "Träger des unter [1] beschriebenen Titels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044cee39-cbeb-49e3-8248-ad0a69502823",
                                "sense_id": "d00b3a47-796d-30db-92d4-49f48e5b61cb",
                                "text": "„\"Ein heiliges Bad während der Sonnenfinsternis zu nehmen ist ein besonders frommer Akt\", sagte der Hindu-Priester Babu Ram Sashtiri.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7e6b416-eb10-4baa-8a7f-ef06d347bc73",
                        "source_entry_id": "569dc505-4125-35f7-aee2-b481467406d8",
                        "source_sense_id": "b78d7fc6-267c-354e-b95f-f78d2c686f1e",
                        "source_sense_description": "in Indien gebräuchliche, einem Titel gleichgestellte Anrede",
                        "target_lang_word": "babu",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babu",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2393dc0d-10d2-3c08-a9be-0882978aa0f7",
                                        "entry_id": "cab9c7e2-acb4-3ca8-8eb6-8cb759abf5db",
                                        "glosses": [
                                            "A Hindu title of respect, equivalent to Mr., usually appended to the surname of a Hindu man."
                                        ],
                                        "tags": [
                                            "Hinglish",
                                            "India",
                                            "North"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5357a5b7-039c-4580-82d2-39254cf7a488",
                                                "sense_id": "2393dc0d-10d2-3c08-a9be-0882978aa0f7",
                                                "text": "I could see Kana-babu’s sweet-shop at the end of their lane with absolute clarity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a9e2212-27f8-39be-b63c-f081c7bf8bc6",
                                        "entry_id": "cab9c7e2-acb4-3ca8-8eb6-8cb759abf5db",
                                        "glosses": [
                                            "an archetypical Indian bureaucrat, perceived as being corrupt, lazy or arrogant."
                                        ],
                                        "tags": [
                                            "India",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274b0f58-2230-475e-aaa9-7a3c9ce747aa",
                                                "sense_id": "5a9e2212-27f8-39be-b63c-f081c7bf8bc6",
                                                "text": "BBMP doesn’t have any elected representatives right now. So a babu has floated this tender to benefit his favourite businessmen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f2e37e-8ac9-36b6-8cff-e6b33ba5cce2",
                                        "entry_id": "cab9c7e2-acb4-3ca8-8eb6-8cb759abf5db",
                                        "glosses": [
                                            "Originally, a Hindu gentleman employed to work as a clerk for the colonial administration; now, a clerk or low-ranking government official."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c6a071-b3d0-4076-9187-a2116c1f0422",
                                                "sense_id": "26f2e37e-8ac9-36b6-8cff-e6b33ba5cce2",
                                                "text": "The Babu put on his cap and quietly dropped out of the window"
                                            },
                                            {
                                                "example_id": "3b94f14e-70fe-40cb-a685-3f8c8e82f7de",
                                                "sense_id": "26f2e37e-8ac9-36b6-8cff-e6b33ba5cce2",
                                                "text": "Office babus are the real rulers of this country now. Our number's up. Best thing we can do is to shut up shop and let 'em stew in their own juice."
                                            },
                                            {
                                                "example_id": "3c74dd55-a825-433b-b640-edac5bea5478",
                                                "sense_id": "26f2e37e-8ac9-36b6-8cff-e6b33ba5cce2",
                                                "text": "From the prevailing colonial perspective, the English of the babus was error-ridden and characterised by over-elaborate ornateness, and for these ‘transgressions’ it became the butt of native-speaker ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
