                "senses": [
                    {
                        "sense_id": "b20ecdea-d0a2-3052-9e92-ef63ad7e8398",
                        "entry_id": "5cf9d0fb-15f4-35c0-9df0-0885017644ee",
                        "glosses": [
                            "Entrichtung von Abgaben, die jemand (insbesondere ein Staat) regelmäßig als Zeichen der Unterwerfung zu leisten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95534e68-6c2a-4797-806d-b9801008c28d",
                                "sense_id": "b20ecdea-d0a2-3052-9e92-ef63ad7e8398",
                                "text": "„Untereinander unterhielten die Adelshäuser mithilfe gegenseitiger Geschenke und Tributzahlungen enge Verbindungen und häuften so ganz nebenbei gewaltige Reichtümer an.“"
                            },
                            {
                                "example_id": "3bf3c7c1-705c-4011-a382-5913454785f9",
                                "sense_id": "b20ecdea-d0a2-3052-9e92-ef63ad7e8398",
                                "text": "„So gaben sich die Moguln nicht mit den traditionell üblichen Treueschwüren und Tributzahlungen unterworfener Fürsten und Könige zufrieden, sondern sie strebten eine direkte Eingliederung der eroberten Gebiete in ihr Reich an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
