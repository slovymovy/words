                        ],
                        "examples": [
                            {
                                "example_id": "ba9d8424-d6ed-4dc8-bade-e2fb19a61d00",
                                "sense_id": "b7a0a8fb-dad4-306d-992f-9dfe7899aed3",
                                "text": "Die mittelalterlichen Scholaren unterstanden nicht dem gewöhnlichen Gericht, durften in ihren Collegien nicht von den Bütteln gesucht oder belästigt werden, sie trugen besondere Tracht, hatten das Recht, sich ungestraft zu duellieren und waren als eine geschlossene Gilde mit eigenen Sitten oder Unsitten anerkannt.",
                                "translation": "The World of Yesterday",
                                "english": "The World of Yesterday"
                            }
                        ]
                    }
