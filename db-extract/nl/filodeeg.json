                "senses": [
                    {
                        "sense_id": "ffe9c543-cd07-37b3-aba6-bf5ca136c290",
                        "entry_id": "9841310f-a4db-3785-80cc-32f4eba28115",
                        "glosses": [
                            "dun deeg dat in grote vellen kant-en-klaar, diepgevroren, gekocht kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca5ea3a-88d0-4989-a161-bcb86ceca7ba",
                                "sense_id": "ffe9c543-cd07-37b3-aba6-bf5ca136c290",
                                "text": "Dit wil overigens niet zeggen dat de Turkse keuken een kopie is van die van de omliggende landen, absoluut niet zelfs. Heerlijke deeggerechtjes, hartig of zoet, horen echt bij de nationale keuken. Gevuld met kaas of groente zijn ze lekker als voorafje of snack. Fraaie sigaartjes van dun filodeeg met feta worden gefrituurd en opgediend als buffetgerecht."
                            },
                            {
                                "example_id": "c7a1a801-d832-40bf-8a5b-da50e8dc145a",
                                "sense_id": "ffe9c543-cd07-37b3-aba6-bf5ca136c290",
                                "text": "Meng de bloem met een eetlepel water. Voeg extra water toe als het papje aan de dikke kant is. Leg twee vellen filodeeg in een ruit voor je. Strijk de bovenste randen van het filodeeg in met het bloempapje."
                            },
                            {
                                "example_id": "40abbb55-798b-4c69-b498-a327e599f87c",
                                "sense_id": "ffe9c543-cd07-37b3-aba6-bf5ca136c290",
                                "text": "Deze Marokkaanse kippastei is een lekkere combinatie van hartig en zoet, doordat je naast ui en filodeeg ook kaneel en poedersuiker toevoegt. Het kost wel wat tijd, maar het resultaat is om van te smullen."
                            }
                        ]
                    }
