                "senses": [
                    {
                        "sense_id": "a51b1aaa-a81a-305e-8447-33575a2999a3",
                        "entry_id": "005ed334-a8ff-3c9e-a4c8-5143ce814d8a",
                        "glosses": [
                            "Luftfahrzeug, das vom Hersteller Cessna Aircraft Company und dessen Nachfolgefirmen produziert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cea7311-7fe6-4f68-a020-66ad2e83fb4f",
                                "sense_id": "a51b1aaa-a81a-305e-8447-33575a2999a3",
                                "text": "„Warum befand sich der amerikanische Botschafter an Bord des Militärflugs Pak One statt in seiner eigenen Cessna?“"
                            },
                            {
                                "example_id": "07526b33-5f2b-4ede-9d48-a6bea2f8292c",
                                "sense_id": "a51b1aaa-a81a-305e-8447-33575a2999a3",
                                "text": "„Dewey verharrte geduckt unter der Tragfläche einer Cessna.“"
                            },
                            {
                                "example_id": "39980053-74a2-40b3-8bfc-a3adfd070326",
                                "sense_id": "a51b1aaa-a81a-305e-8447-33575a2999a3",
                                "text": "„Er stieg aus der Cessna, gefolgt vom Fettsack.“"
                            },
                            {
                                "example_id": "883b501e-bffe-48a5-872c-0e96e4c9873c",
                                "sense_id": "a51b1aaa-a81a-305e-8447-33575a2999a3",
                                "text": "„Für den letzten Streckenabschnitt - von Mexiko in die USA - waren die Boeings freilich ungeeignet, es bedurfte wendigerer und kleinerer Flugzeuge wie der Cessna des Lufttaxiunternehmens Taxceno (Taxi Aéreo del Centro Norte), dessen Hauptaktionär Amado wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
