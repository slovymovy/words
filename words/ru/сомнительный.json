    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dcc4575a-e2d6-3a80-b9a5-b993fac38836",
                    "sense_definition": "Вызывающий сомнение в своей истинности или достоверности.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doubt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Успех этого проекта кажется крайне <w>сомнительным</w>.",
                            "target_lang_translations": {
                                "de": "Der Erfolg dieses Projekts erscheint äußerst <w>zweifelhaft</w>."
                            }
                        },
                        {
                            "text": "Он привел <w>сомнительные</w> доказательства своей правоты.",
                            "target_lang_translations": {
                                "de": "Er brachte <w>fragwürdige</w> Beweise für seine Unschuld vor."
                            }
                        }
                    ],
                    "synonyms": [
                        "недостоверный",
                        "проблематичный",
                        "маловероятный"
                    ],
                    "antonyms": [
                        "несомненный"
                    ],
                    "common_phrases": [
                        "сомнительный успех",
                        "сомнительный результат"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das Zweifel an seiner Wahrheit oder Glaubwürdigkeit aufkommen lässt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zweifelhaft",
                                "target_lang_sense_clarification": "allgemein für Dinge, deren Richtigkeit oder Erfolg fraglich ist"
                            },
                            {
                                "target_lang_word": "fragwürdig",
                                "target_lang_sense_clarification": "betont die Unsicherheit oder den Mangel an Beweisen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9cb4f50-3d2c-3304-82f3-74a52d15a241",
                    "sense_definition": "Внушающий опасение или подозрение.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "suspicion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В парке к нам подошел человек с <w>сомнительной</w> внешностью.",
                            "target_lang_translations": {
                                "de": "Im Park kam ein Mann mit <w>verdächtigem</w> Aussehen auf uns zu."
                            }
                        },
                        {
                            "text": "Это <w>сомнительный</w> тип, лучше не вступать с ним в разговор.",
                            "target_lang_translations": {
                                "de": "Das ist ein <w>zwielichtiger</w> Typ, es ist besser, sich nicht mit ihm einzulassen."
                            }
                        }
                    ],
                    "synonyms": [
                        "подозрительный"
                    ],
                    "common_phrases": [
                        "сомнительный тип",
                        "сомнительная личность"
                    ],
                    "target_lang_definitions": {
