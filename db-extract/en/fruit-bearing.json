                "forms": [],
                "senses": [
                    {
                        "sense_id": "cbb84f49-ef6d-320c-889d-e8e73634490f",
                        "entry_id": "8ede62d4-34dd-3703-a84d-b73cc1e61bf4",
                        "glosses": [
                            "Bearing fruit."
                        ],
                        "tags": [
                            "not-comparable",
