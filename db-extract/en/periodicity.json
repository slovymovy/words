                    },
                    {
                        "translation_id": "843d0e6c-6088-4d06-b5ab-2332dbdaee19",
                        "source_entry_id": "d2015be7-93ad-3ff5-af46-43e94273f8a6",
                        "source_sense_description": "property of being periodic",
                        "target_lang_word": "périodicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "périodicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06c50d31-fe5d-3a38-a395-9a6bf63537c0",
                                        "entry_id": "aa6d7b14-6705-3a33-b5c9-02044d124557",
                                        "glosses": [
                                            "Qualité de ce qui est périodique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50d71ef-985b-4c86-8345-d22cc44e4cfb",
                                                "sense_id": "06c50d31-fe5d-3a38-a395-9a6bf63537c0",
                                                "text": "Il appartenait au gouvernement de montrer aux populations viticoles la périodicité inévitable des crises tant qu'il serait planté des ceps à tort et à travers, tant que producteurs et commerçants ne feraient pas la guerre aux falsifications."
                                            },
                                            {
                                                "example_id": "1cb99864-b3e6-4031-8b09-30c90b846911",
                                                "sense_id": "06c50d31-fe5d-3a38-a395-9a6bf63537c0",
                                                "text": "Les hommes aiment beaucoup trouver, dans la nature, des périodicités du genre de celles dont nous parlons. Elles leur procurent une vague impression d’assurance contre l’inconnu; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59203f37-f32f-313b-a157-34a3d97f71bd",
                                        "entry_id": "aa6d7b14-6705-3a33-b5c9-02044d124557",
                                        "glosses": [
                                            "Fréquence."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c8e38e-bdd6-446b-a2de-ef4ea1a625d5",
                                                "sense_id": "59203f37-f32f-313b-a157-34a3d97f71bd",
                                                "text": "Voici quelques années , ces appareils nécessitaient une commutatrice fournissant le courant à la périodicité requise pour les vibrateurs. Actuellement on dispose de redresseurs plus simples et moins coûteux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a990ea7-fee4-435a-8dbc-27e004782dd6",
                        "source_entry_id": "d2015be7-93ad-3ff5-af46-43e94273f8a6",
                        "source_sense_description": "property of being periodic",
                        "target_lang_word": "Periodizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Periodizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ad5c8a-feda-34a2-bae3-0d14f476a98e",
                                        "entry_id": "7382b2df-1368-362b-9da2-3441686a78db",
                                        "glosses": [
                                            "Eigenschaft, nach Ablauf einer gewissen Zeit (Periode) erneut aufzutauchen/zu erscheinen/sich zu ereignen, und das regelmäßig (periodisch) wiederkehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c15c497-2311-41cd-9b16-e28cf358bbf5",
                                                "sense_id": "d3ad5c8a-feda-34a2-bae3-0d14f476a98e",
                                                "text": "„Anhand der vier »Definitionskriterien« der Zeitung - Periodizität, Aktualität, Universalität und Publizität - soll ihr besonderer Charakter noch einmal verdeutlicht werden.“"
                                            },
                                            {
                                                "example_id": "12ca01b3-ca96-4a0b-8b5e-707b3cadbec9",
                                                "sense_id": "d3ad5c8a-feda-34a2-bae3-0d14f476a98e",
                                                "text": "„Der ursprüngliche Anreiz, die Zeitabhängigkeit der Kraterentstehung zu untersuchen, ergab sich jedoch aus der Erforschung eines – oberflächlich betrachtet – ganz anderen Themas: der offenkundigen Periodizität der Aussterbeereignisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
