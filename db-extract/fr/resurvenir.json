                "senses": [
                    {
                        "sense_id": "82cff0c5-fe4e-3bb7-abc8-bae11eb5e1c1",
                        "entry_id": "78ab389d-4a5b-3751-9255-1b59ebd6f3ef",
                        "glosses": [
                            "Survenir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c94ba2e-e6c3-4bcb-9687-108be2292abc",
                                "sense_id": "82cff0c5-fe4e-3bb7-abc8-bae11eb5e1c1",
                                "text": "Parfois ça marche pas et surtout ça risque de resurvenir un jour ou l'autre... ou pas :D."
                            },
                            {
                                "example_id": "740d2a34-eb4b-4b8f-8c6c-d1113430a68b",
                                "sense_id": "82cff0c5-fe4e-3bb7-abc8-bae11eb5e1c1",
                                "text": "Mais, si elle n'est pas traitée, la violence peut survenir, resurvenir à tous moments dans la vie des couples et des familles."
                            },
                            {
                                "example_id": "c7cf6441-079a-4173-98e7-0845d1d3e58c",
                                "sense_id": "82cff0c5-fe4e-3bb7-abc8-bae11eb5e1c1",
                                "text": "Lorsqu'elles diminuaient en intensité du fait du traitement, elles s'effilochaient sur plusieurs jours, on ne savait pas quand elle allait resurvenir."
                            }
                        ]
                    }
