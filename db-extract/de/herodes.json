                                "target_senses": [
                                    {
                                        "sense_id": "315ecc55-be22-3eb3-bb05-23d9a475e96b",
                                        "entry_id": "22368188-1f28-349e-951a-1d3e4450cd2d",
                                        "glosses": [
                                            "The name of any of a number of members of the Herodian dynasty who ruled in the Roman province of Judea, most notably Herod the Great, who ordered the Massacre of the Innocents, or Herod Antipas, his son, who met Jesus during his Passion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b4cfb57-15a0-47a5-982c-2c2898eabd08",
                        "source_entry_id": "b7ff0697-dcce-3c00-914e-b53653d1bc11",
                        "source_sense_id": "214414c8-fa93-3f9e-abdd-eb994990e820",
                        "source_sense_description": "jüdischer Klientelkönig Roms",
