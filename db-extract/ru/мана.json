                            {
                                "example_id": "adbf22ee-8240-44de-8815-2ef7fadde79e",
                                "sense_id": "be4db334-7607-371f-8749-74bcd4dbcb59",
                                "text": "Моя́ ма́на тра́тится бы́стро\nНо го́лос бу́дто магни́т\nВо мне слова́ и́ли но́ты\nИ се́рдце, как динами́т"
                            }
                        ]
