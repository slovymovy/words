                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5b1f190-736b-398e-aeed-f62693aa23e4",
                        "entry_id": "91b4f76c-75cc-3588-95fc-064972c59bd6",
                        "glosses": [
                            "van iets of iemand dat hij rondgaat zonder goed te weten waarnaartoe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49eada4-2731-43e4-800b-41aef645b08d",
                                "sense_id": "c5b1f190-736b-398e-aeed-f62693aa23e4",
                                "text": "New York zoekt al dagen naar dwalende autistische jongen: Een 14-jarige autistische jongen is 12 dagen geleden uit zijn school in New York gelopen en is sindsdien spoorloos. De hulpdiensten gaan ervan uit dat Avonte Oquendo aan het ronddwalen is en hebben alles uit de kast gehaald om hem te vinden."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3be86b4-686f-339d-8fd7-9396aa3e9cd6",
                        "entry_id": "91b4f76c-75cc-3588-95fc-064972c59bd6",
                        "glosses": [
                            "van iemand dat hij een foute beslissing heeft gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8d1e58f-d867-4c45-a23c-015d605f2cc1",
                                "sense_id": "a3be86b4-686f-339d-8fd7-9396aa3e9cd6",
                                "text": "Ghana dient protest in tegen 'dwalende' arbiter: De Ghanese voetbalbond heeft een officieel protest ingediend bij wereldbond FIFA over de Zuid-Afrikaanse scheidsrechter Daniel Bennett."
                            },
                            {
                                "example_id": "97198420-5dfb-4067-8ad5-ff201eac8468",
                                "sense_id": "a3be86b4-686f-339d-8fd7-9396aa3e9cd6",
                                "text": "VNO-NCW zoekt op korte termijn het overleg met Rijkswaterstaat voor maatregelen die de komende jaren de fileproblemen op de A1 terugdringen. Daarnaast zullen de Tweede Kamerleden worden benaderd om de A1 opnieuw met voorrang op de agenda te krijgen. Bestuurder VNO-NCW Midden Müller: \"Wij zullen alle Kamerleden vragen de, op dit punt dwalende, minister weer op het A1-spoor te zetten.\""
                            }
                        ]
                    }
