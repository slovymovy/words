                                        "entry_id": "771b9290-4cfa-32ec-986d-5a8b7a5165b4",
                                        "glosses": [
                                            "A frozen, unresponsive state, as of electronic equipment."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
