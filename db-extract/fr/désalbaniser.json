                        "glosses": [
                            "Faire perdre son caractère albanais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc78800-abf5-4989-aca1-a4eeaf32c59b",
                                "sense_id": "f40c87ff-2b68-36f1-893d-bbe1fbd9ac9c",
                                "text": "En décembre 1991, le pouvoir serbe débaptisa certaines rues aux noms communistes et en profita pour en « désalbaniser » d’autres."
                            },
                            {
                                "example_id": "7ce5ad13-5b5b-4db4-8fac-726491367542",
                                "sense_id": "f40c87ff-2b68-36f1-893d-bbe1fbd9ac9c",
                                "text": "Mais ce processus de déculturation devait être suivi d’une occasion toute trouvée pour les Grecs de désalbaniser la Tchaméria."
                            }
                        ]
                    }
