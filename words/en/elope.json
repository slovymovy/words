                    "frequency": "Middle",
                    "semantic_group_id": "marriage_or_romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of having a huge wedding, the young couple decided to <w>elope</w> to Las Vegas."
                        },
                        {
                            "text": "Her parents were furious when they discovered that she had <w>eloped</w> with her high school sweetheart."
                        }
                    ],
                    "common_phrases": [
                        "elope to Vegas",
                        "decide to elope"
                    ]
                },
                {
                    "sense_id": "d392d232-7458-32bb-a468-bfbd222e03cf",
                    "sense_definition": "To run away secretly from one's home or spouse with a lover or paramour.",
