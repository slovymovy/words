{
    "word_family": [
        "curtailment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f63fa906-597a-3bdc-9fcd-677ba797352f",
                    "sense_definition": "To shorten or abridge the duration of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker decided to <w>curtail</w> her speech when the audience started to look bored.",
                            "target_lang_translations": {
                                "ru": "Выступающая решила <w>сократить</w> свою речь, когда аудитория начала скучать."
                            }
                        },
                        {
                            "text": "Heavy rain forced the organizers to <w>curtail</w> the outdoor concert.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь вынудил организаторов <w>сократить</w> концерт на открытом воздухе."
                            }
                        }
                    ],
                    "synonyms": [
                        "abbreviate",
                        "shorten"
                    ],
                    "common_phrases": [
                        "curtail a speech",
                        "curtail a visit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращать продолжительность или длительность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "делать менее продолжительным"
                            },
                            {
                                "target_lang_word": "сократить",
                                "target_lang_sense_clarification": "сделать менее продолжительным"
                            },
                            {
                                "target_lang_word": "укорачивать",
                                "target_lang_sense_clarification": "делать короче по времени"
                            },
                            {
                                "target_lang_word": "укоротить",
                                "target_lang_sense_clarification": "сделать короче по времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fac66d06-0f40-3788-8ad1-acc001d89444",
                    "sense_definition": "To limit or restrict something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New laws were introduced to <w>curtail</w> the power of large corporations.",
                            "target_lang_translations": {
                                "ru": "Были приняты новые законы, призванные <w>ограничить</w> власть крупных корпораций."
                            }
                        },
                        {
                            "text": "The government must <w>curtail</w> spending to avoid a national debt crisis.",
                            "target_lang_translations": {
                                "ru": "Правительство должно <w>урезать</w> расходы, чтобы избежать кризиса государственного долга."
                            }
                        }
                    ],
                    "synonyms": [
                        "control",
                        "limit",
                        "restrain"
                    ],
                    "common_phrases": [
                        "curtail spending",
                        "curtail rights"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничивать или уменьшать объём, права, расходы и т. п."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничивать",
                                "target_lang_sense_clarification": "ставить в определённые рамки"
                            },
                            {
                                "target_lang_word": "ограничить",
                                "target_lang_sense_clarification": "поставить в определённые рамки"
                            },
                            {
                                "target_lang_word": "урезывать",
                                "target_lang_sense_clarification": "уменьшать объём, финансирование, права"
                            },
                            {
                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "уменьшить объём, финансирование, права"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c48cd7cd-ca44-30b2-9720-fb6e57fe6c96",
                    "sense_definition": "To cut short the tail of an animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shorten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers would sometimes <w>curtail</w> the tails of sheep for hygiene reasons.",
                            "target_lang_translations": {
                                "ru": "Фермеры иногда <w>купировали</w> хвосты овцам из соображений гигиены."
                            }
                        },
                        {
                            "text": "The practice of <w>curtailing</w> horses was once common in certain regions.",
                            "target_lang_translations": {
                                "ru": "Практика <w>купирования хвостов</w> у лошадей когда-то была распространена в некоторых регионах."
                            }
                        }
                    ],
                    "synonyms": [
                        "crop",
                        "dock"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрезать или купировать хвост животному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "купировать",
                                "target_lang_sense_clarification": "укорачивать хвост животного хирургическим путём"
                            },
                            {
                                "target_lang_word": "обрезать",
                                "target_lang_sense_clarification": "отсекать часть хвоста"
                            },
                            {
                                "target_lang_word": "укорачивать",
                                "target_lang_sense_clarification": "делать хвост короче"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8599e9b7-f33a-3ea2-aaab-72129d0bd79f",
                    "sense_definition": "A scroll-shaped architectural termination, such as at the end of a step.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grand staircase featured an elegant <w>curtail</w> at the bottom step.",
                            "target_lang_translations": {
                                "ru": "Парадная лестница имела элегантный <w>завиток</w> на нижней ступени."
                            }
                        },
                        {
                            "text": "The carpenter carved a decorative <w>curtail</w> into the wooden banister.",
                            "target_lang_translations": {
                                "ru": "Плотник вырезал декоративный <w>завиток</w> на деревянных перилах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Спиралевидное или завиткообразное архитектурное завершение (например, у основания ступени лестницы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завиток",
                                "target_lang_sense_clarification": "спиралевидное завершение ступени или перил"
                            },
                            {
                                "target_lang_word": "волюта",
                                "target_lang_sense_clarification": "спиралевидный архитектурный элемент"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}