                                            {
                                                "example_id": "aa873b97-6fad-4323-a5c3-3b5c9b4f6f4d",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "這房子常常鬧鬼。"
                                            },
                                            {
                                                "example_id": "1e591edd-0ea7-4948-983c-0ba754ac5812",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "这房子常常闹鬼。"
                                            },
                                            {
                                                "example_id": "b49c6c61-0d51-4c09-b049-3427cb676567",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "我在蒙自住過五個月，我的家也在那裡住過兩個月。我現在常常想起這個地方，特別是在人事繁忙的時候。蒙自小得好，人少得好。"
                                            },
                                            {
                                                "example_id": "5e74ecb4-3605-414d-ace2-7f00152ebd49",
                                                "sense_id": "75b5854e-1feb-3db4-8bca-c5e58df5e273",
                                                "text": "我在蒙自住过五个月，我的家也在那里住过两个月。我现在常常想起这个地方，特别是在人事繁忙的时候。蒙自小得好，人少得好。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
