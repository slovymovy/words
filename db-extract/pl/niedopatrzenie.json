                                            {
                                                "example_id": "ecc08c81-5c6c-4e42-a6ed-e8f1dc6432d2",
                                                "sense_id": "286944bc-9681-3c05-8e3d-1310f723b705",
                                                "text": "Inadvertency, or want of attendance to the sense and intention of our prayers."
                                            },
                                            {
                                                "example_id": "eb426894-3fd0-4cea-899d-119206deb14c",
                                                "sense_id": "286944bc-9681-3c05-8e3d-1310f723b705",
                                                "text": "It ſeems more probable that Ovid vvas either the Confident of ſome other paſſion, or that he had ſtumbled by ſome inadvertency, upon the privacies of Livia, and ſeen her in a Bath: […]"
                                            }
                                        ]
