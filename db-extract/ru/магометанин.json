                    },
                    {
                        "translation_id": "636f6693-7089-42fa-9f6e-51f2fb044c75",
                        "source_entry_id": "f71677dc-8da9-3877-ba3b-2e11e0016c05",
                        "source_sense_id": "3dc8c9af-9a04-31b1-9001-67b1ae4f6e5b",
                        "target_lang_word": "mahometano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mahometano",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "15944942-8639-3d5f-a905-8dc3ee9b3bd6",
