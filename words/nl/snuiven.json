{
    "word_family": [
        "snuif",
        "snuiver",
        "snuifdoos",
        "snuiftabak",
        "opsnuiven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f69cacd-b7b4-3083-a1ac-f4a4e1f97ad2",
                    "sense_definition": "sterk door de neus inademen om iets te ruiken of om emotie te tonen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ademhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>snoof</w> eens flink en zei dat hij verse koffie rook.",
                            "target_lang_translations": {
                                "en": "He took a good <w>sniff</w> and said he smelled fresh coffee."
                            }
                        },
                        {
                            "text": "Het paard begon luid te <w>snuiven</w> toen het de stal naderde.",
                            "target_lang_translations": {
                                "en": "The horse began to <w>snort</w> loudly as it approached the stable."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuffelen",
                        "ruiken"
                    ],
                    "common_phrases": [
                        "luid snuiven",
                        "verontwaardigd snuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "to inhale strongly through the nose to smell something or to show emotion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sniff",
                                "target_lang_sense_clarification": "to smell something"
                            },
                            {
                                "target_lang_word": "snort",
                                "target_lang_sense_clarification": "to show emotion or make a loud sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a25f3767-128d-3a62-9609-bbc1f53b5a50",
                    "sense_definition": "een substantie, zoals tabak of drugs, via de neus naar binnen zuigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de Verenigde Staten wordt veel tabak <w>gesnoven</w> en gepruimd.",
                            "target_lang_translations": {
                                "en": "In the United States, a lot of tobacco is <w>snuffed</w> and chewed."
                            }
                        },
                        {
                            "text": "De politie hield de man aan omdat hij drugs zat te <w>snuiven</w> in de auto.",
                            "target_lang_translations": {
                                "en": "The police detained the man because he was <w>snorting</w> drugs in the car."
                            }
                        }
                    ],
                    "synonyms": [
                        "opsnuiven"
                    ],
                    "common_phrases": [
                        "cocaïne snuiven",
                        "tabak snuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "to inhale a substance, such as tobacco or drugs, through the nose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sniff",
                                "target_lang_sense_clarification": "to inhale drugs or glue"
                            },
                            {
                                "target_lang_word": "snort",
                                "target_lang_sense_clarification": "to inhale powdered drugs"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f445a3f-6241-3f36-85a3-a1fe3f11f972",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>snuif</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij nam een paar korte <w>snuiven</w> om de geur van de bloemen op te vangen.",
                            "target_lang_translations": {
                                "en": "He took a few short <w>sniffs</w> to catch the scent of the flowers."
                            }
                        },
                        {
                            "text": "Na enkele <w>snuiven</w> aan het flesje herkende ze de parfum direct.",
                            "target_lang_translations": {
                                "en": "After a few <w>sniffs</w> of the bottle, she recognized the perfume immediately."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'sniff' or 'snort'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sniffs",
                                "target_lang_sense_clarification": "plural of an instance of sniffing"
                            },
                            {
                                "target_lang_word": "snorts",
                                "target_lang_sense_clarification": "plural of a loud nasal inhalation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}