                        "cross_references": [
                            {
                                "target_word": "cucurucho",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "375fe453-a8d2-3d67-8f34-900ddb2c5ff0",
                                        "entry_id": "1f2e78fe-db69-31a1-aec5-0f0c95a0a1a4",
                                        "glosses": [
                                            "Lámina de papel, cartón o bien de barquillo (galleta) enrollada en forma de cono que contiene dulces, helados u otros objetos pequeños."
                                        ],
                                        "tags": [
                                            "se usa también en sentido figurado"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d20e81-70cf-4204-9273-154182eb6a5c",
                                                "sense_id": "375fe453-a8d2-3d67-8f34-900ddb2c5ff0",
                                                "text": "Un momento después, Phoebe volvía, tratando de pasar desapercibida, por el mismo camino que había recorrido antes, llevando un diminuto cucurucho de papel con las golosinas que había comprado y el primer sabor de chocolate en la lengua"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4092a272-baef-3dee-aaec-44ebbe411de3",
                                        "entry_id": "1f2e78fe-db69-31a1-aec5-0f0c95a0a1a4",
                                        "glosses": [
                                            "Sombrero de cartón de forma cónica que usan penitentes y disciplinantes en Semana Santa."
                                        ],
                                        "tags": [
                                            "Vestimenta"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0d4242c-eb7b-4dbe-b5d4-64b04043fd17",
                                                "sense_id": "4092a272-baef-3dee-aaec-44ebbe411de3",
                                                "text": "El gorro puntiguado o cucurucho de cartón que estiliza y cubre la figura de los nazarenos en las procesiones de Semana Santa, denominado capirote, tiene su origen en la época de la Inquisición"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2dca880d-2fc8-3a05-a96a-88fe2b80e021",
                                        "entry_id": "1f2e78fe-db69-31a1-aec5-0f0c95a0a1a4",
                                        "glosses": [
                                            "La parte más alta de un árbol, una casa, un edificio, etc."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Central-America"
                                        ],
                                        "examples": [
                                            {
