                "senses": [
                    {
                        "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                        "entry_id": "c7b7920b-6aaa-3ded-b4fe-8228d7de3ade",
                        "glosses": [
                            "weibliche Person, mit der jemand sich ein Haus, eine Wohnung oder ein Zimmer teilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93fc7dc7-d6db-46ae-a47b-7230455750f3",
                                "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                "text": "„Weil sich Peter Sim seit Einzug seiner neuen Mitbewohnerin so langweilt, schreibt er Tweets und ab jetzt auch Notizen für diese Kolumne“"
                            },
                            {
                                "example_id": "aabaa693-b7ba-4a89-afa4-afcfd7d487cc",
                                "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                "text": "„Wenige Tage später kommen Thomas und Mona Sendler mit einer anderen Mitbewohnerin des Hauses, der sehr korpulenten und resolut auftretenden Marina Graf, ins Gespräch.“"
                            },
                            {
                                "example_id": "cac52cad-6734-4007-bc79-8fa2fe066d1b",
                                "sense_id": "62695de8-c7f5-33ba-9306-e14bba2bb4e5",
                                "text": "„Als kleiner Junge jedoch war er – wegen des Altersunterschieds leider hoffnungslos – in seine hübsche Mitbewohnerin Ruth verliebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
