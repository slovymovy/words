                            }
                        },
                        {
                            "text": "After <w>ransacking</w> the house for hours, the thieves finally found the hidden wall safe.",
                            "target_lang_translations": {
                                "ru": "После того как воры часами <w>перерывали</w> дом, они наконец нашли спрятанный в стене сейф."
                            }
                        }
                    ],
                    "synonyms": [
                        "looting",
                        "pillaging",
                        "plundering",
                        "searching",
                        "scouring"
                    ],
                    "common_phrases": [
