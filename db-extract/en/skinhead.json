                    }
                ],
                "senses": [
                    {
                        "sense_id": "78237705-cee8-33f1-b6bc-cf3f6d5faf5f",
                        "entry_id": "522ac4f1-8b13-3bed-95e3-63a6f15395c8",
                        "glosses": [
                            "сленг человек с лысой головой; лысый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d838c5b-0e8e-4805-b696-c63affd0cbb3",
                                "sense_id": "78237705-cee8-33f1-b6bc-cf3f6d5faf5f",
                                "text": "Bald-headed man, …cue ball, skinhead, turret top."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a231e72-0e97-3d2e-8355-919431a20b08",
                        "entry_id": "522ac4f1-8b13-3bed-95e3-63a6f15395c8",
                        "glosses": [
                            "сленг человек с бритой головой или коротко постриженными волосами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e94f64f6-17e7-4e1f-8425-c94dfc3c5ca0",
                                "sense_id": "9a231e72-0e97-3d2e-8355-919431a20b08",
                                "text": "Cue ball, skinhead, a fellow with a crew haircut."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbe5d497-e24c-3b2b-965d-53a2eed5fcfc",
                        "entry_id": "522ac4f1-8b13-3bed-95e3-63a6f15395c8",
                        "glosses": [
                            "амер. воен. рекрут Корпуса морской пехоты США"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832b1980-1831-4f29-a63d-5ef49f440095",
                                "sense_id": "cbe5d497-e24c-3b2b-965d-53a2eed5fcfc",
                                "text": "He will administer a royal chewing out (tongue lashing) to the hapless skinheads (recruits; so-called because of their completely shaven heads)."
                            }
                        ]
                    },
                    {
                        "sense_id": "53c668de-3e4b-3707-985a-ffb16a06398e",
                        "entry_id": "522ac4f1-8b13-3bed-95e3-63a6f15395c8",
                        "glosses": [
                            "брит. представитель молодёжной группировки, обычно характеризующейся предпочтением к униформе в сочетании с тяжелыми сапогами и склонностью к агрессивному поведению; скинхед, бритоголовый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34d07be-226c-4678-8db2-fd7ce4827307",
                                "sense_id": "53c668de-3e4b-3707-985a-ffb16a06398e",
                                "text": "A group of teenagers … wear tight and rather short jeans, collarless T-shirts, exposed braces, big steel-capped boots and hair erased almost to their scalps. The lack of hair is what gives them their generic names … crop-heads, skin-heads or peanuts. The boots are good for kicking."
                            },
                            {
                                "example_id": "c0c54b07-d25a-4430-a202-8a58f785f26f",
                                "sense_id": "53c668de-3e4b-3707-985a-ffb16a06398e",
                                "text": "Gangs of Hell’s Angels and skinheads marred Easter Monday seaside outings."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "7fb13ebe-11da-40b2-bc6f-b83a31001c52",
