                                        "entry_id": "f4c8d70d-9f7e-3bfb-870f-3e57f67f3b0b",
                                        "glosses": [
                                            "Wissenschaft, die sich mit Zeichensystemen aller Art (zum Beispiel: Bilderschrift, Gestik, Formeln, Sprache, Verkehrszeichen) befasst und versucht, sie zu beschreiben und zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b3f8ce-649f-418e-9a57-db12f374b2fb",
                                                "sense_id": "0c6d7204-8b4d-3ee2-924f-527af991d0f2",
                                                "text": "„Dieser Frage sind verschiedene Forschungsrichtungen wie Onomastik und Logik, Grammatik und Zeichentheorie, Pragma- und Textlinguistik nachgegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
