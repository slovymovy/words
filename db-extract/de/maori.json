                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8954e974-de5a-3693-9569-e06880a3783c",
                                        "entry_id": "cca9839a-e079-3a51-88d9-7da5e34898ee",
