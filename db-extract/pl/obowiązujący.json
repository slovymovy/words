                                    {
                                        "sense_id": "d116a104-5850-3510-9865-8ae0fdbfda21",
                                        "entry_id": "1a2876bf-79f4-377a-b602-62e37eab5ffc",
                                        "glosses": [
                                            "An employee or other worker with some particular function or skill."
