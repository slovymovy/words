                    {
                        "sense_id": "63c9f0a0-5f8d-340d-8d40-04cdd1098f92",
                        "entry_id": "154defb7-024c-3ec6-a9d6-b42a63135943",
                        "glosses": [
                            "A right tributary of the Garonne in southwestern France, flowing through the departments of Lozère, Aveyron, Tarn, Haute-Garonne and Tarn-et-Garonne."
                        ],
                        "tags": [
                            "error-lua-exec"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1616aba7-d56d-4bb7-8334-3a715ed4c9fb",
                        "source_entry_id": "154defb7-024c-3ec6-a9d6-b42a63135943",
                        "source_sense_description": "department",
                        "target_lang_word": "Tarn",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tarn",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25648915-a08e-3dd7-981d-41365442a4f3",
                                        "entry_id": "38d1fc22-5fd6-304b-9740-57f6971fb6c2",
                                        "glosses": [
                                            "Rivière du sud-ouest de la France, affluent de la Garonne."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395ad54c-3d40-4fcf-bd29-66a7094d50a1",
                                                "sense_id": "25648915-a08e-3dd7-981d-41365442a4f3",
                                                "text": "Le vénérable pont sur le Tarn a non seulement de hautes arches en ogive, mais ses piles de briques, entre les les voûtes et au-dessus des avant-becs, sont percées de baies du même style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a5b98e-2bbc-39f1-9d71-9f0ea4bdb730",
                                        "entry_id": "38d1fc22-5fd6-304b-9740-57f6971fb6c2",
                                        "glosses": [
                                            "Département du sud-ouest de la France, faisant partie de la région Occitanie, qui porte le numéro 81."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6970a4a7-0aec-4865-a94d-0184fdffff02",
                                                "sense_id": "a9a5b98e-2bbc-39f1-9d71-9f0ea4bdb730",
                                                "text": "Heureux habitants du Tarn et des autres départements français, non seulement nous vivons de plus en plus vieux, mais nous ne voulons pas vieillir, et il devient banal de voir des septuagénaires jogger ou des dames d’âge ultracanonique s’initier au crapahutage à vélo tout terrain."
                                            },
                                            {
                                                "example_id": "05742a98-8ed9-44c6-bb9b-ec7d2f670ca6",
                                                "sense_id": "a9a5b98e-2bbc-39f1-9d71-9f0ea4bdb730",
                                                "text": "Dans les villages de la Haute-Garonne et du Tarn, le vigné était un lieu rassemblant les parcelles de terre des habitants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "e0f007ea-9378-3d17-9a44-6831468da22f",
                "word": "tarn",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d3461eca-f41c-400e-b309-f6218d587cf1",
                        "entry_id": "e0f007ea-9378-3d17-9a44-6831468da22f",
                        "tags": [
                            "plural"
                        ],
                        "form": "tarns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                        "entry_id": "e0f007ea-9378-3d17-9a44-6831468da22f",
                        "glosses": [
                            "A small mountain lake, especially in Northern England."
                        ],
                        "tags": [
                            "Northern-England"
                        ],
                        "examples": [
                            {
                                "example_id": "2a9a8def-07a0-4376-89b4-cb08f3247a57",
                                "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                                "text": "Thou Wind, that ravest without, / Bare craig, or mountain-tairn, or blasted tree, / Or pine-grove whither woodman never clomb, / Or lonely house, long held the witches' home, / Methinks were fitter instruments for thee, / Mad Lutanist! [footnote: Tairn is a small lake, generally if not always applied to the lakes up in the mountains, and which are the feeders of those in the valleys.[…]]"
                            },
                            {
                                "example_id": "a5be7020-5b34-4029-aaf4-dffcf4bf678d",
                                "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                                "text": "It was possible, I reflected, that a mere different arrangement of the particulars of the scene [of the House of Usher], of the details of the picture, would be sufficient to modify, or perhaps to annihilate its capacity for sorrowful impression; and, acting upon this idea, I reined my horse to the precipitous brink of a black and lurid tarn that lay in unruffled lustre by the dwelling, and gazed down—but with a shudder even more thrilling than before—upon the re-modelled and inverted images of the gray sedge, and the ghastly tree-stems, and the vacant and eye-like windows."
                            },
                            {
                                "example_id": "3951e900-3ede-460b-b144-049a0411a5be",
                                "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                                "text": "Tarns are found in some of the vales, and are numerous upon the mountains. A Tarn, in a Vale, implies, for the most part, that the bed of the vale is not happily formed; that the water of the brooks can neither wholly escape, nor diffuse itself over a large area. Accordingly, in such situtions, Tarns are often surrounded by an unsightly tract of boggy ground; but this is not always the case, […]"
                            },
                            {
                                "example_id": "adf3d3bf-863d-41bb-8675-d9d1621d49d3",
                                "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                                "text": "There Grendel was watching his blood flow out into the seething tarn."
                            },
                            {
                                "example_id": "ff35c11b-2d99-4f52-a8b7-442c99fb2ea9",
                                "sense_id": "763ae3f4-4a12-3df9-ada0-2410903fb716",
                                "text": "In another story the remarkable mystery of the umbrella lost at the shores of a tarn and retrieved at the seaside is explained by the underground communication between the two."
                            }
                        ]
                    },
                    {
                        "sense_id": "be4e29d7-84e5-323f-ba33-7c8d0ec578a5",
                        "entry_id": "e0f007ea-9378-3d17-9a44-6831468da22f",
                        "glosses": [
                            "One of many small mountain lakes or ponds."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "fe6fd4f6-4b71-4de8-ac0a-39a7ac1fb0fd",
                                "sense_id": "be4e29d7-84e5-323f-ba33-7c8d0ec578a5",
                                "text": "It [the caribou] makes a fine, bold study on the foreground of an evening scene among the mountain tarns of Northern Idaho, as it fulfils the ideal description of the stag given by [Walter] Scott and other writers."
                            },
                            {
                                "example_id": "7f2dc4ea-d420-4368-bc0b-41bcfdaa8c9f",
                                "sense_id": "be4e29d7-84e5-323f-ba33-7c8d0ec578a5",
                                "text": "Have you ever been swimming in glacial water – water turned milky blue or deep maroon by minerals and deposits seized by the glacier as it ponderously made its way across a continent? You would have been high atop a mountain, maybe in the Canadian Rockies or in Montana, where glaciers, now in retreat, still press down on the earth's crust. And it would have been in the summer – late August perhaps – the sun warm and still and bright, making you feel as if a dip in this remote glacial tarn is just what your tired body needs at this point in your day."
                            },
                            {
                                "example_id": "663228ac-f77b-4e2a-b79c-c68a43912cc6",
                                "sense_id": "be4e29d7-84e5-323f-ba33-7c8d0ec578a5",
                                "text": "Off to either side of the road [Beartooth Highway], unforgettable mountain scenes arise beneath crisp mountain skies. Here is alpine country at its best, complete with lakes and tarns set amid truly rugged promontories."
                            }
                        ]
                    }
                ],
