                "senses": [
                    {
                        "sense_id": "49b796b1-15a0-3616-9b65-8026fe5faabb",
                        "entry_id": "24c0c099-f4d7-3b11-ba2a-bde3d1b646ae",
                        "glosses": [
                            "(Le sujet est une personne)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7cc1a676-0162-3532-9c7c-63ea4c29cd01",
                        "entry_id": "24c0c099-f4d7-3b11-ba2a-bde3d1b646ae",
                        "glosses": [
                            "(Le sujet est une personne)",
                            "Faire paître; faire pâturer (le bétail)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2f715fec-22d4-3a7b-9ad0-3f2d5bf96ce9",
                        "entry_id": "24c0c099-f4d7-3b11-ba2a-bde3d1b646ae",
                        "glosses": [
                            "(Le sujet est une personne)",
                            "Faire paître, faire pâturer du bétail."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "11126105-8c9f-4058-9c64-7f748897b29a",
                                "sense_id": "2f715fec-22d4-3a7b-9ad0-3f2d5bf96ce9",
                                "text": "Ceux qui passaient par la lande où il pacageait, voyaient de loin le garçon un livre au poing au milieu de ses ouailles."
                            },
                            {
                                "example_id": "3ae7ad7e-693a-42f6-8253-9b7e310208c0",
                                "sense_id": "2f715fec-22d4-3a7b-9ad0-3f2d5bf96ce9",
                                "text": "Il est permis de pacager en terre vaine et vague."
                            }
                        ]
                    },
                    {
                        "sense_id": "533f708a-8f76-3055-be03-4e9b11382258",
                        "entry_id": "24c0c099-f4d7-3b11-ba2a-bde3d1b646ae",
                        "glosses": [
                            "(Le sujet est un animal)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7336dc08-1ba7-3863-951f-cdc6b2eef00a",
                        "entry_id": "24c0c099-f4d7-3b11-ba2a-bde3d1b646ae",
                        "glosses": [
                            "(Le sujet est un animal)",
                            "Brouter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0b6bd6-33ad-4d89-818f-11e606753454",
                                "sense_id": "7336dc08-1ba7-3863-951f-cdc6b2eef00a",
                                "text": "Ce que nous savons du genre d’élevage pratiqué nous incite à penser que la récupération du fumier était faible. Les 20 à 30 millions de moutons pacageaient presque toute l'année sur les landes ; une faible part pacageait les jachères."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e545801-afb1-36fe-b0cb-9e0f609491d4",
                        "entry_id": "24c0c099-f4d7-3b11-ba2a-bde3d1b646ae",
                        "glosses": [
                            "(Le sujet est un animal)",
                            "Paitre."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "3bc62333-35d5-4984-b884-beaf504487a7",
                                "sense_id": "6e545801-afb1-36fe-b0cb-9e0f609491d4",
                                "text": "Les bestiaux qui pacagent à deux portées de fusil de son lit, disparaissent souvent dans les gouffres innombrables qui sont dans la prairie."
                            },
                            {
                                "example_id": "54c0daad-b324-448a-93a5-27ad38532e67",
                                "sense_id": "6e545801-afb1-36fe-b0cb-9e0f609491d4",
                                "text": "Dans le courant de 1849, la maladie apparut une seconde fois dans son bétail, qui pacageait sur la montagne du Trap."
                            },
                            {
                                "example_id": "a1fca752-7ee8-48d6-92c3-17535e6bc97c",
                                "sense_id": "6e545801-afb1-36fe-b0cb-9e0f609491d4",
                                "text": "Des joncs bordaient la sente. Impossible de s'écarter à cause des fondis et des ronciers. Les bestiaux ne pacageaient que dans les prés-clairières."
                            }
                        ]
                    }
                ],
