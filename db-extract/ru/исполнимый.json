                                        "entry_id": "1dfbc63b-28fd-334d-a140-91687c508c26",
                                        "glosses": [
                                            "Qui peut être exécuté, effectué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4073fd3f-7364-4453-809e-d9f3c6782b6c",
                                                "sense_id": "e9864dd9-8657-3f68-8979-bccd54b7a706",
                                                "text": "Ce projet n’est pas exécutable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exécutable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7e51717a-eb8b-3dd4-a6b7-bf16dad2c11d",
                                        "entry_id": "b39ebc58-12b2-3ee0-a170-539c99ea8aae",
                                        "glosses": [
                                            "Fichier contenant un programme informatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed78e355-4d4e-4a22-beca-95cd5bb863d1",
                                                "sense_id": "7e51717a-eb8b-3dd4-a6b7-bf16dad2c11d",
                                                "text": "Cet exécutable a été effacé parce qu’il contenait un virus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "324a13e5-e52d-45ef-ab20-ee47dfa01ae0",
                        "source_entry_id": "f3e51185-d235-3fe6-94f6-709787caf67b",
                        "source_sense_id": "ef323c60-6fec-3173-8787-b55fffafd306",
                        "target_lang_word": "réalisable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réalisable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfef66bd-aea0-3246-9401-46654fb7212c",
                                        "entry_id": "44a656b9-151d-3010-a946-300100153298",
                                        "glosses": [
                                            "Qui est susceptible de se réaliser, d’être réalisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f1ecac8-caf0-43b6-864e-fb8fa1c689bc",
                                                "sense_id": "dfef66bd-aea0-3246-9401-46654fb7212c",
                                                "text": "Il est donc légitime lorsque la foi et la raison semblent en désaccord, de tenir pour vraies les affirmations de la foi, puisque le miracle est chose toujours réalisable pour un Dieu tout-puissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4e57d4-ffbc-3541-b33f-5e1968f4e6c7",
                                        "entry_id": "44a656b9-151d-3010-a946-300100153298",
                                        "glosses": [
                                            "Que l’on peut convertir en liquidités."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebc3b8ba-2dd5-44d6-80ca-a34a3090661b",
                                                "sense_id": "ad4e57d4-ffbc-3541-b33f-5e1968f4e6c7",
                                                "text": "Une fortune facilement réalisable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
