                        "glosses": [
                            "To store (additional honey) in additional tiers or stories of a hive."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "83ecdde0-a264-4208-aa63-04657f08b13c",
                                "sense_id": "356bfb2a-60b4-31c9-926f-c3565750adc0",
                                "text": "The advocates for the storifying system boast, that it is highly favourable to the formation of artificial swarms; it should, however, be previously demonstrated, that any actual advantage is to be derived from an artificial swarm."
