                ],
                "senses": [
                    {
                        "sense_id": "6bcaadc4-9cd2-3e23-a4c7-ea4c0ed2adb3",
                        "entry_id": "29960b0c-ecd4-390e-8b05-7925afed32da",
                        "glosses": [
                            "Plusieurs et distincts les uns des autres."
                        ],
                        "tags": [],
                        "note": "Se dit de plusieurs personnes ou plusieurs choses qu’on ne désigne pas nommément et qui sont présentées seulement comme distinctes",
                        "examples": [
                            {
                                "example_id": "6963a170-c282-4b75-ba1a-5f97b8a2418f",
                                "sense_id": "6bcaadc4-9cd2-3e23-a4c7-ea4c0ed2adb3",
                                "text": "Ainsi tous les esprits doivent avoir quelques inclinations, de même que les corps ont différents mouvements."
                            },
                            {
                                "example_id": "157d535f-0465-46fb-8ccc-aac32765d64a",
                                "sense_id": "6bcaadc4-9cd2-3e23-a4c7-ea4c0ed2adb3",
                                "text": "Revenu à Paris en 1798, il fut employé à différents travaux littéraires et politiques par M. de Talleyrand, ministre des relations extérieures, et concourut à la rédaction du Messager du soir, et à celle de l’Argus, journal anglais auquel travaillait aussi Barère et Goldsmitz, et dont le ministère faisait les frais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7062599-21e5-4b6e-837f-5b720809c390",
                        "source_entry_id": "29960b0c-ecd4-390e-8b05-7925afed32da",
                        "source_sense_id": "6bcaadc4-9cd2-3e23-a4c7-ea4c0ed2adb3",
