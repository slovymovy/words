                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phrenologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1a60db-4b7d-3b31-970a-56cb8013a63d",
                                        "entry_id": "609c64b9-5b97-316f-b1ae-50525c6bdb71",
                                        "glosses": [
                                            "Anschauung, die aus der menschlichen Schädelform Rückschlüsse auf geistig-seelische Veranlagungen der betroffenen Person zu ziehen versucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df1e0ba-7c84-45ae-9498-a7d489201b77",
                                                "sense_id": "dd1a60db-4b7d-3b31-970a-56cb8013a63d",
                                                "text": "„Er erwähnt nun Albertus Magnus, Lodovico Dolci und Galenus und kommt dann auf Joseph Gall, den er den Altmeister der Phrenologie nennt und sogar über sich selbst stellt.“"
                                            },
                                            {
                                                "example_id": "551eab4b-35a8-4684-9468-f47ad074bec2",
                                                "sense_id": "dd1a60db-4b7d-3b31-970a-56cb8013a63d",
                                                "text": "„Gall ist heute so vergessen wie die von ihm begründete Lehre von der Phrenologie, mit deren Hilfe man unfehlbar den Charakter eines Menschen aus Schädelform und Aussehen des Gehirns bestimmen zu können vermeinte – bis weit über die Mitte des vorigen Jahrhunderts hinaus spielte sie eine große Rolle und wurde dann als unwissenschaftlich abgetan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae6bc98f-b3dd-3fb9-b938-f232801135ad",
                                        "entry_id": "609c64b9-5b97-316f-b1ae-50525c6bdb71",
                                        "glosses": [
                                            "die Lehre vom Schädelbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd22148-8ca3-4624-8666-565c75db0508",
                                                "sense_id": "ae6bc98f-b3dd-3fb9-b938-f232801135ad",
                                                "text": "„Zum Methodenspektrum gehörten die Schädelvermessung (Kraniometrie) und die Phrenologie, eine Art Gehirnkartografie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
