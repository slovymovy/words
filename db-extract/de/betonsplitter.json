                        "examples": [
                            {
                                "example_id": "e4f049c1-5b24-4a27-be71-ad449ef0046e",
                                "sense_id": "4edd260f-4488-3296-a051-94946b7c9c5a",
                                "text": "„Der erste Schlag verfehlt das Schloss, die Schaufel rutscht von der Tür ab und knallt auf die Eingangsstufe; sie vibriert in seinen Händen, Betonsplitter spritzen hoch und bohren sich in seine Lippe.“"
                            },
                            {
                                "example_id": "5ae9c4a5-af53-483e-a843-e17c9ae56502",
                                "sense_id": "4edd260f-4488-3296-a051-94946b7c9c5a",
                                "text": "„Um sie herum wirbelten die abprallenden Kugeln Dreck und Betonsplitter auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
