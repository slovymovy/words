                                    {
                                        "sense_id": "5a8164e3-33b2-35b4-baaf-34444073fe04",
                                        "entry_id": "7d1873e4-e6e2-3c1d-93a5-486445e922c0",
                                        "glosses": [
                                            "einfältig bis verrückt"
                                        ],
                                        "tags": [
                                            "teilweise veraltet",
                                            "teilweise regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55dd9e22-a763-45d5-bd63-95230930188a",
                                                "sense_id": "5a8164e3-33b2-35b4-baaf-34444073fe04",
                                                "text": "Sind hier denn alle toll geworden?"
                                            },
                                            {
                                                "example_id": "0aa3368f-7c21-4fd6-b058-4b5639b189c3",
                                                "sense_id": "5a8164e3-33b2-35b4-baaf-34444073fe04",
                                                "text": "„Die besten Kapitel von >Lotte in Weimar< habe ich unter den unerfahrenen, nicht zu beschreibenden Qualen einer wohl über ein halbes Jahr sich hinziehenden infektiösen Ischias geschrieben, den tollsten Schmerzen, die ich je ausgestanden und denen zu entgehen man Tag und Nacht vergebens nach der rechten Position sucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca83adcd-c9df-366e-9819-786b3e55b4d3",
                                        "entry_id": "7d1873e4-e6e2-3c1d-93a5-486445e922c0",
                                        "glosses": [
                                            "an Tollwut erkrankt, tollwütig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66417577-9801-45de-85f3-881d539e0e21",
                                                "sense_id": "ca83adcd-c9df-366e-9819-786b3e55b4d3",
                                                "text": "Der Problembär wurde abgeschossen wie ein toller Hund."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b9355f4b-5341-3f57-a7fe-1c5585c20df7",
                                        "entry_id": "7d1873e4-e6e2-3c1d-93a5-486445e922c0",
                                        "glosses": [
                                            "großartig (Ausdruck der Bewunderung)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73e15ec4-d698-424d-99fb-b9d7029460ff",
                                                "sense_id": "b9355f4b-5341-3f57-a7fe-1c5585c20df7",
                                                "text": "Das Konzert war einfach toll."
                                            },
                                            {
                                                "example_id": "f6616e6f-93b2-4efd-8d56-abfdf77ba2e9",
                                                "sense_id": "b9355f4b-5341-3f57-a7fe-1c5585c20df7",
                                                "text": "Und so ein Ergebnis nennst du toll? Das ist ja wirklich toll, herzlichen Glückwunsch auch!"
                                            },
                                            {
                                                "example_id": "909d4530-4c42-426b-ba20-ac08c60b47f8",
                                                "sense_id": "b9355f4b-5341-3f57-a7fe-1c5585c20df7",
                                                "text": "„Am tollsten war aber: Die Mama hielt sie endlich für alt genug, sie ins Theater und in die Oper zu begleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
