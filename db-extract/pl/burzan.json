                                        "entry_id": "8c99378d-76cc-3818-bb90-b731e6f1687f",
                                        "glosses": [
                                            "собир. высокая, обычно крупностебельная сорная трава"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7787dcc6-286a-40b7-b228-89b80ef42c0c",
                                                "sense_id": "d246721c-db01-374d-a55a-994ffd865e78",
                                                "text": "Грустно шуршали мёртвые бурьяны, лопухи, полынь, пушица, хилый камыш и осока в придорожных обочинах."
                                            }
                                        ]
