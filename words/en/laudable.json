                        {
                            "text": "Fresh air and exercise are <w>laudable</w> factors in maintaining a strong immune system.",
                            "target_lang_translations": {
                                "zh": "新鲜空气和锻炼是维持强大免疫系统<w>有益健康的</w>因素。"
                            }
                        }
                    ],
                    "synonyms": [
