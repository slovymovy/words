                "senses": [
                    {
                        "sense_id": "1bdfcd66-347d-3784-b68c-208cc1f8af11",
                        "entry_id": "b320feca-9707-3ef0-ba84-9664f23ba11f",
                        "glosses": [
                            "een tekst die dieper dan het oppervlak van een voorwerp ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ecf900-3f8e-4844-b48a-2dd2b9b6d71d",
                                "sense_id": "1bdfcd66-347d-3784-b68c-208cc1f8af11",
                                "text": "‘Het inschrift B.E.H.BOSON, de namen van de wetenschappers en de data 1964 en 2014 vervolledigen de grafische compositie’, meldde de FOD Financiën."
                            },
                            {
                                "example_id": "e915e86d-1266-4286-a9e5-93d2b93672bf",
                                "sense_id": "1bdfcd66-347d-3784-b68c-208cc1f8af11",
                                "text": "Britse codebrekers zeggen dat ze een raadsel rond de heilige graal hebben opgelost. Een mysterieus 18e eeuws inschrift in een monument blijkt geen verwijzing naar de beker van Jezus, meldden Britse media donderdag."
                            },
                            {
                                "example_id": "a412309f-c76c-4332-bbe2-0d0fd63e5323",
                                "sense_id": "1bdfcd66-347d-3784-b68c-208cc1f8af11",
                                "text": "De onderzoekers vonden in dit bouwwerk een op een scarabee lijkend zegel met een afmeting van 1,1 bij 1,4 centimeter. Op het zegel staat een afbeelding van granaatappels en een inschrift in oud-Hebreeuws met de woorden: ”voor Netanyahu ben Yaush”."
                            }
                        ]
                    }
