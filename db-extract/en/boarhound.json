                                    {
                                        "sense_id": "f04b44dc-c20c-37eb-875e-a6093c8f2b73",
                                        "entry_id": "c79f2b29-3029-35a7-b3c3-7c88114ee42d",
                                        "glosses": [
                                            "große, kräftige Hunderasse, die besonders als Wachhund gehalten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "497cc447-3630-4375-8620-f44daa4c888c",
                                                "sense_id": "f04b44dc-c20c-37eb-875e-a6093c8f2b73",
                                                "text": "„Ein Gast saß in einem Restaurant und die riesige Dogge eines Nachbars beschnupperte ihn.“"
                                            },
                                            {
                                                "example_id": "deca824a-e43c-4e88-9491-d5fd5b1f12db",
                                                "sense_id": "f04b44dc-c20c-37eb-875e-a6093c8f2b73",
                                                "text": "„Im Tierheim hatte die Dogge offenbar gelitten.“"
                                            },
                                            {
                                                "example_id": "e5ab1a16-a46c-441e-abbb-29ecd56cb7e4",
                                                "sense_id": "f04b44dc-c20c-37eb-875e-a6093c8f2b73",
                                                "text": "„Im Jahr darauf schaffte sie sich einen Hund an, eine unmäßig große Dogge, die, betrat nur ein Kerl das Zimmer, schon mit den Zähnen fletschte.“"
                                            },
                                            {
                                                "example_id": "037e5d7b-2090-4ff7-9883-dba86a39d492",
                                                "sense_id": "f04b44dc-c20c-37eb-875e-a6093c8f2b73",
                                                "text": "„Die Doggen bellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
