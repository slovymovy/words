                "senses": [
                    {
                        "sense_id": "179226ec-e3aa-309c-ae3e-09e7f34359b6",
                        "entry_id": "4133366c-9a1e-35f4-afd8-65302bb99328",
                        "glosses": [
                            "Kriegsschiff, das Seeminen beseitigt und damit für andere Schiffe die Fahrt ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56d937f1-2e9d-41a5-920e-7813d47b032d",
                                "sense_id": "179226ec-e3aa-309c-ae3e-09e7f34359b6",
                                "text": "„Beide Boote warteten nun vor der Hafeneinfahrt auf Geleitschutz durch Sperrbrecher und Minenräumboote, denn die Einfahrt wurde immer wieder von feindlichen Flugzeugen oder U-Booten mit Minen belegt.“"
                            },
                            {
                                "example_id": "e6551dd6-7091-41f2-9f21-dd4d32f06843",
                                "sense_id": "179226ec-e3aa-309c-ae3e-09e7f34359b6",
                                "text": "„Die wissen also Bescheid, da wird ja wohl der Sperrbrecher rechtzeitig am Treffpunkt erscheinen.“"
                            },
                            {
                                "example_id": "4c74621e-9b52-4f6b-a882-7b88ad45c1a7",
                                "sense_id": "179226ec-e3aa-309c-ae3e-09e7f34359b6",
                                "text": "„Bei strömendem Regen schlichen wir in der Nacht zum 30. Juni hinter unseren Sperrbrechern aus dem Hafen von Lorient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
