                "senses": [
                    {
                        "sense_id": "bb2b6517-fb07-3797-b40e-385cb22c6bd5",
                        "entry_id": "a42eaa01-b16d-3556-ad1e-e947e6ef1961",
                        "glosses": [
                            "Eingangstor zu einem Garten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe36b0a6-c610-4a23-8d8e-f295bb1183e8",
                                "sense_id": "bb2b6517-fb07-3797-b40e-385cb22c6bd5",
                                "text": "Der Hund lief weg, weil die Gartenpforte offen war."
                            },
                            {
                                "example_id": "96288ffe-42a0-43eb-ac90-060792464ba5",
                                "sense_id": "bb2b6517-fb07-3797-b40e-385cb22c6bd5",
                                "text": "„Man könnte die kräftigen Vierkantstücke aus den Trümmern ziehen, sie zu Zaunpfählen verarbeiten, zu Gartenpforten oder als Abdeckbohlen auf Jauchegruben legen.“"
                            },
                            {
                                "example_id": "843ec6ea-49cc-446f-892a-5eae0a7e5d81",
                                "sense_id": "bb2b6517-fb07-3797-b40e-385cb22c6bd5",
                                "text": "„Nahe der Gartenpforte zu Annas Elternhaus blieben die beiden stehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
