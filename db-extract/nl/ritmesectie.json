                        "glosses": [
                            "deel van een bandje of orkest dat het ritme van een muziekstuk aangeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e37d1a8-1741-4fde-a7e0-e6ddd15fa800",
                                "sense_id": "937e6566-49dc-303c-9d32-7abf1888aec0",
                                "text": "En ik heb Teddy een keer tegen een andere producer horen zeggen dat Pete en Wanen nog eens uit zouden groeien tot de beste ritmesectie in de rockwereld."
                            },
                            {
                                "example_id": "49c6838c-1e3c-4453-8bd7-6317cac24ae7",
                                "sense_id": "937e6566-49dc-303c-9d32-7abf1888aec0",
                                "text": "Het nieuwe arrangement is in lagen opgenomen: eerst de ritmesectie, daarna de synthesizers, blazers en strijkers, tot slot de trompetten. Daar is voor gekozen om de tune perfect zuiver te krijgen. \"We kunnen het zo live spelen met z'n allen, maar als je het elke dag hoort, dan hoor je onvolkomenheden\", aldus de dirigent."
                            }
                        ]
                    }
