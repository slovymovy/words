    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                "word": "micron",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "495fdc50-f790-497c-901c-0ac04feb22d2",
                        "entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "microns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                        "entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                        "glosses": [
                            "Synonym of micrometre (“one-millionth of a metre”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227b7984-8b14-4152-9c3e-00907e61b683",
                                "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                "text": "2009, Jonathan Amos, (bbc.co.uk) Satellites weigh California water\nAs one spacecraft lurches and drags through the Earth's uneven gravity field, the second follows 210 km behind, measuring changes in their separation to the nearest micron (a thousandth of a millimetre)."
                            },
                            {
                                "example_id": "17603cc7-b946-49bf-b897-710f762125f0",
                                "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                "text": "The microcannon was seen moving at about a micron per second, it was about 15 microns long, and the high speed photograph was done in water (density of 1 kg/L, viscosity of about 0.001 pascal seconds)."
                            },
                            {
                                "example_id": "891c88e4-210f-4a1b-b6ea-555eb3694983",
                                "sense_id": "8214c6c2-d63f-3e6c-83e2-034d0860d57d",
                                "text": "Little pozzolanic reaction is evident for glass above 300 microns but the pozzolanic activity increases as the particle size is reduced below this size with good pozzolanic properties generally being achieved below about 45 microns (Federico & Chidiac 2009). […] In a second mix 20% of the Portland cement was replaced with the same Vycor glass which was ground to pass 45-micron (median particle size ~ 10 micron)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e7ad834-1f11-31d9-a443-ebf96950342f",
                        "entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                        "glosses": [
                            "A very tiny amount."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "730ff975-5788-45fa-be7c-9e1b4fc01805",
                        "source_entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                        "source_sense_description": "micrometer",
                        "target_lang_word": "mikron",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mikron",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c0c16f5b-1592-3878-b0f7-39410718d037",
                                        "entry_id": "ee334f4c-629e-38c1-b295-dc442e075567",
                                        "glosses": [
                                            "miliontina metru; mikrometr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c6dc44-7d88-43c8-989d-077a8ecb9e31",
                                                "sense_id": "c0c16f5b-1592-3878-b0f7-39410718d037",
                                                "text": "Nejteplejší prach září na vlnových délkách kolem 3,6 až 8 mikronů, nejchladnější mezi 70 až 160 mikrony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e75dc8c-2555-4ede-83dc-35da47f69855",
                        "source_entry_id": "385576f0-bc31-32e7-9cf3-aa1bcd7e01fe",
                        "source_sense_description": "micrometer",
                        "target_lang_word": "micron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "micron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09a46dc7-8624-3903-8152-8f335f1a6022",
                                        "entry_id": "ac0c4bf2-fae7-3880-b1f1-6e5ba1e01a48",
                                        "glosses": [
                                            "Micromètre. Ancienne Unité de longueur utilisée pour les observations au microscope et équivalant à la millième partie du millimètre. Le symbole est μ."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03988cf6-2bf8-4d4d-9fee-f854093b697c",
                                                "sense_id": "09a46dc7-8624-3903-8152-8f335f1a6022",
                                                "text": "Il faut y ajouter les cendres vitrifiées de moteurs Diesel (grandes de 1 à 5 microns, en général, avec 5 à 10 % de plus gros que 5 microns)."
                                            },
                                            {
                                                "example_id": "b51431ff-0d9b-4996-94b1-0b7603eb5506",
                                                "sense_id": "09a46dc7-8624-3903-8152-8f335f1a6022",
                                                "text": "Ils contiennent moins de 50 % d'éléments de diamètre supérieur à 500 microns. La fraction dominante est celle comprise entre 315 et 160 microns."
                                            },
                                            {
                                                "example_id": "767d44be-ebf2-425e-bb00-5bdfdad7b47d",
                                                "sense_id": "09a46dc7-8624-3903-8152-8f335f1a6022",
                                                "text": "Enfin, la mécanique de haute précision, employée par exemple en horlogerie ou en chirurgie dentaire, faisait intervenir le titane ; la tolérance des cotes était alors de l’ordre du micron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
