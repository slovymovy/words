                        "target_lang_word": "abziehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abziehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf55a436-61b0-38ba-9670-8e0bc72e5aaa",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "sich entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6bff3bc-bff5-4e2a-b8d5-7e52a19139ad",
                                                "sense_id": "bf55a436-61b0-38ba-9670-8e0bc72e5aaa",
                                                "text": "Die Polizei konnte endlich abziehen."
                                            },
                                            {
                                                "example_id": "55cff942-d3ae-45ea-b9a4-9818acdf856f",
                                                "sense_id": "bf55a436-61b0-38ba-9670-8e0bc72e5aaa",
                                                "text": "„Die beharrliche Strategie des Quintus Fabius Maximus, die Siege des Marcus Claudius Marcellus in Sizilien, die Erfolge des Publius Cornelius Scipio in Hispanien und das militärische Geschick des Marcus Livius Salinator und Gaius Claudius Nero in Italien brachten den immer noch unbesiegten Hannibal in Bedrängnis und zwangen ihn, aus Italien abzuziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77dd0601-7067-380a-82fb-5c4d94094e0c",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "etwas von etwas herunter-, wegziehen oder entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905db1ca-0d8f-42bf-894f-8b19dde97b3a",
                                                "sense_id": "77dd0601-7067-380a-82fb-5c4d94094e0c",
                                                "text": "Dem Kaninchen wurde das Fell abgezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4313c242-f41a-3854-b314-61068ab2dbb5",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "subtrahieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af78ad1-334a-421d-8737-9405fdc219c5",
                                                "sense_id": "4313c242-f41a-3854-b314-61068ab2dbb5",
                                                "text": "Wenn man zwei von drei abzieht, bleibt eins übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6ec9919e-3e9b-3127-9834-b782a809918c",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "durch Reibung schärfen"
                                        ],
                                        "tags": [
                                            "ein Messer",
                                            "Klinge"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1744a4f-d443-43b4-970b-56e53d7aa908",
                                                "sense_id": "6ec9919e-3e9b-3127-9834-b782a809918c",
                                                "text": "Er zog das Messer ab. Danach war es wieder scharf."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2d4b31d3-7264-33c4-b4f7-764c708da955",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "stehlen oder rauben"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "717899bf-2821-46e7-931d-4d045b6824d1",
                                                "sense_id": "2d4b31d3-7264-33c4-b4f7-764c708da955",
                                                "text": "Es ist eine üble Sitte unter Jugendlichen, dass sie andere abziehen."
                                            },
                                            {
                                                "example_id": "717269f7-aa85-4cd2-a8cf-41fc15c652bf",
                                                "sense_id": "2d4b31d3-7264-33c4-b4f7-764c708da955",
                                                "text": "„Abziehen ist eine Straftat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "56b1c3c0-e1b5-3fbe-a41e-efd0ed6d52f6",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "eine Fotokopie erstellen, einen Abzug machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91694506-82b4-4383-bea5-e02488333e5f",
                                                "sense_id": "56b1c3c0-e1b5-3fbe-a41e-efd0ed6d52f6",
                                                "text": "Kann ich mir das Handout kurz abziehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "eba33c98-e99e-35ca-b2f3-cc51bc226f4e",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "die Spülung einer Toilette betätigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed5be16f-92f3-4c5b-a957-5be2723d0dca",
                                                "sense_id": "eba33c98-e99e-35ca-b2f3-cc51bc226f4e",
                                                "text": "Du hast schon wieder vergessen abzuziehen!"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "41688a08-8131-3206-9ffc-21e7f9c5b6a0",
                                        "entry_id": "93805722-45fb-3ca8-8aa6-51a564e3df89",
                                        "glosses": [
                                            "eine Vorstellung geben, eine Szene machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684b1827-aafa-4c2b-bae4-2921d24df120",
                                                "sense_id": "41688a08-8131-3206-9ffc-21e7f9c5b6a0",
                                                "text": "\"Echt schlimm, was sie gestern mit dir abgezogen haben!\""
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
