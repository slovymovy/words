                "senses": [
                    {
                        "sense_id": "a8efae6a-f65e-36dd-8152-c3fc6b7c76ce",
                        "entry_id": "61855f73-5578-3b7b-b658-4188573ffd6e",
                        "glosses": [
                            "вынужденное проживание кого-либо где-либо, отсутствие разрешения на выезд откуда-либо"
                        ],
                        "tags": [],
