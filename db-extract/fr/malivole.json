                "senses": [
                    {
                        "sense_id": "e7b66100-46f5-393b-98ff-a1425d6dab82",
                        "entry_id": "27ce3fe7-3a92-3beb-91bb-05e6b4eb7fd5",
                        "glosses": [
                            "Malveillant ; malintentionné."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "0c04ede8-dee7-44a0-a4fa-be725cedb0da",
                                "sense_id": "e7b66100-46f5-393b-98ff-a1425d6dab82",
                                "text": "[…] selon le sage Salomon, sapience n'entre point en âme malivole & science sans conscience n'est que ruine de l’âme , […]."
                            },
                            {
                                "example_id": "faa0646c-6e9d-4935-a4cb-f952ac3d75ea",
                                "sense_id": "e7b66100-46f5-393b-98ff-a1425d6dab82",
                                "text": "[…] ; et y si l'on savait au milieu de quoi , Monestau vint interrompre la jolie Provençale , toutes les femmes se récrieraient sur l'inconvenance de Monestan , et peut-être sur celle que je commets, en dévoilant de pareils forfaits qui pourraient servir de vengeance à des maris malivoles."
                            },
                            {
                                "example_id": "8df8d34c-53cb-4787-a3b8-7cd40cc8cdc6",
                                "sense_id": "e7b66100-46f5-393b-98ff-a1425d6dab82",
                                "text": "Vous n'êtes qu'âmes malivoles promptes à torturer mais oncques à pardonner. Ce ne sont point les Albigeois qui me contrediront. Que peste soit de vous et de votre Ordre."
                            },
                            {
                                "example_id": "593b2d2d-d863-44bc-b203-f1aa93326387",
                                "sense_id": "e7b66100-46f5-393b-98ff-a1425d6dab82",
                                "text": "Ce serait du moins à tenter d'établir, pour le moins en esquisses bénévoles ou malivoles : par l'essai d'application de notre modélisation, en « double hélice », étayées sur neuf « génératrices », à des époques historiques et au dessin des modalités de civilisation qui s'y sont incrustées."
                            }
                        ]
                    }
