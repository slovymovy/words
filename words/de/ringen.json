                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die verzweifelte Mutter <w>rang</w> die Hände, als sie die schlechte Nachricht hörte."
                        },
                        {
                            "text": "Man sollte nicht tatenlos die Hände <w>ringen</w>, sondern sofort nach Hilfe suchen."
                        }
                    ],
                    "common_phrases": [
