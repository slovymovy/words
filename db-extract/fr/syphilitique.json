                                        "sense_id": "b3507a73-f5fe-397a-a681-2ac3ef7749c0",
                                        "entry_id": "f84b14de-8ab2-37b2-8d1b-9a2bfd2f09e4",
                                        "glosses": [
                                            "A person with syphilis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76692cf7-b9f6-4d30-845c-a0ff4b6153f4",
                                                "sense_id": "b3507a73-f5fe-397a-a681-2ac3ef7749c0",
                                                "text": "It was a syphilitic who lived alone in the shanty between the hole and the railroad yard, coming up to the street only to beg money for food and disinfectant with which to soak his rags."
                                            }
