                                    {
                                        "sense_id": "0955044c-31d8-379b-a188-13fd3b4bca61",
                                        "entry_id": "9b6566f1-f316-3804-9100-c92c66abf3ff",
                                        "glosses": [
                                            "eine Abfolge von Zimmern, die durch Türen miteinander verbunden sind"
                                        ],
