                        "form": "die Prosodie"
                    },
                    {
                        "form_id": "f6a32500-14d9-4d56-b6dc-338918a4d035",
                        "entry_id": "013e0222-7502-34e6-b094-eb92962cfdc9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Prosodien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82add044-1663-377b-90ab-3ffa6f34e8a1",
                        "entry_id": "013e0222-7502-34e6-b094-eb92962cfdc9",
                        "glosses": [
                            "der Teilbereich der Phonologie, der sich mit den sprachlichen Merkmalen beschäftigt, die über einfache Phoneme hinausgehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc2916a-92a7-4b7b-8752-04648af035a2",
                                "sense_id": "82add044-1663-377b-90ab-3ffa6f34e8a1",
                                "text": "Die Prosodie beschäftigt sich unter anderem mit Akzent, Betonung, Sprechpausen, Sprechrhythmus, Sprechtempo."
                            },
                            {
                                "example_id": "3fc94a57-70d9-42bd-8f81-e047d1b9129b",
                                "sense_id": "82add044-1663-377b-90ab-3ffa6f34e8a1",
                                "text": "„Die Prosodie bezieht sich auf rhythmische und melodische Aspekte in Sprache und ist eines der Qualitätsmaße, welches über das reine Sprachverstehen hinaus bei der Beurteilung technischer Hörhilfen, insbesondere von Kochleaimplantaten, zunehmendes Interesse erlangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "15fb3cb3-349e-30b5-803d-64157761ca81",
                        "entry_id": "013e0222-7502-34e6-b094-eb92962cfdc9",
                        "glosses": [
                            "die Eigenschaften des Sprechens, die über die einzelnen Laute/Phoneme hinausgehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164cc283-3ff0-44ba-aa7e-13ce98b44a55",
                                "sense_id": "15fb3cb3-349e-30b5-803d-64157761ca81",
                                "text": "„Im Falle von sprachlichen Dialogen handelt es sich um sog. Prosodien, d.h. Stimmmodulationen, die die Interaktion zwischen Kommunikationspartnern stark beeinflussen.“"
                            },
                            {
                                "example_id": "e97e4de4-dfbd-4340-bb5a-ddc65c3e4bf9",
                                "sense_id": "15fb3cb3-349e-30b5-803d-64157761ca81",
                                "text": "„Wird dieser strukturelle Unterschied in der Prosodie nicht beachtet, wirken die von den Lernern produzierten Äußerungen für dänische Ohren nicht nur zu monoton, sondern auch zu wenig syntaktisch strukturiert.“"
                            },
                            {
                                "example_id": "b934bfde-3f04-4e84-998f-d549af6a6ed5",
                                "sense_id": "15fb3cb3-349e-30b5-803d-64157761ca81",
                                "text": "„Die drei Forscher fokussierten in ihrer Arbeit v. a. die Lexik und Prosodie des sprachlichen Materials, erkannten aber auch z. B. die interaktionale Bedeutung von Pausen, Rückmelde- und Verzögerungseinheiten etc., die Notwendigkeit einer genauen Transkription und die Relevanz einer äußerungsorientierten Beschreibung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8a7255fa-f761-3014-8f1c-9b848e6b19e5",
                        "entry_id": "013e0222-7502-34e6-b094-eb92962cfdc9",
                        "glosses": [
                            "Lehre von den mess- und qualifizierbaren Aspekten dichterischer Sprache"
                        ],
                        "tags": [
                            "Sprachwissenschaft",
                            "beziehungsweise",
                            "Verslehre"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cf73b3b-cf3c-44b9-a01b-36485103d01b",
                        "source_entry_id": "013e0222-7502-34e6-b094-eb92962cfdc9",
                        "source_sense_id": "82add044-1663-377b-90ab-3ffa6f34e8a1",
                        "target_lang_word": "prosody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                        "entry_id": "62c4e873-6c4b-35a3-a859-9343a4620552",
                                        "glosses": [
                                            "The study of rhythm, intonation, stress, and related attributes in speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d35cc23-e285-48fa-a139-9591fd8d37bb",
                                                "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                                "text": "An accurate acquaintance with the Prosody and Metres of the Greek Language is so necessary an accompaniment of true scholarship, that any attempt to advocate its claims to the notice of the student would be entirely superfluous."
                                            },
                                            {
                                                "example_id": "a67cf2cb-8129-4ce6-b3d8-ba2ceb54b30a",
                                                "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                                "text": "The aim of this book is to answer the question WHAT DID GREEK PROSODY SOUND LIKE? The study of prosody stands at the intersection of a number of quite disparate disciplines, as illustrated in the diagram overleaf."
                                            },
                                            {
                                                "example_id": "17245299-6566-426d-8a0c-cdc1a5674b0e",
                                                "sense_id": "fa93aecb-b8a7-3398-b943-3a3fe9019ffb",
                                                "text": "2007, Jackson T. Gandour, Neural substrates underlying the perception of linguistic prosody, Tomas Riad, Carlos Gussenhoven (editors), Tones and Tunes, Volume 2: Experimental Studies in Word and Sentence Prosody, De Gruyter (Mouton de Gruyter), page 3,\nBrain imaging data shows us moreover that we have to go beyond linguistic units themselves to gain a full understanding of how prosody is processed in the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "134c02e8-3e92-3e3e-97cb-6a2a2c1ed770",
                                        "entry_id": "62c4e873-6c4b-35a3-a859-9343a4620552",
                                        "glosses": [
                                            "The study of poetic meter; the patterns of sounds and rhythms in verse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24a3a3f7-ba9c-46df-b979-bf59a2805e67",
                                                "sense_id": "134c02e8-3e92-3e3e-97cb-6a2a2c1ed770",
                                                "text": "But the system of prosody in Samson plainly forbids extrametrical syllables in the midst of the line, and there is certainly no other example."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f202e67-da4f-4757-9daa-b3e7365b501c",
                        "source_entry_id": "013e0222-7502-34e6-b094-eb92962cfdc9",
                        "source_sense_id": "82add044-1663-377b-90ab-3ffa6f34e8a1",
