                    {
                        "translation_id": "7cce7c41-4e4a-4797-a58c-9dd703726ed0",
                        "source_entry_id": "80bc2638-a09c-3714-a927-411970b659af",
                        "source_sense_id": "cc7e4925-c2df-322d-82c4-df532c8ead2a",
                        "source_sense_description": "ein Staatsbürger Montenegros",
                        "target_lang_word": "Monténégrin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monténégrin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50eef0e8-20fd-378d-91db-65a61474306f",
                                        "entry_id": "12510a9d-a489-3e29-a4f5-52a60ce8be36",
                                        "glosses": [
                                            "Habitant du Monténégro ^([1])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305eaffd-f47d-4d86-98f4-1d672633418c",
                                                "sense_id": "50eef0e8-20fd-378d-91db-65a61474306f",
                                                "text": "Par là passent à cheval quelques rares voyageurs ; par là cheminent à pied des bergers pittoresques, des Monténégrins descendus de leurs montagnes, des Albanais chassés par la guerre, des vagabonds venus on ne sait d’où."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "378f8371-078b-4a66-8911-847806db564f",
                        "source_entry_id": "80bc2638-a09c-3714-a927-411970b659af",
                        "source_sense_id": "cc7e4925-c2df-322d-82c4-df532c8ead2a",
                        "source_sense_description": "ein Staatsbürger Montenegros",
                        "target_lang_word": "черногорец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "черногорец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "801644fc-2f4f-3aa6-ab2e-33c9c01d200e",
                                        "entry_id": "a7decaee-6aaa-32cb-8a75-8f7f77ec073c",
                                        "glosses": [
                                            "представитель славяноязычного народа, составляющего основное население Черногории; житель или уроженец Черногории"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0a8ab7-2d78-4fa4-b4f3-e3b3b3f2e4b5",
                                                "sense_id": "801644fc-2f4f-3aa6-ab2e-33c9c01d200e",
                                                "text": "Кажется, в восемнадцатом веке часть рода Войновичей (черногорцы) поселилась в районе Которской бухты, где находился знаменитый Которский флот."
                                            },
                                            {
                                                "example_id": "8d82be0a-280e-4457-9683-c6d6f561e805",
                                                "sense_id": "801644fc-2f4f-3aa6-ab2e-33c9c01d200e",
                                                "text": "Больше всего понравилось спокойствие и ощущение беззаботности, которые не покидали нас во время всего пребывания в стране, размеренность жизни, отличная и недорогая еда, приветливое ненавязчивое отношение черногорцев к приезжим."
                                            },
                                            {
                                                "example_id": "ac6c962d-598e-4f45-8042-f5ab26298336",
                                                "sense_id": "801644fc-2f4f-3aa6-ab2e-33c9c01d200e",
                                                "text": "Годы напролёт черногорцы (в сущности, те же православные сербы) на рядовом гражданском уровне неоднократно выступали против попыток втянуть республику в НАТО — так что в Подгорице уместно вести разговор не о «евроскептицизме», а о негативном восприятии тезиса о «евроатлантизме» как панацее для Черногории."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
