                "senses": [
                    {
                        "sense_id": "925c2e59-08c9-3292-ab5b-15951d680419",
                        "entry_id": "3d385d01-a7b5-349a-94c1-dfc86e2f631d",
                        "glosses": [
                            "Not gained.",
                            "That one has not acquired possession of."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3bd65196-1c6a-4d16-b8bb-5b364487eb07",
                                "sense_id": "925c2e59-08c9-3292-ab5b-15951d680419",
                                "text": "Men prize the thing ungained more than it is;"
                            },
                            {
                                "example_id": "4e10949f-f56e-4b05-ae0e-495f853666ef",
                                "sense_id": "925c2e59-08c9-3292-ab5b-15951d680419",
                                "text": "The streams run on, in bold, malicious haste, His lip can touch the fruit, but cannot taste; In vain he struggles from his chain to burst The stream, the fruit's ungained—unquenched his thirst!"
                            },
                            {
                                "example_id": "aea58370-3c1c-4edb-9828-822b4b688049",
                                "sense_id": "925c2e59-08c9-3292-ab5b-15951d680419",
                                "text": "To refer to something ungained seems impossible in an ordinary way, but we can simulate the time evolution by the method called \"generate-and-search\"."
                            },
                            {
                                "example_id": "26483195-a728-4f10-8c0b-84c851a3e674",
                                "sense_id": "925c2e59-08c9-3292-ab5b-15951d680419",
                                "text": "ungained advantage"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3ad1e71-db24-36a8-ba66-c8732b873109",
                        "entry_id": "3d385d01-a7b5-349a-94c1-dfc86e2f631d",
                        "glosses": [
                            "Not gained.",
                            "Not reached."
                        ],
                        "tags": [
                            "not-comparable"
