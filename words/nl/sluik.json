                        "glad"
                    ],
                    "antonyms": [
                        "krullend",
                        "golvend"
                    ],
                    "common_phrases": [
                        "sluik haar"
                    ],
                    "target_lang_definitions": {
                        "en": "Smooth and hanging straight down, usually said of hair.",
                        "de": "glatt und gerade nach unten hängend, meist von Haaren gesagt"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "of hair, not curly"
                            },
                            {
                                "target_lang_word": "lank",
                                "target_lang_sense_clarification": "long, limp, and straight hair"
                            },
                            {
                                "target_lang_word": "smooth",
                                "target_lang_sense_clarification": "even and without curls"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "glatt",
                                "target_lang_sense_clarification": "von Haaren, ohne Locken oder Wellen"
                            },
                            {
                                "target_lang_word": "strähnig",
                                "target_lang_sense_clarification": "herabhängend, oft kraftlos oder feucht wirkend"
                            },
                            {
