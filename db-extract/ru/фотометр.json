                    {
                        "translation_id": "8609fac6-598e-4582-ba8a-906c0067e5f8",
                        "source_entry_id": "a3319d54-56ea-36fa-a566-5a4781c1dae7",
                        "source_sense_id": "e21cb3b3-9f0a-3080-bc8c-0566eb6e6de4",
                        "target_lang_word": "Fotometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fotometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2044c74d-7ddb-3f55-a2a5-bade56f44a7a",
                                        "entry_id": "a1450f7c-227f-3db5-8654-77f4cd4657c4",
                                        "glosses": [
                                            "Gerät zur Bestimmung der Lichtstärke, der Leuchtdichte oder dergleichen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ae8c41-26fa-443f-a6c2-bb52e79f74d5",
                                                "sense_id": "2044c74d-7ddb-3f55-a2a5-bade56f44a7a",
                                                "text": "„Ein farbloses Substrat wird mit H2O2 durch dieses Enzym oxidiert und so in ein mit einem Fotometer zu messendes Produkt umgewandelt.“"
                                            },
                                            {
                                                "example_id": "36d354bf-1b27-4584-a547-6ec84b21822b",
                                                "sense_id": "2044c74d-7ddb-3f55-a2a5-bade56f44a7a",
                                                "text": "„In einem Fotometer wird zunächst aus dem Licht einer Lampe mit einem Monochromator nur Licht einer bestimmten Wellenlänge ausgewählt und durchgelassen […].“"
                                            },
                                            {
                                                "example_id": "cb1c57e1-5f4d-455d-a7d9-096cf825ddd7",
                                                "sense_id": "2044c74d-7ddb-3f55-a2a5-bade56f44a7a",
                                                "text": "„Zöllner arbeitete hauptsächlich im Bereich der Fotometrie, insbesondre konstruierte er einen Fotometer, der noch heute nach ihm benannt wird.“"
                                            },
                                            {
                                                "example_id": "bc4ca15e-4405-4929-99ef-3a4e1f645fff",
                                                "sense_id": "2044c74d-7ddb-3f55-a2a5-bade56f44a7a",
                                                "text": "„Das Licht der einzelnen Sterne, welches das Keplerteleskop sammelt, wird von einem Fotometer gemessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
