                "senses": [
                    {
                        "sense_id": "da65d683-8dde-368f-a8e1-e0a6df7edfdb",
                        "entry_id": "517b03bd-c94c-3ff8-a19f-c767a7af593b",
                        "glosses": [
                            "een weg die als een ring rond een bepaald gebied ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab925322-df90-4643-888f-b84cef01d362",
                                "sense_id": "da65d683-8dde-368f-a8e1-e0a6df7edfdb",
                                "text": "Op kaarten van de Intergewestelijke Cel Leefmilieu (Ircel) zie je dat in de stedelijke gebieden en rond de autosnelwegen de hoogste roetwaarden opgetekend worden, met jaargemiddelden hoger dan 1,5 microgram per kubieke meter. Uitschieters zijn de ringwegen rond Brussel en Antwerpen."
                            },
                            {
                                "example_id": "783339d3-e3d1-4625-a7a4-124881ec78ea",
                                "sense_id": "da65d683-8dde-368f-a8e1-e0a6df7edfdb",
                                "text": "De nieuwe vaarroutes zijn onder meer nodig door de komst van twee grote nieuwe windparken voor de kust van Zeeland. Je zou het kunnen vergelijken met de ringweg bij een grote stad, waar opeens een compleet nieuwe verkeerssituatie geldt met nieuwe af- en opritten, fly-overs en rijrichtingen."
                            }
                        ]
                    }
                ],
