            "senses": [
                {
                    "sense_id": "49d6277f-cfeb-3eb2-ac65-ae0951d41ad0",
                    "sense_definition": "Teleurgesteld en een beetje sip kijkend nadat iets tegenvalt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "teleurgesteld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jan keek een beetje <w>beteuterd</w> toen hij geen enkel cadeautje kreeg.",
                            "target_lang_translations": {
                                "fr": "Jan avait l'air un peu <w>déconfit</w> lorsqu'il n'a reçu aucun cadeau."
                            }
                        },
                        {
                            "text": "Het kind trok een <w>beteuterd</w> gezicht toen zijn ijsje op de grond viel.",
                            "target_lang_translations": {
                                "fr": "L'enfant a fait une tête <w>dépitée</w> quand sa glace est tombée par terre."
                            }
                        }
                    ],
                    "synonyms": [
                        "teleurgesteld",
                        "terneergeslagen",
                        "ontmoedigd"
                    ],
                    "common_phrases": [
                        "beteuterd gezicht",
                        "beteuterd kijken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Déçu et affichant un air dépité après une déconvenue."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "déconfit",
                                "target_lang_sense_clarification": "dépité, déçu"
                            },
                            {
                                "target_lang_word": "dépité",
                                "target_lang_sense_clarification": "déçu et contrarié"
                            },
                            {
                                "target_lang_word": "penaud",
                                "target_lang_sense_clarification": "l'air déçu et embarrassé"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95ee730b-4d9f-3c91-ba9f-23a73ec4da01",
                    "sense_definition": "Uit het veld geslagen, verbaasd of verlegen door een onverwachte wending.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onthutst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij stond <w>beteuterd</w> te kijken toen iedereen hem plotseling tegensprak.",
                            "target_lang_translations": {
                                "fr": "Il est resté tout <w>décontenancé</w> quand tout le monde l'a soudainement contredit."
                            }
                        },
                        {
                            "text": "Na de onverwachte kritiek bleef de presentator even <w>beteuterd</w> achter.",
                            "target_lang_translations": {
                                "fr": "Après ces critiques inattendues, le présentateur est resté un instant tout <w>penaud</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedremmeld",
                        "beduusd",
                        "onthutst",
                        "verlegen"
                    ],
                    "common_phrases": [
                        "beteuterd staan kijken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Déstabilisé, décontenancé ou gêné à la suite d'un imprévu."
                    },
                    "translations": {
