                        "sense_id": "9983c189-1526-3639-a9db-322262f86853",
                        "entry_id": "1628dfb9-d0d7-376b-a5c7-aa947c43f91d",
                        "glosses": [
                            "koude, uit de richting van het noordoosten komende wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9041726-1728-4757-8b46-58765f8aec3a",
                                "sense_id": "9983c189-1526-3639-a9db-322262f86853",
                                "text": "Zo ruilen wij de koude noordooster voor een veel zachtere variant uit het zuidoosten. Meteen het signaal voor een vroege lente."
                            },
                            {
                                "example_id": "6e293336-f7c0-47a0-8fcd-907d558b399b",
                                "sense_id": "9983c189-1526-3639-a9db-322262f86853",
                                "text": "Vanavond verdwijnen de stapelwolken en is het op de meeste plaatsen onbewolkt. Over de Waddeneilanden kan in de loop van de avond bewolking trekken. Bij een matige noordooster koelt het af naar 8 tot 12 graden. De 8 is voor het noorden van het land."
                            },
                            {
                                "example_id": "95ef3037-1e8e-4764-9699-c2ba07a2d640",
                                "sense_id": "9983c189-1526-3639-a9db-322262f86853",
                                "text": "Wie 1963 zegt, zegt Elfstedentocht. De extreemste editie ooit. Winnaar Reinier Paping trotseert sneeuw, kou en een straffe noordooster. Van de tienduizend toerrijders bereiken 69 de finish."
                            }
                        ]
                    }
                ],
