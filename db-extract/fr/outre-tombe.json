        "fr-extract.jsonl": [
            {
                "entry_id": "90b52914-adf1-32fa-8bc6-e2beacc1f031",
                "word": "outre-tombe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
                        "entry_id": "90b52914-adf1-32fa-8bc6-e2beacc1f031",
                        "glosses": [
                            "Ce qu’il y aurait après la mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5e1b3ab-ba15-4bf7-ba9f-235f783f398a",
                                "sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
                                "text": "Puisqu’il existe une responsabilité d’outre-tombe, faites-nous connaître sa forme. Irons-nous en paradis, en enfer, en purgatoire, ou éprouverons-nous quelqu’une des transformations avilissantes ou glorifiantes dont il est parlé dans d’autres religions ? Pour connaître la forme de la responsabilité d’outre-tombe, il faudrait que je reconnusse les formes ou du moins quelques-unes des formes que Dieu peut donner à sa volonté en dehors de ce monde, c’est-à-dire que je fusse plus qu’un homme, et alors vous ne me comprendriez pas."
                            },
                            {
                                "example_id": "398b77be-1d81-48b8-88bb-3ad3219184d6",
                                "sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
                                "text": "C’est la négation de la création, de la providence, de l’ordre du miracle et de la grâce, à quoi se joignent la négation de l’immortalité individuelle des âmes et l’inexistence des sanctions d’outre-tombe."
                            },
                            {
                                "example_id": "ad1b384b-f391-41cc-a31d-2bc4a28160b0",
                                "sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
                                "text": "Profondément obsédée par les problèmes de l’au-delà, toujours inquiète des mystères d’outre-tombe, l’âme bretonne ne peut se passer de méditer leur explication."
                            },
                            {
                                "example_id": "77f3da42-9d05-44e7-ba4e-20db1bfdc9a5",
                                "sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
                                "text": "Roses in the Snow, avec son violon répétitif et la voix d’outre-tombe de la chanteuse fait partie des chansons les plus flippantes qu'il vous sera donné d'entendre."
                            },
                            {
                                "example_id": "5a3087cd-853f-4027-bbac-cf589577c62f",
                                "sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
                                "text": "Et sa voix parvint au chevalier comme une voix lointaine, peut-être une voix d'outre-tombe ou d'outre-ciel..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68f3fc1-5acb-43e8-b4d4-da55c8afde04",
                        "source_entry_id": "90b52914-adf1-32fa-8bc6-e2beacc1f031",
                        "source_sense_id": "30418007-a45c-3d38-b761-8850f62b79b9",
