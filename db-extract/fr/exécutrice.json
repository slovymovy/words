                            {
                                "example_id": "150786e3-95db-4c6b-a164-9f88e82b6075",
                                "sense_id": "f4441c13-0fa8-33bf-8ea4-b4c5f0876b2a",
                                "text": "La suite de la tragédie montrera qu’elle sera plutôt l’exécutrice des basses œuvres."
                            },
                            {
                                "example_id": "79c155a7-ce9d-431f-97fe-715436df5a10",
                                "sense_id": "f4441c13-0fa8-33bf-8ea4-b4c5f0876b2a",
                                "text": "exécutrice testamentaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4605045a-e2b6-46dd-9216-c78f70847efb",
                        "source_entry_id": "2605e5bc-1240-3eb8-9c6b-f382326d7269",
                        "source_sense_id": "f4441c13-0fa8-33bf-8ea4-b4c5f0876b2a",
                        "source_sense_description": "Celle qui exécute",
                        "target_lang_word": "executrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
