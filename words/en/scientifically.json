{
    "word_family": [
        "science",
        "scientist",
        "scientific",
        "unscientific",
        "unscientifically"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc9c1bb2-3e24-3f50-8c38-0c646aff7c44",
                    "sense_definition": "In a way that relates to science or uses scientific principles and methods.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "science_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers must test the new medicine <w>scientifically</w> before it can be sold.",
                            "target_lang_translations": {
                                "nl": "De onderzoekers moeten het nieuwe medicijn <w>wetenschappelijk</w> testen voordat het verkocht mag worden."
                            }
                        },
                        {
                            "text": "The claims made by the advertisement have never been <w>scientifically</w> proven.",
                            "target_lang_translations": {
                                "nl": "De beweringen in de advertentie zijn nooit <w>wetenschappelijk</w> bewezen."
                            }
                        }
                    ],
                    "antonyms": [
                        "unscientifically"
                    ],
                    "common_phrases": [
                        "scientifically proven"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een manier die verband houdt met wetenschap of gebruikmaakt van wetenschappelijke principes en methoden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wetenschappelijk",
                                "target_lang_sense_clarification": "volgens wetenschappelijke methoden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8daf993e-ef8b-36eb-a1c8-f9ed97980bbe",
                    "sense_definition": "From the point of view or perspective of science.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science_perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Scientifically</w>, there is no evidence to support the idea of ghosts.",
                            "target_lang_translations": {
                                "nl": "<w>Wetenschappelijk gezien</w> is er geen bewijs dat het bestaan van spoken ondersteunt."
                            }
                        },
                        {
                            "text": "The phenomenon remains fascinating and <w>scientifically</w> important to astronomers.",
                            "target_lang_translations": {
                                "nl": "Het fenomeen blijft fascinerend en <w>wetenschappelijk</w> belangrijk voor astronomen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scientifically speaking"
                    ],
                    "target_lang_definitions": {
                        "nl": "Vanuit het perspectief of standpunt van de wetenschap."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wetenschappelijk",
                                "target_lang_sense_clarification": "vanuit de wetenschap gezien"
                            },
                            {
                                "target_lang_word": "wetenschappelijk gezien",
                                "target_lang_sense_clarification": "vanuit wetenschappelijk oogpunt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17080289-7005-3b13-8361-5dd8ea5b5d3c",
                    "sense_definition": "In a careful, logical, and systematic manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to organize her daily schedule <w>scientifically</w> to maximize productivity.",
                            "target_lang_translations": {
                                "nl": "Ze besloot haar dagelijkse planning <w>systematisch</w> in te richten om haar productiviteit te maximaliseren."
                            }
                        },
                        {
                            "text": "He tried to analyze his spending habits <w>scientifically</w> to save more money.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde zijn uitgavenpatroon <w>methodisch</w> te analyseren om meer geld te besparen."
                            }
                        }
                    ],
                    "synonyms": [
                        "methodically",
                        "systematically"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op een zorgvuldige, logische en systematische manier."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wetenschappelijk",
                                "target_lang_sense_clarification": "uiterst nauwkeurig of methodisch"
                            },
                            {
                                "target_lang_word": "systematisch",
                                "target_lang_sense_clarification": "planmatig en geordend"
                            },
                            {
                                "target_lang_word": "methodisch",
                                "target_lang_sense_clarification": "volgens een vaste methode"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}