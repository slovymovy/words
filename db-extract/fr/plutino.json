                                    {
                                        "sense_id": "dad6ca72-0c9f-3688-a323-68900cd4ea88",
                                        "entry_id": "12f696e4-127d-3e24-82fc-bd7f283b0f13",
                                        "glosses": [
                                            "Any planetoid in the Kuiper belt whose orbit, like that of Pluto, has a resonance of 3:2 with that of Neptune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4c32cb-f82b-49ca-a917-4410c57f8b30",
                                                "sense_id": "dad6ca72-0c9f-3688-a323-68900cd4ea88",
                                                "text": "We present a study of the dynamical evolution of plutinos recently escaped from the resonance through numerical simulations. It was shown in previous works the existence of weakly chaotic orbits in the plutino population that diffuse very slowly finally diving into a strong chaotic region."
                                            },
                                            {
                                                "example_id": "224d0f42-2c16-44b3-9e49-5bfd075c5399",
                                                "sense_id": "dad6ca72-0c9f-3688-a323-68900cd4ea88",
                                                "text": "This is dubbed a 3:2 resonance (with Neptune), Pluto being the largest Plutino.\nAbout one fourth of the KBOs are Plutinos. Plutinos may be debris from the collision of another KBO with Pluto, resulting in the formation of Pluto's largest moon, Charon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
