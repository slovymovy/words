                        "source_sense_id": "1bd2fc7e-2dcf-3fa6-82ea-9be9d8c5da51",
                        "source_sense_description": "looksoort Allium sativa met samengevouwen bol",
                        "target_lang_word": "Knoblauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knoblauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d552b57e-4e05-3c5b-bb64-79339f6431a7",
                                        "entry_id": "7395f4e9-45d6-32a7-abae-fed6c3e937eb",
                                        "glosses": [
                                            "Gewürz- und Heilpflanze aus der Familie der Zwiebelgewächse (=Allium sativum) mit einer aus mehreren länglichen Zwiebeln bestehenden Wurzelknolle, die intensiv riecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5438ed2-7aaf-43d8-92bb-9583c82774ca",
                                                "sense_id": "d552b57e-4e05-3c5b-bb64-79339f6431a7",
                                                "text": "Angeblich soll das verstreute Anpflanzen von Knoblauch in Blumenbeeten Wühlmäuse vertreiben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08d2cf05-9da3-390b-967e-7961f5171e44",
                                        "entry_id": "7395f4e9-45d6-32a7-abae-fed6c3e937eb",
                                        "glosses": [
                                            "Wurzelknolle des Knoblauchs^([1]) mit strengem Geschmack und Geruch; wird als Gewürz und als Heilmittel verwendet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0197252-8802-4317-a2b8-75815f4a0eac",
                                                "sense_id": "08d2cf05-9da3-390b-967e-7961f5171e44",
                                                "text": "Zu geschmortem Lammbraten gehört auf jeden Fall eine Menge Knoblauch."
                                            },
                                            {
                                                "example_id": "2e191a2d-e1d6-4dcb-94f0-25592688d742",
                                                "sense_id": "08d2cf05-9da3-390b-967e-7961f5171e44",
                                                "text": "„Geschworene, Anwälte und Richter kauten Knoblauch, Zitronenschalen, Kardamom und Kümmelsamen, um sich nicht an der Atemluft der Sträflinge zu infizieren.“"
                                            },
                                            {
                                                "example_id": "c4600b9f-131a-4263-b697-e27dcf9163cf",
                                                "sense_id": "08d2cf05-9da3-390b-967e-7961f5171e44",
                                                "text": "„Außerdem hatte Eigil sich angewöhnt, Knoblauch und Petersilie zu verwenden.“"
                                            },
                                            {
                                                "example_id": "36383bcb-5177-4bb8-a805-1ef7da96e455",
                                                "sense_id": "08d2cf05-9da3-390b-967e-7961f5171e44",
                                                "text": "„Aber er liebte die Pizza Margherita mit doppelt Knoblauch beim Italiener zwei Häuser weiter und war schnell an der Tür.“"
                                            },
                                            {
                                                "example_id": "dfe1d881-ac2c-46d3-a075-bfc14221b293",
                                                "sense_id": "08d2cf05-9da3-390b-967e-7961f5171e44",
                                                "text": "„Mein Großvater bereitete sie dann mit Knoblauch zu, und die ganze Familie hatte ein wunderbares Essen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
