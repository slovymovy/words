                    },
                    {
                        "form_id": "bc29f6c2-f55c-4b77-b120-c7009ef98774",
                        "entry_id": "5a8742ed-2bb8-3582-9cb7-c4016c9520ff",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Phlegma"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                        "entry_id": "5a8742ed-2bb8-3582-9cb7-c4016c9520ff",
                        "glosses": [
                            "Mangel an Erregbarkeit, unerschütterliche Ruhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fbb2c24-8ca5-49d2-84f5-fd7ad915e552",
                                "sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                                "text": "Wie der Verein zur Förderung gesunder Ernährung mitteilte, sei Übergewicht aber nicht mit Fressen und Phlegma gleichzusetzen."
                            },
                            {
                                "example_id": "40f4dfd0-f593-4c6b-a3f0-1b18d4b5f4f1",
                                "sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                                "text": "„Was nach außen physisch als Gleichgültigkeit und psychisch als Phlegma in Erscheinung tritt, ist nichts anderes als eine Mimikry des Gehirns.“"
                            },
                            {
                                "example_id": "8ab779ed-9aa9-4cf3-b0cf-5e5dddb92379",
                                "sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                                "text": "„Die Brüder waren von einem Phlegma, das an Schwachsinn grenzte, und solange sie samstagsabends ein wenig Geld verdienen und vor einer verständnisvollen Zuhörerschaft spielen konnten, fiel es ihnen nicht weiter auf, daß alles nach Hewlitts Kopf ging.“"
                            },
                            {
                                "example_id": "9daf31bc-5aed-4511-bd68-c11dc540b2b4",
                                "sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                                "text": "„Manchmal aber liest es sich so, als wäre nur eingetreten, was sie ohnehin erwartet hatte, sie hatte zuweilen ein gewisses Phlegma in Lebensdingen, und in ihren Äußerungen klingt manchmal ein Ton an, als lebe sie insgesamt nur halbherzig.“"
                            },
                            {
                                "example_id": "8cc8c202-2de0-4268-8543-e9dc04c235c1",
                                "sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                                "text": "„Ich beneidete sie um ihr Phlegma, ihre Indolenz, ihre Sorglosigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2300d5d-74f2-4428-b4cb-75fabd3703ec",
                        "source_entry_id": "5a8742ed-2bb8-3582-9cb7-c4016c9520ff",
                        "source_sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                        "source_sense_description": "Mangel an Erregbarkeit, unerschütterliche Ruhe",
                        "target_lang_word": "phlegm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phlegm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "One of the four humors making up the body in ancient and mediaeval medicine; said to be cold and moist, and often identified with mucus."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fd5412b-453d-449c-b1b1-ffb713cea4be",
                                                "sense_id": "17057365-4288-3dcc-ace5-645266daa6bf",
                                                "text": "Each person's unique mixture of these substances determines his temperament: a predominance of blood gives a sanguine temperament; a predominance of phlegm makes one phlegmatic; yellow bile, bilious (or choleric); and black bile, melancholic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "Viscid mucus produced by the body, later especially mucus expelled from the bronchial passages by coughing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7272c6e6-3103-42bb-891c-0b08b07846df",
                                                "sense_id": "4f0b48cb-231c-3085-86b7-7ec549b19b9b",
                                                "text": "Even some members of the new bourgeoisie indulge in conspicuously boorish behavior, like hawking phlegm onto the pavement or picking their noses at business meetings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "A watery distillation, especially one obtained from plant matter; an aqueous solution."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae850d3a-a7a3-408f-8ddd-9cfb4781595f",
                                                "sense_id": "cad32b52-0a28-31a8-b841-4be38bbb0124",
                                                "text": "The attempts made to analyse vegetable substances previous to 1720, merely produced their resolution into the supposed elements of the chemists of those days, namely, salts, Earths, phlegm, and sulphur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                        "entry_id": "047e59fe-c0ab-328c-92fa-95c2ae06815f",
                                        "glosses": [
                                            "Calmness of temperament, composure; also seen negatively, sluggishness, indifference."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89beed40-1f95-4c0f-b665-e032cdee90ec",
                                                "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                                "text": "Orloff's phlegm broke completely, and he snatched at the monocle as it dropped[.]"
                                            },
                                            {
                                                "example_id": "6b6ec911-918b-47ad-911d-9aa20f1dddad",
                                                "sense_id": "f9531682-deae-38e6-b0ee-9f5cb3b1900b",
                                                "text": "But Swedish Nazis also talked of the necessity of saving Sweden from Bolshevism, and with the menacing Berlin radio gnawing in their ears many Swedes lost their Scandinavian phlegm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d0c4593-2a28-48ae-81d3-1eb6fd4416b1",
                        "source_entry_id": "5a8742ed-2bb8-3582-9cb7-c4016c9520ff",
                        "source_sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                        "source_sense_description": "Mangel an Erregbarkeit, unerschütterliche Ruhe",
                        "target_lang_word": "apathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apathy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47bdb384-d1af-3e9a-9cce-028f332de072",
                                        "entry_id": "1de756b0-8c75-362c-8712-9a5c84790248",
                                        "glosses": [
                                            "Lack of emotion or motivation; lack of interest or enthusiasm towards something; disinterest (in something)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4e2c04-80ff-4086-ba17-a97c57a36e60",
                                                "sense_id": "47bdb384-d1af-3e9a-9cce-028f332de072",
                                                "text": "I opened it with apathy; the theory which he attempts to demonstrate and the wonderful facts which he relates soon changed this feeling into enthusiasm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d9bd733-476d-45b9-81fb-0459b18d6183",
                        "source_entry_id": "5a8742ed-2bb8-3582-9cb7-c4016c9520ff",
                        "source_sense_id": "76e2c8a1-ca90-3f14-a1b7-419e7f43a39e",
                        "source_sense_description": "Mangel an Erregbarkeit, unerschütterliche Ruhe",
                        "target_lang_word": "flegme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flegme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce147127-3d29-3d61-bf76-e180a61b1904",
                                        "entry_id": "375cac14-bebf-395c-978a-9b5ac3cb57c4",
                                        "glosses": [
                                            "Possession de soi-même, calme d’âme."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a8a446-776f-433b-9d3f-ca92be1eb1d5",
                                                "sense_id": "ce147127-3d29-3d61-bf76-e180a61b1904",
                                                "text": "C’est un homme qui a un grand flegme, qui est d’un grand flegme."
                                            },
                                            {
                                                "example_id": "30c8ceed-a3fc-473b-b054-50d22b7c54cb",
                                                "sense_id": "ce147127-3d29-3d61-bf76-e180a61b1904",
                                                "text": "Son flegme m’étonne."
                                            },
                                            {
                                                "example_id": "01b0c2c5-30bd-41ef-af16-edf8a089048c",
                                                "sense_id": "ce147127-3d29-3d61-bf76-e180a61b1904",
                                                "text": "Le flegme de cet homme me met au désespoir."
                                            },
                                            {
                                                "example_id": "f8045457-e76a-4225-82d9-95eafc23e097",
                                                "sense_id": "ce147127-3d29-3d61-bf76-e180a61b1904",
                                                "text": "Malgré les années, son mari avait conservé un physique avantageux et ne s’était jamais départi de ce flegme aristocratique qu’elle adorait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1992d371-0b41-3be3-bde5-b0f38d0a0b83",
                                        "entry_id": "375cac14-bebf-395c-978a-9b5ac3cb57c4",
                                        "glosses": [
                                            "Lymphe."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58d9cc50-8b38-4450-a077-ff970ad15734",
                                                "sense_id": "1992d371-0b41-3be3-bde5-b0f38d0a0b83",
                                                "text": "Ah, la bonne terre! Vous allez voir comme elle va évacuer les flegmes et les glaires..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1b86cb5-7e35-3a7d-91e0-984c62b9da07",
                                        "entry_id": "375cac14-bebf-395c-978a-9b5ac3cb57c4",
                                        "glosses": [
                                            "Produits aqueux de la première distillation des mélasses, des jus de betteraves ou de grains."
                                        ],
                                        "tags": [
                                            "Distillerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7de0f189-29d4-42bf-94e8-763f20d134f6",
                                                "sense_id": "a1b86cb5-7e35-3a7d-91e0-984c62b9da07",
                                                "text": "Les flegmes ainsi déséthérisés sont envoyés à la chaudière à rectifier, soit après filtration, soit directement, suivant le système suivi dans l’usine ; mais, dans tous les cas, ils sont débarrassés des éthers, qui constituent dans les chauffes de rectification ce qu’on appelle les goûts de tête, et qui sont des causes de coulage aux mauvais goûts et demi-goûts pendant des temps quelquefois très longs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
