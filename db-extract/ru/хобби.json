                                "target_senses": [
                                    {
                                        "sense_id": "5aa95e34-0f3c-3be3-889b-56df83179c48",
                                        "entry_id": "66ab52f1-e736-3e67-9179-87e9a60697c1",
                                        "glosses": [
                                            "An activity that one enjoys doing in one's spare time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "282d6c7d-8f80-43c0-8d67-2092c283417a",
                                                "sense_id": "5aa95e34-0f3c-3be3-889b-56df83179c48",
                                                "text": "I like to collect stamps from different countries as a hobby."
                                            },
                                            {
                                                "example_id": "c50b5c75-f5b4-4f9b-b8b5-cbfeba1ec03e",
                                                "sense_id": "5aa95e34-0f3c-3be3-889b-56df83179c48",
                                                "text": "take up a hobby"
                                            },
                                            {
                                                "example_id": "5804ab83-7af9-4090-bc7b-cf070a8c9e1f",
                                                "sense_id": "5aa95e34-0f3c-3be3-889b-56df83179c48",
                                                "text": "give up your hobby"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1864c90-390b-30bd-ab60-4a100ba05a43",
                                        "entry_id": "66ab52f1-e736-3e67-9179-87e9a60697c1",
                                        "glosses": [
                                            "An extinct breed of horse native to the British Isles, also known as the Irish Hobby."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "790a830a-0282-3a34-a5fd-266d7ca52230",
                                        "entry_id": "66ab52f1-e736-3e67-9179-87e9a60697c1",
                                        "glosses": [
                                            "Synonym of hobby horse (“a favorite topic”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7c6ef1-5d0f-48e6-8c75-f60882971db0",
                                                "sense_id": "790a830a-0282-3a34-a5fd-266d7ca52230",
                                                "text": "\"Well, I think East is right,\" said Arthur; \"I can't see but what it's right to do the best you can, though it mayn't be the best absolutely. Every man isn't born to be a martyr.\"\n\"Of course, of course,\" said East; \"but he's on one of his pet hobbies. — How often have I told you, Tom, that you must drive a nail where it'll go.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hobby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "137067fa-4b5c-30d2-bef2-7bfa3e54027a",
                                        "entry_id": "3cd57ed4-3dff-3be3-b72b-29341a646b1e",
                                        "glosses": [
                                            "Any of four species of small falcons in the genus Falco, especially Falco subbuteo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb97301-de39-4f78-8b10-f58fcf4e4867",
                                                "sense_id": "137067fa-4b5c-30d2-bef2-7bfa3e54027a",
                                                "text": "He hawked – from nearby Esher, Richard Fox sent a servant with a hobby, which Henry received enthusiastically – and hunted, sending a present of freshly slaughtered deer to Princess Mary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
