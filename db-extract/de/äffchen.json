                    {
                        "form_id": "860e1ed0-b852-470a-9811-2b6f8d361e0e",
                        "entry_id": "c62e819d-1c42-3340-bbf6-bcb888792053",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Äffchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                        "entry_id": "c62e819d-1c42-3340-bbf6-bcb888792053",
                        "glosses": [
                            "kleiner Affe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15806d1-e52e-43c7-b210-fd434fc1daac",
                                "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                "text": "„Ich hab ein Haus, ein kunterbuntes Haus, ein Äffchen und ein Pferd, die schauen dort zum Fenster raus.“ (Pippi-Langstrumpf-Lied)"
                            },
                            {
                                "example_id": "b9ae2fe9-da94-4a75-8ac4-ef664d347073",
                                "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                "text": "„Im nächsten Augenblick schoß ein kleines braunes Äffchen durch den Türspalt, hüpfte schrill kichernd die Stufen hinunter und turnte an Thomas Lieven empor.“"
                            },
                            {
                                "example_id": "21bbf064-1054-41c6-b977-18075636b962",
                                "sense_id": "af88b3a5-5547-327e-9fbd-f16c711c935a",
                                "text": "„Seine Hände spielen mit einer um eine Spule gewickelten Schnur, die mit einem Äffchen verbunden ist, Allegorie und verdoppelnde Verkörperung der ›Narrheit‹ des Kindes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f8a8581-930c-4438-a8b4-d8a033e24ab5",
                        "source_entry_id": "c62e819d-1c42-3340-bbf6-bcb888792053",
