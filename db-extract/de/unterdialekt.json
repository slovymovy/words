                "senses": [
                    {
                        "sense_id": "4c32b114-eb29-37ae-b3ba-c0ad232be0db",
                        "entry_id": "d42d5cbd-c18c-3d4e-9b71-ef28bf736dd1",
                        "glosses": [
                            "subdialect"
