    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fb3a0c5f-db06-3e85-a9ac-8848b0dfe06c",
                "word": "sybaritic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b733e5d6-98ca-4671-84c5-9c108bdc1efa",
                        "entry_id": "fb3a0c5f-db06-3e85-a9ac-8848b0dfe06c",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more sybaritic"
                    },
                    {
                        "form_id": "4ecb2f53-c524-4089-b105-ce01afda0a2a",
                        "entry_id": "fb3a0c5f-db06-3e85-a9ac-8848b0dfe06c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most sybaritic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                        "entry_id": "fb3a0c5f-db06-3e85-a9ac-8848b0dfe06c",
                        "glosses": [
                            "Of or having the qualities of a sybarite (“a person devoted to luxury and pleasure”); dedicated to excessive comfort and enjoyment; decadent, hedonistic, self-indulgent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bca8ff62-6705-4fb4-898c-d77f07ee91ae",
                                "sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                                "text": "His belly is a Ceſterne of receit, / A grand Confounder of demulcing Meate. / A Sabariticke Sea, a depthleſſe Gulfe, / A ſenceleſſe Vulture, a corroding VVolfe."
                            },
                            {
                                "example_id": "8489a18c-7b01-4c92-bb88-eeb636b5e3b7",
                                "sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                                "text": "[S]he, for whom attendant maidens had smoothed the Sybaritic sheet of finest texture, […]"
                            },
                            {
                                "example_id": "392043c0-edef-40e6-895a-df685f170736",
                                "sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                                "text": "Mike took a slow sybaritic sip. \"We do use liquor. A few of us—Saul, myself, Sven, some others—like it. I've learned to let it have just a little effect, then hold it, and gain a euphoric growing-closer much like trance without having to withdraw.\""
                            },
                            {
                                "example_id": "95b00129-68b4-441f-b256-789e8a330373",
                                "sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                                "text": "He seeks to work in the arena? […] His is a manly trade; sybaritic Rome, that is becoming effeminate, needs to see muscle at work, recalling more primitive glories."
                            },
                            {
                                "example_id": "cfc46924-8efa-4dba-8dbd-7ab08af5ea0c",
                                "sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                                "text": "He [David Hershkovits] loves to sleep late, he loves to entertain, he's an amazing cook. He's such a joyful, celebratory, sybaritic person."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dcb946a-7389-4ca2-bf7e-fdd998077ea5",
                        "source_entry_id": "fb3a0c5f-db06-3e85-a9ac-8848b0dfe06c",
                        "source_sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                        "source_sense_description": "of or having the qualities of a sybarite — see also decadent, hedonistic, self-indulgent",
                        "target_lang_word": "sybaritique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sybaritique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22557468-90ea-3722-b439-fab7b721627d",
                                        "entry_id": "bd4a48a2-955f-3438-85b8-28f4968269bc",
                                        "glosses": [
                                            "Relatif aux Sybarites."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48f24d34-772c-3451-80ab-8287d2d7cc64",
                                        "entry_id": "bd4a48a2-955f-3438-85b8-28f4968269bc",
                                        "glosses": [
                                            "Recherchant le luxe, les plaisirs raffinés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bda4fcf8-0547-4603-a798-b23e215ba774",
                                                "sense_id": "48f24d34-772c-3451-80ab-8287d2d7cc64",
                                                "text": "Il mène un train de vie sybaritique depuis qu’il a gagné au loto."
                                            },
                                            {
                                                "example_id": "84795ac7-5363-44a2-ae57-f3ee6107c8dd",
                                                "sense_id": "48f24d34-772c-3451-80ab-8287d2d7cc64",
                                                "text": "À table, il avalait pêle-mêle le contenu de son assiette, puis, passant un doigt dans sa bouche, nettoyait son sillon labio-gingival, afin de donner aux autres, sans doute, une leçon de propreté. On le sentait constitué d’une multitude de petites coutumes dégoûtantes, mais sybaritiques, par lesquelles il se maintenait en santé et en tourment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a481464e-618b-4f22-b59c-b56e1558ee53",
                        "source_entry_id": "fb3a0c5f-db06-3e85-a9ac-8848b0dfe06c",
                        "source_sense_id": "8f44b725-9ab2-311a-9034-e4ddb344315a",
                        "source_sense_description": "of or having the qualities of a sybarite — see also decadent, hedonistic, self-indulgent",
                        "target_lang_word": "sybaritisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sybaritisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b63b17d-3f2b-3d69-8eda-88dccd54154f",
                                        "entry_id": "f588ef32-b907-330c-a29f-6c1e656cd8d3",
                                        "glosses": [
                                            "die Stadt Sybaris oder deren Einwohner betreffend"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e013530b-e628-4837-9838-fb65ec43c402",
                                                "sense_id": "7b63b17d-3f2b-3d69-8eda-88dccd54154f",
                                                "text": "„Ein Besucher aus der Renaissance, der unvermittelt auf uns gestoßen wäre, hätte sehr wohl annehmen können, daß wir einem Bild entstiegen waren, welches das gewaltsame Ende des räudigen Gefolges eines sybaritischen Dogen darstellte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "811f5a1a-5d28-3578-a634-2ff492233fc1",
                                        "entry_id": "f588ef32-b907-330c-a29f-6c1e656cd8d3",
                                        "glosses": [
                                            "genusssüchtig, schwelgerisch, verweichlicht"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876b16b6-7143-49af-a656-98a4b837b725",
                                                "sense_id": "811f5a1a-5d28-3578-a634-2ff492233fc1",
                                                "text": "„Seine großartige Physiognomie, eben noch von gotischem Schmerz beseelt, erblühte üppig und heiter; sogar ein sybaritisches Grübchen zeigte sich auf einmal in seiner Wange. 'Die Stunde ist hie -' Und ließ sich die Karte geben . . .“"
                                            },
                                            {
                                                "example_id": "63479d50-9349-43b2-90ee-edd5d76508f7",
                                                "sense_id": "811f5a1a-5d28-3578-a634-2ff492233fc1",
                                                "text": "\"Die sybaritische Wonne eines Taxis verschmähte er und unterzog sich mit Selbstverständlichkeit der qualvollen Aufgabe, in einer fremden Stadt mit fremder Sprache per Tram fremde Sehenswürdigkeiten zu erreichen, deren Name die Eingeborenen kaum kannten.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
