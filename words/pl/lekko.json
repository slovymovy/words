{
    "word_family": [
        "lekki",
        "lekkość"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6be8ec32-522c-3acb-b3be-330aaf40833e",
                    "sense_definition": "W niewielkim stopniu lub z małą intensywnością.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jestem dzisiaj <lekko> przeziębiony i zostanę w domu.",
                            "target_lang_translations": {
                                "ru": "Я сегодня <слегка> простужен и останусь дома.",
                                "en": "I have a <slight> cold today and I will stay at home."
                            }
                        },
                        {
                            "text": "Wiatr powiał <lekko>, poruszając liśćmi na drzewach.",
                            "target_lang_translations": {
                                "ru": "Ветер <легко> подул, шевеля листьями на деревьях.",
                                "en": "The wind blew <lightly>, moving the leaves on the trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieco",
                        "trochę",
                        "troszkę",
                        "nieznacznie"
                    ],
                    "common_phrases": [
                        "lekko ranny",
                        "lekko zdziwiony",
                        "lekko słony"
                    ],
                    "target_lang_definitions": {
                        "ru": "В незначительной степени или с малой интенсивностью.",
                        "en": "To a small extent or with low intensity."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слегка",
                                "target_lang_sense_clarification": "в какой-то мере, чуть-чуть"
                            },
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "не сильно"
                            },
                            {
                                "target_lang_word": "легко",
                                "target_lang_sense_clarification": "слабо"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "slightly",
                                "target_lang_sense_clarification": "to a small degree"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "somewhat"
                            },
                            {
                                "target_lang_word": "lightly",
                                "target_lang_sense_clarification": "with little force or intensity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbf0a070-c303-3c59-a21a-a6fc047c56d5",
                    "sense_definition": "Bez trudu, bez wysiłku; w sposób łatwy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauka języków obcych przychodzi jej bardzo <lekko>.",
                            "target_lang_translations": {
                                "ru": "Изучение иностранных языков дается ей очень <легко>.",
                                "en": "Learning foreign languages comes very <easily> to her."
                            }
                        },
                        {
                            "text": "To zadanie poszło nam <lekko> i szybko je skończyliśmy.",
                            "target_lang_translations": {
                                "ru": "Это задание далось нам <легко>, и мы быстро его закончили.",
                                "en": "This task went <smoothly> for us and we finished it quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "łatwo",
                        "bezproblemowo"
                    ],
                    "common_phrases": [
                        "lekko przyszło",
                        "brać lekko"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без труда, без усилий; легко.",
                        "en": "Without difficulty or effort; in an easy manner."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легко",
                                "target_lang_sense_clarification": "без затруднений"
                            },
                            {
                                "target_lang_word": "просто",
                                "target_lang_sense_clarification": "несложно"
                            },
                            {
                                "target_lang_word": "без труда",
                                "target_lang_sense_clarification": "свободно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "easily",
                                "target_lang_sense_clarification": "without effort"
                            },
                            {
                                "target_lang_word": "lightly",
                                "target_lang_sense_clarification": "effortlessly or without seriousness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ee763e8-bb98-307c-8efe-3987e54ecf77",
                    "sense_definition": "Delikatnie, bez użycia dużej siły.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Matka <lekko> pogłaskała płaczące dziecko po głowie.",
                            "target_lang_translations": {
                                "ru": "Мать <легко> погладила плачущего ребенка по голове.",
                                "en": "The mother <softly> stroked the crying child's head."
                            }
                        },
                        {
                            "text": "Musisz <lekko> nacisnąć ten przycisk, żeby zadziałał.",
                            "target_lang_translations": {
                                "ru": "Ты должен <легко> нажать на эту кнопку, чтобы она сработала.",
                                "en": "You have to press this button <lightly> for it to work."
                            }
                        }
                    ],
                    "synonyms": [
                        "delikatnie",
                        "łagodnie"
                    ],
                    "common_phrases": [
                        "lekko pukać",
                        "lekko dotknąć"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осторожно, мягко, не применяя большой силы.",
                        "en": "Gently, without using much force."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легко",
                                "target_lang_sense_clarification": "слабо, без нажима"
                            },
                            {
                                "target_lang_word": "осторожно",
                                "target_lang_sense_clarification": "бережно"
                            },
                            {
                                "target_lang_word": "аккуратно",
                                "target_lang_sense_clarification": "деликатно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "softly",
                                "target_lang_sense_clarification": "gently and quietly"
                            },
                            {
                                "target_lang_word": "lightly",
                                "target_lang_sense_clarification": "with very little pressure"
                            },
                            {
                                "target_lang_word": "gently",
                                "target_lang_sense_clarification": "carefully and softly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2349a03c-7f6a-3fcf-9aa4-d8af06a36ed0",
                    "sense_definition": "W sposób zwinny, swobodny i sprawiający wrażenie braku ciężaru.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młoda tancerka poruszała się <lekko> po całym parkiecie.",
                            "target_lang_translations": {
                                "ru": "Молодая танцовщица <легко> двигалась по всему паркету.",
                                "en": "The young dancer moved <lightly> across the entire dance floor."
                            }
                        },
                        {
                            "text": "Kot <lekko> zeskoczył z wysokiego płotu na trawę.",
                            "target_lang_translations": {
                                "ru": "Кот <легко> спрыгнул с высокого забора на траву.",
                                "en": "The cat <lightly> jumped down from the high fence onto the grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwinnie"
                    ],
                    "common_phrases": [
                        "stąpać lekko",
                        "poruszać się lekko"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловко, свободно, создавая впечатление невесомости.",
                        "en": "In an agile, free manner that gives the impression of weightlessness."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легко",
                                "target_lang_sense_clarification": "плавно, грациозно"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lightly",
                                "target_lang_sense_clarification": "with a light step or movement"
                            },
                            {
                                "target_lang_word": "gracefully",
                                "target_lang_sense_clarification": "with smooth and elegant movement"
                            },
                            {
                                "target_lang_word": "nimbly",
                                "target_lang_sense_clarification": "with quick and light movement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}