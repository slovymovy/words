                {
                    "sense_id": "9a539e67-f735-332e-b26e-c505ab6d0559",
                    "sense_definition": "Éprouver un profond ennui, trouver le temps très long.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ennui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le film était tellement nul que nous nous sommes <w>emmerdés</w> tout l'après-midi.",
                            "target_lang_translations": {
                                "en": "The film was so dull that we were <w>bored</w> all afternoon.",
                                "ru": "Фильм был настолько нудным, что мы всю вторую половину дня <w>скучали</w>.",
                                "nl": "De film was zo waardeloos dat we ons de hele middag hebben <w>verveeld</w>.",
                                "de": "Der Film war so öde, dass wir <w>uns</w> den ganzen Nachmittag <w>langweilten</w>.",
                                "pl": "Ten film był tak nudny, że <w>nudziliśmy się</w> przez całe popołudnie.",
                                "it": "Il film era talmente noioso che <w>ci</w> siamo <w>annoiati</w> per tutto il pomeriggio.",
                                "cs": "Ten film byl tak otřesný, že jsme <w>se</w> celé odpoledne <w>nudili</w>.",
                                "tr": "Film o kadar sıkıcıydı ki öğleden sonranın tamamı boyunca <w>sıkıldık</w>.",
                                "es": "La película era tan aburrida que <w>nos aburrimos</w> toda la tarde.",
                                "zh": "这部电影烂透了，我们整个下午都<w>无聊</w>得要命。"
                            }
                        },
                        {
                            "text": "Il n'y a rien à faire dans cette ville, je m'<w>emmerde</w> à mourir.",
                            "target_lang_translations": {
                                "en": "There's nothing to do in this town, I'm <w>bored</w> to death.",
                                "ru": "В этом городе делать нечего, я <w>скучаю</w> до смерти.",
                                "nl": "Er is niets te doen in deze stad, ik <w>verveel</w> me dood.",
                                "de": "In dieser Stadt gibt es nichts zu tun, ich <w>langweile mich</w> zu Tode.",
                                "pl": "W tym mieście nie ma nic do roboty, <w>nudzę się</w> na śmierć.",
                                "it": "Non c'è niente da fare in questa città, <w>mi annoio</w> a morte.",
                                "cs": "V tomhle městě není co dělat, <w>nudím se</w> k smrti.",
                                "tr": "Bu şehirde yapacak hiçbir şey yok, ölesiye <w>sıkılıyorum</w>.",
                                "es": "No hay nada que hacer en esta ciudad, <w>me aburro</w> a morir.",
                                "zh": "这座城市无事可做，我<w>无聊</w>到快死了。"
                            }
                        }
