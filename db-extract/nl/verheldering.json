                                "example_id": "37472bd9-d619-438f-9e0c-e2541f42603c",
                                "sense_id": "025c7d96-2332-3992-888e-dc01b308ea61",
                                "text": "Het enige universeel werkzame middel, het enige dat in staat is geluk te bewerkstelligen op alle gebieden en niveaus van het leven, is: verheffing van de menselijke ziel, verheldering van zijn bewustzijn."
                            },
                            {
                                "example_id": "13c789ec-8a46-4825-9d15-a67b4923907a",
                                "sense_id": "025c7d96-2332-3992-888e-dc01b308ea61",
                                "text": "Er is dus sprake van de nodige wederzijdse verheldering."
                            }
                        ]
