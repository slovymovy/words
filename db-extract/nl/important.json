                "senses": [
                    {
                        "sense_id": "de2e8679-3d20-38ae-8cc2-cb5189754aad",
                        "entry_id": "ab117fb3-80a6-3d1a-8ccc-4f6068a61ff8",
                        "glosses": [
                            "van groot belang, van betekenis"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0a2dcf4b-64c3-4667-88db-d84481e50453",
                                "sense_id": "de2e8679-3d20-38ae-8cc2-cb5189754aad",
                                "text": "We weten niet met welke ijver hij als advocaat praktiseerde of wenste te praktiseren. Nog minder weten we welk inkomen dat opleverde. Evenmin weten we of zijn voortdurende werkzaamheid als schrijver enig important geldelijk gewin tot gevolg had. Er zijn bijvoorbeeld weinig teksten waarvan een tweede druk verscheen."
                            },
                            {
                                "example_id": "0a29ede0-3f18-43a2-acc7-ede0f85b4ce0",
                                "sense_id": "de2e8679-3d20-38ae-8cc2-cb5189754aad",
                                "text": "Eindhoven had nog niet dat prestige in Den Haag en evenmin het doorzettingsvermogen van het naoorlogse college, dat zich de facto reichsunmittelbar voelt en bovendien zich sterker gedragen weet door de meewerkende belangstelling van invloedrijke allochtonen. Deze was te meer important sedert na de bevrijding het begrip deviezenbron opgeld ging doen en de Eindhovense industrie daarin een duidelijk woordje meesprak na de verrassend snelle herbouw van de aangerichte verwoestingen, de ondernemingszin van zijn ondernemers en de arbeidzaamheid van zijn arbeiders."
                            }
                        ]
                    },
                    {
                        "sense_id": "42cc9e29-521e-3231-9945-87447044cb43",
                        "entry_id": "ab117fb3-80a6-3d1a-8ccc-4f6068a61ff8",
                        "glosses": [
                            "als bij een kwestie van groot belang"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fa716595-52f3-4c55-854b-6e94ac6e2968",
                                "sense_id": "42cc9e29-521e-3231-9945-87447044cb43",
                                "text": "‘Ook wanneer men zoo important in de lading geïnteresserd is,’ zei Papa Perfect ‘dan wenscht men de welvaart van het scheepje.’"
                            }
                        ]
                    }
