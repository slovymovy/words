                "senses": [
                    {
                        "sense_id": "f9f0752a-968a-3867-9b3b-6af4cacee438",
                        "entry_id": "9883f599-ab00-37ad-b54b-a8883968e04e",
                        "glosses": [
                            "bedrijvende vorm, het actief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92043afa-4b0d-42f0-ac96-ae7abefc2dfb",
                                "sense_id": "f9f0752a-968a-3867-9b3b-6af4cacee438",
                                "text": "De zin De tas wordt door Jan gedragen in is het activum Jan draagt te bal."
                            },
                            {
                                "example_id": "c6cf19f9-9c7d-4cb0-9586-3008707702f2",
                                "sense_id": "f9f0752a-968a-3867-9b3b-6af4cacee438",
                                "text": "Het is lang geleden dat ik op het gymnasium heb gezeten, maar ik meen me toch te kunnen herinneren dat er een middel is om te controleren of iets een lijdend voorwerp is, namelijk door de zin van het activum in het passivum om te zetten. Dus: je zou van ‘hij lachte zich dood’ moeten kunnen maken : ‘hij wordt door hem dood gelachen’. Dat klinkt niet echt goed."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e6002e3-c015-305b-ae96-8825358cc47d",
                        "entry_id": "9883f599-ab00-37ad-b54b-a8883968e04e",
                        "glosses": [
                            "een bezitting van een bedrijf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a71d9553-9e2a-4218-9a57-08d0d4e277a3",
                                "sense_id": "7e6002e3-c015-305b-ae96-8825358cc47d",
                                "text": "Elke zelfhulpboek om rijk te worden zal hetzelfde zeggen: probeer bezit te krijgen, dat is de basis van rijkdom. „Als je iets bezit, is het van jou. Je hebt daar eigendomsrecht op, het exclusieve recht om iets te gebruiken, om er geld mee te verdienen en om anderen te weerhouden daar geld aan te verdienen. Oftewel: een mini-monopolie op een activum.” Denk niet alleen aan fysiek bezit, zoals een goudmijn of oliebron. Je kunt ook denken aan intellectueel eigendom. Wilkin: „Driekwart van de grootste fortuinen zijn (ten minste ten dele) te danken aan assetmanagement of intellectueel eigendom.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93ae324f-063e-4509-acfb-43ade5fcdc62",
                        "source_entry_id": "9883f599-ab00-37ad-b54b-a8883968e04e",
                        "source_sense_id": "f9f0752a-968a-3867-9b3b-6af4cacee438",
                        "source_sense_description": "bedrijvende vorm",
                        "target_lang_word": "Aktiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d27a36-81e6-37d7-b516-60ced8e98b19",
                                        "entry_id": "dc3aa6a4-0f9d-329e-a36b-720c831c62c4",
                                        "glosses": [
                                            "eine der Diathesen/Genera verbi, Tatform, Tätigkeitsform"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33effa49-854c-487f-a05a-26da1da48aae",
                                                "sense_id": "d4d27a36-81e6-37d7-b516-60ced8e98b19",
                                                "text": "„In der Schriftsprache der deutschen Gegenwartssprache sind Aktiv und Passiv sehr ungleich verteilt.“"
                                            },
                                            {
                                                "example_id": "ac65375f-59a4-4e02-82a8-c4a3cb7ca51a",
                                                "sense_id": "d4d27a36-81e6-37d7-b516-60ced8e98b19",
                                                "text": "„Nie hatte Alf jemals eine Frage über den Lehrplan gestellt - sie wußten bereits vieles, was er nicht wußte, er war nie zusammengekommen mit Aktiv und Passiv, Konditional und Gerundium, mit dem lateinischen Ablativus absolutus.“"
                                            },
                                            {
                                                "example_id": "c984f7e6-4cc8-4bd9-8503-52026cc576b5",
                                                "sense_id": "d4d27a36-81e6-37d7-b516-60ced8e98b19",
                                                "text": "„Aus diesen Annahmen ergibt sich, daß Passiv schwieriger als Aktiv ist, semantische Reversibilität schwieriger als Irreversibilität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d879da11-46b5-478c-9b6e-256ac20a27f7",
                        "source_entry_id": "9883f599-ab00-37ad-b54b-a8883968e04e",
                        "source_sense_id": "f9f0752a-968a-3867-9b3b-6af4cacee438",
                        "source_sense_description": "bedrijvende vorm",
                        "target_lang_word": "Aktivum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktivum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81de745f-39d4-3cec-9917-a02e4825a9fb",
                                        "entry_id": "020865ba-cb50-3875-960c-79fffdbdabcf",
                                        "glosses": [
                                            "Vermögenswert, der auf der Aktivseite der Bilanz eines Unternehmens steht"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ff285f-020c-4f5c-8315-237e7fb90bdb",
                                                "sense_id": "81de745f-39d4-3cec-9917-a02e4825a9fb",
                                                "text": "„Die Aktiva gab CIT im Insolvenzantrag mit 71 Milliarden Dollar (48 Mrd Euro) an, dem stünden Verbindlichkeiten von 64,9 Milliarden Dollar gegenüber.“"
                                            },
                                            {
                                                "example_id": "49c9134a-807e-4dcf-9ca3-96cb1a7baf52",
                                                "sense_id": "81de745f-39d4-3cec-9917-a02e4825a9fb",
                                                "text": "„Wohl das größte Aktivum im armen Deutschland ist die Initiative.“"
                                            },
                                            {
                                                "example_id": "f3efd238-049c-498e-b16e-749810864ab7",
                                                "sense_id": "81de745f-39d4-3cec-9917-a02e4825a9fb",
                                                "text": "„Für die moderne Kriegsführung scheint es ja als Aktivum nicht mehr benötigt zu werden, nur noch als Passivum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aktivum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8ed643-54c5-3acd-9291-f0d7f19871a5",
                                        "entry_id": "c51fdfb7-800e-38fb-aba5-e5e77dd20b76",
                                        "glosses": [
                                            "ein Genus Verbi"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0aaff78-dbff-4f01-ad17-ff3d992ef754",
                                                "sense_id": "7c8ed643-54c5-3acd-9291-f0d7f19871a5",
                                                "text": "„Neu behauptet, daß das Medium – sprachhistorisch gesehen! – nicht ein ‚Mittleres‘ zwischen Aktivum und Passivum, sondern ein ‚Mittleres‘ zwischen Aktivum und Perfektivum ist …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f3c8c39-f329-34bb-882c-55202c85c2a9",
                                        "entry_id": "c51fdfb7-800e-38fb-aba5-e5e77dd20b76",
                                        "glosses": [
                                            "Form eines Verbs, das aus der Sicht des Subjekts eine Aktion ausdrückt"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f524ce-cc63-4417-a141-e1f7319c174c",
                                                "sense_id": "2f3c8c39-f329-34bb-882c-55202c85c2a9",
                                                "text": "Das Aktivum von einigen Verben der persönlichen Einschätzung verlangt ein Akkusativobjekt und ein Objektsprädikativ."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8078cd8-fc7c-4864-a32d-e294c430011f",
