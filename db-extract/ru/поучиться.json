                    {
                        "form_id": "4e924127-b08a-4828-a99d-a118dbb11c06",
                        "entry_id": "8e0aaae8-e019-381d-9053-973be2beb550",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "поучи́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d613ca80-901d-3089-86c3-2e71c30ce9f8",
                        "entry_id": "8e0aaae8-e019-381d-9053-973be2beb550",
                        "glosses": [
                            "провести некоторое время, учась"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48844556-b8d7-4213-a94e-4074d4de0309",
                                "sense_id": "d613ca80-901d-3089-86c3-2e71c30ce9f8",
                                "text": "Поучиться переплетать книги. Поучиться правильному произношению."
                            }
                        ]
                    },
                    {
                        "sense_id": "9583dbc2-1933-3831-bcc7-5ee1e5ac85b2",
                        "entry_id": "8e0aaae8-e019-381d-9053-973be2beb550",
                        "glosses": [
                            "разг. провести некоторое время, уча урок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c118d462-0c52-4d94-a2f5-cb2808a2b0f6",
                                "sense_id": "9583dbc2-1933-3831-bcc7-5ee1e5ac85b2",
                                "text": "Немного поучусь, а потом погуляю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33d31c24-2dc4-4b83-8d8c-2fa4c54955ef",
                        "source_entry_id": "8e0aaae8-e019-381d-9053-973be2beb550",
                        "target_lang_word": "learn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "learn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To acquire, or attempt to acquire knowledge or an ability to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "166056e6-a385-4a30-9d07-34ddf6d2f3e7",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "It's time Dad learned (how) to change the oil in the car."
                                            },
                                            {
                                                "example_id": "4e59b337-16a0-428d-91ed-30613c3de6e4",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "In my latest job, I've learnt to keep my mouth shut more than in the last one."
                                            },
                                            {
                                                "example_id": "e453568d-e55b-42a3-adec-60f6e43f4de1",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "Toddlers learn to walk at around one year old."
                                            },
                                            {
                                                "example_id": "ed3a4013-f223-4f2e-97de-8343fe080b66",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "a school in which he learns sly circumvention"
                                            },
                                            {
                                                "example_id": "65744afd-5560-494d-868a-f8e07119a059",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "I was very impressed with the obvious amount of work that went into the learning and synchronization of such a complex and harmonically and difficult score."
                                            },
                                            {
                                                "example_id": "91795502-4bde-4351-b0d4-054c2b8aa44f",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "I have learned far more from them about how to be a scientist than they realize. Above all else, they taught me the virtues of proper waterfowl alignment."
                                            },
                                            {
                                                "example_id": "087b93a8-ea7c-47a2-9048-6a18d58b5c68",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "Every day I learn more about this great city."
                                            },
                                            {
                                                "example_id": "5a0c881c-ce39-4564-a0ed-9c3b8c69daa4",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "Other rules learnt by butlers include lighting candles 15 minutes before guests enter a room, and not saying \"good morning\" to guests until you are 5ft away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d23864-0874-360b-9add-2e84d9ca6ba3",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To attend a course or other educational activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f8b240-7be6-434b-88db-b5defac65505",
                                                "sense_id": "87d23864-0874-360b-9add-2e84d9ca6ba3",
                                                "text": "For, as he took delight to introduce me, I took delight to learn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0ef8db-69ef-3a6f-a440-8f0b6f9a133c",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To gain knowledge from a bad experience so as to improve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d71289-b013-4189-9401-a1f9b888e3c1",
                                                "sense_id": "1c0ef8db-69ef-3a6f-a440-8f0b6f9a133c",
                                                "text": "learn from one's mistakes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e25cc3-3d94-3275-bcc7-c9034458e621",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f1101b-f55d-4a87-bfcc-919f9e7114ec",
                                                "sense_id": "a0e25cc3-3d94-3275-bcc7-c9034458e621",
                                                "text": "I learn medicine."
                                            },
                                            {
                                                "example_id": "5e27ec8c-11f2-494f-a48a-fa86ff89ca09",
                                                "sense_id": "a0e25cc3-3d94-3275-bcc7-c9034458e621",
                                                "text": "They learn psychology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82f5239-b4bb-39d0-985c-8f6d7f51dadf",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To come to know; to become informed of; to find out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5eaf69-ee3c-44af-b363-c558cf24e7a1",
                                                "sense_id": "b82f5239-b4bb-39d0-985c-8f6d7f51dadf",
                                                "text": "He just learned that he will be sacked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To teach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50010699-ad07-45c1-9f24-c44b5eb6ca82",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "Give him a clip round the ear. That'll learn him!"
                                            },
                                            {
                                                "example_id": "3c9b5c74-c871-46be-9e10-2b21e73c0a1d",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "And whan she had serched hym\n she fond in the bottome of his wound that therin was poyson\n And soo she heled hym[…]\n and therfore Tramtrist cast grete loue to la beale Isoud\n for she was at that tyme the fairest mayde and lady of the worlde\n And there Tramtryst lerned her to harpe\n and she beganne to haue grete fantasye vnto hym"
                                            },
                                            {
                                                "example_id": "cf442a3e-ea01-4b32-a5e4-2a404ee048cb",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "Sweete Prince, you learne me noble thankfulnes: […]"
                                            },
                                            {
                                                "example_id": "4497b675-4537-481e-be8c-e9ca4b4d27b4",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "Haue I not bene\n Thy Pupill long? Haſt thou not learn'd me how\n To make Perfumes?"
                                            },
                                            {
                                                "example_id": "3e3920cf-9cb9-4226-b6be-4d043535177b",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "[…] Take heed of filling their [i.e., children's] heads with VVhimzies, and unprofitable Notions; for this vvill ſooner learn them to be malepert and proud, than ſober and humble."
                                            },
                                            {
                                                "example_id": "eca1b2b6-ac6c-4f42-94c0-21b91fe10f02",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "But we’ll play Robin Hood—it’s noble fun. I’ll learn you."
                                            },
                                            {
                                                "example_id": "9b20120b-d9eb-4b83-b5ce-26a76b4ed854",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "That'll learn him to bust my tomater."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
