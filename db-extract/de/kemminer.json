                "senses": [
                    {
                        "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                        "entry_id": "86304fcf-4b01-3ca1-b14e-abf997fc8479",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19fa9b26-ae4c-4bae-8d12-888fb87f5f8a",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Frau Kemminer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b1bc8a6c-6f97-4119-9e71-34d1f12bf200",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Herr Kemminer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b0fa3196-574a-4b7c-9310-62065a270dbd",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Die Kemminers fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "0ca97496-4079-4776-a386-49becb1b3c89",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Der Kemminer trägt nie die Pullover, die die Kemminer ihm strickt."
                            },
                            {
                                "example_id": "a48805d5-d27b-414f-81cd-de8674fbb540",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kemminer kommt, geht der Herr Kemminer.“"
                            },
                            {
                                "example_id": "a2eb2d92-dc72-4d63-a9cc-e12fb422e414",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Kemminer kommt und geht."
                            },
                            {
                                "example_id": "9eddbf2d-2348-43d8-ac63-172842012fbb",
                                "sense_id": "0b60e448-3b25-31e6-822e-7bec831540a9",
                                "text": "Kemminers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
