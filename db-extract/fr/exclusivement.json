                                    {
                                        "sense_id": "8c33f0c0-05ee-3c68-88cb-14cb5b4cba18",
                                        "entry_id": "e90f2031-ac73-381a-bea9-4d1ed4c8e4f0",
                                        "glosses": [
                                            "Alone; exclusively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be69f4a3-e0ec-4e5b-b887-6191eff86159",
                                                "sense_id": "8c33f0c0-05ee-3c68-88cb-14cb5b4cba18",
                                                "text": "The new chef was solely responsible for attending the grill."
                                            },
                                            {
                                                "example_id": "d378981d-bc92-43e9-a610-180da470a784",
                                                "sense_id": "8c33f0c0-05ee-3c68-88cb-14cb5b4cba18",
                                                "text": "This week, officials closed all evacuation centers but two on Staten Island. Now they plan to rely solely on hotels, even as they brace for a new wave of people displaced from storm-damaged housing where they are facing winter without heat or hot water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
