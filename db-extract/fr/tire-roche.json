                        "entry_id": "d092e7b4-17d7-3721-92c9-693a5d71b2f4",
                        "glosses": [
                            "Catapulte d’enfant, constituée d’un manche fourchu et d’un élastique."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "38eab479-2974-457f-b73d-559f04996f54",
                                "sense_id": "a8750c78-4ec3-3ba3-9e98-40c8c3ebe1d3",
                                "text": "Anna avait une carabine prêtée par Bruno, tandis que Paul devrait se contenter d’un tire-roche."
                            },
                            {
                                "example_id": "7dfbbc0d-9cae-4088-b3a2-ed9c7752b13c",
                                "sense_id": "a8750c78-4ec3-3ba3-9e98-40c8c3ebe1d3",
                                "text": "Quand il a environ cinq ans, son père lui fait une paire de petites raquettes et un arc avec des flèches ou un tire-roche. Sa mère lui confectionne un beau parka en peau de lièvre."
                            },
                            {
                                "example_id": "7588cf3a-dc53-4aa2-8418-a662350703c4",
                                "sense_id": "a8750c78-4ec3-3ba3-9e98-40c8c3ebe1d3",
                                "text": "Denis, la petite peste, est souvent représenté avec un tire-roche dans sa poche arrière."
                            }
                        ]
                    }
