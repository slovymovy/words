                "senses": [
                    {
                        "sense_id": "b4b487c7-17a4-36b2-a78b-3c6d7d45c753",
                        "entry_id": "368d760d-21f2-3542-8131-350d4757e778",
                        "glosses": [
                            "termin powstały w środowisku feministycznym oznaczający społeczność zdominowaną przez mężczyzn z kultem fallicznym, władza mężczyzn we wszystkich dziedzinach życia społecznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346183a2-c3c5-4c90-868e-44d3cfc52f16",
                                "sense_id": "b4b487c7-17a4-36b2-a78b-3c6d7d45c753",
                                "text": "W naszych krajach rozpanoszyła się fallokracja. Niewiast nie dopuszcza się do głosu. Jeśli brzydka, traktuje się ją jak służebnicę. Jeśli ładna, jak zabawkę. I oto wybuchnie wielka, krwawa wojna nie o tron, nie o granicę, lecz o białogłowę"
                            },
                            {
                                "example_id": "facf78c8-cfe5-4d12-8fac-1fe91f552ff2",
                                "sense_id": "b4b487c7-17a4-36b2-a78b-3c6d7d45c753",
                                "text": "Fallokracja czy waginocentryzm? Głos feministek we współczesnej debacie o płci, języku i kulturze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
