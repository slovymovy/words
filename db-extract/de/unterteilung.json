                        "examples": [
                            {
                                "example_id": "5bd0f826-b848-467b-84d5-6a329c037b38",
                                "sense_id": "a147b19f-e0d6-3f05-b4d3-c09da33d3293",
                                "text": "„Zur Verbesserung der Lesbarkeit wird auf die Unterteilung von männlicher und weiblicher Bezeichnung verzichtet.“"
                            },
                            {
                                "example_id": "5e7600c2-2164-4ba1-84c0-e71f1693fee6",
                                "sense_id": "a147b19f-e0d6-3f05-b4d3-c09da33d3293",
                                "text": "„In der Praxis hat sich die Unterteilung von Kompetenzen in verschiedene Bereiche durchgesetzt.“"
                            },
                            {
                                "example_id": "e28c47f8-995d-44ef-ac6b-e16e9279d0a4",
                                "sense_id": "a147b19f-e0d6-3f05-b4d3-c09da33d3293",
                                "text": "„Besonders sorgfältig lernt er die Unterteilung von Internetadressen in A-, B- und C-Netze auswendig.“"
                            }
                        ],
