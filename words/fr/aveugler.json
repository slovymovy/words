{
    "word_family": [
        "aveugle",
        "aveuglement",
        "aveuglément"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee42ef2b-c1bd-3ecd-b808-6fdc25bd86db",
                    "sense_definition": "Éblouir en empêchant momentanément de voir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil couchant <w>aveugle</w> les automobilistes sur cette route rapide."
                        },
                        {
                            "text": "Les phares de la voiture en face m'<w>aveuglaient</w> pendant la nuit."
                        }
                    ],
                    "synonyms": [
                        "éblouir"
                    ],
                    "common_phrases": [
                        "aveugler les yeux"
                    ]
                },
                {
                    "sense_id": "e6220d62-a3e4-3b11-9192-7605525d5808",
                    "sense_definition": "Troubler l'esprit de quelqu'un, lui faire perdre son discernement ou sa lucidité.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa jalousie excessive finit par l'<w>aveugler</w> complètement sur ses véritables amis."
                        },
                        {
                            "text": "Il était tellement <w>aveuglé</w> par la colère qu'il n'écoutait plus aucun conseil."
                        }
                    ],
                    "synonyms": [
                        "égarer",
                        "obnubiler"
                    ],
                    "antonyms": [
                        "éclairer"
                    ],
                    "common_phrases": [
                        "aveuglé par la colère",
                        "aveuglé par l'orgueil"
                    ]
                },
                {
                    "sense_id": "82ff49c3-1c09-31d2-abc7-a91f6be408c1",
                    "sense_definition": "Priver définitivement de la vue, rendre infirme des yeux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grave infection peut <w>aveugler</w> un patient si elle n'est pas traitée à temps."
                        },
                        {
                            "text": "Dans les récits antiques, le tyran menaçait d'<w>aveugler</w> tous ses ennemis."
                        }
                    ]
                },
                {
                    "sense_id": "aa71bf54-d3a0-325c-9679-f7e253a9f3da",
                    "sense_definition": "Se faire des illusions et refuser de regarder la vérité en face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu t'<w>aveugles</w> sur les intentions de cette personne malgré toutes les preuves."
                        },
                        {
                            "text": "Les dirigeants de l'entreprise s'<w>aveuglent</w> face aux difficultés financières évidentes."
                        }
                    ],
                    "synonyms": [
                        "s'illusionner",
                        "se leurrer"
                    ],
                    "antonyms": [
                        "se détromper"
                    ],
                    "common_phrases": [
                        "s'aveugler sur ses défauts",
                        "s'aveugler volontairement"
                    ]
                },
                {
                    "sense_id": "ed10560b-8ed1-3cda-ae1d-abf133054b14",
                    "sense_definition": "Boucher complètement une ouverture ou condamner une fenêtre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant le siège, les habitants durent <w>aveugler</w> chaque fenêtre avec des briques."
                        },
                        {
                            "text": "Les ouvriers ont décidé d'<w>aveugler</w> cette ancienne baie pour renforcer le mur."
                        }
                    ],
                    "synonyms": [
                        "boucher",
                        "condamner",
                        "obstruer"
                    ],
                    "antonyms": [
                        "déboucher",
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "aveugler une fenêtre"
                    ]
                },
                {
                    "sense_id": "1b4ad0c5-5128-3be1-81a5-b9e17f6f6e1d",
                    "sense_definition": "Colmater ou boucher provisoirement une brèche par où l'eau pénètre dans un navire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a réussi à <w>aveugler</w> une voie d'eau avant que le navire ne sombre."
                        },
                        {
                            "text": "Le capitaine ordonna aux marins d'<w>aveugler</w> immédiatement la fissure dans la coque."
                        }
                    ],
                    "synonyms": [
                        "colmater",
                        "étancher"
                    ],
                    "common_phrases": [
                        "aveugler une voie d'eau"
                    ]
                }
            ]
        }
    ]
}