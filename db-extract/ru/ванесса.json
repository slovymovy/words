                ],
                "translations": [
                    {
                        "translation_id": "6f712dd6-3a6c-458f-834e-71dc948f5745",
                        "source_entry_id": "1ef1a6cf-2d15-3874-9243-7b84a9a62760",
                        "source_sense_id": "4721f37d-9132-34cb-bc42-b198dafc2f51",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Vanessa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vanessa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09a54af4-50fe-37fe-b817-112af3fdbaaa",
                                        "entry_id": "a40afd7a-f653-39ee-99ec-cc268107bc1c",
                                        "glosses": [
                                            "A female given name originating as a coinage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8373b53-e4a7-4b1c-85d7-96125e9ff602",
                                                "sense_id": "09a54af4-50fe-37fe-b817-112af3fdbaaa",
                                                "text": "Vanessa be the Name / By which thou shalt be known to Fame. / Vanessa, by the Gods enroll'd: / Her Name on Earth - shall not be told."
                                            },
                                            {
                                                "example_id": "05e96b3d-0267-4974-aa29-b60d9b7daad1",
                                                "sense_id": "09a54af4-50fe-37fe-b817-112af3fdbaaa",
                                                "text": "A kind of girl that May had before only seen in the pages of fashion magazines, bored, disdainful, elegant, reluctantly admitted her. - - - She was asked to see Vanessa on the way out. She knew that the girl would be called something like Vanessa."
                                            },
                                            {
                                                "example_id": "2de29a3d-1b7b-48db-95ef-9bf5957a0424",
                                                "sense_id": "09a54af4-50fe-37fe-b817-112af3fdbaaa",
                                                "text": "Vanessa likes the ultrapopular Madison as a girl's name, which tells you everything you need to know about her personality."
                                            },
                                            {
                                                "example_id": "63f41fdd-afaa-48b7-a177-b2d2e6993265",
                                                "sense_id": "09a54af4-50fe-37fe-b817-112af3fdbaaa",
                                                "text": "Democrats called for investigation, not resignation, after Vanessa Tyson accused Justin Fairfax of sexual assault earlier this week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
