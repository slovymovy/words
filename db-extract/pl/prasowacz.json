                                        "entry_id": "9a59a6d8-8e4e-33db-a8ac-acb6c9c899c4",
                                        "glosses": [
                                            "A person, device, or agent that presses or squeezes, as"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51441a61-5b9c-4cb6-93e6-5920ddf0b4ad",
                                                "sense_id": "bc2c67b4-9d91-35e9-9494-ea465a944dc0",
                                                "text": "Visiting a traditional vineyard, we watched the grape pressers treading the grapes underfoot."
                                            },
                                            {
                                                "example_id": "97e256ea-7b8b-4604-82ea-723460fc5e18",
                                                "sense_id": "bc2c67b4-9d91-35e9-9494-ea465a944dc0",
                                                "text": "That's the name of the people who make the polystyrene compound used by pressers of records that don't warp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6832fee-aad2-371c-9567-b1128519df5d",
                                        "entry_id": "9a59a6d8-8e4e-33db-a8ac-acb6c9c899c4",
                                        "glosses": [
                                            "A person, device, or agent that presses or squeezes, as:",
                                            "A member of a press-gang, who forces (presses) others into service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "203730ca-10ba-4380-b09a-78ce5098ad3f",
                                                "sense_id": "d6832fee-aad2-371c-9567-b1128519df5d",
                                                "text": "2012, Sophia Kingshill, The Estate of Jennifer Westwood, The Fabled Coast\nOvernight, North Shields was cordoned off by soldiers while the pressers descended in force, and left with a haul of more than two hundred and fifty men, including sailors, mechanics, and every kind of labourer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31373e06-2db7-3058-af04-f0cc7d34a790",
                                        "entry_id": "9a59a6d8-8e4e-33db-a8ac-acb6c9c899c4",
                                        "glosses": [
                                            "A person, device, or agent that presses or squeezes, as:",
                                            "A person or device that removes wrinkles, usually from clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fead22ba-8ba8-46bf-b9f0-9be1d0282044",
                                                "sense_id": "31373e06-2db7-3058-af04-f0cc7d34a790",
                                                "text": "He saw the man who did the cleaning and pressing for the hotel, a man whom he had always seen before in the gloom of the pressing shop sweating over a steam presser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95cb009-bbd2-37f9-951c-1c41a031d37b",
                                        "entry_id": "9a59a6d8-8e4e-33db-a8ac-acb6c9c899c4",
                                        "glosses": [
                                            "A person, device, or agent that presses or squeezes, as:",
                                            "Alternative spelling of pressor: synonym of vasopressor."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
