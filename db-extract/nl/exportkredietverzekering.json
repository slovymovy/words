                "senses": [
                    {
                        "sense_id": "100f8354-eba8-381f-b717-58a2ef821517",
                        "entry_id": "4242347e-f52c-3b0c-903a-467bb50aeb82",
                        "glosses": [
                            "verzekering op leningen aan het buitenland om uitvoer van goederen en diensten minder risicovol te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4086d0-5add-4e71-bb5c-03e302775c95",
                                "sense_id": "100f8354-eba8-381f-b717-58a2ef821517",
                                "text": "De Nederlandse overheid stond in 2020 voor ruim 1,5 miljard euro garant voor (toeleveranciers van) de olie- en gassector. Die ondersteuning loopt via Atradius Dutch State Business, de exportkredietverzekeraar van de Nederlandse Staat. \"Nederlandse bedrijven maken goederen die over de hele wereld in trek zijn. Met een exportkredietverzekering dekken ze de betalingsrisico's daarvan af,\" legt directeur van Atradius Bert Bruning uit. De exportkredietverzekering blijft bestaan, maar zal vanaf 2023 niet meer aan olie- en gasprojecten toegekend worden."
                            },
                            {
                                "example_id": "c841258d-b708-4376-97b5-84e76b3f0f4c",
                                "sense_id": "100f8354-eba8-381f-b717-58a2ef821517",
                                "text": "Ook in 2021 zijn er exportkredietverzekeringen afgesloten voor fossiele projecten over de hele wereld. De Nederlandse overheid kwam daardoor garant te staan voor projecten van Nederlandse bedrijven als Van Oord, Damen en IHC. Het gaat dit jaar tot nu toe om minstens 1,3 miljard euro aan garantstellingen die verband houden met de olie- en gassector."
                            },
                            {
                                "example_id": "314f5f7b-db01-410c-967a-380b6aa4a8d5",
                                "sense_id": "100f8354-eba8-381f-b717-58a2ef821517",
                                "text": "Staatssecretaris Wiebes schreef vorige maand aan de Kamer dat voor het afsluiten van een exportkredietverzekering geen sociale- en milieueffectenrapportage nodig was. Dat moet alleen bij projecten die langer duren dan twee jaar."
                            }
                        ]
                    }
