                "senses": [
                    {
                        "sense_id": "9450ebc5-c659-3bb1-bf2a-f43c86fe1d08",
                        "entry_id": "dc1a9655-b4e6-39c7-9139-813bc2ac4eab",
                        "glosses": [
                            "Spécialiste de la géopolitique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70b00d71-b05d-4138-b158-d59c9ad8f4b9",
                                "sense_id": "9450ebc5-c659-3bb1-bf2a-f43c86fe1d08",
                                "text": "La géopolitologue, spécialiste du Japon, revient sur le bilan de celui qui a bâti une partie de sa réputation sur sa fermeté vis-à-vis de la Corée du Nord, et prônait un Japon décomplexé de son passé."
                            },
                            {
                                "example_id": "5505f11b-5e4b-4e8d-9242-8da0de235a7d",
                                "sense_id": "9450ebc5-c659-3bb1-bf2a-f43c86fe1d08",
                                "text": "Situé au cœur de ce que les géopolitologues américains appellent le «Heartland» ou le «Pivot de la Terre», et fort de ces 2,725 millions de km2, le Kazakhstan est le neuvième plus grand pays du monde."
                            }
                        ]
                    }
