                                "target_senses": [
                                    {
                                        "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A generally accepted principle; a rule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccc58dd6-2d8b-42a0-8170-ec949e0f01af",
                                                "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                                                "text": "The trial must proceed according to the canons of law."
                                            },
                                            {
                                                "example_id": "e7bc6773-1e18-4034-9821-764c9b97047a",
                                                "sense_id": "13a46e23-9279-3fac-91e8-0950e38779a5",
                                                "text": "Or that the Everlasting had not fixed His canon 'gainst self-slaughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdad7c62-4e86-3591-be1b-65eed8035d89",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A generally accepted principle; a rule.",
                                            "A formally codified set of criteria deemed mandatory for a particular artistic style of figurative art."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e27188b-1adb-4d37-954a-c2d37faca8f5",
                                                "sense_id": "cdad7c62-4e86-3591-be1b-65eed8035d89",
                                                "text": "the Canon of Polykleitos"
                                            },
                                            {
                                                "example_id": "8c93c7ed-8f78-494b-a697-4c4e8cf1c0fc",
                                                "sense_id": "cdad7c62-4e86-3591-be1b-65eed8035d89",
                                                "text": "Despite the many advances made by modern scholars towards a clearer comprehension of the theoretical basis of the Canon of Polykleitos, the results of these studies show an absence of any general agreement upon the practical application of that canon in works of art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A group of literary works that are generally accepted as representing a field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51dd692c-b353-4b90-8a74-4ffcdbefeb48",
                                                "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                                                "text": "Russo had been working as a salesman, selling Great Books of the Western World, hawking the canon to the rubes."
                                            },
                                            {
                                                "example_id": "618de230-61b3-4048-8dda-60d4081edac9",
                                                "sense_id": "60a6ba14-e287-3ae8-9453-1ea8492c01a2",
                                                "text": "the durable canon of American short fiction"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91be24a8-5f19-34e5-9b6f-541ce9fa7914",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "The works of a writer that have been accepted as authentic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a723dae8-681b-493a-a358-7e959525cf6d",
                                                "sense_id": "91be24a8-5f19-34e5-9b6f-541ce9fa7914",
                                                "text": "the entire Shakespearean canon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08bdc04f-d943-3c62-a636-dcf43c55d0fb",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A eucharistic prayer, particularly the Roman Canon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ee0b220-3482-3ef7-92a6-dbfb681dd236",
                                        "entry_id": "c1fe615d-0041-3545-9d37-4c33e47372dc",
                                        "glosses": [
                                            "A religious law or body of law decreed by the church."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8e8f742-a52a-4191-b242-b00331a90101",
                                                "sense_id": "6ee0b220-3482-3ef7-92a6-dbfb681dd236",
                                                "text": "We must proceed according to canon law."
                                            }
                                        ]
                                    },
