                {
                    "sense_id": "025d11fe-1b5d-3d08-a4dc-9faa37ed3f81",
                    "sense_definition": "Défaire ce qui est emmêlé, séparer des fils, des cordes ou des mèches de cheveux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle passe de longues minutes à <w>démêler</w> les cheveux de sa fille après la baignade."
                        },
                        {
                            "text": "Il faut d'abord <w>démêler</w> les fils des écouteurs avant de pouvoir écouter de la musique."
                        }
                    ],
                    "synonyms": [
                        "débrouiller"
                    ],
                    "antonyms": [
                        "emmêler"
                    ],
                    "common_phrases": [
                        "démêler les cheveux",
                        "démêler les fils",
                        "démêler un nœud"
                    ]
                },
                {
                    "sense_id": "b301f9e1-c878-3ae8-b923-2a7b61be5e8e",
                    "sense_definition": "Mettre de l'ordre dans une affaire complexe ou confuse afin de la rendre compréhensible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eclaircir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat tente de <w>démêler</w> une affaire financière particulièrement compliquée."
                        },
                        {
                            "text": "Les journalistes d'investigation s'efforcent de <w>démêler</w> les rouages de ce scandale."
                        }
                    ],
                    "synonyms": [
                        "clarifier",
                        "débrouiller",
                        "élucider"
                    ],
                    "antonyms": [
                        "emmêler"
                    ],
                    "common_phrases": [
                        "démêler une affaire",
                        "démêler l'écheveau",
                        "démêler une intrigue"
                    ]
                },
                {
                    "sense_id": "f16f0675-6fd1-337b-bdee-a612d5ff5019",
                    "sense_definition": "Discerner ou distinguer par l'esprit des éléments confondus ou difficiles à percevoir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eclaircir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette situation ambiguë, il est difficile de <w>démêler</w> le vrai du faux."
                        },
                        {
                            "text": "Le juge essaye de <w>démêler</w> les intentions cachées derrière ces déclarations contradictoires."
                        }
                    ],
                    "synonyms": [
                        "discerner",
                        "distinguer"
                    ],
                    "common_phrases": [
                        "démêler le vrai du faux"
                    ]
                },
                {
                    "sense_id": "84ed3542-11f4-34f4-b49e-724273af5f60",
                    "sense_definition": "Avoir un litige, une discussion ou un différend à régler avec une personne.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voisin affirme qu'il n'a rien à <w>démêler</w> avec cette famille bruyante."
                        },
                        {
                            "text": "Je me demande bien ce que ces deux hommes peuvent avoir à <w>démêler</w> ensemble."
                        }
                    ],
                    "common_phrases": [
                        "avoir à démêler avec",
                        "rien à démêler avec"
                    ]
                }
            ]
        }
