                                                "example_id": "45815298-2206-439b-9fbd-01733077fbfc",
                                                "sense_id": "f8e04a61-e89a-329e-a91f-b669e36d66c2",
                                                "text": "Studies have narrowed the territorial focus to signage used in specific cities, townships, suburbs, precincts, etc."
