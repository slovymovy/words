                ],
                "senses": [
                    {
                        "sense_id": "a011acbc-6298-3b53-8dbc-d11982a21e89",
                        "entry_id": "a9e3ed86-fa4f-336d-ba30-b28cc1178379",
                        "glosses": [
                            "Epoche der Menschheitsgeschichte, etwa von 750 - 450 vor Christus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8c058c-56c4-48b1-a1cb-48382d41151a",
                                "sense_id": "a011acbc-6298-3b53-8dbc-d11982a21e89",
                                "text": "„Die in Hallstatt bzw. in La Tène gemachten Funde waren so typisch für ihre Zeit, daß die Namen Hallstatt- und Latènezeit auch auf weitere Funde außerhalb dieser beiden Orte übertragen wurden.“"
                            },
                            {
                                "example_id": "1c751530-2986-45fa-bea6-f7ad246eb68b",
                                "sense_id": "a011acbc-6298-3b53-8dbc-d11982a21e89",
                                "text": "„Für die Hallstattzeit liegen nur archäologische Zeugnisse vor, für die La-Tène-Zeit liegen sowohl archäologische Zeugnisse als auch schriftliche Quellen der antiken Autoren vor.“"
                            },
                            {
                                "example_id": "4f99dbcd-73d4-41de-b248-88eea4d8cd1c",
                                "sense_id": "a011acbc-6298-3b53-8dbc-d11982a21e89",
                                "text": "„Der Stil der Hallstattzeit geht nach und nach über in den La-Tène-Stil, der eindeutig keltisch sprechenden Menschen zuzuordnen ist.“"
                            },
                            {
                                "example_id": "c9534a38-d508-4a6f-a013-c993a9827d56",
                                "sense_id": "a011acbc-6298-3b53-8dbc-d11982a21e89",
                                "text": "„Die Hallstattzeit ist benannt nach einem Ort im österreichischen Salzkammergut, wo von 1846 an aufsehenerregende Funde aus der Eisenzeit geborgen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
