                                            {
                                                "example_id": "eeffd73e-5130-4e94-a360-c043f53859b6",
                                                "sense_id": "2a7b1d05-bf47-380d-a3a8-4264d46e066e",
                                                "text": "In de rizosfeer vinden allerlei nog grotendeels onbekende interacties tussen micro-organismen onderling en micro-organismen en planten plaats."
                                            }
                                        ]
                                    }
                                ]
