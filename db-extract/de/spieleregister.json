                "senses": [
                    {
                        "sense_id": "254c6ec3-5e04-35b5-894c-806737139782",
                        "entry_id": "01f8ae40-1cd8-32a5-a7fa-7800e72f0ca2",
                        "glosses": [
                            "Auflistung, Verzeichnis von Spielen, meist im Anhang von Spielebüchern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e86ce6-6a9d-42f1-9f42-40aec7f3f07f",
                                "sense_id": "254c6ec3-5e04-35b5-894c-806737139782",
                                "text": "„Im Anhang befinden sich ein Spieleregister und weiterführende Literaturhinweise.“"
                            },
                            {
                                "example_id": "71c7d3ca-69b8-490f-8a7a-acb40fdd5792",
                                "sense_id": "254c6ec3-5e04-35b5-894c-806737139782",
                                "text": "„Wer zu einem bestimmten Anlass, für seinen Unterricht, für den Kindergeburtstag oder für einen geselligen Abend, zündende Spielideen sucht, findet sie schnell und problemlos über das ausführliche Spieleregister oder unter den Schwerpunktkapiteln.“"
                            },
                            {
                                "example_id": "3cf9be5e-e2ae-4884-9ef2-15587561feba",
                                "sense_id": "254c6ec3-5e04-35b5-894c-806737139782",
                                "text": "„In einem einleitenden Spieleregister, das nach dem eingesetzten Spielgerät strukturiert ist, werden die angesprochenen Förderbereiche des jeweiligen Spiels genannt.“"
                            },
                            {
                                "example_id": "18ff0d5f-0120-4612-8683-b985b5bd0740",
                                "sense_id": "254c6ec3-5e04-35b5-894c-806737139782",
                                "text": "„Ein Spieleregister ermöglicht aber auch, daß man sich selbst ein Fest zusammenstellen kann.“"
                            },
                            {
                                "example_id": "2e052f87-8a7f-4aa6-b48d-f506a2eb1961",
                                "sense_id": "254c6ec3-5e04-35b5-894c-806737139782",
                                "text": "„Aus dem 14. Jahrhundert sind sogenannte Spieleregister überliefert, Aneinanderreihungen der Bezeichnungen für verschiedenste Spiele, die vorgetragen, vielleicht auch vorgesungen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
