                                "target_senses": [
                                    {
                                        "sense_id": "4ddf69c9-3111-3fe4-9bc8-9be3daf9c993",
                                        "entry_id": "d0c15382-f551-3dd0-adfe-b804390a960b",
                                        "glosses": [
                                            "Verdauung zelleigner Strukturen durch Phagozyten, zum Beispiel Lysosomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a058a0-c03e-4859-b050-e7b8ff941600",
                                                "sense_id": "4ddf69c9-3111-3fe4-9bc8-9be3daf9c993",
                                                "text": "„Wenn manche Zellen ihren Tod vor Augen haben, dann fangen sie an, sich selbst aufzufressen. Autophagie heißt dieser Mechanismus, den der Japaner Yoshinori Ohsumi erforscht hat - und für den er jetzt den Nobelpreis bekommt.“"
                                            },
                                            {
                                                "example_id": "fcc94975-427f-4771-abd1-46bc9ae1d2d7",
                                                "sense_id": "4ddf69c9-3111-3fe4-9bc8-9be3daf9c993",
                                                "text": "Der Mechanismus der Autophagie spielt neuerdings in der Krebsforschung eine herausragende Rolle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
