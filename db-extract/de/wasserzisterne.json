                "senses": [
                    {
                        "sense_id": "9851e1bd-fd58-3f4c-b0f3-165c8c144c9c",
                        "entry_id": "aca08d81-3d0a-3c6e-bbc2-1069d193e5a0",
                        "glosses": [
                            "Zisterne, in der Wasser gesammelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a0df74-934d-4f08-af31-3b7825f2290a",
                                "sense_id": "9851e1bd-fd58-3f4c-b0f3-165c8c144c9c",
                                "text": "„Das Forstministerium hat sieben Wasserzisternen eingeplant, für deren Bau eine halbe Million Euro veranschlagt wird.“"
                            },
                            {
                                "example_id": "531f68e9-4336-4934-a0cd-7b888b0c71cd",
                                "sense_id": "9851e1bd-fd58-3f4c-b0f3-165c8c144c9c",
                                "text": "„Über den Orden werden Wasserzisternen für die Trinkwasserversorgung errichtet und obdachlosen wie traumatisierten Kindern und Jugendlichen geholfen.“"
                            },
                            {
                                "example_id": "acfe104f-f5fe-4e3f-b675-028dbcc7dfdb",
                                "sense_id": "9851e1bd-fd58-3f4c-b0f3-165c8c144c9c",
                                "text": "„Die Golfanlage über Ebernburg glänzt nicht nur mit spielerischen Herausforderungen, sondern auch mit integrierten Wasserzisternen und Biotopen, Blütenwiesen und Nistplätzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
