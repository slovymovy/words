{
    "word_family": [
        "comedy",
        "comedian",
        "comic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5bc46a81-c07b-33d8-ad72-47b86c2234b6",
                    "sense_definition": "Funny or whimsically amusing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clown gave a <w>comical</w> performance that made all the children laugh.",
                            "target_lang_translations": {
                                "nl": "De clown gaf een <w>komische</w> voorstelling waar alle kinderen om moesten lachen."
                            }
                        },
                        {
                            "text": "He told a <w>comical</w> story about his cat getting stuck in a tree.",
                            "target_lang_translations": {
                                "nl": "Hij vertelde een <w>grappig</w> verhaal over zijn kat die vastzat in een boom."
                            }
                        }
                    ],
                    "synonyms": [
                        "comic",
                        "comedic"
                    ],
                    "common_phrases": [
                        "comical situation",
                        "comical character"
                    ],
                    "target_lang_definitions": {
                        "nl": "Grappig of op een speelse manier vermakelijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "grappig",
                                "target_lang_sense_clarification": "Algemeen woord voor iets dat de lachlust opwekt."
                            },
                            {
                                "target_lang_word": "komisch",
                                "target_lang_sense_clarification": "Iets dat grappig is door de manier waarop het zich voordoet."
                            },
                            {
                                "target_lang_word": "amusant",
                                "target_lang_sense_clarification": "Vermakelijk of vrolijk."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d14e6097-98ab-3a33-ab71-e1be0dd22450",
                    "sense_definition": "Laughable or ridiculous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humorous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>comical</w> error to wear a winter coat on such a hot day.",
                            "target_lang_translations": {
                                "nl": "Het was een <w>lachwekkende</w> fout om op zo'n hete dag een winterjas te dragen."
                            }
                        },
                        {
                            "text": "The idea that he could finish the project in one hour is simply <w>comical</w>.",
                            "target_lang_translations": {
                                "nl": "Het idee dat hij het project in één uur af zou kunnen krijgen is simpelweg <w>lachwekkend</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "comical error",
                        "comical mistake"
                    ],
                    "target_lang_definitions": {
                        "nl": "Om te lachen of belachelijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "lachwekkend",
                                "target_lang_sense_clarification": "Iets dat zo absurd is dat het belachelijk wordt."
                            },
                            {
                                "target_lang_word": "komisch",
                                "target_lang_sense_clarification": "Kan ook worden gebruikt voor situaties die door hun absurditeit grappig zijn."
                            },
                            {
                                "target_lang_word": "hilarisch",
                                "target_lang_sense_clarification": "Zeer grappig, vaak op een ietwat gekke of absurde manier."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba18087d-1037-3a87-a35e-546e265c73d2",
                    "sense_definition": "Relating to the genre of comedy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The play is a classic example of <w>comical</w> drama from the eighteenth century.",
                            "target_lang_translations": {
                                "nl": "Het toneelstuk is een klassiek voorbeeld van <w>komisch</w> drama uit de achttiende eeuw."
                            }
                        },
                        {
                            "text": "She studied the <w>comical</w> elements found in ancient Greek theater.",
                            "target_lang_translations": {
                                "nl": "Zij bestudeerde de <w>komische</w> elementen in het oude Griekse theater."
                            }
                        }
                    ],
                    "synonyms": [
                        "comedial"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op het genre van de komedie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "komisch",
                                "target_lang_sense_clarification": "Gerelateerd aan het genre komedie in theater of literatuur."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}