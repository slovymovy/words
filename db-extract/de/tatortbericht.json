                "senses": [
                    {
                        "sense_id": "e7b11528-f876-3b40-98d6-993b764d7652",
                        "entry_id": "d23e0867-f94a-32d5-aac2-9bfd071965c0",
                        "glosses": [
                            "Bericht über den Ort eines Verbrechens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5562b8d-197c-430b-84ae-30418e76fc8f",
                                "sense_id": "e7b11528-f876-3b40-98d6-993b764d7652",
                                "text": "„Vor dem Abflug rief er ihren Kontaktmann beim Konsulat an und bat ihn, seine Verbindungen bei der örtlichen Polizei spielen zu lassen, um ihm eine Kopie des Tatortberichts zu besorgen.“"
                            },
                            {
                                "example_id": "c41e9bb8-ab12-4143-b1ab-9a992bbfd8bd",
                                "sense_id": "e7b11528-f876-3b40-98d6-993b764d7652",
                                "text": "„Auf dem Rücksitz liegt eine Schachtel mit Akten zu Joes Fall. Sie enthalten Kopien von Tatortberichten, jede Menge Fotos und eine detaillierte Beschreibung der Beweisstücke.“"
                            }
                        ],
