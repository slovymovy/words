                "senses": [
                    {
                        "sense_id": "d9fad16b-26d8-3b44-9488-520dbb4feca1",
                        "entry_id": "dc125a93-07ab-31fb-8d16-b6e4a2f751b1",
                        "glosses": [
                            "iemand die samenwerkt, een medewerker"
                        ],
                        "tags": [],
