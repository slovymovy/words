                        "glosses": [
                            "Prudently, with thrift and foresight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f002d42f-4005-4631-8796-18b3f037ed5e",
                                "sense_id": "c9da8dad-eb6c-3cca-8403-30d4c729516c",
                                "text": "All that we have done comes as the result of a certain insistence that since we must work it is better to work intelligently and forehandedly."
                            }
                        ]
                    },
                    {
                        "sense_id": "803fe8eb-0022-3a2d-a992-64317cd8eacb",
                        "entry_id": "e1c1387e-ce01-3770-bdad-7a80ec6be463",
                        "glosses": [
                            "Ahead of time, in advance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c35c676a-42ee-49d3-95a0-33005be77886",
                                "sense_id": "803fe8eb-0022-3a2d-a992-64317cd8eacb",
                                "text": "Nevertheless, because of the frequent transposition between the two sexes of the traits supposedly specific of each -- a far more frequent transposition than the conventional division between the sexes affords opportunity to observe, the woman being often the more aggressive, the man the more retired of the two—to assign forehandedly one or the other complement to one or the other sex is arbitrary and without warrent."
                            }
                        ]
                    }
