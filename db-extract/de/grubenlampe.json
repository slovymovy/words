                    {
                        "sense_id": "6b431dd3-be42-3fcb-9a4f-fdd8c54f3534",
                        "entry_id": "cd2f4083-bdb8-3dec-a9a1-2496050def5c",
                        "glosses": [
                            "im Bergbau eingesetzte, tragbare Lampe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "833a392b-ad6b-4b3d-a581-5b9e93c43061",
                                "sense_id": "6b431dd3-be42-3fcb-9a4f-fdd8c54f3534",
                                "text": "„Talg wurde seit dem Mittelalter von den Bergleuten als Brennstoff für ihre Grubenlampen benutzt.“"
                            },
                            {
                                "example_id": "70895bd2-ec0d-44b3-8ce1-c70c44494236",
                                "sense_id": "6b431dd3-be42-3fcb-9a4f-fdd8c54f3534",
                                "text": "„Mit seiner Atemmaske und der Grubenlampe sah er aus wie ein Dämon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
