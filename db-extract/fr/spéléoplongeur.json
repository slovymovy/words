                    {
                        "sense_id": "0be4741e-1435-3691-bcf6-af6143bb53da",
                        "entry_id": "fd9f9bf0-647d-3a3e-8486-5fd2cf51d025",
                        "glosses": [
                            "Spéléologue dont la spécialité est d'explorer des conduits souterrains noyés par l'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89102de-ed5f-410d-b81a-8be51247f23c",
                                "sense_id": "0be4741e-1435-3691-bcf6-af6143bb53da",
                                "text": "La spéléologie est une activité scientifique, sportive ou de loisir qui consiste à explorer des cavités souterraines. Elle peut également se pratiquer en milieu aquatique. Dans ce cas, le spéléologue est alors appelé spéléoplongeur."
                            },
                            {
                                "example_id": "416ea4f6-3211-47fc-9199-d95c1080c10d",
                                "sense_id": "0be4741e-1435-3691-bcf6-af6143bb53da",
                                "text": "Le second est un ouvrage plus récent (1991), The Darkness Beckons (qu'on pourrait traduire par « l'appel des ténèbres »), dû à Martyn Farr. un grand spéléo-plongeur britannique."
                            }
                        ]
                    }
