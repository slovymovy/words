                                "target_senses": [
                                    {
                                        "sense_id": "a5ef5b9e-1340-3a4d-b315-737e29835ab0",
                                        "entry_id": "142d2ebf-78b6-320a-8413-e231ead69a00",
                                        "glosses": [
                                            "Qui dévore, engloutit sa nourriture avec avidité, en parlant d’un humain ou d’un animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a561c97-6fa1-4d69-8fb4-956a428c55c0",
                                                "sense_id": "a5ef5b9e-1340-3a4d-b315-737e29835ab0",
                                                "text": "Cet enfant a toujours été glouton."
                                            },
                                            {
                                                "example_id": "9e2b79e8-3064-4ad2-9e7a-8ca2f3239fce",
                                                "sense_id": "a5ef5b9e-1340-3a4d-b315-737e29835ab0",
                                                "text": "Le loup est un animal glouton."
                                            },
                                            {
                                                "example_id": "09a75975-da31-46b3-85b1-fc1b1ff682a8",
                                                "sense_id": "a5ef5b9e-1340-3a4d-b315-737e29835ab0",
                                                "text": "le développement durable est glouton"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec32a5c8-1c3b-3830-9eda-ddae6cb93f09",
                                        "entry_id": "142d2ebf-78b6-320a-8413-e231ead69a00",
                                        "glosses": [
                                            "Qui manifeste une grande avidité pour quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ced5cd4-b828-4e61-b6f9-b2dd345f2cd6",
                                                "sense_id": "ec32a5c8-1c3b-3830-9eda-ddae6cb93f09",
                                                "text": "Il veut contrôler un bien vital et racketter les consommateurs pour satisfaire la soif insatiable d’un État glouton et inefficace."
                                            },
                                            {
                                                "example_id": "e51c497d-69eb-4c33-9654-caf3c9f0e913",
                                                "sense_id": "ec32a5c8-1c3b-3830-9eda-ddae6cb93f09",
                                                "text": "Avec de prodigieuses vitesses de réaction, certaines enzymes sont gloutonnes en substrat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glouton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07df445a-21ef-3af5-bdd0-4bd38c66f0e1",
                                        "entry_id": "4e7d5af5-6ecd-3407-959a-f9b46fbd3686",
                                        "glosses": [
                                            "Personne ou animal qui mange avidement sa nourriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d525193f-24e1-4ed7-953c-85cfb3290bbf",
                                                "sense_id": "07df445a-21ef-3af5-bdd0-4bd38c66f0e1",
                                                "text": "J'avais mangé comme un glouton la moitié de mon assiette mais, à présent, mon estomac boudait. Je posai mes couverts, poussai légèrement mon assiette, et cherchai du courage pour parler à Charly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46bca0a1-978f-3508-82d2-86a522ed1b27",
                                        "entry_id": "4e7d5af5-6ecd-3407-959a-f9b46fbd3686",
                                        "glosses": [
                                            "Mammifère carnivore de l’Hémisphère Nord (Amérique du Nord, Scandinavie, Eurasie), ressemblant à un petit ours, avec une queue velue, de la famille des mustélidés, de nom scientifique Gulo gulo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81518260-cf4d-4b7b-8094-1da4939e40a8",
                                                "sense_id": "46bca0a1-978f-3508-82d2-86a522ed1b27",
                                                "text": "Le glouton est un animal solitaire."
                                            },
                                            {
                                                "example_id": "1c0ff5ed-a6b2-4738-89b9-4714ffb6f8ef",
                                                "sense_id": "46bca0a1-978f-3508-82d2-86a522ed1b27",
                                                "text": "La légendaire férocité du glouton (Gulo gulo) n’est pas un mythe. Endurant, le glouton est un véritable prédateur mais également un charognard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
