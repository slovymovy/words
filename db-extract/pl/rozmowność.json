                    {
                        "translation_id": "a1ccfe25-7451-49bf-b1c1-360081d4d03a",
                        "source_entry_id": "eb3f59d7-0a4d-3c1f-a016-229c6999cabe",
                        "source_sense_id": "1c7c0a0c-739f-3402-9ee2-8fe2c6f7a482",
                        "target_lang_word": "Gesprächigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesprächigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                        "entry_id": "232c5dfc-beb5-37ff-9850-6b7c9c4435e3",
                                        "glosses": [
                                            "Eigenschaft, gerne und viel zu reden, zu sprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f34d94c-cce0-4c02-8934-95521faeccf7",
                                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                                "text": "„Denn inzwischen war der Kaffee aufgetragen, und das Klappern der Tassen und die bald geweckte allgemeine Gesprächigkeit ließen vorläufig nur eine Unterhaltung im engsten Kreise zu.“"
                                            },
                                            {
                                                "example_id": "67d43eb4-7fba-4553-b61d-f08d7c409cb0",
                                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                                "text": "„Was ist in dem geselligen Gastmahl reizender als die Unterhaltung, die belebte Gesprächigkeit, und was belebt diese mehr als der Wein?“"
                                            },
                                            {
                                                "example_id": "aee5576d-f808-46de-a75c-b4124c6a48a8",
                                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                                "text": "„In deutlicher Geringschätzung wichen die herben Kelten der dringlichen Gesprächigkeit ihrer Nachbarn aus, mit unverhohlener Mißbilligung mieden sie ihre müßige Geselligkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3911d65-a686-4032-b8c7-8f520da6b553",
                        "source_entry_id": "eb3f59d7-0a4d-3c1f-a016-229c6999cabe",
                        "source_sense_id": "1c7c0a0c-739f-3402-9ee2-8fe2c6f7a482",
                        "target_lang_word": "Redseligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redseligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                        "entry_id": "eac94cde-89f9-3801-a6ca-41881d2aac7f",
                                        "glosses": [
                                            "Eigenschaft, gern und viel zu reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95429a27-e0c6-468c-87c1-19bc83e38ec0",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "Aufgrund seiner Redseligkeit ist er ein gefürchteter Kunde."
                                            },
                                            {
                                                "example_id": "60b4a866-595a-4508-bc6b-e5103392bbc7",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Grenfeld orderte mit einer seit Jahren eingeübten Handbewegung zwei Whiskeys und hoffte auf die einsetzende Redseligkeit seines Kollegen.“"
                                            },
                                            {
                                                "example_id": "a0d4c379-823d-4e5a-a8ee-0b4507ffd55b",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Schließlich gilt auch der Niederdeutsche dem Oberdeutschen als bedächtig und trocken, eher zur Wortkargheit als zur Redseligkeit geneigt.“"
                                            },
                                            {
                                                "example_id": "c99328fe-ce0e-4451-bf95-8c81695cbd12",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Ihre Redseligkeit brachte mich zum Lachen.“"
                                            },
                                            {
                                                "example_id": "30c4b3db-2180-4682-ae3b-c7df5b21e982",
                                                "sense_id": "f814ac59-68e4-3019-a12f-8f698a7a70a8",
                                                "text": "„Tüchtigkeit und Redseligkeit passen nicht zusammen, da ist etwas schief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
