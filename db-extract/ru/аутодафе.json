                                        "entry_id": "313e9ada-4a46-3a82-9fae-bb4b1ae35526",
                                        "glosses": [
                                            "Alternative spelling of auto da fe."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1be48f48-3bee-482c-8d9f-ab35a3286d0d",
                                                "sense_id": "4b7b84b9-5ff2-3cd8-9bcd-c1e1ef3687ad",
                                                "text": "The taste was of sweetened silt and arabica beans that hadn't been gently roasted so much as charred to death in their very own auto-da-fé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
