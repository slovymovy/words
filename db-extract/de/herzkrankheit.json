                        ],
                        "form": "die Herzkrankheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91699915-cce7-3de6-89bf-16fc0f11e091",
                        "entry_id": "e7bf0828-292d-3ed5-9c31-0cb88184e7c0",
                        "glosses": [
                            "akute oder chronische Entzündungen und Entartungen der einzelnen Teile des Herzens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164f60ba-a58f-4d60-8f84-65307f95b206",
                                "sense_id": "91699915-cce7-3de6-89bf-16fc0f11e091",
                                "text": "„Herz-Kreislauf-Erkrankungen sind in Industrieländern die häufigsten Todesursachen, allen voran die koronare Herzkrankheit.“"
                            },
                            {
                                "example_id": "97ecf90f-6930-42ee-9e92-190ea4689b97",
                                "sense_id": "91699915-cce7-3de6-89bf-16fc0f11e091",
                                "text": "„Untersuchungen haben zudem ergeben, dass es einen Zusammenhang zwischen Ärger und dem Auftreten von Herzkrankheiten sowie Bluthochdruck gibt.“"
                            },
                            {
                                "example_id": "caf7cac9-a41c-47bd-b4a6-536f26612787",
                                "sense_id": "91699915-cce7-3de6-89bf-16fc0f11e091",
                                "text": "„Bruno Frank und Franz Werfel sind gestorben, beide an ihren schweren Herzkrankheiten.“"
                            },
                            {
                                "example_id": "fa82af7d-3578-4d54-9cc9-7f32a018cd4e",
                                "sense_id": "91699915-cce7-3de6-89bf-16fc0f11e091",
                                "text": "„Im August 1982, kurz nach der Diagnose seiner Herzkrankheit, hatte Roth Bernard Malamud besucht, der sich damals von einem Schlaganfall und einer Bypass-Operation erholte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
