                                "target_senses": [
                                    {
                                        "sense_id": "085f434e-314e-3bea-8155-8c1b7ce74d34",
                                        "entry_id": "d1c1356d-faf2-3f40-aa3a-957069cf9ef4",
                                        "glosses": [
                                            "A person who uses hypnotism to induce hypnosis in someone, either for entertainment or therapy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc82c44-5ec1-42ed-8a7b-d9ccd7b3b606",
                                                "sense_id": "085f434e-314e-3bea-8155-8c1b7ce74d34",
                                                "text": "Following their modelling of Perls and Satir, Bandler and Grinder went on to model Milton H. Erickson, the world’s foremost medical hypnotist. The result was a different set of language patterns, the Milton Model, and the publication of the second NLP book, Patterns of the Hypnotic Techniques of Milton H. Erickson MD."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
