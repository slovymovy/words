                        "sense_id": "7d9a5da1-a993-35de-981b-a3a453d58865",
                        "entry_id": "e70b0624-49ae-3cb6-a072-481e072aaeb9",
                        "glosses": [
                            "(männliche^☆) Person, die bei einem Raub Juwelen erbeutet; die einen Juwelenraub durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a4d838-b275-4220-97a2-4196e2b19ca8",
                                "sense_id": "7d9a5da1-a993-35de-981b-a3a453d58865",
                                "text": "„Ein Juwelenräuber, der mit einem Messer bewaffnet war, wurde am 2. März kurz nach der Tat in Brigittenau von der Polizei festgenommen.“"
                            },
                            {
                                "example_id": "547efaa1-756b-45d2-86e5-7aa58e540383",
                                "sense_id": "7d9a5da1-a993-35de-981b-a3a453d58865",
                                "text": "„Die beiden Juwelenräuber gingen äußerst abgebrüht vor: Um 16.20 Uhr Ortszeit fuhren sie mit einem schwarzen Taxi vor und betraten das Nobelgeschäft ohne Masken und in edlen Anzügen und Krawatten - ganz so wie gute und wohlhabende Kunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
