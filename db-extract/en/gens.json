                                        "sense_id": "fd068a81-08a9-3ebf-a078-ff2408fb1b5e",
                                        "entry_id": "ac4b7659-f2ab-3076-a1ae-1cb49a5a3cf8",
                                        "glosses": [
                                            "организация людей в первобытном или патриархальном обществе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27230c8f-552f-491a-b0d9-82c94c20ddfa",
                                                "sense_id": "fd068a81-08a9-3ebf-a078-ff2408fb1b5e",
                                                "text": "Восстал род на род. Роды объединяются в племя. Старейшины рода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e53678-00a1-3b29-be47-c274e82df3ab",
                                        "entry_id": "ac4b7659-f2ab-3076-a1ae-1cb49a5a3cf8",
                                        "glosses": [
