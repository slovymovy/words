                    {
                        "sense_id": "516ba4db-5350-383c-8b75-a73131fdf843",
                        "entry_id": "998631b4-5987-3a87-8077-6e6ea66b4cd8",
                        "glosses": [
                            "Commune française, située dans le département de l’Ariège."
                        ],
                        "tags": [],
