                    ]
                },
                {
                    "sense_id": "c5722bf8-f5fa-30bd-8bf2-553c6f3bb691",
                    "sense_definition": "Section unitaire d'un jeu de barres dans un poste électrique, insécable par un appareillage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "electricite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette installation électrique complexe, le nombre de <w>sommets</w> ne dépasse jamais quatre unités."
                        },
                        {
                            "text": "Le technicien vérifie le raccordement de chaque <w>sommet</w> pour garantir la sécurité du réseau."
