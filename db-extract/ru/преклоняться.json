                ],
                "translations": [
                    {
                        "translation_id": "b5745169-d0f8-41c9-ac10-1f30075d8c31",
                        "source_entry_id": "8fccebf8-c64e-34d9-8cd6-765aab185aec",
                        "target_lang_word": "kneel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kneel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5a03a6e-50a1-33ee-8a29-e12b04e53014",
                                        "entry_id": "0c826e1d-e1d8-3ad8-b276-916b599170ba",
                                        "glosses": [
                                            "To rest on one's bent knees, sometimes only one; to move to such a position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3ccb4f-548c-4c10-a085-7b6315d2d791",
                                                "sense_id": "b5a03a6e-50a1-33ee-8a29-e12b04e53014",
                                                "text": "When the flames at last began to flicker and subside, his lids fluttered, then drooped ; but he had lost all reckoning of time when he opened them again to find Miss Erroll in furs kneeling on the hearth and heaping kindling on the coals, and her pretty little Alsatian maid beside her, laying a log across the andirons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2878aff-4c16-33ef-8f1a-ea45ce1a6c9b",
                                        "entry_id": "0c826e1d-e1d8-3ad8-b276-916b599170ba",
                                        "glosses": [
                                            "To sink down so that the entrance is level with the pavement, making it easier for passengers to enter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef5435f2-6e93-31df-ab20-31166b864ac2",
                                        "entry_id": "0c826e1d-e1d8-3ad8-b276-916b599170ba",
                                        "glosses": [
                                            "To cause to kneel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cac4dec-dc34-4fd1-ac53-5d3b895dc539",
                                                "sense_id": "ef5435f2-6e93-31df-ab20-31166b864ac2",
                                                "text": "She knelt the doll to fit it into the box."
                                            },
                                            {
                                                "example_id": "41e00191-cdf3-453b-9d55-d75e63ee3847",
                                                "sense_id": "ef5435f2-6e93-31df-ab20-31166b864ac2",
                                                "text": "Raising the girl with unexpected strength, she bore her towards the chapel, the firesparks flickered in her eyes, as she knelt her burden against the altar step."
                                            },
                                            {
                                                "example_id": "410a8b48-2e61-4d4c-9d8f-b7df66b12728",
                                                "sense_id": "ef5435f2-6e93-31df-ab20-31166b864ac2",
                                                "text": "Kneel him down and stick his head in. No, don't let him up, just hold him there."
                                            },
                                            {
                                                "example_id": "7da58dda-d04c-46c5-bf6b-4623dc7b6e95",
                                                "sense_id": "ef5435f2-6e93-31df-ab20-31166b864ac2",
                                                "text": "He took the wife in his car to the piney woods outside town, and knelt her down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32927735-f0fb-391d-a3c3-4de18a3882df",
                                        "entry_id": "0c826e1d-e1d8-3ad8-b276-916b599170ba",
                                        "glosses": [
                                            "To rest on (one's) knees."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7137dd41-d297-46d8-82bb-8d04323f18fe",
