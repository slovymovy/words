                        "entry_id": "b2c9a5ee-fa6b-3c1f-85b8-e1a3209c1d84",
                        "glosses": [
                            "A muddy playing field."
                        ],
                        "tags": [
                            "Australia",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d8e67ac0-debb-49b8-a73e-ca438b0b4723",
                                "sense_id": "9c78c3d6-cc61-33a3-8d57-7422d93819b6",
                                "text": "Frequent showers from the dark clouds that swept in and out over the Sydney Football Stadium turned the surface into something of a gluepot."
                            },
                            {
                                "example_id": "bbfa195b-b137-4d30-afac-5a30a7dc1a50",
                                "sense_id": "9c78c3d6-cc61-33a3-8d57-7422d93819b6",
                                "text": "\"We want to bring back the glue-pot. We're going to bog up the wings, bog up the goal squares, have big pools of water on the 50-metre arcs, and the centre square is going to be one of those really squeaky, sticky glue-pots that is a little bit on the nose."
                            },
                            {
                                "example_id": "530088f3-8aa8-495a-9458-58bdbb0a46a3",
                                "sense_id": "9c78c3d6-cc61-33a3-8d57-7422d93819b6",
                                "text": "Bradman countered a ‘gluepot’ pitch by opening with his tailenders and went to the wicket at 2.50pm the following day when Australia were 97 for 5."
                            }
                        ]
                    }
