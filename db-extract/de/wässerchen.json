                    {
                        "translation_id": "5708bcf3-4ae8-4fe7-a369-b657c4326b2c",
                        "source_entry_id": "be8446e3-1e29-315f-bdc3-ad512a7f0211",
                        "source_sense_id": "634f3970-cc19-3354-b26b-c9b10ae78e7a",
                        "target_lang_word": "petite eau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0c03b865-6547-4e88-a1a1-df1522c00d00",
                        "source_entry_id": "be8446e3-1e29-315f-bdc3-ad512a7f0211",
                        "source_sense_id": "634f3970-cc19-3354-b26b-c9b10ae78e7a",
                        "target_lang_word": "водка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "водка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e75b457c-43e2-3aad-9fd6-d116e0af1550",
                                        "entry_id": "752fc25c-ae32-3688-a4cf-fe7a0aaa775f",
                                        "glosses": [
                                            "крепкий алкогольный напиток, представляющий собой смесь максимально очищенного от примесей этилового спирта (от 38 до 56 объёмных процентов) с водой (иногда с ягодными, фруктовыми или ореховыми добавками или специями)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52961475-47ff-44a6-90ef-31715bc79389",
                                                "sense_id": "e75b457c-43e2-3aad-9fd6-d116e0af1550",
                                                "text": "Водка в доме водилась всегда, чтобы было чем угостить приятеля, если зайдёт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de815234-7f1d-3189-9a13-c96f3cac0ff0",
                                        "entry_id": "752fc25c-ae32-3688-a4cf-fe7a0aaa775f",
                                        "glosses": [
                                            "устар. спиртовой настой трав, цветов и т. п. лекарственного или косметического назначения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb2d9a4-395d-4d2e-bb76-80880527000a",
                                                "sense_id": "de815234-7f1d-3189-9a13-c96f3cac0ff0",
                                                "text": "После омыть приказал Тилемах всё оного тело, // А омыть приказал благовонными водками точно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8d15349-647f-309d-b7a1-fdd0bdd55435",
                                        "entry_id": "752fc25c-ae32-3688-a4cf-fe7a0aaa775f",
                                        "glosses": [
                                            "устар., хим., техн. то же, что кислота"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4539d2d3-1cd3-4bc0-a11d-9f096641c1c6",
                                                "sense_id": "b8d15349-647f-309d-b7a1-fdd0bdd55435",
                                                "text": "— Ну, конечно, ежели царской водкой либо купоросным маслом капнуть — дырка будет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
