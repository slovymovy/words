                    "sense_definition": "Indicates agreement on the part of the speaker.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Totally <w>agreed</w>, we should definitely go there.",
                            "target_lang_translations": {
                                "ru": "Полностью <w>согласен</w>, нам определенно стоит пойти туда.",
                                "zh": "完全<w>赞同</w>，我们绝对应该去那里。"
                            }
                        },
                        {
                            "text": "That is a wonderful idea, <w>agreed</w>!",
                            "target_lang_translations": {
                                "ru": "Это замечательная идея, <w>договорились</w>!",
                                "zh": "主意太棒了，<w>一言为定</w>！"
                            }
                        }
                    ],
                    "synonyms": [
