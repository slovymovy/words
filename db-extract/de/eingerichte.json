                        "glosses": [
                            "derjenige Teil eines Schlosses, der zum Schlüssel passt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f487e40-754a-40e9-b72c-a27c3216e65d",
                                "sense_id": "c09eb8e4-5fc4-34bf-b4f8-5beaa5dfbdd3",
                                "text": "Man unterscheidet bei einer Verschlusseinrichtung zwischen dem eigentlichen Schloss (Schlossart) und seinen Eingerichten (Schließsystem)."
                            }
                        ],
