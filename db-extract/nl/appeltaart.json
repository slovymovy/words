                    },
                    {
                        "translation_id": "7efb851f-d503-4a26-aac5-6b3d5be54b72",
                        "source_entry_id": "2955bfbd-f9bb-3783-a38f-3da6615a1321",
                        "source_sense_id": "3314d9ab-93b0-3ef3-afa9-47eb310eed2a",
                        "source_sense_description": "gebak gevuld met stukjes vruchten van de appelboom",
                        "target_lang_word": "Apfelkuchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfelkuchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e968a1c8-3d52-3cd2-87ba-f18c290c1dbf",
                                        "entry_id": "c5eb3737-ebbb-32f5-af11-bc665a869a90",
                                        "glosses": [
                                            "Kuchen mit Apfelspalten als Belag, Apfelmus als Füllung und dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2ae80d-10bd-4129-bcc9-022e7dadf42e",
                                                "sense_id": "e968a1c8-3d52-3cd2-87ba-f18c290c1dbf",
                                                "text": "Apfelkuchen bäckt man am besten aus säuerlichen, festen Äpfeln."
                                            },
                                            {
                                                "example_id": "bc989d8d-8e91-44cc-941f-102b22a0fe2c",
                                                "sense_id": "e968a1c8-3d52-3cd2-87ba-f18c290c1dbf",
                                                "text": "„Hinter der Theke im Café stand jetzt ein Mann, der frischen Apfelkuchen mit einem großen Messer in Stücke schnitt: das braune Gitterwerk aus Teig über dem grünen Apfelmus war frisch und der Mann drückte das Messer vorsichtig in den Kuchen, um das Gitterwerk nicht zu zerstören.“"
                                            },
                                            {
                                                "example_id": "7ec2049b-8c32-43ff-a10a-6a0a6f9ce4a3",
                                                "sense_id": "e968a1c8-3d52-3cd2-87ba-f18c290c1dbf",
                                                "text": "„Sie hatten einen Apfelkuchen und eine Thermosflasche Kaffee mitgebracht.“"
                                            },
                                            {
                                                "example_id": "39bd3b81-07ca-45fd-adeb-5f95f3c9f9bb",
                                                "sense_id": "e968a1c8-3d52-3cd2-87ba-f18c290c1dbf",
                                                "text": "„Touristen, sagt Papa, wandern nicht und beobachten auch nicht genau, Touristen lassen sich irgendwohin fahren und schauen dann, wo sie den nächsten Apfelkuchen mit Sahne bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffd630d6-ed3c-476b-b86b-36f42677f653",
                        "source_entry_id": "2955bfbd-f9bb-3783-a38f-3da6615a1321",
                        "source_sense_id": "3314d9ab-93b0-3ef3-afa9-47eb310eed2a",
