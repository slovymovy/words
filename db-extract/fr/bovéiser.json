                "senses": [
                    {
                        "sense_id": "e76c14ec-f7de-3cd3-9da2-d2fc8743852c",
                        "entry_id": "0f939634-84ed-3701-8a52-10e88c58f2fe",
                        "glosses": [
                            "Rendre plus proche de José Bové."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999a1aaf-182b-4e04-9547-80f803c04e58",
                                "sense_id": "e76c14ec-f7de-3cd3-9da2-d2fc8743852c",
                                "text": "Mais avec les défauts de ses qualités, le Moore, qui risque de se « bovéiser » s’il continue, joue trop sur la corde sensible."
                            },
                            {
                                "example_id": "fe849485-a8ff-48ae-95b7-8618ab39a60c",
                                "sense_id": "e76c14ec-f7de-3cd3-9da2-d2fc8743852c",
                                "text": "C’est bien parce qu’ils sentent que leur pouvoir nomenklaturiste rejoint celui des barons éliminés par l’histoire, que l’argumentation n’est pas de leur côté, qu’ils éprouvent le besoin de se bovéiser, lepéniser et ossamiser."
                            },
                            {
                                "example_id": "35b4266c-7fc7-4671-b95e-ec115cc39cbd",
                                "sense_id": "e76c14ec-f7de-3cd3-9da2-d2fc8743852c",
                                "text": "Votre « gourou » l’altermondialiste au jean levis ^([sic : Levi’s]) vous a dejà ^([sic : déjà]) bovéisé…"
                            }
                        ]
                    }
                ],
