                "senses": [
                    {
                        "sense_id": "c449ce87-ae8c-3500-8fbc-d6d1e99e5786",
                        "entry_id": "d9ed78ef-141a-33bf-ba3a-32ccd2e1bed0",
                        "glosses": [
                            "gebouw waarin kantoren gevestigd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0adbd3fb-c2d5-4c92-927f-29b7791de75a",
                                "sense_id": "c449ce87-ae8c-3500-8fbc-d6d1e99e5786",
                                "text": "De beveiligingsdienst van het VN–hof evacueerde uit voorzorg alle werknemers uit het administratiegebouw aan de Eisenhowerlaan. De Nederlandse politie heeft verder onderzoek verricht."
                            },
                            {
                                "example_id": "fc14572e-1fe4-456d-b039-cbb9e5a22f39",
                                "sense_id": "c449ce87-ae8c-3500-8fbc-d6d1e99e5786",
                                "text": "Volgens gouverneur Ahmed Diaa Eddin had de aartsbisschop eerder een overeenkomst getekend met het gouvernement. In deze overeenkomst wordt gesproken van de volledige sloop van het oude gebouw, met inbegrip van alle bijgebouwen. Diaa Eddin heeft inmiddels echter geconstateerd dat het oude administratiegebouw is blijven staan, evenals de toiletten en de muur."
                            }
                        ]
                    }
