                                            {
                                                "example_id": "c22b1c70-c050-4d5a-b9cd-ab28e66bef60",
                                                "sense_id": "be8d7750-db85-3081-ba3c-5f1bf8e2060f",
                                                "text": "Lubię sporty wodne – kiedyś byłem kajakarzem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "249607a9-a98a-47c0-946a-ca9ddf852508",
                        "source_entry_id": "a45440d3-b989-3c60-bf16-3310fac186a5",
                        "source_sense_description": "спортсмен",
                        "target_lang_word": "kayakiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kayakiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                        "entry_id": "00ddeeae-27ba-393a-91d3-ae8f5afeea3f",
                                        "glosses": [
                                            "Pagayeur qui pratique le kayak."
                                        ],
                                        "tags": [
                                            "Canoë-kayak"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "627e0a89-1066-42bc-9f01-414855d41daa",
                                                "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                                "text": "Un kayakiste doit en effet d’abord être en bonne forme physique."
                                            },
                                            {
                                                "example_id": "8996bea3-8c68-42c1-9ab5-25806443bb85",
                                                "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                                "text": "Et si vous êtes de ces pêcheurs, kayakistes, skieurs ou autres qui sont toujours à la fine pointe de la techno, vous savez très bien qu’il existe maintenant des appareils de sauvetage, de flottaison compacte, tout petits, que vous ne sentez plus une minute après les avoir attachés à votre corps."
                                            },
                                            {
                                                "example_id": "435cf530-8b10-4760-9548-0e6c52eca5eb",
                                                "sense_id": "bea05e4a-2078-3a3f-aeda-fbf8cae815a5",
                                                "text": "Après avoir décroché l’or en 2014 et 2021, et l’argent en 2009, le kayakiste français Boris Neveu a complété sa collection de médailles mondiales individuelles en slalom avec le bronze, samedi, sur le bassin d’Augsbourg, dans le sud de l’Allemagne."
                                            }
                                        ]
                                    }
                                ]
