                        "glosses": [
                            "Rendre sensible aux questions écologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4a97920-537c-4904-bc40-e0c4c9d797f0",
                                "sense_id": "9df58732-2cef-3b1d-8621-4d72d57468c5",
                                "text": "Organiser un éco-événement c'est éco-communiquer, éco-gérer, éco-responsabiliser et éco-sensibiliser !"
                            },
                            {
                                "example_id": "952e4321-b73c-49c6-8182-b0148bdb84d5",
                                "sense_id": "9df58732-2cef-3b1d-8621-4d72d57468c5",
                                "text": "Unilever souhaite aussi, en aval des ventes, éco-sensibiliser quatre cents millions de consommateurs en leur procurant des produits et des outils à même de faciliter la réduction des rejets carbone lors de leurs lessives et de leurs douches."
                            },
                            {
                                "example_id": "6b13b6ab-dd11-4f07-a576-7deb7f40e848",
                                "sense_id": "9df58732-2cef-3b1d-8621-4d72d57468c5",
                                "text": "éco-communiquer et éco-sensibiliser."
                            }
                        ]
