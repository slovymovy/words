                "senses": [
                    {
                        "sense_id": "30511748-b3cf-387a-959e-9a2f251cf2bd",
                        "entry_id": "ee5717ac-4fd6-3bdc-88a8-f85da03d0457",
                        "glosses": [
                            "ein fleckförmiger Bluterguss in Haut und Schleimhäuten als Folge von Mangel an Vitaminen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d249c78d-c127-4d7b-b640-fe6e816f9f4a",
                                "sense_id": "30511748-b3cf-387a-959e-9a2f251cf2bd",
                                "text": "Purpurfrieseln wurden normalerweise durch die Gabe von Vitamin C behandelt."
                            },
                            {
                                "example_id": "a1d28deb-d1d8-412f-afc7-9e90e96d3be2",
                                "sense_id": "30511748-b3cf-387a-959e-9a2f251cf2bd",
                                "text": "„Das Purpurfriesel kann mehreremale dieselbe Person befallen […].“"
                            },
                            {
                                "example_id": "1c6dd9f0-ef83-4b14-a222-6d267a1361e6",
                                "sense_id": "30511748-b3cf-387a-959e-9a2f251cf2bd",
                                "text": "Dieser Purpurfriesel soll ferner den ganzen Körper ohne Unterschied, doch am liebsten die Biegungen der Gelenke und die bedeckten Theile, am wenigsten das Gesicht befallen. (1838)"
                            }
                        ],
