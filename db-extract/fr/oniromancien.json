                        "glosses": [
                            "Personne qui pratique l’oniromancie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f78ac9-b04a-470d-8590-a926f81dff0d",
                                "sense_id": "71562375-3805-3c71-9edc-ff4ba265259b",
                                "text": "C’est la mission de l’oniromancien, l’interprète des rêves, qui peut être un chaman, un prêtre, un mage ou un devin, selon les époques et les cultures, mais qui est toujours un être contraint de respecter des règles et des lois strictes, de se soumettre à des rituels rigoureux, et qui consulte des formulaires d’interprétation des rêves."
                            }
                        ]
                    }
