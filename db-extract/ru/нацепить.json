                                                "sense_id": "3649c1d3-3731-39ba-afbe-37485d5925fb",
                                                "text": "Sie haben natürlich versucht, Paul den Diebstahl anzuhängen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "502e9298-0403-388b-ad6c-d945d374d238",
                                        "entry_id": "47538c45-272e-3150-aa5c-925c666edcc2",
                                        "glosses": [
