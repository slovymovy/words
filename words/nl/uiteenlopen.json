{
    "word_family": [
        "uiteenlopend",
        "uiteenlopendheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f51f0a4f-264d-3f81-948a-c095980c35f4",
                    "sense_definition": "van elkaar verschillen of niet overeenstemmen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verschil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De meningen over het nieuwe plan <w>lopen</w> sterk <w>uiteen</w> binnen de commissie.",
                            "target_lang_translations": {
                                "en": "Opinions on the new plan <w>differ</w> greatly within the committee."
                            }
                        },
                        {
                            "text": "Hij legt uit dat de levensopvattingen van de Han-Chinezen en Tibetanen altijd ver <w>uiteengelopen</w> hebben.",
                            "target_lang_translations": {
                                "en": "He explains that the life views of the Han Chinese and Tibetans have always <w>diverged</w> widely."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschillen",
                        "variëren",
                        "divergeren"
                    ],
                    "antonyms": [
                        "overeenstemmen",
                        "gelijken"
                    ],
                    "common_phrases": [
                        "sterk uiteenlopen",
                        "ver uiteenlopen",
                        "meningen lopen uiteen"
                    ],
                    "target_lang_definitions": {
                        "en": "to differ from each other or not be in agreement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "differ",
                                "target_lang_sense_clarification": "to be unlike or dissimilar"
                            },
                            {
                                "target_lang_word": "diverge",
                                "target_lang_sense_clarification": "to become different in character or opinion"
                            },
                            {
                                "target_lang_word": "vary",
                                "target_lang_sense_clarification": "to be different in size, amount, or degree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10871925-f86b-31f0-85ab-bc4efad3e87c",
                    "sense_definition": "zich vanuit één punt in verschillende richtingen van elkaar af bewegen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de splitsing <w>liepen</w> de twee paden steeds verder <w>uiteen</w> in het bos.",
                            "target_lang_translations": {
                                "en": "After the fork, the two paths <w>diverged</w> further and further in the forest."
                            }
                        },
                        {
                            "text": "Beider standpunten waren echter te veel <w>uiteengelopen</w> om nog tot een akkoord te komen.",
                            "target_lang_translations": {
                                "en": "However, both their viewpoints had <w>drifted</w> too far <w>apart</w> to reach an agreement."
                            }
                        }
                    ],
                    "synonyms": [
                        "divergeren",
                        "waaieren"
                    ],
                    "antonyms": [
                        "samenkomen",
                        "convergeren"
                    ],
                    "common_phrases": [
                        "verder uiteenlopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move away from each other in different directions from a single point"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "diverge",
                                "target_lang_sense_clarification": "to branch off in different directions"
                            },
                            {
                                "target_lang_word": "fan out",
                                "target_lang_sense_clarification": "to spread out from a central point"
                            },
                            {
                                "target_lang_word": "drift apart",
                                "target_lang_sense_clarification": "to move away from each other over time"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}