                        "glosses": [
                            "Personne qui fait du trekking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b04472a-020d-4288-9672-61f96ba6b307",
                                "sense_id": "d322acab-b720-32c5-8f9d-d9042a06c57f",
                                "text": "Aujourd’hui un avion vous dépose à Dar es Salaam après un vol tout confort, un rapide changement à l’aéroport, puis Air Tanzania, la piste du camp MacKenzie, la jeep et de suite, derrière les néons d'un motel, la crête déneigée du mont profanée chaque année par dix mille trekkeurs."
                            }
