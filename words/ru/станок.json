                                "target_lang_sense_clarification": "stojak rzeźbiarski"
                            },
                            {
                                "target_lang_word": "stojak",
                                "target_lang_sense_clarification": "ogólnie podstawa rzemieślnicza"
                            },
                            {
                                "target_lang_word": "krosno",
                                "target_lang_sense_clarification": "tkackie"
                            },
                            {
                                "target_lang_word": "prasa",
                                "target_lang_sense_clarification": "introligatorska"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f0a7ab6-76ea-3235-82c7-a10f85f16acc",
                    "sense_definition": "Техническая установка для бурения скважин.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Геологи доставили буровой <w>станок</w> в труднодоступный район тайги.",
                            "target_lang_translations": {
                                "en": "Geologists delivered a drilling <w>rig</w> to a remote area of the taiga.",
                                "pl": "Geolodzy dostarczyli <w>wiertnicę</w> w trudno dostępny rejon tajgi."
                            }
                        },
                        {
                            "text": "Мощный <w>станок</w> легко проходил сквозь твёрдые горные породы.",
                            "target_lang_translations": {
                                "en": "The powerful <w>rig</w> easily passed through hard rock formations.",
                                "pl": "Mocna <w>wiertnica</w> z łatwością przebijała się przez twarde skały."
                            }
                        }
                    ],
                    "synonyms": [
                        "установка"
                    ],
                    "common_phrases": [
                        "буровой станок"
                    ],
                    "target_lang_definitions": {
                        "en": "A technical installation for drilling wells.",
                        "pl": "Urządzenie techniczne lub instalacja przeznaczona do wiercenia otworów i studni."
                    },
                    "translations": {
