                                "target_lang_word": "artykuł",
                                "target_lang_sense_clarification": "publikacja naukowa"
                            },
                            {
                                "target_lang_word": "publikacja",
                                "target_lang_sense_clarification": "tekst naukowy"
                            },
                            {
                                "target_lang_word": "referat",
                                "target_lang_sense_clarification": "wystąpienie na konferencji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7449a4f-c4a0-3d8d-a7f5-3a66788e15e3",
                    "sense_definition": "A set of questions for an examination, or the document containing them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students were nervous before opening the math <w>paper</w>.",
                            "target_lang_translations": {
                                "ru": "Студенты нервничали перед тем, как открыть <w>экзаменационную работу</w> по математике.",
                                "pl": "Studenci byli zdenerwowani przed otwarciem <w>arkusza</w> z matematyki."
                            }
                        },
                        {
                            "text": "You will have two hours to complete this examination <w>paper</w>.",
                            "target_lang_translations": {
                                "ru": "У вас будет два часа на выполнение этого экзаменационного <w>задания</w>.",
                                "pl": "Będziecie mieć dwie godziny na ukończenie tego <w>arkusza</w> egzaminacyjnego."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exam paper",
                        "past paper"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор вопросов для экзамена или документ, содержащий их.",
                        "pl": "Zestaw pytań egzaminacyjnych lub dokument, który je zawiera."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экзаменационная работа",
                                "target_lang_sense_clarification": "документ с заданиями"
                            },
                            {
                                "target_lang_word": "билет",
                                "target_lang_sense_clarification": "экзаменационный"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "arkusz",
                                "target_lang_sense_clarification": "egzaminacyjny"
                            },
                            {
                                "target_lang_word": "test",
                                "target_lang_sense_clarification": "zestaw pytań"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5831dee-2938-39b9-a1b7-ea8bff5c6521",
                    "sense_definition": "A hand shape resembling a flat sheet, used in the game rock-paper-scissors.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "game_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I chose rock, but he chose <w>paper</w>, so he won the round.",
                            "target_lang_translations": {
                                "ru": "Я выбрал камень, но он выбрал <w>бумагу</w>, поэтому он выиграл раунд.",
                                "pl": "Wybrałem kamień, ale on wybrał <w>papier</w>, więc wygrał rundę."
                            }
                        },
                        {
                            "text": "In the game, <w>paper</w> beats rock but loses to scissors.",
                            "target_lang_translations": {
                                "ru": "В этой игре <w>бумага</w> побеждает камень, но проигрывает ножницам.",
                                "pl": "W tej grze <w>papier</w> bije kamień, ale przegrywa z nożycami."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock paper scissors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жест рукой, напоминающий плоский лист, используемый в игре «Камень, ножницы, бумага».",
                        "pl": "Kształt dłoni przypominający płaski arkusz, używany w grze kamień-papier-nożyce."
                    },
                    "translations": {
