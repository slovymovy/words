{
    "word_family": [
        "pass",
        "passenger",
        "passageway",
        "passable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "109dcd60-919f-31ff-bf32-7c248ba507df",
                    "sense_definition": "A long, narrow way, such as a corridor, path, or channel, that connects one place to another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_way",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked down a long, dark <w>passage</w> to reach the exit.",
                            "target_lang_translations": {
                                "ru": "Они шли по длинному темному <w>коридору</w>, чтобы добраться до выхода.",
                                "zh": "他们沿着一条又长又暗的<w>通道</w>走到了出口。"
                            }
                        },
                        {
                            "text": "A secret <w>passage</w> was hidden behind the bookshelf in the library.",
                            "target_lang_translations": {
                                "ru": "За книжной полкой в библиотеке был спрятан потайной <w>ход</w>.",
                                "zh": "图书馆的书架后面隐藏着一条秘密<w>通道</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrow passage",
                        "underground passage",
                        "secret passage",
                        "dark passage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный узкий путь, такой как коридор, тропа или канал, соединяющий одно место с другим.",
                        "zh": "连接两地的狭长通道，如走廊、路径或管道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "коридор",
                                "target_lang_sense_clarification": "в здании"
                            },
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "часто скрытый или подземный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通道",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "走廊",
                                "target_lang_sense_clarification": "建筑物内的通道"
                            },
                            {
                                "target_lang_word": "过道",
                                "target_lang_sense_clarification": "狭窄的行走空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb1dc15a-5b45-38fb-bc99-616b59741c4f",
                    "sense_definition": "A short section of a text, speech, or musical composition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "text_music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the student to read a <w>passage</w> from the novel aloud.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика прочитать вслух <w>отрывок</w> из романа.",
                                "zh": "老师让学生大声朗读小说中的一个<w>段落</w>。"
                            }
                        },
                        {
                            "text": "This musical <w>passage</w> is difficult to play because of its speed.",
                            "target_lang_translations": {
                                "ru": "Этот музыкальный <w>пассаж</w> трудно сыграть из-за его скорости.",
                                "zh": "这段音乐<w>片段</w>因为速度太快而很难演奏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "read a passage",
                        "famous passage",
                        "opening passage",
                        "musical passage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая часть текста, речи или музыкального произведения.",
                        "zh": "文本、演讲或音乐作品中的一小段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрывок",
                                "target_lang_sense_clarification": "часть текста"
                            },
                            {
                                "target_lang_word": "пассаж",
                                "target_lang_sense_clarification": "музыкальный или риторический"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "часть целого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "段落",
                                "target_lang_sense_clarification": "文本的一部分"
                            },
                            {
                                "target_lang_word": "片段",
                                "target_lang_sense_clarification": "音乐或文学作品的节选"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b053284a-9572-3524-9856-1779ac7378ee",
                    "sense_definition": "The act of moving through, across, or over a place; the process of passing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridge is too low to allow the <w>passage</w> of large trucks.",
                            "target_lang_translations": {
                                "ru": "Мост слишком низкий, чтобы позволить <w>проезд</w> больших грузовиков.",
                                "zh": "这座桥太低，无法让大型卡车<w>通行</w>。"
                            }
                        },
                        {
                            "text": "They were granted safe <w>passage</w> through the enemy territory.",
                            "target_lang_translations": {
                                "ru": "Им был предоставлен безопасный <w>проход</w> через вражескую территорию.",
                                "zh": "他们获准安全<w>通过</w>敌方领土。"
                            }
                        }
                    ],
                    "synonyms": [
                        "passing"
                    ],
                    "common_phrases": [
                        "safe passage",
                        "right of passage",
                        "force a passage",
                        "bird of passage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие перемещения через, сквозь или поверх места; процесс прохождения.",
                        "zh": "通过、穿过或越过某地的动作；通行的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "проезд",
                                "target_lang_sense_clarification": "на транспорте"
                            },
                            {
                                "target_lang_word": "переход",
                                "target_lang_sense_clarification": "пересечение пространства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通行",
                                "target_lang_sense_clarification": "允许通过的行为"
                            },
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "穿过某地的过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86a547e8-657d-37a6-bb88-c297b8699ba0",
                    "sense_definition": "The continuous progress or advance of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her memories faded with the <w>passage</w> of time.",
                            "target_lang_translations": {
                                "ru": "Её воспоминания поблекли с <w>течением</w> времени.",
                                "zh": "随着时间的<w>流逝</w>，她的记忆逐渐模糊了。"
                            }
                        },
                        {
                            "text": "Despite the <w>passage</w> of years, the house remained exactly the same.",
                            "target_lang_translations": {
                                "ru": "Несмотря на <w>прошествие</w> лет, дом остался точно таким же.",
                                "zh": "尽管岁月<w>推移</w>，房子依然保持原样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "passing"
                    ],
                    "common_phrases": [
                        "passage of time",
                        "with the passage of years"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный прогресс или течение времени.",
                        "zh": "时间的持续流逝或推移。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "времени"
                            },
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "развитие событий или времени"
                            },
                            {
                                "target_lang_word": "прошествие",
                                "target_lang_sense_clarification": "истечение срока"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流逝",
                                "target_lang_sense_clarification": "时间的推移"
                            },
                            {
                                "target_lang_word": "推移",
                                "target_lang_sense_clarification": "时间的演进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3c91e73-fe54-3b0d-9943-ec61c4dd292e",
                    "sense_definition": "The official approval of a law or bill by a legislative body.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government celebrated the <w>passage</w> of the new education bill.",
                            "target_lang_translations": {
                                "ru": "Правительство отпраздновало <w>принятие</w> нового законопроекта об образовании.",
                                "zh": "政府庆祝了新教育法案的<w>通过</w>。"
                            }
                        },
                        {
                            "text": "Lobbyists worked hard to ensure the speedy <w>passage</w> of the act.",
                            "target_lang_translations": {
                                "ru": "Лоббисты усердно работали, чтобы обеспечить скорое <w>принятие</w> закона.",
                                "zh": "游说者努力确保该法案能迅速<w>通过</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "passage of the bill",
                        "speedy passage",
                        "secure passage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное утверждение закона или законопроекта законодательным органом.",
                        "zh": "立法机构对法律或法案的正式批准。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принятие",
                                "target_lang_sense_clarification": "закона или решения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通过",
                                "target_lang_sense_clarification": "法律或法案的批准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3cfab13-3375-3f5d-81d0-492fbff8f811",
                    "sense_definition": "A journey, especially by sea, or the right to travel as a passenger on a ship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked on the ship to pay for his <w>passage</w> to America.",
                            "target_lang_translations": {
                                "ru": "Он работал на корабле, чтобы оплатить свой <w>проезд</w> в Америку.",
                                "zh": "他在船上工作以支付去美国的<w>船票</w>。"
                            }
                        },
                        {
                            "text": "She booked <w>passage</w> on the first steamer leaving the port.",
                            "target_lang_translations": {
                                "ru": "Она забронировала <w>место</w> на первом пароходе, покидающем порт.",
                                "zh": "她预订了第一艘离港轮船的<w>船票</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "book passage",
                        "work one's passage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествие, особенно по морю, или право на проезд в качестве пассажира на корабле.",
                        "zh": "旅行，尤指海路旅行，或作为乘客乘船旅行的权利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проезд",
                                "target_lang_sense_clarification": "право на путешествие"
                            },
                            {
                                "target_lang_word": "рейс",
                                "target_lang_sense_clarification": "путешествие"
                            },
                            {
                                "target_lang_word": "плавание",
                                "target_lang_sense_clarification": "морское путешествие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "船票",
                                "target_lang_sense_clarification": "乘船旅行的凭证"
                            },
                            {
                                "target_lang_word": "航程",
                                "target_lang_sense_clarification": "海上旅行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71ae1f3b-bd71-3004-8bf2-2af2e6293792",
                    "sense_definition": "A duct or channel in the body through which fluids or air can pass.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold caused a blockage in his nasal <w>passages</w>.",
                            "target_lang_translations": {
                                "ru": "Простуда вызвала закупорку в его носовых <w>ходах</w>.",
                                "zh": "感冒导致他的鼻<w>气道</w>堵塞。"
                            }
                        },
                        {
                            "text": "Air flows through the <w>passage</w> to reach the lungs.",
                            "target_lang_translations": {
                                "ru": "Воздух течет через <w>проход</w>, чтобы достичь легких.",
                                "zh": "空气流经<w>气道</w>到达肺部。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nasal passage",
                        "air passage"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проток или канал в теле, через который могут проходить жидкости или воздух.",
                        "zh": "体内供液体或空气通过的导管或通道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "анатомический"
                            },
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "дыхательный"
                            },
                            {
                                "target_lang_word": "канал",
                                "target_lang_sense_clarification": "проток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气道",
                                "target_lang_sense_clarification": "呼吸系统通道"
                            },
                            {
                                "target_lang_word": "管道",
                                "target_lang_sense_clarification": "解剖学通道"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f669489-b4ba-3c40-9bd8-2223148eb927",
                    "sense_definition": "To pass a pathogen, cell culture, or similar entity through a host or medium to maintain or modify it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers <w>passaged</w> the virus through several hosts to study its evolution.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>пассировали</w> вирус через несколько носителей, чтобы изучить его эволюцию.",
                                "zh": "研究人员将病毒在几个宿主中进行<w>传代</w>，以研究其进化过程。"
                            }
                        },
                        {
                            "text": "Cells must be <w>passaged</w> regularly to keep the culture healthy.",
                            "target_lang_translations": {
                                "ru": "Клетки необходимо регулярно <w>пассировать</w>, чтобы поддерживать культуру здоровой.",
                                "zh": "细胞必须定期<w>传代</w>以保持培养物的健康。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить патоген, культуру клеток или подобный объект через носителя или среду для его поддержания или изменения.",
                        "zh": "将病原体、细胞培养物等通过宿主或培养基进行传代，以维持或改变其特性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пассировать",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "传代",
                                "target_lang_sense_clarification": "生物学传代培养"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97cc2866-9ca9-3ee4-9d08-abab873f143b",
                    "sense_definition": "Of a bird: less than a year old but living independently, having left the nest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "falconry_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>passage</w> hawk is often easier to train than an older bird.",
                            "target_lang_translations": {
                                "ru": "<w>Перелётный</w> ястреб часто легче поддается дрессировке, чем более старая птица.",
                                "zh": "一只<w>幼鸟</w>通常比年长的鹰更容易训练。"
                            }
                        },
                        {
                            "text": "Falconers prize <w>passage</w> birds for their adaptability.",
                            "target_lang_translations": {
                                "ru": "Сокольники ценят <w>перелётных</w> птиц за их приспособляемость.",
                                "zh": "驯鹰人因其适应性而珍视这些<w>幼鸟</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "falconry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О птице: моложе года, но живущая самостоятельно, покинувшая гнездо (обычно пойманная во время миграции).",
                        "zh": "指鸟类：不到一岁但已离巢独立生活的幼鸟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перелётный",
                                "target_lang_sense_clarification": "о ловчей птице"
                            },
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "не выращенный в неволе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幼鸟",
                                "target_lang_sense_clarification": "指刚离巢的猛禽"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ca2c83ca-a03b-3422-bb6b-475af88cfa6a",
                    "sense_definition": "A town in Ireland, short for Passage West.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited <w>Passage</w> during their trip to County Cork.",
                            "target_lang_translations": {
                                "ru": "Они посетили <w>Пассаж</w> во время своей поездки в графство Корк.",
                                "zh": "他们在科克郡旅行期间参观了<w>帕萨奇</w>。"
                            }
                        },
                        {
                            "text": "The ship docked near <w>Passage</w> for repairs.",
                            "target_lang_translations": {
                                "ru": "Корабль пришвартовался возле <w>Пассажа</w> для ремонта.",
                                "zh": "船只停靠在<w>帕萨奇</w>附近进行维修。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в Ирландии, сокращение от Пассаж-Уэст.",
                        "zh": "爱尔兰的一个城镇，帕萨奇韦斯特的简称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пассаж",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帕萨奇",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}