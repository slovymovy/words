                            {
                                "example_id": "c096ce3a-9c17-40a3-abac-83c6e136b1e3",
                                "sense_id": "7ae927dd-fd95-3df6-9688-edec6639c0b4",
                                "text": "De vier medicijnen die het best in staat zijn om bij relatief lage concentraties het MERS-virus te remmen zijn het malariamedicijn Chloroquine, het antipsychoticum Chlorpromazine, de hiv-remmer Lopinavir en het anti-diarreemiddel Loperamide. Dat laatste medicijn is gewoon bij de drogist te koop."
                            },
                            {
                                "example_id": "c8e73cb4-f845-4257-8d2a-7c08054b9808",
                                "sense_id": "7ae927dd-fd95-3df6-9688-edec6639c0b4",
                                "text": "Zijn uitlatingen over experimentele coronamedicijnen, waaronder het middel chloroquine dat ook dienst heeft gedaan als malariamedicijn, kwam Trump ook op nogal wat kritiek te staan. ,,Ik ben een fan’’, zei hij over het middel in een persconferentie ,,Dit kan maar zo de grootste gamechanger zijn in de geschiedenis van de geneeskunde.’’ Uiteindelijk bleek chloroquine niet meer dan een hype."
                            }
                        ]
                    }
