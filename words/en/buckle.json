{
    "word_family": [
        "unbuckle",
        "buckler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4afc31ff-2d0b-3b01-a856-53d78081e0cc",
                    "sense_definition": "To fasten something using a buckle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>buckle</w> your seatbelt before the plane takes off.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>пристегните</w> ремень безопасности перед взлетом самолета."
                            }
                        },
                        {
                            "text": "He had to <w>buckle</w> the strap tightly to keep the heavy bag from falling.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось туго <w>застегнуть</w> ремешок, чтобы тяжелая сумка не упала."
                            }
                        }
                    ],
                    "antonyms": [
                        "unbuckle"
                    ],
                    "common_phrases": [
                        "buckle a seatbelt",
                        "buckle the strap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Застегнуть что-либо с помощью пряжки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застегнуть",
                                "target_lang_sense_clarification": "с помощью пряжки или застежки"
                            },
                            {
                                "target_lang_word": "пристегнуть",
                                "target_lang_sense_clarification": "ремнем безопасности или лямкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43d7805f-8b9d-39a7-846d-89c74dca7005",
                    "sense_definition": "To apply oneself to or prepare for a task or work with determination.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you want to pass the exam, you need to <w>buckle</w> down to your studies.",
                            "target_lang_translations": {
                                "ru": "Если хочешь сдать экзамен, тебе нужно <w>засесть</w> за учебу."
                            }
                        },
                        {
                            "text": "The team decided to <w>buckle</w> down and finish the project before the deadline.",
                            "target_lang_translations": {
                                "ru": "Команда решила <w>взяться за дело</w> и закончить проект до дедлайна."
                            }
                        }
                    ],
                    "synonyms": [
                        "buckle down"
                    ],
                    "common_phrases": [
                        "buckle down to work",
                        "buckle down to study"
                    ],
                    "target_lang_definitions": {
                        "ru": "Усердно приняться за работу или задачу с решимостью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взяться за дело",
                                "target_lang_sense_clarification": "с усердием"
                            },
                            {
                                "target_lang_word": "засесть",
                                "target_lang_sense_clarification": "за учебу или работу"
                            },
                            {
                                "target_lang_word": "налечь",
                                "target_lang_sense_clarification": "на учебу или работу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38379e77-fb65-35db-a2f7-8c17d77349b1",
                    "sense_definition": "To collapse, bend, or distort under physical pressure or heat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal beams began to <w>buckle</w> under the extreme weight of the snow.",
                            "target_lang_translations": {
                                "ru": "Металлические балки начали <w>прогибаться</w> под огромным весом снега."
                            }
                        },
                        {
                            "text": "The pavement started to <w>buckle</w> during the intense summer heatwave.",
                            "target_lang_translations": {
                                "ru": "Дорожное покрытие начало <w>коробиться</w> во время сильной летней жары."
                            }
                        }
                    ],
                    "synonyms": [
                        "crumple",
                        "fold"
                    ],
                    "common_phrases": [
                        "buckle under pressure",
                        "buckle under weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деформироваться, выгибаться или ломаться под воздействием физического давления или тепла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коробиться",
                                "target_lang_sense_clarification": "от жары или влаги"
                            },
                            {
                                "target_lang_word": "деформироваться",
                                "target_lang_sense_clarification": "под давлением"
                            },
                            {
                                "target_lang_word": "прогибаться",
                                "target_lang_sense_clarification": "под тяжестью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "423e24e6-9879-389d-8c1f-9a9d32efac6c",
                    "sense_definition": "To give in or yield to psychological pressure or stress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "collapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness finally started to <w>buckle</w> under the intense questioning of the lawyer.",
                            "target_lang_translations": {
                                "ru": "Свидетель, наконец, начал <w>сдаваться</w> под интенсивным допросом адвоката."
                            }
                        },
                        {
                            "text": "He is a strong leader who refuses to <w>buckle</w> under political pressure.",
                            "target_lang_translations": {
                                "ru": "Он сильный лидер, который отказывается <w>прогибаться</w> под политическим давлением."
                            }
                        }
                    ],
                    "synonyms": [
                        "cave in",
                        "surrender",
                        "fold"
                    ],
                    "common_phrases": [
                        "buckle under the strain",
                        "buckle under pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдаться или сломаться под психологическим давлением или стрессом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломаться",
                                "target_lang_sense_clarification": "под давлением"
                            },
                            {
                                "target_lang_word": "сдаться",
                                "target_lang_sense_clarification": "уступить обстоятельствам"
                            },
                            {
                                "target_lang_word": "пасовать",
                                "target_lang_sense_clarification": "перед трудностями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42c65e7c-a5e0-3011-9e73-0b49c087a99e",
                    "sense_definition": "To engage in a close fight, contest, or struggle.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two warriors were ready to <w>buckle</w> with each other in the arena.",
                            "target_lang_translations": {
                                "ru": "Два воина были готовы <w>схватиться</w> друг с другом на арене."
                            }
                        },
                        {
                            "text": "The small company had to <w>buckle</w> with a giant corporation to survive.",
                            "target_lang_translations": {
                                "ru": "Маленькой компании пришлось <w>вступить в борьбу</w> с гигантской корпорацией, чтобы выжить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "buckle with an enemy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the context of physical combat or old-fashioned struggles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступить в схватку, борьбу или противостояние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватиться",
                                "target_lang_sense_clarification": "в бою или споре"
                            },
                            {
                                "target_lang_word": "сцепиться",
                                "target_lang_sense_clarification": "с противником"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b5e2b87-9927-387c-ac71-24b4d31fbbe3",
                    "sense_definition": "To join people in marriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marriage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local curate was known to <w>buckle</w> couples for a small fee.",
                            "target_lang_translations": {
                                "ru": "Местный викарий был известен тем, что <w>венчал</w> пары за небольшую плату."
                            }
                        },
                        {
                            "text": "They decided to find someone who could <w>buckle</w> them quickly without a fuss.",
                            "target_lang_translations": {
                                "ru": "Они решили найти кого-то, кто мог бы быстро и без суеты их <w>поженить</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal or old-fashioned use for marrying"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять людей узами брака."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвенчать",
                                "target_lang_sense_clarification": "сочетать браком"
                            },
                            {
                                "target_lang_word": "женить",
                                "target_lang_sense_clarification": "разг. соединять пары"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f1801f5-19f3-38d1-94b2-c91cdb6dddd5",
                    "sense_definition": "A metal clasp used to fasten a belt or strap.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The silver <w>buckle</w> on his belt caught the light as he walked.",
                            "target_lang_translations": {
                                "ru": "Серебряная <w>пряжка</w> на его ремне поблескивала на свету при ходьбе."
                            }
                        },
                        {
                            "text": "She adjusted the <w>buckle</w> on her shoe to make it feel more comfortable.",
                            "target_lang_translations": {
                                "ru": "Она поправила <w>застежку</w> на туфле, чтобы было удобнее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "belt buckle",
                        "shoe buckle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлическая застежка, используемая для скрепления ремня или лямки."
