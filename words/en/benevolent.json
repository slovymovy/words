{
    "word_family": [
        "benevolence",
        "benevolently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aac1d33c-9f55-3447-a951-28c125416ee9",
                    "sense_definition": "Having a desire or disposition to do good for others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "kindness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>benevolent</w> king donated a large portion of his wealth to the local orphanage.",
                            "target_lang_translations": {
                                "tr": "<w>Hayırsever</w> kral, servetinin büyük bir kısmını yerel yetimhaneye bağışladı."
                            }
                        },
                        {
                            "text": "Many cultures view the sun as a <w>benevolent</w> force that provides life to the earth.",
                            "target_lang_translations": {
                                "tr": "Birçok kültür güneşi, dünyaya yaşam veren <w>iyiliksever</w> bir güç olarak görür."
                            }
                        }
                    ],
                    "synonyms": [
                        "kind",
                        "compassionate",
                        "generous"
                    ],
                    "antonyms": [
                        "malevolent"
                    ],
                    "common_phrases": [
                        "benevolent spirit",
                        "benevolent leader"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkalarına iyilik yapma arzusu veya eğilimi taşıyan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hayırsever",
                                "target_lang_sense_clarification": "İyilik yapmayı seven ve yardım eden kişi."
                            },
                            {
                                "target_lang_word": "iyiliksever",
                                "target_lang_sense_clarification": "İyilik yapmaktan hoşlanan, yardımsever."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f280139-b4d7-34c8-8634-e3b918810acc",
                    "sense_definition": "Showing kindness and love toward all people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kindness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>benevolent</w> nature made her a beloved figure in the community.",
                            "target_lang_translations": {
                                "tr": "<w>Özgeci</w> doğası, onu toplumda sevilen bir figür haline getirdi."
                            }
                        },
                        {
                            "text": "The organization is known for its <w>benevolent</w> efforts to help refugees around the world.",
                            "target_lang_translations": {
                                "tr": "Kuruluş, dünya çapındaki mültecilere yardım etmeye yönelik <w>hayırsever</w> çabalarıyla tanınır."
                            }
                        }
                    ],
                    "synonyms": [
                        "philanthropic",
                        "humanitarian"
                    ],
                    "antonyms": [
                        "malevolent"
                    ],
                    "common_phrases": [
                        "benevolent act",
                        "benevolent organization"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tüm insanlara karşı nezaket ve sevgi gösteren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "özgeci",
                                "target_lang_sense_clarification": "Kişisel çıkar gözetmeksizin başkalarına yararlı olmaya çalışan."
                            },
                            {
                                "target_lang_word": "fedakâr",
                                "target_lang_sense_clarification": "Başkalarının iyiliği için kendi çıkarlarından vazgeçebilen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ca275b6-4462-3f3b-b48b-6b343395f68e",
                    "sense_definition": "Acting in a way that is charitable, fair, and helpful to others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "kindness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>benevolent</w> donor provided scholarships for students who could not afford tuition.",
                            "target_lang_translations": {
                                "tr": "<w>Hayırsever</w> bağışçı, okul ücretini karşılayamayan öğrenciler için burs sağladı."
                            }
                        },
                        {
                            "text": "The judge made a <w>benevolent</w> decision that favored the underprivileged family.",
                            "target_lang_translations": {
                                "tr": "Yargıç, dezavantajlı ailenin lehine <w>iyiliksever</w> bir karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "charitable",
                        "altruistic"
                    ],
                    "antonyms": [
                        "malevolent"
                    ],
                    "common_phrases": [
                        "benevolent donor",
                        "benevolent fund"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başkalarına karşı yardımsever, adil ve destekleyici bir şekilde hareket eden."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hayırsever",
                                "target_lang_sense_clarification": "Özellikle maddi yardımda bulunan, bağış yapan."
                            },
                            {
                                "target_lang_word": "özgecil",
                                "target_lang_sense_clarification": "Başkalarını düşünen ve yardım etmeyi ilke edinen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}