                        "cross_references": [
                            {
                                "target_word": "gelijktijdig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "118cfe7e-2d85-3ba7-94d3-6cad5207e40f",
                                        "entry_id": "bc2964aa-54c8-3224-8a4b-ab9328b3413f",
                                        "glosses": [
                                            "op het zelfde moment plaats hebbende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1b3bef-2a0d-41d1-be34-3e64d145034c",
                                                "sense_id": "118cfe7e-2d85-3ba7-94d3-6cad5207e40f",
                                                "text": "Live Aid was een 16 uur durend internationaal benefietconcert op 13 juli 1985. Er trad een groot aantal vooraanstaande artiesten op. Het gehele evenement omvatte gelijktijdige optredens in de Verenigde Staten (JFK Stadium te Philadelphia), het Verenigd Koninkrijk (Wembley Stadium te Londen) en andere kleinere locaties waaronder Den Haag."
                                            },
                                            {
                                                "example_id": "e0e8dda1-af80-4e07-b4c8-091ea639739d",
                                                "sense_id": "118cfe7e-2d85-3ba7-94d3-6cad5207e40f",
                                                "text": "Er werd vrijwel gelijktijdig nog meer bier op de rustieke houten tafels neergesmakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
