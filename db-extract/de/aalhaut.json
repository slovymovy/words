                "senses": [
                    {
                        "sense_id": "9d54fae0-619d-33cb-a5f7-7f68c88a3cf9",
                        "entry_id": "91da2001-209f-3717-b410-a0cde430b2dd",
                        "glosses": [
                            "die Haut eines Aals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "269b9c2f-1941-48b4-9a17-9ec22c6ffcd6",
                                "sense_id": "9d54fae0-619d-33cb-a5f7-7f68c88a3cf9",
                                "text": "„Es war ein regnerischer Tag gewesen, und der Ladesteg war glitschig wie eine Aalhaut.“"
                            },
                            {
                                "example_id": "61fad61f-9345-46b0-ab82-0ef5021f2eb2",
                                "sense_id": "9d54fae0-619d-33cb-a5f7-7f68c88a3cf9",
                                "text": "Bis weit ins 19. Jahrhundert erhalten geblieben ist die Frisur in der preußischen Marine, wo die Matrosen ihre Zöpfe sehr fest flochten und mit Aalhaut überzogen oder mit geteerter Schnur umwickelten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "410d85f5-f5af-415f-9c6c-e3814e6af504",
                        "source_entry_id": "91da2001-209f-3717-b410-a0cde430b2dd",
                        "source_sense_id": "9d54fae0-619d-33cb-a5f7-7f68c88a3cf9",
