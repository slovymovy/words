                ],
                "senses": [
                    {
                        "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                        "entry_id": "ba09ae72-90c3-3ef5-be29-be08289e2581",
                        "glosses": [
                            "Maßnahmen gegen die Weitergabe einer Infektionskrankheit oder von Parasiten; Maßnahmen sind beispielsweise Impfungen oder Barrieren wie Atemschutzmasken oder Kondome (bei sexuell übertragbaren Krankheiten)"
                        ],
                        "tags": [
                            "Infektiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "f7938a5b-13d3-43d5-ac96-0d464c8ca8a5",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "[Schlagzeile:] „Christian Drosten: Corona-Impfung verliert schnell wieder an Übertragungsschutz“"
                            },
                            {
                                "example_id": "50bb383d-63cd-4189-a7b4-1694a73b853e",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "[Coronapandemie 2021:] „Dann wissen wir inzwischen viel deutlicher als damals im Juni, dass Geimpfte nach ein paar Monaten, nach vier, fünf, sechs Monaten deutlich den Übertragungsschutz verlieren.“"
                            },
                            {
                                "example_id": "b173e3c8-96c6-42da-aeb6-118e84638c34",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "[Schlagzeile:] „Übertragungsschutz: Stecken sich Brillenträger seltener mit Corona an?“"
                            },
                            {
                                "example_id": "604ecb4d-80a4-42bb-93c4-b2c8da1574f3",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "[Coronapandemie 2021:] „Vor allem in der Kreativwirtschaft ist das Nähen von Stoffmasken verbreitet. Produzenten drohen Abmahnungen, wenn sie diese Produkte zum Beispiel als „Atemschutz-“ oder „Mundschutzmaske“ bezeichnen. Diese Begriffe implizieren einen Übertragungsschutz, den selbstgenähte Stoffmasken nicht leisten können.“"
                            },
                            {
                                "example_id": "588af67f-7b76-442d-bbb7-5ced1d1f9a2b",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "[Coronapandemie 2021:] „Wir haben hier letztes Mal im Podcast eine Studie aus England besprochen, wo beispielsweise der Übertragungsschutz durch die Erstimpfung speziell in Haushaltsstudien ins Visier genommen wurde. Da konnte man sagen, selbst die Erstimpfung hält schon 50 Prozent aller Übertragungen ab.“"
                            },
                            {
                                "example_id": "2c172785-aa2d-4cbc-a922-2df2ad326fb5",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "[Coronapandemie 2021:] „Zudem zeigt sich, dass der Übertragungsschutz, den Geimpfte haben, sechs Monate nach der Impfung geringer wird.“"
                            },
                            {
                                "example_id": "54dd999b-5a07-4138-b584-f0b3b2dade6c",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "„Die heute gebräuchlichen Plastik-Einmalspritzen (Abb. 30.1, 30.2) werden einzeln steril verpackt geliefert. Sie bieten die folgenden Vorteile: Übertragungsschutz vor Infektionen, z.B. Hepatits, HIV oder Abzsessen, […].“"
                            },
                            {
                                "example_id": "9e7595d1-29dc-4e2e-83b2-9138e5b879ec",
                                "sense_id": "4801289f-4837-3a89-be1c-22a6f68ffd3d",
                                "text": "„Die erkrankten Großkatzen im Bronx Zoo halten sich wacker und werden wohl bald wieder gesund sein. Dennoch arbeiten die Tierpfleger dort jetzt mit erhöhten Auflagen zum Übertragungsschutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
