{
    "word_family": [
        "submersion",
        "submersible",
        "insubmersible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3263c82-4eaa-389b-aa80-b99b6d97e4b0",
                    "sense_definition": "Recouvrir entièrement d'eau, faire disparaître sous les flots.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vagues géantes ont fini par <w>submerger</w> la jetée pendant la tempête nocturne.",
                            "target_lang_translations": {
                                "en": "The giant waves eventually <w>submerged</w> the jetty during the overnight storm.",
                                "ru": "Гигантские волны в конце концов <w>затопили</w> мол во время ночного шторма.",
                                "de": "Die riesigen Wellen haben die Mole während des nächtlichen Sturms schließlich <w>überflutet</w>.",
                                "es": "Las olas gigantes acabaron por <w>inundar</w> el espigón durante la tormenta nocturna.",
                                "zh": "在夜间的暴风雨中，巨浪终于<w>淹没</w>了防波堤。"
                            }
                        },
                        {
                            "text": "Si le niveau de la mer monte, l'eau va rapidement <w>submerger</w> cette petite île côtière.",
                            "target_lang_translations": {
                                "en": "If the sea level rises, the water will quickly <w>submerge</w> this small coastal island.",
                                "ru": "Если уровень моря поднимется, вода быстро <w>затопит</w> этот небольшой прибрежный остров.",
                                "de": "Wenn der Meeresspiegel steigt, wird das Wasser diese kleine Küsteninsel schnell <w>überfluten</w>.",
                                "es": "Si sube el nivel del mar, el agua no tardará en <w>sumergir</w> esta pequeña isla costera.",
                                "zh": "如果海平面上升，海水很快就会<w>淹没</w>这座沿海小岛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inonder",
                        "engloutir"
                    ],
                    "common_phrases": [
                        "submerger les côtes",
                        "être submergé par les eaux"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover completely with water, making something disappear beneath the waves.",
                        "ru": "Полностью покрыть водой, заставив что-либо скрыться под волнами.",
                        "de": "Etwas vollständig mit Wasser bedecken, sodass es unter den Wellen verschwindet.",
                        "es": "Cubrir por completo con agua, haciendo que algo desaparezca bajo las olas.",
                        "zh": "用水把某物完全盖住，使其消失在水面之下。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "submerge",
                                "target_lang_sense_clarification": "beneath water or waves"
                            },
                            {
                                "target_lang_word": "engulf",
                                "target_lang_sense_clarification": "water or waves swallowing something"
                            },
                            {
                                "target_lang_word": "inundate",
                                "target_lang_sense_clarification": "flooding land with water"
                            }
                        ],
                        "ru": [
