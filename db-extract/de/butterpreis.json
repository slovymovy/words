                ],
                "senses": [
                    {
                        "sense_id": "9b66aa25-a534-3d1a-bcb3-7fd73ba50716",
                        "entry_id": "70a2ab3a-4b0c-3ac7-8969-b3494fc414b3",
                        "glosses": [
                            "Preis für Butter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4543af-2a59-4230-967d-70233df9c7a8",
                                "sense_id": "9b66aa25-a534-3d1a-bcb3-7fd73ba50716",
                                "text": "„Beispielsweise sind Butter und Margarine Substitutionsgüter. Steigt etwa der Butterpreis gegenüber dem Margarinepreis, wird Butter im Vergleich zu Margarine unattraktiver und die Nachfrage nach Margarine erhöht sich.“"
                            },
                            {
                                "example_id": "17719487-e52d-40f5-828b-02d588b90dca",
                                "sense_id": "9b66aa25-a534-3d1a-bcb3-7fd73ba50716",
                                "text": "„Die Norwegische Butterkrise begann Ende 2011 mit einer akuten Verknappung von Butter und einer Steigerung der Butterpreise auf den Märkten Norwegens.“"
                            },
                            {
                                "example_id": "44e7db8d-7f0c-4bc1-ba80-d3839dbee435",
                                "sense_id": "9b66aa25-a534-3d1a-bcb3-7fd73ba50716",
                                "text": "„Über seine Ehe mit »Mischa« ist viel gekrittelt worden, doch das brave Mädchen in der Schürze war gleichzeitig prosaisch und großherzig genug, auch glücklose Umstände zu ertragen und hatte trotz ihrer intellektuellen Einfachheit doch Geist genug, ihrem Mann niemals mit Suaden über die Hauswirtschaft, ein geordnetes Leben, die schöne Karriere, die Gründung einer kinderreichen Familie und den Butterpreis lästig zu fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
