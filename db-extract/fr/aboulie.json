        "fr-extract.jsonl": [
            {
                "entry_id": "c8b0227b-7090-3d65-b4bf-1fe1996a6828",
                "word": "aboulie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89a35753-54e8-45d7-9c5f-a35fe8ae51ad",
                        "entry_id": "c8b0227b-7090-3d65-b4bf-1fe1996a6828",
                        "tags": [
                            "plural"
                        ],
                        "form": "aboulies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "467e3362-a3e9-3ae8-940d-fb9459b59c25",
                        "entry_id": "c8b0227b-7090-3d65-b4bf-1fe1996a6828",
                        "glosses": [
                            "Trouble mental caractérisé par une perte de la volonté et une grande difficulté à se décider, à agir (perte de l’initiative)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6df7bc-dc05-4787-bfa6-70155ec9a925",
                                "sense_id": "467e3362-a3e9-3ae8-940d-fb9459b59c25",
                                "text": "En fait l’aboulie est toujours plus ou moins générale."
                            },
                            {
                                "example_id": "3bb6e81f-7946-40d5-a659-fa7ddb160c0e",
                                "sense_id": "467e3362-a3e9-3ae8-940d-fb9459b59c25",
                                "text": "Les prières collectives qui rythmaient les jours et les heures (…) installaient les ouailles dans une bienheureuse hébétude, et les psalmodies diffusées entre les neuf prières quotidiennes par des haut-parleurs infatigables, accrochés aux bons endroits du sanatorium, se répercutaient de cloisons en parois, de couloirs en chambrées, entrelaçant à l'infini leurs échos lénitifs pour maintenir l'attention au ras de l'aboulie. […] Dans le regard absent des orants brillait la même douce et vibrante lumière de l'acceptation, elle ne les quittait jamais."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab1a40fd-b4a8-3f3b-ae0b-c2ae748ffc46",
                        "entry_id": "c8b0227b-7090-3d65-b4bf-1fe1996a6828",
                        "glosses": [
                            "Incapacité anormale du passage à l’action dans le vouloir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9259a635-2f4d-46c8-a265-f834d83200b2",
                                "sense_id": "ab1a40fd-b4a8-3f3b-ae0b-c2ae748ffc46",
                                "text": "« J’ai passé mon temps à avertir et à protester contre nos postures, nos facilités, parce que cette aboulie m’est devenue insupportable » (Manuel Valls)"
                            },
                            {
                                "example_id": "95ccf83a-0cf3-4b96-b786-2c85237d0ae7",
                                "sense_id": "ab1a40fd-b4a8-3f3b-ae0b-c2ae748ffc46",
                                "text": "On diagnostiquera à juste titre ce que Besnier-Thomas nomment « une maladie de la volonté ». Mais cette maladie est peut-être davantage qu’une aboulie. La gauche « qui ne sait plus ce qu’elle veut » ne se contente plus de se taire, mais prend l’habitude de faire sien le grand discours de régression d’une droite dont elle envie la bonne santé, d’une droite à l’entrain réactionnaire communicatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9724e8b7-98dd-421c-99b1-c898d1e4f538",
                        "source_entry_id": "c8b0227b-7090-3d65-b4bf-1fe1996a6828",
                        "target_lang_word": "Abulie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abulie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00b4a8a8-95f2-354f-b643-f65939958520",
                                        "entry_id": "4f00179e-fb37-3067-81da-76548b2c8586",
                                        "glosses": [
                                            "krankhafte Willensschwäche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade3e7a3-a2a1-40da-8206-d0f1ee89667d",
                                                "sense_id": "00b4a8a8-95f2-354f-b643-f65939958520",
                                                "text": "Die Abulie ist keine eigenständige und somit behandelbare Krankheit, sondern stellt stets ein Symptom einer anderen Erkrankung dar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
