                        "depuis toujours",
                        "depuis peu"
                    ]
                },
                {
                    "sense_id": "ae912ec1-9ced-3a57-b5c9-4257944fb385",
                    "sense_definition": "Indique le point de départ dans l'espace, le lieu d'où s'effectue une action ou d'où s'exerce une perception.",
