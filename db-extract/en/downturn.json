                                        "entry_id": "328359c3-2016-3bff-b93f-882e63cb13b2",
                                        "glosses": [
                                            "eine Bewegung von etwas nach unten, das zuvor (mindestens) einen Aufschwung (eine Bewegung nach oben) hatte"
                                        ],
                                        "tags": [
