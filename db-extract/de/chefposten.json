                "senses": [
                    {
                        "sense_id": "e2127bdc-b5b2-3955-84ea-1f54f811cb1b",
                        "entry_id": "df24376e-dca2-32e8-8537-ed22608260e7",
                        "glosses": [
                            "Arbeitsstelle als oberster Leiter eines Unternehmens oder einer Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c30ff8-032f-431e-ba9a-73354916d93a",
                                "sense_id": "e2127bdc-b5b2-3955-84ea-1f54f811cb1b",
                                "text": "„Erst kürzlich musste der Brite John Cryan den Chefposten vorzeitig räumen, weil dem Aufsichtsratschef Paul Achleitner die Wende nicht schnell genug ging.“"
                            },
                            {
                                "example_id": "cfb85e1f-d077-42a2-9769-a3bf6bfd5d87",
                                "sense_id": "e2127bdc-b5b2-3955-84ea-1f54f811cb1b",
                                "text": "„Nach gut hundert Jahren Emanzipationsbewegung haben Frauen zwar nicht die Hälfte der Chefposten inne, dennoch ist es ihnen mit einer Art Guerillataktik gelungen, die westliche Kultur nachhaltig zu feminisieren.“"
                            },
                            {
                                "example_id": "429448c9-ba31-41f0-93cd-0ce64a6714fc",
                                "sense_id": "e2127bdc-b5b2-3955-84ea-1f54f811cb1b",
                                "text": "„Er hatte jetzt den Chefposten inne, war der Herr der Polizeiwache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
