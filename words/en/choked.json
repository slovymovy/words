                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verslikte",
                                "target_lang_sense_clarification": "verleden tijd van zich verslikken"
                            },
                            {
                                "target_lang_word": "stikte",
                                "target_lang_sense_clarification": "verleden tijd van stikken"
                            },
                            {
                                "target_lang_word": "verstikte",
                                "target_lang_sense_clarification": "verleden tijd van verstikken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "325545e3-19fc-35d7-8534-09829ba9b752",
                    "sense_definition": "Suffering from severe difficulty in breathing due to airway obstruction or constriction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suffocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>choked</w> child coughed repeatedly until the doctor arrived.",
                            "target_lang_translations": {
                                "nl": "Het <w>stikkende</w> kind hoestte herhaaldelijk totdat de dokter arriveerde."
                            }
                        },
                        {
                            "text": "Firefighters rescued the <w>choked</w> victim from the smoke-filled building.",
                            "target_lang_translations": {
                                "nl": "Brandweerlieden redden het <w>verstikte</w> slachtoffer uit het met rook gevulde gebouw."
                            }
                        }
                    ],
                    "synonyms": [
                        "suffocated",
                        "asphyxiated"
                    ],
                    "target_lang_definitions": {
                        "nl": "Lijdend aan ernstige ademhalingsproblemen door belemmering of vernauwing van de luchtwegen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stikkend",
                                "target_lang_sense_clarification": "naar adem snakkend"
                            },
                            {
                                "target_lang_word": "verstikt",
                                "target_lang_sense_clarification": "geen lucht meer krijgend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bfd60c1-f81b-3574-ba36-52c49dc2a0aa",
                    "sense_definition": "Blocked, clogged, or heavily obstructed, especially by debris, vegetation, or congestion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "blockage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small garden path was completely <w>choked</w> with weeds.",
                            "target_lang_translations": {
                                "nl": "Het kleine tuinpad was volledig <w>overwoekerd</w> door onkruid."
                            }
                        },
                        {
                            "text": "The narrow river became <w>choked</w> with fallen branches after the storm.",
                            "target_lang_translations": {
                                "nl": "De smalle rivier raakte na de storm <w>verstopt</w> met afgewaaide takken."
                            }
                        }
                    ],
                    "synonyms": [
                        "blocked",
                        "clogged",
                        "obstructed"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "choked with weeds"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geblokkeerd, verstopt of zwaar belemmerd, vooral door puin, begroeiing of ophoping."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verstopt",
                                "target_lang_sense_clarification": "geblokkeerd door vuil of puin"
                            },
                            {
                                "target_lang_word": "overwoekerd",
                                "target_lang_sense_clarification": "geblokkeerd door begroeiing"
                            },
                            {
                                "target_lang_word": "geblokkeerd",
                                "target_lang_sense_clarification": "versperd of afgesloten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}