{
    "word_family": [
        "repartition",
        "partitioner",
        "partitioning",
        "compartment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7a10eda-8c41-345a-989a-12cf6c586730",
                    "sense_definition": "A vertical structure, such as a thin wall, that divides a room or space into separate areas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office used a glass <w>partition</w> to create a private meeting space without blocking the light.",
                            "target_lang_translations": {
                                "ru": "В офисе использовали стеклянную <w>перегородку</w>, чтобы создать приватное место для встреч, не преграждая путь свету."
                            }
                        },
                        {
                            "text": "They decided to install a temporary <w>partition</w> wall to divide the large bedroom into two smaller ones.",
                            "target_lang_translations": {
                                "ru": "Они решили установить временную <w>перегородку</w>, чтобы разделить большую спальню на две поменьше."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass partition",
                        "temporary partition",
                        "partition wall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальная конструкция, такая как тонкая стена, разделяющая комнату или пространство на отдельные зоны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегородка",
                                "target_lang_sense_clarification": "легкая стенка в помещении"
                            },
                            {
                                "target_lang_word": "переборка",
                                "target_lang_sense_clarification": "внутренняя стенка, часто на судне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a1e1486-94cd-31f1-a23a-b2093b207b76",
                    "sense_definition": "A logical section of a hard disk or storage device that is treated as a separate unit by the operating system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should create a separate <w>partition</w> for your operating system and your personal data.",
                            "target_lang_translations": {
                                "ru": "Вам следует создать отдельный <w>раздел</w> для операционной системы и личных данных."
                            }
                        },
                        {
                            "text": "The primary <w>partition</w> on the hard drive was almost full, so I had to delete some old files.",
                            "target_lang_translations": {
                                "ru": "Основной <w>раздел</w> на жестком диске был почти заполнен, поэтому мне пришлось удалить старые файлы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "disk partition",
                        "primary partition",
                        "system partition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логический раздел жесткого диска или запоминающего устройства, который операционная система рассматривает как отдельную единицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздел",
                                "target_lang_sense_clarification": "логическая область диска"
                            },
                            {
                                "target_lang_word": "партиция",
                                "target_lang_sense_clarification": "технический термин в ИТ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efb3a049-9ddb-3564-8589-3efd1278b801",
                    "sense_definition": "The act or process of dividing something into parts or separating one thing from another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>partition</w> of the estate took several months because the heirs could not agree on the terms.",
                            "target_lang_translations": {
                                "ru": "<w>Раздел</w> имущества занял несколько месяцев, так как наследники не могли договориться об условиях."
                            }
                        },
                        {
                            "text": "The <w>partition</w> of the country led to significant social and political changes in the region.",
                            "target_lang_translations": {
                                "ru": "<w>Разделение</w> страны привело к значительным социальным и политическим изменениям в регионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismemberment"
                    ],
                    "antonyms": [
                        "unification",
                        "merger"
                    ],
                    "common_phrases": [
                        "partition of assets",
                        "political partition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс разделения чего-либо на части или отделения одного от другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделение",
                                "target_lang_sense_clarification": "общий процесс деления"
                            },
                            {
                                "target_lang_word": "раздел",
                                "target_lang_sense_clarification": "распределение имущества или территорий"
                            },
                            {
                                "target_lang_word": "расчленение",
                                "target_lang_sense_clarification": "деление на составные части"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1fcef0e-8bab-32b1-86e6-8ec88565a0da",
                    "sense_definition": "In mathematics, a collection of non-empty, disjoint subsets of a set whose union is the set itself.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>partition</w> of a set is a way of grouping its elements into non-overlapping subsets.",
                            "target_lang_translations": {
                                "ru": "<w>Разбиение</w> множества — это способ группировки его элементов в непересекающиеся подмножества."
                            }
                        },
                        {
                            "text": "The professor explained how to find every possible <w>partition</w> of a set with four elements.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил, как найти все возможные <w>разбиения</w> множества из четырех элементов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "set partition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В математике — совокупность непустых непересекающихся подмножеств множества, объединение которых составляет само это множество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбиение",
                                "target_lang_sense_clarification": "математический термин для множеств"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "821d6377-a577-3ee2-868d-23954b218ead",
                    "sense_definition": "To divide something into parts, sections, or shares.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divide_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician will <w>partition</w> the hard drive into three separate volumes for better organization.",
                            "target_lang_translations": {
                                "ru": "Техник <w>разобьет</w> жесткий диск на три отдельных тома для лучшей организации."
                            }
                        },
                        {
                            "text": "It is often necessary to <w>partition</w> a large dataset before performing complex statistical analysis.",
                            "target_lang_translations": {
                                "ru": "Часто необходимо <w>разделить</w> большой набор данных перед выполнением сложного статистического анализа."
                            }
                        }
                    ],
                    "antonyms": [
                        "combine",
                        "unite"
                    ],
                    "common_phrases": [
                        "partition a drive",
                        "partition the data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять что-либо на части, секции или доли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "делить на части"
                            },
                            {
                                "target_lang_word": "разбить",
                                "target_lang_sense_clarification": "разделить на сегменты или разделы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e6a7523-e737-3a59-96af-001513460fab",
                    "sense_definition": "To separate or divide a room or space using a physical barrier, often used with 'off'.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_barrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We can <w>partition</w> off the back of the restaurant for your private birthday party.",
                            "target_lang_translations": {
                                "ru": "Мы можем <w>отгородить</w> заднюю часть ресторана для вашего частного дня рождения."
                            }
                        },
                        {
                            "text": "The workers began to <w>partition</w> the open-plan office into individual cubicles.",
                            "target_lang_translations": {
                                "ru": "Рабочие начали <w>перегораживать</w> офис открытого типа на отдельные кабинки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "partition off",
                        "partition a room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделять или разделять комнату или пространство с помощью физического барьера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегораживать",
                                "target_lang_sense_clarification": "устанавливать перегородку"
                            },
                            {
                                "target_lang_word": "отгораживать",
                                "target_lang_sense_clarification": "отделять часть пространства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbf38ee1-54e2-3096-8073-3c00c2893e2b",
                    "sense_definition": "To divide a region or country into two or more territories with separate political status.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colonial powers decided to <w>partition</w> the territory without considering the local ethnic boundaries.",
                            "target_lang_translations": {
                                "ru": "Колониальные державы решили <w>разделить</w> территорию, не учитывая местные этнические границы."
                            }
                        },
                        {
                            "text": "Historians still debate the long-term consequences of the decision to <w>partition</w> the subcontinent.",
                            "target_lang_translations": {
                                "ru": "Историки до сих пор спорят о долгосрочных последствиях решения <w>разделить</w> субконтинент."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismember"
                    ],
                    "antonyms": [
                        "unify"
                    ],
                    "common_phrases": [
                        "partition a country",
                        "partition a territory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять регион или страну на две или более территории с отдельным политическим статусом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делить",
                                "target_lang_sense_clarification": "о политическом разделе территорий"
                            },
                            {
                                "target_lang_word": "расчленять",
                                "target_lang_sense_clarification": "насильственно делить страну"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}