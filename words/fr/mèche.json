    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "448ae33b-26a5-3a95-a816-f284e46e88c7",
                    "sense_definition": "Touffe ou partie séparée de la chevelure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cheveux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle replace constamment une <w>mèche</w> de cheveux derrière son oreille gauche."
                        },
                        {
                            "text": "Le coiffeur lui a proposé de faire des <w>mèches</w> blondes pour éclaircir sa coiffure."
                        }
                    ],
                    "synonyms": [
                        "touffe",
                        "boucle"
                    ],
                    "common_phrases": [
                        "mèche de cheveux",
                        "mèches rebelles"
                    ]
                },
                {
                    "sense_id": "4709ccaf-27dc-3d03-b5ae-017b8141066c",
                    "sense_definition": "Cordon de tissu ou de fibres tressées qui alimente la flamme d'une bougie ou d'une lampe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "combustion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut couper la <w>mèche</w> de la bougie pour éviter qu'elle ne fume trop."
                        },
                        {
                            "text": "La lampe à pétrole s'est éteinte parce que la <w>mèche</w> était complètement consumée."
                        }
                    ],
                    "common_phrases": [
                        "mèche de bougie"
                    ]
                },
                {
                    "sense_id": "1be6b3ad-8558-3d4c-83bb-a4d7391ecccc",
                    "sense_definition": "Cordon combustible qui sert à transmettre le feu à une charge explosive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "explosif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artificier a allumé la <w>mèche</w> avant de s'éloigner rapidement."
                        },
                        {
                            "text": "Cette décision injuste a mis le feu à la <w>mèche</w> lors des négociations."
                        }
                    ],
                    "synonyms": [
                        "mèche lente",
                        "mèche de sûreté",
                        "mèche fusante"
                    ],
                    "common_phrases": [
                        "allumer la mèche",
                        "mettre le feu à la mèche"
                    ]
                },
                {
                    "sense_id": "aaf2bf9f-5b71-3cb1-8cb2-32d7da9e135f",
                    "sense_definition": "Pièce métallique interchangeable fixée à une perceuse pour percer des trous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a choisi une fine <w>mèche</w> en acier pour percer cette planche de bois."
                        },
                        {
                            "text": "Pense à changer de <w>mèche</w> si tu veux percer dans du béton."
                        }
                    ],
                    "synonyms": [
                        "foret"
                    ],
                    "common_phrases": [
                        "mèche de perceuse",
                        "mèche à bois"
                    ]
                },
                {
                    "sense_id": "bf6564e4-9795-31df-8beb-5a983edd26c7",
                    "sense_definition": "Complot, secret ou dessein caché, souvent utilisé dans des locutions figées.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "secret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'un des complices a vendu la <w>mèche</w> à la police avant l'opération."
                        },
                        {
                            "text": "Tout le monde pensait qu'il était de <w>mèche</w> avec nos adversaires."
                        }
                    ],
                    "common_phrases": [
                        "vendre la mèche",
                        "être de mèche"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "utilisé principalement dans des expressions imagées"
                        }
                    ]
                },
                {
                    "sense_id": "f8a1d4a8-7367-35de-8b0d-67623d62a0e2",
                    "sense_definition": "Possibilité ou moyen d'agir, principalement dans l'expression familière « il n'y a pas mèche ».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argot_possibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'y a pas <w>mèche</w> de négocier avec lui quand il est en colère."
                        },
                        {
                            "text": "J'ai bien cherché une issue, mais il n'y avait pas <w>mèche</w>."
                        }
                    ],
                    "synonyms": [
                        "moyen",
                        "possibilité"
                    ],
                    "common_phrases": [
                        "pas mèche",
                        "y a pas mèche"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre familier ou argotique"
                        }
                    ]
                }
            ]
        }
    ]
