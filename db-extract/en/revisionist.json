                    }
                ],
                "senses": [
                    {
                        "sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                        "entry_id": "f394df62-f366-3b78-8459-3f332a2a54b0",
                        "glosses": [
                            "Of or pertaining to revisionism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97a72069-7283-461b-af97-2320f9044143",
                                "sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                                "text": "Wang interjected: \"We are preparing large exhibitions of art done by workers, peasants and soldiers in cooperation with the art teachers and students. Among them is one popular work entitled 'Never Stop Struggling as Long as You Are Alive.' It is a painting depicting the story of our heroic soldiers fighting the Soviet revisionist troops when they invaded Chen Pao Island on our frontier. Yes,\" Wang said enthusiastically, \"a new upsurge in art is taking form.\""
                            },
                            {
                                "example_id": "d1b736e6-aeed-4789-8f0d-35e6d3852876",
                                "sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                                "text": "[I]n the 575 days since [Oscar] Pistorius shot dead his girlfriend Reeva Steenkamp, there has been an unseemly scramble to construct revisionist histories, to identify evidence beneath that placid exterior of a pugnacious, hair-trigger personality."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39521155-3f6d-4cef-a8d9-11b58f058160",
                        "source_entry_id": "f394df62-f366-3b78-8459-3f332a2a54b0",
                        "source_sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                        "source_sense_description": "of or pertaining to revisionism",
                        "target_lang_word": "révisionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révisionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7ac279-ef87-3850-994f-7764548d8824",
                                        "entry_id": "d8f1057c-1c9a-38e6-9a9b-e7e737337bc7",
                                        "glosses": [
                                            "Qui œuvre à la révision d'une loi, d'un procès, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac404ef2-b616-44fa-b25c-eedff8f752a2",
                                                "sense_id": "1e7ac279-ef87-3850-994f-7764548d8824",
                                                "text": "Même chose chez Marguerite Charpentier, dont Proust attribuera le salon dreyfusard à Madame Verdurin, chez qui les invités peuvent rencontrer toutes les vedettes de la cause révisionniste, Zola, le beau colonel Picquart dans son uniforme bleu ciel à galons dorés, Georges Clemenceau, le baron Reinach ou Fernand Labori."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                        "entry_id": "d8f1057c-1c9a-38e6-9a9b-e7e737337bc7",
                                        "glosses": [
                                            "Relatif à un révisionnisme politique, philosophique, religieux…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5acbff88-4b27-498d-b6b7-c08669394359",
                                                "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                                "text": "Mon père, ami de M. Méline, était convaincu de la culpabilité de Dreyfus. Il avait envoyé promener avec mauvaise humeur des collègues qui lui avaient demandé de signer une liste révisionniste."
                                            },
                                            {
                                                "example_id": "8609c309-26b5-47db-a8d5-18437a397ee7",
                                                "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                                "text": "Hautement recommandé pour les délires antisionistes, révisionnistes, judéophobiques, ou autre simple envie de frapper son voisin parce qu'il est juif. Très efficace, Antisémitox n'a aucun effet secondaire. Il traite également l'antisionisme."
                                            },
                                            {
                                                "example_id": "39d16c66-53cb-4573-bcdf-102b0b43021c",
                                                "sense_id": "6fa88a95-4830-39c5-ac99-b4c760a3d61b",
                                                "text": "Du même coup, un tel examen me semble être au moins aussi impératif dans le cas de diverses versions révisionnistes post-freudiennes de la psychanalyse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee15cac-78e9-3844-a8dc-98d10c58b1cc",
                                        "entry_id": "d8f1057c-1c9a-38e6-9a9b-e7e737337bc7",
                                        "glosses": [
                                            "Qualificatif de toute opinion contraire à l’orthodoxie."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "révisionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0d4bfb-4d88-3f2d-afc1-234c1260f051",
                                        "entry_id": "fdfe0caf-f88f-36af-ae9a-49037f44be84",
                                        "glosses": [
                                            "Celui qui œuvre à la révision d'une loi, d'un jugement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc2eaee-e8e7-4334-8608-d7290cf41162",
                                                "sense_id": "7f0d4bfb-4d88-3f2d-afc1-234c1260f051",
                                                "text": "Le secours allait venir aux révisionnistes du côté où on l'attendait le moins. Une pièce du dossier secret, deux fois rendue publique, se trouva être un faux."
                                            },
                                            {
                                                "example_id": "ba760e2d-85aa-432b-928c-cb59360198d1",
                                                "sense_id": "7f0d4bfb-4d88-3f2d-afc1-234c1260f051",
                                                "text": "– Les prisonnières voulaient rassurer leurs proches, ne pas les inquiéter, leur dire que tout allait bien… elles ne disaient pas la vérité. C’est pourquoi ces correspondances ont été utilisés plus tard par les révisionnistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d079c046-954e-3d44-8ce4-bada1c6b6af9",
                                        "entry_id": "fdfe0caf-f88f-36af-ae9a-49037f44be84",
                                        "glosses": [
                                            "Adepte du révisionnisme, souvent condamnable en tant que tel."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d157ab74-4260-4cfc-a8e4-dffd4e78bf30",
                                                "sense_id": "d079c046-954e-3d44-8ce4-bada1c6b6af9",
                                                "text": "Depuis le 20ᵉ congrès du P.C.U.S., le pouvoir d’État en Union soviétique a été usurpé par une bande de révisionnistes renégats qui ne représentent pas les intérêts de la classe ouvrière, mais seulement ceux de leur propre couche privilégiée et qui ont l’intention de restaurer le capitalisme en U.R.S.S."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6a9cf69-5b9d-4b81-90cf-52145155da01",
                        "source_entry_id": "f394df62-f366-3b78-8459-3f332a2a54b0",
                        "source_sense_id": "c197e29d-dfcc-305d-b996-02aa2dcdb1d1",
                        "source_sense_description": "of or pertaining to revisionism",
                        "target_lang_word": "revisionistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revisionistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                        "entry_id": "b3995036-61be-3ad4-a0cd-39a180684c03",
                                        "glosses": [
                                            "den Revisionismus betreffend; sich auf die Vergangenheit beziehende Meinungen ausdrückend oder danach so handelnd, das die Meinungen oder das Handeln nicht dem wissenschaftlichen, geschichtlichen oder politischen Konsens entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abd6586b-deaa-4b23-9030-a3c1a34539fc",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„In der Folge stellte er sich an die Spitze einer revisionistischen und irredentistischen Politik, die unter dem Motto Nem, nem, soha! („Nein, nein, niemals!“) bestrebt war, alle verlorenen Gebiete zurückzugewinnen, um das Königreich des Heiligen Stephan in seinen historischen Grenzen wiederherzustellen.“"
                                            },
                                            {
                                                "example_id": "3c38a170-adac-4aa2-95e6-a9142c6278f9",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "[In seinen Memoiren] „verteidigte er seine revisionistische Außenpolitik und erklärte, nur das Beste für sein Land gewollt zu haben.“"
                                            },
                                            {
                                                "example_id": "54c1942b-b573-49f8-b6f3-ef4b880defc7",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Russlands revisionistische Außenpolitik zielt nicht nur auf die Verhinderung einer weiteren NATO-Osterweiterung, sondern auf die Wiederherstellung seiner Herrschaft über den gesamten postsowjetischen Raum.“"
                                            },
                                            {
                                                "example_id": "bce03127-d4ac-46ef-8c10-a0b50806ef6e",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Weil Ungarn für eine revisionistische Politik allein zu schwach war, bemühte sich das Land um Verbündete.“"
                                            },
                                            {
                                                "example_id": "9d16c3b2-9a3a-435f-8889-642560243e00",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Holocaust-Überlebende fürchteten nach dem Einzug der AfD in den Niedersächsischen Landtag, dass künftig Personen in dem Gremium sitzen, die den Holocaust verharmlosen oder leugnen und revisionistische oder antisemitische Meinungen vertreten.“"
                                            },
                                            {
                                                "example_id": "a1aadbf6-89b9-48b7-a71a-22914871a1bd",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Der Kandidat hat also eindeutig ein sehr revisionistisches Geschichtsbild.“"
                                            },
                                            {
                                                "example_id": "54988c1c-20f2-4aa7-94d7-669d2980327a",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Obendrein ist Serbien ein revisionistischer Staat, der die im Verlauf der jugoslawischen Zerfallskriege entstandene regionale Ordnung ändern will, den Anschluss der Republika Srpska anstrebt und die Anerkennung des Kosovo verweigert.“"
                                            },
                                            {
                                                "example_id": "43304aa0-e461-4ec1-92ed-9f51b0b70178",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„In den 1950er Jahren war Barnes ein Förderer des jungen amerikanischen revisionistischen Geschichtswissenschaftlers David L. Hoggan.“"
                                            },
                                            {
                                                "example_id": "d40314ea-9e43-4809-b004-6d7b224b2536",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Aus den Vorarbeiten revisionistischer Schreibtischtäter können jene ihr gutes Gewissen beziehen, die jüdische Friedhöfe schänden und in Synagogen Feuer legen.“"
                                            },
                                            {
                                                "example_id": "ebb04f79-6a2c-42e5-b799-b13947949393",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Als revisionistische Propagandawaffe war das Buch aber sehr tauglich“ […]."
                                            },
                                            {
                                                "example_id": "bc68a1d1-c4ff-460f-b2c3-1c93e97100ae",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Da Russland in den vergangenen zehn bis fünfzehn Jahren zunehmend als expansionistische und revisionistische Macht agiert hat, die die europäische Sicherheitsordnung und das Völkerrecht als solche überwinden will, stellt sich die Frage nach dem Wert etwaiger russischer Zusagen in Bezug auf einen Neutralitätsstatus der Ukraine.“"
                                            },
                                            {
                                                "example_id": "d041d774-92c6-4147-88e1-8239c7ad2179",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Denn niemand kann derzeit mit Bestimmtheit sagen an welchem Punkt Russlands revisionistische Bestrebungen befriedigt wären – an den Grenzen der ehemaligen Sowjetunion, des Warschauer Pakts oder …?“"
                                            },
                                            {
                                                "example_id": "7718aff1-9944-42da-b5be-111287a36149",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "[Schlagzeile:] „Nationalsozialismus in revisionistischer Sicht“"
                                            },
                                            {
                                                "example_id": "cec50346-b3c1-4170-b9c7-703c6dafee23",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„Aus dem revisionistischen Bezug auf die undemokratischen Epochen der deutschen Geschichte ergibt sich eine starke Nähe der Reichsbürger zum rechtsextremen Milieu.“"
                                            },
                                            {
                                                "example_id": "51a7e42b-197b-4576-b878-738c7fcc4368",
                                                "sense_id": "dccb6499-b759-30c7-89c7-fc39d1d6c112",
                                                "text": "„»Die Ereignisse haben sich ab Mitte 1991 überstürzt, als es im August in Moskau zum Putsch kam, der die Politik Gorbatschows rückgängig machen wollte, also revisionistisch war.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
