                        "glosses": [
                            "Relatif à une zone volcanique du golfe de Pouzzoles en Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "059ad99e-8f62-4f69-985b-c58582cbfb0a",
                                "sense_id": "f61c132f-d9e7-3888-b626-a6076a4fe326",
                                "text": "Les vapeurs de soufre qui s’exhalent des champs Phlégréens ont plus de force quand elles sortent de la terre encore échauffée par les rayons du soleil."
                            },
                            {
                                "example_id": "f6d386b6-9924-4718-8099-4ed2e9c79404",
                                "sense_id": "f61c132f-d9e7-3888-b626-a6076a4fe326",
                                "text": "Ce furent Naples et son volcan qui raclèrent du plus profond de ses maux ses vers les plus phlégréens. Ceux qui sont de ce lieu et n’en éprouvent aucun orgueil se sont assoupis."
                            },
                            {
                                "example_id": "e8d47760-2655-4a76-83c3-c53b7d7ec407",
