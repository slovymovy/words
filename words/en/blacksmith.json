{
    "word_family": [
        "blacksmithing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a8446f94-eb3e-3296-a09d-bc3ab24b429a",
                    "sense_definition": "A person who forges iron.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metalworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blacksmith</w> used a heavy hammer to shape the glowing metal on the anvil.",
                            "target_lang_translations": {
                                "zh": "<w>铁匠</w>用一把沉重的锤子在铁砧上锻打发红的金属。"
                            }
                        },
                        {
                            "text": "Every village once relied on a local <w>blacksmith</w> to repair tools and forge iron items.",
                            "target_lang_translations": {
                                "zh": "过去每个村庄都依靠当地的<w>铁匠</w>来修理工具和锻造铁器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ironsmith"
                    ],
                    "common_phrases": [
                        "village blacksmith"
                    ],
                    "target_lang_definitions": {
                        "zh": "从事铁器锻造的工匠。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "铁匠",
                                "target_lang_sense_clarification": "指专门打造铁制工具或器物的工匠。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33afd6f0-b5f2-363f-8323-8e4778d96e6d",
                    "sense_definition": "A person who shoes horses.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metalworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>blacksmith</w> carefully fitted a new shoe to the horse's hoof.",
                            "target_lang_translations": {
                                "zh": "<w>钉马掌匠</w>小心翼翼地给马蹄装上了新马掌。"
                            }
                        },
                        {
                            "text": "A skilled <w>blacksmith</w> ensures that the horse can walk comfortably on hard ground.",
                            "target_lang_translations": {
                                "zh": "技术娴熟的<w>钉马掌匠</w>能确保马匹在坚硬的地面上行走自如。"
                            }
                        }
                    ],
                    "synonyms": [
                        "farrier"
                    ],
                    "target_lang_definitions": {
                        "zh": "专门为马匹钉马掌的工匠。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钉马掌匠",
                                "target_lang_sense_clarification": "专门负责给马匹修蹄并钉上马掌的职业。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0481bb3a-1a39-3550-9832-2c8a79fe51ad",
                    "sense_definition": "A blackish fish of the Pacific coast (Chromis punctipinnis).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Divers often spot the <w>blacksmith</w> swimming near rocky reefs in the Pacific.",
                            "target_lang_translations": {
                                "zh": "潜水员经常在太平洋的礁石附近看到<w>点斑光鳃鱼</w>游动。"
                            }
                        },
                        {
                            "text": "The <w>blacksmith</w> is a common species found along the coast of California.",
                            "target_lang_translations": {
                                "zh": "<w>点斑光鳃鱼</w>是加利福尼亚沿岸常见的一种鱼类。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种生活在太平洋沿岸的雀鲷科鱼类（Chromis punctipinnis）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "点斑光鳃鱼",
                                "target_lang_sense_clarification": "该物种的正式中文名称。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3267a127-f1ab-39cd-8db8-785d2314603f",
                    "sense_definition": "To work as a blacksmith.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metalworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>blacksmith</w> for a living after learning the trade from his father.",
                            "target_lang_translations": {
                                "zh": "他在跟父亲学艺后，决定以<w>打铁</w>为生。"
                            }
                        },
                        {
                            "text": "It takes many years of practice to <w>blacksmith</w> effectively and safely.",
                            "target_lang_translations": {
                                "zh": "需要多年的练习才能安全且高效地进行<w>打铁</w>工作。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "从事铁匠工作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打铁",
                                "target_lang_sense_clarification": "指锻造铁器的动作或职业活动。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f6d8fbdf-d4f8-3c65-a827-e433192d88e6",
                    "sense_definition": "A surname originating as an occupation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the historical novel is named John <w>Blacksmith</w>.",
                            "target_lang_translations": {
                                "zh": "这部历史小说的作者名叫约翰·<w>布莱克斯密斯</w>。"
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Blacksmith</w> have ancestors who worked with metal.",
                            "target_lang_translations": {
                                "zh": "许多姓<w>布莱克斯密斯</w>的人，其祖先都是从事金属加工工作的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "源自职业名称的姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布莱克斯密斯",
                                "target_lang_sense_clarification": "作为姓氏时的音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}