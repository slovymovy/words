                    "sense_id": "d57e135b-805d-33b8-a318-5699624dae88",
                    "sense_definition": "een stuk weefsel dat gebruikt wordt als bedekking voor de vloer of een tafel",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bedekking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ligt een zacht <w>kleed</w> op de vloer in de woonkamer.",
                            "target_lang_translations": {
