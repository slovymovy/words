                    {
                        "translation_id": "bda1ade5-87a2-4d43-92f8-8402331dd6ba",
                        "source_entry_id": "20d62015-90b6-3689-8945-f25defc07337",
                        "target_lang_word": "совместимость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "совместимость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "adcbf329-a569-3a51-b357-351c0f62b7a7",
                                        "entry_id": "583ca735-a0e3-3506-b9e1-f7fcd9340afa",
                                        "glosses": [
                                            "свойство по значению прилагательного совместимый; способность сосуществовать, нормально взаимодействовать с кем-либо, чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4da4f810-1436-4094-bc6c-1c4f1343d00d",
                                                "sense_id": "adcbf329-a569-3a51-b357-351c0f62b7a7",
                                                "text": "Мысль о совместимости в одном теле паничка с извозчиком показалась ему, вероятно, очень курьезной и остроумной, потому что он громко захихикал и продолжал развивать эту мысль."
                                            },
                                            {
                                                "example_id": "3edc79c2-0b7f-4ddc-88e7-bbead4f5eb09",
                                                "sense_id": "adcbf329-a569-3a51-b357-351c0f62b7a7",
                                                "text": "А господин Лейбниц, который пытался доказать, что-де бытие зла совершенно совместимо с бытием божиим и что, дескать, совместимость эта тоже совершенно и неопровержимо доказуется книгой Иова, ― господин Лейбниц ― не более как чудачок немецкий."
                                            },
                                            {
                                                "example_id": "2159b873-dc56-436f-a3e2-e7aca8846c19",
                                                "sense_id": "adcbf329-a569-3a51-b357-351c0f62b7a7",
                                                "text": "Он принимает рецепт, проверяет правильность дозировки и совместимость лекарств."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
