                        "entry_id": "0e85d9eb-b171-35c4-a6a9-519a057178e2",
                        "glosses": [
                            "Protozoaire en forme d’arc, parasite de certains vertébrés et agent de la toxoplasmose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da82ae5-2761-4a35-a6f6-862fd742f954",
                                "sense_id": "591e58b3-ab6b-37d5-b0ce-d098e820fe98",
                                "text": "Le toxoplasme est présent dans l’intestin des chiens parasités. Les animaux qui vivent autour de l’homme forment donc un réservoir important de virus."
                            }
                        ]
                    }
                ],
                "translations": [
