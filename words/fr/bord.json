                    "semantic_group_id": "bord_extremite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un morceau de savon traînait sur le <w>bord</w> de la baignoire."
                        },
                        {
                            "text": "Ne pose pas ton verre au <w>bord</w> de la table, il va tomber."
                        },
                        {
