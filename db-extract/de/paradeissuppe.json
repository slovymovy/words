                            {
                                "example_id": "1d6b6d5e-c605-4b2a-9d6d-d56b4512cf92",
                                "sense_id": "727c2411-1555-35e7-8358-c34d3207244b",
                                "text": "„Die beiden waren so arm, daß sie oft kein Stückchen Brot hatten und eine dünne Paradeissuppe löffeln mußten.“"
                            },
                            {
                                "example_id": "737c6264-9a97-4c0d-9d97-7d2147d48f48",
                                "sense_id": "727c2411-1555-35e7-8358-c34d3207244b",
                                "text": "„Demnach reichen schon zwei Portionen Paradeissuppe oder -soße pro Woche aus, um das Risiko von Prostatakrebs um 24 bis 36 Prozent zu senken.“"
                            }
