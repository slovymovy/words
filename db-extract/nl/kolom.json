                    {
                        "sense_id": "90a4cae2-9e40-386c-a31d-807f36b99627",
                        "entry_id": "15b2db40-17b7-30c1-b233-942ae1375f32",
                        "glosses": [
                            "een vrijstaand steunpunt van hout, steen, beton of metaal, vergelijk zuil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ede5b1a-65d3-4aba-a0de-2b6ea7828298",
                                "sense_id": "90a4cae2-9e40-386c-a31d-807f36b99627",
                                "text": "De kolommen stonden vlak voor de gevel van het gebouw."
                            }
                        ]
                    },
                    {
                        "sense_id": "79059d8e-289b-3c93-a0b4-40d0752fad7f",
                        "entry_id": "15b2db40-17b7-30c1-b233-942ae1375f32",
                        "glosses": [
                            "elk van de naast elkaar staande vakken van een in de lengte verdeelde bladzijde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50b10c5-5bbd-45ed-bed0-c51f1616dbad",
                                "sense_id": "79059d8e-289b-3c93-a0b4-40d0752fad7f",
                                "text": "De bladzijde was in twee kolommen verdeeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "c82fdc45-870a-3bed-851b-52dfd47b2954",
                        "entry_id": "15b2db40-17b7-30c1-b233-942ae1375f32",
                        "glosses": [
                            "artikel in een krant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0667d981-99a7-4da6-b01f-26c073c0a95f",
                                "sense_id": "c82fdc45-870a-3bed-851b-52dfd47b2954",
                                "text": "Als we met drieduizend of meer waren, zoals op deze voorzomerse dag, deelde de politie de burgerlijke pers mee dat we met tweeduizend waren, wat de journalisten naar beneden toe afrondden zodat drieduizend mensen op straat er een paar honderd in de kolommen werden."
                            }
                        ]
                    },
                    {
                        "sense_id": "771cc463-b1d7-3c15-bc8d-c311aadff71f",
                        "entry_id": "15b2db40-17b7-30c1-b233-942ae1375f32",
                        "glosses": [
                            "een reeks van verticaal onder elkaar geplaatste getallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875f2b4c-a6a1-4287-a733-61c7b86de64b",
                                "sense_id": "771cc463-b1d7-3c15-bc8d-c311aadff71f",
                                "text": "In een spreadsheet is het gemakkelijk de getallen in een kolom op te tellen."
                            }
                        ]
                    }
                ],
