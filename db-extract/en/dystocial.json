                        "glosses": [
                            "Of, pertaining to or characterised by dystocia; having had a difficult birth."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "918aa5ab-b2a3-43a9-a155-9275a51724ad",
                                "sense_id": "e880431e-c77c-3216-84b4-e05cb8c09e01",
                                "text": "Both authors discuss the same points, but Dr. Kennedy extends his observations to obstetric auscultation in dystocial or difficult parturitions."
                            },
                            {
                                "example_id": "c33e677b-64a3-4d94-88e0-357c00f2f5d1",
                                "sense_id": "e880431e-c77c-3216-84b4-e05cb8c09e01",
                                "text": "Again to point out the value of x-ray pelvimetry, only 42.5 per cent of the patients who were referred to the dystocial clinic because of clinically suspected contracted pelves had them according to the Mengert indices by x-ray."
                            },
                            {
                                "example_id": "f70c8614-3b20-4598-bcca-5ddb057483bc",
                                "sense_id": "e880431e-c77c-3216-84b4-e05cb8c09e01",
                                "text": "By contrast, low-vitality calves, especially dystocial calves, are unable to withstand adverse climatic conditions."
                            },
                            {
                                "example_id": "03f3779b-55d1-40e8-8372-6399003b6d6a",
                                "sense_id": "e880431e-c77c-3216-84b4-e05cb8c09e01",
                                "text": "However, there is a relationship between the occurrence of cold weather and calf deaths, including those due to the ‘weak calf syndrome’ and deficiencies in thermoregulation occur in animals born prematurely and in dystocial calves."
                            }
                        ]
                    }
