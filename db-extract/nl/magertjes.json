                    {
                        "sense_id": "8c967f1d-665a-30b1-bd70-dc3ce8217e95",
                        "entry_id": "6718a087-00e5-3235-b217-7a6359e4d377",
                        "glosses": [
                            "alleen als naamwoordelijk deel: enigszins mager"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a2a9d1-0682-4b10-8064-307848237ca5",
                                "sense_id": "8c967f1d-665a-30b1-bd70-dc3ce8217e95",
                                "text": "Wat ziet hij er magertjes uit, hij is toch niet ziek?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "670df716-9e88-44a9-9090-0be47cf73bd8",
                        "source_entry_id": "6718a087-00e5-3235-b217-7a6359e4d377",
                        "source_sense_id": "8c967f1d-665a-30b1-bd70-dc3ce8217e95",
                        "source_sense_description": "enigszins mager",
                        "target_lang_word": "maigrelet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maigrelet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                        "entry_id": "7cf4d852-6acf-303a-aa99-9e90c066c461",
                                        "glosses": [
                                            "Qui est un peu trop maigre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a770c8-ccb9-4ba2-9bd0-a4be3ab044a1",
                                                "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                                "text": "Elle n’avait jamais été jolie ; elle était laide maintenant, de petite taille et maigrelette."
                                            },
                                            {
                                                "example_id": "3f9103a9-8384-41ee-9cac-fa0257f0d1ff",
                                                "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                                "text": "Et j’ai baisé tes seins menus, pucelette maigrelette, fille gracile du printemps…"
                                            },
                                            {
                                                "example_id": "874ea0d4-0d7c-4fca-8597-dc0e2b7b7a6b",
                                                "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                                "text": "On enterra le père Voie devant un frêne maigrelet ; des oiseaux s’envolèrent du trou, effleurant le croque-mort qui s’impatientait : la boîte de son mort étant rectangulaire, il n’en pouvait reconnaître la tête."
                                            },
                                            {
                                                "example_id": "c3abe6f2-ae48-435d-b0d9-5ccc8ba1dac5",
                                                "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                                "text": "Ces gens qui parlent avec l’accent du Nord se moquent de l’accent italien du nonce ; un monsieur trouve le secrétaire du nonce trop joli pour être honnête ; les dames le trouvent maigrelet."
                                            },
                                            {
                                                "example_id": "ae8b28e2-8f45-48f9-8891-f8f21820704a",
                                                "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                                "text": "Il risquait de la ridiculiser, avec ses allures de poule maigrelette […]"
                                            },
                                            {
                                                "example_id": "d2c799ae-1d8d-48b8-8b4e-48b5fae27359",
                                                "sense_id": "20e4f96a-7c6f-3b13-a482-0f891d0f23e6",
                                                "text": "Il a bien changé depuis cette époque. L’homme à la carrure athlétique que j'ai sous les yeux est bien loin de l’enfant maigrelet que j'ai croisé dans cette cour d'école."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "159269b1-7014-34d3-b3eb-b90d8678ff76",
                                        "entry_id": "7cf4d852-6acf-303a-aa99-9e90c066c461",
                                        "glosses": [
                                            "Faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6e81f9-50de-474e-b538-4475cc3ab976",
                                                "sense_id": "159269b1-7014-34d3-b3eb-b90d8678ff76",
                                                "text": "Voilà comment le plus jeune pêcheur du banc, moqué tout au long de la partie pour ses prises maigrelettes, l’a emporté grâce à un plan patiemment mis en œuvre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maigrelet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "212e4542-024c-305b-bd26-af7cc79f1bbc",
                                        "entry_id": "d3b3ab39-1ed4-3e97-b39a-05ed695cc5d1",
                                        "glosses": [
                                            "Personne maigrelette."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6307097d-e651-4e6b-b3fe-42590abf3c05",
                                                "sense_id": "212e4542-024c-305b-bd26-af7cc79f1bbc",
                                                "text": "De retour, un maigrelet damoiseau me fait face."
                                            },
                                            {
                                                "example_id": "84262cba-8f55-4625-9937-d2bf190c8a6e",
                                                "sense_id": "212e4542-024c-305b-bd26-af7cc79f1bbc",
                                                "text": "D'ailleurs, les années d’effectif squelettique, où mes solistes faisaient office de chœur, je recherchais la présence des gros enfants : ils prenaient chacun la place de deux maigrelets et donnaient de loin l’illusion d'un régiment d'infanterie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
