                                "target_senses": [
                                    {
                                        "sense_id": "2a33d8f4-1b8e-360b-b257-b595157e0820",
                                        "entry_id": "d9e8c643-4f69-3bf1-aa82-59f634741788",
                                        "glosses": [
                                            "The ability to do a task, performance, or execution; a set of functions that something is able or equipped to perform."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d894d7f5-4936-4db4-8382-09aa2a419008",
                                                "sense_id": "2a33d8f4-1b8e-360b-b257-b595157e0820",
                                                "text": "Glu Mobile, who realigned its workforce towards centralized GaaS functions last year, announced earlier this month that it will shut down GameSpy Technology on May 31. The service provides multiplayer functionality for dozens of games on consoles, computers and mobile devices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7167e70c-c2c8-313b-bdfe-f7ddcb3a4fce",
                                        "entry_id": "d9e8c643-4f69-3bf1-aa82-59f634741788",
                                        "glosses": [
                                            "In trademark law, the tendency of a product design to serve a function other than the identification of the product, preventing that design from being protected as a trademark."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d21bd74e-cbac-36e6-b706-c3e78c45c4b9",
                                        "entry_id": "d9e8c643-4f69-3bf1-aa82-59f634741788",
                                        "glosses": [
                                            "The presence of a functional group."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca665034-4783-4b50-819c-e01a3e5dbb79",
                                                "sense_id": "d21bd74e-cbac-36e6-b706-c3e78c45c4b9",
                                                "text": "To appreciate the tasks and problems arising in the synthesis of the monomers it is of fundamental importance to understand that the process used must be capable of yielding organosilanes with different functionalities, since all functionalities are required for synthesis of silicones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e263a91-c20d-4823-97bb-6cd03c9c2733",
                        "source_entry_id": "5849dd5b-b879-37cd-a871-26250d449614",
                        "source_sense_id": "cfc27d68-3486-3ee8-8056-06f6b4a0ec78",
                        "source_sense_description": "Fähigkeit zur Ausübung einer Funktion",
                        "target_lang_word": "working order",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "working order",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                        "entry_id": "ad1b65e9-3d96-3080-99f1-ffc2c090e98c",
                                        "glosses": [
                                            "The state or condition of being operational or of functioning acceptably."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaada5fb-ce05-4fd8-99b3-a22a01a7d73f",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "[T]he Commission got itself into systematic working order, and for weeks the contributions flowed into its treasury in a generous stream."
                                            },
                                            {
                                                "example_id": "80f53046-b320-4d4f-a226-1cc6a9f19677",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "The engine was in working order."
                                            },
                                            {
                                                "example_id": "65744f01-8e13-4f7f-8906-bfefaf24a591",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "The locomotive stock consists of three of the six original American-built 4-6-0 tanks, named Bridget, Peggy, and Hummy, all in clean condition and good working order; [...]."
                                            },
                                            {
                                                "example_id": "aadfcc3c-283d-456e-a1cf-1a42dcc58852",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "The Hedjaz Railway is best known for its connections to T. E. Lawrence, whose fame as \"El Orens\", the railway wrecker, spread quickly throughout Arabia. He arrived at Yenbo in December, 1916, and immediately started his campaign to sabotage the railway, but to keep it sufficiently in working order to allow supplies to reach Medina."
                                            },
                                            {
                                                "example_id": "9b9d362d-920f-4cae-9e29-33e740fcf738",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "Each coach on the Swedish Yoa2 is 57ft long and 10ft 4in wide; with its two traction motors the unit weighs 79 tons in working order and has a maximum speed of under 60 m.p.h."
                                            },
                                            {
                                                "example_id": "c9e3c6e9-1612-41fb-ae12-ff5798003bf0",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "Upstream from the house is a watermill, cased in gleaming white weather-boarding, which has been restored to working order. Near by is the water-driven turbine which [Rudyard] Kipling had installed in 1902 to light his mansion with electricity."
                                            },
                                            {
                                                "example_id": "926a0f04-eb88-4fcc-a8be-34bfe179cb32",
                                                "sense_id": "b29f9597-2ed0-3599-abc3-3449f7ca7c2b",
                                                "text": "The Pentagon's plans assumed that Iraq's industrial base and utilities were in working order."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27cdeeb7-a0a4-496d-b7e3-606a2fc280bd",
                        "source_entry_id": "5849dd5b-b879-37cd-a871-26250d449614",
