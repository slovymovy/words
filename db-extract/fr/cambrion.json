                                    {
                                        "sense_id": "cb7da0f7-807d-3ee4-a713-3f3d70c12ded",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "The part of the leg between the knee and the ankle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c48f9f9-d446-4fd6-99db-6227e7a3c470",
                                                "sense_id": "cb7da0f7-807d-3ee4-a713-3f3d70c12ded",
                                                "text": "Edward I of England was nicknamed Edward Longshanks."
                                            },
                                            {
                                                "example_id": "f1c54299-f6aa-4d36-aa4b-3eb6afdd034c",
                                                "sense_id": "cb7da0f7-807d-3ee4-a713-3f3d70c12ded",
                                                "text": "His youthful hose, well saved, a world too wide / For his shrunk shank […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "557b01ff-2adf-37c8-842b-24988242e5b9",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "Meat from that part of an animal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e70b8fdd-607a-31a4-9295-d0d405b1e4f3",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "A redshank or greenshank, various species of Old World wading birds in the genus Tringa having distinctly colored legs."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6c1085b-9303-341e-a786-4bef7858f1be",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "A straight, narrow part of an object, such as a key or an anchor; shaft; stem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5a95ff-275c-46bc-bee4-42460290b34d",
                                                "sense_id": "b6c1085b-9303-341e-a786-4bef7858f1be",
                                                "text": "The honest, rough piece of iron, so simple in appearance, has more parts than the human body has limbs: the ring, the stock, the crown, the flukes, the palms, the shank. All this, according to the journalist, is “cast” when a ship arriving at an anchorage is brought up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41b778f2-0655-31a7-919e-472cd61eee2f",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "The handle of a pair of shears, connecting the ride to the neck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "939cb787-8457-36e8-89d8-b9315096c2bd",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "The center part of a fishhook between the eye and the hook, the 'hook' being the curved part that bends toward the point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae8792f4-ca15-3e15-ae0e-8f1935b76d9f",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "A protruding part of an object, by which it is or can be attached."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f00dd9-71f2-45a3-83a3-8ebc1f2bca5b",
                                                "sense_id": "ae8792f4-ca15-3e15-ae0e-8f1935b76d9f",
                                                "text": "This twist drill has a reduced shank so that it can be used even in a small chuck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c55f432c-3bdc-3729-9ac9-c24372b68ea1",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "The metal part on a curb bit that falls below the mouthpiece, which length controls the severity of the leverage action of the bit, and to which the reins of the bridle are attached."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9501e072-a3b8-31ce-8004-cf9c6604a6d3",
                                        "entry_id": "8c8ba4c8-5d25-3f9f-a038-40d66357aa9a",
                                        "glosses": [
                                            "A poorly played golf shot in which the ball is struck by the part of the club head that connects to the shaft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f22b275-21d7-4045-8a05-d595576fc707",
                                                "sense_id": "9501e072-a3b8-31ce-8004-cf9c6604a6d3",
                                                "text": "To a good golfer a shank is disgracefuller than being dead drunk or in jail."
                                            }
                                        ]
                                    },
