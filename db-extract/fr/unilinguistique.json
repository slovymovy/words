                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11714e58-3b7a-4669-8d77-4af9d60af16e",
                                "sense_id": "c4673b5d-3da6-32de-8686-6ae1581b91b1",
                                "text": "La collusion d'une foi unanime et d'un état national unilinguistique est probablement un accident de l’histoire et ne saurait être prise pour norme."
                            },
