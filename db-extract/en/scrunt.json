                "senses": [
                    {
                        "sense_id": "499e4899-e4a8-30dd-9af7-ed93b1b39a43",
                        "entry_id": "ff51c497-be43-3046-b980-c6d69679c8b1",
                        "glosses": [
                            "To beg or scrounge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfc6bfd2-69ee-4f6e-8db0-9f78a336d4ca",
                                "sense_id": "499e4899-e4a8-30dd-9af7-ed93b1b39a43",
                                "text": "On the other hand in countries where people scrunt to live, the birth rate is high."
                            },
                            {
                                "example_id": "ab6df4cc-405c-4c52-bd67-c31a62f63457",
                                "sense_id": "499e4899-e4a8-30dd-9af7-ed93b1b39a43",
                                "text": "Four out of every five women are forced to stay at home or scrunt for a meagre existence."
                            },
                            {
                                "example_id": "0fad5f57-9df5-4af5-8c78-1386c360d338",
                                "sense_id": "499e4899-e4a8-30dd-9af7-ed93b1b39a43",
                                "text": "As a woman of color living in the north of Metropole, anything that I did dig up I really had to scrunt for."
                            }
                        ]
                    }
