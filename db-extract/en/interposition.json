                    {
                        "translation_id": "0561adab-d8fb-4b1d-a9ff-60f9600cc853",
                        "source_entry_id": "56f18336-39b7-3398-9122-b7702582aadc",
                        "source_sense_description": "the thing interposed",
                        "target_lang_word": "Einfügung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfügung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "461ea348-027f-378c-8759-45d1dee54715",
                                        "entry_id": "bd523d09-ae7c-3aba-86bc-0ae77d594c93",
                                        "glosses": [
                                            "Vorgang, etwas passend zu etwas hinzuzufügen, zu ergänzen; Handlung, etwas in eine bestimmte Stelle zu platzieren, legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec30d6df-7ac4-4e9e-b4b0-3786863bed1f",
                                                "sense_id": "461ea348-027f-378c-8759-45d1dee54715",
                                                "text": "Die Einfügung von sogenannten Diskurspartikeln – also Füllwörtern wie „also“, „doch“ oder „eben“ – dient der Steuerung und Strukturierung des Gesprächs."
                                            },
                                            {
                                                "example_id": "0cbe7fcb-a303-4a4d-878e-f1998521ff40",
                                                "sense_id": "461ea348-027f-378c-8759-45d1dee54715",
                                                "text": "„Seine Experimente mit Rohstoffen und Verarbeitungsverfahren machten neue Glasgestaltungen möglich, etwa durch Einfügung von Oxiden oder Metallen in die Schmelze, um gefärbtes oder opakes Glas herzustellen.“"
                                            },
                                            {
                                                "example_id": "759608f7-8db5-42c8-857e-1ae6462fa979",
                                                "sense_id": "461ea348-027f-378c-8759-45d1dee54715",
                                                "text": "„Spalatin wich in Orthographie und Interpunktion gelegentlich von der Vorlage ab, vervollständigte Überschriften sowie die Fundorte der Bibelzitate und ergänzte den Text an einigen Stellen durch die Einfügung von einzelnen Worten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa7b56d7-9222-3bd1-9d27-9eb73f55125f",
                                        "entry_id": "bd523d09-ae7c-3aba-86bc-0ae77d594c93",
                                        "glosses": [
                                            "das, was bei [1] hinzugefügt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b342c87d-4ed2-4f42-9923-13909bfc722b",
                                                "sense_id": "fa7b56d7-9222-3bd1-9d27-9eb73f55125f",
                                                "text": "Eine Einfügung in ein Zitat wird durch eckige Klammern „[]“ gekennzeichnet."
                                            },
                                            {
                                                "example_id": "0ff450b6-8903-49a3-acaf-fd41aac47473",
                                                "sense_id": "fa7b56d7-9222-3bd1-9d27-9eb73f55125f",
                                                "text": "„Die Ergebnisse der Bonner Beratungen sind bekannt, nicht zuletzt, weil das vor siebzig Jahren beschlossene Grundgesetz trotz der vielen Dutzend Änderungen und Einfügungen in seinem Kern die Zeiten überdauert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aeb779e0-e7c6-3df2-9044-1d05f67a7e16",
                                        "entry_id": "bd523d09-ae7c-3aba-86bc-0ae77d594c93",
                                        "glosses": [
                                            "Gewöhnung und Anpassung an eine fremde, veränderte Umgebung, Lebensverhältnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778dc8a7-05fa-40ba-9056-4ee9c330cd79",
                                                "sense_id": "aeb779e0-e7c6-3df2-9044-1d05f67a7e16",
                                                "text": "„Integration ist die Einfügung der Eingewanderten in ihr neues Umfeld.“"
                                            },
                                            {
                                                "example_id": "708e93e4-0136-47a6-a472-9efbbdbdff21",
                                                "sense_id": "aeb779e0-e7c6-3df2-9044-1d05f67a7e16",
                                                "text": "„Die Einfügung in die Gemeinschaft und die Erziehung zur Gelassenheit sind die maßgebenden Leitbilder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee72bb21-bca5-407e-8144-9a14b8e9cab0",
