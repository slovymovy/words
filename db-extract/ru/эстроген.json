                                "target_word": "estrogen",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d964a990-a41c-314b-9ba4-b9450bad550d",
                                        "entry_id": "82b6abab-ec85-3fc0-9d40-1402d3c68cb6",
                                        "glosses": [
                                            "żeński hormon płciowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d593964-0fea-4a0b-945d-5d74a5a7851a",
                                                "sense_id": "d964a990-a41c-314b-9ba4-b9450bad550d",
                                                "text": "Wiemy, że ekspozycja na estrogen powoduje tycie, głównie przez hamowanie tarczycy i modulację działania podwzgórza"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af06b44d-f2f6-45cc-9fb1-29d2d64c5ab8",
