                ],
                "senses": [
                    {
                        "sense_id": "d28d197c-f439-330d-a1fd-2b30ef44056c",
                        "entry_id": "a58f67d7-c2de-3910-86a6-e1d82f6b4c16",
                        "glosses": [
                            "Fruit du tamarinier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d40bf82-b1d3-4ec4-b327-901b9693f0e1",
                                "sense_id": "d28d197c-f439-330d-a1fd-2b30ef44056c",
                                "text": "Je mêle à ces souvenirs d’Alexandrie d’autres souvenirs, relatifs à mon séjour au Caire : […] un certain marchand ambulant de la ville indigène, homme maigre à barbiche grisonnante et turban, qui versait le sirop de tamarin en un long jet, tenant son récipient très haut et loin du verre, avec une élégance inimitable."
                            },
                            {
                                "example_id": "ad6f572a-20e3-4ac9-ba90-8bd19734a201",
                                "sense_id": "d28d197c-f439-330d-a1fd-2b30ef44056c",
                                "text": "Les confitures traditionnelles à base de fruits du Vietnam sont multicolores, comme les confitures de chair de coco, de kiwi, de dates, de groseilles étoilées, de tamarin, de gingembre, d’ananas ou d’orange."
                            },
                            {
                                "example_id": "0cfff87b-0d82-4ec5-a0fc-bd04ccd134cd",
                                "sense_id": "d28d197c-f439-330d-a1fd-2b30ef44056c",
                                "text": "Pulpe, sirop de tamarin."
                            }
                        ]
                    },
                    {
                        "sense_id": "7388a9e6-dcb8-388c-a6d1-a81dd18a43e7",
                        "entry_id": "a58f67d7-c2de-3910-86a6-e1d82f6b4c16",
                        "glosses": [
                            "Le tamarinier lui-même."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "83b219d6-4609-448d-bfe8-e903a0c54b49",
                                "sense_id": "7388a9e6-dcb8-388c-a6d1-a81dd18a43e7",
                                "text": "Ma petite croisée […] ouvrait sur le ruisseau qui coulait étroit et solitaire, entre deux épaisses bordures de saules […] de tamarins et de peupliers."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6100592-3270-30d6-9bb1-97f205182ec1",
                        "entry_id": "a58f67d7-c2de-3910-86a6-e1d82f6b4c16",
                        "glosses": [
                            "Variante de tamaris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "321d5bd0-65fb-4bc8-a107-0fd7a95dac99",
                                "sense_id": "a6100592-3270-30d6-9bb1-97f205182ec1",
                                "text": "Des bosquets de tamarins et de fougères succédèrent bientôt à la canne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6efbce3e-7565-4bbd-91e8-1f2dfcbcba48",
