                "senses": [
                    {
                        "sense_id": "64c10692-ce00-3cb8-88b1-9a2ea0546f52",
                        "entry_id": "3e6a789e-0fd0-3388-addb-07c04b97e766",
                        "glosses": [
                            "członek indiańskiego plemienia z Ameryki Północnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8be5a71-e545-4cbf-9ce3-7b854f37d737",
                                "sense_id": "64c10692-ce00-3cb8-88b1-9a2ea0546f52",
                                "text": "Winnetou był wodzem Apaczów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0765885-aac5-4bdd-8588-dca23c002355",
                        "source_entry_id": "3e6a789e-0fd0-3388-addb-07c04b97e766",
                        "source_sense_id": "64c10692-ce00-3cb8-88b1-9a2ea0546f52",
                        "target_lang_word": "Apache",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d82911e-8714-3c7a-8783-4bc0d3ae57c6",
                                        "entry_id": "b01fda4c-9c97-3dbe-b3f9-d313b55b65a5",
                                        "glosses": [
                                            "The group of languages used by any of several Athabascan-speaking peoples of the American southwest excluding Navajo, i.e. Chiricahua, Jicarilla, Lipan, Mescalero, Plains Apache, or Western Apache."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "776c6f82-cbfb-3c0a-b3e9-9744a7db9910",
                                        "entry_id": "b01fda4c-9c97-3dbe-b3f9-d313b55b65a5",
                                        "glosses": [
                                            "A town in Oklahoma, United States. See Apache, Oklahoma."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a09a2d1-8f49-3335-9755-7a5bdb2b6b70",
                                        "entry_id": "b01fda4c-9c97-3dbe-b3f9-d313b55b65a5",
                                        "glosses": [
                                            "Apache HTTP Server, a widely used open source web server software suite."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d91a4602-096e-4813-bbc7-d832d27e1d03",
                                                "sense_id": "8a09a2d1-8f49-3335-9755-7a5bdb2b6b70",
                                                "text": "This list is necessary so Apache can set the right HTTP headers when a certain file is requested."
                                            },
                                            {
                                                "example_id": "c3d930ac-33a9-44c3-a62f-13d1cdef8428",
                                                "sense_id": "8a09a2d1-8f49-3335-9755-7a5bdb2b6b70",
                                                "text": "This section discusses the process of configuring Apache to participate in WebLogic clusters. Apache is a Web server, the most popular one, actually."
                                            },
                                            {
                                                "example_id": "73296f19-4c5a-4fc4-95d6-eefc4ffefab5",
                                                "sense_id": "8a09a2d1-8f49-3335-9755-7a5bdb2b6b70",
                                                "text": "IBM made an early commitment to support and use Apache as the basis for its web offerings and has dedicated substantial resources to the project because it makes more sense to use an established, proven web server."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Apache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8091b818-f8e3-3147-8ed9-e2e004e589e1",
                                        "entry_id": "7c1b2c9c-957f-38df-92cb-4a3154401066",
                                        "glosses": [
                                            "Any of several Athabascan-speaking peoples of the American southwest excluding Navajo, i.e., Chiricahua, Jicarilla, Lipan, Mescalero, Plains Apache, or Western Apache."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5d84ea-2cc6-4155-ad07-fa96862c1eaa",
                                                "sense_id": "8091b818-f8e3-3147-8ed9-e2e004e589e1",
                                                "text": "Away up at the sources of the Gila, where the pines and cedars stand and where creeks and valleys are found, is a part of the Apache land."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dce711ba-6195-3c39-9dc3-46a23acb2f5c",
                                        "entry_id": "7c1b2c9c-957f-38df-92cb-4a3154401066",
                                        "glosses": [
                                            "A person belonging to an Apache people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66f67435-3608-3508-ad27-b1ab63fc3c63",
                                        "entry_id": "7c1b2c9c-957f-38df-92cb-4a3154401066",
                                        "glosses": [
                                            "A Parisian gangster of the late 19th and early 20th centuries."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a97464-78f1-4afd-b001-ff79ae1dfaee",
                                                "sense_id": "66f67435-3608-3508-ad27-b1ab63fc3c63",
                                                "text": "But the brain, and the agility, and the muscles that had coped with the mighty strength and cruel craftiness of Terkoz and Numa in the fastness of their savage jungle were not to be so easily subdued as these apaches of Paris had believed."
                                            },
                                            {
                                                "example_id": "8b034ed9-fc30-4be3-b5c1-a5b2df8d6956",
                                                "sense_id": "66f67435-3608-3508-ad27-b1ab63fc3c63",
                                                "text": "“He had the big paper knife in his hand, and ‘Mind, Dorcas,’ he says, ‘you’ll have to be very respectful. This is my specially sharpened scimitar, and it’s off with your head if I’m at all displeased with you!’ Miss Cynthia, she was what they call an Apache, or some such name—a Frenchified sort of cut-throat, I take it to be. A real sight she looked. You’d never have believed a pretty young lady like that could have made herself into such a ruffian.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a4c1a4-7760-3f2a-a525-1b9d2473fbbe",
                                        "entry_id": "7c1b2c9c-957f-38df-92cb-4a3154401066",
                                        "glosses": [
                                            "AH-64 Apache, a U.S. military helicopter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6391dcae-2d2e-4a7f-9be4-a1e15dd1265d",
                        "source_entry_id": "3e6a789e-0fd0-3388-addb-07c04b97e766",
                        "source_sense_id": "64c10692-ce00-3cb8-88b1-9a2ea0546f52",
                        "target_lang_word": "Apache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                                        "entry_id": "230a2de9-df6c-3958-9ea6-0f4c9f20e114",
                                        "glosses": [
                                            "ein Angehöriger der gleichnamigen Indianernation im Südwesten der Vereinigten Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f87ddb-7c1d-492f-8f20-4a5cc4bcfb4f",
                                                "sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                                                "text": "„Ich hätte mein Leben dahingegeben, um ihm das seinige zu erhalten, so wie er dieses hundertmal für mich wagte. Dies war mir nicht vergönnt; er ist dahingegangen, indem er, wie immer, ein Retter seiner Freunde war; aber er soll nur körperlich gestorben sein und hier in diesen Blättern fortleben, wie er in meiner Seele lebt, er Winnetou, der große Häuptling der Apachen.“"
                                            },
                                            {
                                                "example_id": "e4039b61-7c0d-42e7-bd55-9576c09af852",
                                                "sense_id": "a9ddde7c-7cad-3149-bc88-a79d1b6cda95",
                                                "text": "„Die ersten Pferdezuchten der Prärie bauten Apachen und Jumano im Süden und Südwesten auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
