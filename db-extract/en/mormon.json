            {
                "entry_id": "2c436383-207b-310e-b2fb-f250e57d8671",
                "word": "Mormon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "724bc0bc-ef59-4d9d-832e-6656ac4e401d",
                        "entry_id": "2c436383-207b-310e-b2fb-f250e57d8671",
                        "tags": [
                            "plural"
                        ],
                        "form": "Mormons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29180a97-74f6-367a-96a3-1429b73d7da5",
                        "entry_id": "2c436383-207b-310e-b2fb-f250e57d8671",
                        "glosses": [
                            "A believer in the Mormon religion, which views Joseph Smith as a prophet of God and holds the Bible and the Book of Mormon as its primary scriptures."
                        ],
                        "tags": [
                            "proscribed",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "71eb344d-171f-49c8-94d8-a3e44a4d06e0",
                                "sense_id": "29180a97-74f6-367a-96a3-1429b73d7da5",
                                "text": "That year, 1871, had marked a change which had been gradually coming in the lives of the peace-loving Mormons of the border."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f07d8de0-ace1-447d-9ebc-8e00e923b246",
                        "source_entry_id": "2c436383-207b-310e-b2fb-f250e57d8671",
                        "source_sense_id": "29180a97-74f6-367a-96a3-1429b73d7da5",
                        "source_sense_description": "member of The Church of Jesus Christ of Latter-day Saints",
                        "target_lang_word": "mormon",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "df6a4669-50b4-4ef2-a540-5a248275b1b6",
                        "source_entry_id": "2c436383-207b-310e-b2fb-f250e57d8671",
                        "source_sense_id": "29180a97-74f6-367a-96a3-1429b73d7da5",
                        "source_sense_description": "member of The Church of Jesus Christ of Latter-day Saints",
