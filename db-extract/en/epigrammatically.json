                                        "examples": [
                                            {
                                                "example_id": "bf03ac77-1b47-4aab-b1dd-84391163a63a",
                                                "sense_id": "8f763ff5-d877-3f59-aef3-61fd082f66e7",
                                                "text": "La société commerçante et bourgeoise de la ville avait épigrammatiquement nommé son logis un hôtel, et depuis une vingtaine d’années la plupart des habitants avaient fini par dire sérieusement l’hôtel d'Esgrignon en désignant la demeure du marquis."
                                            },
                                            {
                                                "example_id": "790d5834-0f10-45ec-89a9-e182ff2bef41",
                                                "sense_id": "8f763ff5-d877-3f59-aef3-61fd082f66e7",
                                                "text": "Comment ne pas se pincer épigrammatiquement les lèvres, en voyant l’homme qui avait inventé la philosophie des meubles, des gilets, et qui allait nous léguer des axiomes sur les pantalons, sur la grâce et sur le harnais ?"
                                            }
                                        ]
                                    }
