{
    "word_family": [
        "нагибать",
        "нагиб",
        "нагибание",
        "нагнутый"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a88ea2e9-61f1-3150-857a-e66ba711cf6d",
                    "sense_definition": "Наклонить верхнюю часть тела или голову вниз.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему пришлось <w>нагнуться</w>, чтобы поднять упавшую ручку с пола.",
                            "target_lang_translations": {
                                "it": "Ha dovuto <w>chinarsi</w> per raccogliere la penna caduta dal pavimento."
                            }
                        },
                        {
                            "text": "Девочка <w>нагнулась</w> к цветам, чтобы почувствовать их приятный аромат.",
                            "target_lang_translations": {
                                "it": "La bambina si è <w>chinata</w> verso i fiori per sentirne il profumo gradevole."
                            }
                        }
                    ],
                    "synonyms": [
                        "наклониться"
                    ],
                    "antonyms": [
                        "выпрямиться"
                    ],
                    "common_phrases": [
                        "низко нагнуться"
                    ],
                    "target_lang_definitions": {
                        "it": "Piegare la parte superiore del corpo o la testa verso il basso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "chinarsi",
                                "target_lang_sense_clarification": "Piegare il corpo in avanti o verso il basso, spesso per raccogliere qualcosa."
                            },
                            {
                                "target_lang_word": "piegarsi",
                                "target_lang_sense_clarification": "Flettere il corpo o una parte di esso verso il basso."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cabd57f-1dcb-3167-93d1-16394aa3a695",
                    "sense_definition": "Страдательный залог от глагола <w>нагнуть</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тонкое деревце было <w>нагнуто</w> сильным порывом ветра к самой земле.",
                            "target_lang_translations": {
                                "it": "Il sottile alberello è stato <w>piegato</w> fino a terra da una forte raffica di vento."
                            }
                        },
                        {
                            "text": "Под тяжестью снега ветка была <w>нагнута</w> вниз.",
                            "target_lang_translations": {
                                "it": "Sotto il peso della neve, il ramo è stato <w>piegato</w> verso il basso."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Forma passiva del verbo piegare, indicante un oggetto che è stato curvato da una forza esterna."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "essere piegato",
                                "target_lang_sense_clarification": "Stato di un oggetto che è stato curvato o inclinato da una forza esterna."
                            },
                            {
                                "target_lang_word": "essere curvato",
                                "target_lang_sense_clarification": "Stato di un oggetto che ha perso la sua forma dritta a causa di una pressione."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}