{
    "word_family": [
        "necessary",
        "necessitate",
        "necessarily",
        "necessitous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07f9e451-88a9-3ab9-9650-b79ea1eeb1bb",
                    "sense_definition": "Something necessary; a requisite; something indispensable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Food, water, and shelter are the basic <necessities> of life.",
                            "target_lang_translations": {
                                "ru": "Еда, вода и жилье — это основные жизненные <потребности>.",
                                "zh": "食物、水和住所是生活的基本<w>必需品</w>。",
                                "es": "La comida, el agua y el refugio son las <necesidades> básicas de la vida."
                            }
                        },
                        {
                            "text": "A warm coat is a <necessity> when living in such a cold climate.",
                            "target_lang_translations": {
                                "ru": "Теплое пальто — это <необходимость>, когда живешь в таком холодном климате.",
                                "zh": "在这种寒冷的气候下生活，一件暖和的外套是<w>必需品</w>。",
                                "es": "Un abrigo cálido es una <necesidad> cuando se vive en un clima tan frío."
                            }
                        }
                    ],
                    "synonyms": [
                        "requisite",
                        "essential",
                        "must-have"
                    ],
                    "antonyms": [
                        "luxury"
                    ],
                    "common_phrases": [
                        "bare necessities",
                        "basic necessities",
                        "daily necessities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то необходимое; обязательное условие; что-то незаменимое.",
                        "zh": "指生活中不可或缺的事物或必需品。",
                        "es": "Algo que es necesario; un requisito; algo indispensable."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предмет первой необходимости",
                                "target_lang_sense_clarification": "жизненно важная вещь"
                            },
                            {
                                "target_lang_word": "необходимость",
                                "target_lang_sense_clarification": "вещь, без которой нельзя обойтись"
                            },
                            {
                                "target_lang_word": "потребность",
                                "target_lang_sense_clarification": "надобность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必需品",
                                "target_lang_sense_clarification": "生活中不可缺少的东西"
                            },
                            {
                                "target_lang_word": "必要条件",
                                "target_lang_sense_clarification": "达成某事所必须具备的条件"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "necesidad",
                                "target_lang_sense_clarification": "aquello que se necesita o es indispensable"
                            },
                            {
                                "target_lang_word": "artículo de primera necesidad",
                                "target_lang_sense_clarification": "bien básico para la subsistencia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d548133-f02d-3ba7-a608-ae9ee75a2d31",
                    "sense_definition": "The quality or state of being necessary, unavoidable, or absolutely requisite.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to sell the car out of <necessity> rather than choice.",
                            "target_lang_translations": {
                                "ru": "Мы решили продать машину из <необходимости>, а не по собственному выбору.",
                                "zh": "我们决定卖掉车是出于<w>必要性</w>，而非个人选择。",
                                "es": "Decidimos vender el coche por <necesidad> más que por elección."
                            }
                        },
                        {
                            "text": "He understood the <necessity> of finishing the project on time.",
                            "target_lang_translations": {
                                "ru": "Он понимал <необходимость> закончить проект вовремя.",
                                "zh": "他明白按时完成项目的重要性，这是工作的<w>必要性</w>所在。",
                                "es": "Él entendió la <necesidad> de terminar el proyecto a tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "inevitability",
                        "necessariness",
                        "certainty"
                    ],
                    "antonyms": [
                        "contingency"
                    ],
                    "common_phrases": [
                        "out of necessity",
                        "of necessity",
                        "absolute necessity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние необходимости, неизбежности или обязательности.",
                        "zh": "指某事是必须的、不可避免的或绝对需要的状态。",
                        "es": "La cualidad o estado de ser necesario, inevitable o absolutamente requerido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "необходимость",
                                "target_lang_sense_clarification": "обязательность, неизбежность"
                            },
                            {
                                "target_lang_word": "надобность",
                                "target_lang_sense_clarification": "нужда в чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必要性",
