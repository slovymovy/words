                "translations": [
                    {
                        "translation_id": "2675e9d2-5276-48bb-8b65-6e71e84e153c",
                        "source_entry_id": "f13cce54-7bae-3ddc-8694-d7ed1907d041",
                        "source_sense_id": "74c7e424-9ea1-3dfd-937a-4dcda6b479e5",
                        "source_sense_description": "alle Äste und Zweige eines Baums; Astwerk, Gezweig",
                        "target_lang_word": "Astwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aabe7685-c8ce-379e-b913-e1fe0652111e",
                                        "entry_id": "dd37e6f9-b30b-3e65-887a-e27e31faaff5",
                                        "glosses": [
                                            "Gesamtheit der Äste eines Baums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0481e418-63e0-41f4-b841-0fab51baea6c",
                                                "sense_id": "aabe7685-c8ce-379e-b913-e1fe0652111e",
                                                "text": "„Der Zugang zur Höhle des Dagon liegt stets im Dunkeln, da das mächtige Astwerk und das dichte Laub keine Sonnenstrahlen durchlassen, doch an jenem Tag ließ die Finsternis meiner eigenen Seele die Schatten noch unheilvoller und düsterer erscheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a58cb425-f3bc-4007-8de8-19a14eb6666a",
                        "source_entry_id": "f13cce54-7bae-3ddc-8694-d7ed1907d041",
                        "source_sense_id": "74c7e424-9ea1-3dfd-937a-4dcda6b479e5",
                        "source_sense_description": "alle Äste und Zweige eines Baums; Astwerk, Gezweig",
                        "target_lang_word": "Gezweig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gezweig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                        "entry_id": "2c4a8d2f-3227-3d09-858e-0ab67af7200a",
                                        "glosses": [
                                            "Gesamtheit aller Zweige (einer Hecke, eines Baumes oder Ähnlichem)"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d9e12d9-f926-44b2-aa0a-8af57ecbb5ba",
                                                "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                                "text": "„Im dichten, dunklen Gezweig brüten Vögel und bauen Spinnen ihre Netze.“"
                                            },
                                            {
                                                "example_id": "22e601e5-f1c9-4fd0-b860-3ea95de5ade8",
                                                "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                                "text": "„Das Laub raschelte, die Sonne spielte durch das Gezweig, und aus dem Walde her vernahm man den Specht und dann und wann auch den Kuckuck.“"
                                            },
                                            {
                                                "example_id": "d6dcaa34-828a-4b58-b8d6-76aad94a9f94",
                                                "sense_id": "18c4f1cb-894e-390f-b2d9-502cd50d50fc",
                                                "text": "„Tagsüber hatte ein schwerer Sturm von Nordwesten her durchs Werratal geheult, das trockene Gezweig aus den Bäumen gerissen und den Märzstaub in langen Fahnen über die Landstraßen getrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
