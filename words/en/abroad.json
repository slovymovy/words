            "senses": [
                {
                    "sense_id": "be03866b-be48-3b5b-b21c-eed0a9a0adb7",
                    "sense_definition": "In or to a foreign country or countries.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "foreign_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many students choose to study <w>abroad</w> to learn a new language and experience a different culture.",
