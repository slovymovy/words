        "nl-extract.jsonl": [
            {
                "entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                "word": "akkefietje",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "be93ae08-9a45-4ac4-bbaf-2b7b1c41ac47",
                        "entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "akkefietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1f4fe58-1068-3f94-bdc3-3c581784ded1",
                        "entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                        "glosses": [
                            "lastig werk, karweitje"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ff3a0d3d-cc44-3c19-9de6-18fc66c4315e",
                        "entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                        "glosses": [
                            "een storend voorval, een ruzietje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "021ae068-d098-4f33-9413-43f36b86ab4c",
                                "sense_id": "ff3a0d3d-cc44-3c19-9de6-18fc66c4315e",
                                "text": "Zij hadden een akkefietje op het werk."
                            },
                            {
                                "example_id": "fd471572-9c96-4df8-86f5-ef58aaa9d4cc",
                                "sense_id": "ff3a0d3d-cc44-3c19-9de6-18fc66c4315e",
                                "text": "‘Gaat het? ’Chantal gaf hem een kus. ‘Niks bijzonders. Een akkefietje met de jongens. Na het eten hebben we het er wel over, oké? ’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86609092-5eb5-4fd5-87c8-cde8ebea2c32",
                        "source_entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                        "source_sense_id": "e1f4fe58-1068-3f94-bdc3-3c581784ded1",
                        "source_sense_description": "karweitje",
                        "target_lang_word": "trifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "An English dessert made from a mixture of thick custard, fruit, sponge cake, jelly and whipped cream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c79891-8b81-4e10-965e-c82cfeea0232",
                                                "sense_id": "16162965-0b2e-3f2c-8592-89284274666d",
                                                "text": "It is interesting to watch the surface joviality on screen while racism is layered between courses like soggy trifles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Anything that is of little importance or worth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c68516-c47b-4d02-89d9-6e2659ed57cf",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "Trifles light as air / Are to the jealous confirmation strong / As proofs of holy writ."
                                            },
                                            {
                                                "example_id": "7a322d08-5d32-4bdf-ae4e-65156e9bb983",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "Olde Chaucer doth of Topas tell, / Mad Rablais of Pantagruell, / A latter third of Dowsabell, / With such poore trifles playing:"
                                            },
                                            {
                                                "example_id": "6a71d67f-3840-4163-9984-2e1bb1705b17",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "[W]hen they had the Character and Honour of a VVoman at their Mercy, often times made it their Jest, and at least look’d upon it as a Trifle, and counted the Ruin of thoſe, they had had their VVill of, as a thing of no value."
                                            },
                                            {
                                                "example_id": "cc0830cd-ed41-4040-accd-6023fc7c1807",
                                                "sense_id": "c44b924c-8307-39f0-a8f1-848f3db7d35e",
                                                "text": "‘And all about a rattle!’ said Alice, still hoping to make them a little ashamed of fighting for such a trifle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Anything that is of little importance or worth.",
                                            "An insignificant amount of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10f54872-5640-4509-96de-a7698a1c41b3",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "A trifle, some eight-penny matter."
                                            },
                                            {
                                                "example_id": "bd603be3-d0d9-4754-b0a8-5084a51b2f27",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "He told her of horses which he had bought for a trifle and sold for incredible sums […]"
                                            },
                                            {
                                                "example_id": "8e271f1c-1a22-433f-9479-ec1c83112fde",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "What’s eighty dollars? A trifle. An insignificant sum."
                                            },
                                            {
                                                "example_id": "85951f32-6dda-42f7-aec1-972de8c23560",
                                                "sense_id": "7d1aaf6b-52bc-3e50-a01b-4d67a6267cbb",
                                                "text": "“It was bad of me then not to send the fifteen hundred dollars. I assumed it would be a trifle.” / “Well, until a few months ago it was a trifle.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "A very small amount (of something)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1634c6-8368-4253-8bff-c50aef9a1a95",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "This Line leaves out […] Poplar and Black-vvall, vvhich are indeed contiguous, a Trifle of Ground excepted, and very populous."
                                            },
                                            {
                                                "example_id": "204b9cd2-5780-403d-8608-6516694dd026",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "There was a good deal of rustling and whispering behind the curtain, a trifle of lamp smoke, and an occasional giggle from Amy […]"
                                            },
                                            {
                                                "example_id": "b3c1ac67-15a2-4679-8308-a8aab5d864ca",
                                                "sense_id": "b6ec220f-93a2-3ea4-b0c0-3c170f1a6c4e",
                                                "text": "“Take just a trifle of French mustard […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8aabf77-061e-38c9-96be-9de1b426d461",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "A particular kind of pewter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9bf760d-1973-3934-b633-aeb9b3929599",
                                        "entry_id": "03e23de3-f36d-34a0-9f3a-5f99d0b449eb",
                                        "glosses": [
                                            "Utensils made from this particular kind of pewter."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To deal with something as if it were of little importance or worth."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e7008be-5805-4793-b780-0069e73f9a6b",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "You must not trifle with her affections."
                                            },
                                            {
                                                "example_id": "8791ad27-10bd-4bf7-8097-ea7210e03b50",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "[…] Do not believe / That, from the sense of all civility, / I thus would play and trifle with your reverence:"
                                            },
                                            {
                                                "example_id": "fada06cd-b8c1-4fdd-9ebd-8f2964ce0e54",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "“Miss Bennet,” replied her ladyship, in an angry tone, “you ought to know, that I am not to be trifled with […]”"
                                            },
                                            {
                                                "example_id": "f7b0b147-5669-4051-9659-4c97cdf7b084",
                                                "sense_id": "cc07337d-ed02-3506-9424-79770d7b9233",
                                                "text": "But a Judge may not trifle with the Law because the society is defective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db83cd66-e89b-3f0e-bc93-f36db4591457",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To act, speak, or otherwise behave with jest."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8471fd01-9f98-41a1-94d2-003a618de041",
                                                "sense_id": "db83cd66-e89b-3f0e-bc93-f36db4591457",
                                                "text": "[…] playing and trifling are completely banished out of my mind […]"
                                            },
                                            {
                                                "example_id": "3d4c96c8-dd9d-4829-9fcf-3b3fe7b6869a",
                                                "sense_id": "db83cd66-e89b-3f0e-bc93-f36db4591457",
                                                "text": "But he was terribly roused too and bound to go on; he wasn’t just trifling but intended something."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To inconsequentially toy with something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee57bda-284c-4782-8ad5-8d59d8361834",
                                                "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                                                "text": "Mr. Micawber, leaning back in his chair, trifled with his eye-glass and cast his eyes up at the ceiling […]"
                                            },
                                            {
                                                "example_id": "5d8aad01-a139-47d3-bf1d-e67d7d455fd2",
                                                "sense_id": "c84fa13d-26ec-3379-bf2b-4ebb3b18ade7",
                                                "text": "She sat in a café, trifling with her coffee spoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To squander or waste."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65a205f2-a3f4-4db6-9306-04bef681bec4",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "We trifle time: I pray thee, pursue sentence."
                                            },
                                            {
                                                "example_id": "508faf7c-ac0d-427f-a250-99903adbfb41",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "For an honest and sober man will rather make that woman his wife, whom he seeth employed continually about her business, than one who makes it her business to trifle away her own and others time."
                                            },
                                            {
                                                "example_id": "119ada1f-f336-4d5a-95fe-e3b2aca3c3e2",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "As it was, he did nothing with much zeal, but sport; and his time was otherwise trifled away, without benefit from books or anything else."
                                            },
                                            {
                                                "example_id": "cab4c630-7bf7-4cfa-9e81-d438230ba4d3",
                                                "sense_id": "1757aa35-4292-39b1-9026-4edd2b73c73d",
                                                "text": "You who have known neither sorrow nor pleasure; who have trifled your life away!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ae1394c-58d1-397f-a3ee-cf64ed4caeee",
                                        "entry_id": "bf721720-c35a-36d0-9ff3-461cffcce08b",
                                        "glosses": [
                                            "To make a trifle of, to make trivial."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "860c4768-bd5f-4df7-a1f8-59d369a329ef",
                                                "sense_id": "7ae1394c-58d1-397f-a3ee-cf64ed4caeee",
                                                "text": "[…] but this sore night / Hath trifled former knowings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7967d978-05cf-4b00-9261-630e45aeb5ed",
                        "source_entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                        "source_sense_id": "e1f4fe58-1068-3f94-bdc3-3c581784ded1",
                        "source_sense_description": "karweitje",
                        "target_lang_word": "broutille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broutille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3f9475-1ea7-3b0c-a23f-aadb38227823",
                                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                                        "glosses": [
                                            "Menues branches d’arbres entrant, avec les morceaux de bois, dans la composition des fagots, dont elles constituent l'âme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c09ef85e-5e5c-407e-955c-785f45dfe8f9",
                                                "sense_id": "5f3f9475-1ea7-3b0c-a23f-aadb38227823",
                                                "text": "Le bûcheron se mit à couper du bois, et ses enfants à ramasser des broutilles pour faire des fagots."
                                            },
                                            {
                                                "example_id": "62154668-7692-4f39-9a15-6cfbdb959f7e",
                                                "sense_id": "5f3f9475-1ea7-3b0c-a23f-aadb38227823",
                                                "text": "De petits villageois, tels que ceux-ci, avaient élevé leur colosse; ils étaient en train d'y mettre le bouquet, lorsque la vieille Lisheth vint à passer, courbée en demi-cercle sous le poids d'un fagot de broutilles. Elle avait eu bien du mal à le recueillir, à cause de la neige nouvellement tombée; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                                        "glosses": [
                                            "Éléments sans grande importance au vu de l’ensemble (d'un projet, par ex.) et qu’on peut considérer comme accessoires, sans que cela n’enlève rien à leur valeur intrinsèque."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "456d78e6-2f35-400c-ae33-bd030925489f",
                                                "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                                "text": "Qui plus est, il lui fallait conserver ses huit dollars et des broutilles jusqu'à ce que, d'une manière ou d'une autre, il parvienne à avoir davantage d'argent."
                                            },
                                            {
                                                "example_id": "d4205fc0-0adf-4914-b004-42e799bdf45e",
                                                "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                                "text": "Se complaire, s’abîmer (Litt.) dans des broutilles, et oublier l’essentiel."
                                            },
                                            {
                                                "example_id": "ca79ed73-9720-46a5-a5b8-2239939c3a40",
                                                "sense_id": "077ce6b0-9b88-3a20-81a0-847d3ff6f598",
                                                "text": "Restaient à acheter des tables, des lampes, des chaises et des broutilles comme un dessus-de-lit, des rideaux, des coussins. Mais ils garderaient cela pour un autre jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                        "entry_id": "6542e7b1-4110-353b-b447-6bb39844c0dd",
                                        "glosses": [
                                            "Chose sans grande importance, qui ne mérite pas que l’on s’y attarde (fréquent aussi au singulier)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc63b4a-3700-471c-b6f0-c03536c0ba32",
                                                "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                                "text": "Ce folliculaire n’a fait paraître que des broutilles qu'on aura vite oubliées."
                                            },
                                            {
                                                "example_id": "d2452177-188b-4600-8c88-77d3f0859e64",
                                                "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                                "text": "- Ah ! ça, San-Antonio, rouscaille le Big Boss, vous me dérangez pour une broutille pareille !"
                                            },
                                            {
                                                "example_id": "de62ba9c-3b39-43e9-b409-b7c50e1bfdd9",
                                                "sense_id": "dd37e12a-7fe2-3b3d-9ec7-ab1e3f0c33e8",
                                                "text": "Est-ce un désaccord de fond ou bien n’est-ce qu’une broutille ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e9de08-a2a1-4d59-8e88-7b4d5773668d",
                        "source_entry_id": "6758d1c6-a7c0-3202-8859-08dcaa4214cc",
                        "source_sense_id": "e1f4fe58-1068-3f94-bdc3-3c581784ded1",
                        "source_sense_description": "karweitje",
                        "target_lang_word": "bagatelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bagatelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b529aaf-9369-38f6-9ab0-439a2ea2519b",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Chose de peu de prix et peu nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b5bafd-f212-4e66-9829-f104a4e9fb84",
                                                "sense_id": "2b529aaf-9369-38f6-9ab0-439a2ea2519b",
                                                "text": "Il dépense tout son argent en bagatelles."
                                            },
                                            {
                                                "example_id": "3e76e94e-d0c6-4b27-932e-386bbeca1959",
                                                "sense_id": "2b529aaf-9369-38f6-9ab0-439a2ea2519b",
                                                "text": "Il m’a fait présent de quelques bagatelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b0bd95e-e3be-3152-b00b-5dfb0b7fe64d",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Chose frivole et de peu d’importance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75443e40-5a0b-41ab-8162-aa0b92ad372b",
                                                "sense_id": "7b0bd95e-e3be-3152-b00b-5dfb0b7fe64d",
                                                "text": "Vous pouvez alléguer que mon peu de fortune autant que mes goûts m’interdisent de porter des bagatelles qui ne conviennent qu’à des reines ou à des courtisanes."
                                            },
                                            {
                                                "example_id": "f65de534-96df-4327-9a85-85790d95d6b3",
                                                "sense_id": "7b0bd95e-e3be-3152-b00b-5dfb0b7fe64d",
                                                "text": "Sous la moustache blonde du grand gaillard, ses lèvres goulues cherchaient la bouche voluptueuse, cependant que l’autre, sans s’attarder à des bagatelles inutiles et connaissant la valeur du temps, troussait vigoureusement les jupes."
                                            },
                                            {
                                                "example_id": "efa9b75f-753f-4616-8293-6a5b96a2db62",
                                                "sense_id": "7b0bd95e-e3be-3152-b00b-5dfb0b7fe64d",
                                                "text": "– Voici deux billets de cinquante roubles, mon général.\n– Merci. N’oubliez pas de me faire penser à vous restituer cette bagatelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cc82f8-60d7-3ccd-a184-e0ff95ee836a",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Choses qui n’ont pas toute l’importance, toute la gravité qu’on leur suppose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf0bf29-a7a4-4139-8802-a55a49e48936",
                                                "sense_id": "f5cc82f8-60d7-3ccd-a184-e0ff95ee836a",
                                                "text": "Ignorante comme toutes ses compatriotes, elle était gaie et rieuse, s’amusant de la moindre bagatelle et ne connaissant de la vie que ce qu’elle a d’agréable."
                                            },
                                            {
                                                "example_id": "5625709d-6031-4a44-81c8-b76de37654cb",
                                                "sense_id": "f5cc82f8-60d7-3ccd-a184-e0ff95ee836a",
                                                "text": "Cependant le prince n’essaya pas même de résister, bien que son caractère fût précisément un de ceux qui se cramponnaient à des bagatelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1827f2ff-5fea-3131-8ca6-09bb3e9124e2",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Amourette ou acte de faire l’amour."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a777211-0b67-4688-b350-d817cb1d85b4",
                                                "sense_id": "1827f2ff-5fea-3131-8ca6-09bb3e9124e2",
                                                "text": "Un chaud lapin. Un peu myxomatosé, mais porté sur la bagatelle avec des fruits verts et il a voulu…"
                                            },
                                            {
                                                "example_id": "d79bc852-61e1-4c22-af73-afbb1b825afd",
                                                "sense_id": "1827f2ff-5fea-3131-8ca6-09bb3e9124e2",
                                                "text": "Agathe s’était fait une raison. Depuis le départ de son homme, la bagatelle ne la concernait plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77fd363e-2e1c-318f-922b-3f637c161fb1",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Exclamation, pour exprimer le doute, l’incertitude, ou pour marquer le peu de cas que l’on fait d’une menace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0598f7d4-a307-4461-8746-5ece12539388",
                                                "sense_id": "77fd363e-2e1c-318f-922b-3f637c161fb1",
                                                "text": "Il prétend qu’il me fera un procès : bagatelle ! — Il me maltraitera, dites-vous : bagatelle !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "222388c0-6598-3c5b-af94-0eaabcdf6175",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Meurtre ou assassinat. Expression d’origine sicilienne signifiant la liquidation d’une « taupe » ou d’un « moineau »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620893b1-bf57-49b7-a677-f048a741e257",
                                                "sense_id": "222388c0-6598-3c5b-af94-0eaabcdf6175",
                                                "text": "Il a fait une bagatelle à Dany le moineau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fdc2886-94bd-30e6-924d-dd5f47dd1d7e",
                                        "entry_id": "9e429e63-b2f2-3669-82a2-ff64d3fc7853",
                                        "glosses": [
                                            "Composition brève, simple et légère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b50af8db-f0de-4232-abfa-25ddbde82708",
                                                "sense_id": "5fdc2886-94bd-30e6-924d-dd5f47dd1d7e",
                                                "text": "Bagatelles et impromptus de Bedřich Smetana."
                                            }
                                        ]
                                    }
                                ]
                            }
