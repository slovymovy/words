            "pos": "noun",
            "senses": [
                {
                    "sense_id": "476dbf5b-9556-322f-b770-2b6b676656e9",
                    "sense_definition": "postępowanie zgodne z przyjętymi normami etycznymi i społecznymi; uczciwość oraz takt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moralność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwykła ludzka <w>przyzwoitość</w> nakazuje pomóc osobie, która znalazła się w potrzebie.",
                            "target_lang_translations": {
                                "ru": "Обычная человеческая <w>порядочность</w> велит помочь человеку, оказавшемуся в беде."
                            }
                        },
                        {
                            "text": "Jego zachowanie podczas zebrania przekroczyło wszelkie granice <w>przyzwoitości</w>.",
                            "target_lang_translations": {
                                "ru": "Его поведение во время собрания перешло всякие границы <w>приличия</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "obyczajność",
                        "moralność",
                        "uczciwość"
                    ],
                    "antonyms": [
                        "nieprzyzwoitość",
                        "niemoralność",
                        "nieuczciwość",
                        "podłość"
                    ],
                    "common_phrases": [
                        "ludzka przyzwoitość",
                        "granice przyzwoitości",
                        "zwykła przyzwoitość"
                    ],
                    "target_lang_definitions": {
                        "ru": "поведение в соответствии с принятыми этическими и социальными нормами; честность, порядочность и такт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порядочность",
                                "target_lang_sense_clarification": "честность, строгое следование нормам морали"
                            },
                            {
                                "target_lang_word": "приличие",
                                "target_lang_sense_clarification": "соответствие принятым правилам поведения в обществе"
                            },
                            {
                                "target_lang_word": "благопристойность",
                                "target_lang_sense_clarification": "надлежащее, уважительное поведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a21826f-0986-385d-892d-33f0f32bf33a",
                    "sense_definition": "zachowanie zgodne z normami obyczajowymi dotyczącymi skromności i sfery intymnej",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "obyczajność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starsze pokolenie zwracało szczególną uwagę na <w>przyzwoitość</w> ubioru w miejscach publicznych.",
                            "target_lang_translations": {
                                "ru": "Старшее поколение обращало особое внимание на <w>благопристойность</w> одежды в общественных местах."
                            }
                        },
                        {
                            "text": "Wypowiadane przez niego żarty naruszały podstawowe zasady <w>przyzwoitości</w>.",
                            "target_lang_translations": {
                                "ru": "Шутки, которые он отпускал, нарушали элементарные правила <w>приличия</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "skromność",
                        "obyczajność"
                    ],
                    "antonyms": [
                        "sprośność",
                        "nieprzyzwoitość"
                    ],
                    "common_phrases": [
                        "zasady przyzwoitości"
                    ],
                    "target_lang_definitions": {
                        "ru": "поведение, соответствующее нормам скромности, целомудрия и сдержанности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приличие",
                                "target_lang_sense_clarification": "соблюдение норм скромности и пристойности (часто во мн. ч. приличия)"
                            },
                            {
                                "target_lang_word": "благопристойность",
                                "target_lang_sense_clarification": "скромность, пристойность манер или внешнего вида"
                            },
                            {
                                "target_lang_word": "скромность",
                                "target_lang_sense_clarification": "сдержанность в одежде или поведении"
                            }
                        ]
                    }
                }
            ]
        }
