                ],
                "senses": [
                    {
                        "sense_id": "80f5078f-37c2-3bde-8592-b195e755a428",
                        "entry_id": "4b54fe57-d536-3f64-9b76-8ac14a4a3346",
                        "glosses": [
                            "geometrische Figur mit einundzwanzig Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "76a84e1d-9ef9-4802-94cf-96bb59782679",
                                "sense_id": "80f5078f-37c2-3bde-8592-b195e755a428",
                                "text": "„Die – wahrscheinlich anschlußbedingte – Schmalheit des Mittelschiffs gab Heinrich Parler die Idee und den Mut, aus dem ‚Werk der Alten‘, den Chören von Notre Dame und Amiens, sein verwegenes Einundzwanzigeck zu entwickeln, dessen einbeschriebenes Dreieck diesmal mit der Spitze nach Osten zeigt.“"
                            },
                            {
                                "example_id": "8bc801fd-ad27-497e-8b46-f574ad83d7d9",
                                "sense_id": "80f5078f-37c2-3bde-8592-b195e755a428",
                                "text": "„Doch zurück zu dessen Einundzwanzigeck in Schwäbisch Gmünd. Ein für das Verständnis des Zusammenhangs der Proportionen wichtiger Punkt muß noch bestimmt werden.“"
                            },
                            {
                                "example_id": "80708af5-6d4d-4aec-9038-08861348f57f",
                                "sense_id": "80f5078f-37c2-3bde-8592-b195e755a428",
                                "text": "„In wie viel Dreiecke kann a) ein Fünfeck, b) ein Zwölfeck, c) ein Einundzwanzigeck […] durch Diagonalen zerlegt werden?“"
                            },
                            {
                                "example_id": "83973259-ab4a-4992-9433-9f57f19e72d7",
                                "sense_id": "80f5078f-37c2-3bde-8592-b195e755a428",
                                "text": "„Ich kann ihm deswegen auch nach Belieben viele koordinierte Begriffe an die Seite setzen, Viereck, Fünfeck, Einundzwanzigeck, und das Denken ist darin so wenig behindert als in der Setzung von Zahlen, die ich beliebig vermehren kann.“"
                            },
                            {
                                "example_id": "0bc7575a-e673-4d02-8df8-ba1e5ee140fa",
                                "sense_id": "80f5078f-37c2-3bde-8592-b195e755a428",
                                "text": "„Eine vierte ähnliche Tabelle dient gleicherweise zum unmittelbaren Abgreifen der regelmässigen Vieleckseiten vom Dreieck angefangen bis zum Einundzwanzigeck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
