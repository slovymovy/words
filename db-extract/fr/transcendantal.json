                    },
                    {
                        "form_id": "eefa7a82-3d37-4a60-812e-6fae57bf410b",
                        "entry_id": "a36b199b-f049-3441-bfd6-2ea5ec3e7ac4",
                        "tags": [],
                        "form": "transcendental"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1ec900c3-60cb-3d9d-9b86-76cef5cdc5b0",
                        "entry_id": "a36b199b-f049-3441-bfd6-2ea5ec3e7ac4",
                        "glosses": [
                            "Qui est purement rationnel sans être phénoménal, de ce qui se fonde sur des données supérieures aux impressions des sens, sur des données a priori ; qui porte sur les conditions de possibilité de la chose plutôt que sur la chose elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bda026e-91a1-41ee-9ab7-41b4ec646a21",
                                "sense_id": "1ec900c3-60cb-3d9d-9b86-76cef5cdc5b0",
                                "text": "Il n’y a donc pas là un bien public pareil à d’autres, mais un bien qui conditionne la possibilité de tous les autres, naturels ou sociaux, public ou privés. C’est d’ailleurs pourquoi nous parlons d’un dommage transcendantal."
                            }
                        ]
                    },
                    {
                        "sense_id": "0520ed7c-e261-30b4-887b-43b1e1b16429",
                        "entry_id": "a36b199b-f049-3441-bfd6-2ea5ec3e7ac4",
                        "glosses": [
                            "Énorme, extraordinaire."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f5e13d72-e781-4698-b3f9-b2a800f16aca",
                                "sense_id": "0520ed7c-e261-30b4-887b-43b1e1b16429",
                                "text": "Quand il y a deux caméléons à la même corde, le spectacle devient d’une bouffonnerie transcendantale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cc773d4-96fb-44b0-850e-391c8909fb05",
                        "source_entry_id": "a36b199b-f049-3441-bfd6-2ea5ec3e7ac4",
                        "target_lang_word": "transzendental",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transzendental",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c949cf9-f219-3760-ab5f-b02bbe048cd9",
                                        "entry_id": "6c4517f4-1e68-3f45-910d-4b4c5163f9a5",
                                        "glosses": [
                                            "die aristotelischen Kategorien übersteigend"
                                        ],
                                        "tags": [
                                            "Scholastik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcde8bd2-48c3-4159-919b-d0250d642600",
                                                "sense_id": "6c949cf9-f219-3760-ab5f-b02bbe048cd9",
                                                "text": "„Die Logik ist transzendental.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ccbc5775-41d0-360c-9d33-61d64b437347",
                                        "entry_id": "6c4517f4-1e68-3f45-910d-4b4c5163f9a5",
                                        "glosses": [
                                            "die Bedingungen der Möglichkeit von Erfahrung betreffend (siehe: Transzendentalphilosophie und Transzendentalismus)"
                                        ],
                                        "tags": [
                                            "nach Kant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76d6dfe2-93c6-42bf-b701-5023608eaf53",
                                                "sense_id": "ccbc5775-41d0-360c-9d33-61d64b437347",
                                                "text": "„Ich nenne alle Erkenntnis transzendental, die sich nicht sowohl mit Gegenständen, sondern mit unserer Erkenntnisart von Gegenständen, sofern diese a priori möglich ist, überhaupt beschäftigt“"
                                            },
                                            {
                                                "example_id": "f216c911-808c-4cd3-b3f8-19802f8f97aa",
                                                "sense_id": "ccbc5775-41d0-360c-9d33-61d64b437347",
                                                "text": "„Das Dargelegte hat zur Folge, dass Allgemeine Metaphysik oder Ontologie sich nach Kant nicht mit transzendenten, d. h. jenseits der Erfahrung existierenden, sondern mit transzendentalen, d. h. Erfahrung überhaupt erst ermöglichenden Gegenständen befasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4be6bbc2-90bb-3e84-847a-05e43390c45b",
                                        "entry_id": "6c4517f4-1e68-3f45-910d-4b4c5163f9a5",
                                        "glosses": [
                                            "jenseits der"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50b1c0b4-0524-4840-a4f3-2901dbd05e66",
                        "source_entry_id": "a36b199b-f049-3441-bfd6-2ea5ec3e7ac4",
                        "target_lang_word": "transcendental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transcendental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ee5eff-5b12-3252-9f67-be8d5bbeeffa",
                                        "entry_id": "0a4642e6-3695-3c9c-a311-87729d86ada8",
                                        "glosses": [
                                            "A transcendentalist."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c90766c6-77bb-3bfa-8662-4493fd491cbd",
                                        "entry_id": "0a4642e6-3695-3c9c-a311-87729d86ada8",
                                        "glosses": [
                                            "Any one of the three transcendental properties of being: truth, beauty or goodness, which respectively are the ideals of science, art and religion and the principal subjects of the study of logic, aesthetics and ethics."
                                        ],
                                        "tags": [
                                            "Christian",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849d4240-f7c6-48e3-88e8-41bdf3e05e03",
                                                "sense_id": "c90766c6-77bb-3bfa-8662-4493fd491cbd",
                                                "text": "In deference to Christian usage we can say that the transcendentals constitute the Logos within which everything has its being and according to which everything is made."
                                            },
                                            {
                                                "example_id": "0f026669-12ac-40df-80d3-2c9d8afcfe8c",
                                                "sense_id": "c90766c6-77bb-3bfa-8662-4493fd491cbd",
                                                "text": "These predicates of Being are what the Medievals called, using a term that will have a fertile future, \"transcendentals\" (often called the \"universals\") because they transcend all particular genera, following the example of Being.⁹⁶ A quarrel over these transcendentals even shook the later Middle Ages. The quarrel stemmed from the question of whether the existence of these transcendentals was real or intellectual (also called nominal)."
                                            },
                                            {
                                                "example_id": "24a47203-6175-4ca9-b214-8598eba170e9",
                                                "sense_id": "c90766c6-77bb-3bfa-8662-4493fd491cbd",
                                                "text": "The medieval doctrine of the transcendentals is closely connected with a metaphysical conception of reality, but is there a science of being in William of Ockham (ca. 1285-1347)?"
                                            },
                                            {
                                                "example_id": "809cbefe-a3cb-4dd7-99bb-cdf1d1cc3f69",
                                                "sense_id": "c90766c6-77bb-3bfa-8662-4493fd491cbd",
                                                "text": "Another fascinating thing about the transcendentals is that each is fully contained in the others. When you appreciate beauty, for example, you recognise the presence of goodness and truth. When you grasp the truth about something you experience a moment of beauty in, perhaps, the simplicity or power of the insight. When you observe goodness in the actions of another person you are seeing truth and beauty in operation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transcendental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "446eb13f-420e-332c-90c0-f13500975673",
                                        "entry_id": "46455ccf-8808-3751-8402-41f854d11f09",
                                        "glosses": [
                                            "Concerned with the a priori or intuitive basis of knowledge, independent of experience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13a2cfb7-8c69-4b15-abe6-cf6c565a836a",
                                                "sense_id": "446eb13f-420e-332c-90c0-f13500975673",
                                                "text": "The best way to demonstrate the possibility of something is to show its actuality, for actuality implies possibility. At least since Kant, transcendental philosophies have been on the scene. However, such simple demonstration of the possibility of transcendental philosophy has not been effective and is not likely to be so — so strong is the presumption that transcendental philosophy just could not be possible, or, if it was possible earlier, it is not possible now."
                                            },
                                            {
                                                "example_id": "69531dc9-9a94-41e4-b7f3-07f9eb3be0ea",
                                                "sense_id": "446eb13f-420e-332c-90c0-f13500975673",
                                                "text": "1999, Robert Stern, 4: On Kant's Response to Hume: The Second Analogy as Transcendental Argument, Robert Stern (editor), Transcendental Arguments: Problems and Prospects, 2003, Oxford University Press (Clarendon Press), Paperback, page 47,\nWhilst it was once held that transcendental arguments could provide a direct and straightforward refutation of scepticism, this view now seems over-optimistic."
                                            },
                                            {
                                                "example_id": "00e4d099-c5bb-4883-bab7-fb6e266fe412",
                                                "sense_id": "446eb13f-420e-332c-90c0-f13500975673",
                                                "text": "2007, Steven Crowell, Jeff Malpas, Chapter 1: Introduction Steven Crowell, Jeff Malpas, (editors), Transcendental Heidegger, Stanford University Press, page 1,\nNot only does Heidegger's early work stand within the framework of transcendental phenomenology as established by Husserl—even though it also contests and revises that framework—but that thinking also stands in a close relationship to the critical philosophy of Immanuel Kant, and specifically to the transcendental project, and modes of argument, of Kant's Critique of Pure Reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47e80ed8-fc32-3869-b600-52057a522cd6",
                                        "entry_id": "46455ccf-8808-3751-8402-41f854d11f09",
                                        "glosses": [
                                            "Superior; surpassing all others; extraordinary; transcendent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cf8d8ba-efa4-337c-bb67-f8c88c41b2c6",
                                        "entry_id": "46455ccf-8808-3751-8402-41f854d11f09",
                                        "glosses": [
                                            "Mystical or supernatural."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "903f6d34-bd5d-303f-98dd-7165eaa35688",
                                        "entry_id": "46455ccf-8808-3751-8402-41f854d11f09",
                                        "glosses": [
                                            "Not algebraic (i.e., not the root of any polynomial that has positive degree and rational coefficients)."
                                        ],
                                        "tags": [
                                            "of a number or an element of an extension field"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8329848d-3866-45ad-90ee-8a3ba58212b3",
                                                "sense_id": "903f6d34-bd5d-303f-98dd-7165eaa35688",
                                                "text": "The theory of transcendental numbers was originated by Liouville in his famous memoir^† of 1844 in which he obtained, for the first time, a class, très-étendue, as it was described in the title of the paper, of numbers that satisfy no algebraic equation with integer coefficients."
                                            },
                                            {
                                                "example_id": "de291329-2433-44a4-b95e-bbf9aa8c59c9",
                                                "sense_id": "903f6d34-bd5d-303f-98dd-7165eaa35688",
                                                "text": "If the distribution of decimal digits of #92;pi (or any other transcendental number) is truly random (suspected but not yet mathematically proven!), given any arbitrary finite sequence of whole numbers, that sequence would be included an infinite number of times in the decimal expansion of #92;pi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1a4ace-d790-3fc4-ba34-00e06ead59e8",
                                        "entry_id": "46455ccf-8808-3751-8402-41f854d11f09",
                                        "glosses": [
                                            "That contains elements that are not algebraic."
                                        ],
                                        "tags": [
                                            "of an extension field"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b5b478-7258-4293-a809-d1e96f62184b",
                                                "sense_id": "8d1a4ace-d790-3fc4-ba34-00e06ead59e8",
                                                "text": "2006, Steven Roman, Field Theory, Springer, 2nd Edition, Graduate Texts in Mathematics 158, page 108,\nSuppose that F<E is purely transcendental. Show that any simple extension of F contained in E (but not equal to F) is transcendental over F."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
