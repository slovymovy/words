                                            {
                                                "example_id": "984dc2ae-766b-4341-9d81-4f574d9b11fd",
                                                "sense_id": "e48c10e1-ad3c-323d-8814-ef0e4f54772d",
                                                "text": "Too much desire can seriously affect one’s judgement."
                                            },
                                            {
                                                "example_id": "66e12daf-115b-4a6e-9007-051b11f021f8",
                                                "sense_id": "e48c10e1-ad3c-323d-8814-ef0e4f54772d",
                                                "text": "He stood...filled with the desire that his son should be like him, and should have sons like him, to people the earth. It is the strongest desire that can come to a man - if it comes to him at all - stronger even than love or the desire for personal immortality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98cf6d34-c2ce-358b-982a-843bfee74e3a",
                                        "entry_id": "ec9be0b1-29d4-3225-8511-caf17d44a233",
                                        "glosses": [
                                            "Someone or something wished for."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f85f1a1-36fc-4f30-9205-c6ba2eb777a2",
                                                "sense_id": "98cf6d34-c2ce-358b-982a-843bfee74e3a",
                                                "text": "It is my desire to speak with you."
                                            },
                                            {
                                                "example_id": "471ea309-1479-430f-ba1a-4ce543c771ed",
                                                "sense_id": "98cf6d34-c2ce-358b-982a-843bfee74e3a",
                                                "text": "You’re my heart’s desire."
                                            },
                                            {
                                                "example_id": "0cc04a79-8f81-470e-80d1-298e909b6676",
                                                "sense_id": "98cf6d34-c2ce-358b-982a-843bfee74e3a",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9809943-d987-309c-b0bc-34efccbf7fa7",
                                        "entry_id": "ec9be0b1-29d4-3225-8511-caf17d44a233",
                                        "glosses": [
                                            "Strong attraction, particularly romantic or sexual."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "117e369a-edde-4913-95a2-f64b466d5546",
                                                "sense_id": "e9809943-d987-309c-b0bc-34efccbf7fa7",
                                                "text": "His desire for her kept him awake at night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9921739-c3cb-31eb-b8ed-01bc6b5c68e2",
                                        "entry_id": "ec9be0b1-29d4-3225-8511-caf17d44a233",
                                        "glosses": [
                                            "Motivation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
