                "translations": [
                    {
                        "translation_id": "a20ae175-1f9f-44a4-b140-9bc71d11020b",
                        "source_entry_id": "1521b3b4-539f-3e51-9457-aba2ec5962a7",
                        "source_sense_id": "d34a18be-47dd-3314-aafa-51690e7923e8",
                        "target_lang_word": "heaviness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heaviness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7ce84f-b58c-3687-bbc5-a96e304708a8",
                                        "entry_id": "7e66c4d4-bec5-3e5e-8a2f-ecf3396924c2",
                                        "glosses": [
                                            "The state of being heavy; weight, weightiness, force of impact or gravity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29a8a37a-9c6e-48c3-a088-44ccc53f4625",
                                                "sense_id": "4f7ce84f-b58c-3687-bbc5-a96e304708a8",
                                                "text": "This figure, immobile and static in his heaviness, was assumed to be deeply asleep and therefore to introduce a note of humorous anecdotality to what should have been a tragic scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                        "entry_id": "7e66c4d4-bec5-3e5e-8a2f-ecf3396924c2",
                                        "glosses": [
                                            "Oppression; dejectedness, sadness; low spirits."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9143c2a-1ade-41d7-bdaa-5ec6b816bf0c",
                                                "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                                "text": "Firſt got vvith guile, and then preſeru'd vvith dread, / And after ſpent with pride and lauiſhneſſe, / Leauing behind them griefe and heauineſſe."
                                            },
                                            {
                                                "example_id": "b0a8ae17-c546-425b-bd85-054705cc5669",
                                                "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                                "text": "By ſo much the more ſhall I to-morrovv be at the height of heart-heavineſs."
                                            },
                                            {
                                                "example_id": "79d0f50c-d263-4cdc-a288-4579023b77c1",
                                                "sense_id": "8c9e0c59-1d84-3417-babd-3f87ae5affa1",
                                                "text": "[W]hen man ſigheth, (as the Apoſtle ſaith) as burthened vvith inviſcerate intereſts, longing to put on this pure ſpirituall veſture of Filiall love, this kind of heavineſſe of ſpirit, may be ſaid to make his love vveight in heaven; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc32e0b5-3f74-3d5a-b4f2-088ec8a0b727",
                                        "entry_id": "7e66c4d4-bec5-3e5e-8a2f-ecf3396924c2",
                                        "glosses": [
                                            "Drowsiness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8ed79b-6f85-4f2e-8038-ee9248683dbb",
                                                "sense_id": "fc32e0b5-3f74-3d5a-b4f2-088ec8a0b727",
                                                "text": "The ſtrangeneſs of your ſtory put / Heavineſs in me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
