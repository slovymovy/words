                        "glosses": [
                            "het overdag dromen; het wakend dromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1104067-1e50-4db0-b536-a5f21ecfa5b6",
                                "sense_id": "c6b5b4c5-8eca-3e29-8840-9184132a63dc",
                                "text": "Misschien kon ze haar nagels laten groeien en ze mooi ovaal vijlen. Bij tijd en wijle stond ze zichzelf dagdromerij toe, al viel dat niet mee als ze intussen de vloer dweilde en de ruwe planken haar knieën schaafden."
                            },
                            {
                                "example_id": "c36c24f3-6317-4641-a0ec-f291c4d670f6",
                                "sense_id": "c6b5b4c5-8eca-3e29-8840-9184132a63dc",
                                "text": "De presentator groeide op in Twente, waar het Enschedese Volksparkcircus hem inspireerde, maar waar hij zich als ironicus niet begrepen voelde. Vanwege zijn dagdromerij werd hij van de middelbare school in Hengelo afgehaald en naar de kostschool in Oldenzaal gestuurd."
                            }
                        ]
                    }
