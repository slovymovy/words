        "fr-extract.jsonl": [
            {
                "entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                "word": "formulation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "31419c5c-ec62-4f39-ac2c-255c5ceac397",
                        "entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                        "tags": [
                            "plural"
                        ],
                        "form": "formulations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddbd5809-4c5d-3b55-9caf-20c3c50ec6e8",
                        "entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                        "glosses": [
                            "Action de formuler, de mettre en forme ou en mots ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c6504a-b356-45d7-aaa7-83c812c92c8e",
                                "sense_id": "ddbd5809-4c5d-3b55-9caf-20c3c50ec6e8",
                                "text": "La foule se retire peu à peu du cimetière, et il reste seul dans le grand silence intérieur face à l’appel emmuré des siens, insensible aux tapes amicales qui empoignent maladroitement son épaule, aux mots d’encouragement qui se résument pour la plupart, devant la vanité des paroles, à la formulation de son prénom."
                            },
                            {
                                "example_id": "cfb05bbd-f14c-4d9a-aa70-5100188641a3",
                                "sense_id": "ddbd5809-4c5d-3b55-9caf-20c3c50ec6e8",
                                "text": "Je passai les heures qui suivirent à rédiger des missives à ce joueur de golf. Monsieur Saito rythmait ma production en la déchirant, sans autre commentaire que ce cri qui devait être un refrain. Il fallait à chaque fois inventer une formulation nouvelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "b57bfd2a-924b-3e2a-8c4a-66a84973072d",
                        "entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                        "glosses": [
                            "Mise au point de produits sous forme de mélange dont chaque élément a une fonction sans qu'ils ne réagissent chimiquement entre eux ; le contenu de ce mélange."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3dcdb2b3-ede2-4f48-a56d-de5e056fbe00",
                                "sense_id": "b57bfd2a-924b-3e2a-8c4a-66a84973072d",
                                "text": "Certains constructeurs comme Amazone proposent, avec leurs épandeurs, un livret où figurent les résultats d’essais obtenus avec la plupart des engrais commercialisés. Deux engrais, de même formulation, ne sont jamais identiques."
                            },
                            {
                                "example_id": "e268948d-0b12-40c2-9c2f-dc9c0016e10d",
                                "sense_id": "b57bfd2a-924b-3e2a-8c4a-66a84973072d",
                                "text": "L’association entre les pâtes optimisées et un squelette granulaire dont la demande en eau a été définie permet la formulation de bétons autoplaçants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fac18146-36b4-427e-b7b5-cafb2533bc12",
                        "source_entry_id": "e7e7b4e6-c06c-3423-ba49-5d4481765cb7",
                        "target_lang_word": "Formulierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Formulierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                        "entry_id": "243d3f7a-591f-35da-b1b8-8c85b9146d53",
                                        "glosses": [
                                            "eine bewusst gewählte Zusammenstellung von Wörtern, um einen bestimmten Gedankeninhalt auszudrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43a1bb20-a175-40d0-bb2f-35b8c6432df9",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "Die Formulierung eines guten Bewerbungsschreibens bereitet vielen Leuten Schwierigkeiten."
                                            },
                                            {
                                                "example_id": "9dad02bc-53ad-4d06-a2c1-eb65b3a91810",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Wie viel von all diesen Formulierungen ihm selber einfielen und wie viel ihm die Kommunisten ins Papier schrieben, ist heute nicht mehr auszumachen.“"
                                            },
                                            {
                                                "example_id": "694ffd41-95ec-4ee3-915a-095e94411009",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Wenn du als Besucher deinen Blick über die Wände der ägyptischen Tempel wandern lässt, wirst du sehr bald auf zahlreiche Beispiele dieser Formulierung stoßen.“"
                                            },
                                            {
                                                "example_id": "8bfeb171-f913-4995-8978-726619fffef7",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Solche sehr suggestiv vorgebrachten, sich wiederholenden Formulierungen ließen sogar einige nationalistische Kritiker den Roman über das Leben in den Schützengräben preisen.“"
                                            },
                                            {
                                                "example_id": "fcbdf01c-e9a2-468e-bba7-55c7e51d4cde",
                                                "sense_id": "bee0c17a-dac7-3967-b81d-59922174fd38",
                                                "text": "„Damit die Formulierung nicht so großformatig daherkommt, sei sie erläutert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbaea1ea-c93a-371b-954a-5898b2104c83",
                                        "entry_id": "243d3f7a-591f-35da-b1b8-8c85b9146d53",
                                        "glosses": [
                                            "eine spezielle Zusammenstellung von chemischen oder pharmazeutischen Komponenten, um ein Medikament mit einer genau definierten pharmazeutischen Wirkung zu erstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd036f6-a110-4fff-b6c0-29a76ab661fe",
                                                "sense_id": "dbaea1ea-c93a-371b-954a-5898b2104c83",
                                                "text": "Auf Grund seiner speziellen Formulierung tritt die Wirkung des neuen Medikaments bereits wenige Minuten nach seiner Einnahme ein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
