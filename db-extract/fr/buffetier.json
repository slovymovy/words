                        "glosses": [
                            "Personne qui tient un buffet de gare. ^([1])"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0691e23d-f6b8-4275-a248-331b85c74e4d",
                                "sense_id": "840a92bb-2688-35f6-9348-9d6d143fdf2f",
                                "text": "La cafetière a été remplie par le buffetier mystique à l’aide d’un caoutchouc d’irrigation et le caoutchouc a été déroulé et enroulé lentement comme un emblème par des mains maniérées."
                            },
                            {
                                "example_id": "aa767299-9387-41ea-8abd-55e67390dc74",
                                "sense_id": "840a92bb-2688-35f6-9348-9d6d143fdf2f",
                                "text": "Le buffetier posa son livre, se leva, s’étira par-dessus le comptoir et me détailla morceau par morceau de son regard coupant comme une scie."
                            }
                        ]
                    }
