                            {
                                "example_id": "7a846571-12c4-4c6a-ba51-7aaad8710666",
                                "sense_id": "1c6d42ad-f1be-3ea2-b379-2bac56a2de2b",
                                "text": "Wahlen in repressiv regierten Ländern zeichnen sich häufig durch Wahlbestechung und Wahlverhinderung aus."
                            },
                            {
                                "example_id": "b28cf487-2b3f-48b2-87ac-f80ecf287b9b",
                                "sense_id": "1c6d42ad-f1be-3ea2-b379-2bac56a2de2b",
                                "text": "„Wahlbestechungen wurden ein gängiges Mittel der Politik, und gegen Ende des 2. Jahrhunderts v.Chr. setzte eine erfolgreiche politische Laufbahn nicht mehr ausschließlich die Zugehörigkeit zur Nobilität und persönliche Leistung voraus, sondern vor allem große Geldmittel.“"
                            }
