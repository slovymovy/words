                "senses": [
                    {
                        "sense_id": "3363d508-480d-3d06-82ea-b3ed261aa9db",
                        "entry_id": "a7acc3b2-0792-3c42-a867-119278c8213b",
                        "glosses": [
                            "großer Einrichtungsgegenstand aus Polymer"
                        ],
                        "tags": [
                            "Singular ungebräuchlich"
                        ],
                        "examples": [
                            {
                                "example_id": "09180995-0c09-4a23-9220-939e044a8a53",
                                "sense_id": "3363d508-480d-3d06-82ea-b3ed261aa9db",
                                "text": "„Das Angebot im Bereich der Plastikmöbel ist größer, als man vielleicht vermuten möchte.“"
                            },
                            {
                                "example_id": "d5369b71-2345-4c72-907b-f9d91731f926",
                                "sense_id": "3363d508-480d-3d06-82ea-b3ed261aa9db",
                                "text": "„Der italienische Hersteller von ästhetischen, zweckmäßigen und originellen Plastikmöbeln präsentiert seit 1949 Plastik in einer noch nie dagewesenen Form.“"
                            },
                            {
                                "example_id": "c990f7f3-6744-4101-a4b8-eb30953d0e96",
                                "sense_id": "3363d508-480d-3d06-82ea-b3ed261aa9db",
                                "text": "„Die 60er Jahre waren nicht nur die Geburtsstunde der aufblasbaren Möbel, auch die poppigen Plastikmöbel kamen damals auf den Markt und fanden großen Anklang bei jungen Leuten.“"
                            },
                            {
                                "example_id": "bb3bdb77-bcc1-4de8-8beb-5a5504d71b35",
                                "sense_id": "3363d508-480d-3d06-82ea-b3ed261aa9db",
                                "text": "„Calvia auf Mallorca verbietet Plastikmöbel auf den Terrassen von Restaurants und Kneipen, um das Erscheinungsbild der Gemeinde zu ihr gehören auch Paguera, Santa Ponsa, Palmanova, Portals Nous und Illetas zu verschönern.“"
                            },
                            {
                                "example_id": "50c60568-e5c7-4877-ad4d-9988709d98d6",
                                "sense_id": "3363d508-480d-3d06-82ea-b3ed261aa9db",
                                "text": "Zur Ausstattung gehörten neue, wenn auch wenig zum Gesamteindruck passende weiße Plastikmöbel, solche, wie es sie auch in jedem deutschen Baumarkt zu kaufen gibt, und einige Ventilatoren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
