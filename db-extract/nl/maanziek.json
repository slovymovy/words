                        "sense_id": "dacab041-e2a6-38c6-b417-c14b2bee4788",
                        "entry_id": "f13da2a0-4093-3f6a-93db-1c89ff06defb",
                        "glosses": [
                            "lijdend aan de -nu niet meer erkende- maanziekte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac91764d-9fcc-42be-b46b-eea8436ae21c",
                                "sense_id": "dacab041-e2a6-38c6-b417-c14b2bee4788",
                                "text": "Men gaf maanzieke mensen wel knolselderij te eten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d5cdb75-92a5-487c-ade1-1b96bbf1525b",
                        "source_entry_id": "f13da2a0-4093-3f6a-93db-1c89ff06defb",
                        "source_sense_id": "dacab041-e2a6-38c6-b417-c14b2bee4788",
                        "target_lang_word": "lunatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lunatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                        "entry_id": "29f24dfb-f140-381c-aa6a-1256444accb6",
                                        "glosses": [
                                            "An insane person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e21d48-4081-43e4-80b0-2da56e7f1854",
                                                "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                                "text": "While there are other races (or individuals—heaven forgive me, I am no ethnologist) who think you a criminal or a lunatic unless you carefully plod along from step to step like a hippopotamus out of water."
                                            },
                                            {
                                                "example_id": "c0fdf044-75e6-4630-ae89-61c6bbe7b650",
                                                "sense_id": "66cc7b45-0a65-3a56-a19a-1e193df4699c",
                                                "text": "You may be right\nI may be crazy\nOh, but it just may be a lunatic you're looking for"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lunatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "919627e7-ffdf-3c9b-9feb-09f4e64839a4",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Crazed, mad, insane, demented."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Relating to the Moon; lunar."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2370c0cf-bde5-4ceb-bdfa-47f5e8c518cd",
                                                "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                                "text": "As the narrator turns his attention to the moon itself and its Lunatic inhabitants, Heinsius seems to draw on the True History, but is still within the confines of the Icaromenippus."
                                            },
                                            {
                                                "example_id": "70da88a6-946f-4697-8477-726284e1d8be",
                                                "sense_id": "16374634-d0a4-366a-b264-8fa869df9a61",
                                                "text": "That or I might bounce off something I hit and head back out into space, become the light in the eye of some lunatic observer, looking up at the big blue ball and seeing me bang something in their retina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3992182-e050-3ccb-acfc-94a759da2e04",
                                        "entry_id": "d228d122-5c94-3581-8421-54907168dfef",
                                        "glosses": [
                                            "Influenced or affected by the Moon."
                                        ],
                                        "tags": [
                                            "literary",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd31f492-2b86-4c36-a76a-c0e1d49c3151",
                                                "sense_id": "b3992182-e050-3ccb-acfc-94a759da2e04",
                                                "text": "This I remember: she was false as the lunatic sea."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "528d4877-57cb-40b1-8084-f31a4f6b0486",
                        "source_entry_id": "f13da2a0-4093-3f6a-93db-1c89ff06defb",
                        "source_sense_id": "dacab041-e2a6-38c6-b417-c14b2bee4788",
