                                                "example_id": "a0d0db9a-788c-4f4d-9ca5-9d8b20925d94",
                                                "sense_id": "5118f73a-dd2a-356a-9427-f37793d8b6e7",
                                                "text": "Datteln sind in Nordafrika der klassische Reiseproviant."
                                            },
                                            {
                                                "example_id": "7f0ad621-3a40-4885-b27d-ed8f844e48d3",
                                                "sense_id": "5118f73a-dd2a-356a-9427-f37793d8b6e7",
                                                "text": "„Jetzt durfte ich die Dattel in den Mund nehmen, aber kauen noch nicht.“"
                                            },
                                            {
                                                "example_id": "fd0dc7d1-08bd-4219-97d3-b6963564f92d",
                                                "sense_id": "5118f73a-dd2a-356a-9427-f37793d8b6e7",
                                                "text": "„Er entdeckte auf dem Cembalo zehn oder zwölf Datteln und aß sie auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
