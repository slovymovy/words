                "senses": [
                    {
                        "sense_id": "bb9013d4-1301-34bf-b360-903fff0060d3",
                        "entry_id": "178738aa-8c44-31c7-8650-9d8a9b84bddb",
                        "glosses": [
                            "in direkter Nähe zum Eingang befindlicher Parkplatz bei einem Krankenhaus für werdende Eltern im Falle einer unmittelbar bevorstehenden Entbindung"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e426246e-8a64-4081-862b-d3a2af650fb7",
                                "sense_id": "bb9013d4-1301-34bf-b360-903fff0060d3",
                                "text": "„Auch wenn rund um das Krankenhaus genügend Parkplätze vorhanden sind, stellt der Storchenparkplatz gerade tagsüber eine echte Erleichterung dar.“"
                            },
                            {
                                "example_id": "a105e24f-7e48-4327-ab9f-afbedd596781",
                                "sense_id": "bb9013d4-1301-34bf-b360-903fff0060d3",
                                "text": "„Machmal zählt jede Minute bei der Geburt eines Kindes. […] Aus diesem Grund wurde jetzt im Eingangsbereich der Ilm-Kreis-Klinik am Standort in Arnstadt ein Storchenparkplatz eingerichtet.“"
                            },
                            {
                                "example_id": "58712e1b-bbe0-43fe-a1a0-85c5a8071304",
                                "sense_id": "bb9013d4-1301-34bf-b360-903fff0060d3",
                                "text": "„Vom Storchenparkplatz bis zum Kreißsaal ist es nur noch ein Katzensprung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
