                                        "sense_id": "375d10a6-ec8e-3140-b2a4-9cf1affd2734",
                                        "entry_id": "27f6dc65-8441-3f54-a4dc-08e3b7089757",
                                        "glosses": [
                                            "Le plancher supérieur, le plafond."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621bcd34-f957-4aca-9a3d-ad530ec33c55",
                                                "sense_id": "375d10a6-ec8e-3140-b2a4-9cf1affd2734",
                                                "text": "Peindre les solives d’un plancher."
                                            },
