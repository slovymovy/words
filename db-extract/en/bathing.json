                                        "sense_id": "fdc37fa9-302c-306f-b8d3-ff0356baaf86",
                                        "entry_id": "70cbb6b0-49c0-325b-aeb0-9f69087cf13a",
                                        "glosses": [
                                            "Action de se baigner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcb9897b-efe7-4621-861c-a2ba581e2f7d",
                                                "sense_id": "fdc37fa9-302c-306f-b8d3-ff0356baaf86",
                                                "text": "Voici le Madon, affluent de la Moselle, dont les eaux limoneuses invitent peu à la baignade, malgré la grande chaleur."
                                            },
                                            {
                                                "example_id": "70787982-44b3-48bc-a694-0500c43a03f6",
                                                "sense_id": "fdc37fa9-302c-306f-b8d3-ff0356baaf86",
                                                "text": "Il fit allusion coup sur coup au pont passerelle qui reliait jadis les deux rives, les parties de pêche, les baignades dans la rivière où l'on se « baquait à poil, les étés de plein cagnard »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90b2030a-eb58-4948-870f-873e442b66e1",
                        "source_entry_id": "1473c6c8-1931-3dab-ae34-57dbf1e9bd81",
