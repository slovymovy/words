                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "release_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом году университет смог <выпустить> триста молодых специалистов.",
                            "target_lang_translations": {
