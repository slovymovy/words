                                    {
                                        "sense_id": "2618d168-648d-3d76-97f6-345a916d8c6b",
                                        "entry_id": "7ea54b67-e3d9-31b1-ad71-3c09a709bac5",
                                        "glosses": [
                                            "Any of certain marine bivalve mollusks, especially those of the family Ostreidae (the true oysters), usually found adhering to rocks or other fixed objects in shallow water along the seacoasts, or in brackish water in the mouth of rivers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd02020-4c22-487e-964e-f1c46c1240a4",
                                                "sense_id": "2618d168-648d-3d76-97f6-345a916d8c6b",
                                                "text": "Piſt. Why then the world's mine Oyſter, which I, with ſword will open."
                                            },
                                            {
                                                "example_id": "6768d9e8-a994-4a53-8aa9-9db2a8ff440c",
                                                "sense_id": "2618d168-648d-3d76-97f6-345a916d8c6b",
                                                "text": "He was a bold man that first ate an oyster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc21aea2-e130-3054-a22d-f49393b5a0e3",
                                        "entry_id": "7ea54b67-e3d9-31b1-ad71-3c09a709bac5",
                                        "glosses": [
                                            "The delicate oyster-shaped morsel of dark meat contained in a small cavity of the bone on each side of the lower part of the back of a fowl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b1c65f-83f1-4cdf-84d0-a67ec8198780",
                                                "sense_id": "fc21aea2-e130-3054-a22d-f49393b5a0e3",
                                                "text": "Cut remaining skin on back. Remove the oyster (choice dark meat in spoon-shaped bone on back) with the leg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c39f2c4-1db3-37bd-9c6a-3aa94c66c5b2",
                                        "entry_id": "7ea54b67-e3d9-31b1-ad71-3c09a709bac5",
                                        "glosses": [
                                            "A pale beige color tinted with grey or pink, like that of an oyster."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97eda3aa-6579-3aff-983d-7aa62cdbc36e",
                                        "entry_id": "7ea54b67-e3d9-31b1-ad71-3c09a709bac5",
                                        "glosses": [
                                            "A person who keeps secrets."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceaeb1f9-6ab0-4520-9cc0-fdae4e4dc025",
                                                "sense_id": "97eda3aa-6579-3aff-983d-7aa62cdbc36e",
                                                "text": "Hard and sharp as flint, from which no steel had ever struck out generous fire; secret, and self-contained, and solitary as an oyster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d1b1456-bd12-34ba-9713-d4bebbd718fc",
                                        "entry_id": "7ea54b67-e3d9-31b1-ad71-3c09a709bac5",
                                        "glosses": [
                                            "Something at one's disposal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c249eddf-33e2-4c27-a923-c4f1e29d0f4a",
                                                "sense_id": "4d1b1456-bd12-34ba-9713-d4bebbd718fc",
                                                "text": "He asked a major Chicago retailer with a large store in the heart of the city about the socioeconomic character of his customers. The man replied proudly that the entire range of economic classes was his oyster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31a03ac-4d57-3160-8e53-97a4e0f4ed47",
                                        "entry_id": "7ea54b67-e3d9-31b1-ad71-3c09a709bac5",
                                        "glosses": [
                                            "A shoplifter."
