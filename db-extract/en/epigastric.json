                    {
                        "translation_id": "81ff0f7a-2477-474c-bfd4-5df74ae2425c",
                        "source_entry_id": "08241168-42b8-3307-b845-d8780060e6d2",
                        "source_sense_id": "06ae3c6e-208b-3e33-a3bf-552c0d6c9194",
                        "source_sense_description": "of or pertaining to the epigastrium",
                        "target_lang_word": "epigastrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epigastrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                        "entry_id": "6b96e72f-9f1c-34b4-9bfd-f7150ba05e40",
                                        "glosses": [
                                            "den Oberbauch betreffend, im Oberbauch liegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca43c667-4cb7-47b3-a88d-2b35cbb2f2ba",
                                                "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                                "text": "„Epigastrische Hernien resultieren aus einer Faszienschwäche im Bereich der Linea alba kranial des Nabels gelegen.“"
                                            },
                                            {
                                                "example_id": "beab69d0-8413-49f9-ab6b-9c47f52222b0",
                                                "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                                "text": "„Epigastrisch besteht ein leichter Druckschmerz. Der Spontanschmerz beim Sodbrennen liegt ebenfalls epigastrisch und zieht hinter dem Brustbein hoch.“"
                                            },
                                            {
                                                "example_id": "27ce3be9-07b1-4902-a23b-c655f0176432",
                                                "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                                "text": "„Der Thorax ist überbläht und die heftigen Atemanstrengungen führen zu Einziehungen (intercostal, jugulär, epigastrisch) bei der Einatmung.“"
                                            },
                                            {
                                                "example_id": "3011a46e-b770-49ac-9896-a30832828caf",
                                                "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                                "text": "„Wir führten 4 Behandlungen von Manualmedizin in der epigastrischen und hypogastrischen Region durch ; die Bauchschmerzen, die Dysmenorrhö und die Nervosität verschwanden.“"
                                            },
                                            {
                                                "example_id": "853f28eb-31ee-47a4-a491-9f27caa5e37c",
                                                "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                                "text": "epigastrisch, im Oberbauch gelegen."
                                            },
                                            {
                                                "example_id": "38e59010-3bc1-4962-84b5-1f831f297e3d",
                                                "sense_id": "85babdbc-510e-3f72-8d42-f51011251376",
                                                "text": "Epigastrische Hernie - Eine Hernie in der Mittellinie zwischen Schwertfortsatz und Nabel wird als epigastrische Hernie bezeichnet. Diese sind oft klein und werden deswegen trotz entsprechender Beschwerden gelegentlich verzögert diagnostiziert."
                                            }
                                        ],
