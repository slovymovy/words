                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a11c50a-62ea-4fd6-bae2-f923d679e738",
                                "sense_id": "ba4bcdf8-a901-327d-8b0d-a5ce3083d8e0",
                                "text": "„Als Thomas den Saal betrat, glaubte er, im Raum nur Schattengestalten zu sehen.“"
                            },
                            {
                                "example_id": "ec2b670c-cc55-4030-8de1-9c2573815fd4",
                                "sense_id": "ba4bcdf8-a901-327d-8b0d-a5ce3083d8e0",
                                "text": "„Aus verkohlt zuhaufgestürzten Trümmern zuckte es noch in kleinen gespenstigen Flammen; unter den weithin webenden Schwaden von Schweldunst bewegten sich die Schattengestalten beutender Indianer.“"
                            }
