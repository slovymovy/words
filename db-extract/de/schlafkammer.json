                ],
                "senses": [
                    {
                        "sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                        "entry_id": "49376d8b-c11b-359b-912a-7ce8fa61acb8",
                        "glosses": [
                            "kleiner Raum, der zum Schlafen bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a768d57-81e5-4944-b2f9-a2ffd90101ba",
                                "sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                                "text": "„Anfangs schlief er gemeinsam mit den anderen in der Schlafkammer, als Toko aber sah, wie unangenehm dem weißen Mann ihre unmittelbare Nachbarschaft war, teilte er im Tschottagin einen kleinen Verschlag für ihn ab, ein Mittelding zwischen Hundehütte und Kammer.“"
                            },
                            {
                                "example_id": "48f91ca7-425c-41cb-a561-21087ae19ea7",
                                "sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                                "text": "„Mahorka war für mich Heimat, ich war in einer Großfamilie aufgewachsen, neun Personen in einer Küche und einer unbeheizbaren Schlafkammer, die Wände im Winter vereist und nur in der Küche ein Ofen.“"
                            },
                            {
                                "example_id": "8ae1ea14-33da-4db1-ab7a-3a375907d1f1",
                                "sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                                "text": "„Sie hatte Glück und stieg in die frühere Schlafkammer der Jungen ein.“"
                            },
                            {
                                "example_id": "717d6dc9-fc13-421e-989f-0c0dbefa67d1",
                                "sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                                "text": "„Während sie dann der Gattin des Magisters Schang dasselbe erwies, verließ Frau Mondtraut ihren Sitz und begab sich in die hintere Schlafkammer, um das Kleid zu wechseln und den Puder im Antlitze neu aufzutragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "461cc0a5-1b31-4b6a-9562-e41fd1301387",
                        "source_entry_id": "49376d8b-c11b-359b-912a-7ce8fa61acb8",
                        "source_sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                        "source_sense_description": "kleiner Raum, der zum Schlafen bestimmt ist",
                        "target_lang_word": "chambre à coucher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambre à coucher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5597dfe9-a32f-32cd-8b09-bbfea288b267",
                                        "entry_id": "1fb6fff7-e89e-36a4-9cbf-d701a30fcf89",
                                        "glosses": [
                                            "Pièce d’une habitation utilisée pour dormir, pour une personne ou peu de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bbd9628-2b4a-462c-9c4c-a41568a95e6d",
                                                "sense_id": "5597dfe9-a32f-32cd-8b09-bbfea288b267",
                                                "text": "La cuisine est adossée à la salle à manger, et le salon est doublé d’un cabinet qui servait alors de chambre à coucher à monsieur et à madame Dumay."
                                            },
                                            {
                                                "example_id": "123325c3-808e-46e9-8680-dc3707030dab",
                                                "sense_id": "5597dfe9-a32f-32cd-8b09-bbfea288b267",
                                                "text": "L’armoire en noyer, le lit à colonnes et à bonnes-grâces, ornements de la chambre à coucher, furent sans doute le fruit de quelque risette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1f002c4-8819-45e3-bb0c-8f1dc06c76db",
                        "source_entry_id": "49376d8b-c11b-359b-912a-7ce8fa61acb8",
                        "source_sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                        "source_sense_description": "kleiner Raum, der zum Schlafen bestimmt ist",
                        "target_lang_word": "спальня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "спальня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "744d557d-5660-364c-a448-e11a8e06d56d",
                                        "entry_id": "7f0aa5ea-c288-3075-906e-073b8cd9f30c",
                                        "glosses": [
                                            "комната, предназначенная для сна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4702b15-7c5c-4c5c-9f81-60d6588d6af4",
                                                "sense_id": "744d557d-5660-364c-a448-e11a8e06d56d",
                                                "text": "Стёпа наконец узнал трюмо и понял, что он лежит навзничь у себя на кровати, то есть на бывшей ювелиршиной кровати, в спальне."
                                            },
                                            {
                                                "example_id": "5b5bb1ac-59b7-4ba3-a2fa-1a427ffe5129",
                                                "sense_id": "744d557d-5660-364c-a448-e11a8e06d56d",
                                                "text": "Следите, чтобы в спальне было прохладно: в духоте полноценно спать невозможно. Не смотрите телевизор и, ни в коем случае, не работайте в постели. Оставьте спальню для сна и секса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "febddc33-22a9-3168-8148-8bbdd7cdb488",
                                        "entry_id": "7f0aa5ea-c288-3075-906e-073b8cd9f30c",
                                        "glosses": [
                                            "набор мебели, предназначенный для спальни [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03bbc857-bd3a-46d8-b0b8-559159e777b3",
                                                "sense_id": "febddc33-22a9-3168-8148-8bbdd7cdb488",
                                                "text": "Бродим по квартирам, купили кабинет для Бориса, спальню, гостиную."
                                            },
                                            {
                                                "example_id": "0f8d6312-3446-4d16-a046-4e6012875f4b",
                                                "sense_id": "febddc33-22a9-3168-8148-8bbdd7cdb488",
                                                "text": "При энергичном же прессинге родители могут купить и специальный барбиевский автомобиль, и джакузи, и спальню, и даже целый дом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a62204-c15c-3e0f-8700-e0e32a9c4056",
                                        "entry_id": "7f0aa5ea-c288-3075-906e-073b8cd9f30c",
                                        "glosses": [
                                            "перен. то же, что секс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2e4d0a-effb-4eb2-9433-c685832e84d4",
                                                "sense_id": "20a62204-c15c-3e0f-8700-e0e32a9c4056",
                                                "text": "Несложная фабула фривольного французского фарса (муж в поисках любовника жены заставляет ее пропустить через спальню всех мужчин села), переложенная на партитуру движений, оказалась исполненной веселья и очарования."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dae055b3-3f22-4849-add5-967fe8472492",
                        "source_entry_id": "49376d8b-c11b-359b-912a-7ce8fa61acb8",
                        "source_sense_id": "c47c999e-c2c4-355e-901c-95c9ddccede2",
                        "source_sense_description": "kleiner Raum, der zum Schlafen bestimmt ist",
                        "target_lang_word": "опочивальня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "опочивальня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c311c7ee-3b9e-339b-bfd0-551659a98b6b",
                                        "entry_id": "bb3d2cbf-61e6-325b-870f-e3ddc59c3817",
                                        "glosses": [
                                            "устар. или высок. то же, что спальня (обычно в дворцах, хоромах и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f537e2-361b-4554-a716-801b1f21347c",
                                                "sense_id": "c311c7ee-3b9e-339b-bfd0-551659a98b6b",
                                                "text": "И чудится пану Даниле (тут он стал щупать себя за усы, не спит ли), что уже не небо в светлице, а его собственная опочивальня: висят на стене его татарские и турецкие сабли; около стен полки, на полках домашняя посуда и утварь; на столе хлеб и соль; висит люлька…"
                                            },
                                            {
                                                "example_id": "689a54e4-351d-4486-8005-fe276fedf26f",
                                                "sense_id": "c311c7ee-3b9e-339b-bfd0-551659a98b6b",
                                                "text": "Я невольно поёжилась, в таком зале крайне неуютно и даже страшно, мне по душе старомосковская архитектура: небольшие, даже маленькие спаленки. // — Признайтесь! — вдохновенно воскликнула Инга Федоровна. — У вашей хозяйки не такая роскошная опочивальня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "484760af-5d5b-4f8a-ad40-9c8537928b7b",
                        "source_entry_id": "49376d8b-c11b-359b-912a-7ce8fa61acb8",
