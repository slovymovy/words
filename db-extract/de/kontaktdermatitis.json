                "senses": [
                    {
                        "sense_id": "f3af33e5-793b-3b0b-951c-2cba01e4001a",
                        "entry_id": "d1e35af5-e88e-3074-a376-dda2a5be262f",
                        "glosses": [
                            "Entzündung der Haut als Folge eines Kontaktes mit hautschädigenden Stoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3a10992-e4a5-4210-947c-b45699e8ce45",
                                "sense_id": "f3af33e5-793b-3b0b-951c-2cba01e4001a",
                                "text": "Es [Tetryl] reizt die Atemwege und verursacht Sensibilisierung, Kontaktdermatitis und Gelbfärbung der Haut."
                            },
                            {
                                "example_id": "ac3d8b47-6bd7-409d-a323-798bf80f3ea4",
                                "sense_id": "f3af33e5-793b-3b0b-951c-2cba01e4001a",
                                "text": "Auch die Kamille wird immer wieder im Zusammenhang mit Kontaktdermatitiden genannt, aber aus heutiger wissenschaftlicher Sicht zu Unrecht: die vor vielen Jahren beobachteten Effekte sind nicht der Kamille, sondern einer unerlaubten Beimengung mit Hundskamille (Anthemis-Arten, z.B. A. cotula) zuzuschreiben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
