{
    "word_family": [
        "willen",
        "wil",
        "gewild",
        "onwil",
        "onwillig",
        "vrijwillig"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5486dea3-b34d-362b-a1d8-d710db66fd73",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>willen</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging_willen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat <w>wilt</w> u vanavond eten?",
                            "target_lang_translations": {
                                "ru": "Что вы <w>хотите</w> съесть сегодня вечером?"
                            }
                        },
                        {
                            "text": "Als je met ons mee naar de film <w>wilt</w>, moet je dat nu zeggen.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>хочешь</w> пойти с нами в кино, тебе нужно сказать об этом сейчас."
                            }
                        }
                    ],
                    "synonyms": [
                        "wil"
                    ],
                    "common_phrases": [
                        "wat u wilt",
                        "als je wilt"
                    ],
                    "target_lang_definitions": {
                        "ru": "форма второго лица единственного числа настоящего времени от глагола willen (хотеть, желать)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хочешь",
                                "target_lang_sense_clarification": "при обращении на «ты» (je/jij)"
                            },
                            {
                                "target_lang_word": "хотите",
                                "target_lang_sense_clarification": "при вежливом обращении на «вы» (u)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7b3636f-297a-3401-ba2b-d211bb96a058",
                    "sense_definition": "derde persoon enkelvoud tegenwoordige tijd van <w>willen</w>",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging_willen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>wilt</w> altijd zijn eigen zin doordrijven.",
                            "target_lang_translations": {
                                "ru": "Он всегда <w>хочет</w> настоять на своём."
                            }
                        },
                        {
                            "text": "Iedereen die dat <w>wilt</w>, kan zich gewoon aanmelden.",
                            "target_lang_translations": {
                                "ru": "Каждый, кто этого <w>хочет</w>, может просто записаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "wil"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "niet-standaardvorm in plaats van wil"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нестандартная просторечная форма третьего лица единственного числа от глагола willen (вместо wil)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хочет",
                                "target_lang_sense_clarification": "он/она/оно хочет (разг.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4a48476-819e-3b4a-aa26-aac73f9eac45",
                    "sense_definition": "tweede persoon tegenwoordige tijd met gij van <w>willen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging_willen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als gij dat echt <w>wilt</w>, moet ge daar nu voor kiezen.",
                            "target_lang_translations": {
                                "ru": "Если ты правда этого <w>хочешь</w>, тебе нужно сделать этот выбор прямо сейчас."
                            }
                        },
                        {
                            "text": "Gij <w>wilt</w> altijd precies weten wat er gaat gebeuren.",
                            "target_lang_translations": {
                                "ru": "Ты всегда <w>хочешь</w> точно знать, что произойдёт."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in Vlaanderen en het zuiden van Nederland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "форма второго лица настоящего времени с местоимением gij/ge глагола willen (хотеть)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хочешь",
                                "target_lang_sense_clarification": "региональное (Фландрия, юг Нидерландов)"
                            },
                            {
                                "target_lang_word": "хотите",
                                "target_lang_sense_clarification": "региональное/устаревшее обращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4fce15e-72e8-363e-9f3c-09eb9889b4f3",
                    "sense_definition": "gebiedende wijs meervoud van <w>willen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging_willen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wilt</w> toch luisteren naar wat de meester vertelt!",
                            "target_lang_translations": {
                                "ru": "<w>Извольте</w> же послушать то, что говорит учитель!"
                            }
                        },
                        {
                            "text": "<w>Wilt</w> niet wanhopen in deze moeilijke tijden.",
                            "target_lang_translations": {
                                "ru": "Не <w>вздумайте</w> отчаиваться в эти трудные времена."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderde meervoudige imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшая форма повелительного наклонения множественного числа от глагола willen"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соизвольте",
                                "target_lang_sense_clarification": "устар., высок."
                            },
                            {
                                "target_lang_word": "извольте",
                                "target_lang_sense_clarification": "устар., побуждение"
                            },
                            {
                                "target_lang_word": "пожелайте",
                                "target_lang_sense_clarification": "повелительное наклонение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}