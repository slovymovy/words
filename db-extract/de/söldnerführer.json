                "senses": [
                    {
                        "sense_id": "19e0e00e-a107-3ab4-919a-329fbfbc4774",
                        "entry_id": "79f514f6-56d1-361e-822c-6a4cb1277bd5",
                        "glosses": [
                            "Anführer einer Söldnertruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c649acfb-1e60-4ffa-b487-e04eed7d3b8f",
                                "sense_id": "19e0e00e-a107-3ab4-919a-329fbfbc4774",
                                "text": "„Er war einer der wenigen Söldnerführer, der seit über zwanzig Jahren im Geschäft war und noch immer lebte.“"
                            },
                            {
                                "example_id": "23715436-2660-441d-bf00-f82e0ef2bf2e",
                                "sense_id": "19e0e00e-a107-3ab4-919a-329fbfbc4774",
                                "text": "„Der Söldnerführer grinste nur, wobei er seinen gesamten Bestand an Goldzähnen entblößte.“"
                            },
                            {
                                "example_id": "7d5a52c0-d6c7-4619-9d58-dbc49fa20ae8",
                                "sense_id": "19e0e00e-a107-3ab4-919a-329fbfbc4774",
                                "text": "„Quintus wusste, dass der thrakische Söldnerführer eigentlich Iphikrates hieß, von allen aber nur Polyphem genannt wurde, weil er nur noch ein Auge besaß.“"
                            },
                            {
                                "example_id": "7e093519-6507-4983-bdc4-75848af8e375",
                                "sense_id": "19e0e00e-a107-3ab4-919a-329fbfbc4774",
                                "text": "„Genauso passierte es des Öfteren, dass ein Söldnerführer sich kurzerhand zum Tyrannen aufschwang und seine ehemaligen Auftraggeber unterdrückte.“"
                            },
                            {
                                "example_id": "3a18ad41-35e8-43a3-8531-d00d0ebb2951",
                                "sense_id": "19e0e00e-a107-3ab4-919a-329fbfbc4774",
                                "text": "„Besonders berüchtigt waren Söldnerführer aus Deutschland, Südfrankreich und Großbritannien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
