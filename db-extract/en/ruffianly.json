                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5edb787c-cbd3-43d3-83e4-58ba984729a6",
                                "sense_id": "e1729924-632b-397e-ade5-882b8c2423a5",
                                "text": "Joseph mumbled indistinctly in the depths of the cellar; but, gave no intimation of ascending; so, his master dived down to him, leaving me vis-à-vis the ruffianly bitch, and a pair of grim, shaggy sheep dogs, who shared with her a jealous guardianship over all my movements."
                            },
                            {
                                "example_id": "e2b649f8-2396-4e52-8856-d722b9c4544a",
                                "sense_id": "e1729924-632b-397e-ade5-882b8c2423a5",
                                "text": "One righteous man who reverences the Gods\nShall shipmate be with a ruffianly crew […]"
                            },
                            {
                                "example_id": "685693f9-ad62-46e4-8e87-c96cf7bdb94c",
                                "sense_id": "e1729924-632b-397e-ade5-882b8c2423a5",
                                "text": "By his side padded a big ruffianly collie, and he led by a string a miserable-looking terrier, at which the collie now and then snapped viciously."
                            }
                        ]
                    }
