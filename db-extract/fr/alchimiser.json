                ],
                "senses": [
                    {
                        "sense_id": "2364103d-9065-3629-973a-3516cc4a1715",
                        "entry_id": "29c31138-9d78-3500-99bb-a615f3dd621d",
                        "glosses": [
                            "Donner un caractère alchimique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1af2b6a-c11a-4bba-9898-a68251431115",
                                "sense_id": "2364103d-9065-3629-973a-3516cc4a1715",
                                "text": "C’est alchimiser l’immobilisme de la mémoire génétique pour libérer la mémoire galactique."
                            }
                        ]
                    },
                    {
                        "sense_id": "4df0a42a-f3de-3004-b121-491e10a005db",
                        "entry_id": "29c31138-9d78-3500-99bb-a615f3dd621d",
                        "glosses": [
                            "Transformer par alchimie, ou comme par alchimie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815de5af-87c2-4ce3-b1a5-907f3b90f31e",
                                "sense_id": "4df0a42a-f3de-3004-b121-491e10a005db",
                                "text": "Donc on peut dire qu’il y a eu perte de cette capacité d'alchimiser, de changer l’énergie."
                            },
                            {
                                "example_id": "6addb04b-5167-491d-a46a-6ee5f0e37c01",
                                "sense_id": "4df0a42a-f3de-3004-b121-491e10a005db",
                                "text": "N'est-ce pas nous, avant tout, que nous devons transformer et alchimiser ?"
                            },
                            {
                                "example_id": "11d7fdf2-ff2c-4f4a-bba8-f639480d4b00",
                                "sense_id": "4df0a42a-f3de-3004-b121-491e10a005db",
                                "text": "Tu chuchotes, tu distilles à droite, tu diffames à gauche, tu discrédites, tu suppures, tu dresses les uns contre les autres, tu doses, tu calcules, tu combines, tu alchimises et, quand le mélange est prêt, tu te fais élire."
                            }
                        ]
                    }
                ],
