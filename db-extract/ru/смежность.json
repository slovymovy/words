                                "target_senses": [
                                    {
                                        "sense_id": "4452409e-b657-38d9-841e-3643ce6761df",
                                        "entry_id": "73fb35db-0897-3186-8d52-b29dac26051f",
                                        "glosses": [
                                            "A state in which two or more physical objects are physically touching one another or in which sections of a plane border on one another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d88399f-4432-48f7-9ff9-77090378ef6b",
                                                "sense_id": "4452409e-b657-38d9-841e-3643ce6761df",
                                                "text": "In the mechanical conception of ‘cause’ it is…demanded that there should be spatial and temporal contiguity between the movements involved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68dcef4b-e50c-48fc-8429-13eb0aaacdb9",
                        "source_entry_id": "14bb945b-542a-3c8b-aa34-4bfde7ec1548",
                        "source_sense_id": "fac61c50-caa9-3ced-8216-b94f54185e75",
                        "target_lang_word": "adjacency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjacency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a2255c6-3f1f-38f1-8a0a-6a5bd2244a87",
                                        "entry_id": "c3b378b2-3d5e-3747-a0d1-698b6c9953eb",
                                        "glosses": [
                                            "The quality of being adjacent, or near enough so as to touch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebd6b1ce-8c1d-43bc-a713-af8f7a010c01",
                                                "sense_id": "9a2255c6-3f1f-38f1-8a0a-6a5bd2244a87",
                                                "text": "at that point the Needle conforms unto the true Meridian, and is not distracted by the vicinity of Adjacencies."
                                            },
                                            {
                                                "example_id": "0ce1d3d2-84d0-40c9-bb5a-49f9e311e5d2",
                                                "sense_id": "9a2255c6-3f1f-38f1-8a0a-6a5bd2244a87",
                                                "text": "“With the adjacencies for victims whose families wish them to be listed together,[…], this is an approach that I hope will be acceptable to the great majority of the families affected,” he said afterward."
                                            },
                                            {
                                                "example_id": "2b4a5b26-f836-472d-8c2a-d97339025e40",
                                                "sense_id": "9a2255c6-3f1f-38f1-8a0a-6a5bd2244a87",
                                                "text": "X gained a second wind last year when Mr. Trump won the election. Some advertisers, courted by Ms. Yaccarino, returned to the platform partly because of Mr. Musk’s adjacency to the president."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10186589-8315-3d64-914e-281e8e752ed7",
                                        "entry_id": "c3b378b2-3d5e-3747-a0d1-698b6c9953eb",
                                        "glosses": [
                                            "The programming directly before or after a commercial."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1098a616-3e78-4525-be02-92d6d16e4bb3",
                                                "sense_id": "10186589-8315-3d64-914e-281e8e752ed7",
                                                "text": "The maker of film commercials should be especially aware of the film standards published by the networks and adhere to them carefully, as the effectiveness of his commercial is greatly affected by its adjacencies. He may well give serious thought in his production planning to the problem caused by adjacent film which, in most cases, will not be under his control."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
