        "fr-extract.jsonl": [
            {
                "entry_id": "a209b02a-c3ba-312a-ad9c-53eb7c1daeae",
                "word": "redoux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fadcc479-7322-3090-90bb-12abc3d5a35d",
                        "entry_id": "a209b02a-c3ba-312a-ad9c-53eb7c1daeae",
                        "glosses": [
                            "Réchauffement, en parlant du temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed774e77-bfa1-46a6-85b3-471f3b003894",
                                "sense_id": "fadcc479-7322-3090-90bb-12abc3d5a35d",
                                "text": "Le redoux ensoleillé qui a enveloppé les régions du Québec ces derniers jours fera désormais partie du passé, laissant place à des températures saisonnières et une météo parfois capricieuse pour cette fin de semaine."
                            },
                            {
                                "example_id": "e500f2f6-8e0b-4e7a-822d-5add7fa4f3d4",
                                "sense_id": "fadcc479-7322-3090-90bb-12abc3d5a35d",
                                "text": "Temps humide, redoux… malheureusement pour les cultures de printemps, le climat printanier plaît aux limaces."
                            },
                            {
                                "example_id": "73af3f5b-a783-405e-9f24-a93dbd23c061",
                                "sense_id": "fadcc479-7322-3090-90bb-12abc3d5a35d",
                                "text": "Jusqu’au ciel, la neige avait substantialisé la matière, réinventé le réel, recréé le monde. Chaque hiver, même genèse. Et cette recomposition intégrale disparaîtrait en quelques heures de redoux."
                            }
                        ]
                    }
