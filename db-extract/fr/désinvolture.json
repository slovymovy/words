                                        "sense_id": "0b69534f-0fa1-3f8a-9655-cf868239f38b",
                                        "entry_id": "63258576-5847-3042-862b-95936fbbe3d7",
                                        "glosses": [
                                            "In an abrupt or unfriendly manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
