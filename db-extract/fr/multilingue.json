        "fr-extract.jsonl": [
            {
                "entry_id": "729846b2-1268-378e-93b0-aec69b019692",
                "word": "multilingue",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6f42c822-4d8d-4136-89a9-2e423a0b4ee7",
                        "entry_id": "729846b2-1268-378e-93b0-aec69b019692",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "multilingues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8d97132-45c6-3a19-b9fa-2e62ed5de2e1",
                        "entry_id": "729846b2-1268-378e-93b0-aec69b019692",
                        "glosses": [
                            "Qui traite un sujet dans plusieurs langues, généralement au moins trois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc12738-3cd5-479e-9c63-c489b879d760",
                                "sense_id": "c8d97132-45c6-3a19-b9fa-2e62ed5de2e1",
                                "text": "Une campagne de communication, élargie et multilingue, pourrait accompagner cette mesure."
                            },
                            {
                                "example_id": "eb67e03e-9224-4749-9228-bb0566eea13d",
                                "sense_id": "c8d97132-45c6-3a19-b9fa-2e62ed5de2e1",
                                "text": "Si vous êtes à la recherche de services communautaires pour vous soutenir en période difficile, le 211 Grand Montréal est un service multilingue en 200 langues sans but lucratif qui saura vous recommander les services sociaux de proximité et autres ressources de votre secteur."
                            },
                            {
                                "example_id": "c1a871ec-b5da-4108-9157-12f6fa8a8967",
                                "sense_id": "c8d97132-45c6-3a19-b9fa-2e62ed5de2e1",
                                "text": "Votre nouveau site Web sera multilingue, disponible au départ en français, en anglais, en allemand et en espagnol."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8697dd2-8c67-34cf-8bff-7231089b9294",
                        "entry_id": "729846b2-1268-378e-93b0-aec69b019692",
                        "glosses": [
                            "Qui est capable de s’exprimer dans plusieurs langues, généralement plus de trois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c105c9c8-1f41-4022-971c-02b0ff94e213",
                                "sense_id": "b8697dd2-8c67-34cf-8bff-7231089b9294",
                                "text": "Pierre est multilingue."
                            },
                            {
                                "example_id": "a859326a-b6f9-4c64-b5b2-68363f7d4af9",
                                "sense_id": "b8697dd2-8c67-34cf-8bff-7231089b9294",
                                "text": "Notre rédaction offrira une perspective unique à travers laquelle l'électorat multilingue du continent débattra avec les leaders politiques, les leaders d'opinion et les industriels de l'Union sur des questions brûlantes telles que l'énergie, le climat, la santé, les migrations et la sécurité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eeaf4d1a-ffa6-4488-bf7f-a0b4dcbeab4d",
                        "source_entry_id": "729846b2-1268-378e-93b0-aec69b019692",
                        "target_lang_word": "multilingual",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multilingual",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abe8ee0d-c275-3c5a-b77b-bbef4fa8363d",
                                        "entry_id": "af207b72-b1d9-3a40-bab2-ebeb0c597e90",
                                        "glosses": [
                                            "mehrere, viele Sprachen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c2dac49-091f-41e1-a05c-4130f252c29b",
                                                "sense_id": "abe8ee0d-c275-3c5a-b77b-bbef4fa8363d",
                                                "text": "Manche Staaten wie z.B. Indien sind multilingual."
                                            },
                                            {
                                                "example_id": "0b41d56f-0ef4-4766-84a2-51034e9beb6b",
                                                "sense_id": "abe8ee0d-c275-3c5a-b77b-bbef4fa8363d",
                                                "text": "„Die Gesellschaft in der Region des heutigen Lettland ist stets multilingual und multikulturell geprägt gewesen…“"
                                            },
                                            {
                                                "example_id": "19e657e3-8dfa-40e8-adf3-b97f1bb7d08d",
                                                "sense_id": "abe8ee0d-c275-3c5a-b77b-bbef4fa8363d",
                                                "text": "„Insgesamt ist die Jugend zwar nicht mehr so multilingual wie ihre Vorväter, aber viele sind doch wenigstens zweisprachig und natürlich lernen sie in zunehmendem Maße auch Englisch.“"
                                            },
                                            {
                                                "example_id": "668bfdbb-c5a2-4714-8778-477e963e8c54",
                                                "sense_id": "abe8ee0d-c275-3c5a-b77b-bbef4fa8363d",
                                                "text": "„Jahrhundertelang war Jiddisch genau dieses Bindeglied zwischen den germanischen und slawischen Sprachen, ein multilinguales Amalgam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25f90057-28e0-43ae-9ba7-0d0804891228",
                        "source_entry_id": "729846b2-1268-378e-93b0-aec69b019692",
                        "target_lang_word": "multilingual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multilingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ef204e-8a85-359d-911f-041a965eccc6",
                                        "entry_id": "3e5cd360-7a31-3863-b0d3-b13020b292e4",
                                        "glosses": [
                                            "Of, relating to, or involving multiple languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53066aa1-12e4-4649-9542-44b4c6ae0385",
                                                "sense_id": "93ef204e-8a85-359d-911f-041a965eccc6",
                                                "text": "In reality, the multidimensionality of language contact in multilingual environments ensures no such neat compartmentalisation."
                                            },
                                            {
                                                "example_id": "74e9c358-1fee-4466-b24b-3ec0e68f13de",
                                                "sense_id": "93ef204e-8a85-359d-911f-041a965eccc6",
                                                "text": "Wikipedia is the most ambitious multilingual project after the Bible: There are editions in over 340 languages, and a further 400 even more obscure ones are being developed and tested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148e3b56-2c68-3ea6-8e80-a12a514bb6e5",
                                        "entry_id": "3e5cd360-7a31-3863-b0d3-b13020b292e4",
                                        "glosses": [
                                            "Able to communicate in a number of languages."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23072856-c28e-4d1f-b0ef-4c969e10f4a1",
                                                "sense_id": "148e3b56-2c68-3ea6-8e80-a12a514bb6e5",
                                                "text": "So being multilingual can make you more appealing, more successful and more compassionate. And it’s also good for your health."
                                            },
                                            {
                                                "example_id": "dfeb2178-cba3-45a0-b6d0-ebcdba9f9731",
                                                "sense_id": "148e3b56-2c68-3ea6-8e80-a12a514bb6e5",
                                                "text": "Describing us as multilingual emphasizes our achievements and that learning English adds to the richness of our identity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "multilingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c66704ed-58ba-3d6d-8307-6fbe9269b9a8",
                                        "entry_id": "124b91df-e8f6-322a-a22b-8c8687fdc099",
                                        "glosses": [
                                            "A polyglot."
