                "senses": [
                    {
                        "sense_id": "a3e0884d-3714-320e-98a8-0538a405cc0b",
                        "entry_id": "5254da74-604c-3e41-a3b2-e593567f1342",
                        "glosses": [
                            "zob. borówka brusznica"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4202d3-41f2-49fa-97b1-95d186468b1e",
                                "sense_id": "a3e0884d-3714-320e-98a8-0538a405cc0b",
                                "text": "A tam się czerwieniły wrzosiste pagórki, strojne w brusznice jakby w koralów paciorki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb852cd-f21b-46a0-9fc8-638be4eb99a4",
                        "source_entry_id": "5254da74-604c-3e41-a3b2-e593567f1342",
                        "source_sense_id": "a3e0884d-3714-320e-98a8-0538a405cc0b",
                        "target_lang_word": "брусника",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "брусника",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc0ef22-1a7b-35b3-a242-826608c61ea3",
                                        "entry_id": "0b928eea-1667-37e5-aecd-ce32b14e3fa7",
                                        "glosses": [
                                            "ботан. вечнозелёное кустарничковое растение из рода Vaccinium (лат. Vaccinium vitis-idaea) семейства Вересковых (лат. Ericaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5fe6a0-dfe0-4927-b991-f010ee4cd520",
                                                "sense_id": "6fc0ef22-1a7b-35b3-a242-826608c61ea3",
                                                "text": "Выше их на Сихотэ-Алине растут низкорослые багульники, брусника, рододендрон, мхи, ещё выше — лишаи, и наконец начинаются гольцы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae1daa3-4dec-3201-bb90-8313c59e66dd",
                                        "entry_id": "0b928eea-1667-37e5-aecd-ce32b14e3fa7",
                                        "glosses": [
                                            "плод этого растения, небольшая ягода красного цвета (тж. собир.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b44962-6d97-474d-9e83-4e113becc277",
                                                "sense_id": "eae1daa3-4dec-3201-bb90-8313c59e66dd",
                                                "text": "Ещё вкуснее шиповника была брусника, тронутая морозом, перезревшая, сизая…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
