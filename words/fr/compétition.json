                    "frequency": "High",
                    "semantic_group_id": "sport_concours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère s'entraîne tous les jours pour sa prochaine <w>compétition</w> de judo."
                        },
                        {
                            "text": "Cette <w>compétition</w> sportive réunit les meilleurs athlètes de la région."
                        }
                    ],
                    "synonyms": [
