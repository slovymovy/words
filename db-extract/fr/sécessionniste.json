        "fr-extract.jsonl": [
            {
                "entry_id": "2f590baf-8f6a-3a33-8c9a-a8fd67a5b381",
                "word": "sécessionniste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e52d1733-59b7-49ea-896d-8ee0548df3e9",
                        "entry_id": "2f590baf-8f6a-3a33-8c9a-a8fd67a5b381",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "sécessionnistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aba9b543-580b-3f80-a612-7f8006dfe4f1",
                        "entry_id": "2f590baf-8f6a-3a33-8c9a-a8fd67a5b381",
                        "glosses": [
                            "Relatif à une sécession."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b0ad005-afdd-467f-956b-f0d8710c9936",
                                "sense_id": "aba9b543-580b-3f80-a612-7f8006dfe4f1",
                                "text": "La république du Biafra était un État sécessionniste de 1967 à 1970 situé dans la partie Sud-Est du Nigeria, la plus riche en réserve de pétrole."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fa01c1e-75f5-310f-b69f-9a6aeade6430",
                        "entry_id": "2f590baf-8f6a-3a33-8c9a-a8fd67a5b381",
                        "glosses": [
                            "Relatif à la Sécession viennoise, mouvement autrichien de l'Art nouveau, au début du XXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a68dee-e15a-4a8d-8084-8b898aab5cd6",
                                "sense_id": "5fa01c1e-75f5-310f-b69f-9a6aeade6430",
                                "text": "En 1905, un conflit éclate entre des artistes sécessionnistes « naturalistes » (comprendre « académistes ») et des artistes comme Gustav Klimt, Josef Hoffmann, Koloman Moser."
                            }
                        ]
                    },
                    {
                        "sense_id": "64f8306c-c848-3e2c-9c60-cc6b6134c319",
                        "entry_id": "2f590baf-8f6a-3a33-8c9a-a8fd67a5b381",
                        "glosses": [
                            "Lors de la guerre civile américaine (1861 - 1865), relatif aux confédérés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9403c1e-c482-4037-a98a-3dcb7e8ce1b6",
                                "sense_id": "64f8306c-c848-3e2c-9c60-cc6b6134c319",
                                "text": "Le 20 avril 1861, peu après le déclenchement de la guerre civile, des éléments sécessionnistes s'emparèrent d'un petit arsenal dans la ville de Liberty."
                            },
                            {
                                "example_id": "60163990-b16d-4bd3-971c-89811cbd1f0f",
                                "sense_id": "64f8306c-c848-3e2c-9c60-cc6b6134c319",
                                "text": "Autrefois État sécessionniste, l'Arkansas a été un État ségrégationniste jusqu'à la fin des années 1950."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ac617ea-b00e-45f9-ba72-068bf53c3780",
                        "source_entry_id": "2f590baf-8f6a-3a33-8c9a-a8fd67a5b381",
                        "target_lang_word": "secessionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secessionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "216474ab-5a29-31b6-b0c7-e975cf98e258",
                                        "entry_id": "4b157754-b4f3-3d3a-8c63-22001e4f97e2",
                                        "glosses": [
                                            "A person who secedes or supports secession from a political union or an alliance or organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab8416f-5b9f-40d5-ad9b-3da8465008cd",
                                                "sense_id": "216474ab-5a29-31b6-b0c7-e975cf98e258",
                                                "text": "Gustav Klimt was of the Viennese secessionist school."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secessionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
