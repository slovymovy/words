                    {
                        "translation_id": "e17f0632-a1a0-47c7-ba3b-12ffccbcdd4e",
                        "source_entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
                        "source_sense_id": "d38a6a0c-d6df-3d17-aca0-75fb6b679d3d",
                        "source_sense_description": "Femme qui donne des soins à des animaux",
                        "target_lang_word": "Pflegerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflegerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                                        "glosses": [
                                            "weibliche Person, die jemanden pflegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af1446d2-fd07-4c99-8e31-1eda169a71f2",
                                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                                "text": "Die Pflegerin bringt dem Patienten ein Glas Wasser."
                                            },
                                            {
                                                "example_id": "19651b11-81b4-4809-92c4-89e3c1f5b17d",
                                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                                "text": "Im Affengehege arbeiten momentan mehr Pflegerinnen als Pfleger."
                                            },
                                            {
                                                "example_id": "1f0e40ee-6e53-49c5-bbc7-a9a914be62da",
                                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                                "text": "„Nach einem Kilometer, wir haben die Innenstadt verlassen, passieren wir das Seniorenheim von Hausach; ein paar Pflegerinnen schauen zum Fenster heraus und winken uns zu.“"
                                            },
                                            {
                                                "example_id": "ca21b50c-c7da-4edb-b93f-3a98559603f0",
                                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                                "text": "„Ihr fiel aber nichts ein, außer eine Pflegerin zu engagieren, die von Maman-Bozorg spätestens nach zwei Wochen wieder vor die Tür gesetzt wurde.“"
                                            },
                                            {
                                                "example_id": "745510ea-8f0d-4f0e-abc1-06f354d2c634",
                                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                                "text": "„Die Pflegerinnen erzählen, dass sie manchmal wie ein Kind herumgeht und die anderen Heimbewohner kitzelt.“"
                                            },
                                            {
                                                "example_id": "b7b8b117-ba5e-4375-962f-a173d3312862",
                                                "sense_id": "3e23c020-1458-39e9-a9ee-55bd97619c32",
                                                "text": "„Als er der Kranken für die Nacht eine Pflegerin verschrieb, hatte sie mit der Hand auf Laura gewiesen; daraufhin versprach diese mir, sie nicht mehr allein zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                                        "glosses": [
                                            "weibliche Person, die sich um Krankenhauspatienten kümmert"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff790e9f-829b-4bf8-b639-3280df4849bf",
                                                "sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                                                "text": "Zwei Pflegerinnen waren nötig, um den Patienten umzulagern."
                                            },
                                            {
                                                "example_id": "8354c62d-e2f4-4878-8648-b96e8d0468e0",
                                                "sense_id": "e7a32c89-689c-3736-8e44-a14cdc2a472c",
                                                "text": "„Eine Pflegerin kommt den Weg entlang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc8f28ee-a150-3f9e-b957-b4057fa8a6fd",
                                        "entry_id": "7391500f-0331-3fb6-b60a-b13066ebf1b4",
                                        "glosses": [
                                            "weibliche Person, die minderjährige Patienten betreut"
                                        ],
                                        "tags": [
                                            "Kurzwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98c82616-c586-4e3f-8125-ccde78b0fd3d",
                                                "sense_id": "cc8f28ee-a150-3f9e-b957-b4057fa8a6fd",
                                                "text": "Der kleine Thomas war von keiner Pflegerin zu bändigen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
