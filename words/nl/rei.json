{
    "word_family": [
        "reidans",
        "reien"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "816ca461-3bc0-37a2-834f-962ef352419b",
                    "sense_definition": "Rechte lat van hout of metaal die gebruikt wordt om vlakken te controleren of af te tekenen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman gebruikt een <w>rei</w> om te kijken of de muur recht is. A1",
                            "target_lang_translations": {
                                "fr": "Le charpentier utilise une <w>règle</w> pour vérifier si le mur est droit."
                            }
                        },
                        {
                            "text": "Met een stalen <w>rei</w> kun je een rechte lijn op de vloer trekken. A1",
                            "target_lang_translations": {
                                "fr": "Avec une <w>règle</w> en acier, on peut tracer une ligne droite sur le sol."
                            }
                        }
                    ],
                    "synonyms": [
                        "liniaal",
                        "meetlat"
                    ],
                    "common_phrases": [
                        "stalen rei"
                    ],
                    "target_lang_definitions": {
                        "fr": "Règle ou latte en bois ou en métal utilisée pour vérifier ou tracer des surfaces planes."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "règle",
                                "target_lang_sense_clarification": "instrument pour mesurer ou tracer"
                            },
                            {
                                "target_lang_word": "règle de maçon",
                                "target_lang_sense_clarification": "pour dresser des surfaces en construction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3c3aeb4-304b-33bb-b8ab-2b9dc9ad71dc",
                    "sense_definition": "Stadsgracht of waterloop, met name gebruikt voor waterwegen in steden zoals Brugge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We maakten een boottocht over de historische <w>rei</w> in de binnenstad. A1",
                            "target_lang_translations": {
                                "fr": "Nous avons fait une promenade en bateau sur le <w>canal</w> historique du centre-ville."
                            }
                        },
                        {
                            "text": "In de winter staat het water in de <w>rei</w> erg hoog. A1",
                            "target_lang_translations": {
                                "fr": "En hiver, l'eau dans le <w>canal</w> est très haute."
                            }
                        }
                    ],
                    "synonyms": [
                        "gracht",
                        "singel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in Brugge en Vlaanderen"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Canal ou cours d'eau urbain, particulièrement utilisé pour les voies d'eau dans des villes comme Bruges."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "canal",
                                "target_lang_sense_clarification": "cours d'eau urbain, notamment à Bruges"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18ad3639-4987-3fbb-9614-d5ca040e2c45",
                    "sense_definition": "Een traditonele dans waarin mensen in een cirkel of rij bewegen en zingen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dorpsbewoners dansten een oude <w>rei</w> tijdens het dorpsfeest. A1",
                            "target_lang_translations": {
                                "fr": "Les villageois ont dansé une ancienne <w>ronde</w> pendant la fête du village."
                            }
                        },
                        {
                            "text": "Tijdens de ceremonie vormden de dansers een lange <w>rei</w>. A1",
                            "target_lang_translations": {
                                "fr": "Pendant la cérémonie, les danseurs ont formé une longue <w>ronde</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reidans",
                        "rondedans",
                        "kringdans"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Danse traditionnelle dans laquelle les gens bougent et chantent en cercle ou en ligne."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ronde",
                                "target_lang_sense_clarification": "danse en cercle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da4dbe4-9b5f-329a-8668-b22e97f4cb56",
                    "sense_definition": "Een koor of groep van zangers en dansers in het klassieke of historische toneel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "toneel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het klassieke toneelstuk sloot elk bedrijf af met een optreden van de <w>rei</w>. A1",
                            "target_lang_translations": {
                                "fr": "La pièce de théâtre classique concluait chaque acte par une prestation du <w>chœur</w>."
                            }
                        },
                        {
                            "text": "De <w>rei</w> zong een lied over het lot van de hoofdpersoon. A1",
                            "target_lang_translations": {
                                "fr": "Le <w>chœur</w> a chanté une chanson sur le destin du personnage principal."
                            }
                        }
                    ],
                    "synonyms": [
                        "koor",
                        "zangkoor"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literair/historisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Chœur ou groupe de chanteurs et de danseurs dans le théâtre classique ou historique."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "chœur",
                                "target_lang_sense_clarification": "groupe de chanteurs ou danseurs au théâtre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c093adfa-2046-31bc-a634-5b09c6fbd110",
                    "sense_definition": "Een verzameling of opeenvolging van personen of zaken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stond een hele <w>rei</w> van bekende mensen op het podium. A1",
                            "target_lang_translations": {
                                "fr": "Il y avait toute une <w>suite</w> de personnes célèbres sur la scène."
                            }
                        },
                        {
                            "text": "Een lange <w>rei</w> van beslissingen leidde uiteindelijk tot het succes. A1",
                            "target_lang_translations": {
                                "fr": "Une longue <w>série</w> de décisions a finalement conduit au succès."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une suite, série ou succession de personnes ou de choses."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "série",
                                "target_lang_sense_clarification": "suite de choses ou d'événements"
                            },
                            {
                                "target_lang_word": "suite",
                                "target_lang_sense_clarification": "enfilade de personnes ou choses"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a424347-b100-35ca-bb2d-830c4b2b50cc",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van het werkwoord <w>reien</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>rei</w> door de zaal tijdens de uitvoering. A1",
                            "target_lang_translations": {
                                "fr": "Je <w>danse en ronde</w> à travers la salle pendant la représentation."
                            }
                        },
                        {
                            "text": "Vandaag <w>rei</w> ik samen met de groep. A1",
                            "target_lang_translations": {
                                "fr": "Aujourd'hui, je <w>danse en ronde</w> avec le groupe."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "werkwoordsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent de l'indicatif du verbe reien (danser en ronde)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "danse en ronde",
                                "target_lang_sense_clarification": "forme verbale (je danse en ronde)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}