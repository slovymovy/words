                "senses": [
                    {
                        "sense_id": "d6b72b46-f0f3-3cc4-b2b2-5f869915da6e",
                        "entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                        "glosses": [
                            "A person named, or designated, by another, to any office, duty, or position; one nominated, or proposed, by others for office or for election to office."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a869097-c365-33f9-96fd-7b0f8946531a",
                        "entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                        "glosses": [
                            "A person or organisation in whose name a security is registered though true ownership is held by another party, called nominator, especially for the purpose of concealing the identity of the nominator."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b78c5de5-5244-4ce0-a705-3718ef7af470",
                                "sense_id": "9a869097-c365-33f9-96fd-7b0f8946531a",
                                "text": "The Supreme Court confiscated half of Thaksin Shinawatra's fortune after finding that, while being Prime Minister, he held shares in commercial companies through nominees."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6e3a0a2-0a81-3f5a-aebd-65b7bd58c291",
                        "entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                        "glosses": [
                            "A person to whom the holder of a copyhold estate surrenders their interest."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c063744-3187-407e-89cc-87b5d1c15f28",
                        "source_entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                        "source_sense_description": "a person named or designated to any office, duty or position",
                        "target_lang_word": "candidat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candidat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                        "entry_id": "b0078b55-cc15-3bfc-b1db-836fcf1372d9",
                                        "glosses": [
                                            "Postulant à un titre, à une place, à une fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f268cc-ac25-4596-a8f0-1e7789bd8403",
                                                "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                                "text": "Aux élections générales de 1837, Cobden se porta candidat à Stockport."
                                            },
                                            {
                                                "example_id": "542d4e76-51a1-49de-b90f-b59309fb763d",
                                                "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                                "text": "Charles de Bernage, spéculateur enrichi et futur candidat à la députation, n'avait jamais eu le temps de s'apercevoir qu'il lui manquait quelque chose."
                                            },
                                            {
                                                "example_id": "5e9616bd-1da0-4c4e-b21b-4c2183c76460",
                                                "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                                "text": "Soit, d'abord, le niveau culturel. En 529 le concile de Vaison avait ordonné que les prêtres ruraux éduquassent les candidats à la cléricature."
                                            },
                                            {
                                                "example_id": "a2fa0eb2-270f-4be2-97bd-e68224a1f8c1",
                                                "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                                "text": "Ces candidats semblent chercher une réponse qui soit un « Sésame, ouvre-toi » qui va magiquement leur ouvrir les portes de l’administration par le biais d’une réponse spécifique à un oral de concours."
                                            },
                                            {
                                                "example_id": "a60b6769-d95e-4f60-b0f3-de2b5c0c0c31",
                                                "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                                "text": "Après la publication des résultats de l’écrit sur le site de publinet, les candidats admissibles reçoivent une convocation pour assister à une réunion au lycée Saint-Louis en fin d'après-midi."
                                            },
                                            {
                                                "example_id": "60cf0038-6939-439a-8847-57eddce269d2",
                                                "sense_id": "3efa6ba8-833b-33af-924d-f8b077481469",
                                                "text": "Avec ce rapport, l'association souhaite interpeller les candidats aux élections européennes, puisqu'un règlement sera soumis au vote une fois le scrutin passé. Une pétition est mise en ligne mercredi 17 avril, sur le site de l'association HOP."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26830288-6c24-32fc-9853-76e47f41e6fe",
                                        "entry_id": "b0078b55-cc15-3bfc-b1db-836fcf1372d9",
                                        "glosses": [
                                            "Celui qui aspirait à quelque charge, chez les Romains."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5af809-8727-4f5e-9abe-11f6ff8733dc",
                                                "sense_id": "26830288-6c24-32fc-9853-76e47f41e6fe",
                                                "text": "Les candidats étaient vêtus de blanc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e827f0a5-f426-3520-bc1c-e026d8a6d739",
                                        "entry_id": "b0078b55-cc15-3bfc-b1db-836fcf1372d9",
                                        "glosses": [
                                            "Grade attribué à la fin du premier cycle d’un cursus d’enseignement supérieur long."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98f06d3-ccf9-4fee-93e4-6812902d6784",
                                                "sense_id": "e827f0a5-f426-3520-bc1c-e026d8a6d739",
                                                "text": "Le grade de candidat en arts plastiques, visuels et de l’espace est créé et le diplôme afférent est délivré au terme du premier cycle de l’enseignement supérieur de type long."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09ade6a6-88ad-4237-8ecb-5fc3d2b900c0",
                        "source_entry_id": "1cbbd38d-a1eb-3992-a51f-12aedae4d6a2",
                        "source_sense_description": "a person named or designated to any office, duty or position",
