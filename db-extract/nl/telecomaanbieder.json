                        "glosses": [
                            "bedrijf dat (mobiele) telecommunicatiediensten aanbiedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e563831-a2cf-4434-8f8a-358e68b2120f",
                                "sense_id": "f2dbe71c-ed2e-3d93-9c37-5d196ca2275e",
                                "text": "Vodafone en KPN zijn grote telecomaanbieders in Nederland."
                            },
                            {
                                "example_id": "5fff7c41-4d27-4a60-a51f-a5a6e5b0d1c1",
                                "sense_id": "f2dbe71c-ed2e-3d93-9c37-5d196ca2275e",
                                "text": "Via welke telecomaanbieder ben jij ben jij aangesloten op het internet?"
                            },
                            {
                                "example_id": "c3d1514d-cf35-4694-8e07-af2916884feb",
                                "sense_id": "f2dbe71c-ed2e-3d93-9c37-5d196ca2275e",
                                "text": "KPN (min 4,5 procent) sloot de rij in de AEX. Het telecomconcern had afgelopen kwartaal last van de coronacrisis, maar houdt vast aan zijn eerder afgegeven verwachtingen. KPN zag de kwartaalomzet met bijna 5 procent dalen en voerde de nettowinst iets op tot 135 miljoen euro. In heel 2020 verwacht de telecomaanbieder het bedrijfsresultaat stabiel te kunnen houden of licht op te voeren."
                            },
                            {
                                "example_id": "a6d423bb-ca9a-4de2-aab4-0fe002dd0a82",
                                "sense_id": "f2dbe71c-ed2e-3d93-9c37-5d196ca2275e",
                                "text": "Vodafone introduceert een elektronische simkaart die de plastic simkaart kan vervangen. De telecomaanbieder wil met deze nieuwe simkaart de laatste ontwikkeling van smartphones ondersteunen."
                            }
                        ]
                    }
