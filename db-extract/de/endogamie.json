                "translations": [
                    {
                        "translation_id": "1b6b2064-2316-4fde-8a67-33083900f500",
                        "source_entry_id": "1cadebe2-4b97-31be-a3a5-f0c27d17be18",
                        "source_sense_id": "b0d945ee-5d14-3bf4-9ef1-bc90490e1e16",
                        "source_sense_description": "Heiratsregel, die eine Eheschließung nur innerhalb einer bestimmten Gruppe erlaubt",
                        "target_lang_word": "endogamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endogamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71bd3ee3-82e2-3be2-9786-caf9b8b8469c",
                                        "entry_id": "d99a996a-5f0e-37a0-b8e5-f4209acb2523",
                                        "glosses": [
                                            "The practice of marrying or requiring to marry within one's own ethnic, religious, or social group."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a0575c-cbe3-4f6f-9708-a6a1e3c9169c",
                                                "sense_id": "71bd3ee3-82e2-3be2-9786-caf9b8b8469c",
                                                "text": "Far from suggesting a demoralized culture, endogamy here seemed the mark of a buoyantly confident group, settled in their skin and not needing outsiders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48fcb5fd-bad3-339e-8275-0d6839e47fcc",
                                        "entry_id": "d99a996a-5f0e-37a0-b8e5-f4209acb2523",
                                        "glosses": [
                                            "The fusion of two related gametes."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93a56933-0226-4d2d-90bf-61e41cd06f0a",
                        "source_entry_id": "1cadebe2-4b97-31be-a3a5-f0c27d17be18",
                        "source_sense_id": "b0d945ee-5d14-3bf4-9ef1-bc90490e1e16",
                        "source_sense_description": "Heiratsregel, die eine Eheschließung nur innerhalb einer bestimmten Gruppe erlaubt",
                        "target_lang_word": "endogamie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endogamie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c19302c-07d9-3cfe-aa24-3ca40186764b",
                                        "entry_id": "aa06631b-0c91-3e45-b06c-85d87afea45e",
                                        "glosses": [
                                            "Règle pour un membre d’un groupe social consistant à se marier avec un membre du même groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961b783b-af60-4643-8fdb-cca4da8c3b3d",
                                                "sense_id": "8c19302c-07d9-3cfe-aa24-3ca40186764b",
                                                "text": "L’endogamie est une pratique rencontrée chez tous les peuples de la terre et qui consiste à choisir prioritairement et majoritairement son futur époux/sa future épouse à l’intérieur de l’aire géographique dont on fait partie (endogamie géographique), de la classe sociale à laquelle on appartient (endogamie sociale), du métier que l’on exerce (endogamie professionnelle), de la religion que l’on pratique (endogamie religieuse)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f47bf4-81c8-3d34-9751-0a2ccaf25dd5",
                                        "entry_id": "aa06631b-0c91-3e45-b06c-85d87afea45e",
                                        "glosses": [
                                            "Conservation de l’homogénéité d’un groupe social."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f7ccae-6482-47d1-aac4-01b8ad9a67fa",
                                                "sense_id": "a1f47bf4-81c8-3d34-9751-0a2ccaf25dd5",
                                                "text": "Les enfants de cadres supérieurs y sont surreprésentés, les fils ou filles d’ouvriers quasiment absents. Il en résulte une endogamie renforcée par le classement de sortie, qui permet à une élite de prospérer dans l’entre-soi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
