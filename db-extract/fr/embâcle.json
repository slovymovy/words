                    {
                        "translation_id": "7ef448ad-af75-434f-8171-091b4a5d87d8",
                        "source_entry_id": "60208736-4c75-357c-b00a-d4e00eae4761",
                        "source_sense_id": "6d9f116a-40d1-388c-8b41-a8bdbd90d03c",
                        "source_sense_description": "Obstruction d’un cours d’eau par de la glace",
                        "target_lang_word": "ijsbank",
