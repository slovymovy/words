                "senses": [
                    {
                        "sense_id": "835c3188-22e3-3b9d-ae6e-5bf684e56a55",
                        "entry_id": "3f65b53e-b48f-3db3-b707-1a6e6e05ad68",
                        "glosses": [
                            "tussen de vroegste en de laatste fase in"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21990243-2a59-4ccb-80e8-0c446fc18ebf",
                                "sense_id": "835c3188-22e3-3b9d-ae6e-5bf684e56a55",
                                "text": "Hij heeft de middelbare leeftijd bereikt."
                            },
                            {
                                "example_id": "39a5c654-e6ab-4500-820a-0a1e277525d7",
                                "sense_id": "835c3188-22e3-3b9d-ae6e-5bf684e56a55",
                                "text": "Dit is een regeling voor het middelbaar onderwijs."
                            },
                            {
                                "example_id": "3803e7bd-b1c9-4706-b3db-d7c608c8c827",
                                "sense_id": "835c3188-22e3-3b9d-ae6e-5bf684e56a55",
                                "text": "Het was de basis voor zijn eenzelvigheid. Op de middelbare school werd Muskee geraakt door On the Road van Jack Kerouac en The Naked Lunch van William Burroughs. Discjockey Willis Conover van radiozender The Voice of America stak hem aan met jazz en blues. Vooral de dampende liedjes van John Lee Hooker maakten indruk."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad840f44-d25a-30fc-a3b5-ac44a05c222c",
                        "entry_id": "3f65b53e-b48f-3db3-b707-1a6e6e05ad68",
                        "glosses": [
                            "middelbare fout: een maat voor de spreiding van een verdeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76404c7-8025-4d6c-9595-1920abdc16c6",
                                "sense_id": "ad840f44-d25a-30fc-a3b5-ac44a05c222c",
                                "text": "Een schatting voor de spreiding werd berekend door de middelbare fout te berekenen."
                            }
                        ]
                    }
