            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73b6f322-4c63-3312-b462-2c038d5f89d1",
                    "sense_definition": "het vooraf of van tevoren plaatsvinden van iets, vrijwel uitsluitend gebruikt in vaste verbindingen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt een nieuw plan niet bij <w>voorbaat</w> al afwijzen.",
                            "target_lang_translations": {
                                "en": "You cannot reject a new plan <w>in advance</w> already."
                            }
                        },
                        {
                            "text": "Ik wil je alvast hartelijk bedanken op <w>voorbaat</w> voor je hulp.",
                            "target_lang_translations": {
                                "en": "I would like to thank you warmly <w>in advance</w> for your help."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooraf"
                    ],
                    "antonyms": [
                        "achteraf"
                    ],
                    "common_phrases": [
                        "bij voorbaat",
                        "op voorbaat"
                    ],
                    "target_lang_definitions": {
                        "en": "the state of occurring beforehand or in advance; almost exclusively used in fixed phrases like 'bij voorbaat' (in advance)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advance",
                                "target_lang_sense_clarification": "used in fixed phrases like 'in advance'"
                            },
                            {
                                "target_lang_word": "beforehand",
                                "target_lang_sense_clarification": "in advance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ce27c5a-6b00-36f9-8ca6-87cfd75e0a27",
                    "sense_definition": "de eigenschap dat iets vroegtijdig of op tijd plaatsvindt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>voorbaat</w> van de oogst zorgde voor een vroege verkoop op de markt.",
                            "target_lang_translations": {
                                "en": "The <w>earliness</w> of the harvest led to early sales on the market."
                            }
                        },
                        {
                            "text": "Zijn uitzonderlijke <w>voorbaat</w> bij het leveren van het werk werd erg gewaardeerd.",
                            "target_lang_translations": {
                                "en": "His exceptional <w>promptness</w> in delivering the work was greatly appreciated."
                            }
                        }
                    ],
                    "synonyms": [
                        "vroegtijdigheid"
                    ],
                    "antonyms": [
                        "laatheid"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the quality or state of occurring early or timely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "earliness",
                                "target_lang_sense_clarification": "the state of being early"
                            },
                            {
                                "target_lang_word": "prematurity",
                                "target_lang_sense_clarification": "timeliness or early occurrence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88583e5d-fb07-3737-9434-381a29c20a8d",
                    "sense_definition": "een voordeel, winst of voorsprong die men vooraf behaalt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij behaalden een aanzienlijke <w>voorbaat</w> ten opzichte van de andere deelnemers.",
                            "target_lang_translations": {
                                "en": "They gained a considerable <w>advantage</w> over the other participants."
                            }
                        },
                        {
                            "text": "Het vroege contract gaf het bedrijf een duidelijke <w>voorbaat</w> in de onderhandelingen.",
                            "target_lang_translations": {
                                "en": "The early contract gave the company a clear <w>head start</w> in the negotiations."
                            }
                        }
                    ],
                    "synonyms": [
                        "voordeel",
                        "voorsprong"
                    ],
                    "antonyms": [
                        "achterstand",
                        "nadeel"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "verouderd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an advantage, profit, or head start gained in advance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "advantage",
                                "target_lang_sense_clarification": "benefit gained in advance"
                            },
                            {
                                "target_lang_word": "head start",
                                "target_lang_sense_clarification": "prior advantage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}