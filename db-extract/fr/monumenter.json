                "senses": [
                    {
                        "sense_id": "ea8dbac2-632b-3bf2-9e37-262f2709442a",
                        "entry_id": "ecd8b7b4-4e6d-3c49-9233-f548c4f6c70a",
                        "glosses": [
                            "Entretenir grâce à un monument le souvenir de quelqu’un ou quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce3266c-8936-460a-907f-35b27219a542",
                                "sense_id": "ea8dbac2-632b-3bf2-9e37-262f2709442a",
                                "text": "Ils avaient eu quelque jouissance à relever sur ces parois solitaires des noms d’aventureux explorateurs; ils voulurent monumenter aussi quelque chose pour ceux qui pourraient venir après eux ; mais, au lieu de leurs noms, ils gravèrent des faits scientifiques."
                            },
                            {
                                "example_id": "ab664f3b-326e-4d7d-a3a5-3166d85f022b",
                                "sense_id": "ea8dbac2-632b-3bf2-9e37-262f2709442a",
                                "text": "Puisse cette collection, entreprise dans le but de monumenter les Gloires nationales, obtenir le suffrage de mes compatriotes, pour qui elle est surtout destinée !"
                            }
                        ]
                    }
                ],
