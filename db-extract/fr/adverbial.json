                        "entry_id": "0c785b05-071f-3a54-a17a-393ba7381024",
                        "glosses": [
                            "Qui tient de l’adverbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ee202fa-cf67-4fb1-91a7-4dd4d5ffdcbd",
                                "sense_id": "4dadbdd4-6183-3555-a5d7-934ec08be7a8",
                                "text": "Haut a la valeur adverbiale dans Parler haut."
                            },
                            {
                                "example_id": "3c7f1498-809b-4176-8b0a-5ff48d738aff",
                                "sense_id": "4dadbdd4-6183-3555-a5d7-934ec08be7a8",
                                "text": "Vite n’a plus dans la langue actuelle que le sens adverbial."
                            },
                            {
                                "example_id": "75d51822-425d-43ca-83ab-5ad73185ba46",
                                "sense_id": "4dadbdd4-6183-3555-a5d7-934ec08be7a8",
                                "text": "Nous distinguons la notion d'adverbe de celle de complément adverbial."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c54d74a-f203-42b1-a8fd-12ab732db906",
