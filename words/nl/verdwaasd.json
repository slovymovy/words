{
    "word_family": [
        "dwaas",
        "dwaasheid",
        "verdwazen",
        "verdwaasdheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c2b74b69-a8f7-3eea-9af0-1fe063773d8d",
                    "sense_definition": "geestelijk in de war of versuft, vaak door een schok of verbazing",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verwardheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de harde klap keek de fietser een tijdje <w>verdwaasd</w> om zich heen.",
                            "target_lang_translations": {
                                "en": "After the hard blow, the cyclist looked around <w>dazedly</w> for a while."
                            }
                        },
                        {
                            "text": "Hij liep met een <w>verdwaasde</w> blik door de drukke winkelstraat.",
                            "target_lang_translations": {
                                "en": "He walked through the busy shopping street with a <w>bewildered</w> look."
                            }
                        }
                    ],
                    "synonyms": [
                        "verward",
                        "versuft",
                        "wezenloos",
                        "gedesoriënteerd"
                    ],
                    "antonyms": [
                        "helder",
                        "alert"
                    ],
                    "common_phrases": [
                        "verdwaasde blik",
                        "verdwaasd rondkijken"
                    ],
                    "target_lang_definitions": {
                        "en": "mentally confused or dazed, often due to a shock or amazement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dazed",
                                "target_lang_sense_clarification": "stunned or unable to think clearly"
                            },
                            {
                                "target_lang_word": "bewildered",
                                "target_lang_sense_clarification": "very confused and perplexed"
                            },
                            {
                                "target_lang_word": "stunned",
                                "target_lang_sense_clarification": "shocked into silence or confusion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11fd21e1-0dc6-3f3e-a295-8f806a312fd1",
                    "sense_definition": "zijn verstand verloren hebbend of tot dwaasheid vervallen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwardheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude koning was aan het eind van zijn leven volledig <w>verdwaasd</w> geraakt.",
                            "target_lang_translations": {
                                "en": "The old king had become completely <w>crazed</w> at the end of his life."
                            }
                        },
                        {
                            "text": "Door de jarenlange eenzaamheid maakte de man een <w>verdwaasde</w> indruk op zijn buren.",
                            "target_lang_translations": {
                                "en": "Due to years of loneliness, the man made a <w>senile</w> impression on his neighbors."
                            }
                        }
                    ],
                    "synonyms": [
                        "krankzinnig",
                        "verblind"
                    ],
                    "target_lang_definitions": {
                        "en": "having lost one's mind or fallen into foolishness/madness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crazed",
                                "target_lang_sense_clarification": "mentally deranged or wild"
                            },
                            {
                                "target_lang_word": "delirious",
                                "target_lang_sense_clarification": "in a state of wild excitement or mental confusion"
                            },
                            {
                                "target_lang_word": "senile",
                                "target_lang_sense_clarification": "showing a decline in mental faculties due to old age"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "247857f2-b57d-37f4-844f-7c8a716bee41",
                    "sense_definition": "op een verwarde of versufte manier",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verwardheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik keek een beetje <w>verdwaasd</w> op toen er twee kleine hoofdlampen op me af kwamen.",
                            "target_lang_translations": {
                                "en": "I looked up a bit <w>dazedly</w> when two small headlamps came toward me."
                            }
                        },
                        {
                            "text": "Zij staarde <w>verdwaasd</w> naar de uitslag van het examen die ze net had ontvangen.",
                            "target_lang_translations": {
                                "en": "She stared <w>blankly</w> at the exam results she had just received."
                            }
                        }
                    ],
                    "synonyms": [
                        "verward",
                        "versuft"
                    ],
                    "antonyms": [
                        "helder"
                    ],
                    "common_phrases": [
                        "verdwaasd opkijken",
                        "verdwaasd staren"
                    ],
                    "target_lang_definitions": {
                        "en": "in a confused or dazed manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dazedly",
                                "target_lang_sense_clarification": "acting in a stunned or confused way"
                            },
                            {
                                "target_lang_word": "bewilderedly",
                                "target_lang_sense_clarification": "acting in a very confused manner"
                            },
                            {
                                "target_lang_word": "blankly",
                                "target_lang_sense_clarification": "showing no understanding or emotion"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f176b73b-95b1-3bee-9018-def32363ca1b",
                    "sense_definition": "voltooid deelwoord van <w>verdwazen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De constante propaganda heeft de bevolking volledig <w>verdwaasd</w>.",
                            "target_lang_translations": {
                                "en": "The constant propaganda has completely <w>befuddled</w> the population."
                            }
                        },
                        {
                            "text": "Hij voelde zich <w>verdwaasd</w> door de overweldigende hoeveelheid nieuwe informatie.",
                            "target_lang_translations": {
                                "en": "He felt <w>dazed</w> by the overwhelming amount of new information."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'verdwazen' (to make foolish or daze)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dazed",
                                "target_lang_sense_clarification": "made to feel stunned or confused"
                            },
                            {
                                "target_lang_word": "befuddled",
                                "target_lang_sense_clarification": "made unable to think clearly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}