                                    {
                                        "sense_id": "65388b96-d025-3895-9900-ccc6081cfa17",
                                        "entry_id": "d416086c-664d-38d5-b301-386aa9b8f2fd",
                                        "glosses": [
                                            "The capital city of the Inner Mongolia autonomous region, in north-central China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffa9c79-71a6-41e9-8d03-5c800a85ebbc",
                                                "sense_id": "65388b96-d025-3895-9900-ccc6081cfa17",
                                                "text": "The assemblage of stone artifacts at Dingcun represents a very important link in the evolution of China's primitive cultures. It succeeded the Gehe culture and ushered in the Dayao culture of Hohhot in Inner Mongolia and the Emaokou culture in Huairen County, Shanxi Province.",
                                                "translation": "Early Man in China",
                                                "english": "Early Man in China"
                                            },
                                            {
                                                "example_id": "0da9361f-b3c8-4b66-94e9-199f6420acdc",
                                                "sense_id": "65388b96-d025-3895-9900-ccc6081cfa17",
                                                "text": "Then again, Sima Qian says that, after crossing the river, the Wall wound northward to touch a mountain north-west of Hohhot. But no wall winds northward here."
                                            },
                                            {
                                                "example_id": "c254fe93-ac8b-4b5b-b51b-06fe77749a02",
                                                "sense_id": "65388b96-d025-3895-9900-ccc6081cfa17",
                                                "text": "Mengniu can tap high-quality Aussie milk. And it is one in the eye for Yili, its bigger cross-town dairy rival in Hohhot, the regional capital of Inner Mongolia."
                                            },
                                            {
                                                "example_id": "2a2d8f1c-b150-4efa-8529-0d9e801d3007",
                                                "sense_id": "65388b96-d025-3895-9900-ccc6081cfa17",
                                                "text": "On National Security Education Day in April, students in Hohhot, Inner Mongolia, were instructed on how to report suspicious activity."
                                            }
                                        ]
