                    {
                        "form_id": "8eaf4c18-50a7-4219-a538-864ab00294ef",
                        "entry_id": "9f891a99-bcfc-3fc5-a08d-8d537e808f95",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "schrijfmachientjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "269e0565-d5f8-3626-99cd-694576f6bb5f",
                        "entry_id": "9f891a99-bcfc-3fc5-a08d-8d537e808f95",
                        "glosses": [
                            "een mechanisch apparaat, voorzien van druktoetsen waarmee schrifttekens op papier gezet kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f05080f8-6fe0-4d50-94d7-22f874910829",
                                "sense_id": "269e0565-d5f8-3626-99cd-694576f6bb5f",
                                "text": "Voordat de schrijfmachine werd uitgevonden werden teksten met de hand geschreven en het apparaat werd later vervangen door een tekstverwerker op een computer en een printer."
                            },
                            {
                                "example_id": "995e8efe-07a5-4b79-8e77-1421c8a8d3fb",
                                "sense_id": "269e0565-d5f8-3626-99cd-694576f6bb5f",
                                "text": "Het idee om na het tellen terug te keren naar zijn schrijfmachine was weliswaar rationeel, maar ook immoreel. Geen groot bedrog, maar toch bedrog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b800eae-193c-4a7a-bdae-8cc3aa97d8ba",
                        "source_entry_id": "9f891a99-bcfc-3fc5-a08d-8d537e808f95",
                        "source_sense_id": "269e0565-d5f8-3626-99cd-694576f6bb5f",
                        "source_sense_description": "een mechanisch apparaat, voorzien van druktoetsen waarmee schrifttekens op papier gezet kunnen worden",
                        "target_lang_word": "Schreibmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea400f33-3124-3d8a-87ce-ba806cd827f1",
                                        "entry_id": "47393a46-b5a1-35b7-a132-c930980602a6",
                                        "glosses": [
                                            "mechanisches Gerät zum Verfassen von Texten auf Papier mittels Druckerschwärze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f64092d-260b-4586-b6e0-7305906a8a64",
                                                "sense_id": "ea400f33-3124-3d8a-87ce-ba806cd827f1",
                                                "text": "Ich schreibe meine Briefe immer noch mit der guten, alten Schreibmaschine."
                                            },
                                            {
                                                "example_id": "9dd601e0-6b6d-469d-95d3-4f52c4ae2e4f",
                                                "sense_id": "ea400f33-3124-3d8a-87ce-ba806cd827f1",
                                                "text": "»Sie werden meine Sekretärin, Natalie Iwanowna,« unterbrach sie Semeonow. »Ich rate Ihnen, schon von morgen an Schreibmaschine und Stenographie zu lernen.«"
                                            },
                                            {
                                                "example_id": "b44d5e09-2d37-4f7d-8f01-bd87ccc35107",
                                                "sense_id": "ea400f33-3124-3d8a-87ce-ba806cd827f1",
                                                "text": "Um zu einer Schreibmaschine zu gelangen, stieg ich nachts durch ein Parterrefenster in den Verlag Heinrich F. S. Bachmair, bei dem ich früher einmal Fräulein gewesen war."
                                            },
                                            {
                                                "example_id": "caf04c8e-21ee-408d-94ab-61ebf1914bd3",
                                                "sense_id": "ea400f33-3124-3d8a-87ce-ba806cd827f1",
                                                "text": "Am 7. Mai 1957, vor 50 Jahren, startete in Hannover eine kleine Revolution der Büroarbeit: Auf der Büromaschinen-Fachausstellung der Hannover Messe wurden zum ersten Mal in Deutschland einer größeren Öffentlichkeit elektrische Schreibmaschinen vorgestellt, darunter die Matura Electric von Grundig."
                                            },
                                            {
                                                "example_id": "3d0b1a05-3871-4ddf-81fe-9aee7db8e88b",
                                                "sense_id": "ea400f33-3124-3d8a-87ce-ba806cd827f1",
                                                "text": "Die 1937 in Berlin geborene Sängerin musste sich ihr Studium in Graz mit Sekretariatsarbeiten an der Schreibmaschine ertippen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3889376-07ad-461d-8cff-0373a7b23318",
                        "source_entry_id": "9f891a99-bcfc-3fc5-a08d-8d537e808f95",
                        "source_sense_id": "269e0565-d5f8-3626-99cd-694576f6bb5f",
                        "source_sense_description": "een mechanisch apparaat, voorzien van druktoetsen waarmee schrifttekens op papier gezet kunnen worden",
                        "target_lang_word": "typewriter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typewriter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87910e4a-74b0-384d-9337-80ff81dcf703",
                                        "entry_id": "0d535523-3288-377c-96c9-393b794574c8",
                                        "glosses": [
                                            "A device, at least partially mechanical, used to print text by pressing keys that cause type to be impressed through an inked ribbon onto paper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5b555f4-38bb-3045-8698-4dd60b80f2df",
                                        "entry_id": "0d535523-3288-377c-96c9-393b794574c8",
                                        "glosses": [
                                            "One who uses a typewriter; a typist."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "658b5cd7-107c-4324-b897-62ba286a0c90",
                                                "sense_id": "e5b555f4-38bb-3045-8698-4dd60b80f2df",
                                                "text": "He had taken the wife to his raw new palace in San Diego, where she and her people occupied a wing of great price, and Cheyne, in a veranda-room, between a secretary and a typewriter, who was also a telegraphist, toiled along wearily from day to day."
                                            },
                                            {
                                                "example_id": "82bce83c-5d76-4b29-a79f-14b109710075",
                                                "sense_id": "e5b555f4-38bb-3045-8698-4dd60b80f2df",
                                                "text": "The typewriter got up and disappeared out a back door, and soon she come back with a man, and he said, \"Can I be of some help, Mr. Higgens?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e752fe92-fca1-34db-8763-52646c4dd7b0",
                                        "entry_id": "0d535523-3288-377c-96c9-393b794574c8",
                                        "glosses": [
                                            "A machine gun or submachine gun (from the noise it makes when firing)."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f11d66-218e-4662-ac79-e36588559af3",
                                                "sense_id": "e752fe92-fca1-34db-8763-52646c4dd7b0",
                                                "text": "The battle had opened in earnest. From the wooded ridge came in reply the clacking of \"typewriters,” and bullets whined over our heads."
                                            },
                                            {
                                                "example_id": "5f95475f-1b14-4158-8b00-186f441cd165",
                                                "sense_id": "e752fe92-fca1-34db-8763-52646c4dd7b0",
                                                "text": "It was like sinking to sleep in a soft, dry bed with a big drink of brandy in you after you're dog-tired from a tour of duty on the firing-step, or slipping into a warm bath when you're lousy-dirty and chilled to the bone from crawling through mud and filth and dodging flares and 'typewriter' bullets half the night."
                                            },
                                            {
                                                "example_id": "a1f61eba-4ddc-4f00-bc85-55b8ba44577b",
                                                "sense_id": "e752fe92-fca1-34db-8763-52646c4dd7b0",
                                                "text": "Why, any day I'd go up against a typewriter, with a forty-five. One shot I'd need and there'd be time for three while he was getting that damn' thing swung around and pointed —"
                                            },
                                            {
                                                "example_id": "1461fe3b-a6dd-4868-8c3a-2f289d0206a6",
                                                "sense_id": "e752fe92-fca1-34db-8763-52646c4dd7b0",
                                                "text": "Fortunately we were on the edge of a shallow shell hole when the sentry caught our movements and Fritz cut loose with the \"typewriters.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f01575a7-e941-30e4-9709-eea1e2358abb",
                                        "entry_id": "0d535523-3288-377c-96c9-393b794574c8",
                                        "glosses": [
                                            "A prank in which fingers are jabbed roughly onto someone's chest followed by striking them over the ear in imitation of using an old-fashioned typewriter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c51324a7-e41c-4465-a294-1cd19ed1bb9b",
                        "source_entry_id": "9f891a99-bcfc-3fc5-a08d-8d537e808f95",
                        "source_sense_id": "269e0565-d5f8-3626-99cd-694576f6bb5f",
                        "source_sense_description": "een mechanisch apparaat, voorzien van druktoetsen waarmee schrifttekens op papier gezet kunnen worden",
                        "target_lang_word": "machine à écrire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine à écrire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6278076b-b597-36f1-a08d-7391b9407515",
                                        "entry_id": "2c602044-4111-3e69-b7bd-eda25bbe9568",
                                        "glosses": [
                                            "Machine permettant d’écrire et d’imprimer des caractères sur une feuille de papier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3ad1353-cb13-4941-b9e8-1e275d4cf172",
                                                "sense_id": "6278076b-b597-36f1-a08d-7391b9407515",
                                                "text": "C’est une sorte de psychisme, tout comme l’agora-phobie ou la crampe des écrivains, devenue après l’emploi de la machine à écrire, la crampe des dactylographes."
                                            },
                                            {
                                                "example_id": "08140a7d-cac8-4073-8bba-41436f59ee67",
                                                "sense_id": "6278076b-b597-36f1-a08d-7391b9407515",
                                                "text": "Pour bien apprécier la valeur d’une invention, il faut, d’une part, considérer le temps qui s’est écoulé depuis que le besoin s’en est fait sentir ; de l’autre, la quantité de tentatives restés infructueuses devant les difficultés qu’elle présentait. Envisagée à ce double point de vue, la machine à écrire disposée pour les aveugles, par M. Foucault, aveugle lui-même, est une des plus remarquables qui ait figuré à l’exposition."
                                            },
                                            {
                                                "example_id": "581ae66b-5495-4250-ba96-07e3ad73dece",
                                                "sense_id": "6278076b-b597-36f1-a08d-7391b9407515",
                                                "text": "Aigrie, abrutie par huit heures quotidiennes de machine à écrire, elle craint les histoires."
                                            },
                                            {
                                                "example_id": "af3bd5c0-113b-475e-a67f-eeceae19aec8",
                                                "sense_id": "6278076b-b597-36f1-a08d-7391b9407515",
                                                "text": "La machine à écrire sur la consolette Louis XV, la ronéotype sur le bureau Napoléon III, des paquets de papier partout sur un vestige de tapis de la Savonnerie, et des cendriers pleins de clopes dans tous les coins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
