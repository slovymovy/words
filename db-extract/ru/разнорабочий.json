                "translations": [
                    {
                        "translation_id": "525cbad7-8eae-41ba-83e3-3cc4ebd855d0",
                        "source_entry_id": "3327e385-46d9-3297-a40d-380ed243ba67",
                        "source_sense_id": "e6b02351-4e5f-317d-9624-cc32ed5a2637",
                        "target_lang_word": "homme à tout faire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homme à tout faire",
