                        "sense_id": "982b173c-c481-381d-82d6-97d624084372",
                        "entry_id": "e17242e1-e0f7-3896-98c5-8ba427901029",
                        "glosses": [
                            "свойство по значению прилагательного сексапильный; сексуальная привлекательность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1232a94-d2d3-4300-83de-3586fa92b8fc",
                                "sense_id": "982b173c-c481-381d-82d6-97d624084372",
                                "text": "Не признаваясь себе, она любила разочаровывать тех, кто клевал на её сексапильность."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
