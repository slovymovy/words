        "ru-extract.jsonl": [
            {
                "entry_id": "a5cbcc5b-9a75-34f3-9917-7303d938ef1a",
                "word": "любо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6cd82678-371d-3222-9a4e-ff7342d2914b",
                        "entry_id": "a5cbcc5b-9a75-34f3-9917-7303d938ef1a",
                        "glosses": [
                            "нар.-поэт. приятно, по душе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a122d4e-b2d7-4135-91f4-dcbf17df3a06",
                                "sense_id": "6cd82678-371d-3222-9a4e-ff7342d2914b",
                                "text": "Он так любо пел, что я прямо заслушалась!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ac1ed579-c3ee-319c-9953-ec3fc231f350",
                        "entry_id": "a5cbcc5b-9a75-34f3-9917-7303d938ef1a",
                        "glosses": [
                            "предик. нар.-поэт. оценочная характеристика ситуации, чьих-либо действий как приятных, нравящихся кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9667cd2d-dbbf-4a4b-8e4a-2dc3e73091d1",
                                "sense_id": "ac1ed579-c3ee-319c-9953-ec3fc231f350",
                                "text": "Ну а теперь в комнате чисто: прямо любо смотреть."
                            },
                            {
                                "example_id": "1363ec3d-3819-4b67-91ad-8265ffaed192",
                                "sense_id": "ac1ed579-c3ee-319c-9953-ec3fc231f350",
                                "text": "Любо послушать."
                            },
                            {
                                "example_id": "5eb13791-3aa3-49e0-941f-0abd6eeb8105",
                                "sense_id": "ac1ed579-c3ee-319c-9953-ec3fc231f350",
                                "text": "Не любо — не слушай, а врать не мешай."
                            },
                            {
                                "example_id": "6322ad77-c193-4dbd-8554-8f3ff72ed8a2",
                                "sense_id": "ac1ed579-c3ee-319c-9953-ec3fc231f350",
                                "text": "Любо тогда и жаркому солнцу оглядеться с вышины и погрузить лучи в холод стеклянных вод."
                            }
                        ]
                    }
                ],
