                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Dye</w> has been working at the company for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Дай</w> работает в компании уже двадцать лет.",
                                "zh": "<w>戴</w>先生在这家公司已经工作二十年了。"
                            }
                        },
                        {
                            "text": "We invited the <w>Dye</w> family to the neighborhood barbecue.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Дай</w> на соседское барбекю.",
                                "zh": "我们邀请了<w>戴</w>氏一家参加社区烧烤。"
                            }
                        }
