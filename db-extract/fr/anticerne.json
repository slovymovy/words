                "senses": [
                    {
                        "sense_id": "4b04f714-966f-332a-9307-5bb6e55e7352",
                        "entry_id": "df19e57f-b10d-3bbf-8d08-143bdbc49781",
                        "glosses": [
                            "Qui masque ou corrige les cernes des yeux."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a76c3f80-2359-4387-9c5d-e81f2197137f",
                                "sense_id": "4b04f714-966f-332a-9307-5bb6e55e7352",
                                "text": "Évidemment, il existe des correcteurs anticernes, mais dissimuler la fatigue, ça, c'est une autre histoire."
                            },
                            {
                                "example_id": "d0144aab-b8f7-4304-aa0c-3414b9154c73",
                                "sense_id": "4b04f714-966f-332a-9307-5bb6e55e7352",
                                "text": "Je sors les patchs anticernes de leur boîte. Une demi-heure. C'est marqué sur la boîte. Moi je fais comme c'est marqué sur la boîte. Chaque matin je vis avec mes patchs anticernes pendant une demi-heure. Avant j'avais des cernes. Maintenant j'ai des patchs."
                            }
                        ]
                    }
                ],
