            {
                "entry_id": "8c95626b-4515-3ba6-9a13-c9e8b801c047",
                "word": "verd",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "769e13b9-ca92-4d46-affe-39b01780686f",
