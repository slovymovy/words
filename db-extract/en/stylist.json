    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                "word": "stylist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d684e30f-397f-4d43-83c3-612fc11374c0",
                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "tags": [
                            "plural"
                        ],
                        "form": "stylists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f4459a0-e3b1-3bee-9532-ae1704075071",
                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "glosses": [
                            "A designer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b2a7c29-733d-3aa5-9cd7-3857434c1343",
                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "glosses": [
                            "A hairdresser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5e47dadb-66ea-3ba9-9aeb-7938c72eb950",
                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "glosses": [
                            "A writer or speaker distinguished for excellence or individuality of style; one who cultivates, or is a master or critic of, literary style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef131de0-e868-4d12-9206-acb2948f7724",
                                "sense_id": "5e47dadb-66ea-3ba9-9aeb-7938c72eb950",
                                "text": "If Doctor Johnson, that stilted and accomplished stylist, had lacked the sacred Boswell, what should we have known of him?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b5bf793-c257-357e-9fcd-2007479326c3",
                        "entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "glosses": [
                            "An artist who has a particular distinctive style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6232f416-1df4-483d-aec8-8c875bc4518b",
                                "sense_id": "9b5bf793-c257-357e-9fcd-2007479326c3",
                                "text": "A plain, seemingly graceless stylist, his rather unpalatable movies, full of rabid, sloggingly orchestrated physical pain and psychic damage, picture crime as a monstrous, miasmal evil, divesting it of any glamour it ever had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8c3b569-cbea-45cc-8cbc-77279cd4c3b4",
                        "source_entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "source_sense_description": "a writer or speaker distinguished for excellence or individuality of style",
                        "target_lang_word": "Stilist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stilist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e05c4707-a657-354d-bcaf-7b4330e727d3",
                                        "entry_id": "0fbaa918-b900-3d01-b2e6-069a5b6da01a",
                                        "glosses": [
                                            "Person, die einen Stil beherrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a75b7a-3e97-4fe3-b43a-626452721de9",
                                                "sense_id": "e05c4707-a657-354d-bcaf-7b4330e727d3",
                                                "text": "Thomas Mann gilt vielen als ein hervorragender Stilist."
                                            },
                                            {
                                                "example_id": "5e3c695a-4d50-4caf-848d-6b94122de578",
                                                "sense_id": "e05c4707-a657-354d-bcaf-7b4330e727d3",
                                                "text": "„Er war ein zukunftsfähiger Kopf, ein großer Stilist, ein realistischer, eher konservativer Politiker und alles in allem das, was man einen anständigen, ethisch verantwortungsbewussten Mann nennen könnte.“"
                                            },
                                            {
                                                "example_id": "123c06eb-eb41-48b3-961b-908856a894b2",
                                                "sense_id": "e05c4707-a657-354d-bcaf-7b4330e727d3",
                                                "text": "„Grammatiker und Stilisten in Großbritannien veröffentlichten zur gleichen Zeit Warnungen gegen den Gebrauch von zu vielen Zeichen und einen übermäßig exklamatorischen Ton.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00135d19-6923-4522-b851-5a29d2a57c70",
                        "source_entry_id": "2a925e0d-df58-372c-9864-e83b65f045b3",
                        "source_sense_description": "a writer or speaker distinguished for excellence or individuality of style",
                        "target_lang_word": "Stilistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stilistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                        "entry_id": "f6dbc973-80a4-3b53-846c-92f9baa191ed",
                                        "glosses": [
                                            "Frau, die eine besondere Sorgfalt darauf verwenden, wie sie etwas schön oder ungewöhnlich sagt/schreibt oder spielt/singt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cce761f-b685-4a1d-ae13-46ef5f29c37d",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "„Justyna Bargielska ist eine ungewöhnliche Stilistin und begabte Vertreterin der jungen polnischen Literatur.“"
                                            },
                                            {
                                                "example_id": "e92d6903-e5ef-4ba3-9f60-ef5f6764ae23",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "[Nadine Gordimer: In ihren] „Essays und Erzählungen […] zeigt sich eine elegante Stilistin und rhetorisch gewandte Rednerin […].“"
                                            },
                                            {
                                                "example_id": "41d40cbb-ca36-4156-8414-33f531fa7198",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "„Wenn „100 £“ in einem Text, der in den 1960er Jahren spielt, allen Ernstes mit „100 Euro“ übersetzt werden – und wenn der männliche Roddy eine „Anstandsdame“ genannt wird, bleibt die „große Stilistin“ Brookner auf der Strecke, die der Verlag im Klappentext rühmt.“"
                                            },
                                            {
                                                "example_id": "a1ac4f14-84f1-4d4d-8611-fae846c4d7b5",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "„Warum sind Notizen zu einer nie geschriebenen Reportage es wert, veröffentlicht zu werden? […] Zum einen, weil Joan Didion eine überragende Reporterin und Stilistin ist. Ihre knappen, mäandernden Sätze halten alles, was man sich von ihr erhoffen darf.“"
                                            },
                                            {
                                                "example_id": "6bf28713-2e2f-4bea-99f7-7e36345d0dad",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "„Wenige Stunden später wurde über viele Kanäle vermeldet, dass die Musikerin […] an den Folgen einer Krebserkrankung gestorben ist. Mit Geri Allen verliert die Jazz-Gemeinde eine überragende Stilistin – sie muss zweifelsohne zu den bedeutenden Jazz-Pianisten des Nachkriegsjazz gezählt werden.“"
                                            },
                                            {
                                                "example_id": "9f5e5856-aa7e-44b3-9ca7-e36900e17b95",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "[Sidsel Endresen:] „Die SRF-Jazzredaktorin und Sängerin Annina Salis als Gast in der Sendung würdigt die international erfolgreiche Vokalistin und grenzüberschreitende Stilistin zum Geburtstag am 19. Juni.“"
                                            },
                                            {
                                                "example_id": "e722dccc-6de9-4338-a766-06f02b5ad2e3",
                                                "sense_id": "fd211f04-00c1-316b-bfcd-98722a537b4f",
                                                "text": "[Schlagzeile:] „Souveräne Technik, inniger Ausdruck – Die lyrische Sopran-Stilistin - Erinnerungen an Miriam Gauci an der Wiener Staatsoper.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
