            "senses": [
                {
                    "sense_id": "8daad2af-3f7c-3673-b563-0ac0dcd37745",
                    "sense_definition": "Коммерческая организация, предприятие или фирма, созданная для ведения бизнеса.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "business_entity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта строительная <компания> возводит новые дома в центре города.",
                            "target_lang_translations": {
                                "en": "This construction <w>company</w> is building new houses in the city center.",
                                "zh": "这家建筑<w>公司</w>正在市中心建造新房。"
                            }
                        },
                        {
                            "text": "Мой брат работает в крупной международной <компании>.",
                            "target_lang_translations": {
                                "en": "My brother works for a large international <w>company</w>.",
                                "zh": "我哥哥在一家大型国际<w>公司</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "фирма",
                        "предприя́тие",
                        "би́знес",
                        "конто́ра",
                        "организация"
                    ],
                    "common_phrases": [
                        "строительная компания",
                        "страховая компания",
                        "директор компании",
                        "частная компания"
                    ],
                    "target_lang_definitions": {
                        "en": "A commercial organization, enterprise, or firm created to conduct business.",
                        "zh": "为进行商业活动而成立的商业组织、企业或商号。"
                    },
                    "translations": {
                        "en": [
                            {
