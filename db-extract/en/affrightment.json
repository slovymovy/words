                            {
                                "example_id": "4058a47b-7b9c-4d4f-86c4-56275edaec9e",
                                "sense_id": "c6facd80-6034-38d5-9fe4-a7c34ecaa98a",
                                "text": "Passionate words or blows from the tutor, fill the child's mind with terrour and affrightment; which immediately takes it wholly up, and leaves no room for other impressions."
                            },
                            {
                                "example_id": "5d8ca222-e8ab-42d0-b79e-8440670bfe45",
                                "sense_id": "c6facd80-6034-38d5-9fe4-a7c34ecaa98a",
                                "text": "I [looked] at him, when I could glance at him, with disgust little short of affrightment."
                            }
                        ]
