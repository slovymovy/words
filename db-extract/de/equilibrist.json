                "senses": [
                    {
                        "sense_id": "7b2a5012-494e-3b15-b62d-f4aa41c68918",
                        "entry_id": "6701270b-c8c8-3c22-8054-faaaa9aa47e5",
                        "glosses": [
                            "Artist, der kunstvolle Gleichgewichtsübungen vorführt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "d98f5d5f-9a28-4346-9500-00deec63fb6e",
                                "sense_id": "7b2a5012-494e-3b15-b62d-f4aa41c68918",
                                "text": "„Musiker, was konnte das für Walter Murath, dessen Familie an der Moorweide ganze Etagen bewohnte, anderes sein als eine Art Dompteur, der einen Bären mittels eines Nasenrings regiert, ein brotloser Equilibrist, ein Gaukler und fahrender Sänger?“"
                            },
                            {
                                "example_id": "243fd51e-fd08-4e9e-9797-d17303053784",
                                "sense_id": "7b2a5012-494e-3b15-b62d-f4aa41c68918",
                                "text": "„Wie so oft erhebt sich die Frage, weshalb Männer mit ihrer Persönlichkeit oft diffus sind, wie es sein kann, daß sie an einem Obduktionstisch, in einer Küche, hinter einem Hundeschlitten virtuose Equilibristen sein können, während sie, wenn sie einem Fremden die Hand geben müssen, in infantiler Unbeholfenheit versinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
