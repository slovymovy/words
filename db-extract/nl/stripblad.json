                "senses": [
                    {
                        "sense_id": "9d2f2ec0-464f-3b29-a76e-72d82bb28ea8",
                        "entry_id": "82b9442c-eee0-3b2e-9af6-0255748c5d68",
                        "glosses": [
                            "een tijdschrift met stripverhalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff86dc5f-3f1c-47ba-959c-1e74842fc6af",
                                "sense_id": "9d2f2ec0-464f-3b29-a76e-72d82bb28ea8",
                                "text": "De Donald Duck bestaat dit jaar zestig jaar en daarom maakt het stripblad een toer door Nederland. Deze week wordt onder andere het Binnenhof bezocht."
                            },
                            {
                                "example_id": "a8df34cb-8a68-4f8d-aad2-5c3ad882bf4b",
                                "sense_id": "9d2f2ec0-464f-3b29-a76e-72d82bb28ea8",
                                "text": "De groep van ruimschoots tien personen hield begin dit jaar voor het stadhuis een stiltekring na de aanslagen in het Parijse redactiekantoor van het satirische stripblad Charlie Hebdo en een joodse supermarkt in de stad. Schaake: ,,Met de actie vanmiddag willen we onze bezorgdheid tonen over de verdergaande polarisatie in onze samenleving, waardoor bevolkingsgroepen in toenemende mate tegenover elkaar worden gedreven."
                            },
                            {
                                "example_id": "357d70fe-6847-4e55-8391-02c7888860ad",
                                "sense_id": "9d2f2ec0-464f-3b29-a76e-72d82bb28ea8",
                                "text": "De strip van de Heer op Stand en zijn maatje Tom Poes verscheen oorspronkelijk in NRC Handelsblad. De Brabantse las in het verleden - toen ze al lang niet meer in het dagblad verschenen - enkele verhalen in het stripblad Donald Duck."
                            }
                        ]
                    }
