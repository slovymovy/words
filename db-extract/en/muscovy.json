                        ],
                        "examples": [
                            {
                                "example_id": "d3d1536f-d2ab-49c0-b8b8-9f2dc76d78f3",
                                "sense_id": "c96669c6-a2e2-3b65-ac2a-5f8b334f1a73",
                                "text": "The Russian Federation's war against Ukraine is now in its eighth year. Invaders from Muscovy have been attacking Ukrainians in their homeland every day for 2,563 days."
                            }
                        ]
                    }
                ],
