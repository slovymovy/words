                            {
                                "target_lang_word": "s'occuper de",
                                "target_lang_sense_clarification": "prendre en charge les besoins de quelqu'un ou quelque chose"
                            },
                            {
                                "target_lang_word": "entretenir",
                                "target_lang_sense_clarification": "assurer la maintenance de quelque chose"
                            }
                        ]
                    }
