                        "glosses": [
                            "Coteau dans le Languedoc."
                        ],
                        "tags": [
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "3a7e22df-a2e4-45c8-8054-6d6cc1c6eaeb",
                                "sense_id": "411b9cb5-abcf-3a81-a73c-3554cb35d888",
                                "text": "les terres calcaires sont plus ou moins pierreuses et ocreuses ; elles occupent principalement les coteaux ou soubergues."
                            },
                            {
                                "example_id": "3f606b14-b026-492e-8d0f-fe267691fbbf",
                                "sense_id": "411b9cb5-abcf-3a81-a73c-3554cb35d888",
                                "text": "Elle [une voie romaine] a une largeur très-inégale ; dans le soubergue ou coteau, elle varie depuis six jusqu'à douze toises, mais elle est plus uniforme dans la plaine, où elle se tient constamment entre deux et trois toises."
                            },
                            {
                                "example_id": "40aa41e5-ecd1-4ee3-9098-b0ed98022bf5",
                                "sense_id": "411b9cb5-abcf-3a81-a73c-3554cb35d888",
                                "text": "C'est au cours du XVIIIᵉ siècle que les vignes colonisèrent les soubergues (coteaux) des Cévennes aux sols de fine terre rouge riches en silex mais aussi des cailloutis."
                            },
                            {
                                "example_id": "983725bf-5aa2-413a-8148-92d08f63c667",
                                "sense_id": "411b9cb5-abcf-3a81-a73c-3554cb35d888",
                                "text": "Les parcellaires des soubergues et de la garrigue, très anciennement colonisés, sont le domaine exclusif de la petite propriété paysanne."
                            }
                        ]
                    }
