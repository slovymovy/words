                "senses": [
                    {
                        "sense_id": "f4fbee26-fa96-3d62-823b-5dc59b0448df",
                        "entry_id": "e2b189e8-b5ed-3b46-9f7f-35b4023f7493",
                        "glosses": [
                            "Béatifier (déclarer bienheureux)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd56aa2-f16a-49d8-be36-6316134ff484",
                                "sense_id": "f4fbee26-fa96-3d62-823b-5dc59b0448df",
                                "text": "car, selon la doctrine commune des théologiens, il n’y a pas d’autre différence considérable entre béatiser un saint et le canoniser, sinon que la béatification est une concession et un octroi en forme d’induit ou de grâce, qui accorde aux fidèles la liberté d’appeler quelqu’un saint, de le prier publiquement dans l’église, de faire son panégyrique comme d’un bienheureux, d’en réciter l’office, honorer ses reliques, et en faire la fête ;"
                            },
                            {
                                "example_id": "8f90826c-8e26-48ae-81e6-5492da7f3259",
                                "sense_id": "f4fbee26-fa96-3d62-823b-5dc59b0448df",
                                "text": "Ils se sont fait béatiser."
                            }
                        ]
                    }
