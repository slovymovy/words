                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c52dba-6b99-4b4e-9c43-6b737053eecb",
                                "sense_id": "ac860d66-9865-3c10-9bba-7ab22a1c45e7",
                                "text": "„Das Unterland umfasst den gesamten politischen Bezirk Dornbirn und alle Gebiete des Bezirks Bregenz, die im Rheintal liegen.“"
                            }
                        ],
