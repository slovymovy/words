                        "glosses": [
                            "Personne l’on désire gifler ; individu qui mérite des gifles."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e7141f62-186f-41ae-87a1-5ee2f8b39282",
                                "sense_id": "e36bf8c6-3466-3903-9a8a-1d1a4954be66",
                                "text": "J'ai pu désarmer de Groux qui mourait d'envie de le gifler. A quoi bon? II y a deux Rosny, dont l'un n'a jamais été vu par personne. On ne sait qui est le décoré, qui est le membre, qui est le giflable."
                            }
                        ]
