                        ],
                        "form": "die Tageszeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                        "entry_id": "64609691-7ed4-38b9-bf89-c228ac08700b",
                        "glosses": [
                            "die Zeit, ein Zeitpunkt oder ein Zeitabschnitt an einem Tage, tagsüber ( bei Tageslicht)"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "c651862f-af5a-4ad4-8e23-de2f54c5f499",
                                "sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                                "text": "Zu dieser Tageszeit ist es unangebracht, Besuche zu machen."
                            },
                            {
                                "example_id": "49655a48-dde8-4c0a-b879-53f006dacada",
                                "sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                                "text": "„Wir gingen zwischen dicht gedrängten Rundhütten hindurch, die in den letzten Sonnenstrahlen glühten, und mir fiel auf, dass die winzigen Sprünge und Risse im Lehm zu dieser Tageszeit erstaunlich lange Schatten warfen.“"
                            },
                            {
                                "example_id": "10be1449-5406-4dcc-b403-e524b20c3fc0",
                                "sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                                "text": "„Dieser war ein adliger Venezianer aus der heute erloschenen Familie Lin, ein Sechzigjähriger, der sich zu allen Tageszeiten bei ihr aufhielt.“"
                            },
                            {
                                "example_id": "fe2c3243-db36-4678-beda-29ee6b24543e",
                                "sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                                "text": "„Die Männer gingen schnell an die Arbeit, um die kurze Tageszeit noch auszunutzen.“"
                            },
                            {
                                "example_id": "57e509f7-2fa6-45a0-b736-0613b7547c4f",
                                "sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                                "text": "„Die Kriegsjahre in Frankreich und die Hungerjahre der Emigration hatten ein unersättliches Loch in mir hinterlassen; ich konnte zu jeder Tageszeit essen, und es war mir gleich, was.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1420c70-982f-4917-93d8-81021b59f1d6",
                        "source_entry_id": "64609691-7ed4-38b9-bf89-c228ac08700b",
                        "source_sense_id": "fe4317ab-c64a-3c2a-a58c-d6e30cddf0be",
                        "source_sense_description": "die Zeit, ein Zeitpunkt oder ein Zeitabschnitt an einem Tage, tagsüber",
                        "target_lang_word": "time of day",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "time of day",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52f47f02-f57e-34ed-87d9-aff3470bff6f",
                                        "entry_id": "5f263d55-d5c2-3454-8cf3-56649ecf89bd",
                                        "glosses": [
                                            "The time according to the clock."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cacc000-b32b-3f1b-97fe-74b346e65815",
                                        "entry_id": "5f263d55-d5c2-3454-8cf3-56649ecf89bd",
                                        "glosses": [
                                            "A loosely specified period of time, minutes or hours in duration, especially daytime, or point in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feba7f5d-3939-44b4-821e-698fd6407d57",
                                                "sense_id": "6cacc000-b32b-3f1b-97fe-74b346e65815",
                                                "text": "\"At what time of day and year are the winds strongest?\" / \"Winter mornings, I think, or maybe at day’s end.\""
                                            },
                                            {
                                                "example_id": "2967b6f1-b7c3-40bf-9774-a5a9f4a5b9ab",
                                                "sense_id": "6cacc000-b32b-3f1b-97fe-74b346e65815",
                                                "text": "She would fold laundry at this time of day."
                                            },
                                            {
                                                "example_id": "63a9cd2a-1b86-40e2-95b8-82ed1d103c85",
                                                "sense_id": "6cacc000-b32b-3f1b-97fe-74b346e65815",
                                                "text": "I love that time of day. The light is magical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ab01992-2e43-3ecb-a1f9-931eae837b96",
                                        "entry_id": "5f263d55-d5c2-3454-8cf3-56649ecf89bd",
                                        "glosses": [
                                            "The greeting appropriate to the time of day."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9217098d-bdc6-3974-9d7a-509ff07f842d",
                                        "entry_id": "5f263d55-d5c2-3454-8cf3-56649ecf89bd",
                                        "glosses": [
                                            "era: time; day."
                                        ],
                                        "tags": [
                                            "dated",
                                            "dialectal",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c3f2c07-9f5b-441a-995a-dd94d4bd05f2",
                                                "sense_id": "9217098d-bdc6-3974-9d7a-509ff07f842d",
                                                "text": "that's how it was in that time of day [ = at that time, back in that day]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b1ac2a-f9fd-32f8-bd72-9df4b4c0f95b",
                                        "entry_id": "5f263d55-d5c2-3454-8cf3-56649ecf89bd",
                                        "glosses": [
                                            "The right thing; the ticket; that which is needed."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7a28e16-1649-46a7-9e8d-f2aa747cb58a",
                                                "sense_id": "c0b1ac2a-f9fd-32f8-bd72-9df4b4c0f95b",
                                                "text": "‘Never mind me, Sir,’ replied Sam. ‘Lend him a hand, Mr. Winkle, sir. Steady, sir, steady! That’s the time o’ day!’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
