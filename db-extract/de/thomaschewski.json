                ],
                "senses": [
                    {
                        "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                        "entry_id": "1cd00a39-7c72-3276-93f7-21ba6a57b1e1",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee4b2de-101f-4ff7-868b-808e04913566",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Frau Thomaschewski ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fe2eb274-3b08-444a-b60f-da990482d8c6",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Herr Thomaschewski wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4806fdd7-0107-40b0-abb7-048e5f9db048",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Die Thomaschewskis fahren heute ins Erzgebirge."
                            },
                            {
                                "example_id": "975b2d4a-d35e-4315-ae66-f88dd6b7958b",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Der Thomaschewski trägt nie die Schals, die die Thomaschewski ihm strickt."
                            },
                            {
                                "example_id": "928d1c90-b54e-4f95-a08c-3299214dbc5f",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thomaschewski kommt, geht der Herr Thomaschewski.“"
                            },
                            {
                                "example_id": "b407e3b4-0bff-439c-a7da-f9ff4680048d",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Thomaschewski kommt und geht."
                            },
                            {
                                "example_id": "2cea3045-695e-4473-a685-6ee18523922e",
                                "sense_id": "614a9872-89f3-3847-8b85-da69a4e6f3a6",
                                "text": "Thomaschewskis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
