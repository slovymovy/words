                        "examples": [
                            {
                                "example_id": "56483873-efb6-4296-86ca-0a172ae056ae",
                                "sense_id": "a30c0679-82c0-3a6c-a5cd-9a9dc3434a02",
                                "text": "De Franse presidentsverkiezingen bestaan uit één of twee stemrondes."
                            },
                            {
                                "example_id": "d95db9c6-b3d5-457c-a143-25f5eb7f9a8f",
                                "sense_id": "a30c0679-82c0-3a6c-a5cd-9a9dc3434a02",
                                "text": "Doordat François Hollande afzag van een nieuwe kandidatuur „wordt de partij van de president in de verkiezingen vertegenwoordigd door een tegenstander”, zei Bayrou, doelend op PS-kandidaat Benoît Hamon. De centrum-rechtse Republikeinen van François Fillon, worden geplaagd door affaires „die niet alleen het bestaan van privileges laten zien, maar ook de acceptatie van dit misbruik”. Het risico dat in de tweede stemronde in mei een zwakke kandidaat tegenover Marine Le Pen van het nationaal-populistische Front National komt te staan is Bayrou te groot."
                            }
                        ]
