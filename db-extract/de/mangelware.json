                "senses": [
                    {
                        "sense_id": "22210dc5-741c-3b82-a9ae-3e2a0d521487",
                        "entry_id": "0043f063-28f2-3bbd-a55e-e188a3e95d6f",
                        "glosses": [
                            "Ware (oder Dienstleistung), deren Produktions- oder Absatzmenge nicht ausreichend ist, um die bestehende Nachfrage (oder auch nur die grundlegenden Bedürfnisse) der potenziellen Käufer abzudecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f64ade-a23b-4d4a-af75-a22d6c414ec0",
                                "sense_id": "22210dc5-741c-3b82-a9ae-3e2a0d521487",
                                "text": "Wenn wichtige Lebensmittel zur Mangelware werden, kann es zu Unruhen in der Bevölkerung kommen."
                            },
                            {
                                "example_id": "c04e57ca-d49a-449e-a82c-4136b979896c",
                                "sense_id": "22210dc5-741c-3b82-a9ae-3e2a0d521487",
                                "text": "„Elektrische Kochplatten waren ohnedies Mangelware auf dem schwarzen Markt.“"
                            },
                            {
                                "example_id": "1188012c-b0e7-43e7-83f9-b6345d079c20",
                                "sense_id": "22210dc5-741c-3b82-a9ae-3e2a0d521487",
                                "text": "„Zum einen zahlte Thomas immer gute Preise, zum anderen verschaffte er Mangelware aus der Stadt…“"
                            },
                            {
                                "example_id": "00086436-904b-448b-aeb6-72d27fb07c2a",
                                "sense_id": "22210dc5-741c-3b82-a9ae-3e2a0d521487",
                                "text": "„Ähnlich wie fast im gesamten Nachkriegseuropa war Kaffee in der Sowjetischen Besatzungszone nach 1945 Mangelware.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93010b30-ef4d-3577-b693-6db9ef3f92d1",
                        "entry_id": "0043f063-28f2-3bbd-a55e-e188a3e95d6f",
                        "glosses": [
                            "der subjektiv empfundene (räumlich und/oder zeitlich begrenzte) Mangel an einer Ware, dem Auftreten von speziellen Ereignissen oder Mitgliedern einer bestimmten Personengruppe"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "10f10700-2948-445f-b1dd-b86e39935992",
                                "sense_id": "93010b30-ef4d-3577-b693-6db9ef3f92d1",
                                "text": "In einem Spiel zwischen annähernd gleich starken Fußballmannschaften können Tore schon einmal Mangelware sein."
                            },
                            {
                                "example_id": "bc63896b-6492-47e9-ad26-d0cb355e64d7",
                                "sense_id": "93010b30-ef4d-3577-b693-6db9ef3f92d1",
                                "text": "In Diskotheken in ländlichen Gebieten sind neue Gesichter meist eher Mangelware."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
