                ],
                "senses": [
                    {
                        "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                        "entry_id": "40dcc5e0-06c5-3b89-a6c0-de9b4d2031a9",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691483e9-9271-4f3e-adf8-d3af65dda36c",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Frau Franznick ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cfb62aeb-9b40-4c0c-a188-f8374c995002",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Herr Franznick wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cefc4931-1806-46b6-97c7-0ec1c362332f",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Die Franznicks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c80fb6b3-4a9b-4da4-9867-ccdf788b80a6",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Der Franznick trägt nie die Schals, die die Franznick ihm strickt."
                            },
                            {
                                "example_id": "7d2894e1-b26c-4b7a-84c6-a597b18ab072",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Franznick kommt, geht der Herr Franznick.“"
                            },
                            {
                                "example_id": "543b1611-5ca3-4f1f-88c9-3eac7c79285c",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Franznick kommt und geht."
                            },
                            {
                                "example_id": "54b9f4c4-a61f-42e2-8b63-878eb464dff6",
                                "sense_id": "72cef889-3dc8-3692-8ac8-0f2c543abd6a",
                                "text": "Franznicks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
