        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0625ec69-04b5-305e-8357-c5377836dacb",
                    "sense_definition": "iemand die voortdurend en op een informele manier praat",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die kleine <w>kwebbel</w> houdt nooit haar mond tijdens de les.",
                            "target_lang_translations": {
                                "en": "That little <w>chatterbox</w> never shuts her mouth during class."
                            }
                        },
                        {
                            "text": "Mijn tante is een echte <w>kwebbel</w> die alles wil weten.",
                            "target_lang_translations": {
                                "en": "My aunt is a real <w>chatterbox</w> who wants to know everything."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwek",
                        "teut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a talkative person"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "someone who talks constantly and in an informal way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chatterbox",
                                "target_lang_sense_clarification": "a person who talks a lot"
                            },
                            {
                                "target_lang_word": "windbag",
                                "target_lang_sense_clarification": "a person who talks at length but says little of value"
                            },
                            {
                                "target_lang_word": "babbler",
                                "target_lang_sense_clarification": "someone who talks incoherently or incessantly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "584b599d-695a-35cd-9d69-e152d14aef06",
                    "sense_definition": "een informele of spottende aanduiding voor de mond",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lichaamsdeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hou je <w>kwebbel</w> toch eens als ik aan het praten ben!",
                            "target_lang_translations": {
                                "en": "Shut your <w>trap</w> for once while I am talking!"
