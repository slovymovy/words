            {
                "entry_id": "503a25b0-81bf-34a8-a43e-543191c3ec75",
                "word": "manilla",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "68b11c0c-45ae-3452-9e62-e1bee4735f79",
                        "entry_id": "503a25b0-81bf-34a8-a43e-543191c3ec75",
                        "glosses": [
                            "vezels gewonnen uit de abaca Musa textilis, die sterk zijn en goed tegen zeewater kunnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc6ae413-6900-43f6-a285-45640c76ed5c",
                                "sense_id": "68b11c0c-45ae-3452-9e62-e1bee4735f79",
                                "text": "Stoomtouwslagerijen (in Oudewater in 1882) deden met nieuwe technieken en andere, exotische, grondstoffen als manilla en sisal, hun intrede."
                            }
                        ]
                    },
                    {
                        "sense_id": "5389249a-6b74-3759-85f8-1209f4078929",
                        "entry_id": "503a25b0-81bf-34a8-a43e-543191c3ec75",
                        "glosses": [
                            "touw gemaakt uit vezels van de abaca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a38773a4-9aa1-48ad-91c8-cfc46b7c0f67",
                                "sense_id": "5389249a-6b74-3759-85f8-1209f4078929",
                                "text": "Ook in het touwwerk vond hij verscheidenheid, het oude, veelgeteerde van hennepgaren, splinternieuw manilla, een zeker helderwit slag dat hij nooit gezien had."
                            }
                        ]
                    }
                ],
