                                        "glosses": [
                                            "Characterising people who are unconcerned with worldly matters; spiritually minded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7a0fcc6-bf98-4662-99ec-068894b46e59",
                                                "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                                "text": "‘But a good wife—a good unworldly woman—may really help a man, and keep him more independent.’"
                                            },
                                            {
                                                "example_id": "a14859cd-ba13-4ad5-81ca-45cff2cfdee6",
                                                "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                                "text": "I am an aspiring theological writer-artist, Alien Christian Mystic, unworldly, contemplative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9dc3a8-e609-3ae9-a937-2afd786d3e38",
                                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                                        "glosses": [
                                            "Not belonging to this world; celestial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f790261d-5ad8-4d2b-ae6c-3cb395dd55f1",
                                                "sense_id": "4d9dc3a8-e609-3ae9-a937-2afd786d3e38",
                                                "text": "This creature from a higher world has not forgotten all that he knew before; he retains his unworldly talents and supreme intelligence."
                                            }
