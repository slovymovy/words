                "senses": [
                    {
                        "sense_id": "d5334a2e-21a7-3014-b122-a37edb296af7",
                        "entry_id": "f91ed28d-7817-3538-b6df-d6e514283486",
                        "glosses": [
                            "Institut, das Forschung betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f61ae93e-33f7-436a-a896-9528dce78a4e",
                                "sense_id": "d5334a2e-21a7-3014-b122-a37edb296af7",
                                "text": "„Erstmals seit etwa 150 Jahren ist wieder ein Wolf in Baden-Württemberg nachgewiesen worden. Eine DNA-Untersuchung des Forschungsinstituts Senckenberg zeigt: Ein Tier, das vor zwei Wochen im Schwarzwald überfahren worden war, war tatsächlich ein Wolf. Das teilte der Naturschutzminister des Bundeslandes, Alexander Bonde (Grüne), in Stuttgart mit.“"
                            },
                            {
                                "example_id": "6d6fee36-5113-4e1f-bb09-e7051c9edf88",
                                "sense_id": "d5334a2e-21a7-3014-b122-a37edb296af7",
                                "text": "„Dies geht aus einer Analyse der neuesten statistischen Daten für 2008 durch das Forschungsinstitut empirica im Auftrag der Landesbausparkassen (LBS) hervor.“"
                            },
                            {
                                "example_id": "27b3b3bf-993e-485c-961f-6038bd79a491",
                                "sense_id": "d5334a2e-21a7-3014-b122-a37edb296af7",
                                "text": "„Sicher, kaum ein Forschungsinstitut hatte ein solches Budget für Neuaquisen wie die British Library.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
