    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                "word": "nativism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b246c6c5-4b9b-4264-8431-5505719ac7fa",
                        "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "tags": [
                            "plural"
                        ],
                        "form": "nativisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bb7f0e7-0481-34c4-ae8f-313ab404882a",
                        "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "glosses": [
                            "A policy of favoring native-born inhabitants over immigrants."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6db81843-70f1-46f6-9beb-7e472383c704",
                                "sense_id": "0bb7f0e7-0481-34c4-ae8f-313ab404882a",
                                "text": "To understand just how rare, look back into history to, say, the Johnson Act of 1924. Its national-origins quota system reverberated with nativism and racism."
                            },
                            {
                                "example_id": "ebcf7528-921c-40f4-a0f8-e4af6afeb069",
                                "sense_id": "0bb7f0e7-0481-34c4-ae8f-313ab404882a",
                                "text": "If there is to be another iteration of a Trump presidency, or a successful campaign by one of his acolytes, the scientific denial may be dialed down somewhat while retaining the reflex nativism."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e9f8386-4c31-3462-8947-337c77656dc8",
                        "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "glosses": [
                            "The policy of perpetuating the culture of the natives of a colonised country."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d86ba038-3727-33cb-82b0-bfbe0592a266",
                        "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "glosses": [
                            "A cultural element that is native to a colonised country."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "c73d0404-63f6-4a00-9b94-c0d5e197001a",
                                "sense_id": "d86ba038-3727-33cb-82b0-bfbe0592a266",
                                "text": "The Columbian Exchange was proof like no other of how, when it comes to food, so often the venue of our greatest nativisms, we, as human beings, easily slip the ties of belonging."
                            }
                        ]
                    },
                    {
                        "sense_id": "1806debe-583a-3135-98f9-8eae8577ad32",
                        "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "glosses": [
                            "The doctrine that some skills or abilities are innate and not learned."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f617c5a-17d3-32dd-ad48-570e87eacf7a",
                        "entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "glosses": [
                            "A theory that some knowledge of grammar is innate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "239ea49d-56fe-4d17-96e4-8490e8018f92",
                        "source_entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "source_sense_description": "Translations",
                        "target_lang_word": "nativisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nativisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8023d45-ec2b-3d4b-8f0c-bb5911f6fc8a",
                                        "entry_id": "6734b359-bf25-31bb-a40a-1c693fe9408d",
                                        "glosses": [
                                            "Idéologie ou courant politique qui valorise les natifs d’un pays et s’oppose aux immigrants, perçus comme une menace pour l’identité nationale ou culturelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43315660-b396-4918-986c-d4d9e01b2b2d",
                                                "sense_id": "c8023d45-ec2b-3d4b-8f0c-bb5911f6fc8a",
                                                "text": "Selon la définition classique de Higham, le nativisme est une « intense opposition à une minorité interne en raison de ses liens avec l’étranger », autrement dit, « un nationalisme de type défensif »."
                                            },
                                            {
                                                "example_id": "56fcfcf2-1d9f-4964-a97b-a995606a8e36",
                                                "sense_id": "c8023d45-ec2b-3d4b-8f0c-bb5911f6fc8a",
                                                "text": "Une bonne partie de son succès politique vient de l’exploitation de divisions et de préjugés, qu’il s’agisse de racisme, de nativisme ou de misogynie."
                                            },
                                            {
                                                "example_id": "e461bea9-c103-46c2-87f6-cc716eb49938",
                                                "sense_id": "c8023d45-ec2b-3d4b-8f0c-bb5911f6fc8a",
                                                "text": "Au fond, ce qui distingue le national-populisme des autres courants politiques touche beaucoup moins à ses positions sur le terrain de la démocratie et du règne de la loi qu’à la mise en place d’un « nativisme radical » enraciné dans une approche ethno-pluraliste du protectionnisme culturel, où les cultures et les ethnicités sont considérées comme largement incompatible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77a3dd70-8ae7-3366-a09c-2cee54bb1215",
                                        "entry_id": "6734b359-bf25-31bb-a40a-1c693fe9408d",
                                        "glosses": [
                                            "Théorie selon laquelle certaines structures cognitives, comme la perception de l’espace ou du temps, sont innées et non acquises par l’expérience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38a7d47a-c40c-4167-99a1-998e012f12e4",
                        "source_entry_id": "4dbdd4f1-4451-3b03-95d7-bd394e4e7127",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Nativismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nativismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b89cd75-74eb-30e5-b8a9-c7eb781da6fa",
                                        "entry_id": "ca319c93-ed84-31b3-a5b2-da363d12b498",
                                        "glosses": [
                                            "Hypothese, wesentlich vertreten von Noam Chomsky, dass erhebliche Teile der Sprachstruktur, die ein Kind zu beherrschen lernen muss, angeboren sind und daher zwar ausgelöst, aber nicht erlernt werden müssen. Es handelt sich dabei um die Tiefenstruktur der Sprachen, die als universell (in allen Sprachen gleich) aufgefasst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb29c76-462a-4b51-a2d7-c7119640eb5f",
                                                "sense_id": "0b89cd75-74eb-30e5-b8a9-c7eb781da6fa",
                                                "text": "Die Hypothese, die den Nativismus ausmacht, widerspricht der (vor allem behavioristischen) Auffassung, dass Sprache erlernt werden muss."
                                            },
                                            {
                                                "example_id": "fcf008f0-a7e7-48ce-93b9-ebc2e394cb2b",
                                                "sense_id": "0b89cd75-74eb-30e5-b8a9-c7eb781da6fa",
                                                "text": "Nativismus war eine leitende Hypothese der frühen generativen Transformationsgrammatik und wird heute mit einiger Skepsis gesehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
