                        "sense_id": "944e2c04-a6f4-3bce-a9ee-0b811559d348",
                        "entry_id": "3286ce8b-3d80-3726-a3a9-4a7eccc8e727",
                        "glosses": [
                            "een grote winkel, vaak met meerdere verdiepingen, die een uitgebreid assortiment aan goederen verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6311d084-c62e-4d79-bc1a-bcf9c7376947",
                                "sense_id": "944e2c04-a6f4-3bce-a9ee-0b811559d348",
                                "text": "Een voorbeeld van een warenhuis is de Bijenkorf."
                            },
                            {
                                "example_id": "5e95da29-a7d1-4478-a2d4-a86e48a3c37a",
                                "sense_id": "944e2c04-a6f4-3bce-a9ee-0b811559d348",
                                "text": "De warenhuizen van V&D waren al jaren verlieslijdend. In het laatste niet afgeronde boekjaar, van februari tot en met november vorig jaar, dook de keten bijna 49 miljoen euro in de rode cijfers. Restaurantketen La Place maakte wel winst, met een bedrijfsresultaat van dik 1 miljoen euro, blijkt uit het verslag."
                            },
                            {
                                "example_id": "90966941-668b-4740-809e-d0ad5c752f51",
                                "sense_id": "944e2c04-a6f4-3bce-a9ee-0b811559d348",
                                "text": "De centrale ligging zou heel goed geschikt zijn voor een nieuw warenhuis."
                            }
                        ]
                    }
