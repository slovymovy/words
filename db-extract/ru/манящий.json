                "senses": [
                    {
                        "sense_id": "9521da1d-3221-3128-9740-1ce5340e2d33",
                        "entry_id": "9df3c217-6484-35fa-9f80-b5dd8963ba74",
                        "glosses": [
                            "привлекающий к себе, заманчивый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db83369-3999-4389-9a2e-00847548fb9c",
                                "sense_id": "9521da1d-3221-3128-9740-1ce5340e2d33",
                                "text": "Манящий женский взгляд порой способен лучше всяких слов сказать мужчине, что пора переходить к более решительным действиям."
                            },
                            {
                                "example_id": "5dd115f4-648d-4b4b-97c0-6bb9a69cfb85",
                                "sense_id": "9521da1d-3221-3128-9740-1ce5340e2d33",
                                "text": "И стала представляться ему чаще забытая им Италия, вдали, в каком-то манящем свете .."
                            }
                        ]
                    }
                ],
