                        "cross_references": [
                            {
                                "target_word": "Waterloo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84650cf3-ad42-3f1e-a706-e8b6e3169d11",
                                        "entry_id": "32482f47-7a9b-3bc4-8317-4bf277ad0848",
                                        "glosses": [
                                            "Commune et ville de la province du Brabant wallon de la région wallonne de Belgique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fdb4a2-7842-406b-b8e8-70e2b3bef3e0",
                                                "sense_id": "84650cf3-ad42-3f1e-a706-e8b6e3169d11",
                                                "text": "Pour notre testing de quatre sauces bolognaises industrielles en bocal, nous nous sommes rendus dans un restaurant italien réputé de Waterloo, le Felicità."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "025f3c32-f7d9-312b-8be5-848e5210a848",
                                        "entry_id": "32482f47-7a9b-3bc4-8317-4bf277ad0848",
                                        "glosses": [
                                            "Bataille qui s’y déroula, entre les armées napoléoniennes et une coalition de pays européens, le 18 juin 1815."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ea4dcb9-14ce-4802-a350-29a655641288",
                                                "sense_id": "025f3c32-f7d9-312b-8be5-848e5210a848",
                                                "text": "Qui oserait blasphémer contre cette sublime épopée, qui commence à Valmy, et qui se déroule, en traits de feu, jusqu’à la sombre catastrophe de Waterloo ; épopée qui débute par un hymne de triomphe, et qui se ferme sous les plaintes d’une douloureuse élégie ?"
                                            },
                                            {
                                                "example_id": "69967cc8-b6b6-4848-b937-668485785f3e",
                                                "sense_id": "025f3c32-f7d9-312b-8be5-848e5210a848",
                                                "text": "Moins que les soldats ou les peuples, il voit des victoires ennemies se précipiter l’une contre l’autre, Wattignies contre Sedan, Denain contre Waterloo."
                                            },
                                            {
                                                "example_id": "6e5e270f-31f9-439e-aa82-fa11768e4986",
                                                "sense_id": "025f3c32-f7d9-312b-8be5-848e5210a848",
                                                "text": "Car, si Waterloo n’est pas la bataille la plus sanglante de l’épopée napoléonienne, qui en compte tant, si elle oppose un stratège isolé et finissant à une coalition européenne infiniment plus puissante, elle reste l’acmé du drame, le combat suprême qui causa la perte de l’homme qui, depuis quinze ans, faisait trembler le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca9ef04-f9e1-3937-b76d-c99a60046a72",
                                        "entry_id": "32482f47-7a9b-3bc4-8317-4bf277ad0848",
                                        "glosses": [
                                            "Défaite cuisante et définitive."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9457518c-841e-4b79-bd89-0f4ec1f41b62",
                                                "sense_id": "aca9ef04-f9e1-3937-b76d-c99a60046a72",
                                                "text": "Manuel Valls va-t-il connaître bientôt son Waterloo ?"
                                            },
                                            {
                                                "example_id": "ebf636d6-8edc-48fc-926c-3f70be0a7ac5",
                                                "sense_id": "aca9ef04-f9e1-3937-b76d-c99a60046a72",
                                                "text": "Moi j’aurais bien aimé un peu plus de tendresse\nOu alors un sourire ou bien avoir le temps…\nMais « Au suivant! Au suivant! »\nCe ne fut pas Waterloo, mais ce ne fut pas Arcole;\nCe fut l’heure où l’on regrette d’avoir manqué l’école."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581fb612-f30b-32fe-8bf2-b05188c0f5e8",
                                        "entry_id": "32482f47-7a9b-3bc4-8317-4bf277ad0848",
                                        "glosses": [
                                            "Ville canadienne du Québec située dans la MRC de La Haute-Yamaska."
                                        ],
