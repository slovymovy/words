                            {
                                "example_id": "7d4ca002-d946-40ff-9b99-10a738bd63e4",
                                "sense_id": "ebaa4ede-36c1-39c6-9a2d-21697419a967",
                                "text": "Baltimore was a seat of one of Ireland's most ancient dynasties, the Corcu Loígde, former Kings of Tara and Kings of Munster."
                            }
                        ]
                    },
                    {
                        "sense_id": "781c4827-79d4-3d2a-931e-64b1b947cc32",
                        "entry_id": "7b403698-8ca7-3149-ac89-90858767883f",
