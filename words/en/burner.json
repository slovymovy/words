                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фейковый аккаунт",
                                "target_lang_sense_clarification": "для анонимности"
                            },
                            {
                                "target_lang_word": "твинк",
                                "target_lang_sense_clarification": "дополнительный аккаунт"
                            }
                        ]
