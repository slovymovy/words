                        "glosses": [
                            "Brasser le tangon moins que la normale."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "d697a7e8-86e6-42aa-91cd-8aea3caf3705",
                                "sense_id": "36580f8f-a9fb-3ec0-b122-b36a3900012b",
                                "text": "Sous-brasser le tangon pour avoir une poussée plus latérale."
                            }
                        ]
                    },
                    {
                        "sense_id": "32fa9152-2253-3c41-9fd3-a08b88ae3e23",
                        "entry_id": "30ea904d-1742-3d76-8f7c-af880e961c9a",
                        "glosses": [
                            "Brasser insuffisamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a0650e-b48e-420d-9fd7-fcd9276ee2d7",
                                "sense_id": "32fa9152-2253-3c41-9fd3-a08b88ae3e23",
                                "text": "ne pas surpeupler, ne pas sous-écumer, sous-brasser, sous-éclairer, sur-nourrir, etc."
                            },
                            {
                                "example_id": "a8d47631-d169-48ad-b069-0f39269de1cb",
                                "sense_id": "32fa9152-2253-3c41-9fd3-a08b88ae3e23",
                                "text": "Il vaut mieux sur-brasser que sous-brasser en faisant attention aux coraux les plus fragiles."
                            }
                        ]
