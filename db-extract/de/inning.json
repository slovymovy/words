                        "entry_id": "e8817b62-3492-31f0-a730-2da7e329bd2f",
                        "glosses": [
                            "Abschnitt in einem Spiel, bei dem jede der beiden Mannschaften einmal Schlagmannschaft und einmal Feldmannschaft ist"
                        ],
                        "tags": [
                            "Baseball",
                            "Softball"
                        ],
                        "examples": [
