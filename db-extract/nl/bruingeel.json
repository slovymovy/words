                "senses": [
                    {
                        "sense_id": "3030b31c-536e-3974-a96f-4f580c5c220f",
                        "entry_id": "4c5dbe08-3a9b-35be-8eb8-a3a14db79216",
                        "glosses": [
                            "met een kleur die tussen geel en bruin in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a43e7c4-c5fd-405c-a9f2-e7d976afc40d",
                                "sense_id": "3030b31c-536e-3974-a96f-4f580c5c220f",
                                "text": "„Ik ben inmiddels gestopt met roken”, mailt Remko Weijer uit Utrecht, „maar nog altijd vraag ik me af waarom de filters van de meeste sigaretten allemaal hetzelfde uiterlijk hebben: namelijk bruingeel met vooral een kenmerkende korrel in het ontwerp.”"
                            },
                            {
                                "example_id": "eab6453a-57a3-4657-94e1-0f0a5aa53be4",
                                "sense_id": "3030b31c-536e-3974-a96f-4f580c5c220f",
                                "text": "Theo Durenkamp uit Amsterdam heeft al jaren last van mysterieuze vlekken die hij ’zonnespetters’ noemt. De bruingele druppels lijken spontaan uit de hemel te vallen en zijn moeilijk weg te poetsen."
                            },
                            {
                                "example_id": "22de834a-607f-485a-b7f6-0f82dc4c0cc7",
                                "sense_id": "3030b31c-536e-3974-a96f-4f580c5c220f",
                                "text": "De aanhoudende droogte heeft veel grasstroken en parken veranderd in bruingele steppes. De onderzoekers gebruiken satellietbeelden van het Netherlands Space Office om de gevolgen voor de groenheid van het gras in kaart te brengen. Ook de uitgedroogde parken in Amsterdam zijn goed te zien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d007e338-ed92-4849-9df0-6aa405d5192d",
                        "source_entry_id": "4c5dbe08-3a9b-35be-8eb8-a3a14db79216",
