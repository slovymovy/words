                            }
                        },
                        {
                            "text": "We were startled by the angry <w>bawling</w> coming from the street below.",
                            "target_lang_translations": {
                                "nl": "We schrokken van het boze <w>gebrul</w> dat van de straat beneden kwam."
                            }
