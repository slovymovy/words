                "senses": [
                    {
                        "sense_id": "47898146-40c7-3e83-8467-32d6df92ffa7",
                        "entry_id": "b6d398aa-2b55-30c3-a906-2ea498d7d1e4",
                        "glosses": [
                            "ein zur Erinnerung an bestimmte Dinge oder Personen helfendes Objekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f15ea596-2fb8-43c3-a8e3-a631735a2802",
                                "sense_id": "47898146-40c7-3e83-8467-32d6df92ffa7",
                                "text": "»Als Gedächtnisstütze im Geschichtsunterricht, um nicht zu vergessen, wann Rom gegründet wurde, habe ich mir gemerkt: Sieben, fünf, drei – Rom schlüpft aus dem Ei.«"
                            },
                            {
                                "example_id": "c5ddd6b9-4c02-4077-8b82-46eb0ad2494d",
                                "sense_id": "47898146-40c7-3e83-8467-32d6df92ffa7",
                                "text": "Für ein gutes Referat ist es von Nöten, eine zuverlässige und einfache Gedächtnisstütze zu haben, weshalb viele einen Stichwortzettel benutzten."
                            },
                            {
                                "example_id": "06c498d3-f188-4334-9d4c-9a45190bdc31",
                                "sense_id": "47898146-40c7-3e83-8467-32d6df92ffa7",
                                "text": "„Renate legte als Gedächtnisstütze eine Liste an, von wem sie was gekriegt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
