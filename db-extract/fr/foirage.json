                "senses": [
                    {
                        "sense_id": "56c4941d-0a03-3472-bb55-08065c5dc9bd",
                        "entry_id": "675e319f-f9a5-397c-abb7-3d17b03c883f",
                        "glosses": [
                            "Échec ; ratage."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0c0c6996-ac27-43d5-9b08-e3b97363add6",
                                "sense_id": "56c4941d-0a03-3472-bb55-08065c5dc9bd",
                                "text": "Je n'ai aucune envie de tricher, d'inventer une romance où j'aurais le rôle flatteur de l'amoureux triomphant ; parallèlement, lui présenter mon idylle comme un foirage complet risquerait de voiler l'image du macho insubmersible à laquelle il est attaché."
                            },
                            {
                                "example_id": "4aa19474-732f-4ffe-b1d7-6f8e0f5588d3",
                                "sense_id": "56c4941d-0a03-3472-bb55-08065c5dc9bd",
                                "text": "D’un point de vue de sécurité opérationnelle, c’est le plus grand foirage possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "852c1ef9-b0b8-3959-a8ef-d35d368b67bc",
                        "entry_id": "675e319f-f9a5-397c-abb7-3d17b03c883f",
                        "glosses": [
                            "Avancement particulièrement rapide d'un glacier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754373e6-d843-4624-93b9-377f656a16b5",
                                "sense_id": "852c1ef9-b0b8-3959-a8ef-d35d368b67bc",
                                "text": "Il peut se produire des glissements brutaux de type foirage..."
                            }
                        ]
                    }
