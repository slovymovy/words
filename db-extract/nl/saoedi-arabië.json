                ],
                "senses": [
                    {
                        "sense_id": "1b37706c-4b51-3e48-80fe-0f240f788943",
                        "entry_id": "e18a819e-077e-32be-a72c-5c584df4fb31",
                        "glosses": [
                            "een land in het zuidwesten van Azië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b7054b-3f00-441a-aae1-6f87f0ca7845",
                                "sense_id": "1b37706c-4b51-3e48-80fe-0f240f788943",
                                "text": "In Saoedi-Arabië groeien planten die bij het klimaat passen."
                            },
                            {
                                "example_id": "54d7b006-c234-48df-8b27-5231df840b14",
                                "sense_id": "1b37706c-4b51-3e48-80fe-0f240f788943",
                                "text": "Het land is in werkelijkheid boeiender dan het Saoedi-Arabië uit de reisgids."
                            }
                        ]
                    },
                    {
                        "sense_id": "0286e80d-8795-3678-9aa4-f21c6cd64392",
                        "entry_id": "e18a819e-077e-32be-a72c-5c584df4fb31",
                        "glosses": [
                            "het soevereine 'Koninkrijk Saoedi-Arabië' (Arabisch: المملكة العربية السعودية al-Mamlakah al-`Arabīyah as-Su`ūdiyah) die het onder 1. genoemde gebied omvat; in figuurlijke betekenis ook: zij die als vertegenwoordigers van dit land optreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b419072a-b4ce-4fd4-af75-a52ab9f2b200",
                                "sense_id": "0286e80d-8795-3678-9aa4-f21c6cd64392",
                                "text": "Saoedi-Arabië is lid van de Verenigde Naties."
                            },
                            {
                                "example_id": "e3222f84-47dd-4d34-9687-b00bd6634d8f",
                                "sense_id": "0286e80d-8795-3678-9aa4-f21c6cd64392",
                                "text": "Het Saoedi-Arabië van twee jaar geleden was een zeer sterk elftal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a48682af-bfcf-49e2-8959-2e2873eaa8c7",
                        "source_entry_id": "e18a819e-077e-32be-a72c-5c584df4fb31",
                        "source_sense_id": "1b37706c-4b51-3e48-80fe-0f240f788943",
