                    {
                        "form_id": "da4ce80d-ec49-4587-b4b7-2a7c6870574b",
                        "entry_id": "17473b2b-a067-3350-854a-17e3c7783823",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Portierinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                        "entry_id": "17473b2b-a067-3350-854a-17e3c7783823",
                        "glosses": [
                            "weibliche Person, die am Eingang von Gebäuden mit viel Publikumsverkehr (etwa Hotels, Wohnanlagen oder Bürokomplexen) Kommende und Gehende in Augenschein nimmt, ihnen beim Betreten beziehungsweise Verlassen des Gebäudes behilflich ist und Auskünfte erteilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32e37ff-c287-4443-bf70-b401f963eaaf",
                                "sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                                "text": "Unsere Portierin kann Ihnen einige gute Museen empfehlen."
                            },
                            {
                                "example_id": "b5907ae2-63e3-450d-b77b-771bed6acab0",
                                "sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                                "text": "Die Portierin hat sich krankgemeldet."
                            },
                            {
                                "example_id": "306ab069-58d3-4fea-b5f1-8bb2b206b3fb",
                                "sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                                "text": "Wir sind sehr stolz darauf, dass in unserem Hause gleich drei Portierinnen tätig sind."
                            },
                            {
                                "example_id": "cf996f7c-a7cc-47c6-a00e-e71b3a067442",
                                "sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                                "text": "„Der Portierin haben Erlaucht befohlen, wegen Abreise morgen früh sieben Uhr aufs Jagdhaus nach Gebhardtskirchen – oder richtig gesagt, heut früh, denn jetzt haben wir viertel eins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0992aed1-ced5-437d-8da4-ce2fd00410ec",
                        "source_entry_id": "17473b2b-a067-3350-854a-17e3c7783823",
                        "source_sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                        "source_sense_description": "weibliche Person, die am Eingang von Gebäuden Personen kontrolliert, ihnen behilflich ist und Auskünfte erteilt",
                        "target_lang_word": "portière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Femme dont la profession est de garder une porte d’entrée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7713f8c1-2896-47c7-b5d2-e8664c703bad",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "Puis il y a le piéton causeur qui se plaint, et converse avec la portière, quand elle se pose sur son balai comme un grenadier sur son fusil ;"
                                            },
                                            {
                                                "example_id": "88ea4c5a-b216-44a5-95da-115a46469588",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "Avez-vous jamais vu une portière qui ait un père ou une mère ?"
                                            },
                                            {
                                                "example_id": "7a42146a-d9a6-4c7c-aeb8-87a118bc09b2",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "— Qu’est-ce que c’est que ça ? demanda Gazonal.\nÇa était une vieille femme à chapeau resté six mois à l’étalage, à robe très-prétentieuse, à châle en tartan déteint, dont la figure était restée vingt ans dans une loge humide, dont le cabas très-enflé n’annonçait pas une meilleure position sociale que celle d’ex-portière."
                                            },
                                            {
                                                "example_id": "d2b06a69-a5be-48b0-9601-0584c1c0ca8b",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "Elle fut accusée d’être brutale, commune, dénuée de goût, de vouloir importer sur le théâtre des habitudes d’outre-Rhin et d’outre-Pyrénées, des castagnettes, des éperons, des talons de bottes, — sans compter qu’elle buvait comme un grenadier, qu’elle aimait trop les petits chiens et la fille de sa portière, — et autres linges sales de la vie privée, qui sont la pâture et la friandise journalière de certains petits journaux."
                                            },
                                            {
                                                "example_id": "b563e919-a9e5-4ffe-9c7a-f71904412931",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "La bourgeoisie et ses domestiques, les portières et les cuisinières, ont fourni la grande masse de la clientèle."
                                            },
                                            {
                                                "example_id": "f3a6f278-03f8-45db-9005-ae737a6b1507",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "Il était trop honnête homme, respectait trop son état et gardait trop de discrétion pour avoir jamais pris aucune liberté avec la jeune portière de la bibliothèque."
                                            },
                                            {
                                                "example_id": "c80a7bdf-0aea-410e-93f1-9e9f4ed8b5e1",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "Bouvard, rentré chez lui, aspira sur son balcon une large bouffée d’air en se disant : « Enfin. » Les lumières des quais tremblaient dans l’eau, le roulement des omnibus au loin s’apaisait. Il se rappela des jours heureux passés dans cette grande ville, des pique-niques au restaurant, des soirs au théâtre, les commérages de sa portière, toutes ses habitudes ; et il sentit une défaillance de cœur, une tristesse qu’il n’osait pas s’avouer."
                                            },
                                            {
                                                "example_id": "abcf5b07-fd10-4934-8c91-6ce45cb60abd",
                                                "sense_id": "30f30f84-8041-3498-bde1-2dd44b1a7455",
                                                "text": "Dans l’esprit de la brave portière […] il lui apparaissait que le fait de son habit noir devait coïncider avec des projets d’épousailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9681cd83-5da1-373a-b4fe-12bb73a59319",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Épouse d’un portier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4447de56-2a4d-476c-940b-91b3b45d23ef",
                                                "sense_id": "9681cd83-5da1-373a-b4fe-12bb73a59319",
                                                "text": "Pas de monsieur Fabre, rue Saint-Dominique ! et ventre à terre, et pourboire au cocher, et tout ! J’ai parlé au portier et à la portière, qui est une belle forte femme, ils ne connaissent pas ça !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46de02af-cd35-3297-9aab-8315196519df",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Personne bavarde, souvent médisante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b602a7c-fac5-4017-99fb-216916800bcb",
                                                "sense_id": "46de02af-cd35-3297-9aab-8315196519df",
                                                "text": "— Mademoiselle Fischer vivre avec un jeune homme !… répéta l’employé. C’est des cancans de portière, ne parlons pas si légèrement de la cousine d’un Conseiller-d’État qui fait la pluie et le beau temps au Ministère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "564ba016-f211-353a-bbfb-39dfd27133ad",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Religieuse qui a le soin d’ouvrir et de fermer la porte d’un couvent."
                                        ],
                                        "tags": [
                                            "Par apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7be93389-c478-46a9-92bf-8c914dc55dab",
                                                "sense_id": "564ba016-f211-353a-bbfb-39dfd27133ad",
                                                "text": "Cependant, sa rivale n’était pas oisive ; car, étant d’intelligence avec la mère portière, elle venait d’apprendre l’arrivée du jésuite, et ne doutant point qu’après un si long intervalle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12ff06e-1eb0-3d9a-ad6a-9ea734c9fa41",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Ouverture de la voiture, du wagon ou de l’avion par où l’on monte et l’on descend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c081ffc-7e01-494a-915b-c889907529d5",
                                                "sense_id": "d12ff06e-1eb0-3d9a-ad6a-9ea734c9fa41",
                                                "text": "Ça va ! grommela Bob impatienté. L’autre n’insista pas et se mit à regarder par la portière."
                                            },
                                            {
                                                "example_id": "147713c7-72d6-42fc-811b-95094fdea71a",
                                                "sense_id": "d12ff06e-1eb0-3d9a-ad6a-9ea734c9fa41",
                                                "text": "En passant par la portière,\nParachutiste souviens-toi, Oui souviens-toi.\n Qu’un jour il pourrait se faire.\n Que ton pépin ne s’ouvre pas."
                                            },
                                            {
                                                "example_id": "f4083333-3a4c-4906-85e9-a72052b3c048",
                                                "sense_id": "d12ff06e-1eb0-3d9a-ad6a-9ea734c9fa41",
                                                "text": "L’intelligence avec laquelle ce Tourangeau raccommodait le trait cassé rassura le colonel comte d’Aiglemont, qui revint vers la portière en étendant ses bras comme pour détirer ses muscles endormis ; il bâilla, regarda le paysage, et posa la main sur le bras d’une jeune femme soigneusement enveloppée dans un vitchoura."
                                            },
                                            {
                                                "example_id": "4b165c2a-1f00-4655-8ef5-6cfe3a84a7c2",
                                                "sense_id": "d12ff06e-1eb0-3d9a-ad6a-9ea734c9fa41",
                                                "text": "La mienne avec son intérieur cuir et ses modifications a autant de succès que la German, qui n’a que des portières papillon et des jantes larges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7608ed6e-af45-322d-80d9-5e22cac2fad1",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Sorte de porte qui sert à fermer cette ouverture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b493a0d-bc72-459a-bdbe-e5f15e28082f",
                                                "sense_id": "7608ed6e-af45-322d-80d9-5e22cac2fad1",
                                                "text": "La clameur fut si forte et si unanimement vocifératrice, qu’il fallut, malgré le froid, ouvrir les portières, car on ne s’entendait plus, et on pouvait craindre que les cloisons du wagon ne résistassent pas à un pareil cyclone de colère."
                                            },
                                            {
                                                "example_id": "46fac2ce-5805-4fbb-9651-637ad448269d",
                                                "sense_id": "7608ed6e-af45-322d-80d9-5e22cac2fad1",
                                                "text": "Les portières sont refermées, après la visite du contrôleur. Un dernier coup de sifflet annonce que le train va se mettre en marche…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                        "entry_id": "2c5e6d1f-60ad-3bd9-a7b7-6accd99b451e",
                                        "glosses": [
                                            "Tenture qu’on met devant une porte, pour empêcher le vent ou par ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e07f6fd-93fe-490b-9aac-13fd5422e37b",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "Et en même temps une portière de velours violet fleurdelisé d’or se soulevant, le duc distingua dans l’ombre la reine elle-même […]"
                                            },
                                            {
                                                "example_id": "29882e0d-1278-4430-a702-706e412093d3",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "Ce ne sont que menuiseries sculptées de noyer ou de chêne noir, portières de tapisserie ou de damas des Indes, rideaux de brocatelle à plis larges et puissants, tentures historiées, tapis de Perse, peintures à fresque."
                                            },
                                            {
                                                "example_id": "6f545f2a-83c4-4cfb-9a69-fc43c98f5c53",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "En disant ces mots, le duc de Vallombreuse salua avec une courtoisie étudiée le marquis de Bruyères, souleva une lourde portière de tapisserie et disparut."
                                            },
                                            {
                                                "example_id": "605e02b0-2f53-4355-9b97-820c133b245a",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "Solange lisait et elle ne leva pas les yeux lorsque son prétendu écarta la portière du petit salon."
                                            },
                                            {
                                                "example_id": "5b51fdf2-22c9-483c-8a80-52288e564d97",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "En le voyant dans l’encadrement de la porte, Sainte-Austreberthe voulut aller au-devant de lui ; mais vivement M. de Cheylus laissa retomber la portière et se plaça, devant, un doigt sur ses lèvres."
                                            },
                                            {
                                                "example_id": "1c5f12f7-00aa-4b1d-ae25-20213882975f",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "Dans le fumoir, une pièce qui ouvrait directement sur le vestibule par une baie, dont la portière était relevée, Pierre, debout, attendait avec son compagnon, en regardant curieusement autour de lui."
                                            },
                                            {
                                                "example_id": "a2d18c0e-70f5-4d76-b32b-6d219918b286",
                                                "sense_id": "d068c1a1-5937-35c7-b610-d0ebe1084919",
                                                "text": "Dans la villa des dunes, il accepte d’assister aux charades pour lesquelles la joyeuse baronne Folgers attife ses invités de châles et de portières de velours ; il consent même à y prendre part, ce qui leur donne un brio de plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "portière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f286e0a-aa42-3c83-8021-58e85544f526",
                                        "entry_id": "7cd0c5d1-841b-3ef5-abeb-ffd52e624c8d",
                                        "glosses": [
                                            "Qui est en âge de porter des petits ou qui en a déjà porté."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1126f233-0d21-4cb8-8791-7f7a72b6c134",
                        "source_entry_id": "17473b2b-a067-3350-854a-17e3c7783823",
                        "source_sense_id": "9de5a795-d816-3da2-a9dd-715c0b17dca5",
                        "source_sense_description": "weibliche Person, die am Eingang von Gebäuden Personen kontrolliert, ihnen behilflich ist und Auskünfte erteilt",
                        "target_lang_word": "concierge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concierge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Celui, celle qui a la garde d’un immeuble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd48066-8356-49c8-b725-372c64f52b01",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Au lieu de cette poésie, un affreux chien qui m’aboyait aux jambes, et une femme comme les autres, sans cervelle, sans idées, uniquement occupée de plaisirs, bornant son rêve au théâtre des Variétés et aux caresses de son Spy, son Spy !… ah ! ah ! ah ! son Spy, cet animal ridicule qu’elle aimait avec des tendresses et des mots de concierge !"
                                            },
                                            {
                                                "example_id": "b18fedea-00b5-40e7-8b89-c2d5e44bf36c",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d’un poitrinaire devenu cent kilos, d’un bilieux devenu poupin."
                                            },
                                            {
                                                "example_id": "4b980853-a7df-4524-be5e-6e66efe934e9",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La loge du concierge figure une tour carrée, avec une plate-forme à créneaux, garnie d’échauguettes."
                                            },
                                            {
                                                "example_id": "ca4fa000-d096-41ce-a903-ae03cac9bf85",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Jamalou, le concierge, s’apercevant que la voûte se trouvait éclairée, alla se rendre compte du fait et ne vit rien d’abord qui l’étonnât."
                                            },
                                            {
                                                "example_id": "d9eca25f-52ff-40ed-8517-6f4ec429fc02",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "Une supériorité incontestable de New-York sur Paris, c’est qu’il n’y a pas de concierges, cette race abominable qui épluche votre courrier, épie vos allées et venues, potine avec votre voisin de palier et réussit souvent à vous mettre à couteaux tirés avec les propres membres de votre famille."
                                            },
                                            {
                                                "example_id": "082dd4a6-357b-4f49-b2b0-9bd5f1085e1a",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La loge du concierge était enfouie dans les ténèbres. Autrefois je me serais étonné de la constance avec laquelle Paris maintient ses concierges dans la nuit. Maintenant j’en comprenais la raison. Le métier des concierges exige une telle tension nerveuse qu’une lumière trop vive leur fatiguerait les yeux. D’autre part, du fond de la pénombre, ils voient mieux ce qui se passe à l’extérieur. Leurs yeux gagnent en finesse, comme ceux des chats."
                                            },
                                            {
                                                "example_id": "2e845d15-6ddf-4e82-94f8-cf4f61922402",
                                                "sense_id": "4bbf459d-34b7-321e-b8c7-285f0135b008",
                                                "text": "La concierge logeait au premier. Elle ne pouvait pas entendre. D’ailleurs elle n'était pas là, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "940a0f13-cb08-31ca-ba5b-964f0be80135",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Commère, bavard."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f371c43-f390-4521-ae71-40e2cbefba61",
                                                "sense_id": "940a0f13-cb08-31ca-ba5b-964f0be80135",
                                                "text": "Quelle concierge, celle-là... — Tu vois que tu utilises ce mot dans son acception péjorative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f77bc6-b098-340f-91ef-dfa108bfb2e1",
                                        "entry_id": "0fbe4f9e-9db1-36a4-a1dd-908711d503e8",
                                        "glosses": [
                                            "Employé, dans le secteur de l’hôtellerie de luxe (4 ou 5 étoiles et palaces), dont les principales fonctions sont d’accueillir, de renseigner et de conseiller les clients."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
