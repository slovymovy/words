                                        "sense_id": "e6417c90-7bde-3649-b94d-541bff94a7f6",
                                        "entry_id": "e7dba654-858d-344e-b67d-0e4bd2d3fe81",
                                        "glosses": [
                                            "Initialism of selective serotonin reuptake inhibitor."
                                        ],
                                        "tags": [
                                            "abbreviation",
