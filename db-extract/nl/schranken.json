                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8ec69cf-24b5-30a3-890c-05c40dfa0156",
                                        "entry_id": "37a91a52-35a6-338a-9011-f316ca133f47",
                                        "glosses": [
                                            "A jousting contest. (countable)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f2851e0-1549-4569-916e-ec0cfe604a66",
                                                "sense_id": "b8ec69cf-24b5-30a3-890c-05c40dfa0156",
                                                "text": "Justs and tilts were held here weekly, while the great tourneys that occurred less often were given upon a field outside the castle wall upon the floor of the valley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d43aa884-0323-302d-b594-6648646c6304",
                                        "entry_id": "37a91a52-35a6-338a-9011-f316ca133f47",
                                        "glosses": [
                                            "An attempt at something, such as a tilt at public office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0effa6fb-ee76-4517-9b8a-a395051d1df0",
                                                "sense_id": "d43aa884-0323-302d-b594-6648646c6304",
                                                "text": "City will now make the Premier League an even bigger priority, while regrouping and planning again for what they hope will be another tilt at the Champions League next season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c6dca75-4fcc-3713-9a34-675176778a9b",
                                        "entry_id": "37a91a52-35a6-338a-9011-f316ca133f47",
                                        "glosses": [
                                            "A thrust, as with a lance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc645867-56b9-4979-9467-8989e479312e",
                                                "sense_id": "4c6dca75-4fcc-3713-9a34-675176778a9b",
                                                "text": "His Majesty[…]entertain'd him with the Slaughter of two or three of his Liege Subjects, whom he very dexterously put to Death with the Tilt of his Lance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e53e4a7-be99-38ea-9122-6cc99a484f3b",
                                        "entry_id": "37a91a52-35a6-338a-9011-f316ca133f47",
                                        "glosses": [
                                            "A tilt hammer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                                        "entry_id": "37a91a52-35a6-338a-9011-f316ca133f47",
                                        "glosses": [
                                            "A state of frustration and worsened performance resulting from a series of losses."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ecc961b-6ed3-48e4-a132-2762227476d4",
                                                "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                                                "text": "to go on tilt"
                                            },
                                            {
                                                "example_id": "9a4a8dcf-a714-4662-9cc0-b5b35f5e14b0",
                                                "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                                                "text": "In his landmark book, The Mental Game of Poker, sports psychologist Jared Tendler defines \"tilt\" as \"anger + bad play\". In short, you lose your mental equilibrium and start playing below your best, often making big mistakes. Tilt is caused by many different factors and Tendler defines seven types of tilt."
                                            },
                                            {
                                                "example_id": "1fa2944d-934f-4ba4-9168-3bcb8b905a6a",
                                                "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                                                "text": "In his follow-up video below, ScrapComputer goes into a long list of suggestions for stopping and avoiding tilt while you play League of Legends."
                                            },
                                            {
                                                "example_id": "fee340fa-5798-4a14-9707-f3492c1cfd31",
                                                "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                                                "text": "Doing the same thing and expecting a different result can drive you insane, especially League of Legends. As you keep losing, you become tilted and get frustrated. No matter how mechanically gifted you are, it can't help ameliorate tilt."
                                            },
                                            {
                                                "example_id": "2f724b21-eda2-4545-b780-0202e12a4aa3",
                                                "sense_id": "0cc61f6c-8d50-3042-a2bf-60fa46dfcd98",
                                                "text": "As long as you know that being consistent and sticking to a strategy in the long run, will win you money, you can avoid tilt and negative emotions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tilt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd50d7a-de26-39a2-bdc9-75d5011acc4d",
                                        "entry_id": "d2492b59-8986-3315-9987-c3996077a56a",
