                                                "sense_id": "857e9afd-58ca-3cec-b857-54883aeae33e",
                                                "text": "Kogucią główkę wieńczy okazały grzebień."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "a38a42ff-109c-3e82-8f38-3367de5a4755",
