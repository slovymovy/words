                                "target_senses": [
                                    {
                                        "sense_id": "8c7ddded-3cfc-31ce-9a25-2ffa5c21c3ee",
                                        "entry_id": "0e28a336-787b-3262-9b33-bf6bb116d304",
                                        "glosses": [
                                            "Son émis par le chien et par d’autres canidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0759f421-e9a9-4151-8c7d-5f066e284b57",
                                                "sense_id": "8c7ddded-3cfc-31ce-9a25-2ffa5c21c3ee",
                                                "text": "À l’époque du frai, il pousse spontanément un petit cri peu harmonieux, qui participe de l’aboiement du roquet et du pépiement du poussin."
                                            },
                                            {
                                                "example_id": "0aa02a83-4db2-401c-983c-0ed4dd3d2cbe",
                                                "sense_id": "8c7ddded-3cfc-31ce-9a25-2ffa5c21c3ee",
                                                "text": "La porte ayant été ouverte, les chiens s'échappèrent en jetant de longs aboiements de satisfaction."
                                            },
                                            {
                                                "example_id": "469e60b1-bfa8-4d44-bd4a-cac5a71a8faa",
                                                "sense_id": "8c7ddded-3cfc-31ce-9a25-2ffa5c21c3ee",
                                                "text": "Ils fuyaient, et déjà les aboiements des chiens s’étaient lassés."
                                            },
                                            {
                                                "example_id": "fa25fbc9-0eb0-42da-bada-3bf72fd07fe1",
                                                "sense_id": "8c7ddded-3cfc-31ce-9a25-2ffa5c21c3ee",
                                                "text": "Je passe une nuit excellente dans mon lit de camp, et mon long sommeil réparateur n’est interrompu que pendant quelques instants par des aboiements furibonds répondant aux glapissements lointains d’un chacal."
                                            },
                                            {
                                                "example_id": "3dc3a9ea-b981-4de2-b9c1-877f06d2981f",
                                                "sense_id": "8c7ddded-3cfc-31ce-9a25-2ffa5c21c3ee",
                                                "text": "Le chant des coqs, l’aboiement des chiens, les appels des oiseaux l’éveillèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "800a6b7e-5a78-34f3-92f4-5195f964c4c1",
                                        "entry_id": "0e28a336-787b-3262-9b33-bf6bb116d304",
                                        "glosses": [
                                            "Bruit ou cri désarticulé ressemblant à un aboiement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f41ae0-7f95-4d57-a024-abd244daf513",
                                                "sense_id": "800a6b7e-5a78-34f3-92f4-5195f964c4c1",
                                                "text": "Au loin, Siry entendait l'aboiement incompréhensible d’un haut-parleur espagnol où parlait le père Barca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695be0a8-6b37-3301-818e-9a1eac5e4dac",
                                        "entry_id": "0e28a336-787b-3262-9b33-bf6bb116d304",
                                        "glosses": [
                                            "Paroles, discours violents ou haineux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61b52cb9-ddc1-46bd-af66-720437f65a32",
                                                "sense_id": "695be0a8-6b37-3301-818e-9a1eac5e4dac",
                                                "text": "Lui-même, de temps en temps, publiait, ou faisait publier, quelque remarque caustique, quelque petit aboiement aux talons de confrères dont le succès (ou insuccès) l’agaçaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
