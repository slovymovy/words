                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beiläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74e254bb-1a90-3f41-b722-89ffccbbcfaa",
                                        "entry_id": "6cd8e89e-0c50-3fbb-89d6-cb8b1784f070",
                                        "glosses": [
                                            "nebenbei, wie zufällig erwähnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d341905-103d-45d5-8458-915437990d3e",
                                                "sense_id": "74e254bb-1a90-3f41-b722-89ffccbbcfaa",
                                                "text": "Sein beiläufiger Kommentar erwies sich als wichtig."
                                            },
                                            {
                                                "example_id": "767d45e5-d7b8-4ec7-a76a-b011e8f62110",
                                                "sense_id": "74e254bb-1a90-3f41-b722-89ffccbbcfaa",
                                                "text": "„Eher beiläufig kam sie dann auf das Mordopfer zu sprechen.“"
                                            }
