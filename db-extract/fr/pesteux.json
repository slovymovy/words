                "senses": [
                    {
                        "sense_id": "1b26dc57-a7c0-3c78-a66a-aacb9d30abcc",
                        "entry_id": "62b2dd8e-8ab1-3afa-84c6-c084439c9e70",
                        "glosses": [
                            "Personne atteinte de la peste."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c11e928c-73dc-4501-869b-0cd90c4e57e7",
                                "sense_id": "1b26dc57-a7c0-3c78-a66a-aacb9d30abcc",
                                "text": "— Fils, les médecins n’en savent pas plus que nous. Ils prendront ta pécune, et, pour tout ton potage, ils t’enverront gésir dans un parc à pesteux, où tu ne manqueras point d’empester tout à fait."
                            },
                            {
                                "example_id": "1a4d30e2-a365-4c13-a0e2-f0f19739b2b0",
                                "sense_id": "1b26dc57-a7c0-3c78-a66a-aacb9d30abcc",
                                "text": "Je serai un grand médecin dans une grande ville, comme Paris, ou comme Bordeaux, ou Périgueux.\n— Grand ou petit, dit François avec le dernier mépris, que ferez-vous, sinon soigner les pesteux et les vérolés?"
                            }
                        ]
                    }
