                        "examples": [
                            {
                                "example_id": "42e78c7c-48b4-4133-802a-5b54ac2ef967",
                                "sense_id": "b86d0027-b83d-32d6-ac34-38e04d54ae4b",
                                "text": "New York, 10 Febr. In de Verenigde Staten zal over enkele maanden zonder recept een dieetpil worden verkocht waarvan de werking wetenschappelijk is aangetoond. Het medicijn gaat Alli heten en is al sinds 1999 op recept verkrijgbaar onder de naam Xenical. De Amerikaanse warenautoriteit Food and Drug Administration, die optreedt als waakhond voor de geneesmiddelenmarkt, heeft het product deze week goedgekeurd voor receptloze verkoop, zo meldde The New York Times gisteren."
                            },
                            {
                                "example_id": "1e736f1e-9f54-427a-8f63-ca0107dfd210",
                                "sense_id": "b86d0027-b83d-32d6-ac34-38e04d54ae4b",
                                "text": "Er is nu nog geen dieetpil bekend die alle mensen met obesitas blijvend van hun overgewicht afhelpt."
                            }
                        ]
                    }
