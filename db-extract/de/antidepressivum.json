                    },
                    {
                        "translation_id": "38a47c4e-ae4e-43dd-a62a-9b5b31e1bf4f",
                        "source_entry_id": "dae27eab-2fe8-31f7-babf-e613c1e5c12c",
                        "source_sense_id": "685aab36-c4f3-3cd6-8fcd-e7f3d582913f",
