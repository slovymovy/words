                                    {
                                        "sense_id": "43cccd0a-ac6f-31dc-87ca-5cfd5d32b78f",
                                        "entry_id": "184b62dd-7012-3c1d-ac3e-80d306b522fc",
                                        "glosses": [
                                            "Pigment végétal hydrosoluble allant du rouge au bleu, appartenant à la classe des flavonoïdes, et qui est un hétéroside complexe composé d’une portion aromatique aglycone qui est le pigment proprement dit conférant la couleur, et d’une portion glucidique (i.e. un sucre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f4b3a1-5e24-439f-88db-e6885b58222a",
                                                "sense_id": "43cccd0a-ac6f-31dc-87ca-5cfd5d32b78f",
                                                "text": "…quant au vin rouge, il apporte principalement des anthocyanes et des procyanidines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf5c1372-fa75-4a35-9047-18b14f1221bf",
                        "source_entry_id": "ca96014a-1806-355b-bbfc-73d31c9cfd9f",
                        "source_sense_id": "5c8ce389-c97a-386e-8478-7d330849865c",
                        "source_sense_description": "any of many water-soluble red to violet plant pigments",
                        "target_lang_word": "Anthocyan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthocyan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                        "entry_id": "7b32e259-d016-3f57-b8d8-eb06794451bf",
                                        "glosses": [
                                            "in den Zellen von Pflanzen vorkommender, roter, violetter oder blauer wasserlöslicher Farbstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d58067-cb77-44ee-b7a9-133ab244b60b",
                                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                                "text": "Anthocyane sind chymochrome Farbstoffe, die nahezu in allen höheren Pflanzen vorkommen, jedoch nur im Zellsaft von Landpflanzen, nicht aber in Tieren, Mikroorganismen oder Wasserpflanzen zu finden sind."
                                            },
                                            {
                                                "example_id": "da19f95c-2971-4963-bef7-03e1252e3731",
                                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                                "text": "„Anthocyan wird im Herbst von einigen Bäumen neu gebildet.“"
                                            },
                                            {
                                                "example_id": "147eae8f-112f-4d30-b62a-ae7bfd4e8f2a",
                                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                                "text": "„100 g Rotkohl enthalten rund 25 mg Anthocyane, etwa so viel wie ein Glas Rotwein.“"
                                            },
                                            {
                                                "example_id": "161f7f23-af8e-4eb7-9565-60d75e73d0f8",
                                                "sense_id": "dae3dd51-4efd-31a8-8b75-6cf75aca0c5e",
                                                "text": "„Rotweintrauben erhalten ihre typische Farbe durch das Pigment Anthocyan, das die weißen Kultursorten der Weinrebe (Vitis vinifera) nur in geringem Maße produzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
