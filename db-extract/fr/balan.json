                        ],
                        "examples": [
                            {
                                "example_id": "6c7b4ef0-b096-4b50-89cf-030477404462",
                                "sense_id": "17d72af0-5e47-3fab-bc82-59e8a4d33933",
                                "text": "La roue avant de ma bicyclette a buté sur le rebord du trottoir, mais j'ai tout de même gardé mon balan et évité la chute"
                            },
                            {
                                "example_id": "bd70c2c1-09cf-48d7-b271-1cade1b5da32",
                                "sense_id": "17d72af0-5e47-3fab-bc82-59e8a4d33933",
                                "text": "Simon s’avança près de l’estrade, en traînant les pieds, ne sachant soudain plus marcher, gêné de ses bras qui ne trouvaient plus leur balan."
                            }
                        ]
                    }
