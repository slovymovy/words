                            {
                                "target_word": "drawing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68d0f754-547e-3f44-b026-dd2934f5faf8",
                                        "entry_id": "1e41d89f-3a19-3f09-830d-35b731b7ebe9",
                                        "glosses": [
                                            "A picture, likeness, diagram or representation, usually drawn on paper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cae8366-92d4-4193-b34b-07daf496eefa",
                                                "sense_id": "68d0f754-547e-3f44-b026-dd2934f5faf8",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            },
                                            {
                                                "example_id": "6ec91920-8ed7-4a5e-a86b-3a0232d758f6",
                                                "sense_id": "68d0f754-547e-3f44-b026-dd2934f5faf8",
                                                "text": "While you see some of our exploration on camera, I also spent many happy hours between shoots with Chris Nix, digging out dozens of wonderful plans, maps and drawings of projects that I never knew existed, and some that never did exist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac7e25ad-421a-38ba-a5a4-6406f3075dc1",
                                        "entry_id": "1e41d89f-3a19-3f09-830d-35b731b7ebe9",
                                        "glosses": [
                                            "The act of producing such a picture."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f1f6c5e-d2b6-3144-bcef-d26c8a8c3eee",
                                        "entry_id": "1e41d89f-3a19-3f09-830d-35b731b7ebe9",
                                        "glosses": [
                                            "Such acts practiced as a graphic art form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3832a1b9-27e7-3c54-b79c-fa9ea885ff41",
                                        "entry_id": "1e41d89f-3a19-3f09-830d-35b731b7ebe9",
                                        "glosses": [
                                            "The process of drawing or pulling something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24f74f08-fa79-4a35-b378-3ccfcdddd3db",
                                                "sense_id": "3832a1b9-27e7-3c54-b79c-fa9ea885ff41",
                                                "text": "Proverb: An official is great in his office as a well is rich in drawings of water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a70f394a-8ddb-363a-94d8-675804026607",
                                        "entry_id": "1e41d89f-3a19-3f09-830d-35b731b7ebe9",
                                        "glosses": [
                                            "An act or event in which the outcome (e.g., designating a winner) is selected by chance in the form of a blind draw, notably of lots; especially such a contest in which a winning name or number is selected randomly by removing (or drawing) it from a container, popularly a hat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "927cd0a5-39b5-381f-9dec-d0389e4888b2",
                                        "entry_id": "1e41d89f-3a19-3f09-830d-35b731b7ebe9",
                                        "glosses": [
                                            "A small portion of tea for steeping."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac894fb-587c-43bc-a41a-4f44b98badab",
                                                "sense_id": "927cd0a5-39b5-381f-9dec-d0389e4888b2",
                                                "text": "[…] the tea-kettle was presently steaming like an engine, and an extra large \"drawing of tea\" was steeping on the hearth."
                                            }
                                        ]
                                    }
                                ]
                            }
