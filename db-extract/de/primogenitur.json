                        "source_entry_id": "5aea716d-54b4-37b5-bbde-812337c34044",
                        "source_sense_id": "1d7a15b2-a1e0-352e-914a-e7f303afa9bc",
                        "source_sense_description": "Ordnung der Erbfolge, nach der nur das erstgeborene Kind das Erbe und die Rechtsnachfolge einer verstorbenen Person antritt",
                        "target_lang_word": "eerstgeboorterecht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eerstgeboorterecht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a0da355a-70a2-3a82-889d-c9f864d4c15a",
                                        "entry_id": "b85c8ca4-6691-33ab-9827-c33473d96935",
                                        "glosses": [
                                            "de rechten van het oudste kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "384ad4f5-7232-46c8-b482-7f4ab8fe5021",
                                                "sense_id": "a0da355a-70a2-3a82-889d-c9f864d4c15a",
                                                "text": "Dat Amalia de titel nu wel mag gebruiken, is te danken aan de grondwetswijziging van 1983. Daarin werd vastgelegd dat de sekse van de troonopvolger voortaan geen invloed meer had. Zo ging voortaan ook het eerstgeboorterecht gelden: tot die tijd zou een jongere broer van Amalia voorrang hebben gehad bij de opvolging."
                                            },
                                            {
                                                "example_id": "a7fa03d0-49ba-4304-a962-10e1f3101cea",
                                                "sense_id": "a0da355a-70a2-3a82-889d-c9f864d4c15a",
                                                "text": "Toch was Groot-Brittannië niet de enige monarchie met de ouderwetse regel. Er zijn veel landen die het pas laat hebben ingevoerd. In Denemarken mag de eerstgeborene pas sinds 2009 de troon op en Nepal wijzigde de regel pas in 2006. Ook in Noorwegen en Luxemburg geldt het eerstgeboorterecht pas sinds een paar jaar."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b937de01-a5fc-488b-acec-5d164a41eb16",
                        "source_entry_id": "5aea716d-54b4-37b5-bbde-812337c34044",
                        "source_sense_id": "1d7a15b2-a1e0-352e-914a-e7f303afa9bc",
                        "source_sense_description": "Ordnung der Erbfolge, nach der nur das erstgeborene Kind das Erbe und die Rechtsnachfolge einer verstorbenen Person antritt",
                        "target_lang_word": "primogenituur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "primogenituur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c40eb0-ae27-351b-940b-4706ad9eb05d",
                                        "entry_id": "7803bdd6-55d3-39b4-ba1d-eef5325ed12c",
                                        "glosses": [
                                            "het, bij verschillende volkeren en tradities voorkomende, recht van het oudste kind (meestal zoon) op de gehele erfenis of een groter deel van de erfenis dan jongere kinderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fc20bd0-5702-46bd-a076-57084b7133fd",
                                                "sense_id": "d9c40eb0-ae27-351b-940b-4706ad9eb05d",
                                                "text": "Op enkele koningshuizen na is primogenituur niet langer de norm in westerse landen."
                                            },
                                            {
                                                "example_id": "98fb60db-a6aa-4a25-be8b-a70f211facfa",
                                                "sense_id": "d9c40eb0-ae27-351b-940b-4706ad9eb05d",
                                                "text": "Het verdeelsysteem dat eraan ten grondslag ligt, heet primogenituur: het aanwijzen van de oudste zoon (of, beduidend minder vaak: de oudste dochter) als erfgenaam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
