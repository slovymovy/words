                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a4e5991-fec5-4f1d-aa2c-b0def12e1241",
                                "sense_id": "ec177258-f923-35df-bb19-5d39a5491c99",
                                "text": "Książnica oświęcimska wzbogaciła się o kilkanaście nowych pozycji z dziedziny fantastyki"
                            },
                            {
                                "example_id": "e4a5be0b-8f34-4519-b835-cfc046d59caf",
                                "sense_id": "ec177258-f923-35df-bb19-5d39a5491c99",
                                "text": "Kosztowna konserwacja oświęcimskiego witraża jest możliwa dzięki realizacji specjalnego projektu Niemiecko-Polskiej Fundacji Ochrony Kultury i Zabytków\""
                            },
                            {
                                "example_id": "0a0a4653-6ce8-4388-8c00-fc31ba6334bc",
                                "sense_id": "ec177258-f923-35df-bb19-5d39a5491c99",
                                "text": "Mrozka dostrzegł obecny przy \"selekcji\" komendant obozu oświęcimskiego - Obersturmbahnfürer SS Rudolf Höss"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
