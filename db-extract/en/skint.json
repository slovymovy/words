                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018939af-ebc3-4320-b5e8-6134cbb361b3",
                                                "sense_id": "0be2b16b-2972-36dd-8a4c-2ac9fa3ef342",
                                                "text": "Er wies auf seinen blanken Hintern und zitierte Götz von Berlichingen."
                                            },
                                            {
                                                "example_id": "8776fb57-d70d-4ff8-833f-a213d8f4b684",
                                                "sense_id": "0be2b16b-2972-36dd-8a4c-2ac9fa3ef342",
                                                "text": "Er griff das Schwert und zog blank. (Die Klinge ist sichtbar/unverdeckt)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "87c513ac-958f-3340-9afc-c4798d2fc834",
                                        "entry_id": "7ac6156a-5602-3dac-aee1-319ab580f317",
