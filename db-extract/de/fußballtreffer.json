                "senses": [
                    {
                        "sense_id": "82d0f4e2-8819-3eee-89ce-c1b2a12c8adb",
                        "entry_id": "ed80e7c4-f40c-3e09-a3b4-0817ee4ca7f8",
                        "glosses": [
                            "Treffer bei einem Fußballspiel, der durch einen Fußballspieler erzielt wurde, hierbei kann es sich um ein Tor oder auch um das Treffen eine Person handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa426a5c-2592-47c0-b477-5a91487b3464",
                                "sense_id": "82d0f4e2-8819-3eee-89ce-c1b2a12c8adb",
                                "text": "„Nach hoffentlich nicht gänzlich durchzechter Nacht standen sich bereits am Samstagvormittag am Erlauzwiesler Bolzplatz acht Mannschaften mit zum Teil eigenartig klingenden Namen wie „Die Barmherzigen“ oder „Schewara“ gegenüber, um beim von Klaus Schlägl wieder einmal gut vorbereiteten und von Schiedsrichter Rupert Stadler geleiteten 17. Max Brunner-Gedächtnisturnier der FF Ratzing so viele Fußballtreffer zu erzielen, dass man bei der abendlichen Siegerehrung als Erstplatzierter den Wanderpokal mit nach Hause nehmen kann.“"
                            },
                            {
                                "example_id": "802e4ee0-ba5c-415c-bf8c-f0e7715dabd3",
                                "sense_id": "82d0f4e2-8819-3eee-89ce-c1b2a12c8adb",
                                "text": "„Das Gefühl entspricht dem „Fußballtreffer, wenn man in der Mauer steht“ und ist mit lokaler Kühlung, meist ohne Schmerzmitteleinnahme, gut beherrschbar. “"
                            },
                            {
                                "example_id": "a089cb08-cdd7-47fa-8f29-2514cc3fc665",
                                "sense_id": "82d0f4e2-8819-3eee-89ce-c1b2a12c8adb",
                                "text": "„Die Lokalisation ist belegt durch die Anamnese: Hoden-/Nebenhodenentzündung in jungen Jahren nach einem Fußballtreffer in den Unterleib.“"
                            },
                            {
                                "example_id": "43e94cdf-e324-40be-b989-fb9d808ed35f",
                                "sense_id": "82d0f4e2-8819-3eee-89ce-c1b2a12c8adb",
                                "text": "„Fans können u.a. über Gomez‘ Homepage Videos ihrer spektakulärsten Fußballtreffer einsenden, die dann prämiert werden.“"
                            },
                            {
                                "example_id": "c4ac5b26-379f-4ac1-a005-11dbae008b1a",
                                "sense_id": "82d0f4e2-8819-3eee-89ce-c1b2a12c8adb",
                                "text": "„Schäden, die an Einrichtungsgegenständen der Halle durch Fußballtreffer entstehen (z. B. Zeituhr, Motore), sind vom Verursacher bzw. Veranstalter zu erstatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
