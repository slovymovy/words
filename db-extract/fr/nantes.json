                        "translation_id": "d4d38fe1-b60e-4062-9abd-505fd71af3a0",
                        "source_entry_id": "6cb529f0-7338-3021-ab80-8d0d395b30e8",
                        "source_sense_id": "e7a03026-4a1c-30f4-b7b7-ca3baa7f705d",
