                "senses": [
                    {
                        "sense_id": "b37edb55-7d46-3684-bf13-08ddf9b56e34",
                        "entry_id": "8a0cec39-9864-3e10-a937-d0c3eb456d61",
                        "glosses": [
                            "Qui se rapporte au monde des entrepreneurs et à l'entrepreneuriat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c308216-ab47-49dc-9b28-e170444a65f0",
                                "sense_id": "b37edb55-7d46-3684-bf13-08ddf9b56e34",
                                "text": "– Je suis tombé sur une espèce de boa qui m’a terrifié : le mot “entrepreneurial”…"
                            },
                            {
                                "example_id": "def6ef13-1a06-48fd-b774-f922124dd657",
                                "sense_id": "b37edb55-7d46-3684-bf13-08ddf9b56e34",
                                "text": "On voit ici qu’en termes d’organisation entrepreneuriale avec la franchise, mais aussi de répertoire d’action avec l’usage de techniques de marketing communicationnel, les Hommen adoptent et adaptent leur répertoire de mobilisation à la société médiatique, […]."
                            },
                            {
                                "example_id": "795a9f15-621a-4475-ac01-0565ce3cbade",
                                "sense_id": "b37edb55-7d46-3684-bf13-08ddf9b56e34",
                                "text": "En français, on louerait l’« esprit d’équipe », mais c’est si peu entrepreneurial, le « french speaking »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5671d968-38e0-4319-b62c-4fc33d0b9d80",
                        "source_entry_id": "8a0cec39-9864-3e10-a937-d0c3eb456d61",
                        "source_sense_id": "b37edb55-7d46-3684-bf13-08ddf9b56e34",
                        "source_sense_description": "Qui se rapporte au monde des entrepreneurs",
                        "target_lang_word": "entrepreneurial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrepreneurial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                                        "entry_id": "9c4c5535-dc46-3107-942f-a2ad99375ce2",
                                        "glosses": [
                                            "Having the spirit, attitude or qualities of an entrepreneur; enterprising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150dd5ca-06e3-40bf-8138-671b9dbc1644",
                                                "sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                                                "text": "Homer’s entrepreneurial spirit proves altogether overly infectious. Homer gives Barney a pep talk when he encounters him dressed up like a baby handing out fliers (Barney in humiliating costumes=always funny) and it isn’t long until Barney has purchased a truck of his own and set up shop as the Plow King."
                                            },
                                            {
                                                "example_id": "acd893b9-4074-4330-89c0-554e83415641",
                                                "sense_id": "34f36f2e-face-359e-ac35-ba445880e7b3",
                                                "text": "It is a canard trotted out by lazy or tendentious journalists that nationalised British Railways lacked entrepreneurial flair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
