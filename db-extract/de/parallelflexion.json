                ],
                "senses": [
                    {
                        "sense_id": "74e29c75-4614-30ed-97af-ac9bba8535db",
                        "entry_id": "3a7acb00-72e0-3c2f-8dcd-bf15c704a789",
                        "glosses": [
                            "Übereinstimmung der Flexionsendungen aufeinanderfolgender attributiver Adjektive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d95f7cf3-5e51-4a75-9f4e-d818eaf462f1",
                                "sense_id": "74e29c75-4614-30ed-97af-ac9bba8535db",
                                "text": "„Einige Schreiber setzen das Mittel der Parallel-oder Wechselflexion sogar bewusst ein, um eine Neben- beziehungsweise Unterordnung der Adjektive zu signalisieren.“"
                            },
                            {
                                "example_id": "f9a62416-5e1b-41b4-bbb9-064cc6f4dcfe",
                                "sense_id": "74e29c75-4614-30ed-97af-ac9bba8535db",
                                "text": "„Parallelflexion (also überall die Endung -em) wird in der Standardsprache allerdings vorgezogen…“"
                            },
                            {
                                "example_id": "c7df82db-bdb4-4c9f-83c7-3914541be3b7",
                                "sense_id": "74e29c75-4614-30ed-97af-ac9bba8535db",
                                "text": "„Bei der Parallelflexion sind die beiden Adjektive dagegen dem Substantiv syntaktisch-semantisch in exakt derselben Weise zugeordnet.“"
                            },
                            {
                                "example_id": "2cde987b-78a0-4336-b586-bdee896ff88e",
                                "sense_id": "74e29c75-4614-30ed-97af-ac9bba8535db",
                                "text": "„Da die präskriptive Linguistik spätestens seit dem 20. Jahrhundert die Parallelflexion allerdings bevorzugt, wird die schwache Flexion von Adjektiven in Reihungen in Grammatiken oft als Sprachwandelphänomen dargestellt (…).“"
                            },
                            {
                                "example_id": "1022cc22-06bf-4089-aee3-87ffb43c35b6",
                                "sense_id": "74e29c75-4614-30ed-97af-ac9bba8535db",
                                "text": "„Raus Tun war \"von tiefem christlichen Glauben geprägt\". Das geht gerade noch, obwohl die Parallelflexion heute üblicher ist (\"tiefem christlichem\").“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
