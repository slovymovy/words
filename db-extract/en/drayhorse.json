                        "glosses": [
                            "A large, powerful horse used for pulling drays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ccff30-7010-407e-aea6-01fe65d3728f",
                                "sense_id": "43223a2c-132e-34b3-9925-e190ccaaccc1",
                                "text": "Then his dray-horſe and he, in the ſtreets we did ſee,\nWith his hanger, his ſling, and bis jacket;\nLong time he did watch, to meet with his match;\nFor he'd ever a mind to the placket."
                            }
                        ]
                    },
                    {
