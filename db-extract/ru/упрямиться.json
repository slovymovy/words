                "senses": [
                    {
                        "sense_id": "45277cb1-c4c2-30ce-8477-3481a919ae38",
                        "entry_id": "e8d94682-9638-3d97-bda0-d426dfeae7d2",
                        "glosses": [
                            "to be obstinate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e623c4-9de6-4d62-aa5e-6b238436fbf4",
                                "sense_id": "45277cb1-c4c2-30ce-8477-3481a919ae38",
                                "text": "«Ба́тюшка Пётр Андре́ич! — шепта́л Саве́льич, сто́я за мно́ю и толка́я меня́. — Не упря́мься! что тебе́ сто́ит? плюнь да поцелу́й у злод... (тьфу!) поцелу́й у него́ ру́чку».",
                                "translation": "\"My little father, Piotr Andrevitch,\" whispered Savelitch, who stood behind, nudging me, \"do not be obstinate! What does it cost thee? Spit, and kiss the rob—— (tfu!) Kiss his hand!\"",
                                "english": "\"My little father, Piotr Andrevitch,\" whispered Savelitch, who stood behind, nudging me, \"do not be obstinate! What does it cost thee? Spit, and kiss the rob—— (tfu!) Kiss his hand!\""
                            }
                        ]
                    }
                ],
