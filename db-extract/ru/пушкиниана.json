                    {
                        "sense_id": "33aec5dd-533a-3ad2-8c57-f2aca91937aa",
                        "entry_id": "6cbf07ba-7f7b-3887-8bad-8ea1ccaaaeeb",
                        "glosses": [
                            "all literature and art connected with the life and works of Pushkin, research about him, and all publications of his work"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "456723fd-2dc0-477d-abdc-ae92259b8cb6",
                                "sense_id": "33aec5dd-533a-3ad2-8c57-f2aca91937aa",
                                "text": "Я и сейча́с счита́ю, что его́ кни́га «Пушкин в жизни» ― лу́чшее, что есть в на́шей пушкиниа́не.",
                                "translation": "I still think that his book \"Pushkin in Life\" is the best thing we have in all Pushkin studies.",
                                "english": "I still think that his book \"Pushkin in Life\" is the best thing we have in all Pushkin studies."
                            }
                        ]
                    }
                ],
