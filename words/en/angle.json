{
    "word_family": [
        "angular",
        "angler",
        "triangle",
        "rectangle",
        "triangulation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a7553c2-fb63-3799-bd12-169f5c8ac845",
                    "sense_definition": "The space between two lines or surfaces that meet at one point, often measured in degrees.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geometry_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lines meet at a ninety-degree <w>angle</w>.",
                            "target_lang_translations": {
                                "ru": "Линии сходятся под прямым <w>углом</w>.",
                                "zh": "这两条线在九十度<w>角</w>处相交。"
                            }
                        },
                        {
                            "text": "You should hold the knife at a slight <w>angle</w> when cutting the bread.",
                            "target_lang_translations": {
                                "ru": "При нарезке хлеба нож следует держать под небольшим <w>углом</w>.",
                                "zh": "切面包时，你应该把刀稍微<w>倾斜</w>一点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "right angle",
                        "at an angle",
                        "acute angle",
                        "wide angle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пространство между двумя линиями или поверхностями, сходящимися в одной точке; часто измеряется в градусах.",
                        "zh": "两条线或两个面在一点相交所形成的空间，通常用度数来测量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́гол",
                                "target_lang_sense_clarification": "геометрическая фигура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "角",
                                "target_lang_sense_clarification": "几何图形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e937e1d-1893-3598-bbf7-e63e39edf699",
                    "sense_definition": "A particular way of thinking about a situation, approaching a problem, or looking at an issue.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "viewpoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to consider the problem from a different <w>angle</w> to find a solution.",
                            "target_lang_translations": {
                                "ru": "Нам нужно рассмотреть проблему под другим <w>углом</w>, чтобы найти решение.",
                                "zh": "我们需要从不同的<w>角度</w>考虑这个问题，以找到解决方案。"
                            }
                        },
                        {
                            "text": "The reporter wrote the story from a political <w>angle</w>.",
                            "target_lang_translations": {
                                "ru": "Репортер написал статью с политической <w>точки зрения</w>.",
                                "zh": "记者从政治<w>观点</w>撰写了这篇报道。"
                            }
                        }
                    ],
                    "synonyms": [
                        "perspective",
                        "point of view",
                        "viewpoint",
                        "slant"
                    ],
                    "common_phrases": [
                        "from a different angle",
                        "new angle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый способ осмысления ситуации, подход к проблеме или взгляд на вопрос.",
                        "zh": "思考某种情况、处理问题或看待事物的特定方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "то́чка зре́ния",
                                "target_lang_sense_clarification": "взгляд на ситуацию"
                            },
                            {
                                "target_lang_word": "ра́курс",
                                "target_lang_sense_clarification": "перспектива"
                            },
                            {
                                "target_lang_word": "у́гол",
                                "target_lang_sense_clarification": "подход к проблеме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "角度",
                                "target_lang_sense_clarification": "看待问题的视角"
                            },
                            {
                                "target_lang_word": "观点",
                                "target_lang_sense_clarification": "对事物的看法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5d31d1d-6f9b-358c-99f8-31cd157521cd",
                    "sense_definition": "An outside or inside corner where two sides or walls meet.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hit his knee against the sharp <w>angle</w> of the table.",
                            "target_lang_translations": {
                                "ru": "Он ударился коленом об острый <w>угол</w> стола.",
                                "zh": "他的膝盖撞到了桌子的尖<w>角</w>上。"
                            }
                        },
                        {
                            "text": "The spider built a web in the dark <w>angle</w> of the ceiling.",
                            "target_lang_translations": {
                                "ru": "Паук сплел паутину в темном <w>углу</w> потолка.",
                                "zh": "蜘蛛在天花板阴暗的<w>角落</w>里结了网。"
                            }
                        }
                    ],
                    "synonyms": [
                        "corner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний или внутренний угол, где сходятся две стороны или стены.",
                        "zh": "两条边或墙壁相交的外部或内部拐角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́гол",
                                "target_lang_sense_clarification": "часть предмета или помещения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "角落",
                                "target_lang_sense_clarification": "物体或房间的拐角处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "719068b5-0aca-3437-b29f-0c5a50f87f12",
                    "sense_definition": "A hidden motive or a clever plan to get an advantage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scheme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not trust him because he always has an <w>angle</w>.",
                            "target_lang_translations": {
                                "ru": "Я ему не доверяю, потому что у него всегда есть какой-то <w>скрытый мотив</w>.",
                                "zh": "我不信任他，因为他总是有某种<w>企图</w>。"
                            }
                        },
                        {
                            "text": "She is looking for an <w>angle</w> to make some extra money from the deal.",
                            "target_lang_translations": {
                                "ru": "Она ищет <w>лазейку</w>, чтобы подзаработать на этой сделке.",
                                "zh": "她正在寻找一个能从这笔交易中额外赚钱的<w>门路</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "work an angle",
                        "what is your angle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often implies a selfish or tricky motive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый мотив или хитрый план для получения преимущества.",
                        "zh": "为了获得优势而采取的隐藏动机或狡猾计划。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уло́вка",
                                "target_lang_sense_clarification": "хитрый план"
                            },
                            {
                                "target_lang_word": "хи́трость",
                                "target_lang_sense_clarification": "скрытый мотив"
                            },
                            {
                                "target_lang_word": "лазе́йка",
                                "target_lang_sense_clarification": "способ получить выгоду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "企图",
                                "target_lang_sense_clarification": "隐藏的动机"
                            },
                            {
                                "target_lang_word": "诡计",
                                "target_lang_sense_clarification": "狡猾的计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6aeef258-12a0-3576-a73e-9c5957c66220",
                    "sense_definition": "A member of a Germanic people who settled in Britain in the 5th century.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tribe",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Angles</w> and Saxons invaded Britain long ago.",
                            "target_lang_translations": {
                                "ru": "<w>Англы</w> и саксы вторглись в Британию давным-давно.",
                                "zh": "<w>盎格鲁人</w>和撒克逊人很久以前就入侵了不列颠。"
                            }
                        },
                        {
                            "text": "The English language is named after the <w>Angles</w>.",
                            "target_lang_translations": {
                                "ru": "Английский язык назван в честь <w>англов</w>.",
                                "zh": "英语是以<w>盎格鲁人</w>的名字命名的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель германского народа, заселившего Британию в V веке.",
                        "zh": "公元5世纪定居在不列颠的一个日耳曼民族成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "англ",
                                "target_lang_sense_clarification": "историческое племя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盎格鲁人",
                                "target_lang_sense_clarification": "历史上的日耳曼部落"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "316fe4dd-3d78-3d1d-86b6-c1f3406ae217",
                    "sense_definition": "To move or place something so that it is not straight or is facing a specific direction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>angled</w> the mirror so she could see the door.",
                            "target_lang_translations": {
                                "ru": "Она <w>наклонила</w> зеркало так, чтобы видеть дверь.",
                                "zh": "她<w>倾斜</w>了镜子的角度，这样就能看到门了。"
                            }
                        },
                        {
                            "text": "The path <w>angled</w> sharply to the left near the river.",
                            "target_lang_translations": {
                                "ru": "Тропинка резко <w>поворачивала</w> влево у реки.",
                                "zh": "小路在河边急剧向左<w>转向</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещать или располагать что-либо не прямо или в определенном направлении.",
                        "zh": "移动或放置某物，使其不平直或朝向特定方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклоня́ть",
                                "target_lang_sense_clarification": "ставить под углом"
                            },
                            {
                                "target_lang_word": "повора́чивать",
                                "target_lang_sense_clarification": "менять направление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "使物体处于一定角度"
                            },
                            {
                                "target_lang_word": "转向",
                                "target_lang_sense_clarification": "改变方向"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08820a3a-6dff-3991-bd2f-e74e2f0954c5",
                    "sense_definition": "To try to get something or find out something without asking directly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been <w>angling</w> for a promotion for months.",
                            "target_lang_translations": {
                                "ru": "Он уже несколько месяцев <w>добивается</w> повышения.",
                                "zh": "他几个月来一直都在<w>谋求</w>升职。"
                            }
                        },
                        {
                            "text": "I think she is <w>angling</w> for an invitation to the party.",
                            "target_lang_translations": {
                                "ru": "Думаю, она <w>напрашивается</w> на приглашение на вечеринку.",
                                "zh": "我觉得她是在<w>暗示</w>想要一份派对邀请函。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "angle for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться получить или узнать что-либо, не спрашивая об этом прямо.",
                        "zh": "试图获取或打听某事，但不直接询问。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напра́шиваться",
                                "target_lang_sense_clarification": "намекать с целью получить"
                            },
                            {
                                "target_lang_word": "добива́ться",
                                "target_lang_sense_clarification": "искать окольные пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谋求",
                                "target_lang_sense_clarification": "通过暗示或迂回方式争取"
                            },
                            {
                                "target_lang_word": "套取",
                                "target_lang_sense_clarification": "试图打听信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65cafe1f-da7c-3a02-b96d-c373393886c3",
                    "sense_definition": "To try to catch fish with a hook and line.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went <w>angling</w> in the river on Sunday morning.",
                            "target_lang_translations": {
                                "ru": "В воскресенье утром они отправились <w>удить</w> рыбу на реке.",
                                "zh": "周日上午他们去河里<w>垂钓</w>了。"
                            }
                        },
                        {
                            "text": "He enjoys <w>angling</w> for trout in the mountain streams.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>ловить</w> форель в горных ручьях.",
                                "zh": "他喜欢在山间溪流中<w>钓</w>鳟鱼。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться поймать рыбу с помощью крючка и лески.",
                        "zh": "尝试用鱼钩和鱼线钓鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уди́ть",
                                "target_lang_sense_clarification": "ловить удочкой"
                            },
                            {
                                "target_lang_word": "рыба́чить",
                                "target_lang_sense_clarification": "заниматься рыбной ловлей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垂钓",
                                "target_lang_sense_clarification": "用鱼竿钓鱼"
                            },
                            {
                                "target_lang_word": "钓鱼",
                                "target_lang_sense_clarification": "捕鱼活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}