                        "sense_id": "a37a4919-a666-355f-96ff-098cb32ff188",
                        "entry_id": "f9c4d029-c6d8-320d-9e99-d029698372d6",
                        "glosses": [
                            "A progression of symptoms after treatment, before gradual improvement begins."
