            "senses": [
                {
                    "sense_id": "263ba9fa-d520-3d2b-8f05-827ed4cd661a",
                    "sense_definition": "vegen, met een bezem of borstel schoonmaken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer besloot de vloer van de schuur grondig te <w>vagen</w>.",
                            "target_lang_translations": {
                                "en": "The farmer decided to <w>sweep</w> the barn floor thoroughly."
                            }
                        },
                        {
                            "text": "Zij hielp haar grootmoeder met het <w>vagen</w> van de stoep.",
                            "target_lang_translations": {
                                "en": "She helped her grandmother with <w>sweeping</w> the sidewalk."
                            }
                        }
                    ],
                    "synonyms": [
                        "vegen",
                        "schoonmaken"
                    ],
                    "common_phrases": [
                        "de vloer vagen",
                        "de stoep vagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk in bepaalde dialecten of oudere taal gebruikt in plaats van 'vegen'."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To sweep, to clean with a broom or brush"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweep",
                                "target_lang_sense_clarification": "cleaning with a broom"
                            },
                            {
                                "target_lang_word": "brush",
                                "target_lang_sense_clarification": "cleaning or sweeping with a brush"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "026bfa2a-9c65-387b-afbc-8140fb380a25",
                    "sense_definition": "akkerland braak laten liggen om het te laten rusten",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een oude landbouwtraditie om de akker een jaar te <w>vagen</w>.",
                            "target_lang_translations": {
                                "en": "It is an old agricultural tradition to <w>leave</w> the field <w>fallow</w> for a year."
                            }
                        },
                        {
                            "text": "Door de grond te <w>vagen</w> herstelt de natuurlijke vruchtbaarheid zich sneller.",
                            "target_lang_translations": {
                                "en": "By <w>leaving</w> the soil <w>fallow</w>, its natural fertility recovers faster."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het land vagen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historische of zeer specifieke landbouwterm."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To leave agricultural land fallow to let it rest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave fallow",
                                "target_lang_sense_clarification": "letting agricultural land rest"
                            },
                            {
                                "target_lang_word": "fallow",
                                "target_lang_sense_clarification": "to plow but leave unseeded"
                            }
                        ]
                    }
                }
            ]
        }
    ]
