                                            {
                                                "example_id": "c0067d24-13b7-4e15-b934-c9244426c263",
                                                "sense_id": "cf9b96a6-23d5-338c-9dfd-19e254b7d504",
                                                "text": "Die Konferenzteilnehmer werden um Pünktlichkeit gebeten."
                                            },
                                            {
                                                "example_id": "61223e06-9745-4142-a0df-6dd2986b3dc9",
                                                "sense_id": "cf9b96a6-23d5-338c-9dfd-19e254b7d504",
                                                "text": "„Auch wenn nicht alle Konferenzteilnehmer ins Boot geholt werden können und keine besonders starke Abschlusserklärung erwartet wurde: Für die israelisch-(golf)arabischen Beziehungen ist die Konferenz auf alle Fälle eine Probe.“"
                                            },
                                            {
                                                "example_id": "23a437a4-9303-433d-a41f-01f2d0724b1c",
                                                "sense_id": "cf9b96a6-23d5-338c-9dfd-19e254b7d504",
                                                "text": "„In der Großen Halle tagten die Großen Drei vom 17. Juli bis zum 2. August, an einem in Moskau gebauten runden Tisch von 3,05 Metern Durchmesser, der fünfzehn Konferenzteilnehmern Platz bot.“"
                                            }
