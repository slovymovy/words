        "fr-extract.jsonl": [
            {
                "entry_id": "fffde4a3-6216-37f4-8652-68924260489b",
                "word": "concurremment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d97a6149-611b-319a-be69-34e2ef15c150",
                        "entry_id": "fffde4a3-6216-37f4-8652-68924260489b",
                        "glosses": [
                            "Par un concours mutuel ; ensemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f421f000-14fe-49fb-b984-4efe025a4b2b",
                                "sense_id": "d97a6149-611b-319a-be69-34e2ef15c150",
                                "text": "Chaque département, chaque arrondissement et chaque district ont en outre des magistrats particuliers qui exercent concurremment des fonctions administratives et judiciaires."
                            },
                            {
                                "example_id": "eff302bb-f0c5-42d8-8c77-9cea70f2cdd5",
                                "sense_id": "d97a6149-611b-319a-be69-34e2ef15c150",
                                "text": "Il faut que le criminel, concurremment avec la loi, se choisisse des juges."
                            },
                            {
                                "example_id": "f2d0d0fb-356f-4645-a788-fc96fbd2facb",
                                "sense_id": "d97a6149-611b-319a-be69-34e2ef15c150",
                                "text": "Vous avez saisi mon système : il consiste à attribuer concurremment le droit de faire la paix ou la guerre aux deux pouvoirs que la constitution a consacrés."
                            },
                            {
                                "example_id": "5d6c1a45-5a50-40a9-96b1-3b002571a370",
                                "sense_id": "d97a6149-611b-319a-be69-34e2ef15c150",
                                "text": "Le lupulin fut prescrit, concurremment avec la digitaline et quelques autres moyens appropriés aux circonstances."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e3e2e5b-8c37-3ca9-9b49-805d05a7b9cd",
                        "entry_id": "fffde4a3-6216-37f4-8652-68924260489b",
                        "glosses": [
                            "En concurrence l’un de l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518a8ac4-fab3-45a5-b6bd-05bfe9286a89",
                                "sense_id": "1e3e2e5b-8c37-3ca9-9b49-805d05a7b9cd",
                                "text": "De même, le seul caractère massif d’achats d’aliments ne rendait pas immédiatement commerciale la production animale dans la mesure où il y avait concurremment usage de quantités conséquentes de produits de la terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "861c4916-0848-3c48-bf95-0eabc8b93eb8",
                        "entry_id": "fffde4a3-6216-37f4-8652-68924260489b",
                        "glosses": [
                            "Au même rang."
                        ],
                        "tags": [
                            "Pratique"
                        ],
                        "examples": [
                            {
                                "example_id": "0e7e0772-6305-453b-bb70-9c91e3489493",
                                "sense_id": "861c4916-0848-3c48-bf95-0eabc8b93eb8",
                                "text": "[…], mais l’on n’était qu’en juin et, sauf pour les poires de moisson qui mûrissent en août, il fallait encore attendre longtemps avant de savourer concurremment les pommes du verger et la vengeance désirée."
                            },
                            {
                                "example_id": "41e125d1-4b46-4571-bc24-0b496baf592b",
                                "sense_id": "861c4916-0848-3c48-bf95-0eabc8b93eb8",
                                "text": "L’initiative de la révision de la Constitution appartient concurremment au Président de la République sur proposition du Premier Ministre et aux membres du Parlement."
                            },
                            {
                                "example_id": "131cebd7-9b4e-42e1-a18e-be184b7d0199",
                                "sense_id": "861c4916-0848-3c48-bf95-0eabc8b93eb8",
                                "text": "Ces créanciers viennent en ordre concurremment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f0774b4-5632-48e4-8930-7b1d83b92236",
                        "source_entry_id": "fffde4a3-6216-37f4-8652-68924260489b",
                        "target_lang_word": "concurrently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concurrently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                        "entry_id": "3d1c7fbe-64d5-331f-9272-eccb3c2c3501",
                                        "glosses": [
                                            "In a concurrent manner; at the same time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2b2d65-ac29-430e-8c4d-4ec1322e2d99",
                                                "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                                "text": "For the next four years Mr. Johnson continued building 2-4-0 express passenger engines, thus continuing the Kirtley practice, but from 1882 onwards he built all his express engines with the 4-4-0 or the 4-2-2 wheel arrangement, the two types being put in service concurrently between the years of 1887 and 1900."
                                            },
                                            {
                                                "example_id": "461233ef-12db-4340-bda6-915f7743c915",
                                                "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                                "text": "Concurrently with the St. Pancras-Bedford service, diesel trains have now taken over that between Kentish Town and Barking, on an even-interval basis at half-hourly intervals."
                                            },
                                            {
                                                "example_id": "4f057840-6f6a-4f67-bb2f-537ae2934bce",
                                                "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                                "text": "In many instances, the military was quite unable to distinguish right away between the Red Guard and Revolutionary organizations led by Maoist activists and those organized by Party officials whom Mao wished to topple, since both sides claimed to be dedicated to Mao’s policy. Furthermore, many military commanders were concurrently local administrators such as those in Tibet and Hsinchiang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfb4401b-50c7-437e-9b4b-7767ff0bcd27",
                        "source_entry_id": "fffde4a3-6216-37f4-8652-68924260489b",
                        "target_lang_word": "conjointly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjointly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b0aaefb8-b492-3ec7-ad8f-643586e00a15",
                                        "entry_id": "28662e0a-4456-3dd8-99ea-a819e2dfad86",
                                        "glosses": [
                                            "In a conjoint manner; jointly or together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6107c3ae-c31d-4d99-ad9b-ddfd11a27db0",
                                                "sense_id": "b0aaefb8-b492-3ec7-ad8f-643586e00a15",
                                                "text": "Elytra a little longer than wide conjointly, finely striate, intervals with a row of moderately coarse elongate punctures each bearing a semierect hair, surface subgranularly alutaceous."
                                            },
                                            {
                                                "example_id": "c9b55dda-86fd-4c9e-96e7-37441743fba7",
                                                "sense_id": "b0aaefb8-b492-3ec7-ad8f-643586e00a15",
                                                "text": "The folkland, the national fund, was administered and conveyed conjointly by the king and the witan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
