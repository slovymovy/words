                "senses": [
                    {
                        "sense_id": "d7758e70-2ab5-3dc0-afd3-80dca2f3b33a",
                        "entry_id": "a63fe2cf-0bd3-397b-ae3a-908fcede3224",
                        "glosses": [
                            "Ouvrière chargée des travaux de plomberie, comme les canalisations d’eau, particulièrement à domicile."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "0c71276d-bacb-475c-97bb-4f5506500521",
                                "sense_id": "d7758e70-2ab5-3dc0-afd3-80dca2f3b33a",
                                "text": "On ne s’étonnera donc pas d’apprendre que, pour la fourniture et l’établissement de la canalisation des fontaines de Paris, la municipalité parisienne avait fait marché avec une femme, Barbe Lequeux, qui était qualifiée plombière de la ville. Il est vrai que, dans cette grosse entreprise, elle avait succédé à son mari, mais il faut croire qu’elle s’y était montrée digne de la confiance accordée à celui-ci puisqu’elle en était restée chargée."
                            },
                            {
                                "example_id": "c59032ca-b5ff-435f-963a-fda705d58e5d",
                                "sense_id": "d7758e70-2ab5-3dc0-afd3-80dca2f3b33a",
                                "text": "Plombière au centre hospitalier de Moulins-Yzeure, Carole-Anne Terranova détonne dans une profession très majoritairement exercée par des hommes."
                            }
                        ]
                    },
                    {
                        "sense_id": "43f92add-57c6-3aeb-b05a-c8c7325ebc05",
                        "entry_id": "a63fe2cf-0bd3-397b-ae3a-908fcede3224",
                        "glosses": [
                            "Épouse d’un plombier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b8ca419d-0ff2-3ae1-85fb-3dd4897b2722",
                        "entry_id": "a63fe2cf-0bd3-397b-ae3a-908fcede3224",
                        "glosses": [
                            "Mine d’où on extrait du minerai de plomb."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eab3d0dd-b9e0-4839-b741-178159b18e8e",
                                "sense_id": "b8ca419d-0ff2-3ae1-85fb-3dd4897b2722",
                                "text": "Henri de Gueldre, élu de Liège, renonce au droit qu’il peut avoir à une plombière récemment découverte dans le bois, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "741b49ea-6d4a-38d1-94ef-b9141b737fc8",
                        "entry_id": "a63fe2cf-0bd3-397b-ae3a-908fcede3224",
                        "glosses": [
                            "Sorbetière."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "82164181-e401-414f-8ae4-c009f726ebf1",
                                "sense_id": "741b49ea-6d4a-38d1-94ef-b9141b737fc8",
                                "text": "La crème plombière a tiré son nom de l’ustensile où l’on frappe, appelé aujourd’hui sorbetière, autrefois l’on disait une plombière, vu que l’ustensile est en plomb et étain."
                            }
                        ]
                    }
                ],
