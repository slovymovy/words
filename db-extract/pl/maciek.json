                "senses": [
                    {
                        "sense_id": "183faa5c-0742-3888-920e-c58dcfe0e455",
                        "entry_id": "2b231f4f-5b1f-339a-970d-2a9df0c298d4",
                        "glosses": [
                            "brzuch, brzuszysko"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "85bc58b8-a40f-4103-9683-02f242b46994",
                                "sense_id": "183faa5c-0742-3888-920e-c58dcfe0e455",
                                "text": "To jest, proszę pana kasjera, moje zwyczajne tachnięcie po maćku. …Jak ja panu kasjerowi poszukam w brzuchu, to panu kasjerowi już nie pomoże żaden okulista."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a0faae61-986d-3b9c-a674-5c02762ee80c",
                        "entry_id": "2b231f4f-5b1f-339a-970d-2a9df0c298d4",
                        "glosses": [
                            "prostak, gbur, cham"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3da36d-c075-45a7-a00b-82889b87e5b1",
                                "sense_id": "a0faae61-986d-3b9c-a674-5c02762ee80c",
                                "text": "I gdzie taki maciek pcha się z łokciami?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6c0f8443-4348-394e-a85b-3b1afbda8d10",
                        "entry_id": "2b231f4f-5b1f-339a-970d-2a9df0c298d4",
                        "glosses": [
                            "obżartuch, grubas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dd4836a-53e3-4a60-9b40-9c7cebb94036",
                                "sense_id": "6c0f8443-4348-394e-a85b-3b1afbda8d10",
                                "text": "Pani gospodyni, przecież dla takiego maćka jajecznica z tuzina jaj to za mało!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "30f31122-95ae-3c6f-a6ab-90f316ebc4d0",
                        "entry_id": "2b231f4f-5b1f-339a-970d-2a9df0c298d4",
                        "glosses": [
                            "duża laga o zakrzywionym uchwycie"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "9ce4ce4a-cded-427c-bc42-aabf04796f05",
                                "sense_id": "30f31122-95ae-3c6f-a6ab-90f316ebc4d0",
                                "text": "Wędrowiec skutecznie opędzał się przed wiejskimi kundlami tęgim olszowym maćkiem."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "86858115-eb60-3801-b5ed-e4b0524a2262",
                        "entry_id": "2b231f4f-5b1f-339a-970d-2a9df0c298d4",
                        "glosses": [
                            "bocian"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "a9f3b572-206f-4d07-9cdf-7e721b3d7ec6",
                                "sense_id": "86858115-eb60-3801-b5ed-e4b0524a2262",
                                "text": "Wiosną jak co roku maciek zajął swe stare gniazdo na szopie."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
