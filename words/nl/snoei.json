                },
                {
                    "sense_id": "34293386-2626-3c3c-9dde-5c82b9196d33",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>snoeien</w> bij inversie",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Snoei</w> je de appelboom dit jaar zelf of vraag je de tuinman?",
                            "target_lang_translations": {
                                "fr": "<w>Tailles</w>-tu le pommier toi-même cette année, ou fais-tu appel au jardinier ?"
                            }
                        },
                        {
                            "text": "Waarom <w>snoei</w> je die struik nu al helemaal terug?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>rabats</w>-tu déjà complètement cet arbuste ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversie"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "deuxième personne du singulier au présent de l'indicatif du verbe « snoeien » en cas d'inversion sujet-verbe"
