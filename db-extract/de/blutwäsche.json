                        "glosses": [
                            "Reinigung des einem Patienten entnommenen Blutes von krankhaften Bestandteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4c9cd6-1c6f-48b5-825c-7e7073c89543",
                                "sense_id": "bd4ea37e-48cc-36da-84f4-a59ddce3975b",
                                "text": "„Der Bordarzt der Ikarus musste ihr eine Blutwäsche verpassen, die verabreichten Drogen hatten giftige Einlagerungen in den Organen hinterlassen.“"
                            },
                            {
                                "example_id": "1ef1781a-b8d5-4553-9e3e-f7e5af460a74",
                                "sense_id": "bd4ea37e-48cc-36da-84f4-a59ddce3975b",
                                "text": "„Elf Jahre lang begleitete ein amerikanisches Forscherteam der Emory University in Atlanta 242 Patienten, die eine Blutwäsche brauchten.“"
                            }
                        ],
