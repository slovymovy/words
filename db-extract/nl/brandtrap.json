                            {
                                "example_id": "f33a056d-941d-40f4-bddf-b481193716be",
                                "sense_id": "10cdbba9-9e60-3daa-8fad-69e623cc91b4",
                                "text": "Je moet de brandtrap altijd vrijhouden."
                            },
                            {
                                "example_id": "bef3be1b-dae1-43e0-84a7-e50ad49f3fd9",
                                "sense_id": "10cdbba9-9e60-3daa-8fad-69e623cc91b4",
                                "text": "Via de nooduitgang kom je bij de brandtrap."
                            },
                            {
                                "example_id": "3b779611-b63d-43eb-9f69-7275b99425ae",
                                "sense_id": "10cdbba9-9e60-3daa-8fad-69e623cc91b4",
                                "text": "Af en toe wierp hij een blik op Haralds slaapkamerraam, waarachter het licht de hele tijd brandde. Vanaf daar liepen de brandtrappen zigzaggend naar beneden."
