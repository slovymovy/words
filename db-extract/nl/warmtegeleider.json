                        "glosses": [
                            "stof of apparaat dat warmte van de ene naar de andere plaats kan laten stromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47d86a3-42ed-4d59-b274-9539a1b04f1d",
                                "sense_id": "bcf7ecdd-640c-33c9-88b6-0a3460249d51",
                                "text": "Vooral verse sneeuw is bovendien een slechte warmtegeleider, waardoor het ondergesneeuwde ijs nauwelijks warmte verliest en bevriezing wordt tegengegaan."
                            },
                            {
                                "example_id": "f63ce125-ee37-431d-8809-6176bd0598e2",
                                "sense_id": "bcf7ecdd-640c-33c9-88b6-0a3460249d51",
                                "text": "En zo geschiedde: Siebe, Dagmar en Linda knutselden in het technieklokaal een stoel en maakten van vier koperen buizen een warmtegeleider. Het uiteindelijke ontwerp presenteerden zij op de Milieuolympiade in Utrecht. En met succes: de scholieren werden vierde en sleepten bovendien de publieksprijs (250 euro) in de wacht."
                            }
                        ]
                    }
