                ],
                "senses": [
                    {
                        "sense_id": "f7c0f6dc-bb35-3bd8-a2c3-bd9233adeb24",
                        "entry_id": "f8fe6a46-0c2d-3150-b027-8f0fab9ad256",
                        "glosses": [
                            "intensiv empfundenes, entscheidendes Erlebnis, das späteres Handeln und Verhalten immer wieder beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cca5488-a30a-4212-9601-2c61f0848a18",
                                "sense_id": "f7c0f6dc-bb35-3bd8-a2c3-bd9233adeb24",
                                "text": "„Dennoch wurde diese eine Minute, allein in der Klasse mit dem Lehrer und seinem furchtbaren Satz, zu einem Urerlebnis für sie.“"
                            },
                            {
                                "example_id": "7da72dd7-d0f1-4b0f-afaf-930f4da690cb",
                                "sense_id": "f7c0f6dc-bb35-3bd8-a2c3-bd9233adeb24",
                                "text": "„Und was bedeutete die Bekanntschaft mit der neuartigen und einzigartigen Erscheinung eines mit uralten Überlieferungen getränkten, von dem Urerlebnis einer geheimnisvollen Offenbarung erfüllten, in Not und Tod sich immer wieder erneuernden, in Not und Tod sich immer wieder seines Ursprungs und seiner Sendung bewußt werdenden Genius des jüdischen Volkes einer Generation von Dichtern, Schriftstellern, Gelehrten und Philosophen, die den Ursprung des Menschengeschlechts, die Sendung des Moses, den Geist der hebräischen Poesie und die Sprache der Bibel zu deuten versuchte, und deren Weltanschauung von der Weltanschauung des Juden Spinoza geprägt worden war?“"
                            },
                            {
                                "example_id": "d49adbc6-6258-4c96-87ee-31a0228e28ad",
                                "sense_id": "f7c0f6dc-bb35-3bd8-a2c3-bd9233adeb24",
                                "text": "„Im Rahmen der Primärtheorie sind Einsichten ein quasi automatischer Prozess, der eintritt, wenn frühe psychische Blockaden durch ein Urerlebnis (also das Fühlen von „Urschmerzen“) aufgelöst werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
