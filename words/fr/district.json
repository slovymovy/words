            "senses": [
                {
                    "sense_id": "0a5dfa7c-eb1c-3940-8b73-e98b48a5d2e0",
                    "sense_definition": "Division territoriale, administrative, judiciaire ou électorale d'un pays ou d'une ville.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "division_territoriale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ville est divisée en plusieurs <w>districts</w> scolaires pour organiser les inscriptions."
                        },
                        {
                            "text": "Le juge a compétence sur l'ensemble de ce <w>district</w> judiciaire."
                        }
                    ],
                    "synonyms": [
                        "arrondissement",
                        "circonscription",
                        "secteur"
                    ],
                    "common_phrases": [
                        "district judiciaire",
                        "district électoral"
                    ]
                },
                {
                    "sense_id": "b96057d3-ebfd-3093-89ea-913c34ccdb9b",
                    "sense_definition": "Division administrative intermédiaire entre le canton et la commune dans certains cantons suisses.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "division_territoriale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le canton de Fribourg compte sept <w>districts</w> administratifs ayant chacun leur préfet."
                        },
                        {
                            "text": "Elle a déménagé dans un autre <w>district</w> du canton pour se rapprocher de son travail."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Suisse"
                        }
                    ]
                },
                {
                    "sense_id": "1a351544-a18d-37cb-8b5a-d7a45e530ba8",
                    "sense_definition": "Ancienne subdivision d'un département français, en vigueur de 1790 à 1795 avant d'être remplacée par l'arrondissement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "division_territoriale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous la Révolution, cette commune appartenait au <w>district</w> d'Amiens."
                        },
                        {
                            "text": "Les archives du <w>district</w> conservent de précieux registres de l'époque révolutionnaire."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Histoire de France"
                        }
                    ]
                },
                {
                    "sense_id": "c2fb38b9-275e-34e1-9498-35e9a20c196b",
                    "sense_definition": "Sous l'Ancien Régime, territoire sur lequel s'étendait l'autorité d'un juge ou d'un tribunal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "division_territoriale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magistrat ne pouvait exercer son autorité en dehors de son propre <w>district</w>."
                        },
                        {
                            "text": "Les limites de ce <w>district</w> seigneurial avaient été fixées par une ordonnance royale."
                        }
                    ],
                    "synonyms": [
                        "ressort"
                    ],
                    "traits": [
