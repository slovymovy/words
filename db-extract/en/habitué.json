                                        ],
                                        "examples": [
                                            {
                                                "example_id": "805dc368-e6dc-4a48-9b3b-ca5f26607efa",
                                                "sense_id": "421e6375-0eb4-3ce5-99cb-fb5be4d5ed32",
                                                "text": "η τακτική ετήσια γενική συνέλευση του σωματείου"
                                            },
                                            {
                                                "example_id": "3688b20a-dcf2-4b5f-b230-bc9d1a94e9cf",
                                                "sense_id": "421e6375-0eb4-3ce5-99cb-fb5be4d5ed32",
                                                "text": "※ Ο Παντελής, τακτικός, ανέβαινε κάθε πρωί, και δεν ήξερε τι να κάνει. (Δημήτρης Χατζής, Ανυπεράσπιστοι)"
                                            }
                                        ]
