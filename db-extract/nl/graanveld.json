                        "examples": [
                            {
                                "example_id": "ca2d3b6b-ecc2-4731-90bb-b0b34a0a1038",
                                "sense_id": "6967c86c-6ab7-37e6-bbf5-ddcb41db6180",
                                "text": "Het gouden graan wuifde in de wind op het graanveld.",
                                "translation": "The golden grain swayed in the wind on the grain field.",
                                "english": "The golden grain swayed in the wind on the grain field."
                            },
                            {
                                "example_id": "65db4ffd-8206-4771-a6d3-e58f8d451d81",
                                "sense_id": "6967c86c-6ab7-37e6-bbf5-ddcb41db6180",
                                "text": "De boer verzorgde het graanveldje zorgvuldig om een goede oogst te krijgen.",
                                "translation": "The farmer carefully tended the small grain field to get a good harvest.",
                                "english": "The farmer carefully tended the small grain field to get a good harvest."
                            },
                            {
                                "example_id": "54c944b5-2a6d-4a6d-ab1c-4bd5ef4c8428",
                                "sense_id": "6967c86c-6ab7-37e6-bbf5-ddcb41db6180",
                                "text": "In de zomer zijn de graanvelden een prachtig gezicht met hun rijpe gewassen.",
                                "translation": "In the summer, the grain fields are a beautiful sight with their ripe crops.",
                                "english": "In the summer, the grain fields are a beautiful sight with their ripe crops."
                            }
                        ]
