{
    "word_family": [
        "compartmentalize",
        "compartmentalization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8bf152e9-10ef-3394-abb1-79d4e621d7a8",
                    "sense_definition": "A separate section or room, especially within a vehicle like a train.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family sat together in a private <w>compartment</w> on the train.",
                            "target_lang_translations": {
                                "zh": "那家人一起坐在火车上的私人<w>隔间</w>里。"
                            }
                        },
                        {
                            "text": "He left his luggage in the overhead <w>compartment</w>.",
                            "target_lang_translations": {
                                "zh": "他把行李放在了头顶上方的<w>行李架</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "section",
                        "chamber",
                        "cubicle"
                    ],
                    "common_phrases": [
                        "train compartment",
                        "storage compartment"
                    ],
                    "target_lang_definitions": {
                        "zh": "指被分隔开的部分或房间，尤指火车等交通工具内的隔间。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "隔间",
                                "target_lang_sense_clarification": "指交通工具或房间内被分隔开的空间"
                            },
                            {
                                "target_lang_word": "行李架",
                                "target_lang_sense_clarification": "特指飞机或火车上方的储物空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb090353-bf61-3658-ba31-097a28cb1492",
                    "sense_definition": "One of the smaller parts into which a larger area or object is divided.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desk has a small <w>compartment</w> for storing pens and paper.",
                            "target_lang_translations": {
                                "zh": "这张桌子有一个用来存放笔和纸的小<w>格子</w>。"
                            }
                        },
                        {
                            "text": "She organized her tools into each <w>compartment</w> of the box.",
                            "target_lang_translations": {
                                "zh": "她把工具整理好，分别放进盒子的每一个<w>分隔区</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "division",
                        "partition",
                        "section"
                    ],
                    "common_phrases": [
                        "separate compartment"
                    ],
                    "target_lang_definitions": {
                        "zh": "指将较大区域或物体划分出的较小部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "格子",
                                "target_lang_sense_clarification": "指抽屉或盒子内的小分隔空间"
                            },
                            {
                                "target_lang_word": "分隔区",
                                "target_lang_sense_clarification": "指被划分出的特定区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1711cae4-1e65-3fbd-a66e-41fef911f555",
                    "sense_definition": "A specific region within the body separated by a biological membrane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The muscle is located in a distinct fascial <w>compartment</w>.",
                            "target_lang_translations": {
                                "zh": "这块肌肉位于一个独立的<w>筋膜室</w>内。"
                            }
                        },
                        {
                            "text": "Fluid pressure can increase within a closed <w>compartment</w> of the leg.",
                            "target_lang_translations": {
                                "zh": "腿部封闭的<w>筋膜室</w>内液体压力可能会升高。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指生物体内由生物膜分隔开的特定区域。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "筋膜室",
                                "target_lang_sense_clarification": "医学术语，指肌肉所在的解剖学分隔空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2687d2ae-6881-3024-ae65-6a029e560491",
                    "sense_definition": "A specific part of a protein structure that performs a distinct function.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This protein contains a binding <w>compartment</w> that interacts with DNA.",
                            "target_lang_translations": {
                                "zh": "这种蛋白质包含一个与DNA相互作用的结合<w>结构域</w>。"
                            }
                        },
                        {
                            "text": "Researchers identified a new functional <w>compartment</w> within the enzyme.",
                            "target_lang_translations": {
                                "zh": "研究人员在酶中发现了一个新的功能性<w>结构域</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "domain"
                    ],
                    "target_lang_definitions": {
                        "zh": "指蛋白质结构中执行特定功能的特定部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "结构域",
                                "target_lang_sense_clarification": "生物化学术语，指蛋白质中具有独立功能的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "703c8b86-8a39-3400-bc04-6b03141e8a6f",
                    "sense_definition": "A base or platform in a coat of arms upon which supporters stand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion stands proudly on the grassy <w>compartment</w> of the shield.",
                            "target_lang_translations": {
                                "zh": "狮子骄傲地站在盾徽下方草地状的<w>底座</w>上。"
                            }
                        },
                        {
                            "text": "The heraldic design features a rocky <w>compartment</w> beneath the supporters.",
                            "target_lang_translations": {
                                "zh": "该纹章设计在盾徽兽下方绘有一个岩石状的<w>底座</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指纹章学中盾徽下方支撑盾徽兽的基座或平台。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "底座",
                                "target_lang_sense_clarification": "纹章学中支撑盾徽兽的基部"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d69dfb01-c999-394c-9fb4-18fe532fe444",
                    "sense_definition": "To divide or arrange something into separate sections.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>compartment</w> the storage area to keep items organized.",
                            "target_lang_translations": {
                                "zh": "他们决定将储藏区<w>分隔</w>开，以便保持物品整齐。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>compartment</w> all the different tasks in such a small space.",
                            "target_lang_translations": {
                                "zh": "在这么小的空间里将所有不同的任务<w>划分</w>开是很困难的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "partition",
                        "subdivide"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物划分或安排成不同的部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "分隔",
                                "target_lang_sense_clarification": "指将空间或事物进行划分"
                            },
                            {
                                "target_lang_word": "划分",
                                "target_lang_sense_clarification": "指将整体分为若干部分"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}