                "senses": [
                    {
                        "sense_id": "266402fc-fe27-3eb6-8b7a-4dc47c4a7bad",
                        "entry_id": "41db0f75-5215-39ab-9d2c-e74108091bd9",
                        "glosses": [
                            "Rosir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76d903b9-ada6-4ef0-89d4-fd367e76a5c5",
                                "sense_id": "266402fc-fe27-3eb6-8b7a-4dc47c4a7bad",
                                "text": "Ainsi que d’épis mûrs, ai souvenir : et, Dieu Très morne ! que n’a pu ma lèvre de déesse Réveiller ses doux Yeux et rerosir un peu"
                            },
                            {
                                "example_id": "c7bc3174-ac40-43f5-bda5-2a6e0b93e68f",
                                "sense_id": "266402fc-fe27-3eb6-8b7a-4dc47c4a7bad",
                                "text": "Après la trahison de la CFDT sur les retraites, ce qu’il faut bien appeler un syndicat a tenté de « rerosir » son fanion en soutenant la mort dans l’âme le soulèvement de la jeunesse contre le CPE."
                            }
                        ]
                    }
