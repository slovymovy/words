                                "target_senses": [
                                    {
                                        "sense_id": "c1b5ecbe-7d67-3020-ab22-5bc89ce6a12b",
                                        "entry_id": "82ba4f0c-3ee9-3c2e-b1f2-f5440b12c54c",
                                        "glosses": [
                                            "Trabajador asiático sin experiencia, usualmente de descendencia china o india; obrero."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813b686a-0024-4f85-a9e1-948ff6a67fc9",
                                                "sense_id": "c1b5ecbe-7d67-3020-ab22-5bc89ce6a12b",
                                                "text": "Cualquier potencia que controle África ecuatorial, los países de Oriente Medio, el sur de la India o el archipiélago indonesio dispone también de decenas o centenares de millones de culis trabajadores y mal pagados."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
