                        "translation_id": "956c571f-806d-4e57-a81e-fe1aa5056db8",
                        "source_entry_id": "d6709e72-abf2-3c52-bbab-c703194e8c36",
                        "source_sense_id": "36caeba5-5103-3106-87e1-856e9680f9a6",
