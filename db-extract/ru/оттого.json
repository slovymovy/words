                                                "example_id": "6934ef96-3093-491a-9514-59ac85a1d994",
                                                "sense_id": "783859e2-fccc-327e-ab35-7569d0fb0463",
                                                "text": "Indi s'alzò e il guardo a me volse"
                                            }
                                        ]
                                    }
                                ]
