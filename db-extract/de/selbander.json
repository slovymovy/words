                        "source_entry_id": "38b74c99-657f-30a5-88ba-899daa400602",
                        "source_sense_id": "7729acc6-8ebf-30d7-854d-cd6bef53e5ef",
                        "source_sense_description": "veraltet: zu zweit",
                        "target_lang_word": "вдвоём",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вдвоём",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a69b5f86-960c-3952-beae-599a37987078",
                                        "entry_id": "d1db60a9-9e7f-371b-bd2e-3c79c47412ca",
                                        "glosses": [
                                            "в количестве двух человек, лиц; вместе с другим лицом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0254e31-210a-430b-80d1-de2ce074a240",
                                                "sense_id": "a69b5f86-960c-3952-beae-599a37987078",
                                                "text": "Они вдвоём несли большой поднос с горшком молока, тарелками, ложками, сахаром, ягодами, хлебом."
                                            },
                                            {
                                                "example_id": "0dc44281-7a60-47f9-9a0f-f7e99fe4bce4",
                                                "sense_id": "a69b5f86-960c-3952-beae-599a37987078",
                                                "text": "Вдвоём выпили они штофчик, взятый из города."
                                            },
                                            {
                                                "example_id": "b1221d82-6a3c-472d-8d26-56361f3d01b7",
                                                "sense_id": "a69b5f86-960c-3952-beae-599a37987078",
                                                "text": "Только вдвоём им было не оскорбительно и не больно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9196c355-159c-3af2-aa12-6646ce566874",
                                        "entry_id": "d1db60a9-9e7f-371b-bd2e-3c79c47412ca",
                                        "glosses": [
                                            "без свидетелей; с глазу на глаз; наедине"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374829d3-20fc-4f65-b16c-2afe428bc752",
                                                "sense_id": "9196c355-159c-3af2-aa12-6646ce566874",
                                                "text": "«Ну, Иван Фёдорович! о чём же вы говорили вдвоём с барышнею?» спросила дорогою тётушка."
                                            }
                                        ]
                                    }
                                ]
