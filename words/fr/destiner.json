    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff8dde2e-e513-36d9-ad0f-4fb8f575175d",
                    "sense_definition": "Affecter une personne ou une chose à un emploi, un usage ou une fonction spécifique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité <w>destine</w> cet ancien entrepôt à la création d'un centre culturel."
                        },
                        {
                            "text": "Ces fonds supplémentaires sont <w>destinés</w> à financer la recherche médicale."
                        }
                    ],
                    "synonyms": [
                        "réserver",
                        "consacrer",
                        "vouer"
                    ],
                    "common_phrases": [
                        "destiner à",
                        "être destiné à"
                    ]
                },
                {
                    "sense_id": "e314ed07-0fbc-3493-a42f-96492ea45cd7",
                    "sense_definition": "Préparer ou réserver quelque chose à l'intention d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il garde précieusement cette montre de famille qu'il <w>destine</w> à son fils."
                        },
                        {
                            "text": "Nous ignorons encore quel sort la direction <w>destine</w> à notre équipe de recherche."
                        }
                    ],
                    "synonyms": [
                        "réserver",
                        "préparer"
                    ],
                    "common_phrases": [
                        "destiner à quelqu'un"
                    ]
                },
                {
                    "sense_id": "e13a4322-25ec-3cee-a2da-515836be6430",
                    "sense_definition": "Fixer ou déterminer d'avance par la force du destin ou de la fatalité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fatalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès son enfance, tout le monde pensait que le sort l'avait <w>destiné</w> à une grande carrière."
                        },
                        {
                            "text": "Le jeune prince semblait <w>destiné</w> à régner sur un empire puissant."
                        }
                    ],
                    "synonyms": [
                        "prédestiner",
                        "vouer"
                    ],
                    "common_phrases": [
                        "être destiné à la gloire"
                    ]
                }
            ]
        }
    ]
