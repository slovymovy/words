                    },
                    {
                        "translation_id": "df5a1f75-bd36-4e50-bedd-fe2ccb7c439c",
                        "source_entry_id": "028dae66-0546-3eb7-986f-72678db23e33",
                        "source_sense_id": "70971b5f-32ff-3166-902e-8852743d505b",
                        "target_lang_word": "Theist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                        "entry_id": "72f21a53-69a6-3b06-bc5e-047bc9346815",
                                        "glosses": [
                                            "Anhänger des Theismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9289aa-87e6-4dd2-a7a8-e6a522f294e3",
                                                "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                                "text": "Theisten glauben an Gott."
                                            },
                                            {
                                                "example_id": "9153fad1-c4bd-4c71-bd07-f996d2b55d10",
                                                "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                                "text": "„Man behauptet, daß ein Atheist, der bei seinen Erwägungen an Gott denkt, mehr wert ist, als ein Theist, der nie an ihn denkt.“"
                                            },
                                            {
                                                "example_id": "35f446cc-3b43-4709-9a63-7434f463a321",
                                                "sense_id": "368d93e8-a1a9-3474-9f11-0ab7c0e51ec2",
                                                "text": "„Die Religionen wurden ihres dogmatischen, symbolischen, historischen Inhaltes entkleidet, und der Gott, den die Theisten übrigließen, war eine bloße Abstraktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e08ece7-7a27-3904-8415-7650a4d668e7",
