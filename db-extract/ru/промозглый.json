                                "target_senses": [
                                    {
                                        "sense_id": "f5d3fa41-ece1-39f7-b6aa-62220307271e",
                                        "entry_id": "daaae361-6c51-345e-a3a8-129c87eb9fce",
                                        "glosses": [
                                            "Dark, damp and humid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b5d0806-e1e9-488a-b312-fdacf940c8fd",
                                                "sense_id": "f5d3fa41-ece1-39f7-b6aa-62220307271e",
                                                "text": "The dank cave was chilly and spooky."
                                            },
                                            {
                                                "example_id": "97e8b5de-60ab-4ce1-aa81-65ad35857a4d",
                                                "sense_id": "f5d3fa41-ece1-39f7-b6aa-62220307271e",
                                                "text": "Now that the fields are dank and ways are mire."
                                            },
                                            {
                                                "example_id": "7f62cd53-6b76-4577-8504-b3f4ce4b02e4",
                                                "sense_id": "f5d3fa41-ece1-39f7-b6aa-62220307271e",
                                                "text": "Cheerless watches on the cold, dank ground."
                                            },
                                            {
                                                "example_id": "f28a370b-08f8-4a54-8473-c36721c433d9",
                                                "sense_id": "f5d3fa41-ece1-39f7-b6aa-62220307271e",
                                                "text": "Who were the strugglers, what war did they wage, / Whose savage trample thus could pad the dank / Soil to a plash? [...]"
                                            },
                                            {
                                                "example_id": "65e39e99-c821-4e3e-81f5-370000946f0e",
                                                "sense_id": "f5d3fa41-ece1-39f7-b6aa-62220307271e",
                                                "text": "It's a world away from the dank and uninviting St Pancras that British Rail wanted to tear down in the 1960s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c45c64-727c-3a69-8bd4-a92c79fb2508",
                                        "entry_id": "daaae361-6c51-345e-a3a8-129c87eb9fce",
                                        "glosses": [
                                            "Moist and sticky, (by extension) highly potent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b1508a3-5570-4cde-9949-96f9bc09f68c",
                                                "sense_id": "b2c45c64-727c-3a69-8bd4-a92c79fb2508",
                                                "text": "That was dank bud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccc18f62-8ec0-3aae-a42d-e7b6351e8de8",
                                        "entry_id": "daaae361-6c51-345e-a3a8-129c87eb9fce",
                                        "glosses": [
                                            "Great, awesome."
                                        ],
                                        "tags": [
