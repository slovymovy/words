                        "examples": [
                            {
                                "example_id": "74f963d4-2a11-4097-ac23-857483302220",
                                "sense_id": "a7ed0144-604a-3f28-9351-58c749c154ba",
                                "text": "Przyniesiona przez kelnera przystawka była bardzo gorąca."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "99d4f9e9-901a-3acb-804f-717db306ebb5",
                        "entry_id": "72ddae83-8c7f-3467-8979-4dc63f0b7700",
                        "glosses": [
                            "urządzenie dołączane do innego i współpracujące z nim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec554ee-6275-41d8-9aac-3fada0ceb970",
                                "sense_id": "99d4f9e9-901a-3acb-804f-717db306ebb5",
                                "text": "Robot kuchenny został wyposażony w przystawkę do odwirowywania soków owocowych."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
