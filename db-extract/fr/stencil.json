                                    {
                                        "sense_id": "52b079bd-fa27-3607-9656-aa204037a7b9",
                                        "entry_id": "0bbce2ea-e766-38fd-a30f-e7e45b549a74",
                                        "glosses": [
                                            "A thin sheet, either perforated or using some other technique, with which a pattern may be produced upon a surface; a utensil that contains a perforated sheet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e09a36-b700-46c4-a4ca-e16c3ee63e1e",
                                                "sense_id": "52b079bd-fa27-3607-9656-aa204037a7b9",
                                                "text": "You do not necessarily need to have a stencil brush to paint over a stencil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82e30a8e-02df-38fd-b49a-330c0af2b1e3",
                                        "entry_id": "0bbce2ea-e766-38fd-a30f-e7e45b549a74",
                                        "glosses": [
                                            "A pattern produced using such a utensil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5b82b4-2ad3-443f-9c9c-cadab93f3bb3",
                                                "sense_id": "82e30a8e-02df-38fd-b49a-330c0af2b1e3",
                                                "text": "In 2013 a damaged stencil of a rat and an image of a girl hugging a bomb were painted over on the walls of a Fitzroy church by the building owner’s father-in-law, who tried to help out by painting the building while house sitting. He did not know the significance of the stencils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480206d3-c7d2-38d9-8488-dfcf0d18b203",
                                        "entry_id": "0bbce2ea-e766-38fd-a30f-e7e45b549a74",
                                        "glosses": [
                                            "A two-ply master sheet for use with a mimeograph."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stencil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b80d5983-f580-321a-99f6-feb5be204db2",
                                        "entry_id": "ac44ef0d-4358-3e81-a0bf-dd3002e6d5af",
                                        "glosses": [
                                            "To print with a stencil."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c45fc820-5588-4bfa-acf4-5272892ef9cc",
                                                "sense_id": "b80d5983-f580-321a-99f6-feb5be204db2",
                                                "text": "Stencilled letters were used for words and phrases, as well as for captions for some of his stencil “prints,” print being used in the sense of a multicolor woodcut."
                                            }
                                        ]
                                    }
                                ]
                            }
