                "senses": [
                    {
                        "sense_id": "ab499f71-d221-39b0-a133-a5ebfd51fc30",
                        "entry_id": "948dc3af-d303-3f97-943c-bcafb3547c8b",
                        "glosses": [
                            "osoba, która kogoś naśladuje, wzoruje się na kimś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f77898-4b4c-48bd-a12b-2250dc2e13fb",
                                "sense_id": "ab499f71-d221-39b0-a133-a5ebfd51fc30",
                                "text": "Wegetarianizm to opcja, której naśladowcami są przede wszystkim buddyści."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14245d70-3d28-46be-b18e-babefed88cd2",
                        "source_entry_id": "948dc3af-d303-3f97-943c-bcafb3547c8b",
                        "source_sense_id": "ab499f71-d221-39b0-a133-a5ebfd51fc30",
                        "target_lang_word": "imitator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imitator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9813002d-587e-38bc-b135-6dd45e40c87b",
                                        "entry_id": "36bce7f4-91e3-3e2a-a9ac-a78da43aeb5d",
                                        "glosses": [
                                            "A person who imitates or apes another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621ae26d-4a79-499d-b81f-44c05387bef9",
                                                "sense_id": "9813002d-587e-38bc-b135-6dd45e40c87b",
                                                "text": "Chalk it up to the government’s revelations in recent years about UFOs, or maybe just the pendulum swinging back, again, after “The X-Files” inspired a host of imitators in the 1990s."
                                            },
                                            {
                                                "example_id": "87bbe984-6007-45f7-9896-40c7f48b1f4a",
                                                "sense_id": "9813002d-587e-38bc-b135-6dd45e40c87b",
                                                "text": "Other far-right sites would gravitate to Epik. Among the first to announce its migration in early 2019 was BitChute, a YouTube imitator that had been blocked by PayPal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2dfaf6-6c7f-4a93-8da7-7b518c96562d",
                        "source_entry_id": "948dc3af-d303-3f97-943c-bcafb3547c8b",
                        "source_sense_id": "ab499f71-d221-39b0-a133-a5ebfd51fc30",
                        "target_lang_word": "mimic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4c000d9-fed2-3caf-bea3-05d9d7282e2f",
                                        "entry_id": "a40338ab-c50e-3533-a318-275d8fd68fc4",
                                        "glosses": [
                                            "To imitate, especially in order to ridicule."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d411e67f-6ffe-4948-9c64-c9f05a58f0d5",
                                                "sense_id": "c4c000d9-fed2-3caf-bea3-05d9d7282e2f",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1e4511-b99d-36ea-9f80-043560eac235",
                                        "entry_id": "a40338ab-c50e-3533-a318-275d8fd68fc4",
                                        "glosses": [
                                            "To take on the appearance of another, for protection or camouflage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "711d141a-ce28-3c4f-953d-2ef37694678b",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "A person who practices mimicry; especially:",
                                            "A mime."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5b594e4-212b-3469-bac2-94a5107d3eca",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "A person who practices mimicry; especially:",
                                            "A comic who does impressions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1f95f44-ea75-3707-9a14-7763689f7b98",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "An entity that mimics another entity, such as a disease that resembles another disease in its signs and symptoms; see the great imitator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c0ab0b-7bea-30b3-86d8-cbc51c78ad4d",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "An imitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce1ebec5-5496-4abc-bb58-198f70bdbae3",
                                                "sense_id": "04c0ab0b-7bea-30b3-86d8-cbc51c78ad4d",
                                                "text": "Jess jumped slightly at hearing Tillyʼs extremely accurate mimic of her voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5443df12-6385-3a07-b289-4a81dcb45ce3",
                                        "entry_id": "9523d096-4412-3831-8acc-536619ca33ed",
                                        "glosses": [
                                            "A fictional monster able to disguise itself as an inanimate object, commonly a treasure chest, often with the intent of luring adventurers into a trap."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mimic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                        "entry_id": "334e9d2c-e44d-335d-966c-358e14a3fe9c",
                                        "glosses": [
                                            "Pertaining to mimicry; imitative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "389a2deb-129d-44f1-b17c-f7da001ddfd8",
                                                "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                                "text": "I think every man is cloied and wearied, with seeing so many apish and mimicke trickes, that juglers teach their Dogges, as the dances, where they misse not one cadence of the sounds or notes they heare[…]."
                                            },
                                            {
                                                "example_id": "369b90cd-e11e-4d3d-bd6a-833a0a377d46",
                                                "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                                "text": "Oft, in her absence, mimic fancy wakes / To imitate her."
                                            },
                                            {
                                                "example_id": "cec7c423-5242-4eec-aa8c-466b3f6e464d",
                                                "sense_id": "fa5089b6-1612-3c3d-af12-5eb0d54fda67",
                                                "text": "And there, with fingers interwoven, both hands\nPressed closely palm to palm and to his mouth\nUplifted, he, as through an instrument,\nBlew mimic hootings to the silent owls,\nThat they might answer him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92d5bebf-717b-3ace-a6de-0eb6d888dda1",
                                        "entry_id": "334e9d2c-e44d-335d-966c-358e14a3fe9c",
                                        "glosses": [
                                            "Mock, pretended."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "433582a5-4adc-34c9-9870-3602b134a5e9",
                                        "entry_id": "334e9d2c-e44d-335d-966c-358e14a3fe9c",
                                        "glosses": [
                                            "Imitative; characterized by resemblance to other forms; applied to crystals which by twinning resemble simple forms of a higher grade of symmetry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91c816e6-99c3-47d5-982d-f986953a5bdc",
                        "source_entry_id": "948dc3af-d303-3f97-943c-bcafb3547c8b",
                        "source_sense_id": "ab499f71-d221-39b0-a133-a5ebfd51fc30",
                        "target_lang_word": "imitateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imitateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                        "entry_id": "aefd927c-01b7-3973-86c7-a659de50170c",
                                        "glosses": [
                                            "Celui qui imite, en parlant principalement d’une personne qui règle sa conduite, ses actions sur celles d’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74b0d1b5-fe84-4857-90f7-9776291bd07d",
                                                "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                                "text": "Je forme une entreprise qui n’eut jamais d’exemple, et dont l’exécution n’aura point d’imitateur. Je veux montrer à mes semblables un homme dans toute la vérité de la nature, et cet homme, ce sera moi."
                                            },
                                            {
                                                "example_id": "207ae223-187a-4cac-9cf4-e1e2b22aaff8",
                                                "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                                "text": "Ridicules imitateurs des manies anglaises, en faisant des courses, nous avons aussi introduit chez nous l’usage des paris et nous en avons fait une véritable science de combinaison."
                                            },
                                            {
                                                "example_id": "4a951082-f56e-43a8-b624-b79812075888",
                                                "sense_id": "4ae884a3-98a5-3593-b09a-9fa2b6f30aaf",
                                                "text": "C’est un jeu d’enfant, en cours de route, de se substituer aux substituteurs, d’imiter les imitateurs, de plagier les plagieurs, de renévroser les névroses, de psychotiser les psychoses, et surtout, surtout, de déféticher les féticheurs, de réensorceler les sorcières et les envoûteurs inconscients, bien sûr, peu importe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "083c4762-ddbd-37d3-b65c-500b44e9c8c4",
                                        "entry_id": "aefd927c-01b7-3973-86c7-a659de50170c",
                                        "glosses": [
                                            "Artiste qui donne en spectacle, en les forçant, une imitation de la voix et des manières d'un personnage public."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "946dcf5a-4c19-4ac5-bcff-54c182706563",
                                                "sense_id": "083c4762-ddbd-37d3-b65c-500b44e9c8c4",
                                                "text": "Vince Taylor passa en vedette à l’Olympia, avec, en vedette américaine, Henri Tisot, l’imitateur du général De Gaulle et en vedette anglaise, à l’antépénultième place, Rosalie Dubois une ancienne poissonnière […]."
                                            },
                                            {
                                                "example_id": "a4b6b506-5bb5-48bf-bb5e-c1ddb8573699",
                                                "sense_id": "083c4762-ddbd-37d3-b65c-500b44e9c8c4",
                                                "text": "Le professeur Léon Schwartzenberg vient d’annoncer que le célèbre imitateur souffre d’un cancer des voies respiratoires et que le traitement chimiothérapique l’oblige à annuler son spectacle au palais des Congrès, qui devait débuter la semaine prochaine à guichets fermés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cffc3a8f-3ce6-32cf-b732-05dc91919f62",
                                        "entry_id": "aefd927c-01b7-3973-86c7-a659de50170c",
                                        "glosses": [
                                            "Écrivain ou artiste qui imite le style, la manière, le genre d’un autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd2b647-97e9-4842-b433-aaad0ef96508",
                                                "sense_id": "cffc3a8f-3ce6-32cf-b732-05dc91919f62",
                                                "text": "Cet écrivain, cet artiste a eu beaucoup d’imitateurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imitateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a5e0505-13bb-3020-8e27-66e2b7bb870f",
                                        "entry_id": "fc0fb3c8-ce9c-38f4-8d8e-0cfdee2640aa",
                                        "glosses": [
                                            "Qui imite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf15127-2211-4512-955a-cbf7cc45c028",
                                                "sense_id": "3a5e0505-13bb-3020-8e27-66e2b7bb870f",
                                                "text": "Les Russes sont tellement imitateurs, que toutes les maladies de la civilisation se répercutent chez eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
