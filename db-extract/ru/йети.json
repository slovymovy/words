                "senses": [
                    {
                        "sense_id": "89384987-8666-3ad8-8e81-b0fdafec001a",
                        "entry_id": "2da6394f-8dd5-3394-b799-5bb655055ad1",
                        "glosses": [
                            "гипотетическое человекообразное существо, обитающее, якобы, в горах Центральной Азии; снежный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bcc3842-057b-4af1-897d-e8765d5df78d",
                                "sense_id": "89384987-8666-3ad8-8e81-b0fdafec001a",
                                "text": "Трудно вспомнить, когда появились первые слухи о том, что среди гималайских вершин обитает неизвестное лохматое существо, не то зверь, не то человек. ❬…❭ Местные жители зовут его йети, учёные называют реликтовым гоминоидом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa656438-419a-4ef2-8b16-aebaba0975d8",
                        "source_entry_id": "2da6394f-8dd5-3394-b799-5bb655055ad1",
                        "source_sense_id": "89384987-8666-3ad8-8e81-b0fdafec001a",
                        "target_lang_word": "yeti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yeti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                        "entry_id": "34e283c6-c49b-3b5a-a522-a4f20d078f81",
                                        "glosses": [
                                            "An unidentified humanoid animal said to live in the Himalayas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f53c57-8600-4b02-9e62-97b8b4ad4f50",
                                                "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                                "text": "There is no doubt that the Sherpas accept the fact that the Yeti really exists. But then they believe just as confidently that their gods live in comfort on the summit of Mount Everest. We found it quite impossible to divorce the Yeti from the supernatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
