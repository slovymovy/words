                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het decimale stelsel kijken we eerst naar de eenheden en dan naar het <w>tiental</w>.",
                            "target_lang_translations": {
                                "en": "In the decimal system, we first look at the units and then at the <w>tens</w>.",
