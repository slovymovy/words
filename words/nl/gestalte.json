                    "frequency": "Low",
                    "semantic_group_id": "vormgeving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe beleid moet nog een definitieve <w>gestalte</w> krijgen.",
                            "target_lang_translations": {
