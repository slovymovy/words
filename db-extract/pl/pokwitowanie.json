                    {
                        "translation_id": "fcd4a6c7-96a7-414c-9b22-0d79448076fc",
                        "source_entry_id": "f6073c5c-1d47-3d9c-a064-0087733f831c",
                        "source_sense_id": "85c102be-dd5a-3340-8b13-70485c66ea1c",
                        "target_lang_word": "Quittung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quittung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9583fa46-a58d-351e-9ddd-2d45502b19d6",
                                        "entry_id": "8d780cbd-c6ca-399b-b545-adf05f32c64e",
                                        "glosses": [
                                            "Empfangsbestätigung, Hotelquittung, Zahlungsbestätigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda8bdb6-e377-43be-ac48-21e9abe8dedf",
                                                "sense_id": "9583fa46-a58d-351e-9ddd-2d45502b19d6",
                                                "text": "Die Quittungen sollte man für spätere Garantieansprüche sorgfältig aufbewahren."
                                            },
                                            {
                                                "example_id": "eb1324b5-5a24-445b-9bcf-344aeef33d86",
                                                "sense_id": "9583fa46-a58d-351e-9ddd-2d45502b19d6",
                                                "text": "„Ihre Hand umklammerte einen Zettel, eine Quittung des Lebensmittelhändlers, mit einer Adresse auf der Rückseite.“"
                                            },
                                            {
                                                "example_id": "49f760ad-a0c0-4cd9-b45b-af387a164511",
                                                "sense_id": "9583fa46-a58d-351e-9ddd-2d45502b19d6",
                                                "text": "„Ein Stück außerhalb der Stadt Mzcheta kommen wir wieder an einen Schlagbaum, wo Karnej die Quittung für bezahltes Weggeld vorzeigen muß.“"
                                            },
                                            {
                                                "example_id": "48ec0f06-407a-414a-9c89-4ee29d6114d2",
                                                "sense_id": "9583fa46-a58d-351e-9ddd-2d45502b19d6",
                                                "text": "„Sie las daraufhin die Quittung und fragte mich, warum ich den Schuldschein nicht selbst aufbewahrt hätte.“"
                                            },
                                            {
                                                "example_id": "02401859-b162-4e08-b7b5-748c10be74d7",
                                                "sense_id": "9583fa46-a58d-351e-9ddd-2d45502b19d6",
                                                "text": "„Schweigend schrieben beide den Scheck und die Quittung aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16c1c26a-bd7b-3a6d-9089-4bc1d8bcfe3d",
                                        "entry_id": "8d780cbd-c6ca-399b-b545-adf05f32c64e",
                                        "glosses": [
                                            "Konsequenz für bestimmtes Handeln"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde6e3de-2c81-4c95-83ac-6ee476c135ef",
                                                "sense_id": "16c1c26a-bd7b-3a6d-9089-4bc1d8bcfe3d",
                                                "text": "Als Quittung für sein schlechtes Benehmen wurde er einfach ignoriert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
