                ],
                "senses": [
                    {
                        "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                        "entry_id": "0e7511f2-b04c-355d-88a6-ced33a91fae4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47b3de7-e94f-42ab-850b-f6aacf65630b",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Berteles kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ede0d6fd-6ab2-4a29-a0d7-a19429a25551",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Frau Bertele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ce5cfdc9-670c-423f-ab8d-3e1f232a5e4f",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Herr Bertele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7e59fa4e-253f-4b1b-957f-cb415ac1ce9b",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Die Berteles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0cfa135b-07ce-4814-ac2d-0b8b89b779c6",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Der Bertele trägt nie die Schals, die die Bertele ihm strickt."
                            },
                            {
                                "example_id": "c7fb5988-acc6-4e56-8706-1cf037221e76",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bertele kommt, geht der Herr Bertele.“"
                            },
                            {
                                "example_id": "969f82ea-047b-4986-bc26-e015d07edd06",
                                "sense_id": "7f5cbec5-02b5-309e-8ec8-4a963a89f376",
                                "text": "Bertele kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
