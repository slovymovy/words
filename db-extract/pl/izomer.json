                        "entry_id": "e0c8a20b-fba8-335c-858e-00960f02f37e",
                        "glosses": [
                            "jeden z dwóch lub większej liczby związków chemicznych o tym samym składzie atomowym, różniących się połączeniami lub ułożeniem atomów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de5a6f0f-cd2b-4415-a312-a2ee5a55777d",
                                "sense_id": "3d8653d0-ba10-389c-b1aa-33733c7eebb6",
                                "text": "Przyczyny zróżnicowania zapachu obu izomerów karwonu są w ostatnich latach przedmiotem ożywionej polemiki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4e88a97-adfe-4286-a9b0-0155ec2e741d",
