                                        "sense_id": "f3678df5-467b-3380-881b-a819b48b43df",
                                        "entry_id": "48957b71-ffd4-352e-9691-0315b127bf19",
                                        "glosses": [
                                            "den Neoliberalismus betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d625ef58-8939-4820-8807-d46c34c77935",
                                                "sense_id": "f3678df5-467b-3380-881b-a819b48b43df",
                                                "text": "In der aktuellen Politik sind neoliberale Tendenzen erkennbar."
                                            },
                                            {
                                                "example_id": "feae2386-1e3d-46f9-9f26-8d0fab85f13d",
                                                "sense_id": "f3678df5-467b-3380-881b-a819b48b43df",
                                                "text": "„Der IWF verordnete Simbabwe am 16. Dezember 1991 ein neoliberales Strukturanpassungsprogramm als Voraussetzung für die Vergabe von Krediten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca60676b-2ac7-460e-ac7d-9ee925c5676e",
