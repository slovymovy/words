                                        "glosses": [
                                            "zum Niederdeutschen zählende Dialekte, die im Nordwesten Deutschlands gesprochen werden und im Nordosten der Niederlande"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66de0f0c-ded1-4d62-b79b-02701255d7d7",
                                                "sense_id": "a9836d4f-da08-3a45-9692-11195448b851",
                                                "text": "Das Niedersächsische stammt direkt vom Altsächsischen ab."
                                            },
                                            {
                                                "example_id": "16d3507a-8545-47f3-911b-cabb7961badc",
                                                "sense_id": "a9836d4f-da08-3a45-9692-11195448b851",
                                                "text": "„Nach langer Diskriminierung - wer Plattdeutsch sprach, galt als rückständig - ist das früher auch Niedersächsisch oder Sassisch genannte Platt zum Randphänomen verkümmert.“"
                                            }
