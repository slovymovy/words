        "fr-extract.jsonl": [
            {
                "entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                "word": "imposte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43f9eb75-2099-4575-abbd-e1f7d9fed71c",
                        "entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "tags": [
                            "plural"
                        ],
                        "form": "impostes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34dfb8a3-c73e-3296-bcc8-063f83530efa",
                        "entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "glosses": [
                            "Dernière pierre du pied-droit d’une porte ou d’une arcade qui fait saillie sur les autres pierres et qui a ordinairement quelques moulures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e929320-08fb-48a6-9291-5fd64bb378fb",
                                "sense_id": "34dfb8a3-c73e-3296-bcc8-063f83530efa",
                                "text": "Cette imposte a trop de saillie."
                            },
                            {
                                "example_id": "e11f867d-eed4-424e-b4ea-fb126108f86b",
                                "sense_id": "34dfb8a3-c73e-3296-bcc8-063f83530efa",
                                "text": "La rangée extérieure était de trente pierres droites ; le tout, en y comprenant l’autel et les impostes, se montait à cent trente-neuf pierres."
                            }
                        ]
                    },
                    {
                        "sense_id": "21598ee9-1dd4-377b-ba34-ccf83b27db80",
                        "entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "glosses": [
                            "Partie supérieure d’une porte, d’une fenêtre qu’on laisse dormante pour diminuer la hauteur des battants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f7a3a7-87ff-4504-b6a4-a7b72923987b",
                                "sense_id": "21598ee9-1dd4-377b-ba34-ccf83b27db80",
                                "text": "Les grands panneaux des lambris étaient couverts de peintures (…) ; et les impostes de pastorales d'opéra, de fêtes galantes."
                            },
                            {
                                "example_id": "ef71b26b-d5b7-44ed-8f4d-f84a596aa93f",
                                "sense_id": "21598ee9-1dd4-377b-ba34-ccf83b27db80",
                                "text": "En tournant autour de l’auberge, j’aperçus une lumière qui éclairait une imposte vitrée, et pensant que tout le monde n’était pas couché, je frappai à la porte."
                            },
                            {
                                "example_id": "289940d4-d16b-4603-bafc-b5d7f1fd04a3",
                                "sense_id": "21598ee9-1dd4-377b-ba34-ccf83b27db80",
                                "text": "Il entra en courbant un peu l'échine, malgré la haute imposte de la porte."
                            },
                            {
                                "example_id": "8fafbe79-ab19-4480-a54e-8c310eef4d6c",
                                "sense_id": "21598ee9-1dd4-377b-ba34-ccf83b27db80",
                                "text": "Une lumière rare qui venait de hautes impostes remuait tout ce blanc et ce noir avec de longs bâtons dorés."
                            },
                            {
                                "example_id": "75ca5920-27b2-42ed-8017-78f322e16d36",
                                "sense_id": "21598ee9-1dd4-377b-ba34-ccf83b27db80",
                                "text": "Celui-ci lui raconta qu’ici on devait s’estimer heureux mais qu’à Marseille, dans certaines rues, les morts étaient entassés plus haut que l’imposte des boutiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "54e036f8-f7ac-3646-9b26-36b323a48d3a",
                        "entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "glosses": [
                            "Partie vitrée fixe ou dormante, occupant la place de l’imposte d’une porte, d’une cloison et destinée à donner du jour à une pièce obscure, éventail."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "ab66e36f-88e6-495d-a57a-8584cc46fb32",
                                "sense_id": "54e036f8-f7ac-3646-9b26-36b323a48d3a",
                                "text": "Un après-midi, comme je me rendais au jardin, l’ombre et le silence de l’étable, la lueur rougeâtre qui se glissait par une imposte, le souvenir de quelque lecture aussi, où je voulais m’attarder, me retinrent derrière la porte."
                            },
                            {
                                "example_id": "b9219916-6f2a-4d75-885b-c3947fa918c8",
                                "sense_id": "54e036f8-f7ac-3646-9b26-36b323a48d3a",
                                "text": "L'antichambre (…) n'était éclairée que par une imposte au-dessus de la cuisine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "deeb01a5-05e5-47e5-8410-d0600c3c5fbb",
                        "source_entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "target_lang_word": "Impost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e5c857b-25b6-414c-be30-77f025b4f0d2",
                        "source_entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "target_lang_word": "Kämpfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kämpfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "jemand, der kämpft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa03399b-d716-4905-a565-354de87d3ac1",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "Wer sich nicht ohne Gegenwehr unterkriegen lässt, ist ein Kämpfer."
                                            },
                                            {
                                                "example_id": "2ac29ff5-70a4-42d0-8964-3ac0881c3192",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            },
                                            {
                                                "example_id": "45f1ea3c-ec93-4e53-b009-29823f2ddd81",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Doch auch diesmal kann Wladimir seine Kämpfer nicht bezahlen, wieder muss er die nun lästigen Krieger loswerden.“"
                                            },
                                            {
                                                "example_id": "ac588b5f-7d4e-44a5-ab63-7f15dcb47487",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Die Kämpfer attackieren jeden, den sie für einen Verräter halten.“"
                                            },
                                            {
                                                "example_id": "42aadb53-fc78-494f-b9d3-eb426dc174b4",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Unter den Bäumen war ein Ring aufgebaut, in dem die Kämpfer bei gutem Wetter trainierten, und im Tanzsaal gab es einen großen und einen kleinen Sandsack und eine Matte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38bc7dad-4254-3618-b28f-ed629ca43332",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "die obere vorspringende Platte eines Pfeilers oder einer Säule"
                                        ],
                                        "tags": [
                                            "Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eec3d97-31e8-4f22-91ab-d3141df0b2bd",
                                                "sense_id": "38bc7dad-4254-3618-b28f-ed629ca43332",
                                                "text": "\"Über einem Kapitell kann der Kämpfer auch als Block ausgebildet sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6b633c08-2883-322b-8fd6-ce9a8d085cfa",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "das waagerechte Trennungsteil eines mehrflügeligen Fensters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58440fde-0bb8-490f-8cfb-4f911d99ae28",
                                                "sense_id": "6b633c08-2883-322b-8fd6-ce9a8d085cfa",
                                                "text": "„Rund um Fenster und Türen gibt es zahlreiche Begriffe, die sicher nicht jedem geläufig sind wie Kämpfer, Gangflügel, Gehflügel oder Stulpfenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "729ddbb5-06a4-482e-8c97-c17caf3b66db",
                        "source_entry_id": "1fc1c281-0bc2-3199-9a69-6c8d59cc2815",
                        "target_lang_word": "impost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb613d4-071b-324e-aab7-53d08891123b",
                                        "entry_id": "2cac84ad-0320-300a-9d71-f8fcb5e151ac",
                                        "glosses": [
                                            "A tax, tariff or duty that is imposed, especially on merchandise."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5faca5c-72a8-4180-af01-0f4262e824b2",
                                                "sense_id": "dbb613d4-071b-324e-aab7-53d08891123b",
                                                "text": "’Tis a Land-tax, vvhich he’s too poor to pay; / You, therefore muſt ſome other Impoſt lay."
                                            },
                                            {
                                                "example_id": "3f39fcbb-ece3-4026-be11-13ecb0a88e5b",
                                                "sense_id": "dbb613d4-071b-324e-aab7-53d08891123b",
                                                "text": "1752, David Hume, Political Discourses, Edinburgh: A. Kincaid and A. Donaldson, “Of Taxes,” p. 120,\n[…] a duty upon commodities checks itself; and a prince will soon find, that an encrease of the impost is no encrease of his revenue."
                                            },
                                            {
                                                "example_id": "48ff65d1-78fd-4b9d-9e83-70a1e4c02bf2",
                                                "sense_id": "dbb613d4-071b-324e-aab7-53d08891123b",
                                                "text": "[…] before the sequestration of emigrant property, I had remitted the imposts they had ceased to pay;"
                                            },
                                            {
                                                "example_id": "0a4b3995-c7db-4f8c-879b-194ab76e9a4d",
                                                "sense_id": "dbb613d4-071b-324e-aab7-53d08891123b",
                                                "text": "The Ashanti traded with the tribes to the north and with coastal folk to the south, and caravans going in either direction were liable for imposts according to the nature of the goods they carried."
                                            },
                                            {
                                                "example_id": "40060c69-c3f1-4b2a-9fe0-81c42e13d6b9",
                                                "sense_id": "dbb613d4-071b-324e-aab7-53d08891123b",
                                                "text": "New universal direct taxes had to be introduced […], while the burden of indirect taxes was also made heavier, with new imposts being levied on an ensemble of items ranging from playing cards to wigs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d2465cf-5d18-307e-bd16-9d8ffde2af08",
                                        "entry_id": "2cac84ad-0320-300a-9d71-f8fcb5e151ac",
                                        "glosses": [
                                            "The weight that must be carried by a horse in a race; the handicap."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "impost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "188861aa-2126-3b50-8d65-fb2e9a1720bb",
                                        "entry_id": "092b4d68-38e3-3c26-adbe-1c39347e3286",
                                        "glosses": [
                                            "The top part of a column, pillar, pier, wall, etc. that supports an arch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9c4f915-7338-4721-9fad-bc7b6d1c5c08",
                                                "sense_id": "188861aa-2126-3b50-8d65-fb2e9a1720bb",
                                                "text": "The outer circle [of Stonehenge] has been formed by a combination of two uprights and an impost; yet each combination of these three stones is detached, and without any connection with the rest, except that of coinciding in the form of a circle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
