                ],
                "senses": [
                    {
                        "sense_id": "a89b848d-e220-3d7e-877d-94dc9017ec5b",
                        "entry_id": "9d3815e5-b3c1-3ebd-9e94-c98137d51aa2",
                        "glosses": [
                            "Umfang des Gewünschten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7bd6d6-8003-4385-be13-b923c46bbc48",
                                "sense_id": "a89b848d-e220-3d7e-877d-94dc9017ec5b",
                                "text": "„Dieses Recht zerfällt aufgrund hoher Belastung, weil es entweder nicht angewendet wird oder Tatsachen den politischen Erwartungshorizont des europäischen Gesetzgebers überformen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "336d6b59-d6f5-3069-b8e8-27ab4a6dbb5b",
                        "entry_id": "9d3815e5-b3c1-3ebd-9e94-c98137d51aa2",
                        "glosses": [
                            "auf Grund des Kontextes der Erscheinungszeit denkbarer Inhalt eines literarischen Werks oder Textes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2aab4c-179a-43d2-9d17-f28e90d8c1d0",
                                "sense_id": "336d6b59-d6f5-3069-b8e8-27ab4a6dbb5b",
                                "text": "„Der für heutige Begriffe sehr frei übersetzte Text war offenbar dem Erwartungshorizont französischer Leser gelungen angepasst und wurde sofort ein großer Bucherfolg.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "45a371bd-9fcf-3591-a218-e131576e3cb5",
                        "entry_id": "9d3815e5-b3c1-3ebd-9e94-c98137d51aa2",
                        "glosses": [
                            "in einer Prüfungssituation geforderte festgelegte Leistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da095edb-15b5-449a-b6b7-1ef5d5b53648",
                                "sense_id": "45a371bd-9fcf-3591-a218-e131576e3cb5",
                                "text": "„Bei den Erwartungshorizonten handelt es sich in der Regel nicht um vollständige, mustergültig ausformulierte Lösungen, sondern um Hinweise auf wichtige, einschlägige Aspekte, die bei der Bearbeitung der Aufgaben berücksichtigt werden sollten.“"
                            },
                            {
                                "example_id": "86bc9678-0db6-48b9-bc88-d746bc69f4f1",
                                "sense_id": "45a371bd-9fcf-3591-a218-e131576e3cb5",
                                "text": "„Dies bedeutet, dass der Note ‚gut‘ eine Leitfunktion in der Festlegung des Erwartungshorizontes zukommt.“"
                            },
                            {
                                "example_id": "f4d319c0-3118-4c22-a17e-5c3e60faac79",
                                "sense_id": "45a371bd-9fcf-3591-a218-e131576e3cb5",
                                "text": "„Parallel erstelle ich den sogenannten Erwartungshorizont, ich lege also fest, wie ich welche Aufgabe bewerte.“"
                            },
                            {
                                "example_id": "5d2565a6-4615-46ea-99b4-b92f95c992a8",
                                "sense_id": "45a371bd-9fcf-3591-a218-e131576e3cb5",
                                "text": "„In Latein und Griechisch ist der jeweiligen Aufgabenstellung (§§ 10 und 11) eine dem Erwartungshorizont entsprechende Übersetzung in die Unterrichtssprache sowie eine Disposition zur Beantwortung der gestellten Aufgaben anzuschließen.“"
                            },
                            {
                                "example_id": "837fa3f5-771d-495d-8ece-5cee498cf2cc",
                                "sense_id": "45a371bd-9fcf-3591-a218-e131576e3cb5",
                                "text": "„Der Erwartungshorizont stellt nur eine kleine Richtlinie für unsere Korrektoren dar.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
