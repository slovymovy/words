        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec361246-bb02-3f16-9d17-9d8c9b4d709b",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>bouleverser</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette découverte scientifique a complètement <w>bouleversé</w> nos connaissances actuelles.",
                            "target_lang_translations": {
                                "en": "This scientific discovery has completely <w>overturned</w> our current knowledge.",
                                "ru": "Это научное открытие полностью <w>перевернуло</w> наши нынешние знания.",
                                "de": "Diese wissenschaftliche Entdeckung hat unser heutiges Wissen vollständig <w>umgestoßen</w>.",
                                "es": "Este descubrimiento científico ha <w>revolucionado</w> por completo nuestros conocimientos actuales.",
                                "zh": "这一科学发现彻底<w>颠覆</w>了我们现有的知识。"
                            }
                        },
                        {
                            "text": "La nouvelle organisation du travail a <w>bouleversé</w> les habitudes de toute l'équipe.",
                            "target_lang_translations": {
                                "en": "The new work organization has <w>upset</w> the habits of the whole team.",
                                "ru": "Новая организация работы <w>нарушила</w> привычки всей команды.",
                                "de": "Die neue Arbeitsorganisation hat die Gewohnheiten des gesamten Teams <w>durcheinandergebracht</w>.",
                                "es": "La nueva organización del trabajo ha <w>trastocado</w> las costumbres de todo el equipo.",
                                "zh": "新的工作安排<w>打乱</w>了整个团队的习惯。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past participle of the French verb bouleverser, meaning to upset or overturn.",
                        "ru": "Причастие прошедшего времени мужского рода единственного числа от глагола «bouleverser», означающего «перевернуть» или «нарушить».",
                        "de": "Partizip Perfekt, maskulin Singular, des französischen Verbs „bouleverser“.",
                        "es": "Forma de participio pasado masculino singular del verbo francés «bouleverser», que significa trastocar o revolucionar.",
                        "zh": "法语动词 bouleverser 的阳性单数过去分词形式，意为打乱、颠覆或彻底改变。"
                    },
