                "senses": [
                    {
                        "sense_id": "30b8380d-476d-3a6c-a8b9-fec7347625a2",
                        "entry_id": "6b93827a-5f42-387a-be40-12cab077ba35",
                        "glosses": [
                            "Désactiver (une fonctionnalité)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e13d91-531a-4ac1-918a-3b9961461bd1",
                                "sense_id": "30b8380d-476d-3a6c-a8b9-fec7347625a2",
                                "text": "Et comment on fait si on veut désenabler Front Row ?"
                            },
                            {
                                "example_id": "d5861d75-bc65-412f-a7e0-9f08c9e03fd6",
                                "sense_id": "30b8380d-476d-3a6c-a8b9-fec7347625a2",
                                "text": "Appuyez sur le commutateur d'interrupteur d'arrêt on/off pour activer ou désenabler les autorisations d'un programme d'applications particulières."
                            },
                            {
                                "example_id": "750a2c37-f4a4-4546-bce3-ce794fc4e15c",
                                "sense_id": "30b8380d-476d-3a6c-a8b9-fec7347625a2",
                                "text": "Vous pouvez également activer ou désenabler un arrière-plan nommé m."
                            },
                            {
                                "example_id": "8fc819ac-0877-46ab-bb26-1c03ffe050cf",
                                "sense_id": "30b8380d-476d-3a6c-a8b9-fec7347625a2",
                                "text": "Pour résoudre ce problème, les utilisateurs suggèrent de désenabler temporairement votre pare-feu et de vérifier si cela résout votre problème."
                            },
                            {
                                "example_id": "dbfc8b83-968a-4de7-866b-5ed6afb46fb7",
                                "sense_id": "30b8380d-476d-3a6c-a8b9-fec7347625a2",
                                "text": "Activez la carte vpn du jour, et vous devrez basculer le bouton poussoir vpn pour activer ou désenabler le service."
                            }
                        ]
                    }
