                "senses": [
                    {
                        "sense_id": "b1362a36-ba17-383a-b4bf-598079b1b671",
                        "entry_id": "407e2025-7829-347e-9716-6726115fb7e0",
                        "glosses": [
                            "Surprised and slightly frightened."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c2de9e-31c1-4d50-ba9e-603f0dd068c6",
                                "sense_id": "b1362a36-ba17-383a-b4bf-598079b1b671",
                                "text": "The burnt and bleeding man staggered to his feet, dazed and unbelieving, and asked the startled townspeople who came running whether his fireman and guard were safe. He was kept away from the smouldering crater where his engine had been, and taken to hospital."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "066b95a4-76cc-4f12-8ebb-d0329c0de942",
                        "source_entry_id": "407e2025-7829-347e-9716-6726115fb7e0",
                        "source_sense_id": "b1362a36-ba17-383a-b4bf-598079b1b671",
                        "source_sense_description": "surprised and slightly frightened",
                        "target_lang_word": "geschrokken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geschrokken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8e8e582-591b-316a-ad9e-721a3e06a523",
                                        "entry_id": "c321af89-c049-3a03-9373-39e0895e5d8a",
                                        "glosses": [
                                            "voltooid deelwoord van schrikken"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c2737d-1aee-4144-98bf-43a432c608f2",
                                                "sense_id": "d8e8e582-591b-316a-ad9e-721a3e06a523",
                                                "text": "Na een gigantische knal vlak boven ons hoofd stonden de stoere jonge gasten binnen tien seconden ook binnen. Zelfs zij waren zich rot geschrokken van de klap, en beseften dat het nu menens was. De meeste gezichten had ik nog nooit gezien."
                                            },
                                            {
                                                "example_id": "64ff92de-e3c0-4353-964b-3b8d3b414a14",
                                                "sense_id": "d8e8e582-591b-316a-ad9e-721a3e06a523",
                                                "text": "En nu? Wat moeten we nu doen?' 'Jij gaat ze vertellen dat het niet jouw schilderij is,' zei Teresa met een gekwelde en geschrokken blik."
                                            },
                                            {
                                                "example_id": "343a6f1f-0741-48df-b127-6c256c6daadf",
                                                "sense_id": "d8e8e582-591b-316a-ad9e-721a3e06a523",
                                                "text": "Ze kneep haar ogen samen, haalde de trekker over en hapte geschrokken naar adem toen het wapen terugstootte in haar hand."
                                            },
                                            {
                                                "example_id": "93b6d71d-cc76-413b-affb-1af7c16729b9",
                                                "sense_id": "d8e8e582-591b-316a-ad9e-721a3e06a523",
                                                "text": "Ik slikte, geschrokken van de blik in haar ogen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7445cd6c-d2f7-4380-bfc6-262c9766a028",
                        "source_entry_id": "407e2025-7829-347e-9716-6726115fb7e0",
                        "source_sense_id": "b1362a36-ba17-383a-b4bf-598079b1b671",
                        "source_sense_description": "surprised and slightly frightened",
                        "target_lang_word": "effarouché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effarouché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2519e5a-3c07-3d6e-ba41-bd2836adfd44",
                                        "entry_id": "fd934cd4-ddfe-3888-a29a-c55c4429c989",
                                        "glosses": [
                                            "Qui a peur ; qui est effrayé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4845cfe-b1f1-3f9a-afd1-95c1cf473a06",
                                        "entry_id": "fd934cd4-ddfe-3888-a29a-c55c4429c989",
                                        "glosses": [
                                            "Qui montre de la peur."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee1bdfaa-171d-4397-bb1d-dc3adc54fc19",
                                                "sense_id": "b4845cfe-b1f1-3f9a-afd1-95c1cf473a06",
                                                "text": "[…] ; il me semble n’y avoir vu encore que des visages effarouchés ou rébarbatifs. Peut-être aussi les Parisiens ont-ils peur de l’orage."
                                            },
                                            {
                                                "example_id": "4e0ec189-5666-4ca6-a374-6287595f8d7a",
                                                "sense_id": "b4845cfe-b1f1-3f9a-afd1-95c1cf473a06",
                                                "text": "Moricet. — Bien ! bien ! (Entraînant doucement Léontine à droite, deuxième plan.) Allons, venez, belle effarouchée !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480f921d-1af5-3438-b4f3-e9e523e193e0",
                                        "entry_id": "fd934cd4-ddfe-3888-a29a-c55c4429c989",
                                        "glosses": [
                                            "Se dit d’un chat représenté dressé sur les pattes arrières. À rapprocher d’acculé, cabré, effaré, effrayé, forcené et furieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bcd43b0-702b-4946-be6c-6b1226402ec9",
                                                "sense_id": "480f921d-1af5-3438-b4f3-e9e523e193e0",
                                                "text": "Écartelé : au premier d’azur semé de fleurs de lys d’or, au deuxième de gueules au temple antique d’argent maçonné et ouvert de sable, au troisième losangé d’or et de gueules, au quatrième d’argent au chat effarouché de sable allumé de sinople, qui est de Genainville → voir illustration « chat effarouché »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "effarouché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e74e6af-93bf-3c0e-8cb1-dc0b21541c1a",
                                        "entry_id": "9c9c4616-912c-3740-a1c6-a81188932043",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe effaroucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "978fe560-3417-4dc4-b2a3-fca67dff40e4",
                                                "sense_id": "5e74e6af-93bf-3c0e-8cb1-dc0b21541c1a",
                                                "text": "Tiens, Europe et Paccard n’ont point reparu, j’ai bien peur qu’ils n’aient effarouché les sept cent cinquante mille francs, lui dit Asie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55434c8d-d111-4b00-8eb9-d5912f0a9d82",
                        "source_entry_id": "407e2025-7829-347e-9716-6726115fb7e0",
                        "source_sense_id": "b1362a36-ba17-383a-b4bf-598079b1b671",
                        "source_sense_description": "surprised and slightly frightened",
                        "target_lang_word": "surpris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surpris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34bfa75d-252c-35df-8811-43f4d7ef1233",
                                        "entry_id": "56d7d031-0c96-3ccf-8fe6-b03f2547e373",
                                        "glosses": [
                                            "Qui est sous l’effet de la surprise, de l’étonnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "397e4ca8-0cea-4b9d-b768-efa25597f772",
                                                "sense_id": "34bfa75d-252c-35df-8811-43f4d7ef1233",
                                                "text": "\"Chacun a ses faiblesses. Littré en avait pour sa bonne. Un jour qu’il la lutinait, Madame Littré poussa la porte et s’écria : « Ah, monsieur, je suis surprise ! » Et le regretté Littré, se rajustant, lui répondit : « Non, madame, vous êtes étonnée. C’est nous qui sommes surpris. »\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6715bf61-ae36-3114-a8cc-b2132635a056",
                                        "entry_id": "56d7d031-0c96-3ccf-8fe6-b03f2547e373",
                                        "glosses": [
                                            "Usurpé."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aef97a6-7219-4404-8a31-86d91578df39",
                                                "sense_id": "6715bf61-ae36-3114-a8cc-b2132635a056",
                                                "text": "Il en doit être de même incontestablement de ceux qui ayant été surpris par les ci-devant seigneurs sur le domaine public, sont demeurés par les effets d'une possession aussi vicieuse dans leurs mains, ou ont été transférés sans aucuns droits à leurs vassaux"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3524ce92-8440-3642-a679-34d9ad52b722",
                                        "entry_id": "56d7d031-0c96-3ccf-8fe6-b03f2547e373",
                                        "glosses": [
                                            "Obtenu par surprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9207ef27-3258-4bd4-b893-6827e6a6f3f2",
                                                "sense_id": "3524ce92-8440-3642-a679-34d9ad52b722",
                                                "text": "Elle fut élevée, malgré la résistance de l’ayuntamiento, par le chapitre, sur un ordre surpris à l’empereur Charles-Quint, qui n’avait pas vu la mosquée. Il dit, l’ayant visitée quelques années plus tard : « Si j’avais su cela, je n’aurais jamais permis que l’on touchât à l’œuvre ancienne : vous avez mis ce qui se voit partout à la place de ce qui ne se voit nulle part. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "surpris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d47cc79a-2f62-3072-9948-5202c72c55d9",
                                        "entry_id": "4142c9ec-44ff-3683-9feb-227f5f7b624a",
                                        "glosses": [
                                            "Participe passé du verbe surprendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f121030-270a-4fff-8e7f-847f84df91f3",
                                                "sense_id": "d47cc79a-2f62-3072-9948-5202c72c55d9",
                                                "text": "Combien de fois le passant attardé n’a-t-il pas surpris, mais en se gardant bien de faire mine de les voir, une douzaine ou deux de petits hommes rondiant au clair de lune, par quelque belle nuit d’été, sur les tas de fumier dressés aux abords des fermes !"
                                            },
                                            {
                                                "example_id": "af16a7b8-5727-4f47-826d-63e7fc437260",
                                                "sense_id": "d47cc79a-2f62-3072-9948-5202c72c55d9",
                                                "text": "La trottinette, qui arrivait du boulevard Etienne-Bernand, a été surprise par l'ouverture de la portière côté conducteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
