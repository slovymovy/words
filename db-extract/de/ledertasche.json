                ],
                "senses": [
                    {
                        "sense_id": "d4684b90-ec35-3e40-b2c0-e65edb98c259",
                        "entry_id": "05da0268-c3cd-3af1-9e83-51dadd806a01",
                        "glosses": [
                            "Tasche aus Leder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ccda5d9-4db9-4e27-9b77-0a1235abaf88",
                                "sense_id": "d4684b90-ec35-3e40-b2c0-e65edb98c259",
                                "text": "Ledertaschen sind meist hochwertiger und langlebiger, dafür aber meist teurer."
                            },
                            {
                                "example_id": "9368d518-8234-4c66-93f6-c9103ba0c213",
                                "sense_id": "d4684b90-ec35-3e40-b2c0-e65edb98c259",
                                "text": "„Dann kehrte der frisch Rasierte an seinen Spieltisch zurück, und der Barbier packte seine Scherinstrumente in eine bemerkenswert schöne braune Ledertasche und verließ die Höhle, ein lebender Beweis seiner Kunst.“"
                            },
                            {
                                "example_id": "9856911b-06e1-487a-8083-20fd36ded006",
                                "sense_id": "d4684b90-ec35-3e40-b2c0-e65edb98c259",
                                "text": "„Smoaks nahm seine schwarze Ledertasche, stieg aus dem Wagen und ging zum Dock, wo der Hai hing.“"
                            },
                            {
                                "example_id": "571ca195-3554-4b46-9ffe-691817e2eb02",
                                "sense_id": "d4684b90-ec35-3e40-b2c0-e65edb98c259",
                                "text": "„Er stellte seinen Wecker auf ein Uhr, und als das Gerät klingelte, stand er auf, duschte, zog sich an, ging mit seiner kleinen Ledertasche zu seinem Wagen hinaus und verstaute sie hinter dem Sitz.“"
                            },
                            {
                                "example_id": "0b1abbab-2e33-4ea8-ac4c-33497317e3d1",
                                "sense_id": "d4684b90-ec35-3e40-b2c0-e65edb98c259",
                                "text": "„Gemessenen Schrittes, einen Homburg auf dem Haupt, eine große Ledertasche in der Hand, bewegte sich gegen die Mittagsstunde des 4. September 1940 ein eleganter junger Herr von höchst vorteilhafter Erscheinung durch das Labyrinth der Alfama, der Altstadt von Lissabon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
