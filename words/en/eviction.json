{
    "word_family": [
        "evict",
        "evictive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "555a5723-d127-3101-872f-6c09a19f3244",
                    "sense_definition": "The legal process of forcing someone to leave a property.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family faced <w>eviction</w> after missing several rent payments.",
                            "target_lang_translations": {
                                "zh": "由于拖欠了多次房租，这家人面临被<w>驱逐</w>的境地。"
                            }
                        },
                        {
                            "text": "Protesters gathered to resist the <w>eviction</w> of the squatters.",
                            "target_lang_translations": {
                                "zh": "抗议者聚集在一起，抵制对非法占用者的<w>驱逐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expulsion",
                        "removal",
                        "ejection"
                    ],
                    "common_phrases": [
                        "face eviction",
                        "threat of eviction",
                        "order of eviction"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过法律程序强制某人搬离房产的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驱逐",
                                "target_lang_sense_clarification": "指强制某人离开某地，常用于法律或正式语境。"
                            },
                            {
                                "target_lang_word": "逐出",
                                "target_lang_sense_clarification": "指将某人从房产或组织中赶走。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "216e62b3-bfa0-3d15-939e-3a74cd41146f",
                    "sense_definition": "The condition or state of having been forced out of a property.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>eviction</w> left the tenants without a place to stay.",
                            "target_lang_translations": {
                                "zh": "突如其来的<w>驱逐</w>让租户们无处可去。"
                            }
                        },
                        {
                            "text": "He struggled to find new housing following his recent <w>eviction</w>.",
                            "target_lang_translations": {
                                "zh": "在最近一次被<w>驱逐</w>后，他很难找到新的住处。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "被强制搬离房产后的状态或处境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "被驱逐",
                                "target_lang_sense_clarification": "强调被动状态，即已经失去了居住权。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}