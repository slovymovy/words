        "fr-extract.jsonl": [
            {
                "entry_id": "a8531cdf-5b62-3696-bca0-65ca314ba4ad",
                "word": "ration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0e6be12-b062-4c98-8da1-36083248bf3e",
                        "entry_id": "a8531cdf-5b62-3696-bca0-65ca314ba4ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "rations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf07b07a-d6b9-3173-8594-eb9ae46f2665",
                        "entry_id": "a8531cdf-5b62-3696-bca0-65ca314ba4ad",
                        "glosses": [
                            "Portion journalière soit de pain, soit d’autres vivres, soit de fourrage, qui se distribue aux soldats ou aux marins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9024a83e-0ca5-4a25-a8ca-82e736684fad",
                                "sense_id": "cf07b07a-d6b9-3173-8594-eb9ae46f2665",
                                "text": "Distribuer les rations aux soldats, les rations de foin et d’avoine aux cavaliers."
                            },
                            {
                                "example_id": "2c55c77d-7f4d-456b-96ff-b4fbc6eff4df",
                                "sense_id": "cf07b07a-d6b9-3173-8594-eb9ae46f2665",
                                "text": "L’équipage en fut informé au réfectoire, où on servait les rations du soir."
                            },
                            {
                                "example_id": "f348d0a4-9846-4c7b-b264-76b4d7a1ef8d",
                                "sense_id": "cf07b07a-d6b9-3173-8594-eb9ae46f2665",
                                "text": "Ils jettent à la foule qui les acclame ces petits paquets enveloppés de celluloïd que l’on appelle des « rations ». Ils contiennent un sachet de sucre en poudre, un bonbon, du chocolat, bref un peu de tout ce dont nous avions été longtemps privés."
                            }
                        ]
                    },
                    {
                        "sense_id": "34dcd90b-65e7-370c-abbc-0bfb1c41edf7",
                        "entry_id": "a8531cdf-5b62-3696-bca0-65ca314ba4ad",
                        "glosses": [
                            "Quantité ordinaire de nourriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5e5725-a447-4836-95e6-f9f811c08b09",
                                "sense_id": "34dcd90b-65e7-370c-abbc-0bfb1c41edf7",
                                "text": "Le soir, au lieu du cous-cous traditionnel, Mohammed me sert un tâjin de lièvre que j’arrose d’une double ration de thé pour me dédommager de l’affreux breuvage que j’ai dû avaler hier."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb3c0a07-fcf5-366d-b1f2-99badd9a7ff6",
                        "entry_id": "a8531cdf-5b62-3696-bca0-65ca314ba4ad",
                        "glosses": [
                            "Lot, part."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "af3b24a3-3fa6-4c0a-ba78-2e7ea54d3e9b",
                                "sense_id": "fb3c0a07-fcf5-366d-b1f2-99badd9a7ff6",
                                "text": "J’ai passé de dures journées dont chacune m’apportait sa ration d’épreuves."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e43a96f0-49e1-4320-a743-24af60e8c4de",
                        "source_entry_id": "a8531cdf-5b62-3696-bca0-65ca314ba4ad",
                        "source_sense_description": "Portion journalière qui se distribue aux soldats ou aux marins",
                        "target_lang_word": "ration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43203194-a391-3b88-9e26-42325f59b23b",
                                        "entry_id": "80d1a5b4-c1d4-3a57-bcd4-aa669e746425",
                                        "glosses": [
                                            "A portion of some limited resource, especially food, allocated to a person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a158140-0bae-4f3f-ba50-54a5c245df5c",
                                                "sense_id": "43203194-a391-3b88-9e26-42325f59b23b",
                                                "text": "The corn ration was drastically reduced, and it was announced that an extra potato ration would be issued to make up for it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f2b6309-39a8-3aba-9957-e20a38761d2e",
                                        "entry_id": "c6df0359-ca67-3989-a89d-7349eba80fa3",
                                        "glosses": [
                                            "To supply with a ration; to limit (someone) to a specific allowance of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d475035-03bc-4f44-a360-1892cf439298",
                                                "sense_id": "8f2b6309-39a8-3aba-9957-e20a38761d2e",
                                                "text": "We rationed ourselves to three sips of water a day until we were rescued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9d7667-3f31-32f9-ae55-a285c4072711",
                                        "entry_id": "c6df0359-ca67-3989-a89d-7349eba80fa3",
                                        "glosses": [
                                            "To portion out (especially during a shortage of supply); to limit access to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9f7f0c6-4cc9-4233-aa12-075a4d27c6d1",
                                                "sense_id": "bf9d7667-3f31-32f9-ae55-a285c4072711",
                                                "text": "By the third day on the raft, we had to ration our water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                                        "entry_id": "c6df0359-ca67-3989-a89d-7349eba80fa3",
                                        "glosses": [
                                            "To restrict (an activity etc.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fb27e2-8645-4d79-ac0c-1322b898a704",
                                                "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                                                "text": "Our present health care system is rationed only to those who can afford it because of unnecessary high cost, lack of insurance coverage by 47 million people, and exorbitant prescription prices."
                                            },
                                            {
                                                "example_id": "bb95d85e-380c-4af2-bb51-de9f131cda6f",
                                                "sense_id": "4e361cb4-3742-3df5-ae8f-786b8c98baa2",
                                                "text": "A theocratic state in which an equation is drawn between the Catholic hierarchy and God and the rights of citizens may be rationed by the church according to its doctrines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
