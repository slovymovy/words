                "senses": [
                    {
                        "sense_id": "2ff6d697-f56f-304f-9f46-d6890d3a01d4",
                        "entry_id": "156de99f-c3b5-3f73-b05c-0d7230363f44",
                        "glosses": [
                            "iemand die een bal terugkaatst zonder er zelf veel mee te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdbb963a-78cc-4d74-9f6b-36d035a5da0d",
                                "sense_id": "2ff6d697-f56f-304f-9f46-d6890d3a01d4",
                                "text": "Hij werd vooral bekend vanwege zijn penalty-in-drieën in 1982 tegen Helmond Sport, waarbij hij fungeerde als kaatser voor Johan Cruijff."
                            },
                            {
                                "example_id": "e39d1b59-b4c9-4015-a218-b67b744dbb81",
                                "sense_id": "2ff6d697-f56f-304f-9f46-d6890d3a01d4",
                                "text": "Kasper Dolberg, die afgelopen week vanwege rugklachten niet mee kon spelen bij Denemarken Onder-21, maakte vrijdag op De Toekomst wel gewoon de training af. \"We hebben Kasper aan het begin van de week al enigszins gespaard. Richting de wedstrijd toe draait hij nu weer volledig mee, al hebben we hem af en toe wel uit de duels gehouden door hem als kaatser te gebruiken. Als Mateo Cassierra zaterdag fit terugkeert, hebben we deze interlandperiode weer goed overleefd.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "aa7282fa-6d65-39a3-9338-5515107ef3c6",
                        "entry_id": "156de99f-c3b5-3f73-b05c-0d7230363f44",
                        "glosses": [
                            "iemand die het kaatsspel speelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb11b3cb-e6e8-43ce-83e6-ccd383c43625",
                                "sense_id": "aa7282fa-6d65-39a3-9338-5515107ef3c6",
                                "text": "In Franeker vindt vandaag de oudste sportklassieker van Nederland plaats. Sinds 1854 spelen kaatsers de PC en dit moet je weten over de eeuwenoude sport."
                            }
                        ]
                    }
                ],
                "translations": [
