    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c65c0cc8-8274-3048-b72c-dafd05be5220",
                    "sense_definition": "verkleinwoord van <w>put</w>: een kleine kuil of een kleine afvoeropening",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het water liep langzaam weg door het verstopte <w>putje</w> van de douche.",
                            "target_lang_translations": {
                                "ru": "Вода медленно уходила через засорившийся <w>слив</w> в душе.",
                                "de": "Das Wasser lief langsam durch den verstopften <w>Abfluss</w> der Dusche ab."
                            }
                        },
                        {
                            "text": "Mijn ring viel per ongeluk door het <w>putje</w> van de wastafel.",
                            "target_lang_translations": {
                                "ru": "Моё кольцо случайно упало в <w>сливное отверстие</w> раковины.",
                                "de": "Mein Ring fiel versehentlich in den <w>Abfluss</w> des Waschbeckens."
                            }
                        }
                    ],
                    "common_phrases": [
                        "door het putje spoelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное от «put»: небольшая ямка или сливное отверстие (в раковине, душе и т. п.)",
                        "de": "Verkleinerungsform von „put“: eine kleine Vertiefung, Grube oder ein Abfluss (z. B. im Waschbecken oder in der Dusche)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слив",
                                "target_lang_sense_clarification": "сливное отверстие"
                            },
                            {
                                "target_lang_word": "сливное отверстие",
                                "target_lang_sense_clarification": "в душе, раковине"
                            },
                            {
                                "target_lang_word": "ямка",
                                "target_lang_sense_clarification": "небольшое углубление"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Abfluss",
                                "target_lang_sense_clarification": "Ablauf in Dusche oder Waschbecken"
                            },
                            {
                                "target_lang_word": "Ausguss",
                                "target_lang_sense_clarification": "Abflussöffnung"
                            },
                            {
                                "target_lang_word": "Grübchen",
                                "target_lang_sense_clarification": "kleine Vertiefung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af07fcad-84c9-3910-a0dc-1643dc6c3ca9",
                    "sense_definition": "het diepste of koudste/warmste midden van een seizoen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In <w>putje</w> winter vriest het hier 's nachts meestal erg hard.",
                            "target_lang_translations": {
                                "ru": "В <w>самый разгар</w> зимы ночью здесь обычно сильный мороз.",
                                "de": "Im <w>tiefsten</w> Winter friert es hier nachts meistens sehr stark."
                            }
                        },
                        {
                            "text": "In <w>putje</w> zomer gaan we vaak vroeg in de ochtend al wandelen.",
                            "target_lang_translations": {
                                "ru": "В <w>самую макушку</w> лета мы часто выходим на прогулку уже рано утром.",
                                "de": "Im <w>Hochsommer</w> gehen wir oft schon früh am Morgen spazieren."
                            }
                        }
                    ],
                    "synonyms": [
                        "hartje"
                    ],
                    "common_phrases": [
                        "putje winter",
                        "putje zomer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral in België gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "самый разгар, глубина времени года (зимы, лета)",
                        "de": "der tiefste bzw. kälteste/wärmste Punkt mitten in einer Jahreszeit (besonders in Belgien gebraucht)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгар",
