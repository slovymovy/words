        "nl-extract.jsonl": [
            {
                "entry_id": "23a4fab0-99ba-3840-a2a9-617bb7f2cc9c",
                "word": "voorvoelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "323121d5-3e9d-361c-bcbd-76cc8ade84a3",
                        "entry_id": "23a4fab0-99ba-3840-a2a9-617bb7f2cc9c",
                        "glosses": [
                            "verwachten hoe iets in de toekomst zal gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c3df20-2ef3-4b6d-9dd1-874aec17c6d0",
                                "sense_id": "323121d5-3e9d-361c-bcbd-76cc8ade84a3",
                                "text": "In Privé laten we deze week Diana’s testament zien, het is de laatste wil van een vrouw die voorvoelde dat zij jong zou sterven. En dat is, twintig jaar na dato, nog steeds het grootste thema rond haar dood: was het wel een ongeluk?"
                            },
                            {
                                "example_id": "46d8f726-3dbf-4177-8955-9cd924181998",
                                "sense_id": "323121d5-3e9d-361c-bcbd-76cc8ade84a3",
                                "text": "Hedwiges Maduro voorvoelt dat de Eredivisie afstevent op een spectaculaire ontknoping."
                            },
                            {
                                "example_id": "af56a64f-7f56-4331-b052-77f559209384",
                                "sense_id": "323121d5-3e9d-361c-bcbd-76cc8ade84a3",
                                "text": "Toch kon Juliette niet alleen blijven dansen, want het bestaan in New York was duur. „Ik moest naast mijn studie gaan werken om mijn lening terug te kunnen betalen en ging naast dans ook nog economie studeren. Dat is uiteindelijk mijn redding geweest. Het lijkt wel alsof ik voorvoelde dat ik niet zou kunnen blijven dansen.”"
                            },
                            {
                                "example_id": "af4f3f33-ed46-4c9a-bd66-f7228a719642",
                                "sense_id": "323121d5-3e9d-361c-bcbd-76cc8ade84a3",
                                "text": "Maar het was alsof oma iets had voorvoeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65220fba-17fc-4e23-9f84-7ff7a53ae3f6",
                        "source_entry_id": "23a4fab0-99ba-3840-a2a9-617bb7f2cc9c",
                        "source_sense_id": "323121d5-3e9d-361c-bcbd-76cc8ade84a3",
                        "target_lang_word": "sense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b80604ef-ba78-3d84-b8a0-deb5658f53a2",
                                        "entry_id": "64a52896-41f0-313a-9c30-849bb86edd4b",
                                        "glosses": [
                                            "Any of the manners by which living beings perceive the physical world: for humans sight, smell, hearing, touch, taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e42133e-9c03-4529-b18b-791d471e1f3c",
                                                "sense_id": "b80604ef-ba78-3d84-b8a0-deb5658f53a2",
                                                "text": "Let fancy still my sense in Lethe steep."
                                            },
                                            {
                                                "example_id": "3cc7c22b-3f2e-405f-8a83-e4ea436bf1bc",
                                                "sense_id": "b80604ef-ba78-3d84-b8a0-deb5658f53a2",
                                                "text": "What surmounts the reach / Of human sense I shall delineate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                        "entry_id": "64a52896-41f0-313a-9c30-849bb86edd4b",
                                        "glosses": [
                                            "Perception through the intellect; apprehension; awareness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc48b1a3-af8b-4dbf-8659-419879c3cf99",
                                                "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                                "text": "a sense of security"
                                            },
                                            {
                                                "example_id": "2e2b253b-9e41-4d26-b2ec-f6d7c6b6d5d0",
                                                "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                                "text": "this Basilius, having the quick sense of a lover",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "e1357cdb-49a4-4dbe-8213-3cdebc029284",
                                                "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                                "text": "high disdain from sense of injured merit"
                                            },
                                            {
                                                "example_id": "d9f0c936-e5bb-4acd-a00b-1cf53a9e4d42",
                                                "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                                "text": "The days have vanish’d, tone and tint,\n⁠And yet perhaps the hoarding sense\n⁠Gives out at times (he knows not whence)\nA little flash, a mystic hint; […]"
                                            },
                                            {
                                                "example_id": "81b262a1-8a1a-4dd0-ae1c-977bd0a427fa",
                                                "sense_id": "f9a531ac-5444-396b-8428-eace1a8108d1",
                                                "text": "Where a college administration does not come forward and say that gay people have a right to be here, there is a sense among students that it is acceptable to harass and intimidate lesbian and gay members of that community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "964959d4-5491-3646-b251-5bd991017598",
                                        "entry_id": "64a52896-41f0-313a-9c30-849bb86edd4b",
                                        "glosses": [
                                            "Sound practical or moral judgment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4adbdec-6a34-4ca6-a4f4-72327fed46eb",
                                                "sense_id": "964959d4-5491-3646-b251-5bd991017598",
                                                "text": "It’s common sense not to put metal objects in a microwave oven."
                                            },
                                            {
                                                "example_id": "1c38f2c5-78f7-4d25-b2ed-0fbdd1c3c25c",
                                                "sense_id": "964959d4-5491-3646-b251-5bd991017598",
                                                "text": "some People so Harden'd in Wickedness, as to have No Sense at all of the most Friendly Offices, or the Highest Benefits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d0601b9-10db-35ee-bd55-95c8b6b41788",
                                        "entry_id": "64a52896-41f0-313a-9c30-849bb86edd4b",
                                        "glosses": [
