    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e44d3c46-c25d-3a6e-8829-411212fc0594",
                    "sense_definition": "A formal obligation entered into before a court pledging to perform a specific act, such as appearing at trial, often serving as a form of bail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to release the defendant on his own <w>recognizance</w> instead of demanding bail."
                        },
                        {
                            "text": "She was required to sign a formal <w>recognizance</w> promising to return for the trial next month."
                        }
                    ],
                    "synonyms": [
                        "bail",
                        "bond",
                        "pledge"
                    ],
                    "common_phrases": [
                        "own recognizance",
                        "release on recognizance"
                    ]
                },
                {
                    "sense_id": "6bc5b2dd-8756-35da-b7b2-853d37a8b960",
                    "sense_definition": "A token, symbol, or pledge given as a sign or remembrance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered the gold ring as a lasting <w>recognizance</w> of their friendship."
                        },
                        {
                            "text": "The ancient handkerchief was kept as a sacred <w>recognizance</w> between the families."
                        }
                    ],
                    "synonyms": [
                        "token",
                        "pledge",
                        "symbol"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and archaic use"
                        }
                    ]
                },
                {
                    "sense_id": "7397ec18-3b69-3a3c-87d1-52a35211cf9e",
                    "sense_definition": "An acknowledgment or avowal of a person, relationship, or thing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader sought full <w>recognizance</w> of his authority from the assembled nobles."
                        },
                        {
                            "text": "Her formal statement was accepted as a clear <w>recognizance</w> of their prior agreement."
                        }
                    ],
                    "synonyms": [
                        "acknowledgment",
                        "recognition",
                        "avowal"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
