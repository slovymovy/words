                "senses": [
                    {
                        "sense_id": "b972a68a-40b7-3b9d-935a-536d0f8afe3c",
                        "entry_id": "8a16f81c-f82c-3b0d-9fc1-0f2a1c415123",
                        "glosses": [
                            "fryzjer wykonujący również proste zabiegi medyczne"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "891f6353-3d75-4953-8244-9024c2fe8bba",
                                "sense_id": "b972a68a-40b7-3b9d-935a-536d0f8afe3c",
                                "text": "Wśród narzędzi pewnego warszawskiego cyrulika znajdowały się trzy pelikany."
                            },
                            {
                                "example_id": "70ee4189-08bb-48f6-b94b-ad528eaf3a42",
                                "sense_id": "b972a68a-40b7-3b9d-935a-536d0f8afe3c",
                                "text": "Cyrulik ogolił mnie w okamgnieniu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10148036-6172-4477-b346-a84048450a62",
                        "source_entry_id": "8a16f81c-f82c-3b0d-9fc1-0f2a1c415123",
                        "source_sense_id": "b972a68a-40b7-3b9d-935a-536d0f8afe3c",
                        "target_lang_word": "Bader",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bader",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c59e60-1ce9-3a1a-b799-c97c6811e3f1",
                                        "entry_id": "3669ac28-6bf1-32e0-946e-905ced73661a",
                                        "glosses": [
                                            "Besitzer eines Bades, der auch Heilbehandlungen und Arbeiten eines Friseurs durchführte"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb1b675-9dac-47d3-a8ba-636b04a907f3",
                                                "sense_id": "d0c59e60-1ce9-3a1a-b799-c97c6811e3f1",
                                                "text": "Heute kann man nicht mehr zum Bader gehen, da es diesen Beruf nicht mehr gibt."
                                            },
                                            {
                                                "example_id": "14d9bbef-59c3-4f6f-b965-f9e8f21d7c11",
                                                "sense_id": "d0c59e60-1ce9-3a1a-b799-c97c6811e3f1",
                                                "text": "„Die Kugel stutzte ihm ein Haarbüschel, und das war mehr als ausreichend, um den Bader, den Arzt und alle übrigen Anwesenden zu vertreiben.“"
                                            },
                                            {
                                                "example_id": "7e88fc4c-a418-48c5-ad02-697bb5a7482c",
                                                "sense_id": "d0c59e60-1ce9-3a1a-b799-c97c6811e3f1",
                                                "text": "„Nunmehr wurde ein Bote zu einem Bader in die Stadt geschickt, und der schnitt ihm alsdann Haar und Bart so fein, bis der Bauer wie ein Kirchenpfleger am Sonntag aussah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cc17594-56c6-4dcf-89f4-4c265d4c217a",
                        "source_entry_id": "8a16f81c-f82c-3b0d-9fc1-0f2a1c415123",
                        "source_sense_id": "b972a68a-40b7-3b9d-935a-536d0f8afe3c",
                        "target_lang_word": "цирюльник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "цирюльник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                        "entry_id": "f5956900-18dc-3327-ab1c-d479e395f2c5",
                                        "glosses": [
                                            "устар. парикмахер (часто владевший также элементарными приёмами врачевания)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f35db31b-6fc3-46df-94f7-0d4077baea5a",
                                                "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                                "text": "Те же парикмахеры были цирюльниками, фельдшерами, брили бороду, пускали кровь разными манерами, а подчас выдёргивали и зубы."
                                            },
                                            {
                                                "example_id": "142fddf3-8862-4163-9f63-46083986b0ca",
                                                "sense_id": "d365d136-6f88-3700-90de-7a440ad56c05",
                                                "text": "Меня лечил полковой цирюльник, ибо в крепости другого лекаря не было, и, слава богу, не умничал."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
