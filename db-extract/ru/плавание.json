                                    {
                                        "sense_id": "112f80dc-5ab6-3f68-81c8-4431c2ec9d8a",
                                        "entry_id": "490c0fd1-044d-390f-9979-adb3f8ff713d",
                                        "glosses": [
                                            "Not fixed in position, opinion etc.; free to move or drift."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc74e343-2b1a-4e71-addc-26b08fcd51ff",
                                                "sense_id": "112f80dc-5ab6-3f68-81c8-4431c2ec9d8a",
                                                "text": "The outcome of the forthcoming election is still unclear due to the large number of floating voters."
                                            },
                                            {
                                                "example_id": "1d04d28c-d786-44c9-9a13-6feb34fbd0ed",
                                                "sense_id": "112f80dc-5ab6-3f68-81c8-4431c2ec9d8a",
                                                "text": "In China, the large floating population has tended to gravitate to cities."
                                            },
                                            {
                                                "example_id": "3ff80064-a17d-4ee6-b51e-3fa7ba2913d9",
                                                "sense_id": "112f80dc-5ab6-3f68-81c8-4431c2ec9d8a",
                                                "text": "You can drag the floating toolbars to any position on the screen."
                                            },
                                            {
                                                "example_id": "49445f3f-cfde-4bcf-9dd3-4d7302358238",
                                                "sense_id": "112f80dc-5ab6-3f68-81c8-4431c2ec9d8a",
                                                "text": "\"And I am much mistaken if she has not some floating fancy of her own.\""
                                            }
                                        ]
                                    },
