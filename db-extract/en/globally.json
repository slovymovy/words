                                        "sense_id": "8fcd25ef-9728-3638-9aad-9476068c5b4e",
                                        "entry_id": "69e15b55-d203-3fc5-93c1-d639c686c9c6",
                                        "glosses": [
                                            "D’une façon globale, générale, en bloc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8862b0c4-da20-4296-957d-be2c5c19a0cd",
                                                "sense_id": "8fcd25ef-9728-3638-9aad-9476068c5b4e",
                                                "text": "Vous savez que l’Union du crédit [établissement financier, en Belgique] n’avait point de capital nominal ; c’était une mutualité où quatre mille associés solidaires les uns des autres, et tous ensemble responsables à l’égard des autres, représentaient globalement une surface de soixante millions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd864e0-4009-3551-8221-3697353338e5",
                                        "entry_id": "69e15b55-d203-3fc5-93c1-d639c686c9c6",
                                        "glosses": [
                                            "À l’échelle du globe, du monde."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8ffc8a6-e673-40ec-9b3b-bc0a356dd65b",
                                                "sense_id": "acd864e0-4009-3551-8221-3697353338e5",
                                                "text": "La production industrielle est désormais pensée globalement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
