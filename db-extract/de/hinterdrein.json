                    {
                        "sense_id": "faea760b-d996-3400-b05b-1b7a0ae47958",
                        "entry_id": "62a56b01-d6e5-3cda-ae6f-60580353025d",
                        "glosses": [
                            "hinterher, jemandem oder etwas folgend"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "0543e97e-239f-43fa-a790-be6c49930a6b",
                                "sense_id": "faea760b-d996-3400-b05b-1b7a0ae47958",
                                "text": "Das Kind lief der Großmutter immer hinterdrein, es lief mit auf Schritt und Tritt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32234cb4-c7f2-3124-9788-287727c94a3a",
                        "entry_id": "62a56b01-d6e5-3cda-ae6f-60580353025d",
                        "glosses": [
                            "hinterher, nachdem etwas passiert ist"
                        ],
                        "tags": [
                            "outdated",
                            "temporal"
                        ],
                        "examples": [
                            {
                                "example_id": "beec59b0-b08c-4a9b-ab3e-f8f7e8ab7b7e",
                                "sense_id": "32234cb4-c7f2-3124-9788-287727c94a3a",
                                "text": "Verflucht! Zur rechten Zeit fällt einem nie was ein, und was man Gutes denkt, kommt meist erst hinterdrein. (Goethe)"
                            },
                            {
                                "example_id": "97788f3e-860e-40d8-b6ec-9919b6303009",
                                "sense_id": "32234cb4-c7f2-3124-9788-287727c94a3a",
                                "text": "„Und sie versprach leichte Kost, Milch, Eier, geröstetes Brot, Gemüsesuppen, ein gutes rotes Beefsteak mit Spinat zu Mittag und hinterdrein eine handliche Omelette mit Apfel-Marmelade darin, kurz, Dinge, die nährten und dabei einem heikligen Magen genehm seien wie also dem seinen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
