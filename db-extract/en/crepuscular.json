                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dämmerungsaktiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e6e249-15a5-37c8-a478-84db292ff19b",
                                        "entry_id": "8b0b33a7-fa68-3064-8ee3-c3bde95ed0e2",
                                        "glosses": [
                                            "(nur) in der Dämmerung wach und sonst ruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45438896-9691-4147-925e-0dfe97dd54a8",
                                                "sense_id": "a2e6e249-15a5-37c8-a478-84db292ff19b",
                                                "text": "„Düsing: „Der Feldhase ist von Natur aus dämmerungsaktiv, das heißt, er verbringt die meiste Zeit des Tages in der Deckung.“"
                                            },
                                            {
                                                "example_id": "58edab14-fcce-4674-a1ea-c33c15235e9f",
                                                "sense_id": "a2e6e249-15a5-37c8-a478-84db292ff19b",
                                                "text": "„Zudem sind viele Wildtiere dämmerungsaktiv.“"
                                            },
                                            {
                                                "example_id": "89b32b51-b1d4-41fd-91af-6ba50d9509fd",
                                                "sense_id": "a2e6e249-15a5-37c8-a478-84db292ff19b",
                                                "text": "„Der Automobilclub von Deutschland (AvD) in Frankfurt weist darauf hin, dass das Wildunfallrisiko im morgendlichen Berufsverkehr besonders hoch ist, denn Rehe seien \"dämmerungsaktiv\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
