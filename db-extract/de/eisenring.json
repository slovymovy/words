                            {
                                "example_id": "bd252bec-6064-43b5-81e6-49fa4c53738e",
                                "sense_id": "3f78fe13-f9e3-3275-bce5-6203f0edfbc1",
                                "text": "„Die Dauben eines Fasses werden durch einen Eisenring zusammengehalten.“"
                            },
                            {
                                "example_id": "857ff058-8cbb-4fe6-88fb-1966a72950ba",
                                "sense_id": "3f78fe13-f9e3-3275-bce5-6203f0edfbc1",
                                "text": "„Der Mann war gerade dabei gewesen, ein großes schwarzes Pferd, das er mit seinem Halfter an einem Eisenring in der Stallwand festgemacht hatte, mit einer Bürste zu striegeln.“"
                            }
                        ],
