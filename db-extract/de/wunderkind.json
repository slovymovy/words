                    },
                    {
                        "translation_id": "6c98e953-a317-4204-b9ab-6ec84f91ecd9",
                        "source_entry_id": "f2d8f21b-1a38-3a4e-8cc4-9a610175cc02",
                        "source_sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
