                "translations": [
                    {
                        "translation_id": "56417a13-d96b-4100-b85d-7fddc0ea7bfd",
                        "source_entry_id": "697a0084-bb23-3ec1-9f0d-5847516b00c2",
                        "source_sense_id": "11356fee-c8ec-366d-9668-b8c9b967ef82",
                        "target_lang_word": "чистюля",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чистюля",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                        "entry_id": "8a1c287f-2306-31ab-a7c8-0b66e3beacf3",
                                        "glosses": [
                                            "разг., также ирон. или неодобр. человек с особым пристрастием к чистоте"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087f2246-b1dd-4465-b088-8cd81a94c3a7",
                                                "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                                "text": "Брат был величайший чистюля, но щеголем никогда не был..."
                                            },
                                            {
                                                "example_id": "de07d0cc-04b0-442b-8798-7ae1947324a8",
                                                "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                                "text": "Машка исключительная чистюля. Если замарает (хотя бы табачным пеплом) пальчик, в ужасе таращит глазенки."
                                            },
                                            {
                                                "example_id": "46b5ab36-c66a-4ca9-b607-ccd4b5d27a93",
                                                "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                                "text": "«Какой чистюля, — подумал Адам о Семечкине, — молодец!»"
                                            },
                                            {
                                                "example_id": "a0fe5214-e1a2-47d7-aa7a-dec223e741ae",
                                                "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                                "text": "...— у меня у самой все заштопано: и юбка, и передник, и чулки, у мамы нет денег на новое, а это мне не мешает следить за собой и мыть руки чуть ли не после каждого урока. — Пожалуйста, не чванься… Нашла чем! Чистюля! — насмешливо протянула в нос, подражая Кате, Смолянская..."
                                            },
                                            {
                                                "example_id": "94a52c95-1df8-4314-8c79-61fc34d5e6dc",
                                                "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                                "text": "Варвара Павловна придавала большое значение способности ученого к обобщениям, но одновременно не любила «чистюль» — исследователей, не умеющих делать черновую работу: править рукописи, уметь подводить варианты, устанавливать историю текста и т. д."
                                            },
                                            {
                                                "example_id": "c4df2e40-8f1d-47ec-b10b-cd2005681982",
                                                "sense_id": "3ee97dab-c69d-346e-bf1b-166dd8ad285c",
                                                "text": "Сан Саныч проворчал что-то нелестное в адрес экологических чистюль, но смирился."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
