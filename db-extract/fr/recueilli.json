                                            {
                                                "example_id": "035ae8d2-617d-435b-9dfc-30c12cfa385f",
                                                "sense_id": "5047e820-b3bb-3a8a-8c2b-311c608ca7bf",
                                                "text": "Sie kniete andächtig betend vor dem Altar."
                                            },
                                            {
                                                "example_id": "1119fa63-0022-4267-b30d-d14fdc647f94",
                                                "sense_id": "5047e820-b3bb-3a8a-8c2b-311c608ca7bf",
                                                "text": "„Die andächtigste Aufmerksamkeit ist auf allen Gesichtern eingeprägt. Christus nimmt die Einsetzung gerade so vor, wie das Evangelium sie erzählt.“"
                                            }
