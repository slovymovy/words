                ],
                "senses": [
                    {
                        "sense_id": "ee4e90b1-00a5-3211-8771-c5fd173f79c1",
                        "entry_id": "c1792311-dc70-3307-bea2-bf26c477d7cf",
                        "glosses": [
                            "содержащий кокаин, свойственный кокаину, характерный для кокаина, либо имеющий к такому наркотику иное прямое отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39874b13-647a-4c15-b88b-003230a0f6a4",
                                "sense_id": "ee4e90b1-00a5-3211-8771-c5fd173f79c1",
                                "text": "Кандидат в президенты пообещал, что каждой семье будет разрешено выращивать кокаиновые кусты на территории площадью 1,6 гектаров."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86ff0721-460a-456b-ba12-b4de26e91de1",
                        "source_entry_id": "c1792311-dc70-3307-bea2-bf26c477d7cf",
                        "source_sense_id": "ee4e90b1-00a5-3211-8771-c5fd173f79c1",
                        "target_lang_word": "cocain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "102dcf6a-964a-314a-9446-9fe54252fc2b",
                                        "entry_id": "66df2e93-abc7-3f5a-b786-f8bb0d0ad854",
                                        "glosses": [
                                            "Dated form of cocaine."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f0711e-5232-4d7d-81a4-f2bfecd30748",
                                                "sense_id": "102dcf6a-964a-314a-9446-9fe54252fc2b",
                                                "text": "But in those cases in which the application of cocain would relieve the symptoms, we are sure to get good results[…]"
                                            },
                                            {
                                                "example_id": "087635c8-b5cb-467c-b25c-4f73e618f215",
                                                "sense_id": "102dcf6a-964a-314a-9446-9fe54252fc2b",
                                                "text": "My attention was called to this many years ago, very shortly after the introduction of cocain as a local anesthetic."
                                            },
                                            {
                                                "example_id": "bf6cf6f2-dcfe-4b6f-bd32-1dbd80ca5f69",
                                                "sense_id": "102dcf6a-964a-314a-9446-9fe54252fc2b",
                                                "text": "After opening the bladder (incision extending 1 inch pubically from peritoneal fold) the prostate was injected deeply with 1 per cent. cocain while the pericapsular region was injected with the 1 : 400 novocain solution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
