                                            {
                                                "example_id": "3f874996-78cb-40c7-98ff-660ccb596a36",
                                                "sense_id": "47e6367f-8a55-30c6-a865-370109c5346b",
                                                "text": "The doubtfull wordes whereof they scan and canvas to an fro.\nWhich done, Prometheus sonne began by counsell wise and sage"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6deb8541-8b2f-3c05-86b9-a03afa857f3d",
                                        "entry_id": "4a96a7e3-856c-3cf6-9467-78568250b5a1",
                                        "glosses": [
                                            "Closely related, akin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce05549-b126-40cf-af66-f73d01032880",
                                                "sense_id": "6deb8541-8b2f-3c05-86b9-a03afa857f3d",
                                                "text": "After this Merlyn told vnto kynge Arthur of the prophecye / that there shold be a grete batail besyde Salysbury and Mordred his owne sone sholde be ageynste hym / Also he tolde hym that Basdemegus was his cosyn and germayn vnto kynge Vryence"
                                            },
                                            {
                                                "example_id": "02a3234b-b5dc-473e-b2df-a55598537d77",
                                                "sense_id": "6deb8541-8b2f-3c05-86b9-a03afa857f3d",
                                                "text": "The phrase would bee more Germaine."
                                            },
                                            {
                                                "example_id": "c5fec5bf-aa3a-4d92-a2a0-ae5f6e92ea18",
                                                "sense_id": "6deb8541-8b2f-3c05-86b9-a03afa857f3d",
                                                "text": "Wert thou a Leopard, thou wert Germane to the Lion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
