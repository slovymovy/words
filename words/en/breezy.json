                            {
                                "target_lang_word": "девушка",
                                "target_lang_sense_clarification": "молодая особа"
                            },
                            {
                                "target_lang_word": "телка",
                                "target_lang_sense_clarification": "грубоватый молодежный сленг"
                            },
                            {
                                "target_lang_word": "цыпочка",
                                "target_lang_sense_clarification": "сленг о привлекательной девушке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
