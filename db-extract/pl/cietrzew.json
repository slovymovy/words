                "senses": [
                    {
                        "sense_id": "d5feb792-2710-3298-b3b9-6591d66c1575",
                        "entry_id": "7bab8069-0edc-382e-8b91-1032527dc54f",
                        "glosses": [
                            "duży, eurazjatycki ptak łowny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e177696-ad57-47c1-a267-9f728132487d",
                                "sense_id": "d5feb792-2710-3298-b3b9-6591d66c1575",
                                "text": "Około południa udało mi się ubić jakiegoś dużego ptaka z gatunku cietrzewi, który, upieczony na rożnie, miał bardzo delikatne mięso"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72a826d0-28d5-4bf0-b629-c92ac61271fc",
                        "source_entry_id": "7bab8069-0edc-382e-8b91-1032527dc54f",
                        "source_sense_id": "d5feb792-2710-3298-b3b9-6591d66c1575",
                        "target_lang_word": "black grouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "black grouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd02f88-7b9f-3c4d-9884-a1efff2cb47e",
                                        "entry_id": "e900c758-03f0-360e-ac31-05463c44d096",
                                        "glosses": [
                                            "A large, black bird with a lyre-shaped tail, Lyrurus tetrix (syn. Tetrao tetrix)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ad1723-8cc3-4c06-a459-7b816a4c3ef2",
                                                "sense_id": "bdd02f88-7b9f-3c4d-9884-a1efff2cb47e",
                                                "text": "The shy black grouse, “with an eye on every feather,” can only thrive in vast, absolutely undisturbed heath and moorlands. Therefore, unfortunately, there are not too many black grouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c55a9bd-ba90-4b41-8cd1-4216823431f4",
                        "source_entry_id": "7bab8069-0edc-382e-8b91-1032527dc54f",
                        "source_sense_id": "d5feb792-2710-3298-b3b9-6591d66c1575",
                        "target_lang_word": "tétras lyre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tétras lyre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "633cdada-55c7-306e-8adf-734ea5edb38d",
                                        "entry_id": "4373e9df-4a2d-32e7-9864-0c0db2dcf80c",
                                        "glosses": [
                                            "Espèce d'oiseau de la sous-famille des tétraoninés (tétras et alliés) dont la queue du mâle se termine en forme de lyre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341b42d6-82dc-4ae3-abae-ef024b18312c",
                                                "sense_id": "633cdada-55c7-306e-8adf-734ea5edb38d",
                                                "text": "Le tétras lyre (Petit coq de bruyère Tetrao tetrix, Oiseau Galliforme) est une espèce d’oiseau à répartition boréo-montagnarde, adaptée à des climats rudes et des hivers froids et enneigés."
                                            },
                                            {
                                                "example_id": "970d0ad2-e769-47da-987a-318df89744a4",
                                                "sense_id": "633cdada-55c7-306e-8adf-734ea5edb38d",
                                                "text": "Un paradis pour les grands coqs et leurs nombreux cousins que sont la gélinotte des bois, le lagopède des saules et le tétras-lyre – un petit coq pesant tout juste 1,5 kg. Ici et là, ils se regroupent pour une parade nuptiale en toute sérénité, parfois en grand nombre, comme sur les leks des tétras-lyres qui peuvent rassembler jusqu’à 50 ou 60 mâles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1bbcaba-6fc2-4d5b-b0ba-90b519037feb",
                        "source_entry_id": "7bab8069-0edc-382e-8b91-1032527dc54f",
                        "source_sense_id": "d5feb792-2710-3298-b3b9-6591d66c1575",
                        "target_lang_word": "gallo lira",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ee9cea6b-f3a6-4033-aae4-9b38471f2870",
                        "source_entry_id": "7bab8069-0edc-382e-8b91-1032527dc54f",
                        "source_sense_id": "d5feb792-2710-3298-b3b9-6591d66c1575",
                        "target_lang_word": "Birkhuhn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birkhuhn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd7f1f72-0042-33b8-aa92-652d385cc0b9",
                                        "entry_id": "9ca11be0-7b8e-3987-b109-2e193d291ece",
                                        "glosses": [
                                            "Hühnervogel aus der Familie der Fasanenartigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9241d6d-f701-4b61-aca2-6c54159d4e88",
                                                "sense_id": "fd7f1f72-0042-33b8-aa92-652d385cc0b9",
                                                "text": "Das Birkhuhn lebt in Mooren und Heiden."
                                            },
                                            {
                                                "example_id": "c1c6a52f-1624-4fc1-8304-31c919b631d0",
                                                "sense_id": "fd7f1f72-0042-33b8-aa92-652d385cc0b9",
                                                "text": "„Sie kannte die Plätze der knorrigen Moorbirken und die Buschgruppen aus Weiden und Ebereschen, wo Birkhühner und Wiesenpieper nisteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
