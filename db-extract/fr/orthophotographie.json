                ],
                "senses": [
                    {
                        "sense_id": "eb24abd3-c794-351a-a670-d963e3420612",
                        "entry_id": "bc40dc72-3889-32cd-bcaa-1c059b2210e3",
                        "glosses": [
                            "Image photographique aérienne ou satellitale de la surface terrestre rectifiées géométriquement et égalisées radiométriquement."
                        ],
                        "tags": [
                            "Géomatique"
                        ],
                        "examples": [
                            {
                                "example_id": "a96c8d70-0713-422e-a9f6-7c1f4fff7254",
                                "sense_id": "eb24abd3-c794-351a-a670-d963e3420612",
                                "text": "Le logiciel Google Earth est un bon exemple d’outils utilisant des orthophotographies en fond cartographique."
                            }
                        ]
                    },
                    {
                        "sense_id": "88b52afc-7053-350b-bb5a-ffda36a594c7",
                        "entry_id": "bc40dc72-3889-32cd-bcaa-1c059b2210e3",
                        "glosses": [
                            "Orthoimage obtenue à l’aide d'une ou plusieurs photographies aériennes, en corrigeant les déformations perspectives dues à l’inclinaison des axes de prise de vue, à la distorsion de l’objectif, et au relief, de manière à reconstituer une image du terrain telle qu’elle résulterait d’une projection orthogonale verticale."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a97a910e-9994-4289-8dd4-2994029b18e2",
                        "source_entry_id": "bc40dc72-3889-32cd-bcaa-1c059b2210e3",
                        "target_lang_word": "Orthofoto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orthofoto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad691a15-2cfa-39bd-a0e0-fa6706ab8f07",
                                        "entry_id": "905d3e5a-9c6d-3801-9a53-721a80317153",
                                        "glosses": [
                                            "mit Hilfe von photogrammetrischen Verfahren aus einem Luftbild erzeugte verzerrungsfreie Abbildung eines Teiles der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d701dc9f-79a4-413c-ad79-1c06bda01a2c",
                                                "sense_id": "ad691a15-2cfa-39bd-a0e0-fa6706ab8f07",
                                                "text": "Die Grundlage für jedes Orthofoto ist ein Luftbild."
                                            },
                                            {
                                                "example_id": "4cc3ed57-756b-4544-92e8-40fb8730bb05",
                                                "sense_id": "ad691a15-2cfa-39bd-a0e0-fa6706ab8f07",
                                                "text": "„Seit kurzem befindet sich im Eingangsbereich der Bezirkshauptmannschaft Braunau ein Fotoboden mit einem Ausmaß von drei mal vier Metern, der als Luftbildaufnahme (Orthofoto) den Bezirk Braunau in seiner gesamten Ausdehnung darstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd8f2904-3c3e-4cdc-bd74-ab50b0d81a7f",
                        "source_entry_id": "bc40dc72-3889-32cd-bcaa-1c059b2210e3",
                        "target_lang_word": "orthophoto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orthophoto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c5ffad1-b18c-3622-9321-668c7650054d",
                                        "entry_id": "de09807e-f047-3a2c-9b93-3976a21f11a9",
                                        "glosses": [
                                            "An aerial photograph that has been geometrically corrected (orthorectified) such that the scale of the photograph is uniform, meaning that the photo can be considered equivalent to a map."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e97553-232c-4433-a108-a4d1ceb71709",
                                                "sense_id": "2c5ffad1-b18c-3622-9321-668c7650054d",
                                                "text": "Orthophotos or orthophoto mosaics enhanced by additional symbolized, planimetric information are called orthophoto plans. An orthophoto plan with added contour lines is a modern mapping product, called an orthophoto map."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
