                                    {
                                        "sense_id": "e1ae8a10-b46d-30f8-b389-ce545b70d407",
                                        "entry_id": "56660649-c082-312e-b2d4-f2d1803b03cc",
                                        "glosses": [
                                            "present participle and gerund of lead"
