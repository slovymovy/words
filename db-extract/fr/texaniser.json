                "senses": [
                    {
                        "sense_id": "4affec9b-0c95-34c3-96af-4d36b2322c5e",
                        "entry_id": "fa25d38a-8216-3494-b61b-7c79fa1301d9",
                        "glosses": [
                            "Donner un caractère texan à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b1a1a3-499d-4515-bea3-176ac1e30093",
                                "sense_id": "4affec9b-0c95-34c3-96af-4d36b2322c5e",
                                "text": "Les structures administratives, politiques et juridiques texanes, tout en ne suscitant pas toujours parmi les citoyens l’intérêt escompté, traduisent cependant une véritable cohésion dans le tissu social et contribuent à “texaniser” les gens du comté Médina."
                            },
                            {
                                "example_id": "04bddec8-ceb0-4a61-b1fd-ca6956a37b72",
                                "sense_id": "4affec9b-0c95-34c3-96af-4d36b2322c5e",
                                "text": "Il n’existe pas de dialecte texan, ni « d’anglais texanisé »."
                            }
                        ]
                    }
