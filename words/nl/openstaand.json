                                "target_lang_word": "ouvert",
                                "target_lang_sense_clarification": "porte, fenêtre, pont"
                            },
                            {
                                "target_lang_word": "entrebâillé",
                                "target_lang_sense_clarification": "légèrement ouvert"
                            }
                        ]
