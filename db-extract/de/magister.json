                    },
                    {
                        "sense_id": "5753379d-3aa4-3352-be6a-887318cead0b",
                        "entry_id": "9198dda9-6ae1-31e0-a0d7-aaa8c4fc5165",
                        "glosses": [
                            "Lehrer"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "9c60b897-c665-4317-bea6-7e0ec75f87be",
                                "sense_id": "5753379d-3aa4-3352-be6a-887318cead0b",
                                "text": "Mein Magister sagte immer: »Das Leben ist eines der härtesten«."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "0e0968c8-a556-3cdb-8a95-82681793bde2",
                        "entry_id": "9198dda9-6ae1-31e0-a0d7-aaa8c4fc5165",
                        "glosses": [
                            "akademischer Grad mit Lehrberechtigung an Hochschulen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3ffe3646-8a2c-4418-8e36-6f04f0388c99",
                                "sense_id": "0e0968c8-a556-3cdb-8a95-82681793bde2",
                                "text": "„Der Magister konnte zur Hölle fahren, und genau dorthin dürfte er auch gekommen sein, als er starb.“"
                            },
                            {
                                "example_id": "7afd7752-f044-4cbd-ba68-b0f0748d08fd",
                                "sense_id": "0e0968c8-a556-3cdb-8a95-82681793bde2",
                                "text": "„Er sei der Assistent des Magistersund berühmten Professors Kant, Königsberg.“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    }
