                        "glosses": [
                            "Mettre (un enfant) à l’école maternelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c629c585-0166-4919-942d-61cf8bc53780",
                                "sense_id": "df7b1582-1b16-352d-9ea6-7416be7ab3ae",
                                "text": "Des efforts sont déployés pour convaincre les parents peu instruits de l'importance de préscolariser leurs enfants à partir de 3 ans."
                            },
                            {
                                "example_id": "a82f03dc-a3fe-4608-a29f-ab67b5fb8be5",
                                "sense_id": "df7b1582-1b16-352d-9ea6-7416be7ab3ae",
                                "text": "Il n'en demeure pas moins vrai que les arrondissements bourgeois ont encore tendance à moins préscolariser les enfants mais les contrastes sont beaucoup moins affirmés que dans les années d'après-guerre et même qu'en 1954."
                            }
                        ]
                    }
