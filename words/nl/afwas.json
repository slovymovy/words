                            },
                            {
                                "target_lang_word": "dishwashing",
                                "target_lang_sense_clarification": "the act of cleaning dishes"
                            },
                            {
                                "target_lang_word": "doing the dishes",
                                "target_lang_sense_clarification": "the activity of cleaning up after a meal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "624e24a7-ea64-3fd5-9c26-3840a6472c98",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>afwassen</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>was</w> de borden <w>af</w> terwijl jij de tafel afruimt.",
                            "target_lang_translations": {
                                "en": "I <w>am washing up</w> the plates while you clear the table."
                            }
                        },
                        {
                            "text": "Het is belangrijk dat ik elke avond direct <w>afwas</w>.",
                            "target_lang_translations": {
                                "en": "It is important that I <w>wash the dishes</w> immediately every evening."
                            }
                        }
