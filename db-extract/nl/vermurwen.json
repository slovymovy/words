        "nl-extract.jsonl": [
            {
                "entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                "word": "vermurwen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1ecca65d-7400-30b1-bcac-40fdf0090fe7",
                        "entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                        "glosses": [
                            "medelijden opwekken"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5315f0aa-b0fc-349c-a690-d45fa781b1cc",
                        "entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                        "glosses": [
                            "iemand zachter maken zodat hij makkelijker is over te halen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "35f4cdc3-14f3-45aa-8411-f956b4f71d1e",
                                "sense_id": "5315f0aa-b0fc-349c-a690-d45fa781b1cc",
                                "text": "De beveiligers waren niet te vermurwen. Geen Vierdaagse-polsbandje is geen toegang. \"Maar voor de meeste mensen is dat geen probleem\", zei een van de beveiligers."
                            },
                            {
                                "example_id": "964a3938-48d2-491e-b58e-3b700032a791",
                                "sense_id": "5315f0aa-b0fc-349c-a690-d45fa781b1cc",
                                "text": "Apple gaat door het stof over het bewust vertragen van de iPhone. Publieke excuses en korting op het vervangen van de iPhonebatterij moeten boze iPhonegebruikers vermurwen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6716457-618a-4a78-bcaf-b36e3c4ac110",
                        "source_entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                        "source_sense_id": "1ecca65d-7400-30b1-bcac-40fdf0090fe7",
                        "source_sense_description": "medelijden opwekken",
                        "target_lang_word": "exite pity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "afd14a17-a974-4e1d-a43f-2c0087e69978",
                        "source_entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                        "source_sense_id": "5315f0aa-b0fc-349c-a690-d45fa781b1cc",
                        "source_sense_description": "ompraten",
                        "target_lang_word": "soften",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soften",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "804c5244-b074-36a7-8f6e-b8b23913a74e",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To make something soft or softer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d97191-acd5-4371-90eb-1a609b67ed4a",
                                                "sense_id": "804c5244-b074-36a7-8f6e-b8b23913a74e",
                                                "text": "Soften the butter before beating in the sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be41065f-b020-34a0-a39a-4c29cc20a048",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To undermine the morale of someone (often soften up)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150f02a3-9160-475f-b9c7-b4f8d2c0777c",
                                                "sense_id": "be41065f-b020-34a0-a39a-4c29cc20a048",
                                                "text": "Before the invasion, we softened up the enemy with the artillery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baffe763-14f6-39f7-8d7b-591d61c7881c",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To make less harsh"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cabb484e-b9b1-462e-a41c-12fc7425bd8c",
                                                "sense_id": "baffe763-14f6-39f7-8d7b-591d61c7881c",
                                                "text": "Having second thoughts, I softened my criticism."
                                            },
                                            {
                                                "example_id": "595a2197-87e9-49b9-9f92-184307b2b076",
                                                "sense_id": "baffe763-14f6-39f7-8d7b-591d61c7881c",
                                                "text": "I have recently reclad the south-west facing side of my single-storey cottage […]. I now want to plant some climbers of more manageable proportions to soften the building."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0a1da8-505c-323e-8ea6-fe597e7ce6d9",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To become soft or softer"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1fed54c-5d70-4b24-9604-5f8e84841db0",
                                                "sense_id": "4c0a1da8-505c-323e-8ea6-fe597e7ce6d9",
                                                "text": "The butter softened as it warmed up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94b13739-62a5-35fa-b56f-893aa38d9345",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To become or make (a consonant) more lenis, to lenite."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95a165a0-8c7a-3d0f-b7c6-06a78c44ece7",
                                        "entry_id": "a2019927-940a-3b2e-8338-84994acfaf73",
                                        "glosses": [
                                            "To palatalize."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49e0acd1-5e17-41eb-8374-cc40dd2b708d",
                        "source_entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                        "source_sense_id": "5315f0aa-b0fc-349c-a690-d45fa781b1cc",
                        "source_sense_description": "ompraten",
                        "target_lang_word": "weaken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weaken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                        "entry_id": "55f03671-1ac4-3a4e-9c22-44bcd3a2bc22",
                                        "glosses": [
                                            "To make weaker or less strong."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9d6f71-cc16-4970-ad33-6f6044355d7f",
                                                "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                                "text": "weaken a bond"
                                            },
                                            {
                                                "example_id": "444dfced-be3a-4716-a20a-def41cd60ef7",
                                                "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                                "text": "weaken a joint"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                        "entry_id": "55f03671-1ac4-3a4e-9c22-44bcd3a2bc22",
                                        "glosses": [
                                            "To become weaker or less strong."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f92a1-c809-4cde-a132-924f5a1d239b",
                                                "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                                "text": "Over the years my enthusiasm for the job has weakened."
                                            },
                                            {
                                                "example_id": "bc60c0d1-67b8-4a6b-ae48-17889a3a1b69",
                                                "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                                "text": "My friends, we are confronted with a serious situation. But it is typical of the security problems of the world today. Powerful and aggressive forces are constantly probing, now here, now there, to see whether the free world is weakened. In the face of this, there are no easy choices available. It is misleading for anyone to imply that there are. However, the present situation, though serious, is by no means desperate or hopeless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e1bd7e4-7ce9-4664-90a0-eefe70d74ace",
                        "source_entry_id": "9ae042bb-49e7-3fe4-8c7c-1b3b6d641772",
                        "source_sense_id": "5315f0aa-b0fc-349c-a690-d45fa781b1cc",
                        "source_sense_description": "ompraten",
                        "target_lang_word": "appease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                                        "entry_id": "abada48b-2fa2-308e-b902-15a686570ad8",
                                        "glosses": [
                                            "To make quiet; to calm; to reduce to a state of peace; to dispel (anger or hatred)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c993f4-c6e6-4caa-811e-d3a4125a6af5",
                                                "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                                                "text": "to appease the tumult of the ocean"
                                            },
                                            {
                                                "example_id": "81b6ff9a-ebd8-472a-852c-7fe668df4fc1",
                                                "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                                                "text": "'First, a little refreshment to reward my exertions. You may as well be quiet. It is not the first time, or the second, that your veins have appeased my thirst!'"
                                            },
                                            {
                                                "example_id": "2b1ef9db-b3e3-499d-9741-7484fce6a5c0",
                                                "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                                                "text": "Former Australian prime minister Tony Abbott has suggested climate change is “probably doing good” in a speech in London in which he likened policies to combat it to “primitive people once killing goats to appease the volcano gods” ."
                                            },
                                            {
                                                "example_id": "0ed27f2a-b637-42cb-afa9-99ea77e88aea",
                                                "sense_id": "c97d2c35-7b13-3b6c-a892-4f69af763e94",
                                                "text": "It's been slowly hacked back, amid fears of escalating costs, by politicians who have also increased those costs by adding expensive structures such as tunnels to appease opponents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f72dfef-7688-3a5f-b8a8-845d5c47598c",
                                        "entry_id": "abada48b-2fa2-308e-b902-15a686570ad8",
                                        "glosses": [
                                            "To come to terms with; to adapt to the demands of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9952df6-29f5-4bde-b8af-bcc46939ee48",
                                                "sense_id": "5f72dfef-7688-3a5f-b8a8-845d5c47598c",
                                                "text": "They appeased the angry gods with burnt offerings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
