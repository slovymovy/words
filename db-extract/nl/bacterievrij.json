                "senses": [
                    {
                        "sense_id": "ed38e3eb-7fea-380d-b985-a61a56ccdd4c",
                        "entry_id": "20e31773-2edd-3b07-a433-a6619253fad8",
                        "glosses": [
                            "zonder bacteriën; vrij van bacteriën"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c42d87d-c665-4d2e-89ac-49d1c1b271ea",
                                "sense_id": "ed38e3eb-7fea-380d-b985-a61a56ccdd4c",
                                "text": "Nu heeft Nagarajan Kannan, bioloog aan de Mayo Clinic in Minnesota in de Verenigde Staten, samen met collega’s, dit vermoeden bevestigd. Dat deden ze door muizen te onderzoeken van een bepaald soort die zo gefokt zijn dat ze geen darmbacteriën hebben – ook wel bekend als bacterievrije muizen. Wat bleek: deze muizen produceerden allemaal zinkers, in tegenstelling tot standaardmuizen, waarbij de verdeling ongeveer half-half is."
                            },
                            {
                                "example_id": "7fb92c55-f086-4a4c-b6fe-9766638297c6",
                                "sense_id": "ed38e3eb-7fea-380d-b985-a61a56ccdd4c",
                                "text": "Tijdens de autovakantie heeft het interieur van je auto het vaak niet gemakkelijk. Een flinke schoonmaakbeurt na terugkomst zorgt weer voor een virus- en bacterievrije omgeving en vergroot het rijplezier. Tips en trucs voor een grondige aanpak."
                            }
                        ]
                    }
