                                "example_id": "3431cd63-4568-425c-bcc2-5f6c2953440b",
                                "sense_id": "8d57ed77-1521-3ff2-b932-83fe3e1975ae",
                                "text": "The Scripture Greek is observed to be full of Syriasms and Hebraisms."
                            },
                            {
                                "example_id": "4358a678-a121-4d5d-b7cc-427c6e38776a",
                                "sense_id": "8d57ed77-1521-3ff2-b932-83fe3e1975ae",
                                "text": "Who, in reading this magnificent Hebraism, in his conception, sees aught but the heroic son of Nun, with the outstretched arm, and the greater and lesser light obsequious?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d4840de3-059b-32a8-9b6b-3a40a3b83f19",
                        "entry_id": "9e229e8c-3ae6-39e6-9301-eefbabd863ca",
                        "glosses": [
                            "Excessive use of expressions derived from Hebrew."
                        ],
