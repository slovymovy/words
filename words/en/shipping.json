{
    "word_family": [
        "ship",
        "shipper",
        "shipment",
        "shippable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95e784cc-4163-3f93-b714-12e0fe691ba5",
                    "sense_definition": "The physical transportation of goods from one location to another, often by sea, land, or air.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "logistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking for a faster <w>shipping</w> method to reduce delivery times for customers.",
                            "target_lang_translations": {
                                "ru": "Компания ищет более быстрый способ <w>доставки</w>, чтобы сократить время ожидания для клиентов."
                            }
                        },
                        {
                            "text": "International <w>shipping</w> can be quite complicated due to various customs regulations and taxes.",
                            "target_lang_translations": {
                                "ru": "Международные <w>перевозки</w> могут быть довольно сложными из-за различных таможенных правил и налогов."
                            }
                        }
                    ],
                    "synonyms": [
                        "transport",
                        "transportation",
                        "delivery",
                        "freight"
                    ],
                    "common_phrases": [
                        "international shipping",
                        "shipping industry",
                        "shipping company"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая транспортировка товаров из одного места в другое, часто морским, наземным или воздушным транспортом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозка",
                                "target_lang_sense_clarification": "процесс транспортировки"
                            },
                            {
                                "target_lang_word": "доставка",
                                "target_lang_sense_clarification": "транспортировка до места назначения"
                            },
                            {
                                "target_lang_word": "отправка",
                                "target_lang_sense_clarification": "акт отсылки груза"
                            },
                            {
                                "target_lang_word": "транспортировка",
                                "target_lang_sense_clarification": "перемещение грузов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ce6f81a-f3fe-3891-bf40-8be51887893c",
                    "sense_definition": "The fee or cost charged for sending an item or package through a postal or carrier service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "logistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total price of the order includes <w>shipping</w> and handling fees.",
                            "target_lang_translations": {
                                "ru": "Общая стоимость заказа включает расходы на <w>доставку</w> и обработку."
                            }
                        },
                        {
                            "text": "Many online stores offer free <w>shipping</w> if you spend more than fifty dollars.",
                            "target_lang_translations": {
                                "ru": "Многие интернет-магазины предлагают бесплатную <w>доставку</w> при покупке на сумму более пятидесяти долларов."
                            }
                        }
                    ],
                    "synonyms": [
                        "postage",
                        "delivery charge"
                    ],
                    "common_phrases": [
                        "free shipping",
                        "shipping costs",
                        "shipping and handling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата или стоимость, взимаемая за пересылку товара или посылки через почтовую или курьерскую службу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доставка",
                                "target_lang_sense_clarification": "стоимость услуги"
                            },
                            {
                                "target_lang_word": "стоимость доставки",
                                "target_lang_sense_clarification": "денежная сумма за пересылку"
                            },
                            {
                                "target_lang_word": "почтовые расходы",
                                "target_lang_sense_clarification": "затраты на пересылку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf4c9f53-8a91-3349-acf8-9d671c38fa9c",
                    "sense_definition": "A collective group of ships belonging to a specific nation, port, or industry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harbor was crowded with merchant <w>shipping</w> from all over the world.",
                            "target_lang_translations": {
                                "ru": "Гавань была заполнена торговыми <w>судами</w> со всего мира."
                            }
                        },
                        {
                            "text": "New laws were introduced to protect domestic <w>shipping</w> from foreign competition.",
                            "target_lang_translations": {
                                "ru": "Были приняты новые законы для защиты отечественного <w>судоходства</w> от иностранной конкуренции."
                            }
                        }
                    ],
                    "synonyms": [
                        "vessels",
                        "fleet",
                        "tonnage"
                    ],
                    "common_phrases": [
                        "merchant shipping",
                        "commercial shipping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность судов, принадлежащих определенной стране, порту или отрасли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судоходство",
                                "target_lang_sense_clarification": "отрасль или движение судов"
                            },
                            {
                                "target_lang_word": "флот",
                                "target_lang_sense_clarification": "совокупность судов"
                            },
                            {
                                "target_lang_word": "тоннаж",
                                "target_lang_sense_clarification": "вместимость торгового флота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3effe6c6-f747-3af7-81c3-8b7692d56bfd",
                    "sense_definition": "The act of supporting or wishing for a romantic relationship between two people, typically fictional characters or celebrities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fandom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>shipping</w> of those two characters has become a major part of the online fan community.",
                            "target_lang_translations": {
                                "ru": "<w>Шиппинг</w> этих двух персонажей стал важной частью онлайн-сообщества фанатов."
                            }
                        },
                        {
                            "text": "I don't understand the <w>shipping</w> wars that happen every time a new episode is released.",
                            "target_lang_translations": {
                                "ru": "Я не понимаю войн <w>шипперов</w>, которые случаются каждый раз после выхода новой серии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shipping wars"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in internet culture and fandoms"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддержка или желание романтических отношений между двумя людьми, обычно вымышленными персонажами или знаменитостями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шиппинг",
                                "target_lang_sense_clarification": "сленг в фандомах"
                            },
                            {
                                "target_lang_word": "шипперить",
                                "target_lang_sense_clarification": "глагольная форма процесса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f76b806d-38b4-3750-9aa2-ce02da96c089",
                    "sense_definition": "The present participle and gerund of the verb <w>ship</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>shipping</w> the new product to stores across the country this week.",
                            "target_lang_translations": {
                                "ru": "На этой неделе они <w>отправляют</w> новый товар в магазины по всей стране."
                            }
                        },
                        {
                            "text": "After <w>shipping</w> the package, she sent the tracking number to the buyer.",
                            "target_lang_translations": {
                                "ru": "После <w>отправки</w> посылки она отправила номер для отслеживания покупателю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола «ship» (отправлять, перевозить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отправка",
                                "target_lang_sense_clarification": "процесс отсылки"
                            },
                            {
                                "target_lang_word": "отправляющий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}