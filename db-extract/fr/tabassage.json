                "senses": [
                    {
                        "sense_id": "d6d35ef6-2c3d-38d1-9325-25fe8238c42b",
                        "entry_id": "2e56e9e1-721d-33f7-9dfd-cf2d1e5ed885",
                        "glosses": [
                            "Fait de tabasser quelqu’un, de passer quelqu’un à tabac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073ab8db-3453-4fb0-9b27-79e9faa1320c",
                                "sense_id": "d6d35ef6-2c3d-38d1-9325-25fe8238c42b",
                                "text": "Jérome, un adolescent de 17 ans, subit un tabassage en règle, purement gratuit : il n’avait rien à voler sur lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9ebf5e2-b882-4de8-a055-56a3c7b78f4d",
                        "source_entry_id": "2e56e9e1-721d-33f7-9dfd-cf2d1e5ed885",
                        "source_sense_id": "d6d35ef6-2c3d-38d1-9325-25fe8238c42b",
                        "source_sense_description": "fait de tabasser",
                        "target_lang_word": "beating",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1298be-42d7-35ac-8089-1a90b2e90cc1",
                                        "entry_id": "a4e61a85-9504-32b9-8727-65bbec1076d0",
                                        "glosses": [
                                            "The action by which someone or something is beaten."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "421d22c0-de28-496e-b847-c8e748259f6a",
                                                "sense_id": "ab1298be-42d7-35ac-8089-1a90b2e90cc1",
                                                "text": "the beating of a drum"
                                            },
                                            {
                                                "example_id": "29e50aa0-c625-4739-9e34-2b4f8dad188d",
                                                "sense_id": "ab1298be-42d7-35ac-8089-1a90b2e90cc1",
                                                "text": "secret beatings of prisoners"
                                            },
                                            {
                                                "example_id": "36b1e699-c90c-4de1-be5e-cad5c0372ad8",
                                                "sense_id": "ab1298be-42d7-35ac-8089-1a90b2e90cc1",
                                                "text": "[…] to support or agree with the persecutions, beatings, dehumanizings, insults, murders, genocides, and oppressions of a perpetrator's target […]"
                                            },
                                            {
                                                "example_id": "05015fc5-e1d6-4735-8b84-9b7bfc6bd6e5",
                                                "sense_id": "ab1298be-42d7-35ac-8089-1a90b2e90cc1",
                                                "text": "“It was one of the most severe beatings they’ve seen on tape,” an FDNY insider said, recalling the reaction by brass who viewed video of the bloody fisticuffs."
                                            },
                                            {
                                                "example_id": "c0f69fa4-f94f-4f16-a70b-1150365cf839",
                                                "sense_id": "ab1298be-42d7-35ac-8089-1a90b2e90cc1",
                                                "text": "The fight is not all one-sided. Lion is taking a savage beating as the two flagships trade body blows almost independent of the furious carronade going on behind them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64076668-3885-30c1-ade3-a0c890b7f44b",
                                        "entry_id": "a4e61a85-9504-32b9-8727-65bbec1076d0",
                                        "glosses": [
                                            "A heavy defeat or setback."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ea388f9-fabe-4bf3-9c35-4973c47f41af",
                                                "sense_id": "64076668-3885-30c1-ade3-a0c890b7f44b",
                                                "text": "To increase United's pain, this was their first home defeat in any competition since April 2010, when they lost to Chelsea - but even that defeat, which effectively cost them the title, may not turn out to have the same long-term significance as this heavy beating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbcbb501-3d7b-3765-880f-b689f90ad743",
                                        "entry_id": "a4e61a85-9504-32b9-8727-65bbec1076d0",
                                        "glosses": [
                                            "The pulsation of the heart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
