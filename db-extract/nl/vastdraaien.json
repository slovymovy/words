                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1740b557-470b-45cb-9d81-969c5d27eb26",
                                "sense_id": "18c94400-2879-3f26-b6d1-a719c3c87d55",
                                "text": "Multitool €8,95 gadgethouse.nl. Deze handige multitool past gewoon in je portemonnee, want hij heeft de grootte van een bankpas. Hiermee kun je schroeven vastdraaien, brieven openen, flessen openen en nog eindeloos veel meer."
                            }
                        ]
                    },
