                            }
                        ]
                    },
                    {
                        "translation_id": "3eef09cd-b3f9-4dd6-bd75-4b4835b84237",
                        "source_entry_id": "a039cc63-700d-3e64-9132-4227384251e5",
                        "source_sense_id": "fe61bc86-c2dd-36db-8a5a-b7a7a456c108",
                        "target_lang_word": "réagir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réagir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d27d37e-8039-3f20-bdb1-b4eaa86fd91b",
                                        "entry_id": "1ce14d28-574e-33d1-bb93-c7652134336f",
                                        "glosses": [
                                            "Agir sur un autre corps dont il a éprouvé l’action, en parlant d'un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ec48ba-be9b-43c4-808d-c16fc4c28394",
                                                "sense_id": "6d27d37e-8039-3f20-bdb1-b4eaa86fd91b",
                                                "text": "Un corps élastique réagit sur le corps qui le frappe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93995e2a-4608-3b34-b7a9-b6f72df3a501",
                                        "entry_id": "1ce14d28-574e-33d1-bb93-c7652134336f",
                                        "glosses": [
                                            "Réaction que les corps en se combinant exercent les uns sur les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "924de0b3-f213-4f55-9cc3-cd5bd12787fe",
                                                "sense_id": "93995e2a-4608-3b34-b7a9-b6f72df3a501",
                                                "text": "Il fit réagir deux corps l’un sur l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3248d58-86fe-39d4-a0a7-44093f774e63",
                                        "entry_id": "1ce14d28-574e-33d1-bb93-c7652134336f",
                                        "glosses": [
                                            "Manifester une action, par l’organisme, à la suite d’une excitation quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a306d10d-5d24-462b-bd5e-c7009ab743de",
                                                "sense_id": "f3248d58-86fe-39d4-a0a7-44093f774e63",
                                                "text": "Comme tout le monde, M. Neisser a fait des injections diagnostiques de tuberculine et comme tout le monde il a constaté que parmi ceux qui réagissaient positivement, bon nombre ne se tuberculosaient pas plus tard."
                                            },
                                            {
                                                "example_id": "85b65ece-61ce-49ae-920e-4e47e7a3a965",
                                                "sense_id": "f3248d58-86fe-39d4-a0a7-44093f774e63",
                                                "text": "Au sein de chaque groupe, tous les participants étaient complices avec l’expérimentateur, sauf un, dénommé le sujet. L'expérience visait à observer comment ce dernier allait réagir au comportement des autres."
                                            },
                                            {
                                                "example_id": "38b1204b-bcae-4ae9-bb6e-8bc8fc7518d6",
                                                "sense_id": "f3248d58-86fe-39d4-a0a7-44093f774e63",
                                                "text": "Les sentiments manifestés par un auditoire réagissent souvent sur l’orateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8a44c7-4ed4-34a6-949b-d444078583d2",
                                        "entry_id": "1ce14d28-574e-33d1-bb93-c7652134336f",
                                        "glosses": [
                                            "Éprouver une émotion à la suite d’une nouvelle, d’un reproche, d’une menace, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b151f303-2a49-4b6e-8006-093e8496c6a9",
                                                "sense_id": "8f8a44c7-4ed4-34a6-949b-d444078583d2",
                                                "text": "Mais tout est redite – les rapports humains ont été explorés, réexplorés, désexplorés, et pourtant nous réagissons toujours au grain de vérité que nous reconnaissons au cœur de ces situations lorsqu’elles nous sont présentées à l’écran."
                                            },
                                            {
                                                "example_id": "e9e5956f-8aca-4011-a51a-afea9fffd329",
                                                "sense_id": "8f8a44c7-4ed4-34a6-949b-d444078583d2",
                                                "text": "Mes parents ont mal réagi quand je leur ai annoncé la nouvelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24045b98-9d7e-388c-b627-448bef891843",
                                        "entry_id": "1ce14d28-574e-33d1-bb93-c7652134336f",
                                        "glosses": [
                                            "Résister à, ne pas se laisser aller à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8e79cb-9430-4309-981b-3ab91d799f30",
                                                "sense_id": "24045b98-9d7e-388c-b627-448bef891843",
                                                "text": "La société existe. Elle veut vivre. Donc elle réagit. Supposez qu’elle ne se défende pas : elle serait en quelques heures la proie d’innombrables fripouilles... Tout s'écroulerait."
                                            },
                                            {
                                                "example_id": "1504b9c7-7933-4a28-ae41-f130473c5893",
                                                "sense_id": "24045b98-9d7e-388c-b627-448bef891843",
                                                "text": "Maintes fois je l'avais surpris dans les vapes derrière son éventaire, laissant les gamins chaparder ses gâteaux sans réagir, sans les chasser à coups de pierres comme il l'aurait fait en temps normal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
