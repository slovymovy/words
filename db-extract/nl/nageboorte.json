                ],
                "senses": [
                    {
                        "sense_id": "d214b885-6fa5-3809-922d-c3446de60a0d",
                        "entry_id": "089ba414-365f-3712-baa8-5aabfae7e00d",
                        "glosses": [
                            "de generatie die later ter wereld is gekomen, het nageslacht"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "95f2b305-693a-4550-8502-ee17911012be",
                                "sense_id": "d214b885-6fa5-3809-922d-c3446de60a0d",
                                "text": "Aengaende de tedere ende wellustige [vrouwe] onder u, die niet versocht en heeft hare voetsole op de aerde te setten, om dat sy haer wellustich ende teder hielde; haer ooge sal quaet zijn tegen den man hares schoots, ende tegen haren sone, ende tegens hare dochter;\n57. Ende dat om hare nageboorte, die van tusschen hare voeten uytgegaen sal zijn, ende om hare sonen, die sy gebaert sal hebben; want sy salse eten in ’t verborgen, vermits gebreck van alles: inde belegeringe, ende inde benauwinge, daer mede uwe vyant u sal benauwen in uwe poorten."
                            }
                        ]
                    },
                    {
                        "sense_id": "af7053e0-7777-3955-b54f-adb38b01ecf8",
                        "entry_id": "089ba414-365f-3712-baa8-5aabfae7e00d",
                        "glosses": [
                            "embryonale vlies, chorion"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5d22a647-0a8c-325d-83ad-b98a57859a62",
                        "entry_id": "089ba414-365f-3712-baa8-5aabfae7e00d",
                        "glosses": [
                            "de moederkoek, navelstreng en vliezen die het lichaam van de moeder verlaten nadat de baby is geboren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa3c4b4-8ded-4045-bb2a-2cc0d4e96dde",
                                "sense_id": "5d22a647-0a8c-325d-83ad-b98a57859a62",
                                "text": "Waarom offeren Nederlanders voor mooi weer worst en Vlamingen eieren? En wat deden boeren zoal met de nageboorte van een paard? De kaartencollectie van het Meertens Instituut laat het zien."
                            },
                            {
                                "example_id": "59e0c8a4-b31b-4cb6-9c55-481061370f91",
                                "sense_id": "5d22a647-0a8c-325d-83ad-b98a57859a62",
                                "text": "In de spetterende regen banjert Ingrid op haar klompen door de plassen op het erf, waar de nageboorte van het nieuwe kalfje nog ligt. Ze schuilt onder een druipend afdakje en tuurt over de glooiende weide. Zo ver je kunt zien, rijkt het boerenland van Johan. \"Mooi hè.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45509c86-f492-46e0-92a7-5817984935d5",
                        "source_entry_id": "089ba414-365f-3712-baa8-5aabfae7e00d",
                        "source_sense_id": "5d22a647-0a8c-325d-83ad-b98a57859a62",
                        "source_sense_description": "de moederkoek, navelstreng en vliezen die het lichaam van de moeder verlaten nadat de baby is geboren",
                        "target_lang_word": "Nachgeburt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachgeburt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50907c6b-a6b3-328b-8a1d-42336f702dad",
                                        "entry_id": "1358d845-6457-3f86-869c-57e12492196d",
                                        "glosses": [
                                            "letzte Phase der Geburt; Ausstoßung der Plazenta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8979c2-f587-41cb-b74c-37e0623f2d8f",
                                                "sense_id": "50907c6b-a6b3-328b-8a1d-42336f702dad",
                                                "text": "Bei der Nachgeburt wird die Plazenta ausgestoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                        "entry_id": "1358d845-6457-3f86-869c-57e12492196d",
                                        "glosses": [
                                            "Ergebnis der letzten Geburtsphase; der Mutterkuchen samt Nabelschnur und Allem, was da noch so mitkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3daca293-e49e-4efe-871f-0fc7a8e5be12",
                                                "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                                "text": "Sie ließ sich ihre Nachgeburt verpacken und nahm sie mit nach Hause."
                                            },
                                            {
                                                "example_id": "e4e6e6a7-a235-4bce-b632-b2c44784bb3e",
                                                "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                                "text": "Die meisten Tiere fressen die Nachgeburt auf."
                                            },
                                            {
                                                "example_id": "b4bc5145-1e46-437a-9cfe-068b708dbd2e",
                                                "sense_id": "464118b5-45be-352b-bcff-c60dc24e395d",
                                                "text": "„Als die Nachgeburt eingegraben worden war, kochte sie ein Beruhigungssüppchen und ließ Väsele Li etwas davon zu sich nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
