                        "form": "den Gewissensbiss"
                    },
                    {
                        "form_id": "1e12d593-e5f6-4759-b292-a0721d41438d",
                        "entry_id": "e69b33b9-967b-3790-957c-f5aa42fd9c97",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gewissensbisse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                        "entry_id": "e69b33b9-967b-3790-957c-f5aa42fd9c97",
                        "glosses": [
                            "Bewusstsein, an etwas Verwerflichem schuld zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "981d2cbb-4002-40e0-9db3-226d56ac5614",
                                "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                                "text": "Sie konnten sich ihrer Gewissensbisse nicht auf Dauer erwehren."
                            },
                            {
                                "example_id": "b0c11f39-cc19-4e51-aa53-c2fcbe9f2460",
                                "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                                "text": "Sie zeigten keinerlei Anzeichen von Gewissensbissen."
                            },
                            {
                                "example_id": "c7a3a282-fd27-430f-8814-894b0308ce2b",
                                "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                                "text": "„Er hatte Gewissensbisse wegen Niko.“"
                            },
                            {
                                "example_id": "10a250eb-ce0c-435a-9103-5af6e30c05e8",
                                "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                                "text": "„Nein, ihn plagten keine Gewissensbisse.“"
                            },
                            {
                                "example_id": "895c1f22-6f52-45f8-b28c-45b4f2681252",
                                "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                                "text": "„Sie hatte den Blick noch immer gesenkt – nicht, weil sie sich schämte, und auch nicht, weil sie Gewissensbisse hatte, sondern aus einer Insichgekehrtheit.“"
                            },
                            {
                                "example_id": "96cb5a7a-9e3c-4f83-99d5-2c063f9062d8",
                                "sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                                "text": "„Aber sie freute sich, dass sich ihr ein Anlass zu tätiger Fürsorge bot, ein Anlass, über dem sie ihren Kummer für eine kleine Weile vergessen konnte, ohne deswegen Gewissensbisse empfinden zu müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "136d14fa-a6fe-44b0-a9ad-6a1770ce7aaa",
                        "source_entry_id": "e69b33b9-967b-3790-957c-f5aa42fd9c97",
                        "source_sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                        "source_sense_description": "Bewusstsein, an etwas Verwerflichem schuld zu sein",
                        "target_lang_word": "pang of conscience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pang of conscience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "434b95f6-dae5-3a77-9fad-c992625af21d",
                                        "entry_id": "ccb8bb80-b0c1-318e-93ae-736aac29541e",
                                        "glosses": [
                                            "A feeling of shame, guilt, or embarrassment, resulting from behavior which one regrets."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e3638f-4dbd-4b63-82af-46bb30fc09ec",
                                                "sense_id": "434b95f6-dae5-3a77-9fad-c992625af21d",
                                                "text": "It was clear to Mr. Seely that Dick Shand's story was 'got up,'—and very well got up. He had no pang of conscience as to using it. But when it came to believing it, that was quite another thing."
                                            },
                                            {
                                                "example_id": "be5c6e1a-332c-4c97-9ffc-75473aa6f9f7",
                                                "sense_id": "434b95f6-dae5-3a77-9fad-c992625af21d",
                                                "text": "So it fell that Mistress Anne could go to London without pangs of conscience at leaving her sister in the country and alone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c709e79e-d40b-427f-a421-16a23bb32e8f",
                        "source_entry_id": "e69b33b9-967b-3790-957c-f5aa42fd9c97",
                        "source_sense_id": "67596f2a-366c-39ab-b4f8-083d06130f68",
                        "source_sense_description": "Bewusstsein, an etwas Verwerflichem schuld zu sein",
                        "target_lang_word": "remords",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remords",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deea3563-c42d-3abd-8234-c577a758afe3",
                                        "entry_id": "2ae596ce-3827-35d5-a8dd-72ab923e88bd",
                                        "glosses": [
                                            "Reproche, tourment, regret sincère provoqué par la conscience d’avoir mal agi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058d0afa-6ab9-4d16-801d-04eea6950226",
                                                "sense_id": "deea3563-c42d-3abd-8234-c577a758afe3",
                                                "text": "Brave et digne femme, pour qui le crime dans lequel était tombé son mari était un remords, et qui, se croyant responsable devant Dieu, comme épouse, passait sa vie en prières et en confession."
                                            },
                                            {
                                                "example_id": "448382ba-03f3-466f-89e3-112e6f0d4daa",
                                                "sense_id": "deea3563-c42d-3abd-8234-c577a758afe3",
                                                "text": "Quiconque a eu un remords à apaiser, un souvenir à évoquer, une douleur à noyer, un château en Espagne à bâtir, tous enfin vous ont invoqué, dieu mystérieux caché dans les fibres de la vigne."
                                            },
                                            {
                                                "example_id": "1f3609eb-d2fb-4498-8f16-5bb453579ae9",
                                                "sense_id": "deea3563-c42d-3abd-8234-c577a758afe3",
                                                "text": "« J’aurais bien pu lui demander le double », méditait-il en changeant de tramway ; mais les remords l’emportaient sur les regrets."
                                            },
                                            {
                                                "example_id": "a95f4212-afac-45c7-9752-4e991e0fd61f",
                                                "sense_id": "deea3563-c42d-3abd-8234-c577a758afe3",
                                                "text": "Les bourreaux doivent savourer la même omnipotence, se livrer à pareille furie, goûter une égale joie de meurtrir sans remords."
                                            },
                                            {
                                                "example_id": "ec45f02c-52b6-4ea3-9b24-de5ba8133602",
                                                "sense_id": "deea3563-c42d-3abd-8234-c577a758afe3",
                                                "text": "Le remords est un poison de l'esprit qui, de surcroît, nous empêche de mobiliser, dans le présent, les forces nécessaires pour changer et pour continuer d'évoluer."
                                            }
                                        ]
                                    }
