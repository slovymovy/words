                "senses": [
                    {
                        "sense_id": "456d65cd-7b64-3c74-afed-f194582ec8f5",
                        "entry_id": "37ccf8b0-ee87-345c-abc7-6eb3661e0599",
                        "glosses": [
                            "poeta dworski tworzący w XI–XIII wieku w południowej Francji, wędrowny poeta i śpiewak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549ad285-7bb0-4eef-9223-87b254ee329f",
                                "sense_id": "456d65cd-7b64-3c74-afed-f194582ec8f5",
                                "text": "Uzdolnieni żonglerzy i ubodzy trubadurzy, szukając zarobku, przyszli do Włoch"
                            },
                            {
                                "example_id": "6df075ed-d549-45dd-a0e4-db4c6d148b74",
                                "sense_id": "456d65cd-7b64-3c74-afed-f194582ec8f5",
                                "text": "Laura — jakby na wspomnienie swéj sławnéj imienniczki — kocha się w dawnych zwyczajach rycerskich: lubi słuchać śpiewu trubadura u nóg swoich"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ab66eb9a-4464-368b-b965-0b054593b0c1",
                        "entry_id": "37ccf8b0-ee87-345c-abc7-6eb3661e0599",
                        "glosses": [
                            "poeta, pieśniarz wędrowny"
                        ],
                        "tags": [
                            "literary",
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58345dd1-d1ef-4292-a06d-d0811e929619",
                        "source_entry_id": "37ccf8b0-ee87-345c-abc7-6eb3661e0599",
                        "source_sense_id": "456d65cd-7b64-3c74-afed-f194582ec8f5",
                        "target_lang_word": "troubadour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troubadour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b275b03-c723-3762-b483-46821a184499",
                                        "entry_id": "e75919fe-c057-3b27-82ba-042dd70434ba",
                                        "glosses": [
                                            "An itinerant composer and performer of songs in medieval Europe; a jongleur or travelling minstrel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ecc923-7af0-491b-b856-f83164481a96",
                                                "sense_id": "9b275b03-c723-3762-b483-46821a184499",
                                                "text": "Sitting in the courtroom ..., their laptops and tablets propped before them, power cables snaking through convoluted adapters, the Twitterati have sight of witnesses at all times – the troubadours, or perhaps the tricoteuses, of the digital revolution."
                                            },
                                            {
                                                "example_id": "04867ce6-bf4f-4b1d-bdda-bc8e8ddf965e",
                                                "sense_id": "9b275b03-c723-3762-b483-46821a184499",
                                                "text": "“\"Not a human, not yet a vampire,\" to paraphrase one of your contemporary musical troubadours.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99f6d698-5668-4c4e-9fb3-d062bf5cec7f",
                        "source_entry_id": "37ccf8b0-ee87-345c-abc7-6eb3661e0599",
                        "source_sense_id": "456d65cd-7b64-3c74-afed-f194582ec8f5",
                        "target_lang_word": "trubadúr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trubadúr",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd20b28-a176-3983-9fc6-db529116e343",
                                        "entry_id": "d87f292f-5793-32af-8058-c6991540b1e8",
                                        "glosses": [
                                            "středověký písničkář"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3c3b51-416e-4ca9-a00c-4e5e46fdc4ab",
                                                "sense_id": "1fd20b28-a176-3983-9fc6-db529116e343",
                                                "text": "Za času krále Dona Jaymesa prvního, z Majorky, byl v Perpiňanu znamenitý trubadúr, který skládal podivuhodné verše."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb52fd78-079d-45ca-8c97-5ab8bac56351",
                        "source_entry_id": "37ccf8b0-ee87-345c-abc7-6eb3661e0599",
                        "source_sense_id": "456d65cd-7b64-3c74-afed-f194582ec8f5",
                        "target_lang_word": "troubadour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troubadour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                        "entry_id": "cc230bc4-eebf-32d1-a088-4943ef0f9fe2",
                                        "glosses": [
                                            "Ancien poète épique et/ou lyrique de langue d’oc."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c052dab-63d9-4826-93fc-acd409f16dd9",
                                                "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                                "text": "Tel que Cédric le Saxon était à trente ans, il n’avait pas besoin de tout ce clinquant du troubadour français pour se recommander aux oreilles de la beauté."
                                            },
                                            {
                                                "example_id": "56e21cd9-98ee-48ce-a169-7334a0244624",
                                                "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                                "text": "Ainsi, la poésie lyrique des troubadours et des trouvères, et surtout la portion de cette poésie qui roule sur les sentimens de galanterie chevaleresque, n’a pas une source latine ; cette poésie est née avec la galanterie chevaleresque elle-même."
                                            },
                                            {
                                                "example_id": "d9a9500f-0161-450b-ad23-914efe93c105",
                                                "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                                "text": "Qu’est-ce que la poésie des troubadours ? L’exaltation de l’amour malheureux."
                                            },
                                            {
                                                "example_id": "48300cd2-e8a0-4f2e-8c43-ff36643bc142",
                                                "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                                "text": "Lire les troubadours, c’est remonter à la source de la poésie, et d’une poésie exigeante. […] Les troubadours sont les poètes à qui l’on doit les plus anciens poèmes intégralement conservés dans une langue européenne moderne"
                                            },
                                            {
                                                "example_id": "2ae3b013-0a37-4202-a6ab-5e8aaa61ad97",
                                                "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                                "text": "Il est à peine croyable qu’une forme poétique aussi élaborée que celle des premiers troubadours n’ait pas eu d’antécédents."
                                            },
                                            {
                                                "example_id": "846a8b5f-9953-4d2e-9fa0-cff84af5ad72",
                                                "sense_id": "7c629539-c850-35be-abc4-eaa36c6e9c8a",
                                                "text": "Appartenant à la grande confrérie des conteurs et chanteurs errants, ce troubadour marocain ne possède pour toute fortune qu’un âne famélique, un vieux haïk en lambeaux, une pipe et une blague à kif et un petit instrument primitif à deux cordes, un gimbri, attribut de son état."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad56faac-f8b0-3d7f-a4fb-1bae446dbf24",
                                        "entry_id": "cc230bc4-eebf-32d1-a088-4943ef0f9fe2",
                                        "glosses": [
                                            "Ellipse de style troubadour."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b88209-3958-4a19-8c16-63538569b139",
                                                "sense_id": "ad56faac-f8b0-3d7f-a4fb-1bae446dbf24",
                                                "text": "À ce moment, il avait ri plus d’une fois de ces leçons, qui lui paraissaient d’un troubadour par trop rococo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10228b9c-c242-3938-98fd-72207bb2cd35",
                                        "entry_id": "cc230bc4-eebf-32d1-a088-4943ef0f9fe2",
                                        "glosses": [
                                            "Personne tentant de séduire par les paroles charmantes, la simplicité et la beauté, mais sans avoir les pieds sur terre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4295ded9-3772-4161-8e39-d0ded858c9cc",
                                                "sense_id": "10228b9c-c242-3938-98fd-72207bb2cd35",
                                                "text": "Au lieu de faire des phrases sentimentales à la jeune fille, et de se poser en troubadour, comme avait fait son ami, il avait su s’attirer l’estime et la confiance du père, ce que l’autre avait sottement négligé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "711bee5a-f116-442d-9fbe-ff07f0a6d1f3",
                        "source_entry_id": "37ccf8b0-ee87-345c-abc7-6eb3661e0599",
