                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "гуде́вши"
                    },
                    {
                        "form_id": "cc51e8a2-e37e-45f7-bb8c-5a21fc5ef84b",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… гуде́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b763be1-4de2-30e4-9f08-825c88ae70f4",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "издавать длительный монотонный звук"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1523e7c2-43f4-437b-8a02-2c86e4b03dfb",
                                "sense_id": "2b763be1-4de2-30e4-9f08-825c88ae70f4",
                                "text": "А пчела, видно, так растерялась, что даже гудеть перестала."
                            }
                        ]
                    },
                    {
                        "sense_id": "97950c36-e551-36c1-a0ee-8cc7c9afd4d5",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "издавать протяжный громкий звук, сигнал"
                        ],
                        "tags": [
                            "о гудке"
                        ],
                        "examples": [
                            {
                                "example_id": "521fa0e8-d4d7-46fe-8ca7-1dc03258f421",
                                "sense_id": "97950c36-e551-36c1-a0ee-8cc7c9afd4d5",
                                "text": "Очень страшно было слушать также о том, как налетают самолёты. Вдруг начинают сразу гудеть все сирены, воют, воют, воют, люди, как крысы, шмыгают сразу в подполье, а те летят волнами ― две, три, Бог знает сколько тысяч, ― гудят, гремят и аккуратно выжигают квартал за кварталом."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5492519-5482-33e1-9e09-d2eba2378ad3",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "подавать звуковой сигнал посредством гудка"
                        ],
                        "tags": [
                            "о пароходе, поезде, автобусе и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "50010bae-2e7b-4cf2-ae25-1bfaa517e562",
                                "sense_id": "a5492519-5482-33e1-9e09-d2eba2378ad3",
                                "text": "Тепловоз и стоя не переставал гудеть, грозя вот-вот тронуться в путь."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d559daa-4778-3d7c-9db6-07cce5c267cb",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "перен., разг. говорить или петь низким голосом и монотонно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9bdeab3-bf16-4e5b-8844-c8cad3b85f08",
                                "sense_id": "5d559daa-4778-3d7c-9db6-07cce5c267cb",
                                "text": "― Живет человек, живет и… в ящик! ― продолжает гудеть актер."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d889460-33b0-39b6-a89e-35b7b9acf49d",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "перен., разг. говорить всем одновременно; шуметь"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c4b2e8f0-16c8-33ec-9bec-a65c4a626ea2",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "неперех., разг. непрерывно ныть, надоедливо жаловаться на что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8f63d104-6f02-3250-b326-37dcfa2b0276",
                        "entry_id": "a48439ad-bcac-3a99-94ad-c3ce2a904505",
                        "glosses": [
                            "перен. разг. праздновать, отмечать что-либо шумно, пировать"
                        ],
                        "tags": [],
                        "examples": []
                    }
