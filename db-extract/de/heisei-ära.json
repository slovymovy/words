                "senses": [
                    {
                        "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                        "entry_id": "9bd22630-0f72-3cab-a723-227282307040",
                        "glosses": [
                            "in der japanischen Zeitraum Zeitrechnung vom 8. Januar 1989 bis zum 30. April 2019, in welcher der Kaiser Akihito regierte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b12279b-2aee-4d5e-9340-5c92ffc44b1c",
                                "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                                "text": "„Fast täglich fragen sich aber Zeitungen, welcher Name der heutigen Zeit besonders gut zu Gesicht stünde, sobald die Heisei-Ära endet.“"
                            },
                            {
                                "example_id": "141708cb-78c3-42e1-8124-0ad2bacc3da9",
                                "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                                "text": "„Während der Heisei-Ära sei Japan von vielen Naturkatastrophen heimgesucht worden.“"
                            },
                            {
                                "example_id": "efe3d0b1-7698-4f67-831a-6763abb35e7b",
                                "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                                "text": "„Noch heute wird die Jahreszahl in Japan nach der abgelaufenen Amtszeit des Kaisers bestimmt: Gestern begann das Jahr 7 der Heisei-Ära von Tenno Akihito.“"
                            },
                            {
                                "example_id": "e52642fe-fa67-4c69-a6ba-00c4932d18f4",
                                "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                                "text": "„Während der Heisei-Ära sei Japan von vielen Naturkatastrophen heimgesucht worden.“"
                            },
                            {
                                "example_id": "9a79f3c0-db5d-49f2-b251-f8ee00d458c2",
                                "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                                "text": "„Die Heisei-Ära von Kaiser Akihito endete nach 30 Jahren offiziell am 30.“"
                            },
                            {
                                "example_id": "0a39351f-10da-4959-80c3-999bb0c28a10",
                                "sense_id": "e34e8241-e545-3d2e-b9c5-e3295ea6fde7",
                                "text": "„Der Beginn der Heisei-Ära 1989 war in Japan von dem Ende der «Bubble-Economy» geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
