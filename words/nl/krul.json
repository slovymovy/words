                    "sense_id": "ba8aa826-41e5-3615-8ea4-df6ee6c354c3",
                    "sense_definition": "een lok haar die een spiraalvorm of gebogen vorm heeft",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft prachtige natuurlijke <w>krullen</w> in haar haar.",
                            "target_lang_translations": {
                                "en": "She has beautiful natural <w>curls</w> in her hair."
                            }
                        },
                        {
                            "text": "Het meisje had kleine <w>krulletjes</w> en grote intense ogen.",
                            "target_lang_translations": {
                                "en": "The girl had small <w>ringlets</w> and large intense eyes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bos krullen",
                        "natuurlijke krul"
                    ],
                    "target_lang_definitions": {
                        "en": "a lock of hair that has a spiral or curved shape"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "curl",
                                "target_lang_sense_clarification": "a ringlet of hair"
                            },
