                                "nl": "Ze sprak <w>bits</w> tegen de ober omdat de bediening erg traag was.",
                                "pl": "Odezwała się do kelnera <w>szorstko</w>, ponieważ obsługa była bardzo powolna.",
                                "de": "Sie sprach <w>kurz angebunden</w> mit dem Kellner, weil der Service sehr langsam war.",
                                "fr": "Elle a parlé <w>brusquement</w> au serveur car le service était très lent.",
                                "it": "Ha parlato in modo <w>secco</w> al cameriere perché il servizio era molto lento.",
                                "cs": "Na číšníka mluvila <w>odměřeně</w>, protože obsluha byla velmi pomalá.",
                                "tr": "Hizmet çok yavaş olduğu için garsonla <w>ters bir şekilde</w> konuştu.",
                                "es": "Le habló <w>de forma brusca</w> al camarero porque el servicio era muy lento."
                            }
                        }
