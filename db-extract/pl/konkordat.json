                    },
                    {
                        "translation_id": "10f54085-ea3a-450e-a71c-04d27fd04d90",
                        "source_entry_id": "a1bc3108-8756-3572-b548-cc157810d251",
                        "source_sense_id": "dbf47f51-31db-38a5-92ad-401fe8a799a2",
                        "target_lang_word": "Konkordat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konkordat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcc781b3-1de0-3188-b097-fed47adcbbec",
                                        "entry_id": "7fe2ac2f-6ab6-3d0f-979c-1ffbae4ee02c",
                                        "glosses": [
                                            "Vertrag zwischen der Regierung eines Staates und dem Vatikan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bed3ea8-cf69-41b7-a183-7cde629daa4f",
                                                "sense_id": "fcc781b3-1de0-3188-b097-fed47adcbbec",
                                                "text": "„Sein Hang zur Zentralisierung und zur Festigung der Kontrolle der vatikanischen Bürokratie über die nationalen Kirchen veranlaßte ihn dazu, ein Konkordat mit Deutschland anzustreben, selbst wenn er dabei die katholische Zentrumspartei opfern mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53a71e9a-abe4-3c04-ac5b-be4fbe8fa0cb",
                                        "entry_id": "7fe2ac2f-6ab6-3d0f-979c-1ffbae4ee02c",
                                        "glosses": [
                                            "Vertrag zwischen Kantonen in der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "752be204-c94e-41c4-8825-adc107937a59",
                                                "sense_id": "53a71e9a-abe4-3c04-ac5b-be4fbe8fa0cb",
                                                "text": "Hürlimann hoffte, dass möglichst schnell möglichst viele Kantone dem Konkordat beitreten würden, damit es rasch in Kraft treten könne (das Konkordat sah für das Inkrafttreten ein Quorum von 10 Kantonen vor)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
