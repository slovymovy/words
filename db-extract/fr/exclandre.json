                    },
                    {
                        "translation_id": "49be7fcb-1988-43bb-9af8-c2200ec8eccc",
                        "source_entry_id": "03ea8896-2097-3626-9244-856d4c7e3066",
                        "source_sense_id": "32ea7748-ec57-3fd3-9deb-671d35932104",
                        "target_lang_word": "tumult",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumult",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                                        "entry_id": "b4e90740-13c3-35d4-83da-1fdbc69a44f0",
                                        "glosses": [
                                            "lawaai en onrust in een groep van mensen, soms overgaand in oproer en opstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "965e08f3-8bff-4b55-b4ce-f3f6d406980c",
                                                "sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                                                "text": "Maar daar is seizoen twee al, dat de Suezcrisis biedt, de moord op Kennedy en het Profumo-schandaal. In het midden van dat tumult loopt Elizabeth II, die geen politieke standpunten mag innemen en geen schandaal mag veroorzaken in haar privéleven. Claire Foy moet het allemaal acteren met haar onberispelijk gestifte lippen."
                                            },
                                            {
                                                "example_id": "b9315a1b-19c5-4daa-bd94-891310ced985",
                                                "sense_id": "94b2f220-877d-3198-9128-e1a87c59d0d7",
                                                "text": "Tumult aan de Meijersweg in Geesteren, enkele jaren geleden. In een voormalige boerderij met plek voor twee huishoudens is in een van de twee woongedeelten een extra ruimte om te wonen gecreëerd voor de zoon van de bewoners en zijn gezin. En dat is tegen het zere been van de bewoners aan de andere kant van het huis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7afb472-9137-454f-a5d7-fe0e5913ee0b",
                        "source_entry_id": "03ea8896-2097-3626-9244-856d4c7e3066",
                        "source_sense_id": "32ea7748-ec57-3fd3-9deb-671d35932104",
                        "target_lang_word": "uitbarsting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitbarsting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7c5193be-74c5-3b2f-b726-47aa86e2aa08",
                                        "entry_id": "5afa04ea-c50a-38eb-b294-510f3c7bba64",
                                        "glosses": [
                                            "een plotselinge en felle uiting van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db8195e-7e39-483a-b6c0-e7d3614c1f0b",
                                                "sense_id": "7c5193be-74c5-3b2f-b726-47aa86e2aa08",
                                                "text": "Een uitbarsting was te verwachten, hij werd door iedereen gepest."
                                            },
                                            {
                                                "example_id": "9b0c27ea-203f-4d9e-ad71-9058ce89cad0",
                                                "sense_id": "7c5193be-74c5-3b2f-b726-47aa86e2aa08",
                                                "text": "Ik kan niet alles letterlijk reproduceren en ik moet toegeven dat ik ook niet alles verstond, omdat ik niet was voorbereid op deze uitbarsting van Franse poëzie, maar ik verstond genoeg om te begrijpen dat het ging om een feministische visie op drie verlaten vrouwen uit de mythologie, Nausica, Medea en Dido, die volgens mij werden samengesmolten tot één modern personage in de gedaante van een zwerfster in de metro van Parijs, maar voor het laatste deel van deze interpretatie moet ik gezien de particuliere metaforiek een slag om de arm houden."
                                            },
                                            {
                                                "example_id": "b0b0174b-b777-4419-954b-0f4c030c5e62",
                                                "sense_id": "7c5193be-74c5-3b2f-b726-47aa86e2aa08",
                                                "text": "'Dat was een vreemde uitbarsting,'zei vaandrig Karl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab3b104-5386-344c-a648-761ce5673b53",
                                        "entry_id": "5afa04ea-c50a-38eb-b294-510f3c7bba64",
                                        "glosses": [
                                            "het uitstoten van gassen, rook en lava door een vulkaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40666038-aab2-4bd6-a131-b178efe105aa",
                                                "sense_id": "eab3b104-5386-344c-a648-761ce5673b53",
                                                "text": "De uitbarsting van de vulkaan op IJsland was niet voorzien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
