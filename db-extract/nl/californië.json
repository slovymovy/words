                                                "example_id": "6fbba813-91fc-4722-b1fe-50f1a44f9e45",
                                                "sense_id": "588c35a8-9a49-393c-b287-d467adf728c7",
                                                "text": "Sacramento ist die Hauptstadt von Kalifornien."
                                            },
                                            {
                                                "example_id": "d004b649-a94f-4792-8800-3aaf6dab4c26",
                                                "sense_id": "588c35a8-9a49-393c-b287-d467adf728c7",
                                                "text": "Seit 1962 ist Kalifornien der bevölkerungsreichste US-Bundesstaat, heute hat er schon doppelt so viele Einwohner wie New York, welcher bis dahin der bevölkerungsreichste war."
                                            },
                                            {
                                                "example_id": "13c30cd2-e3e6-496d-abed-824f00d3d992",
                                                "sense_id": "588c35a8-9a49-393c-b287-d467adf728c7",
                                                "text": "„Drei Teilnehmer der Lotterie Powerball aus den US-Bundesstaaten Kalifornien, Florida und Tennessee teilen sich den Hauptgewinn von insgesamt knapp 1,6 Milliarden Dollar (1,47 Milliarden Euro), wie die Lotteriegesellschaft am Donnerstag mitteilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
