{
    "word_family": [
        "gather",
        "gatherer",
        "ingathering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38bca339-6ddc-3f94-8a59-bb2470b4e241",
                    "sense_definition": "Present participle and gerund of <w>gather</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are <w>gathering</w> stones by the river.",
                            "target_lang_translations": {
                                "ru": "Дети <w>собирают</w> камни у реки.",
                                "de": "Die Kinder <w>sammeln</w> Steine am Fluss."
                            }
                        },
                        {
                            "text": "She is currently <w>gathering</w> information for her report.",
                            "target_lang_translations": {
                                "ru": "В данный момент она <w>собирает</w> информацию для своего отчета.",
                                "de": "Sie <w>sammelt</w> derzeit Informationen für ihren Bericht."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола gather (собирать).",
                        "de": "Partizip Präsens und Gerundium von 'sammeln'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "действие по значению гл. собирать"
                            },
                            {
                                "target_lang_word": "собирание",
                                "target_lang_sense_clarification": "процесс сбора"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sammelnd",
                                "target_lang_sense_clarification": "Partizip Präsens, das eine laufende Tätigkeit beschreibt"
                            },
                            {
                                "target_lang_word": "das Sammeln",
                                "target_lang_sense_clarification": "Gerundium, das den Prozess des Zusammenbringens bezeichnet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4b57893-5ed3-3e5e-98e4-27270a19454b",
                    "sense_definition": "A meeting or social event where people come together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We organized a small family <w>gathering</w> for the holidays.",
                            "target_lang_translations": {
                                "ru": "Мы организовали небольшую семейную <w>встречу</w> на праздники.",
                                "de": "Wir haben eine kleine familiäre <w>Zusammenkunft</w> für die Feiertage organisiert."
                            }
                        },
                        {
                            "text": "The annual <w>gathering</w> of scientists attracted people from all over the world.",
                            "target_lang_translations": {
                                "ru": "Ежегодное <w>собрание</w> ученых привлекло людей со всего мира.",
                                "de": "Die jährliche <w>Versammlung</w> von Wissenschaftlern zog Menschen aus der ganzen Welt an."
                            }
                        }
                    ],
                    "synonyms": [
                        "assemblage",
                        "meeting",
                        "get-together"
                    ],
                    "common_phrases": [
                        "family gathering",
                        "social gathering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встреча или общественное мероприятие, на котором люди собираются вместе.",
                        "de": "Ein Treffen oder gesellschaftliches Ereignis, bei dem Menschen zusammenkommen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "собрание друзей, родственников или знакомых"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "мероприятие с участием группы людей"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "совместное пребывание группы людей (трупы, команды)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zusammenkunft",
                                "target_lang_sense_clarification": "allgemeiner Begriff für ein Treffen von Menschen"
                            },
                            {
                                "target_lang_word": "Versammlung",
                                "target_lang_sense_clarification": "formelleres Treffen zu einem bestimmten Zweck"
                            },
                            {
                                "target_lang_word": "Treffen",
                                "target_lang_sense_clarification": "informelle Zusammenkunft von Personen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3485aa17-8560-368b-bfd1-69ffdd8c4a07",
                    "sense_definition": "A group of people or things collected in one place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A large <w>gathering</w> of protesters stood outside the city hall.",
                            "target_lang_translations": {
                                "ru": "У мэрии стояло большое <w>сборище</w> протестующих.",
                                "de": "Eine große <w>Ansammlung</w> von Demonstranten stand vor dem Rathaus."
                            }
                        },
                        {
                            "text": "He addressed the <w>gathering</w> with a passionate speech about climate change.",
                            "target_lang_translations": {
                                "ru": "Он обратился к <w>собранию</w> со страстной речью об изменении климата.",
                                "de": "Er richtete eine leidenschaftliche Rede über den Klimawandel an die <w>Versammlung</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "assemblage"
                    ],
                    "common_phrases": [
                        "gathering of people",
                        "small gathering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей или предметов, собранных в одном месте.",
                        "de": "Eine Gruppe von Menschen oder Dingen, die sich an einem Ort befinden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "присутствующие люди, участники заседания"
                            },
                            {
                                "target_lang_word": "сборище",
                                "target_lang_sense_clarification": "скопление людей (часто с негативным оттенком)"
                            },
                            {
                                "target_lang_word": "скопление",
                                "target_lang_sense_clarification": "множество людей или предметов в одном месте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ansammlung",
                                "target_lang_sense_clarification": "eine Menge von Personen oder Objekten an einem Ort"
                            },
                            {
                                "target_lang_word": "Gruppe",
                                "target_lang_sense_clarification": "eine Anzahl von Menschen oder Dingen, die zusammengehören"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "765ae639-11f8-3710-8f40-331809c762cd",
                    "sense_definition": "The activity of collecting plants, food, or objects, especially from nature.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early human societies relied on hunting and <w>gathering</w> to survive.",
                            "target_lang_translations": {
                                "ru": "Ранние человеческие общества полагались на охоту и <w>собирательство</w> для выживания.",
                                "de": "Frühe menschliche Gesellschaften waren zum Überleben auf Jagd und <w>Sammeln</w> angewiesen."
                            }
                        },
                        {
                            "text": "The <w>gathering</w> of wild mushrooms requires knowledge and caution.",
                            "target_lang_translations": {
                                "ru": "<w>Сбор</w> диких грибов требует знаний и осторожности.",
                                "de": "Das <w>Sammeln</w> von Wildpilzen erfordert Wissen und Vorsicht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hunting and gathering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по сбору растений, еды или предметов, особенно в природе.",
                        "de": "Die Tätigkeit des Sammelns von Pflanzen, Nahrung oder Objekten, besonders in der Natur."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "заготовка грибов, ягод, урожая"
                            },
                            {
                                "target_lang_word": "собирательство",
                                "target_lang_sense_clarification": "форма хозяйственной деятельности (охота и собирательство)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sammeln",
                                "target_lang_sense_clarification": "allgemeine Tätigkeit des Zusammenbringens von Naturprodukten"
                            },
                            {
                                "target_lang_word": "Sammlertum",
                                "target_lang_sense_clarification": "historische oder soziologische Bezeichnung für die Lebensweise"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06022965-1229-3432-b7fd-9f8743bf20a2",
                    "sense_definition": "A section of a book consisting of sheets of paper folded together.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bookbinder carefully stitched each <w>gathering</w> to the spine.",
                            "target_lang_translations": {
                                "ru": "Переплетчик аккуратно пришил каждую <w>тетрадь</w> к корешку.",
                                "de": "Der Buchbinder nähte jede <w>Lage</w> sorgfältig an den Buchrücken."
                            }
                        },
                        {
                            "text": "If a <w>gathering</w> is loose, the pages of the book may fall out.",
                            "target_lang_translations": {
                                "ru": "Если <w>тетрадь</w> закреплена слабо, страницы книги могут выпасть.",
                                "de": "Wenn eine <w>Lage</w> locker ist, können die Seiten des Buches herausfallen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть книги, состоящая из сложенных вместе листов бумаги.",
                        "de": "Ein Teil eines Buches, der aus zusammengefalteten Papierbögen besteht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тетрадь",
                                "target_lang_sense_clarification": "сфальцованные листы для книжного блока"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lage",
                                "target_lang_sense_clarification": "fachsprachlicher Begriff für eine gefaltete Bogenlage im Buchdruck"
                            },
                            {
                                "target_lang_word": "Buchlage",
                                "target_lang_sense_clarification": "spezifisch für die zusammengefügten Blätter eines Buches"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41b9fbcd-7318-353c-ad01-78cf6db60569",
                    "sense_definition": "A pus-filled swelling or abscess on the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor treated the painful <w>gathering</w> on the patient's neck.",
                            "target_lang_translations": {
                                "ru": "Врач обработал болезненный <w>нарыв</w> на шее пациента.",
                                "de": "Der Arzt behandelte den schmerzhaften <w>Abszess</w> am Hals des Patienten."
                            }
                        },
                        {
                            "text": "She applied a warm compress to help the <w>gathering</w> heal.",
                            "target_lang_translations": {
                                "ru": "Она приложила теплый компресс, чтобы <w>нарыв</w> зажил.",
                                "de": "Sie legte eine warme Kompresse auf, damit der <w>Abszess</w> abheilen konnte."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполненная гноем припухлость или абсцесс на теле.",
                        "de": "Eine mit Eiter gefüllte Schwellung oder ein Abszess am Körper."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарыв",
                                "target_lang_sense_clarification": "гнойное воспаление"
                            },
                            {
                                "target_lang_word": "гнойник",
                                "target_lang_sense_clarification": "абсцесс"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Abszess",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für eine Eiteransammlung"
                            },
                            {
                                "target_lang_word": "Eiterbeule",
                                "target_lang_sense_clarification": "umgangssprachliche Bezeichnung für eine eitrige Schwellung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6361e98-ba25-3540-b0c1-00b930ec41ab",
                    "sense_definition": "That is coming together, accumulating, or increasing in force.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked up at the <w>gathering</w> stormclouds with concern.",
                            "target_lang_translations": {
                                "ru": "Она с беспокойством посмотрела на <w>сгущающиеся</w> грозовые тучи.",
                                "de": "Sie blickte besorgt zu den <w>aufziehenden</w> Gewitterwolken hinauf."
                            }
                        },
                        {
                            "text": "There was a <w>gathering</w> sense of excitement as the concert began.",
                            "target_lang_translations": {
                                "ru": "Когда концерт начался, возникло <w>нарастающее</w> чувство волнения.",
                                "de": "Es herrschte eine <w>zunehmende</w> Aufregung, als das Konzert begann."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gathering storm",
                        "gathering darkness"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что собирается вместе, накапливается или усиливается.",
                        "de": "Etwas, das zusammenkommt, sich ansammelt oder an Kraft zunimmt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгущающийся",
                                "target_lang_sense_clarification": "о тучах, темноте или атмосфере"
                            },
                            {
                                "target_lang_word": "нарастающий",
                                "target_lang_sense_clarification": "об эмоциях, силе или звуке"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufziehend",
                                "target_lang_sense_clarification": "besonders bei Wetterphänomenen wie Stürmen"
                            },
                            {
                                "target_lang_word": "sich zusammenbrauend",
                                "target_lang_sense_clarification": "bildlich für drohende Ereignisse oder Wetter"
                            },
                            {
                                "target_lang_word": "zunehmend",
                                "target_lang_sense_clarification": "allgemein für das Anwachsen von Gefühlen oder Intensität"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}