                                "target_senses": [
                                    {
                                        "sense_id": "3ddaf762-f8a8-3431-8fb2-824b0ebb142f",
                                        "entry_id": "392c9376-f605-3eb6-bc9f-43ad392119f5",
                                        "glosses": [
                                            "A collage created by a designer to convey a concept or theme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785b490c-9209-468b-9947-b5273587103c",
                                                "sense_id": "3ddaf762-f8a8-3431-8fb2-824b0ebb142f",
                                                "text": "Her latterday output has stuttered somewhat, but for Madame X the stars have aligned with Madonna’s Pinterest mood board once again. There are hot climates and a piratical eye-patch; shape-shifting to the sounds of the Portuguese diaspora, trap-pop and reggeaton^([sic])."
                                            },
                                            {
                                                "example_id": "56ca5683-252d-4c4a-be29-3f3c7563216b",
                                                "sense_id": "3ddaf762-f8a8-3431-8fb2-824b0ebb142f",
                                                "text": "Look, these niggas be my sons. Without me, they'd be done / Where the fuck would you get all your mood board pictures from?"
                                            },
                                            {
                                                "example_id": "de8ff9df-c2a6-4ec1-befe-85a45da809a7",
                                                "sense_id": "3ddaf762-f8a8-3431-8fb2-824b0ebb142f",
                                                "text": "As if answering our prayers, her [Sabrina Carpenter's] team just posted an official mood board for Short n' Sweet Tour outfits. The vibe? Pastel colors, platform shoes, babydoll dresses, sparkles, and heart and kiss motifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
