                ],
                "senses": [
                    {
                        "sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                        "entry_id": "b6588fe9-7be2-35a1-9850-db7f611d919e",
                        "glosses": [
                            "Religion, die auf der Welt weit verbreitet ist und eine große Anhängerschaft aufweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c438d2-abc2-4ec8-8fdd-0fcc1808e40f",
                                "sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                                "text": "„Der Buddhismus gilt als friedfertig und undogmatisch, stressreduzierend und persönlichkeitsstabilisierend – kurzum: als ideale Religion postmoderner Individualisten. Das mag die westliche Faszination für die viertgrößte Weltreligion erklären.“"
                            },
                            {
                                "example_id": "8621037e-a04e-4b91-aeb6-18f94b006d12",
                                "sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                                "text": "„Nicht weit von uns erhebt sich der Tempelberg, jene Hochfläche vom Ausmaß von 19 Fußballfeldern, auf die sich der Eifer zweier Weltreligionen fokussiert: Judentum und Islam.“"
                            },
                            {
                                "example_id": "afd513b4-8885-4766-82eb-c02c4dad2a7a",
                                "sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                                "text": "„Auf seinen vielen Missionsreisen durch die gesamte griechisch-römische Welt machte er das Christentum zu einer Weltreligion.“"
                            },
                            {
                                "example_id": "c0b044f3-fe8d-4cf2-92ef-957ee96dd5d3",
                                "sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                                "text": "„Meine Eltern kannten sich mit den Weltreligionen nicht aus, aber sie waren nicht ungläubig, im Gegenteil, sie glaubten an alles.“"
                            },
                            {
                                "example_id": "8543ceb5-8264-4864-8f02-d0fc253e75e5",
                                "sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                                "text": "„Dennoch priesen es die großen Weltreligionen seit Menschengedenken als segensreich, die Fleischeslust abzutöten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7af127b-7040-4777-a43a-723975fa14d9",
                        "source_entry_id": "b6588fe9-7be2-35a1-9850-db7f611d919e",
                        "source_sense_id": "0efae0c6-8dd7-3e60-846c-5c2388175fb8",
                        "source_sense_description": "Religion: Religion, die auf der Welt weit verbreitet ist und eine große Anhängerschaft aufweist",
                        "target_lang_word": "world religion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "world religion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6424019e-c96a-302f-956f-1d5f9fa84c06",
                                        "entry_id": "89eff2a8-1be9-338a-b4df-8d28470a7d22",
                                        "glosses": [
                                            "An internationally widespread religious belief system which has become generally recognized as having independent status from any other religion, but which nonetheless may have many, sometimes mutually antagonistic, sects or denominations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34bf6c3-c9c6-48a5-b8ce-63f8367e6245",
                                                "sense_id": "6424019e-c96a-302f-956f-1d5f9fa84c06",
                                                "text": "Christianity is a world religion consisting of Roman Catholics, Eastern Orthodoxy, and Protestants."
                                            },
                                            {
                                                "example_id": "31a96277-55de-41f5-b9d2-67a91e3d0ed7",
                                                "sense_id": "6424019e-c96a-302f-956f-1d5f9fa84c06",
                                                "text": "It is seen that religious evolution through the ages has been practically One thing - that there has been in fact a World-religion, though with various phases and branches."
                                            },
                                            {
                                                "example_id": "331621b6-2f1e-433e-8976-b3f824129d8d",
                                                "sense_id": "6424019e-c96a-302f-956f-1d5f9fa84c06",
                                                "text": "While vast barriers may seem to stretch between a local, single-focus contention of pseudoscience and something like a world religion, the partitions are very thin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
