{
    "word_family": [
        "maladie",
        "maladif",
        "maladivement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "680bd832-32f5-39d7-976f-738ade267cf0",
                    "sense_definition": "Dont la santé est altérée ; qui souffre d'une maladie ou ne se sent pas bien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "maladie_sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est si <w>malade</w> qu'elle ne peut pas venir au travail aujourd'hui."
                        },
                        {
                            "text": "Mon fils est tombé <w>malade</w> la veille de notre départ en vacances."
                        },
                        {
                            "text": "Les enfants <w>malades</w> doivent rester à la maison pour se reposer."
                        }
                    ],
                    "synonyms": [
                        "souffrant"
                    ],
                    "antonyms": [
                        "bien portant",
                        "sain"
                    ],
                    "common_phrases": [
                        "tomber malade",
                        "gravement malade",
                        "se sentir malade",
                        "malade comme un chien"
                    ]
                },
                {
                    "sense_id": "47cd357a-5570-385a-884c-856c3715e0e4",
                    "sense_definition": "Se dit d'une chose, d'une partie du corps ou d'un être vivant dont l'état est altéré par une maladie ou un mal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "maladie_sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne touchez pas son bras <w>malade</w>, car il a encore très mal."
                        },
                        {
                            "text": "Ces plantes sont <w>malades</w> : leurs feuilles jaunissent et tombent."
                        },
                        {
                            "text": "Le médecin soigne le genou <w>malade</w> de ce joueur de football."
                        }
                    ],
                    "antonyms": [
                        "sain"
                    ],
                    "common_phrases": [
                        "bras malade",
                        "arbre malade",
                        "organe malade"
                    ]
                },
                {
                    "sense_id": "5984146c-839e-3b12-97d6-c5946f6744d8",
                    "sense_definition": "Fou, dérangé ; qui a un comportement jugé anormal ou insensé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "folie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mais il est <w>malade</w>, ce type ! Il a traversé l'autoroute à pied."
                        },
                        {
                            "text": "Tu es complètement <w>malade</w> de conduire aussi vite sous la pluie !"
                        }
                    ],
                    "synonyms": [
                        "fou",
                        "taré",
                        "cinglé"
                    ],
                    "common_phrases": [
                        "complètement malade",
                        "malade mental"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi familier."
                        }
                    ]
                },
                {
                    "sense_id": "4dc40b0e-ea5e-31a1-8b7c-c0948153800a",
                    "sense_definition": "Génial, excellent, qui sort de l'ordinaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis allé voir un concert hier, c'était <w>malade</w> !"
                        },
                        {
                            "text": "Hein, c'est <w>malade</w> comme idée, il faut absolument qu'on le fasse un jour."
                        }
                    ],
                    "common_phrases": [
                        "c'est malade"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Argot, surtout employé par les jeunes."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bb25dcd-4440-327e-9be4-d65c1edd878e",
                    "sense_definition": "Personne en mauvaise santé, qui souffre d'une maladie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "personne_malade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>malade</w> doit rester au lit et boire beaucoup d'eau."
                        },
                        {
                            "text": "Les <w>malades</w> attendent dans le couloir de l'hôpital depuis ce matin."
                        },
                        {
                            "text": "Cette infirmière s'occupe très bien des <w>malades</w> de son service."
                        }
                    ],
                    "common_phrases": [
                        "un grand malade",
                        "visiter un malade",
                        "les malades et les blessés"
                    ]
                },
                {
                    "sense_id": "622f4568-081a-337c-9ce9-b97031ec3dbd",
                    "sense_definition": "Personne qui fait l'objet des soins d'un médecin ou d'un établissement de santé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_malade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin explique le traitement au <w>malade</w> et à sa famille."
                        },
                        {
                            "text": "Pour ces cinq cents <w>malades</w>, il n'y a qu'un seul médecin."
                        },
                        {
                            "text": "La façon dont le <w>malade</w> apprend son diagnostic est très variable."
                        }
                    ],
                    "synonyms": [
                        "patient"
                    ],
                    "common_phrases": [
                        "soigner un malade",
                        "dossier du malade",
                        "prise en charge du malade"
                    ]
                },
                {
                    "sense_id": "96fb5749-cdb4-3298-96ea-23d320165ddb",
                    "sense_definition": "Personne considérée comme dangereuse ou folle à cause de son comportement dérangé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "folie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce type me fait peur : c'est un <w>malade</w>, il faut appeler la police."
                        },
                        {
                            "text": "Un <w>malade</w> a menacé les passants avec un couteau devant la gare."
                        }
                    ],
                    "synonyms": [
                        "fou"
                    ],
                    "common_phrases": [
                        "un malade mental",
                        "c'est un malade"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi familier et souvent péjoratif."
                        }
                    ]
                },
                {
                    "sense_id": "bdf0e5bc-9c2f-3f22-b684-5c87d3aad71f",
                    "sense_definition": "Personne passionnée à l'extrême par une activité ou un domaine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un <w>malade</w> de cinéma : il voit trois films par jour."
                        },
                        {
                            "text": "Mon frère est un <w>malade</w> de vélo, il roule même sous la pluie."
                        }
                    ],
                    "common_phrases": [
                        "un malade de cinéma",
                        "un malade de foot"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi familier."
                        }
                    ]
                },
                {
                    "sense_id": "ac2dee8c-01ed-3109-b477-7d35fec5b84b",
                    "sense_definition": "Personne au comportement extraordinaire ou excessif ; par extension, dans « un truc de malade », chose hors du commun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son élection à la tête du club était considérée comme un truc de <w>malade</w>."
                        },
                        {
                            "text": "Ce skateur est un <w>malade</w> : il saute des escaliers de dix marches."
                        }
                    ],
                    "common_phrases": [
                        "un truc de malade"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Langage très familier."
                        }
                    ]
                },
                {
                    "sense_id": "efed6845-452b-379f-899c-d0b16fb1b983",
                    "sense_definition": "Dans le droit de la guerre, combattant qui ne participe plus aux hostilités à cause d'une maladie et qui est protégé s'il dépose les armes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personne_malade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le droit international humanitaire protège le <w>malade</w> qui a déposé les armes."
                        },
                        {
                            "text": "Les <w>malades</w> ne sont plus des cibles légitimes pendant un conflit armé."
                        }
                    ],
                    "common_phrases": [
                        "protection des malades"
                    ]
                }
            ]
        }
    ]
}