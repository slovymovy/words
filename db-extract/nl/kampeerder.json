                                "example_id": "3af75cea-43e5-4fee-bafd-17f0d0548262",
                                "sense_id": "be5cb485-4c38-34bd-98a3-e503a2e571e5",
                                "text": "Het noodweer heeft de kampeerders zwaar getroffen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e48ddce-dc7c-429b-a86a-aad22a5fc067",
                        "source_entry_id": "26c6c2c3-3f57-3857-a284-486e800e95f6",
                        "source_sense_id": "be5cb485-4c38-34bd-98a3-e503a2e571e5",
                        "source_sense_description": "iemand die, gewoonlijk tijdens de vakantie, in een tent bivakkeert",
                        "target_lang_word": "Camper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Camper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a28fc227-d982-3e2d-be77-a70406a73ee1",
                                        "entry_id": "199b9881-f9f3-3433-914f-c9e283717e66",
                                        "glosses": [
                                            "Person, die für eine gewisse Zeit in einem Zelt oder Wohnmobil/Wohnwagen zu Erholungszwecken lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4dac382-6eb4-4245-aa4f-54179d1f7e0a",
                                                "sense_id": "a28fc227-d982-3e2d-be77-a70406a73ee1",
                                                "text": "„Ein Lkw bahnt sich seinen Weg über das Gelände – drei Achsen, hoch wie ein Haus, quietschgelb lackiert und mit dröhnendem Motor. Doch die Camper, die ringsum mit ihren Kaffeetassen in der Spätsommersonne sitzen, lassen sich nicht aus der Ruhe bringen.“"
                                            },
                                            {
                                                "example_id": "2f542ff3-932b-4ee0-ac05-0a73e589c8f1",
                                                "sense_id": "a28fc227-d982-3e2d-be77-a70406a73ee1",
                                                "text": "„Dann aber wurde es draußen immer klarer und heller, und so haben wir uns von den Campern verabschiedet und sind wieder auf die Fahrräder gestiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6baa7e60-27fc-3115-89af-16b0fe73ec67",
                                        "entry_id": "199b9881-f9f3-3433-914f-c9e283717e66",
                                        "glosses": [
                                            "Person, die in Computerspielen dauerhaft in schwer einsehbaren Bereichen der Spielumgebung verharrt, um die Spielfiguren vorbeikommender Mitspieler auszuschalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b64dfdd-729d-457a-9d89-98e62e4d56ee",
                                                "sense_id": "6baa7e60-27fc-3115-89af-16b0fe73ec67",
                                                "text": "Mein Freund ist ein richtiger Camper."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f2c5b2f-ab51-4565-a9ec-1265ca87f22c",
                        "source_entry_id": "26c6c2c3-3f57-3857-a284-486e800e95f6",
                        "source_sense_id": "be5cb485-4c38-34bd-98a3-e503a2e571e5",
                        "source_sense_description": "iemand die, gewoonlijk tijdens de vakantie, in een tent bivakkeert",
                        "target_lang_word": "camper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A person who camps, especially in a tent etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f7165d-1b31-484a-b114-023d48849205",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "There were thousands of campers at the music festival."
                                            },
                                            {
                                                "example_id": "2732ca6e-fe17-40a5-891e-42396f130516",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "They're indispensable for backpackers, campers and anyone else who plans to be away from a power outlet for a while; indeed, both the Solar and the Eco Player are ruggedly built, with rubberized nonscratchable surfaces."
                                            },
                                            {
                                                "example_id": "3e0f35c4-b181-435f-bf5e-5566e5e5888d",
                                                "sense_id": "b350ad95-8b2e-3352-9021-ce22559febd0",
                                                "text": "To be sung to in this way by the entire faery kingdom, each member of it born from the heartsong of a camper, was truly a delight that not many, I believe, have known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e2ad95-51ce-3c64-aa07-99e36c26682b",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A motor vehicle with a rear compartment for living and sleeping in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c71358e2-0aee-46a1-89c5-d786b626df47",
                                                "sense_id": "28e2ad95-51ce-3c64-aa07-99e36c26682b",
                                                "text": "The moonshiners are now only a memory, but the sunrisers have grown into many hundreds, with trailers and campers pulling into Red Rock Canyon days early for a good parking spot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c27f187-4dfe-3c1e-990d-5f27e633ee87",
                                        "entry_id": "ad29765f-5204-376d-9638-189fbc2d762a",
                                        "glosses": [
                                            "A person who stays in one spot during a first-person shooting game, to guard an item etc."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
