                        "glosses": [
                            "bedekt raken met stof omdat men iets niet gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d768d883-7a3c-4ee3-a138-eb90f753bc54",
                                "sense_id": "8c1842ab-1ac0-3c5c-aeef-c131a9f76fca",
                                "text": "Zijn platen verstoffen in de kast, op zijn kamer, hij wordt onpasselijk als hij aan ingewikkelde muziek en improvisaties denkt, hij heeft de piano niet meer aangeraakt sinds zijn bezoek aan de eerste arts."
                            },
                            {
                                "example_id": "b2b271f5-f137-49b0-a715-c928e6b56011",
                                "sense_id": "8c1842ab-1ac0-3c5c-aeef-c131a9f76fca",
                                "text": "Tijdens de restauratie is er veel aan het licht gekomen over het verleden van het doek, dat jarenlang in het atelier van Monet stond te verstoffen. Want na zijn dood had niemand interesse in het late werk van Monet. En dat terwijl Monet al tijdens zijn leven heel populair was."
                            }
                        ]
                    }
