                "senses": [
                    {
                        "sense_id": "d8f74af9-04ec-3400-adce-d9da33b5ba0e",
                        "entry_id": "1d30adab-4eeb-3cba-b87e-0f35ed9cf087",
                        "glosses": [
                            "Zurückdrängen von Migranten von den Grenzen ihres Ziel- oder Transitlandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f5be73-b029-44a3-8a9e-9aadb7076f2e",
                                "sense_id": "d8f74af9-04ec-3400-adce-d9da33b5ba0e",
                                "text": "„Im Dezember 2021 machten Medien und die Anti-Folter-Aussschuss des Europäische Rat Details zur Operation Koridor bekannt, die belegen, dass die Praxis illegaler Pushbacks auf politische Entscheidungen zurück gehen und die Beamten nach Anweisungen handeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b81e8817-e93c-39c2-85f8-e76ff00b81b6",
                        "entry_id": "1d30adab-4eeb-3cba-b87e-0f35ed9cf087",
                        "glosses": [
                            "Zurücksetzen eines Flugzeuges, das mit der Flugzeugnase an einem Flugplatzgebäude (Flugsteig) steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0465cafe-88ce-4ade-b442-c5e042a034ab",
                                "sense_id": "b81e8817-e93c-39c2-85f8-e76ff00b81b6",
                                "text": "„Die Freigabe ist an einigen Flugplätzen auch für die Erlaubnis zum Pushback und zum Triebwerksstart verantwortlich, um Staus auf Rollwegen und Vorfeld zu verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
