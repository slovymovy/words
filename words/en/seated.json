                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hostess <w>seated</w> us at a quiet table in the corner.",
                            "target_lang_translations": {
                                "ru": "Хостес <w>усадила</w> нас за тихий столик в углу.",
                                "zh": "女主人把我们<w>安排</w>在角落里一张安静的桌子旁。"
                            }
                        },
                        {
                            "text": "She <w>seated</w> herself by the window to watch the rain.",
                            "target_lang_translations": {
                                "ru": "Она <w>уселась</w> у окна, чтобы понаблюдать за дождем.",
                                "zh": "她<w>坐</w>在窗边看雨。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
