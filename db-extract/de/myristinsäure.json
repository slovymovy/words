                        "glosses": [
                            "eine gesättigte Fettsäure, Summenformel C₁₄H₂₈O₂"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f64b9e4f-ccd5-4af4-80e9-87b89548d309",
                                "sense_id": "f27f099d-1c16-396e-9b09-140d44b8c1ea",
                                "text": "Die Myristinsäure reagiert mit Alkoholen zu Estern."
                            },
                            {
                                "example_id": "4e5ae71b-d5dd-45a5-a3c2-4242f3765d0f",
                                "sense_id": "f27f099d-1c16-396e-9b09-140d44b8c1ea",
                                "text": "Als Steuersubstanzen sollten Salze der Myristinsäure eingesetzt werden, da aufgrund gastroenterologischer Untersuchungen die Myristinsäure als eine Art Leitsubstanz in der Nahrung bezeichnet werden kann."
                            }
                        ],
