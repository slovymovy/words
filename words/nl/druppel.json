                    ],
                    "target_lang_definitions": {
                        "en": "an electronic key in the shape of a drop that works with RFID technology",
                        "ru": "электронный ключ в форме капли, работающий по технологии RFID"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fob",
