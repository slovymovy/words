{
    "word_family": [
        "bother",
        "bothersome"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a24e94b1-ff88-321a-90f1-2b02741851d9",
                    "sense_definition": "present participle and gerund of <w>bother</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bother_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry for <w>bothering</w> you while you are trying to work on your project.",
                            "target_lang_translations": {
                                "ru": "Простите, что <w>беспокою</w> вас, пока вы пытаетесь работать над своим проектом.",
                                "pl": "Przepraszam, że <w>przeszkadzam</w> ci, kiedy próbujesz pracować nad swoim projektem."
                            }
                        },
                        {
                            "text": "Stop <w>bothering</w> me with those silly questions and let me finish my book.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>донимать</w> меня этими глупыми вопросами и дай мне дочитать книгу.",
                                "pl": "Przestań <w>naprzykrzać mi się</w> tymi głupimi pytaniami i pozwól mi dokończyć książkę."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "disturbing",
                        "troubling"
                    ],
                    "antonyms": [
                        "soothing",
                        "helping"
                    ],
                    "common_phrases": [
                        "sorry for bothering",
                        "stop bothering me",
                        "keep bothering someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола bother (беспокоить)",
                        "pl": "imiesłów czasu teraźniejszego oraz gerundium od czasownika bother (przeszkadzać, niepokoić)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "доставлять неудобство или прерывать"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "отвлекать от дела"
                            },
                            {
                                "target_lang_word": "надоедать",
                                "target_lang_sense_clarification": "докучать просьбами или вопросами"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przeszkadzanie",
                                "target_lang_sense_clarification": "odrywanie kogoś od zajęć"
                            },
                            {
                                "target_lang_word": "niepokojenie",
                                "target_lang_sense_clarification": "zakłócanie czyjegoś spokoju"
                            },
                            {
                                "target_lang_word": "naprzykrzanie się",
                                "target_lang_sense_clarification": "bycie uciążliwym dla kogoś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f50b9e2d-66df-3eb3-b477-3b9e55490225",
                    "sense_definition": "causing annoyance, irritation, or worry",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "annoying_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a <w>bothering</w> experience with him yesterday, but fortunately nothing came of it.",
                            "target_lang_translations": {
                                "ru": "Вчера у меня был <w>неприятный</w> опыт общения с ним, но, к счастью, это ни к чему не привело.",
                                "pl": "Miałem wczoraj <w>nieprzyjemne</w> doświadczenie z nim, ale na szczęście nic z tego nie wynikło."
                            }
                        },
                        {
                            "text": "The <w>bothering</w> noise from the construction site made it impossible to concentrate.",
                            "target_lang_translations": {
                                "ru": "<w>Раздражающий</w> шум со стройки мешал сосредоточиться.",
                                "pl": "<w>Irytujący</w> hałas z placu budowy uniemożliwiał koncentrację."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "irritating",
                        "troublesome",
                        "disturbing"
                    ],
                    "antonyms": [
                        "pleasant",
                        "comforting"
                    ],
                    "common_phrases": [
                        "bothering experience",
                        "bothering thought",
                        "bothering noise"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий раздражение, досаду или беспокойство",
                        "pl": "powodujący irytację, zdenerwowanie lub zmartwienie"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоящий",
                                "target_lang_sense_clarification": "вызывающий тревогу или волнение"
                            },
                            {
                                "target_lang_word": "раздражающий",
                                "target_lang_sense_clarification": "вызывающий чувство досады"
                            },
                            {
                                "target_lang_word": "досадный",
                                "target_lang_sense_clarification": "неприятный или мешающий"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepokojący",
                                "target_lang_sense_clarification": "wywołujący lęk lub troskę"
                            },
                            {
                                "target_lang_word": "irytujący",
                                "target_lang_sense_clarification": "powodujący zdenerwowanie"
                            },
                            {
                                "target_lang_word": "uciążliwy",
                                "target_lang_sense_clarification": "sprawiający kłopot lub dyskomfort"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba3792da-ad9c-3f42-baea-1af1c5de3f5e",
                    "sense_definition": "the act of troubling, disturbing, or pestering someone",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bother_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>bothering</w> from the telemarketers finally forced her to change her phone number.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>беспокойство</w> со стороны телемаркетологов в конце концов заставило её сменить номер телефона.",
                                "pl": "Ciągłe <w>niepokojenie</w> przez telemarketerów w końcu zmusiło ją do zmiany numeru telefonu."
                            }
                        },
                        {
                            "text": "He could not stand the <w>bothering</w> of his younger siblings while he studied.",
                            "target_lang_translations": {
                                "ru": "Он не выносил <w>докучаний</w> своих младших братьев и сестер, пока учился.",
                                "pl": "Nie mógł znieść <w>dokuczania</w> ze strony młodszego rodzeństwa, kiedy się uczył."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturbance",
                        "harassment",
                        "annoyance"
                    ],
                    "antonyms": [
                        "assistance",
                        "peace"
                    ],
                    "common_phrases": [
                        "constant bothering",
                        "unnecessary bothering"
                    ],
                    "target_lang_definitions": {
                        "ru": "действие по созданию помех, беспокойства или назойливости",
                        "pl": "czynność polegająca na zakłócaniu spokoju, niepokojeniu lub byciu natrętnym"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "состояние или действие, нарушающее покой"
                            },
                            {
                                "target_lang_word": "докучание",
