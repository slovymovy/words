                        "entry_id": "b57e10a6-0534-3578-b77b-d1c5b10cb678",
                        "glosses": [
                            "to fly (to, as far as), (thrown object, projectile etc) to reach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef366df-f4dd-4b77-9323-9672a40e2488",
                                "sense_id": "44746861-df40-3d0a-a808-6d93fe61d5f4",
                                "text": "не долете́ть (до це́ли)",
                                "translation": "to fall short (of)",
                                "english": "to fall short (of)"
                            },
                            {
                                "example_id": "23562e13-c9a0-47a8-8f8d-c407391dfd72",
                                "sense_id": "44746861-df40-3d0a-a808-6d93fe61d5f4",
                                "text": "пти́ца не смогла́ туда́ долете́ть",
                                "translation": "the bird could not fly that far",
                                "english": "the bird could not fly that far"
                            },
                            {
                                "example_id": "9047be24-8846-4eb9-8f57-f0644f150cba",
                                "sense_id": "44746861-df40-3d0a-a808-6d93fe61d5f4",
                                "text": "как вы долете́ли?",
                                "translation": "≈ did you enjoy your flight?",
                                "english": "≈ did you enjoy your flight?"
                            }
                        ]
