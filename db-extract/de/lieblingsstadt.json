                        "examples": [
                            {
                                "example_id": "f7bc21a1-3de3-4036-9a2f-c867e979ec96",
                                "sense_id": "99f6387d-302c-34f5-ad6f-f4025783b846",
                                "text": "„Ein Handler in Monte Carlo, der für die Vermittlung zwischen Auftraggeber und -nehmer 20 Prozent Provision kassierte, hatte die aktuelle Geschäftsbeziehung für ihn eingefädelt. Eine Art Finderlohn für einen anspruchsvollen, aber machbaren Job, der Court obendrein nach Paris brachte - wahrscheinlich seine Lieblingsstadt weltweit.“"
                            },
                            {
                                "example_id": "bc77e608-a7ce-4b2f-afd7-fe99ef118f63",
                                "sense_id": "99f6387d-302c-34f5-ad6f-f4025783b846",
                                "text": "„Als Preis für ihre Zustimmung hatte sie darauf bestanden, dass ihr Mann sie auf einen letzten Kurztrip nach Kyoto begleitete, ihre Lieblingsstadt in Asien.“"
                            }
                        ],
