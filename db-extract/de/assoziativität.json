                ],
                "senses": [
                    {
                        "sense_id": "388103f6-ae83-3cbc-b44c-859a5cc66d33",
                        "entry_id": "dc1643c9-0d99-32ba-bbea-5885553c9a5b",
                        "glosses": [
                            "Eigenschaft/Vermögen, im Denken Bilder, Vorstellungen (Assoziationen) auszulösen, auch die ausgelösten Bilder/Vorstellungen/Inhalte selbst"
                        ],
                        "tags": [
                            "Lerntheorie"
                        ],
                        "examples": [
                            {
                                "example_id": "972a1c8a-f9e2-434d-9a77-6eb264b002ba",
                                "sense_id": "388103f6-ae83-3cbc-b44c-859a5cc66d33",
                                "text": "„Assoziativitäten, die durch die Assoziationsgesetze erklärten mentalen Zusammenhänge. Das können Vorstellungsbilder, Begriffe, Worte, Aussagen oder Folgen ganzer Sätze sein (wie z.B. nach dem Erlernen eines Gedichts).“"
                            },
                            {
                                "example_id": "3fcf220c-dec1-4b52-ab0a-06a75cc568dd",
                                "sense_id": "388103f6-ae83-3cbc-b44c-859a5cc66d33",
                                "text": "„Der ›Ort‹ der Assoziativität liegt, wie man vielleicht heute sagen würde, jenseits der Texturen. Er ist im Gedächtnis, im Unbewußten vor dem Geist, im Gehirn.“"
                            },
                            {
                                "example_id": "e2575a80-32a9-4f41-a77e-f6e5087e0556",
                                "sense_id": "388103f6-ae83-3cbc-b44c-859a5cc66d33",
                                "text": "„Als richtige Antwort für die Metagedächtnisfragen wurden alle Antworten gewertet, die erkennen lassen, dass die Kinder den Unterschied zwischen der unterschiedlichen Assoziativität erkannt haben.“"
                            },
                            {
                                "example_id": "14e596a2-ad98-47e2-995e-aaacc045fb2b",
                                "sense_id": "388103f6-ae83-3cbc-b44c-859a5cc66d33",
                                "text": "„Offensichtlich kann die Assoziativität und Offenheit von Hypermedien gerade in Lernsystemen zu Fehlern führen. Durch die nichtsequentielle Rezeption erlangt der Benutzer möglicherweise eine andere Sichtweise, ein anderes Verstehen der Inhalte als die Autoren des Hypermediums beabsichtigt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2aa9c0c8-4066-368f-a0bd-4ad5743fadf9",
                        "entry_id": "dc1643c9-0d99-32ba-bbea-5885553c9a5b",
                        "glosses": [
                            "Eigenschaft/Umstand, dass die Reihenfolge der Ausführung einer mathematischen Berechnung keine Rolle für das Resultat spielt, dass das Assoziativgesetz gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa93538a-73a6-4f70-80fb-1193c7eba57d",
                                "sense_id": "2aa9c0c8-4066-368f-a0bd-4ad5743fadf9",
                                "text": "„Mit diesem Beweis ist allerdings noch nicht geklärt worden, daß sich die Assoziativität der Multiplikation und die Rechtstransitivität der Division wechselseitig entsprechen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "66111b55-7598-3860-bcbb-8288bad570ee",
                        "entry_id": "dc1643c9-0d99-32ba-bbea-5885553c9a5b",
                        "glosses": [
                            "Eigenschaft eines Operators, die eine Vorgabe ergibt, in welcher Reihenfolge gleichwertige Operatoren abgearbeitet werden"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "dc6e4d70-0638-4885-b4e0-f2550d9c5b2e",
                                "sense_id": "66111b55-7598-3860-bcbb-8288bad570ee",
                                "text": "„Assoziativitäten beschreiben die Bindungen zwischen gleichwertigen Operatoren.“"
                            },
                            {
                                "example_id": "530030a9-0b58-47e7-8ed7-489a43a5bb47",
                                "sense_id": "66111b55-7598-3860-bcbb-8288bad570ee",
                                "text": "„In einem Ausdruck mit mehreren Operatoren der gleichen Präzedenz bestimmt die Assoziativität die Reihenfolge, in der die Operationen ausgeführt werden.“"
                            },
                            {
                                "example_id": "ac5bf997-d604-45cc-8adf-e88f04c1a18a",
                                "sense_id": "66111b55-7598-3860-bcbb-8288bad570ee",
                                "text": "„Neben der Präzedenz spielt also auch die Assoziativität von Operatoren eine Rolle, wenn es darum geht, herauszufinden, in welcher Reihenfolge ein Ausdruck ausgewertet wird.“"
                            },
                            {
                                "example_id": "9c87d722-56ca-4e51-a124-d0b96421ce83",
                                "sense_id": "66111b55-7598-3860-bcbb-8288bad570ee",
                                "text": "„Der Wert L steht für Assoziativität von links nach rechts und der Wert R für die Assoziativität von rechts nach links.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
