    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d176f22-c143-3a81-80e9-dc332fd6e029",
                    "sense_definition": "Situation objective dans laquelle une personne ou une chose n'est exposée à aucun danger ou risque.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oubliez pas d'attacher votre ceinture de <w>sécurité</w> dès que vous montez en voiture."
                        },
                        {
                            "text": "Les enfants jouent dans le jardin en toute <w>sécurité</w> sous la surveillance des adultes."
                        }
                    ],
                    "synonyms": [
                        "sûreté"
                    ],
                    "antonyms": [
                        "insécurité"
                    ],
                    "common_phrases": [
                        "ceinture de sécurité",
                        "en toute sécurité",
                        "consignes de sécurité",
                        "sécurité routière"
                    ]
                },
                {
                    "sense_id": "92552dec-8f2b-3c5d-8930-8444d696c449",
                    "sense_definition": "Sentiment de confiance et de tranquillité d'esprit né de l'assurance d'être hors de danger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'elle a déménagé dans ce quartier calme, elle ressent une vraie <w>sécurité</w> d'esprit."
                        },
                        {
                            "text": "Il ne se sentait plus en <w>sécurité</w> tout seul dans cette immense maison isolée."
                        }
                    ],
                    "antonyms": [
                        "insécurité"
                    ],
                    "common_phrases": [
                        "sentiment de sécurité",
                        "en sécurité"
                    ]
                },
                {
                    "sense_id": "06686fac-dea3-38ec-bdf0-4a0c41025a31",
                    "sense_definition": "Protection des systèmes informatiques et des réseaux contre les intrusions, le vol ou les altérations de données.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise a renforcé la <w>sécurité</w> informatique pour empêcher efficacement les cyberattaques."
                        },
                        {
                            "text": "La <w>sécurité</w> des données bancaires reste une priorité absolue pour ce site de vente."
                        }
                    ],
                    "common_phrases": [
                        "sécurité informatique",
                        "sécurité des données"
                    ]
                },
                {
                    "sense_id": "d4d07ef9-db07-3440-b672-bf52aa0c429d",
                    "sense_definition": "Dispositif ou mécanisme conçu pour empêcher le déclenchement involontaire d'une arme ou d'un appareil.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de ranger son arme de service, le policier a soigneusement enclenché le cran de <w>sécurité</w>."
                        },
                        {
                            "text": "Ce robot de cuisine possède une <w>sécurité</w> qui bloque les lames tant que le couvercle est ouvert."
                        }
                    ],
                    "common_phrases": [
                        "cran de sécurité",
                        "mettre la sécurité"
                    ]
                }
            ]
        }
