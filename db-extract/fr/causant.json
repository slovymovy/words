                        "examples": [
                            {
                                "example_id": "0ab15a03-b282-4365-abfe-6a0f43f93157",
                                "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                "text": "C’est elle qui faisait les courses. Pas causante, et même un brin fiérote."
                            },
                            {
                                "example_id": "03841f02-ce42-4db8-bef8-33c4214b0e13",
                                "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                "text": "Il y avait bien du monde à cet enterrement, dit Honoré, mais je n’ai pas vu grand-chose, pour dire que j’aie vu. Et les gens n’étaient guère causants."
                            },
                            {
                                "example_id": "0f68b230-79a0-484d-b103-c7c7724dea7f",
                                "sense_id": "f18a66a6-b1df-3e81-9b47-9315b1e3e916",
                                "text": "Ils ne sont pas précisément “causants”, ces casquettiers, mais je me débrouillerai."
                            }
                        ]
                    }
                ],
