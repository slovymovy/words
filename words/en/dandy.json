{
    "word_family": [
        "dandify",
        "dandyish",
        "dandyism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8baa48b1-87c9-30f2-b9e5-dbf3510fa3a5",
                    "sense_definition": "A man who places excessive importance on stylish clothes, refined appearance, and elegant manners.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dressed like an 18th-century <w>dandy</w> with an embroidered coat and silk scarf.",
                            "target_lang_translations": {
                                "es": "Se vestía como un <w>dandi</w> del siglo XVIII, con abrigo bordado y pañuelo de seda."
                            }
                        },
                        {
                            "text": "The young man was considered a fashionable <w>dandy</w> who spent hours grooming himself.",
                            "target_lang_translations": {
                                "es": "Aquel joven era considerado un <w>petimetre</w> a la moda que pasaba horas arreglándose."
                            }
                        }
                    ],
                    "synonyms": [
                        "fop",
                        "beau",
                        "coxcomb",
                        "popinjay"
                    ],
                    "target_lang_definitions": {
                        "es": "Hombre que da una excesiva importancia a la vestimenta elegante, la apariencia cuidada y los modales refinados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "dandi",
                                "target_lang_sense_clarification": "hombre elegante y refinado"
                            },
                            {
                                "target_lang_word": "dandy",
                                "target_lang_sense_clarification": "grafía original en inglés, de uso común"
                            },
                            {
                                "target_lang_word": "petimetre",
                                "target_lang_sense_clarification": "hombre excesivamente preocupado por su atuendo"
                            },
                            {
                                "target_lang_word": "lechuguino",
                                "target_lang_sense_clarification": "joven que busca vestir a la última moda con afectada compostura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d6baf0-9e8a-3251-845a-771396951a5a",
                    "sense_definition": "Something or someone that is very good or first-rate in its class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That old sports car is a real <w>dandy</w> and runs beautifully.",
                            "target_lang_translations": {
                                "es": "Ese viejo deportivo es una auténtica <w>joyita</w> y funciona de maravilla."
                            }
                        },
                        {
                            "text": "His latest novel turned out to be a <w>dandy</w> of a mystery story.",
                            "target_lang_translations": {
                                "es": "Su última novela resultó ser una <w>maravilla</w> de historia de misterio."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Algo o alguien excelente, de primera categoría o formidable en su clase."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "maravilla",
                                "target_lang_sense_clarification": "cosa o persona extraordinaria"
                            },
                            {
                                "target_lang_word": "joyita",
                                "target_lang_sense_clarification": "objeto de gran valor o calidad"
                            },
                            {
                                "target_lang_word": "primera clase",
                                "target_lang_sense_clarification": "de excelente calidad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f64881be-e863-3a58-93b2-6e1f128dc70d",
                    "sense_definition": "A light, open sedan chair carried on poles, historically used in parts of South Asia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured traveler was carried up the mountain path in a <w>dandy</w>.",
                            "target_lang_translations": {
                                "es": "El viajero herido fue llevado por el sendero de montaña en una <w>silla de manos</w>."
                            }
                        },
                        {
                            "text": "She preferred riding in a <w>dandy</w> along the narrow hillside trail.",
                            "target_lang_translations": {
                                "es": "Ella prefería ir en <w>litera</w> a lo largo del estrecho sendero de la ladera."
                            }
                        }
                    ],
                    "synonyms": [
                        "jampan"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Tipo de litera o silla de manos ligera y abierta, transportada sobre varas, empleada históricamente en el sur de Asia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "silla de manos",
                                "target_lang_sense_clarification": "litera ligera tradicional de Asia del Sur"
                            },
                            {
                                "target_lang_word": "litera",
                                "target_lang_sense_clarification": "asiento portátil llevado a hombros"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88576ed5-8f9a-3293-bbc4-18544c1e058a",
                    "sense_definition": "A boatman or rower in India.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>dandy</w> navigated the boat across the wide river.",
                            "target_lang_translations": {
                                "es": "El <w>barquero</w> local navegó el bote al otro lado del ancho río."
                            }
                        },
                        {
                            "text": "Several river travelers hired a <w>dandy</w> to take them downstream.",
                            "target_lang_translations": {
                                "es": "Varios viajeros fluviales contrataron a un <w>remero</w> para que los llevara río abajo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Barquero o remero en la India."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "barquero",
                                "target_lang_sense_clarification": "remero en ríos de la India"
                            },
                            {
                                "target_lang_word": "remero",
                                "target_lang_sense_clarification": "persona que rema en una embarcación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "711ed7a5-55a9-3646-8e20-982ed35f9896",
                    "sense_definition": "A Shaiva mendicant or ascetic who carries a ceremonial staff.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A holy <w>dandy</w> walked silently through the village carrying his wand.",
                            "target_lang_translations": {
                                "es": "Un santo <w>asceta</w> caminaba en silencio por el pueblo llevando su vara ceremonial."
                            }
                        },
                        {
                            "text": "The pilgrims showed reverence to the wandering <w>dandy</w>.",
                            "target_lang_translations": {
                                "es": "Los peregrinos mostraron reverencia hacia el <w>dandi</w> errante."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Asceta o mendicante hinduista shivaíta que lleva una vara o báculo ceremonial."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "dandi",
                                "target_lang_sense_clarification": "asceta shivaíta portador de un báculo ceremonial"
                            },
                            {
                                "target_lang_word": "asceta",
                                "target_lang_sense_clarification": "monje o mendicante religioso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d07f21d-6acf-3c22-9ecd-7ee06a1becaf",
                    "sense_definition": "A small measure or glass of whisky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patron asked the bartender for a quick <w>dandy</w> of whisky.",
                            "target_lang_translations": {
                                "es": "El cliente le pidió al camarero un rápido <w>chupito</w> de whisky."
                            }
                        },
                        {
                            "text": "He downed a <w>dandy</w> before stepping out into the cold night.",
                            "target_lang_translations": {
                                "es": "Se bebió un <w>trago</w> antes de salir a la fría noche."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Medida o vasito pequeño de whisky."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "chupito",
                                "target_lang_sense_clarification": "vaso pequeño de licor"
                            },
                            {
                                "target_lang_word": "trago",
                                "target_lang_sense_clarification": "porción corta de bebida alcohólica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e7dccde-0155-35c9-91eb-01b8c6423f79",
                    "sense_definition": "A yawl rig, or a small mizzen sail on a yawl.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors adjusted the <w>dandy</w> as the wind shifted suddenly.",
                            "target_lang_translations": {
                                "es": "Los marineros ajustaron la <w>vela de mesana</w> cuando el viento cambió repentinamente."
                            }
                        },
                        {
                            "text": "He bought a boat equipped with a small <w>dandy</w> rig.",
                            "target_lang_translations": {
                                "es": "Compró un barco equipado con un pequeño <w>aparejo de yola</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Aparejo de yola, o vela pequeña de mesana en una yola."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vela de mesana",
                                "target_lang_sense_clarification": "pequeña vela trasera de un yate o yola"
                            },
                            {
                                "target_lang_word": "aparejo de yola",
                                "target_lang_sense_clarification": "tipo de disposición náutica"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac82f916-6c3e-31e8-a20e-f8c8369f57ed",
                    "sense_definition": "A light horse-drawn railway carriage used on certain British branch lines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passengers boarded the historic horse-drawn <w>dandy</w> for the short ride.",
                            "target_lang_translations": {
                                "es": "Los pasajeros abordaron el histórico <w>vagón de tiro de sangre</w> para el trayecto corto."
                            }
                        },
                        {
                            "text": "A restored branch-line <w>dandy</w> was put on display in the museum.",
                            "target_lang_translations": {
                                "es": "Un <w>coche de caballos ferroviario</w> de ramal restaurado se exhibió en el museo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Vagón ferroviario ligero tirado por caballos, usado antiguamente en ciertos ramales británicos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vagón de tiro de sangre",
                                "target_lang_sense_clarification": "coche ferroviario tirado por caballos"
                            },
                            {
                                "target_lang_word": "coche de caballos ferroviario",
                                "target_lang_sense_clarification": "vehículo histórico sobre rieles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7112f8bc-9af9-3eab-899c-8a789271d5b7",
                    "sense_definition": "A dandy roller used in papermaking to add watermarks or textures.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician inspected the metal surface of the <w>dandy</w> before running the press.",
                            "target_lang_translations": {
                                "es": "El técnico inspeccionó la superficie metálica del <w>rodillo filigranador</w> antes de poner en marcha la prensa."
                            }
                        },
                        {
                            "text": "A wire cylinder known as a <w>dandy</w> creates the watermark in the paper.",
                            "target_lang_translations": {
                                "es": "Un cilindro metálico conocido como <w>cilindro desgotador</w> crea la filigrana en el papel."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Cilindro desgotador o filigranador usado en la fabricación de papel para aplicar filigranas o texturas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "rodillo filigranador",
                                "target_lang_sense_clarification": "cilindro que marca filigranas en el papel"
                            },
                            {
                                "target_lang_word": "cilindro desgotador",
                                "target_lang_sense_clarification": "cilindro de tela metálica en papelería"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "48ef18a6-a1e1-3dfd-865a-ba0b44d54be9",
                    "sense_definition": "Satisfactory or good, especially in conventional or slightly ironic phrases.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everything is fine and <w>dandy</w> until you look at the final bill.",
                            "target_lang_translations": {
                                "es": "Todo marcha <w>de maravilla</w> hasta que miras la cuenta final."
                            }
                        },
                        {
                            "text": "That plan is just <w>dandy</w>, but we still need more time.",
                            "target_lang_translations": {
                                "es": "Ese plan está <w>estupendo</w>, pero aún necesitamos más tiempo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fine and dandy",
                        "just dandy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Satisfactorio, bueno o en orden, especialmente usado en expresiones convencionales o algo irónicas."
                    },
                    "translations": {
