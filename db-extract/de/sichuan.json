                                "target_senses": [
                                    {
                                        "sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                                        "entry_id": "217b9c36-10c0-395c-836f-df3e75f56969",
                                        "glosses": [
                                            "Province du sud-ouest de la Chine, dont le chef-lieu est Chengdu, et qui, historiquement, comprenait aussi la ville de Chongqing."
                                        ],
                                        "tags": [
                                            "Toponymie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96a0c8b-e566-4dec-9f24-d4294aa141bb",
                                                "sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                                                "text": "Du groupe des langues lolo, apparentées au birman, relèvent celles parlées par les Yi du Sichuan et du Yunnan."
                                            },
                                            {
                                                "example_id": "b09be899-ba9d-4345-b82d-5b50d2ce214a",
                                                "sense_id": "2b78f5a7-e744-3936-a659-f64573f9581a",
                                                "text": "Le Sichuan, très montagneux et connu dans le monde entier pour ses réserves de pandas, est généralement frappé plusieurs fois par mois par des séismes d’intensités variables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
