                                        "sense_id": "474b8375-db93-3dec-81a8-72a50534d97a",
                                        "entry_id": "12837d64-0efb-3e8b-8ec8-4d65e34892d1",
                                        "glosses": [
                                            "durch Wasser verursachter Abgang von Erde und Steinen in abschüssigem Gelände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25a6e79-241e-411b-808f-2c2c02dd23d8",
                                                "sense_id": "474b8375-db93-3dec-81a8-72a50534d97a",
                                                "text": "„Besondere Bedeutung hat der Wald im Gebirge – als Schutz vor Muren und Lawinen etwa.“"
                                            },
                                            {
                                                "example_id": "b0d645d9-d00f-4dca-a6b5-77e9bc6e22e6",
                                                "sense_id": "474b8375-db93-3dec-81a8-72a50534d97a",
                                                "text": "„In der Region ging am Samstag auch eine Mure auf eine Autobahn nieder.“"
                                            }
