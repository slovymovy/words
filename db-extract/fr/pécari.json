                                        "entry_id": "4982a61b-f3ed-3cad-9228-acc0af2ef9d2",
                                        "glosses": [
                                            "Any of the family Tayassuidae of mammals from the Americas, related to pigs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "298b3489-f437-423d-a7ac-baa50b84f855",
                                                "sense_id": "1f448ae4-36f6-3697-bb90-67633cf8c525",
                                                "text": "He says he drank rainwater collected in his shoes and ate worms and insects while hiding from jaguars and peccaries, a type of pig-like mammal."
                                            }
                                        ]
                                    }
                                ]
                            }
