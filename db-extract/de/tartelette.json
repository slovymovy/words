                    }
                ],
                "senses": [
                    {
                        "sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                        "entry_id": "29c325cb-1d8d-34f4-8f0d-e57ecee1dbe9",
                        "glosses": [
                            "kleine Tarte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd82b19d-a405-4077-8064-992dddc25e8f",
                                "sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                                "text": "Die Tartelette ist eine verkleinerte Tarte und bestehen aus belegten geschmacksneutralen Teig, ähnlich einer Wähe."
                            },
                            {
                                "example_id": "35eeec90-b6b2-4adc-9af3-a89a513f2981",
                                "sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                                "text": "Freunde von Finger- und Löffel-Food konnten sich an Kreationen mit Nordseekrabben delektieren, die auf Namen wie Dim-Sum und Loempia hörten und mit Glasnudelsalat und Tartelette um die Gunst der Gäste buhlten."
                            },
                            {
                                "example_id": "0ab6e6c0-e7d6-4023-a7ce-47c5742d214a",
                                "sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                                "text": "Diese leckeren Apfel-Tarteletten sind ziemlich simpel und schmecken mit süss-säuerlichen Äpfeln am Besten."
                            },
                            {
                                "example_id": "85b1126b-6c03-4b9d-b698-46b0cfc42d55",
                                "sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                                "text": "Grossmutter-Rezepte wie die Tartelette Tatin, die Tartelette au citron meringuée und den Flan, der als der beste von Paris gilt, findet man hier in idealer Verwirklichung."
                            },
                            {
                                "example_id": "cb45ee04-6d7f-4d9e-85bf-eddc0d3ed877",
                                "sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                                "text": "Denn pünktlich um Mittag kommen die ersten Gäste: Die Einstimmung macht vielleicht eine Tomaten-Tartelette mit Jakobsmuscheln und Kräutern, das Hauptstück ein Roastbeef vom Angus-Rind mit lauwarmem Kartoffelsalat und Sommertrüffel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60cad8db-5b64-44d5-94a8-b76e0e9ac1c2",
                        "source_entry_id": "29c325cb-1d8d-34f4-8f0d-e57ecee1dbe9",
                        "source_sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                        "source_sense_description": "kleine Tarte",
                        "target_lang_word": "tartlet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tartlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de53cc27-6623-31c4-a6c4-83fb5c962633",
                                        "entry_id": "06200a3d-8020-3536-8af5-4e942ca882a1",
                                        "glosses": [
                                            "A small tart (pastry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71791bc0-c80a-4bf9-ae76-c372a51a2638",
                                                "sense_id": "de53cc27-6623-31c4-a6c4-83fb5c962633",
                                                "text": "Place the cream in a piping bag with a fairly large star pipe attached, fill each tartlet with a twirl of cream and top with a strawberry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                        "entry_id": "06200a3d-8020-3536-8af5-4e942ca882a1",
                                        "glosses": [
                                            "A promiscuous young woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75b425b0-d6b0-4a35-bcc2-d4d338ac26a8",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "The only excitement I had was watching a tartlet in a teeny-weeny bikini that barely contained her truly mammoth assets light a cigarette and suck on it with puckered, painted, Lolita lips."
                                            },
                                            {
                                                "example_id": "4872260a-4f20-4560-931a-2d8359243ad0",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "\"She's a whore. A tartlet. Junia, he bought her for a hundred and fifty guineas, and then had the nerve to ask me to marry him!\""
                                            },
                                            {
                                                "example_id": "a233e8a4-b3bb-4790-a451-296ac661c9f4",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "She hated that a large chunk of Jerry's income supported his little tartlets instead of being directed into their household as it should have been.."
                                            },
                                            {
                                                "example_id": "14bf244d-233b-4c09-b80b-1bc25c9addc6",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "'Be gone tartlets! Your feminine charms hold no power over me,' he said, […]"
                                            },
                                            {
                                                "example_id": "ace07ac6-f33b-405b-8ae0-d5f10e642d49",
                                                "sense_id": "0f982989-eb1b-3c45-992f-7c6e59556d34",
                                                "text": "I have yet to see a Hollywood tartlet apologize for weighing 95 pounds, or for playing dumb to stay popular, or for always being the sidekick when there's action."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3dbe38a-2a5e-44b5-b664-a3799383edf2",
                        "source_entry_id": "29c325cb-1d8d-34f4-8f0d-e57ecee1dbe9",
                        "source_sense_id": "89e56d06-92c9-3c73-adb3-b75a16b90948",
                        "source_sense_description": "kleine Tarte",
                        "target_lang_word": "tartelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
