                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verwijdering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie moest de demonstranten <w>verplaatsen</w> om de weg vrij te maken.",
                            "target_lang_translations": {
                                "en": "The police had to <w>remove</w> the protesters to clear the road."
                            }
                        },
                        {
