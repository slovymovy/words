                "senses": [
                    {
                        "sense_id": "6a63b639-8f95-3fec-a113-2bda6d68f11f",
                        "entry_id": "c9041204-b3a9-37b0-a961-c6be0bded4d8",
                        "glosses": [
                            "Region mit Skipisten, in der es möglich ist, Ski und Snowboard zu fahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dcb3378-7737-430e-b8f4-8abc87d65acf",
                                "sense_id": "6a63b639-8f95-3fec-a113-2bda6d68f11f",
                                "text": "Bei der Wahl ihres Urlaubsortes achtet sie immer darauf, dass ein Skigebiet in der Nähe ist."
                            },
                            {
                                "example_id": "6c03daca-f325-427b-becc-8f576c7d2474",
                                "sense_id": "6a63b639-8f95-3fec-a113-2bda6d68f11f",
                                "text": "„Seit dem 15. November 2016 ist die Bergwacht allein im Skigebiet rund um die Zugspitze zu mehr als 400 Einsätzen ausgerückt.“"
                            },
                            {
                                "example_id": "3b4e7460-8a43-4ab5-886e-c4643fdc057d",
                                "sense_id": "6a63b639-8f95-3fec-a113-2bda6d68f11f",
                                "text": "„Freerider und Tourengeher suchen auf unberührten Pisten die große Freiheit in den Bergen, das Glücksgefühl im Pulverschnee abseits des Rummels der Skigebiete.“"
                            },
                            {
                                "example_id": "ac5825b5-482f-431b-a52b-c1c039f892d7",
                                "sense_id": "6a63b639-8f95-3fec-a113-2bda6d68f11f",
                                "text": "„Im Anschluss an die Tour nach Siglunes hatte Ari den Nachmittag mit Stefnir im Skigebiet verbracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
