                        "source_sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                        "target_lang_word": "undertaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undertaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e9cff7-22e7-3e15-b963-9c67b82f3d50",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "A funeral director; someone whose business is to manage funerals, burials and cremations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdc6e3a4-d6ba-349b-aee4-453d04625857",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "A person receiving land in Ireland during the Elizabethan era, so named because they gave an undertaking to abide by several conditions regarding marriage, to be loyal to the crown, and to use English as their spoken language."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e3dc2e9-f4ce-4171-8586-6da9fdd399af",
                                                "sense_id": "fdc6e3a4-d6ba-349b-aee4-453d04625857",
                                                "text": "In 1588, Edmund Spenser became an undertaker in the first Elizabethan plantation, receiving the forfeited Irish estate of Kilcolman Castle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad596b2-9db3-3f93-b297-ff0d45c5b06c",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "A contractor for the royal revenue in England, one of those who undertook to manage the House of Commons for the king in the Addled Parliament of 1614."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "344e4ee5-4ba3-330b-b2d6-b625913d3687",
                                        "entry_id": "7afa565f-16ce-38d1-87d6-e67681597dc5",
                                        "glosses": [
                                            "One who undertakes or commits to doing something."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b66859a-9be1-4f2e-b211-cc6f7ad16bc9",
                                                "sense_id": "344e4ee5-4ba3-330b-b2d6-b625913d3687",
                                                "text": "A company shall not be appointed to be a water undertaker unless it is a limited company or a statutory water company and shall not be appointed to be a sewerage undertaker unless it is a limited company."
                                            },
                                            {
                                                "example_id": "4099b1be-13dc-40b5-8a81-9a277ae9a1bf",
                                                "sense_id": "344e4ee5-4ba3-330b-b2d6-b625913d3687",
                                                "text": "The undertaker of the enterprise is usually known today by the French term entrepreneur because we have surrendered the English word to the undertakers of funerals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c75299f-292e-448a-9a5e-1262e6eb97cb",
                        "source_entry_id": "a9844346-ad3e-3c16-a21b-70048a29df38",
                        "source_sense_id": "58134814-9a05-380c-97d2-898d2e4beeac",
                        "target_lang_word": "mortician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mortician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd539785-eab3-3936-bf2a-f5146a4b4d85",
                                        "entry_id": "2d3edd3b-4856-3f4e-9f8c-5b19872e2aa5",
                                        "glosses": [
                                            "An undertaker or funeral director; especially, one who is also the embalmer or cremator."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99d0c10-9941-438e-8375-31811a7c8308",
                                                "sense_id": "dd539785-eab3-3936-bf2a-f5146a4b4d85",
                                                "text": "“And I prefer mortician to funeral director. It sounds more professional and, well, it is more precise. I deal with more than mere funerals; I deal with death, passing on, the transition.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
