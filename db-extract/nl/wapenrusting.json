                                "target_senses": [
                                    {
                                        "sense_id": "573ce48e-029a-3afe-9937-f91f0453bbe1",
                                        "entry_id": "7b3fc0d0-d4f1-35ab-b5f9-2c57f9f190a0",
                                        "glosses": [
                                            "Weapons collectively"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b08a1ce-616d-48a2-8a96-bc74fee31516",
                                                "sense_id": "573ce48e-029a-3afe-9937-f91f0453bbe1",
                                                "text": "The army has a wide array of weaponry."
                                            },
                                            {
                                                "example_id": "6950c4d2-36a5-4d7c-8c28-001644bff21e",
                                                "sense_id": "573ce48e-029a-3afe-9937-f91f0453bbe1",
                                                "text": "The dispatches […] also exposed the blatant discrepancy between the west's professed values and actual foreign policies. Having lectured the Arab world about democracy for years, its collusion in suppressing freedom was undeniable as protesters were met by weaponry and tear gas made in the west, employed by a military trained by westerners."
                                            },
                                            {
                                                "example_id": "81c29ae0-56af-451e-8cf0-2b971756c596",
                                                "sense_id": "573ce48e-029a-3afe-9937-f91f0453bbe1",
                                                "text": "Holy shit! Those things barely look powerful enough to run Oregon Trail, much less Earth-ending weaponry. People who work there must watch WarGames and go “One day, one day, we’ll get to play with that stuff.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
