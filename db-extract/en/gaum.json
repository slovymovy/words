                        "form": "gaumed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "483833a8-5089-3f5a-9149-38ae3b4c30c1",
                        "entry_id": "3cb65b12-0cd3-3ad7-a955-caca4d092081",
                        "glosses": [
                            "To understand; comprehend; consider."
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "76c84d1e-8781-422b-b16f-60d2dba1d2fd",
                                "sense_id": "483833a8-5089-3f5a-9149-38ae3b4c30c1",
                                "text": "\"We said nowt on 't. Ther' no 'casion to stir up trouble. But we all gaumed 'at when he heerd t' sounds o' them 'at com to lowse us he'd crawled off into t' workin's an' brayed his head agean a shou'der o' quartz.\""
                            },
                            {
                                "example_id": "4f7603a6-2559-485c-86ae-ea8739c68b4e",
                                "sense_id": "483833a8-5089-3f5a-9149-38ae3b4c30c1",
                                "text": "'Nobody gaums where we are now,' I said."
                            },
                            {
                                "example_id": "2e27feb9-5149-41da-b1e3-6f208d6b5375",
                                "sense_id": "483833a8-5089-3f5a-9149-38ae3b4c30c1",
                                "text": "Aye sir, we gaum ye."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
