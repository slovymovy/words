                ],
                "senses": [
                    {
                        "sense_id": "de8b3a6e-c328-3232-8801-86d51ad0771b",
                        "entry_id": "d7031e79-b836-3f6f-a0a6-839230d62443",
                        "glosses": [
                            "A plain or shabby person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ffc5f40-201e-4fd0-9093-52cffe9178eb",
                                "sense_id": "de8b3a6e-c328-3232-8801-86d51ad0771b",
                                "text": "Besides these, however, and the determined dowdies, women who either do not understand dress, or who will not be troubled with it, there are certainly many who, while always anxious to appear to the best advantage, are not wealthy enough to do so […]"
                            },
                            {
                                "example_id": "4185c0d5-a3f3-428e-9a1d-4942e20a8b37",
                                "sense_id": "de8b3a6e-c328-3232-8801-86d51ad0771b",
                                "text": "“I knew there were women-dowdies in Bengal. They come up here sometimes. But I didn't know that there were men-dowds, too.”"
                            },
                            {
                                "example_id": "5541d96c-bede-4ed4-80f4-7c373f8f4d11",
                                "sense_id": "de8b3a6e-c328-3232-8801-86d51ad0771b",
                                "text": "The men are all dowdies and the women are all dandies, aren't they?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
