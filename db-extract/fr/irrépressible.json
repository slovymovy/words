            {
                "entry_id": "aa1e7556-66f3-3564-8a45-ba9d6529e2cf",
                "word": "irrépressible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2d5fddb8-ce73-4997-a9fd-165712ec32ab",
                        "entry_id": "aa1e7556-66f3-3564-8a45-ba9d6529e2cf",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "irrépressibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                        "entry_id": "aa1e7556-66f3-3564-8a45-ba9d6529e2cf",
                        "glosses": [
                            "Qu’on ne peut réprimer ou contenir, irrésistible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47dcc242-3c0e-458e-9c49-7719723eed70",
                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                "text": "Quand on assistait à une comédie d’Eugène Labiche, c’était le même rire irrépressible."
                            },
                            {
                                "example_id": "ca731ac7-5009-49ca-bf08-c53d6f31193a",
                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                "text": "L’irrépressible Rolf proposa d’aller souper à trois dans une taverne de Richmond où l’on trouvait de bonnes huîtres."
                            },
                            {
                                "example_id": "000d64b2-13eb-4012-a7e3-c6a6b072364a",
                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                "text": "Comme l’être humain a un besoin irrépressible d’opium, les sectes et la charlatanerie ne manqueront pas de pulluler."
                            },
                            {
                                "example_id": "fb0250de-8df4-49fa-b946-7496df9226a5",
                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                "text": "L’urgenturie, anciennement appelée impériosité urinaire, se définit par un besoin urgent et irrépressible d’uriner. Deux à trois millions de personnes sont concernées en France."
                            },
                            {
                                "example_id": "35ef1491-74af-4b3f-92c2-c9327f8614d1",
                                "sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                                "text": "La chaleur de l’incendie commençait à gagner les environs, mais il n’écoutait plus, pris de sanglots irrépressibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bf3398c-1f5e-46cf-92a3-86e09f809600",
                        "source_entry_id": "aa1e7556-66f3-3564-8a45-ba9d6529e2cf",
                        "source_sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
                        "target_lang_word": "irrepressible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrepressible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97779874-ae8d-31b8-8ba4-2482b1bc78da",
                                        "entry_id": "7e7d7271-1365-3c86-bece-0a000cad7fc6",
                                        "glosses": [
                                            "Not containable or controllable."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e91ac31-6d74-4afa-a063-47aded7b761a",
                                                "sense_id": "97779874-ae8d-31b8-8ba4-2482b1bc78da",
                                                "text": "[...] here the two friends burst into a variety of giggles, and glanced from time to time, over the tops of their pocket-handkerchiefs, at Nicholas, who from a state of unmixed astonishment, gradually fell into one of irrepressible laughter [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                        "entry_id": "7e7d7271-1365-3c86-bece-0a000cad7fc6",
                                        "glosses": [
                                            "Especially high-spirited, outspoken, or insistent."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca25def1-45e9-4451-a1d9-9196b1482f69",
                                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                                "text": "It was Paris' irrepressible High Fashion Doyenne Gabrielle (\"Coco\") Chanel, 80, so-soing this and high-hatting that, while Women's Wear Daily took notes."
                                            },
                                            {
                                                "example_id": "f9fbd47d-7a37-4e06-923f-b9b22761b534",
                                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                                "text": "The irrepressible landlady gave the freest expression to her feelings."
                                            },
                                            {
                                                "example_id": "19fc47d2-04dd-4153-90f7-bdefe9e2983b",
                                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                                "text": "Schomberg, [...] an irrepressible retailer of all the scandalous gossip of the place, would, with both elbows on the table, impart an adorned version of the story to any guest who cared to imbibe knowledge along with the more costly liquors."
                                            },
                                            {
                                                "example_id": "24403b57-264e-4dc1-abf7-c1579860b24c",
                                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                                "text": "\"The irrepressible Yank is knocking at the doors of their temples and he will want to sell 'em carpet-sweepers for their harems.\""
                                            },
                                            {
                                                "example_id": "0a1a4419-3e01-4803-8f2e-d3d9f0757da4",
                                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                                "text": "High-strung and irrepressible, George Jefferson quickly became one of America’s most popular television characters, a high-energy, combative black man who backed down to no one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "934c104a-fc8d-4718-bc77-6f1c04fcc8fa",
                        "source_entry_id": "aa1e7556-66f3-3564-8a45-ba9d6529e2cf",
                        "source_sense_id": "40d33974-2cdc-393a-aea5-581d6135c5c3",
