        "fr-extract.jsonl": [
            {
                "entry_id": "bef74b5c-ebc9-33e5-ba0d-735ac3cc1487",
                "word": "marelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33da1bc2-39da-4e47-b58a-62f467f96223",
                        "entry_id": "bef74b5c-ebc9-33e5-ba0d-735ac3cc1487",
                        "tags": [
                            "plural"
                        ],
                        "form": "marelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "943bfe8f-62a6-3d11-8283-5d515a77c8af",
                        "entry_id": "bef74b5c-ebc9-33e5-ba0d-735ac3cc1487",
                        "glosses": [
                            "Jeu d’enfants qui consiste en une sorte de rectangle divisé en cases tracées sur le sol, dans lequel on saute à cloche-pied en poussant avec le bout du pied une sorte de palet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11a9162-e642-4a6f-b307-478a745cf737",
                                "sense_id": "943bfe8f-62a6-3d11-8283-5d515a77c8af",
                                "text": "Il mangeait des mûres le long des fossés, gardait les dindons avec une gaule, fanait à la moisson, courait dans le bois, jouait à la marelle sous le porche de l’église les jours de pluie, et, aux grandes fêtes, suppliait le bedeau de lui laisser sonner les cloches, pour se pendre de tout son corps à la grande corde et se sentir emporter par elle dans sa volée."
                            },
                            {
                                "example_id": "61ef8b78-5fc5-4f38-805f-f6a9c3e84fd4",
                                "sense_id": "943bfe8f-62a6-3d11-8283-5d515a77c8af",
                                "text": "Quelques enfants qui jouaient aux marelles se sont interrompus un instant et ont crié : Vivat."
                            },
                            {
                                "example_id": "694d52fe-c634-496a-9fd7-5000cc750e02",
                                "sense_id": "943bfe8f-62a6-3d11-8283-5d515a77c8af",
                                "text": "Dans certaines écoles on a peint le parcours d’une marelle. Est-ce que les enfants obéissent au tracé des concepteurs d’école ? On se doute bien que non, qu’ils ne se laissent pas imposer le trajet qui doit les mener de la terre au ciel."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ef89af2-5696-3fb7-99ed-782ecbe897b1",
                        "entry_id": "bef74b5c-ebc9-33e5-ba0d-735ac3cc1487",
                        "glosses": [
                            "Synonyme de jeu du moulin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8d2358d-ce07-4553-87a0-9f49b5f713a2",
                                "sense_id": "4ef89af2-5696-3fb7-99ed-782ecbe897b1",
                                "text": "La marelle est également un jeu de société qui se joue à deux joueurs sur un tablier en forme de figure géométrique régulière sur lequel on pose des pions aux intersections des lignes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a00dda4-9960-4686-8e7d-ca86faf9a19e",
                        "source_entry_id": "bef74b5c-ebc9-33e5-ba0d-735ac3cc1487",
                        "source_sense_id": "943bfe8f-62a6-3d11-8283-5d515a77c8af",
                        "source_sense_description": "Jeu d’enfants",
                        "target_lang_word": "Himmel-und-Hölle-Spiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f5ce00e2-2382-4481-ae8f-c9da4e518052",
                        "source_entry_id": "bef74b5c-ebc9-33e5-ba0d-735ac3cc1487",
                        "source_sense_id": "943bfe8f-62a6-3d11-8283-5d515a77c8af",
                        "source_sense_description": "Jeu d’enfants",
                        "target_lang_word": "hopscotch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopscotch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0e72512-7c68-39c6-a5b1-e37e964ef75e",
                                        "entry_id": "90c71be5-2ed8-3855-ab81-7c84fb7b8163",
                                        "glosses": [
                                            "A child's game, in which a player, hopping on one foot, drives a stone from one compartment to another of a figure traced or scotched on the ground."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aae184e-fd5d-4d6c-8ee3-d356b140909a",
                                                "sense_id": "f0e72512-7c68-39c6-a5b1-e37e964ef75e",
                                                "text": "No-one. Meade’s timberyard. Piled balks. Ruins and tenements. With careful tread he passed over a hopscotch court with its forgotten pickeystone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hopscotch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db40ab8b-4e62-395d-bbd2-c61c2abd6034",
                                        "entry_id": "63d2e564-f5ae-3274-b29c-1ad0862a520d",
                                        "glosses": [
                                            "To move by hopping."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2e2913-fe1a-470a-bba5-e009b1e975a0",
                                                "sense_id": "db40ab8b-4e62-395d-bbd2-c61c2abd6034",
                                                "text": "As he hopscotched around the world on his Gulfstream IV — he got rid of his homes but kept his private plane — he found himself spending more and more time in Los Angeles, and he also rediscovered his interest in politics and philosophy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8fe5759-6856-34a5-9103-09a5f2d460f1",
                                        "entry_id": "63d2e564-f5ae-3274-b29c-1ad0862a520d",
                                        "glosses": [
                                            "To move back and forth between adjacent patterns by or as if by hopping."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea6c1b9c-a03d-4e52-87bf-6014d875b368",
                                                "sense_id": "d8fe5759-6856-34a5-9103-09a5f2d460f1",
                                                "text": "Although the events described hop-scotch back and forth in time, the story moves along in an orderly fasion ^([sic]) and is rarely rambling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
