                        "glosses": [
                            "излагать объяснения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69122f89-6fb9-467a-8abd-e95a2ad9bcae",
                                "sense_id": "2752fb6a-7bdd-3432-8510-983624660a7f",
                                "text": "Этим объясняется кровопролитность этой войны и продолжительность сражений, длящихся по несколько дней."
                            }
                        ]
                    },
                    {
                        "sense_id": "3360fda4-dace-3cc5-b4f1-98bafba2151d",
                        "entry_id": "3fabc67f-b102-365f-bcee-0333b74bae04",
                        "glosses": [
                            "общаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71866a3-6d17-4ca1-b7f3-e5f876964c36",
                                "sense_id": "3360fda4-dace-3cc5-b4f1-98bafba2151d",
                                "text": "Они с ним объяснялись знаками, и он их понимал, в точности исполнял все приказания, но права свои тоже знал, и уже никто не смел садиться на его место в застолице."
                            }
                        ]
                    }
                ],
