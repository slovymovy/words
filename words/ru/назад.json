{
    "word_family": [
        "задний",
        "сзади",
        "позади",
        "кзади"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "eb92b4d4-4361-37e8-8c7c-a167a673ffd2",
                    "sense_definition": "В сторону, противоположную направлению взгляда или основного движения",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы оглянулись <назад>, чтобы посмотреть на пройденный путь.",
                            "target_lang_translations": {
                                "en": "The tourists looked <back> to see the path they had traveled.",
                                "nl": "De toeristen keken <terug> om de afgelegde weg te bekijken."
                            }
                        },
                        {
                            "text": "Машина медленно поехала <назад>, выезжая из гаража.",
                            "target_lang_translations": {
                                "en": "The car slowly drove <backwards> while leaving the garage.",
                                "nl": "De auto reed langzaam <achteruit> bij het verlaten van de garage."
                            }
                        }
                    ],
                    "synonyms": [
                        "обратно"
                    ],
                    "antonyms": [
                        "вперёд"
                    ],
                    "common_phrases": [
                        "оглянуться назад",
                        "шаг назад",
                        "ни шагу назад"
                    ],
                    "target_lang_definitions": {
                        "en": "Towards the rear or in the direction opposite to the one being faced",
                        "nl": "In de richting tegenovergesteld aan de blikrichting of de hoofdbeweging"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "direction"
                            },
                            {
                                "target_lang_word": "backwards",
                                "target_lang_sense_clarification": "movement in reverse"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "achteruit",
                                "target_lang_sense_clarification": "beweging in achterwaartse richting"
                            },
                            {
                                "target_lang_word": "terug",
                                "target_lang_sense_clarification": "in de richting waar men vandaan kwam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c85246d-1f73-391b-8e07-23871fc3f7c8",
                    "sense_definition": "На прежнее место, туда, где кто-либо или что-либо находилось раньше",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, положи взятую книгу <назад> на полку.",
                            "target_lang_translations": {
                                "en": "Please put the borrowed book <back> on the shelf.",
                                "nl": "Leg het geleende boek alsjeblieft <terug> op de plank."
                            }
                        },
                        {
                            "text": "Я хочу получить свои деньги <назад> как можно скорее.",
                            "target_lang_translations": {
                                "en": "I want to get my money <back> as soon as possible.",
                                "nl": "Ik wil mijn geld zo snel mogelijk <terug> krijgen."
                            }
                        }
                    ],
                    "synonyms": [
                        "обратно"
                    ],
                    "common_phrases": [
                        "вернуть назад",
                        "отдать назад",
                        "прийти назад"
                    ],
                    "target_lang_definitions": {
                        "en": "Returning to a previous place, state, or condition",
                        "nl": "Naar de oorspronkelijke plaats, waar iemand of iets zich eerder bevond"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "return"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "terug",
                                "target_lang_sense_clarification": "naar de eerdere plaats of toestand"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "b60d769a-e28a-30d7-9144-e08eb593c444",
                    "sense_definition": "Указывает на отрезок времени, отделяющий прошлое событие от настоящего момента",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы переехали в этот город пять лет <назад>.",
                            "target_lang_translations": {
                                "en": "We moved to this city five years <ago>.",
                                "nl": "We zijn vijf jaar <geleden> naar deze stad verhuisd."
                            }
                        },
                        {
                            "text": "Всего несколько минут <назад> здесь никого не было.",
                            "target_lang_translations": {
                                "en": "Just a few minutes <ago>, there was no one here.",
                                "nl": "Slechts een paar minuten <geleden> was hier niemand."
                            }
                        }
                    ],
                    "antonyms": [
                        "позже"
                    ],
                    "common_phrases": [
                        "год назад",
                        "давно назад",
                        "неделю назад"
                    ],
                    "target_lang_definitions": {
                        "en": "Before the present time; used to indicate how much time has passed",
                        "nl": "Geeft een tijdsduur aan die een gebeurtenis in het verleden scheidt van het heden"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ago",
                                "target_lang_sense_clarification": "time in the past"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "geleden",
                                "target_lang_sense_clarification": "tijd in het verleden"
                            },
                            {
                                "target_lang_word": "terug",
                                "target_lang_sense_clarification": "informeel voor geleden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e50559fe-a26c-32cd-b8cb-f082d02467c6",
                    "sense_definition": "Приказ отойти в сторону или вернуться на прежнее место",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Офицер громко скомандовал солдатам: «<Назад>!»",
                            "target_lang_translations": {
                                "en": "The officer loudly commanded the soldiers: \"<Back>!\"",
                                "nl": "De officier beval de soldaten luid: \"<Terug>!\""
                            }
                        },
                        {
                            "text": "Эй, <назад>! Туда посторонним вход строго воспрещён.",
                            "target_lang_translations": {
                                "en": "Hey, <get back>! Entry is strictly forbidden for unauthorized personnel.",
                                "nl": "Hé, <achteruit>! Toegang voor onbevoegden is daar ten strengste verboden."
                            }
                        }
                    ],
                    "antonyms": [
                        "вперёд"
                    ],
                    "target_lang_definitions": {
                        "en": "A command to move away or return to a previous position",
                        "nl": "Een bevel om opzij te gaan of terug te keren naar de vorige positie"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "command"
                            },
                            {
                                "target_lang_word": "get back",
                                "target_lang_sense_clarification": "imperative phrase"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "terug",
                                "target_lang_sense_clarification": "bevel om achteruit te gaan"
                            },
                            {
                                "target_lang_word": "achteruit",
                                "target_lang_sense_clarification": "gebiedende wijs om afstand te nemen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}