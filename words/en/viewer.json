{
    "word_family": [
        "view",
        "viewable",
        "viewership",
        "viewpoint",
        "preview",
        "review",
        "interview",
        "overview"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e53b867d-288b-302b-9e78-bb3ab761946f",
                    "sense_definition": "A person who watches television programs or online video content.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "audience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The show attracted millions of <w>viewers</w> during its season finale last night.",
                            "target_lang_translations": {
                                "ru": "Шоу привлекло миллионы <w>зрителей</w> во время финала сезона вчера вечером."
                            }
                        },
                        {
                            "text": "A television <w>viewer</w> might find the constant advertisements quite annoying.",
                            "target_lang_translations": {
                                "ru": "<w>Телезритель</w> может счесть постоянную рекламу довольно раздражающей."
                            }
                        }
                    ],
                    "synonyms": [
                        "watcher",
                        "spectator"
                    ],
                    "common_phrases": [
                        "television viewer",
                        "average viewer",
                        "loyal viewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который смотрит телевизионные программы или видеоконтент в интернете."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зритель",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "телезритель",
                                "target_lang_sense_clarification": "человек, смотрящий ТВ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b024bc9d-9156-388e-b2a7-914492b041b4",
                    "sense_definition": "A person who looks at or inspects something, such as a work of art or a public spectacle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "audience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painting is designed to make the <w>viewer</w> feel a sense of peace.",
                            "target_lang_translations": {
                                "ru": "Картина создана для того, чтобы вызвать у <w>зрителя</w> чувство умиротворения."
                            }
                        },
                        {
                            "text": "Every casual <w>viewer</w> at the gallery stopped to admire the sculpture.",
                            "target_lang_translations": {
                                "ru": "Каждый случайный <w>посетитель</w> галереи останавливался, чтобы полюбоваться скульптурой."
                            }
                        }
                    ],
                    "synonyms": [
                        "onlooker",
                        "spectator",
                        "observer"
                    ],
                    "common_phrases": [
                        "casual viewer",
                        "intended viewer",
                        "gallery viewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который осматривает или изучает что-либо, например, произведение искусства или публичное зрелище."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зритель",
                                "target_lang_sense_clarification": "наблюдатель на выставке или мероприятии"
                            },
                            {
                                "target_lang_word": "посетитель",
                                "target_lang_sense_clarification": "в контексте галерей и музеев"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee936be1-c245-320a-961e-fb3599c83a34",
                    "sense_definition": "A computer program or software tool used to display the contents of a specific file type without editing it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to download a file <w>viewer</w> to open this document format.",
                            "target_lang_translations": {
                                "ru": "Вам нужно скачать <w>программу просмотра</w> файлов, чтобы открыть этот формат документа."
                            }
                        },
                        {
                            "text": "The image <w>viewer</w> allows you to scroll through your photos quickly.",
                            "target_lang_translations": {
                                "ru": "<w>Просмотрщик</w> изображений позволяет быстро пролистывать фотографии."
                            }
                        }
                    ],
                    "synonyms": [
                        "reader"
                    ],
                    "antonyms": [
                        "editor"
                    ],
                    "common_phrases": [
                        "file viewer",
                        "image viewer",
                        "document viewer"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерная программа или инструмент для отображения содержимого файлов определенного типа без возможности редактирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просмотрщик",
                                "target_lang_sense_clarification": "разговорный технический термин"
                            },
                            {
                                "target_lang_word": "программа просмотра",
                                "target_lang_sense_clarification": "официальный технический термин"
                            },
                            {
                                "target_lang_word": "вьюер",
                                "target_lang_sense_clarification": "заимствованный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4d36650-7ecc-371c-9d54-8a4f768ae9db",
                    "sense_definition": "An optical device, often handheld, used for looking at photographic slides or film.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "optical_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He held the slide <w>viewer</w> up to the light to see the old family photos.",
                            "target_lang_translations": {
                                "ru": "Он поднес <w>диаскоп</w> к свету, чтобы рассмотреть старые семейные фотографии."
                            }
                        },
                        {
                            "text": "The antique <w>viewer</w> made the small film strips look much larger.",
                            "target_lang_translations": {
                                "ru": "Старинный <w>прибор для просмотра</w> делал маленькие фотопленки гораздо крупнее."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slide viewer",
                        "handheld viewer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оптическое устройство, часто ручное, используемое для просмотра фотослайдов или пленки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диаскоп",
                                "target_lang_sense_clarification": "прибор для просмотра слайдов"
                            },
                            {
                                "target_lang_word": "вьюер",
                                "target_lang_sense_clarification": "оптическое устройство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa3778d0-8ed2-31f6-997e-ff4cc3979832",
                    "sense_definition": "A person appointed to inspect, examine, or survey something officially.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court appointed a <w>viewer</w> to assess the damage to the property.",
                            "target_lang_translations": {
                                "ru": "Суд назначил <w>осмотрщика</w> для оценки ущерба имуществу."
                            }
                        },
                        {
                            "text": "As an official <w>viewer</w>, his report was essential for the final decision.",
                            "target_lang_translations": {
                                "ru": "Как официальный <w>инспектор</w>, его отчет имел решающее значение для окончательного решения."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspector",
                        "examiner",
                        "surveyor"
                    ],
                    "common_phrases": [
                        "official viewer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in legal or historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, назначенное для официального осмотра, проверки или обследования чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "инспектор",
                                "target_lang_sense_clarification": "официальное лицо"
                            },
                            {
                                "target_lang_word": "осмотрщик",
                                "target_lang_sense_clarification": "лицо, проводящее осмотр"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}