                ],
                "senses": [
                    {
                        "sense_id": "e5b84512-830c-3601-b8b1-a96180336b2a",
                        "entry_id": "8ad3e7bb-b8c1-3e86-970f-4ad89e6eb2ab",
                        "glosses": [
                            "The action of the verb space."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dc4327ce-8b8e-3366-9453-bed4f906b5c6",
                        "entry_id": "8ad3e7bb-b8c1-3e86-970f-4ad89e6eb2ab",
                        "glosses": [
                            "A way in which objects or people are separated by spaces."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc545c9-ccc9-42b3-8e27-0702ecc9616b",
                                "sense_id": "dc4327ce-8b8e-3366-9453-bed4f906b5c6",
                                "text": "The spacing of the desks in the exam hall was intended to prevent candidates from copying each other's work."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5529ad1-4a6c-3c10-882a-ee787043e105",
                        "entry_id": "8ad3e7bb-b8c1-3e86-970f-4ad89e6eb2ab",
                        "glosses": [
                            "The space between two objects or people."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2c1f90f5-f79c-4d3e-91ae-3fb6d8d12d4c",
                                "sense_id": "a5529ad1-4a6c-3c10-882a-ee787043e105",
                                "text": "Put some more spacing between those two words to make them more readable."
                            },
                            {
                                "example_id": "0fa95bfa-b5f6-405d-a8b0-5590be5de5eb",
                                "sense_id": "a5529ad1-4a6c-3c10-882a-ee787043e105",
                                "text": "If you are following a book like Starting Electronics, however, a breadboard is even more useful. […] Differences lie between breadboards in the spacings and the positionings of the holes, and the number of holes in each group."
                            }
                        ]
                    },
                    {
                        "sense_id": "4311bcf2-0b5b-3042-b8da-e9c41af7864a",
                        "entry_id": "8ad3e7bb-b8c1-3e86-970f-4ad89e6eb2ab",
                        "glosses": [
                            "The activity of working or living in outer space; the occupation of a spacer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "db141fd9-2387-4546-bc56-9f679f8bf2ce",
                                "sense_id": "4311bcf2-0b5b-3042-b8da-e9c41af7864a",
                                "text": "He was a laconic old soul who loved spacing only a jot better than he loved Martian alky."
                            },
                            {
                                "example_id": "f726aa33-895c-41e1-b7a9-afcb551d7d03",
                                "sense_id": "4311bcf2-0b5b-3042-b8da-e9c41af7864a",
                                "text": "Shepard: You don't seem too broken up about your partner's death.\nPitne For: Dakni Kur knew the risks when he took to spacing. Right now, my worry is me.\nPitne For: It's unhealthy to be a volus in the Nos Astra spaceport right now. Especially a volus named Pitne For!"
                            }
                        ]
                    }
                ],
