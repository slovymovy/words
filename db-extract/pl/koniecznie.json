                                        "sense_id": "47da8542-fd0e-34ac-b563-c913654db3dd",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "In an absolute or unconditional manner; utterly, positively, wholly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "Independently; viewed without relation to other things or factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c81a4da-f091-4ce0-a15a-9077506450cf",
                                                "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                                "text": "Another characteristic of numbers, which does not concern their mutual relations so much as themselves absolutely, is their ability, according to the ideas of Nicomachus, to conform to geometrical arrangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "As an intensive: extremely, very, indeed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ebdec5-29be-4c20-868f-3073a912b06b",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "But when it came to posing for publicity pictures they proved absolutely brilliant doing just what came naturally."
                                            },
                                            {
                                                "example_id": "c38bfa8f-c587-4bcb-acca-4ede84befecf",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The strength of the mouse is absolutely spectacular for various kinds of issues, until you find out that the mouse has absolutely no extracellular matrix to speak of in his optic nerve head."
                                            },
                                            {
                                                "example_id": "a29e99e0-44ab-4143-98bb-d8995ba39d0f",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The most absolutely terrifying creature lifted her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                        "entry_id": "dafa4a83-cdd1-3e27-bd0c-eb0b7ac7b9bc",
                                        "glosses": [
                                            "Yes, certainly; expression indicating strong agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ac9752-fa44-4cd8-b952-dca657402b56",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Is Bob a good teacher?\nAbsolutely!"
                                            },
                                            {
                                                "example_id": "cd181f96-9d79-4997-b6f4-98a9933b0ae2",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Do you want a free cookie with that coffee?\nAbsolutely!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b751d791-20da-4987-8074-f005326182c5",
                        "source_entry_id": "81cc3b50-a7c5-3b57-a9bb-f22b7fafb3e5",
                        "source_sense_id": "7de27401-3684-37af-ba8f-28a55644644e",
                        "target_lang_word": "necessarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necessarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                        "entry_id": "a235f6aa-322a-3eb3-9b85-6bedeefe0837",
                                        "glosses": [
                                            "Inevitably; of necessity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc75b67-f1d2-4283-b953-7fb4a0795006",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "It is not necessarily true that children get their morals from their parents."
                                            },
                                            {
                                                "example_id": "cdce5b1d-007b-40d1-b345-97f2940540ab",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "But clever cities will not necessarily be better ones."
                                            },
                                            {
                                                "example_id": "05607629-a489-405f-a83c-d7200b806f09",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "Oregon’s uptick in marijuana sales along the Idaho border doesn’t necessarily mean that it’s all Idahoans who are lighting up, Lehner said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6e765b8-2c2d-47a4-9f5b-de67f77a4633",
                        "source_entry_id": "81cc3b50-a7c5-3b57-a9bb-f22b7fafb3e5",
                        "source_sense_id": "7de27401-3684-37af-ba8f-28a55644644e",
                        "target_lang_word": "absolument",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolument",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                        "entry_id": "00178899-b138-3bbd-9f8e-b8516d6ebe5e",
                                        "glosses": [
                                            "D’une manière absolue ; complètement ; tout à fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3629a74e-51dd-4373-b447-10ab6529807f",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "On lit ce livre absolument comme au bord de la cascade on entendrait, rêveur, le gazouillement des eaux."
                                            },
                                            {
                                                "example_id": "380bbfb2-702f-4ea3-8a0e-42b7f1e6d4f4",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                                            },
                                            {
                                                "example_id": "dd4fdb10-ec1b-4f73-8b72-72e34a31e5c9",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "Le Danemark, avec le souci le plus louable de la santé physique et morale de ses sujets, interdit absolument l’importation de l’alcool au Groenland ; […]."
                                            },
                                            {
                                                "example_id": "38d85d15-e781-4413-9f4f-fcd39720c781",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "À ce point de vue le peuplement d’une partie de l'Amérique par les Malayo-Polynésiens est démontré par des preuves anthropologiques, ethnologiques et surtout linguistiques absolument indéniables."
                                            },
                                            {
                                                "example_id": "503bd9cb-75ef-4b0f-ac3a-31a258bb4c76",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "L’industrie moderne, après de nombreuses tentatives, est parvenue à obtenir des aciers dits antirouilles, absolument inoxydables."
                                            },
                                            {
                                                "example_id": "f77e68aa-a90b-4c8a-ab0b-3e62ca694ec5",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "On n'y voyait absolument aucun arbre […] Dont on avait perdu la mémoire, tant elle était absolument passée."
                                            },
                                            {
                                                "example_id": "376b6f0e-c3e8-4c3f-8cd4-717c403a57ec",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "La nécessité de la restitution est un principe universellement reçu, nul ne l’ignore ; mais la pratique de la restitution est une chose presque absolument inconnue."
                                            },
                                            {
                                                "example_id": "b7b3975e-94f3-4f2c-a455-4bad4be6178f",
                                                "sense_id": "f8128921-537f-36d7-a92c-5e34876f24a1",
                                                "text": "Dites absolument que je ne suis qu’un sot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce800edb-17cd-3eb5-8ad7-8fad58758e99",
                                        "entry_id": "00178899-b138-3bbd-9f8e-b8516d6ebe5e",
                                        "glosses": [
                                            "En maître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec13d987-02cd-401d-bf01-7022c23075a3",
                                                "sense_id": "ce800edb-17cd-3eb5-8ad7-8fad58758e99",
                                                "text": "Il dispose absolument de tout dans sa maison."
                                            },
                                            {
                                                "example_id": "61086b86-8096-4dcb-8086-557104b2b6e4",
                                                "sense_id": "ce800edb-17cd-3eb5-8ad7-8fad58758e99",
                                                "text": "Un bailli y jugeait absolument des affaires criminelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da09f0f-1e0e-3f17-a719-39ce5753e2ea",
                                        "entry_id": "00178899-b138-3bbd-9f8e-b8516d6ebe5e",
                                        "glosses": [
                                            "Déterminément, malgré toute opposition et toute remontrance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fba3f9-7e71-497d-a5b4-509dc2c1dd03",
                                                "sense_id": "3da09f0f-1e0e-3f17-a719-39ce5753e2ea",
                                                "text": "Il voulut absolument partir."
                                            },
                                            {
                                                "example_id": "018f5a0a-53b0-4a0a-9ffa-583b4d5b3d7f",
                                                "sense_id": "3da09f0f-1e0e-3f17-a719-39ce5753e2ea",
                                                "text": "Je n'en ferai absolument rien."
                                            },
                                            {
                                                "example_id": "ed39fb24-758a-4d0e-ad0f-559c0a8994cc",
                                                "sense_id": "3da09f0f-1e0e-3f17-a719-39ce5753e2ea",
                                                "text": "Nier absolument."
                                            },
                                            {
                                                "example_id": "43b900b2-3cdb-41d9-b2dd-ba138754ca3f",
                                                "sense_id": "3da09f0f-1e0e-3f17-a719-39ce5753e2ea",
                                                "text": "On eut beau lui dire qu’il ne devait pas partir, il le voulut absolument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370f95f2-388c-3794-8c6b-0a5dd2c41b30",
                                        "entry_id": "00178899-b138-3bbd-9f8e-b8516d6ebe5e",
                                        "glosses": [
                                            "Indispensablement ; à tout prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5359d36-aea0-4e3e-b010-38364f4d1561",
                                                "sense_id": "370f95f2-388c-3794-8c6b-0a5dd2c41b30",
                                                "text": "J'allai trouver M. J. N., agent de change, qui voulait absolument que je jouasse à la baisse, mais je me gardai bien d'écouter ses conseils. J’opérai à 53, et un peu plus tard je réalisai à 62."
                                            },
                                            {
                                                "example_id": "059624d6-477d-4ee6-88ca-3642db5bf440",
                                                "sense_id": "370f95f2-388c-3794-8c6b-0a5dd2c41b30",
                                                "text": "Il faut absolument que vous payiez cette dette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9da41a5-c780-332c-9b0c-75c8f8efb291",
                                        "entry_id": "00178899-b138-3bbd-9f8e-b8516d6ebe5e",
                                        "glosses": [
                                            "Sans restriction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1300e5b7-5375-4f30-97a6-0b2bfd639a45",
                                                "sense_id": "b9da41a5-c780-332c-9b0c-75c8f8efb291",
                                                "text": "La parole du sage est générale, et il ne dit pas seulement quelques justes, mais il dit absolument et sans restriction le juste, quel qu’il soit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                        "entry_id": "00178899-b138-3bbd-9f8e-b8516d6ebe5e",
                                        "glosses": [
                                            "Prendre, employer un mot absolument, c’est employer un mot seul, sans complément, quand il est plus habituel d’en donner un, ou qui est susceptible d’en avoir un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b65954b-70a5-42a7-a412-1fc37678e490",
                                                "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                                "text": "Dans « La statue de la liberté », le mot « liberté » est employé seul, absolument, abstraitement ; alors que dans la phrase : « La constitution garanti la liberté d'expression », le mot est employé concrètement."
                                            },
                                            {
                                                "example_id": "13f781fd-35ba-4588-835e-794510045c23",
                                                "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                                "text": "Dans la phrase : cet arbre ne produit pas, produire est pris absolument."
                                            },
                                            {
                                                "example_id": "7c6cb03e-c9ce-41d0-8a9d-a27b71290ca4",
                                                "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                                "text": "Tel verbe se prend, s’emploie quelquefois absolument."
                                            },
                                            {
                                                "example_id": "85395efd-dc66-4953-9172-bf9250c38a9b",
                                                "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                                "text": "Dans cette phrase : espérer, c’est jouir, les verbes espérer et jouir sont pris absolument."
                                            },
                                            {
                                                "example_id": "54c604f4-4c44-4ec7-a79f-f680524b2394",
                                                "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                                "text": "Dans celle-ci : vivre dans l’abondance le mot abondance est employé absolument pour dire l’abondance des choses nécessaires et agréables à la vie."
                                            },
                                            {
                                                "example_id": "7a075496-4429-4e62-878d-2b5c7202e24d",
                                                "sense_id": "2314167e-cb0e-350b-87ff-9c3b8c803e9a",
                                                "text": "Réunies et présentées par Mary Douglas, une quinzaine de contributions très différentes s’unifient cependant autour d’un thème commun, la consommation de l’alcool — seules deux d’entre elles portent sur le thé et le café —, tant il semble que, côté anglo-saxon, comme côté français d’ailleurs, « boire » employé absolument, sans complément, signifie boire de l’alcool et même en boire beaucoup, l’usage savant rencontrant l’euphémisme populaire qui se suffit de suggérer de tel ou tel : « il boit »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc367c6-fdaa-49d5-8091-d853597ab362",
                        "source_entry_id": "81cc3b50-a7c5-3b57-a9bb-f22b7fafb3e5",
