                    {
                        "translation_id": "a09a0c5e-7f71-4f47-bc80-9d755c27203a",
                        "source_entry_id": "42eeec09-66bd-3394-ba21-2cda4af03e33",
                        "source_sense_description": "branch of science",
                        "target_lang_word": "gérontologie",
                        "target_lang_code": "fr",
