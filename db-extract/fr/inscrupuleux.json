                "senses": [
                    {
                        "sense_id": "598e7614-2a93-3a18-a333-ea828326b902",
                        "entry_id": "9c400aab-6b89-38a8-b69b-edfbdcff2197",
                        "glosses": [
                            "Qui a peu de scrupules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e998ca-8001-40e3-a00d-1cb496ccad1d",
                                "sense_id": "598e7614-2a93-3a18-a333-ea828326b902",
                                "text": "L’abbé de Mably décrit les pratiques immorales et inscrupuleuses d'une curie romaine dans les ténébreux méandres de laquelle d'Ossat a dû naviguer lorsqu'il lui a fallu défendre la cause du roi Henri IV et de son absolution entre 1594 et 1595."
                            },
                            {
                                "example_id": "ef238fbd-7012-4c22-afe8-8c490b76b060",
                                "sense_id": "598e7614-2a93-3a18-a333-ea828326b902",
                                "text": "Je perdais Elinor, je la perdais définitivement dans ces épousailles avec cet homme inscrupuleux !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "443b853c-1ff9-474b-a2a4-59931b70dad1",
                        "source_entry_id": "9c400aab-6b89-38a8-b69b-edfbdcff2197",
                        "source_sense_id": "598e7614-2a93-3a18-a333-ea828326b902",
                        "target_lang_word": "skrupellos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skrupellos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                        "entry_id": "49d772bb-2faa-3bf6-93b2-29f1d6731604",
                                        "glosses": [
                                            "keinerlei Hemmungen für etwaige Schandtaten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4576732a-28e0-4f75-8c1e-4d3e23bd0b5d",
                                                "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                                "text": "Du bist vielleicht skrupellos!"
                                            },
                                            {
                                                "example_id": "55f9ac79-75e4-479b-b471-970693afe716",
                                                "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                                "text": "„Sie wäre aber nicht verwunderlich bei einer Crew, die skrupellos eine gesamte Besatzung kidnappt und in eigene Dienste zwingt.“"
                                            },
                                            {
                                                "example_id": "9ab9be80-67e3-4ce9-87df-79f4ca37adf3",
                                                "sense_id": "a01a12b5-575e-30a3-978c-d24f1e45c25c",
                                                "text": "„Ohne Frage war er machtbewusst, skrupellos und visionär.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53febf5-a734-4803-85c2-d9fe123a05db",
                        "source_entry_id": "9c400aab-6b89-38a8-b69b-edfbdcff2197",
                        "source_sense_id": "598e7614-2a93-3a18-a333-ea828326b902",
