                {
                    "sense_id": "8509f502-c671-3225-87b7-cae0fcf4e261",
                    "sense_definition": "Iets doen tot het bedoelde resultaat helemaal is bereikt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "perfect_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar <w>volkomt</w> zijn werk met uiterste precisie.",
                            "target_lang_translations": {
                                "ru": "Художник <w>совершенствует</w> свою работу с предельной точностью.",
                                "en": "The artist <w>perfects</w> his work with extreme precision.",
                                "fr": "L'artiste <w>parfait</w> son œuvre avec une extrême précision."
                            }
                        },
                        {
                            "text": "Hij <w>volkwam</w> de opdracht zoals van hem verwacht werd.",
                            "target_lang_translations": {
                                "ru": "Он <w>выполнил</w> задание так, как от него ожидалось.",
                                "en": "He <w>completed</w> the assignment as was expected of him.",
                                "fr": "Il <w>accomplit</w> la mission comme on l'attendait de lui."
                            }
                        }
                    ],
                    "traits": [
                        {
