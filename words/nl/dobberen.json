{
    "word_family": [
        "dobber",
        "gedobber"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1857dc6e-3122-3aa8-8bd8-cc8caef2fcbe",
                    "sense_definition": "Op het water drijven en rustig op en neer bewegen op de golven, vaak zonder duidelijke richting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleine houten bootjes <w>dobberen</w> rustig in de haven.",
                            "target_lang_translations": {
                                "en": "The small wooden boats are gently <w>bobbing</w> in the harbor."
                            }
                        },
                        {
                            "text": "Hij heeft urenlang op het water <w>gedobberd</w> voor er eindelijk hulp kwam.",
                            "target_lang_translations": {
                                "en": "He <w>drifted</w> on the water for hours before help finally arrived."
                            }
                        }
                    ],
                    "synonyms": [
                        "drijven",
                        "deinen"
                    ],
                    "antonyms": [
                        "zinken"
                    ],
                    "common_phrases": [
                        "op het water dobberen",
                        "rustig dobberen"
                    ],
                    "target_lang_definitions": {
                        "en": "To float on water and move gently up and down on the waves, often without a clear direction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bob",
                                "target_lang_sense_clarification": "to move up and down on water"
                            },
                            {
                                "target_lang_word": "float",
                                "target_lang_sense_clarification": "to rest on the surface of water"
                            },
                            {
                                "target_lang_word": "drift",
                                "target_lang_sense_clarification": "to float aimlessly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df925094-3e56-3b96-8354-0319d9ac7a09",
                    "sense_definition": "Al dobberend en zonder actieve besturing ergens naartoe drijven of terechtkomen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "drijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lege fles is uiteindelijk naar de kust <w>gedobberd</w>.",
                            "target_lang_translations": {
                                "en": "The empty bottle eventually <w>drifted</w> to the shore."
                            }
                        },
                        {
                            "text": "Zonder motor is het schip langzaam naar de overkant <w>gedobberd</w>.",
                            "target_lang_translations": {
                                "en": "Without an engine, the ship slowly <w>drifted</w> to the other side."
                            }
                        }
                    ],
                    "synonyms": [
                        "aandrijven",
                        "afdrijven"
                    ],
                    "common_phrases": [
                        "naar de kant dobberen"
                    ],
                    "target_lang_definitions": {
                        "en": "To drift or end up somewhere while floating, without active steering."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drift",
                                "target_lang_sense_clarification": "to be carried along by currents or wind"
                            },
                            {
                                "target_lang_word": "float",
                                "target_lang_sense_clarification": "to move slowly on water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}