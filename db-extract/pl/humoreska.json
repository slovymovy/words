                        "glosses": [
                            "krótkie opowiadanie o zabawnym zdarzeniu, zwykle zamknięte dowcipną puentą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c752f13a-15f4-4321-a9c3-ca2f9eeb784f",
                                "sense_id": "fa5bc9a1-372f-3155-9f42-f0aa467b694c",
                                "text": "Ta humoreska jest naprawdę zabawna."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "37820f7c-3685-352c-a3dd-32d5b39fcaa2",
                        "entry_id": "f6d3f451-9c4a-399b-ae81-7c376fa32954",
                        "glosses": [
                            "miniatura instrumentalna powstała w okresie romantyzmu, przeważnie o żartobliwym charakterze, zbliżona do scherza lub capriccia"
                        ],
                        "tags": [],
