                ],
                "senses": [
                    {
                        "sense_id": "da4ca38b-0851-36a0-bf2b-7a23da28a213",
                        "entry_id": "814ebbca-e5ad-316a-8d30-68d3e013c421",
                        "glosses": [
                            "Graphem (Schriftzeichen), das zur schriftlichen Wiedergabe von Vokalen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ebe64fc-83c6-445c-89de-ac9d6981c737",
                                "sense_id": "da4ca38b-0851-36a0-bf2b-7a23da28a213",
                                "text": "„Soll ein größerer Wortschatz erfasst werden, zu dem viele Eigennamen und Fremdwörter gehören, so braucht man weitere Grapheme, etwa das Vokalgraphem ⟨y⟩ und das Konsonantengraphem ⟨c⟩.“"
                            },
                            {
                                "example_id": "827e6c93-91d2-49d2-9382-26819c5d5543",
                                "sense_id": "da4ca38b-0851-36a0-bf2b-7a23da28a213",
                                "text": "„Das Operieren mit nur einer Reihe von Vokalgraphemen für den Kern der Schreibsilbe läßt vermuten, daß Korrelate zu Silbenschnitteigenschaften besonderer Kodierung bedürfen.“"
                            },
                            {
                                "example_id": "b89ac5b0-8627-49b1-8d6b-754d9725e524",
                                "sense_id": "da4ca38b-0851-36a0-bf2b-7a23da28a213",
                                "text": "„Ein Dehnungszeichen (Längenzeichen) ist ein auf ein Vokalgraphem (Vokalbuchstaben) bezogenes zusätzliches Graphem oder graphematisches Merkmal (z. B. ein diakritisches Zeichen), das anzeigt, dass ein Vokal lang gesprochen wird.“"
                            },
                            {
                                "example_id": "1468505a-c247-4676-8493-9b3bc473001b",
                                "sense_id": "da4ca38b-0851-36a0-bf2b-7a23da28a213",
                                "text": "„Aus dieser Silbenschrift entstand eine reine Konsonatenschrift, deren Mitlautbuchstaben (Konsonantengrapheme) allmählich um Buchstaben für Selbstlaute (Vokalgrapheme) ergänzt wurden.“"
                            },
                            {
                                "example_id": "a8e0c53d-1c8d-4bcb-885f-8577d4beeef6",
                                "sense_id": "da4ca38b-0851-36a0-bf2b-7a23da28a213",
                                "text": "„Während routinierte Leser dies unbewusst nutzen, kann es Leseanfängern als Hilfe dienen, wenn Texte entsprechend gestaltet werden – zum Beispiel mit einer besonderen Schriftart für Vokalgrapheme und zusätzlichen Abständen an den Silbengrenzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
