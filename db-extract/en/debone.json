                        "source_entry_id": "b35d23d5-ae00-3e04-99fb-95f439991778",
                        "source_sense_id": "189ab4a0-37c9-3018-b460-c94423aa3b31",
                        "source_sense_description": "remove the bones from something",
                        "target_lang_word": "désosser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désosser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30973046-d550-3b77-8ae3-796d921dbe75",
                                        "entry_id": "3a548619-4c58-3c5a-a248-31d6642efdae",
                                        "glosses": [
                                            "Dégarnir un animal de ses os, par exemple quand on veut mettre sa chair en pâté ou la remplir d’un hachis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e30e88-400b-4daf-8180-21ea615118f9",
                                                "sense_id": "30973046-d550-3b77-8ae3-796d921dbe75",
                                                "text": "Je vais désosser le poulet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da3aeb5-797c-330c-8e51-a1171c475f1a",
                                        "entry_id": "3a548619-4c58-3c5a-a248-31d6642efdae",
                                        "glosses": [
                                            "Démonter, mettre en morceaux quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "789645fa-bc3e-4cc2-bc10-3dfe1c815ef1",
                                                "sense_id": "8da3aeb5-797c-330c-8e51-a1171c475f1a",
                                                "text": "La casse, avec ses épaves que l’on désosse sans toujours bien savoir comment s’y prendre, […]"
                                            },
                                            {
                                                "example_id": "dc59b750-09bd-4552-a559-dc8cffa2d4ab",
                                                "sense_id": "8da3aeb5-797c-330c-8e51-a1171c475f1a",
                                                "text": "Après avoir totalement désossé l'engin, j'avais savamment vidé le pot d'échappement en supprimant les chicanes et adapté un carburateur récupéré sur la vieille mobylette d'un copain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45f90aeb-1d4f-3cdd-aeb0-123a9ca63c8a",
                                        "entry_id": "3a548619-4c58-3c5a-a248-31d6642efdae",
                                        "glosses": [
                                            "Retirer une partie de la consistance d’un projet de texte législatif."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04292157-8dda-4418-be62-fadda5429655",
                                                "sense_id": "45f90aeb-1d4f-3cdd-aeb0-123a9ca63c8a",
                                                "text": "Nous essaierons donc d’obtenir de M. Millerand qu’il retire son projet et, s’il n’y consent pas, nous nous efforcerons de désosser le texte à coup d’amendements. Note : Aujourd’hui, le vocabulaire ayant évolué, on parle plus souvent de de détricoter quand il s’agit d’un projet de loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dc5b896-cd94-3c11-afdf-3228a900c4b8",
                                        "entry_id": "3a548619-4c58-3c5a-a248-31d6642efdae",
                                        "glosses": [
                                            "Démolir complètement dans une bagarre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e05eda60-9cf7-4935-af1a-72a45ec40484",
                                                "sense_id": "2dc5b896-cd94-3c11-afdf-3228a900c4b8",
                                                "text": "Nous provoquâmes une rixe et mal nous en prit; nous fûmes rossés. Nous nous retirâmes désossés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
