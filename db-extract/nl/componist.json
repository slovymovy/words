                "translations": [
                    {
                        "translation_id": "dcb53510-3fa5-4991-8e52-576f59486500",
                        "source_entry_id": "e4acf0ae-f17a-3bdb-9c3c-a840ed3f6253",
                        "source_sense_id": "3a7c384a-042d-30f9-97b1-9e3b82d3620c",
                        "source_sense_description": "iemand die muziekstukken schrijft",
                        "target_lang_word": "Komponist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komponist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                        "entry_id": "b9e62cb7-1475-3f4d-ac6e-7d8f62067c97",
                                        "glosses": [
                                            "Künstler, der musikalische Werke schafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa22c97-fd95-4774-8f80-0384f6a10a5d",
                                                "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                                "text": "Mozart und Beethoven waren bekannte Komponisten."
                                            },
                                            {
                                                "example_id": "8367d597-8776-47c0-8280-268c9c365ea9",
                                                "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                                "text": "„Liszt stand als Pianist auf dem Zenit seines Ruhms, doch war er den Ansprüchen, die er an sich als Komponist stellte, in den letzten Jahren vieles schuldig geblieben.“"
                                            },
                                            {
                                                "example_id": "d6207d43-e2aa-4d14-b209-e62c8843e5ed",
                                                "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                                "text": "„Im Jahr 1710 holten die barocken Welfenfürsten einen der berühmtesten Komponisten seiner Zeit in ihre Residenzhauptstadt - Georg Friedrich Händel.“"
                                            },
                                            {
                                                "example_id": "13b74e38-cc34-44c2-81fa-e33cc41dde0f",
                                                "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                                "text": "„Später fügt der Komponist dies als Effekt in das Stück ein, das in den kommenden Jahren seinen Siegeszug durch alle deutschen Militärparaden antritt.“"
                                            },
                                            {
                                                "example_id": "c961a723-5c62-405f-8039-4c781ec8694d",
                                                "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                                "text": "„Trotzdem ist Hoffmann weit davon entfernt zu klagen, er ist froh, seine Kunst vor einem Publikum ausüben zu können, dessen Gunst er als Komponist sehr viel mehr erwirbt denn als Kapellmeister.“"
                                            },
                                            {
                                                "example_id": "db253c23-bd97-4e64-a89b-69fd8354cc32",
                                                "sense_id": "bf4933fc-c825-352a-b5d3-4f365f132a28",
                                                "text": "„Henry Purcell war der führende englische Komponist des 17. Jahrhunderts. Er schrieb Meisterwerke wie die Oper „Dido and Aeneas“.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1619044b-881d-4e6b-964d-3637c901c920",
