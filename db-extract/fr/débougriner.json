                "senses": [
                    {
                        "sense_id": "2de81b7d-44ca-394a-8340-59a496bd2b84",
                        "entry_id": "d98b5482-a437-3c28-b631-6dcc876fa0e5",
                        "glosses": [
                            "Enlever ses vêtements d’extérieur."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "d84cc0bb-1e29-4984-a974-eadbab36a502",
                                "sense_id": "2de81b7d-44ca-394a-8340-59a496bd2b84",
                                "text": "Excusez-moi, je… je vous ai même pas offert de vous débougriner. Donnez-moi vos manteaux pis prenez place."
                            },
                            {
                                "example_id": "9fb3f5bf-8259-46ff-a324-ceb59b43731c",
                                "sense_id": "2de81b7d-44ca-394a-8340-59a496bd2b84",
                                "text": "« Vous avez vu ce qu’il m’a offert pour Noël ? » avait lancé la plus jeune de mes tantes avant de se débougriner pour un réveillon."
                            },
                            {
                                "example_id": "37c13abf-9856-4f4a-917e-31397f455930",
                                "sense_id": "2de81b7d-44ca-394a-8340-59a496bd2b84",
                                "text": "À l’intérieur, se débougriner."
                            }
                        ]
                    }
