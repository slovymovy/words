                "senses": [
                    {
                        "sense_id": "a5845a45-a79c-3774-8449-898bc17900b5",
                        "entry_id": "cda86817-4498-31b0-b5a8-a9c0542d56d7",
                        "glosses": [
                            "einfaches, preisgünstiges Hotel"
