                "senses": [
                    {
                        "sense_id": "f9f62c46-057a-3e0b-8611-12a48aa38cbb",
                        "entry_id": "ac9adbb3-9d12-3df9-88aa-b135fb05cf6c",
                        "glosses": [
                            "urzędnik zarządzający grodem, zamkiem lub kasztelanią"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa9d43d-eb7e-4e63-93d3-cff17642ccb1",
                                "sense_id": "f9f62c46-057a-3e0b-8611-12a48aa38cbb",
                                "text": "W zamian nowy kasztelan zobowiązał się co roku łożyć na remont i konserwację zabytku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d9c61060-1bb1-3f69-b3fd-3893a7e871f6",
                        "entry_id": "ac9adbb3-9d12-3df9-88aa-b135fb05cf6c",
                        "glosses": [
                            "w średniowiecznej Polsce urzędnik ziemski zasiadający w radzie królewskiej, następnie w senacie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0635f7cc-a04c-4292-ac4d-d2250390026b",
                        "source_entry_id": "ac9adbb3-9d12-3df9-88aa-b135fb05cf6c",
                        "source_sense_id": "f9f62c46-057a-3e0b-8611-12a48aa38cbb",
                        "target_lang_word": "castellan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "castellan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4978a61-dfdf-3157-809a-797c887a5f6f",
                                        "entry_id": "fca1876e-13a4-35a1-bfc5-89df47bd4eb9",
                                        "glosses": [
                                            "A feudal lord with a fortified manor."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "805813e0-accb-3c1e-8463-b9995acf5fb3",
                                        "entry_id": "fca1876e-13a4-35a1-bfc5-89df47bd4eb9",
                                        "glosses": [
                                            "The governor or caretaker entrusted to oversee a castle or keep for its lord."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0986b295-951e-4720-9d2f-e461d08ae5e6",
                                                "sense_id": "805813e0-accb-3c1e-8463-b9995acf5fb3",
                                                "text": "The inferior secular senators are ninety-two, containing the ten crown-officers, and eighty-two castellans. The latter are again divided into thirty-three great castellans, and forty-nine little castellans."
                                            },
                                            {
                                                "example_id": "91ba7d8e-e972-417f-9a14-8121dd7c7dda",
                                                "sense_id": "805813e0-accb-3c1e-8463-b9995acf5fb3",
                                                "text": "Castellans, often exercising control over a few villages and half a dozen small lordships, transformed their banal lordships into quasi-sovereign mini-states, independent of royal or comital sanction or control."
                                            },
                                            {
                                                "example_id": "8c0e5a1e-b7e1-41e5-bbda-7895df24954a",
                                                "sense_id": "805813e0-accb-3c1e-8463-b9995acf5fb3",
                                                "text": "The wave of attacks on the castellans in 1511 followed faction-fighting in Udine, in which castellans and their families were massacred by supporters of the Savorgnan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
