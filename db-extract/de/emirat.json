                                "example_id": "c3b89ff7-26a6-483f-a62a-f58aa3420dbf",
                                "sense_id": "426a053b-42e4-354e-bc73-2cd80fc9f9af",
                                "text": "„Bis 2013 gab es kein einziges funktionierendes Solarkraftwerk in den Emiraten.“"
                            }
