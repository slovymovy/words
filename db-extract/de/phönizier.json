                "senses": [
                    {
                        "sense_id": "21945d75-0f09-3b51-810c-78929a50cfba",
                        "entry_id": "298c9086-c560-3318-b885-c9f480bc1ac3",
                        "glosses": [
                            "Bewohner von Phönizien"
                        ],
                        "tags": [
                            "Antike"
                        ],
                        "examples": [
                            {
                                "example_id": "74925e08-ae0b-40e4-a2c0-61df077f0f8c",
                                "sense_id": "21945d75-0f09-3b51-810c-78929a50cfba",
                                "text": "„Die Phönizier landen um 800 vor Christus hier, später die Römer, denen der Landstrich jahrhundertelang als Kornkammer dient.“"
                            },
                            {
                                "example_id": "ff017267-0173-4602-9753-78b54ef19648",
                                "sense_id": "21945d75-0f09-3b51-810c-78929a50cfba",
                                "text": "„Wie schon tausend Jahre zuvor bleiben die Phönizier ihrer Seefahrer- und Händlertradition treu und dehnten nun den Handel auf den gesamten Mittelmeerraum bis nach Spanien und Gibraltar aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cae57e2-b738-43a6-a022-b807deb01585",
                        "source_entry_id": "298c9086-c560-3318-b885-c9f480bc1ac3",
                        "source_sense_id": "21945d75-0f09-3b51-810c-78929a50cfba",
                        "source_sense_description": "Antike: Bewohner von Phönizien",
                        "target_lang_word": "Φοίνικες",
