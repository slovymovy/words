                "senses": [
                    {
                        "sense_id": "9437c925-3a18-3955-9679-8dfe81bf89c5",
                        "entry_id": "49d6cd78-8ea8-3ab1-98cb-356af2a8f4c1",
                        "glosses": [
                            "spezielle Stiefel zum Reiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e095b8f2-81ea-4afd-a2d3-9c4188102933",
                                "sense_id": "9437c925-3a18-3955-9679-8dfe81bf89c5",
                                "text": "Die Reitstiefel gehören neben der Reitkappe und der Reithose zur Grundausstattung eines Reitschülers."
                            },
                            {
                                "example_id": "18d1b762-f44a-4a8f-8230-a5525ab1ed42",
                                "sense_id": "9437c925-3a18-3955-9679-8dfe81bf89c5",
                                "text": "„Und das immerhin ergibt einen Sinn: So elegante und wohlerhaltene Reitstiefel besitzt keiner dieser Kavalleristen.“"
                            },
                            {
                                "example_id": "49401ef2-17e4-4da3-abfc-a6a914f555ae",
                                "sense_id": "9437c925-3a18-3955-9679-8dfe81bf89c5",
                                "text": "„In diesem Zimmer stand ein kleiner, dicker, etwa dreissigjähriger Mann in weissen Hosen, Reitstiefeln und einem offenbar eben erst angezogenen Batisthemde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
