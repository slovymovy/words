                                    },
                                    {
                                        "sense_id": "b5dc4d5f-d6c6-35f6-875e-45f9b039a570",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "Le fût d’une colonne."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68357ba6-0845-3c9d-8167-0349a9bda51d",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "La partie longue et cylindrique d’une clef, qui est entre l’anneau et le panneton."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2c54874-c28e-3ccc-9374-cef5c0c5d6aa",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "La partie d’un flambeau qui prend depuis le pied jusqu’à la bobèche."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b0f26f6-66a9-35b6-be91-249a8dad0765",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "La partie d’un guéridon qui prend depuis le pied jusqu’à la tablette."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae6af556-755d-37b3-8ea7-d7de80693c34",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "Manche d’une canne."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "526abba9-1945-328a-aeea-8c1d640c5d89",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "La partie de la botte qui surmonte l’empeigne et enveloppe la jambe."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc7a232-e0a5-4c39-a826-a6a52a87a11b",
                                                "sense_id": "526abba9-1945-328a-aeea-8c1d640c5d89",
                                                "text": "Au bruit de leurs lourds sabots, à tiges de toile bise, les marins dévalaient par groupes, le dos courbé sous le poids de leurs filets ; […]."
                                            },
                                            {
                                                "example_id": "f8c9ded4-d5da-46c4-9a5b-e571db76fa80",
                                                "sense_id": "526abba9-1945-328a-aeea-8c1d640c5d89",
                                                "text": "Son pantalon à grand pont, éraillé aux boutonnières et bombé aux genoux, s’arrêtait à mi-jambe sur la tige d’une forte botte dont le cuir ne ployait pas"
                                            },
                                            {
                                                "example_id": "8c4f0b8d-e5b4-440d-9532-c28edc74b5f7",
                                                "sense_id": "526abba9-1945-328a-aeea-8c1d640c5d89",
                                                "text": "Il laissa le moulin à son frère et apprit le métier de cordonnier. Dès qu’il sut distinguer la semelle de la tige, il s’installa pour son compte."
                                            },
                                            {
                                                "example_id": "fca9776c-bfe5-4ae0-bdc1-018cd2f4ed28",
                                                "sense_id": "526abba9-1945-328a-aeea-8c1d640c5d89",
                                                "text": "Un pantalon d’habit, raide et lisse, n’était-il pas préférable à de ridicules tuyaux de poêle, parfois trop courts, cachant à peine les chaussettes et la tige disgracieuse des souliers neufs insuffisamment imprégnés de cirage, parfois trop longs, et vrillant alors en larges rides, comme une défroque de saltimbanque ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06f3f61-c2a3-3d16-a68f-d38fce961357",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Partie allongée de diverses choses.",
                                            "Barre métallique, souvent par paire, faisant partie du rig d'une caméra, servant à fixer certains équipements tels qu'un follow focus, un moteur de point ou un support pour batteries."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c656f5d8-ccab-35b5-8be9-733ddb06c8a4",
                                        "entry_id": "7640186b-68aa-34ef-8670-2777d62175c0",
                                        "glosses": [
                                            "Cigarette."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4b0c71-f0f9-4e53-8aec-6bb75237ad39",
                                                "sense_id": "c656f5d8-ccab-35b5-8be9-733ddb06c8a4",
                                                "text": "Ça te tente-tu de revenir ? l'interrompit Maria d'une voix rauque qui trahissait une forte consommation de tiges de huit."
                                            },
                                            {
                                                "example_id": "1c6b1af0-ee4d-42b1-8b7e-13ac6817947d",
                                                "sense_id": "c656f5d8-ccab-35b5-8be9-733ddb06c8a4",
                                                "text": "La cueillette n'a pas été très fructueuse. Les bouts de cigarettes deviennent de plus en plus courts. Tout ça à cause des filtres. Si ça continue, les gens vont fumer leurs « tiges » jusqu’au coton hydrophile (dit tampax dans le jargon populaire)."
                                            },
                                            {
                                                "example_id": "9b462898-c17f-4d39-9777-39566534f401",
                                                "sense_id": "c656f5d8-ccab-35b5-8be9-733ddb06c8a4",
                                                "text": "Au sol, mon sac gît entrouvert, et là, tout au fond, je peux apercevoir mon paquet de tiges."
                                            }
                                        ]
                                    }
