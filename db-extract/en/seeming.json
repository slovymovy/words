                "senses": [
                    {
                        "sense_id": "4df50e24-7d12-3474-af24-833d7922d27f",
                        "entry_id": "e90deacf-5267-339a-bd55-160a7dcc86b9",
                        "glosses": [
                            "Outward appearance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56eef816-3fd4-4072-a689-7425c07f5d26",
                                "sense_id": "4df50e24-7d12-3474-af24-833d7922d27f",
                                "text": "My loue is strengthned though more weake in seeming\n I loue not lesse, thogh lesse the show appeare,"
                            },
                            {
                                "example_id": "6098c795-a562-4892-ae99-5ceac57d51a1",
                                "sense_id": "4df50e24-7d12-3474-af24-833d7922d27f",
                                "text": "And his eyes have all the seeming of a demon’s that is dreaming"
                            },
                            {
                                "example_id": "4fa21df3-3bae-4c87-8156-b7300b8a9335",
                                "sense_id": "4df50e24-7d12-3474-af24-833d7922d27f",
                                "text": "I am not what I seemed to her, he thought, and doubtless she is not what she seemed to me, but it is our lot to be irrevocably condemned to seemings and to deserve them too."
                            }
                        ]
                    },
                    {
                        "sense_id": "76d10d31-a5d9-3fc7-b269-fe9bd2d1da86",
                        "entry_id": "e90deacf-5267-339a-bd55-160a7dcc86b9",
                        "glosses": [
                            "Apprehension; judgement."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ccb1abb-e7c3-445c-a898-b1921b1c26ec",
                                "sense_id": "76d10d31-a5d9-3fc7-b269-fe9bd2d1da86",
                                "text": "Nothing more cleare vnto their seeming, then that a new Jerusalem being often spoken of in Scripture, they vndoubtedly were themselues that newe Ierusalem,"
                            },
                            {
                                "example_id": "88fed9ca-66b6-4752-bf11-a48073c40038",
                                "sense_id": "76d10d31-a5d9-3fc7-b269-fe9bd2d1da86",
                                "text": "[…] in her ears the sound\nYet rung of his perswasive words, impregn’d\nWith Reason, to her seeming, and with Truth;"
                            }
                        ]
                    }
                ],
