                        "sense_id": "dfee7232-f8c2-3f51-bb0b-c6dbeb8b5b6a",
                        "entry_id": "acf505b0-3494-373e-b902-36f51c4f2d9b",
                        "glosses": [
                            "To cheer, applaud"
                        ],
                        "tags": [
                            "ambitransitive",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3e0a7762-d292-4c6b-a1a4-a0d4cc3509b1",
                                "sense_id": "dfee7232-f8c2-3f51-bb0b-c6dbeb8b5b6a",
                                "text": "...the people clapped and vivaed, groaned and hooted, as they were pleased or disappointed, until at length the intense excitement began to subside..."
                            },
                            {
                                "example_id": "e550c184-9169-45ff-96e9-1e6b0598b1d1",
                                "sense_id": "dfee7232-f8c2-3f51-bb0b-c6dbeb8b5b6a",
                                "text": "The next evening Paine went to the theatre. The state-box had been prepared for him. The house rose and vivaed as he entered."
                            },
                            {
                                "example_id": "11bfa46f-a76d-4ae6-8497-e2e6402f494e",
                                "sense_id": "dfee7232-f8c2-3f51-bb0b-c6dbeb8b5b6a",
                                "text": "...did you not hear how the beasts last night were cheering and vivaing those French heretics?"
                            }
                        ]
                    }
                ],
