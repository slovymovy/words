    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4306c952-04b6-30d6-8b64-c587274e0db6",
                    "sense_definition": "A story or narrative, often describing imaginary or exciting events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children sat on the rug and listened to a fairy <w>tale</w>.",
                            "target_lang_translations": {
                                "ru": "Дети сидели на ковре и слушали волшебную <w>сказку</w>.",
                                "zh": "孩子们坐在地毯上，听着一个<w>童话</w>。"
                            }
                        },
                        {
                            "text": "He told us a fascinating <w>tale</w> about his travels in the jungle.",
                            "target_lang_translations": {
                                "ru": "Он поведал нам увлекательную <w>историю</w> о своих путешествиях по джунглям.",
                                "zh": "他给我们讲了一个关于他在丛林中旅行的迷人<w>故事</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "story",
                        "narrative",
                        "yarn",
                        "account"
                    ],
                    "common_phrases": [
                        "fairy tale",
                        "folk tale",
                        "tall tale",
                        "tell a tale"
                    ],
                    "target_lang_definitions": {
                        "ru": "История или повествование, часто описывающее вымышленные или захватывающие события.",
                        "zh": "指故事或叙述，通常描述虚构或激动人心的事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассказ",
                                "target_lang_sense_clarification": "повествование"
                            },
                            {
                                "target_lang_word": "история",
                                "target_lang_sense_clarification": "случай из жизни"
                            },
                            {
                                "target_lang_word": "сказка",
                                "target_lang_sense_clarification": "волшебная история"
                            },
                            {
                                "target_lang_word": "сказание",
                                "target_lang_sense_clarification": "легенда, предание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "故事",
                                "target_lang_sense_clarification": "叙述性的事件"
                            },
                            {
                                "target_lang_word": "童话",
                                "target_lang_sense_clarification": "儿童文学中的虚构故事"
                            },
                            {
                                "target_lang_word": "传说",
                                "target_lang_sense_clarification": "民间流传的叙事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "125be562-19ec-38ec-9d7b-bb7369d35ef2",
                    "sense_definition": "A malicious story, piece of gossip, or a lie, often told to cause trouble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the students not to tell <w>tales</w> about each other.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников не распускать <w>сплетни</w> друг о друге.",
                                "zh": "老师要求学生们不要互相散布<w>闲话</w>。"
                            }
                        },
                        {
                            "text": "She was upset because someone had spread a false <w>tale</w> about her.",
                            "target_lang_translations": {
                                "ru": "Она была расстроена, потому что кто-то распустил о ней лживую <w>сплетню</w>.",
                                "zh": "她很难过，因为有人散布了关于她的虚假<w>流言</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lie",
                        "gossip",
                        "rumor",
                        "fib"
                    ],
                    "antonyms": [
                        "fact",
                        "truth"
                    ],
                    "common_phrases": [
                        "tell tales"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злонамеренная история, сплетня или ложь, часто распространяемая с целью доставить неприятности.",
                        "zh": "指恶意的故事、流言蜚语或谎言，通常是为了制造麻烦而散布的。"
                    },
                    "translations": {
                        "ru": [
