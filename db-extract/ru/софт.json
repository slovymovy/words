                                "target_senses": [
                                    {
                                        "sense_id": "7f61bcba-d13a-303e-aca0-31c2a7015f20",
                                        "entry_id": "f7329814-fc65-3ccc-87f0-8a4b6884fde7",
                                        "glosses": [
                                            "software, oprogramowanie"
                                        ],
                                        "tags": [
                                            "środ."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7236d1-c210-490d-b92c-ce1cfe95e363",
                                                "sense_id": "7f61bcba-d13a-303e-aca0-31c2a7015f20",
                                                "text": "Muszę ściągnąć sobie jakiś soft do obróbki zdjęć."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f26aa34-f1e5-4fc4-8844-cc400357834b",
                        "source_entry_id": "1f7a33eb-aa52-3d8b-a7e7-1c4c555ecd76",
                        "source_sense_id": "29ad9e1b-3844-3946-b3f9-c91d55088b6a",
                        "target_lang_word": "logiciel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "logiciel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46343d28-63f9-32e8-8429-b8b9e9a0414a",
                                        "entry_id": "39fb52b6-37d3-3571-83ad-3dd27a0dc5c1",
                                        "glosses": [
                                            "Qui concerne les aspects logiques d’un ordinateur ou d’un système de traitement de l’information, par opposition aux aspects matériels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24d620b-da6b-4038-b9ea-6601e44f038b",
                                                "sense_id": "46343d28-63f9-32e8-8429-b8b9e9a0414a",
                                                "text": "L’omission d’Android 12 est due au fait que le processeur Qualcomm Snapdragon 632 ne supporte pas officiellement les nouvelles versions d’Android, ce qui a augmenté la charge de travail de l’équipe logicielle de Fairphone."
                                            },
                                            {
                                                "example_id": "e2ac00e8-7151-479a-b6e2-ec0a1d9c664f",
                                                "sense_id": "46343d28-63f9-32e8-8429-b8b9e9a0414a",
                                                "text": "Il faudra réfléchir à l’architecture matérielle, mais aussi à l’architecture logicielle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "logiciel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6deca7b-2793-3b32-9887-3919b7855f20",
                                        "entry_id": "c9363af2-ecaa-35c1-82ef-6fd5c564b027",
                                        "glosses": [
                                            "Ensemble de programmes, procédés et règles d’un système de traitement informatique des données."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9c0d453-73c4-3c25-b325-89ff37af1347",
                                        "entry_id": "c9363af2-ecaa-35c1-82ef-6fd5c564b027",
                                        "glosses": [
                                            "Programme informatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b402a59-61f1-4c5b-ae93-123e3c74cf3b",
                                                "sense_id": "b9c0d453-73c4-3c25-b325-89ff37af1347",
                                                "text": "Lors d'une exécution automatique, si un logiciel malicieux est détecté, le prochain administrateur qui se loguera sur le système sera notifié par un message dans la zone de notification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c230d4ae-1b95-37ba-8281-40acb18808c6",
                                        "entry_id": "c9363af2-ecaa-35c1-82ef-6fd5c564b027",
                                        "glosses": [
                                            "Secteur d’activité concernant la réalisation de programmes informatiques, de logiciels (dans le sens précédent)."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7a4cd2-d32c-4747-a320-8435836496ba",
                                                "sense_id": "c230d4ae-1b95-37ba-8281-40acb18808c6",
                                                "text": "Le logiciel est un secteur en crise en Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d87a40aa-a493-3940-b959-a0683c469bf4",
                                        "entry_id": "c9363af2-ecaa-35c1-82ef-6fd5c564b027",
                                        "glosses": [
                                            "Manière de procéder mûrement élaborée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3751731f-0fb4-43cb-8b80-d61cfa6ea6a4",
                                                "sense_id": "d87a40aa-a493-3940-b959-a0683c469bf4",
                                                "text": "Démonétisés et affaiblis, les partis, qui lancent cette semaine leur université d’été, tentent d’associer de nouveaux intellectuels afin d’irriguer et de fortifier leur logiciel ou leur doctrine."
                                            },
                                            {
                                                "example_id": "62bf1a91-18bd-4bee-a282-de7ff895e99b",
                                                "sense_id": "d87a40aa-a493-3940-b959-a0683c469bf4",
                                                "text": "Dans le logiciel nord-coréen, il y a cet amour inconditionnel à une créature politique et presque mystique, Kim Jong-un."
                                            },
                                            {
                                                "example_id": "303f3397-545f-4cca-a014-f01a403e5f26",
                                                "sense_id": "d87a40aa-a493-3940-b959-a0683c469bf4",
                                                "text": "Mais je ne l’avais pas fait, et sans doute je ne pouvais pas le faire, je n’avais pas été formaté pour une telle proposition, ça ne faisait pas partie de mon logiciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
