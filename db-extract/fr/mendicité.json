            {
                "entry_id": "61cfc6b3-2552-30de-b0ba-dbbd56634bc0",
                "word": "mendicité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f54819f8-87cc-4027-ab22-54a748838cab",
                        "entry_id": "61cfc6b3-2552-30de-b0ba-dbbd56634bc0",
                        "tags": [
