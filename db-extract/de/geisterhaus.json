                ],
                "senses": [
                    {
                        "sense_id": "ed84c6a1-e15c-3d8e-bf72-0cfa6e2583a5",
                        "entry_id": "6a911bc9-8151-37e2-894e-37924f29c770",
                        "glosses": [
                            "leerstehendes, unheimlich wirkendes Haus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f758ac65-5a26-46c0-9b01-6d709df5f399",
                                "sense_id": "ed84c6a1-e15c-3d8e-bf72-0cfa6e2583a5",
                                "text": "„1927 kaufte die Gemeinde Tórshavn die Moschee, und nun besaß er dieses Geisterhaus und wusste nicht, was er damit anfangen sollte.“"
                            },
                            {
                                "example_id": "43b5199d-7716-45b3-93be-4b653399ecfb",
                                "sense_id": "ed84c6a1-e15c-3d8e-bf72-0cfa6e2583a5",
                                "text": "„Zum erstenmal blieben die Häuser der Fremden leer, alte und neue Gebäude in allen Lagen, Fischerhütten und Bungalows in den Wäldern, verrammelte Luxuspaläste und offene Datschen, verlassene Geisterhäuser an leeren Buchten, ein aufgelassenes Gefängnis, ein Restaurant – billig zu kaufen, billiger zu mieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cc240a2-2053-455f-92cd-ec0869fc37a4",
                        "source_entry_id": "6a911bc9-8151-37e2-894e-37924f29c770",
                        "source_sense_id": "ed84c6a1-e15c-3d8e-bf72-0cfa6e2583a5",
                        "source_sense_description": "leerstehendes, unheimlich wirkendes Haus",
                        "target_lang_word": "haunted house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haunted house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8d39a6-9459-3c10-aabc-e2db14d8424d",
                                        "entry_id": "4e621ada-21f3-3422-82d8-af89fb38b69b",
                                        "glosses": [
                                            "An amusement attraction in which a building or series of rooms is decorated to frighten the people who pass through."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3913611b-7466-47aa-8988-ba9f4e0d2ecb",
                                                "sense_id": "5e8d39a6-9459-3c10-aabc-e2db14d8424d",
                                                "text": "Lisette can't wait to create a haunted house on Halloween night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "696fce31-b612-35fe-85a0-9df3d63aebd3",
                                        "entry_id": "4e621ada-21f3-3422-82d8-af89fb38b69b",
                                        "glosses": [
                                            "Synonym of witch house (“music genre”)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751da8a5-5363-4a06-ba8b-fe38a1d0a80c",
                                                "sense_id": "696fce31-b612-35fe-85a0-9df3d63aebd3",
                                                "text": "This enigmatic bunch are a reaction to Manchester's musical past, with a blend of haunted house and rave dynamics"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6390167b-c0f7-3e6b-a41a-693d8eff83c2",
                                        "entry_id": "4e621ada-21f3-3422-82d8-af89fb38b69b",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see haunted, house."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ceee12-c356-483e-a891-0e2e7d03cc23",
                                                "sense_id": "6390167b-c0f7-3e6b-a41a-693d8eff83c2",
                                                "text": "It was easy to see that it was an avoided house—a house that was shunned by the village, to which my eye was guided by a church spire some half a mile off—a house that nobody would take. And the natural inference was, that it had the reputation of being a haunted house."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8058f27-c696-4d22-9b2f-60548ce9c6c4",
                        "source_entry_id": "6a911bc9-8151-37e2-894e-37924f29c770",
                        "source_sense_id": "ed84c6a1-e15c-3d8e-bf72-0cfa6e2583a5",
                        "source_sense_description": "leerstehendes, unheimlich wirkendes Haus",
                        "target_lang_word": "maison hantée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison hantée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "969d5834-edb6-3029-bf66-9488b9196737",
                                        "entry_id": "04134e0a-f301-3ac9-9032-86de58abb91f",
                                        "glosses": [
                                            "Maison (ou château, vieille bâtisse, usine désaffectée, etc..) qui passe pour être visitée par des esprits, des fantômes, des entités et autres forces surnaturelles. On dit qu'elle est le théâtre de phénomènes étranges et inexpliqués, supposés surnaturels ou paranormaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ab1ffb-af9c-4f49-a749-9a7be88f8263",
                                                "sense_id": "969d5834-edb6-3029-bf66-9488b9196737",
                                                "text": "Dès que j’eus entendu parler de cet envoûtement, je consultai quelques ouvrages – je possède un nombre considérable de textes égyptiens qui traitent de ces problèmes de fantômes – et, à l’heure du premier sommeil, je me rendis à la maison hantée, malgré les prières de mon hôte qui voulut m’en empêcher […]."
                                            },
                                            {
                                                "example_id": "189f0a3c-ea02-4115-af72-7945f612d784",
                                                "sense_id": "969d5834-edb6-3029-bf66-9488b9196737",
                                                "text": "Mistress Snagsby est tellement alerte, qu’aux mystérieux craquements du plancher, aux frôlements inexplicables de vêtements invisibles, qui bruissent perpétuellement dans l’ombre, on dirait la maison hantée par des revenants ; les apprentis supposent qu’il faut que jadis il y ait eu quelqu’un d’assassiné par là ; […]."
                                            },
                                            {
                                                "example_id": "94a83b58-cb1b-43bc-9a58-a164be10cb63",
                                                "sense_id": "969d5834-edb6-3029-bf66-9488b9196737",
                                                "text": "Et, je l’avoue, dans cette maison hantée, redevenue noire, la peur me prit, une peur qui ne fut qu’un léger malaise, qu’un petit frisson à fleur de peau, puis qui s’exaspéra, qui me glaça tout entier, dans une folie d’épouvante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1d59ad7-17cd-3cba-8867-11e07a8b3d9b",
                                        "entry_id": "04134e0a-f301-3ac9-9032-86de58abb91f",
                                        "glosses": [
                                            "Attraction foraine. Parcours ludique, où l’on effraie les touristes avec des apparitions de fantômes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a9ac6d-d02f-4e04-9c82-1eba0b644bb9",
                                                "sense_id": "d1d59ad7-17cd-3cba-8867-11e07a8b3d9b",
                                                "text": "« J’ai l’impression d’être entré dans une maison hantée de fête foraine. » Kara essuya ses yeux humides et regarda autour d’elle. La minuscule boutique était bourrée d’articles de sorcellerie."
                                            },
                                            {
                                                "example_id": "bd14de8d-ac21-4a76-bc88-8d6e550ba99a",
                                                "sense_id": "d1d59ad7-17cd-3cba-8867-11e07a8b3d9b",
                                                "text": "Imaginez une version aquatique de la maison hantée dans une fête foraine, avec le bruit du ruissellement de l’eau et les battements d'ailes des oiseaux en guise de fond sonore."
                                            },
                                            {
                                                "example_id": "bfb23525-69f9-429d-a779-d729fbe3f01b",
                                                "sense_id": "d1d59ad7-17cd-3cba-8867-11e07a8b3d9b",
                                                "text": "Bizarrement, son cadavre sanglant ne la dérangeait pas : il lui faisait à peu près le même effet qu’un zombie de pacotille dans une maison hantée de fête foraine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
