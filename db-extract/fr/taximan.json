                    {
                        "translation_id": "568c118c-cd5b-45a3-9ed6-ee03b8ca8f91",
                        "source_entry_id": "36f071e9-5244-3a16-8867-6b09719b3800",
                        "source_sense_id": "e9d91d1b-fe83-369f-b572-33f34f5a312c",
