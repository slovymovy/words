                                                "example_id": "f4b8135c-2cf8-4114-9db3-6d6454b30aa6",
                                                "sense_id": "6663b9ce-99c6-33f8-80fe-8381bb18ba05",
                                                "text": "Giselle, calme et attentive, s'occupa de tout préparer pour son retour, et, installée dans une salle du rez-de-chaussée, attendit l'arrivée de son père et de ses invités, le duc de Guise et le prince de Condé."
                                            },
                                            {
                                                "example_id": "cdcac661-04f9-44c3-b3f9-5add6ccb8479",
                                                "sense_id": "6663b9ce-99c6-33f8-80fe-8381bb18ba05",
                                                "text": "Mais, en regardant la liste des invités, on constate que, sur la cinquantaine de streameurs présents, le nombre de femmes ne dépasse pas la dizaine."
                                            }
                                        ]
                                    }
                                ]
                            },
