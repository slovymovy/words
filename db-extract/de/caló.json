                "senses": [
                    {
                        "sense_id": "41ddcbb2-2c38-331b-9c28-c746010805be",
                        "entry_id": "db7f58bf-12b9-3d2a-86a7-58eb1f20a786",
                        "glosses": [
                            "Sprache der Gitanos (eine Gruppe der Roma) im Süden Spaniens (Andalusien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d50830d-48fe-47f8-8deb-6126c2d8b199",
                                "sense_id": "41ddcbb2-2c38-331b-9c28-c746010805be",
                                "text": "„[…] zehn Wörter der Germania, die ins Caló entlehnt sind[…]. Ropero Núñez liefert die erste längere Liste von Caló-Wörtern, die schriftlich in Texten belegt sind.“"
                            },
                            {
                                "example_id": "dde7f002-d011-46f9-884d-741d06b2ae1a",
                                "sense_id": "41ddcbb2-2c38-331b-9c28-c746010805be",
                                "text": "„Guasa ist ein gutes andalusisches Wort (der Anlaut gua- findet sich im Caló nicht; das Wort guachedre bei Borrow wird der Germanía angehören);“"
                            },
                            {
                                "example_id": "e0aef3a9-0ed6-434c-bd14-9493e60205f2",
                                "sense_id": "41ddcbb2-2c38-331b-9c28-c746010805be",
                                "text": "„Der größte Anteil der Wörter, die integriert wurden, stammt aus der italienische Sprache um die 30%, der Rest stammt aus dem Caló, die Sprache der Zigeuner, dem französischen Argot, und der alten spanischen Germanía und sind Lehnwörter aus dem indigenen, lusitanischen und englischem Vokabular.“"
                            },
                            {
                                "example_id": "3a44c728-6b3d-4ecf-a82f-c7f319ed2b38",
                                "sense_id": "41ddcbb2-2c38-331b-9c28-c746010805be",
                                "text": "„Das heute praktisch nicht mehr existente Caló ist ein Idiom vom Typ II.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
