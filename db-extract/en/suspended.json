                                        "sense_id": "2f6bc33a-78a3-32c2-a872-a465cf826780",
                                        "entry_id": "d3e4d821-9052-323c-b415-ab8207efc7e9",
                                        "glosses": [
                                            "Qui fait l’objet d’une suspension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513ed64f-ff78-416d-964d-5a2f979a2065",
                                                "sense_id": "2f6bc33a-78a3-32c2-a872-a465cf826780",
                                                "text": "Pont suspendu."
                                            },
                                            {
                                                "example_id": "38c05fde-baff-4670-b0cc-3c6b98e7dd35",
                                                "sense_id": "2f6bc33a-78a3-32c2-a872-a465cf826780",
                                                "text": "[…] un délai interrompu recommencera à courir depuis le début tandis qu’un délai suspendu repartira, une fois levée la cause de suspension, du point d’arrêt jusqu’au terme du délai […]."
                                            },
                                            {
                                                "example_id": "a06e8b5c-bb47-43c9-aa54-341b2d7bc87d",
                                                "sense_id": "2f6bc33a-78a3-32c2-a872-a465cf826780",
                                                "text": "Mais je commence à m’effrayer aujourd'hui des condamnations suspendues sur les journaux pour la moindre infraction au texte de la loi nouvelle. (Par analogie avec l'épée de Damoclès.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b6e10d9-68ac-3867-b5e5-86f15548301b",
                                        "entry_id": "d3e4d821-9052-323c-b415-ab8207efc7e9",
                                        "glosses": [
                                            "Qui est en équilibre et qui parait se soutenir de soi-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3db40941-1a57-46d5-b7c2-dffbb5356fca",
                                                "sense_id": "3b6e10d9-68ac-3867-b5e5-86f15548301b",
                                                "text": "Les nuées sont suspendues en l’air."
                                            },
                                            {
                                                "example_id": "0256ce4e-db8c-4f0f-af1b-19de62917839",
                                                "sense_id": "3b6e10d9-68ac-3867-b5e5-86f15548301b",
                                                "text": "J’ébauche un sourire purement professionnel et tends une main qui restera honteusement suspendue dans le vide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd1a96d-5d95-33fc-9e91-a40c5633db16",
                                        "entry_id": "d3e4d821-9052-323c-b415-ab8207efc7e9",
                                        "glosses": [
                                            "Mis à l'arrêt, effectivement retiré de champ, ou relevé de l'ordre du jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d612ebbc-484c-4ad0-b0ad-3c68bd2bb3d5",
                                                "sense_id": "8bd1a96d-5d95-33fc-9e91-a40c5633db16",
                                                "text": "Laissez votre arme et vos menottes, Harris. Vous êtes suspendu."
                                            }
                                        ]
                                    }
                                ]
