                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
                                        "glosses": [
                                            "nicht gezähmt; frei in der Natur vorkommend; nicht veredelt"
                                        ],
                                        "tags": [
                                            "Gegenwort zu zahm oder veredelt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ce78fc-8387-4582-bf75-32b806757a79",
                                                "sense_id": "4d6ef943-6793-3834-b268-ff7fbcaf1edf",
                                                "text": "Viele Menschen haben Angst vor wild lebenden Tieren."
                                            },
                                            {
                                                "example_id": "3b307815-cd22-474e-9c2c-f111883f2294",
                                                "sense_id": "4d6ef943-6793-3834-b268-ff7fbcaf1edf",
                                                "text": "Beim Sammeln von wilden Pflanzen sollte man aufpassen, dass sie nicht giftig sind."
                                            },
                                            {
                                                "example_id": "96352b7b-bd63-4523-880e-a3c5f88d4a08",
                                                "sense_id": "4d6ef943-6793-3834-b268-ff7fbcaf1edf",
                                                "text": "Wir haben wilde Beeren im Wald gepflückt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5c1f79f-5d62-3f1a-a059-299824c01b01",
                                        "entry_id": "a98bcbd3-e123-3650-9ea8-5c6ab31221bf",
                                        "glosses": [
                                            "gegen das Gesetz, gegen die Ordnung verstoßend; ohne Kontrolle geschehend"
