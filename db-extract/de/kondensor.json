                "senses": [
                    {
                        "sense_id": "9c470e93-2986-3434-9695-173d176a3037",
                        "entry_id": "bcd7c4bb-47fe-3d59-b6af-13c6f2880521",
                        "glosses": [
                            "Sammellinse(n) in einem optischen Gerät, Beleuchtungssystem innerhalb eines solchen Geräts, das für eine gleichmäßige Ausleuchtung sorgt"
                        ],
                        "tags": [
                            "Optik",
                            "oder auch"
                        ],
                        "examples": [
                            {
                                "example_id": "ced05566-3e17-43ce-a6b4-3c79cb296600",
                                "sense_id": "9c470e93-2986-3434-9695-173d176a3037",
                                "text": "„Wir wollen nun unter Voraussetzung einer punktförmigen Lichtquelle vergleichen, wie sich die vom zwei- und dreiteiligen Kondensor aufgenommenen Lichtmengen verhalten.“"
                            },
                            {
                                "example_id": "9aae5d75-7b3a-4b83-a303-cab56067c9ad",
                                "sense_id": "9c470e93-2986-3434-9695-173d176a3037",
                                "text": "„Durch die Verwendung von telezentrischen Kondensoren mit einer eingebauten LED werden undefinierte Reflexionen an den Objektkanten vermieden, da zur Beleuchtung nur die achsparallelen Strahlen verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
