                        "target_lang_word": "discrepancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discrepancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                        "entry_id": "a7506862-6b7b-3f45-8820-340a40051c0f",
                                        "glosses": [
                                            "An inconsistency between facts or sentiments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9574d201-1faf-46e8-a4b9-838ed94a919c",
                                                "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                                "text": "They found a discrepancy between the first set of test results and the second, and they're still trying to figure out why."
                                            },
                                            {
                                                "example_id": "eda1e472-b162-4779-9e31-cebb8b797295",
                                                "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                                "text": "Still, there is pilferage, mysterious discrepancies eating into the percentages."
                                            },
                                            {
                                                "example_id": "16bd5542-cc65-47bf-afe7-71fe4f2e24ab",
                                                "sense_id": "1409e323-deb2-3ba4-b1f9-4cf5f305305e",
                                                "text": "WikiLeaks did not cause these uprisings but it certainly informed them. The dispatches revealed details of corruption and kleptocracy that many Tunisians suspected, […]. They also exposed the blatant discrepancy between the west's professed values and actual foreign policies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a78740d2-c679-37d3-ad10-f750ff683de6",
                                        "entry_id": "a7506862-6b7b-3f45-8820-340a40051c0f",
                                        "glosses": [
                                            "The state or quality of being discrepant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4cdd74c-0402-4f88-b6ea-36892baa2eb8",
                        "source_entry_id": "6d7c03d9-4d51-3661-a99c-2541c97653cc",
                        "source_sense_id": "9ed60e27-9ef2-3571-919f-2f0beed54b6c",
                        "target_lang_word": "disharmony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disharmony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f420dad6-a1fc-3811-a60b-f78e0c1e1d51",
                                        "entry_id": "2cb1569b-8bc8-33f0-b960-0be2f1b63c87",
                                        "glosses": [
                                            "The absence of harmony or concordance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbf1d376-2ad9-4618-875f-c3cb9bee4270",
                                                "sense_id": "f420dad6-a1fc-3811-a60b-f78e0c1e1d51",
                                                "text": "Critics suggest that Fernández, an unashamed populist and nationalist, is seeking to deflect attention from social disharmony at home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3f78b80-4340-4b88-aa77-6eb91c5541e5",
                        "source_entry_id": "6d7c03d9-4d51-3661-a99c-2541c97653cc",
                        "source_sense_id": "9ed60e27-9ef2-3571-919f-2f0beed54b6c",
                        "target_lang_word": "inharmony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inharmony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df5aba2c-6cca-3501-b81c-2c4779c28ef1",
                                        "entry_id": "939ae134-bfd3-3d57-aeba-2359496e59e1",
                                        "glosses": [
                                            "Lack of harmony."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b73c1907-9187-4985-9215-70f840a4caa6",
                                                "sense_id": "df5aba2c-6cca-3501-b81c-2c4779c28ef1",
                                                "text": "Here in the night stretches a wide and blasted field studded with half-extinct fires burning redly with I know not what presage of evil. . . . To what monstrous inharmony of death was it the visible prelude?"
                                            },
                                            {
                                                "example_id": "0114c5d6-bca2-43f5-ac41-91c51ac93809",
                                                "sense_id": "df5aba2c-6cca-3501-b81c-2c4779c28ef1",
                                                "text": "Tom Slater made a congratulatory speech—in reality, a mournful adjuration to avoid the pitfalls of matrimonial inharmony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
