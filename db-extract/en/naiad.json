                                                "example_id": "3d30d160-4aaf-4588-a85a-838cc0f363f2",
                                                "sense_id": "5891baff-900b-3123-bb91-4bd6bc716932",
                                                "text": "„Sie ist eine Najade in einer Silberhaut.“"
                                            },
                                            {
                                                "example_id": "936d73a5-e2cd-4cca-8700-6d2de5d8f512",
                                                "sense_id": "5891baff-900b-3123-bb91-4bd6bc716932",
                                                "text": "„Sie preßte mich an sich, so daß ich sie von den Beinen bis zur Schulter fühlte, als hätte ich eine Najade im Arm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
