                "senses": [
                    {
                        "sense_id": "e8ba5043-1729-3012-a64f-7c202382b9bf",
                        "entry_id": "4c3c0335-bf0c-36a3-883d-7172105866f0",
                        "glosses": [
                            "ein Brand oder ein Schnaps, der aus Weinhefe gebrannt worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc4e9bf-4a38-4c2d-a1c0-d21ea69b4d21",
                                "sense_id": "e8ba5043-1729-3012-a64f-7c202382b9bf",
                                "text": "„So ist ein „Riesling Eisweintrester\" oder „Weinhefebrand aus kaltvergorener Rivanerhefe\" oder ein „Deutscher Weinbrand X. O. vom Riesling\" oder ein „Traubenbrand aus Gewürztraminer\" den unspezifizierten Erzeugnissen vorzuziehen.“"
                            },
                            {
                                "example_id": "0cd53cfd-bfe3-4700-a15a-3860fb121622",
                                "sense_id": "e8ba5043-1729-3012-a64f-7c202382b9bf",
                                "text": "„Weintrub, ausgenommen Weinhefe zur Herstellung von Weinhefebrand, darf nur nach ausreichender Vergällung in den Verkehr gebracht oder bezogen werden.“"
                            },
                            {
                                "example_id": "77662c13-5c00-458c-86a4-70978278fa35",
                                "sense_id": "e8ba5043-1729-3012-a64f-7c202382b9bf",
                                "text": "„Volker Baumgartner erhielt für seinen vorzüglichen Weinhefebrand Gold und für das Kirschwasser die Bronzemedaille.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
