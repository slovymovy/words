                        ],
                        "examples": [
                            {
                                "example_id": "0a5744ea-7a6b-4c2c-8b2e-5e19305ead5c",
                                "sense_id": "213443bc-8b22-3f56-bbb0-4ed102d4b903",
                                "text": "Tout ce que Paris compte de minets, pédés, zyvas, sapeurs, négros, bolosses, étudiants, bicots, bracass et beaux gosses se retrouve chez H&M pour enfiler les derniers molards de la mode, tout ce que le capital feuj cherche à fourguer de merdes fabriquées par des gosses à l'autre bout du monde — et ces connards payent pour porter ça."
                            }
                        ]
                    }
