                        "examples": [
                            {
                                "example_id": "54b4f94c-61d7-4907-8214-da208a90ad76",
                                "sense_id": "94c23bf4-ed8e-3a3a-85e6-3224079c62e9",
                                "text": "„›Hat gerade angerufen. Er ist unterwegs. Wahrscheinlich nervös geworden. Setz dich. Ich hab dir was zu trinken gemacht. Dein Lieblingsdrink.‹“"
                            },
                            {
                                "example_id": "ebb7d2e9-db99-41d6-8129-9c6a48ee21cf",
                                "sense_id": "94c23bf4-ed8e-3a3a-85e6-3224079c62e9",
                                "text": "„Jenever war zwar nie sein Lieblingsdrink gewesen, aber das Verlangen danach, was er bewirken konnte, überfiel ihn, so dass er wie erstarrt vor der Anrichte stand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
