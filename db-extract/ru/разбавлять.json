                "senses": [
                    {
                        "sense_id": "c6dfc806-b7ca-3881-8e5c-4cea97174668",
                        "entry_id": "ef679a68-2c64-36d7-abef-b0cd4d04959c",
                        "glosses": [
                            "добавляя воды или иной жидкости, делать менее крепким, менее густым, менее насыщенным или более жидким"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225f5adf-5e97-42bd-8a88-8c541e46ee1c",
                                "sense_id": "c6dfc806-b7ca-3881-8e5c-4cea97174668",
                                "text": "Разбавить спирт водкой."
                            }
                        ]
                    },
                    {
                        "sense_id": "28d8a045-2107-377d-a557-d741b5c89e9a",
                        "entry_id": "ef679a68-2c64-36d7-abef-b0cd4d04959c",
                        "glosses": [
                            "перен. добавляя, присоединяя что-либо постороннее, лишать что-либо силы, содержательности, однородности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20b74b79-6207-4cd5-9b81-eeb50320a5a5",
                                "sense_id": "28d8a045-2107-377d-a557-d741b5c89e9a",
                                "text": "Разбавить текст описаниями природы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f1efa04-83f3-4cee-918b-13939a568efe",
                        "source_entry_id": "ef679a68-2c64-36d7-abef-b0cd4d04959c",
                        "target_lang_word": "dilute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da74d09d-72d5-34ad-bbff-02c97daa085f",
                                        "entry_id": "1ba9db95-ba25-3147-8d1a-fb2b53fbb551",
                                        "glosses": [
                                            "To make thinner by adding solvent to a solution, especially by adding water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "865b05e0-4b76-4eda-937d-f667da15bcb3",
                                                "sense_id": "da74d09d-72d5-34ad-bbff-02c97daa085f",
                                                "text": "Mix their watery store / With the chyle's current, and dilute it more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e343d9da-3977-3878-9ce6-2f4175edfbe6",
                                        "entry_id": "1ba9db95-ba25-3147-8d1a-fb2b53fbb551",
                                        "glosses": [
                                            "To weaken, especially by adding a foreign substance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c1feef8-22a7-4816-b06c-8e445c550732",
                                                "sense_id": "e343d9da-3977-3878-9ce6-2f4175edfbe6",
                                                "text": "For if these Colours be diluted and weakened by the Mixture of any adventitious light, the distance between the places of the Paper will not be so great."
                                            },
                                            {
                                                "example_id": "bf2199ee-8628-4135-98bb-950500a50825",
                                                "sense_id": "e343d9da-3977-3878-9ce6-2f4175edfbe6",
                                                "text": "“Stay a little.”\n“Not another second: language and discussion dilute thought; I will say no more.”"
                                            },
                                            {
                                                "example_id": "f71bea67-b300-4dc6-9cc3-b76b3c4629eb",
                                                "sense_id": "e343d9da-3977-3878-9ce6-2f4175edfbe6",
                                                "text": "It's healthy to have people in the military who would perhaps rather be somewhere else; they can dilute the more gung-ho military types."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ff9dc92-f5fa-3b35-aa24-f7943598aba8",
                                        "entry_id": "1ba9db95-ba25-3147-8d1a-fb2b53fbb551",
                                        "glosses": [
