                        ],
                        "examples": [
                            {
                                "example_id": "d47edc24-aced-431d-b748-c2106417610b",
                                "sense_id": "fbc30b00-ef62-370f-828e-722f2d43f081",
                                "text": "Se payer une graisseuse pis un roteux ? ironisa Mario. Non, on va regarder les vitrines. Ah bon, fit le garçon en fronçant les sourcils."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fcb43a5-2369-3432-ab9e-d8386a3fafb5",
                        "entry_id": "4f5553e0-184d-367a-9322-5169e768c8ca",
                        "glosses": [
                            "Femme obèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdcd2d75-baf4-425f-a752-494f7f72a4e5",
                                "sense_id": "4fcb43a5-2369-3432-ab9e-d8386a3fafb5",
                                "text": "Fabio donnait donc dans les graisseuses ! Bah, il connaissait bien deux ou trois Italiens qui préféraient les négresses."
                            },
                            {
                                "example_id": "a50a8644-5df5-4a92-a18b-ebb614dc0bd1",
                                "sense_id": "4fcb43a5-2369-3432-ab9e-d8386a3fafb5",
                                "text": "A part les graisseuses et les squaws , il n'y avait donc pas plus de vingt femmes dans tout le comté de Yuba , en dehors de Marysville."
                            }
                        ]
                    }
