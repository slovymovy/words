                        "examples": [
                            {
                                "example_id": "d34159ad-9c3f-4d08-b5af-61497eabc679",
                                "sense_id": "bb253c9d-a454-3091-b29c-46e182b9db1c",
                                "text": "Co więcej, zdolne są do położenia się na dnie morskim – gdzie są praktycznie niewykrywalne – pasywnie oczekując na swój cel"
