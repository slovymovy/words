        "fr-extract.jsonl": [
            {
                "entry_id": "be0b6799-d391-30f8-99b2-737b3ca7e0b2",
                "word": "démoniaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8cd8fda5-3a5f-4231-a326-3fcffb0bd2ca",
                        "entry_id": "be0b6799-d391-30f8-99b2-737b3ca7e0b2",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "démoniaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c409682-5487-38a4-bf82-80a61efe1c17",
                        "entry_id": "be0b6799-d391-30f8-99b2-737b3ca7e0b2",
                        "glosses": [
                            "Qui est possédé ou semble possédé du démon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a95ac9-99ec-43d3-9d5f-a88c853a874c",
                                "sense_id": "8c409682-5487-38a4-bf82-80a61efe1c17",
                                "text": "Une femme démoniaque."
                            },
                            {
                                "example_id": "c39c0034-7f5c-4148-abaf-76642832164c",
                                "sense_id": "8c409682-5487-38a4-bf82-80a61efe1c17",
                                "text": "L’étranger abaissa les yeux sur ses grands pieds auxquels des sandales de cuir brut au bout pointu et recourbé donnaient un aspect démoniaque."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a2c763c-0394-384e-b4fe-4f61a4925889",
                        "entry_id": "be0b6799-d391-30f8-99b2-737b3ca7e0b2",
                        "glosses": [
                            "Se dit d’un système non-déterministe qui trouvera le moyen, s’il existe, d’échouer, de ne pas atteindre l’état final désiré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8965b1c9-e949-4609-9d6b-8c70b5c01ced",
                                "sense_id": "1a2c763c-0394-384e-b4fe-4f61a4925889",
                                "text": "– Sémantique opérationnelle naturelle de traces finies et infinies, approximations angélique et démoniaque ;\n– Sémantiques relationnelles naturelle, angélique et démoniaque ;\n– Sémantiques dénotationnelles naturelle (Plotkin), angélique (Hoare) et démoniaque (Smyth), cas particulier des langages déterministes (Scott)"
                            },
                            {
                                "example_id": "4413a84e-99fe-45eb-833d-3f85164b290c",
                                "sense_id": "1a2c763c-0394-384e-b4fe-4f61a4925889",
                                "text": "Je montrerai que certains concepts inventés par des économistes dès les années 1950 et par des statisticiens dans les années 1960 peuvent être remis au goût du jour pour fournir des modèles de systèmes de transition mêlant choix probabiliste et choix non déterministes (démoniaque, angélique, chaotique, … au choix), et ce même dans des espaces à états continus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "042aede7-a291-4968-b723-fe50a5956b95",
                        "source_entry_id": "be0b6799-d391-30f8-99b2-737b3ca7e0b2",
                        "target_lang_word": "dämonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dämonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6172a5-3593-3de0-9ce4-f0055ab32f0c",
                                        "entry_id": "ee915f1d-194a-33db-b15c-26c87c28f549",
                                        "glosses": [
                                            "die Dämonen betreffend, durch Dämonen verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7fe9ff7-6528-484f-aadc-0bc07f002129",
                                                "sense_id": "ae6172a5-3593-3de0-9ce4-f0055ab32f0c",
                                                "text": "Das dämonische Antlitz des Teufels verzog sich zu einer grässlichen Fratze."
                                            },
                                            {
                                                "example_id": "51c65bf8-ab03-4611-b8d9-89605bd6bb83",
                                                "sense_id": "ae6172a5-3593-3de0-9ce4-f0055ab32f0c",
                                                "text": "„Jesus scheint also davon ausgegangen zu sein, daß hinter Krankheiten allemal dämonische Mächte stünden, die im Betroffenen mehr oder weniger direkt ihr Unwesen trieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "699cd022-97d8-3033-92e4-5fd37f12da0b",
                                        "entry_id": "ee915f1d-194a-33db-b15c-26c87c28f549",
                                        "glosses": [
                                            "Angst hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783e87ed-da09-4202-93ec-d79750777b24",
                                                "sense_id": "699cd022-97d8-3033-92e4-5fd37f12da0b",
                                                "text": "Ihre Schwester bedachte sie mit einem schier dämonischen Blick."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66f3e0d3-9a8c-4330-84e6-ba931e7a3786",
                        "source_entry_id": "be0b6799-d391-30f8-99b2-737b3ca7e0b2",
                        "target_lang_word": "demonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1e0caff-b733-3e67-849c-25b2f533b04c",
                                        "entry_id": "e04167e7-6307-34fc-be8f-460767016312",
                                        "glosses": [
                                            "Pertaining to demons or evil spirits; demoniac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7156f4e9-70b3-4afc-aea1-edade747b108",
                                                "sense_id": "d1e0caff-b733-3e67-849c-25b2f533b04c",
                                                "text": "Convinced that his uncle was a warlock, he rifled through his attic, looking for demonic artifacts."
                                            },
                                            {
                                                "example_id": "813395ee-96e5-4a42-982e-c41270de4dd5",
                                                "sense_id": "d1e0caff-b733-3e67-849c-25b2f533b04c",
                                                "text": "Once he had grasped the controls, he unleashed a demonic laugh that made his hostages shudder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1419110a-7da1-3e43-a4c0-0ce8b7d33d50",
                                        "entry_id": "e04167e7-6307-34fc-be8f-460767016312",
                                        "glosses": [
                                            "Pertaining to daemons in ancient Greek thought; concerning supernatural ‘genius’."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd37937-2c89-4418-92d0-be7ad7b87bc8",
                                                "sense_id": "1419110a-7da1-3e43-a4c0-0ce8b7d33d50",
                                                "text": "Aristotle concedes that the nature of the dream is indeed daemonic [translating dämonischer], but not divine – which might well reveal a profound meaning, if one could hit on the right translation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9677faae-ea53-3cc8-a287-ae93990b5586",
                                        "entry_id": "e04167e7-6307-34fc-be8f-460767016312",
                                        "glosses": [
                                            "Extremely cruel or evil; abhorrent or repugnant; diabolical."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72125e2-bdd6-49ab-a3f0-38f69d325c0d",
                                                "sense_id": "9677faae-ea53-3cc8-a287-ae93990b5586",
                                                "text": "Lifton goes on to argue that they can commit these demonic acts because they rationalize their behaviour. A whole array of rationalizations justified the murder of innocent men, women and children."
                                            },
                                            {
                                                "example_id": "d5c6304e-f31e-4069-89e6-fe991f109d05",
                                                "sense_id": "9677faae-ea53-3cc8-a287-ae93990b5586",
                                                "text": "Texts show the star prime time host Tucker Carlson calling Mr. Trump a “demonic force,” […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a2d50bb-ed53-437c-9262-0716300959b6",
