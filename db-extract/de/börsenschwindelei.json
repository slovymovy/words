                ],
                "senses": [
                    {
                        "sense_id": "00b26720-51bb-3f55-97d8-e9d9cbd956f1",
                        "entry_id": "4e8214a6-f509-3336-9f85-822d06e7ec8e",
                        "glosses": [
                            "unlauteres Geschäftsgebaren oder sogar Betrug an der Börse, einem Handelsplatz für zum Beispiel Aktien"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6428caa7-3b2c-4163-91c7-2540973c9f32",
                                "sense_id": "00b26720-51bb-3f55-97d8-e9d9cbd956f1",
                                "text": "„Die Unterschlagungen, Börsenschwindeleien und der allgemeine Mißbrauch öffentlicher Gelder für private Zwecke, die den Grundzug des Systems des Zweiten Kaiserreichs bildeten, hatten auch die Armee ergriffen.“"
                            },
                            {
                                "example_id": "b22a471b-6884-4ef8-b337-6ddb23a81806",
                                "sense_id": "00b26720-51bb-3f55-97d8-e9d9cbd956f1",
                                "text": "„Cochrane Johnstone, und ein französischer Oberst, de Berenger, hatten den Plan gefaßt, ihren zerrütteten Finanzen durch eine großartige Börsenschwindelei wieder aufzuhelfen.“"
                            },
                            {
                                "example_id": "e2d94e30-b946-47c0-9ea1-7189fa4c8746",
                                "sense_id": "00b26720-51bb-3f55-97d8-e9d9cbd956f1",
                                "text": "„Aber einmal war das System dasselbe, stete Vermehrung der Schulden, Verkleidung des Defizits. Und mit der Zeit trat die alte Börsenschwindelei unverhüllter hervor.“"
                            },
                            {
                                "example_id": "f1a1a19c-0c91-4eb9-8969-3d84675267e9",
                                "sense_id": "00b26720-51bb-3f55-97d8-e9d9cbd956f1",
                                "text": "„Gerade dieser Anlaß zeigte wieder recht deutlich, welchen Werth die Journale haben. Sie alle sind nichts als bezahlte Reclamenmacher für die Börsenschwindelei sowie für Alles was Geld einbringt.“"
                            },
                            {
                                "example_id": "e5575468-dd40-49da-a363-49a6d5fe238f",
                                "sense_id": "00b26720-51bb-3f55-97d8-e9d9cbd956f1",
                                "text": "„Erst dann, wenn die Börsenschwindeleien, die Fälschungen und Betrügereien des Handels, die schlüpfrigen Bankiersgeschäfte der Gegenstand einer allgemeinen Verurtheilung sein werden, erst dann darf man hoffen, dass die commercielle Ehrbarkeit unter den Schutz des Gesetzes gestellt werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
