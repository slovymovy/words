                                "target_senses": [
                                    {
                                        "sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                                        "entry_id": "58c090c0-4c7f-3ad0-a6e2-f4b53852d7db",
                                        "glosses": [
                                            "Joie intense."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f37d8f5e-b076-41d3-a6fd-48fd1a54fd71",
                                                "sense_id": "fdc305a2-bca0-3d0d-9279-0d5031b9a429",
                                                "text": "Un grand merci à Stanislas Dehaene, Maître, Collègue et Ami (MCA) qui m’a initié à la recherche en neurosciences cognitives dans une atmosphère amicale d’exultation intellectuelle partagée. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 455)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fede0c7-ce1e-4b18-a8a4-87f44ac89e8f",
                        "source_entry_id": "3e47d104-8d15-38bb-9ea5-e87a13bc64e5",
                        "source_sense_id": "c33b661e-0393-385f-8841-039967ee1eff",
                        "source_sense_description": "lively joy at success or victory",
                        "target_lang_word": "Jubel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jubel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                        "entry_id": "dc74b7ba-f329-30be-a0c5-dea69499a9d9",
                                        "glosses": [
                                            "Offenbarung großer Freude durch entsprechendes Verhalten in Gestik, Mimik, Stimme, Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f16a0b-9eb2-4319-a072-cccee4ee961d",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "Der Jubel über den Sieg wollte kein Ende nehmen."
                                            },
                                            {
                                                "example_id": "88850e93-e4cd-484d-a416-0324741739f3",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "„Trotzdem gab es regelmäßig Jubel, wenn Soldatenkolonnen in Uniform ihre Kasernen verließen und sich auf den Weg zu den Bahnhöfen machten.“"
                                            },
                                            {
                                                "example_id": "6640fdac-12a4-4adc-ac4a-3d2066832209",
                                                "sense_id": "751c2269-719f-30db-b7a6-1d3ae71cd4b0",
                                                "text": "„Kein Jubel, kein Frohlocken war jedoch unter der versammelten, größtenteils aus Frauen und Kindern bestehenden Menge zu hören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "759ffedc-40b4-4ec8-ad61-6a8de2982898",
