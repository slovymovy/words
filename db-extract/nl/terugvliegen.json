                ],
                "senses": [
                    {
                        "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                        "entry_id": "63490dd3-07c8-3403-880f-302ec377301c",
                        "glosses": [
                            "to fly back"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95eb1cb-4c63-4676-99db-44325373205b",
                                "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                                "text": "Na de vakantie zullen we terugvliegen naar huis.",
                                "translation": "After the vacation, we will fly back home.",
                                "english": "After the vacation, we will fly back home."
                            },
                            {
                                "example_id": "7671c3a3-5467-4f89-83bd-7af225747e21",
                                "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                                "text": "Het team zal morgenochtend terugvliegen na de wedstrijd.",
                                "translation": "The team will fly back tomorrow morning after the match.",
                                "english": "The team will fly back tomorrow morning after the match."
                            },
                            {
                                "example_id": "f6127f59-50cc-40ec-8066-3bda9fd8e9fa",
                                "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                                "text": "Ze besloten eerder dan gepland terug te vliegen vanwege het slechte weer.",
                                "translation": "They decided to fly back earlier than planned due to bad weather.",
                                "english": "They decided to fly back earlier than planned due to bad weather."
                            },
                            {
                                "example_id": "59a1c602-9575-4e35-a8cb-cce76d5286fd",
                                "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                                "text": "Na de zakelijke bijeenkomst zullen ze direct terugvliegen naar hun kantoor.",
                                "translation": "After the business meeting, they will fly back directly to their office.",
                                "english": "After the business meeting, they will fly back directly to their office."
                            },
                            {
                                "example_id": "c1173e17-a703-45ff-95a7-5ee04769d801",
                                "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                                "text": "Ze hadden een geweldige tijd op vakantie, maar nu is het tijd om terug te vliegen naar de realiteit.",
                                "translation": "They had a great time on vacation, but now it's time to fly back to reality.",
                                "english": "They had a great time on vacation, but now it's time to fly back to reality."
                            },
                            {
                                "example_id": "1866dd39-09e6-4ff2-9df6-8b2dcd232564",
                                "sense_id": "c33682f0-eb69-387f-af4f-8d3b247dd4d8",
                                "text": "De piloot kondigde aan dat we binnenkort zouden terugvliegen naar onze vertrekbestemming.",
                                "translation": "The pilot announced that we would soon fly back to our departure destination.",
                                "english": "The pilot announced that we would soon fly back to our departure destination."
                            }
                        ]
                    }
                ],
