        "nl-extract.jsonl": [
            {
                "entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                "word": "daarentegen",
                "pos": "conj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                        "entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "glosses": [
                            "daarmee in tegenspraak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f253bbd3-fb04-47a6-8b71-8f49a475821d",
                                "sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                                "text": "De tuin was niet goed verzorgd, daarentegen waren de kozijnen netjes in de verf gezet."
                            },
                            {
                                "example_id": "47465117-4247-4380-b634-eeef09257e44",
                                "sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                                "text": "Bijna vier maanden had ik erover gedaan om de staat Californië te doorkruisen. De buurstaat Oregon daarentegen liep ik in drie weken van zuid naar noord."
                            },
                            {
                                "example_id": "1013273f-662c-476c-8043-7d45d5febed9",
                                "sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                                "text": "Misschien moeten vrouwen daarentegen wakker blijven, wachten en beschermen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37bebbdc-d2b9-4554-9abb-fa2c44f4aef1",
                        "source_entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "source_sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                        "target_lang_word": "all the time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all the time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                        "entry_id": "51923671-ee5a-3bfc-b334-c31957a6fedf",
                                        "glosses": [
                                            "Always; constantly; for the complete duration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24355fb-3cf3-40ae-96ae-4114c8cc290d",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "The public does not wish to be outraged in this way all the time."
                                            },
                                            {
                                                "example_id": "2568eb13-fb92-47c6-a4b4-65e4ed87c0c7",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "Afore we got to the shanty Colonel Applegate stuck his head out of the door. His temper had been getting raggeder all the time, and the sousing he got when he fell overboard had just about ripped what was left of it to ravellings."
                                            },
                                            {
                                                "example_id": "cdc6bb2e-fe8f-4ee7-825e-d899cbd472ee",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "I couldn't live without your love\nNow, I know you′re really mine\nI gotta have you all the time"
                                            },
                                            {
                                                "example_id": "b49dccf7-d999-4eb1-88d1-41e7807ba4f4",
                                                "sense_id": "ff241474-6a86-3f4d-b45c-35756df4fecc",
                                                "text": "The study found that there had been as many patent applications for artificial intelligence since 2013 as there were in all the time since the term AI was first used in the 1950s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ab9aa5-e3a3-357c-9a75-76a5f778bc90",
                                        "entry_id": "51923671-ee5a-3bfc-b334-c31957a6fedf",
                                        "glosses": [
                                            "Very often; frequently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f8bb41c-3044-4887-83f2-f1186636a7aa",
                                                "sense_id": "a1ab9aa5-e3a3-357c-9a75-76a5f778bc90",
                                                "text": "I have never been this excited about having an album. I play it all the time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5377df9c-36b1-4900-8439-a3b17b2b2dab",
                        "source_entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "source_sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                        "target_lang_word": "in the meantime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the meantime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                        "entry_id": "6f1e09ab-a9b4-36c9-a4f5-460f4faf0409",
                                        "glosses": [
                                            "meanwhile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779d4a11-3bbd-4c10-a9d3-bf2b1bc17fb7",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "But in the meantime Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            },
                                            {
                                                "example_id": "fb1ed1c2-10d1-4690-9706-2ce0b4a2907a",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "\"In the meantime,\" said Norbourne, \"we have arrived at the park-gate, and have not determined whither we shall ride.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ca7b1a3-cf67-471e-857c-0ac94f283754",
                        "source_entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "source_sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                        "target_lang_word": "meanwhile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                        "entry_id": "caab6ad0-d45e-39cc-9755-498b9ee5e510",
                                        "glosses": [
                                            "The time between two events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b2315d-7c63-4384-b5eb-77c4ded31571",
                                                "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                                "text": "In the meanwhile, the surveyors carried the line three miles, which was no contemptible day's work, considering how cruelly they were entangled with briers and gallbushes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During the time that something is happening, often specifically in a different place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e5e79c-ae8f-4148-b523-1c9c34e73771",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "There was a party going on downstairs. Meanwhile, I was reading a book."
                                            },
                                            {
                                                "example_id": "e2fca7da-277f-4f41-a041-026da9b103ab",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During an intervening time; from now until a future time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87e7889-9a76-4362-9b4e-6076a7392553",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "We’re going on holiday next month; meanwhile, keep working on the project."
                                            },
                                            {
                                                "example_id": "eb3d8668-3f83-46a9-837f-55f7e8b2e18d",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "The day may dawn when fair play, love for one's fellow men, respect for justice and freedom, will enable tormented generations to march forth triumphant from the hideous epoch in which we have to dwell. Meanwhile, never flinch, never weary, never despair."
                                            },
                                            {
                                                "example_id": "224cf66c-ad13-4898-9fc8-c656c0cb974a",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "“[…] I’m not ignoring you, I’m very sorry, I’ll talk to you soon. Meanwhile, get your tickets.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "In contrast to aspects previously mentioned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ed779-978e-44e0-81d8-98bcd1fa47c8",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "Some songs on the album are beautiful. Meanwhile, others are quite forgettable."
                                            },
                                            {
                                                "example_id": "c4a80167-011a-4835-973a-e857e80ce02e",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "When you are in the studio you don’t have anybody to feed off of, meanwhile when you are playing live you interact with people and you feel the energy in the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abd98db5-44ef-4b7c-a0ae-bb23164a2134",
                        "source_entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "source_sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                        "target_lang_word": "on the contrary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on the contrary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c383cb58-8493-3f4d-8637-25e53f3c8efc",
                                        "entry_id": "af3bec45-b60f-33d9-ade3-3c15292073fa",
                                        "glosses": [
                                            "Opposite of what had earlier been expected or assumed; to the contrary."
                                        ],
                                        "tags": [
                                            "conjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b206170b-ec83-4b33-b911-2b7798422938",
                                                "sense_id": "c383cb58-8493-3f4d-8637-25e53f3c8efc",
                                                "text": "Even if they managed to strike Japan, the United States or South Korea with nuclear weapons — a big if, given that they do not have a reliable delivery system — they could not save themselves from ultimate defeat. On the contrary, the use of nuclear or other terror weapons would be certain to invite overwhelming retaliation, delivering North Korea’s decision makers to a fiery oblivion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b4b736c-78ec-4472-8606-33082d43f9e4",
                        "source_entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "source_sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
                        "target_lang_word": "otherwise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "otherwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                        "entry_id": "a3666cbf-8f9d-3afe-8c6f-5507dbb19c7a",
                                        "glosses": [
                                            "Differently, in another way."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95028f6b-1e1a-4921-b91f-6c69e824f55f",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "You may have a point, but I think otherwise."
                                            },
                                            {
                                                "example_id": "d0f26a5f-78fd-4bda-b7a1-6a12c18b0429",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "Could I do otherwise than smile?"
                                            },
                                            {
                                                "example_id": "4dd3de1b-af64-4d40-ac25-e8f17539b00f",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "It is not permitted to sell or otherwise distribute any copies."
                                            },
                                            {
                                                "example_id": "45f1acf5-2df2-47f9-892c-c6d7be2d2412",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "There was one rotten apple in an otherwise perfect batch."
                                            },
                                            {
                                                "example_id": "1dba04c1-ec23-49c5-86b0-7d57e030cae6",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "If any man teach otherwise, and consent not to wholesome words, euen the wordes of our Lord Iesus Christ, and to the doctrine which is according to godlinesse:"
                                            },
                                            {
                                                "example_id": "afa91719-5de3-4e51-a72c-db5e68e84a40",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "Much as I wish that I had not to write this chapter, I know that I shall have to swallow many such bitter draughts in the course of this narrative. And I cannot do otherwise, if I claim to be a worshipper of Truth. […]"
                                            },
                                            {
                                                "example_id": "54573fcb-6cd5-464a-a511-0b544d47af88",
                                                "sense_id": "7c02e47f-a680-370b-8bd2-02b238efa37b",
                                                "text": "Fabio Capello insisted Rooney was in the right frame of mind to play in stormy Podgorica despite his father's arrest on Thursday in a probe into alleged betting irregularities, but his flash of temper - when he kicked out at Miodrag Dzudovic - suggested otherwise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                                        "entry_id": "a3666cbf-8f9d-3afe-8c6f-5507dbb19c7a",
                                        "glosses": [
                                            "In different circumstances; or else."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "397cb104-70b7-4d34-bfa1-1869ce798590",
                                                "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                                                "text": "I’m not well today, otherwise I would have helped."
                                            },
                                            {
                                                "example_id": "2adab10f-626f-4051-87ca-caaa7f719fb4",
                                                "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                                                "text": "You have to open your umbrella, otherwise you'll get wet."
                                            },
                                            {
                                                "example_id": "7f6c1327-2874-43ec-8167-12b603497d37",
                                                "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "a8ee4674-34d2-427a-87e3-548f39180e20",
                                                "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "c3c842df-08ff-4ccc-8a50-08633fa6b668",
                                                "sense_id": "b62cb072-5602-3c89-a6bb-5ed48294a86d",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "189f398f-6c85-3486-b669-8b94cba6cf50",
                                        "entry_id": "a3666cbf-8f9d-3afe-8c6f-5507dbb19c7a",
                                        "glosses": [
                                            "In all other respects."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679fc1ca-6cc3-491a-9622-ca10bded0b4f",
                                                "sense_id": "189f398f-6c85-3486-b669-8b94cba6cf50",
                                                "text": "Looking back at more than four years spent going to college I can now positively say that the most meaninful thing I accomplished (the only meaningful thing I accomplished!) was establishing a gay liberation group on campus. Otherwise my college education was almost useless."
                                            },
                                            {
                                                "example_id": "9ee5ff3a-f318-4581-8807-e3bcd1e21467",
                                                "sense_id": "189f398f-6c85-3486-b669-8b94cba6cf50",
                                                "text": "He lost his temper once in a while. Otherwise he behaved rationally."
                                            },
                                            {
                                                "example_id": "56d7259b-0c50-40ab-9638-bdc0535b3a7b",
                                                "sense_id": "189f398f-6c85-3486-b669-8b94cba6cf50",
                                                "text": "Robin van Persie squandered United's best chance late on but otherwise it was a relatively comfortable afternoon for Liverpool's new goalkeeper Simon Mignolet, who has yet to concede a Premier League goal since his £9m summer move from Sunderland."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "otherwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24a8db84-800c-3f5e-944a-21f8a5b9ac53",
                                        "entry_id": "96c5c6d1-fe36-3319-8a03-3232a73cda90",
                                        "glosses": [
                                            "Other than supposed; different."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d5f3a7a-33d6-4ea6-8d48-24598e185252",
                                                "sense_id": "24a8db84-800c-3f5e-944a-21f8a5b9ac53",
                                                "text": "He said he didn’t do it, but the evidence was otherwise."
                                            },
                                            {
                                                "example_id": "4d3dea08-1aea-42c3-ab43-238e5d481d8d",
                                                "sense_id": "24a8db84-800c-3f5e-944a-21f8a5b9ac53",
                                                "text": "Statistics need lots of information, digital and otherwise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5cb0775-fdc5-47d0-9084-e8b7300ce04c",
                        "source_entry_id": "257707ea-a8f5-3553-86fc-7321c5b0b44d",
                        "source_sense_id": "845a5e35-b38b-3c94-ae59-a74ffcf2020c",
