                "senses": [
                    {
                        "sense_id": "ca906d1d-7fcc-31ed-9fbd-c735977a2a10",
                        "entry_id": "530fe188-3962-39e4-bf98-84512c2e2136",
                        "glosses": [
                            "bezig zijn uit liefhebberij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8645b5a9-682f-4bad-994a-f29434b78af8",
                                "sense_id": "ca906d1d-7fcc-31ed-9fbd-c735977a2a10",
                                "text": "\"Wij werken niet in de tuin, wij hobbyen er”, zegt Willemien Lubberink in de krant van zaterdag."
                            },
                            {
                                "example_id": "303b8d44-96b6-4664-8b99-803bf2be8b53",
                                "sense_id": "ca906d1d-7fcc-31ed-9fbd-c735977a2a10",
                                "text": "Dit geld wordt geïnvesteerd in de bouw van extra opslagruimte en de inrichting van één van de bestaande zalen met werkbanken, kasten en verschillende gereedschappen en materialen. Inwoners van Kloosterhaar kunnen hier in kleine groepen samen komen hobbyen."
                            },
                            {
                                "example_id": "998d9a64-50c8-44b9-bcba-7eb82cfb282a",
                                "sense_id": "ca906d1d-7fcc-31ed-9fbd-c735977a2a10",
                                "text": "De Zwitser Pascal Prokop houdt van hobbyen en niet van de kou. Daarom besloot de man een heuse houtkachel in zijn Volvo 240 te plaatsen."
                            },
                            {
                                "example_id": "6e9eb368-90b8-4838-b6ef-0ccf60102fcd",
                                "sense_id": "ca906d1d-7fcc-31ed-9fbd-c735977a2a10",
                                "text": "In 1979 begon Piet Stoof voor zichzelf. Hij kocht z’n eigen materialen en richtte zich met zijn bedrijf, Lastra, op projecten in het topsegment. Lacht: ,,Het mooie is, dit werk is gewoon betaald hobbyen. Rekenen, tekenen, je kunt er al je praktische knowhow in kwijt.’’"
                            }
                        ]
                    },
                    {
                        "sense_id": "48e740ab-daf6-30e4-ab8d-55d4f99d9fc1",
                        "entry_id": "530fe188-3962-39e4-bf98-84512c2e2136",
                        "glosses": [
                            "klungelen, aanmodderen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "33cbc638-59c0-4c27-a543-2f497bc80599",
                                "sense_id": "48e740ab-daf6-30e4-ab8d-55d4f99d9fc1",
                                "text": "We moeten plaats maken voor experimenten met technieken van de toekomst. Bijvoorbeeld op het gebied van duurzaamheid. Niet met huis- tuin- en keuken-geknutsel een beetje hobbyen, maar met serieuze innovaties een bijdrage leveren aan nieuwe, andere manieren van produceren. Dat is én goed voor de wereld en voor onze economie, voor onze banen. Daarom vind ik het belangrijk te blijven investeren in innovatie en kennis."
                            }
                        ]
                    }
