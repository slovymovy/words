                "forms": [],
                "senses": [
                    {
                        "sense_id": "d59c71e7-11d2-3bb1-a4c6-70b3fe4eb730",
                        "entry_id": "4d501344-fe44-3766-88d6-12b5e62da621",
                        "glosses": [
                            "The size of type between Norse and brilliant, standardized as 3-point."
                        ],
                        "tags": [
                            "US",
                            "dated",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4810bc7b-5433-37f2-ad42-04d14fedc363",
                        "entry_id": "4d501344-fe44-3766-88d6-12b5e62da621",
                        "glosses": [
                            "Stuffing material (as for furniture and mattresses) made of slender, curled woodshavings, as a substitute for hair."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2037ab2c-5ab3-46e9-90d0-a94a536ceb2e",
                                "sense_id": "4810bc7b-5433-37f2-ad42-04d14fedc363",
                                "text": "These little mangers, with baby dolls representing Jesus, porcelean Josephs and Marys, wide-eyed cows of papier-mâché, and excelsior for straw, were purchased by pious parents for well-behaved children at Christmas-tide."
                            },
                            {
                                "example_id": "afa6c85f-a8d2-4293-bbd9-fdbe112ee390",
                                "sense_id": "4810bc7b-5433-37f2-ad42-04d14fedc363",
                                "text": "Working both [of them] at Kroll's then, she selling candy and cashews in a white smock with \"Jan\" stitched on her pocket and he lugging easy chairs and maple end tables around on the floor above, hammering apart packing crates from nine to five, the itch of the packing excelsior getting into his nose and eyes and making them burn."
                            },
                            {
                                "example_id": "b0106572-831d-4368-b059-6948aa4e99cf",
                                "sense_id": "4810bc7b-5433-37f2-ad42-04d14fedc363",
                                "text": "Each Pet Rock came in a cardboard carrying case, complete with air holes, tenderly nestled on a bed of excelsior."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c6f1b3-2b21-4bc9-81cb-5796eef133f2",
                        "source_entry_id": "4d501344-fe44-3766-88d6-12b5e62da621",
                        "source_sense_description": "3-point type",
                        "target_lang_word": "kwart cicero",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5ff89d08-832d-4860-82a6-d42d9bf0cf92",
                        "source_entry_id": "4d501344-fe44-3766-88d6-12b5e62da621",
                        "source_sense_description": "3-point type",
                        "target_lang_word": "diamant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diamant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b570c3-d072-37de-ab1e-22012bafdf1a",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Corps simple le plus dur du règne minéral, constitué de carbone cristallisé dans le système cubique, utilisé en joaillerie et dans l’industrie. Sa formule chimique est C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "165bfebc-92ec-4a1a-bd77-53728bd1e2c7",
                                                "sense_id": "c2b570c3-d072-37de-ab1e-22012bafdf1a",
                                                "text": "Ce premier mémoire est terminé par des rapprochemens très-ingénieux, qui résultent de la comparaison de la plombagine, de l’anthracite, du charbon et du diamant."
                                            },
                                            {
                                                "example_id": "7db0b4d9-a02e-491c-9dd2-7c5e6e5c31ee",
                                                "sense_id": "c2b570c3-d072-37de-ab1e-22012bafdf1a",
                                                "text": "Il ne faut pas confondre la dureté du diamant avec la propriété qu’il possède, comme tous les corps, d’être cassable. Les anciens croyaient le diamant incassable ; c'est une erreur."
                                            },
                                            {
                                                "example_id": "1ca06370-a14b-42ef-83ea-13f29485f85f",
                                                "sense_id": "c2b570c3-d072-37de-ab1e-22012bafdf1a",
                                                "text": "Les carbones sont des diamants polycristallins formés d'une matrice poreuse de cristallites anhédrales de très petites dimensions, de 0,5 à 20 microns, orientées au hasard, et entourant parfois des cristaux octaédriques ou cubiques bien formés de diamant, qui seraient de première génération, et atteignent 500 μ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e2bbc6d-c3ad-321c-85e1-6f864993e5f2",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Pierre précieuse transparente à laquelle la taille et le polissage confèrent un grand éclat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd55047-ffe4-4a7d-8b09-670cd329ffa9",
                                                "sense_id": "2e2bbc6d-c3ad-321c-85e1-6f864993e5f2",
                                                "text": "Et elle glissa dans son corsage, tout raide de broderies et de diamants, cette lettre qui sortait du pourpoint du jeune homme."
                                            },
                                            {
                                                "example_id": "82c0fab9-8de3-428d-b861-6f896fc4b428",
                                                "sense_id": "2e2bbc6d-c3ad-321c-85e1-6f864993e5f2",
                                                "text": "Au moral, la mairesse était, si vous voulez, du strass ; mais, pour les sauvages, le strass ne vaut-il pas le diamant ?"
                                            },
                                            {
                                                "example_id": "e12e2ed6-99a1-4a6a-9315-85c396647f0e",
                                                "sense_id": "2e2bbc6d-c3ad-321c-85e1-6f864993e5f2",
                                                "text": "Élie Magus, à force d’acheter des diamants et de les revendre, de brocanter les tableaux et les dentelles, les hautes curiosités et les émaux, jouissait d’une immense fortune inconnue, acquise dans ce commerce devenu si considérable."
                                            },
                                            {
                                                "example_id": "8aea867d-6329-4fbd-af05-2e9cd771b8d6",
                                                "sense_id": "2e2bbc6d-c3ad-321c-85e1-6f864993e5f2",
                                                "text": "Jelly Roll a non seulement plusieurs dents en or, mais une incisive où je crois voir briller un diamant. Interrogé, il répond que c’est bien un diamant et ajoute qu’au temps de sa splendeur, il raffolait des diamants et en portait partout : sur sa cravate, ses bretelles, ses fixe-chaussettes, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e9caf6a-13ae-3fd4-a9a6-b295c03f6571",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Outil de vitrier, de miroitier, etc., qui consiste en une pointe de diamant fixée à un manche et qui sert à couper le verre et les glaces."
                                        ],
                                        "tags": [
                                            "Verrerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5144c5c6-4c9b-443f-aa88-ea6b888fb1ee",
                                                "sense_id": "6e9caf6a-13ae-3fd4-a9a6-b295c03f6571",
                                                "text": "Sur une glace, ils tracent des traits au diamant, collodionnent la face ainsi gravée et, après sensibilisation, exposent à la lumière par le revers de la plaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eceaa8fd-b209-3cc7-b7d2-146bbf0fe166",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Pointe d’un tourne-disque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afb4fb0-667b-4d6b-b2f9-4e71f8ed91ad",
                                                "sense_id": "eceaa8fd-b209-3cc7-b7d2-146bbf0fe166",
                                                "text": "Le diamant de l’électrophone commençait à être usé."
                                            },
                                            {
                                                "example_id": "c9bad871-0383-417b-a0c3-af98da8381fa",
                                                "sense_id": "eceaa8fd-b209-3cc7-b7d2-146bbf0fe166",
                                                "text": "Je sortis de sa pochette un de mes 33 tours préférés, l’installai sur le plateau du tourne-disque, tirai le bras vers la droite pour actionner le moteur, et posai délicatement le diamant sur le bord du sillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2226ef7c-641e-35b5-9c55-3bb5ba6c048a",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Symbole de la dureté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b27ac763-8a14-4d5a-8119-0702d518f87f",
                                                "sense_id": "2226ef7c-641e-35b5-9c55-3bb5ba6c048a",
                                                "text": "Vos ongles de tigre et de femme n'ont pas de prise sur ce cœur de diamant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa62965c-cbec-3aba-86f6-0fde39d3ae73",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Symbole de la pureté cristalline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "784a0c83-5178-4e6d-aafe-18cb34e3bf39",
                                                "sense_id": "aa62965c-cbec-3aba-86f6-0fde39d3ae73",
                                                "text": "Avoir une voix de diamant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6e35d1b-689f-31b1-9538-47911567762b",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Symbole de la préciosité, perle, trésor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16445ee-1dcf-405d-b7e7-188f497e2286",
                                                "sense_id": "c6e35d1b-689f-31b1-9538-47911567762b",
                                                "text": "Le château d’Azay, diamant taillé à facettes, serti par l’Indre, monté sur des pilotis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c489734-26a8-3f29-b87f-429ebe9a8ae3",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Petit format de livre très élégant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f6a96c1-af26-4dd9-9af4-79e34cbf8e2d",
                                                "sense_id": "6c489734-26a8-3f29-b87f-429ebe9a8ae3",
                                                "text": "Édition diamant."
                                            },
                                            {
                                                "example_id": "e0097796-395c-4b25-b0e8-03f1a57f9a81",
                                                "sense_id": "6c489734-26a8-3f29-b87f-429ebe9a8ae3",
                                                "text": "Avec l’aide de mon dictionnaire diamant, je parvins à soutenir une conversation fort passable pour un étranger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5a3dac7-7317-3a53-a57f-7f65c304955f",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Symbole de la durabilité, de la pérennité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1452d50e-9e06-4c54-9e7d-72502736ccd9",
                                                "sense_id": "c5a3dac7-7317-3a53-a57f-7f65c304955f",
                                                "text": "Les noces de diamant : Anniversaire célébrant la soixantième année de vie commune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed407d98-4855-38f4-b264-92a5f0d4e91d",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Oiseau, passereau de la famille des estrildidés, diamant mandarin, diamant modeste, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05353413-4d95-38bf-ac6b-4fa25c42aa91",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Point lumineux visible parfois juste avant la totalité d’une éclipse solaire et dû au relief lunaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6313d470-d93a-3bf3-9e43-45a9c6c035f7",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Pièce cornée blanche que les petits des animaux ovipares possèdent à l’extrémité du bec ou du museau lors de l’éclosion et utilisent pour casser la coquille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0580b3e-4c16-421e-acc9-b7c5b6110763",
                                                "sense_id": "6313d470-d93a-3bf3-9e43-45a9c6c035f7",
                                                "text": "Le poussin est aidé dans ce travail par un organe transitoire, le « diamant », qui a commencé à s’ébaucher dès la fin de la première semaine d’incubation et s’est bien développé dans les derniers jours de celle-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd1db3e-0f79-3868-a077-06e115703b2e",
                                        "entry_id": "4ad392c9-1952-308d-a9ba-8daa40262759",
                                        "glosses": [
                                            "Partie d’une ancre marine située à l’opposé de son organeau en bas de la verge, c'est de là que partent les bras de l’ancre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
