        "fr-extract.jsonl": [
            {
                "entry_id": "cede09f5-72be-39de-a549-cc6799093981",
                "word": "viticulteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4e77386a-5dee-40b4-9b3b-b6c1f54d0e10",
                        "entry_id": "cede09f5-72be-39de-a549-cc6799093981",
                        "tags": [
                            "plural"
                        ],
                        "form": "viticulteurs"
                    },
                    {
                        "form_id": "23e3697c-47ae-411d-9745-c656604fccbe",
                        "entry_id": "cede09f5-72be-39de-a549-cc6799093981",
                        "tags": [
                            "feminine"
                        ],
                        "form": "viticultrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8bc1d72-c148-3afa-ba76-6867425f28c1",
                        "entry_id": "cede09f5-72be-39de-a549-cc6799093981",
                        "glosses": [
                            "Celui qui fait de la viticulture, qui cultive la vigne pour en faire du vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515b672a-0d44-468c-8041-143c1837d2d5",
                                "sense_id": "d8bc1d72-c148-3afa-ba76-6867425f28c1",
                                "text": "Le syndrome du garde champêtre, on le retrouve dans le processus qui a fait disparaître du langage « vigneron » au profit de « viticulteur ». Il se renforce ici du prestige de la technicité. Mais voici le viticulteur dépassé : la publicité qui s’étale sur les camions de livraison de telle vedette viticole de la nouvelle vague nous enseigne que ce producteur se distinguant des vulgaires viticulteurs, ses confrères, s’est promu oeniculteur."
                            },
                            {
                                "example_id": "f48fcb27-8124-4928-aff8-654e670e879c",
                                "sense_id": "d8bc1d72-c148-3afa-ba76-6867425f28c1",
                                "text": "Dans la production des vins blancs, en plus du sauvignon, du colombard ou du chardonnay, nous utilisons du chauché, poursuit le viticulteur. C’est un vieux cépage qui était employé au Moyen Âge et qui a été remis au goût du jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9411ac2-0a83-3825-b5d1-ec33633797e9",
                        "entry_id": "cede09f5-72be-39de-a549-cc6799093981",
                        "glosses": [
                            "Exploitant agricole d’un vignoble."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cab3ec35-5a7c-4050-8e97-c4b43833ef34",
                        "source_entry_id": "cede09f5-72be-39de-a549-cc6799093981",
                        "target_lang_word": "Winzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                        "entry_id": "65fe7d71-9043-3e4d-bf2b-43c2e8b44c4a",
                                        "glosses": [
                                            "Person, die beruflich Wein an- und teilweise auch ausbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dee3acd-d13b-46f4-b1ab-6d35b5d9796c",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„Günther Jauch wird Winzer. Bald schon wird ihm das Weingut von Othegraven im 600-Seelen-Örtchen Kanzem an der Saar gehören.“"
                                            },
                                            {
                                                "example_id": "29384e2e-5c17-4917-9bb1-b01bd3e788be",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„Die Winzer von Saale und Unstrut rechnen mit erheblichen Ertragseinbußen. Sie befürchten im Vergleich zu den Vorjahren Ausfälle zwischen 70 und 80 Prozent.“"
                                            },
                                            {
                                                "example_id": "894b4b38-cdcf-4483-8088-03ad21052ba1",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„Der Winzer war braungebrannt und jung und sah aus wie eine widernatürliche Kreuzung zwischen Adonis uns Apoll.“"
                                            },
                                            {
                                                "example_id": "ba4aabb4-650e-45a0-8cfa-176a78be45e7",
                                                "sense_id": "1a76cce9-fa0b-3931-842b-8640131d35df",
                                                "text": "„In diesem Zusammenhang müssen wir aus übervollem Herzen ein Wort des Dankes und der Bewunderung an unsere wackeren Winzer richten, denen wir unser edelstes Teil verdanken: den Wein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
