                "senses": [
                    {
                        "sense_id": "a3ab52f3-8b9e-3625-b3f8-df889f306eae",
                        "entry_id": "1e716493-5877-3dac-adb7-7a6a5c2f908f",
                        "glosses": [
                            "weibliche Person, die hobbymäßig oder beruflich Bilder zeichnet (oder auch: Urheberin einer Zeichnung, die nicht ständig, vielleicht nur einmal zeichnet beziehungsweise gezeichnet hat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40805847-f294-452e-9a15-9e0d02de6ff3",
                                "sense_id": "a3ab52f3-8b9e-3625-b3f8-df889f306eae",
                                "text": "Sie steht in dem Ruf, eine sehr gute Zeichnerin zu sein."
                            },
                            {
                                "example_id": "968d737a-4230-4392-b9af-b8b3945ec83e",
                                "sense_id": "a3ab52f3-8b9e-3625-b3f8-df889f306eae",
                                "text": "„Außerdem hatte das Blatt eine tüchtige Zeichnerin.“"
                            },
                            {
                                "example_id": "a3e6b179-0754-4528-a107-d95084b1a312",
                                "sense_id": "a3ab52f3-8b9e-3625-b3f8-df889f306eae",
                                "text": "„Dass sie, eine begabte Zeichnerin und Illustratorin seiner Bücher, nach einer Kinderlähmung gehbehindert ist und am Stock geht, erhöht das Flair des mondänen Paars.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
