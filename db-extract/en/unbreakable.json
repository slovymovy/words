                    {
                        "translation_id": "f4bf6140-f5f5-4807-9c48-327fddd915ea",
                        "source_entry_id": "ca62280a-c2ec-3911-9d9d-d63978a1c227",
                        "source_sense_description": "difficult or impossible to break",
                        "target_lang_word": "incassable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incassable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d51f7e9-ecee-3a05-af80-ae6a8ef52b93",
                                        "entry_id": "de55530b-fd35-352f-8a74-25fbc9c7ad85",
                                        "glosses": [
                                            "Qui ne peut être cassé ou qui ne l’est que difficilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f86f9e7-4d3d-43ee-976e-812a9c8b284f",
                                                "sense_id": "8d51f7e9-ecee-3a05-af80-ae6a8ef52b93",
                                                "text": "Il ne faut pas confondre la dureté du diamant avec la propriété qu’il possède, comme tous les corps, d’être cassable. Les anciens croyaient le diamant incassable ; c'est une erreur."
                                            },
                                            {
                                                "example_id": "600b0c40-3627-4f28-b898-a569afcac871",
                                                "sense_id": "8d51f7e9-ecee-3a05-af80-ae6a8ef52b93",
                                                "text": "L’Artiste a aussi inventé une calèche de campagne, à laquelle il joindra l’essieu incassable, qu’on ne graisse qu’une fois le mois."
                                            },
                                            {
                                                "example_id": "2f3bb09c-0236-482e-b1f3-90ab9a15bffc",
                                                "sense_id": "8d51f7e9-ecee-3a05-af80-ae6a8ef52b93",
                                                "text": "Mais voici une première difficulté, que ne manquera pas de relever notre assureur : aussi près d’une cour de récréation, il fallait des vitres incassables."
                                            },
                                            {
                                                "example_id": "a69acfc5-3a6f-4a6e-83d0-87ea54644ea5",
                                                "sense_id": "8d51f7e9-ecee-3a05-af80-ae6a8ef52b93",
                                                "text": "Ils se représentaient les atomes comme de petites billes incassables d’où leur nom « atome » qui veut justement dire en grec « incassable »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "217ffae3-a259-32f0-9977-9863ab9217c4",
                                        "entry_id": "de55530b-fd35-352f-8a74-25fbc9c7ad85",
                                        "glosses": [
                                            "Se dit d’un jugement qui ne peut pas faire l’objet d’un recours en cassation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a7b0eb-af00-48b2-8e83-01851f2c2533",
                                                "sense_id": "217ffae3-a259-32f0-9977-9863ab9217c4",
                                                "text": "On n’a eu aucun égard aux Requêtes en cassation présentées contre le Jugement du Conseil de guerre aux Invalides, dans lequel on établissait une miltitude de vices de forme, par la raison qu’un Jugement de Conseil de guerre est incassable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
