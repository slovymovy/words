                "senses": [
                    {
                        "sense_id": "6bf7c1b7-96e3-373a-9527-8d9927d93164",
                        "entry_id": "f7f104ac-8a36-3b64-b8f6-1722599901c2",
                        "glosses": [
                            "een spannende, kort durende liefdesgeschiedenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b756d8-0052-4c45-99eb-ca7d649d35e8",
                                "sense_id": "6bf7c1b7-96e3-373a-9527-8d9927d93164",
                                "text": "Het zijn eenvoudige verhalen, afgestemd op een bepaald publiek, verhalen waarin de dokter niet alleen de centrale held is, maar waarin hij ook steevast in een liefdesavontuur is verwikkeld."
                            },
                            {
                                "example_id": "1573d95f-dfb0-4147-b9dc-51a6a06a7e63",
                                "sense_id": "6bf7c1b7-96e3-373a-9527-8d9927d93164",
                                "text": "Zij rijden zwijgend, Dirk Egberts gedachten zijn bij de moeilijk te vinden weg, bij de gecompliceerdheid van zijn plannen, hij vergeet bijkans dat hij tevens een liefdesavontuur tegemoet gaat."
                            }
                        ]
                    }
