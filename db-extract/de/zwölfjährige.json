                "senses": [
                    {
                        "sense_id": "4f341b5b-4b2a-3200-ac79-db1b54d528ba",
                        "entry_id": "28fe7be0-30d9-3d82-bbc8-c79a82d0b511",
                        "glosses": [
                            "Mädchen im Alter von zwölf Jahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "797b7295-e5c6-4090-b4a4-779ec6f6eba5",
                                "sense_id": "4f341b5b-4b2a-3200-ac79-db1b54d528ba",
                                "text": "„Therese hatte seit jeher einen offenen, neugierigen Blick für alles, was nach Vornehmheit und Eleganz aussah; als Zwölfjährige schon in Lemberg hatte sie für einen hübschen jungen Erzherzog geschwärmt, der im Regiment des Vaters als Leutnant diente, […]“"
                            },
                            {
                                "example_id": "62cf7640-fb13-4643-a1ac-27d037437ad3",
                                "sense_id": "4f341b5b-4b2a-3200-ac79-db1b54d528ba",
                                "text": "„Unter den Blockierern an der A100 war auch eine Zwölfjährige, wie die Aktivisten der Gruppe ‚Aufstand der letzten Generation‘ mitteilten.“"
                            },
                            {
                                "example_id": "9549aaa1-2589-4acb-b5d9-2343dd72a8de",
                                "sense_id": "4f341b5b-4b2a-3200-ac79-db1b54d528ba",
                                "text": "„Die seit Montagmittag vermisste Zwölfjährige aus Paderborn wurde am späten Dienstagabend wohlbehalten in Hamburg am Hauptbahnhof von Polizeibeamten angetroffen, teilt die Kreispolizeibehörde Paderborn mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
