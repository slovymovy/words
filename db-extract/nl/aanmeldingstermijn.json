                        "examples": [
                            {
                                "example_id": "6557caed-061e-494c-8d25-aadceefec7d8",
                                "sense_id": "1b123962-003d-34fe-bd20-e87abd8ea92a",
                                "text": "Maar vervolgens meldden zich in korte tijd veel meer mensen voor een gesprek dan verwacht, ruim 7800. De aanmeldingstermijn werd daarop meteen gesloten. Het ministerie wijst erop dat niet alle mensen die belangstelling hebben getoond, daadwerkelijk weggaan. Het departement verwacht dat het er maximaal 5800 worden."
                            },
                            {
                                "example_id": "7621f22e-c2e1-4a06-b62f-10e0ad6c5209",
                                "sense_id": "1b123962-003d-34fe-bd20-e87abd8ea92a",
                                "text": "Ramon Vega, een voormalig profvoetballer uit Zwitserland, stelde nog voor het verstrijken van de aanmeldingstermijn dat hij zich ook kandidaat wilde stellen. Vega zei veel positieve reacties te hebben ontvangen naar aanleiding van zijn beoogde deelname aan de verkiezing."
                            }
                        ]
