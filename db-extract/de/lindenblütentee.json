                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baee6e88-9f97-4401-8679-6ba0d0431eea",
                                "sense_id": "9fcbff9d-9cd2-3d23-8539-fbcbaaa45a97",
                                "text": "Für Lindenblütentee sind am besten die Blüten der Sommerlinde geeignet."
                            },
                            {
                                "example_id": "62475bba-3070-4481-bf78-f13a847d8a0d",
                                "sense_id": "9fcbff9d-9cd2-3d23-8539-fbcbaaa45a97",
                                "text": "„Marja Dmitrijewna legte ihr ein Kissen unter den Kopf, deckte sie mit zwei Decken zu und brachte ihr selbst heissen Lindenblütentee.“"
                            }
                        ],
