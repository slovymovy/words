                "senses": [
                    {
                        "sense_id": "f1e15bbf-1591-3e39-833d-5af9844dc2b9",
                        "entry_id": "b58faed2-36a5-386c-9b67-73d633346dce",
                        "glosses": [
                            "Allocation de chômage majorée pour les travailleurs qui sont licenciés après un certain âge."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "e6b25d41-0f02-4e34-b2f4-8fa8adbca37a",
                                "sense_id": "f1e15bbf-1591-3e39-833d-5af9844dc2b9",
                                "text": "D’après nos informations, les prépensions sont repoussées à 58 ans, mais il reste des possibilités de partir à 55 ans."
                            },
                            {
                                "example_id": "93b75e78-be98-4f79-b271-307448eee474",
                                "sense_id": "f1e15bbf-1591-3e39-833d-5af9844dc2b9",
                                "text": "La prépension n’est donc pas applicable aux travailleurs qui donnent eux-mêmes leur démission."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8afc8678-7414-4bdd-843a-65f77dd4cf15",
                        "source_entry_id": "b58faed2-36a5-386c-9b67-73d633346dce",
                        "source_sense_id": "f1e15bbf-1591-3e39-833d-5af9844dc2b9",
                        "target_lang_word": "Frühpension",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frühpension",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dafdb6a1-1699-3967-9a1a-4a1b6c6ebe0e",
                                        "entry_id": "7e93cb20-b00d-38ee-b3bf-ea8cf4fb0bdb",
                                        "glosses": [
                                            "Rente (Pension) vor dem Ende der üblichen Lebensarbeitszeit, oftmals bei bestehender Erwerbsunfähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d4548ed-bbca-4789-8ccf-27daef72e6ac",
                                                "sense_id": "dafdb6a1-1699-3967-9a1a-4a1b6c6ebe0e",
                                                "text": "„Wir kaschieren in Österreich die Arbeitslosigkeit (konkret vor allem die Altersarbeitslosigkeit, die immer Langzeitarbeitslosigkeit ist) durch die Frühpension.“"
                                            },
                                            {
                                                "example_id": "56c638e5-283c-4e96-b71d-cc652ce26d8d",
                                                "sense_id": "dafdb6a1-1699-3967-9a1a-4a1b6c6ebe0e",
                                                "text": "„Solange man mit ein paar Jahren Arbeitslosigkeit bevorzugt in Frühpension gehen kann, wird es immer genügend 55jährige (Männer) und 50jährige (Frauen) geben, die nicht eine neue Stelle anstreben, sondern in Pension gehen wollen.“"
                                            },
                                            {
                                                "example_id": "221f1109-9b4d-4731-8507-8213a728fb5c",
                                                "sense_id": "dafdb6a1-1699-3967-9a1a-4a1b6c6ebe0e",
                                                "text": "„Wenn, dann käme die Frühpension infrage. Aber dann reicht das Geld nicht, sie hat zwei Töchter zu versorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
