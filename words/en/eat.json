    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                    "sense_definition": "To consume food by putting it into the mouth and swallowing it.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ingestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>eating</w> a red apple for his afternoon snack.",
                            "target_lang_translations": {
                                "ru": "Он <w>ест</w> красное яблоко на полдник."
                            }
                        },
                        {
                            "text": "I like to <w>eat</w> breakfast early in the morning before work.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>завтракать</w> рано утром перед работой."
                            }
                        }
                    ],
                    "synonyms": [
                        "consume",
                        "devour",
                        "swallow",
                        "have"
                    ],
                    "common_phrases": [
                        "eat breakfast",
                        "eat lunch",
                        "eat dinner",
                        "something to eat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потреблять пищу, помещая её в рот и проглатывая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "принимать пищу"
                            },
                            {
                                "target_lang_word": "кушать",
                                "target_lang_sense_clarification": "разговорный, часто вежливый вариант"
                            },
                            {
                                "target_lang_word": "питаться",
                                "target_lang_sense_clarification": "регулярно принимать пищу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f60dac4a-481e-3171-862d-dbf8ba85520e",
                    "sense_definition": "To have a meal.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ingestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "What time do you usually <w>eat</w> in the evening?",
                            "target_lang_translations": {
                                "ru": "В какое время вы обычно <w>едите</w> по вечерам?"
                            }
                        },
                        {
                            "text": "We decided to <w>eat</w> out at a new Italian restaurant tonight.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>поесть</w> вне дома в новом итальянском ресторане сегодня вечером."
                            }
                        }
