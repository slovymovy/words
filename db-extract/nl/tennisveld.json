                        "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                        "entry_id": "a7710a3e-4d8c-35fb-af0b-37c3fb503a91",
                        "glosses": [
                            "veld waarop men tennis kan spelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d9d43d-0100-4136-90aa-fb0afa4eaf7a",
                                "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                "text": "Maar allemaal samen is het absorberende oppervlak dat gevormd wordt door de kleine gaatjes erin zo groot als een tennisveld."
                            },
                            {
                                "example_id": "6945bae1-07e3-4747-acac-d1d05dfaa40e",
                                "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                "text": "De liefde voor voetballen hebben ze van Marcel meegekregen, ik vertoefde liever op het naastgelegen tennisveld."
                            },
                            {
                                "example_id": "8d21e6e9-8867-44dd-9249-7c80e2a8b99d",
                                "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                "text": "\"Hij is mijn vriend, hij is mijn coach en ik kan wel zeggen dat hij ook soms mijn vader is\", vertelde Alcaraz, die op zijn vijftiende toetrad tot de tennisacademie van Ferrero. \"Hij was nummer een van de wereld en ik heb zo veel van hem geleerd. Ik ben heel dankbaar om hem in mijn spelersbox te hebben, maar ook buiten het tennisveld.\""
                            }
                        ]
                    }
