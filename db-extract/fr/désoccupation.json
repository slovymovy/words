                        "target_lang_word": "ανεργία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ανεργία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "c8f887ac-874e-3c7e-8434-2a22f179637b",
                                        "entry_id": "26bfe20f-815a-3fb2-b691-434afd7440cd",
                                        "glosses": [
                                            "η κατάσταση του ανέργου, του ανθρώπου που επιθυμεί να εργαστεί, αλλά δε βρίσκει δουλειά"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aaf1aca-9ab9-41f4-a7d6-e8fe396fa16a",
                                                "sense_id": "c8f887ac-874e-3c7e-8434-2a22f179637b",
                                                "text": "επίδομα ανεργίας"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3fa382f-0ef4-387c-9240-a3736405216c",
                                        "entry_id": "26bfe20f-815a-3fb2-b691-434afd7440cd",
                                        "glosses": [
                                            "η κατάσταση κατά την οποία υπάρχουν περισσότερα άτομα που ψάχνουν απασχόληση από τις προσφερόμενες θέσεις εργασίας"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af83cb3b-89f1-40d3-8ded-c73e3745d2a0",
                                                "sense_id": "f3fa382f-0ef4-387c-9240-a3736405216c",
                                                "text": "※ Όπως είναι φανερό, η διαρθρωτική ανεργία δημιουργείται από τη δυσαναλογία προσφοράς και ζήτησης των διαφόρων ειδικεύσεων. Η μείωσή της απαιτεί επανεκπαίδευση των ανέργων, ώστε να αποκτήσουν τις ειδικεύσεις στις οποίες υπάρχει έλλειψη. (Θεόδωρος Π. Λιανός, Απλά μαθήματα οικονομίας, εκδ. Παπαζήσης, 2015)"
                                            },
                                            {
                                                "example_id": "b4fafddd-765d-456a-b39c-7968d4a95c51",
                                                "sense_id": "f3fa382f-0ef4-387c-9240-a3736405216c",
                                                "text": "αναμένεται να αυξηθεί και φέτος το ποσοστό ανεργίας"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
