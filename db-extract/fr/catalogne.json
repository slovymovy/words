                "senses": [
                    {
                        "sense_id": "2c885ed3-13ff-38e4-99ce-da6ad4c808f6",
                        "entry_id": "b2c13e5b-8aea-3e4f-af5e-09160b797934",
                        "glosses": [
                            "Région autonome en Espagne, dont la langue locale est le catalan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef0ddcda-b45a-4ab9-b678-7523fcf12cef",
                                "sense_id": "2c885ed3-13ff-38e4-99ce-da6ad4c808f6",
                                "text": "Nils Guyon, très performant en Catalogne comme lors de tous les tournois estivaux de 2021, est encore de la fête."
                            },
                            {
                                "example_id": "5e6ade97-2132-4f05-b2fa-183c0cb190d5",
                                "sense_id": "2c885ed3-13ff-38e4-99ce-da6ad4c808f6",
                                "text": "Chênes de Bourgogne, frênes d’Amérique, anémones, érables de Montpellier, merisiers… Plus de 470 arbres d’espèces différentes vont pousser dorénavant sur la place de Catalogne, dans le 14ᵉ arrondissement, transformant un rond-point minéral en une zone pleine d’arbres."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "17b07b05-570f-395e-a029-1eb4f7aa5bb9",
                "word": "Catalogne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ff63a5e-081c-3929-a0c1-07279282ba5c",
                        "entry_id": "17b07b05-570f-395e-a029-1eb4f7aa5bb9",
                        "glosses": [
                            "Tissu de type toile, composé de chaîne en fil de coton et trame en bandelettes de tissu de coton, pouvant être intercalées par une ou plusieurs duites de fil semblable à la chaîne. De tradition ancestrale, la catalogne est souvent utilisées pour faire des couvre-lits ou des tapis."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5dade2e-feca-4bd8-be10-c0417972c0a5",
                        "source_entry_id": "17b07b05-570f-395e-a029-1eb4f7aa5bb9",
                        "source_sense_id": "8ff63a5e-081c-3929-a0c1-07279282ba5c",
                        "target_lang_word": "Katalonien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katalonien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                        "entry_id": "dfc6b498-0c89-3098-96ff-af2193a384b4",
                                        "glosses": [
                                            "Landschaft und Region (Autonome Region, was in etwa dem deutschen \\\"Bundesland\\\" entspricht) in Nordost-Spanien mit der Hauptstadt Barcelona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84c270f8-c564-448c-b6c2-da0fc70ec720",
                                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                                "text": "Katalonien ist mit seiner schönen Küste, der Costa Brava, und mit seinen herrlichen Bergen, den Pyrenäen, ein landschaftlich aber ebenso kulturell sehr vielseitiges Land."
                                            },
                                            {
                                                "example_id": "64f9646c-768b-4b64-9468-fd9608abb2b0",
                                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                                "text": "„In Katalonien, dem reichsten und - neben dem Baskenland - rebellischsten Teil Spaniens, hat sich nun eine Mehrheit des Regionalparlaments dafür ausgesprochen, jene \"klassischen\" Stierkämpfe zu verbieten, in denen der Stier - nach einem genau festgelegten Ritual - getötet wird.“"
                                            },
                                            {
                                                "example_id": "10db35eb-0670-4123-8823-abb6c932ca9c",
                                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                                "text": "Der Name Katalonien \"taucht erstmals in einem Gedicht des 12. Jahrhunderts auf, in dem der Graf Ramon Berenguer III. \"Dux Catalensis\" genannt wird.\""
                                            },
                                            {
                                                "example_id": "5160feb4-8010-4de4-b68c-c30e99657f8d",
                                                "sense_id": "1161c7fe-b0d0-3104-a730-2285fded649f",
                                                "text": "„Katalonien war schon lange mediterrane Handelsmacht, als die katholischen Könige gerade ihren Kolumbus über den Atlantik schickten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
