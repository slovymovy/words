                                        "glosses": [
                                            "En France, l'activité physique adaptée (APA) permet de faire le lien entre les activités physiques-sportives ordinaires et le handicap (physique et/ou mental)."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32aedff-5f6b-49a1-b47c-0c94ae34d76f",
                                                "sense_id": "d50c6752-2b6b-346d-9374-119c0fc2b4a0",
                                                "text": "Chaque séance d’APA dure entre 45 et 60 minutes et associe des activités d’endurance, d’aérobie et de renforcement musculaire."
                                            }
                                        ]
                                    }
                                ]
                            },
