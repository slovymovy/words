                "senses": [
                    {
                        "sense_id": "a10fc524-4866-3b3c-97f6-850735130f56",
                        "entry_id": "bc87da32-d578-3a0f-a44b-b0f23ae3d3e1",
                        "glosses": [
                            "Bailler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f178eb4-dcc3-41c8-91a0-f93ad71b3303",
                                "sense_id": "a10fc524-4866-3b3c-97f6-850735130f56",
                                "text": "Ne devais-je être sage et me ressouvenir\nD’avoir vu la lumière aux aveugles rendue,\nRebailler aux muets la parole perdue,\nEt faire dans les corps les âmes revenir ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "33a8eb06-e31e-38a3-8c2d-ef9efa3e4b5f",
                        "entry_id": "bc87da32-d578-3a0f-a44b-b0f23ae3d3e1",
                        "glosses": [
                            "Redonner à bail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b67be4d-b434-4348-9d79-9a6dddaa4e0d",
                                "sense_id": "33a8eb06-e31e-38a3-8c2d-ef9efa3e4b5f",
                                "text": "Après que ledit sieur Letelier eut acquis le total de la propriété desdits quatrièmes, ils furent réunis à la recette des aides et rebaillés au profit du fermier général."
                            }
                        ]
                    }
