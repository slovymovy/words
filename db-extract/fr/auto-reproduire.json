                ],
                "senses": [
                    {
                        "sense_id": "6edbdadc-0060-3912-98c4-bfa2d3d317ec",
                        "entry_id": "4da66884-5a32-3695-8815-3e7697e8b33b",
                        "glosses": [
                            "Reproduire sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6c760d7-7730-4b14-88a3-833e512f6221",
                                "sense_id": "6edbdadc-0060-3912-98c4-bfa2d3d317ec",
                                "text": "On peut s’interroger sur cette violence qui pourrait être, au contraire, une manière d’auto-reproduire un système basé sur l’agressivité et la violence."
                            },
                            {
                                "example_id": "4edbe7ca-3e4a-4f61-ad22-d5c2cbadf6ca",
                                "sense_id": "6edbdadc-0060-3912-98c4-bfa2d3d317ec",
                                "text": "Ainsi il ne s’agit pas de comprendre la vie telle qu’elle est, mais de saisir d’autres formes possibles de vie, de structures avec possibilité de s’auto-organiser et de s’auto-reproduire."
                            }
                        ]
                    }
