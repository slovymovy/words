                "senses": [
                    {
                        "sense_id": "1cab4445-e714-3bd3-b563-fa9f8e9958a7",
                        "entry_id": "1cb085d6-609d-3ade-ba7e-32c11b55e861",
                        "glosses": [
                            "Prospection et extraction artisanale de l’or à partir de puits individuels à ciel ouvert, ou dans les rivières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee989796-742b-48c7-8543-e61ac7ebf338",
                                "sense_id": "1cab4445-e714-3bd3-b563-fa9f8e9958a7",
                                "text": "Dans les régions où il est abondamment pratiqué, l’orpaillage est la principale source de pollution au mercure."
                            },
                            {
                                "example_id": "3be759be-62d1-4c25-87c9-88a9fa6fd4b2",
                                "sense_id": "1cab4445-e714-3bd3-b563-fa9f8e9958a7",
                                "text": "Mais le sous-secteur artisanal, aussi appelé orpaillage, emploie 1,5 million de personnes, et génère une production annuelle supplémentaire d’environ 10 tonnes d’or, selon le ministère des Mines."
                            },
                            {
                                "example_id": "a2583eac-319f-4cfa-ae81-0dbde8cc837d",
                                "sense_id": "1cab4445-e714-3bd3-b563-fa9f8e9958a7",
                                "text": "En 2018, la brigade de gendarmerie de Saint-Georges-de-l’Oyapock reconnaissait avoir l’accord du parquet pour fournir le home indien en denrées alimentaires non périssables saisies dans le cadre de la lutte contre l’orpaillage clandestin."
                            }
                        ]
                    }
                ],
