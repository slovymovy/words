                "senses": [
                    {
                        "sense_id": "d59ebefd-2a6f-3bf8-96eb-d0a0c1b71f56",
                        "entry_id": "e58bcf27-6ca2-3b77-bb43-9a78412e0626",
                        "glosses": [
                            "weibliche Person, die gefälschte Urkunden herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3138c70-95fb-41fe-a60c-db8f03352dbd",
                                "sense_id": "d59ebefd-2a6f-3bf8-96eb-d0a0c1b71f56",
                                "text": "Die Urkundenfälscherin konnte von der Polizei ausfindig gemacht und verhaftet werden."
                            },
                            {
                                "example_id": "45e59818-56c4-456f-a4d6-4aa3aae9f25e",
                                "sense_id": "d59ebefd-2a6f-3bf8-96eb-d0a0c1b71f56",
                                "text": "„Das Gericht verurteilte die Betrügerin und Urkundenfälscherin zu einer Bewährungsstrafe.“"
                            },
                            {
                                "example_id": "bc98190e-678a-40a2-8907-f25724cad791",
                                "sense_id": "d59ebefd-2a6f-3bf8-96eb-d0a0c1b71f56",
                                "text": "„Am 5. April 2001 erhob der Bezirksanwalt Anklage, nannte Christina Maria Kurmann aus Adliswil eine Urkundenfälscherin und Betrügerin.“"
                            },
                            {
                                "example_id": "3f9dd131-4002-4760-abb4-aaf675aae3b0",
                                "sense_id": "d59ebefd-2a6f-3bf8-96eb-d0a0c1b71f56",
                                "text": "„Streng genommen ist sie heute eine Urkundenfälscherin, wenn sie mit Gerda Casagrande unterschreibt, so wie sie das die vergangenen Jahrzehnte getan hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
