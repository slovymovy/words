        "fr-extract.jsonl": [
            {
                "entry_id": "fad0408f-b074-3e7e-bb1e-81d687001b04",
                "word": "biquette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3fd2b406-b858-4014-83ed-16026d995c45",
                        "entry_id": "fad0408f-b074-3e7e-bb1e-81d687001b04",
                        "tags": [
                            "plural"
                        ],
                        "form": "biquettes"
                    },
                    {
                        "form_id": "4147584e-bd94-426f-b055-56decbaa926d",
                        "entry_id": "fad0408f-b074-3e7e-bb1e-81d687001b04",
                        "tags": [
                            "recommandée par les rectifications orthographiques de 1990"
                        ],
                        "form": "biquète"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4e074eb-8f6c-3a19-8fce-4b2224cc1077",
                        "entry_id": "fad0408f-b074-3e7e-bb1e-81d687001b04",
                        "glosses": [
                            "Chèvre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "note": "Dans ce sens, le diminutif donne un sens plus affectueux que bique",
                        "examples": [
                            {
                                "example_id": "283ee23b-77f4-4952-9fe5-fa2bd4b9d7da",
                                "sense_id": "a4e074eb-8f6c-3a19-8fce-4b2224cc1077",
                                "text": "Fin de pause, la route nous attend. Les biquettes me narguent tout le long du chemin, sont-elles des amies de celle que j’avais percutée lors du dernier voyage ?"
                            },
                            {
                                "example_id": "c70ad331-cf98-4d7a-aa0c-73f23c05b456",
                                "sense_id": "a4e074eb-8f6c-3a19-8fce-4b2224cc1077",
                                "text": "Nourries au foin, les biquettes ne donnaient pas un lait aussi savoureux et parfumé. Rien ne valait les pâtures gourmandes du printemps et de l'été."
                            },
                            {
                                "example_id": "ee883cd3-2fd6-47d7-a33d-e0a62a01e50d",
                                "sense_id": "a4e074eb-8f6c-3a19-8fce-4b2224cc1077",
                                "text": "Dès le printemps, Julien, accompagné de son chien Fax, emmène les chèvres gambader sur le terril. C'est la transhumance. Les biquettes se nourrissent des broussailles. Elles permettent l'entretien de la végétation de cette réserve naturelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b987856-ffef-35fe-9d24-c9d503efcba3",
                        "entry_id": "fad0408f-b074-3e7e-bb1e-81d687001b04",
                        "glosses": [
                            "Chevreau ou chevrelle."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ff50f21d-2d4e-4952-8b93-9a987f50333b",
                                "sense_id": "0b987856-ffef-35fe-9d24-c9d503efcba3",
                                "text": "Les biquettes sont parfois un peu brusques dans leurs jeux, un peu folles dans leurs caprices. Tu penses ce qui advenait parfois du baby encore mal assuré sur ses bonnes petites jambes maladroites."
                            },
                            {
                                "example_id": "8304e2ac-d4f6-4d74-8a9f-80f5fdf707d9",
                                "sense_id": "0b987856-ffef-35fe-9d24-c9d503efcba3",
                                "text": "Trois étaient des biquettes et le quatrième un biquet."
                            }
                        ]
                    }
                ],
