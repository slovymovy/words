        "fr-extract.jsonl": [
            {
                "entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                "word": "caïd",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "105090a1-cd40-4e8c-876f-944e73085ba0",
                        "entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "tags": [
                            "plural"
                        ],
                        "form": "caïds"
                    },
                    {
                        "form_id": "acd0f00a-2952-4952-85b0-f856b9c62193",
                        "entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "tags": [],
                        "form": "kaïd"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "293d5799-14e2-3172-9367-2228a6605c0a",
                        "entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "glosses": [
                            "Gouverneur de province ou de ville chez les Arabes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59deb251-8929-4070-924f-40227d23ad27",
                                "sense_id": "293d5799-14e2-3172-9367-2228a6605c0a",
                                "text": "Ils [les saint-simoniens] plaident pour une administration des tribus par l’intermédiaire de caïds indigènes nommés par les bureaux arabes, voie vers une « véritable association franco-arabe » qui préparera « la fusion »."
                            },
                            {
                                "example_id": "8b86906a-5419-4c7b-bc51-a19b46a6f532",
                                "sense_id": "293d5799-14e2-3172-9367-2228a6605c0a",
                                "text": "En passant au large d’El-Kçar, nous vîmes au flanc des montagnes des Ahl Serif le camp de Raïssouli, qui mettait à la raison les derniers partisans de son ennemi mortel le caïd Er-Remiki."
                            },
                            {
                                "example_id": "887b3829-6fb5-4edc-803e-39f6885c6224",
                                "sense_id": "293d5799-14e2-3172-9367-2228a6605c0a",
                                "text": "La cause de ces insurrections est presque toujours la même : les exactions, les extorsions et mille autres injustices commises par les caïds (gouverneurs) qui, ayant acheté leur poste, ne songent qu’à rentrer dans leurs fonds et à s’enrichir aux dépens de leurs administrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc584a35-0d98-3c1f-80d9-c00e2d7b44f7",
                        "entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "glosses": [
                            "Chef d’une bande de voyous."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7994d238-a5ad-44d8-b076-4ded3943057f",
                                "sense_id": "cc584a35-0d98-3c1f-80d9-c00e2d7b44f7",
                                "text": "Le bigor Rezgui était un « caïd ». Il jouait du couteau dans les caves de sa « cité », agressait les vieilles, se vantait d’être dangereux."
                            },
                            {
                                "example_id": "9319c732-aecb-426e-86da-94be07b6cdf9",
                                "sense_id": "cc584a35-0d98-3c1f-80d9-c00e2d7b44f7",
                                "text": "Les caïds du milieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "d131c37d-1bc2-30c5-9631-f3b02eeef1fa",
                        "entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "glosses": [
                            "Homme ou femme s’imposant par la dureté, par sa force."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "65313a61-7ef8-4647-94e8-2a35a161e42a",
                                "sense_id": "d131c37d-1bc2-30c5-9631-f3b02eeef1fa",
                                "text": "Ils ont reçu 8000 $ de deux caïds pour une cargaison de 125 laveuses et sécheuses volées. Mais ils se sont faits arrêter par la police quatre jours plus tôt."
                            },
                            {
                                "example_id": "212e1cc7-7a6e-466a-aeb1-54e525ee085b",
                                "sense_id": "d131c37d-1bc2-30c5-9631-f3b02eeef1fa",
                                "text": "C’est une opération anti-occupation de l’espace public qu’a entamé la jeune Caïd d’Azrou, Chaimaa Chahbaoui, le 9 août dans la petite ville du Moyen-Âtlas."
                            },
                            {
                                "example_id": "ee273ba3-08b8-4bc2-a328-9ed32c9ad968",
                                "sense_id": "d131c37d-1bc2-30c5-9631-f3b02eeef1fa",
                                "text": "Il marchait d’un pas brutal de vainqueur […] Un conquistador en vérité, un caïd, un malabar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a58d5a9-5cb5-43a8-89ce-2c2bbebe425b",
                        "source_entry_id": "cbd4f159-67c9-34e2-aedb-28cb02cc9481",
                        "source_sense_description": "chef, commandeur arabe",
                        "target_lang_word": "caid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2146c33-51ad-3f57-979d-b30e24ae4eac",
                                        "entry_id": "ed3ef00e-7519-309d-a3c1-bca2fb8cb936",
                                        "glosses": [
                                            "A local governor or leader, especially in North Africa or Moorish Spain; an alcaide."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9500f12e-9d53-4c1a-b61e-a866fee383d1",
                                                "sense_id": "f2146c33-51ad-3f57-979d-b30e24ae4eac",
                                                "text": "Having taken over the land, the caids procured labour for themselves by conscripting people for forced farm work, calling the practice a form of Touiza, which was a centuries-old practice of mutual help in the rural areas."
                                            },
                                            {
                                                "example_id": "77364695-15f9-4a0f-b7a6-1abd7ef59f70",
                                                "sense_id": "f2146c33-51ad-3f57-979d-b30e24ae4eac",
                                                "text": "This results in frequent and severe conflicts which, if the provincial governor and the caid are unable to resolve them, are taken to the Ministry of the Interior in Rabat.\nThe office of caid can be considered an extension of the province head."
                                            },
                                            {
                                                "example_id": "19fcf6e4-5741-491c-bcaf-b9faa038ea56",
                                                "sense_id": "f2146c33-51ad-3f57-979d-b30e24ae4eac",
                                                "text": "Most of the process was in the hands of the caids who drew up first estimates of the taxable wealth. Then the local head of the Bureau Arab looked over these figures for the final fiscal census. This gave the caid much power."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac99422-cc70-3009-be81-27b1a1da59c7",
                                        "entry_id": "e23acb69-08c9-31ae-ab92-091655a9cb1f",
                                        "glosses": [
                                            "Any of various ancient and traditional Irish football games."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
