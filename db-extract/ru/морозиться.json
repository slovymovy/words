                "senses": [
                    {
                        "sense_id": "ee6966c5-0ee8-33d1-8bdc-ab8d3abd227b",
                        "entry_id": "92050230-2dad-32ae-8a4c-b7e03db09648",
                        "glosses": [
                            "страд. к морозить"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "42e669db-e81e-4a25-8635-af1df15c463a",
                                "sense_id": "ee6966c5-0ee8-33d1-8bdc-ab8d3abd227b",
                                "text": "Обычно пельмени лепятся в значительном количестве и морозятся впрок."
                            },
                            {
                                "example_id": "31ee4b09-0fd1-44e1-ad27-e489c1c00b95",
                                "sense_id": "ee6966c5-0ee8-33d1-8bdc-ab8d3abd227b",
                                "text": "Дольше рябина морозится — вкуснее будет."
                            }
                        ]
                    },
                    {
                        "sense_id": "1773410e-b0b5-34ff-8831-836ec562e8e4",
                        "entry_id": "92050230-2dad-32ae-8a4c-b7e03db09648",
                        "glosses": [
                            "жарг., мол. проявлять непоколебимость, безучастие, отмалчиваться, утаивать, скрываться, ломаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b27674b-c1fb-422b-a6fc-5852770932b6",
                                "sense_id": "1773410e-b0b5-34ff-8831-836ec562e8e4",
                                "text": "Мы ни морозиться, ни обжигаться не желали!"
                            },
                            {
                                "example_id": "dfe0ac7c-ba18-4884-996e-5ad89be8d218",
                                "sense_id": "1773410e-b0b5-34ff-8831-836ec562e8e4",
                                "text": "— Я ему говорю так и так, мол, а он морозится."
                            },
                            {
                                "example_id": "528d662a-fede-4812-811f-cd5dbf3eed56",
                                "sense_id": "1773410e-b0b5-34ff-8831-836ec562e8e4",
                                "text": "Ну что ты не говоришь, а морозишься!"
                            }
                        ]
                    }
                ],
