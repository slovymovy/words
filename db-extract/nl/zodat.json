                "senses": [
                    {
                        "sense_id": "2c58a147-0546-3be7-a938-c3f28e514129",
                        "entry_id": "30d10c0d-1d72-3122-aff7-c5a01e3c3435",
                        "glosses": [
                            "en daardoor"
                        ],
                        "tags": [
                            "geeft onderschikkend een gevolg aan"
                        ],
                        "examples": [
                            {
                                "example_id": "b0d34559-0a64-4e1b-a964-7d55ee469e55",
                                "sense_id": "2c58a147-0546-3be7-a938-c3f28e514129",
                                "text": "Het heeft geregend zodat de straten nat zijn."
                            },
                            {
                                "example_id": "e48c7291-7ccd-4093-8b59-19ec26cfe6ba",
                                "sense_id": "2c58a147-0546-3be7-a938-c3f28e514129",
                                "text": "Waarschijnlijk was het helemaal niet terecht geweest dat hij de twee Duitse schrijvers had vervloekt die om een of andere reden niet samen in het Grand Hotel in Saltsjôbaden wilden verblijven, zodat een van hen, helaas de bolsjewiek en niet de Nobelprijswinnaar, bij hen thuis in Villa Bellevue moest logeren."
                            }
                        ]
                    },
                    {
                        "sense_id": "d364df7c-45ce-3182-b2ee-2f82680091a0",
                        "entry_id": "30d10c0d-1d72-3122-aff7-c5a01e3c3435",
                        "glosses": [
                            "met de bedoeling dat"
                        ],
                        "tags": [
                            "geeft onderschikkend een doel aan"
                        ],
                        "examples": [
                            {
                                "example_id": "22abfa9b-7184-42ad-8f8c-a4ef97a03b89",
                                "sense_id": "d364df7c-45ce-3182-b2ee-2f82680091a0",
                                "text": "Ik spaar zodat ik later een huis kan kopen."
                            },
                            {
                                "example_id": "f05fd7e4-862a-4d43-ba7b-3e1b3b727d9c",
                                "sense_id": "d364df7c-45ce-3182-b2ee-2f82680091a0",
                                "text": "Zij had me gevraagd om altijd een extra liter water mee te nemen, zodat ik nooit zonder zou komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a31e3791-4b00-4e97-a9f6-34eeb350c300",
                        "source_entry_id": "30d10c0d-1d72-3122-aff7-c5a01e3c3435",
                        "source_sense_description": "en daardoor",
                        "target_lang_word": "damit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bfef25a-1f56-310c-8b21-2f8441df89e9",
                                        "entry_id": "de4d6815-7134-3c5a-b678-6f2e6e1a6349",
                                        "glosses": [
                                            "… mit dem Ziel, dass …"
                                        ],
                                        "tags": [
                                            "Konjunktion zur Begründung der Zielsetzung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31eda1a-0f39-4a65-b91f-1d2fc2b2617f",
                                                "sense_id": "6bfef25a-1f56-310c-8b21-2f8441df89e9",
                                                "text": "Es wurden Vorräte angelegt, damit es in Notzeiten nicht mangelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "damit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "demonstrativer oder relativer Verweis auf ein Mittel, ein Werkzeug im direkten oder übertragenen Sinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba9ca01e-cc09-4815-838b-ec98ed84919e",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "Der Mann nahm den Hammer und trieb damit den Nagel in das Holz."
                                            },
                                            {
                                                "example_id": "7a0a6627-65e7-4e48-8deb-3f65c54586a6",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "Damit kannst du ihn ruinieren."
                                            },
                                            {
                                                "example_id": "8eae5aa0-1b79-4bc0-a987-6c1fc61c73be",
                                                "sense_id": "2b0d9c31-f017-33c1-9602-bb47a1c82936",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "demonstrativer oder relativer Verweis auf Zustände oder Sachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b276ed-22be-4719-98e0-6b784a6bf6f3",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Hier hast du eine Puppe, damit kannst du spielen."
                                            },
                                            {
                                                "example_id": "8eca93c9-40e0-4da8-b5db-99db04fffc83",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Der Räuber sah das Geld und rief: „Her damit!“"
                                            },
                                            {
                                                "example_id": "4fc89ce0-9469-4d96-bae5-a295bbd69165",
                                                "sense_id": "53666050-7d32-3db3-8c5b-91ecd5193646",
                                                "text": "Damit hätte ich jetzt nicht gerechnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                        "entry_id": "2b53141e-0347-3f74-8110-970c9f6c2761",
                                        "glosses": [
                                            "zum Ausdruck einer zeitlichen Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b1ed6c-b726-466b-96e9-0d36ea9dfda3",
                                                "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                                "text": "Im letzten Akt des Theaterstücks starb der Protagonist, damit endete auch das Stück."
                                            },
                                            {
                                                "example_id": "6f0dad9d-c6f0-4351-ba35-ecfad80ad145",
                                                "sense_id": "3cf34f7e-524e-38b7-84f5-4ee285144a7b",
                                                "text": "Und damit wäre ich am Ende meiner kleinen Geschichte angelangt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9685775-d46d-4395-b9b3-34dbcb0a3a31",
                        "source_entry_id": "30d10c0d-1d72-3122-aff7-c5a01e3c3435",
                        "source_sense_description": "en daardoor",
                        "target_lang_word": "так что",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "так что",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                        "entry_id": "6cff2714-1ba6-3e29-82a5-773bfed2d768",
                                        "glosses": [
                                            "так, таким образом, следовательно, поэтому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c6b8b5-dd54-45bd-8863-a55799c91b5f",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Он меня хватает поперёк зубов, так что рот не открыть."
                                            },
                                            {
                                                "example_id": "e8c44084-a4e6-4327-af2c-4147697e35fa",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Так что давай отложим серьёзный разговор…"
                                            },
                                            {
                                                "example_id": "a3acd4fc-5921-41ac-a162-aef1f612e62f",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Так что перед нами стоит задача защитить не просто вашу, Валя, теорию ревертазы, но судьбу всей нашей планетной биологии вообще…"
                                            },
                                            {
                                                "example_id": "328dece0-1b9c-493b-bacf-f1f68886c5da",
                                                "sense_id": "30f2f7df-9364-36e9-8961-d8c2077c1a90",
                                                "text": "Все его нутро наладилось на какое-то другое существование, похожее на смерть, так что он даже не думал об отрубленной стопе, культя которой, как ни странно, даже не болела."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
