                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                        "entry_id": "517256a4-3e35-3cf0-b563-e7d1c525cee4",
                        "glosses": [
                            "That which cannot be divided or split."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19a146ae-99ea-471b-844b-cb47a8b14598",
                                "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                "text": "By atom, nobody will imagine we intend to express a perfect indivisible, but only the least sort of natural bodies."
                            },
                            {
                                "example_id": "e417aa02-600c-468d-aa71-a10485816980",
                                "sense_id": "fd7ce9f5-624d-39ad-8045-e0079de471bc",
                                "text": "The compoſition of Bodies, whether it be of Diviſibles or Indiviſibles, is a queſtion which must be rank'd with the Indiſſolvibles: For though it hath been attempted by the moſt illuſtrious Wits of all Philoſophick Ages; yet they have done little elſe, but ſhewn their own diviſions to be almoſt as infinite, as ſome ſuppoſe thoſe of their Subject."
                            }
                        ]
                    },
                    {
                        "sense_id": "22483c9d-915c-35d8-b8de-feaa0a468587",
                        "entry_id": "517256a4-3e35-3cf0-b563-e7d1c525cee4",
                        "glosses": [
                            "An infinitely small quantity which is assumed to admit of no further division."
                        ],
                        "tags": [],
                        "examples": []
                    }
