                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36da75c5-ebb3-4fc5-8804-f0e6b2fea3de",
                                                "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                                "text": "She kept a scoop in the dog food."
