                {
                    "sense_id": "e85c2951-68dc-3779-b935-9cacd920892d",
                    "sense_definition": "Een glas alcoholhoudende drank, vaak genuttigd voor de gezelligheid in een café of op een feest.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we vanavond in de stad een <w>drankje</w> gaan doen?",
                            "target_lang_translations": {
                                "en": "Shall we go into town for a <w>drink</w> tonight?",
                                "ru": "Может, сходим сегодня вечером в город пропустить по <w>стаканчику</w>?",
                                "fr": "Si on allait boire un <w>verre</w> en ville ce soir ?"
                            }
                        },
                        {
                            "text": "Hij trakteerde zijn vrienden op een <w>drankje</w> om zijn verjaardag te vieren.",
                            "target_lang_translations": {
                                "en": "He treated his friends to a <w>drink</w> to celebrate his birthday.",
                                "ru": "Он угостил друзей <w>выпивкой</w>, чтобы отпраздновать свой день рождения.",
                                "fr": "Il a offert un <w>verre</w> à ses amis pour fêter son anniversaire."
                            }
                        }
                    ],
                    "synonyms": [
                        "borrel"
                    ],
                    "common_phrases": [
                        "een drankje doen",
                        "een drankje bestellen",
                        "een drankje betalen"
                    ],
                    "target_lang_definitions": {
                        "en": "A glass of alcoholic beverage, often consumed for sociability in a café or at a party.",
                        "ru": "Бокал алкогольного напитка, который часто пьют для общения в кафе или на вечеринке.",
                        "fr": "Un verre de boisson alcoolisée, souvent consommé pour la convivialité dans un café ou une fête."
                    },
