                                            {
                                                "example_id": "25de1c49-a5c6-4967-9bf5-f5364d507c49",
                                                "sense_id": "fbff97cb-bcf5-3e08-8e85-b06545062a04",
                                                "text": "Near-synonym: (in federations) federal"
