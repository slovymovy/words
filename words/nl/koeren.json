    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fda54ba9-bd2f-3414-9ab0-5df52ee7cd53",
                    "sense_definition": "het zachte, rollende geluid maken dat kenmerkend is voor duiven",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeg in de ochtend hoorde ik de duiven zachtjes <w>koeren</w> op het dak.",
                            "target_lang_translations": {
                                "en": "Early in the morning, I heard the pigeons softly <w>cooing</w> on the roof."
                            }
                        },
                        {
                            "text": "In het park zaten twee tortelduiven verliefd tegen elkaar aan te <w>koeren</w>.",
                            "target_lang_translations": {
                                "en": "In the park, two turtledoves were affectionately <w>cooing</w> to each other."
                            }
                        }
                    ],
                    "synonyms": [
                        "roekoeën"
                    ],
                    "common_phrases": [
                        "duiven horen koeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make the soft, murmuring sound characteristic of pigeons or doves"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coo",
                                "target_lang_sense_clarification": "sound made by pigeons or doves"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d74d0f1-a32f-3325-919e-8f983aae57b5",
                    "sense_definition": "op een zachte, lieflijke of vleiende toon praten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze <w>koerde</w> lieve woordjes tegen de pasgeboren baby om hem te troosten.",
                            "target_lang_translations": {
                                "en": "She <w>cooed</w> sweet words to the newborn baby to soothe him."
                            }
                        },
                        {
                            "text": "\"Wat zie je er prachtig uit vandaag,\" <w>koerde</w> hij zachtjes in haar oor.",
                            "target_lang_translations": {
                                "en": "\"You look wonderful today,\" he <w>cooed</w> softly into her ear."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to speak in a soft, affectionate, or flattering tone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "coo",
                                "target_lang_sense_clarification": "speak in a soft, loving voice"
                            },
                            {
                                "target_lang_word": "bill and coo",
                                "target_lang_sense_clarification": "exchange affectionate words and behavior"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac022708-8ad2-3252-9721-e2eff895364b",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>koer</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen speelden vroeger vaak op de kleine <w>koeren</w> achter de oude arbeiderswoningen.",
                            "target_lang_translations": {
                                "en": "The children often used to play in the small <w>courtyards</w> behind the old workers' houses."
                            }
                        },
                        {
                            "text": "In de oude stad vind je prachtige verborgen <w>koeren</w> vol bloemen en planten.",
                            "target_lang_translations": {
                                "en": "In the old town, you find beautiful hidden <w>courtyards</w> full of flowers and plants."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenplaatsen",
                        "binnenpleinen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "vooral gebruikelijk in België"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'koer': inner courtyards or backyards (chiefly Belgian Dutch)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "courtyards",
                                "target_lang_sense_clarification": "enclosed outdoor areas adjacent to buildings"
                            },
                            {
                                "target_lang_word": "backyards",
                                "target_lang_sense_clarification": "small enclosed yards behind houses"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}