                "word": "сереть",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "67437b5f-1d8e-4f0c-98af-8df75d511b11",
                        "entry_id": "8a5d380e-72c5-3a08-93b8-b1426a811175",
                        "tags": [
                            "stressed"
                        ],
                        "form": "се́реть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e88d25f6-3e75-3c77-aecf-5cc632899f27",
                        "entry_id": "8a5d380e-72c5-3a08-93b8-b1426a811175",
                        "glosses": [
                            "вульг. и устар., эвф. испражняться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f84f433-9f33-49dd-908b-993bffdd8cdb",
                                "sense_id": "e88d25f6-3e75-3c77-aecf-5cc632899f27",
                                "text": "Сей корсиканец целый век // Гремит кровавыми делами. // Ест по сто тысяч человек // И серет королями."
                            },
                            {
                                "example_id": "74a8b274-afeb-49a3-abe5-4e496187d5ad",
                                "sense_id": "e88d25f6-3e75-3c77-aecf-5cc632899f27",
                                "text": "Я иду, а милка серет // В огороде, в борозде! // Я схватил одну картоху // Да как ёбну по пизде!"
                            }
                        ]
                    },
                    {
                        "sense_id": "fb5bc2cb-1bd4-3776-ac17-3bd4454345f0",
                        "entry_id": "8a5d380e-72c5-3a08-93b8-b1426a811175",
                        "glosses": [
                            "перен., устар., эвф. вредить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e73464-821c-48e9-a803-f82abb75edd9",
                                "sense_id": "fb5bc2cb-1bd4-3776-ac17-3bd4454345f0",
                                "text": "Канкрину Россия верит // И несёт ему сребро! // Он, за русское добро, // Депозитками ей серет."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
