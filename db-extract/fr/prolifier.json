                        "glosses": [
                            "Proliférer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478ae886-8195-48e6-9ffb-711f63f1ff50",
                                "sense_id": "16c92463-8bf0-38ad-8eca-d8823cd1715b",
                                "text": "La Pâquerette est la Composée qui se prolifie le plus souvent : j’en conserve plusieurs échantillons dans mon herbier."
                            },
                            {
                                "example_id": "8a3046f0-b432-4555-907a-f6ffbcb74c7d",
                                "sense_id": "16c92463-8bf0-38ad-8eca-d8823cd1715b",
                                "text": "Quant au Lolium compositum, dont la manière vraiment singulière de prolifier ne s’est malheureusement pas encore offerte à mes yeux, je ne puis ici, de même que je l’ai déja fait dans la 6e remarque de ma traduction, ne pas la regarder comme possible, attendu que cette déviation du type n’est pas tout-à-fait hors des lois du développement."
                            }
                        ]
                    }
