                ],
                "senses": [
                    {
                        "sense_id": "3dcf999b-2ed2-38e4-900d-586c777c5dd6",
                        "entry_id": "716c9c11-ff79-3b58-b4e8-5d2f14bb631c",
                        "glosses": [
                            "Diode, die Laserlicht emittiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10838b6f-aed7-41c6-9204-076cb157134f",
                                "sense_id": "3dcf999b-2ed2-38e4-900d-586c777c5dd6",
                                "text": "„In der Laserpistole befindet sich eine kleine rote Laserdiode, die einen Lichtblitz von einer Sekunde in das Fleisch schießt.“"
                            },
                            {
                                "example_id": "e54ca9e9-b087-40f8-91ce-736c348979fd",
                                "sense_id": "3dcf999b-2ed2-38e4-900d-586c777c5dd6",
                                "text": "„Der japanische Elektronikkonzern Sanyo hat eine blaue Laserdiode entwickelt, die dank ihrer erhöhten Leistungsfähigkeit die Konstruktion von schnelleren und kapazitätsstärkeren Blu-ray-Disks ermöglicht.“"
                            },
                            {
                                "example_id": "e69be3d1-c06d-44b1-a49d-b41044772fa9",
                                "sense_id": "3dcf999b-2ed2-38e4-900d-586c777c5dd6",
                                "text": "„Eine echte grüne Laserdiode gibt es nicht. Deshalb nutzte etwa Microvision für sein Picobeamer-Modul grüne Leuchtdioden (respektive gepumpte grüne Laserdioden) im Verbund mit echten Laserdioden, die rotes und blaues Licht emittieren – letztere gibt es übrigens erst seit etwa 15 Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
