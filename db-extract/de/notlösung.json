                    {
                        "form_id": "d5afe349-9be6-418b-ada8-f86b3c43beed",
                        "entry_id": "e2906534-bcab-3730-b35a-d3714517c093",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Notlösungen"
