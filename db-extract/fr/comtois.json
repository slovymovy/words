                    {
                        "sense_id": "b1f2b974-b272-3613-a09d-96a07871f05e",
                        "entry_id": "80c57179-f70f-3062-be9e-edf42806b891",
                        "glosses": [
                            "Relatif à la Franche-Comté et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35227eff-e446-44f7-beea-11ccc9a1b53c",
                                "sense_id": "b1f2b974-b272-3613-a09d-96a07871f05e",
                                "text": "Oh! vraiment, monsieur le comte, dit-il avec un accent comtois très prononcé, allongeant toutes les voyelles brèves et traînant la voix sur l'avant-dernière syllabe de chaque membre de phrase; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "7843b7a6-02c1-39f5-a316-8bb25818636c",
                        "entry_id": "80c57179-f70f-3062-be9e-edf42806b891",
                        "glosses": [
                            "Qualifie un type d'horloge à balancier et contrepoids qui se fabriquait en Franche-Comté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ead1a7f-edbf-4fa0-8fd2-facc77942380",
                                "sense_id": "7843b7a6-02c1-39f5-a316-8bb25818636c",
                                "text": "On n’entendait que […] le battement régulier de la vieille horloge comtoise dont l’énorme lentille de cuivre s’avivait avec le flot de soleil qui déferlait en chatoyant."
                            }
                        ]
                    },
