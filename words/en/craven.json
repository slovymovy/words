        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dad1de3b-2876-392e-8f57-ba7d0bab9feb",
                    "sense_definition": "To make someone cowardly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cowardice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant threats served only to <w>craven</w> his spirit.",
                            "target_lang_translations": {
                                "de": "Die ständigen Drohungen dienten nur dazu, seinen Geist zu <w>entmutigen</w>."
                            }
