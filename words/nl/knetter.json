{
    "word_family": [
        "knetteren",
        "geknetter",
        "knettergek"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "911ce97b-1fdf-30f1-9ad0-959e78f6924c",
                    "sense_definition": "waanzinnig gedrag vertonend; een verkorte vorm van <w>knettergek</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waanzinnig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet echt ophouden met die onzin, je bent helemaal <w>knetter</w> geworden.",
                            "target_lang_translations": {
                                "en": "You really need to stop with that nonsense, you've gone completely <w>crazy</w>."
                            }
                        },
                        {
                            "text": "Hij wordt <w>knetter</w> van al dat lawaai in de straat.",
                            "target_lang_translations": {
                                "en": "He is going <w>nuts</w> from all that noise in the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "stapelgek"
                    ],
                    "common_phrases": [
                        "helemaal knetter worden"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "exhibiting insane or crazy behavior; a shortened form of 'knettergek'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "insane or mad"
                            },
                            {
                                "target_lang_word": "nuts",
                                "target_lang_sense_clarification": "informal for crazy"
                            },
                            {
                                "target_lang_word": "bonkers",
                                "target_lang_sense_clarification": "completely crazy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89d265a2-e538-33d4-b8b8-8b9ba437f627",
                    "sense_definition": "in zeer hoge mate; heel erg",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange dag in de zon was hij <w>knetter</w> verbrand op zijn schouders.",
                            "target_lang_translations": {
                                "en": "After a long day in the sun, his shoulders were <w>badly</w> sunburned."
                            }
                        },
                        {
                            "text": "Zij was <w>knetter</w> verliefd op haar nieuwe buurjongen.",
                            "target_lang_translations": {
                                "en": "She was <w>madly</w> in love with her new neighbor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "knetter verliefd",
                        "knetter verbrand"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to a very high degree; extremely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extremely",
                                "target_lang_sense_clarification": "to a very high degree"
                            },
                            {
                                "target_lang_word": "totally",
                                "target_lang_sense_clarification": "completely or entirely"
                            },
                            {
                                "target_lang_word": "stark",
                                "target_lang_sense_clarification": "used as an intensifier, e.g., stark raving mad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68cb4119-048f-33f3-af42-2bee6d9cb1c6",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>knetteren</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>knetter</w> van de statische elektriciteit als ik deze trui uittrek.",
                            "target_lang_translations": {
                                "en": "I <w>crackle</w> with static electricity when I take off this sweater."
                            }
                        },
                        {
                            "text": "Als ik het vuur aansteek, <w>knetter</w> ik soms door de vonken.",
                            "target_lang_translations": {
                                "en": "When I light the fire, I sometimes <w>crackle</w> because of the sparks."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb conjugation"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'knetteren' (to crackle)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crackle",
                                "target_lang_sense_clarification": "making sharp snapping noises"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de26d9a7-fdd9-310f-88d2-8cd2ec529d01",
                    "sense_definition": "de gebiedende wijs van <w>knetteren</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Knetter</w> maar lekker raak, zei de man tegen het kampvuur.",
                            "target_lang_translations": {
                                "en": "Just <w>crackle</w> away, the man said to the campfire."
                            }
                        },
                        {
                            "text": "Hoor het hout eens branden, <w>knetter</w>!",
                            "target_lang_translations": {
                                "en": "Listen to the wood burning, <w>crackle</w>!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative mood"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative mood of 'knetteren' (to crackle)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crackle",
                                "target_lang_sense_clarification": "command to make snapping noises"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}