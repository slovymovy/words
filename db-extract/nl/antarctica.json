                                        "entry_id": "09d27711-ccab-3eee-bb29-78f1646894f3",
                                        "glosses": [
                                            "Continent compris presque entièrement à l’intérieur du cercle polaire austral, au centre duquel se situe le pôle Sud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416fd65b-ead6-494a-8421-3b90b9d08aad",
                                                "sense_id": "f2aebb75-557e-3763-9dbe-4bba7b222f42",
                                                "text": "Le « Pourquoi pas », succéda au « Français » qui conduisit dans l’Antarctique en 1903-1905 la première expédition polaire française de longue haleine."
                                            },
                                            {
                                                "example_id": "e95efc4c-757d-4bc8-add0-4398ea259d1b",
                                                "sense_id": "f2aebb75-557e-3763-9dbe-4bba7b222f42",
                                                "text": "Nick Dale, un photographe anglais, a réussi à capturer cet instant à Brown Bluff, en Antarctique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
