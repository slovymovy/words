                                    {
                                        "sense_id": "1b001278-4039-355a-abf4-77a295c62cbb",
                                        "entry_id": "b57d9b7a-e7d9-38d7-9a67-b3f9a47b719a",
                                        "glosses": [
                                            "The first time that a person, usually a child, receives the sacrament of Communion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "097ceb13-2f9a-3fa5-9194-6fdff71929a8",
                                        "entry_id": "b57d9b7a-e7d9-38d7-9a67-b3f9a47b719a",
                                        "glosses": [
                                            "The celebration of the former, consisting of a solemn mass and generally a following private party."
                                        ],
                                        "tags": [],
