                ],
                "senses": [
                    {
                        "sense_id": "b486c002-88d9-316b-ba59-7a449777dac6",
                        "entry_id": "0831e2e2-77ad-3e22-81c4-143a1541f27f",
                        "glosses": [
                            "Großstadt in Nordindien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93a7645-b387-4b37-a593-718e16b3f7b3",
                                "sense_id": "b486c002-88d9-316b-ba59-7a449777dac6",
                                "text": "„Das alte Rathaus von Amritsar ist ein palastartiger roter Sandsteinbau aus dem späten 19. Jahrhundert, eines der Architekturschmuckstücke, die von den britischen Kolonialherren in Indien hinterlassen wurden.“"
                            },
                            {
                                "example_id": "3017048a-4dab-44fe-8947-b04f9b51fe55",
                                "sense_id": "b486c002-88d9-316b-ba59-7a449777dac6",
                                "text": "„Eine unbewaffnete Menschenmenge versammelte sich im Jalianwala Bagh von Amritsar, einem von Mauern umgebenen Platz, der sich als grausame Falle erwies, als der britische General Dyer den Befehl erteilte, auf die Menge zu schießen.“"
                            },
                            {
                                "example_id": "4343669f-318b-410c-acfe-ca500f62f44f",
                                "sense_id": "b486c002-88d9-316b-ba59-7a449777dac6",
                                "text": "„Damit wurde der Punjab zu einer wichtigen Übergangszone zwischen dem neu entstandenen Durranireich in Afghanistan und dem bröckelnden Mogulimperium. Dies hatte zur Folge, dass sich seit dem ausgehenden 18. Jahrhundert die Religionsgemeinschaft der Sikhs zunächst der Städte Lahore und Amritsar bemächtigte.“"
                            },
                            {
                                "example_id": "574aebd6-06dc-4d4f-a933-f2d7430442b8",
                                "sense_id": "b486c002-88d9-316b-ba59-7a449777dac6",
                                "text": "„Ich hatte den Befehl, einen Zug mit Hindus nach Amritsar zu begleiten und darüber zu wachen, dass sie sicher und gesund dort eintrafen.“"
                            },
                            {
                                "example_id": "84107fe6-4b80-42f7-a350-5bef6c2ca0be",
                                "sense_id": "b486c002-88d9-316b-ba59-7a449777dac6",
                                "text": "„Und Pritam Singh Hansra, der sich seit anderthalb Monaten in Amritsar aufhielt, schrieb Briefe an Papa-ji.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
