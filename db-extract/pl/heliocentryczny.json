                                        "glosses": [
                                            "Having the sun at the center/centre; usually in reference to a coordinate system or orbit."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d2f0af8-b9e1-4b70-b522-6dbf55e8e16d",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "a heliocentric coordinate system"
                                            },
                                            {
                                                "example_id": "bacbbf33-43a5-4e2e-82ba-5897f7446e48",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "a heliocentric orbit"
                                            },
                                            {
                                                "example_id": "0392baa7-d1d0-4547-a8e0-ec2ec3768cfc",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "To make the Catalogue of Eclipses, as also the Table of the Parallaxes of [Jupiter], it was necessary first to make a Table of [Jupiter]' Heliocentrick places, to which the Parallaxes being applied, give the Geocentrick."
                                            },
                                            {
                                                "example_id": "12517051-27f6-492f-8a48-de227842beaf",
                                                "sense_id": "4376f0fe-0f27-3e03-ac93-ec711ef210f9",
                                                "text": "Apollyon, who, as god of the sun, has a certain stake in the matter, teaches the Prior the truth of what the Greeks, Pythagoras' disciples, knew many years before— the nature of the heliocentric (or pyrocentric) planetary system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c3c9020-4a6b-3853-965c-1bc44b55ad8d",
                                        "entry_id": "4de74f67-40bb-3807-b239-6cb46a9cd8aa",
                                        "glosses": [
                                            "Of or relating to heliocentrism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
