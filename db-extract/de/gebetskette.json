                        "glosses": [
                            "Kette, die zum Beten verwendet wird, mit deren Hilfe die Anzahl verrichteter Gebete gezählt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b38489ed-37be-4107-8961-cae7952f19d2",
                                "sense_id": "1a62bd17-b246-3b57-be3e-430854420a0c",
                                "text": "„In der einen Hand hält sie ihren rosa Steindolch, und in der anderen, die sie jetzt hebt, hat sie was? Die verfluchte Gebetskette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
