        "fr-extract.jsonl": [
            {
                "entry_id": "ed5fcf39-45d2-3f62-b838-1700b52a54c0",
                "word": "pop-up",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c2404865-282b-4eb6-bcda-7caaa79ae942",
                        "entry_id": "ed5fcf39-45d2-3f62-b838-1700b52a54c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "pop-ups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad57b779-55e8-3f42-bd11-32f6f00fffd1",
                        "entry_id": "ed5fcf39-45d2-3f62-b838-1700b52a54c0",
                        "glosses": [
                            "Livre animé où les images se dressent en relief du livre et s’animent lors du mouvement d’ouverture de la page."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c4162922-7d27-45d3-aef9-ff4578016950",
                                "sense_id": "ad57b779-55e8-3f42-bd11-32f6f00fffd1",
                                "text": "Avec ses fées volantes, ses pirates bondissants et bien d’autres surprises, Robert Sabuda ressuscite, grâce à son incomparable talent, l’univers magique de ce classique de la littérature enfantine dans un incroyable pop-up."
                            },
                            {
                                "example_id": "8f90979c-8e5f-433e-bb2a-03cd5b0e235c",
                                "sense_id": "ad57b779-55e8-3f42-bd11-32f6f00fffd1",
                                "text": "Mercredi, Catherine Kerambellec, auteure jeunesse, membre du Cercle des écrivains (CEL), est venue guider les enfants pour leur apprendre à réaliser un livre accordéon pop-up."
                            }
                        ]
                    },
                    {
                        "sense_id": "5763411b-b252-327f-b384-dfa9ba90b8a9",
                        "entry_id": "ed5fcf39-45d2-3f62-b838-1700b52a54c0",
                        "glosses": [
                            "Fenêtre secondaire qui s’ouvre avec ou sans sollicitation de l’utilisateur. Il peut s'agir d'un message d'un logiciel signalant un événement (erreur, fin d'une opération, réception d'un message électronique), ou pour afficher des informations contextuelles (par exemple signification d'une icône), mais aussi fréquemment d'encarts publicitaires lors de la navigation sur un site web. La plupart des navigateurs Internet intègrent aujourd’hui un bloqueur de pop-up destiné à éliminer les pop-ups non sollicités par l’utilisateur."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "426aace9-58f2-4a21-be9e-4aa7b18bb1c2",
                        "source_entry_id": "ed5fcf39-45d2-3f62-b838-1700b52a54c0",
                        "source_sense_description": "Informatique",
                        "target_lang_word": "Pop-up",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pop-up",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ba5ca8-eb07-3cda-af01-c1eca9e96d4f",
                                        "entry_id": "a907ed9b-c6fe-3f5b-bd94-5f64745ef338",
                                        "glosses": [
                                            "kleiner Kasten, kleines Fenster/Browserfenster mit Information, das (meist plötzlich) auf dem Bildschirm auftaucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a046d398-dfe7-4654-ab6a-3cb6c0c7e6f4",
                                                "sense_id": "d2ba5ca8-eb07-3cda-af01-c1eca9e96d4f",
                                                "text": "Mit der ESC-Taste entfernst du das oberste Pop-up."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0494bbf9-6802-3ebb-be73-9a85ebbcc8d1",
                                        "entry_id": "a907ed9b-c6fe-3f5b-bd94-5f64745ef338",
                                        "glosses": [
                                            "dreidimensionales Pappgebilde, das sich entfaltet und einem ›entgegenspringt‹, wenn man ein zugehöriges Buch aufschlägt"
                                        ],
                                        "tags": [
                                            "Buch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43cbb94-5282-46d9-9fea-a4d0cb49f680",
                                                "sense_id": "0494bbf9-6802-3ebb-be73-9a85ebbcc8d1",
                                                "text": "„Bis in die 1990er Jahre gelang es dem Verlag, die Pop-ups zu einer hohen drucktechnischen Qualität und konkurrenzlos günstigen Preisen anzubieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9e461ab-5645-4b95-8344-ea4aabb84e7f",
                        "source_entry_id": "ed5fcf39-45d2-3f62-b838-1700b52a54c0",
                        "source_sense_description": "Informatique",
                        "target_lang_word": "pop-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pop-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "144ee650-9a19-38ad-87cd-706f6d05c07f",
                                        "entry_id": "9c9cd596-6cb4-37f7-b0d4-1b4bd3f44abe",
                                        "glosses": [
                                            "Coming into view suddenly from a concealed position."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0487bc-de32-45b3-820e-aa9625f3a23f",
                                                "sense_id": "144ee650-9a19-38ad-87cd-706f6d05c07f",
                                                "text": "I packed a pop-up hamper in my suitcase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "500838f0-3150-37a8-81da-7c8bc399d3f8",
                                        "entry_id": "9c9cd596-6cb4-37f7-b0d4-1b4bd3f44abe",
                                        "glosses": [
                                            "Opening out to form a three-dimensional structure when the page of a book is opened."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdfc70dd-0936-408a-a180-c24fb820f46a",
                                                "sense_id": "500838f0-3150-37a8-81da-7c8bc399d3f8",
                                                "text": "[…] I had a pop-up book of sexual organs by the time I was four –[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4eacfe8-944e-3604-93c1-7ef796f7971f",
                                        "entry_id": "9c9cd596-6cb4-37f7-b0d4-1b4bd3f44abe",
                                        "glosses": [
                                            "Operating or existing for a brief period only; temporary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5245df0b-65ab-432e-a452-df69709b0cbf",
                                                "sense_id": "b4eacfe8-944e-3604-93c1-7ef796f7971f",
                                                "text": "But then this is essentially a pop-up team, glued into place brilliantly, with certain parts already chafing and smoking. Chelsea’s two top goalscorers could be off in a month, Diego Costa to cause an international incident in China, [Eden] Hazard to the usual summer suspects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3bf730f-7541-3813-ac25-8d9e842955d5",
                                        "entry_id": "9c9cd596-6cb4-37f7-b0d4-1b4bd3f44abe",
                                        "glosses": [
                                            "Employing the cold launch technique."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pop-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "708a039c-7864-3ec9-9d7d-5aa5754a7924",
                                        "entry_id": "f0121c58-fba4-3c49-b43c-d47630e54294",
                                        "glosses": [
                                            "A pop-up advertisement; an advertisement that is triggered to appear on a computer screen when the user accesses a particular web page."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5b93c29-d894-3ed3-adcf-b1f522168c2f",
                                        "entry_id": "f0121c58-fba4-3c49-b43c-d47630e54294",
                                        "glosses": [
                                            "A pop-up ball: a ball that has been hit to a considerable height above the infield or the shallow outfield; a pop fly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a2074c0-1213-3c36-ac8a-0c010024e59e",
                                        "entry_id": "f0121c58-fba4-3c49-b43c-d47630e54294",
                                        "glosses": [
                                            "A folded paper element which pops up from a book, greeting card, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbb5fad4-e13d-3271-b255-c4390b736f48",
                                        "entry_id": "f0121c58-fba4-3c49-b43c-d47630e54294",
                                        "glosses": [
                                            "A business that opens for a brief temporary period only, such as a temporary restaurant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12af247-a7c8-4fa7-846f-6e2856348e1c",
                                                "sense_id": "cbb5fad4-e13d-3271-b255-c4390b736f48",
                                                "text": "Pop-ups often charge restaurant prices, but without advance menus, quality control, health-inspected facilities or professional service. Bring cash and arrive early: most pop-ups don't accept credit cards, and popular dishes run out fast."
                                            },
                                            {
                                                "example_id": "92c1cdfe-7079-431a-9ace-c175e302104d",
                                                "sense_id": "cbb5fad4-e13d-3271-b255-c4390b736f48",
                                                "text": "Ms. Setti recently had to close her bar after a change of management at the food hall that housed it. But she plans to launch several pop-ups and hopes to find a new permanent space by the middle of the year, she said."
                                            },
                                            {
                                                "example_id": "1c702c11-d9f2-40a8-b34a-aa1ed1b767d5",
                                                "sense_id": "cbb5fad4-e13d-3271-b255-c4390b736f48",
                                                "text": "I came across this recipe when Helen Graham cooked it for Bracia and Friends, a pop-up whose USP is that chefs must cook a single dish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
