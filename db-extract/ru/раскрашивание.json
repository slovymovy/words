                                            {
                                                "example_id": "31f0e7e1-ac49-4eab-a1b9-699cf4228caf",
                                                "sense_id": "7ad218fe-3f83-366d-8f15-2b48e943d3c4",
                                                "text": "The seven hampers for four boys and three girls were personalised to each patient, including overnight hotel stays, colouring books and self care items."
                                            },
                                            {
                                                "example_id": "3ba3e0dc-71a5-40b4-8070-bba66181cbae",
                                                "sense_id": "7ad218fe-3f83-366d-8f15-2b48e943d3c4",
                                                "text": "In 2008, British health ministers agreed to phase out six artificial food colourings by 2009, while the European Union bans some colourings and requires warning labels on others."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colouring",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33c14937-6bcd-33b1-a5ed-cb0ffdbaba6c",
                                        "entry_id": "83447240-de4c-37be-beac-d65d4a9678ef",
                                        "glosses": [
                                            "Of something that provides colour."
                                        ],
                                        "tags": [],
                                        "examples": [
