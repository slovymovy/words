                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51d952fc-a5f9-3305-bb94-48c5574cfa4a",
                                        "entry_id": "c3d83c3f-7098-3a30-b55f-64b00308e7b5",
                                        "glosses": [
                                            "Biographie d’une personne écrite par cette personne même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3387b3f0-6dd5-4b59-bbb0-274731fc0652",
                                                "sense_id": "51d952fc-a5f9-3305-bb94-48c5574cfa4a",
                                                "text": "Les autobiographies sont souvent mensongères."
                                            },
                                            {
                                                "example_id": "ec074adb-52fc-4f92-87bb-d6611366ca1a",
                                                "sense_id": "51d952fc-a5f9-3305-bb94-48c5574cfa4a",
                                                "text": "Le mot «autobiographie» est composé de trois racines grecques : graphein, «écrire»; bios, «vie»; et autos, «soi-même»."
                                            }
                                        ]
                                    }
                                ]
                            },
