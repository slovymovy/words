                        "translation_id": "f2478741-e9aa-409e-8ee4-7314c6dd4b3f",
                        "source_entry_id": "c8aa4ed8-a562-39d8-b7d0-a3b2b7c57aa8",
                        "source_sense_description": "to make a whimpring sound when breathing",
                        "target_lang_word": "всхли́пнуть",
                        "target_lang_code": "ru",
