                "senses": [
                    {
                        "sense_id": "5b9d1c65-fb6f-3a13-88c4-11187e76b58a",
                        "entry_id": "2a47dcd2-de47-3670-a948-4b4541ca8b99",
                        "glosses": [
                            "schicksalhafte Abfolge schmerzhafter Geschehnisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8962b6a9-b61a-4b8d-ab9c-647dd58e8c1b",
                                "sense_id": "5b9d1c65-fb6f-3a13-88c4-11187e76b58a",
                                "text": "„Jetzt bleibt mir nur, dafür zu beten, dass Narcisse Pelletier am Ende seines Leidensweges auf seine Art und Weise Frieden und Ruhe finden möge.“"
                            },
                            {
                                "example_id": "4bfbdb2f-1e00-4a0f-9c88-0f3a99d1e175",
                                "sense_id": "5b9d1c65-fb6f-3a13-88c4-11187e76b58a",
                                "text": "„Viele freilebende Tiere litten nach Angaben des Tierschutzbundes unter Nahrungsmangel sowie auch unter Infektionskrankheiten und Parasitenbefall. Oft drohe den Tieren dann ein langer Leidensweg bis zum qualvollen Tod.“"
                            },
                            {
                                "example_id": "8ec77d48-d5e7-43a1-9eb8-5410a931a408",
                                "sense_id": "5b9d1c65-fb6f-3a13-88c4-11187e76b58a",
                                "text": "„Endlich stieß er auf Spuren seines Leidensweges, Merkzeichen und Örtlichkeiten, die er sich eingeprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
