                "translations": [
                    {
                        "translation_id": "ce2c62a3-c179-4866-a679-0621dca52b0f",
                        "source_entry_id": "8b1442f9-8ec9-32b0-92ec-6e7d3b26d009",
                        "target_lang_word": "distraction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distraction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Something that distracts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28321ee-2b35-4b15-8530-4748faf84bdd",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "Poking one's eye is a good distraction from a hurting toe."
                                            },
                                            {
                                                "example_id": "d37d09d4-0811-47a6-aa59-d1bf92c76baa",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "At last the Duke of Anjou arrived, dressed, as his brother said, to distraction."
                                            },
                                            {
                                                "example_id": "a1618cc4-2dab-4b2a-91ea-d4611b79094d",
                                                "sense_id": "ddf87f98-33a9-3f0e-bd3e-935a32c64a3d",
                                                "text": "“… This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. I am sure, Lord Stranleigh, that he has been descanting on the distraction of the woods and the camp, or perhaps the metropolitan dissipation of Philadelphia, …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "The process of being distracted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f701c1e9-cf4e-4535-9d9c-2252126bbdfe",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "We have to reduce distraction in class if we want students to achieve good results."
                                            },
                                            {
                                                "example_id": "e75ce999-88b9-40fa-a47d-173537338fda",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about \"creating compelling content\", or offering services that let you \"stay up to date with what your friends are doing\",[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention."
                                            },
                                            {
                                                "example_id": "9976f64f-8bdc-4c39-af5d-e359d58b3105",
                                                "sense_id": "ef7f06ed-04fc-3945-b7d8-c651ce1a67a7",
                                                "text": "We determined that the probable cause of the Tishomingo, Oklahoma, collision was the teen driver’s acceleration through the intersection after briefly slowing without stopping, due to distraction from having five teen passengers in the car, limited driving experience, and likely impairment from cannabis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3288e23f-9b7a-3189-bb56-ce8918147b72",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Perturbation; disorder; disturbance; confusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de3b38e9-2e28-445e-8d66-683a13493993",
                                                "sense_id": "3288e23f-9b7a-3189-bb56-ce8918147b72",
                                                "text": "It's true that the Copernican Systeme introduceth distraction in the universe of Aristotle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Mental disarray; a deranged state of mind; insanity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8c55cbc-725d-42eb-b546-965607926361",
                                                "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                                "text": "The incessant nightmares drove him to distraction."
                                            },
                                            {
                                                "example_id": "72ff139c-5411-44b3-bc8f-c79e0e2c6b43",
                                                "sense_id": "e1a8ddc0-3bfe-3744-880f-6335bd02cd2e",
                                                "text": "[…] if he speak the words of an oath in a strange language, thinking they signify something else, or if he spake in his sleep, or deliration, or distraction, it is no oath, and so not obligatory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a56a58-05e1-3de7-90bd-7100f40ac23b",
                                        "entry_id": "1ae5fd1b-1d35-376c-ae64-11eee828f869",
                                        "glosses": [
                                            "Traction so exerted as to separate surfaces normally opposed."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d36158a-7b74-46cc-8201-3888237c7457",
                        "source_entry_id": "8b1442f9-8ec9-32b0-92ec-6e7d3b26d009",
                        "target_lang_word": "distraction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distraction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                                        "entry_id": "d21bf3fe-2291-3123-9368-be80ac206fe3",
                                        "glosses": [
                                            "Inattention, inapplication de la pensée aux choses dont on devrait s’occuper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7323b33b-5491-4080-b575-16181b0f7771",
                                                "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                                                "text": "On cite une marquise du commencement de ce siècle, qui prétendait qu’en le voulant bien on pouvait s’empêcher de mourir. Elle n’est peut-être morte que d’une distraction. Il en est ainsi de beaucoup d’accidents présumés involontaires. Qui sait même si le bonheur n’est pas en grande partie dans la volonté d’être heureux ?"
                                            },
                                            {
                                                "example_id": "294ccb02-c161-4d0c-894e-8d91acde5210",
                                                "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                                                "text": "Camille demanda à ses hôtes ce qu'ils buvaient, chercha les alcools avec des hésitations qu'on pouvait prendre pour de la distraction, puis s'assit avec un verre de jus d’orange, la mit en veilleuse et écouta."
                                            },
                                            {
                                                "example_id": "1a993912-4ede-4342-8016-dcd398310656",
                                                "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                                                "text": "Je ne manquerai pas de respect à l’égard du législateur au point de l’accuser d’incompétence ou de distraction ; mais enfin, s’il ne l’était pas, incompétent ou distrait, que voulait-il faire ?"
                                            },
                                            {
                                                "example_id": "21f3d41e-882d-4bf1-a414-4233e3f8d6b6",
                                                "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                                                "text": "La surutilisation des écrans tactiles est un problème à l'échelle de l'industrie. Presque tous les constructeurs automobiles déplacent les commandes clés sur des écrans tactiles centraux, obligeant les conducteurs à quitter la route des yeux et augmentant le risque d'accidents liés à la distraction."
                                            },
                                            {
                                                "example_id": "34986fb8-4657-4e16-929e-34ae33fbfa15",
                                                "sense_id": "39b8cf89-fc6f-326a-88dd-20360e2932df",
                                                "text": "L’éblouissement causé par les phares à DEL est \"vraiment débilitant\" et \"une grande source de distraction\", constate-t-il."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d4594a-e416-3fdb-bfa4-c7142d64b672",
                                        "entry_id": "d21bf3fe-2291-3123-9368-be80ac206fe3",
                                        "glosses": [
                                            "Résultat de cette inattention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaf07a14-842b-4b53-9362-18547ba6e103",
                                                "sense_id": "39d4594a-e416-3fdb-bfa4-c7142d64b672",
                                                "text": "Il nous donnait la comédie avec ses distractions."
                                            },
                                            {
                                                "example_id": "fe7520c5-2488-4073-b10b-a40d1e9ffd2e",
                                                "sense_id": "39d4594a-e416-3fdb-bfa4-c7142d64b672",
                                                "text": "Voilà une distraction un peu forte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2563d3e-ca58-30ce-aae6-4961d204ea19",
                                        "entry_id": "d21bf3fe-2291-3123-9368-be80ac206fe3",
                                        "glosses": [
                                            "Ce qui amuse, délasse l’esprit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4157c2ec-804f-45bd-badf-0dc3cf44ca28",
                                                "sense_id": "a2563d3e-ca58-30ce-aae6-4961d204ea19",
                                                "text": "Il ne se privait d'ailleurs d'aucune des distractions que Paris offre aux gens qui roulent sur l'or, et il était arrivé à ce moment psychologique où l'ambition vient aux capitalistes."
                                            },
                                            {
                                                "example_id": "e57fedaa-6783-414f-b3be-b13765219eea",
                                                "sense_id": "a2563d3e-ca58-30ce-aae6-4961d204ea19",
                                                "text": "Mais avec un petit poële net, propre, chauffé par l'électricité et pourvu de thermomètres, avec des températures absolument contrôlables et des écrans protecteurs, la cuisine pourrait devenir une distraction et un amusement même pour les dames âgées ou valétudinaires."
                                            },
                                            {
                                                "example_id": "eb0e43af-ac39-45ab-ab0b-3efd89a1ae34",
                                                "sense_id": "a2563d3e-ca58-30ce-aae6-4961d204ea19",
                                                "text": "Deux heures plus tard, le yawl regagnait son mouillage, nous laissant l'inoffensive distraction d'imaginer d'extraordinaires romans dignes du cinématographe."
                                            },
                                            {
                                                "example_id": "5286b4df-11bb-4e85-83e3-5c9f5d5beeb3",
                                                "sense_id": "a2563d3e-ca58-30ce-aae6-4961d204ea19",
                                                "text": "Avec le recul, je crois que nous avons été bien reçus par ces derniers [les Amérindiens Achuar] parce que nous leur fournissions une distraction. Ils nous posaient plus de questions que nous ne leur en posions !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28a3f6f3-13b0-3f2d-9016-38c629d1b7a5",
                                        "entry_id": "d21bf3fe-2291-3123-9368-be80ac206fe3",
                                        "glosses": [
                                            "Séparation d’une partie d’avec son tout."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20af9719-bf2c-4c9b-8e22-7f5ff96c7963",
                                                "sense_id": "28a3f6f3-13b0-3f2d-9016-38c629d1b7a5",
                                                "text": "On a demandé distraction de cette terre."
                                            },
                                            {
                                                "example_id": "34e155c8-1f72-4389-a6fe-c54d358cdec2",
                                                "sense_id": "28a3f6f3-13b0-3f2d-9016-38c629d1b7a5",
                                                "text": "Faire distraction d’une somme en faveur de quelqu’un."
                                            },
                                            {
                                                "example_id": "3ff64d4f-ac88-4730-b7bf-9cf6e6e2f2f2",
                                                "sense_id": "28a3f6f3-13b0-3f2d-9016-38c629d1b7a5",
                                                "text": "« Le territoire de Nice et l’arrondissement de Grasse, par distraction du département du Var, forment le département des Alpes-Maritimes » (loi du 23 juin 1860)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "591e41b6-fdea-373e-bc32-a00da37d87c2",
                                        "entry_id": "d21bf3fe-2291-3123-9368-be80ac206fe3",
                                        "glosses": [
                                            "Retrait d’une parcelle du champ d’application du régime forestier."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4bdbbad-47ac-48e3-af83-d8ec0b7e63f1",
                                                "sense_id": "591e41b6-fdea-373e-bc32-a00da37d87c2",
                                                "text": "[L]a distraction du régime forestier n'est autorisée que lorsque le changement de destination du fonds est certain et définitif. Dans ce cas, la vocation de la parcelle concernée ne sera plus forestière, la commune peut alors solliciter auprès des services de l'Etat^([sic]) une demande de distraction du régime forestier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
