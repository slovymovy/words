                "senses": [
                    {
                        "sense_id": "4d1fd761-8b75-3443-89c2-2c89d007e32d",
                        "entry_id": "5581f50e-598f-3b5f-aa0f-6e65431e7b22",
                        "glosses": [
                            "Eimer, der beim Putzen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c799ade-218d-4f72-b6f2-8f1eaf9d4b08",
                                "sense_id": "4d1fd761-8b75-3443-89c2-2c89d007e32d",
                                "text": "„Er sagte auch nichts mehr und trug seinen Putzeimer noch mehrmals hin und her, denn darum war er so spät unterwegs, um sein Kloster zu putzen.“"
                            },
                            {
                                "example_id": "a49820ab-3a68-4d0d-b0f4-562b52ddafaa",
                                "sense_id": "4d1fd761-8b75-3443-89c2-2c89d007e32d",
                                "text": "„Wie in Trance war sie zu ihrem Putzeimer gegangen und hatte den Aufnehmer ins Wasser getaucht, um die Gaststube fertig zu putzen.“"
                            },
                            {
                                "example_id": "9270c7e0-0285-4820-8143-98f358e041ec",
                                "sense_id": "4d1fd761-8b75-3443-89c2-2c89d007e32d",
                                "text": "„Mit einer Bürste, die sie zuweilen in einen Putzeimer tauchte, schrubbte sie unermüdlich die Bretter, die an Stelle der Fenster eingefügt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
