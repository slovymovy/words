                    },
                    {
                        "sense_id": "1cfba912-2972-3dd7-a53b-be2834810cc8",
                        "entry_id": "a54ebe4d-7cc3-3874-b8e7-a2abe08e3955",
                        "glosses": [
                            "сделать более резким, ощутимым"
                        ],
                        "tags": [],
