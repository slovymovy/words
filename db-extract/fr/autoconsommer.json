                "senses": [
                    {
                        "sense_id": "e01d1085-997e-367d-a8cc-8b618442401a",
                        "entry_id": "d30b9dc9-dbb3-3667-8de6-3a61cad34dd4",
                        "glosses": [
                            "Consommer ce qu’on a soi-même produit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900751c2-6b1c-4293-9c5f-80c25fd20833",
                                "sense_id": "e01d1085-997e-367d-a8cc-8b618442401a",
                                "text": "En effet, si les producteurs préfèrent autoconsommer leurs marchandises, ils démontrent que ces dernières ont pour eux la valeur de leur prix de marché."
                            },
                            {
                                "example_id": "093dc630-e6fd-41c9-a521-3e54c05ff2e8",
                                "sense_id": "e01d1085-997e-367d-a8cc-8b618442401a",
                                "text": "A partir de données d’enquête sur le Maroc, ils ont décrit un modèle de ménage très simple dans lequel le ménage produit deux cultures, une culture vivrière partiellement autoconsommée et une culture entièrement commercialisée."
                            }
                        ]
                    }
