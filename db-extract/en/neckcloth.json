                "senses": [
                    {
                        "sense_id": "491289ec-03f1-3f17-b851-c4b2a0ad3286",
                        "entry_id": "d4f19b57-af43-3ee8-acd9-7b26df883896",
                        "glosses": [
                            "An ornamental cravat, usually white."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "cd5b04ac-c5ee-4c5c-8214-c82d7e070167",
                                "sense_id": "491289ec-03f1-3f17-b851-c4b2a0ad3286",
                                "text": "[…] I did remember I had among the Seamens Cloaths which were sav’d out of the Ship, some Neckcloaths of Callicoe or Muslin; and with some Pieces of these I made three small Sieves, but proper enough for the Work […]"
                            },
                            {
                                "example_id": "a2900450-b0a6-4b02-83a6-5b157724da22",
                                "sense_id": "491289ec-03f1-3f17-b851-c4b2a0ad3286",
                                "text": "1720, John Gay, “Tuesday; or, the Ditty” in Poems on Several Occasions, London: H. Lintot, R. Tonson & S. Draper, 1745, Volume I, p. 85,\nWill she thy linen wash or hosen darn,\nAnd knit thee gloves made of her own-spun yarn?\nWill she with huswife’s hand provide thy meat,\nAnd ev’ry Sunday morn thy neckcloth plait?\nWhich o’er thy kersey doublet spreading wide,\nIn service time drew Cic’ly’s eyes aside."
                            },
                            {
                                "example_id": "5ebbcada-de57-4071-9e0e-7e23b533ed34",
                                "sense_id": "491289ec-03f1-3f17-b851-c4b2a0ad3286",
                                "text": "He was a man of such rigid refinement, that he would have starved rather than have dined without a white neck-cloth."
                            },
                            {
                                "example_id": "400dd267-7172-4e11-989c-9e00597135e2",
                                "sense_id": "491289ec-03f1-3f17-b851-c4b2a0ad3286",
                                "text": "He was very cleanly dressed, in a blue coat, striped waistcoat, and nankeen trowsers; and his fine frilled shirt and cambric neckcloth looked unusually soft and white, reminding my strolling fancy (I call to mind) of the plumage on the breast of a swan."
                            },
                            {
                                "example_id": "6e862eb7-1249-4e0c-a0bf-e7db5f879afa",
                                "sense_id": "491289ec-03f1-3f17-b851-c4b2a0ad3286",
                                "text": "It was not until Lestrade succeeded in getting his hand inside his neckcloth and half-strangling him that we made him realize that his struggles were of no avail; and even then we felt no security until we had pinioned his feet as well as his hands."
                            }
                        ]
                    }
