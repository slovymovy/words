                                "target_senses": [
                                    {
                                        "sense_id": "180b92df-8ddf-36a9-9490-69c8ab4c7dd3",
                                        "entry_id": "700fdcbf-bac0-3247-b190-8f6e7166b8b1",
                                        "glosses": [
                                            "The child (son or daughter) of one's grandchild."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6323b9-c6aa-46e4-8031-9abe2facc12b",
                                                "sense_id": "180b92df-8ddf-36a9-9490-69c8ab4c7dd3",
                                                "text": "She’s now a great-grandmother with three sons, a grandson and two great-grandchildren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36305396-a465-4f07-a091-6483bad7bde0",
                        "source_entry_id": "5068ef2e-3c92-3b9f-95ae-c03024918cb1",
                        "source_sense_id": "88bd365e-5d51-3fb9-9335-719d970fab77",
