                ],
                "translations": [
                    {
                        "translation_id": "e20aa22a-8824-42b5-8127-859c4db5dedf",
                        "source_entry_id": "a12dbaa6-f932-3030-86f1-a3689d97c5f0",
                        "source_sense_id": "a827738b-51ae-38fe-bb16-718933da0a63",
                        "target_lang_word": "Wirbelwind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a66a4aea-1283-4578-bf97-77fe0dc4ee59",
                        "source_entry_id": "a12dbaa6-f932-3030-86f1-a3689d97c5f0",
                        "source_sense_id": "a827738b-51ae-38fe-bb16-718933da0a63",
                        "target_lang_word": "cyclone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb5094c-dee3-32ed-b624-95bfec0266f0",
                                        "entry_id": "517a07a2-d0d4-3f18-9a87-8bf7d0dd815b",
                                        "glosses": [
                                            "To separate using a cyclone separator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "360ef086-7ac9-42d5-a197-9f9e7a153b25",
                                                "sense_id": "9cb5094c-dee3-32ed-b624-95bfec0266f0",
                                                "text": "The product is cycloned and overflow at 45-50% solids is pumped to primary flotation where 50-70% of the copper is removed as a 21% concentrate."
                                            },
                                            {
                                                "example_id": "a98eadb8-b978-41b8-b5af-96206d48c079",
                                                "sense_id": "9cb5094c-dee3-32ed-b624-95bfec0266f0",
                                                "text": "The Syncrude Tar Sand Mine in Alberta, Canada uses a similar hydraulic cell construction technique to raise tailings embankments, although tailings are not cycloned."
                                            },
                                            {
                                                "example_id": "82db48bd-f8e0-49a2-b2e3-6ac2cccbd7f0",
                                                "sense_id": "9cb5094c-dee3-32ed-b624-95bfec0266f0",
                                                "text": "Some catsup manufacturers demand a hot break before the tomatoes are cycloned in order to retain the largest possible amount of pectin from the tomatoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e724980f-29dc-372b-8fce-cde3c73df3c8",
                                        "entry_id": "517a07a2-d0d4-3f18-9a87-8bf7d0dd815b",
                                        "glosses": [
                                            "To storm as a cyclone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75fbcaab-c5d0-4352-90b9-5d0eba625f67",
                                                "sense_id": "e724980f-29dc-372b-8fce-cde3c73df3c8",
                                                "text": "What difference if it rained, hailed, blew, snowed, cycloned?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c64af8c6-649a-32e6-aca6-666737fabaa3",
                                        "entry_id": "517a07a2-d0d4-3f18-9a87-8bf7d0dd815b",
                                        "glosses": [
                                            "To whirl in spirals as a result of a cyclone or whirlwind-like force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae2305ee-bdf0-47e8-ab8d-aeb05f3b5a94",
                                                "sense_id": "c64af8c6-649a-32e6-aca6-666737fabaa3",
                                                "text": "White dust was cycloning at the bottom of ravines that cut for miles into the red flatness"
                                            },
                                            {
                                                "example_id": "a17d55d2-1d26-4a34-9035-9c7f4195a8ff",
                                                "sense_id": "c64af8c6-649a-32e6-aca6-666737fabaa3",
                                                "text": "Pine needles cycloned wildly as Jan swung her car into the Institute's parking lot."
                                            },
                                            {
                                                "example_id": "cee6e204-55aa-40f6-9900-6db4750cb232",
                                                "sense_id": "c64af8c6-649a-32e6-aca6-666737fabaa3",
                                                "text": "The unicorn stamped and gave him a scornful look as Sally cycloned away from them, but Wulfric laughed to himself a crafty laugh."
                                            },
                                            {
                                                "example_id": "e2d31281-286a-4c3f-a4b5-f029f2c1b12c",
                                                "sense_id": "c64af8c6-649a-32e6-aca6-666737fabaa3",
                                                "text": "He raised his arms in supplication even as the cloak's hood blew back and his hair cycloned—like he was standing in a vortex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653dcc49-ff11-3521-900c-a6fb42b2afb4",
                                        "entry_id": "517a07a2-d0d4-3f18-9a87-8bf7d0dd815b",
                                        "glosses": [
                                            "To storm wildly; to be in a frenzy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea9e6faf-61b5-4647-9aee-77985053e0e1",
                                                "sense_id": "653dcc49-ff11-3521-900c-a6fb42b2afb4",
                                                "text": "When Whyte got an eyeful of our groundsman's Barkjano ass bouncing to a rapid beat, he exploded, not so much in words as in gestures and a rapid departure that contained far greater energy than a trifling “storm”—he cycloned-whirlwinded-squalled and thundergaled out of the house and the whole barbecue."
                                            },
                                            {
                                                "example_id": "9dd39bf0-9c62-48f0-b573-4af66ca58dc0",
                                                "sense_id": "653dcc49-ff11-3521-900c-a6fb42b2afb4",
                                                "text": "The winds of change cycloned around Rhodesia and the debris began to fall within its borders."
                                            },
                                            {
                                                "example_id": "b1e7ea34-3642-4d08-88f7-b47b0e934032",
                                                "sense_id": "653dcc49-ff11-3521-900c-a6fb42b2afb4",
                                                "text": "Now, all of a sudden, I had to juggle class schedules with study time and assignment deadlines and work hours. It quickly cycloned into a sort of frantic agitation with all-nighters, near misses, and frenzied nerves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cyclone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01bfd278-50c9-36e4-8933-b66269779acb",
                                        "entry_id": "ec0494a5-61da-3281-83a2-de909b117f8b",
                                        "glosses": [
                                            "Any weather phenomenon consisting of a system of winds rotating around a centre of low atmospheric pressure; a low pressure system."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3edc8c96-d7f5-4344-8867-647bf391833f",
                                                "sense_id": "01bfd278-50c9-36e4-8933-b66269779acb",
                                                "text": "Near-synonym: storm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6945e5a8-eb89-3bf4-8834-5a929201b84d",
                                        "entry_id": "ec0494a5-61da-3281-83a2-de909b117f8b",
                                        "glosses": [
                                            "A tropical cyclone occurring in the South Pacific or Indian Ocean."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff66414c-6b18-44cc-8521-6f175785a977",
                                                "sense_id": "6945e5a8-eb89-3bf4-8834-5a929201b84d",
                                                "text": "Near-synonyms: typhoon, hurricane"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881f4484-3781-324d-a512-a3aeb8e10419",
                                        "entry_id": "ec0494a5-61da-3281-83a2-de909b117f8b",
                                        "glosses": [
                                            "The more or less violent, small-scale circulations such as tornadoes, waterspouts, and dust devils."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63f80a5e-f029-3eea-b890-607f2412ad5a",
                                        "entry_id": "ec0494a5-61da-3281-83a2-de909b117f8b",
                                        "glosses": [
                                            "A strong wind."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7559aa27-37c0-3ddf-9d64-29b5530dad0d",
                                        "entry_id": "ec0494a5-61da-3281-83a2-de909b117f8b",
                                        "glosses": [
                                            "A cyclone separator; the cylindrical vortex tube within such a separator"
                                        ],
                                        "tags": [],
