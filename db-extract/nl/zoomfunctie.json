                        "entry_id": "a3c26e37-a424-3138-8406-74a840c31c8d",
                        "glosses": [
                            "een functie van een camera(lens) waardoor het mogelijk is een deel van het beeld te vergroten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e35d27-ffa9-401d-851a-87ccb70931b8",
                                "sense_id": "a948c7ac-73bd-30da-b7dc-0538b9bb7707",
                                "text": "De RAV4 is beschikbaar met een digitale binnenspiegel met beter zicht en een zoomfunctie. De nieuwe RAV4 wordt in januari 2019 in Nederland leverbaar."
                            }
