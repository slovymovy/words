                "senses": [
                    {
                        "sense_id": "7c788282-a4a8-3640-b213-b3139756dd3b",
                        "entry_id": "83eeb610-92d7-33e4-b8b4-11425e1cf0ff",
                        "glosses": [
                            "in der Betriebswirtschaftslehre der Werteverzehr im laufenden Geschäftsbetrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06e29d94-75c2-44ee-bf2a-41c6e1f5757d",
                                "sense_id": "7c788282-a4a8-3640-b213-b3139756dd3b",
                                "text": "„Immerhin würden bei einem jährlichen Zuwachs von 20 bis 30 Prozent zwischen 1,8 bis 2,7 Millionen Mark pro Jahr für neue Lichtanlagen ausgegeben werden. Viel höher als die Anlage- sind die Betriebskosten, unter welchen die Ausgaben für den Stromverbrauch an erster Stelle stehen. Bleiben wir bei der Durchschnittsanlage von 1000 Glühlampen à 75 Watt, so ergibt sich bei der Annahme einer durchschnittlichen täglichen Brennzeit von vier Stunden ein täglicher Verbrauch von 100 Kilowattstunden oder von 36 500 Kilowattstunden pro Jahr.“"
                            },
                            {
                                "example_id": "4fec8cf0-8672-48e3-87e0-5881002f331f",
                                "sense_id": "7c788282-a4a8-3640-b213-b3139756dd3b",
                                "text": "„Sie führten beide einen Handwerksbetrieb, und beim Abendessen war bald die Rede von steigenden Betriebskosten, Problemen mit der Buchführung und ulkigen Kundenwünschen, über die sie herzhaft lachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5cb3ecf0-35ad-3266-b8b1-6b65250fc0e1",
                        "entry_id": "83eeb610-92d7-33e4-b8b4-11425e1cf0ff",
                        "glosses": [
                            "die finanziellen Ausgaben für die allgemeinen Kosten in einem Haus wie der Hauswart, der gemeinsame Strom im Treppenhaus, das gemeinsame Wasser etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03ced983-2815-407d-8dc9-80455b540dcf",
                                "sense_id": "5cb3ecf0-35ad-3266-b8b1-6b65250fc0e1",
                                "text": "„Wie berichtet, sollen die Kaltmieten in dem bekannten Gebäude zwischen 6 und 8 Euro liegen, die Betriebskosten zwischen 2,20 und 4,50 Euro je Quadratmeter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e518e4ee-2445-4923-9099-04eb803feeb0",
                        "source_entry_id": "83eeb610-92d7-33e4-b8b4-11425e1cf0ff",
