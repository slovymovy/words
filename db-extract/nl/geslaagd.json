                ],
                "senses": [
                    {
                        "sense_id": "8e4e078e-c7d8-3d0d-a40e-b823505c8fe0",
                        "entry_id": "d000df8c-0e4a-3993-a32f-be5165d38e48",
                        "glosses": [
                            "gelukt, succesvol, dat iets of iemand een toets heeft doorstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067a3a47-ba75-486d-9e48-5c30c682b83d",
                                "sense_id": "8e4e078e-c7d8-3d0d-a40e-b823505c8fe0",
                                "text": "De ouders van het geslaagde meisje hingen de vlag uit nadat ze haar diploma had gehaald."
                            },
                            {
                                "example_id": "25b7f592-25a9-4791-b72f-5cd43c26631e",
                                "sense_id": "8e4e078e-c7d8-3d0d-a40e-b823505c8fe0",
                                "text": "Ik kwam tot de conclusie dat Pamela iemand was die haar buik rond eten met cervelaatworst op Leicester Square als een geslaagd avondje uit beschouwde."
                            },
                            {
                                "example_id": "7337634b-c34a-44e9-b590-888d8c214319",
                                "sense_id": "8e4e078e-c7d8-3d0d-a40e-b823505c8fe0",
                                "text": "Haar vader had financiële problemen, Louise noch hij wist er de details van, maar ze hadden begrepen dat het om een paar minder geslaagde zaken ging, misschien zelfs van die zaken die zo nu en dan voorkomen in oorlogstijd, die zaken waarbij je het risico liep het slachtoffer te worden van minder gewetensvolle debiteurs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "21318938-c6f8-37b7-abf3-28836b81839e",
                "word": "geslaagd",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0193ad7a-d83c-3e66-9f83-770fa6a5afbd",
                        "entry_id": "21318938-c6f8-37b7-abf3-28836b81839e",
                        "glosses": [
                            "voltooid deelwoord van slagen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c926549c-8f4d-4558-b0fb-4739858381f1",
                                "sense_id": "0193ad7a-d83c-3e66-9f83-770fa6a5afbd",
                                "text": "Het verbaasde Teresa dat Sarah erin was geslaagd om zichzelf in Santa Justa in de waterput te zien."
                            },
                            {
                                "example_id": "7be52799-0c17-454a-b4cb-42c217817d74",
                                "sense_id": "0193ad7a-d83c-3e66-9f83-770fa6a5afbd",
                                "text": "Deze fabrikanten proberen elkaar flink af te troeven. \"Er is echt een innovatie-oorlog gaande. Omdat er nu zo veel concurrentie is, probeert iedereen nieuwe functies in een auto te stoppen\", zegt Van Dillen. Niet elke innovatie is volgens hem even geslaagd. \"Veel van de nieuwe Chinese auto's hebben een waslijst aan innovaties waar mensen waarschijnlijk niet veel van zullen gebruiken.\""
                            }
                        ]
                    }
                ],
