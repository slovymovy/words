                "senses": [
                    {
                        "sense_id": "10efc383-5d7e-310e-9621-f23d1916260a",
                        "entry_id": "2a0efe7e-8fcb-33ec-a659-57c1064ed169",
                        "glosses": [
                            "Transformer progressivement en bidonville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "373493f8-1d71-451f-87a5-14548966d69a",
                                "sense_id": "10efc383-5d7e-310e-9621-f23d1916260a",
                                "text": "Au départ, on voulait qu'elle serve de soupape à l'encombrement qui commence à bidonvilliser et étouffer les grandes villes."
                            },
                            {
                                "example_id": "e53a0434-790f-4da7-aab4-1b9ad1d76296",
                                "sense_id": "10efc383-5d7e-310e-9621-f23d1916260a",
                                "text": "L'habitat témoigne alors de ce processus de paupérisation ; il se dégrade, manque cruellement d'entretien et finit par se « bidonvilliser »."
                            }
                        ]
                    }
