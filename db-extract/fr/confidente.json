                        "source_sense_id": "0a3329d2-582d-3a17-8edb-bbc81247e81c",
                        "source_sense_description": "(Théâtre) Personnage subalterne d’une tragédie ou d’une comédie à qui le ou les personnages principaux font leurs confidences.",
                        "target_lang_word": "confidante",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidante",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c7634cb-7cb3-3319-b5c0-2eb649a42ef0",
                                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                                        "glosses": [
                                            "A female confidant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "122ca842-0f8a-4508-a1b2-206705d7b7fc",
                                                "sense_id": "1c7634cb-7cb3-3319-b5c0-2eb649a42ef0",
                                                "text": "Dany’s descent into madness is coming, of that there’s no doubt, especially given that the episode ends with the execution of her confidante Missandei."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c883e5a-9fdb-394a-80a0-476300de6db2",
                                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                                        "glosses": [
                                            "A type of settee having a seat at each end at right angles to the main seats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961096f6-3c46-4b17-9032-a434dda33e96",
                                                "sense_id": "9c883e5a-9fdb-394a-80a0-476300de6db2",
                                                "text": "Meanwhile, Sally peels herself from the stage's only prop – a green-velvet confidante – and staggers off into the wings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                        "entry_id": "717b2655-2f10-3cf3-b84e-51c3227c2175",
                                        "glosses": [
                                            "Nonstandard spelling of confidant (male)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d610a4-eed6-4522-aac4-c74c2ceecdba",
                                                "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                                "text": "To Major Smiley, as his friend, his adviser, and his confidante, Adolphus Fitzopal had opened his heart […]"
                                            },
                                            {
                                                "example_id": "48bd7a1c-3d76-493f-a031-926ff3bd3bc8",
                                                "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                                "text": "Henry Wilberforce was one of his few confidantes, certainly the one of longest standing, now that Bowden and Froude were gone and Rogers declined to correspond with him."
                                            },
                                            {
                                                "example_id": "95ec25cc-0030-4aba-b206-e6fd23de4636",
                                                "sense_id": "ad2cf59b-3d38-33a7-8e95-deef472a9de0",
                                                "text": "The fortunate confidante is lost in anonymity. He is a character who has always intrigued biographers […] [but] nothing is known about his name or his personal history."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
