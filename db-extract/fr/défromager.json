                "senses": [
                    {
                        "sense_id": "bbacdbc2-f0f4-3168-a190-e3e36303ce63",
                        "entry_id": "debc6201-8039-3109-b0a7-908cb8fc34bb",
                        "glosses": [
                            "Provoquer un orgasme chez quelqu'un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6c1c0c2-75d4-40fb-b445-f1c019501968",
                                "sense_id": "bbacdbc2-f0f4-3168-a190-e3e36303ce63",
                                "text": "Et d’abord qu’est-ce que t’en sais qu’elle préférait pas rester baiser avec nous, plutôt que d’aller défromager le griffon ?"
                            },
                            {
                                "example_id": "783217bc-4c45-4f49-9af6-030cb0b5bd1c",
                                "sense_id": "bbacdbc2-f0f4-3168-a190-e3e36303ce63",
                                "text": "Il va me la défromager avec délicatesse, c’est sûr."
                            }
                        ]
                    },
                    {
                        "sense_id": "73978ef3-e79b-39ef-8c90-9dde71b001b4",
                        "entry_id": "debc6201-8039-3109-b0a7-908cb8fc34bb",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa04bdd-fd94-472c-8165-542306e614f5",
                                "sense_id": "73978ef3-e79b-39ef-8c90-9dde71b001b4",
                                "text": "Je m’approche du trou pour le voir se défromager au pied de l’arbre, vingt mètres plus bas!"
                            }
                        ]
                    }
