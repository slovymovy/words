                "senses": [
                    {
                        "sense_id": "240c51c4-3b22-3f89-9cb0-a1e76ec6456d",
                        "entry_id": "c2fbe7ec-ad7b-3aa8-b3d4-2147f4053ff3",
                        "glosses": [
                            "теория, утверждающая наличие связи между психическими, моральными свойствами человека и строением его черепа"
                        ],
                        "tags": [],
