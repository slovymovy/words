                    },
                    {
                        "translation_id": "2a7b438c-ce6e-463e-9bcf-edeb153bba03",
                        "source_entry_id": "805c9293-2d24-3053-83e5-bd52fe945ce6",
                        "source_sense_id": "b815c037-05d3-3589-b960-1ee55512f216",
                        "target_lang_word": "eindringlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindringlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                        "entry_id": "245c86e5-8000-3e6a-aa58-0ca2d79d6ca6",
                                        "glosses": [
                                            "mit großem Ernst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322209d8-365b-4920-9a66-b9846e875e40",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "Mit eindringlichen Worten erzählte die alte Dame von der Flucht aus dem Krisengebiet."
                                            },
                                            {
                                                "example_id": "20bef733-12e3-47a7-bd65-8eef44a76589",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "Die Behörden warnen eindringlich davor Drogen unbekannter Herkunft zu konsumieren, da die Gefahr einer Vergiftung besteht."
                                            },
                                            {
                                                "example_id": "1f5f00be-ad1c-4264-891b-cebcd0741cf6",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„Im Jahr 168 v.Chr. erlosch die makedonische Monarchie. Den Schlussakt aber setzte die Zerstörung Korinths im Jahr 146 v.Chr., die parallel zur Zerstörung Karthagos stattfand und den ungehemmten Anspruch Roms auf die Weltherrschaft in Ost und West eindringlich dokumentierte.“"
                                            },
                                            {
                                                "example_id": "cf75af93-f82c-4d60-831c-5acfb5c47061",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„\"Ein Jahr voller Klimakatastrophen und eindringlichen Warnungen der besten Wissenschaftler weltweit hätten zu viel mehr führen sollen\", so Greenpeace-Chefin Jennifer Morgan.“"
                                            },
                                            {
                                                "example_id": "1b01376c-8cd7-42ff-a604-0e31de6f6a16",
                                                "sense_id": "8f6000f3-8f6b-3f99-a58d-68dbe91dad86",
                                                "text": "„Eindringlich wies Lennart Meri auf die Gefahr der russischen Großmachtfantasien hin – und verurteilte die vorherrschende westliche Appeasement-Politik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4255960-5ed0-4bad-a681-89e5847f8c88",
                        "source_entry_id": "805c9293-2d24-3053-83e5-bd52fe945ce6",
                        "source_sense_id": "b815c037-05d3-3589-b960-1ee55512f216",
                        "target_lang_word": "instamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                        "entry_id": "8ce52479-c53c-32d1-a378-b2995552a500",
                                        "glosses": [
                                            "D’une manière instante ou pressante ; avec instance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9681ac54-269f-46bb-a1e3-dd785399cff7",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "Je demande si instamment à Dieu qu’il ne t’arrive aucun mal."
                                            },
                                            {
                                                "example_id": "2bf18b04-5619-47e3-a79a-a021b5f9058f",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "Oh ! Madame, si vous êtes si instamment attendue, permettez-moi de m’éloigner, car il me serait impossible de vous parler en ce moment."
                                            },
                                            {
                                                "example_id": "69f85a99-ddfe-45a0-aa99-e186bafb7864",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "Cette constatation faite, nous n'en avons pas moins à compter avec la nombreuse cohorte des névropathes vraiment insomniaques, qui souffrent de ne pas dormir, et qui prient instamment que le sommeil leur soit rendu."
                                            },
                                            {
                                                "example_id": "487c109a-7b94-45a7-8772-21d437cd6e19",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "— Édith vous prie de bien vouloir descendre un instant dans sa chambre. Rien qu’un instant. Elle vous en prie instamment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
