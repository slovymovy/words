                        "entry_id": "5585ae73-bc10-343c-a492-de080f3d580f",
                        "glosses": [
                            "An underground passage, subway, tunnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62dddba6-9e10-4924-8a2b-80826a39ee35",
                                "sense_id": "6242efce-d1fc-3061-a8a6-fa5a8ad294aa",
                                "text": "There are in fact many such subterranean underways in Germany, speeding traffic beneath bergs, burgs and villages and into and around and under big city downtowns ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "71da4248-dd52-365a-9878-ea01b6e14443",
                        "entry_id": "5585ae73-bc10-343c-a492-de080f3d580f",
                        "glosses": [
                            "A voyage, especially underwater."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a250a5-1b91-4efb-b657-9f876e266e4a",
                                "sense_id": "71da4248-dd52-365a-9878-ea01b6e14443",
                                "text": "I had been the diving officer on three previous submarines, …, and was an experienced officer of the deck with many underways and landings under my belt on all three."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c663a86-920e-4724-b4b4-6a0145e28bd6",
                        "source_entry_id": "5585ae73-bc10-343c-a492-de080f3d580f",
                        "source_sense_description": "underground passage, tunnel",
                        "target_lang_word": "Unterführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                        "entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                                        "glosses": [
                                            "Verkehrsweg, der unter einem anderen hindurchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7f5682-9719-4720-b0c1-41c0d3b0a001",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "Um zum Krankenhaus zu kommen, musste er die Unterführung passieren."
                                            },
                                            {
                                                "example_id": "f6096d43-9769-4ebb-b79b-e42222676e61",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "„Wir gelangen über einen Baustellenpfad aus der Unterführung hinaus auf den Bahnhofsvorplatz.“"
                                            },
                                            {
                                                "example_id": "e4913f72-7197-489f-9386-14cd51a40d4d",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "„Morgens zogen sie schweigsam los, vorbei an der Sandkiste und durch die große Unterführung hindurch.“"
                                            },
                                            {
                                                "example_id": "938be085-1d18-4c17-b6cf-84245d1c3eca",
                                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                                "text": "„In der Unterführung am Zentralplatz war eine Zoohandlung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e79955b0-8676-3e7a-9000-a719132a7090",
                                        "entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                                        "glosses": [
                                            "Schriftzeichen, das in der Zeile unter einem gleichen Wort gesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
