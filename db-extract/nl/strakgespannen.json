        "nl-extract.jsonl": [
            {
                "entry_id": "5407fd6d-2dcb-3e78-a67d-f607252701e0",
                "word": "strakgespannen",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a9932ad5-41f0-4921-b0bd-6fc35ba85782",
                        "entry_id": "5407fd6d-2dcb-3e78-a67d-f607252701e0",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "strakgespannens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73efc7f3-594e-3658-a9ec-24bc4de672b2",
                        "entry_id": "5407fd6d-2dcb-3e78-a67d-f607252701e0",
                        "glosses": [
                            "heel erg krachtig aangespannen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c5054e-d7d3-4c65-8bbc-7739b00bfdce",
                                "sense_id": "73efc7f3-594e-3658-a9ec-24bc4de672b2",
                                "text": "'Dit maakt ons verre neven en nichten en onze bloedlijn is er een van verleiders, overspeligen, moordenaars en fraudeurs. Zijn gezicht stond strakgespannen en ze legde haar hand op zijn mouw. `Maar ook van geliefden.'En hij schonk haar een blik die de warmte van die nacht terugbracht."
                            },
                            {
                                "example_id": "98a88344-47b0-419c-925b-25d52f7dd504",
                                "sense_id": "73efc7f3-594e-3658-a9ec-24bc4de672b2",
                                "text": "Het touw was strakgespannen om de schilders in staat te stellen van boven naar beneden te bewegen. Met hulp van andere bewoners konden de werklieden na enige tijd via een raam in veiligheid worden gebracht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97079dcb-cdfb-4686-9daf-00593a2e4442",
                        "source_entry_id": "5407fd6d-2dcb-3e78-a67d-f607252701e0",
                        "source_sense_id": "73efc7f3-594e-3658-a9ec-24bc4de672b2",
                        "source_sense_description": "heel erg krachtig aangespannen",
                        "target_lang_word": "taut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                        "entry_id": "948a26b3-a656-3a7b-8733-f9a620d9debd",
                                        "glosses": [
                                            "Under tension, like a stretched bowstring, rope, or sail; tight."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b80d457-cb95-42bd-acd2-f7bb53f2e3b8",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "The hawser was as taut as a bowstring, and the current so strong she pulled upon her anchor. All around the hull, in the blackness, the rippling current bubbled and chattered like a little mountain stream."
                                            },
                                            {
                                                "example_id": "27ff6c5c-1be4-4e14-8d3d-e44299aaecb2",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "Every piece of binding is first carefully examined and tested; then it is put on, cautiously and accurately. Every turn is hauled taut, taking care that it is in its right place. [...] A sledge journey of the kind we had before us is a serious undertaking, and the work has to be done seriously."
                                            },
                                            {
                                                "example_id": "58230f9b-d987-46a3-b5af-cabbeb7347ff",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "After some moments of interchanging messages with the leaders on the platform, during which the suspense in the hall was tremendously taut, the police left saying that the women arrested would have to report themselves at Bow Street the following morning."
                                            },
                                            {
                                                "example_id": "d1074c6f-ff77-4555-bc22-f964cd99d9fc",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "With an engine of the weight of a Garratt heading a long heavy coal train over such a road great skill in handling was necessary; not only by the enginemen but by the guard; the secret, of course, was to keep the couplings as taut as possible throughout the train to avoid severe \"snatches\"."
                                            },
                                            {
                                                "example_id": "93fde875-868f-466a-9c0d-6f9aac7f2555",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "The cord goes taut, tauter, tautest, till down she trips and Adam has a good laugh."
                                            },
                                            {
                                                "example_id": "b8b39814-ae5f-46e3-8f8a-a35e4df16fc5",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "Lisa Jones – a woman in her thirties – sits cross-legged onstage, absent-mindedly tuning the high E-string on an acoustic guitar. She tunes the string up and up until it reaches the correct note – and then continues on past it. [...] Higher and higher the note, the string growing ever more taut, the fretboard beginning to tremble under the strain, the tension rising – but she still winds the tuning peg, up and up and up and up until … … the string snaps!"
                                            },
                                            {
                                                "example_id": "4d0fefde-9e38-4adc-8a11-6b721e3525b1",
                                                "sense_id": "ef4f51ac-323f-3df1-8a5f-3485cb5a8a52",
                                                "text": "As Red played the intro, he allowed himself a passing glance at her. She was at the back of the crowd, face taut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad877b5-d36b-3ab3-95c2-cf0ab6c65b64",
                                        "entry_id": "948a26b3-a656-3a7b-8733-f9a620d9debd",
                                        "glosses": [
                                            "Not flabby; firm, toned; (of a person) having a lean, strong body."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b16732b2-dd94-42dd-a527-348b8ea66ae6",
                                                "sense_id": "8ad877b5-d36b-3ab3-95c2-cf0ab6c65b64",
                                                "text": "I watched him from the side as he strode along. His walk was quite different; his face too looked tauter."
                                            },
                                            {
                                                "example_id": "7b3f5d98-7a15-435d-8344-7433f933912f",
                                                "sense_id": "8ad877b5-d36b-3ab3-95c2-cf0ab6c65b64",
                                                "text": "In a sense, Michelangelo's David is everything his Bacchus was not: firmly in control of himself while the god of wine was teetering on the brink of dissolution; his senses heightened while Bacchus's are dulled. Where one is taut, the other is flaccid. David's toned, athletic body contrasts with Bacchus's effeminate form, illustrating the dichotomy in Michelangelo's mind between the active masculine force and the passive feminine."
                                            },
                                            {
                                                "example_id": "82c1f7c2-5c1c-4f7c-93ec-245b2f8720c8",
                                                "sense_id": "8ad877b5-d36b-3ab3-95c2-cf0ab6c65b64",
                                                "text": "The silky sarong fell away, pooling around her hips with a whisper. Her nipples were pink and taut, the rest of her naked body a soft glow as moonlight flowed through the living room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af509ef-b90e-3983-982f-0f69b76b1467",
                                        "entry_id": "948a26b3-a656-3a7b-8733-f9a620d9debd",
                                        "glosses": [
                                            "Containing only relevant parts; brief and controlled."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0da16e-9238-494b-b506-55ac02533aae",
                                                "sense_id": "5af509ef-b90e-3983-982f-0f69b76b1467",
                                                "text": "If he curbs his swing a little and gets something crisper and tauter in his methods he may yet be very good."
                                            },
                                            {
                                                "example_id": "44cef53e-6c08-475f-8afe-5ad8316c92e2",
                                                "sense_id": "5af509ef-b90e-3983-982f-0f69b76b1467",
                                                "text": "The superbly crafted suspense thriller that director Jonathan Demme has made from Thomas Harris's taut best-selling novel The Silence of the Lambs slams you like a sudden blast of bone-chilling, pulse-pounding terror."
                                            },
                                            {
                                                "example_id": "dc4beef1-6a52-483e-864c-eba19287b365",
                                                "sense_id": "5af509ef-b90e-3983-982f-0f69b76b1467",
                                                "text": "Quick action and dialogue create a taut story, although it is illustration that shapes the characters."
                                            },
                                            {
                                                "example_id": "6cb5101e-c2be-4f1d-9a07-bb10a5f9bf16",
                                                "sense_id": "5af509ef-b90e-3983-982f-0f69b76b1467",
                                                "text": "Guitarist Jade Puget and vocalist Davey Havok have distilled AFI's strengths (a ferocious, post-hardcore rhythmic backbone; goth-tinctured, post-punky guitars; and Havok's desperate, dramatic croon) into 14 taut, hook-driven songs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69448ab6-8b9d-35d9-a456-1836f6d97236",
                                        "entry_id": "948a26b3-a656-3a7b-8733-f9a620d9debd",
                                        "glosses": [
                                            "Experiencing anxiety or stress."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efd2755-9263-408c-91be-5d61f48fcbcc",
                                                "sense_id": "69448ab6-8b9d-35d9-a456-1836f6d97236",
                                                "text": "His outward appearance was calm, but inside he was very taut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                                        "entry_id": "948a26b3-a656-3a7b-8733-f9a620d9debd",
                                        "glosses": [
                                            "Neat and well-disciplined; (by extension) efficient and in order."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c898fd2c-7926-40ec-b2e2-867d5e8d7623",
                                                "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                                                "text": "[O]ur friend was a hearty toper in the days of his Whiggery, but no sooner turned one of the tautest of Tories, than he took to the tea-pot. It seems a thing against nature."
                                            },
                                            {
                                                "example_id": "1df10f2f-d5ee-487c-86f2-9dd0385a84fb",
                                                "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                                                "text": "[T]he astonished boy looked round him, and wondered if this could really be the trim, taut ship he had read of. The deck was so encumbered with foul-smelling casks, coils of rope, and masses of rubbish, that there was no room to move; and Jack felt at a loss where to fly to be out of the way of the busy, swearing crew."
                                            },
                                            {
                                                "example_id": "a9e05f9f-e137-4a6e-a67f-6748e3a8ba01",
                                                "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                                                "text": "In the tautest schooner that ever swam / He rides at anchor at Anisquam."
                                            },
                                            {
                                                "example_id": "6bc1576c-d2fc-47e8-9272-ed8349350b23",
                                                "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                                                "text": "You've secured the neatest, trimmest, tautest little craft that ever man could wish to be commander of."
                                            },
                                            {
                                                "example_id": "414e14de-63a1-4741-8697-cfa5a0305895",
                                                "sense_id": "398e3334-3e7a-3f61-bc93-42d2bc6fb369",
                                                "text": "George Szell took up the reins of the Cleveland Orchestra in 1946, and made it one of the world's tautest, most disciplined ensembles, ideal in the classical and early romantic repertory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf91ce2d-3eca-37ec-b26d-cadd30d94481",
                                        "entry_id": "948a26b3-a656-3a7b-8733-f9a620d9debd",
                                        "glosses": [
                                            "Strong; uncompromising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d9e7f1-7de3-4669-9b73-494ac4b3bdc6",
                                                "sense_id": "cf91ce2d-3eca-37ec-b26d-cadd30d94481",
                                                "text": "Yet the 2016 Éxilé rosé from Lise et Bertrand Jousset in the Loire Valley, made mostly of gamay, was yeasty let light and lithe, while the 2016 Indigeno from Ancarani in Emilia-Romagna, made of trebbiano, was taut and earthy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f48aa5f-1060-3f23-9d65-8cb06ab9cfb5",
                                        "entry_id": "a68f8f54-1225-38e0-83e1-469d80dbd771",
                                        "glosses": [
                                            "To make taut; to tauten, to tighten."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5b85a84-83a5-4273-97bc-f0e61d68db4f",
                                                "sense_id": "8f48aa5f-1060-3f23-9d65-8cb06ab9cfb5",
                                                "text": "The machine is operated by a double friction drum hoist. From the rear drum a steel cable, called the tension cable, leads to a set of fall blocks attached to the mast pole. These blocks afford a means for slackening and tauting the track cable, one end of which is supported by the fall blocks and the other fastened to a \"dead man\" or other suitable anchorage planted in the bank of the pit opposite the dumping point."
                                            },
                                            {
                                                "example_id": "20310b6e-f28a-43a9-ab19-564ff8e430b6",
                                                "sense_id": "8f48aa5f-1060-3f23-9d65-8cb06ab9cfb5",
                                                "text": "The cold wind blew in again through the front door, and with a desperate, frantic energy Evelyn stretched both her arms around the bowl. She must be quick—she must be strong. She tightened her arms until they ached, tauted the thin strips of muscle under her soft flesh, and with a mighty effort raised it and held it."
                                            },
                                            {
                                                "example_id": "56ba57c8-94ac-466d-b6fa-30bf940e95e6",
                                                "sense_id": "8f48aa5f-1060-3f23-9d65-8cb06ab9cfb5",
                                                "text": "Men come down to the bare nail / suffer or inflict pain // life demands degradation / tauts the thread that hangs us all: [...]"
                                            },
                                            {
                                                "example_id": "7dd97368-29eb-4d1b-906d-3c5b14fd7eb2",
                                                "sense_id": "8f48aa5f-1060-3f23-9d65-8cb06ab9cfb5",
                                                "text": "The global penetration is measured with a potentiometric displacement sensor connected to an impeller. A thin steel cable is fastened with a spring to the vibrator and runs over the rim of the impeller. On the other side, a counterweight of 0.4 kg tauts the cable, [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
