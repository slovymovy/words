                        "entry_id": "8c305807-55d7-31cb-9e8b-f2e575d0a9b7",
                        "glosses": [
                            "Destiné à lutter contre l’hyperactivité de la thyroïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3c20d2a-1e31-4882-8677-7399fbd5471f",
                                "sense_id": "8675f57d-be29-38d7-97cf-700f0d5dd3ca",
                                "text": "Action antithyroïdienne iatrogène de médicaments antibactériens et antiparasitaires utilisés en thérapeutique vétérinaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "324e8a8e-534c-4d9c-b3d5-80ee1047659a",
                        "source_entry_id": "8c305807-55d7-31cb-9e8b-f2e575d0a9b7",
                        "source_sense_id": "8675f57d-be29-38d7-97cf-700f0d5dd3ca",
                        "target_lang_word": "antithyroid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antithyroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7891aaa-98b2-3392-b73e-2ac443e19b1d",
                                        "entry_id": "6386e3a8-a965-32af-9a18-6140fa73df24",
                                        "glosses": [
                                            "Reducing the production or effects of thyroid hormones."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6a601dc-3735-464f-a9d1-fe86a9c69177",
                                                "sense_id": "b7891aaa-98b2-3392-b73e-2ac443e19b1d",
                                                "text": "A RECENT report by Anderson et al. on the antithyroid activity of a series of alkyl derivatives of thiouracil shows that peak activity is reached at the n-propyl compound."
                                            },
                                            {
                                                "example_id": "c84e8468-90fb-4844-ba15-2cf454948d19",
                                                "sense_id": "b7891aaa-98b2-3392-b73e-2ac443e19b1d",
                                                "text": "Postmortem histological examination of the thyroid gland and measurement of serum antithyroid antibodies were performed in 70 patients without overt thyroid disease."
                                            },
                                            {
                                                "example_id": "add48224-813c-4e76-bd3e-f268d1e4957e",
                                                "sense_id": "b7891aaa-98b2-3392-b73e-2ac443e19b1d",
                                                "text": "Antithyroid drugs, which have been in use for more than half a century, remain cornerstones in the management of hyperthyroidism, especially for patients with Graves' disease."
                                            },
                                            {
                                                "example_id": "21609684-9f35-475e-a3c4-f93e6e7ef43b",
                                                "sense_id": "b7891aaa-98b2-3392-b73e-2ac443e19b1d",
                                                "text": "2005, The American Thyroid Association, \"Hyperthyroidism\",\nDrugs known as antithyroid agents—methimazole (Tapazole®) or propylthiouracil (PTU)—may be prescribed if your doctor chooses to treat the hyperthyroidism by blocking the thyroid gland’s ability to make new thyroid hormone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
