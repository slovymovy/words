{
    "word_family": [
        "stanch",
        "staunchly",
        "staunchness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0f678471-5e52-39a0-89ac-f2eb6c09f89b",
                    "sense_definition": "Staying true to one's aims or principles; firm, resolute, unswerving.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loyal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She remained a <w>staunch</w> defender of human rights throughout her long career.",
                            "target_lang_translations": {
                                "tr": "Uzun kariyeri boyunca insan haklarının <w>tavizsiz</w> bir savunucusu olarak kaldı."
                            }
                        },
                        {
                            "text": "The candidate has a <w>staunch</w> group of supporters who attend every rally.",
                            "target_lang_translations": {
                                "tr": "Adayın her mitinge katılan <w>sıkı</w> bir destekçi grubu var."
                            }
                        }
                    ],
                    "synonyms": [
                        "steadfast",
                        "resolute",
                        "unwavering"
                    ],
                    "common_phrases": [
                        "staunch supporter",
                        "staunch defender"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hedeflerine veya ilkelerine bağlı kalan; kararlı, sarsılmaz, tavizsiz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sıkı",
                                "target_lang_sense_clarification": "bir davaya veya ilkeye sımsıkı bağlı"
                            },
                            {
                                "target_lang_word": "kararlı",
                                "target_lang_sense_clarification": "tutumundan şaşmayan"
                            },
                            {
                                "target_lang_word": "tavizsiz",
                                "target_lang_sense_clarification": "inanç ve ilkelerinde ödün vermeyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18e86545-6632-32a3-81d8-f46dba336519",
                    "sense_definition": "Dependable, loyal, reliable, trustworthy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loyal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been a <w>staunch</w> friend to me during the most difficult times.",
                            "target_lang_translations": {
                                "tr": "En zor zamanlarımda bana <w>sadık</w> bir dost oldu."
                            }
                        },
                        {
                            "text": "The company relies on its <w>staunch</w> employees to maintain high standards.",
                            "target_lang_translations": {
                                "tr": "Şirket, yüksek standartları korumak için <w>güvenilir</w> çalışanlarına güveniyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "loyal",
                        "reliable",
                        "trustworthy"
                    ],
                    "common_phrases": [
                        "staunch friend",
                        "staunch ally"
                    ],
                    "target_lang_definitions": {
                        "tr": "Güvenilir, sadık, vefakar, bağlı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sadık",
                                "target_lang_sense_clarification": "bağlı ve güvenilir kimse veya dost"
                            },
                            {
                                "target_lang_word": "vefalı",
                                "target_lang_sense_clarification": "bağlılığını her zaman sürdüren"
                            },
                            {
                                "target_lang_word": "güvenilir",
                                "target_lang_sense_clarification": "her koşulda itimat edilebilen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fd0bdef-3e73-33f5-83d0-55241e1b5d86",
                    "sense_definition": "Strongly built; in good or strong condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strong",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stone bridge is still <w>staunch</w> after centuries of heavy use.",
                            "target_lang_translations": {
                                "tr": "Eski taş köprü, yüzyıllar boyu süren yoğun kullanıma rağmen hâlâ <w>sağlam</w>."
                            }
                        },
                        {
                            "text": "They built a <w>staunch</w> shelter to protect the livestock from the winter storms.",
                            "target_lang_translations": {
                                "tr": "Hayvanları kış fırtınalarından korumak için <w>dayanıklı</w> bir barınak inşa ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "sturdy",
                        "robust"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sağlam yapılmış; dayanıklı veya güçlü durumda."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sağlam",
                                "target_lang_sense_clarification": "yapısal olarak güçlü ve dirençli"
                            },
                            {
                                "target_lang_word": "dayanıklı",
                                "target_lang_sense_clarification": "kolay yıpranmayan ya da yıkılmayan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a9715e21-a8f4-3d21-99ad-c5d6ff0ac59b",
                    "sense_definition": "To stop or restrict the flow of something, especially blood from a wound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stop_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor applied pressure to <w>staunch</w> the bleeding from the deep cut.",
                            "target_lang_translations": {
                                "tr": "Doktor, derin kesikten gelen kanamayı <w>dindirmek</w> için baskı uyguladı."
                            }
                        },
                        {
                            "text": "They used a clean cloth to <w>staunch</w> the wound until the ambulance arrived.",
                            "target_lang_translations": {
                                "tr": "Ambulans gelene kadar yarayı <w>durdurmak</w> için temiz bir bez kullandılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "stem",
                        "stop"
                    ],
                    "common_phrases": [
                        "staunch the bleeding"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin, özellikle de bir yaradan gelen kanın akışını durdurmak veya kesmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dindirmek",
                                "target_lang_sense_clarification": "kan veya akıntıyı durdurmak"
                            },
                            {
                                "target_lang_word": "durdurmak",
                                "target_lang_sense_clarification": "akışı kesmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}