                    "frequency": "Middle",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte pour enfants, un vieux <w>sorcier</w> vit seul au fond de la forêt sombre."
                        },
                        {
                            "text": "Le héros de cette histoire combat un puissant <w>sorcier</w> pour délivrer tout le royaume."
                        }
                    ],
                    "synonyms": [
                        "magicien",
                        "enchanteur"
                    ],
