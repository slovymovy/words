                        "entry_id": "d58f01ee-004c-3f2c-b7e6-a78f1e16da2b",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "igbos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a2b18ec-3fbd-33d0-a5e9-1037ddde0990",
                        "entry_id": "d58f01ee-004c-3f2c-b7e6-a78f1e16da2b",
                        "glosses": [
                            "Relatif aux Igbos en tant que peuple, à leur culture, à leur langue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefd3e08-64fc-485b-afcd-49b0ca901a33",
                                "sense_id": "2a2b18ec-3fbd-33d0-a5e9-1037ddde0990",
                                "text": "La tradition igbo fait des jumeaux des êtres maudits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1492dbc-cb41-4644-8df2-a098a28102ed",
                        "source_entry_id": "d58f01ee-004c-3f2c-b7e6-a78f1e16da2b",
                        "source_sense_id": "2a2b18ec-3fbd-33d0-a5e9-1037ddde0990",
                        "target_lang_word": "Igbo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Igbo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d25b892f-fd70-37de-9579-3a7f83e32822",
                                        "entry_id": "441d24b3-a646-3327-bbe2-e30e5d5076c7",
                                        "glosses": [
                                            "eine Igboid-Sprache, die in Westafrika (vorwiegend in Nigeria) gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d685763-1406-482c-9baf-1bc5d41f4e68",
                                                "sense_id": "d25b892f-fd70-37de-9579-3a7f83e32822",
                                                "text": "„Igbo gehört neben Haussa und Yoruba zu den Hauptsprachen in Nigeria, neben der offiziellen englischen Amtssprache.“"
                                            },
                                            {
                                                "example_id": "cdec2659-f036-44ec-9b44-24d75d35786e",
                                                "sense_id": "d25b892f-fd70-37de-9579-3a7f83e32822",
                                                "text": "„Das Igbo ist eher ein Bund sehr eng verwandter Sprachen als eine Sprache, ein für Afrika nicht untypischer Fall.“"
                                            },
                                            {
                                                "example_id": "040786a6-c9f1-4ecf-853c-7522fc71834f",
                                                "sense_id": "d25b892f-fd70-37de-9579-3a7f83e32822",
                                                "text": "„Das Ende der Saga blieb ein Geheimnis, weil sie ab der achten Strophe auf Igbo, Yoruba und Hausa sangen.“"
                                            },
                                            {
                                                "example_id": "c41dca5e-fd5f-410c-8b47-52c4c10e11fa",
                                                "sense_id": "d25b892f-fd70-37de-9579-3a7f83e32822",
                                                "text": "„›Ich dachte, im Osten sprechen alle Igbo.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Igbo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20566750-5c38-3aa7-9470-5bd883d7cdf6",
                                        "entry_id": "ad32a6c3-75cd-351f-b176-7d969243370c",
                                        "glosses": [
                                            "Angehöriger eines Volks in Nigeria"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2b20a4-0154-4cc5-86eb-1db87bd2c373",
                                                "sense_id": "20566750-5c38-3aa7-9470-5bd883d7cdf6",
                                                "text": "„Der traditionelle Lebensstil der Igbo, vorherrschend bis in die 1970er Jahre, basierte auf einem hohen Maß an kooperativem und altruistischem Verhalten.“"
                                            },
                                            {
                                                "example_id": "aae2c84c-d55e-488f-b7a0-94240ac2cbb7",
                                                "sense_id": "20566750-5c38-3aa7-9470-5bd883d7cdf6",
                                                "text": "„Die Igbo entwickelten sich zur führenden Ethnie in Ostnigerien, deren Mitglieder auf die viel zahlreicheren Hausa im Norden herabblickten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
