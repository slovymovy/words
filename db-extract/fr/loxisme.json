                        "examples": [
                            {
                                "example_id": "654e73f0-8e19-4aeb-8fa5-193458a795e3",
                                "sense_id": "6726f36b-9bd0-3ce2-a2de-e672166d89ca",
                                "text": "Je n'avais jamais entendu parler du mot \"loxisme\"."
                            },
                            {
                                "example_id": "32c0e0c1-7813-42a5-83e7-c58f49769561",
                                "sense_id": "6726f36b-9bd0-3ce2-a2de-e672166d89ca",
                                "text": "Le loxisme a conduit à un pillage de nos nations. Il a conduit à une invasion organisée par des hordes musulmanes, contrôlées et commandées par des agents j."
                            },
                            {
                                "example_id": "dd036da1-1651-46ec-8852-8d9a10b63a21",
                                "sense_id": "6726f36b-9bd0-3ce2-a2de-e672166d89ca",
                                "text": "Le loxisme est la haine des blancs par les juifs. Il s'agit de la forme de haine raciale la plus diffusée sur la planète et, pourtant elle n'est jamais mentionnée par la société."
                            },
                            {
                                "example_id": "a6864997-e244-46a7-8591-ae6202b14f0f",
                                "sense_id": "6726f36b-9bd0-3ce2-a2de-e672166d89ca",
                                "text": "Connaissez-vous le loxisme ? La haine raciale juive contre les peuples blancs ?"
                            }
                        ]
                    }
