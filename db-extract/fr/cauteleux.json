                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchtrieben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bbf8239-53af-3235-b350-c812de7f779d",
                                        "entry_id": "86b6b598-86a4-3073-90e1-77c63367ac0f",
                                        "glosses": [
                                            "gerissen, gewieft"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a20afc6f-eb67-44dc-b6ac-840a9bc4610b",
                                                "sense_id": "7bbf8239-53af-3235-b350-c812de7f779d",
                                                "text": "Eine durchtriebene Person verschafft sich durch unmoralische oder unethische Methoden einen ihr nicht zustehenden Vorteil."
                                            },
                                            {
                                                "example_id": "f12e792c-a855-484f-8dd2-1b1f213e076e",
                                                "sense_id": "7bbf8239-53af-3235-b350-c812de7f779d",
                                                "text": "Der Gangsterboss war durchtrieben und schreckte auch vor Mord nicht zurück, um seine Position in der Bande zu unterstreichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07f70da5-e1a4-4091-8ba8-e947473c67e3",
                        "source_entry_id": "270678b7-18df-30da-8c8b-f2a292b8ac22",
                        "source_sense_id": "0612adf9-50b0-3cc0-a354-7494ecdf9528",
                        "target_lang_word": "verschlagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
