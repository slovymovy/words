        "fr-extract.jsonl": [
            {
                "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                "word": "bassinet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5460fc7c-7428-41b6-9638-13cea1333bf0",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "tags": [
                            "plural"
                        ],
                        "form": "bassinets"
                    },
                    {
                        "form_id": "044bd350-1061-46df-883e-2e1519d85ab3",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "tags": [],
                        "form": "bacinet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "802b8d05-ee2d-37ca-9f8c-0f6daf3dd5af",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Petit bassin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2dfad9-788d-4409-8c2a-018af86fe94b",
                                "sense_id": "802b8d05-ee2d-37ca-9f8c-0f6daf3dd5af",
                                "text": "[…] les magnifiques papillons qui peuplent les solitudes et qui caressent les fleurs des deux mondes. […] je les voyais […] rivaliser d’éclat avec les corolles en coupes, en cloches, en bassinets, en cornets, en roses, en étoiles, en soleils, qui pendaient, vermeilles, de tous les rameaux."
                            },
                            {
                                "example_id": "d913eeb9-016f-40c8-8756-7711a20e2ffb",
                                "sense_id": "802b8d05-ee2d-37ca-9f8c-0f6daf3dd5af",
                                "text": "Un valet de l’auberge […] contenait la foule à la porte, qu’il barrait d’une sorte de pertuisane, ne laissant passer quiconque qu’il n’eût craché au bassinet dans un plateau d’argent posé sur une table."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b808ab1-7a35-3264-890b-7e785678cf80",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Bobèche d’un chandelier."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9a12aeb5-12ea-34a3-b148-89e38f07f84b",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Petite pièce creuse de la platine d’une arme à feu, dans laquelle on mettait l’amorce, et qui était recouverte par la batterie."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "f2909f4c-6fb2-43eb-9858-e74edd0ec306",
                                "sense_id": "9a12aeb5-12ea-34a3-b148-89e38f07f84b",
                                "text": "Fermer, ouvrir le bassinet."
                            },
                            {
                                "example_id": "81693075-f1bf-48e8-bad2-dd3fdddda00d",
                                "sense_id": "9a12aeb5-12ea-34a3-b148-89e38f07f84b",
                                "text": "Mettre la poudre au bassinet, dans le bassinet."
                            },
                            {
                                "example_id": "aae147a0-3fd1-4297-855f-2b963bcdf313",
                                "sense_id": "9a12aeb5-12ea-34a3-b148-89e38f07f84b",
                                "text": "Il amorçait le pistolet et ajoutait de la poudre à celle qui était déjà dans le bassinet."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb2aaf07-ddd2-394b-9f53-ecd25d6c7669",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Casque de fer à visière que portaient les hommes d’armes durant le moyen-âge."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ec3704a9-37a2-31f6-9968-111e4d1dacd1",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Cavité en forme d’entonnoir dans laquelle aboutissent tous les calices du rein."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8495fd2d-405d-3c37-a1f7-53f78fbc59d8",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Espèce de renoncule, bouton d’or."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b9347249-cd65-40fe-8383-c1d870aef512",
                                "sense_id": "8495fd2d-405d-3c37-a1f7-53f78fbc59d8",
                                "text": "Des prairies toutes jaunes de bassinets, bordées de pommiers couverts de fleurs blanches et roses, me rappellent les printemps et les prairies de la Normandie."
                            },
                            {
                                "example_id": "7843d25c-11f0-4524-8bf2-2b8e3b3487ac",
                                "sense_id": "8495fd2d-405d-3c37-a1f7-53f78fbc59d8",
                                "text": "On indique comme plantes les plus nuisibles aux récoltes […] et la renoncule rampante, que les cultivateurs désignent, selon les localités, par les noms de vuide-grange, pipon, bacinet, persu ; elle est très-nuisible à cause de sa facile propagation."
                            }
                        ]
                    },
                    {
                        "sense_id": "f338e5ba-1dfa-3890-90e1-58c7edbac9df",
                        "entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "glosses": [
                            "Cupule du gland du chêne."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38c81809-7b5d-4366-bf03-0c4e0f23097c",
                        "source_entry_id": "eb3e5998-13f1-380c-8e14-3e50fb2f4482",
                        "source_sense_description": "Casque",
                        "target_lang_word": "bassinet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bassinet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f8a3111-be1c-3ef0-9c6a-974917ee4d50",
                                        "entry_id": "efc489d1-d301-3096-8096-0ecae493d07d",
                                        "glosses": [
                                            "A newborn baby's bed, traditionally woven with reeds or straw; a (wicker) cradle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1134d6af-9f65-497a-a243-b0dcbaabe01e",
                                                "sense_id": "3f8a3111-be1c-3ef0-9c6a-974917ee4d50",
                                                "text": "The next day, the baby sleeps in a bassinet near my bed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bassinet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8aade3-703d-3afa-a498-09d715b3566e",
                                        "entry_id": "a0bb5037-5a73-3e6f-bc71-bb634c0932c2",
                                        "glosses": [
                                            "Alternative form of bascinet."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840a6aab-143c-401c-908f-cee66f856907",
                                                "sense_id": "cb8aade3-703d-3afa-a498-09d715b3566e",
                                                "text": "Bassinets were worn in the reigns of Edward II. and III. and Richard II. by most of the English Infantry, as may be repeatedly seen in the Rolls of Parliament, and other public records."
                                            },
                                            {
                                                "example_id": "0cda9f31-72b1-462d-ac8b-f878e7a0e31b",
                                                "sense_id": "cb8aade3-703d-3afa-a498-09d715b3566e",
                                                "text": "Alleyne stood by the tiller, looking backwards, the fresh wind full in his teeth, the crisp winter air tingling on his face and blowing his yellow curls from under his bassinet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
