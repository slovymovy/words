        "nl-extract.jsonl": [
            {
                "entry_id": "7358fd53-73f4-3afe-8236-64a7d0ae2fa8",
                "word": "toevalligerwijze",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ce95bd6-e336-3e32-8148-d0a42c195efb",
                        "entry_id": "7358fd53-73f4-3afe-8236-64a7d0ae2fa8",
                        "glosses": [
                            "op een manier die berust op toeval of pech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb3e64d-af4c-4a87-8d97-ed114991b70f",
                                "sense_id": "7ce95bd6-e336-3e32-8148-d0a42c195efb",
                                "text": "De omstandigheden, waaronder deze groepen leefden, waren toevalligerwijze in de Commissie van de tweede juni besproken en er was door Aleksej Aleksandrovitsj met kracht op gewezen dat dit een zaak was, die geen uitstel duldde, daar de autochtone bevolking zich in een jammerlijke toestand bevond."
                            },
                            {
                                "example_id": "1614bccd-2460-4faa-a157-5a2621dcaa79",
                                "sense_id": "7ce95bd6-e336-3e32-8148-d0a42c195efb",
                                "text": "Eind mei zat ook een Apeldoornse wijk zonder gas. Ook toen was er modder in de gasleiding gekomen na een waterleidingbreuk. \"Het is toevalligerwijze in een aangrenzende wijk. De gebieden overlappen enigszins.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47ec52dd-f373-4e75-bd76-de367985946d",
                        "source_entry_id": "7358fd53-73f4-3afe-8236-64a7d0ae2fa8",
                        "source_sense_id": "7ce95bd6-e336-3e32-8148-d0a42c195efb",
                        "source_sense_description": "op een manier die berust op toeval of pech",
                        "target_lang_word": "by chance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by chance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                        "entry_id": "2d6a64a2-982a-3e4f-99d0-592d81a4abe0",
                                        "glosses": [
                                            "Unexpectedly, accidentally; without foreplanning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "282dcf68-d656-467a-b518-f66fe3d0d941",
                                                "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                                "text": "I stumbled across the exit by chance."
                                            },
                                            {
                                                "example_id": "8692c1a3-03a4-4654-952f-905d0e23d1c5",
                                                "sense_id": "cef8240d-0402-3a45-8856-c0a40d63b44e",
                                                "text": "[...] Yojo had told him two or three times over, and strongly insisted upon it everyway, that instead of our going together among the whaling-fleet in harbor, and in concert selecting our craft; instead of this, I say, Yojo earnestly enjoined that the selection of the ship should rest wholly with me, inasmuch as Yojo purposed befriending us; and, in order to do so, had already pitched upon a vessel, which, if left to myself, I, Ishmael, should infallibly light upon, for all the world as though it had turned out by chance; and in that vessel I must immediately ship myself, for the present irrespective of Queequeg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                        "entry_id": "2d6a64a2-982a-3e4f-99d0-592d81a4abe0",
                                        "glosses": [
                                            "Possibly; perhaps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df29180-41a9-44d2-a31c-6ccfc7b1b98b",
                                                "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                                "text": "Are you by chance looking for the exit?"
                                            },
                                            {
                                                "example_id": "ab5b02a5-4c88-47cb-8c84-2932fb4b7680",
                                                "sense_id": "63dd9b9e-3f8a-3fb3-bc8f-7e02a67581d3",
                                                "text": "If by chance you notice the fine, almost sweet maltiness of the aroma, and the brisk, dry, mineral quality of the flavors, even better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87f9a82d-f5e0-4d21-bafa-b87532288826",
                        "source_entry_id": "7358fd53-73f4-3afe-8236-64a7d0ae2fa8",
                        "source_sense_id": "7ce95bd6-e336-3e32-8148-d0a42c195efb",
                        "source_sense_description": "op een manier die berust op toeval of pech",
                        "target_lang_word": "by accident",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by accident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c63bcfd1-f2f5-36a9-8884-188d5030a459",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "Accidentally; unintentionally; without meaning to; as the result of an event not expected, aided, or willingly planned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f654d342-2a72-425a-923e-85aa318ddee3",
                                                "sense_id": "c63bcfd1-f2f5-36a9-8884-188d5030a459",
                                                "text": "Sorry. I knocked over the vase by accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "As the result of some undesigned, unintended, unrelated, natural, or random occurrence; as the unexpected and unforeseen result of formerly unrelated factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9044340e-d76e-403e-9ab6-c5066abc12dc",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The car got totaled by accident; a giant snowdrift fell off the church roof."
                                            },
                                            {
                                                "example_id": "bb05287d-8655-471c-92c0-d7edc7f45dd8",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The only way that project still exists today is by accident; I thought we closed it years ago."
                                            },
                                            {
                                                "example_id": "cebd0362-7c33-4da9-adc8-3450947d4aec",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The scholar thinks the quote and the parable were spoken on different occasions and only by accident were brought together here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "By chance; unexpectedly; as the result of an unrelated series of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa47827-163d-4fd5-a6b2-2fe90e6f2f51",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "I hadn't seen her for years, but I ran into her by accident at the store."
                                            },
                                            {
                                                "example_id": "9079f2a3-7c5f-477f-8e47-7e5e935eda84",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "She overheard the information by accident."
                                            },
                                            {
                                                "example_id": "e719d215-78f7-45f7-aeb0-a25544be378d",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "Thou cam'st not to thy place by accident: It is the very place God meant for thee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "by accident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                        "entry_id": "9c8e2dca-c723-34cc-9f44-e6a18cb23f73",
                                        "glosses": [
                                            "Accidental; as the result of some unforeseen happening or series of events; unexpected; resulting from an event without the foresight, expectation, aid, or design of the person by whose agency it was caused; unintentional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786d10c7-77ca-4237-b8ca-be0d4608d3d9",
                                                "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                                "text": "The victim's death was by accident."
                                            },
                                            {
                                                "example_id": "fc16ab94-e72b-4077-b512-d6c3152e38fa",
                                                "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                                "text": "That the injury was by accident is not questioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
