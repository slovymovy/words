                ],
                "senses": [
                    {
                        "sense_id": "e59cc9e9-900b-3de5-b363-e0f747a78337",
                        "entry_id": "e75a3a40-cefe-3938-90c4-424f0550184c",
                        "glosses": [
                            "A small trench or ditch, typically built in a zigzag pattern, serving to connect or provide communication between two trenches, particularly the rear and front lines."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "744e5e21-bf5d-3a58-8fb6-271681a933e9",
                        "entry_id": "e75a3a40-cefe-3938-90c4-424f0550184c",
                        "glosses": [
                            "A line, drawn winding about, in order to enclose several tracts of land, or to attack some works."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "321aec4e-e041-4e85-870a-d745b2b70090",
                        "source_entry_id": "e75a3a40-cefe-3938-90c4-424f0550184c",
                        "source_sense_description": "passage connecting two trenches",
                        "target_lang_word": "boyau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boyau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd87a7d-6802-3ef3-9117-4b8eaee37941",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Intestin, tripes, viscères."
                                        ],
                                        "tags": [],
                                        "note": "se dit des animaux et péjorativement de l’homme",
                                        "examples": [
                                            {
                                                "example_id": "08a553a0-0d61-40aa-9eb3-34a1d383b087",
                                                "sense_id": "3cd87a7d-6802-3ef3-9117-4b8eaee37941",
                                                "text": "Une même pensée, qui mettait en leur tête comme une odeur de cuisine, allongeait les jambes, mouillait les bouches de salive, descendait jusqu'au fond des ventres où elle faisait chanter les boyaux."
                                            },
                                            {
                                                "example_id": "ca251a1e-baf8-4274-9b13-3fea6341278c",
                                                "sense_id": "3cd87a7d-6802-3ef3-9117-4b8eaee37941",
                                                "text": "Boyaux de chat, de porc."
                                            },
                                            {
                                                "example_id": "2732dac4-bed3-4e08-823d-cb6391ee0842",
                                                "sense_id": "3cd87a7d-6802-3ef3-9117-4b8eaee37941",
                                                "text": "Rendre tripes et boyaux, vomir avec de grands efforts."
                                            },
                                            {
                                                "example_id": "c54c951a-d5c6-4e87-82cf-4ec50a8dc5e4",
                                                "sense_id": "3cd87a7d-6802-3ef3-9117-4b8eaee37941",
                                                "text": "Corde à boyau ou corde de boyau, corde faite des boyaux de certains animaux et servant à garnir divers instruments de musique, comme violon, guitare, harpe, etc., à monter des raquettes, et à beaucoup d’autres usages."
                                            },
                                            {
                                                "example_id": "d4fd2c91-7454-4924-b201-4b7b4dd5d627",
                                                "sense_id": "3cd87a7d-6802-3ef3-9117-4b8eaee37941",
                                                "text": "Racler le boyau, jouer mal d'un instrument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad09e39-66c9-3ecb-be8e-847956d3a703",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Intestin, tripes, viscères.",
                                            "Membrane de l’intestin qui sert à diverses industries, telles qu’en charcuterie la préparation des boyaux soufflés, la fabrication des baudruches, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fccc8239-6662-49d5-95a8-65dfb5d760d3",
                                                "sense_id": "2ad09e39-66c9-3ecb-be8e-847956d3a703",
                                                "text": "Léon, de la main droite, soulevait un long bout de boyau vide, dans l'extrêmité duquel un entonnoir très évasé était adapté ; et, de la main gauche, il enroulait le boudin autour d’un bassin, d’un plat rond de métal, à mesure que le charcutier emplissait l’entonnoir à grandes cuillerées. La bouille coulait, toute noire et toute fumante, gonflant peu à peu le boyau, qui retombait ventru, avec des courbes molles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e6a63be-59e7-345a-b1b4-a2a6ab03a81b",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Long conduit de cuir adapté à une machine hydraulique pour porter l’eau à distance ou pour l’élever à une certaine hauteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6385de89-11c7-33ba-a280-c8e65f665323",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Galerie étroite servant de communication entre deux galeries plus larges."
                                        ],
                                        "tags": [
                                            "Industrie minière",
                                            "Spéléologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1e0e1b0-51e1-3ba4-9792-499c028c5db1",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Espace long et peu large."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa23cc54-65ab-4ce0-a31f-73b7fe4e7fad",
                                                "sense_id": "f1e0e1b0-51e1-3ba4-9792-499c028c5db1",
                                                "text": "Cette salle n’est qu’un boyau."
                                            },
                                            {
                                                "example_id": "78606579-9920-4f4f-8c89-855ba56a8ab7",
                                                "sense_id": "f1e0e1b0-51e1-3ba4-9792-499c028c5db1",
                                                "text": "Si vous rétrécissez cette galerie, ce ne sera plus qu’un boyau."
                                            },
                                            {
                                                "example_id": "9d0cf64c-956c-4d48-bf03-577a2d8f3d56",
                                                "sense_id": "f1e0e1b0-51e1-3ba4-9792-499c028c5db1",
                                                "text": "Après le lit, une ruelle bornée par une sorte de couloir que fermait une cloison percée, à la tête et au pied, de deux ouvertures sans porte, assez larges pour livrer passage à un homme d'un certain embonpoint. Ce boyau, fermé à une extrémité par la muraille, aboutissait de l'autre à la chambre."
                                            },
                                            {
                                                "example_id": "f2e67d93-50ec-456f-8bc5-cb084bfe4628",
                                                "sense_id": "f1e0e1b0-51e1-3ba4-9792-499c028c5db1",
                                                "text": "On étouffait dans ce boyau, étroit et écrasé comme une galerie de mine, que des lampes à gaz éclairaient."
                                            },
                                            {
                                                "example_id": "50082e39-ec01-48cb-a064-3a121ea3f98c",
                                                "sense_id": "f1e0e1b0-51e1-3ba4-9792-499c028c5db1",
                                                "text": "Le triste boyau sur lequel donnaient une douzaine de portes, toutes semblables, me serra le cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ac5fc5-9637-31fa-8441-84dc7a0fc755",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Partie de la tranchée que deux angles terminent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d11ef0d-95d2-3b52-90ea-8095e6c48980",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Voie étroite de communication entre deux tranchées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceccb694-16c6-4318-ad2c-562cf9ffe963",
                                                "sense_id": "6d11ef0d-95d2-3b52-90ea-8095e6c48980",
                                                "text": "Mission dangereuse. Il faut ramper par un boyau bouleversé, marmité, où déjà plusieurs des nôtres agonisent."
                                            },
                                            {
                                                "example_id": "8e493ad1-6cca-4ee6-ac2b-e60954400674",
                                                "sense_id": "6d11ef0d-95d2-3b52-90ea-8095e6c48980",
                                                "text": "Après une longue marche nous arrivâmes à une espèce de broussaille, à des boyaux un peu plus creusés, et à un abri de capitaine, qui n’était guère solide."
                                            },
                                            {
                                                "example_id": "42169e88-cbe4-406b-ac92-de0214dbb8c9",
                                                "sense_id": "6d11ef0d-95d2-3b52-90ea-8095e6c48980",
                                                "text": "Alfred Boucq était volontaire de guerre; il fut tué en 1917 au fameux « boyau de la Mort », à Dixmude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf057bbd-45d8-37da-bc5d-f50fd8be9add",
                                        "entry_id": "96915c06-d759-31d3-9862-0658e8d0926a",
                                        "glosses": [
                                            "Chambre à air, pneumatique de bicyclette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ee6cfd9-e3c9-4e69-adaa-473d0447ccbe",
                                                "sense_id": "cf057bbd-45d8-37da-bc5d-f50fd8be9add",
                                                "text": "Vite, Jules, prends les boyaux."
                                            },
                                            {
                                                "example_id": "154c9a66-9739-471b-a287-2d9a916322f8",
                                                "sense_id": "cf057bbd-45d8-37da-bc5d-f50fd8be9add",
                                                "text": "Ils portaient un ou deux boyaux de secours, croisés en huit et passés autour des épaules. Un autre plié plusieurs fois était maintenu à l’arrière de la selle par de fines courroies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
