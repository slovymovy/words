                "senses": [
                    {
                        "sense_id": "ad2d5dc0-fbba-32b4-80cb-e23c27746da3",
                        "entry_id": "75882a3f-7fbf-3d61-b0ff-1c5600ddb1f0",
                        "glosses": [
                            "Stab, der zur punktuellen Ionisation von kleinsten Bauteilgruppen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba88197-1b40-4430-a80d-71a0efc3b82f",
                                "sense_id": "ad2d5dc0-fbba-32b4-80cb-e23c27746da3",
                                "text": "„1265 Einzelpunkt Ionisationsstab Leistungsstarker Punkt-Ionisator. Dieser Ionisationsstab ist ideal zur Ionisation von kleinen Teilen in kompakter Bauweise. […]“"
                            },
                            {
                                "example_id": "3533ea0a-9e76-4685-bf06-5a9a13a9d702",
                                "sense_id": "ad2d5dc0-fbba-32b4-80cb-e23c27746da3",
                                "text": "„Der Ionisationsstab EI DC eignet sich hervorragend für den Einsatz in schnell laufenden Prozessen oder zum Neutralisieren von hohen elektrostatischen Ladungen.“"
                            },
                            {
                                "example_id": "13a51593-9f12-4d7c-92d5-2f99e808260f",
                                "sense_id": "ad2d5dc0-fbba-32b4-80cb-e23c27746da3",
                                "text": "„Der Ionisationsstab IO RN ist ein leistungsstarkes und robustes Gerät zur Beseitigung elektrostatischer Aufladungen und hat sich bei Folien-Paternostern und Panel Cleaner hervorragend bewährt.“"
                            },
                            {
                                "example_id": "98a1b4b1-dfd9-498f-95fb-601d5a437f63",
                                "sense_id": "ad2d5dc0-fbba-32b4-80cb-e23c27746da3",
                                "text": "„Ein handelsüblicher Ionisationsstab besitzt zur gleichmäßigen Verteilung der hohen Spannung symmetrisch angeordnete, nur sehr kleine, zylindrische Elektroden mit einem Durchmesser von ca. 1 mm, die in einem isolierenden Material eines Halters so eingesetzt sind, daß die Elektrode nur ca. 2 bis 4 mm vorsteht.“"
                            },
                            {
                                "example_id": "6a383ba2-1c4e-4e1f-9ad2-308d7b774e79",
                                "sense_id": "ad2d5dc0-fbba-32b4-80cb-e23c27746da3",
                                "text": "„Mit dem Ionisator verhindert der Ionisationsstab Störeinflüsse beim automatischen Einwiegen mit dem 864 Balance Sample Processor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
