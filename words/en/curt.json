                },
                {
                    "sense_id": "bbd6fabf-7eba-3281-b78f-a2808844d48f",
                    "sense_definition": "A short form of the male given name <w>Curtis</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "male_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Most people call him <w>Curt</w>, but his full name is Curtis.",
                            "target_lang_translations": {
                                "ru": "Большинство людей зовут его <w>Курт</w>, но его полное имя — Кёртис."
                            }
                        },
                        {
                            "text": "He introduced himself as <w>Curt</w> during the meeting.",
                            "target_lang_translations": {
                                "ru": "Во время встречи он представился как <w>Курт</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая форма мужского личного имени Кёртис."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Курт",
                                "target_lang_sense_clarification": "уменьшительное имя"
                            }
                        ]
                    }
                }
            ]
        },
