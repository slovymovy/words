                            {
                                "example_id": "65f89e71-26c0-4b42-bd50-cef8d9ba60ae",
                                "sense_id": "7f89c736-fb0c-3ae7-86c7-d408b7e92a63",
                                "text": "Waarvan is die foto?"
                            }
                        ]
                    },
                    {
                        "sense_id": "76d71e79-f9fd-3d4c-b313-c9856c8bb3af",
                        "entry_id": "4ccc0ba0-2cd8-3cc6-a0ac-c260c81ad9e9",
                        "glosses": [
                            "betrekkelijk van wat, van hetwelk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45772593-c6ed-4297-b4a4-34c0c20f4580",
                                "sense_id": "76d71e79-f9fd-3d4c-b313-c9856c8bb3af",
                                "text": "Ik weet niet waarvan deze opname gemaakt is."
                            },
                            {
                                "example_id": "5e1170a3-5d5f-401d-96e6-64afea11dd45",
                                "sense_id": "76d71e79-f9fd-3d4c-b313-c9856c8bb3af",
                                "text": "Ik heb de camera waar dit een lens van is, niet bij me."
                            },
                            {
                                "example_id": "3ce2926e-f558-4c70-b475-b28949829e59",
                                "sense_id": "76d71e79-f9fd-3d4c-b313-c9856c8bb3af",
                                "text": "Hier was het nog lastiger omdat er twee mensen naast mij lagen, waarvan één tot overmaat van ramp de enige aanwezige vrouw was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efc78212-1240-4829-992e-49a1e65828c1",
                        "source_entry_id": "4ccc0ba0-2cd8-3cc6-a0ac-c260c81ad9e9",
                        "source_sense_id": "7f89c736-fb0c-3ae7-86c7-d408b7e92a63",
