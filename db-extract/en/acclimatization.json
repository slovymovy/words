                                    {
                                        "sense_id": "be87994d-0d26-3b46-85c2-2274ca1a2811",
                                        "entry_id": "867c8128-2823-3337-b01c-72255dc8bc96",
                                        "glosses": [
                                            "een verandering zodat iets beter werkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0fba7e-a6e9-45d3-919b-a6ee094b3a07",
                                                "sense_id": "be87994d-0d26-3b46-85c2-2274ca1a2811",
                                                "text": "Dat was de goede aanpassing waardoor het computerprogramma eindelijk goed werkte."
                                            },
                                            {
                                                "example_id": "9d5e030b-0a04-4105-9916-ee28c01e2b97",
                                                "sense_id": "be87994d-0d26-3b46-85c2-2274ca1a2811",
                                                "text": "De outfit komt 'met alle toeters en bellen', inclusief de aanpassingen die Whitney zelf heeft gedaan. In het grijze pak dat de zangeres onder de outfit droeg, zitten zelfs nog wat gaten die er tijdens de opnames zijn ingekomen. Ook missen er daardoor wat chromen balletjes die aan het pak zaten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f836dbd7-c9b9-377f-ab4d-af5493f09d14",
                                        "entry_id": "867c8128-2823-3337-b01c-72255dc8bc96",
                                        "glosses": [
                                            "het zich aanpassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a9509f0-fa25-487d-a422-757b6d125605",
                                                "sense_id": "f836dbd7-c9b9-377f-ab4d-af5493f09d14",
                                                "text": "Hij maakte een aanpassing in zijn manier van lesgeven."
                                            },
                                            {
                                                "example_id": "51884a0a-97d3-4d94-a2b5-0595b22c6b19",
                                                "sense_id": "f836dbd7-c9b9-377f-ab4d-af5493f09d14",
                                                "text": "In de jaren daarna deed Swanson nog enkele aanpassingen aan hun een- persoonsmaaltijden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
