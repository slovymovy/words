                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0322eca0-49d8-460f-a435-b70f26b644f2",
                        "entry_id": "a855c4da-d860-38e7-b393-50c0b5c01a69",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anadromes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3346023-6506-31e4-a6b5-8f0477dac0f4",
                        "entry_id": "a855c4da-d860-38e7-b393-50c0b5c01a69",
                        "glosses": [
                            "Qualifie les espèces aquatiques qui vivent habituellement en mer mais remontent les cours d’eau, fleuves, rivières pour s'y reproduire et pondre leurs œufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9171e49e-0a17-40b6-a333-2f7f57010766",
                                "sense_id": "b3346023-6506-31e4-a6b5-8f0477dac0f4",
                                "text": "C'est ainsi que les métis qui en proviennent […], d’anadromes que ceux-ci étaient, ils restent sédentaires, s’accommodent de la vie en étang et supportent mieux une température élevée que leurs auteurs."
                            },
                            {
                                "example_id": "f065896e-5043-41e2-95c8-2d70fe88db30",
                                "sense_id": "b3346023-6506-31e4-a6b5-8f0477dac0f4",
                                "text": "Ce poisson est anadrome. C’est-à-dire qu’il mène une double vie, une en eau douce, une en eau salée."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5b392ca-724d-3aeb-a631-f88b1d68ac0c",
                        "entry_id": "a855c4da-d860-38e7-b393-50c0b5c01a69",
                        "glosses": [
                            "Qualifie la nervation d’une fougère dans laquelle les premières nervures dans un segment de fronde sont produites en direction de l’apex de la fronde."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "252abc20-3335-47c7-8770-36c507dea6b8",
                        "source_entry_id": "a855c4da-d860-38e7-b393-50c0b5c01a69",
                        "target_lang_word": "anadromous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anadromous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db481358-84a1-3493-a7b7-75e23546069d",
                                        "entry_id": "a6bb8329-c8cc-336f-8b3a-4f125870c5a8",
                                        "glosses": [
                                            "That lives in the sea and breeds in fresh water."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a378f58-155f-4e4b-a39d-485abde435b0",
                                                "sense_id": "db481358-84a1-3493-a7b7-75e23546069d",
                                                "text": "Emphasizing that it has applied equitable apportionment to not only rivers and streams but also to interstate river basins, to groundwater pumping that affects surface water flows, and to anadromous fish like Chinook salmon and steelhead trout, the court stated that equitable apportionment applies only when transboundary resources are at issue."
                                            },
                                            {
                                                "example_id": "7cc3bc7d-1cbe-4b2b-8fac-8edd566adecd",
                                                "sense_id": "db481358-84a1-3493-a7b7-75e23546069d",
                                                "text": "Shads and most species of salmon are anadromous."
                                            },
                                            {
                                                "example_id": "3b22ba4e-0ab3-49c0-8fa6-ff08e6082e9c",
                                                "sense_id": "db481358-84a1-3493-a7b7-75e23546069d",
                                                "text": "Alewives are anadromous fish: Born in freshwater, they spend their lives in the ocean, returning annually to their birthplaces to spawn."
                                            },
                                            {
                                                "example_id": "7bada7f8-42bd-4cdf-934f-7b5b2fc9b1e6",
                                                "sense_id": "db481358-84a1-3493-a7b7-75e23546069d",
                                                "text": "Bird migration routes favor marshes and river valleys, as do, more obviously, the movement of anadromous salmon and, the mirror image, catadromous eels, to mention only two of the numerous migrating fish species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5059f35-3e8e-3a1d-966e-c37a9264fda4",
                                        "entry_id": "a6bb8329-c8cc-336f-8b3a-4f125870c5a8",
                                        "glosses": [
                                            "Of a fern: in which the first veins in a frond segment are produced towards the apex of the frond."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c3623b4-cccc-45c9-80a3-0a7b8bdb773f",
