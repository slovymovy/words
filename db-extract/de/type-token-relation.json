                        "glosses": [
                            "Linguistik: Verhältnis der Menge aller Wörter eines Textes zu der Menge der verschiedenen Wörter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435b1c46-582c-46ea-97cd-8c367d9b80e7",
                                "sense_id": "7404fcba-eb84-3284-ad6f-8ea8461ed5f9",
                                "text": "Die Type-Token-Relation gibt Aufschluss darüber, ob ein Text einen eher stereotypen oder eher reichhaltigen Wortschatz aufweist."
                            },
                            {
                                "example_id": "f14d3326-5bdc-456f-9f21-e8337e63bd1b",
                                "sense_id": "7404fcba-eb84-3284-ad6f-8ea8461ed5f9",
                                "text": "„Für die allgemeine Zeichentheorie und speziell für die Semantik der Identität ist die Type-Token-Relation von größter Bedeutung.“"
                            }
                        ],
