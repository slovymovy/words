    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13cb2bac-1908-3e4b-a3db-1a5978aa1c0b",
                    "sense_definition": "Совет, намёк или указание, помогающие найти решение или правильный ответ.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "advice_hint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студент смог решить эту сложную задачу без всякой <w>подсказки</w> со стороны преподавателя.",
                            "target_lang_translations": {
                                "pl": "Student zdołał rozwiązać to trudne zadanie bez żadnej <w>podpowiedzi</w> ze strony wykładowcy."
                            }
                        },
                        {
                            "text": "Если ты не знаешь правильного ответа, тебе очень пригодится небольшая <w>подсказка</w>.",
                            "target_lang_translations": {
                                "pl": "Jeśli nie znasz prawidłowej odpowiedzi, bardzo przyda ci się mała <w>wskazówka</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "намёк",
                        "совет"
                    ],
                    "common_phrases": [
                        "без всякой подсказки",
                        "нужна подсказка",
                        "небольшая подсказка"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rada, wskazówka lub naprowadzenie pomagające znaleźć rozwiązanie bądź właściwą odpowiedź."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "podpowiedź",
                                "target_lang_sense_clarification": "wskazówka, naprowadzenie na odpowiedź"
                            },
                            {
                                "target_lang_word": "wskazówka",
                                "target_lang_sense_clarification": "rada, instrukcja"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2be4fde-e33c-3732-9597-7f75b2c6b294",
                    "sense_definition": "Тайное или тихое указание (часто шёпотом) того, что нужно говорить или отвечать.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prompting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель строго запретил любые <w>подсказки</w> во время устного экзамена по истории.",
                            "target_lang_translations": {
                                "pl": "Nauczyciel surowo zabronił wszelkich <w>podpowiedzi</w> podczas ustnego egzaminu z historii."
                            }
                        },
                        {
                            "text": "Актёр на сцене внезапно забыл свою роль и ждал спасительной <w>подсказки</w> суфлёра.",
                            "target_lang_translations": {
                                "pl": "Aktor na scenie nagle zapomniał swojej roli i czekał na zbawienną <w>podpowiedź</w> suflera."
                            }
                        }
                    ],
                    "common_phrases": [
                        "подсказка суфлёра",
                        "надеяться на подсказку"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dyskretne lub ciche (często szeptane) mówienie komuś, co ma powiedzieć, np. w szkole lub w teatrze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "podpowiedź",
                                "target_lang_sense_clarification": "dyskretne podpowiadanie komuś"
                            },
                            {
                                "target_lang_word": "suflerowanie",
                                "target_lang_sense_clarification": "w teatrze, przez suflera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fea228b-8d6b-3f0f-a199-5c9ff55ba30c",
                    "sense_definition": "Слова или знак, помогающие вспомнить забытое.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "advice_hint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Когда певец случайно забыл слова куплета, из зрительного зала сразу послышались дружеские <w>подсказки</w>.",
                            "target_lang_translations": {
                                "pl": "Kiedy wokalista przypadkowo zapomniał słów zwrotki, z widowni od razu dało się słyszeć przyjazne <w>podpowiedzi</w>."
                            }
                        },
                        {
                            "text": "Благодаря этой краткой <w>подсказке</w> я сразу вспомнил имя нашего старого знакомого.",
                            "target_lang_translations": {
                                "pl": "Dzięki tej krótkiej <w>podpowiedzi</w> natychmiast przypomniałem sobie imię naszego dawnego znajomego."
                            }
                        }
                    ],
                    "synonyms": [
                        "напоминание"
                    ],
                    "target_lang_definitions": {
                        "pl": "Słowa lub znak pomagające przypomnieć sobie coś zapomnianego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przypomnienie",
                                "target_lang_sense_clarification": "słowo lub znak odświeżający pamięć"
                            },
                            {
                                "target_lang_word": "podpowiedź",
                                "target_lang_sense_clarification": "słowa pomagające sobie przypomnieć"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "517953ae-01c2-32dc-b16e-5a3266b15fc6",
                    "sense_definition": "Элемент графического интерфейса компьютерной программы, поясняющий функцию кнопки или элемента.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При наведении курсора мыши на значок на экране появляется полезная всплывающая <w>подсказка</w>.",
                            "target_lang_translations": {
                                "pl": "Po najechaniu kursorem myszy na ikonę na ekranie pojawia się przydatna <w>podpowiedź</w> w chmurce."
                            }
                        },
                        {
                            "text": "Разработчики добавили текстовые <w>подсказки</w> для всех новых кнопок приложения.",
                            "target_lang_translations": {
                                "pl": "Twórcy dodali <w>podpowiedzi</w> tekstowe dla wszystkich nowych przycisków w aplikacji."
                            }
                        }
                    ],
                    "common_phrases": [
                        "всплывающая подсказка"
                    ],
                    "target_lang_definitions": {
                        "pl": "Element interfejsu graficznego programu komputerowego wyjaśniający funkcję przycisku lub ikony."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dymek",
                                "target_lang_sense_clarification": "chmurka z objaśnieniem"
                            },
                            {
                                "target_lang_word": "podpowiedź",
                                "target_lang_sense_clarification": "tekst objaśniający element interfejsu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eba94bc-c426-3352-a684-2f4abb3605a8",
                    "sense_definition": "Листок или запись со справочными данными, используемые для тайного подглядывания; шпаргалка.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prompting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Докладчик незаметно заглянул в бумажную <w>подсказку</w>, чтобы не перепутать важные цифры.",
                            "target_lang_translations": {
                                "pl": "Prelegent dyskretnie zerknął w papierową <w>ściągawkę</w>, aby nie pomylić ważnych liczb."
                            }
                        },
                        {
                            "text": "На контрольной работе ученик спрятал в карман маленькую <w>подсказку</w> с формулами.",
                            "target_lang_translations": {
                                "pl": "Podczas sprawdzianu uczeń schował do kieszeni małą <w>ściągę</w> ze wzorami."
                            }
                        }
                    ],
                    "synonyms": [
                        "шпаргалка",
                        "шпора"
                    ],
                    "common_phrases": [
                        "листок-подсказка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Kartka lub notatka z informacjami używana do nieuczciwego podglądania; ściągawka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ściąga",
                                "target_lang_sense_clarification": "potocznie"
                            },
                            {
                                "target_lang_word": "ściągawka",
                                "target_lang_sense_clarification": "kartka z gotowymi odpowiedziami"
                            }
                        ]
                    }
                }
            ]
        }
