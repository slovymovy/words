{
    "word_family": [
        "spice",
        "spiciness",
        "spicily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a4faf4da-575a-3c33-913e-1a5c1080453c",
                    "sense_definition": "Producing a burning sensation in the mouth, typically from chili peppers or capsaicin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This curry is too <w>spicy</w> for me to eat without a glass of milk.",
                            "target_lang_translations": {
                                "ru": "Это карри слишком <w>острое</w>, я не могу его есть без стакана молока."
                            }
                        },
                        {
                            "text": "I love eating <w>spicy</w> food even though it makes my eyes water.",
                            "target_lang_translations": {
                                "ru": "Я обожаю <w>острую</w> еду, хотя от неё у меня слезятся глаза."
                            }
                        }
                    ],
                    "synonyms": [
                        "hot",
                        "spicy-hot",
                        "piquant"
                    ],
                    "antonyms": [
                        "mild",
                        "bland",
                        "unspicy"
                    ],
                    "common_phrases": [
                        "spicy food",
                        "spicy sauce",
                        "extra spicy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий ощущение жжения во рту, обычно из-за перца чили или капсаицина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "сильно приправленный перцем"
                            },
                            {
                                "target_lang_word": "жгучий",
                                "target_lang_sense_clarification": "вызывающий сильное жжение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4871fca8-0309-3fef-851b-ab10dff09302",
                    "sense_definition": "Containing or flavored with various spices like cinnamon, cloves, or nutmeg.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen was filled with the <w>spicy</w> aroma of freshly baked gingerbread.",
                            "target_lang_translations": {
                                "ru": "Кухня наполнилась <w>пряным</w> ароматом свежеиспеченного имбирного печенья."
                            }
                        },
                        {
                            "text": "He prepared a <w>spicy</w> casserole using a blend of traditional herbs.",
                            "target_lang_translations": {
                                "ru": "Он приготовил <w>пряную</w> запеканку, используя смесь традиционных трав."
                            }
                        }
                    ],
                    "synonyms": [
                        "spicy",
                        "tangy",
                        "zesty"
                    ],
                    "antonyms": [
                        "spiceless",
                        "bland"
                    ],
                    "common_phrases": [
                        "spicy aroma",
                        "spicy herbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий или приправленный различными специями, такими как корица, гвоздика или мускатный орех."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пряный",
                                "target_lang_sense_clarification": "с добавлением ароматных специй"
                            },
                            {
                                "target_lang_word": "ароматный",
                                "target_lang_sense_clarification": "имеющий сильный запах специй"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcfda0ce-687a-321e-9516-9fd99409efb1",
                    "sense_definition": "Suggestive, racy, or mildly provocative in a sexual or scandalous way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine was full of <w>spicy</w> details about the celebrity's private life.",
                            "target_lang_translations": {
                                "ru": "Журнал был полон <w>пикантных</w> подробностей о личной жизни знаменитости."
                            }
                        },
                        {
                            "text": "I don't want my children to see the <w>spicy</w> images on this website.",
                            "target_lang_translations": {
                                "ru": "Я не хочу, чтобы мои дети видели <w>неприличные</w> изображения на этом сайте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spicy details",
                        "spicy images"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe gossip or media content"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наводящий на размышления, пикантный или слегка провокационный в сексуальном или скандальном смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пикантный",
                                "target_lang_sense_clarification": "возбуждающий интерес, двусмысленный"
                            },
                            {
                                "target_lang_word": "неприличный",
                                "target_lang_sense_clarification": "выходящий за рамки приличия"
                            },
                            {
                                "target_lang_word": "скабрезный",
                                "target_lang_sense_clarification": "грубовато-непристойный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb2c8da-d1ae-338b-8bdc-fea0d432ef58",
                    "sense_definition": "Exciting, vigorous, or full of spirit and color.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate gave a <w>spicy</w> speech that energized the entire crowd.",
                            "target_lang_translations": {
                                "ru": "Кандидат произнес <w>острую</w> речь, которая зарядила энергией всю толпу."
                            }
                        },
                        {
                            "text": "He is known for his <w>spicy</w> political commentary in the local newspaper.",
                            "target_lang_translations": {
                                "ru": "Он известен своими <w>едкими</w> политическими комментариями в местной газете."
                            }
                        }
                    ],
                    "synonyms": [
                        "pungent"
                    ],
                    "common_phrases": [
                        "spicy commentary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Захватывающий, энергичный или полный духа и красок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "едкий, язвительный"
                            },
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "энергичный и выразительный"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "полный силы и задора"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}