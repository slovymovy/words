                ],
                "senses": [
                    {
                        "sense_id": "a4e59ce2-7d3d-3c4b-a4d0-411d8edc7cf3",
                        "entry_id": "f5140be6-1946-32c1-bd75-7147787d9515",
                        "glosses": [
                            "Objekt, mit dem man den oder vom Weltraum aus angreifen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f6a279-8cbb-418e-accc-0de0146ac1ac",
                                "sense_id": "a4e59ce2-7d3d-3c4b-a4d0-411d8edc7cf3",
                                "text": "„Aus Furcht, das globale Gleichgewicht der Mächte durch ein kostspieliges Wettrüsten im All zu destabilisieren, wurden Weltraumwaffen bisher größtenteils gemieden.“"
                            },
                            {
                                "example_id": "aa1a5ff0-d932-4d08-a2b4-9b573196a02c",
                                "sense_id": "a4e59ce2-7d3d-3c4b-a4d0-411d8edc7cf3",
                                "text": "„Üblicherweise sind Weltraumwaffen als Zerstörungssysteme definiert, die – direkt von der Erde abgeschossen oder in einer Umlaufbahn stationiert – im Weltraum operieren.“"
                            },
                            {
                                "example_id": "37211908-03d6-45c0-9af5-9964f8823cf2",
                                "sense_id": "a4e59ce2-7d3d-3c4b-a4d0-411d8edc7cf3",
                                "text": "„Auch orbitale Plattformen, die Geschosse abfeuern oder intensive Strahlung aussenden können, fallen unter die Weltraumwaffen.“"
                            },
                            {
                                "example_id": "91b9ef5f-285f-43c3-99c7-854c11003fa9",
                                "sense_id": "a4e59ce2-7d3d-3c4b-a4d0-411d8edc7cf3",
                                "text": "„Vor kurzem haben einige Befürworter von Weltraumwaffen die genannte Klassifizierung aber um zwei bereits vorhandene Technologien erweitert: interkontinentale ballistische Raketen (ICBM) und bodengestützte elektronische Kriegführungssysteme.“"
                            },
                            {
                                "example_id": "7e366157-1814-4079-8341-91017feacccd",
                                "sense_id": "a4e59ce2-7d3d-3c4b-a4d0-411d8edc7cf3",
                                "text": "„Zu den schwerwiegendsten technischen Herausforderungen im Zusammenhang mit der Stationierung von Weltraumwaffen gehört, wie ebenfalls bereits erwähnt, der Umgang mit dem entstehenden Weltraumschrott.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
