                "senses": [
                    {
                        "sense_id": "53e1ab1a-18c0-37fc-a5e2-c565b8fb88da",
                        "entry_id": "e00dfa5f-ae9e-3190-9e66-29ec0e760b49",
                        "glosses": [
                            "Sohle aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e699a2c9-00d8-4f90-a0ca-1de58f7812ea",
                                "sense_id": "53e1ab1a-18c0-37fc-a5e2-c565b8fb88da",
                                "text": "„Clogs werden traditionell mit Holzsohlen gefertigt.“"
                            },
                            {
                                "example_id": "4d696bb4-d226-4cc7-abd4-4b51ebf79efd",
                                "sense_id": "53e1ab1a-18c0-37fc-a5e2-c565b8fb88da",
                                "text": "„Clogs und andere Schuhe mit Holzsohlen können bequem, stylish, langlebig und einfach zum An- und Ausziehen sein.“"
                            },
                            {
                                "example_id": "0997b442-6c13-43f4-8947-02105702cb42",
                                "sense_id": "53e1ab1a-18c0-37fc-a5e2-c565b8fb88da",
                                "text": "„Krankenschwestern und andere Arbeiter, die den ganzen Tag auf ihren Beinen sind und daher orthopädische Schuhe benötigen, tragen Clogs mit Holzsohlen, da das Holz Stöße absorbiert und den Fuß schützt.“"
                            },
                            {
                                "example_id": "0c733f3e-a464-4572-8a18-44bc5550a207",
                                "sense_id": "53e1ab1a-18c0-37fc-a5e2-c565b8fb88da",
                                "text": "„Holzsohlen ohne die Polsterung der Extraschichten können Blasen, Schwielen und schwitzige Füße verursachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
