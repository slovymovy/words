                        "propriétés curatives"
                    ]
                },
                {
                    "sense_id": "ceec2c05-18d8-3c52-a1fc-abc25a5f1349",
                    "sense_definition": "Attribut ou caractéristique associée à un élément ou à un objet informatique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "caracteristique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développeur doit modifier une <w>propriété</w> de l'objet pour ajuster sa couleur d'affichage."
