                        "entry_id": "f66a65d4-7446-33ea-b285-e3eb46bc35a9",
                        "glosses": [
                            "Aufzeichnung eines Ereignisses mit Hilfe einer Filmkamera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16401ab2-1ceb-4af5-ba65-85bedf828c02",
                                "sense_id": "c27d5f89-ea44-3637-b7e2-09f59986297e",
                                "text": "„Bei 24 Bildern pro Sekunde reicht eine Kassette dabei gerade einmal für zweieinhalb Minuten Filmaufnahme.“"
                            },
                            {
                                "example_id": "8c62253a-35ff-4a9c-8995-369c69f4e7a0",
                                "sense_id": "c27d5f89-ea44-3637-b7e2-09f59986297e",
                                "text": "„Cyprian kam vorbei, sooft sie konnte, obwohl ihre neuen Filmaufnahmen sie sehr in Atem hielten – und die Romanze mit einer monokeltragenden Zeitungsverlegerin, die sie in der Bar in der Rue Edgar-Quinet kennengelernt hatte.“"
                            }
                        ],
