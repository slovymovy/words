                "senses": [
                    {
                        "sense_id": "4722b7ea-02ef-3c54-9cc4-87c195c9e3a1",
                        "entry_id": "480e127c-f631-3444-b48b-806605bb0e02",
                        "glosses": [
                            "Linguistik, geregelter Wechsel von langen und kurzen Silben"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "da15bab3-db55-459c-8111-4f85b6e90da7",
                                "sense_id": "4722b7ea-02ef-3c54-9cc4-87c195c9e3a1",
                                "text": "„Der Wohlklang ergab sich für ihn in erster Linie aus dem Sprachrhythmus, der durch »die richtige Abwechselung langer und kurzer Syllben« entsteht.“"
                            },
                            {
                                "example_id": "d253990c-a781-4e17-ac61-4ea70b3955e4",
                                "sense_id": "4722b7ea-02ef-3c54-9cc4-87c195c9e3a1",
                                "text": "„In der Dichtung unterscheidet man vom normalen Sprach-Rhythmus den gesteigerten Prosarhythmus der Kunstprosa und besonders den Versrhythmus:…“"
                            },
                            {
                                "example_id": "878cd7ae-bbf3-47a4-b8d9-bc79c0913f33",
                                "sense_id": "4722b7ea-02ef-3c54-9cc4-87c195c9e3a1",
                                "text": "„Der Trägerimpuls der Sprache hinsichtlich ihr zuweisbarer zeitstruktureller Zusammenhänge ist der Sprachrhythmus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
