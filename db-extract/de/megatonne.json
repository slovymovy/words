                "senses": [
                    {
                        "sense_id": "850f7a51-b70d-323e-bd9e-f515f4aed91c",
                        "entry_id": "f657672a-d4a4-3fbd-baff-e1cada9ff137",
                        "glosses": [
                            "eine Million Tonnen"
                        ],
                        "tags": [
                            "Maßeinheit"
                        ],
                        "examples": [
                            {
                                "example_id": "464d9b51-180a-4031-92e1-a32476fb4cc6",
                                "sense_id": "850f7a51-b70d-323e-bd9e-f515f4aed91c",
                                "text": "„Der Kasatochi (Alaska, 2008), der Sarytschew (Russland, 2009) und der Nabro (Eritrea, 2011) schleuderten Schätzungen zufolge jeweils weit über eine Megatonne Schwefeldioxid (SO2) in die Atmosphäre.“"
                            },
                            {
                                "example_id": "4617744e-37bf-419b-b2c2-516cfe59dc3a",
                                "sense_id": "850f7a51-b70d-323e-bd9e-f515f4aed91c",
                                "text": "„Die Experten beim Militärfachmagazin Jane's Defence in London nehmen an, die JL-2 könne je nach Variante drei bis zehn MIRVs mit einer Explosionskraft von je 90 Kilotonnen TNT-Äquivalent befördern, oder eine einzelne Bombe mit bis zu einer Megatonne Sprengkaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
