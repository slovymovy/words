                                "target_senses": [
                                    {
                                        "sense_id": "9f557d17-33d2-3eb9-9400-940ffc9485df",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "The highest form of bishop, in the ancient world having authority over other bishops in the province but now generally as an honorary title; in Roman Catholicism, considered a bishop second only to the Pope in rank."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a09803b5-6baf-319a-8620-212ad2dea2f9",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "A male leader of a family, tribe or ethnic group, especially one of the twelve sons of Jacob (considered to have created the twelve tribes of Israel) or (in plural) Abraham, Isaac and Jacob."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55a9823c-2303-4b35-acb0-6f7d127e17fa",
                                                "sense_id": "a09803b5-6baf-319a-8620-212ad2dea2f9",
                                                "text": "Men and brethren / lett me frely ſpeake vnto you of the patriarke David: For he is both deed and buryed / and his ſepulcre remayneth with vs vnto this daye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c42bfd-07aa-3944-811f-096dbba54bc1",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "A founder of a political or religious movement, an organization or an enterprise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ef4204-f3ba-346a-8288-295a419c1b0a",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "An old leader of a village or community."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06aa6563-90d2-4c7c-a60e-9d9b0b5514b1",
                                                "sense_id": "10ef4204-f3ba-346a-8288-295a419c1b0a",
                                                "text": "The opinions of this junto were completely controlled by Nicholas Vedder, a patriarch of the village, and landlord of the inn, at the door of which he took his seat from morning till night, just moving sufficiently to […] keep in the shade of a large tree; […]"
                                            },
                                            {
                                                "example_id": "f607ec51-23f0-422f-a950-27fb10f06150",
                                                "sense_id": "10ef4204-f3ba-346a-8288-295a419c1b0a",
                                                "text": "Fictional male antiheroes like television’s crime patriarchs Tony Soprano and Walter White have reigned for some time, but the antiheroine has only more recently had the opportunity to rise up – and become the cause of her own downfall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa8bda7c-2613-37d1-891f-c09efd4ea362",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "The male progenitor of a genetic or tribal line, or of a clan or extended family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a32f3af8-412c-335f-bcf4-afdc43aab1c2",
                                        "entry_id": "7e4e9f03-8928-3aeb-8720-7746efdcabff",
                                        "glosses": [
                                            "The male head of a household or nuclear family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f9dd64-e313-4b19-b391-c5c3b7c01953",
                                                "sense_id": "a32f3af8-412c-335f-bcf4-afdc43aab1c2",
                                                "text": "The popular Duck Dynasty television show and Duck Commander products took center stage in a controversy over comments made by Phil Robertson. As patriarch of the family and founder of the company, he stars in the A&E reality show based on his Louisiana life and company."
                                            }
                                        ]
                                    }
                                ]
