                                            {
                                                "example_id": "7b112f21-8a84-42ea-b74b-920337695d72",
                                                "sense_id": "2bed4e92-cbae-3499-a572-9206078d100a",
                                                "text": "Ze stopte het in haar tasje, dat ze op tafel had laten liggen en dat - alweer: wonderlijk genoeg - niet zoek was geraakt tijdens de overweldiging."
                                            },
                                            {
                                                "example_id": "5018dd38-a43e-4edd-9103-6a9a59e063a0",
                                                "sense_id": "2bed4e92-cbae-3499-a572-9206078d100a",
                                                "text": "Een boek als Nooit meer te druk zorgt er, wat mij betreft, vooral voor dat je je bewuster wordt van jezelf en je gedrag. Het continue gevoel van overweldiging door alles wat we moeten, veroorzaken we zelf en dus is het een kwestie van keuzes maken."
                                            }
                                        ]
