                        "form": "die Zugehörigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                        "entry_id": "6f5c38ca-2279-30d4-a539-3b7d31629b2b",
                        "glosses": [
                            "Eigenschaft, zu etwas dazuzugehören, Mitglied von etwas zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5604c469-d3c0-42a8-8019-54e936437025",
                                "sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                                "text": "„Kriminalität hat keine Religion oder ethnische Zugehörigkeit, sie ist weder türkisch noch deutsch.“"
                            },
                            {
                                "example_id": "0acdad72-a8a6-4f34-8290-21e1d6e014b3",
                                "sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                                "text": "„Wahlbestechungen wurden ein gängiges Mittel der Politik, und gegen Ende des 2. Jahrhunderts v.Chr. setzte eine erfolgreiche politische Laufbahn nicht mehr ausschließlich die Zugehörigkeit zur Nobilität und persönliche Leistung voraus, sondern vor allem große Geldmittel.“"
                            },
                            {
                                "example_id": "6b604f24-fafd-49f6-a95a-2469d81cd067",
                                "sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                                "text": "„Und nun werden sie von schwarzen Politikern übernommen, um so eine Hausmacht auf die Zugehörigkeit zu ihrem Volk zu gründen.“"
                            },
                            {
                                "example_id": "e6eb4c2e-5f54-4f6c-a0b0-3959ee1975d0",
                                "sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                                "text": "„Dank seiner ethnischen Zugehörigkeit bekam er einen Posten.“"
                            },
                            {
                                "example_id": "06d7c7de-2d33-47f5-9005-a18a140a0405",
                                "sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                                "text": "„Das zeigt sich ebenso am eigenartigen Verhältnis von Juden und Deutschen wie an der grundsätzlichen Art und Weise, in der hierzulande über Zugehörigkeit diskutiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d32d27ca-6466-4829-b78b-bcbb56fd5519",
                        "source_entry_id": "6f5c38ca-2279-30d4-a539-3b7d31629b2b",
                        "source_sense_id": "7ee2c899-c222-3201-8b2c-3b52ad99d798",
                        "source_sense_description": "Eigenschaft, zu etwas dazuzugehören, Mitglied von etwas zu sein",
                        "target_lang_word": "belonging",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belonging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "544ff6d6-70e6-3053-b9c4-1c1a1536ec15",
                                        "entry_id": "b9200684-143d-3762-8c39-3acf766c9a12",
                                        "glosses": [
                                            "The feeling that one belongs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41bd96ec-7b2e-40eb-b950-8ebd3594c7c9",
                                                "sense_id": "544ff6d6-70e6-3053-b9c4-1c1a1536ec15",
                                                "text": "I have a feeling of belonging in London."
                                            },
                                            {
                                                "example_id": "d6bd5156-ea4d-43d6-9a9b-4e35f1a75926",
                                                "sense_id": "544ff6d6-70e6-3053-b9c4-1c1a1536ec15",
                                                "text": "A need for belonging seems fundamental to humans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31a013a6-c63c-37eb-8d2d-7f2d99ca8aec",
                                        "entry_id": "b9200684-143d-3762-8c39-3acf766c9a12",
                                        "glosses": [
                                            "Something physical that is owned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f926ee44-f996-4615-8d70-58502b92aace",
                                                "sense_id": "31a013a6-c63c-37eb-8d2d-7f2d99ca8aec",
                                                "text": "Make sure you take all your belongings when you leave."
                                            },
                                            {
                                                "example_id": "2d84c408-d6a2-4516-991d-6525512ddc72",
                                                "sense_id": "31a013a6-c63c-37eb-8d2d-7f2d99ca8aec",
                                                "text": "[…] Thyself and thy belongings\nAre not thine own so proper as to waste\nThyself upon thy virtues, they on thee."
                                            },
                                            {
                                                "example_id": "8957dd24-c333-43ec-a118-3253caedb3be",
                                                "sense_id": "31a013a6-c63c-37eb-8d2d-7f2d99ca8aec",
                                                "text": "In the little houses the tenant people sifted their belongings and the belongings of their fathers and of their grandfathers. Picked over their possessions for the journey to the west."
                                            },
                                            {
                                                "example_id": "30ddf2e0-d5ff-4bfd-b46e-a3007d5cb7c9",
                                                "sense_id": "31a013a6-c63c-37eb-8d2d-7f2d99ca8aec",
                                                "text": "Now, upstairs, she changed into faded Levis and a green sweater, and fastened round her wrist her third most valued belonging, a gold watch […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b32133-28f9-3e05-a2a5-e24d76671a77",
                                        "entry_id": "b9200684-143d-3762-8c39-3acf766c9a12",
                                        "glosses": [
                                            "Family; relations; household."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "dated",
                                            "plural",
                                            "plural-only",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e1f3d8f-02cf-4725-bf55-c62be1936a0f",
                                                "sense_id": "c9b32133-28f9-3e05-a2a5-e24d76671a77",
                                                "text": "When Lady Kew said Sic volo, sic jubeo [Thus I will, thus I command], I promise you few persons of her ladyship’s belongings stopped, before they did her biddings, to ask her reasons."
                                            },
                                            {
                                                "example_id": "95531acb-fcf0-402c-88ac-02a184f5f307",
                                                "sense_id": "c9b32133-28f9-3e05-a2a5-e24d76671a77",
                                                "text": "As soon as the principal personages were seated, the verandah of the house was filled silently by the muffled-up forms of Lakamba’s female belongings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "belonging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03b1c8b7-cdde-37e7-9d13-6116d96825fe",
                                        "entry_id": "a98de0df-30a6-3870-a887-7edd3a88829a",
                                        "glosses": [
                                            "present participle and gerund of belong"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
