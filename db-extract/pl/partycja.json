                                                "example_id": "65041031-e52c-49ac-b394-d852d20b7658",
                                                "sense_id": "fbf38ee1-54e2-3096-8073-3c00c2893e2b",
                                                "text": "Poland was progressively partitioned by Russia, Austria, and Prussia in the late 18th century."
                                            }
