                "word": "demi-chasse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a03cbba7-63a8-38b6-aaf0-efc156a2a3b1",
                        "entry_id": "4cdad52f-266d-35e8-bc92-f42263cfc82c",
                        "glosses": [
                            "Caractère qui occupe une seule colonne sur l’écran texte traditionnel, par exemple une lettre latine, par opposition au caractère de pleine chasse qui occupe deux colonnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa979fe-9f0c-4cb5-8e9f-52c91be1886b",
                                "sense_id": "a03cbba7-63a8-38b6-aaf0-efc156a2a3b1",
                                "text": "Change les caractères anglais ou katakana à pleine chasse (codés sur deux octets) à l’intérieur d’une chaîne de caractères en caractères à demi-chasse (codés sur un octet)."
                            },
                            {
                                "example_id": "5c411214-b9bb-4149-a9ee-d79918a4a795",
                                "sense_id": "a03cbba7-63a8-38b6-aaf0-efc156a2a3b1",
                                "text": "La case à cocher Respectez les caractères à demi-chasse/à pleine chasse permet la reconnaissance des caractères à demi-chasse à pleine chasse issus des langues d'Asie de l'Est."
                            }
                        ]
                    }
                ],
