                        "glosses": [
                            "Type de carton, souple, épais, d'une structure poreuse, utilisé, entre autres, pour la fabrication du feutre bitumé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c349acd1-c054-4c20-a045-b7812a930f22",
                                "sense_id": "b5c47639-be96-3165-b7f9-074461da8962",
                                "text": "Le carton bitumé pour toiture se fabrique à partir du carton feutre laineux , dont la pâte est composée des chiffons demi-laine mélangés ou non avec de vieux papiers."
                            },
                            {
                                "example_id": "4fb6cfae-d003-4ddd-9f64-a21b378c1619",
                                "sense_id": "b5c47639-be96-3165-b7f9-074461da8962",
                                "text": "Les revêtements vinyliques sur feutre synthétique sont analogues aux précédents mais le feutre de jute est remplacé par un feutre en polyester et parfois par un carton-feutre ou une mince feuille de liège."
                            }
                        ]
