                    },
                    {
                        "form_id": "e1b035da-bb78-436f-92f1-b44f8f5d26ca",
                        "entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "tags": [
                            "feminine"
                        ],
                        "form": "sapeuse-pompière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                        "entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "glosses": [
                            "Synonyme de pompier."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "e8efc07a-c487-4444-b6cf-fd573acb01b4",
                                "sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                                "text": "Le calage voire l'étaiement du véhicule est une condition nécessaire à l'introduction de personnels dans le véhicule accidenté. Ce calage est effectué par les sapeurs-pompiers et utilise diverses méthodes."
                            },
                            {
                                "example_id": "1628e94f-917f-4152-be89-5fcb8e98ac80",
                                "sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                                "text": "Comme chaque année en début de saison estivale, de nombreux effectifs, de gendarmerie, maîtres-nageurs sauveteurs, sapeurs-pompiers, agents techniques et contractuels, viennent renforcer les services de la mairie michelaise."
                            },
                            {
                                "example_id": "17449b73-b65b-437d-b554-8ad555626e57",
                                "sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                                "text": "À Bezons (Val-d’Oise), un escape game a été installé dans la caserne des sapeurs-pompiers. Une initiative pour célébrer les 50 ans du service départemental d’incendie et de secours (SDIS)."
                            },
                            {
                                "example_id": "f822be37-4ebc-4a92-ab1f-66d857f7399f",
                                "sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                                "text": "Les deux incendies de Flaignes-Havys et Bossus-lès-Rumigny ont permis aux sapeurs-pompiers des Ardennes de tester leurs deux nouveaux véhicules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb82899f-9b30-495b-b428-ef9fff6928ac",
                        "source_entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "source_sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                        "source_sense_description": "sapeur-pompier",
                        "target_lang_word": "Feuerwehrmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwehrmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d442776c-0924-3c8c-af00-fa1947913380",
                                        "entry_id": "1e9a09e8-623e-3cb2-94c7-10c84f3468f9",
                                        "glosses": [
                                            "Person, die dafür ausgebildet ist, Feuer zu löschen und andere Personen aus gefährlichen Situationen zu retten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced7e624-2b1a-4ae1-9d44-2f4dd70b98cc",
                                                "sense_id": "d442776c-0924-3c8c-af00-fa1947913380",
                                                "text": "Viele kleine Jungen wollen später einmal Feuerwehrmann werden, wenn sie groß sind."
                                            },
                                            {
                                                "example_id": "32b96b7d-61b7-4a12-a226-b4ab95c75f5f",
                                                "sense_id": "d442776c-0924-3c8c-af00-fa1947913380",
                                                "text": "„Sie löschen Brände, helfen bei Hochwasser und retten Tiere: Feuerwehrleute genießen in der Bevölkerung hohes Ansehen – ganz im Gegensatz zu Managern.“"
                                            },
                                            {
                                                "example_id": "86c698f2-aeab-4dc8-9892-3dd50993c60b",
                                                "sense_id": "d442776c-0924-3c8c-af00-fa1947913380",
                                                "text": "„Droben im Turm, so hoch, daß man sich fast den Hals verrenken mußte, war die kleine Gestalt eines Feuerwehrmannes zu sehen, der das Gebäude inspizierte.“"
                                            },
                                            {
                                                "example_id": "3af827d6-f5a1-4a44-8862-c52f8524ae59",
                                                "sense_id": "d442776c-0924-3c8c-af00-fa1947913380",
                                                "text": "„Sie lief zu einem der Feuerwehrmänner.“"
                                            },
                                            {
                                                "example_id": "a9070abc-a673-44c0-b6c8-2a094840ac68",
                                                "sense_id": "d442776c-0924-3c8c-af00-fa1947913380",
                                                "text": "„Feuerwehrmänner rannten herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d23caa75-9632-480e-87f7-630080fb1a36",
                        "source_entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "source_sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                        "source_sense_description": "sapeur-pompier",
                        "target_lang_word": "Feuerwehrleute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwehrleute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f795f7e9-3e95-33ed-95bc-ec7fc7aafe4f",
                                        "entry_id": "71eeb15a-d05d-3a3f-b884-f44a74118e97",
                                        "glosses": [
                                            "alternativer (und eigenständiger) Plural von Feuerwehrmann (bei der Feuerwehr beschäftigte Person)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e084dd-b7f0-4d73-8942-46b25f83c402",
                                                "sense_id": "f795f7e9-3e95-33ed-95bc-ec7fc7aafe4f",
                                                "text": "„Feuerwehrleute und Helfer des Technischen Hilfswerks versuchten, das Gebäude abzustützen und vor dem völligen Einsturz zu bewahren.“"
                                            },
                                            {
                                                "example_id": "7d5008e4-8f8d-4f55-b413-822f16e69349",
                                                "sense_id": "f795f7e9-3e95-33ed-95bc-ec7fc7aafe4f",
                                                "text": "„Vor allem Aussagen von Feuerwehrleuten nährten den Verdacht, dass es sich lediglich um einen Unfall mit einem Gastank in einem nahen Gebäude gehandelt haben könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54d3d229-eb1b-43f5-ac3c-1b0f6bcc0657",
                        "source_entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "source_sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                        "source_sense_description": "sapeur-pompier",
                        "target_lang_word": "fireman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fireman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "477086d6-31a8-3ea9-af9e-28f6df39d24f",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "Someone (especially one who is male) who is skilled in the work of fighting fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7daecca9-0d3e-46cb-900c-c2c0c19338e2",
                                                "sense_id": "477086d6-31a8-3ea9-af9e-28f6df39d24f",
                                                "text": "By February 1944 there were over two thousand women employed at the Alabama Dry Dock and Shipbuilding Company [...]. There were also female firemen on almost every shipyard crane [...]."
                                            },
                                            {
                                                "example_id": "b33c85aa-dd9d-45f0-b9f7-ba140b589f48",
                                                "sense_id": "477086d6-31a8-3ea9-af9e-28f6df39d24f",
                                                "text": "For firemen everywhere rescuing cats from trees has been as much a part of the job as tackling blazing buildings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "A person (originally a man) who keeps the fire going underneath a steam boiler (originally, shoveling coal by hand), particularly on a railroad locomotive or steamship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6eb2258-9c5e-4457-ab9e-5a4261650ef9",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "He looked around his cab at his black greasy fireman, saying 'shovel on a little more coal, and when we cross that White Oak Mountain, you can watch Old 97 roll'."
                                            },
                                            {
                                                "example_id": "bba931e3-d10f-41b7-948a-64773822ccc5",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "No grass grew under a train when the engineer let Fireman McLash take the throttle."
                                            },
                                            {
                                                "example_id": "8eb482b2-2312-467c-a353-b78aa044e7cb",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "A few keen enginemen, such as Driver Rosewarne of York, could coax good work out of them when engaged in heavy East Coast express service, but to most footplate crews, especially firemen, they were rather heartbreaking and backbreaking machines, and gradually were relegated to secondary or fast goods duties."
                                            },
                                            {
                                                "example_id": "ff8bd3cf-9499-41b1-825d-e4bde4785461",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "I was elated to pass because there were times when I did not think I was physically capable. It is quite rare for a woman to become a fireman."
                                            },
                                            {
                                                "example_id": "ddf2339c-2ec6-4092-b88c-d8c37b7b9053",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "The driver remained at his post, while telling fireman Jim Nightall to get down on the track and run back to uncouple the burning wagon from the rest."
                                            },
                                            {
                                                "example_id": "d58b095c-3e92-402d-8848-d8d1219e682b",
                                                "sense_id": "ca5d962e-4dcc-3a8c-b0a7-87b22eb9c5f4",
                                                "text": "(the latter is informal)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d41a175-94ec-3a7c-b181-dee845dbc21b",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "An assistant on any locomotive, whether steam-powered or not."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b484799-7390-33b4-bfda-fe17436f7000",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "A relief pitcher (reflecting the figurative analogy of rescuing the situation)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f259ab4-aeae-3cab-9747-c35d1e366cef",
                                        "entry_id": "9af78a70-343d-31d9-9602-c73e66182df5",
                                        "glosses": [
                                            "A safety inspector in coal mines."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70f10438-df38-446e-bbdf-61ce7146e4f4",
                        "source_entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "source_sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                        "source_sense_description": "sapeur-pompier",
                        "target_lang_word": "brandweerman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brandweerman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4e80ce-05b7-3343-a8de-1d643151cef6",
                                        "entry_id": "3b0a0825-82dc-34cd-8a38-af72dfccf712",
                                        "glosses": [
                                            "speciaal voor het bestrijden van branden opgeleid lid van de brandweer"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91680775-be3c-4d43-8a6d-7c7ca4a4ebbc",
                                                "sense_id": "7b4e80ce-05b7-3343-a8de-1d643151cef6",
                                                "text": "„Het was ooit mijn grote droom brandweerman te worden. Maar ja, dat was een populair beroep, dus ik kwam er niet tussen. Sinds vorig jaar draai ik weer mee als vrijwilliger bij brandweer Gooi en Vechtstreek. Soms wel zeven dagdiensten in de maand, ik heb een jaar moeten trainen om fit genoeg te zijn. Nu blijf ik elk weekend hardlopen, anders komt opa niet door de keuring.”"
                                            },
                                            {
                                                "example_id": "d009c460-8da2-49fb-8c2c-f0e20938c726",
                                                "sense_id": "7b4e80ce-05b7-3343-a8de-1d643151cef6",
                                                "text": "„Dank jullie wel. Het is goed dat jullie gekomen zijn,” zegt Distel na 120 seconden. De groep mensen gaat uiteen. Anderen pakken hun afgebroken gesprek weer op. Brandweermannen brengen een groet. Een witte auto start zijn dieselmotor en rijdt weg. De burgemeester hurkt voor het monument en kijkt naar de namen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5086be6d-14f2-4480-98df-aa6aeb443e2f",
                        "source_entry_id": "8d377011-862c-3509-8e9d-6a337ba1b573",
                        "source_sense_id": "980e833e-c68d-30b3-a787-af551bf50ce6",
                        "source_sense_description": "corps des sapeur-pompier",
                        "target_lang_word": "Feuerwehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerwehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                        "entry_id": "1bcfff13-c540-3cda-9db1-e3153f01ff87",
                                        "glosses": [
                                            "berufsmäßig oder freiwillig aufgebaute Mannschaft zur Brandbekämpfung, für Notfälle, Katastrophenschutz und andere Aufgaben"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ffbad37-1be4-4c4b-b135-a59a8f4a9d95",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Er sei Mitglied der deutschen Feuerwehr und werde für die nächsten Wahlen seine Einschreibung in den deutschen Wahlkataster veranlassen.“"
                                            },
                                            {
                                                "example_id": "15365904-02fb-4d3c-8fff-73b9284c621a",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "Ein Nachbar alarmierte rasch die Feuerwehr."
                                            },
                                            {
                                                "example_id": "49315789-e46b-4fec-ba6a-49cf8bea4f09",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Ein Grossbrand in einem Wolkenkratzer von Dubai hält die Feuerwehr kurz vor dem Jahreswechsel in Atem.“"
                                            },
                                            {
                                                "example_id": "8fa9e16a-6f47-40e3-916f-c637439c9d05",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Instinktiv löste Carlos in diesem Moment den Alarm für die Feuerwehr aus.“"
                                            },
                                            {
                                                "example_id": "948ee618-1247-4323-b360-5f00f42157db",
                                                "sense_id": "997795dd-7129-3bd8-be69-c18d69929f43",
                                                "text": "„Keine Feuerwehren rückten aus, keiner schleppte Wassereimer, um zu löschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5c1eaed-afd4-36a7-bb7d-0f6608d6abc0",
                                        "entry_id": "1bcfff13-c540-3cda-9db1-e3153f01ff87",
                                        "glosses": [
                                            "Mitglieder der Feuerwehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca0eeaa-e0f0-4b4b-b549-457c1f007b68",
                                                "sense_id": "d5c1eaed-afd4-36a7-bb7d-0f6608d6abc0",
                                                "text": "Die Feuerwehr kommt."
                                            },
                                            {
                                                "example_id": "03e84c8f-302a-43ba-90ac-efa36d6d021b",
                                                "sense_id": "d5c1eaed-afd4-36a7-bb7d-0f6608d6abc0",
                                                "text": "„Wo immer es loderte, rückte die Feuerwehr aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96b28a50-47ad-3c14-a703-b1734f73c476",
