                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was arrested and taken down to the local <w>nick</w> for questioning.",
                            "target_lang_translations": {
                                "ru": "Его арестовали и отвезли в местный <w>участок</w> для допроса.",
                                "zh": "他被捕后被带到了当地的<w>局子</w>接受审讯。"
                            }
