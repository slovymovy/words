                    {
                        "sense_id": "1fc240f1-bb6a-3346-9d58-93fc78407067",
                        "entry_id": "874d0e28-1269-33a5-a59c-16d715c57cb6",
                        "glosses": [
                            "nieprzemakalne nakrycie stołu kuchennego, wykonane z bawełnianej flaneli pokrytej jednostronnie barwną warstwą olejną z nadrukowanym deseniem, użytkowane powszechnie w XIX-XX wieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f1ed6b-f700-4979-8860-3e79a5cb4732",
                                "sense_id": "1fc240f1-bb6a-3346-9d58-93fc78407067",
                                "text": "Po nakazie utrzymania czystości w zakładowej stołówce wszystkie stoły schludnie pokryto jednobarwnymi ceratami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "447c8554-3e82-4ff9-af09-0e65c0eb29ff",
                        "source_entry_id": "874d0e28-1269-33a5-a59c-16d715c57cb6",
                        "source_sense_id": "1fc240f1-bb6a-3346-9d58-93fc78407067",
                        "target_lang_word": "oilcloth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oilcloth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6505303-4fd3-308c-a830-17b86ac611c6",
                                        "entry_id": "9148a48f-7722-3074-b85b-f435093b9633",
                                        "glosses": [
                                            "A fabric or cloth treated on one side with a waterproof covering, especially one made from linseed oil etc.; used for flooring, tablecloths, kitchen shelves and sometimes furniture covering."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "176c2dc5-4a67-41b5-a239-d840af6edfb1",
                                                "sense_id": "b6505303-4fd3-308c-a830-17b86ac611c6",
                                                "text": "Ignatius pounded a paw into the oilcloth on the kitchen table."
                                            },
                                            {
                                                "example_id": "072629df-6b33-45d7-a1ef-775d662d33a6",
                                                "sense_id": "b6505303-4fd3-308c-a830-17b86ac611c6",
                                                "text": "When the Lincolns moved into the White House, it was not furnished, there was oilcloth on the floor in the State Rooms because of the overflow from the spittoons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a665675-ba82-41f9-a158-8f37d0da1328",
                        "source_entry_id": "874d0e28-1269-33a5-a59c-16d715c57cb6",
                        "source_sense_id": "1fc240f1-bb6a-3346-9d58-93fc78407067",
                        "target_lang_word": "oilskin",
                        "target_lang_code": "en",
