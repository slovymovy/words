                        "source_entry_id": "d27947ce-8265-33ec-b984-554f6a704427",
                        "source_sense_id": "93e624a5-48d9-388f-bc69-db5d519ac143",
                        "target_lang_word": "Monotonie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monotonie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70a12a29-bc64-37ba-81df-efbae6cbbd09",
                                        "entry_id": "59f8218e-0409-37b1-8de5-274b465def36",
                                        "glosses": [
                                            "ermüdende Einförmigkeit; langweilige, ständige Wiederholung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e4c289-9ce6-4704-8300-f1b24bbfc4d8",
                                                "sense_id": "70a12a29-bc64-37ba-81df-efbae6cbbd09",
                                                "text": "„Das Straßennetz ist von neuzeitlicher Geometrie – und auch Monotonie.“"
                                            },
                                            {
                                                "example_id": "6f3daf50-239f-41e8-a174-47f2c7b326a2",
                                                "sense_id": "70a12a29-bc64-37ba-81df-efbae6cbbd09",
                                                "text": "„Was Monotonie und Stumpfsinn anbelangt hat deutscher HipHop jedenfalls längst internationalen Standard erreicht.“"
                                            },
                                            {
                                                "example_id": "17ff7fd4-b646-4bd0-af59-2442b64a771b",
                                                "sense_id": "70a12a29-bc64-37ba-81df-efbae6cbbd09",
                                                "text": "„Die Monotonie der Straße macht schläfrig.“"
                                            },
                                            {
                                                "example_id": "6963a2f1-f0a0-47fe-b26c-ea263da48ec6",
                                                "sense_id": "70a12a29-bc64-37ba-81df-efbae6cbbd09",
                                                "text": "„Natürlich muß er die Monotonie des ganzen Abends unglaublich finden, die Tatsache, daß es ein Paar wie dieses überhaupt gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40b87c3d-fb69-3203-8e9b-5fa7780d1261",
                                        "entry_id": "59f8218e-0409-37b1-8de5-274b465def36",
                                        "glosses": [
                                            "ständiges Steigen oder Fallen von Funktionen oder Folgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de56c96b-5640-4859-8c03-ec6666e66385",
                                                "sense_id": "40b87c3d-fb69-3203-8e9b-5fa7780d1261",
                                                "text": "„Die Monotonie bezieht sich auf das Steigungsverhalten einer Funktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
