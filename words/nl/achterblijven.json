                    ],
                    "antonyms": [
                        "vertrekken",
                        "meegaan"
                    ],
                    "common_phrases": [
                        "alleen achterblijven",
                        "op het filter achterblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain in a place after others have left or after something has been removed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to stay behind",
                                "target_lang_sense_clarification": "remaining when others leave"
                            },
                            {
                                "target_lang_word": "to remain",
                                "target_lang_sense_clarification": "to be left over or stay in place"
                            },
                            {
