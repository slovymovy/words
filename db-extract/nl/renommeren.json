                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3485d47e-a178-4adb-b5cb-b10528bd24d4",
                                                "sense_id": "82018b99-1b1a-33ca-ba1c-ca101611c78a",
                                                "text": "Le bâtiment de l’hôpital de Créteil, ouvert exceptionnellement en pleine crise du coronavirus, a été renommé en hommage à une soignante d’Albert-Chenevier, décédée du Covid-19."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8f1bc89-5760-3332-a4be-d4a92e21bf98",
                                        "entry_id": "83d9a2ae-50a3-3833-a6b3-091aa4fb6d36",
                                        "glosses": [
                                            "Nommer, élire de nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb156c1-6c32-4c52-a556-754227b4727a",
                                                "sense_id": "a8f1bc89-5760-3332-a4be-d4a92e21bf98",
                                                "text": "Les électeurs l’ont renommé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                        "entry_id": "83d9a2ae-50a3-3833-a6b3-091aa4fb6d36",
                                        "glosses": [
                                            "Nommer souvent et avec éloge, entourer de renom."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e90483a-0d84-47d2-949e-9abfa4f429ca",
                                                "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                                "text": "Le prince s’est fait renommer partout."
                                            },
                                            {
                                                "example_id": "dee025a2-2e7d-43a2-afbe-44a98597c877",
                                                "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                                "text": "Ses belles actions l’ont fait renommer par toute la terre."
                                            },
                                            {
                                                "example_id": "d0cf8937-aa0d-4190-a20c-ded834959c0e",
                                                "sense_id": "352f27b7-cca9-358b-b753-124d14d66fb4",
                                                "text": "Ce héros qu’on renomme en tous lieux."
                                            }
                                        ]
                                    }
