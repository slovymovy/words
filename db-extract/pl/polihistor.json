                "senses": [
                    {
                        "sense_id": "bbb9cac3-1e63-344a-a629-8d735208486e",
                        "entry_id": "827c07a9-02ba-3885-a19b-c338bdd64271",
                        "glosses": [
                            "ktoś o wszechstronnej wiedzy z różnych dziedzin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4df3296-c7db-44d4-84f6-3561c73a9498",
                                "sense_id": "bbb9cac3-1e63-344a-a629-8d735208486e",
                                "text": "Już Leonardo da Vinci, geniusz i polihistor epoki renesansu, zauważył, że wraz z wysokością drzewa grubość gałęzi zmienia się o stały współczynnik"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d72bd87b-99d4-4079-82ca-43888e561d47",
                        "source_entry_id": "827c07a9-02ba-3885-a19b-c338bdd64271",
                        "source_sense_id": "bbb9cac3-1e63-344a-a629-8d735208486e",
                        "target_lang_word": "polyhistor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyhistor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "429bbd05-3d23-3ebc-9a46-8a3248dc6298",
                                        "entry_id": "0cc2b005-6608-3150-a621-b8c9402feae9",
                                        "glosses": [
                                            "Someone gifted or learned to a great extent or in multiple disciplines; a great scholar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72df4ed9-075d-4ada-8d3e-78c8dc75237d",
                                                "sense_id": "429bbd05-3d23-3ebc-9a46-8a3248dc6298",
                                                "text": "A hired diplomat in Edirne and to the Porte in Constantinople, a military commander in the Austro-Turkish wars, a polyhistor and a learned man."
                                            },
                                            {
                                                "example_id": "dd45f781-6ba0-4745-94fa-c7b2d9b52c2d",
                                                "sense_id": "429bbd05-3d23-3ebc-9a46-8a3248dc6298",
                                                "text": "[Carlfriedrich] Claus is an artist, though he does not like to call himself one, and a scholar. As such, he personifies the polyhistor, a species rarely found today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd77206-58a7-436a-a427-64889334ebb3",
                        "source_entry_id": "827c07a9-02ba-3885-a19b-c338bdd64271",
                        "source_sense_id": "bbb9cac3-1e63-344a-a629-8d735208486e",
