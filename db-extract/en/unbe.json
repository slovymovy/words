                        "sense_id": "aed1c7d7-a1ea-329d-8515-9d270e587307",
                        "entry_id": "832e27d7-4e87-3313-a79e-c02b17379e21",
                        "glosses": [
                            "To lack being; to be nonexistent."
                        ],
                        "tags": [
                            "intransitive",
                            "no-past",
                            "poetic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0d4e2c5e-1838-4698-95e1-b8bf57c0388e",
                                "sense_id": "aed1c7d7-a1ea-329d-8515-9d270e587307",
                                "text": "I cannot bear my fate as writ, / I'd have my life unbe; Would turn my memory to a blot, / Make every relic of me rot, / My doings be as they were not, / And what they've brought to me!"
                            },
                            {
                                "example_id": "8b42f758-c403-412e-b61f-9a861372246d",
                                "sense_id": "aed1c7d7-a1ea-329d-8515-9d270e587307",
                                "text": "There is a saying that unseen is as good as unbeen; but in this case it was otherwise—unseen, Master Malrubius was more palpably present than ever before."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d98fa01-2cb6-3b3c-9b53-96da9e1c0540",
                        "entry_id": "832e27d7-4e87-3313-a79e-c02b17379e21",
                        "glosses": [
                            "To deprive of being; to make nonexistent."
                        ],
