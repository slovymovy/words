    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95097ac1-dd5b-3387-a876-23a93d85ffce",
                    "sense_definition": "Naar boven bewegend, stijgend (zoals hemellichamen).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>opkomende</w> zon begon al erg fel te worden. ",
                            "target_lang_translations": {
                                "en": "The <w>rising</w> sun was already starting to get very bright."
                            }
                        },
                        {
                            "text": "We wandelden vroeg in de ochtend om naar de <w>opkomende</w> zon te kijken.",
                            "target_lang_translations": {
                                "en": "We walked early in the morning to watch the <w>rising</w> sun."
                            }
                        }
                    ],
                    "synonyms": [
                        "opgaand",
                        "stijgend"
                    ],
                    "antonyms": [
                        "ondergaand"
                    ],
                    "common_phrases": [
                        "de opkomende zon"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving upwards, rising (such as celestial bodies)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rising",
                                "target_lang_sense_clarification": "moving upward, like the sun or moon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "874a9c0f-c02b-3e86-9520-beb25bf6c67f",
                    "sense_definition": "Aan succes, bekendheid of invloed winnend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>opkomende</w> acteur kreeg de eerste prijs.",
                            "target_lang_translations": {
                                "en": "The <w>up-and-coming</w> actor won first prize."
                            }
                        },
                        {
                            "text": "China is een <w>opkomende</w> markt met veel nieuwe kansen.",
                            "target_lang_translations": {
                                "en": "China is an <w>emerging</w> market with many new opportunities."
                            }
                        }
                    ],
                    "synonyms": [
                        "veelbelovend",
                        "stormachtig"
                    ],
                    "antonyms": [
                        "gevestigd",
                        "neergang"
                    ],
                    "common_phrases": [
                        "een opkomende markt",
                        "een opkomend talent"
                    ],
                    "target_lang_definitions": {
                        "en": "Gaining success, fame, or influence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "emerging",
                                "target_lang_sense_clarification": "developing and gaining prominence"
                            },
                            {
                                "target_lang_word": "up-and-coming",
                                "target_lang_sense_clarification": "promising and gaining success"
                            },
                            {
                                "target_lang_word": "rising",
                                "target_lang_sense_clarification": "growing in influence or popularity"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "186ad605-f213-3864-8c13-04dd8b841732",
                    "sense_definition": "Onvoltooid deelwoord van <w>opkomen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Opkomend</w> voor de rechten van de werknemers hield zij een vurig betoog.",
                            "target_lang_translations": {
                                "en": "<w>Standing up</w> for the rights of the employees, she gave a passionate speech."
                            }
                        },
                        {
                            "text": "Hij keek naar de uit de horizon <w>opkomende</w> storm.",
                            "target_lang_translations": {
