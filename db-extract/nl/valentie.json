                                        "sense_id": "d2be5de6-b50c-3bad-9791-75b6ea876f0e",
                                        "entry_id": "475fab57-a0a1-3e46-86c7-66e7e3b71aa8",
                                        "glosses": [
                                            "Bedeutung, die etwas zugewiesen wird, dessen Wertgehalt"
