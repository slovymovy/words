                                            },
                                            {
                                                "example_id": "7d840060-f00b-4fb2-a25d-dd0b71bad873",
                                                "sense_id": "6f3c62a9-9497-3742-b2a9-38b2a9285a17",
                                                "text": "write lyrics"
                                            },
                                            {
                                                "example_id": "d8119479-d235-41ce-8877-892d13a8410a",
                                                "sense_id": "6f3c62a9-9497-3742-b2a9-38b2a9285a17",
                                                "text": "learn the lyrics"
                                            },
                                            {
                                                "example_id": "777cfc48-13b2-4e6e-a0a7-e9e3eb5133b9",
                                                "sense_id": "6f3c62a9-9497-3742-b2a9-38b2a9285a17",
                                                "text": "The song’s lyrics were full of nostalgia."
                                            },
                                            {
                                                "example_id": "a35f7e69-a9f2-4328-ad44-9272904ec73e",
                                                "sense_id": "6f3c62a9-9497-3742-b2a9-38b2a9285a17",
                                                "text": "He struggled to memorize the lyrics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "140c3142-3a62-49fa-8973-877e4dac42d1",
                        "source_entry_id": "bf2e6abe-b2a8-31e5-99b7-783372dc34db",
                        "source_sense_id": "2f98efe4-1fb9-3f08-afb6-73a1ea408a05",
                        "source_sense_description": "Text eines Liedes, vor allem bei Werken der Rock- und Pop-Literatur",
                        "target_lang_word": "songtext",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "songtext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb27dab-6252-321c-9f40-455c6af59cbf",
                                        "entry_id": "7d8c975b-d199-374b-8f6c-b137221ae011",
                                        "glosses": [
                                            "The written words to a song; lyrics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea60111-0956-454d-9c9a-4e0f0fddc76b",
                                                "sense_id": "7bb27dab-6252-321c-9f40-455c6af59cbf",
                                                "text": "The use of songtext, therefore, was important as a literary medium and as a means of recording oral traditions and events of historical ... Songtext may also be considered as an important factor in determining emotional effect of musical sound."
                                            },
                                            {
                                                "example_id": "5c5669eb-9a44-4ff0-bc1e-0efb6b15d336",
                                                "sense_id": "7bb27dab-6252-321c-9f40-455c6af59cbf",
                                                "text": "Next to this is a separate column for the songtext — which does not always give the words of the text, at the most a few catchwords, headed by the word: [...]"
                                            },
                                            {
                                                "example_id": "fa4c558f-822e-4897-ac2b-050e13b520c3",
                                                "sense_id": "7bb27dab-6252-321c-9f40-455c6af59cbf",
                                                "text": "“No doubt,” writes LèviStrauss (in his analysis which ignores the performative, social, colonial and microhistorical contexts of the song-text), “the purpose of such an alteration in the details of the myth is to elicit the corresponding organic reaction, [...]”"
                                            },
                                            {
                                                "example_id": "9be58617-d243-4a89-8407-27c86b5aa5ed",
                                                "sense_id": "7bb27dab-6252-321c-9f40-455c6af59cbf",
                                                "text": "The songtexts are in rhymed verses, and each line is repeated once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecb2e9f0-7ab3-42af-abd5-865794eb4419",
                        "source_entry_id": "bf2e6abe-b2a8-31e5-99b7-783372dc34db",
                        "source_sense_id": "2f98efe4-1fb9-3f08-afb6-73a1ea408a05",
                        "source_sense_description": "Text eines Liedes, vor allem bei Werken der Rock- und Pop-Literatur",
                        "target_lang_word": "paroles",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paroles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e57c03f9-13ef-39ec-8d6c-cc5d54755d6a",
                                        "entry_id": "89b1ec68-538e-3c2c-b8af-f5490cf4badc",
                                        "glosses": [
                                            "Mots d’un air, d’une chanson ; poème d’une cantate ; livret d’un opéra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c580149b-753e-4d4a-b86c-9cad08c2e647",
                                                "sense_id": "e57c03f9-13ef-39ec-8d6c-cc5d54755d6a",
                                                "text": "Il ne savait aucune des paroles du grand choral de Luther, mais il ouvrait toute grande sa bouche et émettait des sons vastes, graves et partiellement harmonieux…"
                                            },
                                            {
                                                "example_id": "fa2978b6-896c-4a0a-a674-0a02556e9c80",
                                                "sense_id": "e57c03f9-13ef-39ec-8d6c-cc5d54755d6a",
                                                "text": "La musique exprime les sentiments, mais elle serait bien empêchée de les définir, et, sans le commentaire des paroles, absent de la musique instrumentale, l’auditeur reste toujours dans un certain vague quant à la nature et à l’objet du sentiment dont s’est inspiré le musicien."
                                            },
                                            {
                                                "example_id": "a074262e-3ad7-4021-8c31-c0c5147785ae",
                                                "sense_id": "e57c03f9-13ef-39ec-8d6c-cc5d54755d6a",
                                                "text": "Les ivrognes, maintenant accoudés au comptoir, braillaient une chanson dont ils n’avaient retenu que quelques paroles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6760f3-c07b-3e5b-93d6-187d4d20e49e",
                                        "entry_id": "89b1ec68-538e-3c2c-b8af-f5490cf4badc",
                                        "glosses": [
                                            "Promesses vaines et vagues, par opposition à effets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331ff816-9abe-4ced-b906-5ade6276b4e3",
                                                "sense_id": "fe6760f3-c07b-3e5b-93d6-187d4d20e49e",
                                                "text": "Shaokang, […], menaçait de la renvoyer, irrité par la lenteur avec laquelle elle réagissait à ses ordres. Mais elle savait que c'étaient des paroles en l'air, destinées avant tout aux autres travailleurs du service d'hygiène, car il était de ces hommes qui dissimulent leur bonté sous des paroles dures."
                                            },
                                            {
                                                "example_id": "106b2ba6-9ec6-4d6c-a2ba-8ec364ea2c51",
                                                "sense_id": "fe6760f3-c07b-3e5b-93d6-187d4d20e49e",
                                                "text": "Je veux avoir de l’argent, je ne me contente pas de paroles."
                                            },
                                            {
                                                "example_id": "adb0d0e1-99ff-4bdc-a70c-a4bbab319d02",
                                                "sense_id": "fe6760f3-c07b-3e5b-93d6-187d4d20e49e",
                                                "text": "Pense-t-il m’amuser de paroles, avec des paroles, me payer de paroles ?"
                                            },
                                            {
                                                "example_id": "50be5d1b-236f-4536-b36b-454a251e36b3",
                                                "sense_id": "fe6760f3-c07b-3e5b-93d6-187d4d20e49e",
                                                "text": "Des paroles vagues, des paroles vaines, des paroles en l’air."
                                            },
                                            {
                                                "example_id": "5b6434cf-754c-4196-bb63-3c47ef344856",
                                                "sense_id": "fe6760f3-c07b-3e5b-93d6-187d4d20e49e",
                                                "text": "Du reste, tout cela, ce ne sont que des paroles, des paroles… Il faut agir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paroles",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b74e174f-4efe-3d38-ac8b-85c93bc897b6",
                                        "entry_id": "f224058d-6c58-3ae1-8137-72006d8258f2",
                                        "glosses": [
                                            "Pluriel de parole."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d263b55-5e8e-4bc9-b67a-4cc0d95d9358",
                                                "sense_id": "b74e174f-4efe-3d38-ac8b-85c93bc897b6",
                                                "text": "Ainsi, l’une et l’autre nous nous épiions, sous un masque de sourires et malgré des paroles affectueuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
