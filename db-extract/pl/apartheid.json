                "senses": [
                    {
                        "sense_id": "b4b0b30c-201e-30e6-8150-036239a2725f",
                        "entry_id": "a1d588ca-c773-3258-9f52-b50a2e2266c6",
                        "glosses": [
                            "ideologia głosząca konieczność osobnego rozwoju społeczności różnych ras i polityka segregacji rasowej połączona z ograniczeniem praw i dyskryminacją ludności niebiałej w RPA w latach 1948-1990"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a91640-5872-47b0-9723-cbe58ebb2fe7",
                                "sense_id": "b4b0b30c-201e-30e6-8150-036239a2725f",
                                "text": "Zwieńczeniem tego systemu segregacji – wyprzedzającego apartheid, a nawet rasowe ustawy w hitlerowskich Niemczech – było wprowadzenie przez Belgów specjalnych paszportów, zawierających informację o przynależności do Tutsi lub Hutu"
                            },
                            {
                                "example_id": "18356434-602b-4463-b079-80d0cdc9c9ff",
                                "sense_id": "b4b0b30c-201e-30e6-8150-036239a2725f",
                                "text": "Symbolem walki z apartheidem w Republice Południowej Afryki jest Nelson Mandela. Dla swej działalności zyskał on poparcie społeczności międzynarodowej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6b190a01-754e-34ce-85b5-570f886d90c5",
                        "entry_id": "a1d588ca-c773-3258-9f52-b50a2e2266c6",
                        "glosses": [
                            "(w szerszym rozumieniu) polityka segregacji rasowej połączona z dyskryminacją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3ae4c4-0a74-46b4-ad84-34e566d69410",
                                "sense_id": "6b190a01-754e-34ce-85b5-570f886d90c5",
                                "text": "Kiedy jedna grupa kontroluje drugą grupę i używa niehumanitarnych środków, by podtrzymać tę dominację, mamy do czynienia z apartheidem"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aeeee25-b720-4273-bb0d-44332dacf320",
                        "source_entry_id": "a1d588ca-c773-3258-9f52-b50a2e2266c6",
                        "source_sense_id": "b4b0b30c-201e-30e6-8150-036239a2725f",
