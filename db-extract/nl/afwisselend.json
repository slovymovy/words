                                "example_id": "d79fd066-977d-4596-825f-80b478287573",
                                "sense_id": "ea018d24-eb59-38ca-96a1-eefaf4324ed0",
                                "text": "De wedstrijden worden afwisselend in Europa en in Amerika gespeeld."
                            }
                        ]
