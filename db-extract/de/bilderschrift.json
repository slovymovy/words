                "senses": [
                    {
                        "sense_id": "ae1b7a7c-f3dc-3cef-ba6c-c0447c37f5e1",
                        "entry_id": "f9404bf7-aa19-39bf-88f9-57e671d9800e",
                        "glosses": [
                            "Schrift, in der Schriftzeichen keine abstrakten Zeichen, sondern stilisierte Bilder sind"
                        ],
                        "tags": [
                            "linguistics"
                        ],
                        "examples": [
                            {
                                "example_id": "293f4a2b-fbf1-4f0c-aaf5-9d1c753af29f",
                                "sense_id": "ae1b7a7c-f3dc-3cef-ba6c-c0447c37f5e1",
                                "text": "„Versuche dieser Art seien ganz allgemein verbreitet gewesen, die Mexikaner aber hätten eine solche Bilderschrift am weitesten entwickelt.“"
                            },
                            {
                                "example_id": "ada2a872-f164-4f73-9fb7-f1e680833ba3",
                                "sense_id": "ae1b7a7c-f3dc-3cef-ba6c-c0447c37f5e1",
                                "text": "„In der altchinesischen Bilderschrift bezeichnete ein senkrecht aufgerichteter stilisierter Penis den Begriff ›Vorfahre, Ahne‹.“"
                            },
                            {
                                "example_id": "c99603c3-d5ef-4dfd-987c-7d694974244f",
                                "sense_id": "ae1b7a7c-f3dc-3cef-ba6c-c0447c37f5e1",
                                "text": "Zum Begriff Bilderschrift: „Da dieser Ausdruck jedoch zu umfassend und daher irreführend ist, unterscheidet man heute zwischen Bilderschrift im engeren Sinne (Piktographie) und der Ideenschrift (Ideographie) als einer höheren Entwicklungsstufe der Bilderschrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
