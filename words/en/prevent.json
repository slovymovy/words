{
    "word_family": [
        "prevention",
        "preventive",
        "preventable",
        "preventative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad994f0a-05c4-3070-a8ff-1e7c290911aa",
                    "sense_definition": "To stop something from happening or to keep someone from doing something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I brush my teeth regularly to <w>prevent</w> tooth decay.",
                            "target_lang_translations": {
                                "ru": "Я регулярно чищу зубы, чтобы <w>предотвратить</w> кариес."
                            }
                        },
                        {
                            "text": "The new security measures are designed to <w>prevent</w> accidents in the workplace.",
                            "target_lang_translations": {
                                "ru": "Новые меры безопасности призваны <w>предотвращать</w> несчастные случаи на рабочем месте."
                            }
                        },
                        {
                            "text": "Heavy rain might <w>prevent</w> us from going to the park today.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь может <w>помешать</w> нам пойти в парк сегодня."
                            }
                        }
                    ],
                    "antonyms": [
                        "allow",
                        "permit",
                        "cause"
                    ],
                    "common_phrases": [
                        "prevent accidents",
                        "prevent from happening",
                        "prevent further damage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить что-либо от совершения или помешать кому-либо сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предотвращать",
                                "target_lang_sense_clarification": "не давать чему-то случиться"
                            },
                            {
                                "target_lang_word": "помешать",
                                "target_lang_sense_clarification": "создать препятствие для действия"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать помехи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67cd476e-4355-397f-9f09-e2c7a24b8c41",
                    "sense_definition": "To take proactive measures or act in a way that stops a problem before it starts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is always better to <w>prevent</w> than to cure a disease.",
                            "target_lang_translations": {
                                "ru": "Болезнь всегда лучше <w>предупредить</w>, чем лечить."
                            }
                        },
                        {
                            "text": "The doctor advised me on how to <w>prevent</w> illness during the winter months.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал мне, как <w>предотвратить</w> болезнь в зимние месяцы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "better to prevent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать упреждающие меры, чтобы остановить проблему до ее возникновения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предотвратить",
                                "target_lang_sense_clarification": "заблаговременно не допустить"
                            },
                            {
                                "target_lang_word": "предупреждать",
                                "target_lang_sense_clarification": "принимать меры заранее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5673926b-c911-310c-b675-b3e7a6a9d3cc",
                    "sense_definition": "To be beforehand with or to <w>anticipate</w> someone's actions or needs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their ready guilt was <w>preventing</w> the king's commands before they were even spoken.",
                            "target_lang_translations": {
                                "ru": "Их готовность признать вину <w>предвосхищала</w> приказы короля еще до того, как они были произнесены."
                            }
                        },
                        {
                            "text": "She sought to <w>prevent</w> his every wish by acting before he could ask.",
                            "target_lang_translations": {
                                "ru": "Она стремилась <w>опережать</w> каждое его желание, действуя прежде, чем он успевал попросить."
                            }
                        }
                    ],
                    "synonyms": [
                        "anticipate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean anticipate"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать на опережение или предвосхищать чьи-либо действия или нужды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвосхищать",
                                "target_lang_sense_clarification": "архаичное: делать что-то заранее"
                            },
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "действовать раньше другого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffc06fca-a367-3426-bd33-30ff19fefbc3",
                    "sense_definition": "To come before in time or order; to precede.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "precedence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We pray that thy grace may always <w>prevent</w> and follow us throughout our lives.",
                            "target_lang_translations": {
                                "ru": "Мы молимся, чтобы твоя благодать всегда <w>предшествовала</w> нам и сопутствовала нам на протяжении всей нашей жизни."
                            }
                        },
                        {
                            "text": "In the old text, the herald was said to <w>prevent</w> the arrival of the queen.",
                            "target_lang_translations": {
                                "ru": "В старинном тексте говорилось, что глашатай <w>предшествовал</w> прибытию королевы."
                            }
                        }
                    ],
                    "antonyms": [
                        "follow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage meaning to go before"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предшествовать во времени или порядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предшествовать",
                                "target_lang_sense_clarification": "идти перед чем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76e598ca-7aab-379c-bc70-52689974ae9a",
                    "sense_definition": "To outdo or surpass in speed or excellence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surpass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight rode with such force, <w>preventing</w> the very speed of a flying arrow.",
                            "target_lang_translations": {
                                "ru": "Рыцарь скакал с такой силой, <w>превосходя</w> саму скорость летящей стрелы."
                            }
                        },
                        {
                            "text": "His skill in battle would <w>prevent</w> all others who challenged him.",
                            "target_lang_translations": {
                                "ru": "Его мастерство в бою <w>превосходило</w> всех остальных, кто бросал ему вызов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превосходить в скорости или мастерстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превосходить",
                                "target_lang_sense_clarification": "быть лучше или быстрее"
                            },
                            {
                                "target_lang_word": "опережать",
                                "target_lang_sense_clarification": "быть впереди по качеству"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}