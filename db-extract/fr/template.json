                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A physical object whose shape is used as a guide to make other objects."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b2d85b5-8ca1-3120-967c-197881528a86",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A generic model or pattern from which other objects are based or derived."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c47f05e-2c7e-46c6-8e4b-7726f743c3e9",
                                                "sense_id": "9b2d85b5-8ca1-3120-967c-197881528a86",
                                                "text": "Gaelic also benefits from having a readily available template for Celtic minority language revitalisation, derived from Welsh and Irish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfc131d1-95bb-3184-84db-98b397f4868a",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A file or document serving as a basis for others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e71bb042-1d85-384e-aaa3-baa456c7f369",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A macromolecule which provides a pattern for the synthesis of another molecule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec6e40f-2fa8-438b-991a-87bc991790de",
                                                "sense_id": "e71bb042-1d85-384e-aaa3-baa456c7f369",
                                                "text": "Classically, the functional product of coding genes is a protein whose synthesis is directed by an mRNA-template."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69722fc8-0a73-33d8-9daf-e5ba30b9bd7a",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A partially defined class or function, that can be instantiated in a variety of ways depending on the instantiation arguments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74c1b2c8-df78-3db0-a5f6-513a16f45acd",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "A strip of metal used in boiler-making, pierced with a series of holes, and serving as a guide in marking out a line of rivet-holes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a10d2e3f-0704-327a-9d17-cdce0609613d",
                                        "entry_id": "1471d542-394a-39f1-b987-33ed3105e089",
                                        "glosses": [
                                            "Synonym of temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8e013bd-920e-42ed-aad5-42107c183541",
                                                "sense_id": "a10d2e3f-0704-327a-9d17-cdce0609613d",
                                                "text": "The template length is adjusted to the proper fabric width. Then the sharp pins in the template ends are hooked into the selvedge edges (with the template open)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
