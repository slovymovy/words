                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moulin à café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                        "entry_id": "b26dc8fc-b753-3fc6-b40c-9e28ccd9bbf6",
                                        "glosses": [
                                            "Objet destiné à broyer les grains de café en conservant au maximum ses arômes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453a39ad-e057-43f9-b53d-3594f78abac1",
                                                "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                                "text": "- Mieux : tu aurais fait un bon moulin à café.\n- Ah ?\n- Puisque tu n’arrêtes pas de broyer du noir."
                                            },
                                            {
                                                "example_id": "5c4bc338-3a2b-44b6-b595-7522f3c4deb7",
                                                "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                                "text": "Il est également intéressant d’observer les réajustements de la structure des grains dans le réservoir d’un moulin à café manuel lorsqu’on actionne celui-ci …"
                                            },
                                            {
                                                "example_id": "59b5c036-cfe0-4a3e-b594-1fe82e3ff441",
                                                "sense_id": "f1559c30-8ab1-3345-bc3c-ed545780b015",
                                                "text": "L’utilisation de l’acier permet l’avènement d’une vraie industrie du moulin à café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efefd995-804a-32a0-a9bc-f82ce46d66c7",
                                        "entry_id": "b26dc8fc-b753-3fc6-b40c-9e28ccd9bbf6",
                                        "glosses": [
                                            "Mitrailleuse."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843a545e-5d2b-4a2b-9d65-6dec670451c8",
                                                "sense_id": "efefd995-804a-32a0-a9bc-f82ce46d66c7",
                                                "text": "La mitrailleuse y est assimilée, à cause de son tric-trac, à une machine à découdre ou à un moulin à café : « Entends-tu ces pieds-là, avec leur sale moulin à café ? » René X, Parisiens à la guerre. — « Avant d’avoir fait cent mètres, nous serons fauchés par les moulins à café comme des tiges de pavot », Galopin, Les Poilus, p. 4"
                                            }
                                        ]
                                    }
                                ]
                            }
