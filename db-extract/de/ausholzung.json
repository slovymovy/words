                "senses": [
                    {
                        "sense_id": "3c35def5-8890-3d44-93d2-fb1c3a980999",
                        "entry_id": "f0aa9844-87a8-3cf1-8b0b-c6dbbc54f13d",
                        "glosses": [
                            "das Entfernen aller Bäume in einem Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b58dad-6075-4e81-b74d-ba4b4b805674",
                                "sense_id": "3c35def5-8890-3d44-93d2-fb1c3a980999",
                                "text": "„Die Maschinen in der Fabrik liefen wieder, fast ein Drittel der Anbaufläche konnte bereits bewirtschaftet werden, und die Rodungstrupps machten beachtliche Fortschritte bei der Ausholzung alter Bäume und im Kampf gegen das Lalang-Gras.“"
                            },
                            {
                                "example_id": "a5e8f329-3b40-4067-9d67-2655f5334f97",
                                "sense_id": "3c35def5-8890-3d44-93d2-fb1c3a980999",
                                "text": "„In geschichtlicher Zeit hat die Lärche auch in der Provinz Sondrio eine mengenmäßige Verminderung erfahren, hauptsächlich infolge des Bestrebens, durch die Ausholzung freie Weideflächen zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
