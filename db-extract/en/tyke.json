                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a9c9ead4-c516-3115-80a0-c2de248b852a",
                        "entry_id": "3e53d661-e832-3ca4-9064-8ac04837c95a",
                        "glosses": [
                            "A small child, especially a cheeky or mischievous one.",
                            "Designating an initiation level of sports competition for young children."
                        ],
                        "tags": [
                            "Canada",
                            "colloquial"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cb7bba0c-2aef-3749-94a8-f653acee49f6",
                        "entry_id": "3e53d661-e832-3ca4-9064-8ac04837c95a",
                        "glosses": [
                            "An uncultured, crude and unrefined or uncouth ill-bred person."
                        ],
                        "tags": [
                            "British",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "419d8907-2132-4877-880c-19a44092d08b",
                                "sense_id": "cb7bba0c-2aef-3749-94a8-f653acee49f6",
                                "text": "Why, the inquiry thing, the yellow-dog thing—you wouldn’t think a mangy, native tyke would be allowed to trip up people in the verandah of a magistrate’s court, would you?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b00cc0e0-1be3-3bfc-b6f3-f046f624738a",
                        "entry_id": "3e53d661-e832-3ca4-9064-8ac04837c95a",
                        "glosses": [
                            "A person from Yorkshire; a Yorkshireman or Yorkshirewoman."
                        ],
