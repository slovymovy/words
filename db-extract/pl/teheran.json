                    },
                    {
                        "translation_id": "cf62fd08-460c-4eea-918c-453426e273f2",
                        "source_entry_id": "77ed2797-4c4d-3627-9b87-ab847b4da006",
                        "source_sense_id": "5d6b2c98-771e-36f1-adbd-5568815e7ce5",
                        "target_lang_word": "Teheran",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teheran",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463d89b8-dbcb-3150-8e34-6d551e64e59d",
                                        "entry_id": "8736e70e-92a5-370e-a168-77251d571499",
                                        "glosses": [
                                            "Dated spelling of Tehran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefa14b2-8917-4a9f-8ace-80369efddd5a",
                                                "sense_id": "463d89b8-dbcb-3150-8e34-6d551e64e59d",
                                                "text": "This one stark fact stands out: Every agreement the Soviets entered into at Teheran in 1943 and Yalta in 1945, was ruthlessly broken, save for those palpably to their advantage. The same holds true for the Potsdam Conference of 1945."
                                            },
                                            {
                                                "example_id": "5d540c04-a645-4adf-9d89-5a0f2be47516",
                                                "sense_id": "463d89b8-dbcb-3150-8e34-6d551e64e59d",
                                                "text": "No tears need be shed for next year’s games at Teheran. Even if we should remain in the AGF, the Iranians would find ways to keep us out of competition, just as the Indonesians did at Jakarta in 1962."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce1502f1-2197-4fad-9679-2e32e42d94e1",
                        "source_entry_id": "77ed2797-4c4d-3627-9b87-ab847b4da006",
                        "source_sense_id": "5d6b2c98-771e-36f1-adbd-5568815e7ce5",
                        "target_lang_word": "Teherán",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teherán",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "17a4911b-6ea9-32b6-b02e-5c46d04934ea",
                                        "entry_id": "5049741e-babb-3173-b231-79e2399e351e",
                                        "glosses": [
                                            "hlavní město Íránu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42f1c7f-e423-4c94-bd26-5755d0004cf2",
                                                "sense_id": "17a4911b-6ea9-32b6-b02e-5c46d04934ea",
                                                "text": "Při konferencích tří státníků v Teheránu a na Jaltě se Stalin zavázal, že pošle své armády proti Japonsku, jakmile bude poražena německá armáda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7d45558-dac8-3bfa-baa5-04f74aba0e56",
                                        "entry_id": "5049741e-babb-3173-b231-79e2399e351e",
                                        "glosses": [
                                            "političtí zástupci Íránu"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cde2342-c6d7-46a7-b166-9194f3853322",
                                                "sense_id": "b7d45558-dac8-3bfa-baa5-04f74aba0e56",
                                                "text": "Írán má z blízkovýchodních zemí nejvíc nakažených i úmrtí. Teherán ve čtvrtek hlásil 10 075 nemocných, v pátek uvádí 11 364."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4940c327-6831-4aa3-ae63-ebf3e5051caa",
                        "source_entry_id": "77ed2797-4c4d-3627-9b87-ab847b4da006",
                        "source_sense_id": "5d6b2c98-771e-36f1-adbd-5568815e7ce5",
                        "target_lang_word": "Téhéran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Téhéran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e375b0a2-2e1d-336b-9173-ebbf068e30d3",
                                        "entry_id": "df80a59d-5d95-3f38-9b44-665bc230f307",
                                        "glosses": [
                                            "Capitale de l’Iran."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efca8fe2-fb36-4532-b2e5-5e63e3941f15",
                                                "sense_id": "e375b0a2-2e1d-336b-9173-ebbf068e30d3",
                                                "text": "— Trop neuve, Téhéran, trop peu d’histoire ! Longtemps elle n’a été qu’une obscure dépendance de Rayy, la prestigieuse cité des savants démolie au temps des Mongols. Ce n’est qu’à la fin du XVIIIᵉ siècle qu’une tribu turkmène, celle des Kadjars, a pris possession de cette localité. Ayant réussi à soumettre par le glaive l’ensemble de la Perse, la dynastie a élevé son modeste repaire au rang de capitale."
                                            },
                                            {
                                                "example_id": "e8062015-6df1-49da-8466-5b2fe6f8783c",
                                                "sense_id": "e375b0a2-2e1d-336b-9173-ebbf068e30d3",
                                                "text": "Plusieurs centaines d'Iraniens ont célébré hier dans les rues de Téhéran l'accord cadre sur le programme nucléaire de l'Iran conclu quelques heures plus tôt à Lausanne, en Suisse."
                                            },
                                            {
                                                "example_id": "e9aa83f5-d4d5-4b6b-bcd8-e7caa37a5f80",
                                                "sense_id": "e375b0a2-2e1d-336b-9173-ebbf068e30d3",
                                                "text": "Ne tourne pas de l’œil, je t’en prie, ça irait très bien avec ton déshabillé vert nil et cette grâce désuète qui m’a fait oublier toutes les autres le jour béni où je t’ai trouvée dans un… Seigneur ! dans un aéroport, à Téhéran, au temps du Shah-in-Shah, au temps où tu étais aussi fauchée que moi, au temps où tu portais des bluejeans et les chemises de soie indiennes déchirées des flower children, le jour béni où tu avais perdu ton passeport et où nous avons rampé sous tous les sièges de l’aéroport pour le trouver, ce qui fut fait, donc ne tourne pas de l’œil, quant à la grâce désuète et tes yeux d’une largeur anormale, il s’est trouvé un Roberto dei Rossi pour s’en enticher et te transformer en petite marquise de plus en plus jolie, de plus en plus désuète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7503e768-7177-3c18-b859-3136ad3912af",
                                        "entry_id": "df80a59d-5d95-3f38-9b44-665bc230f307",
                                        "glosses": [
                                            "Siège du pouvoir iranien ; gouvernement iranien."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6256bcda-a0fc-4aac-8987-c947b45ea552",
                                                "sense_id": "7503e768-7177-3c18-b859-3136ad3912af",
                                                "text": "Téhéran, en particulier, avec qui Washington espère sceller un accord historique sur son programme nucléaire, est violemment critiqué pour ses « graves restrictions » sur les libertés individuelles."
                                            },
                                            {
                                                "example_id": "68e6fc92-e7ed-4cf0-92db-703a8af09050",
                                                "sense_id": "7503e768-7177-3c18-b859-3136ad3912af",
                                                "text": "Washington débordé par l’affrontement entre Riyad et Téhéran"
                                            },
                                            {
                                                "example_id": "ed910609-9e99-4ace-8a87-4314bac299e2",
                                                "sense_id": "7503e768-7177-3c18-b859-3136ad3912af",
                                                "text": "Erdogan en profite pour jeter l’ancre sur la Tripolitaine, au grand dam des Émirats qui sont un élément majeur de l'alliance de fait construite pour contrer le régime de Téhéran, mais aussi et peut-être surtout pour contenir l'islamisme politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23278751-6093-46b7-b323-b746a2023aa9",
                        "source_entry_id": "77ed2797-4c4d-3627-9b87-ab847b4da006",
