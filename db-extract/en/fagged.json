                            {
                                "example_id": "118f4f01-5ed2-42a8-88bb-f0a896f5cfcc",
                                "sense_id": "4731a2cd-f5d7-3340-9711-2af22e8b0c8f",
                                "text": "O why are we so haggard at the heart, so care-coiled, care-killed, so fagged, so fashed, so cogged, so cumbered."
                            },
                            {
                                "example_id": "09266f9b-78e3-4bdf-bb18-6a4c71cad903",
                                "sense_id": "4731a2cd-f5d7-3340-9711-2af22e8b0c8f",
                                "text": "But you look very fagged tonight ."
                            },
                            {
                                "example_id": "295c0156-57af-44ae-bab5-53245f9400cb",
                                "sense_id": "4731a2cd-f5d7-3340-9711-2af22e8b0c8f",
                                "text": "We were both very fagged by now, and we quarrelled incessantly during the whole of that day."
                            }
                        ]
                    }
