                "senses": [
                    {
                        "sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                        "entry_id": "0d6240bd-d895-3efc-bac8-0279df9eba8f",
                        "glosses": [
                            "imię męskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65390f3c-c2b1-4b07-905a-7bd1735e9311",
                                "sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                                "text": "Ryszard co roku był świętym mikołajem na szkolnej zabawie mikołajkowej."
                            },
                            {
                                "example_id": "8efb7e6c-daf8-4b1f-a8b0-13e70b72bf2c",
                                "sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                                "text": "Ryszardzie, ależ z ciebie ranny ptaszek, ale czy śniadanko przygotowałeś?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25d7bf14-d044-4458-b8ec-7f7b1547a930",
                        "source_entry_id": "0d6240bd-d895-3efc-bac8-0279df9eba8f",
                        "source_sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                        "target_lang_word": "Richard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Richard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf3ff0cb-432e-3d24-b020-6a778376d2fb",
                                        "entry_id": "37258d5f-bf37-3acf-a29f-5ef4c1182495",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d4f46b-3624-4223-a340-52d04ef8102b",
                                                "sense_id": "cf3ff0cb-432e-3d24-b020-6a778376d2fb",
                                                "text": "What! do I fear myself? there's no one else by; / Richard loves Richard; that is, I am I."
                                            },
                                            {
                                                "example_id": "4ed62c4d-bc97-4991-b2c1-2a263b844ee4",
                                                "sense_id": "cf3ff0cb-432e-3d24-b020-6a778376d2fb",
                                                "text": "But we have known Williams and Richards, names not found in sacred story, but familiar to our country, prove as gracious saints as any Safe deliverance, Fight the good fight of faith, or such like,"
                                            },
                                            {
                                                "example_id": "28355a56-c0f0-4ef8-b1a7-dd555c7464d6",
                                                "sense_id": "cf3ff0cb-432e-3d24-b020-6a778376d2fb",
                                                "text": "I'd love to live in our castle. First I'd change my name from Dickie to Richard. That's my real name and it's a good king name. I don't like being called Dickie anyway, and I don't want to be Dick Junior either because everybody starts calling you Junior. What I'd like to be called is Rich but I don't know how to start people doing it."
                                            },
                                            {
                                                "example_id": "19a65ef3-3dd6-4a67-839c-7397ca48a829",
                                                "sense_id": "cf3ff0cb-432e-3d24-b020-6a778376d2fb",
                                                "text": "While the less-than-a-word improvement was statistically significant, it would be hard to tell if such a small change would improve a person’s life, said Alzheimer’s disease researcher Dr. Richard Isaacson, a preventive neurologist at the Institute for Neurodegenerative Diseases of Florida."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5767c069-41bd-31b8-8ae0-64983ca2ba5d",
                                        "entry_id": "37258d5f-bf37-3acf-a29f-5ef4c1182495",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b4b9083-e402-45f8-8fca-2b6d31ae2f8b",
                                                "sense_id": "5767c069-41bd-31b8-8ae0-64983ca2ba5d",
                                                "text": "Martin Richard was the youngest of three people killed by explosions at the Boston Marathon in 2013."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "958b8819-2e06-4b24-ac70-3b61da613737",
                        "source_entry_id": "0d6240bd-d895-3efc-bac8-0279df9eba8f",
                        "source_sense_id": "f0d4956d-1680-3c4d-86ff-e5b0b13fbf50",
                        "target_lang_word": "Richard",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Richard",
