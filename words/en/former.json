                                "target_lang_word": "шабло́н",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "лека́ло",
                                "target_lang_sense_clarification": "инструмент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kalıp",
                                "target_lang_sense_clarification": "biçim verme aracı"
                            },
                            {
                                "target_lang_word": "şablon",
                                "target_lang_sense_clarification": "rehber nesne"
                            }
                        ],
                        "zh": [
