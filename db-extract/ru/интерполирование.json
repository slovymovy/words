                                    {
                                        "sense_id": "96602214-46c3-368a-a24d-b74e41dc8d37",
                                        "entry_id": "78d22bff-cfa2-30a0-8eb9-c71d20d24df8",
                                        "glosses": [
                                            "Action d’interpoler ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef8dedc-e18c-41ff-8272-6d2fb5b7dba5",
                                                "sense_id": "96602214-46c3-368a-a24d-b74e41dc8d37",
                                                "text": "Du reste, les variantes et les interpolations sont fréquentes dans ces chansons ; chaque province possédait une version différente."
                                            },
                                            {
                                                "example_id": "5d2e1866-7048-47f4-bcb2-1cc7f82ddee3",
                                                "sense_id": "96602214-46c3-368a-a24d-b74e41dc8d37",
                                                "text": "Le texte que j’ai suivi n’est pas de la main du diacre Georges. Je ne sais s’il est complet. Je prévois qu’on signalera des lacunes et des interpolations."
                                            },
                                            {
                                                "example_id": "67b40e89-12f8-4967-8b91-d6065805f6ba",
                                                "sense_id": "96602214-46c3-368a-a24d-b74e41dc8d37",
                                                "text": "L’interpolation de ce passage est évidente."
                                            },
                                            {
                                                "example_id": "3e1be7ea-4505-4fb9-b0fb-dc36944fc9a7",
                                                "sense_id": "96602214-46c3-368a-a24d-b74e41dc8d37",
                                                "text": "Ce passage est une interpolation faite par le copiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e6fe2a-13c4-3848-83a9-dd2fb410cd61",
