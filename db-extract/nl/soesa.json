        "nl-extract.jsonl": [
            {
                "entry_id": "09473ea0-0aae-3b88-aa2e-385c1902bafa",
                "word": "soesa",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "53b9e7ca-f588-3a6d-8d2c-f8d9335e01cc",
                        "entry_id": "09473ea0-0aae-3b88-aa2e-385c1902bafa",
                        "glosses": [
                            "gebeurtenissen of bezigheden die meer aandacht vereisen dan wenselijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94722bbe-dab3-4ae5-ae8b-42d54c1fe4c7",
                                "sense_id": "53b9e7ca-f588-3a6d-8d2c-f8d9335e01cc",
                                "text": "Ach, wat een soesa... Ik heb nooit zooveel soesa gekend, Oerip..."
                            },
                            {
                                "example_id": "e69bb13a-9e88-4b2e-a95b-3e1165f42efd",
                                "sense_id": "53b9e7ca-f588-3a6d-8d2c-f8d9335e01cc",
                                "text": "Door de soesa die de media over stormen en stormschade maken zouden jonge Nederlanders kunnen gaan geloven dat we in een tijd van ongekend windgeweld leven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "017eb838-0f50-4f29-9fe6-c94567d15155",
                        "source_entry_id": "09473ea0-0aae-3b88-aa2e-385c1902bafa",
                        "source_sense_id": "53b9e7ca-f588-3a6d-8d2c-f8d9335e01cc",
                        "source_sense_description": "gebeurtenissen of bezigheden die meer aandacht vereisen dan wenselijk is",
                        "target_lang_word": "Ärger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ärger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                        "entry_id": "c24af514-0f38-3189-a9d1-1c48c4fe28b9",
                                        "glosses": [
                                            "spontane, innere, emotionale Reaktion hochgradiger Unzufriedenheit auf eine Situation, eine Person oder eine Erinnerung, die der Verärgerte lieber anders gesehen hätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60bb48d2-89f5-4a8d-8741-563238262c22",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "Als ihm der Zug vor der Nase wegfuhr, spürte er den Ärger in sich aufsteigen."
                                            },
                                            {
                                                "example_id": "d4041843-c3f8-49a8-9919-2a13d08bd7b5",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Häufig suchen auch die Anwälte reicher Anleger seinen Rat, wenn sie Ärger mit der Steuer befürchten.“"
                                            },
                                            {
                                                "example_id": "fb74a6c2-c726-41dd-bb51-ff5002670427",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Das Verlangen nach Anerkennung durch Mitschüler kann manchmal geradezu suchtartige Formen annehmen und manche Schüler nehmen dafür erheblichen Ärger mit dem Lehrer in Kauf.“"
                                            },
                                            {
                                                "example_id": "1cd7024e-4c0b-4076-a599-e2b57eef1e29",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Ohne etwas zu entgegnen, schluckte Herbstaster ihren Ärger hinunter.“"
                                            },
                                            {
                                                "example_id": "425effd1-1b3c-404b-a6a8-e09318249230",
                                                "sense_id": "6807cc39-11b5-3405-b0e9-8d0a854474e9",
                                                "text": "„Der Pfarrer lächelte von Zeit zu Zeit, seine Nichte konnte jedoch ihren Ärger nicht verwinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2379616b-6e4a-3e3a-bd50-06e0aa886cf6",
                                        "entry_id": "c24af514-0f38-3189-a9d1-1c48c4fe28b9",
                                        "glosses": [
                                            "ein ärgerliches Erlebnis"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cbc6184-883d-4b9b-9de2-e9ac205bdd74",
                                                "sense_id": "2379616b-6e4a-3e3a-bd50-06e0aa886cf6",
                                                "text": "Hoffentlich machen die Hooligans heute keinen Ärger."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e61f290-8353-4c82-afbc-984a48d8f7bd",
                        "source_entry_id": "09473ea0-0aae-3b88-aa2e-385c1902bafa",
                        "source_sense_id": "53b9e7ca-f588-3a6d-8d2c-f8d9335e01cc",
                        "source_sense_description": "gebeurtenissen of bezigheden die meer aandacht vereisen dan wenselijk is",
                        "target_lang_word": "Theater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d45e413c-14bb-3ded-a113-599343a2e6aa",
                                        "entry_id": "fde07223-6049-3544-9af4-0cd499838b30",
                                        "glosses": [
                                            "eine Schauspielstätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b8b3aa8-b464-4bfa-bddd-be645297f70f",
                                                "sense_id": "d45e413c-14bb-3ded-a113-599343a2e6aa",
                                                "text": "Das Theater wird renoviert."
                                            },
                                            {
                                                "example_id": "e897ae27-30ca-4d9a-b9be-4299619dc887",
                                                "sense_id": "d45e413c-14bb-3ded-a113-599343a2e6aa",
                                                "text": "„Jeden Tag sitze ich in der kleinen Konditorei gegenüber dem Theater und warte auf sie.“"
                                            },
                                            {
                                                "example_id": "7a0d1751-313f-4165-b974-b3704618d3ce",
                                                "sense_id": "d45e413c-14bb-3ded-a113-599343a2e6aa",
                                                "text": "„Das Theater war kein großes Theater mit einer riesigen Bühne, sondern ein kleines Theater .“"
                                            },
                                            {
                                                "example_id": "c010167b-26ba-48dc-a9c6-7d4ee63ef4d0",
                                                "sense_id": "d45e413c-14bb-3ded-a113-599343a2e6aa",
                                                "text": "„Während seines ersten Aufenthaltes in Berlin geht Hoffmann oft ins Theater; eine faszinierende neue Welt erschließt sich ihm.“"
                                            },
                                            {
                                                "example_id": "d5faf891-1546-4c4a-ac26-d1d1774e2cae",
                                                "sense_id": "d45e413c-14bb-3ded-a113-599343a2e6aa",
                                                "text": "„Im Theater waren alle Plätze besetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d08f3238-cf87-32d9-b6f3-e1bbe74c3d2b",
                                        "entry_id": "fde07223-6049-3544-9af4-0cd499838b30",
                                        "glosses": [
                                            "ein aufgeführtes Stück, Schauspiel, Spektakel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a4f42aa-a4bd-41c0-81e4-3934f1487b5d",
                                                "sense_id": "d08f3238-cf87-32d9-b6f3-e1bbe74c3d2b",
                                                "text": "„Sie besuchte zum erstem Mal ein Kino, ein Museum, ging ins Theater und in die Oper.“"
                                            },
                                            {
                                                "example_id": "7e589217-bb3d-4b86-a2b4-e802416e0ad0",
                                                "sense_id": "d08f3238-cf87-32d9-b6f3-e1bbe74c3d2b",
                                                "text": "Wir haben uns fürs Theater mal richtig schick angezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "39384b4c-d7e4-304f-8d98-8911be70236b",
                                        "entry_id": "fde07223-6049-3544-9af4-0cd499838b30",
                                        "glosses": [
                                            "eine Kunstform, gekennzeichnet durch szenische Darstellung inneren und äußeren Geschehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7ba6d9b-a2e2-4eac-83ee-fae565df2edc",
                                                "sense_id": "39384b4c-d7e4-304f-8d98-8911be70236b",
                                                "text": "Wir haben großes Theater erlebt."
                                            },
                                            {
                                                "example_id": "f5ef37f4-ddfd-4243-827a-835447b1ca84",
                                                "sense_id": "39384b4c-d7e4-304f-8d98-8911be70236b",
                                                "text": "„Viele der beeindruckendsten Metaphern Schopenhauers (und, ehrlich gesagt, der gesamten Literaturgeschichte), sind der Welt des Theaters entliehen.“"
                                            },
                                            {
                                                "example_id": "3d8ac008-6378-4adf-8fee-965036c3a6ed",
                                                "sense_id": "39384b4c-d7e4-304f-8d98-8911be70236b",
                                                "text": "„Sie alle betrachten ihren Versuch, das Theater in Deutschland zu einer Propagandainstitution zu machen, als Fehlschlag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "252d0722-d042-333c-a7e1-5242e17f1912",
                                        "entry_id": "fde07223-6049-3544-9af4-0cd499838b30",
                                        "glosses": [
                                            "eine Gruppe von Künstlern, die Theater spielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841f5b88-9445-4aff-b4e7-c98aca20024f",
                                                "sense_id": "252d0722-d042-333c-a7e1-5242e17f1912",
                                                "text": "Das Theater geht nächstes Jahr auf Tournee nach Japan."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6ace6f01-073c-3eae-b538-752b23602250",
                                        "entry_id": "fde07223-6049-3544-9af4-0cd499838b30",
                                        "glosses": [
                                            "Aufruhr, Getue, Ruhestörung, Skandal, Spektakel, Tumult"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd58282-14f3-4053-92f6-b975109d868a",
                                                "sense_id": "6ace6f01-073c-3eae-b538-752b23602250",
                                                "text": "Mach nicht immer so ein Theater."
                                            },
                                            {
                                                "example_id": "1b95fb20-318f-4871-a63c-907de1e160f1",
                                                "sense_id": "6ace6f01-073c-3eae-b538-752b23602250",
                                                "text": "Dieses ganze Theater hier geht mir auf den Geist."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "598e6350-127a-4900-95e1-8bb3efdaefe8",
