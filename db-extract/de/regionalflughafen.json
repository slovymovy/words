                                "example_id": "b7b51987-efb2-4d15-9e02-4191b4012349",
                                "sense_id": "afb89d34-19a7-3cf1-b72f-dfb5ff5b8028",
                                "text": "„Finden Sie einen kleinen Regionalflughafen in der Nähe, gehen Sie dort runter und lassen Sie die Jungs hinten raus.“"
                            }
