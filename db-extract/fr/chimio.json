                "translations": [
                    {
                        "translation_id": "a0ffea5e-8b26-4ef5-bee5-1f2db71e0e80",
                        "source_entry_id": "56dcae68-93e3-301b-a844-6735db8fa521",
                        "source_sense_id": "a6bd9553-aa35-3741-8eef-93c057d7f544",
                        "source_sense_description": "umgangssprachlich, Medizin: Chemo, Chemotherapie",
                        "target_lang_word": "Chemo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "00daf2bf-a1bd-4431-97e3-4d82bf1be464",
                        "source_entry_id": "56dcae68-93e3-301b-a844-6735db8fa521",
                        "source_sense_id": "a6bd9553-aa35-3741-8eef-93c057d7f544",
                        "source_sense_description": "umgangssprachlich, Medizin: Chemo, Chemotherapie",
                        "target_lang_word": "Chemotherapie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chemotherapie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                        "entry_id": "857e4010-e7f0-3c26-b5c9-34eb559d36ab",
                                        "glosses": [
                                            "Behandlung von Krebs mit Medikamenten"
                                        ],
                                        "tags": [
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0442c2e-e142-465d-8c67-5f52194e63a5",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "Von der aufzehrenden Chemotherapie gezeichnet, wenden sich alle seine früheren „Freunde“ von ihm ab."
                                            },
                                            {
                                                "example_id": "72d67791-dfdc-43a3-b74c-65b70c99b0b3",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Ihre Chemotherapie hatte Anfang November begonnen, und bald darauf hatte sie alle Haare verloren.“"
                                            },
                                            {
                                                "example_id": "1fd7ba94-e7fc-4a26-a630-8089d205e0fa",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Bevor der Arzt dem Patienten die gentherapeutisch veränderten Blutstammzellen verabreicht, muss er dessen defektes Knochenmark mit einer Chemotherapie zerstören.“"
                                            },
                                            {
                                                "example_id": "a6d2bea2-1623-438a-9a51-383475ccc752",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Die Initiatoren der Studie kommen klar und unmissverständlich zu dem Schluss, dass die Behandlungsergebnisse deutlich besser sind, wenn man nach der chirurgischen Entfernung der Geschwulst eine Chemotherapie anstelle der bisher üblichen Strahlentherapie durchführt.“"
                                            },
                                            {
                                                "example_id": "4d9ea4df-48b9-45fa-aa2a-c87fbb21630c",
                                                "sense_id": "6f5f5e84-dc09-3c67-94cb-de78f45bb4ae",
                                                "text": "„Vielleicht war es Jean ähnlich ergangen, und vielleicht hatte er sich ähnlich verraten gefühlt, dass sie einfach gestorben war und uns nicht einmal die Zeit zum Abschied gegeben hatte, als sie die Chemotherapie verweigerte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
