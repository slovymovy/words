                                ]
                            },
                            {
                                "target_word": "perche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5212b9c9-c979-3542-ab54-1be214a4d546",
                                        "entry_id": "c8c838a2-b236-3c70-9cd9-4d8b6578994f",
                                        "glosses": [
                                            "Poisson de la famille des percidés, de nom scientifique Perca fluviatilis, aussi appelée perche commune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0213cb5-b720-4bee-bf52-b7ad40a1c1c2",
                                                "sense_id": "5212b9c9-c979-3542-ab54-1be214a4d546",
                                                "text": "Leguay tournait autour de Waldeck immobile, sa cigarette au coin du bec, sans que Waldeck eût l’air d’y faire plus attention qu’un brochet à une vieille perche trop coriace."
                                            },
                                            {
                                                "example_id": "769ef98c-c6ac-4cec-ac82-75c7d6af9e7a",
                                                "sense_id": "5212b9c9-c979-3542-ab54-1be214a4d546",
                                                "text": "Parfois, en scrutant davantage le fond de l’eau, Anne apercevait le dos vert sombre d’une perche, rayé de noir comme le dos d’un tigre."
                                            },
                                            {
                                                "example_id": "f1dcac9e-1012-448b-a71c-c39a58be54c7",
                                                "sense_id": "5212b9c9-c979-3542-ab54-1be214a4d546",
                                                "text": "Pour l'anguille, il se contentait de déposer aux endroits convenables de petits fagots de serments ; mais sa plus grande joie était de prendre à la main les perches et chevesnes, à certains moments de l'année."
                                            },
                                            {
                                                "example_id": "d3f17a34-00c5-4f48-84f4-8d1a740e892a",
                                                "sense_id": "5212b9c9-c979-3542-ab54-1be214a4d546",
                                                "text": "Entre deux eaux, dans les couches baignées de soleil, leurs nageoires rouges ouvertes et bien tendues sur leur piquants, des Perches passaient comme des jonques chinoises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a58b8b1c-7e03-3c7b-841a-3193bcb8d99f",
                                        "entry_id": "c8c838a2-b236-3c70-9cd9-4d8b6578994f",
                                        "glosses": [
                                            "Autre poisson osseux ressemblant à cette perche commune."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "perche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                        "entry_id": "aaf6f2d9-8ee7-3039-a35e-85c301905dd4",
                                        "glosses": [
                                            "Longue pièce de bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2461fd1e-65df-4468-a01c-a4915fdcd46d",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "Tendez à un homme qui se noie une perche grosse comme une canne, il y voit une route royale de première classe."
                                            },
                                            {
                                                "example_id": "879c5dc2-ccd9-4851-8f73-6aadc91e65af",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "Sur des perches partant du haut des greniers, des écheveaux de coton séchaient à l’air."
                                            },
                                            {
                                                "example_id": "b0cbe7a0-0bd9-43d1-94ed-75fd75c0653b",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "Il ne reste plus qu’à faire sécher l’écorce sur un lit de perches disposées en plan incliné, […]."
                                            },
                                            {
                                                "example_id": "f3c15422-b12e-4571-aebb-8becfcf5d6b0",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "De nouveau, il désigna un député, dans le même groupe, un homme d’environ cinquante ans, malpropre, l’air éploré, d’une hauteur de perche, et la taille un peu courbée par le poids de sa tête, qu’il avait longue et chevaline."
                                            },
                                            {
                                                "example_id": "bfb176d0-37eb-45e5-ab91-dede002005a9",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "Il faisait bon dans cette cabane, bâtie avec des perches serrées l’une contre l’autre et réunies à leur sommet, de manière à former un pain de sucre. De la glaise battue et des mottes de gazon la recouvraient."
                                            },
                                            {
                                                "example_id": "43ec1f52-daf4-4683-b1ef-87096af019e2",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "La rainette, atteinte en plein flanc, écartait les pattes […].\n— Faut l’attraper, proposa Lebrac. Avec une perche on l’amènera tout doucement jusqu’au bord : ensuite de quoi on la déculottera et on la fera cuire sur la braise pour la boulotter."
                                            },
                                            {
                                                "example_id": "3b7361f3-71c2-4248-aff5-9d01c3234f24",
                                                "sense_id": "1c279904-ed9a-389c-8da0-6e91e6a1e6e8",
                                                "text": "Puis ils ont connu les privations de liberté et la misère économique. Les appréhensions de ceux qui ont vécu cette misère devraient être entendues comme une expérience de vie plutôt que comme une déviation politique. Pas avec une perche de 100 pieds ! (…) Mais je constate que ceux qui ont connu les révolutions gauchistes de près ne veulent rien savoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edf1daec-a0d8-389c-ace8-96bf4ec35e86",
                                        "entry_id": "aaf6f2d9-8ee7-3039-a35e-85c301905dd4",
                                        "glosses": [
                                            "Longue tige au bout de laquelle est fixé un microphone pour capter du son."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdb5bd38-ac2a-31a8-9112-558a9e4d13b3",
                                        "entry_id": "aaf6f2d9-8ee7-3039-a35e-85c301905dd4",
                                        "glosses": [
                                            "Arbre dont le diamètre à 1.3 m est compris entre 7,5 et 17.5 cm."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db007c9-b327-40f5-b3f0-f8f099e1389a",
                                                "sense_id": "cdb5bd38-ac2a-31a8-9112-558a9e4d13b3",
                                                "text": "Il peut arriver que la structure des peuplements s’organise en bouquets, notamment avec l’épicéa et surtout le pin sylvestre qui exigent plus de lumière pour se régénérer. Cette structuration est d’ailleurs plutôt à favoriser car elle permet une meilleure qualification des perches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b19c7e-26e4-3d00-8c1d-7183389066e2",
                                        "entry_id": "aaf6f2d9-8ee7-3039-a35e-85c301905dd4",
                                        "glosses": [
                                            "Autre nom de l’age de la charrue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b35ad0ee-9f2c-3b43-83de-fe3f4998a0d9",
                                        "entry_id": "aaf6f2d9-8ee7-3039-a35e-85c301905dd4",
                                        "glosses": [
                                            "Personne dont la taille est haute et grêle."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
