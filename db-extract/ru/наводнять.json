                    {
                        "form_id": "aee394ec-1b31-4a68-b2b8-e9e8d5935611",
                        "entry_id": "245d99a8-0e2d-33db-a552-6d0443658a63",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "наводня́вши"
                    },
                    {
                        "form_id": "d71bad8a-04cb-42a1-adf8-fbb84163c937",
                        "entry_id": "245d99a8-0e2d-33db-a552-6d0443658a63",
