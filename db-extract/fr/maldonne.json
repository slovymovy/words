            {
                "entry_id": "f437753c-69c7-38f4-aa9e-690ebbc30714",
                "word": "maldonne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "29d964b1-508a-41aa-b9a4-c65a1a45d4de",
                        "entry_id": "f437753c-69c7-38f4-aa9e-690ebbc30714",
                        "tags": [
