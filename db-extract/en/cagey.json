                                                "example_id": "ab6bf238-813e-49f9-84ef-892db743de41",
                                                "sense_id": "6a6d3ec8-d214-3173-8c48-cbbf87c2dc59",
                                                "text": "Na de dood van haar vader is ze erg zwijgzaam geworden."
                                            },
