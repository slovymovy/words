                        "entry_id": "0af6c86a-b3a4-399b-8e55-176c45b312e6",
                        "glosses": [
                            "Modèle qui orne la première de couverture d’un magazine, qui fait la une."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "22db88c4-cb24-4c85-9645-980e18b38ad3",
                                "sense_id": "c8802d65-9852-37c5-9a05-df3916e7ebee",
                                "text": "Après Juliette Binoche, le magazine Playboy a fait appel à la jolie Ludivine Sagnier pour être la covergirl de son prochain numéro."
                            },
                            {
                                "example_id": "67013dbf-455e-434f-acc3-5011947c04d5",
                                "sense_id": "c8802d65-9852-37c5-9a05-df3916e7ebee",
                                "text": "Il s’est retourné dans son poumon d’acier pour demander qui est cette Norma Jeane, covergirl du mois sur la couverture du magazine Laff."
                            }
                        ]
                    }
                ],
                "translations": [
