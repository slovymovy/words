                ],
                "senses": [
                    {
                        "sense_id": "6c612be8-d9ca-3316-ae82-0c8f4e8b8dc5",
                        "entry_id": "a55540af-5440-3f2b-9a40-e04030c6a971",
                        "glosses": [
                            "aus Laminat gefertigter Fußbodenbelag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74e1a96c-ecf4-4e90-9621-164f3ebfb682",
                                "sense_id": "6c612be8-d9ca-3316-ae82-0c8f4e8b8dc5",
                                "text": "„Das Kellergewölbe in der Rauhensteingasse im ersten Bezirk ist eher schmucklos: Es gibt einen dunklen Laminatboden und zwei nackte Glühbirnen, die von der Decke hängen.“"
                            },
                            {
                                "example_id": "d99d5522-3165-4ba2-95ce-6b215d7b42f2",
                                "sense_id": "6c612be8-d9ca-3316-ae82-0c8f4e8b8dc5",
                                "text": "„Eine goldfarbene Treppe führt hinauf, es herrscht luxuriöse Gediegenheit: Designermöbel aus schwarzem Leder, dunkler Laminatboden und ein Konzertflügel.“"
                            },
                            {
                                "example_id": "e95fc53b-4697-478a-9c46-1d12ff113fc0",
                                "sense_id": "6c612be8-d9ca-3316-ae82-0c8f4e8b8dc5",
                                "text": "„Ein graues Sofa, Laminatboden und eine locker aufgebaute Schrankwand - so sah das durchschnittliche deutsche Wohnzimmer aus, das die Werbeagentur Jung von Matt vor zwei Jahren ermittelte und nachbaute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
