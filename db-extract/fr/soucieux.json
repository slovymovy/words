                ],
                "senses": [
                    {
                        "sense_id": "a14c2725-f3bc-3c93-9d48-b38fae83bc3d",
                        "entry_id": "43f642a2-c4f8-3db0-a31e-8a4a848936d5",
                        "glosses": [
                            "Qui se soucie, qui prend intérêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4ea694b-33ff-4cc7-b51d-890b9935841f",
                                "sense_id": "a14c2725-f3bc-3c93-9d48-b38fae83bc3d",
                                "text": "Le jeune homme se dirigea donc vers le parc de Valfeuillu, distant de quelques pas seulement, et, peu soucieux de l'article 394 du Code pénal, il franchit le large fossé qui entoure la propriété de M. de Trémorel."
                            },
                            {
                                "example_id": "6d6faa8f-f7ce-4f5a-a6f4-67bd3a54b038",
                                "sense_id": "a14c2725-f3bc-3c93-9d48-b38fae83bc3d",
                                "text": "Ce n'est pas à cette allure que vont jamais les gentlemen, soucieux de leur respectabilité."
                            },
                            {
                                "example_id": "4be414c5-a169-4d60-924b-bdbb7a4b2f1a",
                                "sense_id": "a14c2725-f3bc-3c93-9d48-b38fae83bc3d",
                                "text": "Je suis soucieux de votre santé."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4e2b822-47d8-3273-ad1e-ebd17c275fba",
                        "entry_id": "43f642a2-c4f8-3db0-a31e-8a4a848936d5",
                        "glosses": [
                            "Qui est inquiet, pensif, qui a du souci."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "1b1f34a7-95cf-4006-bfac-9d1ff17cff20",
                                "sense_id": "d4e2b822-47d8-3273-ad1e-ebd17c275fba",
                                "text": "Mais les femmes ressemblent aux mouches. Soucieuses, elles fuient soudain le souci sans que rien en leur attitude ait annoncé l’envol."
                            },
                            {
                                "example_id": "21ceb2f7-ecc6-4207-8914-611a86d6af3a",
                                "sense_id": "d4e2b822-47d8-3273-ad1e-ebd17c275fba",
                                "text": "La « drôle de guerre » menée par la bourgeoisie française plus soucieuse de répression anticommuniste et de menées antisoviétiques que de lutte antihitlérienne oblitère pour le plus grand nombre le sens de la guerre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a332bf1d-707f-350b-b2aa-f0bbb7e16cfc",
                        "entry_id": "43f642a2-c4f8-3db0-a31e-8a4a848936d5",
                        "glosses": [
                            "Qui marque du souci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38caa2a6-ffe7-46b0-8eed-a99139186d38",
                                "sense_id": "a332bf1d-707f-350b-b2aa-f0bbb7e16cfc",
                                "text": "Le vieillard souriait par moments ; mais parfois aussi des expressions soucieuses attristaient passagèrement sa figure desséchée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa898f6-bf0c-486e-8427-98254548256f",
                        "source_entry_id": "43f642a2-c4f8-3db0-a31e-8a4a848936d5",
                        "target_lang_word": "besorgt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
