                    {
                        "form_id": "76894f11-0f5d-4e71-a97d-7fbad05e29e9",
                        "entry_id": "a35d5496-1a20-3832-9c2d-e77f4abd1399",
                        "tags": [
                            "accusative",
                            "plural"
