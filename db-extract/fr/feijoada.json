                    },
                    {
                        "sense_id": "b85e1d10-a32e-3037-8080-1d71153c58dd",
                        "entry_id": "f4290f25-f0b6-381d-83da-6f8711f9aeba",
                        "glosses": [
                            "Ragout aux haricots.",
                            "ragoût brésilien aux haricots et viande de porc salées, considéré comme un plat national au Brésil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa95f152-8c8a-4ea9-bc4c-f00d58b3a7e2",
                                "sense_id": "b85e1d10-a32e-3037-8080-1d71153c58dd",
                                "text": "En vrac, nous adorons : le carré d’agneau, la feijoada brésilienne, l’English breakfast, les spaghetti napoli avec de l’origan, le poulet aux morilles, le bebek goreng (plat de canard indonésien), les frite, le tajine d’agneau, la blanquette de veau, les légumes stir fry (plat thaïlandais) au lait de coco et citron vert, la tom yum soup (encore la Thaïlande à l’honneur avec cette soupe à la citronnelle et aux crevettes), la fondue bourguignonne, la tartiflette, le pho, soupe vietnamienne à la viande plongée crue dans le bouillon."
                            }
                        ]
                    },
                    {
                        "sense_id": "57f7170e-7789-31f0-afff-70592c4717c4",
                        "entry_id": "f4290f25-f0b6-381d-83da-6f8711f9aeba",
                        "glosses": [
                            "Ragout aux haricots.",
                            "ragoût portugais aux haricots et viande de porc ou de bœuf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ac887b-f51b-43bf-97c3-36c24137fc9e",
                                "sense_id": "57f7170e-7789-31f0-afff-70592c4717c4",
                                "text": "En revanche, on évitera les ragoûts comme le cozido (pot-au-feu) ou la feijoada portugaise, si on n’aime pas les abats."
                            }
                        ]
                    }
