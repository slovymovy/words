                "senses": [
                    {
                        "sense_id": "f46a881f-1769-3ba8-b9a7-c56f32dcc5c1",
                        "entry_id": "2e313902-2e22-3c9f-b5ff-28d6d1ac4aea",
                        "glosses": [
                            "Wasser aus Niederschlägen, das oberirdisch auf befestigten und versiegelten Flächen fließt und das noch nicht ins Erdreich eindringen konnte; Oberflächenwasser ist neben frischem Niederschlagswasser auch das Wasser in Bächen, Flüssen und Seen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd4ca3e-92da-4ac1-88d9-be5e8c468a58",
                                "sense_id": "f46a881f-1769-3ba8-b9a7-c56f32dcc5c1",
                                "text": "Dieses Oberflächenwasser weist einen hohen Verschmutzungsgrad auf."
                            },
                            {
                                "example_id": "50ff34e3-f0bb-4a2e-ae48-1ceb4fc61a49",
                                "sense_id": "f46a881f-1769-3ba8-b9a7-c56f32dcc5c1",
                                "text": "„Als Reaktion auf die Trockenheit kündigen immer mehr Landkreise und Städte an, die Entnahme von Oberflächenwasser zu untersagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
