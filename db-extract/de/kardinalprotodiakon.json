                        ],
                        "examples": [
                            {
                                "example_id": "603553b9-a796-4f99-9f45-7f34d052ce03",
                                "sense_id": "4314b28a-a638-31d0-a141-276f128c8f7d",
                                "text": "Der Kardinalprotodiakon ist nur ein primus inter pares unter den Kardinaldiakonen."
                            },
                            {
                                "example_id": "22a652bd-a5b2-494d-941e-e07ca05c9ebd",
                                "sense_id": "4314b28a-a638-31d0-a141-276f128c8f7d",
                                "text": "Seit dem 21. Februar 2011 ist Jean-Louis Tauran Kardinalprotodiakon."
                            },
                            {
                                "example_id": "7d2136b9-c7c5-4410-bc06-a5f8c3bf2749",
                                "sense_id": "4314b28a-a638-31d0-a141-276f128c8f7d",
                                "text": "Eine der Aufgaben des Kardinalprotodiakons ist es, von der Benediktionsloggia aus die Nachricht von der Wahl eines neuen Papstes der Öffentlichkeit mitzuteilen."
                            }
                        ],
