                                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                                "text": "Schon viele Jahre studiert Eduard Medizin."
                                            },
                                            {
                                                "example_id": "7660c2c9-7171-49e6-96de-48416c9cc56a",
                                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                                "text": "Seit einer bestandenen Seepferdchenprüfung liebt Eduard Schwimmbäder."
                                            },
                                            {
                                                "example_id": "7714c727-05a4-4364-8b3d-fbfe7e1c0dde",
                                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                                "text": "Die ganze Firma fuhr ins Krankenhaus, um Eduard nach seiner Gallenoperation zum Geburtstag zu gratulieren."
                                            },
                                            {
                                                "example_id": "6dd80b04-dd71-4908-8d25-c743f7723a76",
                                                "sense_id": "f91e3643-e489-3c7a-9ce5-be769a1f5f7f",
                                                "text": "Den schlauen Eduard hat der Chef jetzt zur Standortanalyse nach Sachsen geschickt."
