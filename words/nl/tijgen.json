                    "frequency": "Low",
                    "semantic_group_id": "verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogelaars <w>togen</w> naar de plaats waar de oehoe was gespot.",
                            "target_lang_translations": {
