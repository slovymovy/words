                        "sense_id": "9504f5ce-275d-30a4-af3a-ef9071576ae4",
                        "entry_id": "549bae6f-f863-3aad-b76b-9d405e75850c",
                        "glosses": [
                            "A despicable, worthless person; a scoundrel."
                        ],
                        "tags": [
                            "Australia",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b615e262-7901-411b-855e-8f2d6a705836",
                                "sense_id": "9504f5ce-275d-30a4-af3a-ef9071576ae4",
                                "text": "Calvin could be anywhere in this zoo. I hope he at least has the sense to stay put, wherever he is. Where would the little rotter go if he was lost and separated from his stuffed toy?"
                            },
                            {
                                "example_id": "b365c258-d758-42c5-a633-2faed7048df8",
                                "sense_id": "9504f5ce-275d-30a4-af3a-ef9071576ae4",
                                "text": "Some Johnny with brains produces a hypothesis. Everybody calls him a rotter at first. But he remains calm in the face of opprobrium."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
