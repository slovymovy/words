                        "translation_id": "9509fe65-74b8-476a-a16a-bc181ca1e192",
                        "source_entry_id": "b3a3cddd-77a5-319d-98e4-0ceaaa56e97e",
                        "source_sense_id": "eed1b7a4-f11e-326a-a322-ff21a287c947",
