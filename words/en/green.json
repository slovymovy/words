                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was having trouble on the <w>greens</w> and missed several putts.",
                            "target_lang_translations": {
                                "ru": "У него были проблемы на <w>гринах</w>, и он промазал несколько паттов."
                            }
                        },
                        {
                            "text": "The golfer carefully studied the slope of the <w>green</w>.",
