                                    {
                                        "sense_id": "4568f7c4-4b0d-340a-892f-563a38d05d93",
                                        "entry_id": "d49a6ee1-aa8e-31d7-9a4b-d2b502de0fec",
                                        "glosses": [
                                            "Action de boiser un pays, de le garnir de forêts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af791143-6278-436d-8dcb-89dcb952b516",
                                                "sense_id": "4568f7c4-4b0d-340a-892f-563a38d05d93",
                                                "text": "À l’heure actuelle, l’étendue inculte boisable en épicéa étant fortement réduite, son extension est due à la conversion de peuplements feuillus en pessières et au boisement de terres agricoles."
                                            },
                                            {
                                                "example_id": "fffb5a27-76cf-4508-81c8-b04cdc2ee0b8",
                                                "sense_id": "4568f7c4-4b0d-340a-892f-563a38d05d93",
                                                "text": "Pour un premier boisement derrière prairie par exemple, il est impératif de décompacter l’horizon de surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f218a7bf-cd42-38f2-bee7-c40b080f12d3",
                                        "entry_id": "d49a6ee1-aa8e-31d7-9a4b-d2b502de0fec",
                                        "glosses": [
                                            "Action de boiser, d’étayer une fouille ou une galerie de mine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
