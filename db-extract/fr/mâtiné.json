                "senses": [
                    {
                        "sense_id": "cb2c864c-d3a3-356a-ac8b-0227ca7ea874",
                        "entry_id": "aead6ec8-9331-39b9-ad76-94695a17dba4",
                        "glosses": [
                            "Se dit d’un animal qui n’est pas de race pure, qui a été croisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ccf658-d6c6-49d4-82ad-16f75f36e43e",
                                "sense_id": "cb2c864c-d3a3-356a-ac8b-0227ca7ea874",
                                "text": "Les chiens mâtinés sont parfois bons à la chasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "759e9345-431a-3b88-8776-e46592edbac7",
                        "entry_id": "aead6ec8-9331-39b9-ad76-94695a17dba4",
                        "glosses": [
                            "Qui est mêlé de."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b7fc7d4e-57ad-4ee8-a66c-b52c2c2312dd",
                                "sense_id": "759e9345-431a-3b88-8776-e46592edbac7",
                                "text": "Très maigre, le nez fortement accusé, il avait bien l’air d’un baladin mâtiné de Don Quichotte."
                            },
                            {
                                "example_id": "efd85022-0932-43a5-b319-db16b96aaa3c",
                                "sense_id": "759e9345-431a-3b88-8776-e46592edbac7",
                                "text": "Juif roumain par ses parents, Gérard avait vu le jour à Paris. […]. La mère de Gérard se prénommait Marie, la mienne, Marie-Louise, malgré une arménitude quelque peu matinée de sépharadisme."
                            },
                            {
                                "example_id": "4bc5d3b7-c4e9-4763-9a75-d2fa665de686",
                                "sense_id": "759e9345-431a-3b88-8776-e46592edbac7",
                                "text": "Ça ne semble pas être le cas de Vladimir Poutine, qui a des réflexes aristocratiques (dans le mauvais sens du terme) mâtinés d’aspects hitlériens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82902e83-50b9-41bb-a32a-f3d3bb563b62",
                        "source_entry_id": "aead6ec8-9331-39b9-ad76-94695a17dba4",
                        "target_lang_word": "mongrel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mongrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2227291-d797-353c-8069-f33c337979dc",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "Someone or something of mixed kind or uncertain origin, especially a dog."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002cd8d9-539f-4391-88af-24763837cc71",
                                                "sense_id": "f2227291-d797-353c-8069-f33c337979dc",
                                                "text": "That dog is a mongrel; who knows what breed it could be!"
                                            },
                                            {
                                                "example_id": "4c0e88b5-cd85-47c2-b1cc-043affb498ca",
                                                "sense_id": "f2227291-d797-353c-8069-f33c337979dc",
                                                "text": "America is an improbable idea. A mongrel nation built of ever-changing disparate parts, it is held together by a notion, the notion that all men are created equal, though everyone knows that most men consider themselves better than someone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103d6bb6-1798-387a-81ba-ea37c54a70c8",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "Someone or something of mixed kind or uncertain origin, especially a dog.",
                                            "A mixed-race person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "offensive",
                                            "often",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6e127f6-2822-317c-ba41-37560c184b39",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "A thuggish, obnoxious, or contemptible person; (often preceded by \\\"poor\\\") a pitiable person."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85d19b32-ef45-4dd2-adbe-e08ad9c7cb9b",
                                                "sense_id": "e6e127f6-2822-317c-ba41-37560c184b39",
                                                "text": "\"Yanto bloody Evans!\" Jack stuttered with rage. \"Yanto bloody Evans! That... that... bloody mongrel! D'you know who he is? He's the one who knocked me back for a bit of extra timber before the roof fell in on me!\""
                                            },
                                            {
                                                "example_id": "14f45a9e-3296-445c-8fbd-2a9c156d2457",
                                                "sense_id": "e6e127f6-2822-317c-ba41-37560c184b39",
                                                "text": "But somebody's got to tell these mums and dads why their kids died, why this mongrel thinks he can wipe them out like a dirty rag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b3eba05-617c-3185-947f-fc9b01c7e5c1",
                                        "entry_id": "34a06d29-6fc4-38f5-8925-4c22f8a17aba",
                                        "glosses": [
                                            "An erect penis; an erection."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
