                    "target_lang_definitions": {
                        "ru": "Конкретная точка в цикле формы волны или периодического явления, часто измеряемая относительно стандартного положения.",
                        "zh": "波形或周期性现象在循环中的特定点，通常相对于标准位置进行测量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фаза",
                                "target_lang_sense_clarification": "колебаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相位",
                                "target_lang_sense_clarification": "波动或周期运动中的位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cefad15a-ee1a-3722-8450-beb897e71111",
