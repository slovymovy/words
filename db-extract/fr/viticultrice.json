                        "sense_id": "cea54da6-66a8-35b3-b380-370abd601ae0",
                        "entry_id": "a6f5dffd-8b05-31d3-a113-9fda6f27bc75",
                        "glosses": [
                            "Celle qui fait de la viticulture, qui cultive la vigne pour en faire du vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e906a535-15f4-4cd8-be14-52fcf2c2c599",
                                "sense_id": "cea54da6-66a8-35b3-b380-370abd601ae0",
                                "text": "Vendredi, le vin de Noémie Tanneau, viticultrice à Lussac-Saint-Emilion, a été sélectionné par le CIVB (Conseil interprofessionnel du vin de Bordeaux) pour être présenté au roi Charles III lors de sa déambulation place de la Bourse, à Bordeaux"
                            }
                        ]
                    },
                    {
                        "sense_id": "386f253a-ffef-34cd-9e6c-409c829e5e5b",
                        "entry_id": "a6f5dffd-8b05-31d3-a113-9fda6f27bc75",
                        "glosses": [
                            "Exploitante agricole d’un vignoble."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "ae3c61e4-a127-4474-8e39-5f19e8db4b62",
                                "sense_id": "386f253a-ffef-34cd-9e6c-409c829e5e5b",
                                "text": "« En 2021 et 2022, une partie des mariages sont des reports de 2020. Et j’ai déjà une dizaine de réservations pour 2023. Les familles s’y prennent plus tôt pour avoir le choix des dates », explique celle qui est aussi viticultrice (28 ha de vigne)."
                            }
                        ]
                    }
