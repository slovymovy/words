{
    "word_family": [
        "évitable",
        "évitement",
        "inévitable",
        "inévitablement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b75c734f-d56c-3aa6-a657-b623609f04b5",
                    "sense_definition": "Faire en sorte de ne pas subir une situation désagréable ou s'abstenir prudemment d'accomplir une action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>éviter</w> de manger trop de sucre pour rester en bonne santé."
                        },
                        {
                            "text": "Pour <w>éviter</w> la foule, nous faisons nos courses tôt le matin."
                        }
                    ],
                    "synonyms": [
                        "s'abstenir"
                    ],
                    "antonyms": [
                        "rechercher"
                    ],
                    "common_phrases": [
                        "éviter de"
                    ]
                },
                {
                    "sense_id": "70454cf2-2218-3089-af97-ffafcf2acf51",
                    "sense_definition": "Modifier sa trajectoire pour ne pas heurter un obstacle, ou fuir délibérément la rencontre de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a donné un coup de volant pour <w>éviter</w> un obstacle."
                        },
                        {
                            "text": "Depuis notre dispute, mon collègue m'<w>évite</w> et refuse de me saluer."
                        }
                    ],
                    "synonyms": [
                        "esquiver",
                        "contourner",
                        "fuir"
                    ],
                    "antonyms": [
                        "affronter"
                    ],
                    "common_phrases": [
                        "éviter un obstacle"
                    ]
                },
                {
                    "sense_id": "ca701aa4-d2fa-3170-b893-c7a8e377116a",
                    "sense_definition": "Empêcher la survenue d'un danger, d'un incident fâcheux ou d'une catastrophe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'intervention rapide des secours a permis d'<w>éviter</w> une catastrophe majeure."
                        },
                        {
                            "text": "Un accord a été trouvé au dernier moment pour <w>éviter</w> le pire."
                        }
                    ],
                    "synonyms": [
                        "parer",
                        "prévenir"
                    ],
                    "antonyms": [
                        "provoquer",
                        "causer"
                    ],
                    "common_phrases": [
                        "éviter le pire",
                        "éviter une catastrophe"
                    ]
                },
                {
                    "sense_id": "9801abbc-63e6-3781-8049-d3489888d0ef",
                    "sense_definition": "Tourner autour de son ancre au changement de vent ou de marée, en parlant d'un navire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec le changement de marée, le navire commence à <w>éviter</w> sur son ancre."
                        },
                        {
                            "text": "Le capitaine surveille le mouillage pendant que les bateaux <w>évitent</w> face au vent."
                        }
                    ],
                    "common_phrases": [
                        "éviter sur son ancre",
                        "éviter au vent"
                    ]
                }
            ]
        }
    ]
}