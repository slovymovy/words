                "senses": [
                    {
                        "sense_id": "8436f636-f3b3-33b5-b8f9-c520921b72e6",
                        "entry_id": "e7fb7a33-fcee-3b53-b0c4-a79d51655222",
                        "glosses": [
                            "indigene nordamerikanische Sprache aus der Familie der uto-aztekischen Sprachen, die im Südwesten der USA gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fd09116-3240-4f52-9944-93a0144f9af8",
                                "sense_id": "8436f636-f3b3-33b5-b8f9-c520921b72e6",
                                "text": "„Daß das Hopi gerade den Raumbereich seines sprachlichen Weltbildes sehr feinmaschig gewortet hat und vor allem bei den Grundkategorien des Standortes, Zielortes und Herkunftsortes äußerst differenzierende Maßstäbe ansetzt, wird schon im Vergleich mit anderen Indianersprachen deutlich.“"
                            },
                            {
                                "example_id": "d1bfc4e7-8441-49bd-94b0-66e1120f4dba",
                                "sense_id": "8436f636-f3b3-33b5-b8f9-c520921b72e6",
                                "text": "„[…] die Kinder sprechen beide Sprachen fließend, weil sie sich mit ihrem Vater auf Hopi, mit ihrer Mutter und deren Verwandten auf Tewa unterhalten müssen.“"
                            },
                            {
                                "example_id": "59e9774a-a859-4027-b3e9-e5e8f253db33",
                                "sense_id": "8436f636-f3b3-33b5-b8f9-c520921b72e6",
                                "text": "„Die Kommentare der Clowns, überwiegend auf Hopi, wurden von einigen Zuschauern als sehr obszön empfunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
