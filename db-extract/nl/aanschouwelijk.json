                        "examples": [
                            {
                                "example_id": "561926ce-649c-4bce-b29b-cb1739eaa9dd",
                                "sense_id": "f992aebb-9183-382e-9263-6bccd830803c",
                                "text": "De bloederige tragische verhalen die overal op de Peloponnesos in theaters aanschouwelijk werden gemaakt, gingen over inschattingsfouten, blinde vlekken, onmatige temperamenten en koppige karaktertrekken waardoor het leven van bekwame en bewonderenswaardige mensen werd ontwricht."
                            },
                            {
                                "example_id": "58e68dd2-f68d-48b8-a27d-52d98e31c60e",
                                "sense_id": "f992aebb-9183-382e-9263-6bccd830803c",
                                "text": "Corona is snel, dramatisch en aanschouwelijk, meetbaar wat de gevolgen betreft."
                            }
                        ]
