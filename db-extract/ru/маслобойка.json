                ],
                "senses": [
                    {
                        "sense_id": "c49ba61f-f947-3ba7-98b3-abaee37aa942",
                        "entry_id": "06ff0fab-77b2-302c-bac7-eeee642b0be1",
                        "glosses": [
                            "аппарат для сбивания сливок или сметаны в сливочное масло"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a514af0-6650-4361-b4f4-ee21ca3ce3b7",
                                "sense_id": "c49ba61f-f947-3ba7-98b3-abaee37aa942",
                                "text": "Его функции взял на себя другой горячий источник — STROKKUR, который расположен рядом. Он очень активен. Не зря переводится как — маслобойка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ad4af1e-c6da-4057-ae42-a065b50cb398",
                        "source_entry_id": "06ff0fab-77b2-302c-bac7-eeee642b0be1",
                        "source_sense_id": "c49ba61f-f947-3ba7-98b3-abaee37aa942",
                        "target_lang_word": "churn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "churn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To agitate rapidly and repetitively, or to stir with a rowing or rocking motion; generally applies to liquids, notably cream."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e172d852-2661-473e-9cbd-40ea463d3f1f",
                                                "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                                "text": "Now the cream is churned to make butter."
                                            },
                                            {
                                                "example_id": "65c4bb9d-5de3-4c61-b256-1a427fd234e8",
                                                "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                                "text": "no-churn ice cream"
                                            },
                                            {
                                                "example_id": "6001be79-5509-4ce3-887c-ed59222c8574",
                                                "sense_id": "6d9bbee4-5f17-3135-8b56-23440de3cb69",
                                                "text": "Churned in his teeth, the foamy venom rose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e093ba8-e260-3baa-9641-3eff63a1668f",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To produce excessive and sometimes undesirable or unproductive activity or motion."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f2b885-0ad7-4796-a496-4b1129ee8666",
                                                "sense_id": "0e093ba8-e260-3baa-9641-3eff63a1668f",
                                                "text": "The slope of the terrain, shaped like a funnel, squeezed the growing swell of churning snow into a steep, twisting gorge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a751a1-ee86-319c-bd15-dc0a28bc7b29",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To move rapidly and repetitively with a rocking motion; to tumble, mix or shake."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5041f8-a89b-4cc8-9513-8c2ae9010261",
                                                "sense_id": "18a751a1-ee86-319c-bd15-dc0a28bc7b29",
                                                "text": "I was so nervous that my stomach was churning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6c640ab-13e8-364d-a891-266ecd589494",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To stop using a company's product or service."
                                        ],
                                        "tags": [
                                            "of a customer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "598a5302-7f98-4af2-97e1-19b76fd5ed5d",
                                                "sense_id": "d6c640ab-13e8-364d-a891-266ecd589494",
                                                "text": "Subscriptions can be ended or canceled, which is known as churn. If there are no subscriptions, a customer churns when they stop using the product."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e91053d-2ea9-3467-83cb-7d787e0c9a19",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To repeatedly cancel and rebook a reservation in order to refresh ticket time limits or other fare rule restrictions."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8e5cbee-90cf-397b-8fb9-e0d234d802f3",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To continually sign up for new credit cards in order to earn signup bonuses, airline miles, and other benefits."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cdb8e49-e966-3be9-b457-04c8d6cbd5b0",
                                        "entry_id": "b1547f8a-b153-315f-aba2-2976d2f68bbc",
                                        "glosses": [
                                            "To carry out wash sales in order to make the market appear more active than it really is."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "churn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a6a176-0f1c-3e39-bb6e-b55398c25345",
                                        "entry_id": "1fd461a4-e1df-3585-9dd2-6df7f67b0b22",
                                        "glosses": [
                                            "A vessel used for churning, especially for producing butter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df2049d8-7b04-4ee8-931e-ebd6b6c0efd2",
                                                "sense_id": "a8a6a176-0f1c-3e39-bb6e-b55398c25345",
                                                "text": "a butter churn"
                                            },
                                            {
                                                "example_id": "cd99c2d5-f799-4c86-854b-9ed8a9b28c6b",
                                                "sense_id": "a8a6a176-0f1c-3e39-bb6e-b55398c25345",
                                                "text": "We notice by our exchanges that great efforts are being made throughout the western States especially, to palm off upon the farming public various kinds of patent churns, or to induce many mechanics to give large sums for the Right to manufacture the same—while in a majority of cases, we believe, the articles are absolutely worthless, or inferior to older kinds that might be procured for less money. We have repeatedly cautioned our readers against purchasing these new fangled churns until after they have been more fully tested; and we are happy to know that our remarks have saved not a few of our friends from imposition. To set this matter in a clearer light before our readers, we will glance at a few of the different churns, now most prominently before the public—some valuable, some useless."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87610df2-8c1a-3405-b1e4-6e8f1ce76bfa",
                                        "entry_id": "1fd461a4-e1df-3585-9dd2-6df7f67b0b22",
                                        "glosses": [
                                            "A milk churn (container for the transportation of milk)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038bfa3e-feb3-4b3e-9741-d30d13e179c8",
                                                "sense_id": "87610df2-8c1a-3405-b1e4-6e8f1ce76bfa",
                                                "text": "As the ends of the up and down platforms are not opposite each other, it is not possible to provide the ordinary type of barrow crossing, and the full churns were too heavy to be man-handled up and down the stairs of the footbridge."
                                            },
                                            {
                                                "example_id": "ae512b79-53f1-49f8-8037-e6315aa80b2c",
                                                "sense_id": "87610df2-8c1a-3405-b1e4-6e8f1ce76bfa",
                                                "text": "In the old days, milk trains consisted entirely of vans loaded with ten-gallon churns. When filled, these churns weigh 130 lb. each and their manipulation is an art. [...] Like the tank wagons, the churns are dairy property, but farmers often have other ideas, and find their own uses for them—it has not been unknown for dairy inspectors to find missing churns tucked away in an unsuspected corner of a farmhouse, filled to the brim with banknotes!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf4edc2-4a84-33b9-b5bf-174026c66809",
                                        "entry_id": "1fd461a4-e1df-3585-9dd2-6df7f67b0b22",
                                        "glosses": [
                                            "Customer attrition; the phenomenon or rate of customers leaving a company."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f28af8b-d295-3f2d-a3d6-1a759cde996f",
                                        "entry_id": "1fd461a4-e1df-3585-9dd2-6df7f67b0b22",
                                        "glosses": [
                                            "The time when a consumer switches his/her service provider."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b7ad33e-262b-3085-982a-a1225e7d44d6",
                                        "entry_id": "1fd461a4-e1df-3585-9dd2-6df7f67b0b22",
                                        "glosses": [
                                            "The mass of people who are ready to switch carriers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54982e69-d6ea-32bf-8aeb-4bea011ebf21",
                                        "entry_id": "1fd461a4-e1df-3585-9dd2-6df7f67b0b22",
                                        "glosses": [
                                            "Cyclic activity that achieves nothing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507603ee-ef1d-462b-9409-b6d07bad8e10",
                                                "sense_id": "54982e69-d6ea-32bf-8aeb-4bea011ebf21",
                                                "text": "I wished my brain would shut up and knew that soon I'd have to start tidying, but first I needed to rest, so I tried to quell the pointless churn behind my eyes and kept on trying (in a minute) until Vicky came back home."
                                            },
                                            {
                                                "example_id": "5ab9fc8a-1b11-4467-89fd-51de90b2d528",
                                                "sense_id": "54982e69-d6ea-32bf-8aeb-4bea011ebf21",
                                                "text": "Getting the right manager has just been made more difficult by not having Champions League to offer. There will also be a huge churn of players after the lavish, unrewarding outlay this season."
                                            }
                                        ]
