                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "snello",
                                "target_lang_sense_clarification": "magro e armonioso"
                            },
                            {
                                "target_lang_word": "slanciato",
                                "target_lang_sense_clarification": "alto, sottile e proporzionato"
                            },
                            {
                                "target_lang_word": "scattante",
                                "target_lang_sense_clarification": "atletico e pronto al movimento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fcd19ef-6295-3e71-99fc-bb1095eb3ac7",
                    "sense_definition": "Adaptable, nimble, or light in style, character, or taste.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic praised the wine for being crisp, fresh, and remarkably <w>lithe</w> on the palate.",
                            "target_lang_translations": {
                                "it": "Il critico ha lodato il vino per essere vivace, fresco e straordinariamente <w>snello</w> al palato."
                            }
                        },
                        {
                            "text": "Her prose possesses a <w>lithe</w> quality that makes complex ideas easy to follow.",
                            "target_lang_translations": {
                                "it": "La sua prosa possiede una qualità <w>fluida</w> che rende le idee complesse facili da seguire."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Adattabile, fluido o leggero nello stile, nel carattere o nel gusto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "fluido",
                                "target_lang_sense_clarification": "scorrevole e naturale nello stile"
                            },
                            {
                                "target_lang_word": "snello",
                                "target_lang_sense_clarification": "leggero e agile riferito a un testo o sapore"
                            },
                            {
                                "target_lang_word": "agile",
                                "target_lang_sense_clarification": "versatile o scorrevole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a899f7d2-ce3b-36f5-9fa2-25ec5f20fc3f",
                    "sense_definition": "Mild, calm, or gentle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors welcomed the <w>lithe</w> breeze after days of enduring violent ocean storms.",
                            "target_lang_translations": {
                                "it": "I marinai accolsero la brezza <w>mite</w> dopo aver sopportato giorni di violente tempeste oceaniche."
                            }
                        },
                        {
                            "text": "They sat outside until midnight, enjoying the <w>lithe</w> weather of early summer.",
                            "target_lang_translations": {
                                "it": "Rimasero seduti all'aperto fino a mezzanotte, godendosi il clima <w>dolce</w> dell'inizio dell'estate."
                            }
                        }
                    ],
                    "synonyms": [
                        "clement",
                        "gentle",
                        "mellow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Mite, calmo o dolce (arcaico)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "mite",
                                "target_lang_sense_clarification": "dolce, calmo (riferito al clima)"
                            },
                            {
                                "target_lang_word": "dolce",
                                "target_lang_sense_clarification": "delicato, soave"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7df0fa98-c932-3abb-9e20-607dc513bdc2",
                    "sense_definition": "To thicken soup, gravy, or broth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cook stirred in extra flour to <w>lithe</w> the simmering beef gravy.",
                            "target_lang_translations": {
                                "it": "Il cuoco aggiunse altra farina mescolando per <w>addensare</w> il sugo di manzo che sobbolliva."
                            }
                        },
                        {
                            "text": "You must slowly <w>lithe</w> the broth until it coats the back of a spoon.",
                            "target_lang_translations": {
                                "it": "Devi <w>legare</w> lentamente il brodo finché non vela il dorso di un cucchiaio."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern England and Scotland"
