                            {
                                "example_id": "e56aa25d-5fc6-4742-b52b-8725d3a3103e",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Oh ben chouette alors, on a 30 points… on s’est gourationné… on pensait en avoir que 24…"
                            },
                            {
                                "example_id": "41e81a1b-6671-4a53-bab9-8039a321871c",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Je peux me gourationner…"
                            },
                            {
                                "example_id": "a1e7703c-57f8-4e37-abac-3c5007bca105",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Mais je puis me gourationner, n’étant guère familier avec la langue de Lady Di."
                            },
                            {
                                "example_id": "9ab849a6-8726-4af0-8024-394a20e9f0e7",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Vous ne vous êtes pas gourationnés, les Croms"
                            },
                            {
                                "example_id": "bad5f7f6-9c7a-43f6-af19-f7f931f0d9dd",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Voir plus haut, je me suis gourationnée."
                            },
                            {
                                "example_id": "4ad98b47-8de5-479d-a400-540db567e0f4",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Je peux me gourationner mais le sac ne me semble pas français; le modèle en usage dans la Royale n’a pas de lacet de fermeture mais une poignée métallique - en fonte d’aluminium (alpax) -, fermée par un cadenas."
                            },
                            {
                                "example_id": "c9fb5e0b-0043-4f9b-8d12-99309c9f04a5",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "J’ai un petit poème tout simple en tête que je vais essayer de te retrouver, sans me gourationner dans les accents (dur !)."
                            },
                            {
                                "example_id": "af2441a3-be76-453f-89a4-b07a3103a256",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Mais je peux me gourationner."
                            },
                            {
                                "example_id": "d4e9c682-8daa-4bf8-98fc-92007f1b3564",
                                "sense_id": "7b73cdcf-dda7-3462-9720-2a46c8141808",
                                "text": "Maintenant j’peux me gourationner total…"
                            }
                        ]
