                    {
                        "translation_id": "215e55ed-c96d-4583-94c0-109f03c27fdd",
                        "source_entry_id": "8421665f-4a70-3a5a-b475-03f7c5250ac2",
                        "source_sense_id": "59fcb34a-2189-3111-aae4-5bc1feb50f9a",
