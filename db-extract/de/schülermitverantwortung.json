                "senses": [
                    {
                        "sense_id": "b2562845-4430-3bcd-a493-a085e5f3e7a0",
                        "entry_id": "27f45e8b-1f39-3800-9ad5-079076775d9e",
                        "glosses": [
                            "Vertretung der Schüler an den Schulen in einigen Bundesländern Deutschlands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0458a89-0a1b-4252-8789-c0a656720e95",
                                "sense_id": "b2562845-4430-3bcd-a493-a085e5f3e7a0",
                                "text": "„Zu häufig habe er erlebt, dass Verbesserungsvorschläge von Seiten der Schülermitverantwortung nicht ernst genommen worden seien. ‚Dabei geht es doch um uns. Wir wissen doch am besten, wie der Schulalltag abläuft‘, sagt Kieslich.“"
                            },
                            {
                                "example_id": "4d4c4b7a-df45-433f-a2cc-14c140032bfe",
                                "sense_id": "b2562845-4430-3bcd-a493-a085e5f3e7a0",
                                "text": "„Ozan Ayka und Alex Löhrer beginnen mit dem Aufbau im Kleinsten, als sie bei dem ersten Vernetzungstreffen der Schülermitverantwortungen (SMV) im Landkreis Dachau das Konzept des Münchner Schülerbüros darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
