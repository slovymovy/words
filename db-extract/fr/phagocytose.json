        "fr-extract.jsonl": [
            {
                "entry_id": "6247a4bd-1500-302a-ba8c-f3ae6e2e39e6",
                "word": "phagocytose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "579f1d54-d30e-4377-b3fd-8fcf0dcf6e1f",
                        "entry_id": "6247a4bd-1500-302a-ba8c-f3ae6e2e39e6",
                        "tags": [
                            "plural"
                        ],
                        "form": "phagocytoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15998d71-e028-39f9-b1db-68d169836bbb",
                        "entry_id": "6247a4bd-1500-302a-ba8c-f3ae6e2e39e6",
                        "glosses": [
                            "Processus d’englobement et de digestion par une cellule de particules solides ou d'autres cellules qu’elle trouve dans son milieu."
                        ],
                        "tags": [
                            "Biologie cellulaire"
                        ],
                        "examples": [
                            {
                                "example_id": "92de0e9b-be06-4d29-9867-3356a5792003",
                                "sense_id": "15998d71-e028-39f9-b1db-68d169836bbb",
                                "text": "Pour l’étude du comportement du vacuome au cours de la phagocytose, c'est l'amidon de riz qui représente le matériel phagocytaire le plus commode."
                            },
                            {
                                "example_id": "e96fa664-d25d-4df1-b5dd-900ba5e9fba8",
                                "sense_id": "15998d71-e028-39f9-b1db-68d169836bbb",
                                "text": "Deux types de globules blancs, les granulocytes neutrophiles et les monocytes, sont capables de migrer de la circulation sanguine vers les tissus et d’« avaler » les éventuels micro-organismes envahisseurs par un mécanisme appelé phagocytose."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c96da43-e6f4-3d43-800e-676e3481001e",
                        "entry_id": "6247a4bd-1500-302a-ba8c-f3ae6e2e39e6",
                        "glosses": [
                            "Destruction, disparition par absorption, intégration, neutralisation."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5224743d-895f-4c17-a6bb-5e035864c3c3",
                                "sense_id": "7c96da43-e6f4-3d43-800e-676e3481001e",
                                "text": "[…] au mépris de l’expérience tant de fois répétée de la puissance de phagocytose du capitalisme, de sa capacité à tout digérer, à tout annuler, à tout recoder en sa faveur, y compris (surtout) les « subversions »"
                            }
                        ]
                    }
                ],
