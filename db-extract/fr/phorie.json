                    {
                        "sense_id": "8c19e993-e0ab-33f8-ad1d-b04347157fb7",
                        "entry_id": "ae4c800b-45fc-3ad5-bf52-36416925869d",
                        "glosses": [
                            "Axe visuel au repos d'un œil fixant un objet en vision binoculaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a32415d-2dd8-4d8b-aaa7-cd29e56b14be",
                                "sense_id": "8c19e993-e0ab-33f8-ad1d-b04347157fb7",
                                "text": "Une attention toute particulière sera portée aux professions exigeant une vue attentive et soutenue de près (informaticien, secrétaire, étudiant...). En effet ces dernières sont exposées aux troubles de la phorie. — (Florence Malet, LENTILLES DE CONTACT RAPPORT SFO 2009, Éditeur Elsevier Masson, 2009)"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4f73b86-a020-3f8d-a495-d096d7f22ac5",
                        "entry_id": "ae4c800b-45fc-3ad5-bf52-36416925869d",
                        "glosses": [
                            "Déviation de l’axe visuel visible uniquement au repos et corrigé automatiquement lors d’une vision active par le cerveau en réalignant les yeux."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "33676d61-ca27-45b8-823b-785aaa58203d",
                                "sense_id": "f4f73b86-a020-3f8d-a495-d096d7f22ac5",
                                "text": "Une déviation latente est une - phorie, une déviation patente une - tropie."
                            }
                        ]
                    }
                ],
