                "senses": [
                    {
                        "sense_id": "cf7d9f5d-768b-37a7-9384-9b592cebb072",
                        "entry_id": "7270a2ea-b1e1-37d1-9a32-37c8dcfb8a78",
                        "glosses": [
                            "to shed a few tears, to have tears in one's eyes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b998a254-5ee8-4551-8453-577bbb2b2943",
                                "sense_id": "cf7d9f5d-768b-37a7-9384-9b592cebb072",
                                "text": "пирова́ли - весели́лись, подсчита́ли - прослези́лись",
                                "translation": "after feasting came the reckoning",
                                "english": "after feasting came the reckoning"
                            },
                            {
                                "example_id": "b89ccb29-b9e9-42d9-92ef-3f87d611e4e8",
                                "sense_id": "cf7d9f5d-768b-37a7-9384-9b592cebb072",
                                "text": "Я не о́чень си́льно уда́рил себя́ по щеке́, вы́пил ещё три глотка́ — и прослези́лся.",
                                "translation": "I hit myself not very hard across the cheek, drank three slugs, and shed a tear.",
                                "english": "I hit myself not very hard across the cheek, drank three slugs, and shed a tear."
                            }
                        ]
                    }
                ],
