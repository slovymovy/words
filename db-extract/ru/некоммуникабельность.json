                        "source_entry_id": "6755bc9a-993c-357b-bf5b-54bbd42995ca",
                        "source_sense_id": "1e8c0747-9ac3-3e8c-ad3d-c8546ee03a92",
                        "target_lang_word": "incommunicabilité",
                        "target_lang_code": "fr",
