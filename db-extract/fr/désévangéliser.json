                "senses": [
                    {
                        "sense_id": "43c7aa5c-debf-3a36-8fc6-97880c32ba00",
                        "entry_id": "65befa53-e7e4-3532-a689-47699825a313",
                        "glosses": [
                            "Faire disparaître l’influence de l’Évangile dans une société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc4266cd-873d-465e-a89d-cb90344879da",
                                "sense_id": "43c7aa5c-debf-3a36-8fc6-97880c32ba00",
                                "text": "On peut très bien désévangéliser la société sans goulag."
                            },
                            {
                                "example_id": "dd2de0f6-93e0-404e-81dc-e211244a7f91",
                                "sense_id": "43c7aa5c-debf-3a36-8fc6-97880c32ba00",
                                "text": "Envoyé du ciel pour désévangéliser votre monde auquel Dieu ne croit plus, il vous fait prendre conscience du potentiel humoristique que vous possédez."
                            },
                            {
                                "example_id": "78b1c081-d16f-4a1a-a009-f849ac3801b8",
                                "sense_id": "43c7aa5c-debf-3a36-8fc6-97880c32ba00",
                                "text": "C'était une guerre pour désévangéliser l'Allemagne ?"
                            },
                            {
                                "example_id": "9c79e2c2-a473-44c6-b171-66409d138f5a",
                                "sense_id": "43c7aa5c-debf-3a36-8fc6-97880c32ba00",
                                "text": "Je ne suis pas de ceux qui croient que ce sont les Chinois et les Africains qui vont nous évangéliser, parce que, au contraire, ils vont se désévangéliser à grande vitesse, comme les Polonais."
                            }
                        ]
                    }
                ],
