                ],
                "senses": [
                    {
                        "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                        "entry_id": "46f0db4b-ffe2-386d-97ce-eca32636f29c",
                        "glosses": [
                            "Stürmer, der auf dem Spielfeld auf der äußersten rechten Seite spielt"
                        ],
                        "tags": [
                            "bei Ballspielen"
                        ],
                        "examples": [
                            {
                                "example_id": "6420899a-e496-46d2-a6b6-6f5d28439f77",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Handball:] „[…] Eine Viertelstunde vor Schluss verletzte sich Rechtsaußen Lasse Svan, als er an Gegenspieler Max Preller vorbei in den Kreis springen wollte.“"
                            },
                            {
                                "example_id": "f1b14769-5921-4e07-aa4e-aa65ef9918e4",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Fußballer Nik Omladic:] „Der 31 Jahre alte Rechtsaußen […] musste das Training am Montag wegen einer schmerzhaften Prellung abbrechen und begab sich in ärztliche Behandlung.“"
                            },
                            {
                                "example_id": "675844cc-046a-46fb-8eed-60bb2897fc56",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Fußballer Patrick Herrmann:] „Sein Bundesligadebüt gab der Rechtsaußen im März 2010 im rheinischen Derby beim 1. FC Köln.“"
                            },
                            {
                                "example_id": "5c03f12e-f930-427c-85a6-204c4f487a67",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "„Rechtsaußen Müller war erst im vergangenen Sommer […] zur Eintracht gewechselt, bei der er auch etliche Jugendteams durchlief.“"
                            },
                            {
                                "example_id": "642f4247-d203-474e-b2ee-6926251c88e2",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Der Fußballer Kai Havertz ist] „sehr flexibel einsetzbar: Rechtsaußen, Linksaußen, zweite Spitze - diese Polyvalenz macht ihn für viele Vereine so attraktiv.“"
                            },
                            {
                                "example_id": "a5fcb8ef-a27d-4fff-894f-f4f93401fade",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Hamburger Sport Verein:] „Linksaußen \"Charly\" Dörfel und Rechtsaußen Klaus Neisner, erinnern sich, 60 Jahre danach, an diese Deutsche Meisterschaft.“"
                            },
                            {
                                "example_id": "407a6fed-aef4-4999-8293-a20a532ed6d0",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Der Handballer Patrick Groetzki vergab] „weitere Chancen. Der sonst so sichere Rechtsaußen der Rhein-Neckar-Löwen haderte sichtlich mit sich.“"
                            },
                            {
                                "example_id": "411431d4-df54-488c-ba96-835bb858be77",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Handball:] „Der geniale Kroate Luka Cindric, der flinke slowenische Rechtsaußen Blaz Janc, der dänische Linksaußen Casper Mortensen, der französische Kreisläufer Cedric Fabregas oder der dänische Torwart Kevin Möller, der nach der Saison nach Flensburg zurückkehren wird, sind nur einige illustre Namen beim spanischen Rekordmeister.“"
                            },
                            {
                                "example_id": "2dacc224-5fbb-4fdd-828a-80db34210882",
                                "sense_id": "1ef219e2-8ba4-3309-919c-04fbfee9d9ea",
                                "text": "[Handball:] „Der dänische Rechtsaußen Johan Hansen traf zweimal kurz hintereinander […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                        "entry_id": "46f0db4b-ffe2-386d-97ce-eca32636f29c",
                        "glosses": [
                            "Vertreter des äußersten rechten Flügels innerhalb einer politischen Partei"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d7bd81be-9a45-4ab4-832a-7197929594e0",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "[Schlagzeile:] „Rechtspopulismus – Rechtsaußen Poggenburg verlässt AfD und gründet neue Partei“"
                            },
                            {
                                "example_id": "9960f802-8e90-4f4e-8831-ba41b3e055a6",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "„Unruhe in der AfD – Die Umfragewerte sind die schlechtesten seit 2017. Der Parteivorstand unter Führung von Jörg Meuthen hat jetzt Rechtsaußen Andreas Kalbitz aus der Partei ausgeschlossen.“"
                            },
                            {
                                "example_id": "9bc7f6da-7743-49ac-a34a-08fe724238a5",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "[Burkaverbot:] „Schließlich fand die Mitte-Rechts-Koalition im vergangenen Jahr einen typisch niederländischen Kompromiss: Kein Total-Verbot, wie es der Rechtsaußen Wilders wollte, sondern ein Verbot in öffentlichen Gebäuden.“"
                            },
                            {
                                "example_id": "b96f8b93-0969-4df1-9dd8-cf891d92f402",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "[AfD:] „Die beiden Rechtsaußen aus Schwerin, Dirk Lerche und Bert Obereiner, sind jetzt als Direktkandidaten nach Vorpommern ausgewichen, weil sie in der Landeshauptstadt offenbar \"nicht mehr unterkamen\".“"
                            },
                            {
                                "example_id": "7e921895-fbb6-409f-982e-59b1865ee24e",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "„Höcke gilt als Rechtsaußen in der AfD. Der Bundesverfassungsschutz hatte ihn im März als rechtsextremistische Führungspersönlichkeit eingestuft.“"
                            },
                            {
                                "example_id": "4537845e-dbd8-461c-9569-e656369b46f6",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "„Auf Parler findet man neben den Rechtsaußen der Republikaner zahlreiche Rassisten, Holocaust-Leugner und QAnon-Sektierer, die glauben, Politik und Medien seien von pädophilen Satanisten unterwandert.“"
                            },
                            {
                                "example_id": "254f14d8-0ef7-415e-bc9f-918f423dda11",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "„Trotz allem Toben der Schreihälse von Rechtsaußen: Gegen die Fakten kommt niemand an, die Mehrheit in Deutschland hat das jetzt endgültig verstanden.“"
                            },
                            {
                                "example_id": "e7a042d5-8fbc-4208-a5a2-30d55aaa5c61",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "[Der Rechtsextremismusforscher Matthias Quent] „warnt davor, das Thema Sicherheit »den politischen Akteuren von Rechtsaußen zu überlassen«.“"
                            },
                            {
                                "example_id": "45764ab6-ac7d-4451-b07f-06a771a060e6",
                                "sense_id": "02797648-5a7c-34a3-b8cc-b05eab5f107c",
                                "text": "„Am dritten Abend des republikanischen Nominierungsparteitags bat Aryeh Spero, ein orthodoxer Rabbiner mit einer langen Karriere als engagierter Rechtsaußen bei den Republikanern, Gott darum, Donald Trump zu segnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
