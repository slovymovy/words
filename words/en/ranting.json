{
    "word_family": [
        "rant",
        "ranter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9169e59b-ab90-3bf6-892d-3a817353d5e0",
                    "sense_definition": "A long, angry, and impassioned speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician ignored the crowd's <w>ranting</w> and continued with his prepared speech.",
                            "target_lang_translations": {
                                "cs": "Politik ignoroval <w>výlevy</w> davu a pokračoval ve svém připraveném projevu."
                            }
                        },
                        {
                            "text": "I had to listen to his endless <w>ranting</w> about the poor quality of the service.",
                            "target_lang_translations": {
                                "cs": "Musel jsem poslouchat jeho nekonečné <w>tirády</w> na špatnou kvalitu služeb."
                            }
                        }
                    ],
                    "synonyms": [
                        "diatribe",
                        "tirade"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dlouhý, rozzlobený a vášnivý projev."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "diatriba",
                                "target_lang_sense_clarification": "útočný, kritický projev"
                            },
                            {
                                "target_lang_word": "tiráda",
                                "target_lang_sense_clarification": "dlouhý, bouřlivý výlev"
                            },
                            {
                                "target_lang_word": "výlev",
                                "target_lang_sense_clarification": "emotivní vyjádření nespokojenosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a035245c-e7bb-3c96-b17d-af47ddad1eeb",
                    "sense_definition": "The act or process of delivering a rant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>ranting</w> at the staff made everyone in the office feel very uncomfortable.",
                            "target_lang_translations": {
                                "cs": "Jeho neustálé <w>rozčilování se</w> na zaměstnance způsobilo, že se všichni v kanceláři cítili velmi nepříjemně."
                            }
                        },
                        {
                            "text": "After hours of <w>ranting</w>, he finally calmed down and started to speak rationally.",
                            "target_lang_translations": {
                                "cs": "Po hodinách <w>nadávání</w> se konečně uklidnil a začal mluvit racionálně."
                            }
                        }
                    ],
                    "synonyms": [
                        "raving"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost nebo proces přednášení rozzlobeného projevu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozčilování se",
                                "target_lang_sense_clarification": "projevování hněvu"
                            },
                            {
                                "target_lang_word": "nadávání",
                                "target_lang_sense_clarification": "hlasité vyjadřování nespokojenosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9f46aab-af80-3369-bf5d-57b93c253f5a",
                    "sense_definition": "Present participle and gerund of <w>rant</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>ranting</w> about the unfair rules for over an hour yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera přes hodinu <w>rozčileně řečnil</w> o nespravedlivých pravidlech."
                            }
                        },
                        {
                            "text": "Stop <w>ranting</w> and tell me exactly what the problem is.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>se rozčilovat</w> a řekni mi přesně, v čem je problém."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomný příčestí a gerundium slovesa rant (rozčilovat se, řečnit)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozčilující se",
                                "target_lang_sense_clarification": "vyjadřující hněv"
                            },
                            {
                                "target_lang_word": "nadávající",
                                "target_lang_sense_clarification": "hlasitě kritizující"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}