                                    },
                                    {
                                        "sense_id": "ed25060b-69ee-3840-bce0-290bced7bf33",
                                        "entry_id": "a742415e-7d3c-37c7-9db6-4f789fe1a5b4",
                                        "glosses": [
                                            "A place of reverence or honor."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "870d9495-b38a-443d-842b-411ab868be8d",
                                                "sense_id": "ed25060b-69ee-3840-bce0-290bced7bf33",
                                                "text": "He has put his mother on a pedestal. You can't say a word against her."
                                            },
                                            {
                                                "example_id": "9dfb569e-88b6-4cda-9fad-5b5941578a5f",
                                                "sense_id": "ed25060b-69ee-3840-bce0-290bced7bf33",
                                                "text": "But India is also where the Mahatma may have fallen furthest from the pedestal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78d09126-8013-3fa2-9399-16194d396da6",
                                        "entry_id": "a742415e-7d3c-37c7-9db6-4f789fe1a5b4",
                                        "glosses": [
