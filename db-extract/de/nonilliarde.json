                ],
                "senses": [
                    {
                        "sense_id": "1a16c49d-751e-34af-89f3-d9048f2359ff",
                        "entry_id": "221faf18-908c-3df3-b2b9-1e5d6d4945a9",
                        "glosses": [
                            "die Zahl 10⁵⁷, eine Eins mit 57 Nullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "175b67ad-66e8-4fef-a68b-5c3cbde92647",
                                "sense_id": "1a16c49d-751e-34af-89f3-d9048f2359ff",
                                "text": "„Der Großmeister Kortschnoi hat einmal ausgerechnet, daß eine durchschnittliche Partie von 45 Zügen eine Nonilliarde möglicher Varianten hätte.“"
                            },
                            {
                                "example_id": "256d4584-a103-4c8d-b3c7-4f128ea1fb25",
                                "sense_id": "1a16c49d-751e-34af-89f3-d9048f2359ff",
                                "text": "„Schon einmal von Oktilliarden, Sexdezilliarden oder gar Nonilliarden gehört? Während der Weltmeisterschaft im Kopfrechnen im hessischen Gießen zeigt Rüdiger Gamm, was das heißt: Innerhalb kürzester Zeit ermittelt der 35-Jährige die hundertste Potenz einer zweistelligen Zahl.“"
                            },
                            {
                                "example_id": "302f4c38-fffc-442e-9f4d-1662a68431a3",
                                "sense_id": "1a16c49d-751e-34af-89f3-d9048f2359ff",
                                "text": "„Jonglieren mit Nonilliarden und Oktilliarden — Zahlen, die selbst der Duden nicht kennt.“"
                            },
                            {
                                "example_id": "809d80b4-9425-4489-ac72-1d07f42c3e83",
                                "sense_id": "1a16c49d-751e-34af-89f3-d9048f2359ff",
                                "text": "„Zum Vergleich:",
                                "translation": "Die Anzahl aller Atome in der Sonne beträgt ungefähr 1 Nonilliarde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
