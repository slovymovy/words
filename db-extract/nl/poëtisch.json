                "translations": [
                    {
                        "translation_id": "89d1e03c-7e0f-40bc-82cf-839f766fc529",
                        "source_entry_id": "7df696e8-4c75-3ae2-9084-9f681f5dee5b",
                        "source_sense_id": "211924e5-11a6-3231-9d49-b099581ed0cf",
                        "source_sense_description": "uit de poëzie, gelijkend op poëzie",
                        "target_lang_word": "poetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                        "entry_id": "65b0478c-04ad-3175-8fd9-e44f5f65a985",
                                        "glosses": [
                                            "in der Art und Weise der Poesie oder des Poeten, auf die Poesie oder den Poeten bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6998040-3186-4742-a4e8-3eae052b966a",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "Wenn mir danach ist, lese ich gern ein poetisches Werk."
                                            },
                                            {
                                                "example_id": "456c33db-6300-4906-97fe-599a25ea6bc7",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "Das klingt sehr poetisch."
                                            },
                                            {
                                                "example_id": "806c6969-f2d0-4a45-8df0-8a8b4a099e51",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "„Die Poetik ist nur eine der Disziplinen, die sich mit poetischen Texten beschäftigen.“"
                                            },
                                            {
                                                "example_id": "03fc9569-73f3-4905-bc1a-5507b65957c1",
                                                "sense_id": "51e6d409-dd2d-3500-be6e-9521292f626e",
                                                "text": "„Ja, das Schreiben und das Lesen",
                                                "translation": "poetisch war ich nie!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59498354-3f72-389d-b502-df36cae5400b",
                                        "entry_id": "65b0478c-04ad-3175-8fd9-e44f5f65a985",
                                        "glosses": [
                                            "von besonderer Stimmung, Atmosphäre"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef33677f-de03-4744-b68a-e8593d4e839c",
                        "source_entry_id": "7df696e8-4c75-3ae2-9084-9f681f5dee5b",
                        "source_sense_id": "211924e5-11a6-3231-9d49-b099581ed0cf",
                        "source_sense_description": "uit de poëzie, gelijkend op poëzie",
                        "target_lang_word": "dichterisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dichterisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c98a8994-f9ae-3010-9adf-632be1c01435",
                                        "entry_id": "678b1bdd-c428-3f63-bd7f-1aa4685e2133",
                                        "glosses": [
                                            "in der Art eines Dichters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700faba8-6dce-491c-90e3-fb7afc552f21",
                                                "sense_id": "c98a8994-f9ae-3010-9adf-632be1c01435",
                                                "text": "Der Brief war in einer dichterischen Sprache verfasst."
                                            },
                                            {
                                                "example_id": "fe6c75d8-1579-40d4-a661-bb6304e1fd53",
                                                "sense_id": "c98a8994-f9ae-3010-9adf-632be1c01435",
                                                "text": "„Warum also Zarathustra als Namensgeber für Nietzsches geheimnisvollstes, dichterischstes, symbolhaltigstes und zugleich dunkelstes, mit Sicherheit aber sein gültigstes und identifikatorischstes Werk? Nietzsche sagt es in ‹Ecce homo›, …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b512e3f1-180a-4546-9bb9-c315ab14b2a1",
                        "source_entry_id": "7df696e8-4c75-3ae2-9084-9f681f5dee5b",
                        "source_sense_id": "211924e5-11a6-3231-9d49-b099581ed0cf",
                        "source_sense_description": "uit de poëzie, gelijkend op poëzie",
                        "target_lang_word": "poetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec4d22a-c20f-380a-9f8b-2aaa0e672b1a",
                                        "entry_id": "c5d95d53-8ce9-3407-a5e7-643082c59d07",
                                        "glosses": [
                                            "Relating to poetry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf315c7-86bf-4969-a3e8-903edb0ba8c0",
                                                "sense_id": "0ec4d22a-c20f-380a-9f8b-2aaa0e672b1a",
                                                "text": "Iambics are one form of poetic meter."
                                            },
                                            {
                                                "example_id": "94ddaa58-240b-4ca6-8b55-bf593db0d14a",
                                                "sense_id": "0ec4d22a-c20f-380a-9f8b-2aaa0e672b1a",
                                                "text": "Some poems, echoing the purpose of early poetic treatises on scientific principles, attempt to elucidate the mathematical concepts that underlie prime numbers. Others play with primes’ cultural associations. Still others derive their structure from mathematical patterns involving primes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e58aa3d-533a-3223-89cb-e7326d3a4f5d",
                                        "entry_id": "c5d95d53-8ce9-3407-a5e7-643082c59d07",
                                        "glosses": [
                                            "Characteristic of poets; romantic, imaginative, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a2b624b-22b8-36ed-91e5-e9b81ec80cae",
                                        "entry_id": "c5d95d53-8ce9-3407-a5e7-643082c59d07",
                                        "glosses": [
                                            "Connecting to the soul of the beholder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
