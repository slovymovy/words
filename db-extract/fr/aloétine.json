                        "examples": [
                            {
                                "example_id": "fe4e6270-76fd-4dc7-a8db-9c4524aed0d0",
                                "sense_id": "337fe545-3cf1-3f1b-a6ae-476c488e66d2",
                                "text": "L’aloès déposé dans le tombeau de Jésus aurait imprégné d’aloétine le linceul."
                            },
                            {
                                "example_id": "81dcdf38-77f7-468e-9411-5e75ebb53809",
                                "sense_id": "337fe545-3cf1-3f1b-a6ae-476c488e66d2",
                                "text": "L'aloés contient une petite quantité d'aloïne et une assez grande quantité d'aloétine qui n'est qu'une transformation amorphe de l'aloïne. — (Georges Hayem, Leçons de thérapeutique tome 4, éd. Masson, 1893)"
                            },
                            {
                                "example_id": "85c18fa3-76c2-4377-9665-e620847a643b",
                                "sense_id": "337fe545-3cf1-3f1b-a6ae-476c488e66d2",
                                "text": "Le produit désigné sous le nom d'aloétine , isolé par Robiquet , n'est probablement pas une espèce chimique définie."
                            }
                        ]
                    }
