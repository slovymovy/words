{
    "word_family": [
        "expect",
        "expectant",
        "expectancy",
        "unexpected",
        "unexpectedly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eed155a-e01f-34ba-b60a-61111db4a6d2",
                    "sense_definition": "A strong belief that something will happen or be the case in the future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team had a high <w>expectation</w> of winning the championship after their successful season.",
                            "target_lang_translations": {
                                "ru": "У команды были высокие <w>ожидания</w> от победы в чемпионате после успешного сезона."
                            }
                        },
                        {
                            "text": "There is a general <w>expectation</w> that the economy will improve by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Существует общее <w>ожидание</w>, что экономика улучшится к концу года."
                            }
                        }
                    ],
                    "synonyms": [
                        "anticipation",
                        "prospect",
                        "prediction"
                    ],
                    "antonyms": [
                        "disbelief",
                        "doubt"
                    ],
                    "common_phrases": [
                        "high expectation",
                        "general expectation",
                        "meet expectation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердая уверенность в том, что что-то произойдет или будет иметь место в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидание",
                                "target_lang_sense_clarification": "состояние предвкушения события"
                            },
                            {
                                "target_lang_word": "предположение",
                                "target_lang_sense_clarification": "мнение о будущем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e991af7c-4d2d-3ab6-a692-08e3340a8063",
                    "sense_definition": "A standard of conduct or performance that someone is required or encouraged to reach.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher set a clear <w>expectation</w> for the students regarding their behavior in the classroom.",
                            "target_lang_translations": {
                                "ru": "Учитель установил четкие <w>требования</w> к поведению учеников в классе."
                            }
                        },
                        {
                            "text": "He felt a lot of pressure to live up to his parents' <w>expectation</w> of becoming a doctor.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал сильное давление, стараясь оправдать <w>ожидания</w> родителей и стать врачом."
                            }
                        }
                    ],
                    "synonyms": [
                        "requirement",
                        "standard",
                        "demand"
                    ],
                    "common_phrases": [
                        "live up to expectation",
                        "clear expectation",
                        "parental expectation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт поведения или результативности, которого от кого-либо требуют или ожидают достичь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требование",
                                "target_lang_sense_clarification": "установленный стандарт"
                            },
                            {
                                "target_lang_word": "ожидание",
                                "target_lang_sense_clarification": "надежды на чьи-то успехи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "964e5f31-3f3b-36cb-bf05-8f10bf6b50a4",
                    "sense_definition": "The prospect of future success or the hope of receiving something good, such as an inheritance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prospect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the only heir, he had a great <w>expectation</w> of inheriting the family estate.",
                            "target_lang_translations": {
                                "ru": "Как единственный наследник, он имел большие <w>надежды</w> на получение семейного поместья."
                            }
                        },
                        {
                            "text": "She moved to the city with the <w>expectation</w> of finding a better job and a new life.",
                            "target_lang_translations": {
                                "ru": "Она переехала в город в <w>надежде</w> найти лучшую работу и начать новую жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "prospect",
                        "hope",
                        "likelihood"
                    ],
                    "common_phrases": [
                        "great expectation",
                        "future expectation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перспектива будущего успеха или надежда на получение чего-то ценного, например, наследства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надежда",
                                "target_lang_sense_clarification": "упование на успех или выгоду"
                            },
                            {
                                "target_lang_word": "перспектива",
                                "target_lang_sense_clarification": "шансы на будущее"
                            },
                            {
                                "target_lang_word": "чаяние",
                                "target_lang_sense_clarification": "высокое, книжное: надежда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88c7956a-fbb5-3b54-95a1-2fad2b4f8a33",
                    "sense_definition": "The predicted value of a variable, calculated as the sum of all possible values each multiplied by the probability of its occurrence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In statistics, the mathematical <w>expectation</w> represents the long-run average value of a random variable.",
                            "target_lang_translations": {
                                "ru": "В статистике математическое <w>ожидание</w> представляет собой среднее значение случайной величины в долгосрочной перспективе."
                            }
                        },
                        {
                            "text": "The scientist calculated the <w>expectation</w> of the experiment's results based on the initial data.",
                            "target_lang_translations": {
                                "ru": "Ученый рассчитал математическое <w>ожидание</w> результатов эксперимента на основе исходных данных."
                            }
                        }
                    ],
                    "synonyms": [
                        "expected value",
                        "mean",
                        "average"
                    ],
                    "common_phrases": [
                        "mathematical expectation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогнозируемое значение переменной, рассчитанное как сумма всех возможных значений, умноженных на вероятность их появления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "математическое ожидание",
                                "target_lang_sense_clarification": "статистический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}