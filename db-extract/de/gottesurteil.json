                    },
                    {
                        "translation_id": "763126de-fbb7-4c07-8092-44e656b7141d",
                        "source_entry_id": "16ef4981-721a-3b73-ab6a-76d451ca419a",
                        "source_sense_id": "21bdfa2e-94b0-3e87-bd96-93f324baeb9f",
                        "target_lang_word": "ordeal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordeal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98da317a-f87a-30b6-96c3-74b023f96f7e",
                                        "entry_id": "e09f9a34-bd2f-3225-9572-894654e1f2ab",
                                        "glosses": [
                                            "A trial in which the accused was subjected to a dangerous test (such as ducking in water), divine authority deciding the guilt of the accused."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da94cb6f-5127-4e95-ab88-6ea8a88a7c57",
                                                "sense_id": "98da317a-f87a-30b6-96c3-74b023f96f7e",
                                                "text": "trial by ordeal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                        "entry_id": "e09f9a34-bd2f-3225-9572-894654e1f2ab",
                                        "glosses": [
                                            "A painful or trying experience."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c244b8-8f29-48d2-8446-eda1957dfd69",
                                                "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                                "text": "“And do you realize that in a few shakes I've got to show up at dinner and have Mrs Cream being very, very kind to me? It hurts the pride of the Woosters, Jeeves.” “My advice, sir, would be to fortify yourself for the ordeal.” “How?” “There are always cocktails, sir. Should I pour you another?” “You should.”"
                                            },
                                            {
                                                "example_id": "920b9c05-073e-439e-b981-cc0b8a1eb7c6",
                                                "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                                "text": "All the same, nearly eight hours on the footplate covering a distance of 320 miles, with an ambient temperature of up to 103° for much of the time, proved an ordeal which I would not lightly undertake again."
                                            },
                                            {
                                                "example_id": "76f5edde-adce-4810-bfb4-3a91957865e7",
                                                "sense_id": "aab888ee-6081-3351-a726-4e7f31f93e79",
                                                "text": "Arsène Wenger confessed: \"The result was not an accurate indication of the match.\" Certainly, at half-time it seemed unlikely that Arsenal would catch fire so spectacularly because the first half was a damp squib of a display from Wenger's team, as Newcastle initially showed no ill-effects from their Old Trafford ordeal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eecd012-785f-3e86-9da1-f639a16fd66d",
                                        "entry_id": "e09f9a34-bd2f-3225-9572-894654e1f2ab",
                                        "glosses": [
                                            "The poisonous ordeal bean or Calabar bean."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
