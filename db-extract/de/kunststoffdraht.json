                "senses": [
                    {
                        "sense_id": "12b920f1-62c3-347b-80ec-a02c85f63240",
                        "entry_id": "418c2ee6-cbdf-3cf2-89b9-05213a85b248",
                        "glosses": [
                            "dünnes biegsames Kunststoffstück mit in der Regel rundem Profil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d10f7b6d-5544-4e4d-bb13-f992a6439640",
                                "sense_id": "12b920f1-62c3-347b-80ec-a02c85f63240",
                                "text": "„Die meisten 3D-Drucker für daheim spulen das benötigte Plastik als Kunststoffdraht von einer Rolle ab, der zu Kilogrammpreisen zwischen 24 und 32 Euro zu haben ist.“"
                            },
                            {
                                "example_id": "e664cfe1-0423-44ae-95ef-16aa2fa4fce4",
                                "sense_id": "12b920f1-62c3-347b-80ec-a02c85f63240",
                                "text": "„Antenne ausfahren,bis das Teleskop mit dem gezahnten Kunststoffdraht aus der Antenne herausgenommen werden kann; das letzte Stück vollständig von Hand herausziehen,dabei auf die Richtung der Zähne achten.“"
                            },
                            {
                                "example_id": "a5873b26-8285-4513-94c2-9abe95ff409b",
                                "sense_id": "12b920f1-62c3-347b-80ec-a02c85f63240",
                                "text": "„Dort wird der Kunststoffdraht bis kurz über seinen Schmelzpunkt erhitzt und auf die Bauplattform bzw. die eben erstellte Schicht aufgetragen.“"
                            },
                            {
                                "example_id": "4ecb2c51-36da-4921-89c8-e2c299821383",
                                "sense_id": "12b920f1-62c3-347b-80ec-a02c85f63240",
                                "text": "„Dabei wird ein auf einer Spule aufgewickelter Kunststoffdraht einem beheizten Extrusionskopf zugeführt und darin aufgeschmolzen.“"
                            },
                            {
                                "example_id": "a06d149f-5d96-4790-af89-116f4357891e",
                                "sense_id": "12b920f1-62c3-347b-80ec-a02c85f63240",
                                "text": "„Der Kunststoffdraht wird eher in Ausnahmefällen für die Produktion von Kehrichtballen oder Futtermittelballen eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
