            {
                "entry_id": "dc171029-116c-3a24-a019-101afff863c9",
                "word": "slipform",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a8deebac-ea21-48f7-9a15-29c35f726118",
                        "entry_id": "dc171029-116c-3a24-a019-101afff863c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "slipforms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8751e12-d661-33a8-b42e-35ca287e4c57",
                        "entry_id": "dc171029-116c-3a24-a019-101afff863c9",
                        "glosses": [
                            "A type of process for setting concrete which uses moveable forms that are moved and reused once the concrete is stiff enough to retain its shape under its own weight."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bab809d5-831d-4d4b-9c14-04ca5efe183b",
                                "sense_id": "b8751e12-d661-33a8-b42e-35ca287e4c57",
                                "text": "Like other Flagg houses, the walls were created of stone (in this case Tennessee quartzite) and mortar using a slipform process."
                            },
                            {
                                "example_id": "f8bdecec-b111-4155-9a09-f4310887f767",
                                "sense_id": "b8751e12-d661-33a8-b42e-35ca287e4c57",
                                "text": "The objective of this study is to evaluate the impacts of vibration and consolidation of modern slipform pavers used in Wisconsin on the air-void structure and air content of portland cement concrete pavements."
                            },
                            {
                                "example_id": "227b2bbf-4b44-41e2-b72a-dac77a4eadd5",
                                "sense_id": "b8751e12-d661-33a8-b42e-35ca287e4c57",
                                "text": "On most slipform paving projects, however, small amounts of fixed-form paving or \"handwork\" are still necessary."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6908d18-1ac9-3df5-8cc6-e2e6678498e1",
                        "entry_id": "dc171029-116c-3a24-a019-101afff863c9",
                        "glosses": [
                            "A moveable form used when setting concrete using the slipform technique."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "403d7cb5-0d05-4fad-abcc-306854d36d60",
                                "sense_id": "f6908d18-1ac9-3df5-8cc6-e2e6678498e1",
                                "text": "Slipforms of various designs have been used with excellent results."
                            },
                            {
                                "example_id": "6b11f7d3-e50d-4b5e-a4f6-81b222b38873",
                                "sense_id": "f6908d18-1ac9-3df5-8cc6-e2e6678498e1",
                                "text": "The slipform is fed with concrete from a crane-carried or rail-mounted bucket."
                            },
                            {
                                "example_id": "54890cec-08dc-4fd5-9d78-4fc2db1bee74",
                                "sense_id": "f6908d18-1ac9-3df5-8cc6-e2e6678498e1",
                                "text": "Vibration may be used ahead of the slipform, but consolidation must be completed as the concrete passes under the form."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9064a036-1758-343e-90df-ef7dd1ea3e6f",
