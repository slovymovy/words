                ],
                "senses": [
                    {
                        "sense_id": "7a581338-df6a-329f-a363-e56214c732f3",
                        "entry_id": "d559ee31-91d7-32dd-84ac-f007d326b379",
                        "glosses": [
                            "dun horse, usually male, with black mane and tail"
                        ],
                        "tags": [
                            "animal-not-person",
                            "colloquial",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b1d4347b-572e-4684-b56a-69e8ee280912",
                                "sense_id": "7a581338-df6a-329f-a363-e56214c732f3",
                                "text": "Gdy król wyszedł, jego łysy bułanek towarzysz boju z pod Grunwaldu bystro patrzał , rżał wesoło, kopytem rąbał , ale na samem wkładaniu nogi w strzemię , padł i zdechł na miejscu",
                                "translation": "When the king left, his bald companion dun stallion from the battle of Grunwald looked sharply, neighed cheerfully, kicked with his hoof, but as soon as he put his foot in the stirrup, he fell and died on the spot.",
                                "english": "When the king left, his bald companion dun stallion from the battle of Grunwald looked sharply, neighed cheerfully, kicked with his hoof, but as soon as he put his foot in the stirrup, he fell and died on the spot."
                            },
                            {
                                "example_id": "05dfa1d0-8415-4c2e-8b0b-57eb1de2b60d",
                                "sense_id": "7a581338-df6a-329f-a363-e56214c732f3",
                                "text": "Koń jego, dziarski bułanek, zabrał się zaraz do ogryzania liści z krzaków, a Otek zeskoczywszy na ziemię, począł przeglądać juki i poprawiać rzemienie.",
                                "translation": "His horse, a spry dun stallion, immediately began nibbling leaves from the bushes, while Otek jumped down to the ground and began examining his saddlebags and adjusting the straps.",
                                "english": "His horse, a spry dun stallion, immediately began nibbling leaves from the bushes, while Otek jumped down to the ground and began examining his saddlebags and adjusting the straps."
                            }
                        ]
                    }
                ],
