                                        "glosses": [
                                            "auf der Häcksel- oder Futterschneidemaschine kurz geschnittenes Heu, Stroh und grobstängliges Grünfutter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69dff76d-c4ee-4750-8cda-b4336d0ec830",
                                                "sense_id": "ec50bc94-c5f9-39d0-b8aa-fe9932914482",
                                                "text": "Ich muss dem Vieh noch das Häcksel geben."
                                            }
                                        ],
