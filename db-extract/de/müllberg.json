                ],
                "senses": [
                    {
                        "sense_id": "c0852340-9625-3310-8a66-34ef509864da",
                        "entry_id": "7756f6ca-d822-323e-bc95-acfbe5c15902",
                        "glosses": [
                            "großer Haufen bestehend aus Müll/Unrat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31108ed-9d33-4a7e-9cda-31983ab83052",
                                "sense_id": "c0852340-9625-3310-8a66-34ef509864da",
                                "text": "„Laut Schaal möchte nun auch der Landkreis Augsburg am Müllberg entsorgen, weil die Deponie Hegnenbach nicht mehr zur Verfügung steht.“"
                            },
                            {
                                "example_id": "20ad6fe7-3d00-42d0-8912-c5cafb089269",
                                "sense_id": "c0852340-9625-3310-8a66-34ef509864da",
                                "text": "„Die geplante Deponie an der Westseite der „Müllberge“ soll innerhalb von 7-11 Jahren eine Gesamthöhe von 40 Metern über Bodenniveau erreichen.“"
                            },
                            {
                                "example_id": "afe6160f-d214-46a4-8046-aae1abc334d3",
                                "sense_id": "c0852340-9625-3310-8a66-34ef509864da",
                                "text": "„Die Straßenreinigung funktionierte nicht mehr, vielerorts sammelten sich Müllberge, in denen die noch nicht erlegten und ebenfalls hungrigen Ratten nach Fressbarem wühlten.“"
                            },
                            {
                                "example_id": "7ad378c9-ee71-493e-a6ab-41c521bf840d",
                                "sense_id": "c0852340-9625-3310-8a66-34ef509864da",
                                "text": "„Vor allem aber sah die Obrigkeit in den Müllbergen in den Straßen Verkehrshindernisse, die den freien Fluss von Menschen und Waren behinderten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f06911aa-4357-341f-8418-4954f90dd52f",
                        "entry_id": "7756f6ca-d822-323e-bc95-acfbe5c15902",
                        "glosses": [
                            "große Unordnung mit dem Aussehen von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72914ae-b3cd-47ef-8c2a-2b2215d87ab3",
                                "sense_id": "f06911aa-4357-341f-8418-4954f90dd52f",
                                "text": "Den Müllberg in seinem Zimmer hatte Rainer nicht bezwingen können."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
