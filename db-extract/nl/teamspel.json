                        "examples": [
                            {
                                "example_id": "e3c19b95-4bcf-4be3-a4de-7301a7a4a5c0",
                                "sense_id": "3d64c7ec-bf6f-3020-a635-79bff8b296b4",
                                "text": "Een bron heeft aan het Engelse tabloid vertelt dat veel spelers zich net 'schooljongens'voelden. ,,Van Gaal is na de gesprekken wat losser en je ziet een duidelijke verbetering in het teamspel.\""
                            },
                            {
                                "example_id": "79eda643-626a-48a2-aa32-0a26fcb502a3",
                                "sense_id": "3d64c7ec-bf6f-3020-a635-79bff8b296b4",
                                "text": "Çounterterrorisme is een teamspel, en de EU is daarvoor het beste raamwerk."
                            }
                        ]
