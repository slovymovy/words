                                        "sense_id": "f14aa5ab-70ff-36b9-88b0-c1d3c302d35a",
                                        "entry_id": "0f608d5e-8d68-356e-9ee0-e2143e821248",
                                        "glosses": [
                                            "Action de réserver une place (à un spectacle, dans un véhicule de transport en commun, etc.)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aed3ffed-2a0e-3951-b437-be7cf9b38a0d",
                                        "entry_id": "0f608d5e-8d68-356e-9ee0-e2143e821248",
                                        "glosses": [
                                            "Droit en vertu duquel le pape, dans les pays d’obédience, se réserve la nomination, la collation de certains bénéfices, lorsqu’ils viennent à vaquer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
