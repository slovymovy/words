                "senses": [
                    {
                        "sense_id": "aa6fa3f5-918c-38f5-9a96-4700c2c0d219",
                        "entry_id": "f07cf654-3dc9-3958-89c9-6437a2132868",
                        "glosses": [
                            "dział hydrobiologii i hydrologii badający życie organizmów wodnych w zbiornikach śródlądowych jak też właściwości chemiczne i fizyczne tego środowiska"
                        ],
