                "senses": [
                    {
                        "sense_id": "37ce5f2b-a06f-31a8-a9fc-a00ec40c493e",
                        "entry_id": "2364a923-9588-38c7-9c50-b2ac876c53e2",
                        "glosses": [
                            "Tee aus getrockneten Blüten des Holunders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a6d48d-8e14-4e62-be40-c35d0e69e056",
                                "sense_id": "37ce5f2b-a06f-31a8-a9fc-a00ec40c493e",
                                "text": "„Denn heißer Holunderblütentee wirkt gegen fiebrige Erkältungen.“"
                            },
                            {
                                "example_id": "738467f3-78a9-45ae-81ad-5619087ddf97",
                                "sense_id": "37ce5f2b-a06f-31a8-a9fc-a00ec40c493e",
                                "text": "„Die Europäische Arzneimittel-Agentur (EMA) empfiehlt Holunderblütentee bei Erkältungssymptomen bis zu dreimal täglich.“"
                            },
                            {
                                "example_id": "dc03f346-8920-458d-8fb2-4de55cd1d943",
                                "sense_id": "37ce5f2b-a06f-31a8-a9fc-a00ec40c493e",
                                "text": "„Holunderblütentee ist ideal als Getränk für Kinder, die ständig erkältet sind, chronisch husten oder an Polypen leiden und auch für Erwachsene, um Heuschnupfenattacken abzumildern oder bei chronischen Entzündungen wie z.B. Sinusitis.“"
                            },
                            {
                                "example_id": "4bab7eec-3350-4c68-81f3-0fc486eca577",
                                "sense_id": "37ce5f2b-a06f-31a8-a9fc-a00ec40c493e",
                                "text": "„Zur Stärkung des Immunsystems und somit eine gute Vorbeugungsmaßnahme gegen Erkältung und Grippe ist der regelmäßige, abendliche Genuss von Holunderblütentee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
