                    {
                        "sense_id": "c56bb904-96f7-3566-a85e-d1228e246ae3",
                        "entry_id": "2eb0b661-7ed2-332a-a61b-1f00e2db7df0",
                        "glosses": [
                            "das Zögern, eine noch nicht für alle zur Verfügung stehende Immunisierung erhalten zu haben, zu erwähnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0382ac1-06d0-4762-a696-dcc931945cb1",
                                "sense_id": "c56bb904-96f7-3566-a85e-d1228e246ae3",
                                "text": "„Gibt es das in großem Stil – so etwas wie Impfneid und Impfscham?“"
                            },
                            {
                                "example_id": "e692fdb6-3846-4cf6-af5b-3238edbfc950",
                                "sense_id": "c56bb904-96f7-3566-a85e-d1228e246ae3",
                                "text": "„Dann kam der Code und ich bekam einen sehr baldigen Termin, und ein neues Gefühl flammte auf: Impfscham.“"
                            },
                            {
                                "example_id": "e5e81157-27c1-4984-812d-e3944c286080",
                                "sense_id": "c56bb904-96f7-3566-a85e-d1228e246ae3",
                                "text": "„Zwischen Impfneid und Impfscham lebt es sich schwer.“"
                            },
                            {
                                "example_id": "fe2a3601-9ec7-46bb-ac56-e9ca9daacd3c",
                                "sense_id": "c56bb904-96f7-3566-a85e-d1228e246ae3",
                                "text": "„Schluss mit der Impfscham!“"
                            },
                            {
                                "example_id": "1b80b517-9fe2-404d-8bfb-2c0a7c482ae6",
                                "sense_id": "c56bb904-96f7-3566-a85e-d1228e246ae3",
                                "text": "„Nach dem Impfneid ist vor der Impfscham. Unsere Redakteurin wurde geimpft. Und ertappt sich seither dabei, sich vor sämtlichen Menschen rechtzufertigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
