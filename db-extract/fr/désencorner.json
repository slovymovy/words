                        "examples": [
                            {
                                "example_id": "da181e6c-dc3c-4399-9800-b3213ddecfa6",
                                "sense_id": "1c1acacb-8e8b-3c50-82fc-c9a382903bb6",
                                "text": "Impossible de le « désencorner ». Finalement, les cornes du bouc se cassèrent net et elles restèrent fichées dans la caboche du malin."
                            },
                            {
                                "example_id": "4442100d-a18f-48e5-bcd5-e0ddc7f31a69",
                                "sense_id": "1c1acacb-8e8b-3c50-82fc-c9a382903bb6",
                                "text": "Que ce soit par des froids de 30° et des vents à désencorner un bœuf, ou par des températures où le soleil verse du plomb sur les crânes, ils sont là."
                            },
                            {
                                "example_id": "eeb85efb-2289-49a6-aaf6-c1cfdf4bd746",
                                "sense_id": "1c1acacb-8e8b-3c50-82fc-c9a382903bb6",
                                "text": "On a eu cette nuit un orage à désencorner tous les cocus de France."
                            }
                        ]
