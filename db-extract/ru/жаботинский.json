                "senses": [
                    {
                        "sense_id": "ef6eb3f0-4af5-34fe-875d-a80e5116741d",
                        "entry_id": "00700761-02ed-3444-8499-f3ab90a6c24e",
                        "glosses": [
                            "Žabotinský, Žabotinskij - ruské příjmení"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fd348a-5b15-455d-bb8d-235b00ad8d87",
                                "sense_id": "ef6eb3f0-4af5-34fe-875d-a80e5116741d",
                                "text": "Мирным же путём, согласно Жаботинскому, арабы из естественного патриотизма не готовы допустить осуществления сионистской идеи ни в какой форме. По мнению Жаботинского, борьба с арабами не противоречит требованиям морали, так как арабы имеют множество стран и государств.",
                                "translation": "Podle Žabotinského nejsou bez vojenského nátlaku Arabové ochotni již z přirozeného vlastenectví připustit realizaci sionistické myšlenky v jakékoliv formě. Podle Žabotinského názoru boj s Araby není v rozporu s nároky morálky vzhledem k tomu, že Arabové mají řadu zemí a států."
                            },
                            {
                                "example_id": "5518dd67-00c7-4de3-a56d-0acbfd54c4bc",
                                "sense_id": "ef6eb3f0-4af5-34fe-875d-a80e5116741d",
                                "text": "«В нашей общей истории поставлена еще одна страшная точка» Заявление Владимира Евгеньевича Жаботинского в связи с убийством Бориса Немцова",
                                "translation": "\"V našich společných dějinám došlo k další strašné události\" Prohlášení Vladimira Jevgeněviče Žabotinského v souvislosti s vraždou Borise Němcova."
                            },
                            {
                                "example_id": "479c95fc-affb-4d12-9118-368a5e647bc5",
                                "sense_id": "ef6eb3f0-4af5-34fe-875d-a80e5116741d",
                                "text": "Страдания семьи Жаботинских",
                                "translation": "Utrpení rodiny Žabotinských"
                            }
                        ]
