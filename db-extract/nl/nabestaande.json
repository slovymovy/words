                        "sense_id": "66e487a7-e0df-315a-9529-060cbcf2b797",
                        "entry_id": "9c9519f5-069a-3b34-9e6b-06c0d8f5e3ab",
                        "glosses": [
                            "familielid van iemand die overleden is."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a0b7aed-5b95-4440-9995-742fa1bb5ea4",
                                "sense_id": "66e487a7-e0df-315a-9529-060cbcf2b797",
                                "text": "De nabestaande regelde de uitvaart van de overledene."
                            },
                            {
                                "example_id": "3378ac15-e92b-455b-a5ca-3a3fe6bb8c2b",
                                "sense_id": "66e487a7-e0df-315a-9529-060cbcf2b797",
                                "text": "Het gaat over de ervaringen van nabestaanden van overleden klimmers."
                            },
                            {
                                "example_id": "ad2aa1e1-5bc1-4707-902f-943cb3ab3597",
                                "sense_id": "66e487a7-e0df-315a-9529-060cbcf2b797",
                                "text": "Fotocollage van de slachtoffers: Er komen twee lange wanden te staan met de namen van alle slachtoffers. Nabestaanden en genodigden kunnen daar een bloem achterlaten zodat een erehaag ontstaat. Aan het einde van de ceremonie wordt een collage geprojecteerd van foto's van de slachtoffers. De nabestaanden hebben die foto's ingezonden."
                            }
                        ]
                    }
