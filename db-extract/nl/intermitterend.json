                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intermittent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                        "entry_id": "85e64006-2988-3443-ba26-6eae3419746d",
                                        "glosses": [
                                            "Stopping and starting, occurring, or presenting at intervals; coming after a particular time span."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cfb0c73-341d-4185-afff-774aadf2846c",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "The day was cloudy with intermittent rain."
                                            },
                                            {
                                                "example_id": "6e1912ea-7968-4312-b09e-cc39d31f0d2b",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "Intermittent bugs are most difficult to reproduce."
                                            },
                                            {
                                                "example_id": "5ff3ba53-d394-4f31-92b6-e9d30b5552f2",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "Also bloudletting is good in feuers, whether they be continual or intermittent […]"
                                            },
                                            {
                                                "example_id": "337afd82-4c76-40fa-9ed5-727817098a6c",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "[…] the Gift of Prophecy […] was in the mind not as an Inhabitant, but as a Guest; that is, by intermittent Returns and Ecstasies, by Occasional Raptures and Revelations; as is clear from what we read of the Prophets in the Old Testament."
                                            },
                                            {
                                                "example_id": "9e682b9b-e7cc-4430-b438-19d6875023bb",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "[…] Pale through night’s curtain gleam’d\nBy fits the lunar intermittent ray,\nThat quiv’ring serv’d to light his lonely steps"
                                            },
                                            {
                                                "example_id": "1f03b47a-5d43-42f3-84ba-a90db18b63a8",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "[…] by degrees the talk became as flickering and intermittent as the light of the dying fire, which they were too idle to feed with sticks […]"
                                            },
                                            {
                                                "example_id": "c0dfdbf7-613a-4999-a052-6500a07326e9",
                                                "sense_id": "e27b2bbe-9326-36a4-bdf5-47286c0d635c",
                                                "text": "[…] three scruffy-looking young men with intermittent facial hair and starvation-symptom physiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727815cb-0aac-3d3a-8c58-2850dbe53eab",
                                        "entry_id": "85e64006-2988-3443-ba26-6eae3419746d",
                                        "glosses": [
                                            "Existing only for certain seasons; that is, being dry for part of the year."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03975447-d762-4c1c-afa2-2ad410872a5c",
                                                "sense_id": "727815cb-0aac-3d3a-8c58-2850dbe53eab",
                                                "text": "The area has many intermittent lakes and streams."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intermittent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f49af6b8-5600-38ab-a983-75265ed8e415",
                                        "entry_id": "ef319732-2f04-37b9-817a-878969344ece",
                                        "glosses": [
                                            "An intermittent fever or disease."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdc03a9f-08cb-43ea-92bf-eefe753e2f4d",
                                                "sense_id": "f49af6b8-5600-38ab-a983-75265ed8e415",
                                                "text": "Feuers, and especially those that are called intermittents, discontinuing agues, euen naturally at the beginning and their first inuasion, cause vomits: and at the declining, sweats."
                                            },
                                            {
                                                "example_id": "d7d996d2-9789-4b54-96f5-a5c014d8d7e8",
                                                "sense_id": "f49af6b8-5600-38ab-a983-75265ed8e415",
                                                "text": "The Bark, which had been ineffectual in the Intermittents of the former Year, was successful in this."
                                            },
                                            {
                                                "example_id": "2abd1458-47ee-4bdd-9f5e-e5bca94dda7c",
                                                "sense_id": "f49af6b8-5600-38ab-a983-75265ed8e415",
                                                "text": "In disease, the agency of this system of vessels is an object of attentive study with the pathologist. To its influence in inflammation, we have already alluded; but it is no less exemplified in the more general diseases of the frame, as in the cold, hot, and sweating stages of an intermittent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
