                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1f034a89-62ac-4c67-be65-f5f20f3fec59",
                        "entry_id": "3fb75b0e-e7c6-3b42-b1ed-9b5d88b58089",
