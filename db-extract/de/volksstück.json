                ],
                "senses": [
                    {
                        "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                        "entry_id": "5b233688-4723-3cbf-af15-258d31b9d4b3",
                        "glosses": [
                            "ein (oft humoristisches, populäres) für das Theater geschriebenes Werk (= Theaterstück) oft mit lokalem Bezug (= Lokalkolorit, beispielsweise bayerisch, Kölsch, hamburgisch); Volkslied"
                        ],
                        "tags": [
                            "Theater",
                            "auch (selten)",
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "fd972eb5-6a7d-4b5d-b891-8e8b82946afb",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Die derberen Unterarten Burleske, Schwank und Posse leben im Volksstück und im Laientheater weiter.“"
                            },
                            {
                                "example_id": "824f89eb-fe82-4334-bc14-08b7934a9a9d",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "[Carl Zuckmayer – Der fröhliche Weinberg (1925):] „Das diesseitsfreudige, derbrealistische Volksstück über eine Liebesepisode im Leben hessischer Weinbauern wird ein durchschlagender Erfolg, der Autor wird dafür mit dem Kleist-Preis ausgezeichnet.“"
                            },
                            {
                                "example_id": "da62f52f-eb53-451e-8ab0-9ff3f10e2fea",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "[Weihnachten in den 1960ern und 1970ern:] „Nicht ohne Grund wurde gerade auch in dieser Zeit mit großem Erfolg im Hamburger Ohnesorgtheater das Volksstück aufgelegt: „Wer nimmt Oma?““"
                            },
                            {
                                "example_id": "9c5887a4-8749-40b8-a46e-c167d6fc01c0",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Seinen ersten Bühnenerfolg erlebte er mit sechs Jahren, als seine Mutter ein bayerisches Volksstück in der Provinz spielte.“"
                            },
                            {
                                "example_id": "b7cdd761-c474-4a8b-91f9-04e40f4e199e",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Um die vertrackte Wechselbeziehung von Ökonomie und Moral geht es in Horvaths Volksstück \"Kasimir und Karoline\".“"
                            },
                            {
                                "example_id": "5973bbcd-7937-446b-9d7d-0723e6ed8a78",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Es ist ein Volksstück über einen Tiroler Bergmann und dessen Frau.“"
                            },
                            {
                                "example_id": "cdd79b1a-21b1-454d-b4d8-368222988583",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Das Theater Chambinzky liegt im Frauenland und präsentiert als Boulevardtheater vor allem Komödien, manchmal Volksstücke, Krimis und Musicals, in eigenen Produktionen.“"
                            },
                            {
                                "example_id": "5afc8982-0ede-4bb3-a8b0-671a08f76ba5",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "[Friedrich Wilhelm III. (Preußen):] „Die Theaterbesuche verschafften ihm auch Gelegenheit, sich anhand der bürgerlichen Volksstücke in die Mentalität seiner Bürger und ihre Stimmungen einzufühlen.“"
                            },
                            {
                                "example_id": "e674685a-6338-412c-97dc-2f7c17dfbc73",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Es ist eine Tradition, die Generationen verbindet - ein ganzer Ort kommt zusammen und inszeniert ein Volksstück: Bis 11. August wird in Öblarn wieder Paula Groggers „Die Hochzeit“ gespielt.“"
                            },
                            {
                                "example_id": "d77fa1d6-7674-421b-b0f9-35098854d39c",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Mit dem Volksstück \"Der Junge von St. Pauli\" feiert er 1970 ebenso Erfolge wie drei Jahre später mit \"Mensch, Kuddel, wach auf!\". Quinn ist insgesamt etwa 1.000 Mal auf der Bühne des St. Pauli Theaters zu sehen.“"
                            },
                            {
                                "example_id": "26711595-8916-4e73-a950-20c34bba52dc",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„«Im Weissen Rössl» entstand ursprünglich 1896 als reines Theaterstück.“ […] „Ein paar Jahre später waren es die Nazis, denen das beliebte Volksstück die Zornesröte ins Gesicht trieb. Die satirischen und teils schlüpfrigen Zwischentöne, die sich über österreichische und deutsche Eigenarten lustig machten, brachten sie auf die Palme.“"
                            },
                            {
                                "example_id": "5ee70bf5-4534-4745-91c3-1f99563e1a53",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Ein Volksstück, ins Schweizerische übertragen: Das erfolgreiche Lustspiel «Fenster zum Flur» von Curth Flatow und Horst Pillau liegt dem Dialektfilm «Im Parterre links» zugrunde.“"
                            },
                            {
                                "example_id": "cdbc1f1a-9159-4484-a3a7-11a7eb1afc41",
                                "sense_id": "e8342528-ecaf-3aa5-98c2-2b38e680a527",
                                "text": "„Zum Abschluss spielten die Philharmoniker das koreanische Volksstück \"Arirang\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
