                                    {
                                        "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                        "entry_id": "1bdbdda3-194b-356d-b43d-460c0fc95f92",
                                        "glosses": [
                                            "Person, die Bücher bindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a68ca2-9d31-4104-9d78-5a43150f5172",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Aber die Buchbinder geben sich kaum die Mühe, Schnittfarben zu mischen. Sie verwenden gern einerlei Farbtöne und vernachlässigen die Ausbildung ihres Farbensinnes. Das ist schade.“"
                                            },
                                            {
                                                "example_id": "e9056e0f-c716-414c-8342-95baf03ea824",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Der Buchbinder wollte wissen, weshalb kein Arbeiter eingeladen war, da es doch um einen Arbeiterverein ginge.“"
                                            },
                                            {
                                                "example_id": "9d21089c-4b7c-41d5-a2e6-7edfed3c579a",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Der Buchbinder war, ohne es vorerst näher eingrenzen zu können, bis um 1505 in Süddeutschland tätig.“"
                                            },
                                            {
                                                "example_id": "81fcd2cb-7a7b-42c8-a9b3-ae32c3825cfb",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Ferner war beim Buchbinder eine Kassette zu bestellen, die zur Aufnahme des Testaments bestimmt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ef46a3a-d661-43ee-be18-5134245a6a63",
                        "source_entry_id": "d3bc0b87-c39e-3be2-88a7-60ab09338c60",
                        "source_sense_id": "fa89c501-17fa-3554-9dc5-37d0640bc641",
