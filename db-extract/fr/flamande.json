                        "entry_id": "ed0ba030-9db1-3cea-986b-fce08e4821d7",
                        "glosses": [
                            "Puits de lumière éclairant la cuisine, traditionnellement pièce aveugle en Lorraine."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "81d51ece-dcbe-4a2c-b278-605127ac79ea",
                                "sense_id": "6954ed79-d169-3c92-96ee-e6357c419a35",
                                "text": "Parfois, une cloison vitrée permettait l’arrivée parcimonieuse de lumière. Le mode le plus fréquent était cependant l’éclairement par au-dessus, grâce à la flamande."
                            }
                        ]
                    }
                ],
