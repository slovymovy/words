                            {
                                "example_id": "968f8f3b-fbbc-44c9-8ae8-c679c89e5713",
                                "sense_id": "22a89ad8-b6b7-3aa7-a8a5-84c229e7905e",
                                "text": "„Als C. sich ihr nähert, legt er die rechte Hand auf die linke Brustseite und verbeugt sich mit der eleganten Geste eines Herrenreiters.“"
                            },
                            {
                                "example_id": "979c2145-1972-4e69-bf1d-b76c90a34429",
                                "sense_id": "22a89ad8-b6b7-3aa7-a8a5-84c229e7905e",
                                "text": "„Er trug einen blauen Frack, ein Ordenskreuz um den Hals und einen Stern auf der linken Brustseite.“"
                            }
                        ],
