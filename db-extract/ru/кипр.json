                                        "entry_id": "caffd2e7-3cb6-306c-9005-0b4944f933c7",
                                        "glosses": [
                                            "Akdeniz'in üçüncü büyük adası."
                                        ],
                                        "tags": [
                                            "adalar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67bd9d5-c836-4a01-a00e-9e5b50b64820",
                                                "sense_id": "371ccc3d-1d9c-3612-90bd-dc024c3cd287",
                                                "text": "Kıbrıs'ın kuzeyinde Türkiye, doğusunda Suriye, güneydoğusunda İsrail ve Lübnan, güneyinde Mısır ve kuzeybatısında Yunanistan yer alır."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa1c0b7-2981-41c7-9005-74642f2951f8",
                        "source_entry_id": "a9c5159b-ab8a-39d7-b183-9c6eb6c7fb24",
                        "source_sense_description": "остров",
                        "target_lang_word": "Chypre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chypre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a658d56-67aa-3652-b186-51c3f73e3392",
                                        "entry_id": "8144e000-5315-3f78-b6c2-36b12dc73b44",
                                        "glosses": [
                                            "Grande île située en Méditerranée orientale, au large des côtes de la Turquie, de la Syrie, et du Liban."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37409d34-413b-48b0-989e-9482d253fcbd",
                                                "sense_id": "3a658d56-67aa-3652-b186-51c3f73e3392",
                                                "text": "Le Cardinal. – Êtes-vous vierge ? n’y a-t-il plus de vin de Chypre ? n’avez-vous pas au fond de la mémoire quelque joyeuse chanson ? n’avez-vous pas lu l’Arétin ?"
                                            },
                                            {
                                                "example_id": "b34f5db6-58d0-40d0-824a-fa229960206c",
                                                "sense_id": "3a658d56-67aa-3652-b186-51c3f73e3392",
                                                "text": "Dans la partie orientale de la Méditerranée s’étend une île aujourd’hui presque déserte, autrefois fameuse : je veux parler de Chypre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b3c787d-6f4d-34f1-ba45-b66c099a7096",
                                        "entry_id": "8144e000-5315-3f78-b6c2-36b12dc73b44",
                                        "glosses": [
                                            "République chypriote, dont la capitale est Nicosie, occupant une partie de cette île, exception faite de la République turque de Chypre du Nord et des deux zones de souveraineté britanniques de Dhekelia et Akrotiri."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
