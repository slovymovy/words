                                "example_id": "db1ca89a-2707-47c3-80a5-7efbf0158af8",
                                "sense_id": "116677c3-b10d-397a-815c-7a33b665235b",
                                "text": "We stonden vroeg op om de zonsopkomst te zien.",
                                "translation": "We got up early to see the sunrise.",
                                "english": "We got up early to see the sunrise."
                            },
                            {
                                "example_id": "6ac6873c-8f23-43e2-9ce6-ad6df6fd4327",
                                "sense_id": "116677c3-b10d-397a-815c-7a33b665235b",
                                "text": "De kleuren van de zonsopkomst waren adembenemend.",
                                "translation": "The colors of the sunrise were breathtaking.",
                                "english": "The colors of the sunrise were breathtaking."
                            },
                            {
                                "example_id": "ad12f43a-60ed-41a1-9249-6d8f749cb336",
                                "sense_id": "116677c3-b10d-397a-815c-7a33b665235b",
                                "text": "Elke zonsopkomst op het strand is uniek.",
                                "translation": "Every sunrise on the beach is unique.",
                                "english": "Every sunrise on the beach is unique."
                            }
                        ]
                    }
