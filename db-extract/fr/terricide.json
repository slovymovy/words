                        "entry_id": "b1dd7e4d-48e0-382a-b601-a43c91733e9e",
                        "glosses": [
                            "Destruction des écosystèmes visibles et des écosystèmes perceptifs qui régulent la vie sur Terre, conséquence d’un modèle de civilisation fondé sur l’industrialisation, la croissance illimitée et la domination de la nature, qui réduit la planète à un objet exploitable et ignore les liens subtils qui soutiennent la vie."
                        ],
                        "tags": [
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f63bd455-dcc1-4f78-8f80-d821ea3ac254",
                                "sense_id": "61e2e9d5-1f19-3db2-af39-df3d6eca548b",
                                "text": "Le mot de terricide regroupe toutes les façons dont on élimine la vie. Et toutes les formes de vie, humaine ou non humaine, de la Palestine à l’Ukraine, en passant par la Patagonie."
                            }
                        ]
                    }
