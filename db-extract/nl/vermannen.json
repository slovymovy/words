            {
                "entry_id": "664fcde9-1043-3b55-8988-0f01b3379d90",
                "word": "vermannen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "152ea1c4-b7dc-3da8-bf6f-7013354ff3dc",
                        "entry_id": "664fcde9-1043-3b55-8988-0f01b3379d90",
                        "glosses": [
                            "jezelf de baas worden, je ergens overheen zetten, je best doen, de moed vatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932688ad-b32f-4f28-815d-594755e56f2b",
                                "sense_id": "152ea1c4-b7dc-3da8-bf6f-7013354ff3dc",
                                "text": "Hun huwelijk was dus niet kansloos. Morten was het aan haar verplicht om zich te vermannen en niet te blijven hangen in zijn verdriet om Evelien. Misschien was het al wat aan het slijten. Vanmorgen tijdens het hardlopen had hij nauwelijks aan haar gedacht."
                            },
                            {
                                "example_id": "07d86345-68c1-4e12-a608-099c4e617922",
                                "sense_id": "152ea1c4-b7dc-3da8-bf6f-7013354ff3dc",
                                "text": "Ik had zin om te roepen dat ze zich moest vermannen. Ik wist hoe charmant ze kon zijn, hoe goed ze er juist in was om met andere mensen rond een tafel te zitten praten, vertellen, lachen. Aan de andere kant, realiseerde ik me net op tijd, hoe gedroeg ik me eigenlijk als we een paar vrienden van haar ontmoetten die ik niet zo goed kende? Zwijgzaam en ontoegankelijk en verlegen, iemand die daar tijdens de hele maaltijd kon zitten zonder meer dan het absoluut noodzakelijke te zeggen."
                            },
                            {
                                "example_id": "29b4be90-e8fb-4dcf-8ccb-b9474dc73ee6",
                                "sense_id": "152ea1c4-b7dc-3da8-bf6f-7013354ff3dc",
                                "text": "Sommige managers hebben hun klachten gebagatelliseerd en hen gedwongen de pijn te verbijten. Als arbeiders tegen managers over pijn klaagden, antwoordden die volgens Sanchez: ‘We hebben allemaal pijn. Kun je je niet vermannen?’ Alan Ochoa, die door een blessure nu met ziekteverlof is, zegt dat de managers ‘de productieaantallen belangrijker vonden dan de veiligheid en het welzijn van de medewerkers’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc5c056c-fec9-44df-9e4d-baf28943ac71",
                        "source_entry_id": "664fcde9-1043-3b55-8988-0f01b3379d90",
                        "source_sense_id": "152ea1c4-b7dc-3da8-bf6f-7013354ff3dc",
                        "source_sense_description": "jezelf ergens overheen zetten",
                        "target_lang_word": "take heart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "take heart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c49239f4-45bc-3833-aeaf-26c6ab20c4c6",
                                        "entry_id": "9d689081-2cf7-3d17-825a-df587aa0326f",
                                        "glosses": [
                                            "To be courageous; to regain one's courage."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3db7e8d2-dd79-4e3d-a98d-f4f89d264996",
                                                "sense_id": "c49239f4-45bc-3833-aeaf-26c6ab20c4c6",
                                                "text": "I took heart in the assurance that the issue was already solved."
                                            },
                                            {
                                                "example_id": "18ab1d2d-210b-48b3-b4d5-9e0f3fb10827",
                                                "sense_id": "c49239f4-45bc-3833-aeaf-26c6ab20c4c6",
                                                "text": "England will not be catapulted among the favourites for Euro 2012 as a result of this win, but no victory against Spain is earned easily and it is right they take great heart from their efforts as they now prepare to play Sweden at Wembley on Tuesday."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "take heart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "811c3b0a-f444-3e0f-b394-3dc248a6ca0d",
                                        "entry_id": "7417fa64-5304-3e42-9e90-43fb8127c617",
                                        "glosses": [
                                            "Used when encouraging someone to bear or take up a difficult situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba570da-fba4-4d99-a2ea-fae9d1fdd77a",
                                                "sense_id": "811c3b0a-f444-3e0f-b394-3dc248a6ca0d",
                                                "text": "Take heart, help will arrive shortly and everything will be fine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
