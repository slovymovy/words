                        "cross_references": [
                            {
                                "target_word": "pasteurisation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd9ae000-a868-3ece-9e4a-e3f56d55778b",
                                        "entry_id": "d2d65561-2b1d-3525-97df-b2b66ae39b02",
                                        "glosses": [
                                            "Heat-treatment of a perishable food to destroy heat-sensitive vegetative cells followed by immediate cooling to limit growth of the surviving cells and germination of spores."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb28bfd8-c056-4bee-a25b-dd9e973a01ce",
                                                "sense_id": "dd9ae000-a868-3ece-9e4a-e3f56d55778b",
                                                "text": "Lorries collect the milk from the various outlying farms, whence it is taken to the district distribution centre to undergo pasteurisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
