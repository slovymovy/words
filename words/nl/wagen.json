                            },
                            {
                                "target_lang_word": "cart",
                                "target_lang_sense_clarification": "a smaller, often two-wheeled vehicle for carrying goods"
                            },
                            {
                                "target_lang_word": "carriage",
                                "target_lang_sense_clarification": "a horse-drawn vehicle primarily for transporting people"
                            }
                        ]
