                    {
                        "translation_id": "6fd24140-8cc6-478e-9682-4d6ede626799",
                        "source_entry_id": "eb822718-7352-3717-9993-2cb05f46d5c5",
                        "source_sense_id": "b59026d8-3756-35c4-bf5a-ea31f2e890ec",
                        "source_sense_description": "regional (Maghreb): junger Mann",
                        "target_lang_word": "Mann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2162a7fb-b1ce-3235-ad1d-aa37e61ea9b1",
                                        "entry_id": "ae361399-8b4f-3269-8372-ed8a89c99f37",
                                        "glosses": [
                                            "erwachsener, männlicher Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea8056c-d093-407d-8f8f-ee3cc950b7c2",
                                                "sense_id": "2162a7fb-b1ce-3235-ad1d-aa37e61ea9b1",
                                                "text": "Er ist ein kluger Mann."
                                            },
                                            {
                                                "example_id": "09697549-a312-4cb1-934b-7970661ed720",
                                                "sense_id": "2162a7fb-b1ce-3235-ad1d-aa37e61ea9b1",
                                                "text": "„Ich stand da im Laden und blickte auf die frischen Morgenzeitungen, auf die die meisten Männer so verrückt sind.“"
                                            },
                                            {
                                                "example_id": "a2302e59-2d7e-4f8f-9cb0-373b5f33cde6",
                                                "sense_id": "2162a7fb-b1ce-3235-ad1d-aa37e61ea9b1",
                                                "text": "„Die Teilnehmer setzten sich aus Männern und Matronen der älteren Behördenschaft zusammen, die mehr oder weniger maßgebliche Funktionen als Büroreferenten, Sachbearbeiter, Protokollführer und dergleichen ausübten.“"
                                            },
                                            {
                                                "example_id": "3c4d45aa-8dfe-4652-90f9-b8b446693f4f",
                                                "sense_id": "2162a7fb-b1ce-3235-ad1d-aa37e61ea9b1",
                                                "text": "„Rolande dirigierte zwei Mädchen mit einer leichten Hndbewegung zu einem Mann hinüber, der auf einer Banquette saß und schlief.“"
                                            },
                                            {
                                                "example_id": "f269ba06-feeb-4645-b717-7aa27dae6105",
                                                "sense_id": "2162a7fb-b1ce-3235-ad1d-aa37e61ea9b1",
                                                "text": "„Ist der Unterschied zwischen Männern und Frauen ein Fantasieprodukt, wie das Kastensystem in Indien oder die Rassentrennung in den Vereinigten Staaten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dc78f060-ed3f-3e4e-b3ca-acccb59c530f",
                                        "entry_id": "ae361399-8b4f-3269-8372-ed8a89c99f37",
                                        "glosses": [
                                            "verheiratete, männliche Person in Beziehung zu der anderen Ehepartei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c7516f-670a-499c-8ec4-065148180235",
                                                "sense_id": "dc78f060-ed3f-3e4e-b3ca-acccb59c530f",
                                                "text": "Nach ihrer Hochzeit lebten sie als Mann und Frau bis an ihr Ende."
                                            },
                                            {
                                                "example_id": "d074d6ca-1606-4cd5-a44d-7d627030185a",
                                                "sense_id": "dc78f060-ed3f-3e4e-b3ca-acccb59c530f",
                                                "text": "Darf ich vorstellen? Mein Mann."
                                            },
                                            {
                                                "example_id": "45035a7f-6516-43e9-94c7-8bc0f2c31f74",
                                                "sense_id": "dc78f060-ed3f-3e4e-b3ca-acccb59c530f",
                                                "text": "„Ist der Unterschied zwischen Männern und Frauen ein Fantasieprodukt, wie das Kastensystem in Indien oder die Rassentrennung in den Vereinigten Staaten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e28ea4b-2c64-3d35-bad8-cf41ebb96592",
                                        "entry_id": "ae361399-8b4f-3269-8372-ed8a89c99f37",
                                        "glosses": [
                                            "allgemeiner Zahlklassifikator für Personen"
                                        ],
                                        "tags": [
                                            "mit ungebeugtem Plural im militärischen, seemännischen und ähnlichen Sprachgebrauch mit Formen wie ›zwei Mann‹"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655aba53-3009-4888-b06b-45e273b7ce47",
                                                "sense_id": "6e28ea4b-2c64-3d35-bad8-cf41ebb96592",
                                                "text": "Ich brauche zwei Mann für diese Arbeit."
                                            },
                                            {
                                                "example_id": "3b0ff577-127a-4649-a111-9d8b02b7c48b",
                                                "sense_id": "6e28ea4b-2c64-3d35-bad8-cf41ebb96592",
                                                "text": "Alle Mann an Deck!"
                                            },
                                            {
                                                "example_id": "091dd046-0ec6-4d1f-a3fe-ed932149bee3",
                                                "sense_id": "6e28ea4b-2c64-3d35-bad8-cf41ebb96592",
                                                "text": "Hundert Mann und ein Befehl."
                                            },
                                            {
                                                "example_id": "3287298f-f584-49ad-b210-fd91f3a3f641",
                                                "sense_id": "6e28ea4b-2c64-3d35-bad8-cf41ebb96592",
                                                "text": "„Zwangsläufig war es mit diesen zwei Mann, die ebenfalls berufstätig waren, nicht mehr möglich, den Umfang an Arbeit, der sich vorher auf 6 Mann verteilte, in Zukunft weiterhin zu erledigen.“"
                                            },
                                            {
                                                "example_id": "4ef2bca4-1c2e-4d4e-b3f7-2d8271843617",
                                                "sense_id": "6e28ea4b-2c64-3d35-bad8-cf41ebb96592",
                                                "text": "„Sechsunddreißig Divisionen im Gesamtumfang von 1,5 Millionen Mann sollten für das Unternehmen bereitgestellt werden, mit Luftwaffe, Marine und Logistik-Einheiten alles in allem fünf Millionen Mann, eine Streitmacht, die doppelt so groß war wie jene, die Stalin zu Beginn des Jahres gegen Berlin aufgeboten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "55970b22-303b-3812-a790-39755a7f3c33",
                                        "entry_id": "ae361399-8b4f-3269-8372-ed8a89c99f37",
                                        "glosses": [
                                            "Ausruf des Erstaunens oder der Verärgerung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "889ec979-0e21-4e39-9c9d-1125d49776ad",
                                                "sense_id": "55970b22-303b-3812-a790-39755a7f3c33",
                                                "text": "Mann, bist du blöd!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1366b0d1-ea66-373f-a277-5dc9a9a21d98",
                                        "entry_id": "ae361399-8b4f-3269-8372-ed8a89c99f37",
                                        "glosses": [
                                            "Mitglied einer Anhängerschaft, Gefolgschaft von jemandem"
                                        ],
                                        "tags": [
                                            "Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa330145-0eb9-480a-bdce-3bb9e62f6432",
                                                "sense_id": "1366b0d1-ea66-373f-a277-5dc9a9a21d98",
                                                "text": "Er rief seine Mannen zusammen."
                                            },
                                            {
                                                "example_id": "1cacc8c6-b8b7-4860-b35f-d3f063ceb253",
                                                "sense_id": "1366b0d1-ea66-373f-a277-5dc9a9a21d98",
                                                "text": "„Herr Wilhelm und seine Mannen vom Stubnblues bereiten sich auf einen stimmungsvollen Abend in der Arena vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6166fa4c-a340-3c92-80f9-24e7db84e1ae",
                                        "entry_id": "ae361399-8b4f-3269-8372-ed8a89c99f37",
                                        "glosses": [
                                            "einzelne Person"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9f64aa-a685-4120-b3f9-f693ba1a7942",
                                                "sense_id": "6166fa4c-a340-3c92-80f9-24e7db84e1ae",
                                                "text": "Sie hatten wegen des warmen Wetters Mühe, ihre Winterware an den Mann zu bringen."
                                            },
                                            {
                                                "example_id": "d0cbea4e-c6eb-421b-a72f-e7267445665a",
                                                "sense_id": "6166fa4c-a340-3c92-80f9-24e7db84e1ae",
                                                "text": "„Fast Mann an Mann standen sie an den Hauswänden und auf dem Rande des Gehsteigs: Händler, Bettler, Dirnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                        "entry_id": "1a649334-b58d-38ec-88e0-22846e69acdd",
                                        "glosses": [
