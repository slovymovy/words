                    {
                        "sense_id": "7b4ea161-91ed-341a-9ee9-bd534227932a",
                        "entry_id": "a098172f-e219-35d1-878c-512597af951e",
                        "glosses": [
                            "Ersetzung eines Phonems durch ein anderes bei der Aussprache eines Wortes, ohne dass dadurch die Bedeutung des Wortes verändert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23012c0-0a49-4a94-a030-06e43db49054",
                                "sense_id": "7b4ea161-91ed-341a-9ee9-bd534227932a",
                                "text": "„Die Autoren dieser Neuauflage sehen es als eine wesentliche Aufgabe und Leistung dieses Werkes an, Phonemvariation zu erfassen und zu dokumentieren.“"
                            },
                            {
                                "example_id": "f89153e9-e227-406d-b984-619b04121490",
                                "sense_id": "7b4ea161-91ed-341a-9ee9-bd534227932a",
                                "text": "„Meist sind es Verben auf -ieren, die durch Stammreduzierung, gelegentlich auch begleitet von Phonemvariation, gekürzt werden, vgl. funktionieren > funzen, fotografieren > foten, registrieren > reggen.“"
                            }
                        ],
