                        "translation_id": "1dfe73d2-cb2c-415f-a692-c39fd5e1938d",
                        "source_entry_id": "b4a35d39-5914-3fd2-9b48-e7e3e929a4f7",
                        "source_sense_id": "9dfe04ee-93ad-33e6-89e5-f33378af1859",
