        "fr-extract.jsonl": [
            {
                "entry_id": "fc31647c-659c-3bea-91ec-d6015d9bf205",
                "word": "cénotaphe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0142a6f3-2b5b-47ca-b0ae-4e9268cde21a",
                        "entry_id": "fc31647c-659c-3bea-91ec-d6015d9bf205",
                        "tags": [
                            "plural"
                        ],
                        "form": "cénotaphes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                        "entry_id": "fc31647c-659c-3bea-91ec-d6015d9bf205",
                        "glosses": [
                            "Tombeau vide, dressé à la mémoire et en l’honneur d’un mort (ou d’un ensemble de morts) dont le corps est perdu ou enterré quelque part ailleurs, contrairement au mausolée qui contient le corps directement."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "b511cd71-08ee-4c61-8de4-eddda5124cc8",
                                "sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                                "text": "J’eus le chagrin de voir que le tombeau de Ménandre, le cénotaphe d’Euripide et le petit temple dédié à Socrate n’existaient plus."
                            },
                            {
                                "example_id": "41da19f2-394e-470f-9ec0-b7d15c28a47d",
                                "sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                                "text": "Un cénotaphe lui fut élevé dans la Gaule, et un tombeau magnifique dans Rome."
                            },
                            {
                                "example_id": "6200fe20-e507-47b7-a862-b44f2ee66acb",
                                "sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                                "text": "On citait d’elles plusieurs beaux traits dont la cendre de Montyon avait dû tressaillir dans son beau cénotaphe."
                            },
                            {
                                "example_id": "f7cc19ef-b7ee-41c6-bfe1-213d88b73ee1",
                                "sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                                "text": "Pourtant, ici, il n’y a pas de tombe. Il n’y a qu’une pierre. Et ce n’est même pas une pierre tombale. C’est un cénotaphe."
                            },
                            {
                                "example_id": "a033081a-c806-4901-a07c-1a5c3744752b",
                                "sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                                "text": "Au moment où les six chevaliers du deuil, baissant la pointe de l’épée, entraient dans le chœur pour se ranger autour du cénotaphe, un moine parut tout à coup derrière le cercueil vide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "280979ad-fb87-45ae-a7de-28ac9309e322",
                        "source_entry_id": "fc31647c-659c-3bea-91ec-d6015d9bf205",
                        "source_sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                        "target_lang_word": "Kenotaph",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kenotaph",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd75fda7-21ae-31de-903f-0d981efc818d",
                                        "entry_id": "c76703b9-9d33-31bf-a00d-0cfa2b486656",
                                        "glosses": [
                                            "ein Grabmal, zur Erinnerung an einen Verstorbenen, der dort aber nicht begraben ist; Scheingrab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eda2a2c-d079-4077-b701-90bde2cab399",
                                                "sense_id": "bd75fda7-21ae-31de-903f-0d981efc818d",
                                                "text": "Das Kenotaph Sethos I. liegt in Abydos (Ägypten)."
                                            },
                                            {
                                                "example_id": "f11ffcaf-c0fc-4b76-b493-f992d4ccd86e",
                                                "sense_id": "bd75fda7-21ae-31de-903f-0d981efc818d",
                                                "text": "\"Hier errichtete Herodes dem Urvater ein Scheingrab, ein Kenotaph.\""
                                            },
                                            {
                                                "example_id": "a73d115f-5a8f-4363-948e-40d55301fbea",
                                                "sense_id": "bd75fda7-21ae-31de-903f-0d981efc818d",
                                                "text": "„Es ist nicht eindeutig zu klären, ob dieses Grab belegt und ausgeraubt wurde oder ein Kenotaph (Scheingrab zum Gedächtnis an einen Toten) war.“"
                                            },
                                            {
                                                "example_id": "95da4a13-8130-4437-918b-75ad35553085",
                                                "sense_id": "bd75fda7-21ae-31de-903f-0d981efc818d",
                                                "text": "„Die Stadt war von überwältigender Fremdartigkeit. Ihre unwirklichen Turmspitzen bohrten sich in einen rabenschwarzen Himmel, und all die tausend Gebäude darunter, glatt wie jene Türme, waren Monolithen und Kenotaphe und Obelisken, ohne Fenster oder Türen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa85ffe-effa-4368-95d2-75860e593a8a",
                        "source_entry_id": "fc31647c-659c-3bea-91ec-d6015d9bf205",
                        "source_sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                        "target_lang_word": "Ehrenmal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehrenmal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cef0e64-5fbf-33c0-8c31-974928c10066",
                                        "entry_id": "c132ad8d-31ce-3e48-bab5-464a95679502",
                                        "glosses": [
                                            "Denkmal zu Ehren von jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34539815-d392-4bbd-9b33-6a76a2243a6f",
                                                "sense_id": "5cef0e64-5fbf-33c0-8c31-974928c10066",
                                                "text": "„Wir bogen dann von der Mauer weg und fuhren an einem Sowjetischen Ehrenmal vorbei.“"
                                            },
                                            {
                                                "example_id": "f8b9e846-caaa-41b7-8eaf-70b3f78e587f",
                                                "sense_id": "5cef0e64-5fbf-33c0-8c31-974928c10066",
                                                "text": "„Das Ehrenmal, in den Grünanlagen am Obertorwall, am 18.8.1931 enthüllt, ist heute Mahnmal der Gefallenen des I. und II. Weltkrieges sowie der nationalsozialistischen Gewaltherrschaft.“"
                                            },
                                            {
                                                "example_id": "31f73ca3-8bfa-44f8-9e5d-d0285714067e",
                                                "sense_id": "5cef0e64-5fbf-33c0-8c31-974928c10066",
                                                "text": "„1924 wurde deren berühmtestem Professor, Immanuel Kant, zum 200. Geburtstag ein neues, pompöses Ehrenmal spendiert; es stiftete ein westdeutscher Industrieller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcf5a10d-65e8-4092-ac0c-2596c15bb982",
                        "source_entry_id": "fc31647c-659c-3bea-91ec-d6015d9bf205",
                        "source_sense_id": "bfa9dae9-cbcf-3577-9468-b3183e2aad8c",
                        "target_lang_word": "cenotaph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cenotaph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                        "entry_id": "eab42f22-acae-331c-ac34-4ffdd679ce07",
                                        "glosses": [
                                            "A monument, generally in the form of an empty tomb, erected to honour the dead whose bodies lie elsewhere, especially members of the armed forces who died in battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03197407-f6bb-46e6-b438-8a5895a7b0fb",
                                                "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                                "text": "On Remembrance Sunday (November 14), [...]. A special service was held at Ayr station that afternoon, to allow people to pay their respects after attending the Ayr cenotaph that morning."
                                            },
                                            {
                                                "example_id": "1dcfcb32-1ca8-4ec2-bbec-ad68aeae2766",
                                                "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                                "text": "A cenotaph was erected for him in Gaul, while his body was taken to Rome and inclosed in a magnificent tomb."
                                            },
                                            {
                                                "example_id": "fc5b5d72-3fc9-4756-9f52-17d80c7c5e65",
                                                "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                                "text": "[…] tombs and cenotaphs were strewed thick around adorned by every renewing vegetation; […]"
                                            },
                                            {
                                                "example_id": "d2135a83-6879-400a-8cbd-aca9cac283dc",
                                                "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                                "text": "I am the daughter of Earth and Water,\n And the nursling of the Sky;\n I pass through the pores of the ocean and shores;\n I change, but I cannot die.\n For after the rain when with never a stain\n The pavilion of Heaven is bare,\n And the winds and sunbeams with their convex gleams\n Build up the blue dome of air,\n I silently laugh at my own cenotaph,\n And out of the caverns of rain,\n Like a child from the womb, like a ghost from the tomb,\n I arise and unbuild it again."
                                            },
                                            {
                                                "example_id": "f16d33be-0ad6-4dba-9525-db4b486cb53e",
                                                "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                                "text": "But age is heart-wearied and tempest-torn: it is the crumbling cenotaph of fear and hope!"
                                            },
                                            {
                                                "example_id": "182a39f5-fe4b-4cc2-96e2-85125d67fb55",
                                                "sense_id": "590237cf-ffc6-35cc-a22f-604d999feee3",
                                                "text": "A tomb from which the body is absent, living elsewhere. The grave whose headstone bore the famous inscription,\n Here lies me two children dear\n One in ould Ireland, t'other one here.\nwas a cenotaph, so far as regarded the \"One in ould Ireland\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
