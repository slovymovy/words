                "senses": [
                    {
                        "sense_id": "8c242246-1516-3510-a9c3-26ff6113c4cb",
                        "entry_id": "0bb23732-a1cb-3f7e-a646-67be3d52bf81",
                        "glosses": [
                            "Describing the chemical composition or temperature of a mixture of substances that gives the lowest temperature at which the mixture becomes fully molten. A further requirement is that that temperature is lower than the melting point of any of the pure component substances."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0ddb2740-c34c-392e-8df2-230f6d7e3930",
                        "entry_id": "0bb23732-a1cb-3f7e-a646-67be3d52bf81",
                        "glosses": [
                            "Describing the thermodynamic equilibrium conditions where a liquid coexists with two solid phases."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "46a2192b-e09b-4ffe-bc68-1f377cfdd9ce",
                                "sense_id": "0ddb2740-c34c-392e-8df2-230f6d7e3930",
                                "text": "For a mixture with two components at a fixed pressure, the eutectic reaction can only happen at a fixed chemical composition and temperature, called the eutectic point."
                            }
                        ]
                    }
                ],
