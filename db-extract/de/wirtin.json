                        "form": "den Wirtinnen"
                    },
                    {
                        "form_id": "96526f07-c8fa-4d88-a5a8-633dfd47e602",
                        "entry_id": "04b75c57-0427-3714-a070-e77378802096",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Wirtin"
                    },
                    {
                        "form_id": "8cf188e8-8a98-4be7-bb74-decef9472298",
                        "entry_id": "04b75c57-0427-3714-a070-e77378802096",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Wirtinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c70a46b-bc72-334e-bbef-94127b3db3b9",
                        "entry_id": "04b75c57-0427-3714-a070-e77378802096",
                        "glosses": [
                            "weibliche Person, die privat oder kommerziell Gäste bewirtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fb2b86-3127-4483-a0e9-4a9f72c63d5c",
                                "sense_id": "2c70a46b-bc72-334e-bbef-94127b3db3b9",
                                "text": "„Die Wirtin beschied mich recht.“"
                            },
                            {
                                "example_id": "3d2037c9-b1c0-45da-bb08-10bce1f4b74d",
                                "sense_id": "2c70a46b-bc72-334e-bbef-94127b3db3b9",
                                "text": "„Der Wirt sieht was und ruft die Wirtin, die sieht auch was.“"
                            },
                            {
                                "example_id": "b465f7bf-9956-45b9-a59d-b6382753999e",
                                "sense_id": "2c70a46b-bc72-334e-bbef-94127b3db3b9",
                                "text": "„Die Wirtin mußterte uns mißtrauisch.“"
                            },
                            {
                                "example_id": "1d4e4677-5e21-4e71-b5db-cdb293d9a89e",
                                "sense_id": "2c70a46b-bc72-334e-bbef-94127b3db3b9",
                                "text": "„Der Erste Offizier – ein Ausländer, wenngleich ich nie herausfand, aus welchem Land – wohnte in einem Haus, das von einer hübschen Wirtin geführt wurde.“"
                            },
                            {
                                "example_id": "79291273-5ace-4ee2-b714-c7e0f82a6357",
                                "sense_id": "2c70a46b-bc72-334e-bbef-94127b3db3b9",
                                "text": "„Die Wirtin rechnete mir noch die Gebühren für ein Telegramm an, das ich abends nach Bonn an Monika Silvs aufgegeben, das Kostert zu bezahlen sich geweigert hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "72103458-f556-367d-83e3-fe3fd019d2f3",
                        "entry_id": "04b75c57-0427-3714-a070-e77378802096",
                        "glosses": [
                            "weibliche Person, die Wohnraum vermietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9499670-7e63-46c8-a79f-91690fc938ae",
                                "sense_id": "72103458-f556-367d-83e3-fe3fd019d2f3",
                                "text": "„Als seriös wird es jedem Untermieter angerechnet, wenn er seiner Wirtin mit Rat und Tat gegen die Nachbarin beisteht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
