                    {
                        "translation_id": "dac52049-b9fb-4550-bbba-6d0c25c531dc",
                        "source_entry_id": "ce547481-e6f1-333a-baed-fdfcfc8a3116",
                        "source_sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                        "source_sense_description": "Geologie, Umwelttechnik: die Wärme, die im zugänglichen Teil der Erdkruste gespeichert ist",
                        "target_lang_word": "geothermy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geothermy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c41f040-ef9e-3406-943f-e4f7ecf98b6d",
                                        "entry_id": "841694ca-7e67-3ee3-8943-fc7bcd281f8e",
                                        "glosses": [
                                            "The heat produced by the natural processes of the Earth, including heat from the undercrust, plate tectonics, volcanism, and other sources."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e27e8c1b-56e8-3989-bdf3-0d27555c0462",
                                        "entry_id": "841694ca-7e67-3ee3-8943-fc7bcd281f8e",
                                        "glosses": [
                                            "The process and practice of harvesting heat produced by the Earth to be used as an energy source."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93c72f0b-eb07-325b-a365-2e7b850899fa",
                                        "entry_id": "841694ca-7e67-3ee3-8943-fc7bcd281f8e",
                                        "glosses": [
                                            "The study of heat produced naturally by the Earth, usually considered a subdiscipline of geophysics."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52344a10-95e0-46a9-b4ac-da958cfe4f93",
                                                "sense_id": "93c72f0b-eb07-325b-a365-2e7b850899fa",
                                                "text": "A method was worked out by the Geothermy Laboratory of the O. Yu. Schmidt institute of Earth Physics (Lyubimova et al., 1964 b) which utilizes the principles of heat convection from a momentary linear source (Tikhonov, Samarskiy, 1953)."
                                            },
                                            {
                                                "example_id": "3b7ffa1d-0c8c-47c3-9ee4-400db3e82067",
                                                "sense_id": "93c72f0b-eb07-325b-a365-2e7b850899fa",
                                                "text": "However, in geothermy, as in any other area of geophysics, it is often necessary to solve an inverse problem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40098878-fad5-4be6-ba70-33eab209d7b1",
                        "source_entry_id": "ce547481-e6f1-333a-baed-fdfcfc8a3116",
                        "source_sense_id": "3e02544f-ebbe-3565-a90e-6b8dd090b060",
                        "source_sense_description": "Geologie, Umwelttechnik: die Wärme, die im zugänglichen Teil der Erdkruste gespeichert ist",
                        "target_lang_word": "géothermie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géothermie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d345e3f-b9e1-3c2d-be41-1ca4132d4082",
                                        "entry_id": "508447cf-ea11-3d62-abab-073e099e1ccb",
                                        "glosses": [
                                            "Science qui étudie les phénomènes thermiques internes du globe terrestre et la technique qui vise à l’exploiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c9c458e-4b6d-41e4-8c20-9d8b195d4a0c",
                                                "sense_id": "6d345e3f-b9e1-3c2d-be41-1ca4132d4082",
                                                "text": "À l’exception de l’énergie nucléaire, de la géothermie et de l’énergie marémotrice, l’énergie solaire est à l’origine de toutes les énergies sur Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5f37c6c-8736-3dcd-b426-975b474d12f2",
                                        "entry_id": "508447cf-ea11-3d62-abab-073e099e1ccb",
                                        "glosses": [
                                            "Énergie géothermique issue de l’énergie de la Terre qui récupère la chaleur puis la convertit éventuellement en électricité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1132384c-de76-433c-83ea-36c932a8549b",
                                                "sense_id": "a5f37c6c-8736-3dcd-b426-975b474d12f2",
                                                "text": "Saisissons cette opportunité pour accélérer à Saint-Cloud l’implantation de panneaux photovoltaïques sur les toits de nos bâtiments, installons des ombrières et lançons un projet de géothermie afin de se chauffer grâce à nos sous-sols !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
