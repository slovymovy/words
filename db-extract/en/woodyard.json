                        "cross_references": [
                            {
                                "target_word": "Holzplatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01ff0d6d-05e5-346d-953b-6e7ea3a008bb",
                                        "entry_id": "4eb50996-be21-3a68-8e12-6cee96a1fde0",
                                        "glosses": [
                                            "Platz zur Aufbewahrung/Lagerung von Brenn- oder Bauholz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b882b9-831c-40e4-90b7-b04dbab97e79",
                                                "sense_id": "01ff0d6d-05e5-346d-953b-6e7ea3a008bb",
                                                "text": "„Bei der Arbeit auf dem Holzplatz wird die Arbeitszeit von zehn Stunden nie genau eingehalten, da oftmals kurz vor Feierabend noch Waggons kommen, die gleich abgeladen werden müssen.“"
                                            },
                                            {
                                                "example_id": "5b3ee58f-523e-481d-811b-55b7fbb9b297",
                                                "sense_id": "01ff0d6d-05e5-346d-953b-6e7ea3a008bb",
                                                "text": "„Ich kann zu Fuß zur Lände gehn – das heißt zum Supermarkt und zur Bar – auf der einzigen Piste oder querweg durch die Insel, durch bemooste flache Felsen und waldige Moore, an Holzplätzen, Lichtungen, Scheunen vorbei nach Kallalä, wo die Anlegestelle der südlichen Fähren ist.“"
                                            }
                                        ],
