                "senses": [
                    {
                        "sense_id": "f81d8c05-b31b-35b9-bb34-99f611298e12",
                        "entry_id": "5052aba2-4de5-3766-af79-04d7dd061573",
                        "glosses": [
                            "een ornament dat in of op het oor aangebracht wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86abb27-511a-4d79-b9dc-043c4318691c",
                                "sense_id": "f81d8c05-b31b-35b9-bb34-99f611298e12",
                                "text": "Hij had een oorbelletje in zijn rechteroor."
                            },
                            {
                                "example_id": "7448a025-d37d-4166-ab4e-55b9b143ce48",
                                "sense_id": "f81d8c05-b31b-35b9-bb34-99f611298e12",
                                "text": "Natuurlijk had ik Clio onderschat. In plaats van de deur open te doen in verhuis-T-shirt en joggingbroek verscheen zij, alsof ze wist dat dit haar eerste opkomst zou zijn in mijn boek, als een vrouw die weet hoe zij haar entree moet maken, in een spectaculair kort zwart jurkje van Elsa Schiaparelli, dat was afgezet met een bloemmotief van witte glaskraaltjes en een wufte kraag van witte raffia, met daarbij zwarte open schoenen met een hoge hak van Fendi en lange, hangende, zilveren oorbellen van Gucci."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e88a6f86-1bd9-4cf3-909f-103461730231",
                        "source_entry_id": "5052aba2-4de5-3766-af79-04d7dd061573",
                        "source_sense_id": "f81d8c05-b31b-35b9-bb34-99f611298e12",
                        "source_sense_description": "een ornament dat in of op het oor aangebracht wordt",
                        "target_lang_word": "Ohrring",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ohrring",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                        "entry_id": "e570ee72-39aa-3b44-8f71-6575e68a443e",
                                        "glosses": [
                                            "Ring oder anderes Schmuckstück, das am Ohr getragen wird, entweder an einem durchs Ohr (zum Beispiel Ohrläppchen) gestochenen Loch oder festgeklemmt am Ohrläppchen (dann auch Ohrclip genannt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3279c1-5e5f-4a75-b53d-75e1c470b200",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "Ohrringe werden als Schmuck hauptsächlich von Frauen getragen."
                                            },
                                            {
                                                "example_id": "61c993f8-bf1a-482a-b971-9f94abe5b568",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "Sabine trägt zwei Ohrringe im linken Ohrläppchen."
                                            },
                                            {
                                                "example_id": "a2ce5b70-e7b7-4b09-9a43-3d25510daace",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "Der Ohrring eines Wandergesellen war meist aus Gold und sollte dem Bestatter als Entlohnung im Todesfall dienen."
                                            },
                                            {
                                                "example_id": "78e91993-0afb-4fd0-acc6-6c2c99faec3a",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "„Sie trug ein halblanges Batikkleid und hatte große Ohrringe.“"
                                            },
                                            {
                                                "example_id": "2430d433-63d2-4153-96cc-067835ed857c",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "„Zwei Tage später wird Madam die Ohrringe wegwerfen.“"
                                            },
                                            {
                                                "example_id": "b00fca64-8351-4932-a303-1d3639f82e65",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "„Sie trägt billige Ohrringe, und ab und zu berührt sie sie.“"
                                            },
                                            {
                                                "example_id": "9bfcfbdb-2bff-4dc2-bc87-243503e41b16",
                                                "sense_id": "ea97aa66-5bcc-33b8-a53f-f08c1f98045a",
                                                "text": "„Almuth trug an diesem Abend Ohrringe in Gestalt kleiner Laternen, aus denen das Licht großer Rubine leuchtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
