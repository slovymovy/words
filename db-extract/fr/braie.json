                                    {
                                        "sense_id": "61fc1120-eca7-37c4-9f6c-fc2ccf568edc",
                                        "entry_id": "28d13960-b180-325d-a2cb-043637641ab9",
                                        "glosses": [
                                            "A garment whose purpose is to cover or clothe the buttocks."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "historical",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668fa707-ff80-4a79-b8a2-494bf7f5b426",
                                                "sense_id": "61fc1120-eca7-37c4-9f6c-fc2ccf568edc",
                                                "text": "'Lat be,' quod he, ‘it shal nat be, so theech!\nThou woldest make me kisse thyn old breech,\nAnd swere it were a relik of a seint,"
                                            },
                                            {
                                                "example_id": "25492f06-adb6-4b3d-902d-916edf91febc",
                                                "sense_id": "61fc1120-eca7-37c4-9f6c-fc2ccf568edc",
                                                "text": "The stallion lipped Alanna’s breech pockets. “He’s spoiled rotten.” Fishing a lump of sugar out, she fed it to him."
                                            },
                                            {
                                                "example_id": "363fe5dc-94e8-4b2a-8012-d40ed88551f9",
                                                "sense_id": "61fc1120-eca7-37c4-9f6c-fc2ccf568edc",
                                                "text": "The typical American combat soldier in World War I wore an olive-drab tunic, stiff at the neck, breech-style trousers, and combat shoes with canvas leggings or, preferably, wrappings."
                                            },
                                            {
                                                "example_id": "83fa59a7-2c32-4be8-a936-f7a852732105",
                                                "sense_id": "61fc1120-eca7-37c4-9f6c-fc2ccf568edc",
                                                "text": "He reached into his breech pockets. They were huge, but well-tailored and disguised properly within the folds of the pants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e369d71-3b90-3442-bcbe-91a9b5042438",
                                        "entry_id": "28d13960-b180-325d-a2cb-043637641ab9",
                                        "glosses": [
                                            "The buttocks or backside."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9250baf2-fd04-4dc4-9ed9-44f11380fcf5",
                                                "sense_id": "0e369d71-3b90-3442-bcbe-91a9b5042438",
                                                "text": "When pamper'd Cupids, bestly Veni's, / And motly, squinting Harvequini's, / Shall lick no more their Lady's Br—, / But die of Looseness, Claps, or Itch; / Fair Thames from either ecchoing Shoare / Shall hear, and dread my manly Roar."
                                            },
                                            {
                                                "example_id": "571bef34-2267-4af9-9646-c61286d08866",
                                                "sense_id": "0e369d71-3b90-3442-bcbe-91a9b5042438",
                                                "text": "And he made a woman for playing the whore, sit upon a great stone, on her bare breech twenty-foure houres, onely with corne and water, every three dayes, till nine dayes were past […]"
                                            },
                                            {
                                                "example_id": "57d0cddf-19c3-4fb3-a429-d256f6c9c91e",
                                                "sense_id": "0e369d71-3b90-3442-bcbe-91a9b5042438",
                                                "text": "\"Oho!\" says Thwackum, \"you will not! then I will have it out of your br—h;\" that being the place to which he always applied for information on every doubtful occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb80d981-605a-38b8-8ef0-8a0b05626082",
                                        "entry_id": "28d13960-b180-325d-a2cb-043637641ab9",
                                        "glosses": [
                                            "The part of a cannon or other firearm behind the chamber."
