                    }
                ]
            },
            {
                "entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                "word": "mythomane",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b31ad971-388c-440a-a955-7db2290e0a3d",
                        "entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                        "tags": [
                            "plural"
                        ],
                        "form": "mythomanes"
                    },
                    {
                        "form_id": "579c5b2d-30db-46f9-9662-a1127060562c",
                        "entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                        "tags": [
                            "feminine"
                        ],
                        "form": "mythowoman"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ced8233b-7eb6-3fa0-b1c0-eaf8841fac25",
                        "entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                        "glosses": [
                            "Personne qui a la manie pathologique de l’invention mensongère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff5727e-ff61-4e6f-a64c-d3f221cb2b13",
                                "sense_id": "ced8233b-7eb6-3fa0-b1c0-eaf8841fac25",
                                "text": "Un, une mythomane."
                            }
                        ]
                    },
                    {
                        "sense_id": "43034db4-4fbe-3370-8d07-242f3aabd185",
                        "entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                        "glosses": [
                            "Menteur ou menteuse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b09176ff-7169-4f1b-be21-96e3b7137c1d",
                                "sense_id": "43034db4-4fbe-3370-8d07-242f3aabd185",
                                "text": "Cet homme ! Il ne raconte que des mensonges ! Quel mythomane !"
                            }
                        ]
                    },
                    {
                        "sense_id": "3e7e68c8-4535-3e18-a747-f1f3b08f7e36",
                        "entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                        "glosses": [
                            "Personne qui a recours systématiquement aux mythes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57115292-f2fb-4553-a6ca-fd2fc5261ced",
                                "sense_id": "3e7e68c8-4535-3e18-a747-f1f3b08f7e36",
                                "text": "Pour ma part, je connais entre autres explications astronomiques, celle des contes de la Mère L’Oie : Petit-Poucet et Cendrillon, La Belle au Bois Dormant et le Chat Botté; et je sais ce qu’il faut croire des récits de la Bible, et, cela va sans dire, de l’Evangile dans ses moindres détails; car le rapprochement, que dis-je ? l’identité de Jésus et d’Osiris n’offre pas le plus léger doute pour ces interprètes mythologues ou… mythomanes à tout crin. Mythomanie plus hypothétique qu’expérimentale dans ses recherches, plus confessionnelle que scientifique dans ses conclusions !"
                            },
                            {
                                "example_id": "ba6c60b1-4a84-4f6e-bec1-8cbdd9836382",
                                "sense_id": "3e7e68c8-4535-3e18-a747-f1f3b08f7e36",
                                "text": "Charles Guignebert a nommé ces auteurs les « mythomanes » pour indiquer avec quelle obstination ils ont cherché le mythe que la foi chrétienne avait soi-disant historisé pour se donner un fondement historique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "737de589-0cc2-42c7-9c91-e612290d2dd8",
                        "source_entry_id": "7ef92233-521f-36f6-9eec-38520a9f8c62",
                        "source_sense_id": "ced8233b-7eb6-3fa0-b1c0-eaf8841fac25",
                        "source_sense_description": "Personne qui ment de façon pathologique",
                        "target_lang_word": "Pseudologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pseudologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                        "entry_id": "77c4c3e6-2f55-35b4-aeb9-d4e0090c3f9b",
                                        "glosses": [
                                            "Person, welche Mangels eigener Erlebnisse oder Kenntnisse, Lebensgeschichten oder Fakten ausdenkt und anderen erzählt, als wären sie real (pathologisches Lügen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c114a83-d9ac-4572-a436-da404ad96fbd",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„‚Pseudologen‘ werden unter Fachleuten Menschen genannt, bei denen das Lügen zwanghaft ist.“"
                                            },
                                            {
                                                "example_id": "f3e90776-5ebf-40a7-b4f2-0ebf58f483c7",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„In der Sucht, eine Rolle zu spielen, die ihm das wirkliche Leben versagt, spielt der Pseudologe anderen und sich selbst Theater vor.“"
                                            },
                                            {
                                                "example_id": "1e432a12-60bd-48e5-9442-f16ba9e2f706",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„Auf die ganz großen Lügen, Lebenslügen und Doppelleben, zielten echte Pseudologen gar nicht ab.“"
                                            },
                                            {
                                                "example_id": "4d42ae68-49b1-4a2f-8dd5-3ae05f6f5ec5",
                                                "sense_id": "07b7aebe-556e-3ee7-a2cc-6bbd168e1bda",
                                                "text": "„Wahr ist wohl, dass Pseudologen aus einer Art Schutzbedürfnis heraus handeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
