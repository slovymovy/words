    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e33aca5e-fd59-3dfd-93ea-fcbc018a54c8",
                    "sense_definition": "Iemand die beroepshalve voor personen (zoals ouderen of zieken) zorgt, maar geen verpleegkundige is.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verzorgende</w> helpt de oudere man elke ochtend met wassen en aankleden.",
                            "target_lang_translations": {
                                "en": "The <w>caregiver</w> helps the elderly man with washing and dressing every morning."
                            }
                        },
                        {
                            "text": "Als gediplomeerd <w>verzorgende</w> werkt zij met veel plezier in het verpleeghuis.",
                            "target_lang_translations": {
                                "en": "As a qualified <w>care worker</w>, she enjoys working in the nursing home very much."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzorgster",
                        "verzorger"
                    ],
                    "common_phrases": [
                        "een gediplomeerd verzorgende",
                        "verzorgende in de thuiszorg"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who professionally cares for people (such as the elderly or sick) but is not a registered nurse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "caregiver",
                                "target_lang_sense_clarification": "general term for someone providing care"
                            },
                            {
                                "target_lang_word": "care worker",
                                "target_lang_sense_clarification": "professional in social or healthcare"
                            },
                            {
                                "target_lang_word": "nursing assistant",
                                "target_lang_sense_clarification": "assisting with basic patient care"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "adb1db11-4a79-3a76-93bc-ea45ed3e588e",
                    "sense_definition": "Verbogen vorm van de stellende trap van <w>verzorgend</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft een zeer <w>verzorgende</w> rol binnen ons team.",
                            "target_lang_translations": {
                                "en": "She has a very <w>nurturing</w> role within our team."
                            }
                        },
                        {
                            "text": "Deze crème heeft een <w>verzorgende</w> werking op de droge huid.",
                            "target_lang_translations": {
                                "en": "This cream has a <w>nourishing</w> effect on dry skin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een verzorgende crème",
                        "verzorgende eigenschappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inflected form of the adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of the positive degree of the adjective 'verzorgend' (caring, nourishing, nurturing)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "caring",
                                "target_lang_sense_clarification": "showing concern or empathy in a role"
                            },
                            {
                                "target_lang_word": "nourishing",
                                "target_lang_sense_clarification": "providing care and nutrients, e.g., for skin"
                            },
                            {
                                "target_lang_word": "nurturing",
                                "target_lang_sense_clarification": "supporting and encouraging growth or care"
                            }
                        ]
                    }
                }
            ]
        }
    ]
