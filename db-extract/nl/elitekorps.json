                "senses": [
                    {
                        "sense_id": "50095600-7fc5-3cc4-a390-5301dca52387",
                        "entry_id": "75cd3137-6a31-3fa7-ac3f-dd20eb411b9c",
                        "glosses": [
                            "een groep speciaal getrainde militairen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bf766b1-66d0-4646-88a3-103d34e114fb",
                                "sense_id": "50095600-7fc5-3cc4-a390-5301dca52387",
                                "text": "Voorlopig is het slechte weer nog niet opgehouden. Op verschillende plaatsen houdt de hevige regen nog altijd aan. Teams van de Rode Halvemaan, het leger en de Revolutionaire Garde, een elitekorps van het Iraanse regime, zijn naar de getroffen gebieden gegaan om hulp te verlenen."
                            },
                            {
                                "example_id": "ae540316-e501-4099-bb27-fb99e8d6f20a",
                                "sense_id": "50095600-7fc5-3cc4-a390-5301dca52387",
                                "text": "Hamedani is een van de hoogste bevelhebbers van de Revolutionaire Garde, een militair elitekorps dat losstaat van het Iraanse leger. De garde staat onder leiding van geestelijk leider van Iran, ayatollah Khameini. Hij speelde een belangrijke rol in de oorlog tussen Iran en Irak, die tussen 1980 en 1988 plaatshad."
                            }
                        ]
                    }
