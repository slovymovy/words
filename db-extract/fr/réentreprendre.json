                "senses": [
                    {
                        "sense_id": "380eb4c4-ba3b-3cc9-9e44-ebd284b79e62",
                        "entry_id": "f159dfe4-1441-3236-b3ae-6fab289af8db",
                        "glosses": [
                            "Mettre en œuvre soit un nouveau projet lié à un autre plus ancien, soit un projet qui a déjà abouti et qu’on désire poursuivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbf8e000-f978-460b-be00-8c09ae9c655b",
                                "sense_id": "380eb4c4-ba3b-3cc9-9e44-ebd284b79e62",
                                "text": "Il a fallu attendre dix ans pour que soient réentrepris les travaux de rénovation de l’hôpital."
                            },
                            {
                                "example_id": "d90480db-c8e1-44e7-b42e-fb8f728bd684",
                                "sense_id": "380eb4c4-ba3b-3cc9-9e44-ebd284b79e62",
                                "text": "Sa passion pour la médecine l’a poussé à réentreprendre des études."
                            },
                            {
                                "example_id": "79e1993d-51af-4529-a914-d63021688918",
                                "sense_id": "380eb4c4-ba3b-3cc9-9e44-ebd284b79e62",
                                "text": "Dans le domaine de la phonétique corrective, il faudrait réentreprendre des recherches portant sur la comparaison entre langue-cible et langue-source."
                            }
                        ]
                    }
