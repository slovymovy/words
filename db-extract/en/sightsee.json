                    {
                        "sense_id": "26663eae-a28e-37c6-aedd-d4cc53d47dc3",
                        "entry_id": "f277e459-c4e3-3024-a327-af87bfa95e77",
                        "glosses": [
                            "To go sightseeing; to visit places of interest in a city, town or geographical area."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5261159b-9e1a-449b-8dae-be3ed778fb29",
                                "sense_id": "26663eae-a28e-37c6-aedd-d4cc53d47dc3",
                                "text": "The German team liked each other, ate, drank, sightsaw, sunbathed and worked their horses together. All were firmly rooting for Ludwig. A German victory was all that mattered."
                            },
                            {
                                "example_id": "8f5c70b4-ad96-43da-b74c-75543c128c73",
                                "sense_id": "26663eae-a28e-37c6-aedd-d4cc53d47dc3",
                                "text": "It was their first time on the Continent and they sight-saw for a week in Paris […]."
                            }
                        ]
                    }
                ],
