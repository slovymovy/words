                ],
                "senses": [
                    {
                        "sense_id": "6c183d5f-f288-3e34-ae6f-9d3a69ffa429",
                        "entry_id": "771176ac-4da2-3135-942e-31c1c029c203",
                        "glosses": [
                            "illegal immigrant, illegal alien"
                        ],
                        "tags": [
                            "adjectival",
                            "informal",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "833dea7d-4a95-49c6-bcee-8cf56aef9f07",
                                "sense_id": "6c183d5f-f288-3e34-ae6f-9d3a69ffa429",
                                "text": "Mit ein Grund sind Versuche des Kongresses, die Strafen für Arbeitgeber zu erhöhen, die Illegale beschäftigen.",
                                "translation": "A contributing reason are attempts by the congress to increase the punishment for employers that employ illegal aliens.",
                                "english": "A contributing reason are attempts by the congress to increase the punishment for employers that employ illegal aliens."
                            },
                            {
                                "example_id": "4372e937-d90b-4951-b123-cb5da828eba5",
                                "sense_id": "6c183d5f-f288-3e34-ae6f-9d3a69ffa429",
                                "text": "Die Illegalen gehen oft zu Fuß. Diejenigen, die noch Geld haben, bezahlen Schleuser, die sie durchs Land transportieren.",
                                "translation": "The illegal aliens often travel on foot. The ones that still have money pay smugglers that transport them through the land.",
                                "english": "The illegal aliens often travel on foot. The ones that still have money pay smugglers that transport them through the land."
                            },
                            {
                                "example_id": "90d0e12f-b379-4466-94b9-517df6aa8961",
                                "sense_id": "6c183d5f-f288-3e34-ae6f-9d3a69ffa429",
                                "text": "Die Illegalen kommen aus Somalia, Eritrea, Kongo, Nigeria oder dem Senegal und sind auf überfüllten, abgetakelten Trawlern nach Italien geschifft worden.",
                                "translation": "The illegal immigrants come from Somalia, Eritrea, the Congo, Nigeria or Senegal and have been brought to Italy on overcrowded, run-down trawlers.",
                                "english": "The illegal immigrants come from Somalia, Eritrea, the Congo, Nigeria or Senegal and have been brought to Italy on overcrowded, run-down trawlers."
                            }
                        ]
                    }
