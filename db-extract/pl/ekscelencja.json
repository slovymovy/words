                                "target_senses": [
                                    {
                                        "sense_id": "422aca81-3929-336e-b4dc-7e11a8450ffb",
                                        "entry_id": "ebed6248-40cb-3607-ae09-028b253bcd20",
                                        "glosses": [
                                            "A form of address for certain high officials or dignitaries."
                                        ],
                                        "tags": [
                                            "used with His"
                                        ],
