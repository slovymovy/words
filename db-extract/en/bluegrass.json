                "forms": [],
                "senses": [
                    {
                        "sense_id": "e15bbe4d-b157-370d-bdee-ccf5ec9b2936",
                        "entry_id": "af4300a8-c492-3db0-8d48-d7583a6fbb19",
                        "glosses": [
                            "ботан. мятлик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8cbdf90-ffb2-4109-9d92-c8c9fdcdc3cf",
                                "sense_id": "e15bbe4d-b157-370d-bdee-ccf5ec9b2936",
                                "text": "Bluegrass refers to several species of grasses of the genus Poa (with the most famous being the Kentucky bluegrass).",
                                "translation": "Название \"мятлик\" используется для описания нескольких видов травянистых растений рода Poa, самый известный из которых мятлик луговой."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c74b90e-e09d-3f7a-a1d8-a6f1e75c4635",
                        "entry_id": "af4300a8-c492-3db0-8d48-d7583a6fbb19",
                        "glosses": [
                            "муз. блюграсс (разновидность музыки кантри)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5dfcbd-aad8-47b2-8f52-f43108a59196",
                                "sense_id": "5c74b90e-e09d-3f7a-a1d8-a6f1e75c4635",
                                "text": "Unlike mainstream country music, bluegrass relies mostly on acoustic stringed instruments.",
                                "translation": "В отличие от популярного кантри в блюграссе используются в основном акустические струнные инструменты."
                            }
                        ]
                    }
