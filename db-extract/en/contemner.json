                "senses": [
                    {
                        "sense_id": "c35d18a7-6ef2-3ced-93c1-d57069f8b657",
                        "entry_id": "c2f1e470-5c9a-30af-9063-275d584962fe",
                        "glosses": [
                            "One who contemns, who displays contempt towards another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceb6ddb3-ee11-4c4e-9d0e-890f556dbf0a",
                                "sense_id": "c35d18a7-6ef2-3ced-93c1-d57069f8b657",
                                "text": "Præsumptuous violators or contemners of the sabbath or holie exercises /."
                            },
                            {
                                "example_id": "5d39c0da-0c82-4b8b-a710-b38f67506220",
                                "sense_id": "c35d18a7-6ef2-3ced-93c1-d57069f8b657",
                                "text": "I have read a fiery gospel writ in burnished rows of steel: / “As ye deal with my contemners, so with you my grace shall deal; / […] ”"
                            },
                            {
                                "example_id": "dd0f44e0-f45e-45e5-bca2-b339133106ca",
                                "sense_id": "c35d18a7-6ef2-3ced-93c1-d57069f8b657",
                                "text": "From all of which Isabel gathered that Lord Warburton was a nobleman of the newest pattern, a reformer, a radical, a contemner of ancient ways."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dcf4e26-40e2-4ded-a3d8-8d4b2a91eaf4",
                        "source_entry_id": "c2f1e470-5c9a-30af-9063-275d584962fe",
                        "source_sense_id": "c35d18a7-6ef2-3ced-93c1-d57069f8b657",
                        "source_sense_description": "Translations",
                        "target_lang_word": "contempteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contempteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                        "entry_id": "6da1b19d-d59d-38cf-a726-716d41f81f57",
                                        "glosses": [
                                            "Celui qui méprise quelqu’un ou quelque chose."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1839b63d-1303-4f56-8217-ca7c16a7bc54",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "[…] ses puissances n’en résident pas moins au fond de son être, et […] un jour elles se réveilleront pour étonner de leur fière originalité et de leur indomptable énergie et leurs timides apologistes et leurs insolents contempteurs."
                                            },
                                            {
                                                "example_id": "d0d02ffe-2b9d-4160-aaf5-beb61099160c",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Les vieux d’avant la Révolution étaient morts ; les jeunes passèrent presque tous à la thèse de l’infaillibilité papale ; mais il resta encore une profonde différence entre ces ultramontains de la dernière heure et les hardis contempteurs de la scolastique et de l’église gallicane sortis de l’école de Lamennais."
                                            },
                                            {
                                                "example_id": "2dca7093-a559-42d4-a40c-a4806d7bd412",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Ce contempteur de la ruse ment. Ce flétrisseur de la lâcheté use et mésuse de petits papiers. Pouah !"
                                            },
                                            {
                                                "example_id": "52c642b6-708b-46dc-b774-fdab17456541",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Les contempteurs du burkini (ou du hijab) n’ont de cesse de renvoyer aux pratiques dans les théocraties islamiques : dans ces pays, nous disent-ils, les femmes se battent pour avoir le droit de se dévêtir en public."
                                            },
                                            {
                                                "example_id": "d3a89214-0d42-4369-8b98-0be9597d9e1f",
                                                "sense_id": "a299a334-0c5a-3768-9152-4e0b94f443e6",
                                                "text": "Assimilés à des parasites suçant le lait déjà avarié de notre Hexagone déclinant, tantôt à des tire-au-flanc dont le poil dans la main prendrait, à écouter leurs contempteurs plus remontés que des coucous suisses, des allures de poutre de Bamako, ils sont devenus l'ennemi public numéro un."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3d1b312-a856-4d03-ac52-4936a0ad0aa3",
