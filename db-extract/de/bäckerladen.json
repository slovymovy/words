                    {
                        "sense_id": "c01bbc27-f6f9-3bbb-9bad-c4f5b1690c0e",
                        "entry_id": "5d257892-520c-3441-9368-bbafa8b30f42",
                        "glosses": [
                            "Geschäft, das Backwaren führt; Laden eines Bäckers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c5c144-74a0-4a8e-9446-59053b281ef7",
                                "sense_id": "c01bbc27-f6f9-3bbb-9bad-c4f5b1690c0e",
                                "text": "„Bisweilen haben es die Deutschen untereinander schwer genug, sich auf ihren Speisekarten richtig zu verständigen und ihre Provinzialismen in Bäckerläden und Metzgereien zu entflechten.“"
                            },
                            {
                                "example_id": "e215777f-753d-4ecc-8199-03be69726649",
                                "sense_id": "c01bbc27-f6f9-3bbb-9bad-c4f5b1690c0e",
                                "text": "„Er sah einen Bäckerladen, in dem kein Brot war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
