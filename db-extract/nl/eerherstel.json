                                "target_senses": [
                                    {
                                        "sense_id": "6919e402-cde3-3b7c-bab5-f5839219ed50",
                                        "entry_id": "f0e1085e-6795-31b8-bba9-20ffd26f5241",
                                        "glosses": [
                                            "Therapie, die auf die Wiederherstellung verlorengegangener Fähigkeiten abzielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b176c30f-8f70-4bda-89e1-c7152b79f0df",
                                                "sense_id": "6919e402-cde3-3b7c-bab5-f5839219ed50",
                                                "text": "Nach dem Unfall musste er eine dreimonatige Rehabilitation über sich ergehen lassen."
                                            },
                                            {
                                                "example_id": "f27b605f-a48d-4362-91d4-e79f503b0654",
                                                "sense_id": "6919e402-cde3-3b7c-bab5-f5839219ed50",
                                                "text": "„In den Bundeswehrkrankenhäusern und bei Bedarf auch in zivilen Kliniken wird die Behandlung mit der weitergehenden klinischen Versorgung und Rehabilitation abgeschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c465cf5c-92df-393d-a115-765d8c2b646c",
                                        "entry_id": "f0e1085e-6795-31b8-bba9-20ffd26f5241",
                                        "glosses": [
                                            "Maßnahmen, die die Wiederherstellung des Rufs einer Person zum Ziel haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec53b339-159b-4dea-a969-f55b837ad089",
                                                "sense_id": "c465cf5c-92df-393d-a115-765d8c2b646c",
                                                "text": "Einige politische Gefangene der DDR warten bis heute auf ihre Rehabilitation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b79c081-0603-4acc-bf66-a8ddfa935a68",
                        "source_entry_id": "5a8714c4-3c57-3cf2-bd2b-0d4a0e0cff30",
                        "source_sense_id": "48816734-36f3-359e-9572-6bc18fe7130f",
                        "target_lang_word": "rehabilitation",
