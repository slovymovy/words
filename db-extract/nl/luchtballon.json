                                "sense_id": "f39ea1e6-e827-3f43-955b-5f5888a869a3",
                                "text": "We gingen vroeg in de ochtend een ritje maken in een luchtballon.",
                                "translation": "We went for a ride in a hot air balloon early in the morning.",
                                "english": "We went for a ride in a hot air balloon early in the morning."
                            },
                            {
                                "example_id": "b44e92d9-73dc-48b5-8828-fd26b4f33d1d",
                                "sense_id": "f39ea1e6-e827-3f43-955b-5f5888a869a3",
                                "text": "Je vraagt me waarom, maar ik ben niet dom / Laat me maar vliegen in m'n luchtballon",
                                "translation": "You ask me why, but I'm not stupid / Just let me fly in my hot-air balloon",
                                "english": "You ask me why, but I'm not stupid / Just let me fly in my hot-air balloon"
                            }
