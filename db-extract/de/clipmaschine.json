                "senses": [
                    {
                        "sense_id": "d123847a-f933-39f0-8836-a2f04cfff1ce",
                        "entry_id": "11c30bb4-3adb-3aec-8656-5ebf67b44c96",
                        "glosses": [
                            "mechanisches Arbeits- beziehungsweise Produktionsmittel zum Verschließen von Verpackungen mittels Clipverschluss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a33662fe-38d5-4940-9d66-10c1d3ced3f3",
                                "sense_id": "d123847a-f933-39f0-8836-a2f04cfff1ce",
                                "text": "Das ist eine Clipmaschine zum Verschließen von Wursthüllen."
                            },
                            {
                                "example_id": "d044325b-892e-4c21-8108-ed4f03e8ba97",
                                "sense_id": "d123847a-f933-39f0-8836-a2f04cfff1ce",
                                "text": "Bestehend aus dem Beutelfüllgerät, der Vakuumkammer-Clipmaschine und dem Schrumpftank, verpackt diese Linie Wurst und Fleischwaren, Geflügel, Käse u. ä."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79ded6b7-0ace-3d20-8889-a9ea7cea9e3c",
                        "entry_id": "11c30bb4-3adb-3aec-8656-5ebf67b44c96",
                        "glosses": [
                            "mechanisches Arbeits- beziehungsweise Produktionsmittel für die Befestigung von Schienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33acd4b0-549c-4e06-b7fd-bc9de8fec27b",
                                "sense_id": "79ded6b7-0ace-3d20-8889-a9ea7cea9e3c",
                                "text": "Diese Clipmaschine eignet sich für alle Befestigungsbügel, die in Querrichtung zum Schienenverlauf ein- bzw. ausgedrückt werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
