    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                "word": "counterpoint",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aec582c7-ddaf-4aaa-ada2-c559d49ca51a",
                        "entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                        "tags": [
                            "plural"
                        ],
                        "form": "counterpoints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "054ca004-c947-3758-989d-7e632b351e5b",
                        "entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                        "glosses": [
                            "A melody added to an existing one, especially one added to provide harmony whilst each retains its simultaneous identity; a composition consisting of such contrapuntal melodies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c53d4883-2473-40e5-84dd-429653c4538d",
                                "sense_id": "054ca004-c947-3758-989d-7e632b351e5b",
                                "text": "I noticed […] that when a very cheesy synthesized violin sound plays in counterpoint with a real violin, it can quite convincingly seem as if two violins are playing."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe4e0896-01c3-340a-a3da-d88d453702f6",
                        "entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                        "glosses": [
                            "Any similar contrasting element in a work of art."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ec17dbfa-8aab-417f-936d-9f7f7db8f9a5",
                                "sense_id": "fe4e0896-01c3-340a-a3da-d88d453702f6",
                                "text": "As counterpoints to the glamorous looks of 1980s models such as Chistie Brinkley and Heidi Klum, heroin chic looks such as Kate Moss were thin to the point of anorectic gauntness."
                            }
                        ]
                    },
                    {
                        "sense_id": "82915e52-53aa-37ad-997b-0b1f228a1bc5",
                        "entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                        "glosses": [
                            "An opposite point."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "badd4f1a-d473-4710-8fc4-2b4f11467351",
                                "sense_id": "82915e52-53aa-37ad-997b-0b1f228a1bc5",
                                "text": "[…] Priests; who affecting in them selves and their followers a certein Angelical puritie, fell sodainly to the very counterpoint of justifying bestialitie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b1e2786-a876-493e-9072-e4f4b1f26fd8",
                        "source_entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                        "source_sense_description": "(music) a melody added to an existing one",
                        "target_lang_word": "contrepoint",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrepoint",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17ca3c7e-bb2b-307b-aaab-b081b25e09b3",
                                        "entry_id": "97e3721d-085c-358b-a9a2-4ff455fdbdb8",
                                        "glosses": [
                                            "Art de composer de la musique à deux ou plusieurs parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d76d5d70-959b-442e-a35d-16924097324f",
                                                "sense_id": "17ca3c7e-bb2b-307b-aaab-b081b25e09b3",
                                                "text": "Apprendre le contrepoint."
                                            },
                                            {
                                                "example_id": "7a5ecf6a-d9fd-4810-abe1-5d075943454e",
                                                "sense_id": "17ca3c7e-bb2b-307b-aaab-b081b25e09b3",
                                                "text": "L’étude du contrepoint."
                                            },
                                            {
                                                "example_id": "91f80055-632b-4bf1-a4a2-ff8af9036052",
                                                "sense_id": "17ca3c7e-bb2b-307b-aaab-b081b25e09b3",
                                                "text": "La science du contrepoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3bed3b-0ed2-3514-8fe7-7d9a9ed0b149",
                                        "entry_id": "97e3721d-085c-358b-a9a2-4ff455fdbdb8",
                                        "glosses": [
                                            "Ce qui contraste avec autre chose et rend l’ensemble plus équilibré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66b78088-61c0-4982-b300-4070c99493d8",
                                                "sense_id": "6a3bed3b-0ed2-3514-8fe7-7d9a9ed0b149",
                                                "text": "La fraîcheur du vent offre un agréable contrepoint au soleil de la plage."
                                            },
                                            {
                                                "example_id": "4b121b78-4476-46ba-b428-da744ecb0268",
                                                "sense_id": "6a3bed3b-0ed2-3514-8fe7-7d9a9ed0b149",
                                                "text": "Je me suis appliqué, au long des périodes de l’histoire helvétique, à dégager quelques constantes qui donnent à son déroulement un caractère particulier souvent en contrepoint de l’évolution de ses voisins."
                                            },
                                            {
                                                "example_id": "baa0606c-c827-4bed-a366-6b304c112068",
                                                "sense_id": "6a3bed3b-0ed2-3514-8fe7-7d9a9ed0b149",
                                                "text": "Des éclaircies, en contrepoint à la marche sombre des corps."
                                            },
                                            {
                                                "example_id": "6f0724f2-88fd-4050-9743-e6a876c36e13",
                                                "sense_id": "6a3bed3b-0ed2-3514-8fe7-7d9a9ed0b149",
                                                "text": "C’est en ce sens que Uexkühl, sous un premier aspect, développe une conception de la Nature mélodique, polyphonique, contrapuntique. Non seulement le chant d’un oiseau a ses rapports de contrepoint, mais il peut en trouver avec le chant d’autres espèces, et peut lui-même imiter ces autres chants comme s’il s’agissait d’occuper un maximum de fréquences. La toile d’araignée contient « un portrait très subtil de la mouche » qui lui sert de contrepoint. La coquille comme maison du mollusque devient, lorsqu’il est mort, le contrepoint du Bernard-l’hermite qui en fait son propre habitat, grâce à sa queue qui n’est pas natatoire, mais préhensile, et lui permet de capturer la coquille vide. La Tique est organiquement construite de manière à trouver son contrepoint dans le mammifère quelconque qui passe sous sa branche, comme les feuilles de chêne rangées à la manière de tuiles, dans les gouttes de pluie qui ruissellent."
                                            },
                                            {
                                                "example_id": "8ca0cf07-3bfb-4e59-985b-6e59409af00a",
                                                "sense_id": "6a3bed3b-0ed2-3514-8fe7-7d9a9ed0b149",
                                                "text": "Au contraire, un subtil jeu de contrepoints fait dialoguer les architectures entre elles et intensifie l’expressivité de chacune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "118d59b5-eab3-49fb-948b-bc290270d263",
                        "source_entry_id": "12d2fe16-99c9-3870-a815-1d71633d4aac",
                        "source_sense_description": "(music) a melody added to an existing one",
                        "target_lang_word": "Kontrapunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kontrapunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c90120-7ad9-358d-88c4-e3be730dcc68",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "melodisch und rhythmisch eigenständig geführte Stimme (eigenständige Gegenstimme zum Thema, gleichwertiger „Partner“ der anderen Stimme(n) in einem polyphonen Satz)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb817e1-c6df-4ae9-8f2a-d110f3406d2e",
                                                "sense_id": "f7c90120-7ad9-358d-88c4-e3be730dcc68",
                                                "text": "Man „nennt […] die Stimme, die in einer Fuge gleichzeitig mit dem Thema bzw. Soggetto erklingt, dessen Kontrapunkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c158289c-5ba0-336e-a392-f5d8cff577d3",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "die Kunst beziehungsweise Technik, Gegenstimmen zu gegebenen Tonfolgen zu erfinden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba9a894-0a5b-4cb9-bff8-94d145e74a79",
                                                "sense_id": "c158289c-5ba0-336e-a392-f5d8cff577d3",
                                                "text": "„Der Kontrapunkt als Kompositionstechnik unterlag in der Musikgeschichte sich wandelnden Regeln, die von der wechselnden Bewertung von Konsonanzen und Dissonanzen abhingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fa64f233-da8a-3faf-a918-6e30ed204be3",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "synonyme Verwendung für Polyphonie, Mehrstimmigkeit"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7028ceaa-2836-42db-9a88-f14d5ac8d333",
                                                "sense_id": "fa64f233-da8a-3faf-a918-6e30ed204be3",
                                                "text": "„Polyphonie in diesem Sinn ist eine Form der Mehrstimmigkeit, bei der die einzelnen Stimmen im Wesentlichen gleichwertig sind. Dies wird erreicht, indem ein Komponist ihren Verlauf nach den Regeln des Kontrapunkts führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "35fab730-f27e-3f96-b2cb-a7206db640fa",
                                        "entry_id": "0f0690d8-cd8e-3c1a-ae98-7b998a337d14",
                                        "glosses": [
                                            "deutlich erkennbarer Gegensatz"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dbe0dfe-0b9a-4f1d-9cfa-4769cd45ab1d",
                                                "sense_id": "35fab730-f27e-3f96-b2cb-a7206db640fa",
                                                "text": "„Mit der Betonung des kompromisslosen Kampfes gegen Israel setzt er bewusst einen Kontrapunkt zu Mahmud Abbas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
