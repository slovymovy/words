                "senses": [
                    {
                        "sense_id": "49394762-6049-345d-b326-51a484772066",
                        "entry_id": "c37654ed-3ae2-39e5-9983-d0b1617e36b0",
                        "glosses": [
                            "Faire perdre son caractère accidenté à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb1543f-a62a-41fa-b00e-fcafede10f61",
                                "sense_id": "49394762-6049-345d-b326-51a484772066",
                                "text": "J’écoute prioritairement le virtuel et le modifiable, ce sur quoi on pourrait s’appuyer pour « désaccidenter », pour rendre à l’enfant un minimum de sentiment de valeur, pour le remettre progressivement en devenir."
                            },
                            {
                                "example_id": "75dc16b2-481c-431e-ab71-25f2866c0d94",
                                "sense_id": "49394762-6049-345d-b326-51a484772066",
                                "text": "Au delà, le pays garde, au contact du grand fleuve, la même nature mamelonnée et tourmentée, tandis qu’il se désaccidente vers le Sud."
                            }
                        ]
                    }
