                        "glosses": [
                            "Opposé à la réunion de deux sectes religieuses, de deux pays, de deux peuples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bdc5eaa-8217-45cd-91fb-d732f7bc75c1",
                                "sense_id": "1fcd98ce-72eb-305e-a9bf-bb9d2164dce3",
                                "text": "Chacun des districts devant élire deux députés, on a 28 noms, sur lesquels cinq seulement sont antiunionistes; parmi eux se trouvent les anciens hospodars Bibesco et Stirbey."
                            }
                        ]
                    },
