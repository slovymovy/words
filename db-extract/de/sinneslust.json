                "senses": [
                    {
                        "sense_id": "77b75e18-7433-3fca-b79a-02140387ceb4",
                        "entry_id": "6dc8dc34-be24-3edd-a359-48fc143cb29b",
                        "glosses": [
                            "Lust/Freude, die durch die Sinne erlebt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86823146-0741-40df-93ba-37dfb749123d",
                                "sense_id": "77b75e18-7433-3fca-b79a-02140387ceb4",
                                "text": "„Dieser Leittrend der 80er Jahre, das Streben nach Genuss und Sinneslust, hat nach wie vor einen hohen Stellenwert.“"
                            },
                            {
                                "example_id": "bd97d461-60c1-47cf-a312-7a483213bf9d",
                                "sense_id": "77b75e18-7433-3fca-b79a-02140387ceb4",
                                "text": "„Gedankenversunken gab sich Viktoria dieser gustatorischen Sinneslust hin, als die Tür plötzlich wieder aufgestoßen wurde.“"
                            },
                            {
                                "example_id": "0a9a08da-7c4e-4427-bd1e-a7ed0b72fec2",
                                "sense_id": "77b75e18-7433-3fca-b79a-02140387ceb4",
                                "text": "„Des Menschen Antrieb sind die Zwänge, die von Natur ihm auferlegt, wenn Körper sich an Körper drängen von starker Sinneslust geprägt.“"
                            },
                            {
                                "example_id": "158a28cb-1d6b-4d79-b827-245186804a31",
                                "sense_id": "77b75e18-7433-3fca-b79a-02140387ceb4",
                                "text": "„Es wuchs das Begehren, das Besitzen-, Sein- und Habenwollen, und damit wuchsen zugleich die Sinneslüste und Gelüste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
