            "senses": [
                {
                    "sense_id": "5a595d3f-e2a5-3503-bc3c-a54001d66ae8",
                    "sense_definition": "Relating to the energy released by reactions within atomic nuclei, especially when used to generate electricity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "energy_physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many countries are debating the safety and future of <w>nuclear</w> energy.",
                            "target_lang_translations": {
                                "ru": "Многие страны обсуждают безопасность и будущее <w>ядерной</w> энергетики.",
                                "zh": "许多国家正在讨论<w>核能</w>的安全性和未来。"
                            }
                        },
                        {
                            "text": "The city receives most of its electricity from a nearby <w>nuclear</w> power plant.",
                            "target_lang_translations": {
                                "ru": "Город получает большую часть электричества от близлежащей <w>атомной</w> электростанции.",
                                "zh": "这座城市的大部分电力来自附近的一座<w>核电</w>站。"
                            }
                        }
                    ],
                    "synonyms": [
                        "atomic"
                    ],
                    "antonyms": [
                        "non-nuclear"
                    ],
                    "common_phrases": [
                        "nuclear energy",
                        "nuclear power",
                        "nuclear reactor",
                        "nuclear waste",
                        "nuclear fuel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к энергии, высвобождаемой в результате реакций внутри атомных ядер, особенно при использовании для производства электроэнергии.",
                        "zh": "与原子核内反应释放的能量有关，尤指用于发电。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "я́дерный",
                                "target_lang_sense_clarification": "относящийся к энергии ядра"
                            },
                            {
                                "target_lang_word": "а́томный",
                                "target_lang_sense_clarification": "используемый в названиях электростанций и ледоколов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "核能",
                                "target_lang_sense_clarification": "指核能本身"
                            },
                            {
                                "target_lang_word": "核电",
                                "target_lang_sense_clarification": "指核能发电"
                            }
                        ]
                    }
                },
                {
