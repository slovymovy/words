                        "examples": [
                            {
                                "example_id": "4a010420-b62c-465d-a306-fc3784d15104",
                                "sense_id": "96b8a039-1edf-31c5-9e75-51e202ba3e58",
                                "text": "Twee gemaskerde mannen, gewapend met vuurwapens, hebben zaterdagavond een overval gepleegd op een elektrowinkel van de keten Vanden Borre in Drogenbos. Er vielen geen gewonden, zo heeft het parket van Brussel zondag gemeld."
                            },
                            {
                                "example_id": "d4011ed1-8980-411c-833c-0ad3fab4983b",
                                "sense_id": "96b8a039-1edf-31c5-9e75-51e202ba3e58",
                                "text": "Niet alleen de Rode Duivels kunnen een aardige duit overhouden aan het WK. Ook drankencentrales en elektrowinkels maken zich klaar om gouden zaken te doen."
                            }
                        ]
                    },
