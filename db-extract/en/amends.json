                        "source_sense_id": "afae3a18-563c-3123-b41b-7f69fd256046",
                        "source_sense_description": "compensation for a loss or injury",
                        "target_lang_word": "Entschädigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Entschädigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                        "entry_id": "a2d69c37-395e-35b7-a947-3ff8fe355d6d",
                                        "glosses": [
                                            "Leistung als Ausgleich für einen zugefügten Schaden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1233f24c-fb50-463e-aa7b-84ac9e2190bc",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "Dafür muss Entschädigung geleistet werden."
                                            },
                                            {
                                                "example_id": "ac3e3802-08f7-4ea7-85fe-031e4ad359b6",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "„Doch das Land Hessen lehnt bislang jede Entschädigung ab.“"
                                            },
                                            {
                                                "example_id": "597d2803-329e-4cbe-ad02-3bbe4c7d28e1",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "„Das Wort ‚Entschädigung‘ wurde dabei möglichst vermieden. Stattdessen ist von einer ‚materiellen Anerkennung erlittenen Leids‘ die Rede.“"
                                            },
                                            {
                                                "example_id": "65f79540-7a07-4884-8615-1427328a2fbe",
                                                "sense_id": "178eed51-1cad-33aa-9bd2-2967893f4d4b",
                                                "text": "„Die Deutsche Bahn musste aufgrund von Zugausfällen und Verspätungen im Jahr 2022 die Rekordsumme von 92,7 Millionen Euro an Entschädigungen an ihre Kunden zahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd25f0dc-ce5e-3554-a323-59923c396c6b",
                                        "entry_id": "a2d69c37-395e-35b7-a947-3ff8fe355d6d",
                                        "glosses": [
                                            "Vergütung einer Dienstleistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3700fe6-d5ff-440c-a129-32096b57e5fe",
                                                "sense_id": "fd25f0dc-ce5e-3554-a323-59923c396c6b",
                                                "text": "Für den Vortrag erhielt der Redner eine geringe Entschädigung."
                                            },
                                            {
                                                "example_id": "816e9234-c2eb-4bf2-9f4c-a8ba3a6f36f6",
                                                "sense_id": "fd25f0dc-ce5e-3554-a323-59923c396c6b",
                                                "text": "Der deutsche Chemiekonzern IG Farben zahlte ihm [Anmerkung: dem jüdischen Chemiker und Schriftsteller Primo Levi] eine Entschädigung für die im KZ geleistete Zwangsarbeit - in Höhe von rund 63 Euro."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
