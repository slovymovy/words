                                    {
                                        "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                        "entry_id": "9e697e88-9d31-3ca1-aee2-625e2d0e25ec",
                                        "glosses": [
                                            "Rouler plusieurs fois une chose autour d’une autre, ou sur elle-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06cbb3fa-c221-4e70-9d7d-cdeb41a8f6eb",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Un singe enroule sa queue autour d’une branche pour s’y suspendre."
                                            },
                                            {
                                                "example_id": "f63a44df-36bc-47b5-a31c-365dd6d9f5f1",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Les vrilles de cette plante s’enroulent autour des corps voisins."
                                            },
                                            {
                                                "example_id": "a50f035f-a097-4b91-8361-b0e21b4c6de6",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Evans prend possession de l'unique lit et s'y fourre entre deux édredons, tandis que je monte mon lit de voyage et m’y enroule dans mon plaid."
                                            },
                                            {
                                                "example_id": "5335b3f5-9d9e-4f24-843d-23b7823f9468",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Enrouler une pièce d’étoffe sur le cylindre."
                                            },
                                            {
                                                "example_id": "488373d6-87d3-4195-b0f8-e351235113f0",
                                                "sense_id": "bc67e100-9041-3571-9994-b0a11a25879f",
                                                "text": "Enrouler du fil pour en former un peloton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bcc9cb7-d59a-345a-a5c2-9801a562709b",
                                        "entry_id": "9e697e88-9d31-3ca1-aee2-625e2d0e25ec",
                                        "glosses": [
                                            "Frapper le ballon avec un effet."
                                        ],
