                    {
                        "translation_id": "ba46f91a-e8b6-42b8-ab75-f8affe317ba4",
                        "source_entry_id": "34c2cd4f-1ed9-39e5-b97a-e553502be71b",
                        "source_sense_id": "0bd64bfc-c534-3df5-a578-92941f475a8c",
                        "target_lang_word": "popelig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
