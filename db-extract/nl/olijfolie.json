                    {
                        "translation_id": "318aeb38-5431-44a9-8a5b-82a0189c3404",
                        "source_entry_id": "7a059664-6d53-3ad3-981d-8fc9c5e90312",
                        "source_sense_id": "51f167a3-e17c-3429-8040-87e1fb7035f8",
                        "source_sense_description": "fijne spijsolie verkregen door persing uit olijven",
                        "target_lang_word": "Olivenöl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olivenöl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb8de54d-4b7b-3589-9221-133f4574a0f3",
                                        "entry_id": "85138748-7bcb-35aa-b07d-8513d92d99dd",
                                        "glosses": [
                                            "pflanzliches Speiseöl, das aus den Früchten des Olivenbaums gepresst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d0af94-51b1-44b9-9857-82837563183f",
                                                "sense_id": "eb8de54d-4b7b-3589-9221-133f4574a0f3",
                                                "text": "Olivenöl wird in Deutschland immer populärer."
                                            },
                                            {
                                                "example_id": "a1faaaae-4f0f-4a6e-aa2f-a619b7cf27ba",
                                                "sense_id": "eb8de54d-4b7b-3589-9221-133f4574a0f3",
                                                "text": "Pesto wird aus zerstoßenen Pinienkernen, Basilikum und Olivenöl zubereitet."
                                            },
                                            {
                                                "example_id": "9ad239d2-6483-4435-8427-62da8ae0627f",
                                                "sense_id": "eb8de54d-4b7b-3589-9221-133f4574a0f3",
                                                "text": "„Sie stellten einen großen Topf auf die Herdplatte und gossen duftendes Olivenöl hinein.“"
                                            },
                                            {
                                                "example_id": "606375fd-68a2-4d45-9af7-f886b8c6e1d2",
                                                "sense_id": "eb8de54d-4b7b-3589-9221-133f4574a0f3",
                                                "text": "„In diesem Fall wäre zu überlegen, sich eine Fenchelknolle dazuzuhobeln, die mit Zitrone und Olivenöl angemacht für knackige Frische und jenen zarten Aniston sorgt, der sich gerade zu Dosenfisch so überaus angenehm macht.“"
                                            },
                                            {
                                                "example_id": "b8ad4895-a341-4156-9f7f-76606cc22496",
                                                "sense_id": "eb8de54d-4b7b-3589-9221-133f4574a0f3",
                                                "text": "„In einem kleinen Laden im Dorf konnten die Kinder auch Olivenöl kaufen, sodass sie den Gang dorthin in ihr Spiel einbauten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce25b136-15ba-41c4-b43e-d113e6eb1f41",
                        "source_entry_id": "7a059664-6d53-3ad3-981d-8fc9c5e90312",
