                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "083f464d-c3f4-4175-9914-85d99ffe8259",
                                "sense_id": "0415e95c-c932-362a-aba9-e3366fcc6a24",
                                "text": "„Mediziner vermuten, dass die Anlage für Asthma bereits im Mutterleib gelegt wird, auch ein geringes Lungenvolumen bei der Geburt scheint die Voraussetzungen für späteres Asthma zu begünstigen.“"
                            },
                            {
                                "example_id": "1bfe062b-f8d3-4499-a59b-d8b5432410aa",
                                "sense_id": "0415e95c-c932-362a-aba9-e3366fcc6a24",
                                "text": "„Allein vom Wichsen bekam ich ein ungeheures Lungenvolumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
