                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e298d80-d40a-403d-8e1f-0be1e977e77c",
                        "source_entry_id": "14bed10a-275c-3f26-be18-a08623b8b670",
                        "source_sense_id": "5c3f1c18-f8f2-399e-bead-d0f73ec59fe5",
                        "source_sense_description": "female saint",
                        "target_lang_word": "sainte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc30afa-3779-3fac-8ad3-9be14b4d8e31",
                                        "entry_id": "75aa5dcc-d6f6-32c8-8f1a-eedfeea3bda0",
                                        "glosses": [
                                            "Femme ayant vécu une vie pure, souverainement parfaite et bienheureuse, et généralement reconnue comme telle par une religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df2e3d81-b9e9-4709-a8a8-b81227759659",
                                                "sense_id": "8dc30afa-3779-3fac-8ad3-9be14b4d8e31",
                                                "text": "— ceux-là le croiront qui estiment que Berthe, femme de Girard de Roussillon, a pu entrer dans la légende sans le concours des moines de Pothières, lesquels vénéraient Berthe comme leur sainte."
                                            },
                                            {
                                                "example_id": "c09610d9-8591-41f0-aff5-73f60faf32cc",
                                                "sense_id": "8dc30afa-3779-3fac-8ad3-9be14b4d8e31",
                                                "text": "De là, il se rendit au tombeau de la petite fille du Prophète et colla son visage aux croissants dorés de la grille. Il supplia la sainte d’intercéder pour lui auprès d’Allah."
                                            },
                                            {
                                                "example_id": "278ee550-77c4-4dfa-80cd-d4dc8aa9a422",
                                                "sense_id": "8dc30afa-3779-3fac-8ad3-9be14b4d8e31",
                                                "text": "S’il y eut des saintes et des martyres, en revanche point de papesses ou seulement de clergeonnes. La messe est purement virile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6206320a-759f-3caa-864e-c3578118d8a5",
                                        "entry_id": "75aa5dcc-d6f6-32c8-8f1a-eedfeea3bda0",
                                        "glosses": [
                                            "Image ou représentation d’une sainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceb1ecaa-7979-411d-9465-762c5e5e7c5e",
                                                "sense_id": "6206320a-759f-3caa-864e-c3578118d8a5",
                                                "text": "Ces saints et ces saintes ont tous une auréole en disque, à leur nom, qui s'accorde avec les médailles décoratives (hagiographiques et non antiquisantes) placées sur les montants du premier étage."
                                            },
                                            {
                                                "example_id": "79aded06-8ee3-403b-b9b7-5867326974fb",
                                                "sense_id": "6206320a-759f-3caa-864e-c3578118d8a5",
                                                "text": "Sous les pieds partaient des amorces\nOn promenait un saint doré\nCe qui tournait au tour de force\nDans les ombres démesurées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3954bc2c-2f68-3a5f-9380-4af4cdb5c366",
                                        "entry_id": "75aa5dcc-d6f6-32c8-8f1a-eedfeea3bda0",
                                        "glosses": [
                                            "Femme d’une haute valeur morale, vivant de manière exemplaire et reconnue comme telle par la société."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sainte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f13f0b4-85e9-3183-a10d-9cdd3c7c4baa",
                                        "entry_id": "f0e927bc-76fd-321c-bfc2-65364de662c7",
                                        "glosses": [
                                            "Féminin singulier de saint."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dac13b17-e0e4-4dc8-8854-558997180bcd",
                                                "sense_id": "5f13f0b4-85e9-3183-a10d-9cdd3c7c4baa",
                                                "text": "L’idée d’une Ecriture sainte de la nouvelle alliance a été tout à fait étrangère au premier siècle chrétien qui n’a pas connu d’autre recueil canonique que l’Ancien Testament."
                                            },
                                            {
                                                "example_id": "0d700c97-fa4e-4a7c-8f9c-a20361dba41f",
                                                "sense_id": "5f13f0b4-85e9-3183-a10d-9cdd3c7c4baa",
                                                "text": "On peut l’affirmer en toute confiance : Le Dieu-homme est la toute-vertu. C’est pourquoi la sainte mission assignée à la vie de tout chrétien est de se porter acquéreur de toute vertu, de se christifier, de se divino-humaniser, de se trinitariser — Oui, de se trinitariser, car là où est le Fils, là est aussi le Père, et là aussi est l’Esprit saint, la Trinité tri-hypostatique et indivisible tout entière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sainte",
                                "target_lang_code": "fr",
                                "target_senses": [
