{
    "word_family": [
        "cruiser"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60d9351f-3078-3be9-a326-bc2639c3ca54",
                    "sense_definition": "A sea or lake voyage, especially one taken for pleasure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voyage_pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are planning a <w>cruise</w> around the Mediterranean islands next summer.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>круиз</w> по островам Средиземного моря следующим летом.",
                                "zh": "我们计划明年夏天去地中海岛屿进行一次<w>游轮旅行</w>。"
                            }
                        },
                        {
                            "text": "The luxury <w>cruise</w> stopped at several famous ports along the coast.",
                            "target_lang_translations": {
                                "ru": "Этот роскошный <w>круиз</w> включал остановки в нескольких известных портах вдоль побережья.",
                                "zh": "这次豪华<w>游轮旅行</w>沿途停靠了几个著名的港口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "voyage",
                        "trip",
                        "boat trip"
                    ],
                    "common_phrases": [
                        "go on a cruise",
                        "luxury cruise",
                        "cruise ship",
                        "cruise liner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морское или озерное путешествие, совершаемое обычно ради удовольствия.",
                        "zh": "在海上或湖上的旅行，通常是为了娱乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круиз",
                                "target_lang_sense_clarification": "путешествие на корабле"
                            },
                            {
                                "target_lang_word": "морское путешествие",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "游轮旅行",
                                "target_lang_sense_clarification": "乘坐游轮的度假方式"
                            },
                            {
                                "target_lang_word": "海上巡游",
                                "target_lang_sense_clarification": "海上航行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb76ce2-2292-3a19-acb9-67b7ceb7d8f3",
                    "sense_definition": "The portion of aircraft travel at a constant airspeed and altitude between ascent and descent phases.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "constant_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot announced that we had reached <w>cruise</w> and could move about the cabin.",
                            "target_lang_translations": {
                                "ru": "Пилот объявил, что мы вышли в <w>крейсерский режим</w> и можем передвигаться по салону.",
                                "zh": "飞行员宣布我们已进入<w>巡航</w>阶段，可以在机舱内走动。"
                            }
                        },
                        {
                            "text": "During <w>cruise</w>, the aircraft consumes fuel at a steady and efficient rate.",
                            "target_lang_translations": {
                                "ru": "Во время <w>крейсерского полета</w> самолет расходует топливо с постоянной и эффективной скоростью.",
                                "zh": "在<w>巡航</w>期间，飞机的燃油消耗保持在稳定且高效的水平。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cruise altitude",
                        "cruise speed",
                        "cruise phase"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "aviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть полета самолета с постоянной скоростью и высотой между фазами набора высоты и снижения.",
                        "zh": "飞机在起飞和降落阶段之间，以恒定速度和高度飞行的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крейсерский режим",
                                "target_lang_sense_clarification": "авиация"
                            },
                            {
                                "target_lang_word": "крейсерский полет",
                                "target_lang_sense_clarification": "фаза полета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡航",
                                "target_lang_sense_clarification": "航空术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c49a516-1651-3935-9272-f8a728234f92",
                    "sense_definition": "To sail about, especially for pleasure.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voyage_pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>cruised</w> along the river enjoying the sunny afternoon.",
                            "target_lang_translations": {
                                "ru": "Они <w>плыли</w> по реке, наслаждаясь солнечным днем.",
                                "zh": "他们<w>巡游</w>在河面上，享受着阳光明媚的午后。"
                            }
                        },
                        {
                            "text": "We plan to <w>cruise</w> the Caribbean on a rented yacht this winter.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>совершить круиз</w> по Карибскому морю на арендованной яхте этой зимой.",
                                "zh": "我们计划今年冬天租一艘游艇在加勒比海<w>巡游</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sail",
                        "voyage"
                    ],
                    "common_phrases": [
                        "cruise around",
                        "cruise the coast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плавать на судне, особенно ради удовольствия.",
                        "zh": "乘船航行，尤指为了娱乐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершать круиз",
                                "target_lang_sense_clarification": "путешествовать по воде"
                            },
                            {
                                "target_lang_word": "плавать",
                                "target_lang_sense_clarification": "передвигаться по воде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡游",
                                "target_lang_sense_clarification": "乘船游览"
                            },
                            {
                                "target_lang_word": "航行",
                                "target_lang_sense_clarification": "在水上移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a311914f-5182-3c79-a3fe-6fc5f1ce8375",
                    "sense_definition": "To travel at a constant speed for maximum operating efficiency, often used regarding cars or planes.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "constant_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car <w>cruised</w> down the highway at sixty miles per hour.",
                            "target_lang_translations": {
                                "ru": "Машина <w>ехала</w> по шоссе со скоростью шестьдесят миль в час.",
                                "zh": "汽车以每小时六十英里的速度在高速公路上<w>巡航</w>行驶。"
                            }
                        },
                        {
                            "text": "Once we reached the open road, we set the system and <w>cruised</w> comfortably.",
                            "target_lang_translations": {
                                "ru": "Как только мы выехали на открытую дорогу, мы включили систему и с комфортом <w>ехали с постоянной скоростью</w>.",
                                "zh": "一旦进入开阔路段，我们便开启系统，舒适地<w>巡航</w>行驶。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cruise control",
                        "cruise at speed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться с постоянной скоростью для максимальной эффективности (обычно о машинах или самолетах).",
                        "zh": "以恒定速度行驶以达到最高效率，常用于汽车或飞机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать с крейсерской скоростью",
                                "target_lang_sense_clarification": "об автомобиле"
                            },
                            {
                                "target_lang_word": "идти ровно",
                                "target_lang_sense_clarification": "двигаться без ускорений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡航",
                                "target_lang_sense_clarification": "保持恒定速度行驶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08444373-2b31-3e41-8c40-eed7b9c7fdd8",
                    "sense_definition": "To move about an area leisurely, often in a vehicle, in the hope of discovering something or looking for social interaction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leisurely_search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teenagers used to <w>cruise</w> the main street on Friday nights to see their friends.",
                            "target_lang_translations": {
                                "ru": "Подростки раньше <w>разъезжали</w> по главной улице по пятницам, чтобы повидаться с друзьями.",
                                "zh": "青少年过去常在周五晚上开车在主街上<w>兜风</w>，以便和朋友见面。"
                            }
                        },
                        {
                            "text": "The police car <w>cruised</w> slowly through the neighborhood on patrol.",
                            "target_lang_translations": {
                                "ru": "Полицейская машина медленно <w>патрулировала</w> район.",
                                "zh": "警车在社区里缓慢地<w>巡逻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roam",
                        "wander",
                        "patrol"
                    ],
                    "common_phrases": [
                        "cruise the streets",
                        "cruise around town"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспешно передвигаться по какой-либо территории (часто на транспорте) в поисках чего-либо или ради общения.",
                        "zh": "在某区域内悠闲地移动（常指驾车），以寻找某物或进行社交。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъезжать",
                                "target_lang_sense_clarification": "кататься без определенной цели"
                            },
                            {
                                "target_lang_word": "колесить",
                                "target_lang_sense_clarification": "ездить по местности"
                            },
                            {
                                "target_lang_word": "патрулировать",
                                "target_lang_sense_clarification": "о полиции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兜风",
                                "target_lang_sense_clarification": "驾车闲逛"
                            },
                            {
                                "target_lang_word": "巡逻",
                                "target_lang_sense_clarification": "指警察等执行任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb8a34a-749b-397e-baa3-68ac074d916f",
                    "sense_definition": "To win or progress easily and convincingly in a competition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "win_easily",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion <w>cruised</w> to victory in the final match of the tournament.",
                            "target_lang_translations": {
                                "ru": "Чемпион <w>легко пришел</w> к победе в финальном матче турнира.",
                                "zh": "冠军在锦标赛决赛中<w>轻松获胜</w>。"
                            }
                        },
                        {
                            "text": "Despite a slow start, the team <w>cruised</w> through the qualifying rounds.",
                            "target_lang_translations": {
                                "ru": "Несмотря на медленный старт, команда <w>легко прошла</w> квалификационные раунды.",
                                "zh": "尽管开局缓慢，该队还是<w>轻松</w>通过了资格赛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breeze",
                        "sweep"
                    ],
                    "antonyms": [
                        "struggle"
                    ],
                    "common_phrases": [
                        "cruise to victory",
                        "cruise into the finals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко и убедительно побеждать или продвигаться вперед в соревновании.",
                        "zh": "在比赛中轻松且令人信服地获胜或晋级。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легко побеждать",
                                "target_lang_sense_clarification": "выигрывать без усилий"
                            },
                            {
                                "target_lang_word": "уверенно идти",
                                "target_lang_sense_clarification": "к победе или финалу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻松获胜",
                                "target_lang_sense_clarification": "不费力地赢下比赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe75888-34a0-3cb3-bd30-bb44ed869ae5",
                    "sense_definition": "To actively seek a romantic or sexual partner by moving about a particular area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "leisurely_search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He went to the club to <w>cruise</w> for a date.",
                            "target_lang_translations": {
                                "ru": "Он пошел в клуб, чтобы <w>подцепить</w> кого-нибудь для свидания.",
                                "zh": "他去俱乐部是为了<w>寻觅</w>约会对象。"
                            }
                        },
                        {
                            "text": "They spent the evening <w>cruising</w> the local bars.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер, <w>ходя</w> по местным барам в поисках знакомств.",
                                "zh": "他们花了一整晚在当地酒吧里<w>寻觅</w>伴侣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "troll"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Активно искать романтического или сексуального партнера, перемещаясь по определенной территории.",
                        "zh": "通过在特定区域内移动，积极寻找浪漫或性伴侣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искать партнера",
                                "target_lang_sense_clarification": "знакомиться"
                            },
                            {
                                "target_lang_word": "снимать",
                                "target_lang_sense_clarification": "сленг, искать сексуального партнера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寻觅伴侣",
                                "target_lang_sense_clarification": "寻找约会对象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a64871f2-251d-308d-9319-32a49d8786a7",
                    "sense_definition": "To walk while holding on to an object, typically referring to a stage in a baby's development.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baby_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby has started to <w>cruise</w> around the furniture in the living room.",
                            "target_lang_translations": {
                                "ru": "Ребенок начал <w>ходить, держась</w> за мебель в гостиной.",
                                "zh": "宝宝已经开始<w>扶着</w>客厅里的家具走动了。"
                            }
                        },
                        {
                            "text": "Before they can walk independently, most infants will <w>cruise</w> along tables and chairs.",
                            "target_lang_translations": {
                                "ru": "Прежде чем начать ходить самостоятельно, большинство младенцев <w>передвигаются, держась</w> за столы и стулья.",
                                "zh": "在能够独立行走之前，大多数婴儿会<w>扶着</w>桌椅走动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "child development"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить, держась за предметы (обычно о стадии развития ребенка).",
                        "zh": "扶着物体行走，通常指婴儿发育的一个阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить, держась за опору",
                                "target_lang_sense_clarification": "о детях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扶着家具走",
                                "target_lang_sense_clarification": "婴儿学步阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "026e20f5-02f3-361a-a691-2c9ab03642e5",
                    "sense_definition": "A surname from Anglo-Norman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cruise</w> signed the documents yesterday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Круз</w> подписал документы вчера.",
                                "zh": "<w>克鲁斯</w>先生昨天签署了文件。"
                            }
                        },
                        {
                            "text": "Tom <w>Cruise</w> is a famous actor known for action movies.",
                            "target_lang_translations": {
                                "ru": "Том <w>Круз</w> — известный актер, знаменитый своими ролями в боевиках.",
                                "zh": "汤姆·<w>克鲁斯</w>是一位以动作片闻名的著名演员。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия англо-нормандского происхождения.",
                        "zh": "源自盎格鲁-诺曼语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Круз",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "克鲁斯",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}