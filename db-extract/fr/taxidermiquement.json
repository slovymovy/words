                        "examples": [
                            {
                                "example_id": "80c2b621-5b02-45b4-94ad-6c9ac44f6133",
                                "sense_id": "6dcf3141-c977-392f-a6ae-a71c0c0745ee",
                                "text": "Désirant préparer taxidermiquement un des argalis, nous avions emmené avec nous des pâtres qui se chargèrent de transporter ce bel échantillon de la faune du Khorassan."
                            },
                            {
                                "example_id": "38a19f64-e105-4078-aed8-6ed49f847113",
                                "sense_id": "6dcf3141-c977-392f-a6ae-a71c0c0745ee",
                                "text": "[…] ; maintenant, on en gratte la moindre pierre jusqu'à les faire ressembler à des os blanchis, et, pelés, plumés, vidés, nettoyés, une fois taxidermiquement désinfectés et désaffectés, on y installe une billetterie et une boutique de brimborions, et on le live à la curiosité des foules."
                            }
                        ]
