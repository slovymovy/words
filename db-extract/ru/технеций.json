                                        "entry_id": "7b97c5fd-5ee1-3867-9fbc-bd5cf8eabd2d",
                                        "glosses": [
                                            "scheikundig element met symbool Tc en atoomnummer 43. Het is een zilvergrijs overgangsmetaal"
                                        ],
                                        "tags": [
                                            "element"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1613c5-9090-4707-944f-a1bc0b3bee6f",
                                                "sense_id": "ede4d42c-5d9e-3946-bc83-168dba579696",
                                                "text": "Technetium komt van nature niet op aarde voor, maar een radioactieve vorm kan in kernreactoren vervaardigd worden en vindt toepassing in de kankerbestrijding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
