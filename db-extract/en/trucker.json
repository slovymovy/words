                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "08e3bb4e-2718-4ec1-9cfa-c021c57c3cfb",
                                "sense_id": "1f1c5d10-828b-3210-912f-b9050cf2bcbf",
                                "text": "I says, \"Pig Pen, this here's the Rubber Duck\nWe just ain't a-gonna pay no toll.\"\nSo we crashed the gate doing ninety-eight.\nI says \"Let them truckers roll, 10-4!\""
                            },
                            {
                                "example_id": "2bf8f026-7b19-4980-a22f-cd8ab7b5f9b1",
                                "sense_id": "1f1c5d10-828b-3210-912f-b9050cf2bcbf",
                                "text": "Because of deregulation and the drive to lower costs, Mr. Lorr said, truckers are now regarded by many companies as just another replaceable part. Some can barely eke out a living."
                            }
                        ]
                    }
                ],
