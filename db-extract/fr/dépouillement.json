                    {
                        "translation_id": "5c07a28f-251e-4a91-bece-ec107750a27f",
                        "source_entry_id": "2e745301-10bc-3549-9323-a6425d0c4ccb",
                        "source_sense_description": "Renoncement au monde",
                        "target_lang_word": "onthechting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onthechting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a97fbd6f-53fc-3762-844e-e1f6fd36d76b",
                                        "entry_id": "43d730aa-5705-3319-a0bb-59fd4a6521fd",
                                        "glosses": [
                                            "je losmaken van allerlei materiële behoeften en zaken"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f3d0791-ac40-3b6a-867a-50fa60e1bd65",
                                        "entry_id": "43d730aa-5705-3319-a0bb-59fd4a6521fd",
                                        "glosses": [
                                            "het loskomen van allerlei (ook niet materiële) zaken waaraan men gehecht is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "614c35d8-d464-4f28-8ad0-0b2ce8b33d69",
                                                "sense_id": "9f3d0791-ac40-3b6a-867a-50fa60e1bd65",
                                                "text": "Burgers zijn niet plotseling amoreel, egoïstisch of onthecht geraakt, al willen hun opvattingen over normen en waarden in de samenleving nogal verschillen."
                                            },
                                            {
                                                "example_id": "5575ac2b-50fe-4838-a054-e05a8a614f46",
                                                "sense_id": "9f3d0791-ac40-3b6a-867a-50fa60e1bd65",
                                                "text": "Tja, toch een huilend afscheid. Maar dat waren ook tranen van geluk om wat ik heb mogen meemaken, van onthechting ook. En natuurlijk van vermoeidheid. Ik heb dat geloof ik ook gezegd: ik was zó moeNormaal heb ik emoties en stress redelijk onder controle, maar dit is zo'n bijzonder spel en dan ook nog op de mooiste plekken. Je beleeft het allemaal zo intens..."
                                            },
                                            {
                                                "example_id": "cbf8c4dc-52db-444d-ab63-a9b41b96fd5e",
                                                "sense_id": "9f3d0791-ac40-3b6a-867a-50fa60e1bd65",
                                                "text": "Het is oppassen geblazen met ’menselijke’ robots, zeker voor wie ze wil gebruiken als kinderoppas of voor seks. Zulke robots nemen een hoge vlucht, maar kunnen zorgen voor onthechting en uiteindelijk ontwrichting van de samenleving door asociaal gedrag."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
