                    "frequency": "Middle",
                    "semantic_group_id": "cortege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles avancent lentement dans les rues pendant la <w>procession</w> religieuse."
                        },
                        {
                            "text": "Toute la paroisse participe à la grande <w>procession</w> organisée pour la fête du village."
                        }
                    ],
                    "synonyms": [
                        "cortège"
                    ],
                    "common_phrases": [
                        "procession religieuse",
                        "marcher en procession"
                    ]
                },
                {
                    "sense_id": "bd401153-80d2-34ac-8713-eb8cd2846fa1",
                    "sense_definition": "Défilé ou longue file de personnes ou d'animaux qui avancent les uns derrière les autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cortege",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une longue <w>procession</w> de manifestants traverse le boulevard principal dans le plus grand calme."
                        },
                        {
                            "text": "Les enfants forment une <w>procession</w> silencieuse pour retourner en classe après la récréation."
                        }
                    ],
                    "synonyms": [
                        "cortège",
                        "théorie"
                    ],
                    "common_phrases": [
