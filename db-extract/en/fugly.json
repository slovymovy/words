                "senses": [
                    {
                        "sense_id": "c9c3537b-7fdf-34f8-abb5-ac04b668cce7",
                        "entry_id": "a80d012a-f989-3093-b004-86e410f973e4",
                        "glosses": [
                            "Extremely ugly."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "61463f04-945d-4429-85b8-84add570a9ae",
                                "sense_id": "c9c3537b-7fdf-34f8-abb5-ac04b668cce7",
                                "text": "\"Fugly?\" \"Like extra-double ugly with cheese. It's when ugly goes off the scale. She looked like an angry handbag.\" Billie squawked in delight."
                            },
                            {
                                "example_id": "0353c0d9-dce4-4bfd-9dc2-892625527957",
                                "sense_id": "c9c3537b-7fdf-34f8-abb5-ac04b668cce7",
                                "text": "Man, but she's one fugly creature, horror-show fugly, I'm sorry."
                            },
                            {
                                "example_id": "8073c4a3-c18e-4806-aed5-85834d8e2d7c",
                                "sense_id": "c9c3537b-7fdf-34f8-abb5-ac04b668cce7",
                                "text": "This girl is the nastiest skank bitch I've ever met. Do not trust her. She is a fugly slut."
                            },
                            {
                                "example_id": "e775c681-79e5-4812-9843-a0de23cdae54",
                                "sense_id": "c9c3537b-7fdf-34f8-abb5-ac04b668cce7",
                                "text": "“Look at this photo I got with Maddison.” “You look so ---- hot.” “Nah, I'm fugly. But thanks.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b1c1e87-35d5-4848-89b1-00242a3de7e3",
                        "source_entry_id": "a80d012a-f989-3093-b004-86e410f973e4",
                        "source_sense_id": "c9c3537b-7fdf-34f8-abb5-ac04b668cce7",
                        "source_sense_description": "extremely ugly",
                        "target_lang_word": "oerlelijk",
