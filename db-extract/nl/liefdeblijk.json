                        "examples": [
                            {
                                "example_id": "bf67d0bb-c948-46f7-89a3-2840fbfe5b7d",
                                "sense_id": "8501c68d-53cf-32b8-9ca0-3ef87400f50a",
                                "text": "Van deernis met hem, die verbannen werd om een al te oprecht liefdeblijk, sprongen de tranen hem in de ogen, maar dadelijk klaarde zijn gezicht ook weer op bij het denkbeeld dat zijn uiting van aanhankelijkheid, met enkele boekels, deze vorst zo welgevallig mocht zijn dat Zijne Majesteit haar vervolgens aan alle mensen voorschreef."
                            },
                            {
                                "example_id": "e73da00c-3381-4965-ad17-98c8e10146ef",
                                "sense_id": "8501c68d-53cf-32b8-9ca0-3ef87400f50a",
                                "text": "Omdat liefde nooit blind kan zijn, moeten Westerse christenen in hun liefde tot Oost-Europese christenen nooit lukraak hulp bieden, maar liefdeblijken altijd in het kader van Gods koninkrijk stellen, aldus de predikant."
                            }
                        ]
                    }
