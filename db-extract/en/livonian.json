                    {
                        "translation_id": "b1396e65-dedb-4995-9e14-4ec88651c1b8",
                        "source_entry_id": "8287672b-3b42-3a0f-9ed3-803c43bc296a",
                        "source_sense_id": "d5086372-34d1-3b05-98ad-fec4b64a1b00",
                        "source_sense_description": "language",
                        "target_lang_word": "Livisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Livisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac39e5bf-90f1-3860-b41f-e0da244cc606",
                                        "entry_id": "d4ae6866-5a76-3b2e-9257-164cd12f785b",
                                        "glosses": [
                                            "von den Liven im Westen Lettlands gesprochene Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680ea7cc-1b01-4865-b250-68e73cdc84f1",
                                                "sense_id": "ac39e5bf-90f1-3860-b41f-e0da244cc606",
                                                "text": "„Je nach Erhebungsmethode sprechen heute noch etwa fünf bis zwanzig Liven ihre Sprache als Muttersprache. Livisch ist also aktuell hochgradig vom Aussterben bedroht.“"
                                            },
                                            {
                                                "example_id": "3d184163-ec7d-47e1-b82f-5aaa21f47ca0",
                                                "sense_id": "ac39e5bf-90f1-3860-b41f-e0da244cc606",
                                                "text": "„Livisch weist sogar einige Elemente auf, die in den anderen finno-ugrischen Sprachen bereits vor lange Zeit verloren gegangen sind.“"
                                            },
                                            {
                                                "example_id": "0bffedc4-4265-41a3-854c-7d59099aac5d",
                                                "sense_id": "ac39e5bf-90f1-3860-b41f-e0da244cc606",
                                                "text": "„Die dritte im Gesetz zur Staatssprache erwähnte Varietät ist das Livische, eine finno-ugrische Kleinstsprache, die heute nur noch von einer Hand voll Sprechern beherrscht wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
