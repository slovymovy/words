                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15f0a388-4012-433d-bc5e-2dceec2cbe20",
                                                "sense_id": "008176b6-3741-33f2-b22e-dd95942c8031",
                                                "text": "They came down to buy sugar, flour, saltfish or candy from Nana, to collect letters and exchange gossip."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbfa970c-56f3-3b49-a9ce-f10c6504bc34",
                                        "entry_id": "897009fa-8047-35ad-8e1a-8feb93a6796e",
                                        "glosses": [
                                            "A piece of confectionery of this kind."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "370d3be0-462f-4a1d-af40-91534f2de270",
                                                "sense_id": "dbfa970c-56f3-3b49-a9ce-f10c6504bc34",
                                                "text": "Unwholesome pink and yellow candies were sold from trays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea714594-b1f4-3da8-bbac-6eeb4bccc57a",
                                        "entry_id": "897009fa-8047-35ad-8e1a-8feb93a6796e",
                                        "glosses": [
                                            "crack cocaine."
                                        ],
                                        "tags": [
                                            "US",
