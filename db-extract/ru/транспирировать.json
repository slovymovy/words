                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99c24993-5567-3c2d-9a1a-b9bb0a83323c",
                                        "entry_id": "a22737d4-da67-35e1-aa69-006498d325f4",
                                        "glosses": [
                                            "Of plants, to give off water and waste products through the stomata."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "663005d4-41ba-3506-9684-8d952a05a281",
                                        "entry_id": "a22737d4-da67-35e1-aa69-006498d325f4",
                                        "glosses": [
                                            "To become known; to escape from secrecy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc760ca-ab40-4423-9a4f-69ebd153b23a",
                                                "sense_id": "663005d4-41ba-3506-9684-8d952a05a281",
                                                "text": "It eventually transpired that the murder victim had been a notorious blackmailer."
                                            },
                                            {
                                                "example_id": "7b72cb86-0114-409d-8716-3b4a86f19476",
                                                "sense_id": "663005d4-41ba-3506-9684-8d952a05a281",
                                                "text": "The story of Paulina's and Maximilian's mutual attachment had transpired through many of the travellers."
                                            },
                                            {
                                                "example_id": "8cd659b3-45ff-47ad-a77a-555bd0784af0",
                                                "sense_id": "663005d4-41ba-3506-9684-8d952a05a281",
                                                "text": "Hubert then recommends M. Leproux to be punctual to meet him at the rendezvous agreed on between them, where a third individual, whose name did not transpire, was to join them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5701449c-3a5e-309f-aba6-5dc0f265eda3",
                                        "entry_id": "a22737d4-da67-35e1-aa69-006498d325f4",
                                        "glosses": [
                                            "To happen, take place."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba635324-8cea-4533-9a24-b154cbd0ff98",
                                                "sense_id": "5701449c-3a5e-309f-aba6-5dc0f265eda3",
                                                "text": "Although I was prevented from attending the 1952 annual conference, I was immediately informed as to what had transpired."
                                            },
                                            {
                                                "example_id": "87cfd757-fed3-4ccb-a38a-18ac891546d1",
                                                "sense_id": "5701449c-3a5e-309f-aba6-5dc0f265eda3",
                                                "text": "But there is a school of thought that holds that the more you talk about recession, the more likely it is to transpire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
