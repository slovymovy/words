                        ]
                    },
                    {
                        "translation_id": "f6f8b970-37a6-4305-b10d-c001e1f98fa5",
                        "source_entry_id": "91df0d6e-8cff-3dbd-b781-d6a501d239da",
                        "source_sense_id": "25b6a000-5768-3fa7-9c23-7e4a7e4366ef",
                        "source_sense_description": "Gerät, mit dem in einem Behälter ein Vakuum erzeugt werden kann",
                        "target_lang_word": "pompe à vide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompe à vide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52925f41-d2d0-337f-90dc-e36f578e0c19",
                                        "entry_id": "c2ae1be7-0e95-3bd8-baec-ff5f09a4438c",
                                        "glosses": [
                                            "Dispositif permettant d’extraire l’air ou les gaz contenus dans une enceinte close, ce qui diminue la pression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa2f342-9fe3-4870-9ea1-175d2ce34ca8",
                                                "sense_id": "52925f41-d2d0-337f-90dc-e36f578e0c19",
                                                "text": "Une pompe à vide est une pièce indispensable au freinage d’un véhicule diesel. Elle permet en effet de faciliter le freinage en créant une dépression d’air de manière à réduire l’effort nécessaire au niveau de la pédale de frein."
                                            },
                                            {
                                                "example_id": "8082afc2-9178-4fde-b2dc-b9406bb65484",
                                                "sense_id": "52925f41-d2d0-337f-90dc-e36f578e0c19",
                                                "text": "Une pompe à vide de laboratoire est un appareil destiné à aspirer les gaz et l’air contenus dans une enceinte afin d’y créer le vide. Selon leur type, les pompes à vide de laboratoire sont capables de créer un vide primaire (>10⁻⁶ mbar), un vide secondaire (<10⁻⁶ mbar et >10⁻⁹ mbar) ou l’ultravide (<10⁻⁹ mbar)."
                                            },
                                            {
                                                "example_id": "6b55895b-8d54-45fe-a05c-f5dc54e699d2",
                                                "sense_id": "52925f41-d2d0-337f-90dc-e36f578e0c19",
                                                "text": "La pompe à vide à deux étages est constituée de deux pompes associées en série. Ce type de pompe à vide permet d’obtenir une pression limite d’environ dix fois plus petite que celle d’une pompe à vide à un seul étage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
