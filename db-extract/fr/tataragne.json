                                        "examples": [
                                            {
                                                "example_id": "39299be6-cc16-4778-8f64-b6a4f0b58d8a",
                                                "sense_id": "e8eafd8f-b14f-380d-bfba-374aadacd801",
                                                "text": "Cut slices and lay them in cold water in the spider; boil them up two or three minutes, then pour off the water and set the spider again on the coals and brown the slices on each side."
                                            },
                                            {
                                                "example_id": "2be5143e-3d55-466d-a1e2-2c211c886ba0",
                                                "sense_id": "e8eafd8f-b14f-380d-bfba-374aadacd801",
                                                "text": "In spider pan or deep skillet set over hot coals, quickly fry a few at a time in deep lard until brown."
                                            },
                                            {
                                                "example_id": "8148366f-9b0a-428d-98e3-cd118331a698",
                                                "sense_id": "e8eafd8f-b14f-380d-bfba-374aadacd801",
                                                "text": "2008, Corona Club (San Francisco, California), Corona Club Cook Book, page 202,\nMelt ½ the dry sugar in the spider, stirring with knife until all is melted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851bbc93-7d8f-3734-a995-f0ddd976ca7e",
                                        "entry_id": "f73d8d49-333c-3d8d-8c9d-eed8626570d7",
                                        "glosses": [
                                            "Implement for moving food in and out of hot oil for deep frying, with a circular metal mesh attached to a long handle; a spider skimmer"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19b61cb-1f2b-4173-b9fd-8243b5a039d8",
                                                "sense_id": "851bbc93-7d8f-3734-a995-f0ddd976ca7e",
                                                "text": "If you are deep-frying your falafel, use a spider or basket to place them gently into the hot oil, which should be preheated to a temperature of 175°C (330°F)."
                                            },
                                            {
                                                "example_id": "73f23a99-933e-478b-8336-df4e6fe27d24",
                                                "sense_id": "851bbc93-7d8f-3734-a995-f0ddd976ca7e",
                                                "text": "Consider investing in a frying basket or a spider for small amounts of fish. A spider looks like a metal web and has a long handle and can lower and raise fish from the hot oil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a40faf-d0c1-32a9-866e-9e076f86c9c2",
                                        "entry_id": "f73d8d49-333c-3d8d-8c9d-eed8626570d7",
                                        "glosses": [
                                            "A part of a crank, to which the chainrings are attached."
