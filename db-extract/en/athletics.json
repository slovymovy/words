                                "target_senses": [
                                    {
                                        "sense_id": "94d6c09e-4466-31c9-ae95-786b57b1e2f0",
                                        "entry_id": "c95b99c9-1404-3718-aea4-ee992637c108",
                                        "glosses": [
                                            "Ensemble des exercices auxquels on se livre afin d’amener le corps à son entier développement et à son maximum de force et de souplesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30721595-ce8a-4160-aba0-e2921f25fdb5",
                                                "sense_id": "94d6c09e-4466-31c9-ae95-786b57b1e2f0",
                                                "text": "L’athlétisme, c’est bon pour la santé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b60066e-e1f7-3984-a50a-dbbc7c1837dc",
                                        "entry_id": "c95b99c9-1404-3718-aea4-ee992637c108",
                                        "glosses": [
                                            "Ensemble des sports de course, de saut et de lancer pratiqués par l'athlète."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9dd2eea-5f38-4ace-b03f-a20cfde02685",
                                                "sense_id": "6b60066e-e1f7-3984-a50a-dbbc7c1837dc",
                                                "text": "« Je crois qu’il y a deux athlétismes, il y a deux vitesses, il y a un double langage. Ou on fait des contrôles efficaces ou on n’en fait pas."
                                            },
                                            {
                                                "example_id": "a85b92fa-0b61-4800-912e-91afac95c0f7",
                                                "sense_id": "6b60066e-e1f7-3984-a50a-dbbc7c1837dc",
                                                "text": "Les règles du sprint en athlétisme stipulent depuis 2002 que, si un athlète quitte les starting blocks en moins de 100 ms (0,1 s) après le coup de feu, il sera sanctionné d'un faux départ."
                                            },
                                            {
                                                "example_id": "98e7aafa-e1ac-427d-b8ed-26e7bae8cbac",
                                                "sense_id": "6b60066e-e1f7-3984-a50a-dbbc7c1837dc",
                                                "text": "L'équipe des hockeyeuses avait disparu, mais il trouva sans mal le gymnase, un bâtiment bas près d'une piste d’athlétisme, avec sur le devant une grande statue représentant un discobole."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
