                "senses": [
                    {
                        "sense_id": "d943de34-104b-31db-a644-9babb33b3226",
                        "entry_id": "d2fda1d2-1929-3ea9-a2c3-eb90fb04653c",
                        "glosses": [
                            "technisches Gerät, das dabei hilft, ein vorgegebenes Ziel zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db07f472-03a2-4f00-b91f-f5eecf1afd3a",
                                "sense_id": "d943de34-104b-31db-a644-9babb33b3226",
                                "text": "„Leichtsinnigerweise besitzen wir immer noch kein Navigationsgerät.“"
                            },
                            {
                                "example_id": "94024037-1a8d-49d4-8d42-0905de2403a2",
                                "sense_id": "d943de34-104b-31db-a644-9babb33b3226",
                                "text": "„Es macht den Anschein als ob die Zeit traditioneller Navigationsgeräte der Vergangenheit angehört.“"
                            },
                            {
                                "example_id": "bec8d4e8-3c82-407f-bc68-73e98f803a65",
                                "sense_id": "d943de34-104b-31db-a644-9babb33b3226",
                                "text": "„Ein Lastwagenfahrer hat sich in Schwaben von dem Navigationsgerät in die Irre leiten lassen und dadurch seinen 40-Tonner fast zum Umkippen gebracht.“"
                            },
                            {
                                "example_id": "6392c583-2669-49d4-80fb-fb811c30be41",
                                "sense_id": "d943de34-104b-31db-a644-9babb33b3226",
                                "text": "„Im Wagen ist nur noch die Stimme des Navigationsgeräts zu hören.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
