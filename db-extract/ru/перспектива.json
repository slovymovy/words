                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd844f08-8fb7-49c6-9da0-76b4597c026a",
                                                "sense_id": "919d04e2-c976-3f61-8677-0a7bcb23bb8f",
                                                "text": "Ich suche nach einer neuen Perspektive."
                                            },
                                            {
                                                "example_id": "9f1c68f0-efc3-4a3c-8e68-23c7e5739f53",
                                                "sense_id": "919d04e2-c976-3f61-8677-0a7bcb23bb8f",
                                                "text": "„Die Teilnahme an dem Projekt soll dazu beitragen, Hemmschwellen vor Hochschulen abzubauen und die Perspektive eines Studiums zu eröffnen.“"
                                            },
                                            {
                                                "example_id": "2cc45c57-ab1f-4007-94fc-a425b5ce3f73",
                                                "sense_id": "919d04e2-c976-3f61-8677-0a7bcb23bb8f",
                                                "text": "[Ostdeutschland:] „Junge Frauen verlassen nach der Schule in Scharen wegen fehlender Perspektiven ihre Heimat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3f57ee8e-e247-3b0d-bc28-3f13b2cce694",
                                        "entry_id": "a91413ea-6045-3cda-9aae-94946bdd765f",
                                        "glosses": [
