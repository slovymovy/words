                ],
                "senses": [
                    {
                        "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                        "entry_id": "c88c584c-8b98-3c6c-b197-78a2f27b3e99",
                        "glosses": [
                            "industriell gefertigtes nährstoffhaltiges Substrat, das das Wachstum von Pflanzen sicherstellen soll"
                        ],
                        "tags": [
                            "Gärtnern",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "bba3b997-6304-45bc-a237-2bbe43d5f095",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "Aus unserem Biomüll erzeugt der Recyclinghof in 10 Wochen sehr nährstoffreiche Pflanzenerde."
                            },
                            {
                                "example_id": "9c1c81e4-66ca-463f-90de-22571355c428",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "In jedem Baumarkt oder Gartencenter gibt es heute torffreie Pflanzenerde."
                            },
                            {
                                "example_id": "45162c06-f170-4929-b632-f7b7f607ac92",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "Wegen des möglichen Schimmels wird Pflanzenerde in Büros fast nie verwendet, sondern meist Blähton mit Flüssigdünger."
                            },
                            {
                                "example_id": "3a57a279-1dbe-4c76-a295-a546d8a82c5f",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Wer im Gartencenter Erde kaufen will, hat die Qual der Wahl. Palettenweise Säcke mit verschiedensten Garten- und Pflanzenerden.“"
                            },
                            {
                                "example_id": "8dd35c09-06a1-4432-9a6f-5bc18eb47904",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Wie der Hersteller aussagt, ist die Rezeptur für diese Pflanzenerde vom Profi-Gartenbau abgeleitet, wobei die enthaltenen Holzfasern aus regionaler Produktion stammen sollen.“"
                            },
                            {
                                "example_id": "6041913b-a741-4653-afab-cdf863d883a5",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "[Schlagzeile:] „Wieviel darf ein Sack Pflanzenerde kosten?“"
                            },
                            {
                                "example_id": "29b371ff-62ec-404a-88b1-17ceeb4024ad",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Aus Mutterboden, Kompost, Sand und Steinmehl können Sie auch ganz einfach hochwertige Pflanzenerde selbst mischen: Wenn man Beete neu anlegen will oder einen ausgelaugten Boden wieder fruchtbar machen will, ist das die günstigste Methode.“"
                            },
                            {
                                "example_id": "a880d253-4d60-4b15-b91e-d33efea23373",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Pflanzenerde ist kostbar und teuer. Daher ist es sinnvoll, sie so lange wie möglich zu nutzen.“"
                            },
                            {
                                "example_id": "c679b703-54e5-4759-8496-8d8c5362c844",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Blumen- oder Pflanzenerde ohne Torf ist eigentlich bis heute fast undenkbar.“"
                            },
                            {
                                "example_id": "827ad086-7755-42e8-8056-a441dab72b10",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Außerdem wichtig: Die Pflanzenerde sollte torffrei sein – was eher selten der Fall ist.“"
                            },
                            {
                                "example_id": "b16fce11-cde3-40a9-8653-ae875b6f3adc",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Umwelt. – Torf ist der Stoff, auf dem fast alles im industriellen Gartenbau heranwächst. Doch Torf ist nicht nur eine attraktive Pflanzenerde, sondern auch abgebautes Moor.“"
                            },
                            {
                                "example_id": "7d8c836b-1cf4-413e-8a69-89ab2e62559a",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Wie überall in Zentraleuropa wird im Westermoor seit den 50-er Jahren Torf abgebaut, um daraus Pflanzenerde herzustellen. Bis heute ist Deutschland der größte Substrat- und Erdenproduzent Europas.“"
                            },
                            {
                                "example_id": "1c4881ae-fdbc-410f-af64-5c8e5996b9f4",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Mittlerweile verkauft das Unternehmen bis zu 5.000 m³ zertifizierte Pflanzenerde pro Jahr.“"
                            },
                            {
                                "example_id": "979af040-8dff-4c70-a3d2-d57660790eea",
                                "sense_id": "1352674c-b35f-347a-96d9-b6c12e956891",
                                "text": "„Ganz wichtig bei den Dickblattgewächsen: Sie mögen es auch bei der Erde eher mager und karg. Heißt: Normale Pflanzenerde vertragen sie nicht, sie ist ihnen zu üppig. Besser sollte man sie daher in eine 1:1 Mischung von Erde und Sand setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
