                        "entry_id": "78ee9f92-0d61-3e23-8a75-9cd05c4e11e4",
                        "glosses": [
                            "Rollicking; lively, boisterous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0223aff-a2f7-4a49-8285-4d82bb1d69df",
                                "sense_id": "cfdf040f-f869-39a1-998e-7f0c3e0173d0",
                                "text": "The cause was very evident, for there was Larry in the midst of a group of seamen, dancing an Irish jig to the tune of one of his most rollicksome songs."
                            },
                            {
                                "example_id": "38af3f44-626c-42f6-854f-c10d3241ae83",
                                "sense_id": "cfdf040f-f869-39a1-998e-7f0c3e0173d0",
                                "text": "With genuine and heartfelt emotion they shook hands and looked into each other's eyes—these two who had not met for long years, since the rollicksome days of student life in Paris when they had been as intimate as brothers."
                            },
                            {
                                "example_id": "22c7bde9-f29d-491c-80da-99b5242dd905",
                                "sense_id": "cfdf040f-f869-39a1-998e-7f0c3e0173d0",
                                "text": "Let him see one of the little white beds where he will sleep after you return home, the sunny dining room where he will eat his morning porridge and his Sunday ice cream; the playground full of rollicksome youngsters, with whom he will seesaw and play tag by and by, and the busy schoolroom, where so many delightful and interesting things are sure to happen."
                            }
                        ]
                    }
