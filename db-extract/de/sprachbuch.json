                "senses": [
                    {
                        "sense_id": "e27c1f5c-dba2-3324-b07f-454ba549a143",
                        "entry_id": "9115fdca-2759-37fa-9f52-5723985bad30",
                        "glosses": [
                            "Buch, das dem Erlernen einer Fremdsprache oder der Muttersprache dienlich sein soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b966174-b2cb-4895-9f99-0ae9595bf8b3",
                                "sense_id": "e27c1f5c-dba2-3324-b07f-454ba549a143",
                                "text": "„Die ältesten deutsch-italienischen Sprachbücher (Glossare, verbunden mit anderen sprachdidaktischen Textsorten) stehen im Zusammenhang mit engen Handelskontakten zwischen Nürnberg, Augsburg, Ulm und Köln mit den norditalienischen Handelszentren.“"
                            },
                            {
                                "example_id": "c8241de0-52b8-4536-a300-3297147cca11",
                                "sense_id": "e27c1f5c-dba2-3324-b07f-454ba549a143",
                                "text": "„Was müssen Sprachbücher in einem verbundenen Sprachunterricht leisten?“"
                            },
                            {
                                "example_id": "9be0e212-fd36-488d-b5b2-e7b5e7aefcad",
                                "sense_id": "e27c1f5c-dba2-3324-b07f-454ba549a143",
                                "text": "„Auf dem Schreibtisch lagen fast nur noch die Sprachbücher.“"
                            },
                            {
                                "example_id": "82f9769c-9c58-4fe6-9ca4-63439718abcb",
                                "sense_id": "e27c1f5c-dba2-3324-b07f-454ba549a143",
                                "text": "„Im Sprachbuch war eine Seite, auf der wir alle Buchstaben ausmalen konnten, die wir durchgenommen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
