                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning mist began to <w>invest</w> the valley in a soft white blanket.",
                            "target_lang_translations": {
