                ],
                "senses": [
                    {
                        "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                        "entry_id": "486f9ba3-3d47-3da2-846f-58b979432249",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3734cb2-0026-4c75-b150-53e98597b003",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Frau Ensch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e96e8f66-a472-4f41-9574-147274975c26",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Herr Ensch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d757037b-ff8c-4fba-ab37-f937e65e68d2",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Die Enschs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "81e81b7a-e500-43a0-9df6-75af28994a30",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Der Ensch trägt nie die Schals, die die Ensch ihm strickt."
                            },
                            {
                                "example_id": "e2988791-6762-4868-adbb-e0c8edd661d6",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ensch kommt, geht der Herr Köhl.“"
                            },
                            {
                                "example_id": "f0f3efc6-f8f0-4316-8221-f1e1e7656cc6",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Ensch kommt und geht."
                            },
                            {
                                "example_id": "90c21d1e-32ae-43ae-801f-eb5fd4e478b4",
                                "sense_id": "5d3c2dca-050f-3484-9d79-088b41b328a3",
                                "text": "Enschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
