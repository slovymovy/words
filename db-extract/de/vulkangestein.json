                "senses": [
                    {
                        "sense_id": "097dc74c-0728-344c-8ca4-2adb4446d001",
                        "entry_id": "3c470119-c162-3a0f-8ac6-8a81b08de75d",
                        "glosses": [
                            "Gestein vulkanischen Ursprungs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee14c368-eaee-43e3-a452-8934f3496366",
                                "sense_id": "097dc74c-0728-344c-8ca4-2adb4446d001",
                                "text": "„Wir fuhren los, wieder vorbei an den Felsen aus Vulkangestein und kamen nach Bordj el Haouas, ein Häuflein Häuser entlang einer Hauptstraße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bd8067e-5226-4c7a-843c-85ebde3d816e",
                        "source_entry_id": "3c470119-c162-3a0f-8ac6-8a81b08de75d",
                        "source_sense_id": "097dc74c-0728-344c-8ca4-2adb4446d001",
                        "source_sense_description": "Geologie: Gestein vulkanischen Ursprungs",
                        "target_lang_word": "volcanic rock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5553e25a-8219-4587-8005-806b7cfd9ee6",
                        "source_entry_id": "3c470119-c162-3a0f-8ac6-8a81b08de75d",
                        "source_sense_id": "097dc74c-0728-344c-8ca4-2adb4446d001",
                        "source_sense_description": "Geologie: Gestein vulkanischen Ursprungs",
                        "target_lang_word": "roche volcanique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roche volcanique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92bbf9df-f327-33db-8439-114a967e8ee2",
                                        "entry_id": "95e0c041-6593-3a9d-b32d-def122c997ad",
                                        "glosses": [
                                            "Roche formée par refroidissement rapide du magma à la surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4c41679-2507-4559-bfdd-aac8038511e5",
                                                "sense_id": "92bbf9df-f327-33db-8439-114a967e8ee2",
                                                "text": "A l’exception de quelques roches lacustres ou d’eau douce , les roches volcaniques sont les seules dont la formation continue , pour ainsi dire , sous nos yeux ."
                                            },
                                            {
                                                "example_id": "8fa0f3e3-3b0c-49b4-b43d-d171fee586be",
                                                "sense_id": "92bbf9df-f327-33db-8439-114a967e8ee2",
                                                "text": "Ainsi, la présence de diamant dans des roches volcaniques, toujours accidentelle, est restreinte aux magmas formés au-delà de 150 kilomètres de profondeur et dont la remontée est suffisamment rapide pour préserver les diamants."
                                            },
                                            {
                                                "example_id": "ac6d542c-41ea-4def-842d-f5ee2a20e08b",
                                                "sense_id": "92bbf9df-f327-33db-8439-114a967e8ee2",
                                                "text": "D’après les scientifiques, ce sol qui ressemble à une « croûte cuite » pourrait être un lac asséché recouvert de roche volcanique."
                                            },
                                            {
                                                "example_id": "7491d680-22b5-41c1-a959-ec08ba64b20b",
                                                "sense_id": "92bbf9df-f327-33db-8439-114a967e8ee2",
                                                "text": "Leurs résultats, publiés dans la revue Icarus, montrent que la texture et la morphologie de ces roches du socle martien sont relativement semblables à celles des ignimbrites terrestres, des roches volcaniques typiques produites lors d'éruptions volcaniques explosives particulièrement violentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
