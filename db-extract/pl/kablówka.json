                        ],
                        "examples": [
                            {
                                "example_id": "f129dcb7-33ef-4ed5-b6ed-aba6b1533429",
                                "sense_id": "6858b3a0-5651-3386-9ac5-ad2dfc43e505",
                                "text": "W kablówce mam sześćdziesiąt programów, ale większość w językach, których nie znam."
                            },
                            {
                                "example_id": "72bddb31-a825-4a9b-8096-7077f6a14eb2",
                                "sense_id": "6858b3a0-5651-3386-9ac5-ad2dfc43e505",
                                "text": "Nie mam kablówki, więc do telewizora podłączyłem antenę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "607bdd28-7fc6-4934-89ee-661a1f3ad12d",
