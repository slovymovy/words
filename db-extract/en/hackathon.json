                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hackathon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "82302619-7f53-3239-b737-43e14a851c99",
                                        "entry_id": "eb71c9c7-27c1-313d-9b14-a2dd25213c98",
                                        "glosses": [
                                            "een evenement waar softwareprogrammeurs elkaar ontmoeten om samen te programmeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363adfec-fcc3-448b-a1c4-4dbfcc1ef131",
                                                "sense_id": "82302619-7f53-3239-b737-43e14a851c99",
                                                "text": "In Amsterdam werd er een hackathon gehouden om Wikipedia beter toegankelijk te maken voor het publiek."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38176e64-7f61-4905-b1fb-94ec4696ddb4",
                        "source_entry_id": "ec011a06-f512-3b2a-9c92-904b0d232d1f",
                        "source_sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                        "source_sense_description": "event",
                        "target_lang_word": "hackathon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hackathon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                        "entry_id": "83cc507d-bdc0-33c3-a05c-1cedc57016d9",
                                        "glosses": [
                                            "Événement où des programmeurs se rencontrent pour collaborer au développement de logiciels."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4591c986-3241-42e4-8b3b-d9f788c98733",
                                                "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                                "text": "Les ambassades en diffusent à l’occasion de salons et de festivals, et organisent même des « hackathons » (fabrication d’un projet VR en 48 heures chrono) à Singapour ou à New York…"
                                            },
                                            {
                                                "example_id": "f9b1b7d7-3778-4cb7-a091-b63ad4970447",
                                                "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                                "text": "En mai s’est tenu un hackathon GNOME pour réduire la consommation de ressources d’une session typique de GNOME."
                                            },
                                            {
                                                "example_id": "cd9b8724-d04a-49eb-b239-a05fc73657da",
                                                "sense_id": "040c2ef0-1f6f-3c45-8815-1f490d9f7484",
                                                "text": "Un hackathon, une compétition d’innovation, est également prévu en partenariat avec Île-de-France Mobilités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93da3551-a418-49cb-9241-7cc18a3ecbb1",
                        "source_entry_id": "ec011a06-f512-3b2a-9c92-904b0d232d1f",
                        "source_sense_id": "b3fdb9f3-9ade-3f7c-b6b5-0b48f53d3a8f",
                        "source_sense_description": "event",
                        "target_lang_word": "Hackathon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hackathon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "126cc79c-bfdf-32b8-9094-a9f74c158d39",
                                        "entry_id": "f4bd67bc-547e-33a8-9515-7de10f1c19b9",
                                        "glosses": [
                                            "Veranstaltung, bei der kollaborativ Software oder Hardware entwickelt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb6a43e6-26e3-4d77-993b-34986361349a",
                                                "sense_id": "126cc79c-bfdf-32b8-9094-a9f74c158d39",
                                                "text": "„Beachten Sie unbedingt, dass auch kreative Leistungen dem Urheberrecht unterliegen; klären Sie also vorab am besten mit der Rechtsabteilung Ihres Unternehmens, wie bei einem Hackathon gefundene Ideen und Lösungen weiterverwertet werden können …“"
                                            },
                                            {
                                                "example_id": "879ff50a-144d-4bb9-afa9-edbdad44bb1f",
                                                "sense_id": "126cc79c-bfdf-32b8-9094-a9f74c158d39",
                                                "text": "„Die Eingangstür zierte das Wort ebenso wie verschiedene Sticker und Wände, und Facebook-Mitarbeiter schwärmten von den sogenannten »Hackathons« (Kunstwort aus »Hack« und »Marathon«), die regelmäßig in der Firma veranstaltet werden.“"
                                            },
                                            {
                                                "example_id": "87333c27-3ea4-4b19-bb12-f0dbb8d4d03d",
                                                "sense_id": "126cc79c-bfdf-32b8-9094-a9f74c158d39",
                                                "text": "„Beim Format „Hackathon“ werden innerhalb eines bestimmten Zeitraums zu eingegrenzten Themen an konkreten Produkten und Projekten gearbeitet, die abschließend der Öffentlichkeit präsentiert werden.“"
                                            },
                                            {
                                                "example_id": "eb7f30d7-ccd7-4e70-b0ab-419b15625bae",
                                                "sense_id": "126cc79c-bfdf-32b8-9094-a9f74c158d39",
                                                "text": "„Schlaflos im Willy-Brandt-Haus: In der SPD-Zentrale entwickeln 40 junge Programmierer Ideen für den Wahlkampf, 24 Stunden lang. Auf einem sogenannten Hackathon basteln sie an Computerspielen, Twitter-Software und Apps für politisch Interessierte. Verrückt, findet SPD-Kanzlerkandidat Schulz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
