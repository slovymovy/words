                "senses": [
                    {
                        "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                        "entry_id": "71afa4af-25bc-3550-8b4d-c2e912bd5dfe",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd7a713-deeb-4d4c-b608-e827f3bfba8c",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Frau Kuchlbauer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7b77505b-711d-421f-8fc6-a30cbac1d501",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Herr Kuchlbauer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "012219b0-c6f7-4e9f-920c-04dcb2952c22",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Die Kuchlbauers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6d92be99-032b-4ab8-bcc2-5714a84e88e5",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Der Kuchlbauer trägt nie die Schals, die die Kuchlbauer ihm strickt."
                            },
                            {
                                "example_id": "2edc8a2d-acb9-4df4-8c30-84e9dd6e1096",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kuchlbauer kommt, geht der Herr Kuchlbauer.“"
                            },
                            {
                                "example_id": "04ce7bc6-cc43-4422-9227-8f6fd0500210",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Kuchlbauer kommt und geht."
                            },
                            {
                                "example_id": "28f297dd-465c-48f7-956a-342998bb440e",
                                "sense_id": "6eab66d7-3fb0-3f44-868e-c68a5f1379d6",
                                "text": "Kuchlbauers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
