                                "target_senses": [
                                    {
                                        "sense_id": "6c0a80ec-a5ab-3408-8662-255570a4134d",
                                        "entry_id": "cbc0309c-f87e-3e7d-b83f-78b7a2bc6ef2",
                                        "glosses": [
                                            "Outside the mainstream."
                                        ],
                                        "tags": [],
