                ],
                "translations": [
                    {
                        "translation_id": "925f06d8-679b-44b6-8228-7772f93e3e05",
                        "source_entry_id": "a61fc63d-b2a4-370d-abca-39272b88339d",
                        "source_sense_id": "1e9dfe85-0b52-3432-b27f-f239f47349c5",
                        "target_lang_word": "ratsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                        "entry_id": "213c138a-f540-3cb3-9a39-6d5dac39530b",
                                        "glosses": [
                                            "einem Ratschlag oder der eigenen Einsicht entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11898ea4-a06c-4684-bcdd-d8817caf9646",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Es ist ratsam, sich auf eine Prüfung gut vorzubereiten."
                                            },
                                            {
                                                "example_id": "cbdb7056-98dd-4006-a06c-9c2a8af6e1a7",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Frühes Reservieren ist ratsam, denn beliebte Ziele sind schnell ausgebucht."
                                            },
                                            {
                                                "example_id": "c1d4bfe4-09ec-408e-a480-438cc4c51cc4",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Die meisten Unternehmen haben spezielle Onlineportale für Bewerbungen. Es ist aber ratsam, schon vor der Bewerbung um die erste Stelle über ein Praktikum Kontakte zu knüpfen."
                                            },
                                            {
                                                "example_id": "1c6ac9ee-d905-4113-9d4a-3d8c6efe6211",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "\"Der Punkt, dass du bekannt bist, als \"derjenige, der so ist\", unabhängig vom Beruf, halte ich für keinen ratsamen Weg\", sagte Tommasi."
                                            },
                                            {
                                                "example_id": "184419e5-340a-41e9-962a-a109c52d406d",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "Niedrige Zinsen, die Gefahr steigender Preise und dann noch Weihnachten: Geld auszugeben erscheint vielen Menschen derzeit ratsamer, als es anzulegen."
                                            },
                                            {
                                                "example_id": "b46e53e1-b2bf-41ea-b781-fc820463fd3b",
                                                "sense_id": "6e4929dc-f6d4-3112-b20f-c067f20ad419",
                                                "text": "„Der besiegte Großmogul bot den Briten nun erneut die «Diwani» von Bengalen an, und Clive übernahm sie schließlich im Namen der Ostindiengesellschaft, da Pitt weiterhin eine Übernahme durch die Krone für nicht ratsam hielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22e01231-927e-4291-a7a2-5a737abc878c",
                        "source_entry_id": "a61fc63d-b2a4-370d-abca-39272b88339d",
                        "source_sense_id": "1e9dfe85-0b52-3432-b27f-f239f47349c5",
                        "target_lang_word": "advisable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "advisable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97996862-55bc-3c6a-9b82-b8ec1d16ee1a",
                                        "entry_id": "84b4fc19-0d52-3658-ac45-2d4dd48c6d33",
                                        "glosses": [
                                            "Worthy of being recommended; desirable."
                                        ],
                                        "tags": [
                                            "of a course of action"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2de41f4-9718-48c7-8b51-93ef690fd113",
                                                "sense_id": "97996862-55bc-3c6a-9b82-b8ec1d16ee1a",
                                                "text": "Perhaps it will be advisable for me to state my reasons for marrying."
                                            },
                                            {
                                                "example_id": "9ec7b2cf-9765-4b99-8d60-f13b0dc1b7e7",
                                                "sense_id": "97996862-55bc-3c6a-9b82-b8ec1d16ee1a",
                                                "text": "Owing to the war, it was not thought advisable to carry out repairs to this pier, as this would have involved the temporary narrowing of the channel, and it was not until 1919 that it was decided to proceed with the construction of a steel-pile coffer dam round the south pier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fadd6161-9779-364d-a56f-8d0370d12f2e",
                                        "entry_id": "84b4fc19-0d52-3658-ac45-2d4dd48c6d33",
                                        "glosses": [
                                            "Capable of being advised or willing to be advised."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
