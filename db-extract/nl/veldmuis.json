                        "sense_id": "807e357c-dde0-3cc1-9362-7449101271fe",
                        "entry_id": "423dda0e-f131-31b8-8d3d-eedb93d5db65",
                        "glosses": [
                            "Microtus arvalis in Europa een vrij algemeen voorkomende knaagdiersoort. De wetenschappelijke naam van het geslacht Microtus betekent letterlijk: klein-oor (gelatiniseerd Grieks: mikrōtos = mikr(o)- klein + ōtos, van ous, oor) en de soortnaam arvalis betekent uit het bouwland (Latijn: arvālis). Ze leven graag in gebieden waar grassen en granen te vinden zijn. Hij kan vaak staande op zijn achterpoten worden gezien. De veldmuis is géén \\\"ware muis\\\", zoals de huismuis en de bosmuis, maar behoort tot de woelmuizen, een andere grote onderfamilie uit de orde der knaagdieren"
                        ],
                        "tags": [
                            "knaagdieren"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf4db1e9-9765-4ff4-8862-68b10a089a81",
                        "source_entry_id": "423dda0e-f131-31b8-8d3d-eedb93d5db65",
                        "source_sense_id": "807e357c-dde0-3cc1-9362-7449101271fe",
                        "source_sense_description": "Microtus arvalis, familie van de woelmuis",
                        "target_lang_word": "Feldmaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldmaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                        "entry_id": "2e06fb60-3913-3e00-b26c-6c7a3c5bc1bc",
                                        "glosses": [
                                            "eine kleine graubraune Wühlmaus, die auf Feldern und Wiesen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d61756-351e-4d89-b0c3-cf7a4261c634",
                                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                                "text": "Die Feldmaus kann bis 10 cm groß werden."
                                            },
                                            {
                                                "example_id": "bfba06d3-2709-4d4d-b3ae-ce1c4532b4f8",
                                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                                "text": "Das Feld ist von Feldmäusen durchlöchert."
                                            },
                                            {
                                                "example_id": "7bbf6766-5c52-4078-be69-b7d78c2c5720",
                                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                                "text": "Die Feldmäuse leben in Kolonien mit bis zu 20 Tieren unter der Erde."
                                            },
                                            {
                                                "example_id": "5672585d-52b7-4a33-bc27-6670a799eb85",
                                                "sense_id": "ef8184c8-71a2-35e6-93b6-0e39dc647d73",
                                                "text": "„Hochsommerlicher Heuduft hing schwer über dem Hang, der voller Goldrute stand und von Feldmäusen wimmelte und sich zur Marsch hinuntersenkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
