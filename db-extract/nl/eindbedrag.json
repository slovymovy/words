                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4b01e7-82d0-46c1-b5eb-c20ba9fcb697",
                                "sense_id": "21325454-882a-3278-9448-daf0e90593d8",
                                "text": "De samenwerkende hulporganisaties gaan ervan uit dat het eindbedrag van Giro555 verder oploopt. Er zijn namelijk nog steeds acties bezig en het rekeningnummer blijft voorlopig geopend."
                            },
                            {
                                "example_id": "66d2ac85-0bff-45eb-a3b1-8bd0a92c252c",
                                "sense_id": "21325454-882a-3278-9448-daf0e90593d8",
                                "text": "De schadevergoeding loopt mogelijk op tot 1,5 miljoen euro, of hoger, en is zowel bestemd voor de kopers als voor Van Hemert zelf. Het eindbedrag moet nog worden vastgesteld door een deskundige. Nog niet alle kopers van de schilderijen uit de periode 1991-1995 hebben zich gemeld."
                            }
                        ]
                    }
