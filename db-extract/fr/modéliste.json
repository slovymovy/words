                                        "sense_id": "c3985e6c-b141-3827-8191-2f912ba28b93",
                                        "entry_id": "b1ebd7ba-7475-3097-8866-27e2743e86d1",
                                        "glosses": [
                                            "Alternative spelling of modeler."
                                        ],
                                        "tags": [
