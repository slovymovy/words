    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28f05e22-ec3d-3227-b90a-eaf447e9c68f",
                    "sense_definition": "Qui ne peut plus rien accueillir ou recevoir ; entièrement occupé ou réservé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "occupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le théâtre affiche <w>complet</w> depuis plusieurs jours en raison du succès de la pièce."
                        },
                        {
                            "text": "Nous devons attendre le bus suivant car celui-ci est déjà <w>complet</w>."
                        }
                    ],
                    "synonyms": [
                        "plein"
                    ],
                    "common_phrases": [
                        "afficher complet",
                        "être complet"
                    ]
                },
                {
                    "sense_id": "527d1ffc-4b80-3ee6-bb0a-500af1b66138",
                    "sense_definition": "À quoi il ne manque aucune partie ou aucun élément nécessaire ; entier et achevé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "totalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veuillez vérifier que votre dossier est bien <w>complet</w> avant de nous le renvoyer."
                        },
                        {
                            "text": "Le médecin a exigé un examen <w>complet</w> pour comprendre l'origine de cette douleur."
                        }
                    ],
                    "synonyms": [
                        "entier",
                        "exhaustif",
                        "global",
                        "total"
                    ],
                    "antonyms": [
                        "incomplet"
                    ],
                    "common_phrases": [
                        "dossier complet",
                        "examen complet"
                    ]
                },
                {
                    "sense_id": "ac04fd10-4aa7-3e54-bd63-a413caf394c4",
                    "sense_definition": "Totalement ivre, en état d'ébriété avancée.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ivresse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir bu autant d'alcool en soirée, il est rentré chez lui complètement <w>complet</w>."
                        },
                        {
                            "text": "Regarde cet homme au bar, il ne tient plus debout tellement il est <w>complet</w>."
                        }
                    ],
                    "synonyms": [
                        "plein"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre très familier"
                        }
                    ]
                },
                {
                    "sense_id": "71752c84-2a3b-3091-8cc2-4e2beba1f27f",
                    "sense_definition": "Se dit d'un espace métrique où toute suite de Cauchy converge vers un élément de cet espace.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ensemble des nombres réels muni de la distance usuelle constitue un espace métrique <w>complet</w>."
                        },
                        {
                            "text": "Le professeur a démontré qu'un sous-espace fermé d'un espace <w>complet</w> est également <w>complet</w>."
                        }
                    ],
                    "common_phrases": [
                        "espace complet"
                    ]
                }
            ]
        },
        {
