                        "examples": [
                            {
                                "example_id": "5c67cd3e-60ec-4e70-a7a9-889b3b9c0654",
                                "sense_id": "bdd895e6-0d80-379f-8ce3-fdcc948179e0",
                                "text": "A gross-gutted, bulb-nosed, bourbon-stanky Boston flatfoot in plain clothes wrinkled white sox, with a race track tip-sheet stuffed in his back pocket trying real hard to mingle unnoticed at an elegant Buddies \"do\" to glean inside-dope."
                            },
                            {
                                "example_id": "03485d96-b57d-4faa-b2a8-4f65fcb4b357",
                                "sense_id": "bdd895e6-0d80-379f-8ce3-fdcc948179e0",
                                "text": "As fun as fish are to watch, they require a lot of fish food, and fish food makes fish poop, and pooping fish make for a stanky tank after too long. Just say no to stanky tanks."
                            },
                            {
                                "example_id": "9b9cfafd-9fd2-4b24-9fb2-74f17babd554",
                                "sense_id": "bdd895e6-0d80-379f-8ce3-fdcc948179e0",
                                "text": "“I don't know what happened, but the skunks have had a very horny springtime.” “Well, that horny springtime is turning into a very stanky summer. You need to clean this up.”"
                            }
                        ]
                    }
