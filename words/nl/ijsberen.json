{
    "word_family": [
        "ijsbeer",
        "beer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "918f2a63-11f3-3218-b8c6-7e1310ca0c03",
                    "sense_definition": "rusteloos heen en weer lopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zenuwachtige vader bleef maar in de gang <w>ijsberen</w> terwijl hij op nieuws wachtte.",
                            "target_lang_translations": {
                                "en": "The nervous father kept <w>pacing</w> in the hallway while he waited for news."
                            }
                        },
                        {
                            "text": "Loop niet zo te <w>ijsberen</w>, want daar word ik zelf ook onrustig van.",
                            "target_lang_translations": {
                                "en": "Don't <w>pace</w> like that, because it makes me feel restless too."
                            }
                        }
                    ],
                    "synonyms": [
                        "heen en weer lopen",
                        "drentelen"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "zenuwachtig ijsberen",
                        "te ijsberen"
                    ],
                    "target_lang_definitions": {
                        "en": "To walk back and forth restlessly, often due to nervousness or anxiety."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pace",
                                "target_lang_sense_clarification": "walking back and forth"
                            },
                            {
                                "target_lang_word": "to pace up and down",
                                "target_lang_sense_clarification": "repetitive walking in a small area"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1474516f-855f-3aa1-9670-749b3b00887b",
                    "sense_definition": "meervoud van <w>ijsbeer</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze dierentuin kun je twee grote witte <w>ijsberen</w> in het water zien zwemmen.",
                            "target_lang_translations": {
                                "en": "In this zoo, you can see two large white <w>polar bears</w> swimming in the water."
                            }
                        },
                        {
                            "text": "Door het smelten van het ijs hebben <w>ijsberen</w> steeds meer moeite om voedsel te vinden.",
                            "target_lang_translations": {
                                "en": "Due to the melting of the ice, <w>polar bears</w> are having more and more difficulty finding food."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of polar bear; large white bears inhabiting the Arctic regions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "polar bears",
                                "target_lang_sense_clarification": "Arctic animals"
                            }
                        ]
                    }
                }
            ]
        }
    ]
