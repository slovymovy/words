                    {
                        "translation_id": "ad7bce9a-9a27-4ef7-87d6-e26c6f2acaad",
                        "source_entry_id": "b912e5d5-b7ab-30e9-9797-94dd8df36695",
                        "source_sense_description": "law: denial, disavowal, or renunciation (as of a title, claim, interest, estate, or trust; relinquishment or waiver of an interest or estate)",
                        "target_lang_word": "Gegenerklärung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenerklärung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36bf0f20-2ad1-3f09-869e-06f09586c18e",
                                        "entry_id": "99b3c2bb-4ec5-37cc-8ef2-6d741e323819",
                                        "glosses": [
                                            "offizielle Mitteilung, die eine Reaktion auf eine zuvor abgegebene darstellt"
                                        ],
                                        "tags": [
                                            "Gerichtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "257ddec7-cd3f-4adc-96ee-b4214a740376",
                                                "sense_id": "36bf0f20-2ad1-3f09-869e-06f09586c18e",
                                                "text": "„Darüber hinaus ist klar abzusehen, daß jede Erklärung neue Gegenerklärungen auslösen würde.“"
                                            },
                                            {
                                                "example_id": "9d8607ef-0283-47f5-8984-7446c698fa34",
                                                "sense_id": "36bf0f20-2ad1-3f09-869e-06f09586c18e",
                                                "text": "„Das Ergebnis und die Begründung sollen in der Bundestagsdrucksache veröffentlicht werden, wenn die Frist für Gysis Gegenerklärung verstrichen ist.“"
                                            },
                                            {
                                                "example_id": "8d583be1-2f3b-4b4a-ac0d-0bda2d12ee0d",
                                                "sense_id": "36bf0f20-2ad1-3f09-869e-06f09586c18e",
                                                "text": "„Kiew machte gestern eine Gegenerklärung: wenn die Russische Föderation die Preisformel nicht revidiert, dann steigen für sie die Kosten des Gastransits über das ukrainische Territorium.“"
                                            },
                                            {
                                                "example_id": "04c495a5-a429-4e12-9506-58a131bd8c18",
                                                "sense_id": "36bf0f20-2ad1-3f09-869e-06f09586c18e",
                                                "text": "„Erst in der vergangenen Woche hatte die Staatsanwaltschaft ihre Gegenerklärung fertig gestellt, am Mittwoch erhielt der Vollstreckungsleiter die Akte.“"
                                            },
                                            {
                                                "example_id": "5b257bd2-35c4-4e44-bd0a-52694013c349",
                                                "sense_id": "36bf0f20-2ad1-3f09-869e-06f09586c18e",
                                                "text": "„Außerdem existiert eine Gegenerklärung, die von den meisten islamischen und einigen afrikanischen Ländern unterstützt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ea3bb50-9631-42f4-94b9-b94974623757",
                        "source_entry_id": "b912e5d5-b7ab-30e9-9797-94dd8df36695",
                        "source_sense_description": "law: denial, disavowal, or renunciation (as of a title, claim, interest, estate, or trust; relinquishment or waiver of an interest or estate)",
                        "target_lang_word": "Widerruf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerruf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                        "entry_id": "600e2216-ebac-34b2-994d-2aa7f6ab9e1b",
                                        "glosses": [
                                            "Erklärung/Mitteilung, dass etwas ungültig sein soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef0653b5-8563-467a-b21e-1ee826331469",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "Da ich dem gesendeten Vertrag nicht zustimmen konnte, schrieb ich einen Widerruf."
                                            },
                                            {
                                                "example_id": "a31f6c8f-61b8-498c-b0d7-59070aa4f75f",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "„Der Grund zu diesem Widerruf kann nur der folgende sein.“"
                                            },
                                            {
                                                "example_id": "82b933b2-e98e-4c9f-afed-6b07bb10a871",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "„Die Order sei widerrufen worden, er aber habe noch vor dem Widerruf einen Fluchtversuch unternommen, daher die weitere Haft, die neuen Handschellen.“"
                                            },
                                            {
                                                "example_id": "1a5cc452-3621-4aad-85f0-ab33c29c4fd9",
                                                "sense_id": "7de8ae3c-bed9-3aa5-abe5-e18cafac6247",
                                                "text": "„Nachdem Luther einen Widerruf seiner Lehre abgelehnt hatte, verfiel er der Reichsacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
