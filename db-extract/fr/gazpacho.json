                ],
                "senses": [
                    {
                        "sense_id": "731cd73c-f5af-3c53-86e6-d8e860065e90",
                        "entry_id": "74439bfd-882d-3f96-b07e-ae6c3448ef49",
                        "glosses": [
                            "Variante orthographique de gaspacho (soupe froide aux légumes à base (essentiellement) de jus de tomate)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5efa1d9d-2298-452a-8f59-4df6a106ef39",
                                "sense_id": "731cd73c-f5af-3c53-86e6-d8e860065e90",
                                "text": "Je bus l’eau qu’on me présentait, je mangeai du gazpacho préparé par les mains de mademoiselle Carmencita, et même je fis son portrait sur mon livre de croquis."
                            },
                            {
                                "example_id": "3b9b1292-1cd9-4100-b961-e404b9b0e0cc",
                                "sense_id": "731cd73c-f5af-3c53-86e6-d8e860065e90",
                                "text": "Et en effet, à dater de ce jour, tous les plats – je dis bien tous, pain compris – qui n’étaient pas du gazpacho, du poivron à l’huile ou de la paëlla, furent violemment parfumés à la cannelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fa87756-d425-4005-a79f-450d13218a05",
                        "source_entry_id": "74439bfd-882d-3f96-b07e-ae6c3448ef49",
                        "source_sense_id": "731cd73c-f5af-3c53-86e6-d8e860065e90",
                        "target_lang_word": "Gazpacho",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gazpacho",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24283d36-0b83-361f-a78e-21f661055102",
                                        "entry_id": "60d92a4c-8732-35bc-9001-70875a646304",
                                        "glosses": [
                                            "Gericht aus der spanischen Küche (Andalusien): kalte Suppe aus rohem pürierten und/oder gewürfelten Gemüse (vor allem Tomaten, Gurken, Paprika, Zwiebeln, Knoblauch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7c6345-4d26-4790-a9d8-84884b290659",
                                                "sense_id": "24283d36-0b83-361f-a78e-21f661055102",
                                                "text": "„Der gebratene Thunfisch zur sanften Gazpacho hatte ein wenig zu lange in der Pfanne gelegen, doch das trübte den positiven Gesamteindruck nur wenig.“"
                                            },
                                            {
                                                "example_id": "ebb79b82-a7d7-45a4-8cbd-42e646fc8be5",
                                                "sense_id": "24283d36-0b83-361f-a78e-21f661055102",
                                                "text": "Im Winter wärmt eine heiße französische Zwiebelsuppe, im Sommer erfrischt ein kalter Gazpacho."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0af51ad8-c84a-40d8-928e-bec302f4daf6",
                        "source_entry_id": "74439bfd-882d-3f96-b07e-ae6c3448ef49",
                        "source_sense_id": "731cd73c-f5af-3c53-86e6-d8e860065e90",
                        "target_lang_word": "gazpacho",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gazpacho",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be21f406-1390-3aae-9e9e-5a0eb0a98c0a",
                                        "entry_id": "f4d376a8-1a0b-3737-8277-eb16aba6951e",
                                        "glosses": [
                                            "A cold soup of Spanish origin, made with olive oil, vinegar, bread and raw vegetables such as tomatoes, garlic, onion, cucumber and sweet peppers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb6f831a-3e9f-47c1-9357-845e44932975",
                                                "sense_id": "be21f406-1390-3aae-9e9e-5a0eb0a98c0a",
                                                "text": "First, as to the title: Gazpacho is the name of a dish universal in, and peculiar to, Spain. It is a sort of cold soup, made of bread, pot-herbs, oil, and water. Its materials are easily come by, and its concoction requires no skill."
                                            },
                                            {
                                                "example_id": "da727bc6-f3a1-4175-b91a-8c5cd905199f",
                                                "sense_id": "be21f406-1390-3aae-9e9e-5a0eb0a98c0a",
                                                "text": "[…] I’d rather have my fill of gazpacho than be subject to the misery of a meddling doctor who kills me with hunger, and I’d rather lie in summer under the shade of an oak, and in winter wrap myself in a double sheepskin jacket in freedom, than go to bed between holland sheets and dress in sables under the restraint of a government."
                                            },
                                            {
                                                "example_id": "23026438-1b2a-4014-9166-a8849fdfcd6d",
                                                "sense_id": "be21f406-1390-3aae-9e9e-5a0eb0a98c0a",
                                                "text": "He will eat a plateful of gazpacho or puchero, a sardine, half a roll of bread, and drink clear water as often as wine. Food is always of secondary importance: he ranks it after his novia, after his cigarillo, after the bulls."
                                            },
                                            {
                                                "example_id": "67f67a34-0877-461b-9011-9f3d91e0582d",
                                                "sense_id": "be21f406-1390-3aae-9e9e-5a0eb0a98c0a",
                                                "text": "Seville is the home of gazpacho, a delicious cold soup of cucumber, tomato, and miscellaneous garnishings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
