                                        "sense_id": "26ce847a-45e0-3304-b7a8-06c3ec90b88d",
                                        "entry_id": "5fc3b6fe-7000-3750-baa5-8929dba1bad0",
                                        "glosses": [
                                            "De manera artificial."
                                        ],
