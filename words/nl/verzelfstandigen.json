{
    "word_family": [
        "verzelfstandiging",
        "zelfstandig",
        "zelfstandigheid"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "53c1d9b2-bc26-3833-ab5c-2760e9348414",
                    "sense_definition": "Zelfstandig of onafhankelijk maken, bijvoorbeeld van een overheidsdienst of bedrijfsonderdeel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verzelfstandigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente besloot de lokale bibliotheek te <w>verzelfstandigen</w> om kosten te besparen.",
                            "target_lang_translations": {
                                "en": "The municipality decided to <w>privatize</w> the local library in order to save costs."
                            }
                        },
                        {
                            "text": "Het is niet eenvoudig om een overheidsdienst succesvol te <w>verzelfstandigen</w>.",
                            "target_lang_translations": {
                                "en": "It is not easy to successfully <w>make</w> a government service <w>independent</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "privatiseren",
                        "autonoom maken"
                    ],
                    "antonyms": [
                        "naasten",
                        "inlijven"
                    ],
                    "common_phrases": [
                        "een overheidsdienst verzelfstandigen",
                        "een bedrijfsonderdeel verzelfstandigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make independent or autonomous, for example, a public service or a business unit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "privatize",
                                "target_lang_sense_clarification": "to transfer from public to private ownership or control"
                            },
                            {
                                "target_lang_word": "make independent",
                                "target_lang_sense_clarification": "to grant autonomy to an organization or department"
                            },
                            {
                                "target_lang_word": "spin off",
                                "target_lang_sense_clarification": "to separate a subsidiary or division into an independent entity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54cf7134-2d5c-37b9-8282-ba38cd68b1e2",
                    "sense_definition": "Zelfstandig of onafhankelijk worden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verzelfstandigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van voorbereiding kon de dochteronderneming eindelijk volledig <w>verzelfstandigen</w>.",
                            "target_lang_translations": {
                                "en": "After years of preparation, the subsidiary was finally able to <w>become</w> fully <w>independent</w>."
                            }
                        },
                        {
                            "text": "De school wil graag <w>verzelfstandigen</w> om meer eigen keuzes te kunnen maken.",
                            "target_lang_translations": {
                                "en": "The school would like to <w>become independent</w> in order to be able to make more of its own choices."
                            }
                        }
                    ],
                    "synonyms": [
                        "onafhankelijk worden",
                        "autonoom worden"
                    ],
                    "antonyms": [
                        "fuseren"
                    ],
                    "common_phrases": [
                        "volledig verzelfstandigen",
                        "als organisatie verzelfstandigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To become independent or autonomous."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "become independent",
                                "target_lang_sense_clarification": "to gain autonomy or self-governance"
                            },
                            {
                                "target_lang_word": "spin off",
                                "target_lang_sense_clarification": "to become a separate, independent entity"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}