                "senses": [
                    {
                        "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                        "entry_id": "5a0623c6-7c23-35a9-b31f-8ed919551978",
                        "glosses": [
                            "Lebensabschnitt zwischen der Kindheit und dem Erwachsensein; die Pubertät und Adoleszenz umfassende Altersstufe"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "6a783020-bfc1-40c6-8c23-d129513a7048",
                                "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                "text": "„Das Manual beschreibt ein zehn Sitzungen umfassendes Gruppenprogramm zur universellen Prävention von Depressionen im Jugendalter.“"
                            },
                            {
                                "example_id": "744074dd-7224-4a55-82b2-e5c030ab9ea2",
                                "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                "text": "„Die Prävention bei psychischen Erkrankungen im Kindes- und Jugendalter ist noch lange nicht ausreichend im Bewusstsein der Gesellschaft, obwohl Zahlen und Fakten alarmierend wirken sollten.“"
                            },
                            {
                                "example_id": "94c6ba6a-37b8-458d-a2df-e5bc0f9ba8c7",
                                "sense_id": "3a8a6760-6233-3f29-8a96-447243b93048",
                                "text": "„Stresserleben und Stresssymptome sind im Jugendalter weit verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
