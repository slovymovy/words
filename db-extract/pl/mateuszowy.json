                "senses": [
                    {
                        "sense_id": "b9679c3c-e44f-38fa-9c60-e835a956d7bc",
                        "entry_id": "ab163ebb-5db8-3962-9366-47b3f399d4a2",
                        "glosses": [
                            "należący do Mateusza"
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2aedc69e-ea98-4083-b20b-a537718853a8",
                                "sense_id": "b9679c3c-e44f-38fa-9c60-e835a956d7bc",
                                "text": "Przed Mateuszowym domem rosną rosochate orzechy."
                            },
                            {
                                "example_id": "328c55bf-97aa-4049-97ac-df39a80eba31",
                                "sense_id": "b9679c3c-e44f-38fa-9c60-e835a956d7bc",
                                "text": "Mateuszowa perykopa o chodzeniu po morzu jest zakorzeniona w Starym Testamencie"
                            },
                            {
                                "example_id": "f3321fb2-d6bc-438e-b2a6-ebc2b10c200d",
                                "sense_id": "b9679c3c-e44f-38fa-9c60-e835a956d7bc",
                                "text": "Sąsiadował z Mateuszową zagrodą z jednej strony i z Maciejowym polem z drugiej."
                            },
                            {
                                "example_id": "e9e32f3e-4401-4982-ba1e-f093c4286898",
                                "sense_id": "b9679c3c-e44f-38fa-9c60-e835a956d7bc",
                                "text": "Mateuszowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
