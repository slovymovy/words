                        "aide sociale"
                    ]
                },
                {
                    "sense_id": "83537029-dd7a-34b6-83ad-fe30202bb3d2",
                    "sense_definition": "Qui vit naturellement en groupe ou en communauté organisée, par opposition à solitaire.",
