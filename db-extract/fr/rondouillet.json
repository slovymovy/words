                                    {
                                        "sense_id": "b1ab970a-71e0-322f-9568-6f4ede9fdd2d",
                                        "entry_id": "005277df-40b7-37e4-9fc4-f575b42fbd20",
                                        "glosses": [
                                            "Of a person: slightly overweight, somewhat fat, and hence plump, rounded, and soft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb417a5a-f67e-46ff-adab-84bf8fb51b8b",
                                                "sense_id": "b1ab970a-71e0-322f-9568-6f4ede9fdd2d",
                                                "text": "Obviously the chubby child was eating too much."
                                            },
                                            {
                                                "example_id": "619ad1ed-195a-4a73-95c5-43d14259ab92",
                                                "sense_id": "b1ab970a-71e0-322f-9568-6f4ede9fdd2d",
                                                "text": "Slowly Skye wrapped her arms around the chubby woman's frame and rested her head on Rita's chest drenched with perspiration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee18e106-9f92-3d57-9506-2abf7c21b55f",
                                        "entry_id": "005277df-40b7-37e4-9fc4-f575b42fbd20",
                                        "glosses": [
                                            "Of a body part: containing a moderate amount of fat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1951c2d7-fef7-4002-8c2f-c878c58894a6",
                                                "sense_id": "ee18e106-9f92-3d57-9506-2abf7c21b55f",
                                                "text": "It’s quite normal for babies to have chubby cheeks."
                                            },
                                            {
                                                "example_id": "6ed82d5c-5fa7-4759-b32f-d995e4ae628a",
                                                "sense_id": "ee18e106-9f92-3d57-9506-2abf7c21b55f",
                                                "text": "The servant to whom he put this question was a young fellow with chubby cheeks, small, dull eyes, and a round chin, covered with a colorless down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chubby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4dad8f4-db1c-385c-8d22-e35cfa76bbbd",
                                        "entry_id": "1823baa3-1b72-3bcd-aad1-27be3692ccf7",
                                        "glosses": [
                                            "A chubby, plump person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5cd8a33-9285-4a3f-a2e0-d634498a319f",
                                                "sense_id": "d4dad8f4-db1c-385c-8d22-e35cfa76bbbd",
                                                "text": "Today there is no color or fabric that is out for girl or teen chubbies. Plaids, big, bold block designs, dark or light grounds, heavy textured wools, fleeces and brilliant colors of red, kelly or green, odd or off shades of rust, lavender, and other colors in the fashion cycle are now adapted in designing. Designers themselves have learned that the chubby is more truly eager for a fashionable dress[…]"
                                            },
                                            {
                                                "example_id": "ab679bb9-e460-4175-a8ae-6bf8364a3346",
                                                "sense_id": "d4dad8f4-db1c-385c-8d22-e35cfa76bbbd",
                                                "text": "The chubby is the girl who cannot be fitted in the regular 7 to 14 size range because she is too stout. Sizes for these girls are 7*4 to 141/^, and are specially styled and designed to give them better proportions."
                                            },
                                            {
                                                "example_id": "811322f2-3e21-42d7-b84b-4845c1cac837",
                                                "sense_id": "d4dad8f4-db1c-385c-8d22-e35cfa76bbbd",
                                                "text": "The chubby is especially taken for granted: \"Hey, can you watch my purse while I dance?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f2bf7ff-f42d-3e4d-a2c3-a53e84ef6602",
                                        "entry_id": "1823baa3-1b72-3bcd-aad1-27be3692ccf7",
                                        "glosses": [
                                            "A chubby, plump person.",
                                            "An overweight or obese gay man."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51749418-7709-3dcf-a042-1a005721e3c5",
                                        "entry_id": "1823baa3-1b72-3bcd-aad1-27be3692ccf7",
                                        "glosses": [
                                            "A penile erection, especially when short and with a large circumference; a boner."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aac73cb-64b7-4f16-9f5c-81d72176933c",
                                                "sense_id": "51749418-7709-3dcf-a042-1a005721e3c5",
                                                "text": "Hey, Lucius, I just wanted to share a piece of personal information with you. I've got a... a chubby right now because [starts screaming] This is one of the most awesome experiences of my life!"
                                            }
                                        ]
                                    },
