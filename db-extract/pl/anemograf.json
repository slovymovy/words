                "senses": [
                    {
                        "sense_id": "31ceae41-24e5-3447-b36e-0bd54834b265",
                        "entry_id": "0ed15837-da00-3ede-a254-c1c70c61e3c5",
                        "glosses": [
                            "przyrząd meteorologiczny służący do ciągłego rejestrowania prędkości i kierunku wiatru"
                        ],
                        "tags": [],
