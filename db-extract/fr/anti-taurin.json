                        "sense_id": "ff56089f-381f-33b2-b34c-9d47883d2e18",
                        "entry_id": "cd0bdbb6-497b-32dc-b862-82a7fb9a3242",
                        "glosses": [
                            "Personne se réclamant de la cause anti-taurine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e189178-1d7f-4a0d-bdff-6e3909af8798",
                                "sense_id": "ff56089f-381f-33b2-b34c-9d47883d2e18",
                                "text": "Des coups de corne, des nuits de voiture, des articles dédaigneux de la critique taurine, des injures de la part des anti-taurins, des blessures de corps ou d’amour-propre, tel est souvent leur lot."
                            },
                            {
                                "example_id": "3aa04790-2435-4995-93e1-d021b911e789",
                                "sense_id": "ff56089f-381f-33b2-b34c-9d47883d2e18",
                                "text": "La tauromachie par sa complexité, ce qu’elle inspire, implique ou déclenche comme sentiments va bien au-delà de la simple polémique entre taurin et anti-taurin."
                            }
                        ]
                    }
