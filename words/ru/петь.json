    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78cdf382-05a3-35c1-85c8-a2d4e3815653",
                    "sense_definition": "Использовать голос для исполнения музыкальных звуков или песен",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя сестра очень любит <w>петь</w> весёлые песни.",
                            "target_lang_translations": {
                                "en": "My sister really loves to <w>sing</w> cheerful songs.",
                                "zh": "我妹妹非常喜欢<w>唱歌</w>，唱的都是欢快的歌。"
                            }
                        },
                        {
                            "text": "Мы будем громко <w>петь</w> в хоре на празднике.",
                            "target_lang_translations": {
                                "en": "We will <w>sing</w> loudly in the choir at the celebration.",
                                "zh": "我们会在庆典上大声地<w>唱</w>合唱。"
                            }
                        },
                        {
                            "text": "Она умеет красиво <w>петь</w> под гитару.",
                            "target_lang_translations": {
                                "en": "She knows how to <w>sing</w> beautifully to the guitar.",
                                "zh": "她很会弹着吉他<w>唱歌</w>，声音很美。"
                            }
                        }
                    ],
                    "antonyms": [
                        "молчать"
                    ],
                    "common_phrases": [
                        "петь песню",
                        "петь в хоре",
                        "громко петь",
                        "петь под гитару",
                        "красиво петь"
                    ],
                    "target_lang_definitions": {
                        "en": "To use the voice to perform musical sounds or songs",
                        "zh": "用嗓子发出悦耳的音乐声或演唱歌曲"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sing",
                                "target_lang_sense_clarification": "to produce musical sounds with the voice"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唱",
                                "target_lang_sense_clarification": "发出音乐声"
                            },
                            {
                                "target_lang_word": "唱歌",
                                "target_lang_sense_clarification": "演唱歌曲"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33df1631-dcd1-33f0-b3fd-7f8509199ae6",
                    "sense_definition": "Издавать мелодичные или характерные звуки (о птицах, насекомых или явлениях природы)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_sounds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро за окном звонко <w>поют</w> птицы.",
                            "target_lang_translations": {
                                "en": "Every morning birds <w>sing</w> loudly outside the window.",
                                "zh": "每天清晨，窗外的鸟儿都在清脆地<w>鸣</w>叫。"
                            }
                        },
                        {
                            "text": "В деревне петух <w>поёт</w> очень рано.",
                            "target_lang_translations": {
                                "en": "In the village, the rooster <w>crows</w> very early.",
                                "zh": "在农村，公鸡很早就开始<w>啼</w>叫了。"
                            }
                        },
                        {
                            "text": "Холодный ветер <w>поёт</w> в проводах зимой.",
                            "target_lang_translations": {
                                "en": "The cold wind <w>sings</w> in the wires in winter.",
                                "zh": "冬天的寒风在电线间呼啸，发出像<w>唱歌</w>一样的声音。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "птицы поют",
                        "соловей поёт",
                        "петух поёт",
                        "ветер поёт"
                    ],
                    "target_lang_definitions": {
                        "en": "To produce melodious or characteristic sounds (referring to birds, insects, or nature)",
                        "zh": "指鸟类、昆虫或自然现象发出悦耳或有特征的声音"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sing",
                                "target_lang_sense_clarification": "of birds, wind, or nature: to make musical sounds"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸣",
                                "target_lang_sense_clarification": "指鸟兽虫鸣叫"
                            },
                            {
                                "target_lang_word": "啼",
                                "target_lang_sense_clarification": "特指鸟类鸣叫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0ead792-7c74-326a-b4b2-a13bdad8e795",
                    "sense_definition": "Выдавать секреты, доносить на кого-либо, давать показания (обычно полиции)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Преступник испугался и начал <w>петь</w> на первом же допросе.",
                            "target_lang_translations": {
                                "en": "The criminal got scared and started to <w>sing</w> at the very first interrogation.",
                                "zh": "罪犯害怕了，在第一次审讯时就开始<w>招供</w>了。"
                            }
                        },
                        {
                            "text": "Если он начнёт <w>петь</w>, у нас будут большие проблемы.",
                            "target_lang_translations": {
                                "en": "If he starts to <w>sing</w>, we will have big problems.",
                                "zh": "如果他开始<w>告密</w>，我们会有大麻烦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "начать петь",
                        "петь следователю"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal or police slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To reveal secrets, inform on someone, or give testimony (usually to the police)",
                        "zh": "指供出秘密、告密或向警方提供证词"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sing",
                                "target_lang_sense_clarification": "slang: to confess or inform against others"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "招供",
                                "target_lang_sense_clarification": "供出罪行"
                            },
                            {
                                "target_lang_word": "告密",
                                "target_lang_sense_clarification": "揭发他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95b871f7-e505-3671-a45c-fba169805ed4",
                    "sense_definition": "Прославлять или восхвалять кого-либо в стихах или речах",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поэты любили <w>петь</w> красоту родной природы.",
                            "target_lang_translations": {
                                "en": "Poets loved to <w>sing</w> the beauty of their native nature.",
                                "zh": "诗人们喜欢<w>歌颂</w>家乡大自然的美丽。"
                            }
                        },
                        {
                            "text": "Мы всегда будем <w>петь</w> славу героям войны.",
                            "target_lang_translations": {
                                "en": "We will always <w>sing</w> the glory of the war heroes.",
                                "zh": "我们将永远<w>赞美</w>战争英雄的荣耀。"
                            }
                        }
                    ],
                    "synonyms": [
                        "восхвалять",
                        "воспевать",
                        "воздавать хвалу"
                    ],
                    "common_phrases": [
                        "петь славу",
                        "петь дифирамбы"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "or poetic style"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To glorify or praise someone in poetry or speech",
                        "zh": "在诗歌或演讲中赞美或歌颂某人"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sing",
                                "target_lang_sense_clarification": "poetic: to celebrate or praise in verse"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "歌颂",
                                "target_lang_sense_clarification": "赞美"
                            },
                            {
                                "target_lang_word": "赞美",
                                "target_lang_sense_clarification": "称赞"
                            }
                        ]
                    }
                }
            ]
        },
