    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f63eb8e8-308f-38fc-a891-d5b0d4daff88",
                    "sense_definition": "To poke fun at someone in a playful, affectionate, or sometimes cruel way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older boys used to <w>tease</w> him about his glasses until he started playing football.",
                            "target_lang_translations": {
                                "ru": "Старшие мальчики <w>дразнили</w> его из-за очков, пока он не начал играть в футбол.",
                                "tr": "Büyük çocuklar, o futbol oynamaya başlayana kadar gözlükleri yüzünden onunla <w>alay ederlerdi</w>.",
                                "zh": "大一点的男孩过去常因为他戴眼镜而<w>取笑</w>他，直到他开始踢足球。"
                            }
                        },
                        {
                            "text": "It is common for siblings to <w>tease</w> each other, but they usually mean no harm.",
                            "target_lang_translations": {
                                "ru": "Для братьев и сестер естественно <w>поддразнивать</w> друг друга, но обычно они не хотят ничего плохого.",
                                "tr": "Kardeşlerin birbirine <w>takılması</w> yaygındır ancak genellikle kötü bir niyetleri yoktur.",
                                "zh": "兄弟姐妹之间互相<w>打趣</w>是很常见的，但他们通常没有恶意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mock"
                    ],
                    "antonyms": [
                        "praise",
                        "flatter"
                    ],
                    "common_phrases": [
                        "tease each other",
                        "stop teasing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подшучивать над кем-либо в игривой, ласковой или иногда жестокой манере.",
                        "tr": "Birisiyle şakacı, sevecen veya bazen acımasız bir şekilde alay etmek.",
                        "zh": "以戏谑、亲昵或有时是刻薄的方式取笑某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дразнить",
                                "target_lang_sense_clarification": "намеренно раздражать шутками или насмешками"
                            },
                            {
                                "target_lang_word": "поддразнивать",
                                "target_lang_sense_clarification": "дразнить слегка или по-доброму"
                            },
                            {
                                "target_lang_word": "подшучивать",
                                "target_lang_sense_clarification": "по-доброму смеяться над кем-то"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takılmak",
                                "target_lang_sense_clarification": "birine şakayla karışık laf atmak"
                            },
                            {
                                "target_lang_word": "alay etmek",
                                "target_lang_sense_clarification": "birinin kusurlarıyla veya davranışlarıyla dalga geçmek"
                            },
                            {
                                "target_lang_word": "dalga geçmek",
                                "target_lang_sense_clarification": "birini eğlence konusu yapmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "取笑",
                                "target_lang_sense_clarification": "以言语戏弄他人"
                            },
                            {
                                "target_lang_word": "调侃",
                                "target_lang_sense_clarification": "用言语戏弄、嘲笑"
                            },
                            {
                                "target_lang_word": "打趣",
                                "target_lang_sense_clarification": "用言语开玩笑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ccda8c0-0f16-39a3-ab7d-36ca36129304",
                    "sense_definition": "To provoke, disturb, or annoy someone repeatedly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>tease</w> the dog while he is eating his dinner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>дразните</w> собаку, пока она ест свой ужин.",
                                "tr": "Lütfen köpeği yemeğini yerken <w>rahatsız etmeyin</w>.",
                                "zh": "请不要在狗吃晚饭时<w>逗弄</w>它。"
                            }
                        },
                        {
                            "text": "He suffered them to <w>tease</w> him into acts that were directly opposed to his own wishes.",
                            "target_lang_translations": {
                                "ru": "Он позволял им <w>изводить</w> себя, толкая на поступки, которые прямо противоречили его собственным желаниям.",
                                "tr": "Onların, kendisini kendi isteklerine tamamen zıt eylemlere <w>sürüklemesine</w> izin verdi.",
                                "zh": "他任由他们<w>骚扰</w>，被迫做出违背自己意愿的行为。"
                            }
                        }
                    ],
                    "antonyms": [
                        "soothe",
                        "comfort"
                    ],
                    "common_phrases": [
                        "tease the animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Провоцировать, беспокоить или неоднократно раздражать кого-либо.",
                        "tr": "Birini sürekli olarak kışkırtmak, rahatsız etmek veya sinirlendirmek.",
                        "zh": "反复挑衅、打扰或惹恼某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дразнить",
                                "target_lang_sense_clarification": "провоцировать на ответную реакцию, злить"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "мучить придирками или раздражающим поведением"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "умышленно вызывать раздражение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kışkırtmak",
                                "target_lang_sense_clarification": "birini tepki vermeye zorlamak"
                            },
                            {
                                "target_lang_word": "rahatsız etmek",
                                "target_lang_sense_clarification": "birinin huzurunu bozmak"
                            },
                            {
                                "target_lang_word": "sinirini bozmak",
                                "target_lang_sense_clarification": "birini sürekli rahatsız ederek öfkelendirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逗弄",
                                "target_lang_sense_clarification": "戏弄或挑逗（动物或人）"
                            },
                            {
                                "target_lang_word": "骚扰",
                                "target_lang_sense_clarification": "反复打扰他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2413632d-1930-3660-9560-1f98cab55dfc",
                    "sense_definition": "To deliberately arouse someone sexually without the intention of satisfying that arousal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sexual behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She liked to <w>tease</w> him with suggestive comments but always left before things got serious.",
                            "target_lang_translations": {
                                "ru": "Ей нравилось <w>дразнить</w> его двусмысленными комментариями, но она всегда уходила до того, как всё становилось серьезным.",
                                "tr": "Ona imalı yorumlarla <w>takılmaktan</w> hoşlanırdı ama işler ciddileşmeden her zaman giderdi.",
                                "zh": "她喜欢用暗示性的话语<w>挑逗</w>他，但总是在事情变得严肃之前离开。"
                            }
                        },
                        {
                            "text": "My favorite fantasy involves being tied down and <w>teased</w> for a long time.",
                            "target_lang_translations": {
                                "ru": "Моя любимая фантазия включает в себя то, что меня связывают и долго <w>дразнят</w>.",
                                "tr": "En sevdiğim fantezi, bağlanıp uzun süre <w>tahrik edilmeyi</w> içeriyor.",
                                "zh": "我最喜欢的幻想是被人绑住并长时间地<w>撩拨</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tease and tantalize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно вызывать у кого-либо сексуальное возбуждение без намерения его удовлетворить.",
                        "tr": "Birini, cinsel tatmin sağlama niyeti olmaksızın kasten cinsel olarak uyarmak.",
                        "zh": "故意挑逗某人的性欲却无意满足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дразнить",
                                "target_lang_sense_clarification": "возбуждать желания, не удовлетворяя их"
                            },
                            {
                                "target_lang_word": "соблазнять",
                                "target_lang_sense_clarification": "привлекать, вызывая влечение"
                            },
                            {
                                "target_lang_word": "раззадоривать",
                                "target_lang_sense_clarification": "возбуждать интерес или страсть"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tahrik etmek",
                                "target_lang_sense_clarification": "cinsel arzuyu uyandırmak"
                            },
                            {
                                "target_lang_word": "baştan çıkarmak",
                                "target_lang_sense_clarification": "ilgi çekip arzuyu körüklemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑逗",
                                "target_lang_sense_clarification": "引起性冲动或欲望"
                            },
                            {
                                "target_lang_word": "撩拨",
                                "target_lang_sense_clarification": "挑逗、引诱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ff307a4-c03a-320d-89b0-402ada699b87",
                    "sense_definition": "To release a small amount of information about a future product or event to create interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marketing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The studio decided to <w>tease</w> the new movie with a fifteen-second clip on social media.",
                            "target_lang_translations": {
                                "ru": "Студия решила <w>подогреть интерес</w> к новому фильму пятнадцатисекундным роликом в социальных сетях.",
                                "tr": "Stüdyo, yeni filmi sosyal medyada on beş saniyelik bir kliple <w>tanıtmaya</w> karar verdi.",
                                "zh": "制片厂决定在社交媒体上发布一段十五秒的短片，为新电影进行<w>预热</w>。"
                            }
                        },
                        {
                            "text": "The tech company began to <w>tease</w> a new product launch scheduled for next month.",
                            "target_lang_translations": {
                                "ru": "Технологическая компания начала <w>интриговать</w> анонсами запуска нового продукта, запланированного на следующий месяц.",
                                "tr": "Teknoloji şirketi, gelecek ay yapılması planlanan yeni ürün lansmanı için <w>merak uyandırmaya</w> başladı.",
                                "zh": "这家科技公司开始为下个月计划发布的新产品进行<w>预热</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tease a release",
                        "tease a trailer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрывать небольшое количество информации о будущем продукте или событии для создания интереса.",
                        "tr": "İlgi yaratmak amacıyla gelecekteki bir ürün veya etkinlik hakkında az miktarda bilgi vermek.",
                        "zh": "发布关于未来产品或活动的少量信息以引起兴趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интриговать",
                                "target_lang_sense_clarification": "возбуждать любопытство намеками"
                            },
                            {
                                "target_lang_word": "подогревать интерес",
                                "target_lang_sense_clarification": "создавать ажиотаж перед выходом"
                            },
                            {
                                "target_lang_word": "дразнить",
                                "target_lang_sense_clarification": "давать короткие анонсы для привлечения внимания"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "merak uyandırmak",
                                "target_lang_sense_clarification": "ipuçları vererek ilgiyi artırmak"
                            },
                            {
                                "target_lang_word": "tanıtım yapmak",
                                "target_lang_sense_clarification": "kısa bir ön gösterimle dikkat çekmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "预热",
                                "target_lang_sense_clarification": "为活动或产品发布做前期宣传"
                            },
                            {
                                "target_lang_word": "吊胃口",
                                "target_lang_sense_clarification": "通过透露少量信息来激发好奇心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6509330b-a428-3142-95e7-e73e7beff92c",
                    "sense_definition": "To comb hair toward the scalp to create volume; to backcomb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stylist had to <w>tease</w> her hair extensively to achieve that 1960s beehive look.",
                            "target_lang_translations": {
                                "ru": "Стилисту пришлось сильно <w>начесать</w> ей волосы, чтобы добиться образа «бабетта» в стиле 1960-х.",
                                "tr": "Stilist, 1960'ların o kabarık saç modelini elde etmek için saçına yoğun bir şekilde <w>krepe yapmalıydı</w>.",
                                "zh": "造型师必须大量地为她<w>打毛</w>头发，才能做出那种60年代的蜂窝头造型。"
                            }
                        },
                        {
                            "text": "If you <w>tease</w> your hair too much, you might end up with difficult knots.",
                            "target_lang_translations": {
                                "ru": "Если слишком сильно <w>начесывать</w> волосы, можно получить труднораспутываемые узлы.",
                                "tr": "Saçınızı çok fazla <w>kabartırsanız</w>, çözülmesi zor düğümlerle karşılaşabilirsiniz.",
                                "zh": "如果你把头发<w>打毛</w>得太厉害，可能会弄出很难解开的结。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tease the hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расчесывать волосы по направлению к коже головы для создания объема; делать начес.",
                        "tr": "Hacim kazandırmak için saçı saç derisine doğru taramak; krepe yapmak.",
                        "zh": "向发根方向梳理头发以增加蓬松感；倒梳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начесывать",
                                "target_lang_sense_clarification": "придавать пышность волосам гребнем"
                            },
                            {
                                "target_lang_word": "делать начес",
                                "target_lang_sense_clarification": "создавать объемную прическу"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "krepe yapmak",
                                "target_lang_sense_clarification": "saça hacim vermek için ters taramak"
                            },
                            {
                                "target_lang_word": "kabartmak",
                                "target_lang_sense_clarification": "saçı tarayarak daha dolgun göstermek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打毛",
                                "target_lang_sense_clarification": "通过倒梳使头发蓬松"
                            },
                            {
                                "target_lang_word": "倒梳",
                                "target_lang_sense_clarification": "逆着发丝方向梳理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "448dc31a-6a83-3b26-9464-1d060c208266",
                    "sense_definition": "To separate the fibers of a material, such as wool or flax.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textiles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers would <w>tease</w> the raw wool by hand before it was sent to the spinning wheel.",
                            "target_lang_translations": {
                                "ru": "Рабочие вручную <w>чесали</w> сырую шерсть перед тем, как отправить её на прялку.",
                                "tr": "İşçiler, ham yünü çıkrığa gönderilmeden önce elle <w>didiklerlerdi</w>.",
                                "zh": "工人们在把生羊毛送到纺车前，会先用手将其<w>梳理</w>开。"
                            }
                        },
                        {
                            "text": "It takes a lot of patience to <w>tease</w> apart the tangled fibers of the old rope.",
                            "target_lang_translations": {
                                "ru": "Требуется много терпения, чтобы <w>распутать</w> спутанные волокна старой веревки.",
                                "tr": "Eski halatın birbirine dolanmış liflerini <w>ayırmak</w> çok sabır ister.",
                                "zh": "需要极大的耐心才能把旧绳子缠结的纤维<w>拆解</w>开。"
                            }
                        }
                    ],
                    "common_phrases": [
