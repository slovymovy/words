                "senses": [
                    {
                        "sense_id": "692cb81f-b6e6-31f6-a364-fae028896bcb",
                        "entry_id": "d26afba9-5c51-3aad-b706-0ae1a953407f",
                        "glosses": [
                            "Frau, die sich auf der Straße als Prostituierte anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420e3baf-20e9-416c-9849-b766afeefb5c",
                                "sense_id": "692cb81f-b6e6-31f6-a364-fae028896bcb",
                                "text": "„Straßendirnen lungerten an den Toren herum, und Max musterte sie mit Kennerblick.“"
                            },
                            {
                                "example_id": "b5e9e110-72a0-4d85-881a-50e598edb890",
                                "sense_id": "692cb81f-b6e6-31f6-a364-fae028896bcb",
                                "text": "„Den berufsmäßigen Straßendirnen ging ich nicht ins Netz, weil ich keine einzige sah, die so hübsch war wie Bettina; aber ich konnte mich nicht von dem Verlangen nach jener Art Ruhm freihalten, den man durch todesverachtenden Mut erringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
