                        "glosses": [
                            "Schütze, der so platziert ist, dass er aus dem Heck eines Flugzeugs feuert"
                        ],
                        "tags": [
                            "Luftwaffe"
                        ],
                        "examples": [
                            {
                                "example_id": "e431a8af-0b9b-4f58-abd9-af13b3b5b4f1",
                                "sense_id": "c257a495-cbdc-34cc-9498-7b43a54bdefa",
                                "text": "„Achtern, der Heckschütze, ist ein Spinner, dachte Freddy und mochte ihn trotzdem gern leiden.“"
                            },
                            {
                                "example_id": "63513ee0-b368-4f67-bb44-bdfd3aed0e25",
                                "sense_id": "c257a495-cbdc-34cc-9498-7b43a54bdefa",
                                "text": "„Der verletzte Navigator und der Heckschütze konnten sich als Erste per Fallschirm aus dem Flugzeug retten.“"
                            }
                        ],
