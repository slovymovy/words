                "senses": [
                    {
                        "sense_id": "a517da67-7e84-30ae-8ab8-80bd051e1d52",
                        "entry_id": "143c953f-a569-3609-806a-6e269d7318df",
                        "glosses": [
                            "met meewerkend voorwerp nieuwsgierigheid opwekken bij"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "84bc5369-7c78-46bf-bc08-b96685ab7ce2",
                                "sense_id": "a517da67-7e84-30ae-8ab8-80bd051e1d52",
                                "text": "Het benieuwde hem enorm wat er in Iran aan het gebeuren was."
                            },
                            {
                                "example_id": "e15083bf-180e-4f24-967c-9dfceea3c771",
                                "sense_id": "a517da67-7e84-30ae-8ab8-80bd051e1d52",
                                "text": "Over die zaken wil ik dus wel graag weten wat Europa gaat doen. Wat is de zeggenschap? Kunnen ze daar gewoon even beslissen dat ze wapens die kant op sturen? Wie hoort daarvan? Wie weet daarvan? Die dingen benieuwen mij."
                            }
                        ]
                    }
