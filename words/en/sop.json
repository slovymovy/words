{
    "word_family": [
        "sopping",
        "soppy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc879f78-09b9-3b83-83d9-27a80243c494",
                    "sense_definition": "A set of fixed instructions for performing a routine task.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company updated its <w>SOP</w> to ensure all employees follow the same safety guidelines.",
                            "target_lang_translations": {
                                "cs": "Společnost aktualizovala svůj <w>standardní operační postup</w>, aby zajistila, že všichni zaměstnanci dodržují stejné bezpečnostní pokyny."
                            }
                        },
                        {
                            "text": "Following the standard <w>SOP</w> is essential for maintaining quality control in the laboratory.",
                            "target_lang_translations": {
                                "cs": "Dodržování standardního <w>pracovního postupu</w> je nezbytné pro udržení kontroly kvality v laboratoři."
                            }
                        }
                    ],
                    "synonyms": [
                        "protocol",
                        "procedure",
                        "routine"
                    ],
                    "common_phrases": [
                        "follow the SOP"
                    ],
                    "target_lang_definitions": {
                        "cs": "Soubor závazných pokynů pro provádění rutinních úkolů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "standardní operační postup",
                                "target_lang_sense_clarification": "přesný odborný termín pro SOP"
                            },
                            {
                                "target_lang_word": "pracovní postup",
                                "target_lang_sense_clarification": "obecnější označení pro postup práce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "079bb692-8c1e-33c3-88a8-bd5e335201f5",
                    "sense_definition": "Something given to a person to pacify them or stop them from complaining.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pacification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small bonus was just a <w>sop</w> to keep the angry workers from going on strike.",
                            "target_lang_translations": {
                                "cs": "Malý bonus byl jen <w>úlitbou</w>, aby se zabránilo rozzlobeným pracovníkům ve stávce."
                            }
                        },
                        {
                            "text": "The new policy was merely a <w>sop</w> to critics who demanded immediate change.",
                            "target_lang_translations": {
                                "cs": "Nová politika byla pouze <w>ústupkem</w> kritikům, kteří požadovali okamžitou změnu."
                            }
                        }
                    ],
                    "synonyms": [
                        "bribe",
                        "concession",
                        "pacifier"
                    ],
                    "common_phrases": [
                        "a sop to"
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co je někomu dáno, aby ho uklidnilo nebo aby přestal stěžovat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úlitba",
                                "target_lang_sense_clarification": "přenesený význam: drobný ústupek pro uklidnění"
                            },
                            {
                                "target_lang_word": "ústupek",
                                "target_lang_sense_clarification": "obecné vyhovění protistraně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc8de2b2-e260-365c-bff5-9be769fb68dc",
                    "sense_definition": "A piece of bread or similar food intended to be dipped into liquid food like soup or gravy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dipped a <w>sop</w> of bread into the rich, savory stew.",
                            "target_lang_translations": {
                                "cs": "Namočil si <w>kousek chleba</w> do bohatého, chutného guláše."
                            }
                        },
                        {
                            "text": "The old recipe suggests serving the meat with a <w>sop</w> to soak up the juices.",
                            "target_lang_translations": {
                                "cs": "Starý recept doporučuje podávat maso s <w>kouskem pečiva</w> na vytření šťávy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "The term is rarely used in modern culinary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kousek chleba nebo podobné potraviny určený k namáčení do tekutého jídla, jako je polévka nebo šťáva."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kousek chleba k namáčení",
                                "target_lang_sense_clarification": "popisný překlad, v češtině neexistuje jednoslovný ekvivalent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "679f477c-0d29-3f0e-93ec-0f9616902686",
                    "sense_definition": "To dip or soak food in a liquid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is common to <w>sop</w> up the remaining gravy with a piece of crusty bread.",
                            "target_lang_translations": {
                                "cs": "Je běžné <w>vytřít</w> zbývající omáčku kouskem křupavého chleba."
                            }
                        },
                        {
                            "text": "He used the bread to <w>sop</w> the sauce from the bottom of his plate.",
                            "target_lang_translations": {
                                "cs": "Použil chleba, aby <w>vytřel</w> omáčku ze dna talíře."
                            }
                        }
                    ],
                    "synonyms": [
                        "soak",
                        "dip",
                        "dunk"
                    ],
                    "common_phrases": [
                        "sop up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Namočit nebo nasáknout jídlo v tekutině."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "namočit",
                                "target_lang_sense_clarification": "ponořit do tekutiny"
                            },
                            {
                                "target_lang_word": "vytřít",
                                "target_lang_sense_clarification": "vytřít pečivem zbytek omáčky z talíře"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e5a240ae-3f9b-3f8e-ba09-92f7a05df550",
                    "sense_definition": "Initialism of State of Palestine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "International organizations often refer to the <w>SOP</w> in diplomatic documents.",
                            "target_lang_translations": {
                                "cs": "Mezinárodní organizace se v diplomatických dokumentech často odkazují na <w>Stát Palestina</w>."
                            }
                        },
                        {
                            "text": "The status of the <w>SOP</w> remains a central topic in regional peace negotiations.",
                            "target_lang_translations": {
                                "cs": "Status <w>Státu Palestina</w> zůstává ústředním tématem regionálních mírových jednání."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Iniciálová zkratka pro Stát Palestina."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Stát Palestina",
                                "target_lang_sense_clarification": "geografický a politický název"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}