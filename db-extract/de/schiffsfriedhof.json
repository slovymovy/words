                                    {
                                        "sense_id": "de32c8e9-997b-3e56-9b20-159ace087ca0",
                                        "entry_id": "bbe7c101-878c-3b6f-9dea-a093ed2176f0",
                                        "glosses": [
                                            "Lieu où sont stockés des navires qui ne peuvent plus naviguer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa3ff537-409e-41a4-aff7-06d35fce9ef7",
                                                "sense_id": "de32c8e9-997b-3e56-9b20-159ace087ca0",
                                                "text": "Les deux individus ont été surpris vendredi soir au cimetière de bateaux de Landévennec."
                                            },
                                            {
                                                "example_id": "50f329a8-52fe-428e-878a-278ce86b055e",
                                                "sense_id": "de32c8e9-997b-3e56-9b20-159ace087ca0",
                                                "text": "Chaque année, le groupe de chanteurs est invité à venir terminer la programmation estivale au cimetière de bateaux de Kerhervy."
                                            },
                                            {
                                                "example_id": "87a52e2e-a93f-41fd-94fd-ccfbc02fd124",
                                                "sense_id": "de32c8e9-997b-3e56-9b20-159ace087ca0",
                                                "text": "L’anse de Penforn ne fut pas toujours un cimetière de bateaux. Aux origines, le site était une station navale installée dans les années 1840 afin d’accueillir des escadres en réserve."
                                            }
                                        ]
                                    }
