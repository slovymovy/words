                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d0bc419-2f91-4756-b3ac-a557ca17a304",
                        "source_entry_id": "37df0e4c-f621-361c-94f0-b36868859204",
                        "source_sense_id": "93144092-f939-3a7c-9f02-7f550704fc55",
                        "source_sense_description": "sdü",
                        "target_lang_word": "einschüchtern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einschüchtern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "453edd54-b094-35b9-b849-fe6a8aa6a004",
                                        "entry_id": "52bf1e6b-6f3e-3bde-b7cb-24ca5fe4e599",
                                        "glosses": [
                                            "Furcht bei jemandem auslösen; jemanden unsicher machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9614793-3664-4cda-b540-a82ef91e908d",
                                                "sense_id": "453edd54-b094-35b9-b849-fe6a8aa6a004",
                                                "text": "Kay will durch sein Auftreten und seinen finsteren Gesichtsausdruck seine Klassenkameraden einschüchtern."
                                            },
                                            {
                                                "example_id": "96728bc5-d1e6-4d16-9091-4d7b6110b9a7",
                                                "sense_id": "453edd54-b094-35b9-b849-fe6a8aa6a004",
                                                "text": "Von solchem Benehmen lasse ich mich nicht einschüchtern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34a7bf0d-cd1b-4fdd-a06d-4d5ca22a3671",
                        "source_entry_id": "37df0e4c-f621-361c-94f0-b36868859204",
                        "source_sense_id": "93144092-f939-3a7c-9f02-7f550704fc55",
                        "source_sense_description": "sdü",
                        "target_lang_word": "intimider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intimider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                        "entry_id": "fd0052dc-59f3-387e-af19-367ce1192d2b",
                                        "glosses": [
                                            "Troubler quelqu’un en lui causant de la crainte, de l’appréhension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5cd289-2d21-44b4-8ee7-d068b4e6934d",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Il croyait que les lois étaient faites pour secourir les citoyens autant que pour les intimider."
                                            },
                                            {
                                                "example_id": "af86b790-6394-4e7b-bc80-e117faa84893",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Enfin, à l'image des oiseaux des îles Falkland, décrits par Darwin en 1835, les limules manquent de timidité. En effet, ils ne craignent pas l'homme et ne sont aucunement intimidés par sa présence. Se pencher sur un limule est aussi une expérience un peu troublante... Souvent, l'invertébré se positionne pour mieux percevoir l'étranger. Dès lors, on ne sait plus très bien qui étudie qui."
                                            },
                                            {
                                                "example_id": "5281c074-9e54-448b-992e-08c3bd0d7fde",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Il l’intimida en lui disant un seul mot."
                                            },
                                            {
                                                "example_id": "2a5ea606-8d1f-41f4-b4f8-a53418696364",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Il n’y a qu’à l’intimider pour venir à bout de lui."
                                            },
                                            {
                                                "example_id": "719bbcbc-aacd-451a-8e57-d6129df4988f",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "C’est un esprit qu’on intimide facilement par des menaces."
                                            },
                                            {
                                                "example_id": "3b6fed25-9581-4778-a405-7d2db3d3f058",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "C’est un homme qui ne se laisse point intimider."
                                            },
                                            {
                                                "example_id": "95d9eddb-9947-4e1e-af4d-0f40887d31e7",
                                                "sense_id": "c3a3a0e2-3594-39ce-9940-791bab09d5f3",
                                                "text": "Son aspect m’intimide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89601846-3e08-4d0d-8a7a-a664a09c6263",
                        "source_entry_id": "37df0e4c-f621-361c-94f0-b36868859204",
                        "source_sense_id": "561bed97-afec-3dd7-ab91-661989083476",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "tief beeindrucken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "044d8b18-9f33-4f0c-8f74-78235501a19a",
                        "source_entry_id": "37df0e4c-f621-361c-94f0-b36868859204",
                        "source_sense_id": "561bed97-afec-3dd7-ab91-661989083476",
