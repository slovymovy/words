                                        "entry_id": "ccaa71ab-0ffc-3eef-bbbc-3b15a42f2903",
                                        "glosses": [
                                            "tłumaczenie (najczęściej nazwy własnej lub terminu) na język łaciński, nadawanie wyrazowi postaci językowej łacińskiej"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace801b2-4577-4a58-8f8c-12e787442580",
                                                "sense_id": "cf1bb031-415b-3265-b0b6-24ea79f9151f",
                                                "text": "W dawnej Polsce modna była latynizacja nazwisk, szczególnie wśród literatów."
                                            },
                                            {
                                                "example_id": "0c0d0d49-dac9-4133-83ff-ac25bec920af",
                                                "sense_id": "cf1bb031-415b-3265-b0b6-24ea79f9151f",
