    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73bd7d9f-b6c0-3918-920c-07c10cc713b3",
                    "sense_definition": "A modifier key on a computer keyboard used to switch between character sets, such as typing capital letters or special symbols.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing_key",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hold down the <w>shift</w> key to type a capital letter.",
                            "target_lang_translations": {
                                "ru": "Удерживайте клавишу <w>Shift</w>, чтобы напечатать заглавную букву.",
                                "zh": "按住 <w>Shift</w> 键即可输入大写字母。"
                            }
                        },
                        {
                            "text": "If you press <w>shift</w> and P together, the preview display will change.",
                            "target_lang_translations": {
                                "ru": "Если нажать <w>Shift</w> и P одновременно, окно предварительного просмотра изменится.",
                                "zh": "如果你同时按下 <w>Shift</w> 和 P 键，预览显示就会改变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shift key"
                    ],
                    "common_phrases": [
                        "press shift",
                        "left shift",
                        "right shift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Клавиша-модификатор на клавиатуре компьютера, используемая для переключения на другой набор символов, например, для ввода заглавных букв.",
                        "zh": "电脑键盘上的一个修饰键，用于切换字符集，例如输入大写字母或特殊符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шифт",
                                "target_lang_sense_clarification": "клавиша"
                            },
                            {
                                "target_lang_word": "клавиша Shift",
                                "target_lang_sense_clarification": "компьютерная клавиша"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "Shift键",
                                "target_lang_sense_clarification": "电脑键盘上的按键"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a399386-8628-3f3f-bd1e-8d16077fd6e3",
                    "sense_definition": "A scheduled period of time during which a specific group of workers is on duty.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "work_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will work three <w>shifts</w> a day until the job is finished.",
                            "target_lang_translations": {
                                "ru": "Мы будем работать в три <w>смены</w> в день, пока работа не будет закончена.",
                                "zh": "在工作完成前，我们将每天实行三班<w>倒</w>。"
                            }
                        },
                        {
                            "text": "She usually works the night <w>shift</w> at the hospital.",
                            "target_lang_translations": {
                                "ru": "Она обычно работает в ночную <w>смену</w> в больнице.",
                                "zh": "她通常在医院上夜<w>班</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "workshift"
                    ],
                    "common_phrases": [
                        "night shift",
                        "day shift",
                        "work in shifts",
                        "early shift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленный период времени, в течение которого определенная группа работников находится на дежурстве.",
                        "zh": "一组工人轮班工作的预定时间段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смена",
                                "target_lang_sense_clarification": "рабочее время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "班次",
                                "target_lang_sense_clarification": "工作时间段"
                            },
                            {
                                "target_lang_word": "轮班",
                                "target_lang_sense_clarification": "工作制度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70de5389-c115-3e90-8838-cff5510ed50b",
                    "sense_definition": "A slight change in position, direction, tendency, or atmosphere.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "change_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a noticeable <w>shift</w> in the political atmosphere after the election.",
                            "target_lang_translations": {
                                "ru": "После выборов произошел заметный <w>сдвиг</w> в политической атмосфере.",
                                "zh": "选举后，政治氛围发生了明显的<w>转变</w>。"
                            }
                        },
                        {
                            "text": "The generational <w>shift</w> in the workforce is already under way.",
                            "target_lang_translations": {
                                "ru": "<w>Смена</w> поколений в рабочей силе уже идет полным ходом.",
                                "zh": "劳动力市场的代际<w>更替</w>已经在进行中了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "move",
                        "change",
                        "transition"
                    ],
                    "common_phrases": [
                        "paradigm shift",
                        "shift in focus",
                        "major shift",
                        "policy shift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое изменение в положении, направлении, тенденции или атмосфере.",
                        "zh": "在位置、方向、趋势或氛围上的轻微变化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдвиг",
                                "target_lang_sense_clarification": "изменение"
                            },
                            {
                                "target_lang_word": "перемена",
                                "target_lang_sense_clarification": "изменение"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转变",
                                "target_lang_sense_clarification": "趋势或氛围的变化"
                            },
                            {
                                "target_lang_word": "变动",
                                "target_lang_sense_clarification": "位置或情况的改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a3eb278-908f-399a-8017-156af77049e6",
                    "sense_definition": "The mechanism in a vehicle used to change gears.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Does this car come with a stick <w>shift</w> or is it automatic?",
                            "target_lang_translations": {
                                "ru": "Эта машина с ручным <w>переключением</w> передач или автомат?",
                                "zh": "这辆车是手动<w>挡</w>还是自动挡？"
                            }
                        },
                        {
                            "text": "He grabbed the <w>shift</w> to change into a higher gear.",
                            "target_lang_translations": {
                                "ru": "Он схватился за <w>рычаг переключения</w>, чтобы перейти на более высокую передачу.",
                                "zh": "他握住<w>换挡杆</w>以切换到更高档位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stick shift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механизм в транспортном средстве, используемый для переключения передач.",
                        "zh": "车辆中用于变换档位的机械装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычаг переключения передач",
                                "target_lang_sense_clarification": "механизм"
                            },
                            {
                                "target_lang_word": "переключение передач",
                                "target_lang_sense_clarification": "система/действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "换挡杆",
                                "target_lang_sense_clarification": "机械装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "359bc6c4-a8b3-31e1-a212-5deb10d7250b",
                    "sense_definition": "A simple dress that hangs straight from the shoulders and fits loosely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just last week she bought a new linen <w>shift</w> at the market.",
                            "target_lang_translations": {
                                "ru": "Только на прошлой неделе она купила на рынке новое льняное <w>платье</w>.",
                                "zh": "就在上周，她在市场上买了一条新的亚麻<w>直筒裙</w>。"
                            }
                        },
                        {
                            "text": "She wore a simple white <w>shift</w> to the summer party.",
                            "target_lang_translations": {
                                "ru": "Она надела простое белое <w>платье</w> на летнюю вечеринку.",
                                "zh": "她穿了一条简单的白色<w>直筒裙</w>去参加夏季派对。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shift dress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простое платье прямого покроя, свободно свисающее с плеч.",
                        "zh": "一种从肩部直垂下来、剪裁宽松的简单连衣裙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "платье прямого покроя",
                                "target_lang_sense_clarification": "одежда"
                            },
                            {
                                "target_lang_word": "платье-рубашка",
                                "target_lang_sense_clarification": "одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直筒裙",
                                "target_lang_sense_clarification": "服装款式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b55c74c-ae92-3a23-ad89-934ff8789f1f",
                    "sense_definition": "A type of women's undergarment or slip worn under a dress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a simple cotton <w>shift</w> beneath her heavy gown.",
                            "target_lang_translations": {
                                "ru": "Она носила простую хлопковую <w>сорочку</w> под своим тяжелым платьем.",
                                "zh": "她在厚重的礼服下穿了一件简单的棉质<w>衬裙</w>。"
                            }
                        },
                        {
                            "text": "Some women wear black <w>shifts</w> under their dresses.",
                            "target_lang_translations": {
                                "ru": "Некоторые женщины носят черные <w>сорочки</w> под платьями.",
                                "zh": "有些女性会在裙子下穿黑色的<w>衬裙</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность женского нижнего белья или сорочки, надеваемой под платье.",
                        "zh": "一种穿在连衣裙里面的女性内衣或衬裙。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сорочка",
                                "target_lang_sense_clarification": "нижнее белье"
                            },
                            {
                                "target_lang_word": "комбинация",
                                "target_lang_sense_clarification": "нижнее белье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衬裙",
                                "target_lang_sense_clarification": "内衣"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c730389-927d-3b82-ba49-c0ddb3d56044",
                    "sense_definition": "To move something or someone from one place or position to another.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "move_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will have to <w>shift</w> these heavy boxes to the downtown office.",
                            "target_lang_translations": {
                                "ru": "Нам придется <w>переместить</w> эти тяжелые коробки в офис в центре города.",
                                "zh": "我们得把这些沉重的箱子<w>搬</w>到市中心的办公室去。"
                            }
                        },
                        {
                            "text": "Can you help me <w>shift</w> the table to the other side of the room?",
                            "target_lang_translations": {
                                "ru": "Ты можешь помочь мне <w>передвинуть</w> стол на другую сторону комнаты?",
                                "zh": "你能帮我把桌子<w>挪</w>到房间的另一边吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "move",
                        "relocate",
                        "transfer",
                        "reposition"
                    ],
                    "common_phrases": [
                        "shift the blame",
                        "shift the load"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещать что-либо или кого-либо с одного места или положения на другое.",
                        "zh": "将某物或某人从一个地方或位置移动到另一个地方或位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемещать",
                                "target_lang_sense_clarification": "двигать"
                            },
                            {
                                "target_lang_word": "передвигать",
                                "target_lang_sense_clarification": "сдвигать с места"
                            },
                            {
                                "target_lang_word": "сдвигать",
                                "target_lang_sense_clarification": "менять положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "移动",
                                "target_lang_sense_clarification": "改变位置"
                            },
                            {
                                "target_lang_word": "搬动",
                                "target_lang_sense_clarification": "移动重物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c1bfb46-393e-3788-b756-282b227d09fc",
                    "sense_definition": "To change in form, character, focus, or opinion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "change_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His voice <w>shifted</w> from a loud song to a quiet whisper.",
                            "target_lang_translations": {
                                "ru": "Его голос <w>сменился</w> с громкого пения на тихий шепот.",
                                "zh": "他的声音从大声歌唱<w>转为</w>轻声耳语。"
                            }
                        },
                        {
                            "text": "The conversation suddenly <w>shifted</w> to a more serious topic.",
                            "target_lang_translations": {
                                "ru": "Разговор внезапно <w>переключился</w> на более серьезную тему.",
                                "zh": "谈话内容突然<w>转移</w>到了一个更严肃的话题上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swap",
                        "interchange"
                    ],
                    "common_phrases": [
                        "shift focus",
                        "shift attention",
                        "shift perspective"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменяться по форме, характеру, направленности или мнению.",
                        "zh": "在形式、性格、焦点或观点上的改变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "становиться иным"
                            },
                            {
                                "target_lang_word": "изменяться",
                                "target_lang_sense_clarification": "становиться иным"
                            },
                            {
                                "target_lang_word": "переключаться",
                                "target_lang_sense_clarification": "о внимании/теме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转变",
                                "target_lang_sense_clarification": "性质或焦点的改变"
                            },
                            {
                                "target_lang_word": "转移",
                                "target_lang_sense_clarification": "焦点的改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08c1d601-efaa-3578-844f-d926088052f4",
                    "sense_definition": "To move one's body slightly, often because of discomfort or to change posture.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "move_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>shifted</w> slightly in her seat during the long movie.",
                            "target_lang_translations": {
                                "ru": "Она слегка <w>заерзала</w> на своем месте во время длинного фильма.",
                                "zh": "在漫长的电影放映过程中，她在座位上微微<w>挪动</w>了一下。"
                            }
                        },
                        {
                            "text": "He <w>shifted</w> his weight from one foot to the other while waiting.",
                            "target_lang_translations": {
                                "ru": "Он <w>переминался</w> с ноги на ногу в ожидании.",
                                "zh": "他在等待时，身体重心在双脚间来回<w>移动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reposition",
                        "move"
                    ],
                    "common_phrases": [
                        "shift uncomfortably",
                        "shift weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка менять положение тела, часто из-за неудобства или для смены позы.",
                        "zh": "轻微地改变身体姿势，通常是因为不舒服或为了调整坐姿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шевелиться",
                                "target_lang_sense_clarification": "менять позу"
                            },
                            {
                                "target_lang_word": "ерзать",
                                "target_lang_sense_clarification": "двигаться от неудобства"
                            },
                            {
                                "target_lang_word": "переминаться",
                                "target_lang_sense_clarification": "с ноги на ногу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挪动",
                                "target_lang_sense_clarification": "改变身体位置"
                            },
                            {
                                "target_lang_word": "调整",
                                "target_lang_sense_clarification": "改变姿势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c76430a-fcfc-3661-add3-3464fd8ca499",
                    "sense_definition": "To change the gears of a vehicle to alter its speed or power.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "driving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I crested the hill and <w>shifted</w> into fifth gear.",
                            "target_lang_translations": {
                                "ru": "Я поднялся на холм и <w>переключился</w> на пятую передачу.",
                                "zh": "我翻过山顶，<w>换</w>入了五档。"
                            }
                        },
                        {
                            "text": "You need to <w>shift</w> down when you approach a steep curve.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>переключиться</w> на пониженную передачу, когда приближаешься к крутому повороту.",
                                "zh": "接近陡峭弯道时，你需要<w>降</w>挡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shift gears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переключать передачи транспортного средства для изменения скорости или мощности.",
                        "zh": "改变车辆的档位以调整速度或动力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переключать",
                                "target_lang_sense_clarification": "передачи"
                            },
                            {
                                "target_lang_word": "переключаться",
                                "target_lang_sense_clarification": "менять скорость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "换挡",
                                "target_lang_sense_clarification": "驾驶动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a4001df-1e19-34c9-8a26-0918422c7aee",
                    "sense_definition": "To manage to remove or get rid of something, such as a stain or dirt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How can I <w>shift</w> this stubborn grass stain from my shirt?",
                            "target_lang_translations": {
                                "ru": "Как мне <w>вывести</w> это стойкое пятно от травы с рубашки?",
                                "zh": "我该怎么把衬衫上这块顽固的草渍<w>洗掉</w>？"
                            }
                        },
                        {
