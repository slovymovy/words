                    {
                        "sense_id": "93b0ba10-40bd-37a3-8d4c-57e51990bdd3",
                        "entry_id": "2f02439e-3384-3aba-85be-80ce631e0487",
                        "glosses": [
                            "plantaardige voedingsmiddelen die geproduceerd zijn in tuinbouwbedrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97fc5f12-dd5a-405c-95bd-793e97a886ee",
                                "sense_id": "93b0ba10-40bd-37a3-8d4c-57e51990bdd3",
                                "text": "De Europese Unie komt tuinbouwers tegemoet die de nadelige gevolgen ondervinden van het Russische invoerverbod op hun producten. Europees landbouwcommissaris Dacian Ciolos kondigde maandag aan 125 miljoen euro uit te trekken voor het uit de markt halen of niet oogsten van een groot aantal tuinbouwproducten, zoals tomaten, appels en peren, wortelen, druiven en komkommers."
                            },
                            {
                                "example_id": "d43b2db9-2127-43c9-acb8-90a58515f86d",
                                "sense_id": "93b0ba10-40bd-37a3-8d4c-57e51990bdd3",
                                "text": "De Europese melksector kan ook gaan rekenen op steun. Naast de Europese noodmaatregelen voor bederfelijke tuinbouwproducten komt er ook steun voor boter, bepaalde kaassoorten en magere melkpoeders. Dat maakte de Europese Commissie donderdag bekend."
                            },
                            {
                                "example_id": "28e150f3-fb2d-40be-9f2c-763d3eaf3277",
                                "sense_id": "93b0ba10-40bd-37a3-8d4c-57e51990bdd3",
                                "text": "Uitbreiding van de EU kost het volk miljarden extra belastinggeld, militaire onveiligheid met Rusland, economische schade door invoerbeperkingen land- en tuinbouwproducten etc. door Rusland, werkloosheid."
                            }
                        ]
                    }
