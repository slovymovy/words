                                "sense_id": "7b14b989-5df6-3c28-b47a-f6fad7aa5cee",
                                "text": "De overvallers namen alle waardevolle spullen mee.",
                                "translation": "The raiders took all the valuables.",
                                "english": "The raiders took all the valuables."
                            },
                            {
