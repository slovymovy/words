                "senses": [
                    {
                        "sense_id": "84b02c54-a10d-3bcb-b149-406daf480efe",
                        "entry_id": "e9521bb3-6914-3a90-b8f9-6de261ab72a2",
                        "glosses": [
                            "уменьш.-ласк. к хобот; маленький хобот"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "89d8a67a-e454-3329-b4d1-6078aab086e6",
                        "entry_id": "e9521bb3-6914-3a90-b8f9-6de261ab72a2",
                        "glosses": [
                            "энтомол. вытянутый в трубку рот некоторых членистоногих, служащий для сосания, ощупывания, прокалывания и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93c1ff4-62de-40e9-97c7-22a2b6d4171d",
                                "sense_id": "89d8a67a-e454-3329-b4d1-6078aab086e6",
                                "text": "Маленький бражник с телом шмеля и стеклянистыми, невидимыми от быстроты биения, крыльцами, с воздуха попытал длинным хоботком цветок, кинулся к другому, к третьему."
                            }
                        ]
                    },
                    {
                        "sense_id": "f44ef53d-f825-3157-b095-ec03d38943b2",
                        "entry_id": "e9521bb3-6914-3a90-b8f9-6de261ab72a2",
                        "glosses": [
                            "небольшая по размеру часть механизма, приспособления и т. п., формой или функцией напоминающая вытянутый нос животного"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f1ab7d4-e30c-4af4-9603-a0029208e09b",
                        "source_entry_id": "e9521bb3-6914-3a90-b8f9-6de261ab72a2",
                        "source_sense_description": "вытянутый в трубку рот некоторых членистоногих",
                        "target_lang_word": "proboscis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proboscis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9899459-5a7c-3b5b-abea-eab49e66d34c",
                                        "entry_id": "9c7c41c6-bf3f-3803-a012-4d95a3ba69fc",
                                        "glosses": [
                                            "An elongated tube from the head or connected to the mouth, of an animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf48645c-db9f-42e0-ac25-09183ed57b6a",
                                                "sense_id": "f9899459-5a7c-3b5b-abea-eab49e66d34c",
                                                "text": "Don Caldwell, editor-in-chief of the site Know Your Meme, namechecks Brr Brr Patapim, “a proboscis monkey that is also a tree”, as one who made it to YouTube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627c989d-cdcf-381d-a930-a32fa9144241",
                                        "entry_id": "9c7c41c6-bf3f-3803-a012-4d95a3ba69fc",
                                        "glosses": [
                                            "An elongated tube from the head or connected to the mouth, of an animal.",
                                            "The tubular feeding and sucking organ of certain invertebrates like insects, worms and molluscs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a0a8ebd-9ff5-4369-b8ca-539324f55101",
                                                "sense_id": "627c989d-cdcf-381d-a930-a32fa9144241",
                                                "text": "Unlike the proboscides of Lower brachyceran lineages, which are continuous with the head capsule and tend to dangle (Matsuda 1965), the proboscides of most cyclorrhaphan species are suspended by a membranous region and divided into three functional parts: the basiproboscis (rostrum), medioproboscis (haustellum), and distiproboscis (labellum), each of which is defined by internal muscles but also shares muscles with the other regions (Graham-Smith 1930; Lall and Davies 1971)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff588d94-50d6-3c3e-b6c2-a44906570c3e",
                                        "entry_id": "9c7c41c6-bf3f-3803-a012-4d95a3ba69fc",
                                        "glosses": [
                                            "An elongated tube from the head or connected to the mouth, of an animal.",
                                            "The trunk of an elephant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1ad689c-31f0-32e9-9ccb-74892ae77d7a",
                                        "entry_id": "9c7c41c6-bf3f-3803-a012-4d95a3ba69fc",
                                        "glosses": [
                                            "A large or lengthy human nose."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "informal",
                                            "mildly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "564e12d4-fcbc-45ea-9b89-d4b3bb9910af",
                        "source_entry_id": "e9521bb3-6914-3a90-b8f9-6de261ab72a2",
                        "source_sense_description": "вытянутый в трубку рот некоторых членистоногих",
                        "target_lang_word": "trompa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trompa",
