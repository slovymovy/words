                        ],
                        "examples": [
                            {
                                "example_id": "016320b2-d7de-484d-bf11-44a100661741",
                                "sense_id": "56296d7e-f286-377c-8efd-b1f8af2a0964",
                                "text": "In this scene Lupita, the neophyte, is counselled by more weathered professionals about the rules and regulations of whoring."
                            }
                        ]
