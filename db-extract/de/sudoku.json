                "senses": [
                    {
                        "sense_id": "b3cdd842-5bbf-344d-a509-c0157d8d0565",
                        "entry_id": "b7f9b6b8-eaed-3e94-b516-6b7ace14ab1f",
                        "glosses": [
                            "ein japanisches Zahlenrätsel, Zahlenpuzzle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d125e96-48c6-425a-a17c-97f40077a541",
                                "sense_id": "b3cdd842-5bbf-344d-a509-c0157d8d0565",
                                "text": "Ziel des Sudoku ist, in jeder Zeile und jeder Spalte die Ziffern von Eins bis Neun unterzubringen, ohne dass eine Ziffer mehrmals pro Zeile oder Spalte vorkommt."
                            },
                            {
                                "example_id": "4dd8b599-d0c5-4856-b504-a70ac3cd6b29",
                                "sense_id": "b3cdd842-5bbf-344d-a509-c0157d8d0565",
                                "text": "„Sie löst gerade ein Sudoku, hat aber Probleme mit ihrem Kuli.“"
                            },
                            {
                                "example_id": "9930273c-455e-41b4-ad23-854b275a8125",
                                "sense_id": "b3cdd842-5bbf-344d-a509-c0157d8d0565",
                                "text": "„Dort lag Frau Arnesen und schlief, die Zeitung war auf ihren Schoß gerutscht, aufgeschlagen bei einem halb gelösten Sudoku.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e4cfd86-d605-47f6-b477-1b07b75929f1",
                        "source_entry_id": "b7f9b6b8-eaed-3e94-b516-6b7ace14ab1f",
                        "source_sense_id": "b3cdd842-5bbf-344d-a509-c0157d8d0565",
                        "source_sense_description": "ein japanisches Zahlenrätsel, Zahlenpuzzle",
                        "target_lang_word": "sudoku",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sudoku",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b499ac9b-2d06-3959-8c3f-719abb8debcf",
                                        "entry_id": "e66d3719-fd15-329c-aca7-b4994e16f465",
                                        "glosses": [
                                            "A type of pencil puzzle played on a square grid, requiring each of the columns, each of the rows, and each of the subregions (called \\\"boxes\\\" or \\\"regions\\\") to contain the lowest whole numbers up to the dimension of the puzzle, usually 1 to 9, once each. The subregions are rectangular or square except in variants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1a61ef5-fc17-457e-a7a0-d4f33e73f549",
                                                "sense_id": "b499ac9b-2d06-3959-8c3f-719abb8debcf",
                                                "text": "For Preston is the publishing director at Puzzler Media, which creates magazines filled with puzzles, including one called sudoku that has taken Britain by storm. […] The puzzles are widely available over the Internet because efforts to trademark the name in Britain have not been successful, and you can even download sudokus to mobile phones."
                                            },
                                            {
                                                "example_id": "a6ab29f2-aa0c-482b-baf2-9ec0295e7e7c",
                                                "sense_id": "b499ac9b-2d06-3959-8c3f-719abb8debcf",
                                                "text": "In fact, anything we do just to kill time—even essentially healthy activities like reading, chatting on the phone, or completing a sudoku puzzle—becomes a 'time thief."
                                            },
                                            {
                                                "example_id": "dfdb2cda-75f3-434d-a73b-b6157f50f38d",
                                                "sense_id": "b499ac9b-2d06-3959-8c3f-719abb8debcf",
                                                "text": "The annual championship event comprises two days of Sudoku, followed by three days of other types of pencil-and-paper logic puzzles. Some of the Sudokus were classics: In a 9-by-9 grid, insert a number from 1 to 9 into each cell so that no number repeats in any row, column or bolded 3-by-3 square region."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f51fefc0-b736-4fa2-af95-73ad3787bae9",
                        "source_entry_id": "b7f9b6b8-eaed-3e94-b516-6b7ace14ab1f",
                        "source_sense_id": "b3cdd842-5bbf-344d-a509-c0157d8d0565",
