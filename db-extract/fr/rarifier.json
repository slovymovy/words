                        ],
                        "examples": [
                            {
                                "example_id": "d7c23e2e-084a-46f0-9e81-b255d3db114f",
                                "sense_id": "7553317d-243b-3cca-b7fe-900dc7212f38",
                                "text": "La pratique d’une activité physique d’endurance en condition d’hypoxie (Oxygène de l’air rarifié) permet un certain nombre d’adaptations de l’organisme."
                            },
                            {
                                "example_id": "e5c498ab-fb53-42a4-af46-7c85cef3c894",
                                "sense_id": "7553317d-243b-3cca-b7fe-900dc7212f38",
                                "text": "En France, seule des groupes de la taille de Neubauer peuvent se permettre des danseuses mais pour combien de temps, la clientèle risque de se rarifier, non par manque de moyens mais pour cause d’autophobie et de problèmes sociaux."
                            },
                            {
                                "example_id": "41679d25-ff46-4941-9d05-778b1b445059",
                                "sense_id": "7553317d-243b-3cca-b7fe-900dc7212f38",
                                "text": "À mesure que l'air se rarifie…"
                            }
                        ]
                    }
