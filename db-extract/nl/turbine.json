                ],
                "senses": [
                    {
                        "sense_id": "5ddbc2d0-c429-31f0-9a76-12110953f387",
                        "entry_id": "a7ffb0c6-1a0a-330a-837e-0a25a20aebe6",
                        "glosses": [
                            "schoepenrad toegepast als energieopwekker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3aa3234-afa3-4e8a-87a3-91ec42329c14",
                                "sense_id": "5ddbc2d0-c429-31f0-9a76-12110953f387",
                                "text": "Volgens de beheerder van de waterkrachtcentrale lijkt het water nu \"ordelijk\" door de dam te stromen. De dam is 45 jaar oud en bestaat volgens exploitant Hafslund uit twee turbines en een dam met deuren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dabdb989-b076-4ffd-a55b-ef6ce11fea3e",
                        "source_entry_id": "a7ffb0c6-1a0a-330a-837e-0a25a20aebe6",
                        "source_sense_id": "5ddbc2d0-c429-31f0-9a76-12110953f387",
                        "source_sense_description": "een schoepenrad als energieopwekker",
                        "target_lang_word": "Turbine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Turbine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfe060d9-33d0-3964-870a-d6d015fd4dc4",
                                        "entry_id": "5770ff7f-cd69-3dcd-9a6c-32921dbe4c9c",
                                        "glosses": [
                                            "Strömungskraftmaschine mit der Umsetzung von Strömung (kinetische Energie) in Rotation (Rotationsenergie → mechanischen Energie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3921fc-9ecf-4279-b5c8-8755c76b0dca",
                                                "sense_id": "dfe060d9-33d0-3964-870a-d6d015fd4dc4",
                                                "text": "„Die Francis-Turbine - 1849 konstruierte der angloamerikanische Ingenieur James B. Francis technisch verbesserte Turbine, die einen Wirkungsgrad von rund 90 % erreichte.“"
                                            },
                                            {
                                                "example_id": "3ef932d0-ac83-4b90-8abc-605a1695d04b",
                                                "sense_id": "dfe060d9-33d0-3964-870a-d6d015fd4dc4",
                                                "text": "„Aufgabe der Turbine ist es, Strömungsenergie in mechanische Energie umzuwandeln.“"
                                            },
                                            {
                                                "example_id": "cc527973-fb32-44ee-9a41-42baa8a75b32",
                                                "sense_id": "dfe060d9-33d0-3964-870a-d6d015fd4dc4",
                                                "text": "„Die USA decken drei Viertel ihres Kobaltbedarfs im Kongo und die Hälfte ihrer Importe des Metalls Tatalum, das sie für die Turbinen ihrer strategischen Flugzeugflotten brauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cbdc229-0b62-4b83-9f44-569b902b5321",
                        "source_entry_id": "a7ffb0c6-1a0a-330a-837e-0a25a20aebe6",
                        "source_sense_id": "5ddbc2d0-c429-31f0-9a76-12110953f387",
                        "source_sense_description": "een schoepenrad als energieopwekker",
                        "target_lang_word": "turbine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turbine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce673e1f-96e8-3246-ab62-1c86c3151ccf",
                                        "entry_id": "ace9d598-9414-3042-80aa-9b1c34a58eb5",
                                        "glosses": [
                                            "Any of various rotary machines that use the kinetic energy of a continuous stream of fluid (a liquid or a gas) to turn a shaft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4a6ba03-be5f-4e8a-a54f-70ef6acfaf09",
                                                "sense_id": "ce673e1f-96e8-3246-ab62-1c86c3151ccf",
                                                "text": "Upstream from the house is a watermill, cased in gleaming white weather-boarding, which has been restored to working order. Near by is the water-driven turbine which [Rudyard] Kipling had installed in 1902 to light his mansion with electricity."
                                            },
                                            {
                                                "example_id": "67c7d4a9-26f3-4d4a-b5de-b94913b36392",
                                                "sense_id": "ce673e1f-96e8-3246-ab62-1c86c3151ccf",
                                                "text": "Turbines have been around for a long time—windmills and water wheels are early examples. The name comes from the Latin turbo, meaning vortex, and thus the defining property of a turbine is that a fluid or gas turns the blades of a rotor, which is attached to a shaft that can perform useful work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a8bad78-2be6-4020-84e9-87d154877aba",
                        "source_entry_id": "a7ffb0c6-1a0a-330a-837e-0a25a20aebe6",
                        "source_sense_id": "5ddbc2d0-c429-31f0-9a76-12110953f387",
                        "source_sense_description": "een schoepenrad als energieopwekker",
                        "target_lang_word": "turbine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turbine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb136c29-23e8-3be6-aa45-aedee78dd799",
                                        "entry_id": "78073640-1c04-36a4-bb85-7079d386f84d",
                                        "glosses": [
                                            "Dispositif rotatif mu par un fluide et communiquant son mouvement à une machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea95f722-2456-4d17-a907-86c5e5fab061",
                                                "sense_id": "eb136c29-23e8-3be6-aa45-aedee78dd799",
                                                "text": "La ville exécute aujourd'hui à Chèvres, petit hameau à 4 k. 500 m. de Genève, une nouvelle installation hydraulique. Cet établissement comprendra 15 turbines à 800 chevaux chacune, soit une force totale de 12.000 chevaux."
                                            },
                                            {
                                                "example_id": "8d6cbe63-1279-41cd-8c1a-6330d28eb865",
                                                "sense_id": "eb136c29-23e8-3be6-aa45-aedee78dd799",
                                                "text": "Le tuyautage de la turbine est fêlé au ras de la coque, les mécaniciens font une réparation de fortune ; […]."
                                            },
                                            {
                                                "example_id": "1f125d12-df66-4512-bc4e-5c429269483e",
                                                "sense_id": "eb136c29-23e8-3be6-aa45-aedee78dd799",
                                                "text": "Viennent ensuite les conduites forcées qui mènent l'eau jusqu'aux turbines. Ces impressionnants tuyaux en acier de 1,9 à 2,3 mètres de diamètre peuvent supporter une pression de 28 bars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3492dc-a132-3b8d-b7d1-f1e6ffe1fe5f",
                                        "entry_id": "78073640-1c04-36a4-bb85-7079d386f84d",
                                        "glosses": [
                                            "Cerveau."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5518c5-3a60-4c0e-b5f1-d60151b4749b",
                                                "sense_id": "db3492dc-a132-3b8d-b7d1-f1e6ffe1fe5f",
                                                "text": "Je dois aussi m'enfoncer dans la turbine les conseils de mes deux bavards – conseilleurs nabots –, qui ne sont pas du tout chaudards, du tout, pour me laisser balancer les vrais patronymes."
                                            }
                                        ]
                                    }
                                ]
                            },
