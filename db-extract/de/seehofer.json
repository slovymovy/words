                ],
                "senses": [
                    {
                        "sense_id": "1f7c991b-4255-35c6-9cce-1ec6b90de443",
                        "entry_id": "5cd86fca-5d19-37e3-81f5-318a9289c370",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9804e15a-31ce-42b3-9a05-b9159189049c",
                                "sense_id": "1f7c991b-4255-35c6-9cce-1ec6b90de443",
                                "text": "Beim CSU-Parteitag musste sich die Kanzlerin auf offener Bühne wie ein Schulmädchen von Horst Seehofer belehren lassen."
                            },
                            {
                                "example_id": "2e63a948-8456-4f5a-b612-fcf7086270f7",
                                "sense_id": "1f7c991b-4255-35c6-9cce-1ec6b90de443",
                                "text": "Horst Seehofer fehlte auf der Weihnachtsfeier der CSU-Fraktion."
                            },
                            {
                                "example_id": "4b235ffa-224d-4725-b6f2-357274c917fc",
                                "sense_id": "1f7c991b-4255-35c6-9cce-1ec6b90de443",
                                "text": "In dem Märchenfilm Schneeweißchen und Rosenrot (1955), einer Verfilmung des gleichnamigen Märchens Schneeweißchen und Rosenrot, übernahm Seehofer eine der Hauptrollen als Schneeweißchen."
                            },
                            {
                                "example_id": "75107583-6754-4461-9b1e-ca3eca3e84f6",
                                "sense_id": "1f7c991b-4255-35c6-9cce-1ec6b90de443",
                                "text": "Therese Seehofer wuchs als Tochter eines Bäckers in einer Familie mit acht Kindern auf."
                            },
                            {
                                "example_id": "79d47fe6-63d4-43b0-a401-75c0d9826043",
                                "sense_id": "1f7c991b-4255-35c6-9cce-1ec6b90de443",
                                "text": "Am Beispiel der Alt und der Seehofer lassen sich in exemplarischer Weise die Außenverflechtungen und die Zentralität der Handelsmetropole Augsburg im süddeutschen Raum verdeutlichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
