                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef0c3f2d-033f-3cb6-9f03-b8950669611f",
                        "entry_id": "bceacc1f-36dd-3d3c-b0fb-b164e2bc2dc1",
                        "glosses": [
                            "сделать более медленным, уменьшить скорость чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dca9f42-f928-46d3-852d-10f6ad424506",
                                "sense_id": "ef0c3f2d-033f-3cb6-9f03-b8950669611f",
                                "text": "Даже хождение пешком кажется им чрезмерно быстрым способом передвижения. Чтобы замедлить этот процесс, они завели огромное количество так называемых автомобилей."
                            }
                        ]
                    },
                    {
                        "sense_id": "06a62479-5c24-3be9-b770-fc6c7100e19b",
                        "entry_id": "bceacc1f-36dd-3d3c-b0fb-b164e2bc2dc1",
                        "glosses": [
                            "задержать, приостановить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6887fac4-cb6a-450c-b090-7368f665008e",
                                "sense_id": "06a62479-5c24-3be9-b770-fc6c7100e19b",
                                "text": "Курс процедур на знаменитой швейцарской клеточной косметике способен реально замедлить появление новых морщин и заметно сократить количество тех, которые уже успели появиться."
                            }
                        ]
                    },
                    {
                        "sense_id": "4109f3b5-24c2-37c5-8f75-2815fb421b68",
                        "entry_id": "bceacc1f-36dd-3d3c-b0fb-b164e2bc2dc1",
                        "glosses": [
                            "задержаться, запоздать"
                        ],
                        "tags": [
                            "с чем или с инф. (обычно с отриц.)"
                        ],
                        "examples": [
                            {
                                "example_id": "b957c062-b4ad-4f46-b9c0-5905f08466ae",
                                "sense_id": "4109f3b5-24c2-37c5-8f75-2815fb421b68",
                                "text": "Когда ты веешь ароматом / Тобою бережно взлелеянных цветов: / Под очарованный твой кров / Замедлил я моим возвратом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af2e1b40-a7ab-4454-a16b-9746f2272ac7",
                        "source_entry_id": "bceacc1f-36dd-3d3c-b0fb-b164e2bc2dc1",
                        "target_lang_word": "slow down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slow down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                        "entry_id": "382836f9-b631-3cae-8dda-51757417a994",
                                        "glosses": [
                                            "To decelerate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2032ab-5003-498c-bacb-2aeb49c55abd",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "When approaching a bend in the road, slow down, and speed up after leaving it."
                                            },
                                            {
                                                "example_id": "0e856135-e5c8-485e-aec7-9185ab9e73a2",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "Crossing stations on single lines are laid out so that one line has a straight run through, and is signalled in each direction, avoiding the need to slow down to take the turnout into the loop."
                                            },
                                            {
                                                "example_id": "72d56439-c557-4ecb-82f5-abd1ff83cb0a",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "When the long, hot journey drew to its end and the train slowed down for the last time, there was a stir in Jessamy’s carriage."
                                            },
                                            {
                                                "example_id": "03e6eff9-64df-4181-8d45-dc3af66eaa12",
                                                "sense_id": "026aede4-f831-3b58-a49d-2eda9e46ee3b",
                                                "text": "Then came the war... and everything slowed down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                        "entry_id": "382836f9-b631-3cae-8dda-51757417a994",
                                        "glosses": [
                                            "To reduce the velocity, speed, or tempo of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce48c866-fe71-447b-8ad6-0727d1e6b83b",
                                                "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                                "text": "With a comfortable lead, the football team slowed down the tempo of the game."
                                            },
                                            {
                                                "example_id": "e8c3f4fc-ba1c-49e9-a08a-1f86282263ba",
                                                "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "d196c406-4360-4bd7-9f4c-8ada4ca33f11",
                                                "sense_id": "43bf0935-3eb9-3786-acf9-ed65f03fdc32",
                                                "text": "The elimination of vacuum-braked wagons would be slowed down, and the Western Region's flirtation with diesel-hydraulic locomotives was questioned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83778179-143e-3aa9-a1cd-167cdc0fb288",
                                        "entry_id": "382836f9-b631-3cae-8dda-51757417a994",
                                        "glosses": [
                                            "To become less intense, enthusiastic, etc., usually with a positive connotation, implying that one is stripped of exaggerated or unnecessary eagerness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b4f2653-27a8-4070-ad32-547c847e878c",
                                                "sense_id": "83778179-143e-3aa9-a1cd-167cdc0fb288",
                                                "text": "Whoa, slow down there, bucko. Everyone will get a chance. Be patient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "516de2b5-3530-4a92-a9b5-46090eb773af",
