                            {
                                "example_id": "c63d078d-25da-41f8-b6b7-9830a27ee133",
                                "sense_id": "927215b1-c6f1-3c9d-a191-782e66a488a0",
                                "text": "C’est là qu’a demeuré le célèbre ténor Satar, qui donnait le contre-fa de poitrine… Et ce qu’on le lui payait !"
                            },
                            {
                                "example_id": "6ae456fd-b4f9-4054-b15e-a86ee5e13fac",
                                "sense_id": "927215b1-c6f1-3c9d-a191-782e66a488a0",
                                "text": "La course à l’aigu avait déjà été gagnée au XVIIIᵉ siècle où le soprano tente de rivaliser avec le castrat : Faustine Boroni émet le premier contre ut féminin en 1720, la Gabrielli atteint le contre-fa vers 1750, et l’on mentionne même un contre contre-ut."
                            }
                        ]
