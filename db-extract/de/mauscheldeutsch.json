                "senses": [
                    {
                        "sense_id": "2414cfba-4b85-3988-a8b7-26a1cb1da77a",
                        "entry_id": "76946d83-d27e-3c6e-a53b-9022fe754a70",
                        "glosses": [
                            "ein Deutsch mit jiddischen Anteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9cd06ff-8850-4310-9ee8-109ebccf5436",
                                "sense_id": "2414cfba-4b85-3988-a8b7-26a1cb1da77a",
                                "text": "„Mit dem Mauscheldeutsch waren Reliktformen des Jiddischen oder ein deutscher Sprachgebrauch gemeint, bei dem sich dem geübten Ohr die jüdische Herkunft des Sprechers an kleinsten Sprachdetails verriet.“"
                            },
                            {
                                "example_id": "7a5bbe99-d170-4561-9b16-565efa43bba6",
                                "sense_id": "2414cfba-4b85-3988-a8b7-26a1cb1da77a",
                                "text": "„In seinem Erinnerungsband…beklagte er, daß er ‚keine rechte Muttersprache besaß als Jude in einem zweisprachigen Lande‘, er habe ‚die Leichen dreier Sprachen mit sich herumzutragen‘ gehabt:…drittens geringe Reste aus dem (ebenfalls geringgeschätzten) Hebräisch und Jiddisch (Mauscheldeutsch);…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
