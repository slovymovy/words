                ],
                "senses": [
                    {
                        "sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                        "entry_id": "77e6c975-8b0f-35b5-85aa-ee1ff22689c5",
                        "glosses": [
                            "Tapirus Brisson, ssak lasów tropikalnych, o niewielkiej trąbie wykształconej z nosa i wargi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253662cd-d1f4-4b31-885c-90cd66217a4c",
                                "sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                                "text": "Winne były zwierzęta, i duże i małe, kojot, tapir, szlachar, zaskroniec i gągół"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e108421-0633-4010-9d19-68319f5e31ed",
                        "source_entry_id": "77e6c975-8b0f-35b5-85aa-ee1ff22689c5",
                        "source_sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                        "target_lang_word": "tapir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "220b4160-535c-329c-b129-10566cf22170",
                                        "entry_id": "9e8ceb1c-0eed-3c8e-a70d-4198ca3a860c",
                                        "glosses": [
                                            "Any species of large odd-toed ungulates of the genus Tapirus with a long prehensile upper lip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ffe2aa-5632-4e20-80d8-43ef4f73c7e8",
                                                "sense_id": "220b4160-535c-329c-b129-10566cf22170",
                                                "text": "Once a dark, clumsy tapir stared at us from a gap in the bushes, and then lumbered away through the forest; once, too, the yellow, sinuous form of a great puma whisked amid the brushwood, and its green, baleful eyes glared hatred at us over its tawny shoulder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f04d8e87-938d-45ff-be54-c977cd43a998",
                        "source_entry_id": "77e6c975-8b0f-35b5-85aa-ee1ff22689c5",
                        "source_sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                        "target_lang_word": "bouffant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouffant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c892b81-0c70-3afa-8ae7-d7631bfd5ebf",
                                        "entry_id": "032f718a-0da2-3028-8fae-5bcaa00136e7",
                                        "glosses": [
                                            "Of hair or clothing, full-bodied or puffy; puffed out away from head or body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59efc7cd-db6f-4c2a-9240-36f8b96b5f99",
                                                "sense_id": "6c892b81-0c70-3afa-8ae7-d7631bfd5ebf",
                                                "text": "Her bouffant suit made her seem much heavier than her petite figure actually was."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdeb1f10-85b2-32f9-b273-f006e718f304",
                                        "entry_id": "620b6d73-936e-3464-ab71-43ab6641a6a5",
                                        "glosses": [
                                            "A puffy, round hairstyle, popular in the mid-to-late 16th century, characterized by hair raised high on the head and usually covering the ears or hanging down on the sides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09a320fb-9a90-422f-92e7-c3b1a95f5c24",
                                                "sense_id": "cdeb1f10-85b2-32f9-b273-f006e718f304",
                                                "text": "Mother went a little pale. “Preposterous!” she said. “I don’t know what’s got into you!” She fiddled with her bouffant, almost as if she was nervous."
                                            },
                                            {
                                                "example_id": "f6f988f0-6749-4ac8-ae68-3e5f75e1e227",
                                                "sense_id": "cdeb1f10-85b2-32f9-b273-f006e718f304",
                                                "text": "But by the early 1980s the energy had largely drained from the punk movement, giving way to the synthesizers, eyeliner and bouffants of so-called New Romantic bands like Duran Duran and Adam and the Ants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "142e3e3e-b02e-437d-b140-4d9081008384",
                        "source_entry_id": "77e6c975-8b0f-35b5-85aa-ee1ff22689c5",
                        "source_sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                        "target_lang_word": "tapir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95f2eb5a-45fc-3fb0-a94e-817d0be4e0ed",
                                        "entry_id": "04823919-f999-35e8-b683-cc8f6be565c1",
                                        "glosses": [
                                            "Espèce d’ongulé périssodactyle d’Amérique tropicale ou d’Asie, qui a nez long et qui est nocturne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3708087f-8e90-45a4-aa6c-7f0170ef36b7",
                                                "sense_id": "95f2eb5a-45fc-3fb0-a94e-817d0be4e0ed",
                                                "text": "Nous […] surprenions tous les secrets de la jungle : la goinfrerie du tapir qui, sitôt réveillé, se mettait à avaler des fourmis ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tapir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "023736b2-9758-30a3-9c8b-3c2373526647",
                                        "entry_id": "1d89ecd4-8053-30a7-8ad4-dd9470c50e5b",
                                        "glosses": [
                                            "Client de cours particuliers donnés par un normalien."
                                        ],
                                        "tags": [
                                            "France",
                                            "Argot de l’école normale supérieure"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13478c18-b499-4f52-a35b-a20065d54b95",
                                                "sense_id": "023736b2-9758-30a3-9c8b-3c2373526647",
                                                "text": "— C’est ça. il s’agit d’une leçon qu’il doit me procurer.\n— Un tapir ?\n— Oui. Imaginez-vous que je me suis amené à Paris le 6 octobre au lieu du 30 comme je comptais le faire, soi-disant pour prendre possession d’un tapirat."
                                            },
                                            {
                                                "example_id": "9022f9dd-6b4d-493d-921d-d4504a201e96",
                                                "sense_id": "023736b2-9758-30a3-9c8b-3c2373526647",
                                                "text": "Le tapir type doit être recalé plusieurs fois à son bachot, doit avoir été mis à la porte de divers établissements, et doit posséder une grand-mère qui l’a fait travailler dans son enfance. La jeune tapiresse fréquente des écoles libres où l’on ne va en classe qu’une fois par semaine, […]."
                                            },
                                            {
                                                "example_id": "e519a7a5-2184-4d04-98ce-8e6653fddfd1",
                                                "sense_id": "023736b2-9758-30a3-9c8b-3c2373526647",
                                                "text": "18 mai 43 – Nous nous rencontrons le samedi plus longuement et je sillonne Paris à bicyclette pour l’apercevoir entre deux leçons à ses « tapirs »."
                                            },
                                            {
                                                "example_id": "dfcc28a6-5fac-4887-a491-ba41c42fa86d",
                                                "sense_id": "023736b2-9758-30a3-9c8b-3c2373526647",
                                                "text": "En langage normalien, cet élève normand était un tapir avant la lettre, nom de chose, masculin ; au féminin : tapiresse, et autrefois tapirine : collégien, lycéen, ou étudiant généralement candide (et quelquefois plus âgé que son professeur), qui prend des leçons avec un normalien, et constitue l’objet d’un commerce contribuant à l’équilibre budgétaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tapir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                        "entry_id": "75a7a35e-4349-372a-9a85-dbe4a0dc4b60",
                                        "glosses": [
                                            "(Utilisé uniquement dans se tapir) Se cacher en se tenant dans une posture ramassée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c597923-0907-45df-b0fa-555f62173ab7",
                                                "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                                "text": "Du reste, ces affreuses bourrasques sont bien connues des naturels, (…). Ils en redoutent les effets, et, pour s’y soustraire, ils se réfugient dans leurs cavernes ou se tapissent dans leurs huttes."
                                            },
                                            {
                                                "example_id": "4eace1b9-c530-42cb-b8c0-958f1a263a86",
                                                "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                                "text": "Il obliqua de suite à gauche, montrant le chemin à sa maîtresse, puis, vint se tapir sous un buisson épais."
                                            },
                                            {
                                                "example_id": "e10c8c2b-e72f-4287-a53d-2f0c5e16b542",
                                                "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                                "text": "Hannibal, épouvanté par la sonorité étrange de son propre nom, s’alla tapir sous une bibliothèque dans un espace si petit qu’un rat n’y eût pas tenu."
                                            },
                                            {
                                                "example_id": "06d1e822-61bf-4790-af52-86be1e2cd3e5",
                                                "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                                "text": "Et Anne parfois se levait pour voir si la chaleur était tombée. Mais, les volets à peine entrouverts, la lumière pareille à une gorgée de métal en fusion, soudain jaillie, semblait brûler la natte, et il fallait, de nouveau, tout clore et se tapir."
                                            },
                                            {
                                                "example_id": "27213cf8-e2d3-4ede-a874-c26cc862ecf4",
                                                "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                                "text": "Et les petits rongeurs, les habitants des touffes sèches, il savait leur espèce à leur museau, à leur pelage, quand, épouvantés par le tonnerre qui s’abattait sur eux, ils couraient vers leurs terriers et se tapissaient dans les sillons."
                                            },
                                            {
                                                "example_id": "f2ab0b8c-9e1d-438b-8ddb-8e5bf154ca7c",
                                                "sense_id": "c0fec4eb-d75f-384b-9e96-7328d6ffda72",
                                                "text": "Comme il tournait son regard vers le lac, il en vit sortir deux géants, coiffés d’un turban et vêtus d’un habit rouge, qui tenaient un sabre à la main. À cette vue, le pêcheur fut effrayé et se tapit dans sa cachette sans rien dire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26dc9a63-6ddc-439b-b61d-1ccb91bfc8d0",
                        "source_entry_id": "77e6c975-8b0f-35b5-85aa-ee1ff22689c5",
                        "source_sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                        "target_lang_word": "Tapir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tapir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2df24ab-082e-3db1-9589-a0c57eea11f3",
                                        "entry_id": "0fd512e9-f087-37ae-8ad8-6715ce4c02cb",
                                        "glosses": [
                                            "südamerikanisches oder asiatisches Huftier mit einem dichten Fell und kurzem Rüssel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccedb283-e37c-4d46-887a-751e40868d8d",
                                                "sense_id": "b2df24ab-082e-3db1-9589-a0c57eea11f3",
                                                "text": "Tapire sind äußerlich schweineähnliche Säugetiere."
                                            },
                                            {
                                                "example_id": "316807a0-35d4-44b4-9cfe-3144a6f282e9",
                                                "sense_id": "b2df24ab-082e-3db1-9589-a0c57eea11f3",
                                                "text": "Ein Tapir ist ein nachtaktiver Einzelgänger."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ffc9ca7-e6b1-4c14-aeb3-666a317b4c67",
                        "source_entry_id": "77e6c975-8b0f-35b5-85aa-ee1ff22689c5",
                        "source_sense_id": "1738c4b4-3a7a-3531-b74a-7dc3911043cb",
                        "target_lang_word": "тапир",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тапир",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "628e412d-9ad2-324d-ab25-c0ca90a23291",
                                        "entry_id": "9678942a-d280-3c9c-be68-951791eadb57",
                                        "glosses": [
                                            "зоол. крупное травоядное непарнокопытное с небольшим хоботом, обитающее в тропических лесах Америки и Юго-Восточной Азии (Tapirus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9caf4ee3-4e46-4f38-b307-7b5dd276e972",
                                                "sense_id": "628e412d-9ad2-324d-ab25-c0ca90a23291",
                                                "text": ".. тапир живёт далеко за пределами цивилизованных стран. Родиной его считается тропическая полоса Южной Америки, и он никогда не удаляется от рек и болотистых местностей, ибо проводит свою жизнь частью на суше, частью в воде, где отлично плавает и ныряет. // Целый день тапир спит или лежит где-нибудь в укромном и тенистом уголке тропического леса. С наступлением ночи покидает он своё убежище и направляется к реке .. До самого рассвета он находится в воде и ищет себе пищу, которая главным образом состоит из водяных растений."
                                            },
                                            {
                                                "example_id": "e32464e4-0ec0-4ffd-90f2-a59168734575",
                                                "sense_id": "628e412d-9ad2-324d-ab25-c0ca90a23291",
                                                "text": "На передних ногах у тапира по четыре пальца, а на задних только по три .."
                                            },
                                            {
                                                "example_id": "5a161966-bf60-4968-bee6-4aa3bff1f971",
                                                "sense_id": "628e412d-9ad2-324d-ab25-c0ca90a23291",
                                                "text": "Слепая кишка также очень развита у многих других травоядных, например у тапира, слона и множества грызунов."
                                            },
                                            {
                                                "example_id": "bed1d6b2-b91b-440b-b3fb-cc652f181d7b",
                                                "sense_id": "628e412d-9ad2-324d-ab25-c0ca90a23291",
                                                "text": ".. стояло стадо каких-то зверей, неуклюжих, с крупной продолговатой головой, которая была украшена торчащими ушами, маленькими глазками и удлинённой верхней губой. Они были похожи на громадных свиней или на небольших слонов. Звери эти ― тапиры, которые сохранились теперь только в Южной Америке."
                                            },
                                            {
                                                "example_id": "88860306-0d8f-4386-b962-f87171105e25",
                                                "sense_id": "628e412d-9ad2-324d-ab25-c0ca90a23291",
                                                "text": "Лошади, носороги и тапиры ― непарнокопытные животные."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
