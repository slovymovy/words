{
    "word_family": [
        "indoctrination",
        "indoctrinator",
        "indoctrine"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8788f54-7d82-3a48-806d-d769b1e829ae",
                    "sense_definition": "To teach someone to accept a set of beliefs uncritically and without question.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ideological_instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regime used schools to <w>indoctrinate</w> young citizens with nationalist propaganda."
                        },
                        {
                            "text": "Cult leaders often isolate members to <w>indoctrinate</w> them more effectively."
                        }
                    ],
                    "synonyms": [
                        "brainwash"
                    ],
                    "common_phrases": [
                        "indoctrinate children",
                        "attempt to indoctrinate"
                    ]
                },
                {
                    "sense_id": "959e97b3-6f3b-30b9-a4ec-a8181140df15",
                    "sense_definition": "To instill a specific doctrine, ideology, or set of biased beliefs into someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ideological_instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sought to <w>indoctrinate</w> strict religious beliefs into the minds of the students."
                        },
                        {
                            "text": "Propaganda broadcasts were designed to <w>indoctrinate</w> state loyalty into the population."
                        }
                    ],
                    "synonyms": [
                        "instill",
                        "inculcate"
                    ],
                    "common_phrases": [
                        "indoctrinate values",
                        "indoctrinate beliefs"
                    ]
                },
                {
                    "sense_id": "3df11d7a-2ee7-3b4d-9e66-db4281b78fea",
                    "sense_definition": "To instruct or educate; to impart knowledge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "teaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old scholar took great care to <w>indoctrinate</w> his apprentices in classical philosophy."
                        },
                        {
                            "text": "In earlier centuries, mentors sought merely to <w>indoctrinate</w> students in traditional grammar."
                        }
                    ],
                    "synonyms": [
                        "instruct",
                        "teach"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the neutral sense of simply teaching or instructing."
                        }
                    ]
                }
            ]
        }
    ]
}