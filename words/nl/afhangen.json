            "senses": [
                {
                    "sense_id": "da349467-4fee-38de-b909-f90fb44c480c",
                    "sense_definition": "bepaald worden door iets of iemand anders",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "afhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>hangt</w> van het weer <w>af</w> of we morgen gaan wandelen.",
                            "target_lang_translations": {
                                "en": "It <w>depends</w> on the weather whether we will go for a walk tomorrow.",
                                "it": "<w>Dipende</w> dal tempo se domani faremo una passeggiata."
                            }
                        },
                        {
                            "text": "Dat <w>hangt</w> ervan <w>af</w>.",
                            "target_lang_translations": {
                                "en": "That <w>depends</w>.",
                                "it": "Questo <w>dipende</w>."
                            }
                        },
                        {
                            "text": "Je moet niet alles van je ouders laten <w>afhangen</w>.",
                            "target_lang_translations": {
                                "en": "You shouldn't let everything <w>depend</w> on your parents.",
                                "it": "Non devi far <w>dipendere</w> tutto dai tuoi genitori."
                            }
                        }
                    ],
                    "synonyms": [
                        "afhangen van"
                    ],
                    "common_phrases": [
                        "ervan afhangen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be determined or influenced by something or someone else",
                        "it": "essere determinato o influenzato da qualcos'altro o da qualcun altro"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depend",
                                "target_lang_sense_clarification": "to be contingent on something"
                            },
                            {
                                "target_lang_word": "rely",
                                "target_lang_sense_clarification": "to be dependent on someone for support"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "dipendere",
                                "target_lang_sense_clarification": "essere condizionato da qualcosa o qualcuno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da2eda86-0850-3e2e-b6df-b3c9622d9ad7",
                    "sense_definition": "een deur of raam aan de scharnieren bevestigen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman <w>hangt</w> het raam <w>af</w> aan de kozijnstijl.",
                            "target_lang_translations": {
                                "en": "The carpenter is <w>hanging</w> the window on the frame.",
                                "it": "Il falegname <w>monta</w> la finestra sul telaio."
                            }
                        },
                        {
                            "text": "Na het schilderen moet je de deuren weer voorzichtig <w>afhangen</w>.",
                            "target_lang_translations": {
                                "en": "After painting, you must carefully <w>hang</w> the doors again.",
                                "it": "Dopo aver dipinto, devi <w>rimontare</w> le porte con attenzione."
                            }
                        }
                    ],
                    "synonyms": [
                        "ophangen",
                        "monteren"
                    ],
                    "antonyms": [
                        "uithangen"
                    ],
                    "common_phrases": [
                        "deuren afhangen",
                        "ramen afhangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische vaktaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to mount or install a door or window on its hinges",
                        "it": "fissare o montare una porta o una finestra sui cardini"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hang",
                                "target_lang_sense_clarification": "to install a door or window"
                            },
                            {
                                "target_lang_word": "mount",
                                "target_lang_sense_clarification": "to fix something in its correct position"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "montare",
                                "target_lang_sense_clarification": "installare una porta o finestra sui cardini"
                            },
                            {
                                "target_lang_word": "appendere",
                                "target_lang_sense_clarification": "collocare una porta o finestra nella sua sede"
                            }
                        ]
                    }
                }
            ]
        }
