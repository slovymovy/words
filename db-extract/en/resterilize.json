                        ],
                        "examples": [
                            {
                                "example_id": "97ebad21-3a96-4aec-9528-142c7f309174",
                                "sense_id": "ff7307a9-d38d-39ee-8109-77bfd3a3621e",
                                "text": "This afternoon Bets does surgery on my leg—a small infection I've let get worse. It looks bad, clearly infected around the area. She pulls off the scab and some of the surrounding skin with our often resterilized needle."
                            },
                            {
                                "example_id": "d56251e4-2a4c-4d80-8107-f9baf0c23dcb",
                                "sense_id": "ff7307a9-d38d-39ee-8109-77bfd3a3621e",
                                "text": "If in doubt, know that most “spoilers” — molds, yeasts, enzymes and bacteria — cannot survive more than a few minutes’ cooking, so the contents of a questionable jar can always be dumped into a pot and resterilized by boiling for 10 minutes."
                            }
                        ]
                    }
