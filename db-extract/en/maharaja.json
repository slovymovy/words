                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a737c910-49c1-419f-af18-a0a08359ea03",
                                                "sense_id": "4557e544-a663-3eb9-a4ed-08c9bb179499",
                                                "text": "… il se disait : « Comment se peut-il qu'un batelier comme moi soit devenu un Maharadja ? » Puis, peu à peu, insensiblement, il prit habitude de ces honneurs qu'on lui rendait."
                                            },
                                            {
                                                "example_id": "7902c2d7-3aeb-48ae-9574-d709fb7ae505",
                                                "sense_id": "4557e544-a663-3eb9-a4ed-08c9bb179499",
                                                "text": "un prince hindou, un maharadja en grand costume."
                                            },
                                            {
                                                "example_id": "a50c9661-df03-47a8-bfff-6223f237ffaf",
                                                "sense_id": "4557e544-a663-3eb9-a4ed-08c9bb179499",
                                                "text": "Vicente ouvre la marche, pieds nus, comme un prince maharadja."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b798b61-01b4-4643-9fb4-0a10b10c28e5",
