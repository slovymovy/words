                        "sense_id": "54cfb2d0-7e64-3c2c-813f-8608f00d25cc",
                        "entry_id": "3a0a9ec3-ac19-3ac9-a5ca-1304efb8014f",
                        "glosses": [
                            "Marked by courage, determination or boldness in the face of difficulties or danger; having guts."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e5a0f4e-1cb9-3875-98eb-927fabb1448f",
                        "entry_id": "3a0a9ec3-ac19-3ac9-a5ca-1304efb8014f",
                        "glosses": [
                            "From the gut; deep and often coarse."
                        ],
                        "tags": [
                            "of the voice"
                        ],
                        "examples": [
                            {
                                "example_id": "b0004647-a7df-433e-9568-8c051e460bd5",
                                "sense_id": "5e5a0f4e-1cb9-3875-98eb-927fabb1448f",
                                "text": "Album release show for Cline's \"S*&%ferbrains! Vol One Chapter 9.\" The singer and guitarist has a gutsy voice, both rustic and soulful lending itself well to country, punk, bluegrass, soul and rock."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e45ee36-f9c3-4d1f-b35e-65c2f423e844",
