                                        "sense_id": "cdc7f67a-1eb5-3f93-ac38-fba19eddba6a",
                                        "entry_id": "e353d7f6-bc9f-3a7a-9943-a6f11cc7b056",
                                        "glosses": [
                                            "Eigenschaft/Tatsache, dass etwas Ganzes aus einer Auswahl an einzelnen (standardisierten) Bauteilen/Elementen/Programmen (Modulen) zusammengesetzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "946218ae-3e64-431f-83a6-268e7ff73a85",
                                                "sense_id": "cdc7f67a-1eb5-3f93-ac38-fba19eddba6a",
                                                "text": "„Ein praktisches Beispiel für die Anwendung dieser Art der Modularität liefern Regalhersteller.“"
                                            },
                                            {
                                                "example_id": "bd775440-9905-4450-a79b-fbebc813cf8b",
                                                "sense_id": "cdc7f67a-1eb5-3f93-ac38-fba19eddba6a",
                                                "text": "„Das Konzept der Modularität gibt es sowohl in den IT-Branchen als auch in anderen schon lange. Das Wesen des Konzepts gibt die Wendung »Erstellung aus austauschbaren Teilen« wieder.“"
                                            },
                                            {
                                                "example_id": "db8dbec0-206e-4595-a362-db6dfa7e9909",
                                                "sense_id": "cdc7f67a-1eb5-3f93-ac38-fba19eddba6a",
                                                "text": "„Zur Bewältigung großer komplexer Strukturen setzt die Informatik auf Modularität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
