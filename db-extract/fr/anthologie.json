                    },
                    {
                        "translation_id": "b182fbde-2eab-4460-9e69-152d2222bcca",
                        "source_entry_id": "1e8a6703-ea7e-37d8-9521-cbb83073b779",
                        "source_sense_id": "173f86af-28d3-330c-97cd-1190a105606c",
                        "source_sense_description": "Zusammenstellung verschiedener Texte oder Textauszüge; Anthologie, Blütenlese",
                        "target_lang_word": "Blütenlese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blütenlese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c0cfc27-b295-328e-ad20-c155cd1ad7ad",
                                        "entry_id": "33cf5667-fecd-30d5-a3c9-e35c117a305a",
                                        "glosses": [
                                            "Zusammenstellung von Bibelstellen, Redewendungen, Motetten oder Zitaten bekannter Autoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44af1473-f4cc-4686-a219-6f5ef583c1de",
                                                "sense_id": "2c0cfc27-b295-328e-ad20-c155cd1ad7ad",
                                                "text": "Die Blütenlese wurde in Schulen gerne für didaktische Zwecke eingesetzt."
                                            },
                                            {
                                                "example_id": "a506f762-d382-45b8-95de-d22f27891fa0",
                                                "sense_id": "2c0cfc27-b295-328e-ad20-c155cd1ad7ad",
                                                "text": "„Von Zeit zu Zeit bringen die Blätter verschiedene Blütenlesen seines Denkens, und außerdem schreibt er dann und wann auch noch ein Buch, in dem er seine Ansichten über dies Leben und über das zukünftige niederlegt.“"
                                            },
                                            {
                                                "example_id": "df53a7b4-1950-4763-b1bf-0180650413b3",
                                                "sense_id": "2c0cfc27-b295-328e-ad20-c155cd1ad7ad",
                                                "text": "„Darum kann die folgende Blütenlese auch nur unvollständig ausfallen, und ebensowenig wird es möglich sein, wie sonst bei diesen Musterstücken praktiziert, alle Autoren in längeren Ausführungen zu Wort kommen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
