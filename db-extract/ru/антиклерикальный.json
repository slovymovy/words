                "senses": [
                    {
                        "sense_id": "2f34f2a7-a80f-3bdc-bde1-9f7a939cc76b",
                        "entry_id": "641b90a8-00b9-310f-9f79-492898fc2f8b",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным антиклерикализм"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f05dc3f8-a3d5-3307-981a-2f6aa7cfe992",
                        "entry_id": "641b90a8-00b9-310f-9f79-492898fc2f8b",
                        "glosses": [
                            "направленный против влияния церкви или церковной касты в политике"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f287dee-9845-4c5c-ac57-99a639576810",
                        "source_entry_id": "641b90a8-00b9-310f-9f79-492898fc2f8b",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным «антиклерикализм»",
                        "target_lang_word": "antiklerikal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiklerikal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d389081d-d559-305d-966c-e79865275fbe",
                                        "entry_id": "e29ad2a5-d2f3-3e44-8306-e5f8fd4682af",
                                        "glosses": [
                                            "gegen die Kirche; der Kirche gegenüber ablehnend eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b354910-29a9-469b-89c3-1c64e878c77b",
                                                "sense_id": "d389081d-d559-305d-966c-e79865275fbe",
                                                "text": "„Radikal antiklerikal, provozierte er allerdings einen unsinnigen Kampf mit Anhängern der katholischen Kirche (\"cristeros\"), der Tausenden von Menschen das Leben kostete und ihn innenpolitisch schwächte.“"
                                            },
                                            {
                                                "example_id": "5d43fa55-25d0-4a62-989a-a0d61a632348",
                                                "sense_id": "d389081d-d559-305d-966c-e79865275fbe",
                                                "text": "„Wer in Europa die Obrigkeit angreifen wollte, musste die Kirchen angreifen. Revolutionen waren gleichermaßen antiklerikal wie antiroyal, und die Franzosen trieben dies bis zu den Exzessen der Revolution von 1789.“"
                                            },
                                            {
                                                "example_id": "17ba7ee8-75a9-44c8-b149-027476b7f775",
                                                "sense_id": "d389081d-d559-305d-966c-e79865275fbe",
                                                "text": "1848 gründete er die Zeitung \"Le Confédéré de Fribourg\", die den unversöhnlichsten und antiklerikalsten Flügel seiner Partei repräsentierte."
                                            },
                                            {
                                                "example_id": "eb4f709d-17d0-4071-a77a-db977b795eae",
                                                "sense_id": "d389081d-d559-305d-966c-e79865275fbe",
                                                "text": "„Anzengruber verstand sich als Volksaufklärer und Sozialreformer, liberal und antiklerikal eingestellt.“"
                                            },
                                            {
                                                "example_id": "c6f6e866-4655-41c4-9765-64dd2182bc03",
                                                "sense_id": "d389081d-d559-305d-966c-e79865275fbe",
                                                "text": "„Wilhelm Ostwald hatte atheistischen und antiklerikalen Bestrebungen stets nahegestanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
