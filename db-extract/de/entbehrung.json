                "senses": [
                    {
                        "sense_id": "9c3c9034-d71c-3ead-89fa-c3bd4e8e40d0",
                        "entry_id": "658a2310-373c-33b7-bec9-b2e11c6be198",
                        "glosses": [
                            "Verzicht aus Mangel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "314cd39f-9966-4947-9d68-aa249d952107",
                                "sense_id": "9c3c9034-d71c-3ead-89fa-c3bd4e8e40d0",
                                "text": "Deutsche-Bank-Experte Konstam sieht die alleinige Fokussierung auf Sparpakete allerdings skeptisch: „Irgendwann ist die Grenze der Entbehrungen erreicht“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f77678f0-0fa9-430a-b406-49b0db2b199b",
                        "source_entry_id": "658a2310-373c-33b7-bec9-b2e11c6be198",
                        "source_sense_id": "9c3c9034-d71c-3ead-89fa-c3bd4e8e40d0",
                        "source_sense_description": "Verzicht aus Mangel",
                        "target_lang_word": "austerity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austerity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "696bfe9a-45b4-3c6d-816e-1fb976d6614f",
                                        "entry_id": "2e14c57e-a87f-30ff-b236-133196ea454f",
                                        "glosses": [
                                            "Severity of manners or life; extreme rigor or strictness; harsh discipline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed07c3a-0b8b-4a89-89a5-323218538e75",
                                                "sense_id": "696bfe9a-45b4-3c6d-816e-1fb976d6614f",
                                                "text": "The most rigid and noted of the English ladies resident in the French capital acknowledged and countenanced her; the virtuous Lady Elderbury, the severe Lady Rockminster, the venerable Countess of Southdown—people, in a word, renowned for austerity, and of quite a dazzling moral purity:—so great and beneficent an influence had the possession of ten (some said twenty) thousand a year exercised upon Lady Clavering’s character and reputation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d0fe9fc-b389-39a0-844b-7a1aa968c989",
                                        "entry_id": "2e14c57e-a87f-30ff-b236-133196ea454f",
                                        "glosses": [
                                            "Freedom from adornment; plainness; severe simplicity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b4805fc-da5e-4fc8-b9b9-233a7eee1532",
                                                "sense_id": "9d0fe9fc-b389-39a0-844b-7a1aa968c989",
                                                "text": "One critic [Madeleine Schwartz] recently noted that the politics of Rooney’s novels were largely “gestural,” with airy mentions of Gaza or austerity protests but not much radical substance."
                                            },
                                            {
                                                "example_id": "2149c6a1-8624-4b51-b8fa-6b442a187c10",
                                                "sense_id": "9d0fe9fc-b389-39a0-844b-7a1aa968c989",
                                                "text": "The war-torn first half of the 20th century, together with the railway grouping of 1923, ushered in further austerity in design."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd9778f7-fd2b-3136-9c8b-b4545c03243a",
                                        "entry_id": "2e14c57e-a87f-30ff-b236-133196ea454f",
                                        "glosses": [
                                            "A policy of deficit-cutting, which by definition requires lower spending, higher taxes, or both."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3861e4-c496-4384-9e84-db61a76aecdb",
                                                "sense_id": "cd9778f7-fd2b-3136-9c8b-b4545c03243a",
                                                "text": "He said France clearly wanted to \"close one page and open another\". He reiterated his opposition to austerity alone as the only way out of Europe's crisis: \"My final duty, and I know I'm being watched from beyond our borders, is to put Europe back on the path of growth and employment.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ce787f2-1571-36ce-ba3e-169ba3e6f74f",
                                        "entry_id": "2e14c57e-a87f-30ff-b236-133196ea454f",
                                        "glosses": [
                                            "Sourness and harshness to the taste."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f86e037-75c9-4fd4-a6d5-fb92355a6c1e",
                        "source_entry_id": "658a2310-373c-33b7-bec9-b2e11c6be198",
                        "source_sense_id": "9c3c9034-d71c-3ead-89fa-c3bd4e8e40d0",
                        "source_sense_description": "Verzicht aus Mangel",
                        "target_lang_word": "privation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "privation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Perte, absence, manque d’un bien ou d’un avantage qu’on avait, ou qu’on devait ou qu’on pouvait avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b086f6-9748-434b-a0ef-523eb0a82f58",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "La privation de la vue, de l’ouïe."
                                            },
                                            {
                                                "example_id": "81896c40-7e91-4a93-9e2b-30e51d5b90da",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "C’est un homme qui est dans la privation de toutes choses."
                                            },
                                            {
                                                "example_id": "e4ad263f-289c-4538-b4ad-4728f1a3678a",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "On châtia cette ville par la privation de ses privilèges."
                                            },
                                            {
                                                "example_id": "ff04b705-79d0-41c1-9164-bc1d7ce056e7",
                                                "sense_id": "63373b21-31cf-3a45-9ea4-8b919c003bd4",
                                                "text": "La privation des droits civils."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Manque de beaucoup de choses nécessaires à la vie."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d1dd4a-68cc-4dc8-8c31-bbe5240e177b",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Il l'avait saisie avec une sorte de frénésie, doué de l’appétit brutal de l'homme qui a dû accumuler trop de privations."
                                            },
                                            {
                                                "example_id": "6c52e7d3-1360-463a-bfc8-aab79990a42b",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Les intempéries et les privations ne sont rien."
                                            },
                                            {
                                                "example_id": "4d306f55-3681-4988-81d9-e3355fd4d224",
                                                "sense_id": "d89d3720-12f8-39e4-a7a4-18a8bbe5333b",
                                                "text": "Ce n'était pas tous les jours que le butin se composait de plusieurs centaines de chrétiennes toutes plus vierges les unes que les autres. De tels moments effaçaient les souvenirs de longs mois de guerre, de privations et de souffrances..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                        "entry_id": "e796350d-4176-33ac-96d6-39b3aacadff8",
                                        "glosses": [
                                            "Action de se priver volontairement, de s’abstenir de quelque chose dont on pourrait jouir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3d7271-467f-48e4-bfb4-a50cc1a39c36",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "S’imposer des privations."
                                            },
                                            {
                                                "example_id": "cd667125-0609-4212-9184-5ea9219c9673",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "À force de privations, il a amassé un petit pécule."
                                            },
                                            {
                                                "example_id": "44de1b58-c567-47eb-a39b-352eeb812fb2",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "Privation volontaire."
                                            },
                                            {
                                                "example_id": "9ec91cf5-2d5d-4348-b20f-e45a2a682e06",
                                                "sense_id": "857dbceb-9a47-3d01-bc39-59e03a0f2143",
                                                "text": "S’exercer, s’habituer aux privations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "895044de-176e-4ec3-9403-b6a29abd0c3e",
                        "source_entry_id": "658a2310-373c-33b7-bec9-b2e11c6be198",
                        "source_sense_id": "9c3c9034-d71c-3ead-89fa-c3bd4e8e40d0",
