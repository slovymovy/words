                        "glosses": [
                            "Qui concerne ou se rapporte à Lorenz Spengler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49788b6a-9213-462b-9009-247c03ad7201",
                                "sense_id": "ccf79a93-cd8b-331b-9a68-0d3bab327d22",
                                "text": "Selon ce naturaliste [Johann Julius Walbaum], la tortue spenglérienne ressemble beaucoup à la tortue serpentine ; quoi que cependant elle en diffère essentiellement par la forme de sa carapace, qui a postérieurement dix dentelures aiguës, et par l'arrangement de ses plaques écailleuses"
                            }
                        ]
                    }
