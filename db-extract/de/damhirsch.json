                "senses": [
                    {
                        "sense_id": "b7ece03f-cb21-3b74-a29b-fe7376701905",
                        "entry_id": "dce09102-bcc3-37d7-89eb-873549e62cdb",
                        "glosses": [
                            "Art der Familie Hirsche mit Schaufelgeweih und geflecktem Sommerfell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2905fbb-e7e7-4a21-b81d-3ff23e69a749",
                                "sense_id": "b7ece03f-cb21-3b74-a29b-fe7376701905",
                                "text": "Mit seinem weißgefleckten Fell und dem typischen Schaufelgeweih ist der Damhirsch einer der bekanntesten Hirsche."
                            },
                            {
                                "example_id": "b994e16b-a9de-497a-963a-fe316c58aa20",
                                "sense_id": "b7ece03f-cb21-3b74-a29b-fe7376701905",
                                "text": "Die Paarungszeit der Damhirsche ist Mitte Oktober."
                            },
                            {
                                "example_id": "22fdb399-8edf-4001-915f-9b0a571f3e3c",
                                "sense_id": "b7ece03f-cb21-3b74-a29b-fe7376701905",
                                "text": "In der Jägersprache werden Damhirsche als Damwild bezeichnet."
                            },
                            {
                                "example_id": "c90c6b7f-ea9d-4450-8f14-e8b7fedbe626",
                                "sense_id": "b7ece03f-cb21-3b74-a29b-fe7376701905",
                                "text": "„Mit diesen Worten nahm er seine gewichtige Reitpeitsche, mit der er wirklich einst einen Damhirsch zu Boden geschlagen, von der Wand, steckte eine gewaltige Pistole in seine lange Rocktasche und bestieg seinen Gaul.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
