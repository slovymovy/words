                "senses": [
                    {
                        "sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                        "entry_id": "9204615c-ff17-32f4-908a-9affd882f06b",
                        "glosses": [
                            "PKW oder LKW, der dem Zwecke dient, die Feuerwehr zur Brandbekämpfung, zum Katastrophenschutz, bei Notfällen und damit in Verbindung stehenden Aufgaben zu transportieren"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "kindersprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "586ef035-b0d1-4e51-92c8-d148f136fcf6",
                                "sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                                "text": "Ein Feuerwehrauto hat normalerweise eine Sirene."
                            },
                            {
                                "example_id": "9d15eba7-0342-40dd-b1cf-2072c36f9eee",
                                "sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                                "text": "„Ein Feuerwehrauto kommt schnell zum Einsatzort, weil alle Platz machen.“"
                            },
                            {
                                "example_id": "8f8a2aad-343a-443a-8d2e-2ea027b3fad3",
                                "sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                                "text": "„Meine Mutter stellt ein Feuerwehrauto auf den Couchtisch.“"
                            },
                            {
                                "example_id": "f4c1c9b2-462b-41f7-a06d-f3f8de7b1bef",
                                "sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                                "text": "„Er fährt ein Feuerwehrauto aus den fünfziger Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43016883-b6c6-4627-ba07-5520bfde1bdf",
                        "source_entry_id": "9204615c-ff17-32f4-908a-9affd882f06b",
                        "source_sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                        "target_lang_word": "fire engine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fire engine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82c8686c-c6a4-3c43-8a0a-a43cb5d38030",
                                        "entry_id": "f982972f-1071-367a-aad2-c173cffb7f44",
                                        "glosses": [
                                            "A vehicle used by firefighters to pump water to fight a fire. Typically, a fire engine carries a supply of water and has the ability to connect to an external water supply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbd1a412-94d6-4162-865b-f3d9723daf67",
                                                "sense_id": "82c8686c-c6a4-3c43-8a0a-a43cb5d38030",
                                                "text": "Near-synonyms: fire truck (usually synonymous in current usage); fire appliance; water engine (formerly synonymous)"
                                            },
                                            {
                                                "example_id": "1752ac37-3e31-44c1-a68b-17dbe8c7f100",
                                                "sense_id": "82c8686c-c6a4-3c43-8a0a-a43cb5d38030",
                                                "text": "A fire aboard TfW 175007, working a Holyhead-Cardiff Central service on February 8, closed the A483 road while five fire engines from Wrexham, Deeside, and Cheshire attended the scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac696d08-a0ce-3557-9bcb-0c9bc516a509",
                                        "entry_id": "f982972f-1071-367a-aad2-c173cffb7f44",
                                        "glosses": [
                                            "A steam engine."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0f678d5-67ff-49ce-86ef-1958866f5169",
                                                "sense_id": "ac696d08-a0ce-3557-9bcb-0c9bc516a509",
                                                "text": "A plan somewhat similar to this was adopted by Smeaton in the boiler of his portable fire engine."
                                            },
                                            {
                                                "example_id": "abd8010f-6525-4a5a-9d2a-76f404cf90b0",
                                                "sense_id": "ac696d08-a0ce-3557-9bcb-0c9bc516a509",
                                                "text": "In the same year a very compact arrangement for a stationary fire engine was described by Mr. Wm. Baddeley, in which he proposed it should be worked like a capstan by means of handspikes, and it could be bolted down to a ship's deck, or fastened wherever wanted."
                                            },
                                            {
                                                "example_id": "2b7b673b-3468-4b98-b960-d9de9c2807fa",
                                                "sense_id": "ac696d08-a0ce-3557-9bcb-0c9bc516a509",
                                                "text": "This discovery gave a great impulse to mechanical ingenuity, and many schemes were contrived to make this new agent available as a motive power; but the first of these projects that appears to have been of any avail was the fire engine of Captain Tomas Savery, who produced a vacuum by condensing steam in close vessels, and then applied the vacuum so obtained to the elevation of water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b0edf66-e5a1-40dc-ba76-d61c87494a4c",
                        "source_entry_id": "9204615c-ff17-32f4-908a-9affd882f06b",
                        "source_sense_id": "55e7a5c8-4666-310a-93ab-b22618467eec",
                        "target_lang_word": "fire truck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fire truck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9597378d-a6e0-39b1-87dc-b2f8a300d53b",
                                        "entry_id": "e26abae9-9504-3d4a-8898-6755b0b1bb4c",
                                        "glosses": [
                                            "A motor truck that serves as firefighting apparatus (a fire appliance)."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "US"
                                        ],
