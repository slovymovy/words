                        "excéder le montant"
                    ]
                },
                {
                    "sense_id": "5089e355-cdf3-3ba6-800b-c5d29bbf6e2f",
                    "sense_definition": "Énerver au plus haut point, lasser ou pousser à bout la patience de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce bruit constant finit par <w>excéder</w> tous les habitants du quartier."
                        },
                        {
                            "text": "Ses interruptions constantes ont fini par <w>excéder</w> la patience de son interlocuteur."
                        }
                    ],
                    "synonyms": [
                        "exaspérer"
                    ],
                    "common_phrases": [
