{
    "word_family": [
        "wielder",
        "wieldy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "220de3ea-344c-30e6-a7d5-c49b5a13ea9b",
                    "sense_definition": "To hold and use a tool or weapon with skill and ease.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was able to <w>wield</w> his heavy sword with surprising speed and grace.",
                            "target_lang_translations": {
                                "pl": "Rycerz potrafił <w>posługiwać się</w> swoim ciężkim mieczem z zaskakującą szybkością i gracją."
                            }
                        },
                        {
                            "text": "The chef can <w>wield</w> a sharp knife with incredible precision while preparing the meal.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni potrafi <w>posługiwać się</w> ostrym nożem z niezwykłą precyzją podczas przygotowywania posiłku."
                            }
                        }
                    ],
                    "synonyms": [
                        "handle",
                        "brandish",
                        "operate"
                    ],
                    "common_phrases": [
                        "wield a sword",
                        "wield a weapon"
                    ],
                    "target_lang_definitions": {
                        "pl": "Trzymać i używać narzędzia lub broni z wprawą i łatwością."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "posługiwać się",
                                "target_lang_sense_clarification": "używać narzędzia lub broni z umiejętnością"
                            },
                            {
                                "target_lang_word": "dzierżyć",
                                "target_lang_sense_clarification": "trzymać coś w ręku, często broń lub przedmiot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "640fd980-6a77-31ae-921f-d1ae8f4e62a6",
                    "sense_definition": "To exercise authority, power, or influence effectively.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president continues to <w>wield</w> significant influence over the country's economic policies.",
                            "target_lang_translations": {
                                "pl": "Prezydent nadal <w>wywiera</w> znaczący wpływ na politykę gospodarczą kraju."
                            }
                        },
                        {
                            "text": "She knows how to <w>wield</w> her authority to get things done in the office.",
                            "target_lang_translations": {
                                "pl": "Wie, jak <w>wykorzystywać</w> swój autorytet, aby załatwiać sprawy w biurze."
                            }
                        }
                    ],
                    "synonyms": [
                        "exert",
                        "exercise",
                        "command"
                    ],
                    "common_phrases": [
                        "wield power",
                        "wield influence"
                    ],
                    "target_lang_definitions": {
                        "pl": "Skutecznie sprawować władzę, wywierać wpływ lub korzystać z autorytetu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sprawować",
                                "target_lang_sense_clarification": "wykonywać władzę lub funkcję"
                            },
                            {
                                "target_lang_word": "wywierać",
                                "target_lang_sense_clarification": "mieć wpływ na coś lub kogoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b644fe61-7389-38d9-9190-feff606f0bd5",
                    "sense_definition": "To manage or guide something or someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to <w>wield</w> a large team of people during a crisis.",
                            "target_lang_translations": {
                                "pl": "Trudno jest <w>kierować</w> dużym zespołem ludzi podczas kryzysu."
                            }
                        },
                        {
                            "text": "He struggled to <w>wield</w> the complex situation to his advantage.",
                            "target_lang_translations": {
                                "pl": "Z trudem próbował <w>wykorzystać</w> tę złożoną sytuację na swoją korzyść."
                            }
                        }
                    ],
                    "synonyms": [
                        "manage",
                        "direct",
                        "control"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zarządzać czymś lub kimś, kierować sytuacją."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kierować",
                                "target_lang_sense_clarification": "zarządzać grupą ludzi lub procesem"
                            },
                            {
                                "target_lang_word": "zarządzać",
                                "target_lang_sense_clarification": "kontrolować przebieg spraw"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1cc3a8e-8da1-3def-95fa-3251754afbd3",
                    "sense_definition": "Power, control, or authority over something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king held the <w>wield</w> of the entire kingdom in his hands.",
                            "target_lang_translations": {
                                "pl": "Król dzierżył w swoich rękach <w>władzę</w> nad całym królestwem."
                            }
                        },
                        {
                            "text": "She lost her <w>wield</w> over the situation after the scandal broke.",
                            "target_lang_translations": {
                                "pl": "Straciła <w>kontrolę</w> nad sytuacją po wybuchu skandalu."
                            }
                        }
                    ],
                    "synonyms": [
                        "control",
                        "authority",
                        "power"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Władza, kontrola lub autorytet nad czymś (użycie archaiczne)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "władza",
                                "target_lang_sense_clarification": "kontrola nad terytorium lub ludźmi"
                            },
                            {
                                "target_lang_word": "kontrola",
                                "target_lang_sense_clarification": "panowanie nad sytuacją"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d12a84c2-cd34-34d4-a04a-3ba894255411",
                    "sense_definition": "Acronym for the Western Institute for Endangered Language Documentation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>WIELD</w> project focuses on preserving languages that are at risk of disappearing.",
                            "target_lang_translations": {
                                "pl": "Projekt <w>WIELD</w> koncentruje się na ochronie języków, które są zagrożone wyginięciem."
                            }
                        },
                        {
                            "text": "Researchers at <w>WIELD</w> are documenting rare dialects in remote regions.",
                            "target_lang_translations": {
                                "pl": "Naukowcy z <w>WIELD</w> dokumentują rzadkie dialekty w odległych regionach."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Akronim dla Western Institute for Endangered Language Documentation (Zachodni Instytut Dokumentacji Języków Zagrożonych)."
                    },
                    "translations": {
                        "pl": []
                    }
                }
            ]
        }
    ]
