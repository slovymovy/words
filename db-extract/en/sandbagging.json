                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "98874fe0-65ab-3e8f-a248-5e914a50d89e",
                        "entry_id": "f7daf299-815b-3074-b07b-a4cd75fc5e18",
                        "glosses": [
                            "The striking of a person with a sandbag or other heavy object."
                        ],
