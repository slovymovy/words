                "senses": [
                    {
                        "sense_id": "5b6ca722-1f0b-3185-8b4b-29c636dadc21",
                        "entry_id": "b74f0fd1-a61a-3952-a8d5-77d6a00595a8",
                        "glosses": [
                            "Souder par l’effet de la chaleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "654063a1-8d12-4478-a85a-fd9670b59fbc",
                                "sense_id": "5b6ca722-1f0b-3185-8b4b-29c636dadc21",
                                "text": "Il suffit de placer la matière sur une surface dure — carton ou planchette — et d’opérer une pression chaude par fer à repasser, fer à friser ou pince à thermo-souder."
                            },
                            {
                                "example_id": "af6b06ce-a681-434d-b476-ef2df89ed716",
                                "sense_id": "5b6ca722-1f0b-3185-8b4b-29c636dadc21",
                                "text": "La bâche de ce chapiteau a été thermo-soudée pour éviter les trous que pourraient causer les aiguilles et déchirures."
                            }
                        ]
                    }
