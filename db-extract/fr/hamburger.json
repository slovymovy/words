                            {
                                "target_word": "hamburger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                        "entry_id": "7b95aa0d-68cd-36cc-8693-162231417ac1",
                                        "glosses": [
                                            "To badly injure or damage (a fleshy part of the body)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb5af848-ac3e-4951-adf9-0430c1e75dd0",
                                                "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                                "text": "The men played baseball on coral diamonds that tore their shoes and clothes and hamburgered their hands."
                                            },
                                            {
                                                "example_id": "7204479f-4d33-4606-9fb9-acfd37b66ea4",
                                                "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                                "text": "And his tires triggered no Claymore mines or Bouncing Betties that might have hamburgered his vehicle with him in it."
                                            },
                                            {
                                                "example_id": "ed7e09a8-57bf-46a9-8b1f-263c58a0c8a2",
                                                "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                                "text": "My tears are like gagged pieces of ice cutting up my eyeballs and hamburgering my face."
                                            },
                                            {
                                                "example_id": "010d46f9-ce76-4b41-b768-3676e044db84",
                                                "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                                "text": "It’s a trail that has taken more than its fair share of blood, my first flat tire, and hamburgered my entire forearm on a descent."
                                            },
                                            {
                                                "example_id": "97b4edb3-d4f0-465b-87ff-3bc93c5d07c7",
                                                "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                                "text": "Ken broke three fingers and hamburgered his legs, but he still got to his feet, chased down his burro, and continued on to the finish line."
                                            },
                                            {
                                                "example_id": "416d2b97-14f6-494d-bfab-97444ff8dd00",
                                                "sense_id": "b814c481-48ba-3512-98a9-4202b94460b1",
                                                "text": "Why they didn’t both break their necks or get hamburgered by cloven hooves was a mystery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
