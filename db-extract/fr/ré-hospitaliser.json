                        "glosses": [
                            "Variante orthographique de réhospitaliser (hospitaliser à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6029af-6471-46db-8485-552f6b127244",
                                "sense_id": "cb165fcc-6454-3194-9b4d-a5158f733e07",
                                "text": "Et s’il y a problème ou urgence, est-ce que je suis sûr(e) de pouvoir ré-hospitaliser mon patient ?"
                            },
                            {
                                "example_id": "b52c8569-ca9b-4e07-962b-0897678d234d",
                                "sense_id": "cb165fcc-6454-3194-9b4d-a5158f733e07",
                                "text": "La décision tomba sèchement : il faut encore tout arrêter, même la kiné et le ré-hospitaliser à peine deux mois après qu’il ait passé neuf mois à l’hôpital."
                            },
                            {
                                "example_id": "32cb3658-900f-4681-b948-60bee9d1e147",
                                "sense_id": "cb165fcc-6454-3194-9b4d-a5158f733e07",
                                "text": "Voilà, il est ré-hospitalisé, drainé et diurétisé!"
                            }
                        ]
                    }
