                "senses": [
                    {
                        "sense_id": "b3a0d2d9-0627-3d2d-b965-0796340a9159",
                        "entry_id": "e6f8e06f-e395-3d9a-aa52-c6399f0f920b",
                        "glosses": [
                            "interdisziplinäres Forschungsfeld, das sich mit Methoden zur Analyse von Daten befasst, mit dem Ziel, Wissen zu gewinnen"
                        ],
                        "tags": [
                            "häufig im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0388fc21-bd44-47c5-8acb-df861160b2b4",
                                "sense_id": "b3a0d2d9-0627-3d2d-b965-0796340a9159",
                                "text": "„Neuere Entwicklungen in den Datenwissenschaften ermöglichen es etwa, in den Messwerten selbst Muster zu erkennen und zum Beispiel herauszufinden, welche Messstationen unter welchen Umständen die bedeutendsten oder die zuverlässigsten Werte liefern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
