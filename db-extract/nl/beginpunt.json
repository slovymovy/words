                ],
                "senses": [
                    {
                        "sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                        "entry_id": "bf571dc3-11fe-3035-b901-764617bdeae5",
                        "glosses": [
                            "het plaats waar iets begint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa724a32-5f2c-4a31-b6e4-ff8a8ba5dde4",
                                "sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                                "text": "Het beginpunt van de grafiek was niet goed af te lezen."
                            },
                            {
                                "example_id": "666af25e-471b-48bb-8225-198a71059089",
                                "sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                                "text": "Ik draaide me om en liep naar de beroemde Southern Terminus-palen die het beginpunt vormen van de Pacific Crest Trail."
                            },
                            {
                                "example_id": "518d98ba-12b0-4a1c-b479-2043fbc0ef10",
                                "sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                                "text": "Maar een deel van Olives probleem was dat het haar tweede natuur was geworden om geheimen te hebben; ze voelde zich er veilig bij, het was het beginpunt van haar scheppingsvermogen."
                            },
                            {
                                "example_id": "1b7ebd02-e587-43d8-a90a-a7526700d745",
                                "sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                                "text": "' Dag 2 Santa Cristina Gela - Corleone Het beginpunt van de wandeling is het dorpje Santa Cristina Gela, op drie kwartier rijden van Palermo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2517a988-35f2-48dc-a780-0928e242d895",
                        "source_entry_id": "bf571dc3-11fe-3035-b901-764617bdeae5",
                        "source_sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                        "target_lang_word": "Anfangspunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "58bd7b41-cb67-40c3-930a-68dfdcd3dbc7",
                        "source_entry_id": "bf571dc3-11fe-3035-b901-764617bdeae5",
                        "source_sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                        "target_lang_word": "starting point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starting point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9977192b-3f52-3c88-a3f2-02576a095675",
                                        "entry_id": "cb81e757-177d-3980-9f36-99826926668e",
                                        "glosses": [
                                            "The place where a journey starts."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f00c5b-952a-4f4e-bb57-fe64734a46f2",
                                                "sense_id": "9977192b-3f52-3c88-a3f2-02576a095675",
                                                "text": "King's Cross Station proved to be the starting point of a journey that took me around the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                        "entry_id": "cb81e757-177d-3980-9f36-99826926668e",
                                        "glosses": [
                                            "The first steps when commencing an activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e5b61b-2e2e-4a41-87d0-57ba531770a3",
                                                "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                                "text": "Examining the data and facts will be a good starting point."
                                            },
                                            {
                                                "example_id": "0a1dde27-f377-490a-93e3-643fa6897081",
                                                "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                                "text": "What Loehr called the Middle Western Chou is the probable starting point, that is, during the mid-eleventh century B.C.⁵⁸ when a breakdown in the old order of Phase I can be documented. For instance, a yu found at T'un-hsi, Anhui, (Plate 19) is decorated with intertwining birds both on the belly and lid and exemplifies this conversion."
                                            },
                                            {
                                                "example_id": "30201199-11b9-4ae8-8fd9-d3c4281c20bd",
                                                "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f04891b7-8460-4cd8-bf33-0f0f0399bcbb",
                        "source_entry_id": "bf571dc3-11fe-3035-b901-764617bdeae5",
                        "source_sense_id": "e5a0309a-f07e-38fb-9433-e7ec32af3ff7",
                        "target_lang_word": "point de départ",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point de départ",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2aaa20ee-65be-3f57-9979-be063070bf01",
                                        "entry_id": "e39761d8-2e55-356b-afdd-612cfdb6d7d1",
                                        "glosses": [
                                            "[Sens spatial] Lieu d'où l'on est parti."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c0f6b3-a553-4163-883b-d681ab9b3fc2",
                                                "sense_id": "2aaa20ee-65be-3f57-9979-be063070bf01",
                                                "text": "Enfin il revint à son point de départ et examina une dernière fois si tout correspondait bien : la traînée d'herbes sèches à la traînée de poudre, et la traînée de poudre du sol avec la poudre contenue dans les anfractuosités du mur."
                                            },
                                            {
                                                "example_id": "9c46820e-731d-4561-96a3-29876d33806e",
                                                "sense_id": "2aaa20ee-65be-3f57-9979-be063070bf01",
                                                "text": "Mon père dit toujours que mon sens de l’orientation en forêt est troublant – tout comme mon aptitude à retrouver mon chemin jusqu'au point de départ – mais je ne m'y fiais pas à cet instant. Je m'arrêtai sous un arbre gigantesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f467fca9-7b17-3313-b2bb-0490a09713b4",
                                        "entry_id": "e39761d8-2e55-356b-afdd-612cfdb6d7d1",
                                        "glosses": [
                                            "[Sens temporel] Point d’origine dans le temps."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                        "entry_id": "e39761d8-2e55-356b-afdd-612cfdb6d7d1",
                                        "glosses": [
                                            "Début ou commencement d’une action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd0fa23-abf9-4f41-8bc1-d53669312ce1",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "Prenant pour point de départ notre point de vue, c’est-à-dire la Terre où nous sommes, nous pouvons de là nous diriger vers les autres planètes de notre système."
                                            },
                                            {
                                                "example_id": "ab4a83b3-38d0-40ee-8380-e888d9e742f8",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "En 1888, Baur prenait un brevet pour la fabrication de musc artificiel, en prenant comme point de départ un composé appelé toluène, qui est extrait du goudron de houille."
                                            },
                                            {
                                                "example_id": "6f6fb6a2-15d8-45c2-823d-757e32753b2e",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "Tandis que le Midi, qui a, de tout temps, été un foyer de vie intellectuelle très intense et où les juifs cultivaient toutes les sciences, a été le point de départ d’une agitation antiphilosophique et antiscientifique."
                                            },
                                            {
                                                "example_id": "af71d76b-5f7b-4530-a6cd-84f5229ed613",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "La doctrine mercantiliste, sur les relations entre économie et politique des nations, a pour point de départ, pour principe la formule célèbre : « L’argent est le nerf de la guerre. »"
                                            },
                                            {
                                                "example_id": "f39aec43-37fd-433a-a4f3-db9b817b2448",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "La conquête facile de la Mandchourie et de la Corée constituait le point de départ de la grande aventure qui devait s'illustrer par l'effondrement des États-Unis d'Amérique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cebc2d15-b0a4-4395-9fd6-068577bc519e",
                        "source_entry_id": "bf571dc3-11fe-3035-b901-764617bdeae5",
