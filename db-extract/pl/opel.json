                ],
                "senses": [
                    {
                        "sense_id": "fe637f31-6d3e-39f2-9068-5bf3e7d9fd9d",
                        "entry_id": "54f304a9-2e24-3e56-80db-fc6f37c84bb2",
                        "glosses": [
                            "Auto der Marke Opel; Opel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "401fe62b-5d6c-4790-a1af-054d7dc94992",
                                "sense_id": "fe637f31-6d3e-39f2-9068-5bf3e7d9fd9d",
                                "text": "„Ponad 38 proc. posiadaczy fiatów nie zdecydowałoby się na inną markę, reszta kupiłaby volkswagena, opla lub daewoo.“",
                                "translation": "Über 38 Prozent der Fiat-Besitzer würde sich nicht für eine andere Marke entscheiden, der Rest würde einen Volkswagen, Opel oder Daewoo kaufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0530788-a185-4765-a38f-5413b8cd5bc5",
                        "source_entry_id": "54f304a9-2e24-3e56-80db-fc6f37c84bb2",
                        "source_sense_id": "fe637f31-6d3e-39f2-9068-5bf3e7d9fd9d",
                        "source_sense_description": "Technik: Auto der Marke Opel; Opel",
                        "target_lang_word": "Opel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Opel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                        "entry_id": "8880c5b8-fa36-30fd-b39a-c23d03e86552",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e09ea710-fe3c-41e6-a12a-907fa754b3aa",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Frau Opel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "7246d879-109a-4a3d-9274-d020a2105cc4",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Herr Opel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "529e1f88-aaea-440b-85da-2958222947fa",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Die Opels fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "c58d1841-25e1-49bc-9c88-9801d2a97473",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Der Opel trägt nie die Schals, die die Opel ihm strickt."
                                            },
                                            {
                                                "example_id": "59a71e83-c46e-47ed-b826-64515843a558",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Opel kommt, geht der Herr Opel.“"
                                            },
                                            {
                                                "example_id": "54ca7eba-8907-4a9c-95f7-84738c52d9c0",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Opel kommt und geht."
                                            },
                                            {
                                                "example_id": "99a19b7b-65fc-497a-ac14-a2ef686d87ae",
                                                "sense_id": "14993966-12ac-3b8a-b904-9002e5c10f3d",
                                                "text": "Opels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
