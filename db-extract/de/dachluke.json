                ],
                "senses": [
                    {
                        "sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                        "entry_id": "9c06f612-4bf3-3ed7-acb0-fb242d2e9620",
                        "glosses": [
                            "ein kleines Fenster im Hausdach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa810704-0ae3-4435-a3ad-80aab968e2c0",
                                "sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                                "text": "Der Speicher ist ziemlich dunkel, weil es nur eine kleine Dachluke gibt."
                            },
                            {
                                "example_id": "d17dad40-273e-4155-94fb-d12378d761e7",
                                "sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                                "text": "„Jan war inzwischen bei der Dachluke angelangt und kletterte hinaus.“"
                            },
                            {
                                "example_id": "96e9759f-ea1b-440d-bc74-96eb830e574e",
                                "sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                                "text": "„Das Mondlicht warf durch die Dachluke ein helles Quadrat auf den staubigen Dielenboden.“"
                            },
                            {
                                "example_id": "65c441e2-f0dc-40a2-b4dd-c3a0f20b575f",
                                "sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                                "text": "„Schon jetzt, Ende März, strömt die Luft milde und würzig durch unsere geöffnete Dachluke, und Tag um Tag strahlt die Sonne aus einem Himmel ohne Wolken.“"
                            },
                            {
                                "example_id": "1da074a9-d94c-4ff0-9c04-6bf56314ad8c",
                                "sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                                "text": "„Mit erstaunlicher Behendigkeit, wenn man seine Masse bedachte, sprang er die Trittleiter hinauf und zwängte sich durch das Loch in die Dachkammer, und unmittelbar darauf hörten wir seine triumphierende Stimme verkünden, daß er die Dachluke mit der Falltür gefunden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c708a261-4505-4ace-a091-08c7fe44a086",
                        "source_entry_id": "9c06f612-4bf3-3ed7-acb0-fb242d2e9620",
                        "source_sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                        "source_sense_description": "ein kleines Fenster im Hausdach",
                        "target_lang_word": "lucarne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucarne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "Fenêtre pratiquée dans le toit ou dans le haut d’une maison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361a69da-60a9-4dc4-b4f3-aee68c8dc06c",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "Or, il faut savoir qu’il n’y avait pas, dans toute l’hôtellerie, une seule fenêtre qui donnât sur les champs, mais uniquement une lucarne de grenier par laquelle on jetait la paille dehors."
                                            },
                                            {
                                                "example_id": "dd266d19-da81-450a-b066-82551d7d1f04",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "Une toute jeune fille était debout dans la porte entrebâillée. La lucarne du galetas où le jour paraissait était précisément en face de la porte et éclairait cette figure d’une lumière blafarde."
                                            },
                                            {
                                                "example_id": "a12a9233-4cd8-46d8-be56-7107be6cd8bf",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "L’unique lucarne du logement donnait sur la cour des Folies-Montparnasse."
                                            },
                                            {
                                                "example_id": "8b37333c-e5d1-46f6-87af-3e0b798fbdb5",
                                                "sense_id": "a9183fb3-5da3-3451-96ea-0f0f4e11a75b",
                                                "text": "D’une lucarne, dans le haut du mur, je voyais la nuit s’éclaircir. J’entendis un coq chanter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "Chacun des deux angles supérieurs que forment les poteaux des buts avec la barre transversale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27905434-054b-42b6-b69b-7cfa56230f87",
                                                "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                                "text": "L’attaquant rennais se remet sur son pied droit, à cinq mètres de la surface et déclenche une frappe surpuissante au second poteau en pleine lucarne."
                                            },
                                            {
                                                "example_id": "8d2ca9bf-5bad-490f-a6d8-68b0cdc5c894",
                                                "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                                "text": "Dimanche, son premier but, cette frappe puissante du plat du pied en plein dans la lucarne de Szczesny, n’est pas que beau."
                                            },
                                            {
                                                "example_id": "2b09b870-578c-47e0-bbb3-ad32efcffb5d",
                                                "sense_id": "e00fd41b-e8dc-31ac-9f9d-e1b5ca6f3861",
                                                "text": "Pour la photo, on préférera la praline glissée de Schär dans les arrêts de jeu, droit dans la lucarne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7def75-5ca3-3ef1-83d3-e13444495e46",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "But d’un gardien."
                                        ],
                                        "tags": [
                                            "Hockey sur glace"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "429a0415-6641-323e-9fa2-73675dd57ed3",
                                        "entry_id": "cc8062ed-ba09-3262-a2d9-08b48faaacde",
                                        "glosses": [
                                            "Dans une vidéo, petite vidéo insérée dans un coin de l’image principale, pour avoir deux vues en même temps."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c3cb700-2401-4bb8-9e8f-fdff89038df5",
                                                "sense_id": "429a0415-6641-323e-9fa2-73675dd57ed3",
                                                "text": "Cette émission de cinéma montre un extrait de film où joue une actrice présente sur le plateau et, en lucarne, l’actrice que l’on voit réagir à son image."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a252fe15-4737-447a-81ad-48e772126692",
                        "source_entry_id": "9c06f612-4bf3-3ed7-acb0-fb242d2e9620",
                        "source_sense_id": "8d282be3-abe3-3236-963a-3156d6aea547",
                        "source_sense_description": "ein kleines Fenster im Hausdach",
                        "target_lang_word": "tabatière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tabatière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a6af89f-c56b-3e1f-8eb8-19a3fe73984d",
                                        "entry_id": "5c360f0a-252d-3b2b-b4f5-1aa24675da7e",
                                        "glosses": [
                                            "Petite boite où l’on met du tabac à priser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e18df1c9-a2ba-44bf-8236-67ede0d4294a",
                                                "sense_id": "6a6af89f-c56b-3e1f-8eb8-19a3fe73984d",
                                                "text": "J'ai du bon tabac dans ma tabatière\nJ'ai du bon tabac, tu n'en auras pas."
                                            },
                                            {
                                                "example_id": "2ad9aaf8-d405-4a3c-85b7-ec77e5b79293",
                                                "sense_id": "6a6af89f-c56b-3e1f-8eb8-19a3fe73984d",
                                                "text": "Il tenait le haut bout, maniait une large tabatière, où il puisait seul pour ne point déroger, et faisait aux paysans la lecture d'un vieux journal russe à moitié pourri,…"
                                            },
                                            {
                                                "example_id": "dabc3923-9efe-4783-afed-c9a88cedfda5",
                                                "sense_id": "6a6af89f-c56b-3e1f-8eb8-19a3fe73984d",
                                                "text": "Mon voisin de droite prisait et, quand nous nous trouvions rapprochés, il me lançait sa tabatière dans laquelle je prenais de toutes petites pincées, histoire de faire comme les autres, de m’éclaircir le cerveau en éternuant."
                                            },
                                            {
                                                "example_id": "bc923b0d-a3ae-4181-a8ba-5114910b7dd8",
                                                "sense_id": "6a6af89f-c56b-3e1f-8eb8-19a3fe73984d",
                                                "text": "Comme elle tire sa tabatière, Tantôt lui demande une prise; c'est du tabac à la menthe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72685bec-e455-370c-8675-bfc41c6e7614",
                                        "entry_id": "5c360f0a-252d-3b2b-b4f5-1aa24675da7e",
                                        "glosses": [
                                            "Fenêtre à tabatière ou plutôt châssis à tabatière. Fenêtre de toit ayant la même inclinaison que celui-ci."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c1105d7-d55f-4be1-95a0-6b3de253a510",
                                                "sense_id": "72685bec-e455-370c-8675-bfc41c6e7614",
                                                "text": "C’est une petite chambre au cinquième, une de ces mansardes où la pluie tombe droite sur les vitres à tabatière, et qui — la nuit venue comme maintenant — semblent se perdre avec les toits, dans le noir et dans la rafale."
                                            },
                                            {
                                                "example_id": "14cb7b38-e665-4baa-aa0c-5d82e5d1dc0b",
                                                "sense_id": "72685bec-e455-370c-8675-bfc41c6e7614",
                                                "text": "Un petit poêle fendu envoyait son tuyau dans la vitre d’une lucarne en tabatière et couvait les pommes étalées devant lui, d’un seul œil, rouge."
                                            },
                                            {
                                                "example_id": "f4e3a398-7364-43b2-a32f-b8684b0d131a",
                                                "sense_id": "72685bec-e455-370c-8675-bfc41c6e7614",
                                                "text": "Couché sur son grabat, suçant sa pipe éteinte et ne pensant à rien, c’est la même étoile que le père Pâqueux regarde par la tabatière percée entre les chevrons."
                                            },
                                            {
                                                "example_id": "f53fa922-f10f-404f-bee6-7231cf98c079",
                                                "sense_id": "72685bec-e455-370c-8675-bfc41c6e7614",
                                                "text": "Je lève illico le panneau vitré de ma tabatière, ce qui me permet de constater qu’une belle journée se prépare."
                                            },
                                            {
                                                "example_id": "5f2ae28b-f7a0-4732-ad8f-4b8883c3a896",
                                                "sense_id": "72685bec-e455-370c-8675-bfc41c6e7614",
                                                "text": "C’était une mansarde de quelques pieds carrés sans cheminée, où la tabatière à crémaillère laissait passer l’haleine des saisons, le chaud de l’été, le froid de l’hiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b01aae-8e34-3d26-b99a-b5d7e264722e",
                                        "entry_id": "5c360f0a-252d-3b2b-b4f5-1aa24675da7e",
                                        "glosses": [
                                            "Mécanisme à charnière permettant l'ouverture de la culasse d'un fusil."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b55f6c-b02e-4202-baee-ca2e69a4b673",
                                                "sense_id": "20b01aae-8e34-3d26-b99a-b5d7e264722e",
                                                "text": "Toute la journée les fédérés ont tiraillé, et la tabatière du fusil d’Henri lui a craché à la figure. Il a l’œil droit tout meurtri, plein de grains de poudre, mais l’œil est intact."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7643159b-0ce7-31d0-a112-b09ecc87eaf8",
                                        "entry_id": "5c360f0a-252d-3b2b-b4f5-1aa24675da7e",
                                        "glosses": [
                                            "Ancien modèle, actuellement interdit, de porte-fusible en porcelaine composé d'un boîtier dans lequel des agrafes métalliques supportent un fusible ou des vis pour y mettre un fil de plomb, le tout fermé par un couvercle également en porcelaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e77895-aa9d-403d-8ce5-185501b56e2b",
                                                "sense_id": "7643159b-0ce7-31d0-a112-b09ecc87eaf8",
                                                "text": "Lorsque le fil neutre de la distribution est relié au sol, il convient de placer un parasurtension sur le fil de phase et, sur le fil neutre, une tabatière dans laquelle on remplace le fusible par un conducteur de cuivre qui réunit alors le neutre directement au sol tout en permettant la coupure pour vérification."
                                            },
                                            {
                                                "example_id": "c72f4a29-5e50-4486-999f-d2d44b35c6bb",
                                                "sense_id": "7643159b-0ce7-31d0-a112-b09ecc87eaf8",
                                                "text": "Examinons un coupe-circuit du type « tabatière ». Enlevons le couvercle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0892807c-5516-39cc-ad7d-ee06cdb445a5",
                                        "entry_id": "5c360f0a-252d-3b2b-b4f5-1aa24675da7e",
                                        "glosses": [
                                            "Ouvrière qui travaille à la fabrication du tabac."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd1b6741-99da-3694-85df-fd72193715f7",
                                        "entry_id": "5c360f0a-252d-3b2b-b4f5-1aa24675da7e",
                                        "glosses": [
                                            "Femme vendant du tabac."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c87926c-8ebb-460e-bd2a-45c20dbcb7c5",
                                                "sense_id": "fd1b6741-99da-3694-85df-fd72193715f7",
                                                "text": "La tabatière — Sauveur se plaisait à nommer ainsi la dame affable et dodue qui tenait la petite boutique tabac-journaux-papeterie du bourg — se fendit pour lui d’un large sourire en tranche de pastèque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
