                                        "sense_id": "1e2272a1-92ee-3171-8ad9-19d47c8205fd",
                                        "entry_id": "85ee121a-bba1-3382-b0ed-a20a3b69366e",
                                        "glosses": [
                                            "A pathological craving for or addiction to narcotics or alcohol."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "995d6574-8ebf-43d1-951c-13e0be437788",
                                                "sense_id": "1e2272a1-92ee-3171-8ad9-19d47c8205fd",
                                                "text": "A. S. Sholomovich reported in 1925 that two institutions for child narcotic addicts and eight out-patient clinics for three forms of \"narcomania\"—alcohol, cocaine, and morphia addiction—were functioning in Moscow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0099d271-f95f-4e87-ab5c-b8e5440c0c7e",
