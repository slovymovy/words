                "senses": [
                    {
                        "sense_id": "c3c213f7-8828-3230-a840-aa0faa256ed6",
                        "entry_id": "e3a89824-59e0-3e54-bfac-28a10f081ec1",
                        "glosses": [
                            "Konstruktion aus Stangen und/oder Seilen zum (spielerischen) Klettern, besonders für Kinder auf Spielplätzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60707d55-bc29-4758-b2d1-41a8033af7a7",
                                "sense_id": "c3c213f7-8828-3230-a840-aa0faa256ed6",
                                "text": "„Da hinten kommen sie. Jetzt kommen sie. Über den Hügel, vorbei am Klettergestell.“"
                            },
                            {
                                "example_id": "f3e33b87-1026-4b50-8518-6b67576ab22c",
                                "sense_id": "c3c213f7-8828-3230-a840-aa0faa256ed6",
                                "text": "„Wir setzten uns wieder ins Auto, fuhren zur alten E6 hinunter, kreuzten die Bahnschienen, sahen aus der Ferne die Klavierfabrik. Passierten den verschlossenen Eingang zum Laden, die Schule, wo die Klettergestelle leer waren, den alten Bahnhof, wo kein Zug mehr hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
