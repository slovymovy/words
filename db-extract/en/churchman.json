            {
                "entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                "word": "churchman",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2f6c60ad-adca-47f8-a1b1-f1c6d18eaadd",
                        "entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                        "tags": [
                            "plural"
                        ],
                        "form": "churchmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f3736a8-2e32-3649-b4ba-b45409f1f484",
                        "entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                        "glosses": [
                            "A churchwarden."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d883694f-8319-3f6a-adff-4c160d1974dd",
                        "entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                        "glosses": [
                            "A person (originally a man) of authority in a Christian religious organization (a church)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d460068-b885-4b93-a9c1-1647f5cf1de2",
                                "sense_id": "d883694f-8319-3f6a-adff-4c160d1974dd",
                                "text": "The bishop, a highly placed churchman, stated the religion's opinion."
                            }
                        ]
                    },
                    {
                        "sense_id": "207dc2b9-e425-3b03-90e8-669327fbf3f4",
                        "entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                        "glosses": [
                            "A member or adherent of an established church, especially the Church of England."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e239a240-13bc-4dfe-83e8-3a1589d14300",
                                "sense_id": "207dc2b9-e425-3b03-90e8-669327fbf3f4",
                                "text": "I replied, ‘I attended St. James's, St. Martin's, and St. Ann's, Soho;’—‘So,’ said he, ‘you are a churchman.’"
                            },
                            {
                                "example_id": "308c8376-9d31-444a-943b-d1df69d9daca",
                                "sense_id": "207dc2b9-e425-3b03-90e8-669327fbf3f4",
                                "text": "Thus they say the king of Great Britain, must maintain episcopacy in England, and presbyterianism in Scotland, whether he be a presbyterian as king William, a Lutheran as George I. or a true churchman as his present Majesty."
                            },
                            {
                                "example_id": "16b2756f-d1ef-41c3-9735-d0081ac01e21",
                                "sense_id": "207dc2b9-e425-3b03-90e8-669327fbf3f4",
                                "text": "It was a brave sight on a Sunday morning to see those old Tottenhamites—each with his comfortable lady-wife on his arm—proceeding in their stiff Sunday best to the morning service; pitying the Quaker friends they met on their way for their incomplete and unenlightened faith—the Quakers, of course, pitying the Churchmen for theirs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "751eb671-341b-458c-8762-57990f6aaa30",
                        "source_entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                        "source_sense_description": "a person of authority in a religious organization; a cleric",
                        "target_lang_word": "церко́вник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "церко́вник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1408f24b-2d1c-3a13-a037-7dda3d9ed47d",
                                        "entry_id": "3f6c9e9a-0d8b-317c-9084-b8aa5ae64dc0",
                                        "glosses": [
                                            "религ. то же, что церковнослужитель; тот, кто служит в церкви, но не посвящён в духовный сан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca241732-3760-4936-b41f-a82c555a8a8d",
                                                "sense_id": "1408f24b-2d1c-3a13-a037-7dda3d9ed47d",
                                                "text": "И когда священнические дети и прочие церковники научатся грамматического учения, и книжного разумения навыкнут всесовершенно, то и о пастве своей прилежнее будут заботиться, дабы адские волки не разогнали их."
                                            },
                                            {
                                                "example_id": "3ceb3fdb-ffe3-48bd-938a-4925b10e0024",
                                                "sense_id": "1408f24b-2d1c-3a13-a037-7dda3d9ed47d",
                                                "text": "Вскоре послышался на дворе стук колес, и минуты две спустя вошёл в залу священник при епитрахили, сопровождаемый хозяином и церковниками."
                                            },
                                            {
                                                "example_id": "5fdb4a68-15c0-43fc-b40a-132989849d49",
                                                "sense_id": "1408f24b-2d1c-3a13-a037-7dda3d9ed47d",
                                                "text": "В приезд царевны или царевен в какую-нибудь церковь или в какой-нибудь монастырь соблюдались особые строгие порядки. В церкви не мог быть никто, кроме церковников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4450946c-c737-39b9-90e6-c1a46155ab2c",
                                        "entry_id": "3f6c9e9a-0d8b-317c-9084-b8aa5ae64dc0",
                                        "glosses": [
                                            "религ. представитель духовенства, духовного сословия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dec2d3f-d192-4fd1-9f07-ea79487b3147",
                                                "sense_id": "4450946c-c737-39b9-90e6-c1a46155ab2c",
                                                "text": "С самого начала политической жизни на Руси русское духовенство имело огромное влияние, так как именно с помощью церковников и проповедуемого ими христианства языческому народу прививались зачатки культуры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d836458a-d335-3c4c-836c-59076bd698be",
                                        "entry_id": "3f6c9e9a-0d8b-317c-9084-b8aa5ae64dc0",
                                        "glosses": [
                                            "сторонник усиления влияния церкви"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987fcb16-80e4-428d-80de-5f117bf1b1da",
                                                "sense_id": "d836458a-d335-3c4c-836c-59076bd698be",
                                                "text": "Соблюдение субботы для евреев есть то, что для церковников причастие."
                                            },
                                            {
                                                "example_id": "20a96d45-23f3-44bc-b314-7ccbb06ca9a3",
                                                "sense_id": "d836458a-d335-3c4c-836c-59076bd698be",
                                                "text": "А декаденты? Это уж — быт, декаденты-то! Они уж отцам кричат: не в таких домах живете, не на тех стульях сидите, книги читаете не те! И заметно, что у родителей-атеистов дети — церковники…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c262e391-61b0-38aa-a620-b32c23477d49",
                                        "entry_id": "3f6c9e9a-0d8b-317c-9084-b8aa5ae64dc0",
                                        "glosses": [
                                            "религ. тот, кто исповедует православие; православный (у старообрядцев-беспоповцев)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb8f74da-b629-4980-bf63-a2b3f134b4da",
                                                "sense_id": "c262e391-61b0-38aa-a620-b32c23477d49",
                                                "text": "― Врут они, смотницы, пустое плетут… Мы ведь не староверы, в бабье не веруем. — Нешто церковники? — спросил Патап Максимыч дядю Онуфрия. — Всё по церкви, — отвечал дядя Онуфрий. — У нас по всей Лыковщине староверов спокон веку не важивалось."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d5cadb-3eb2-4dd7-a5b4-1620ab49ea51",
                        "source_entry_id": "f48de277-5e2c-37f1-84d3-8c9047670050",
                        "source_sense_description": "a person of authority in a religious organization; a cleric",
                        "target_lang_word": "священнослужи́тель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "священнослужи́тель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0aca64a9-e9c3-364d-bee0-e680a0a32d42",
                                        "entry_id": "731dc077-6538-3e1d-88e5-3bd12b850008",
                                        "glosses": [
                                            "религ. лицо, совершающее богослужение, имеющее духовный сан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fdb89b1-90ec-45ce-8303-a2c9fe773686",
                                                "sense_id": "0aca64a9-e9c3-364d-bee0-e680a0a32d42",
                                                "text": "Накануне вечером в храме было совершено вечернее богослужение, священнослужители читали над телом почившего пастыря Евангелие."
                                            },
                                            {
                                                "example_id": "86b52b3a-d5da-4976-9039-d196fd989d60",
                                                "sense_id": "0aca64a9-e9c3-364d-bee0-e680a0a32d42",
                                                "text": "Политика Каткова как главного редактора была направлена на широкое освещение религиозной жизни русского народа, пробуждение в российском обществе интереса к церковной и духовно-нравственной проблематике. Это осуществлялось посредством публикации произведений с положительными образами священников, монахов, старцев и в целом русского православия (примеры ― роман Ф. М. Достоевского «Братья Карамазовы» и роман-хроника Н. С. Лескова «Соборяне» с живыми и глубокими изображениями православных священнослужителей ― старца Зосимы, протопопа Савелия Туберозова, священника Захарии Бенефактова и диакона Ахиллы Десницына)."
                                            },
                                            {
                                                "example_id": "9f8b32af-878e-4883-9bc7-0c0cb870173f",
                                                "sense_id": "0aca64a9-e9c3-364d-bee0-e680a0a32d42",
                                                "text": "В настоящее время происходит возрождение института военного и морского духовенства, штатные священнослужители появляются в армии и на флоте и сталкиваются с различными сложностями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
