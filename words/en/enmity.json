{
    "word_family": [
        "enemy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                    "sense_definition": "The quality of being an enemy; a hostile or unfriendly disposition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hostility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>enmity</w> between the two families lasted for several generations.",
                            "target_lang_translations": {
                                "ru": "Древняя <w>вражда</w> между двумя семьями длилась несколько поколений."
                            }
                        },
                        {
                            "text": "They lived in a state of constant <w>enmity</w> with their neighbors.",
                            "target_lang_translations": {
                                "ru": "Они жили в состоянии постоянной <w>вражды</w> со своими соседями."
                            }
                        }
                    ],
                    "synonyms": [
                        "hostility",
                        "antagonism"
                    ],
                    "antonyms": [
                        "amity"
                    ],
                    "common_phrases": [
                        "deep enmity",
                        "constant enmity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношения или настрой врагов; враждебное или недружелюбное расположение духа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вражда",
                                "target_lang_sense_clarification": "неприязненные отношения между сторонами"
                            },
                            {
                                "target_lang_word": "враждебность",
                                "target_lang_sense_clarification": "враждебный настрой, расположенность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                    "sense_definition": "A state or feeling of opposition, hatred, or animosity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hostility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a deep <w>enmity</w> between the two political rivals that never faded.",
                            "target_lang_translations": {
                                "ru": "Между двумя политическими соперниками существовала глубокая <w>вражда</w>, которая никогда не угасала."
                            }
                        },
                        {
                            "text": "He could not hide his <w>enmity</w> toward those who had betrayed his trust.",
                            "target_lang_translations": {
                                "ru": "Он не мог скрыть своей <w>неприязни</w> к тем, кто обманул его доверие."
                            }
                        }
                    ],
                    "synonyms": [
                        "animosity",
                        "rancor",
                        "antipathy"
                    ],
                    "common_phrases": [
                        "deep enmity",
                        "bitter enmity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или глубокое чувство противостояния, ненависти или сильной неприязни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неприязнь",
                                "target_lang_sense_clarification": "чувство антипатии или недоброжелательности"
                            },
                            {
                                "target_lang_word": "враждебность",
                                "target_lang_sense_clarification": "чувство вражды или агрессии"
                            },
                            {
                                "target_lang_word": "вражда",
                                "target_lang_sense_clarification": "противостояние, взаимная ненависть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}