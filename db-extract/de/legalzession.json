                "senses": [
                    {
                        "sense_id": "f41421d9-dd54-3049-8dd0-0f8aa19ed55e",
                        "entry_id": "8c248c33-2439-3fc6-9125-21797c9bf190",
                        "glosses": [
                            "Übergang einer Forderung kraft Gesetzes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c3bf85-3e59-4ef4-8486-911231c5d834",
                                "sense_id": "f41421d9-dd54-3049-8dd0-0f8aa19ed55e",
                                "text": "„Der Geschädigte verliert mit der Legalzession die aktive Legitimation auf Schadenersatz, soweit der Anspruch auf den Sozialversicherungsträger übergegangen ist.“"
                            },
                            {
                                "example_id": "0cd40df4-e907-4cab-adbc-4b7ed42a8a59",
                                "sense_id": "f41421d9-dd54-3049-8dd0-0f8aa19ed55e",
                                "text": "„Durch die vorgesehene Legalzession hat der Träger der Behindertenhilfe die Möglichkeit, bereits getätigte Ausgaben von Dritten ersetzt zu bekommen.“"
                            },
                            {
                                "example_id": "fa94ee3b-fd4b-4474-a81d-e37880e026aa",
                                "sense_id": "f41421d9-dd54-3049-8dd0-0f8aa19ed55e",
                                "text": "„Krankenversicherungsträger und allfällige Haftpflichtversicherer, die den Schaden liquidiert haben, können ihrerseits nach Übergang der Schadenersatzforderung des Kindes im Wege der Legalzession vom ‚Beaufsichtiger‘ als Verursacher Ersatz fordern (§ 332 ASVG; § 67 VersVG).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
