                "senses": [
                    {
                        "sense_id": "0d08e0b3-7dc9-3199-8612-70bddfba34b7",
                        "entry_id": "6fa86e3b-acd5-3300-bc44-724afa70b6e5",
                        "glosses": [
                            "bewaffneter Konflikt, der ausbricht, weil es Streitigkeiten über die Thronfolge gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7d53aa-8440-4383-9069-5880040e5183",
                                "sense_id": "0d08e0b3-7dc9-3199-8612-70bddfba34b7",
                                "text": "„Nach dem Tod König Heinrichs IV. folgt ihm seine Tochter als Isabella I., die jedoch im fünfjährigen Erbfolgekrieg ihre Ansprüche gegenüber Portugal durchsetzen muss.“"
                            },
                            {
                                "example_id": "80379187-4f21-45a3-a01d-fb1854d77be0",
                                "sense_id": "0d08e0b3-7dc9-3199-8612-70bddfba34b7",
                                "text": "„Dieselbe Strategie verfolgten sie im Spanischen Erbfolgekrieg, der ab 1702 auch zwischen Frankreich und England in Nordamerika ausgefochten wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
