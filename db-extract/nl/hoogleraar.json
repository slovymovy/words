                "senses": [
                    {
                        "sense_id": "0e1a5404-c4a8-3920-b49d-de02e5a8c427",
                        "entry_id": "a8d15fdf-4d51-3917-a4a5-ddd741d63e45",
                        "glosses": [
                            "iemand met titel professor die aan een hogeschool of universiteit een leerstoel in een bepaald vak bekleedt en die het onderzoek en onderwijs in dit vak leidt"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "6e083f38-1e11-4b26-bc87-095420337383",
                                "sense_id": "0e1a5404-c4a8-3920-b49d-de02e5a8c427",
                                "text": "Precies 150 jaar geleden sprak Robert Fruin hier zijn oratie uit als eerste hoogleraar Vaderlandse Geschiedenis in Leiden en daarmee tegelijk als eerste hoogleraar geschiedenis in Nederland."
                            },
                            {
                                "example_id": "d2fa0dda-1ef2-4c4d-a8f3-14cfa8175e62",
                                "sense_id": "0e1a5404-c4a8-3920-b49d-de02e5a8c427",
                                "text": "Uiteindelijk verloor Buikhuisen ook de steun van de universiteit. Na enkele jaren vertrok de hoogleraar naar Spanje, waar hij antiekhandelaar werd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0470c855-f6e4-4596-a6ba-1f6eae2144e1",
                        "source_entry_id": "a8d15fdf-4d51-3917-a4a5-ddd741d63e45",
                        "source_sense_id": "0e1a5404-c4a8-3920-b49d-de02e5a8c427",
                        "source_sense_description": "iemand met titel professor die aan een hogeschool of universiteit een leerstoel in een bepaald vak bekleedt en die het onderzoek en onderwijs in dit vak leidt",
                        "target_lang_word": "Hochschullehrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochschullehrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                        "entry_id": "87822375-24f3-3754-abc0-ddd32476f407",
                                        "glosses": [
                                            "Person, die an einer Hochschule unterrichtet und forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d6f811-d7e5-440a-9b40-59f9c134e8be",
                                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                                "text": "Letztes Jahr nahm er eine Stelle als Hochschullehrer an einer angesehenen Universität an."
                                            },
                                            {
                                                "example_id": "ebe0dd0e-c5bd-4823-b27d-9d412691029f",
                                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                                "text": "„Als Jurist und Hochschullehrer verfügte Steinberg über eine für seine Zeit beachtliche Büchersammlung.“"
                                            },
                                            {
                                                "example_id": "f247c4eb-6197-47d2-9a75-e189b916c4e6",
                                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                                "text": "„Für diese Trennung hatten sich übrigens gerade die deutschen Hochschullehrer stark gemacht.“"
                                            },
                                            {
                                                "example_id": "a23a270c-3ad7-47db-8f9d-7a764dcb8997",
                                                "sense_id": "68f70048-7ebe-3d5c-b30b-be1b7bf01380",
                                                "text": "„Ich berichte im folgenden aus der Perspektive des Hochschullehrers in Erinnerung an die Vorgänge der damaligen Jahre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeb115d6-be65-4916-9a9d-6f0b262ad2d4",
                        "source_entry_id": "a8d15fdf-4d51-3917-a4a5-ddd741d63e45",
                        "source_sense_id": "0e1a5404-c4a8-3920-b49d-de02e5a8c427",
                        "source_sense_description": "iemand met titel professor die aan een hogeschool of universiteit een leerstoel in een bepaald vak bekleedt en die het onderzoek en onderwijs in dit vak leidt",
                        "target_lang_word": "professor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "professor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b57a77-fa24-3377-8438-7f18719ac2c1",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "The most senior rank for an academic at a university or similar institution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80ea57fb-d3a8-41b4-b595-e1014c6ea998",
                                                "sense_id": "d0b57a77-fa24-3377-8438-7f18719ac2c1",
                                                "text": "Professor is what you become after teaching for twenty to thirty years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0648a193-f236-3033-a788-4dcaf0ee3e7d",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A teacher or faculty member at a college or university regardless of formal rank."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "One who professes something, such as a religious doctrine."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea142e1e-4d80-4c01-9aa9-f3933ce438cb",
                                                "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                                "text": "As for Religion, I have not said, much lesse meant irreverently of it, or of the Professors thereof."
                                            },
                                            {
                                                "example_id": "e57c59e7-843b-450b-a3df-4c1e37e6776e",
                                                "sense_id": "dc655b59-1612-30c2-8e44-4bb5ee3ea640",
                                                "text": "This period in which Abraham the Jew lived was one in which Magic was almost universally believed in, and in which its Professors were held in honour;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62efaa3-0e29-3770-bf4d-5efed6e7d063",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A practitioner, one who (publicly) practises or teaches an art or skill."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c450cb3-7bd8-4d6e-a247-9a1397da5f17",
                                                "sense_id": "f62efaa3-0e29-3770-bf4d-5efed6e7d063",
                                                "text": "Two young men of familiar acquaintance … were one euening at a common Inne of this town (as I haue heard) where the one of them shewed his skill on the Virginals, to the no little contentement of the hearers. Nowe as diuers guests of the house came into the room to listen, so among the rest entered an artificiall Conny-catcher, who as occasion serued, in the time of ceissing betweene the seueral toyes and fancies hee plaid: very much commended his cunning, quicke hand, and such qualities praiseworthy in such a professour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9026d2-0d41-3d55-ac18-8dde6b60ffd1",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "A pianist in a saloon, brothel, etc."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42855727-aa29-4c32-a189-b66a89488d47",
                                                "sense_id": "cb9026d2-0d41-3d55-ac18-8dde6b60ffd1",
                                                "text": "You could hear [...] pianos under the hands of whorehouse professors sounding like they came with keys between the keys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f5f94d-4bc3-3ffd-b9e9-2c95655bb70e",
                                        "entry_id": "3718b061-489b-39ca-8e11-9ee1e111150b",
                                        "glosses": [
                                            "The puppeteer who performs a Punch and Judy show; a Punchman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
