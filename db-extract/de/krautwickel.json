                                        "entry_id": "8afaa2f6-e54b-3964-8f23-4721c9a661c4",
                                        "glosses": [
                                            "Russulaceae, grzyb blaszkowy należący do rodziny gołąbkowatych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
