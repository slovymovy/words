                                            {
                                                "example_id": "75584094-22bc-416a-a842-f9d42e160cef",
                                                "sense_id": "0eba838d-056e-3e02-bd75-37641b005c9e",
                                                "text": "Die Moas sind wahrscheinlich vom Menschen ausgerottet worden."
                                            }
                                        ],
