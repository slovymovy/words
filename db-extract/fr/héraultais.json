                "senses": [
                    {
                        "sense_id": "b163c168-788a-36d4-a94d-5111e75e5f30",
                        "entry_id": "edb98657-b307-3b33-b31c-7c00036d01ed",
                        "glosses": [
                            "Relatif à l’Hérault, département français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203a9152-4e11-4bad-b968-c40c33b12308",
                                "sense_id": "b163c168-788a-36d4-a94d-5111e75e5f30",
                                "text": "La commission médicale du club héraultais a décidé de prolonger sa période d’arrêt jusqu’au lundi 7 novembre."
                            },
                            {
                                "example_id": "720f7c6f-fe05-4a0d-958f-bdec6f80d379",
                                "sense_id": "b163c168-788a-36d4-a94d-5111e75e5f30",
                                "text": "Si le Nancéien n’était pas suspendu ce week-end, le président héraultais lui aurait bien dit le fond de sa pensée, comme il l’a confié au Républicain Lorrain."
                            },
                            {
                                "example_id": "56795a2f-1e82-4bd1-9153-7edeccbd47b9",
                                "sense_id": "b163c168-788a-36d4-a94d-5111e75e5f30",
                                "text": "Le club héraultais, champion de France 2022 et quart-finaliste du dernier exercice, a fait venir le réceptionneur-attaquant Moritz Reichert (28 ans, capitaine de l’équipe d’Allemagne), qui évoluait à Tourcoing."
                            }
                        ]
                    }
