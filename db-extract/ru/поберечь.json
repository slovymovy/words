                "word": "поберечь",
                "pos": "verb",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6173bf63-aad0-34ae-9118-c41892ec6b3e",
                        "entry_id": "1f9a29a3-7a8c-390d-81da-ddac4a72286e",
                        "glosses": [
                            "Garder, défendre, protéger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2158c7ca-cec5-4d55-b208-e9ee97e25adf",
                                "sense_id": "6173bf63-aad0-34ae-9118-c41892ec6b3e",
                                "text": "беречь детей : garder des enfants."
                            },
                            {
                                "example_id": "e63689a4-e40d-4901-a501-f871d8549b69",
                                "sense_id": "6173bf63-aad0-34ae-9118-c41892ec6b3e",
                                "text": "беречь тайну : garder un secret."
                            }
                        ]
                    },
                    {
                        "sense_id": "c39d4d27-ae29-3ae4-9093-310f3a1bd22a",
                        "entry_id": "1f9a29a3-7a8c-390d-81da-ddac4a72286e",
                        "glosses": [
                            "Conserver, garder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "553e023f-9da5-4a64-820b-1367a90d471f",
                                "sense_id": "c39d4d27-ae29-3ae4-9093-310f3a1bd22a",
                                "text": "беречь деньги : conserver de l’argent."
                            },
                            {
                                "example_id": "b59beaf9-b7ec-41c9-bdae-4132421fe83c",
                                "sense_id": "c39d4d27-ae29-3ae4-9093-310f3a1bd22a",
                                "text": "беречь здоровье : ménager sa santé."
                            },
                            {
                                "example_id": "c59d5aae-4e24-4b49-8d37-fd48105578f0",
                                "sense_id": "c39d4d27-ae29-3ae4-9093-310f3a1bd22a",
                                "text": "беречь важные бумаги : conserver des documents importants."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec445f51-fd59-322a-a982-2574d86b5e6e",
                        "entry_id": "1f9a29a3-7a8c-390d-81da-ddac4a72286e",
                        "glosses": [
                            "Ménager, économiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f437b909-843e-411e-982c-583c75957515",
                                "sense_id": "ec445f51-fd59-322a-a982-2574d86b5e6e",
                                "text": "беречь силы : ménager ses forces."
                            },
                            {
                                "example_id": "8d57da35-26f7-4ce7-a30e-8e3ab4f53e50",
                                "sense_id": "ec445f51-fd59-322a-a982-2574d86b5e6e",
                                "text": "беречь своё время : économiser son temps."
                            }
                        ]
                    }
