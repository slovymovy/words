                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave an <w>expedite</w> response to the urgent request.",
                            "target_lang_translations": {
                                "ru": "Руководитель дал <w>незамедлительный</w> ответ на срочный запрос."
                            }
