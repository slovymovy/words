                ],
                "senses": [
                    {
                        "sense_id": "921a962c-7fe1-35e1-b0e5-0a5c9cf61b75",
                        "entry_id": "5c8eb51d-af76-3572-90f4-45ee56b1909c",
                        "glosses": [
                            "een deken van gassen die zich vormt rond een planeet of maan als massa ervan groot genoeg en de temperatuur niet te hoog is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4395a22-d499-4b15-a3c3-6967bd60f6f7",
                                "sense_id": "921a962c-7fe1-35e1-b0e5-0a5c9cf61b75",
                                "text": "De dampkring van Neptunus bestaat uit waterstof, helium en methaan."
                            },
                            {
                                "example_id": "074b366a-c053-4485-93d2-6faca0fe7d7a",
                                "sense_id": "921a962c-7fe1-35e1-b0e5-0a5c9cf61b75",
                                "text": "Poollicht kan alleen ontstaan in de dampkring van een planeet met een magnetisch veld."
                            }
                        ]
                    },
                    {
                        "sense_id": "afaad6be-12b4-3781-934f-fe71892dd39c",
                        "entry_id": "5c8eb51d-af76-3572-90f4-45ee56b1909c",
                        "glosses": [
                            "de dampkring van de Aarde."
                        ],
                        "tags": [
                            "pregnant gebruik"
                        ],
                        "examples": [
                            {
                                "example_id": "dc2bc30c-cfe9-424d-9a5c-a5d02c8c0afd",
                                "sense_id": "afaad6be-12b4-3781-934f-fe71892dd39c",
                                "text": "Het resultaat is dat er een teveel aan kooldioxide ontstaat die in de dampkring terechtkomt."
                            },
                            {
                                "example_id": "090fdf04-6362-4fb1-b88f-d38a4e6af072",
                                "sense_id": "afaad6be-12b4-3781-934f-fe71892dd39c",
                                "text": "Minder last van de dampkring is leuk, maar helemaal geen last van de dampkring is het einde."
                            },
                            {
                                "example_id": "51c1f53a-067e-4e79-8bc2-d6d6a0d67927",
                                "sense_id": "afaad6be-12b4-3781-934f-fe71892dd39c",
                                "text": "Door verstrooiing van licht in de dampkring kunnen de allerzwakste sterren niet worden waargenomen - ze steken eenvoudigweg niet voldoende af tegen de hemelachtergrond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f8594cd-cf59-4984-8cb4-4405f633b2c2",
                        "source_entry_id": "5c8eb51d-af76-3572-90f4-45ee56b1909c",
                        "source_sense_id": "921a962c-7fe1-35e1-b0e5-0a5c9cf61b75",
                        "source_sense_description": "een deken van gassen die zich vormt rond een planeet of maan als...",
                        "target_lang_word": "Atmosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atmosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77420c45-9fc5-3c02-bdfa-90b6167ff110",
                                        "entry_id": "1beca71a-4639-3db7-ba8f-a3851a6ef341",
                                        "glosses": [
                                            "Gashülle eines Himmelskörpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c45e66-d8a2-4607-8808-3e910b5cac98",
                                                "sense_id": "77420c45-9fc5-3c02-bdfa-90b6167ff110",
                                                "text": "„Neben manchen Planeten hat auch der große Saturnmond Titan eine dichte Atmosphäre.“"
                                            },
                                            {
                                                "example_id": "beb9f827-d263-4e2e-90df-4ac20fc73144",
                                                "sense_id": "77420c45-9fc5-3c02-bdfa-90b6167ff110",
                                                "text": "„Für die Wissenschaft steht fest, daß sich die Konzentration der Treibhausgase (wie z.B. CO₂) in der Atmosphäre erhöht und daß mit steigender Konzentration der Anteil der in der Atmosphäre eingefangenen Sonnenenergie zunimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                        "entry_id": "1beca71a-4639-3db7-ba8f-a3851a6ef341",
                                        "glosses": [
                                            "wahrnehmbare Stimmung an einem Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e11f1141-5e00-4765-8449-6ec12ab096a8",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "Die Atmosphäre beim Konzert gestern war wunderbar."
                                            },
                                            {
                                                "example_id": "e910f027-cdc8-43fa-8895-76dfd5af5024",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "„[…] wir [Anmerkung: die Wikipedia-Gemeinschaft] versuchen, eine Atmosphäre zu schaffen, sodass sich auch neue Mitschreiberinnen und Mitschreiber wohlfühlen.“"
                                            },
                                            {
                                                "example_id": "7739a7ec-5284-4b7d-b5df-5f1abe1afafd",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "„Die Beerdigung findet in extravaganter Atmosphäre in New York statt.“"
                                            },
                                            {
                                                "example_id": "88594975-4da4-4c81-b1b2-d190f60d0ba2",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "„Die Atmosphäre entspannte sich.“"
                                            },
                                            {
                                                "example_id": "08357bc4-0022-48f6-8b72-7ac388f34372",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "„In dieser Atmosphäre vereinbarten sie ein Treffen in der Nacht, in der auch das Konzert der Diva der Eisenbahntrassen stattfand.“"
                                            },
                                            {
                                                "example_id": "ea10aa7a-9615-4081-9578-a8a459db68d0",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "„Im April veränderte sich die Atmosphäre auf dem Darß und auch auf unserem Hof.“"
                                            },
                                            {
                                                "example_id": "6e103334-7156-496d-8a5b-9a3d4f80ff7e",
                                                "sense_id": "5c206981-06a6-3299-a701-d253b6e6abb9",
                                                "text": "„Auch in den Entbindungsstationen wird heute zunehmend auf die Atmosphäre der Geburtsräume geachtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "168801d7-fbb2-33d1-989e-18700a281bf9",
                                        "entry_id": "1beca71a-4639-3db7-ba8f-a3851a6ef341",
                                        "glosses": [
                                            "gasförmiges Medium in einem abgeschlossenen System"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7485a77-8e8d-4e7a-9c26-7bbdcd731161",
                                                "sense_id": "168801d7-fbb2-33d1-989e-18700a281bf9",
                                                "text": "„Für die Wissenschaft steht fest, daß sich die Konzentration der Treibhausgase (wie z.B. CO₂) in der Atmosphäre erhöht und daß mit steigender Konzentration der Anteil der in der Atmosphäre eingefangenen Sonnenenergie zunimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2fe81d62-1844-3e5b-a17f-4b79507e0bc7",
                                        "entry_id": "1beca71a-4639-3db7-ba8f-a3851a6ef341",
                                        "glosses": [
                                            "alte Maßeinheiten für den (physikalischen und technischen) Druck"
                                        ],
                                        "tags": [
                                            "Messwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6261af3-31c7-4228-a0c7-fee0fdbec925",
                                                "sense_id": "2fe81d62-1844-3e5b-a17f-4b79507e0bc7",
                                                "text": "„Eine physikalische Atmosphäre ist als 760 Torr definiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac311ee-e120-41f4-b512-14edd752d003",
                        "source_entry_id": "5c8eb51d-af76-3572-90f4-45ee56b1909c",
                        "source_sense_id": "afaad6be-12b4-3781-934f-fe71892dd39c",
                        "source_sense_description": "de dampkring van de aarde",
                        "target_lang_word": "Erdatmosphäre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdatmosphäre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5293d858-d40d-3d34-8ae1-ecda93349f59",
                                        "entry_id": "a811376b-e87e-3433-94c0-bfe7f159bf2d",
                                        "glosses": [
                                            "Atmosphäre, gasförmige Hülle der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f728d3ba-2b71-4646-8b28-25f719122b7d",
                                                "sense_id": "5293d858-d40d-3d34-8ae1-ecda93349f59",
                                                "text": "Vergleicht man die Erde mit einer Orange, so entspricht die Orangenschale in etwa der Erdatmosphäre."
                                            },
                                            {
                                                "example_id": "0acb6471-aad7-45b5-967a-bc52d13c776f",
                                                "sense_id": "5293d858-d40d-3d34-8ae1-ecda93349f59",
                                                "text": "„Zwar brachte das Rocky-Mountains-Teleskop den Mond näher heran, aber die Erdatmosphäre schwächte die Lichtstärke derart, daß Barbicane mit Hilfe einer Lorgnette Einzelheiten wahrnehmen konnte, die den Astronomen dort unten verborgen blieben.“"
                                            },
                                            {
                                                "example_id": "fc21dc8b-b4c7-4af9-9171-397e1de125b2",
                                                "sense_id": "5293d858-d40d-3d34-8ae1-ecda93349f59",
                                                "text": "„Die Erdatmosphäre ist über 400 km dick, aber der meiste Wasserdampf befindet sich in den untersten zwölf Kilometern, der Troposphäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
