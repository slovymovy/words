                        "entry_id": "dd948454-e5aa-3bc1-b321-d24a46ef62d5",
                        "glosses": [
                            "Installation d’une ou plusieurs applications sur un appareil Apple iPhone ou iPod Touch, en contournant la GDN."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "ff59fda0-e3fd-4df6-afe5-9a4643e9d794",
                                "sense_id": "cdb84597-b044-3aaf-91d4-1b98638d6617",
                                "text": "Apple semble l’appliquer à la lettre, avec le recrutement en stage du hacker Comex, qui s’est rendu célèbre avec ses jailbreaks de l’iPhone."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80650e28-3992-4c66-b072-dbab56423e37",
                        "source_entry_id": "dd948454-e5aa-3bc1-b321-d24a46ef62d5",
                        "source_sense_id": "cdb84597-b044-3aaf-91d4-1b98638d6617",
                        "target_lang_word": "jailbreak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jailbreak",
