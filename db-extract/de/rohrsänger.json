                                    {
                                        "sense_id": "54e7132a-aa08-3825-9abb-66d5a4b58101",
                                        "entry_id": "5a3f78ca-b5e9-3b61-a3c5-48b286eaa35f",
                                        "glosses": [
                                            "Any of various small passerine songbirds, especially of the family Sylviidae (Old World warblers) and Parulidae (New World warblers)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d0a697e-17bd-3037-8496-0b1c546654d2",
                                        "entry_id": "5a3f78ca-b5e9-3b61-a3c5-48b286eaa35f",
                                        "glosses": [
                                            "One who warbles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "619623a2-caec-478a-9c48-37e0a524f1ab",
                                                "sense_id": "5d0a697e-17bd-3037-8496-0b1c546654d2",
                                                "text": "In lulling strains the feather'd warblers woo."
                                            },
                                            {
                                                "example_id": "fa2c88b2-8528-4962-bfd8-063767038be3",
                                                "sense_id": "5d0a697e-17bd-3037-8496-0b1c546654d2",
                                                "text": "And it looked like at first she was just another pop warbler, and “Girls Just Want to Have Fun” is a great record, but nothing threatening, nothing strange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb65d08-7a8d-3e1f-9490-7259dd10571f",
                                        "entry_id": "5a3f78ca-b5e9-3b61-a3c5-48b286eaa35f",
                                        "glosses": [
                                            "A device that makes a warbling sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07675d91-60e9-4c40-bf1e-e0942775f230",
                                                "sense_id": "dbb65d08-7a8d-3e1f-9490-7259dd10571f",
                                                "text": "In electronic telephones, this ringer may be a small electronic warbler rather than a bell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "694b1b02-f844-3299-a48a-34c1c8cafc79",
                                        "entry_id": "5a3f78ca-b5e9-3b61-a3c5-48b286eaa35f",
                                        "glosses": [
                                            "A hissy fit."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
