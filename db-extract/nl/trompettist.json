                            {
                                "example_id": "3ac6c936-2986-4d06-8a6c-919a553eb130",
                                "sense_id": "f350a875-cb83-38d2-ac54-3d0082bbf152",
                                "text": "Zonder ventielen te gebruiken blies de trompettist de schrille tonen van de 'last post'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a763900-0ece-4ddb-a09b-942f2cb84b12",
                        "source_entry_id": "b215dcc5-f0f5-3344-931f-9951277a4098",
                        "source_sense_id": "f350a875-cb83-38d2-ac54-3d0082bbf152",
                        "source_sense_description": "musicus die een trompet bespeelt",
                        "target_lang_word": "Trompeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trompeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                        "entry_id": "f96f4396-6b56-30cb-8d59-5073bb6bc90a",
                                        "glosses": [
                                            "jemand, der Trompete spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656a5ead-23f9-41f8-b829-5b0439e664b9",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "Der Trompeter übte an jedem Tag mindestens fünf Stunden das Spielen seines Instrumentes."
                                            },
                                            {
                                                "example_id": "53f8b325-ad1b-4a6c-8e36-55a204ca9074",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "„Das Jazz at the Lincoln Center Orchestra ehrte Legenden von Benny Goodman bis Dizzy Gillespie. Besonders berührend: ein Duett von Wynton Marsalis mit dem hiesigen Trompeter Thomas Gansch.“"
                                            },
                                            {
                                                "example_id": "2fffef31-097d-4ecc-b38e-4209c1128c2d",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "„Sie stand am Tresen und schäkerte mit einem Blondschopf, dem Trompeter von Bernhard Ettés Orchester.“"
                                            },
                                            {
                                                "example_id": "6222d15a-b014-4fe3-80f0-e53e833c297c",
                                                "sense_id": "4789d794-9e2c-3e69-9995-54a3e94f77d7",
                                                "text": "„Ein Trompeter blies die Sonne in ihr Nachtlager, die Soldaten sangen Lieder und schwärmten von Fischen und gebratenem Ochsenfleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81037ed8-de1b-31cf-add7-10d0ee0a2f95",
                                        "entry_id": "f96f4396-6b56-30cb-8d59-5073bb6bc90a",
                                        "glosses": [
                                            "Dienstgrad im Deutschen Reich für einen Soldaten des Trompeterkorps"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fd743bc-13fe-485e-8a51-ba95d94d52f3",
                                                "sense_id": "81037ed8-de1b-31cf-add7-10d0ee0a2f95",
                                                "text": "„Sergeant Henry Serpollet tot, Trompeter Wenzel Zavadil 41,2 Grad Fieber.“"
                                            },
                                            {
                                                "example_id": "fb0e6c46-a5f1-4413-b486-6a0bc2bda60e",
                                                "sense_id": "81037ed8-de1b-31cf-add7-10d0ee0a2f95",
                                                "text": "„Auf jedem Gesicht von Denissow bis zum Trompeter zeigte sich ein bei allen gleicher Ausdruck von Kampflust, Spannung und Aufregung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
