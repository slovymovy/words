                        ],
                        "form": "периге́лии"
                    },
                    {
                        "form_id": "f6a50727-9c6c-40fd-9837-69dd1728be35",
                        "entry_id": "50f87cdb-4847-3eb4-b44f-d6645defabb0",
                        "tags": [
                            "plural",
