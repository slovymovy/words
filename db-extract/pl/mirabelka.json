                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff639127-4f53-44e7-bdb6-fe39cac4835f",
                                "sense_id": "720b60e4-e245-3f7d-b504-cbea2d94ea92",
                                "text": "Nagotowałam kompotu z mirabelek, może skosztujesz?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f5f3583-0bb0-4c1e-9a0d-f94c1310c6a3",
