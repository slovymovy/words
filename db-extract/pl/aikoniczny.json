                "translations": [
                    {
                        "translation_id": "0e2b3922-7983-4e4a-9aa3-e73991b81896",
                        "source_entry_id": "5cb2bab4-7f0d-3fc0-b83d-235f28c23525",
                        "source_sense_id": "89bbb692-a73c-3046-9277-db126d577eb0",
                        "target_lang_word": "anikonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anikonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43451a65-b6fa-30c7-a5d2-754bdb5aa4b5",
                                        "entry_id": "e18dc364-5065-34be-85e7-3a5b85a56cd8",
                                        "glosses": [
                                            "etwas nicht visuell abbildend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04e144e-9c3c-4f1a-8275-1a9b4fa5492d",
                                                "sense_id": "43451a65-b6fa-30c7-a5d2-754bdb5aa4b5",
                                                "text": "„Neu ist der Inhalt und die Sitte Grabstelen zu bebildern, denn die älteren Grabstelen einheimischer Tradition waren anikonisch.“"
                                            },
                                            {
                                                "example_id": "4f231f07-f1b3-4554-9445-a62ce9040d9f",
                                                "sense_id": "43451a65-b6fa-30c7-a5d2-754bdb5aa4b5",
                                                "text": "„In ihrer frühesten Phase war buddhistische Kunst anikonisch, kannte also keine Darstellungen des Buddha in menschlicher Gestalt.“"
                                            },
                                            {
                                                "example_id": "80783c00-a671-4430-9af1-4575f85b7646",
                                                "sense_id": "43451a65-b6fa-30c7-a5d2-754bdb5aa4b5",
                                                "text": "„Streng anikonisch sind das Judentum und der Islam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
