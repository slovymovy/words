                                    },
                                    {
                                        "sense_id": "330d68b3-9944-3b18-9e1b-57ae6e970cda",
                                        "entry_id": "539091a2-7fb0-392d-8646-81011a01eb30",
                                        "glosses": [
                                            "Action de désinvestir."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92ebe4c-7cbc-4eb1-974a-67f075c4d9ca",
                                                "sense_id": "330d68b3-9944-3b18-9e1b-57ae6e970cda",
                                                "text": "Le désinvestissement est souvent assimilé à une opération effectuée en réponse à la fragilité financière de l’entreprise."
                                            },
                                            {
                                                "example_id": "77740825-b627-4426-a351-272ba1559ac8",
                                                "sense_id": "330d68b3-9944-3b18-9e1b-57ae6e970cda",
                                                "text": "Pour TikTok, la demande de désinvestissement est «tout simplement impossible», et plus encore dans le temps imparti."
                                            },
                                            {
                                                "example_id": "15246753-7eed-4f5b-943a-7a54f6ace51e",
                                                "sense_id": "330d68b3-9944-3b18-9e1b-57ae6e970cda",
                                                "text": "Le désinvestissement des énergies fossiles dans le but de réduire le réchauffement climatique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e95b89-d8fc-3b20-bf86-54638f7f3fec",
                                        "entry_id": "539091a2-7fb0-392d-8646-81011a01eb30",
                                        "glosses": [
                                            "Privation d’un droit, d’une fonction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7afa124-068e-3def-8d84-59d8e0680ac6",
                                        "entry_id": "539091a2-7fb0-392d-8646-81011a01eb30",
                                        "glosses": [
                                            "Action de se désinvestir de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b98464bb-eddd-4946-b7b0-049fd3472911",
                                                "sense_id": "f7afa124-068e-3def-8d84-59d8e0680ac6",
                                                "text": "Cette asthénie des sens se doublait d’un désinvestissement professionnel croissant."
                                            },
                                            {
                                                "example_id": "38775936-8803-4ae4-83c1-783c6bce42af",
                                                "sense_id": "f7afa124-068e-3def-8d84-59d8e0680ac6",
                                                "text": "Le traumatisme parasite la concentration, l’attention et la mémorisation. Les efficacités représentationnelles sont inhibées. Le désinvestissement scolaire accompagne ces inhibitions majeures qui parasitent les mécanismes d’appropriation de la connaissance, de la structuration du langage ou de l’opérationnalisation de la mémoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
