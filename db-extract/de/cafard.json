                "senses": [
                    {
                        "sense_id": "feae9fb9-e3e9-313d-a9f5-a0802a092138",
                        "entry_id": "92f78da1-0024-301d-a6be-ce0b7a09fa6b",
                        "glosses": [
                            "bedrückte Stimmung/Verfassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c234793-a5d6-40bd-8336-29aace0db952",
                                "sense_id": "feae9fb9-e3e9-313d-a9f5-a0802a092138",
                                "text": "„Der Cafard, der plötzliche Weltschmerz, der Hader mit Gott, den jeder hier oben kannte und der ohne ersichtlichen Grund kam und ging, war geblieben.“"
                            },
                            {
                                "example_id": "4de2201b-6ca7-46d0-b8c5-d6f1f39e4183",
                                "sense_id": "feae9fb9-e3e9-313d-a9f5-a0802a092138",
                                "text": "„Doch wie auch die Sonne schien, an diesem Morgen beschlich mich die Sorte von Elend, die der Franzose Cafard nennt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c89a0f-3450-4ea1-a756-64098268ae5b",
                        "source_entry_id": "92f78da1-0024-301d-a6be-ce0b7a09fa6b",
                        "source_sense_id": "feae9fb9-e3e9-313d-a9f5-a0802a092138",
                        "source_sense_description": "bedrückte Stimmung/Verfassung",
                        "target_lang_word": "cafard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf2a5f1-e53e-3ff3-83c0-93761caa58b0",
                                        "entry_id": "2152b8ca-a2e8-3e2c-b356-51db4307ca4c",
                                        "glosses": [
                                            "Depression; melancholy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e7aa02-1d11-4817-b015-1eb3431a9457",
                                                "sense_id": "9cf2a5f1-e53e-3ff3-83c0-93761caa58b0",
                                                "text": "That's the worst trouble with the soldiers in the trenches — nothing to do. It gives them the cafards, the black butterflies, the blue devils, the jimjams, the hump."
                                            },
                                            {
                                                "example_id": "24529b32-75f9-4db5-b725-b0127065e522",
                                                "sense_id": "9cf2a5f1-e53e-3ff3-83c0-93761caa58b0",
                                                "text": "At such times when the cafard of the city seized her, I was at my wits' end to devise a means of rousing her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0ae25ce-78f2-4a64-b1cc-8a312daed513",
                        "source_entry_id": "92f78da1-0024-301d-a6be-ce0b7a09fa6b",
                        "source_sense_id": "feae9fb9-e3e9-313d-a9f5-a0802a092138",
                        "source_sense_description": "bedrückte Stimmung/Verfassung",
                        "target_lang_word": "cafard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cafard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "273153b4-a6d5-3149-8df1-c93f11c38203",
                                        "entry_id": "1482224c-0602-367e-8359-bfffa6533653",
                                        "glosses": [
                                            "Qui est faux dévot, hypocrite, bigot, mécréant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf31fe3-7776-4778-9a23-c83c748771e7",
                                                "sense_id": "273153b4-a6d5-3149-8df1-c93f11c38203",
                                                "text": "« Si mes camarades savent ceci, se dit Lucien, gare au deuxième duel ; les épithètes de cafard vont pleuvoir sur moi. Mais comment le sauraient-ils ? ils ne voient pas ce monde-ci ; tout au plus le colonel par ses espions ; et, ma foi, tant mieux : cafard vaut mieux que républicain. »"
                                            },
                                            {
                                                "example_id": "ba91c942-4741-4312-84de-c33243847a39",
                                                "sense_id": "273153b4-a6d5-3149-8df1-c93f11c38203",
                                                "text": "— Un grand artiste, aujourd’hui, c’est un prince qui n’est pas titré. C’est la gloire et la fortune, les deux plus grands avantages sociaux, après la vertu, ajouta-t-il d’un petit ton cafard."
                                            },
                                            {
                                                "example_id": "86552847-049f-4760-aa4c-0c6fbb0ec7e6",
                                                "sense_id": "273153b4-a6d5-3149-8df1-c93f11c38203",
                                                "text": "Elle s’excusa un instant sur son ignorance de toutes choses ; Montgenays parut prendre cette timidité pour une admirable modestie ou pour une méfiance dont il se plaignait d’une façon cafarde."
                                            },
                                            {
                                                "example_id": "de7f3188-1ac8-45a9-a9a6-205e471de9ca",
                                                "sense_id": "273153b4-a6d5-3149-8df1-c93f11c38203",
                                                "text": "Il avait dit cela sur le petit ton cafard que M. de la Ferté connaissait bien, et qui lui donnait chaque fois envie de s’emporter."
                                            },
                                            {
                                                "example_id": "8dce1f72-d687-4327-a523-51960f535269",
                                                "sense_id": "273153b4-a6d5-3149-8df1-c93f11c38203",
                                                "text": "Cet homme du XVIIᵉ siècle […], qui a publié en 1808 un livre où il proposait un plan audacieux de nouvelles relations sexuelles et où il jetait les bases du féminisme moderne, va s'apercevoir qu'il était encore loin d'imaginer le degré de dévergondage que certains milieux pouvaient atteindre, que ses propres nièces, sous des dehors cafards, forment une bande de partouzardes fieffées, qui se gaussent de sa naïveté."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cafard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                        "entry_id": "59510b80-f9aa-3528-8dd4-af433c1e97ce",
                                        "glosses": [
                                            "Hypocrite, faux dévot."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd662a51-c211-4408-bc10-787a1624d690",
                                                "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                                "text": "Apres auoir raconté le meurtre de Louys Duc d’Orleans commis par le Duc de Bourgongne, il ſe ruë ſur la perſonne de Iean Petit, lequel il qualifie grand Theologien, grãd Predicateur & Caphard, & le dit auec vne telle entreſuite de parolles, qu’il laisse à iuger aux lecteurs qu’en ſon Calepin, Theologiẽ, Predicateur & Caphard, ſont trois ſynonimes : & moy ie luy reſpõs qu’en mon Dictionnaire, Paſquier, meſdiſant, impertinent, glorieux & libertin, ſont de meſme ſignification : ſçauoit il pas que ce mot de caphard tres odieux, a eſté mis en vſage par les Huguenots pour denigrer l’honneur de la Preſtriſe ?"
                                            },
                                            {
                                                "example_id": "d1489fd9-1e5d-4277-ab32-420b74a684d2",
                                                "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                                "text": "Messieurs, ce ne sont point les raisonneurs qui font du mal, ce sont les cafards. La Philosophie peut aller son train sans risque, le Peuple ne l’entend pas ou la laisse dire, et lui rend tout le dédain qu’elle a pour lui."
                                            },
                                            {
                                                "example_id": "db476caf-bde7-4fae-a380-6d1b758cd741",
                                                "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                                "text": "Triste homme, oui, triste homme ! Il bousculait les pauvres, car il n’y avait pas que moi qu’il traitât mal. Tous ceux qui étaient abandonnés ou à prix réduit recevaient ses crachats, et les petits même recevaient des coups. Il est bête, —on parle de lui comme d’un type, entre pensions. On emploie son nom pour dire cuistre, bêta et un peu cafard."
                                            },
                                            {
                                                "example_id": "4c63d863-98db-422d-adb8-f092348f2cdb",
                                                "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                                "text": "Ce sont là plutôt les sales imaginations d’un cafard que les vues d’un docteur."
                                            },
                                            {
                                                "example_id": "4413ee29-6fbf-44b7-9470-2db9f8e432f5",
                                                "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                                "text": "— En voilà un cafard !… Parce que sa vieille paysanne de mère lui a fait avaler le bon Dieu tous les dimanches !…"
                                            },
                                            {
                                                "example_id": "6bca4478-f271-446e-adaa-d0cc487ce2eb",
                                                "sense_id": "94fda4e4-2d8e-37de-9fab-f47073686490",
                                                "text": "— Je songe à un marchand de tableaux qui me confiait un jour : « Vingt pour cent sur du Rembrandt, ça ne m’intéresse pas. » Je songe à un critique théâtral qui disait une fois : « Mme Sarah Bernhardt, en jouant Hamlet, l’a grandi. » Je songe à un vicaire de Saint-Louis d’Antin qui déclarait en chaire « C’est dans les tourments éternels que Renan expie les audaces sacrilèges de sa pensée. » Et il me semble soudain qu’il n’y a plus de négociants, plus de cabotins, plus de cafards. La terre est propre comme un chien baigné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1adf300e-c4fd-3629-af1f-7a84e431a9e4",
                                        "entry_id": "59510b80-f9aa-3528-8dd4-af433c1e97ce",
                                        "glosses": [
                                            "Personne qui dénonce hypocritement les autres pour se faire bien voir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bd82ed-ae92-4243-be9d-fd71dd8aa649",
                                                "sense_id": "1adf300e-c4fd-3629-af1f-7a84e431a9e4",
                                                "text": "Philomène guettait Maheu, pour que Zacharie n’entamât point la monnaie. Et il n’y avait que la Pierronne qui semblât assez calme, ce cafard de Pierron s’arrangeant toujours, on ne savait comment, de manière à avoir, sur le livret du porion, plus d’heures que les camarades."
                                            },
                                            {
                                                "example_id": "3ab75150-7b55-4bf2-9ab2-713fcf28dd71",
                                                "sense_id": "1adf300e-c4fd-3629-af1f-7a84e431a9e4",
                                                "text": "[…] ; j'ai entendu cet ex-moine, ce cafard, dénoncer une messe qu'on devoit célébrer le lendemain, pour le rétablissement des BOURBONS sur le trône. Heureusement, le gouverneur ne fit point cas de la délation du moine."
                                            },
                                            {
                                                "example_id": "91081072-86a4-428d-8da5-9fb401b35504",
                                                "sense_id": "1adf300e-c4fd-3629-af1f-7a84e431a9e4",
                                                "text": "Heureusement que la Police est mal faite , que tous les contrôleurs sont trompés , et que la plupart des Codes sont ignorés des jaloux et des cafards qui dénoncent les gens qui les gênent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cafard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cdecbd2e-51e0-3e2a-9a3e-5984b533b223",
                                        "entry_id": "96efc612-c02c-322c-8518-75acc909fbc9",
                                        "glosses": [
                                            "Blatte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "618a0584-aa04-4393-8a65-5cc4be30ee10",
                                                "sense_id": "cdecbd2e-51e0-3e2a-9a3e-5984b533b223",
                                                "text": "Pendant la nuit, entendant un bruit insolite, je découvris dans un caisson un cafard ailé d’environ cinq centimètres de long […] Je ne me doutais guère que je ne pourrais jamais tenir en échec ces blattes redoutables qui allaient […] causer de sérieux dégâts à mes livres et cartes de voyage."
                                            },
                                            {
                                                "example_id": "d5bc7bae-b8c5-487e-8a7a-c810d5869233",
                                                "sense_id": "cdecbd2e-51e0-3e2a-9a3e-5984b533b223",
                                                "text": "La surface marron de l’une des portes paraît parfois remuer, elle oscille légèrement… au début cela m’avait effrayée, mais on m’a expliqué que ce n’étaient que les mouvements des cafards qui recouvrent cette porte… des petites bêtes qui ne mordent pas et qui vont rester là… Personne ne s’en soucie et ils me donnent bientôt l’impression, comme à tout le monde, qu’ils font partie de la maison."
                                            },
                                            {
                                                "example_id": "349fbd3f-7e87-4134-b0c8-a6256da69aa0",
                                                "sense_id": "cdecbd2e-51e0-3e2a-9a3e-5984b533b223",
                                                "text": "Mais rien de tout cela n’est décisif, la vraie solution serait d’enseigner au cafard à être son propre prédateur, Pinchard y croit dur comme fer, il sélectionne l’agressivité, prépare la guerre civile, la blatte germanique contre le zyzzyva ou beattle yankee."
                                            },
                                            {
                                                "example_id": "87209c28-211d-47fa-bbfd-d0bf7580caeb",
                                                "sense_id": "cdecbd2e-51e0-3e2a-9a3e-5984b533b223",
                                                "text": "Les cafards peuvent transmettre des maladies et des bactéries à l’homme. Ils se cachent dans les endroits chauds et humides mais ne sont pas signe de saleté. Des produits chimiques, des pièges et des solutions naturelles permettent de les éliminer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cafard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                                        "entry_id": "e629a047-9c4f-36d0-be96-67c0ace46609",
                                        "glosses": [
                                            "Tristesse, accès de mélancolie, spleen."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f44bf6e8-739f-4101-98b3-d0555ed69827",
                                                "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                                                "text": "Peut-être me plaisais-je à baigner ainsi dans le doute et le cafard, traînant, esseulé, ma mélancolie sur le campus alourdi par la neige."
                                            },
                                            {
                                                "example_id": "4b2f640b-f945-4b01-8585-5513e2b46f9c",
                                                "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                                                "text": "Et, d’un trait, il expliqua toute son histoire, la rencontre de Tacherot, un jour de cafard et de mouise sinistre."
                                            },
                                            {
                                                "example_id": "162ed41d-bc2d-47ef-9877-92e305d6ab57",
                                                "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                                                "text": "Je savais quand ça le reprenait ce cafard des architectures, c’était surtout à la campagne […] Il lui revenait un coup de souvenirs."
                                            },
                                            {
                                                "example_id": "cabbf3ac-6c44-4c32-b874-3167498b5fe1",
                                                "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                                                "text": "Toujours ce sale petit brouillardToujours ce sale petit cafardQui vous transperce jusqu’aux osEt qui se colle à votre peau."
                                            },
                                            {
                                                "example_id": "9b15df15-01c7-4679-8421-aab8dd2e2675",
                                                "sense_id": "da914cf1-2b48-3386-b046-975e6482316a",
                                                "text": "Toujours avec une bande de « camarades sociétaires » à la chasse au cafard du dimanche soir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
