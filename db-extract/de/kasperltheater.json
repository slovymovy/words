                "senses": [
                    {
                        "sense_id": "9d36e075-8645-376c-9769-a7eaebb577e3",
                        "entry_id": "9fb164b5-ada9-3afe-bf4f-16cc673bf6e4",
                        "glosses": [
                            "Theater, das Puppenspiele mit Kasperl als Hauptfigur aufführt"
                        ],
                        "tags": [
                            "bayrisch-österreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8ebae9-8500-4b58-bf0a-6d92faff5f6b",
                                "sense_id": "9d36e075-8645-376c-9769-a7eaebb577e3",
                                "text": "„Das gute, alte Kasperltheater mit seiner simplen Aufteilung in Gut und Böse ist nicht nur für die Kleinsten ein lehrreicher Riesenspaß.“"
                            },
                            {
                                "example_id": "872d9743-ec18-456e-8a64-734c7c8cdc06",
                                "sense_id": "9d36e075-8645-376c-9769-a7eaebb577e3",
                                "text": "„Zur Wahrnehmung der behördlichen Aufgaben gemäß § 2 Abs. 1 und 2 des Gesetzes ist die Landesregierung zuständig in folgenden Fällen: […] h) Veranstaltungen ambulanter Schausteller wie Schaubuden (einschließlich Panoramen, Tierschauen u. dgl.), Attraktionsschauen (einschließlich Kasperltheater nach Schaustellerart)/ Karusselle (einschließlich Riesenräder u. dgl.), …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "50f674e9-1f6e-35de-92cf-fae21e43ca0c",
                        "entry_id": "9fb164b5-ada9-3afe-bf4f-16cc673bf6e4",
                        "glosses": [
                            "ein albernes Verhalten, ein alberner Vorgang"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "fd583e15-a505-45ea-8ed6-e4b639ffc5b7",
                                "sense_id": "50f674e9-1f6e-35de-92cf-fae21e43ca0c",
                                "text": "„Der Richter nannte Orlichs Auftritt ein Kasperltheater.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
