                    {
                        "form_id": "f64c630f-ee62-468f-b341-0ce3b0e7a4d2",
                        "entry_id": "c1e7399e-5501-3c04-b764-5d51013ee727",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "leugenaartjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "babbf20b-d822-3b88-938c-e6ee33e548c5",
                        "entry_id": "c1e7399e-5501-3c04-b764-5d51013ee727",
                        "glosses": [
                            "iemand die bewust dingen zegt die niet waar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d07c04ad-7d40-423f-b960-17013c6e06ee",
                                "sense_id": "babbf20b-d822-3b88-938c-e6ee33e548c5",
                                "text": "De grootste leugenaar van deze eeuw is voorlopig nog altijd George W. Bush met zijn leugens over de zogenaamde massavernietigingswapens in Irak"
                            },
                            {
                                "example_id": "9ff163c7-2be9-416a-9d20-d75db690f843",
                                "sense_id": "babbf20b-d822-3b88-938c-e6ee33e548c5",
                                "text": "De Franse president Emmanuel Macron haalde ook nog eens uit naar fanatieke Brexiteers: “De keuze van het Britse volk is beïnvloed door degenen die makkelijke oplossingen beloofden. Dat zijn leugenaars. Ze vertrokken de dag erna, zodat ze de gevolgen niet hoefden te dragen.” Daar kunnen Boris Johnson en voormalig UKIP-leider Nigel Farage het mee doen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8ce8ff1-a04b-4a4d-bc09-5860f658130e",
                        "source_entry_id": "c1e7399e-5501-3c04-b764-5d51013ee727",
                        "source_sense_id": "babbf20b-d822-3b88-938c-e6ee33e548c5",
                        "source_sense_description": "iemand die bewust dingen zegt die niet waar zijn",
                        "target_lang_word": "Lügner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lügner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                        "entry_id": "2493ba71-230a-3a29-a8a0-bd14f2466641",
                                        "glosses": [
                                            "jemand, der lügt, der die Unwahrheit spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eb1e7b-023e-481b-8e1b-d6c2e77b645a",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "Du bist mir schon so ein Lügner vor dem Herrn, kannst du nicht einfach mal so aus Spaß die Wahrheit sagen?"
                                            },
                                            {
                                                "example_id": "acfe68fc-966c-4803-8c05-ca256a24e14c",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "Diesem Lügner würde ich nicht trauen."
                                            },
                                            {
                                                "example_id": "554e59f8-f6a3-4929-ac0d-b9ba8038c8f6",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "Ihre Aussagen widersprechen sich. Wer ist hier jetzt der Lügner?"
                                            },
                                            {
                                                "example_id": "b271c868-47b8-4d53-89f0-f8f2bf46dff0",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "„Das Volk hielt ihn für einen Lügner.“"
                                            },
                                            {
                                                "example_id": "8e6e0922-ac8d-4571-a32f-d9a34fd2e1e8",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "„Ich sagte zu Uwe, daß er ein Lügner sei.“"
                                            },
                                            {
                                                "example_id": "a4c767c5-a27d-4085-abb9-cd3dd5aea3c9",
                                                "sense_id": "d207c74c-9496-32a2-b7dc-726280b67664",
                                                "text": "„Die Hyäne hatte gelogen und wußte das; sie wußte auch, daß ich in der Klemme saß, da ich ihn nicht als Lügner bezeichnen konnte, ohne sein Gebrüll hervorzurufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df70f5d1-a167-4d7d-a322-902ee0a23c80",
                        "source_entry_id": "c1e7399e-5501-3c04-b764-5d51013ee727",
                        "source_sense_id": "babbf20b-d822-3b88-938c-e6ee33e548c5",
                        "source_sense_description": "iemand die bewust dingen zegt die niet waar zijn",
                        "target_lang_word": "liar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A person who frequently lies; someone who tells a lie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26315097-df91-4787-b96e-b10142725470",
                                                "sense_id": "48ddd1cf-0bb5-3559-baeb-049aefa083b7",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough![…]What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything?[…]’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                        "entry_id": "0beb25d9-8f5a-3d24-8e96-c043c68a5b3f",
                                        "glosses": [
                                            "A swabber responsible for cleaning the outside parts of the ship rather than the cabins, a role traditionally assigned to a person caught telling a lie the previous week."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74b14fb9-d5f1-4632-8d73-329ae21dfc9a",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The Swabber is to keep the Cabbins, and all the Rooms of the Ship clean within board, and the Liar to do the like without board. The Liar holds his Place but for a week; and he that is first taken with a Lie upon a Monday morning, […] for that week he is under the Swabber, and meddles not with making clean the Ship within board, but without."
                                            },
                                            {
                                                "example_id": "b14ac5f7-2b53-4beb-9e5e-b685328fa22c",
                                                "sense_id": "a4877bce-a2bd-3c4d-b23f-2d125d063da4",
                                                "text": "The swabber, perhaps the lowliest position on the ship, was responsible for cleaning the decks. By tradition, each Monday a new crewmember was appointed the liar—the first person caught telling a lie the previous week."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceea7037-ef41-41a2-af8a-be13fcc9f232",
                        "source_entry_id": "c1e7399e-5501-3c04-b764-5d51013ee727",
                        "source_sense_id": "babbf20b-d822-3b88-938c-e6ee33e548c5",
                        "source_sense_description": "iemand die bewust dingen zegt die niet waar zijn",
                        "target_lang_word": "menteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                        "entry_id": "dd03b8ee-2a88-33f1-bb17-e0f67c0e5182",
                                        "glosses": [
                                            "Qui ment, qui a l’habitude de mentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147133c2-2e5f-41c2-9044-b471b44f8e34",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Une femme menteuse."
                                            },
                                            {
                                                "example_id": "5051e98c-1daf-4bd6-a153-e8de00c3b701",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Langage menteur."
                                            },
                                            {
                                                "example_id": "6a0b5ca3-25f7-46a0-a9cc-ae5af676737f",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Physionomie menteuse."
                                            },
                                            {
                                                "example_id": "254936fa-9c23-43c1-8f22-57e299909090",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Menteur comme un arracheur de dents."
                                            },
                                            {
                                                "example_id": "c4ee3136-162e-4ee1-b231-2ee3efa9030e",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Robespierre enfin fit rédiger par Saint-Just l’acte d’accusation le plus menteur, le plus violent, le plus haineux, le plus infâme, par lequel on reprochait à Danton et à ses compagnons d’être royalistes."
                                            },
                                            {
                                                "example_id": "5604a864-de5b-4b45-abc1-23dd428bf41b",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Il ne savait donc rien, cet homme ! Toute sa science était donc menteuse, puisqu’il ne pouvait d’un coup d’œil distinguer la vie de la mort !"
                                            },
                                            {
                                                "example_id": "f812fe57-9b90-4290-9924-761d53cad776",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Un fiancé se dupe aisément ; mais un mari ! N’importe qui sait proférer des paroles menteuses ; les mensonges du corps exigent une autre science. Mimer le désir, la joie, la fatigue bienheureuse, cela n’est pas donné à tous."
                                            },
                                            {
                                                "example_id": "3fccbefe-d19d-4537-b184-aec94d4816cd",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Quoi de plus simple que de mimer la loyauté, elle n’est jamais plus vraie que dans les bouches menteuses."
                                            },
                                            {
                                                "example_id": "eeb08a8e-c4f8-4278-8c7e-b986be6a42be",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Frapper quelqu'un qui vous a traité de menteur ne prouve pas que vous avez dit la vérité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                        "entry_id": "09760989-2ab7-3efd-a33c-3764f8cb5c76",
                                        "glosses": [
                                            "Personne qui ment, qui a l’habitude de mentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a267181-f480-40e8-be9e-d4c280d79cf0",
                                                "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                                "text": "De l’autre côté, quelques-uns parmi nous discutaient s’il fallait ajouter foi aux affirmations du criminel qui s’était montré menteur incorrigible."
                                            },
                                            {
                                                "example_id": "d8df8b8b-e2ed-4c6e-a8bd-8a1ecf042b83",
                                                "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                                "text": "Sommeil impossible pour quatre, car Laurent ronfle. Nous vérifions enfin sur lui l’affirmation classique des ronfleurs qui ne ronflent prétendent-ils, que couchés sur le dos. Les ronfleurs sont des menteurs : Laurent ronfle quand nous le tournons sur le côté droit, et sur le côté gauche, et sur le ventre."
                                            },
                                            {
                                                "example_id": "7723c31c-bfc4-488a-a327-b71a45228414",
                                                "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                                "text": "« Ne faites pas attention, il est extrêmement blagueur », dit-il à mi-voix à Saint-Loup qui n’en fut que plus intéressé, étant très curieux de la psychologie des menteurs. — Plus menteur encore que l’Ithaquesien Odysseus qu’Athènes appelait pourtant le plus menteur des hommes, compléta notre camarade Bloch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdfa8939-0744-3b01-b8a9-47b13a314dce",
                                        "entry_id": "09760989-2ab7-3efd-a33c-3764f8cb5c76",
                                        "glosses": [
                                            "Jeux de cartes se jouant à cartes face cachée (sauf la première). À tout moment, on peut accuser un des joueurs de mentir après qu’il a posé sa carte, d’où le nom du jeu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
