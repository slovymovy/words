                                        "sense_id": "1e384e0d-4ed1-36f2-8790-f3e6e58658c0",
                                        "entry_id": "e97d746d-cb18-3a47-b29e-4122df17c95e",
                                        "glosses": [
                                            "een gebied waarin geen voertuigen zijn toegestaan en waar dus gelopen moet worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3e1fdc-58b7-4e56-8767-4ff4a04161c0",
                                                "sense_id": "1e384e0d-4ed1-36f2-8790-f3e6e58658c0",
                                                "text": "Veel binnensteden zijn autovrij gemaakt en voetgangersgebieden geworden."
