                        "entry_id": "f06722f1-572f-3eb3-85fb-9b84b742b813",
                        "glosses": [
                            "Roux, en parlant d’une personne."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "937e48b4-f4d5-467e-a6c5-e5ce488de1ec",
                                "sense_id": "270bf096-549c-325f-b884-14ab28c21685",
                                "text": "Petiot, maigriot, roussot, le cheveu rare, l’œil chassieux; non, décidément, M. Lecoq-Hue n’était pas très bien!"
                            },
                            {
                                "example_id": "43af6b81-64da-46cc-b10b-c43244f2ea09",
                                "sense_id": "270bf096-549c-325f-b884-14ab28c21685",
                                "text": "Une fille parut, roussotte, louchon, sans front, et dont la robuste laideur, trempée de jeunesse et de force, reluisait."
                            },
                            {
                                "example_id": "e7096ff4-688f-4f32-8270-0d9b561981fb",
                                "sense_id": "270bf096-549c-325f-b884-14ab28c21685",
                                "text": "Pas d’autre parfum que la fragrance un peu roussotte des cheveux."
                            }
                        ]
                    }
                ],
