{
    "word_family": [
        "frustrate",
        "frustration",
        "frustrating",
        "frustratingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4b72c6a-912a-351e-bf31-16e10ff3e27d",
                    "sense_definition": "Feeling annoyed, disappointed, or restless because you cannot achieve what you want or because things are not going as planned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She easily gets <w>frustrated</w> when it comes to financial matters and complex paperwork.",
                            "target_lang_translations": {
                                "ru": "Она легко <w>расстраивается</w>, когда дело касается финансовых вопросов и сложной бумажной работы.",
                                "zh": "一碰到财务问题和繁琐的文件，她就很容易感到<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "The <w>frustrated</w> customer decided to leave the store after waiting in line for twenty minutes.",
                            "target_lang_translations": {
                                "ru": "<w>Раздраженный</w> клиент решил покинуть магазин, простояв в очереди двадцать минут.",
                                "zh": "排了二十分钟队后，那位<w>懊恼的</w>顾客决定离开商店。"
                            }
                        },
                        {
                            "text": "He felt deeply <w>frustrated</w> by the lack of progress on the new project.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя глубоко <w>разочарованным</w> из-за отсутствия прогресса в новом проекте.",
                                "zh": "新项目毫无进展，让他深感<w>沮丧</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyed",
                        "exasperated",
                        "discouraged",
                        "discontented"
                    ],
                    "antonyms": [
                        "satisfied",
                        "content",
                        "fulfilled"
                    ],
                    "common_phrases": [
                        "feel frustrated",
                        "get frustrated",
                        "deeply frustrated",
                        "frustrated attempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство раздражения, разочарования или беспокойства из-за невозможности достичь желаемого или из-за того, что дела идут не по плану.",
                        "zh": "因无法实现愿望或事情未按计划进行而感到沮丧、懊恼或烦躁的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстроенный",
                                "target_lang_sense_clarification": "из-за неудач или препятствий"
                            },
                            {
                                "target_lang_word": "раздраженный",
                                "target_lang_sense_clarification": "из-за невозможности что-то сделать"
                            },
                            {
                                "target_lang_word": "разочарованный",
                                "target_lang_sense_clarification": "в своих ожиданиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沮丧的",
                                "target_lang_sense_clarification": "因受挫或事与愿违而灰心失意"
                            },
                            {
                                "target_lang_word": "懊恼的",
                                "target_lang_sense_clarification": "因事情不顺而烦躁恼火"
                            },
                            {
                                "target_lang_word": "失落的",
                                "target_lang_sense_clarification": "因期望落空而感到难受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30242823-905a-304b-ac52-a06addca1e28",
                    "sense_definition": "Prevented from progressing, succeeding, or being fulfilled; blocked or foiled.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their <w>frustrated</w> ambitions led them to seek opportunities in a different industry.",
                            "target_lang_translations": {
                                "ru": "Их <w>нереализованные</w> амбиции заставили их искать возможности в другой отрасли.",
                                "zh": "<w>受挫的</w>抱负促使他们去其他行业寻找机会。"
                            }
                        },
                        {
                            "text": "The police reported a <w>frustrated</w> escape attempt by the inmates during the night.",
                            "target_lang_translations": {
                                "ru": "Полиция сообщила о <w>сорванной</w> попытке побега заключенных в ночное время.",
                                "zh": "警方通报了夜间囚犯一起<w>未遂的</w>越狱企图。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thwarted",
                        "foiled",
                        "blocked",
                        "stymied"
                    ],
                    "antonyms": [
                        "successful",
                        "realized"
                    ],
                    "common_phrases": [
                        "frustrated ambition",
                        "frustrated efforts",
                        "frustrated plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, которому помешали развиваться, преуспеть или реализоваться; заблокированный или сорванный.",
                        "zh": "（愿望、计划等）受阻的、受挫的或未能实现的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несостоявшийся",
                                "target_lang_sense_clarification": "о планах или амбициях"
                            },
                            {
                                "target_lang_word": "тщетный",
                                "target_lang_sense_clarification": "о попытках или усилиях"
                            },
                            {
                                "target_lang_word": "сорванный",
                                "target_lang_sense_clarification": "о планах или побеге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受挫的",
                                "target_lang_sense_clarification": "指抱负、努力等遭到阻碍"
                            },
                            {
                                "target_lang_word": "未遂的",
                                "target_lang_sense_clarification": "指企图或企图逃跑等被阻挠"
                            },
                            {
                                "target_lang_word": "落空的",
                                "target_lang_sense_clarification": "指希望或计划未能实现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb78ad89-ff43-3c28-9b87-fb5b68d2b4df",
                    "sense_definition": "Describing a crime where all necessary acts were performed but the intended result was not achieved.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>frustrated</w> homicide leaves the victim injured or wounded rather than killed.",
                            "target_lang_translations": {
                                "ru": "При <w>незавершенном</w> убийстве жертва остается раненой или травмированной, а не убитой.",
                                "zh": "<w>未遂的</w>杀人行为会致使受害人受伤而非死亡。"
                            }
                        },
                        {
                            "text": "The court classified the incident as a <w>frustrated</w> robbery because the money was never taken.",
                            "target_lang_translations": {
                                "ru": "Суд классифицировал инцидент как <w>неудавшееся</w> ограбление, так как деньги не были похищены.",
                                "zh": "法庭将这起事件定性为抢劫<w>未遂</w>，因为钱款并未被拿走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unconsummated",
                        "failed"
                    ],
                    "antonyms": [
                        "consummated"
                    ],
                    "common_phrases": [
                        "frustrated homicide",
                        "frustrated murder",
                        "frustrated crime"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический термин, описывающий преступление, при котором были совершены все необходимые действия, но намеченный результат не был достигнут.",
                        "zh": "（法律用语）犯罪行为已实施完毕但未达成预期结果的；未遂的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незавершенный",
                                "target_lang_sense_clarification": "о составе преступления"
                            },
                            {
                                "target_lang_word": "неудавшийся",
                                "target_lang_sense_clarification": "о попытке преступления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未遂的",
                                "target_lang_sense_clarification": "指犯罪已着手实施但未达目的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a986d2e8-d8e5-3b3d-8613-ba2971abeb66",
                    "sense_definition": "Simple past and past participle of <w>frustrate</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant delays <w>frustrated</w> the passengers who were trying to get home for the holidays.",
                            "target_lang_translations": {
                                "ru": "Постоянные задержки <w>расстроили</w> пассажиров, которые пытались добраться домой на праздники.",
                                "zh": "接连不断的延误让急于回家过节的乘客们感到十分<w>沮丧</w>。"
                            }
                        },
                        {
                            "text": "The heavy rain <w>frustrated</w> our plans for a weekend hike in the mountains.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>сорвал</w> наши планы на поход в горы на выходных.",
                                "zh": "大雨<w>打乱</w>了我们周末去山里徒步的计划。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «frustrate» (расстраивать, срывать планы).",
                        "zh": "动词 frustrate 的过去式和过去分词形式（使沮丧，阻碍，挫败）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстроил",
                                "target_lang_sense_clarification": "кого-либо"
                            },
                            {
                                "target_lang_word": "сорвал",
                                "target_lang_sense_clarification": "планы или намерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使沮丧",
                                "target_lang_sense_clarification": "让人感到失落或气馁"
                            },
                            {
                                "target_lang_word": "挫败",
                                "target_lang_sense_clarification": "使计划或企图落空"
                            },
                            {
                                "target_lang_word": "打乱",
                                "target_lang_sense_clarification": "使原有安排受到阻碍"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}