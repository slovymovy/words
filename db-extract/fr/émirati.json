                "senses": [
                    {
                        "sense_id": "39db95db-0095-3dac-83fd-cf7a87a30db4",
                        "entry_id": "0eea4a2b-ede1-30c3-88a1-da5983726241",
                        "glosses": [
                            "sich auf die Vereinigten Arabischen Emirate oder einen ihrer Emirate beziehend; emiratisch"
                        ],
                        "tags": [],
