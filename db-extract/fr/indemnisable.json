                "senses": [
                    {
                        "sense_id": "9f373c02-9591-3ef4-92c1-4b9fee9b6aec",
                        "entry_id": "9595dc45-a97a-351e-9257-cab3564729d6",
                        "glosses": [
                            "Qui peut être indemnisé, qui a droit à une indemnité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9337f9f8-1e0f-4f02-84ff-c45436804cb5",
                                "sense_id": "9f373c02-9591-3ef4-92c1-4b9fee9b6aec",
                                "text": "Il y a là une nature de propriété non indemnisable : comment donc l’indemniserez-vous ?"
                            },
                            {
                                "example_id": "489133b8-f958-420b-b37d-1ea76dd41e11",
                                "sense_id": "9f373c02-9591-3ef4-92c1-4b9fee9b6aec",
                                "text": "Dans un arrêt rendu le 8 janvier 2020, la Haute Cour estime qu’un licenciement abusif cause toujours un préjudice indemnisable."
                            },
                            {
                                "example_id": "22d8ec05-02b1-4562-bf58-76c93dab92d1",
                                "sense_id": "9f373c02-9591-3ef4-92c1-4b9fee9b6aec",
                                "text": "Par exemple, la perte des aliments d’un congélateur n’est pas indemnisable si une coupure de courant est en cause, alors qu’elle l’est si l’appareil a été submergé par l’inondation."
                            }
                        ]
                    }
                ],
