                "senses": [
                    {
                        "sense_id": "406ba563-4dcf-3f36-99f3-a2510bb4cd94",
                        "entry_id": "ecfd94fd-8f08-31a9-9ac8-19e066df51b6",
                        "glosses": [
                            "aus Chrom bestehender/verchromter Tisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d658590-b13a-4759-ab96-823331174819",
                                "sense_id": "406ba563-4dcf-3f36-99f3-a2510bb4cd94",
                                "text": "„Ich beuge mich über den Chromtisch und male den nächsten heißen dunkelblauen Streifen zwischen ihre Beine.“"
                            },
                            {
                                "example_id": "fdf7907a-79aa-4410-b003-f169abc75ddb",
                                "sense_id": "406ba563-4dcf-3f36-99f3-a2510bb4cd94",
                                "text": "„Trotz der hellen, bunten Farbgebung herrschte eine morbide Atmosphäre. Keine Musik, nur das leise Flüstern der Klimaanlage und die gedämpften Stimmen von fünf, sechs Leuten, die um große, niedrige Chromtische saßen, auf Sofas und Sesseln aus bunt gefärbtem Straußenleder - blau, grün, rot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
