                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fd76870-28df-48f2-a43e-9d8ddddc1509",
                        "source_entry_id": "88630e45-40ad-3231-ae1d-0dbf864141ee",
                        "source_sense_id": "4a6cee58-cd6d-3d33-8290-f85643397dd5",
                        "target_lang_word": "furniture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furniture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "Large movable item(s), usually in a room, which enhance(s) the room's characteristics, functionally or decoratively."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dcf4210-4884-4bcd-b496-f520cb56d45e",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "The woman does not even have one stick of furniture moved in yet."
                                            },
                                            {
                                                "example_id": "dcbea044-9039-408b-921c-f3f45bbcbac6",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "How much furniture did they leave behind?"
                                            },
                                            {
                                                "example_id": "9f6676c0-375c-400c-8e17-575cf6121978",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "A chair is furniture. Sofas are also furniture."
                                            },
                                            {
                                                "example_id": "8f4dd14c-24cd-47d8-a865-8d9dba8706bc",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "They bought a couple of pieces of furniture."
                                            },
                                            {
                                                "example_id": "29e54873-ddba-4ab3-99e5-e1be26763870",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "Your furniture is beautiful."
                                            },
                                            {
                                                "example_id": "ef8bfdf7-3bce-49ce-a57d-f774fdae81ac",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "Three chairs of the steamer type, all maimed, comprised the furniture of this roof-garden, with (by way of local color) on one of the copings a row of four red clay flower-pots filled with sun-baked dust […]"
                                            },
                                            {
                                                "example_id": "483d7d33-366b-4feb-ac47-29d01fd30f3b",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "She mixed furniture with the same fatal profligacy as she mixed drinks, and this outrageous contact between things which were intended by Nature to be kept poles apart gave her an inexpressible thrill."
                                            },
                                            {
                                                "example_id": "c1f6e3ca-1451-4ff5-ba95-d6f7057a22d8",
                                                "sense_id": "7d0ae67d-19d4-3dac-a870-01f828a69206",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fb3854f-01e6-3440-beb4-7d0aa5c3daa9",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "The harness, trappings etc. of a horse, hawk, or other animal."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12c16a66-3458-47ef-8c36-c97eb9241184",
                                                "sense_id": "4fb3854f-01e6-3440-beb4-7d0aa5c3daa9",
                                                "text": "We commend a horse because he is strong and nimble,[…]and not for his furniture: a greyhound for his swiftnesse, not for his collar: a hawke for her wing, not for her cranes or bells."
                                            },
                                            {
                                                "example_id": "80fd8786-93b7-4c4e-b35b-b32660bf1127",
                                                "sense_id": "4fb3854f-01e6-3440-beb4-7d0aa5c3daa9",
                                                "text": "Amongst the rich this part of a hawk's furniture is ornamented with embroidery, handsome silver aigrettes, tassels and other decorations."
                                            },
                                            {
                                                "example_id": "f501ba31-662e-4234-a97b-0064f1da3eff",
                                                "sense_id": "4fb3854f-01e6-3440-beb4-7d0aa5c3daa9",
                                                "text": "Horse furniture included a white sheepskin with red ‘wolf's teeth’; blue shabraque with yellow edging and royal cypher; blue valise with yellow edging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3448277f-ae2a-3626-9c07-b399714213c7",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "Fittings, such as handles, of a door, coffin, or other wooden item."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a73272ca-7d67-4518-a268-981455e5e19b",
                                                "sense_id": "3448277f-ae2a-3626-9c07-b399714213c7",
                                                "text": "[…]a new universal pistol, one to be carried by each man, with a 9-inch barrel of musket-bore and an iron ramrod carried in the holster; the furniture was reduced to just a brass trigger guard (no butt-plate), and some were fitted with Nock's lock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba73b828-9562-357f-b101-1a1fd8809be0",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "An accompanying enhancing feature, or features collectively; embellishment, decoration, trimming."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe5415e-1f70-44af-97f6-89a904698b58",
                                                "sense_id": "ba73b828-9562-357f-b101-1a1fd8809be0",
                                                "text": "A Scythian Shepherd, so imbelliſhed\nWith Natures pride, and richeſt furniture?\nHis looks do menace heauen & dare the Gods,\nHis fiery eies are fixt vpon the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a986f85-b6e0-3c1c-a746-c75fbb67b8d8",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "The stock and forearm of a weapon."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "925ceb47-1e69-36f2-8233-48b48c8b4077",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "The pieces of wood or metal put around pages of type to make proper margins and fill the spaces between the pages and the chase."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85f7dd91-438d-3cce-8fe1-86fc51bbe8de",
                                        "entry_id": "6d40a72d-e5f1-3e5b-843b-40e67ebf634a",
                                        "glosses": [
                                            "The stumps."
                                        ],
                                        "tags": [
