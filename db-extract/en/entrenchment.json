                                        "sense_id": "66c2597d-8d69-3bff-b128-aafb5c0130d6",
                                        "entry_id": "e0d9bef9-0a5d-32f3-9535-0ccfb566c6f5",
                                        "glosses": [
                                            "zum Schutz gedachte, hochgezogene Bordwand eines Schiffes (Kriegsschiffes)"
                                        ],
                                        "tags": [],
