                                    {
                                        "sense_id": "1cdde2c8-36c4-3fd4-93fd-0bef0ea936ae",
                                        "entry_id": "db017c6d-e0e4-38ed-ab62-fff9919e1436",
                                        "glosses": [
                                            "Grand mouflon d’Asie, vivant en Asie centrale, en Chine et en Mongolie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e87df8-7fee-449a-821c-0514ad13ddf3",
                                                "sense_id": "1cdde2c8-36c4-3fd4-93fd-0bef0ea936ae",
                                                "text": "L’argali, la zibeline, la taupe dorée de Sibérie, le musc delà Chine, ne se trouvent point à la baie de Hudson ni dans aucune autre partie du nord-ouest du nouveau continent."
                                            },
                                            {
                                                "example_id": "b833bed0-5f95-4f68-8d7a-b3e6b9de3c20",
                                                "sense_id": "1cdde2c8-36c4-3fd4-93fd-0bef0ea936ae",
                                                "text": "Désirant préparer taxidermiquement un des argalis, nous avions emmené avec nous des pâtres qui se chargèrent de transporter ce bel échantillon de la faune du Khorassan."
                                            }
                                        ]
                                    }
                                ]
                            }
