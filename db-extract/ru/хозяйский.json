                            },
                            {
                                "example_id": "1d73f12b-137c-4625-b83a-ab9e886ac6ef",
                                "sense_id": "b5a83417-f4fb-3e73-9166-42391bf3133b",
                                "text": "прояви́ть хозя́йскую забо́ту (о)",
                                "translation": "take a proprietary interest (in)",
                                "english": "take a proprietary interest (in)"
                            },
                            {
                                "example_id": "63cdfa71-8643-45ef-bf69-0202909329a4",
                                "sense_id": "b5a83417-f4fb-3e73-9166-42391bf3133b",
                                "text": "де́ло хозя́йское",
                                "translation": "it is for you to decide; it is up to you; you are your own master",
                                "english": "it is for you to decide; it is up to you; you are your own master"
                            }
                        ]
