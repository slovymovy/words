                                    {
                                        "sense_id": "17323300-8337-38a6-96e9-a04b1d0a3715",
                                        "entry_id": "338d3ef1-a427-33d2-a6cd-9107830f1c55",
                                        "glosses": [
                                            "die Erwartungen oder Bedürfnisse von jemandem oder etwas erfüllen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee5f0c11-6545-477d-8011-2a599fc1f8cb",
                                                "sense_id": "17323300-8337-38a6-96e9-a04b1d0a3715",
                                                "text": "Der Mensch versucht zuerst die Bedürfnisse der niedrigsten Stufe der Maslowschen Bedürfnispyramide zu befriedigen, bevor die nächste Stufe zum neuen und stärkeren Bedürfnis wird. Ein starkes Bedürfnis erhöht die Motivation es zu befriedigen."
                                            },
                                            {
                                                "example_id": "18581106-019f-4438-9c29-9d4ba61c7607",
                                                "sense_id": "17323300-8337-38a6-96e9-a04b1d0a3715",
                                                "text": "Unsere Sehnsucht wird immer größer, je weniger wir sie befriedigen können."
                                            },
                                            {
                                                "example_id": "00c6dc35-8d17-4cb6-86d0-12759ed1e2e3",
                                                "sense_id": "17323300-8337-38a6-96e9-a04b1d0a3715",
                                                "text": "„Unterschiedliche Zweige des Handwerks wurden perfektioniert, um die Nachfrage an Luxusprodukten für die Oberschicht zu befriedigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "160c6287-7207-3893-adba-c65ad36eef12",
                                        "entry_id": "338d3ef1-a427-33d2-a6cd-9107830f1c55",
                                        "glosses": [
                                            "jemanden sexuell befriedigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae64c91b-2846-49b7-abc2-21bdb46acd20",
                                                "sense_id": "160c6287-7207-3893-adba-c65ad36eef12",
                                                "text": "Ich glaube, er konnte seine Freundin nicht befriedigen, deshalb hat sie auch Schluss gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "054b913f-3dac-3f49-bccc-71ad381f16c5",
                                        "entry_id": "338d3ef1-a427-33d2-a6cd-9107830f1c55",
                                        "glosses": [
                                            "onanieren, masturbieren"
                                        ],
