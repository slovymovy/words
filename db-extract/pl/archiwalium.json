                ],
                "senses": [
                    {
                        "sense_id": "f2ca34d1-76c5-3c06-9308-eed3119d0c91",
                        "entry_id": "7b4af0e3-f867-35c3-80c7-45f6a5a5d891",
                        "glosses": [
                            "archival document, archived document"
                        ],
                        "tags": [
                            "literary",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "330f3dbb-13a9-4f53-8163-ab74690bfa2a",
                                "sense_id": "f2ca34d1-76c5-3c06-9308-eed3119d0c91",
                                "text": "Gdy notes padł ofiarą złodziei, ujawnił się anarchistyczny rys jego natury i sam dokonał transakcji ze złodziejami, odkupując bezcenne archiwalium.",
                                "translation": "When the notebook fell victim to the thief, his anarchistic nature came out and he completed the transaction himself with the thieves, buying the priceless archived document back.",
                                "english": "When the notebook fell victim to the thief, his anarchistic nature came out and he completed the transaction himself with the thieves, buying the priceless archived document back."
                            },
                            {
                                "example_id": "d29fc800-7a94-4259-b178-c25f41fc52b2",
                                "sense_id": "f2ca34d1-76c5-3c06-9308-eed3119d0c91",
                                "text": "Ale przecież tak wiele pozostało, że można potraktować to archiwalium jako aktualną satyrę...",
                                "translation": "But so much has remained, that you can treat this archived document like a satire of current affairs...",
                                "english": "But so much has remained, that you can treat this archived document like a satire of current affairs..."
                            },
                            {
                                "example_id": "91f57073-d8bf-4adc-a937-3b0aef4e9683",
                                "sense_id": "f2ca34d1-76c5-3c06-9308-eed3119d0c91",
                                "text": "Chyba najcenniejszym archiwalium jest dziś tekst wystąpienia założyciela i pierwszego kierownika bolechowskiej Szkoły Lasowej, ck nadleśniczego Piotra Hirscha, wygłoszonego z okazji otwarcia tej placówki.",
                                "translation": "The most valuable archived document today is the founder's appearances and the first director of the Bolechowo62 Forest School, of the imperial-royal forest ranger Piotr Hirch, announced at the opening of this playground.",
                                "english": "The most valuable archived document today is the founder's appearances and the first director of the Bolechowo62 Forest School, of the imperial-royal forest ranger Piotr Hirch, announced at the opening of this playground."
                            }
                        ]
                    }
