                ],
                "senses": [
                    {
                        "sense_id": "51977353-8a01-3190-8d5e-e453352a7451",
                        "entry_id": "a91ee0c3-2e86-3038-ab00-01a744864f07",
                        "glosses": [
                            "Person, die viel Zeit und Aufwand in einen besonders ausgewählten Typ von Objekt (zum Beispiel Schuhe) legt; Person, die durch diese Objekte sexuell erregt wird"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "521fbd48-ca44-41b8-91fa-87ccd864c31b",
                                "sense_id": "51977353-8a01-3190-8d5e-e453352a7451",
                                "text": "„Ich bin kein Fetischist, was Motoren angeht. Die Technik und die Geräusche interessieren mich nicht. Ein seidenweicher Lauf reicht mir.“"
                            },
                            {
                                "example_id": "7569a862-60a0-4d73-8963-698db12356c8",
                                "sense_id": "51977353-8a01-3190-8d5e-e453352a7451",
                                "text": "Du meinst also, es könnte so eine Art Fetischist sein? Jemand, der auf gebrauchte Unterwäsche steht?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "11a235b6-8aac-32bb-8514-769374c8de78",
                        "entry_id": "a91ee0c3-2e86-3038-ab00-01a744864f07",
                        "glosses": [
                            "Person, die an die Wirkung und Kraft eines Fetisch (Gegenstands mit magischen Eigenschaften) glaubt"
                        ],
                        "tags": [
                            "Völkerkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "9d391be0-a50e-418a-92ae-0a83353ad8ca",
                                "sense_id": "11a235b6-8aac-32bb-8514-769374c8de78",
                                "text": "„Die Quojas sind keine Fetischisten, sondern glauben an einen geistigen Gott […].“ (1790)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
