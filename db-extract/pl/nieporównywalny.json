                ],
                "translations": [
                    {
                        "translation_id": "558b2ef8-b161-4b2d-b120-99a7000fe68f",
                        "source_entry_id": "76690f4f-4ec0-3d69-ba2c-e82c70dc77b3",
                        "source_sense_id": "45345f9b-e7c2-3414-992d-613d58a7f417",
                        "target_lang_word": "incomparable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "384b2962-e9f7-348e-9cb2-011cbffb3fee",
                                        "entry_id": "87520ea0-710e-33cf-beb2-cde9c84f4e4a",
                                        "glosses": [
                                            "Not comparable."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a3b00a6-d8ea-3c7c-85a6-8e6724c03424",
                                        "entry_id": "87520ea0-710e-33cf-beb2-cde9c84f4e4a",
                                        "glosses": [
                                            "So much better than another as to be beyond comparison."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82ea953-130f-4662-ba9e-00482306a949",
                                                "sense_id": "2a3b00a6-d8ea-3c7c-85a6-8e6724c03424",
                                                "text": "I know of nothing in all drama more incomparable from the point of view of art, nothing more suggestive in its subtlety of observation, than Shakespeare's drawing of Rosencrantz and Guildenstern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a8ccf02-198e-3932-a5dc-d1fe07377447",
                                        "entry_id": "74abfcc5-2770-3477-8472-a5ac48a6be84",
                                        "glosses": [
                                            "Something beyond compare; a thing with which there is no comparison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0f40535-0eb4-415b-ae63-dc70c1825a08",
                        "source_entry_id": "76690f4f-4ec0-3d69-ba2c-e82c70dc77b3",
                        "source_sense_id": "45345f9b-e7c2-3414-992d-613d58a7f417",
                        "target_lang_word": "incomparable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incomparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                        "entry_id": "412c659c-07e4-3d6e-ac8d-7e453306143a",
                                        "glosses": [
                                            "À qui ou à quoi rien ne peut être comparé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f1ae0b-ee3b-4ebe-895c-f889c3efa33f",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Puis, après une demi-heure d’un incomparable éclat, sans qu’il se fût resserré ni concentré, sans un amoindrissement même partiel de sa lumière, le splendide météore s'éteignit soudain, […]."
                                            },
                                            {
                                                "example_id": "21625221-a492-45dc-bc68-e02e9b093e04",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Au bout d'une heure nous atteignons la cime, du haut de laquelle on domine tout l'archipel féroésien; contemplée au crépuscule de minuit, cette vue est d'une incomparable magnificence."
                                            },
                                            {
                                                "example_id": "22bfca14-af4c-4349-bed3-a2c21f0a7698",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Ce chef de gouvernement capable de discuter avec Einstein la théorie de la relativité de l'espace et du temps emprunte à sa vie intérieure un incomparable prestige."
                                            },
                                            {
                                                "example_id": "c94605fd-d948-4b61-847d-86b5c9e52cc6",
                                                "sense_id": "fa13d1d1-b87f-3dcd-8d8f-c30be35eef7d",
                                                "text": "Le Caux est une terre à blé, mais la vallée verdoyante du Bray est un immense et magnifique pâturage où un élevage intensif se pratique dans des prés incomparables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18d0905d-7023-41fe-ad91-787208c9e851",
                        "source_entry_id": "76690f4f-4ec0-3d69-ba2c-e82c70dc77b3",
                        "source_sense_id": "45345f9b-e7c2-3414-992d-613d58a7f417",
                        "target_lang_word": "inégalable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inégalable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                        "entry_id": "449fd3c4-70e0-31cd-beab-b608f1e4c250",
                                        "glosses": [
                                            "Que l'on ne peut égaler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f612082c-969f-401a-a97d-c77d92ac65a7",
                                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                                "text": "Jusque là les phénomènes décrits par l’inégalable Abbesse restaient exacts."
                                            },
                                            {
                                                "example_id": "ae750eec-f00e-4894-b47d-3efb0df87052",
                                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                                "text": "On se serait cru chez un grand seigneur d’autrefois, n’eussent été l’allure vulgaire et les éclats de voix canailles qui attestent chez notre amphitryon un muflisme inégalable..."
                                            },
                                            {
                                                "example_id": "cc4c66f0-ac71-48c5-a260-2f338380b463",
                                                "sense_id": "3d32e945-7b3e-32d0-98df-ed653d0ba665",
                                                "text": "Colette Ledannois fut, comme toujours, inégalable dans le décryptement d’un manuscrit propre à décourager les meilleurs casseurs de code."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77e54ac3-5e02-445b-b80b-6fae4a3c7b6e",
                        "source_entry_id": "76690f4f-4ec0-3d69-ba2c-e82c70dc77b3",
                        "source_sense_id": "45345f9b-e7c2-3414-992d-613d58a7f417",
                        "target_lang_word": "unvergleichlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a79e0e78-595c-4651-8158-7f903c6a4d9b",
                        "source_entry_id": "76690f4f-4ec0-3d69-ba2c-e82c70dc77b3",
                        "source_sense_id": "45345f9b-e7c2-3414-992d-613d58a7f417",
                        "target_lang_word": "несравнимый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "несравнимый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "767d55b5-598a-39d2-a471-bbebc9902fb5",
                                        "entry_id": "4d1ac497-578a-3343-af95-4dd29ec22715",
                                        "glosses": [
                                            "уникальный; не поддающийся сравнению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4053251-8c7f-4d9b-8b9d-eebe0e1af37e",
                                                "sense_id": "767d55b5-598a-39d2-a471-bbebc9902fb5",
                                                "text": "В сущности, это практическая отработка стиля, постав пера, контакт слова и реальности, доводимый до автоматизма, ежедневная тренировка руки, несравнимая по эффективности ни с какими «уроками чистописания», ― вот это добровольное дневниковое тягло."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
