                        ],
                        "form": "vluchthuisje"
                    },
                    {
                        "form_id": "27f5bba3-1e69-4b74-9764-af3b3431d2a8",
                        "entry_id": "b5896ecd-982a-3049-acb8-12e55d79f699",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "vluchthuisjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9b3da6e3-cab1-3b16-bbb8-da785dc2513a",
                        "entry_id": "b5896ecd-982a-3049-acb8-12e55d79f699",
                        "glosses": [
                            "een Belgisch opvangcentrum voor vrouwen die mishandeld of bedreigd worden door het geweld van hun partner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686e83db-3a92-4dde-8e0c-f13974fe3af0",
                                "sense_id": "9b3da6e3-cab1-3b16-bbb8-da785dc2513a",
                                "text": "Zes jaar geleden verliet Esther de vader van haar twee jongste kinderen. ‘Toen stond ik op straat, met een plastieken zak vol spullen en twee kinderen op mijn arm. Ik ben terechtgekomen in een vluchthuis, in de buurt van Hasselt. Na onze scheiding bleek dat hij geld had uitgegeven op mijn naam, en moest ik opdraaien voor alle schulden.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "b5068409-7afc-3ab9-80a3-ffb326512fa8",
                        "entry_id": "b5896ecd-982a-3049-acb8-12e55d79f699",
                        "glosses": [
                            "toevluchtsoord in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "934daaa3-c35c-4c49-8a52-e0f10d3c024d",
                                "sense_id": "b5068409-7afc-3ab9-80a3-ffb326512fa8",
                                "text": "Tijdens het gesprek over de campagnes die de in 2011 overleden Liz Taylor voerde voor de preventie en het wegnemen van het stigma van hiv en aids, vertelde model Ireland over het 'vluchthuis'dat Taylor runde in Los Angeles."
                            },
                            {
                                "example_id": "7c0cd7db-49ed-4d78-abda-14f62eecaac6",
                                "sense_id": "b5068409-7afc-3ab9-80a3-ffb326512fa8",
                                "text": "Ook Den Haag zoekt - totdat het Rijk een oplossing biedt - zelf door naar onderdak voor de groep asielzoekers die morgen een Haags vluchthuis moet verlaten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01a60b81-08af-4554-8320-6abceb724af6",
                        "source_entry_id": "b5896ecd-982a-3049-acb8-12e55d79f699",
                        "source_sense_id": "9b3da6e3-cab1-3b16-bbb8-da785dc2513a",
                        "source_sense_description": "blijf-van-mijn-lijfhuis",
                        "target_lang_word": "battered women`s refuge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "26c10fc4-f44c-4fab-aa71-f4696f364919",
                        "source_entry_id": "b5896ecd-982a-3049-acb8-12e55d79f699",
                        "source_sense_id": "9b3da6e3-cab1-3b16-bbb8-da785dc2513a",
                        "source_sense_description": "blijf-van-mijn-lijfhuis",
                        "target_lang_word": "refuge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refuge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359fd24c-5326-3480-8642-44b952c81f43",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "A state of safety, protection or shelter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2c1ff42-102b-4551-b254-68046d404cf0",
                                                "sense_id": "359fd24c-5326-3480-8642-44b952c81f43",
                                                "text": "Rocks, dens, and caves! But I in none of these / Find place or refuge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea62e87c-d44b-34fa-887d-b0092205d938",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "A place providing safety, protection or shelter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda9952a-a16a-4ced-b507-dfbb19a33a96",
                                                "sense_id": "ea62e87c-d44b-34fa-887d-b0092205d938",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba10bfed-5b81-312b-a3ab-ceb19a0e276f",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "Something or someone turned to for safety or assistance; a recourse or resort."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41c9b909-b91e-4270-a411-8569f06e5b78",
                                                "sense_id": "ba10bfed-5b81-312b-a3ab-ceb19a0e276f",
                                                "text": "Since its conception, the European Union has been a haven for those seeking refuge from war, persecution and poverty in other parts of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c978db-c650-3512-ba5c-f7b661bd6f4f",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "An expedient to secure protection or defence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016fdf74-1153-4796-a544-1a8337335412",
                                                "sense_id": "01c978db-c650-3512-ba5c-f7b661bd6f4f",
                                                "text": "Their latest refuge / Was to send him."
                                            },
                                            {
                                                "example_id": "7b87a980-70d3-4eb6-947b-f8852b46855b",
                                                "sense_id": "01c978db-c650-3512-ba5c-f7b661bd6f4f",
                                                "text": "This is occaſioned by this, that too too often the Teaching of a Grammar School is the ordinary Refuge that deſperate Perſons as to any other Employment in good Learning betake themſelves to; whilﬅ but a few know themſelves ſuited with intellectual and moral Abilities, and fewer have that Encouragement, when they undertake it, their Pains deſerve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de491a1-3147-3a39-91c8-d123483def1f",
                                        "entry_id": "381e82da-86bd-34b3-ae2e-4945b0e250db",
                                        "glosses": [
                                            "A refuge island."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "refuge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "014d961d-3a11-3ee4-ae41-5772afdc5696",
                                        "entry_id": "9670f8cc-6cc4-3f1f-8f10-cb2cd0d323c3",
                                        "glosses": [
                                            "To return to a place of shelter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7420b1ea-2965-4d92-a2be-c3f06883c03c",
                                                "sense_id": "014d961d-3a11-3ee4-ae41-5772afdc5696",
                                                "text": "Among these macaques, although activity cycles are quite variable from location to location, refuging is a common characteristic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "994786da-adab-30a7-bd22-ebbf231feb05",
                                        "entry_id": "9670f8cc-6cc4-3f1f-8f10-cb2cd0d323c3",
                                        "glosses": [
                                            "To shelter; to protect."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
