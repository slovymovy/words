                {
                    "sense_id": "857da0cb-efdc-38eb-9cd7-d1e5d11c99cb",
                    "sense_definition": "Информация в цифровом виде, обрабатываемая компьютерной программой.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Программа шифрует <данные> перед их отправкой на сервер.",
                            "target_lang_translations": {
                                "en": "The program encrypts <w>data</w> before sending it to the server.",
                                "zh": "程序在将<w>数据</w>发送到服务器之前会对其进行加密。"
                            }
                        },
                        {
                            "text": "Потеря важных <данных> стала серьёзной проблемой для компании.",
                            "target_lang_translations": {
                                "en": "The loss of important <w>data</w> became a serious problem for the company.",
                                "zh": "重要<w>数据</w>的丢失成了公司的一个严重问题。"
                            }
                        }
