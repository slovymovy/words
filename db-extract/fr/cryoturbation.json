                        "entry_id": "d6bf2b9f-8241-318f-aeef-53c20fee5ea3",
                        "glosses": [
                            "Modification plastique de la structure superficielle d’un sol, causée par une réaction différente de deux ou plusieurs matériaux à un cycle de gel et de dégel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75aa628c-5c15-47b2-ad53-bd6453223b4f",
                                "sense_id": "7df45889-bd83-3bad-9029-2c68260843af",
                                "text": "L'étude des solutions du sol a permis d'approcher la connaissance des mécanismes pédogénétiques affectant une rendzine brune encroûtée, développée sur la craie à poches de cryoturbation."
                            },
                            {
                                "example_id": "70fb380f-307b-4ce1-a928-701f495f7d42",
                                "sense_id": "7df45889-bd83-3bad-9029-2c68260843af",
                                "text": "Les plus importantes pour la différenciation des sols actuels sont les produits de remaniement sur pentes, les grèves et graveluches ainsi que les poches de cryoturbation."
                            }
                        ]
                    }
