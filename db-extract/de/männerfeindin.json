                                        "glosses": [
                                            "Exhibiting or pertaining to misandry: hating or prejudiced against men."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "misandrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e5bc212-f377-39be-af29-be2a64f57cf0",
                                        "entry_id": "9fcb3d5a-2456-3585-99cc-f43d831ce4f0",
                                        "glosses": [
                                            "One who professes misandry; a hater of men."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d9366a9-110d-4e6d-b8ca-ba43d2c0d6a1",
                                                "sense_id": "3e5bc212-f377-39be-af29-be2a64f57cf0",
                                                "text": "A misandrist hates all men, and a philandrist likes them."
                                            },
                                            {
                                                "example_id": "138f3c08-fa67-4a4c-a4a1-f17dec07965a",
                                                "sense_id": "3e5bc212-f377-39be-af29-be2a64f57cf0",
                                                "text": "Others support Harmange and Coffin, yet stop short of calling themselves misandrists."
                                            },
                                            {
                                                "example_id": "010c2d0f-5647-4a8e-8633-f1df3aa32bfb",
                                                "sense_id": "3e5bc212-f377-39be-af29-be2a64f57cf0",
                                                "text": "According to the LAist, Bartkus appeared to describe himself as being promortalist and misandrist on a website that surfaced after the bombing and could be heard in an audio recording saying, “Basically I’m anti-life. And IVF is like kind of the epitome of pro-life ideology.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2dd5dbf2-a564-4920-b78c-08bdf617f9ae",
                        "source_entry_id": "c11d544a-03a2-3419-bea5-296d40ba8ed7",
                        "source_sense_id": "ddf0d37c-762f-3bb2-8519-2be44843b9eb",
