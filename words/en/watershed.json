{
    "word_family": [
        "shed",
        "water"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c18715d-e288-3f9b-816d-64a654a41c84",
                    "sense_definition": "A critical point or event that marks a significant change in course or development.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "turning point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invention of the internet was a <w>watershed</w> moment in human history.",
                            "target_lang_translations": {
                                "ru": "Изобретение интернета стало <w>переломным моментом</w> в истории человечества."
                            }
                        },
                        {
                            "text": "The new law proved to be a <w>watershed</w> for environmental protection.",
                            "target_lang_translations": {
                                "ru": "Новый закон стал настоящим <w>водоразделом</w> в деле защиты окружающей среды."
                            }
                        }
                    ],
                    "synonyms": [
                        "turning point",
                        "crossroads"
                    ],
                    "common_phrases": [
                        "watershed moment",
                        "watershed year",
                        "watershed event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Критический момент или событие, знаменующее значительное изменение в ходе событий или развитии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переломный момент",
                                "target_lang_sense_clarification": "событие, меняющее ход истории или жизни"
                            },
                            {
                                "target_lang_word": "водораздел",
                                "target_lang_sense_clarification": "переносное значение: граница между этапами или явлениями"
                            },
                            {
                                "target_lang_word": "поворотный пункт",
                                "target_lang_sense_clarification": "важное событие, определяющее дальнейшее развитие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76ab0b76-dc7f-382b-a469-3c40bfd3347e",
                    "sense_definition": "The time of day after which programs with adult content may be broadcast on television or radio.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "broadcasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie contains too much violence to be shown before the <w>watershed</w>.",
                            "target_lang_translations": {
                                "ru": "В фильме слишком много насилия, чтобы показывать его до <w>водораздела</w> (детского времени)."
                            }
                        },
                        {
                            "text": "Broadcasters must follow strict rules regarding the nine o'clock <w>watershed</w>.",
                            "target_lang_translations": {
                                "ru": "Вещатели должны соблюдать строгие правила относительно девятичасового <w>временного порога</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "before the watershed",
                        "after the watershed",
                        "television watershed"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Время суток, после которого на телевидении или радио разрешена трансляция программ с контентом для взрослых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водораздел",
                                "target_lang_sense_clarification": "в контексте телевещания (обычно 21:00 в Британии)"
                            },
                            {
                                "target_lang_word": "временной порог",
                                "target_lang_sense_clarification": "ограничение по времени для показа взрослого контента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "315e681b-d15c-3944-92c2-0c548b6544e6",
                    "sense_definition": "An area of land where all the water that is under it or drains off of it goes into the same place.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution in the upper <w>watershed</w> affects the water quality of the entire river.",
                            "target_lang_translations": {
                                "ru": "Загрязнение в верхней части <w>водосборного бассейна</w> влияет на качество воды во всей реке."
                            }
                        },
                        {
                            "text": "The local government is working to protect the <w>watershed</w> area from industrial waste.",
                            "target_lang_translations": {
                                "ru": "Местные власти работают над защитой зоны <w>водосбора</w> от промышленных отходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "catchment basin",
                        "catchment area",
                        "drainage area",
                        "river basin"
                    ],
                    "common_phrases": [
                        "local watershed",
                        "watershed management",
                        "protect the watershed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, с которой все поверхностные и грунтовые воды стекают в один общий водоем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водосборный бассейн",
                                "target_lang_sense_clarification": "территория стока воды"
                            },
                            {
                                "target_lang_word": "водосбор",
                                "target_lang_sense_clarification": "географическая область питания реки или озера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c0ee8d7-7b52-3b9f-a1cf-8199c0597725",
                    "sense_definition": "A ridge of high land that separates two different river systems or basins.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain range acts as a natural <w>watershed</w> between the two valleys.",
                            "target_lang_translations": {
                                "ru": "Горный хребет служит естественным <w>водоразделом</w> между двумя долинами."
                            }
                        },
                        {
                            "text": "Rain falling on one side of the <w>watershed</w> flows toward the Atlantic.",
                            "target_lang_translations": {
                                "ru": "Дождь, выпадающий по одну сторону <w>водораздела</w>, стекает в сторону Атлантики."
                            }
                        }
                    ],
                    "synonyms": [
                        "water parting",
                        "drainage divide",
                        "water divide",
                        "divide"
                    ],
                    "common_phrases": [
                        "continental watershed",
                        "mountain watershed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия на земной поверхности, разделяющая бассейны двух или нескольких рек или океанов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водораздел",
                                "target_lang_sense_clarification": "географическая граница между речными бассейнами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9314533c-2490-3cb9-81c9-67cc88c7fd96",
                    "sense_definition": "Serving to mark a very important development or a major change in direction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "turning point",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court's <w>watershed</w> decision changed the legal landscape for decades.",
                            "target_lang_translations": {
                                "ru": "<w>Переломное</w> решение суда изменило правовой ландшафт на десятилетия."
                            }
                        },
                        {
                            "text": "This was a <w>watershed</w> publication that redefined the study of linguistics.",
                            "target_lang_translations": {
                                "ru": "Это была <w>знаковая</w> публикация, которая переопределила изучение лингвистики."
                            }
                        }
                    ],
                    "synonyms": [
                        "momentous"
                    ],
                    "common_phrases": [
                        "watershed decision",
                        "watershed agreement",
                        "watershed study"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для обозначения очень важного события или серьезного изменения направления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переломный",
                                "target_lang_sense_clarification": "решающий, меняющий ситуацию"
                            },
                            {
                                "target_lang_word": "знаковый",
                                "target_lang_sense_clarification": "очень важный, определяющий эпоху"
                            },
                            {
                                "target_lang_word": "поворотный",
                                "target_lang_sense_clarification": "связанный с коренным изменением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}