                "senses": [
                    {
                        "sense_id": "d5b8c3e8-8dff-3f37-9be4-7d36c7244cd8",
                        "entry_id": "8b95e735-954e-3637-8331-2e721f092cf8",
                        "glosses": [
                            "Provoquer un suraccident."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc638fb3-ff36-46f6-b5e0-0a3f3a09591c",
                                "sense_id": "d5b8c3e8-8dff-3f37-9be4-7d36c7244cd8",
                                "text": "Pour ne pas suraccidenter les lieux, j'ai pris mon van pour le transporter à l'écurie."
                            },
                            {
                                "example_id": "ba3fa47c-497f-4c41-aa2d-1ab2f39f0396",
                                "sense_id": "d5b8c3e8-8dff-3f37-9be4-7d36c7244cd8",
                                "text": "Contraîrement aux bébés d'Izazou, une n'avait pas de réflexe de succion; de plus le petit poids de celle-ci a \"suraccidenté\" une malformation."
                            },
                            {
                                "example_id": "d02974fd-6dc9-4dc3-b7cd-e5835e689084",
                                "sense_id": "d5b8c3e8-8dff-3f37-9be4-7d36c7244cd8",
                                "text": "La grossesse simple n'a pas \"suraccidenté\"."
                            }
                        ]
                    }
