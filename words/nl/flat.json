                    "sense_id": "b78b211a-80e3-3dde-9a6e-6cace12cfb9d",
                    "sense_definition": "Een groot gebouw met meerdere verdiepingen waarin verschillende woningen boven elkaar liggen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "housing_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij wonen op de derde verdieping van een hoge <w>flat</w>.",
                            "target_lang_translations": {
                                "en": "We live on the third floor of a tall <w>apartment building</w>.",
                                "ru": "Мы живем на третьем этаже высокой <w>многоэтажки</w>.",
                                "pl": "Mieszkamy na trzecim piętrze wysokiego <w>bloku</w>.",
                                "de": "Wir wohnen im dritten Stock eines hohen <w>Hochhauses</w>.",
                                "fr": "Nous habitons au troisième étage d'un grand <w>immeuble</w>.",
                                "it": "Abitiamo al terzo piano di un alto <w>condominio</w>.",
                                "cs": "Bydlíme ve třetím patře vysokého <w>paneláku</w>.",
                                "tr": "Yüksek bir <w>apartmanın</w> üçüncü katında oturuyoruz.",
                                "es": "Vivimos en el tercer piso de un <w>edificio de apartamentos</w> alto."
                            }
                        },
                        {
                            "text": "Aan de rand van de stad wordt een nieuwe <w>flat</w> gebouwd.",
                            "target_lang_translations": {
                                "en": "A new <w>block of flats</w> is being built on the edge of the city.",
                                "ru": "На окраине города строится новый <w>многоквартирный дом</w>.",
                                "pl": "Na obrzeżach miasta budowany jest nowy <w>blok mieszkalny</w>.",
                                "de": "Am Stadtrand wird ein neuer <w>Wohnblock</w> gebaut.",
                                "fr": "Un nouvel <w>immeuble</w> est en cours de construction à la périphérie de la ville.",
                                "it": "Alla periferia della città si sta costruendo un nuovo <w>palazzo</w>.",
                                "cs": "Na okraji města se staví nový <w>bytový dům</w>.",
                                "tr": "Şehrin kenarında yeni bir <w>apartman binası</w> inşa ediliyor.",
                                "es": "Se está construyendo un nuevo <w>bloque de pisos</w> en las afueras de la ciudad."
                            }
                        }
                    ],
                    "synonyms": [
