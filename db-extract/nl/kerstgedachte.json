                                "example_id": "8f75d5af-d33b-43b2-b38e-5d7a568be3e5",
                                "sense_id": "4e7c7c61-e3b2-3df5-99e2-3072136a5a5e",
                                "text": "Tijdens de feestdagen moeten we de kerstgedachte levend houden.",
                                "translation": "During the festive season, we should keep the seasonal goodwill alive.",
                                "english": "During the festive season, we should keep the seasonal goodwill alive."
                            },
                            {
                                "example_id": "d9ef480c-f0f6-48f4-aaf4-b7641a4d50b3",
                                "sense_id": "4e7c7c61-e3b2-3df5-99e2-3072136a5a5e",
                                "text": "Dit geschenk wordt gegeven in de ware kerstgedachte.",
                                "translation": "This gift is given in the true Christmas cheer.",
                                "english": "This gift is given in the true Christmas cheer."
                            }
