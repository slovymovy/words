                    },
                    {
                        "sense_id": "accc1a88-182e-3df8-9938-e643b2600be9",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "breed wiel met dwars op de buitenrand geplaatste vlakken",
                            "als de aandrijving van een watermolen door de vlakken zo in een waterstroom te plaatsen dat het wiel gaat draaien"
                        ],
                        "tags": [
                            "molenaarsambacht"
                        ],
                        "examples": [
                            {
                                "example_id": "851a1071-1e0d-4c6d-923d-0847eaf3e6b9",
                                "sense_id": "accc1a88-182e-3df8-9938-e643b2600be9",
                                "text": "De ‘waterkrachtcentrale’ blijkt een simpel schoepenrad in de modderige rivier."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d46bf6d-0854-386c-b9ef-3d4818a1afdd",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "breed wiel met dwars op de buitenrand geplaatste vlakken",
                            "om een raderboot voort te stuwen doordat een motor het wiel laat draaien zodat de vlakken aan de onderkant het water wegduwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e55d574-f0cc-4ca0-915a-ad76750ae9eb",
                                "sense_id": "1d46bf6d-0854-386c-b9ef-3d4818a1afdd",
                                "text": "Scheepsbouwer Frédéric Sauvage vond de spiraalvormige scheepsschroef uit, die het schoepenrad zou vervangen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a48083a9-5cd4-31d7-9d86-fc0d529e23c9",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "breed wiel met dwars op de buitenrand geplaatste bakken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a99d5c39-e051-345e-9c2d-8f33ea11e554",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "breed wiel met dwars op de buitenrand geplaatste bakken",
                            "als aandrijving van een watermolen bij een hoogteverschil in een waterstroom, waarbij de bakken aan de bovenkant van het wiel door de bovenstroom worden gevuld, door hun gewicht omlaag zakken, leeglopen in de benedenstroom en dan door het gewicht van de volle bakken weer omhoog draaien"
                        ],
                        "tags": [
                            "molenaarsambacht"
                        ],
                        "examples": [
                            {
                                "example_id": "be875429-1618-40c9-9c39-bd6f71563604",
                                "sense_id": "a99d5c39-e051-345e-9c2d-8f33ea11e554",
                                "text": "Denk aan het schoepenrad van een watermolen. Terwijl de voorliggende schoep zich langzaam met water vult, blijft het rad bewegingloos staan. Pas als de laatste druppel in de schoep valt, wordt de weerstand weggedrukt en slaat het rad in één klap naar de nieuwe stand."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7fc9a6c-9b2c-3b19-bb37-a587d464ad8f",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "breed wiel met dwars op de buitenrand geplaatste bakken",
                            "om water naar een hoger niveau te scheppen als men het wiel aandrijft"
                        ],
                        "tags": [
                            "molenaarsambacht"
                        ],
                        "examples": [
                            {
                                "example_id": "e500493f-5b44-4217-bcb4-5da5d67666f8",
                                "sense_id": "e7fc9a6c-9b2c-3b19-bb37-a587d464ad8f",
                                "text": "Waar in andere landen het schoepenrad lustig kleppert, zoeven ten onzent sombere wieken een eeuwig ‘Wilt heden nu treden’, waar elders een oneindige reeks emmertjes vrolijk klaterend zijn inhoud over de velden doet vloeien, klinkt bij ons het zompig geluid van de waterschroef, slechts te vergelijken met het eentonig in de bek terugspugen en malen der kaken van de in onze polychrome weidelandschappen detonerende zwart-witte herkauwers."
                            }
                        ]
                    },
                    {
                        "sense_id": "bec2053f-295a-361a-8683-0252807c3f34",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "constructie van bladen rond een as in een turbomachine"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e21eefe0-22e8-3704-b8ca-7edc644a9e26",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "constructie van bladen rond een as in een turbomachine",
                            "onderdeel van een turbine dat door een stroming aan het draaien wordt gebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11db30e6-5452-4708-ae1c-87a256c6e31f",
                                "sense_id": "e21eefe0-22e8-3704-b8ca-7edc644a9e26",
                                "text": "Die stoom laat het schoepenrad van de turbine draaien."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9be86c0-ff0e-35af-beaa-821fe237d9c3",
                        "entry_id": "c808462e-96a8-301b-b293-cd37b5cb4612",
                        "glosses": [
                            "constructie van bladen rond een as in een turbomachine",
