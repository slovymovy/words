                "senses": [
                    {
                        "sense_id": "f4786c01-b0e3-3f54-a3d3-eaeba6c0fc82",
                        "entry_id": "37f472a5-27a1-3967-93ab-8a7569d10780",
                        "glosses": [
                            "mäanderartige Fahrt/Linienführung etc."
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "36c43f2a-cd3a-49be-8504-c9e3876b1a3e",
                                "sense_id": "f4786c01-b0e3-3f54-a3d3-eaeba6c0fc82",
                                "text": "„Zur Reduzierung von Arbeitszeit und Speicherkapazität erfolgt die Mäanderfahrt mit Bildaufnahme und Übergabe in den Bildspeicher immer innerhalb eines Präparats, so daß anschließend gleich mehrere Bilder gespeichert werden […]"
                            },
                            {
                                "example_id": "4dd9b784-c2af-4bc8-9686-28dcd070738c",
                                "sense_id": "f4786c01-b0e3-3f54-a3d3-eaeba6c0fc82",
                                "text": "„Aber das Bild davon, die Bilder berittener Polizei im herbstlichen Wald, filmender und photographierender Polizisten auf dem Friedhof, die Mäanderfahrt durch Straßensperren, Polizeikontrollen: also das dokumentarische Material des Films […]“"
                            },
                            {
                                "example_id": "5f093aa0-cce3-476f-8375-c725f04c3e0d",
                                "sense_id": "f4786c01-b0e3-3f54-a3d3-eaeba6c0fc82",
                                "text": "„Es sichert hohe Kursgenauigkeit auch bei häufigen schnellen Kursänderungen wie z.B. bei der auf Forschungsschiffen oft praktizierten Mäanderfahrt."
                            },
                            {
                                "example_id": "5f3f2dcc-dea5-4b4d-9933-039efc4ab8d4",
                                "sense_id": "f4786c01-b0e3-3f54-a3d3-eaeba6c0fc82",
                                "text": "„Anders als die Mäanderfahrt von Halle nach Hessen wird die Reise von Venedig nach Norden zur Eilfahrt. Zweimal nur hält Friederich sich für mehrere Tage an einem Ort auf, gezwungenermaßen, das Wetter, ein Radbruch, […]“"
                            },
                            {
                                "example_id": "b982d238-6dbb-47c3-99ee-4e80b1f3f08d",
                                "sense_id": "f4786c01-b0e3-3f54-a3d3-eaeba6c0fc82",
                                "text": "„[…] die ihn dazu bestimmte, auf eine systematische Darstellung zu verzichten und die Beobachtungen, die er seinem Notizbuche einverleibt hatte, ergänzt durch Literaturhinweise, in der Reihenfolge seiner „Mäanderfahrten\" niederzuschreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
