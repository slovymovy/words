                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e074fb7-686c-4fd1-b23e-2f894bda216d",
                                                "sense_id": "f02098f5-8f07-3596-becf-46727dc85dcc",
                                                "text": "Zdumiewał się poruszony do łez, gdy naraz posłyszał za sobą w sąsieku ostre trzeszczenie słomy"
                                            },
                                            {
                                                "example_id": "ddec2b1b-2d5d-4086-a0fa-d05adfa60f8c",
                                                "sense_id": "f02098f5-8f07-3596-becf-46727dc85dcc",
                                                "text": "Będąc latem na wsi, często spaliśmy w sąsieku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5624ce33-357c-3556-b195-45cd6f3417cf",
