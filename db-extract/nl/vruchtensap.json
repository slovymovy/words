                                "example_id": "63f07593-4704-4781-a326-5043bcb21931",
                                "sense_id": "ac6afaab-65ff-3e06-ae3a-b2b3b8776591",
                                "text": "Is geregeld vruchtensap drinken goed voor de gezondheid?"
                            },
                            {
                                "example_id": "88ddfcfe-a648-4348-92ad-65ed87453f8a",
                                "sense_id": "ac6afaab-65ff-3e06-ae3a-b2b3b8776591",
                                "text": "de Gezondheidsraad en het Voedingscentrum zeggen dat je als je dorst hebt beter water kunt drinken dan vruchtensap en dat je beter fruit kunt eten dan het sap ervan drinken."
                            }
                        ]
                    }
