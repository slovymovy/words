                    {
                        "sense_id": "ccbbf011-cbba-3abf-9808-656aa381afa7",
                        "entry_id": "4ecaa115-f107-3f8a-90a5-a45b072ce83f",
                        "glosses": [
                            "cudzoziemiec"
