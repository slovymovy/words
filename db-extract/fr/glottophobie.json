                    {
                        "translation_id": "e634f644-38db-4519-8b35-f7edbfa266eb",
                        "source_entry_id": "7c7b53f9-c0e8-3bbd-9b8a-077db7114c42",
                        "source_sense_id": "5f11fcba-8c6b-3661-9d44-5b7490ee63eb",
                        "target_lang_word": "languagism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languagism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6ced0ae-4609-344e-91e7-b83ab8b1f566",
                                        "entry_id": "8c5bedad-9960-329a-bb26-671f8a202800",
                                        "glosses": [
                                            "Linguicism; discrimination or chauvinism based on features of language such as accent, syntax, or vocabulary."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c0bf00-1440-4250-850c-b964c1433915",
                                                "sense_id": "a6ced0ae-4609-344e-91e7-b83ab8b1f566",
                                                "text": "The reactionary elements in the country have had their days in poisoning the minds of most of the city people. It is in the shape of communalism, communism and languagism."
                                            },
                                            {
                                                "example_id": "e3552eca-a4b9-43d8-a936-dcf7f8508d86",
                                                "sense_id": "a6ced0ae-4609-344e-91e7-b83ab8b1f566",
                                                "text": "The question may be raised whether we will win the battle against racism, sexism, and agism only to lose the fight against languagism."
                                            },
                                            {
                                                "example_id": "69124946-2eba-4148-98cf-e4434c9cd387",
                                                "sense_id": "a6ced0ae-4609-344e-91e7-b83ab8b1f566",
                                                "text": "America has the potential within the schools and with the educators, but it must keep the pedecrat of modern languagism out of the field of bilingualism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
