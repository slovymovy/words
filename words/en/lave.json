{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b3b7948-634a-3adb-a1fa-8f1d43defa2f",
                    "sense_definition": "To wash, bathe, or splash someone or something with liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She knelt by the clear mountain brook to <w>lave</w> her face in the cold water.",
                            "target_lang_translations": {
                                "es": "Se arrodilló junto al claro arroyo de montaña para <w>lavar</w> su rostro en el agua fría."
                            }
                        },
                        {
                            "text": "The tired traveler paused to <w>lave</w> his dusty feet in the river.",
                            "target_lang_translations": {
                                "es": "El cansado viajero se detuvo a <w>bañar</w> sus pies polvorientos en el río."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Lavar, bañar o rociar a alguien o algo con un líquido, especialmente en un contexto literario o poético."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lavar",
                                "target_lang_sense_clarification": "limpiar con agua"
                            },
                            {
                                "target_lang_word": "bañar",
                                "target_lang_sense_clarification": "mojar con agua"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0ac1810-a053-333b-874b-cb63bbffaf03",
                    "sense_definition": "Of a river, sea, or body of water: to flow along, wash against, or gently lap upon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gentle waves began to <w>lave</w> the sandy shoreline as the evening tide rolled in.",
                            "target_lang_translations": {
                                "es": "Olas suaves comenzaron a <w>bañar</w> la orilla arenosa a medida que subía la marea vespertina."
                            }
                        },
                        {
                            "text": "The quiet river slowly <w>laves</w> the ancient stone walls of the castle.",
                            "target_lang_translations": {
                                "es": "El río tranquilo <w>lame</w> lentamente los antiguos muros de piedra del castillo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in poetic or literary descriptions."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Dicho de una corriente de agua, mar o río: bañar, lamer o acariciar suavemente la orilla o una superficie."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "bañar",
                                "target_lang_sense_clarification": "dicho del agua al tocar la orilla"
                            },
                            {
                                "target_lang_word": "lamer",
                                "target_lang_sense_clarification": "acariciar el agua suavemente la orilla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28c68079-7386-3677-945f-0261d80a1b26",
                    "sense_definition": "To bathe or immerse oneself in water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woodland nymphs were said to <w>lave</w> in the moonlit pool every night.",
                            "target_lang_translations": {
                                "es": "Se decía que las ninfas del bosque se <w>bañaban</w> en el estanque iluminado por la luna cada noche."
                            }
                        },
                        {
                            "text": "Weary pilgrims stopped to <w>lave</w> in the cool spring before ascending the hill.",
                            "target_lang_translations": {
                                "es": "Peregrinos agotados se detuvieron para <w>lavarse</w> en el fresco manantial antes de subir la colina."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly found in archaic poetry."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Bañarse o sumergirse en el agua (uso poético o arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "bañarse",
                                "target_lang_sense_clarification": "sumergirse en el agua"
                            },
                            {
                                "target_lang_word": "lavarse",
                                "target_lang_sense_clarification": "asearse con agua"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "718cef2b-dabd-3762-9710-3347719a2b8f",
                    "sense_definition": "To bail, scoop, or ladle liquid out of a container or vessel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors had to <w>lave</w> out the incoming water to keep the leaky boat afloat.",
                            "target_lang_translations": {
                                "es": "Los marineros tuvieron que <w>achicar</w> el agua que entraba para mantener a flote el barco con fugas."
                            }
                        },
                        {
                            "text": "He used an old tin pail to <w>lave</w> the rainwater from the flooded basement.",
                            "target_lang_translations": {
                                "es": "Usó un viejo cubo de hojalata para <w>sacar</w> el agua de lluvia del sótano inundado."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lave out"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly nautical or historic usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Achicar o extraer líquido de una embarcación o recipiente utilizando un cubo, achicador o cucharón."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "achicar",
                                "target_lang_sense_clarification": "sacar agua de una embarcación"
                            },
                            {
                                "target_lang_word": "sacar",
                                "target_lang_sense_clarification": "extraer líquido con un recipiente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49c2d6b8-9032-3f4a-8aa5-357999a28888",
                    "sense_definition": "To pour liquid onto or into something, especially using a ladle or scoop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metalworker carefully <w>laved</w> the molten iron into the prepared sand molds.",
                            "target_lang_translations": {
                                "es": "El metalúrgico <w>vertió</w> con cuidado el hierro fundido en los moldes de arena preparados."
                            }
                        },
                        {
                            "text": "They used a heavy spoon to <w>lave</w> the boiling syrup over the cooling confections.",
                            "target_lang_translations": {
                                "es": "Usaron una cuchara pesada para <w>verter</w> el almíbar hirviendo sobre los dulces que se enfriaban."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare and archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Verter o echar líquido sobre algo con la ayuda de un cucharón o recipiente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "verter",
                                "target_lang_sense_clarification": "echar líquido con cucharón"
                            },
                            {
                                "target_lang_word": "rociar",
                                "target_lang_sense_clarification": "echar líquido sobre algo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1686382-6afd-3f4b-ba20-8e6e140b4808",
                    "sense_definition": "To remove or wash away something gently, as if cleansing with water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of peaceful solitude helped <w>lave</w> the deep sorrow from his wounded spirit.",
                            "target_lang_translations": {
                                "es": "Años de pacífica soledad ayudaron a <w>borrar</w> la profunda tristeza de su espíritu herido."
                            }
                        },
                        {
                            "text": "With quiet forgiveness she sought to <w>lave</w> away the bitter memories of the feud.",
                            "target_lang_translations": {
                                "es": "Con un perdón silencioso, intentó <w>limpiar</w> los recuerdos amargos de la disputa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Chiefly literary and figurative."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Eliminar o limpiar suavemente algo en sentido figurado, como si se lavara con agua."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "limpiar",
                                "target_lang_sense_clarification": "eliminar penas o culpas"
                            },
                            {
                                "target_lang_word": "borrar",
                                "target_lang_sense_clarification": "hacer desaparecer recuerdos o penas"
                            },
                            {
                                "target_lang_word": "lavar",
                                "target_lang_sense_clarification": "purgar o purificar en sentido figurado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b30f2314-de2a-3d8c-91b6-b32a57708402",
                    "sense_definition": "To surround, envelop, or lap gently, as if immersed in liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soft golden light seemed to <w>lave</w> the quiet garden during the summer twilight.",
                            "target_lang_translations": {
                                "es": "Una suave luz dorada parecía <w>bañar</w> el tranquilo jardín durante el crepúsculo de verano."
                            }
                        },
                        {
                            "text": "Gentle ocean breezes <w>laved</w> the sleepy village throughout the warm tropical night.",
                            "target_lang_translations": {
                                "es": "Suaves brisas marinas <w>envolvían</w> el somnoliento pueblo durante toda la cálida noche tropical."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Poetic or literary figurative use."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Envolver o rodear suavemente, como si sumergiera en un líquido (uso poético)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "bañar",
                                "target_lang_sense_clarification": "envolver con luz, aire o perfume"
                            },
                            {
                                "target_lang_word": "envolver",
                                "target_lang_sense_clarification": "rodear suavemente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86017b93-da6e-3358-be25-72330d8429fd",
                    "sense_definition": "To lick or stroke gently with the tongue, especially in erotic contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His warm tongue began to <w>lave</w> her sensitive skin in slow, tender caresses.",
                            "target_lang_translations": {
                                "es": "Su cálida lengua comenzó a <w>lamer</w> su piel sensible con caricias lentas y tiernas."
                            }
                        },
                        {
                            "text": "He bent down slowly to <w>lave</w> the sweet moisture from her trembling neck.",
                            "target_lang_translations": {
                                "es": "Se inclinó lentamente para <w>lamer</w> la dulce humedad de su cuello tembloroso."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Chiefly romance or erotic literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Lamer o acariciar suavemente con la lengua, especialmente en literatura romántica o erótica."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lamer",
                                "target_lang_sense_clarification": "pasar la lengua suavemente"
                            },
                            {
                                "target_lang_word": "recorrer con la lengua",
                                "target_lang_sense_clarification": "acariciar con la lengua"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b50201fd-a156-3081-acc0-9f5dac6f1d58",
                    "sense_definition": "Of ears: to droop or hang down limp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hound sat peacefully, letting its long ears <w>lave</w> toward the damp grass.",
                            "target_lang_translations": {
                                "es": "El viejo sabueso se sentó plácidamente, dejando que sus largas orejas <w>cayeran</w> hacia la hierba húmeda."
                            }
                        },
                        {
                            "text": "Tired from the hunt, the pig let its bruised ears <w>lave</w> in the afternoon heat.",
                            "target_lang_translations": {
                                "es": "Cansado por la cacería, el cerdo dejó <w>colgar</w> sus orejas magulladas bajo el calor de la tarde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Dicho de las orejas de un animal: colgar o caer de forma lacia (obsoleto)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "caer",
                                "target_lang_sense_clarification": "colgar las orejas de forma lacia"
                            },
                            {
                                "target_lang_word": "colgar",
                                "target_lang_sense_clarification": "pender de forma lacia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0930efd1-ecbd-32a5-9e0f-489d44cb8a38",
                    "sense_definition": "The remainder or that which is left; the rest.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took her share of the money and left the <w>lave</w> for her brothers.",
                            "target_lang_translations": {
                                "es": "Ella tomó su parte del dinero y dejó <w>el resto</w> para sus hermanos."
                            }
                        },
                        {
                            "text": "While the leaders entered the cottage, the <w>lave</w> of the company waited outside.",
                            "target_lang_translations": {
                                "es": "Mientras los líderes entraban en la cabaña, <w>los demás</w> miembros del grupo esperaban afuera."
                            }
                        }
                    ],
                    "synonyms": [
                        "remainder",
                        "remains",
                        "remnant",
                        "residue",
                        "rest"
                    ],
                    "common_phrases": [
                        "the lave"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Chiefly Scottish and Northern English."
                        },
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic in modern standard English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "El resto, la parte restante de algo (uso dialectal escocés o arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "el resto",
                                "target_lang_sense_clarification": "lo que queda"
                            },
                            {
                                "target_lang_word": "los demás",
                                "target_lang_sense_clarification": "las restantes personas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4113e2d9-6c76-323f-910d-6fa285bb3e27",
                    "sense_definition": "An act of washing or bathing; a wash.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bath",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a grueling day under the hot sun, a quick <w>lave</w> in the creek refreshed him.",
                            "target_lang_translations": {
                                "es": "Tras un día agotador bajo el sol ardiente, un rápido <w>baño</w> en el arroyo lo refrescó."
                            }
                        },
                        {
                            "text": "The soothing sound of the brook offered a gentle <w>lave</w> to their tired feet.",
                            "target_lang_translations": {
                                "es": "El sonido relajante del arroyo ofreció un suave <w>lavado</w> para sus pies cansados."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare and poetic."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Acción de lavarse o darse un baño ligero (arcaico o poético)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lavado",
                                "target_lang_sense_clarification": "acción de lavarse brevemente"
                            },
                            {
                                "target_lang_word": "baño",
                                "target_lang_sense_clarification": "acto de refrescarse con agua"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37f49bbf-ab1d-3c44-aeb8-090108c10cb0",
                    "sense_definition": "The sea or ocean.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ocean",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Flocks of white gulls glided effortlessly over the restless surface of the <w>lave</w>.",
                            "target_lang_translations": {
                                "es": "Bandadas de gaviotas blancas planeaban sin esfuerzo sobre la inquieta superficie del <w>mar</w>."
                            }
                        },
                        {
                            "text": "The lone fishing boat drifted quietly across the vast expanse of the <w>lave</w>.",
                            "target_lang_translations": {
                                "es": "El solitario barco pesquero navegaba en silencio a través de la vasta extensión del <w>mar</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare poetic usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "El mar o el océano (uso poético muy raro)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "mar",
                                "target_lang_sense_clarification": "océano o masa de agua"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f19f93c7-158d-3f00-9eaf-47ca2205e988",
                    "sense_definition": "A widow; a surviving spouse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unfortunate <w>lave</w> mourned her husband long after the fatal sea voyage.",
                            "target_lang_translations": {
                                "es": "La desafortunada <w>viuda</w> lloró a su esposo mucho tiempo después del fatal viaje por mar."
                            }
                        },
                        {
                            "text": "Villagers brought food and firewood to support the poor <w>lave</w> throughout the harsh winter.",
                            "target_lang_translations": {
                                "es": "Los aldeanos llevaron comida y leña para apoyar a la pobre <w>viuda</w> durante todo el duro invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "relic"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historical and obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Viuda; cónyuge superviviente (obsoleto e histórico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "viuda",
                                "target_lang_sense_clarification": "mujer cuyo cónyuge ha muerto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fed73997-0625-318b-92cc-2a43ce81a660",
                    "sense_definition": "Of ears: drooping or hanging down limp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spaniel greeted its master with large <w>lave</w> ears flapping in the wind.",
                            "target_lang_translations": {
                                "es": "El spaniel recibió a su dueño con grandes orejas <w>caídas</w> que ondeaban al viento."
                            }
                        },
                        {
                            "text": "He laughed when he noticed the donkey's comical <w>lave</w> ears swaying from side to side.",
                            "target_lang_translations": {
                                "es": "Se rió al notar las cómicas orejas <w>gachas</w> del burro balanceándose de un lado a otro."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lave ears"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete, chiefly found in historical texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Dicho de orejas: caídas o colgantes de manera lacia (obsoleto)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "caído",
                                "target_lang_sense_clarification": "dicho de orejas gachas o colgantes"
                            },
                            {
                                "target_lang_word": "gacho",
                                "target_lang_sense_clarification": "inclinado hacia abajo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}