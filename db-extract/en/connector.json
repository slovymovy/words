                        "entry_id": "261f30e5-d487-38ca-a10e-5e4bb10ccde3",
                        "glosses": [
                            "A software component that provides access from an application program to an external database or data source, such as a JDBC connector."
                        ],
                        "tags": [],
                        "examples": []
                    },
