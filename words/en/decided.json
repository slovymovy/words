                {
                    "sense_id": "b87b00f6-ef07-361f-a99a-1f3a60c247a4",
                    "sense_definition": "Having firm opinions or character; determined and resolute.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a man of <w>decided</w> character who rarely changes his mind once it is made up.",
                            "target_lang_translations": {
                                "ru": "Это человек <w>решительного</w> характера, который редко меняет своё мнение, если уж он его составил.",
                                "zh": "他是一个性格<w>果断的</w>人，一旦打定主意就很少改变。"
                            }
                        },
                        {
                            "text": "She walked with a <w>decided</w> step towards the podium to give her speech.",
                            "target_lang_translations": {
                                "ru": "Она <w>твёрдым</w> шагом направилась к трибуне, чтобы произнести речь.",
                                "zh": "她迈着<w>坚定的</w>步伐走向讲台准备发表演讲。"
                            }
                        }
