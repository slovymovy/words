                                            {
                                                "example_id": "07b7a4c8-0688-43ca-9d07-44c50c1df3e3",
                                                "sense_id": "2893b28f-2b16-3c42-9c06-621fde7031b6",
                                                "text": "His jacket was dotted with splashes of paint."
                                            },
                                            {
                                                "example_id": "68febd8a-ebbb-47d8-abda-ab0955935876",
                                                "sense_id": "2893b28f-2b16-3c42-9c06-621fde7031b6",
                                                "text": "Nurse Cramer had a cute nose and a radiant, blooming complexion dotted with fetching sprays of adorable freckles that Yossarian detested."
                                            },
                                            {
                                                "example_id": "0814b952-86f9-427d-a24e-cd34e1eeb8f2",
                                                "sense_id": "2893b28f-2b16-3c42-9c06-621fde7031b6",
                                                "text": "Yang Shuo county, in the middle of the Guangxi Autonomous Region, is an area dotted by hundreds of little villages, all looking much alike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "742213aa-1317-3a9f-bafa-5a64875afb2f",
                                        "entry_id": "b098d139-e00d-3767-ad84-ef178d90fcad",
                                        "glosses": [
                                            "To add a dot (the symbol) or dots to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c7682a-a1ec-4bf1-9ec7-1f3ed07e5b62",
                                                "sense_id": "742213aa-1317-3a9f-bafa-5a64875afb2f",
                                                "text": "Dot your is and cross your ts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee448b55-6076-360c-b9d5-120b3f134053",
                                        "entry_id": "b098d139-e00d-3767-ad84-ef178d90fcad",
                                        "glosses": [
                                            "To mark by means of dots or small spots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c675e388-760c-4f69-b08f-e7b28d00d48a",
                                                "sense_id": "ee448b55-6076-360c-b9d5-120b3f134053",
                                                "text": "to dot a line"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "591ab6d4-cede-3538-9f5f-b983d202878e",
                                        "entry_id": "b098d139-e00d-3767-ad84-ef178d90fcad",
                                        "glosses": [
                                            "To mark or diversify with small detached objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "235186e3-0ef7-499d-bd4e-1a64d25d941b",
                                                "sense_id": "591ab6d4-cede-3538-9f5f-b983d202878e",
                                                "text": "to dot a landscape with cottages"
                                            },
                                            {
                                                "example_id": "a6131668-1743-434c-8009-e7c5d0a137fc",
                                                "sense_id": "591ab6d4-cede-3538-9f5f-b983d202878e",
                                                "text": "The switchback road to Diabaig - pronounced 'Jer-vague' - passes through some of the most exhilarating scenery in Scotland. […] With a final swoop, the road plummets down into Diabaig, where cottages are dotted across the slopes of a rocky semi-circle."
                                            },
                                            {
                                                "example_id": "ac4045a1-03ca-44f5-aaa0-7e19c4275b08",
                                                "sense_id": "591ab6d4-cede-3538-9f5f-b983d202878e",
                                                "text": "Wooden crosses, some drunkenly askew, dot a darkened stage at the start of Vuyani Dance Theater’s “Cion: Requiem of Ravel’s Bolero.” There is silence, then the sound of weeping, which escalates to heart-rending, gasping sobs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec1375ad-17ff-3f3a-9701-13af7466d37b",
                                        "entry_id": "b098d139-e00d-3767-ad84-ef178d90fcad",
                                        "glosses": [
                                            "To punch (a person)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37c9bf69-346b-4c6a-b84e-0afd581f987e",
                                                "sense_id": "ec1375ad-17ff-3f3a-9701-13af7466d37b",
                                                "text": "`Which means,' said John, `that someone dotted him a good one, shoved him into the bathtub, ran the water, then opened his mouth and poured champagne into it until he drowned.'"
                                            }
                                        ]
                                    }
                                ]
                            },
