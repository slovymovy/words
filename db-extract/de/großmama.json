                "senses": [
                    {
                        "sense_id": "ff3285d2-cdb5-3e8a-bf4d-4746378d6cfd",
                        "entry_id": "f683c0e1-bacf-30ce-bd47-d67ba50d5b88",
                        "glosses": [
                            "Mutter des Vaters oder der Mutter, weiblicher Teil der Großeltern"
                        ],
                        "tags": [
                            "familiär"
                        ],
                        "examples": [
                            {
                                "example_id": "88970a5b-ba1e-48b6-8ad9-764a13df510d",
                                "sense_id": "ff3285d2-cdb5-3e8a-bf4d-4746378d6cfd",
                                "text": "„So kam die Abenddämmerung herauf, die Großmama reichte Schnittchen mit Lachsschinken, Leberwurst und Essiggurke.“"
                            },
                            {
                                "example_id": "ddf51fb2-51bb-4bc4-a02e-07b4b75ad4e4",
                                "sense_id": "ff3285d2-cdb5-3e8a-bf4d-4746378d6cfd",
                                "text": "„Warum deine Großmama das getan hat? Damit sie es hierher zu dir schafft! Sonst hättest du womöglich gar keine Großmama mehr.“"
                            },
                            {
                                "example_id": "09267ea6-826f-4628-b03c-453a16431e18",
                                "sense_id": "ff3285d2-cdb5-3e8a-bf4d-4746378d6cfd",
                                "text": "„Großmama liegt im Sterben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
