                "senses": [
                    {
                        "sense_id": "a6629308-31ca-3545-ac6c-44a7bf4c65f0",
                        "entry_id": "d4645d35-5a34-3137-9e55-793dd9c41dff",
                        "glosses": [
                            "ein aasfressender Raubvogel aus der Unterfamilie der Altweltgeier (Aegypiinae)"
                        ],
                        "tags": [
                            "Südafrika (KwaZulu-Natal)"
                        ],
                        "examples": [
                            {
                                "example_id": "27ab2c0a-c778-4bc1-aca1-932036b480bf",
                                "sense_id": "a6629308-31ca-3545-ac6c-44a7bf4c65f0",
                                "text": "„Kurz nach Mittag bemerkte ich einen Aasvogel, der hoch über uns seine Kreise zog.“"
                            },
                            {
                                "example_id": "a9e84e29-cfcb-4b88-9e1b-fcd5c938a942",
                                "sense_id": "a6629308-31ca-3545-ac6c-44a7bf4c65f0",
                                "text": "„Auch im südlichen Ungarn, in der Wallachei und der südlichen Krimm pflanzt sich der Aasvogel in einzelnen Paaren fort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
