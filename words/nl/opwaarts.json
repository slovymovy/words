                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uphill",
                                "target_lang_sense_clarification": "moving against a slope"
                            },
                            {
                                "target_lang_word": "upward",
                                "target_lang_sense_clarification": "general ascent"
                            }
                        ]
                    }
                }
            ]
        }
