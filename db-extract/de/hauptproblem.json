                ],
                "senses": [
                    {
                        "sense_id": "f9d44641-5a16-3d16-a847-7d2f2af9c361",
                        "entry_id": "24c03898-1d5f-39c1-b4ae-ff5310135900",
                        "glosses": [
                            "größtes, wesentliches Problem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c068c87-d784-4fa8-aaf3-12cfdc3759ab",
                                "sense_id": "f9d44641-5a16-3d16-a847-7d2f2af9c361",
                                "text": "„Das Hauptproblem, das 1946 und 1947 auf der zionistischen Agenda stand – der Kampf gegen die Briten –, löste sich von selbst, als die Briten im Februar 1947 beschlossen, Palästina zu verlassen und die Palästinafrage den Vereinten Nationen zu überlassen.“"
                            },
                            {
                                "example_id": "9f6a91d2-8331-4ee4-9d3b-dd9fcc56ae8d",
                                "sense_id": "f9d44641-5a16-3d16-a847-7d2f2af9c361",
                                "text": "„Mein Hauptproblem mit den Nachtgängern ist, dass sie sich aufs hohe Ross setzen und mich einen Heuchler und Fanatiker nennen.“"
                            },
                            {
                                "example_id": "26047a68-4000-4a78-8b0f-1a32a85ce5e0",
                                "sense_id": "f9d44641-5a16-3d16-a847-7d2f2af9c361",
                                "text": "„›Das Hauptproblem, über das ich mir Sorgen mache, mein Herzog‹, gab Gurney zu, ›sind die Atomwaffen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
