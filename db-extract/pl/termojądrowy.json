                "senses": [
                    {
                        "sense_id": "66626504-39ad-31f2-b36e-3e764857958b",
                        "entry_id": "6ac35e2d-f892-3670-bb84-14c2b4240d48",
                        "glosses": [
                            "dotyczący łączenia lekkich jąder atomów w cięższe pod wpływem wysokich temperatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9c8ab89-91ed-47c1-b994-6485e37a91f1",
                                "sense_id": "66626504-39ad-31f2-b36e-3e764857958b",
                                "text": "Aby nastąpiła termojądrowa fuzja, plazmę jąder wodorowych należy rozgrzać do temperatury 100 mln stopni."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eec337d7-b92c-48f6-a710-203140ebe41e",
                        "source_entry_id": "6ac35e2d-f892-3670-bb84-14c2b4240d48",
                        "source_sense_id": "66626504-39ad-31f2-b36e-3e764857958b",
                        "target_lang_word": "thermonuclear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermonuclear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b90c941-b47b-3408-b48a-71f5111a9bf3",
                                        "entry_id": "25f5ec1f-c1f9-342f-86a8-43168c1df97f",
                                        "glosses": [
                                            "Of, or relating to the fusion of atomic nuclei at high temperatures."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daea2d84-b91a-4a77-822c-f9a67e8f875e",
                                                "sense_id": "2b90c941-b47b-3408-b48a-71f5111a9bf3",
                                                "text": "The first thermonuclear reaction was in a star; it was brought about by heat, as the description implies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bce6690-6a68-372d-bde6-be2510d314ec",
                                        "entry_id": "25f5ec1f-c1f9-342f-86a8-43168c1df97f",
                                        "glosses": [
                                            "Of, or relating to the use of atomic weapons based on such fusion, especially as distinguished from those based on fission."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e1f3c1-1953-46fd-bfd0-1c6150aa3abd",
                                                "sense_id": "5bce6690-6a68-372d-bde6-be2510d314ec",
                                                "text": "I can't believe you gave me, a ten-year-old boy, a thermonuclear device [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thermonuclear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2af4a0c5-ce84-3b11-b27d-d3b1d91dc3dc",
                                        "entry_id": "65f24d8c-8154-399c-9fd3-ce1c149e8e7f",
                                        "glosses": [
                                            "A thermonuclear weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0317971-67ac-4f01-aac3-d8fd05994bd2",
                                                "sense_id": "2af4a0c5-ce84-3b11-b27d-d3b1d91dc3dc",
                                                "text": "China detonated her first thermonuclear in June 1967."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "724ff65e-221a-4930-b610-23f09ef506a5",
                        "source_entry_id": "6ac35e2d-f892-3670-bb84-14c2b4240d48",
                        "source_sense_id": "66626504-39ad-31f2-b36e-3e764857958b",
                        "target_lang_word": "termonukleární",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f2dab1e6-3189-4608-b856-a364d7ea9af3",
                        "source_entry_id": "6ac35e2d-f892-3670-bb84-14c2b4240d48",
                        "source_sense_id": "66626504-39ad-31f2-b36e-3e764857958b",
                        "target_lang_word": "termonuclear",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "064dffa2-3902-45ce-95e2-ad683d6933fe",
                        "source_entry_id": "6ac35e2d-f892-3670-bb84-14c2b4240d48",
                        "source_sense_id": "66626504-39ad-31f2-b36e-3e764857958b",
                        "target_lang_word": "thermonuklear",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermonuklear",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "214e54f2-efa2-3914-964e-5bf53b8dcaf5",
                                        "entry_id": "2e3a3e05-90b2-3505-84f1-2e69d5e61c32",
                                        "glosses": [
                                            "die bei einer Kernreaktion auftretende Wärme betreffend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b01156ee-005e-434b-9342-6d35f6fdd50d",
                                                "sense_id": "214e54f2-efa2-3914-964e-5bf53b8dcaf5",
                                                "text": "Im Weltall spielt sich die Kernverschmelzung in den Sternen, wie etwa unserer Sonne, in gesteuerter Weisse ab und spendet seit Jahrmilliarden ohne Gleichgewichtsstörung thermonukleare Energie."
                                            },
                                            {
                                                "example_id": "9fefe1b3-5904-4edd-a094-50e35da8e4c2",
                                                "sense_id": "214e54f2-efa2-3914-964e-5bf53b8dcaf5",
                                                "text": "Die thermonukleare Energie aus diesem Prozess startet eine Kettenreaktion in deren Folge das zuvor akkumulierte Gas explodiert, wobei der Weiße Zwergstern jedoch intakt bleibt."
                                            },
                                            {
                                                "example_id": "093efd2e-a6db-458c-8b8e-06dba1e20227",
                                                "sense_id": "214e54f2-efa2-3914-964e-5bf53b8dcaf5",
                                                "text": "Im Ausland wird die Darstellung über die Zündung einer solchen H-Bombe oder thermonuklearen Bombe, die viel stärker wäre als eine herkömmliche Atombombe, bezweifelt."
                                            },
                                            {
                                                "example_id": "bbf68b33-9bdb-4ee6-8081-857962faf7d0",
                                                "sense_id": "214e54f2-efa2-3914-964e-5bf53b8dcaf5",
                                                "text": "Diese wären mit thermonuklearen Waffen angegriffen worden, die große Gebiete in der Umgebung radioaktiv verseucht hätten."
                                            },
                                            {
                                                "example_id": "1f0f08f1-06cc-4471-b52d-16dbb6e2f63e",
                                                "sense_id": "214e54f2-efa2-3914-964e-5bf53b8dcaf5",
                                                "text": "Doch Wladimir Netschaj hat es mit seinem Tod jedermann offenbart: Im Rußland von heute kann niemand die Sicherheit der thermonuklearen Programme garantieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
