        "fr-extract.jsonl": [
            {
                "entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                "word": "raskolnik",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9df2f87-d5e5-4f8c-a4d1-97c77e7f8a52",
                        "entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                        "tags": [
                            "plural"
                        ],
                        "form": "raskolniks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                        "entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                        "glosses": [
                            "Sectateur du raskol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40bb4487-18a8-45b2-bb4d-3d558162858e",
                                "sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                                "text": "Les raskolniks, qui étaient devenus très nombreux en Russie et se divisaient en sectes diverses, n'acceptaient pas ce nom, dans lequel ils voyaient une injure. Ils se nommaient eux-mêmes vieux croyants, mais orthodoxes, et traitent leurs adversaires de nikoniens."
                            },
                            {
                                "example_id": "a11a8b56-77b7-4bcf-bfb2-f553563f8df7",
                                "sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                                "text": "De par son nom Raspoutine est donc déjà un rebelle, un raskolnik."
                            },
                            {
                                "example_id": "51142387-bd77-4d03-9650-d45275214e45",
                                "sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                                "text": "D’après Stanislas Plater, la Pologne, en 1765, sur 20 millions d’habitants, possédait environ 8 million de catholiques romains, près de 4 millions de catholiques grecs, 3 millions de catholiques schismatiques, 2 millions de protestants, 2 millions d’israélites, près de 200.000 raskolniks ou espèces de bohémiens et de missionnaires russes, et 56.000 mahométans."
                            },
                            {
                                "example_id": "b980a014-19c0-412c-83d3-b5b060854eae",
                                "sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                                "text": "Le nombre des femmes de raskolniks envoyées pour ce crime [infanticide] en Sibérie se compte par milliers."
                            },
                            {
                                "example_id": "3177ea03-54a2-4572-ad9a-f3ac4db8bf54",
                                "sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                                "text": "Encore aujourd’hui il est des raskolniks en rébellion systématique contre les procédés élémentaires de l’État."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e129739a-c8b5-435c-b9b3-ea320ad6d662",
                        "source_entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                        "source_sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                        "target_lang_word": "Raskolnik",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raskolnik",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39b14c7-e90b-327a-a372-e62627d704ea",
                                        "entry_id": "86261cee-bc01-3afd-8ff7-40634dda1381",
                                        "glosses": [
                                            "Any of those who separated from the official Russian Orthodox Church after 1666 as a protest against church reforms introduced by Patriarch Nikon between 1652 and 1666."
                                        ],
                                        "tags": [
                                            "historical",
                                            "offensive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "885a296d-664b-4d0e-b076-cb510fb193b7",
                        "source_entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                        "source_sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                        "target_lang_word": "Old Believer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Old Believer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb52cbc9-61b8-3f21-9449-1cd094e0949f",
                                        "entry_id": "727f8776-d4d5-39e0-bb76-c0db6862cf64",
                                        "glosses": [
                                            "Any of those who separated from the official Russian Orthodox Church after 1666 as a protest against the church reforms introduced by Patriarch Nikon between 1652 and 1666. They continue liturgical and ritual practices which predate the reforms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "741ff6b2-f24e-41d5-af34-968c6e0035fa",
                        "source_entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                        "source_sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                        "target_lang_word": "раскольник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "раскольник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "688cfd0d-fc52-3480-897a-ee07b0db41c4",
                                        "entry_id": "75622d54-0189-3fdb-a5b9-14bb9a4b8a69",
                                        "glosses": [
                                            "разг., неодобр. тот, кто создаёт раскол в какой-либо организации, вносит разлад в какое-либо общее дело, способствует расколу, разладу в них"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab82025-7883-4e32-a5bc-0321bde795e4",
                                                "sense_id": "688cfd0d-fc52-3480-897a-ee07b0db41c4",
                                                "text": "Словно удары хлыста по щеке, стегнули Дмитрия гневные восклицания: — Позор! — Долой раскольников!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "раскольник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2c59f736-cb1a-3f0c-bde8-79f68313a74a",
                                        "entry_id": "424c1aa5-6f33-3b23-9aef-82e184522462",
                                        "glosses": [
                                            "истор. участник раскола в значении «религиозно-общественное движение, результатом которого явилось отделение от Русской православной церкви части верующих, не признавших церковные реформы патриарха Никона, стремившихся к сохранению прежних традиций в церковной жизни и обрядности (в Российском государстве в 1653–1656 гг.)»"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5779bf8e-1caf-4ab1-832b-68b71580ff77",
                                                "sense_id": "2c59f736-cb1a-3f0c-bde8-79f68313a74a",
                                                "text": "Раскольники почуяли измену в церкви и государстве, они перестали верить в святость иерархической власти в русском царстве."
                                            },
                                            {
                                                "example_id": "8f223e1d-576b-49be-983d-d63cc8f8fccd",
                                                "sense_id": "2c59f736-cb1a-3f0c-bde8-79f68313a74a",
                                                "text": "Мы ведь не называем еретиком или раскольником буддиста, мусульманина или язычника: чтобы быть еретиком или раскольником, надо быть христианином."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474ed792-b074-3727-80c1-0ad8b7f19961",
                                        "entry_id": "424c1aa5-6f33-3b23-9aef-82e184522462",
                                        "glosses": [
                                            "религ. член одной из сект, принадлежащих к расколу в значении «вероучение, возникшее в результате такого религиозно-общественного движения; старообрядчество»; последователь раскола; старообрядец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dcf811b-efac-4f9e-b745-8a8ad832c596",
                                                "sense_id": "474ed792-b074-3727-80c1-0ad8b7f19961",
                                                "text": "Раскольники учат: «Щепоть есть кукиш, раздвинь пальцы, большой сунь меж ними.»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe91d5cb-78ed-4c8c-ba78-b38db69154c1",
                        "source_entry_id": "1881bb6a-2976-3bd9-ae02-a0aeaa92fa94",
                        "source_sense_id": "f25d2334-a933-3293-8865-b420e8ff41d8",
                        "target_lang_word": "старовер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "старовер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7cb2683c-1f0f-324a-9831-246117c2de2b",
                                        "entry_id": "5a63836f-30dc-398e-b655-630a59edbd78",
                                        "glosses": [
                                            "истор., религ. то же, что старообрядец; православный, не принявший церковной реформы XVII века"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faf26213-3137-4b81-8a1d-c3b18cd70cd9",
                                                "sense_id": "7cb2683c-1f0f-324a-9831-246117c2de2b",
                                                "text": "А он же старовер, Карп-то Иваныч."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7c722de-6a58-348d-b398-f347735c60d1",
                                        "entry_id": "5a63836f-30dc-398e-b655-630a59edbd78",
                                        "glosses": [
                                            "перен., ирон. человек, придерживающийся старых мнений, устоев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75fce72-9900-4169-a260-d94dfd3df276",
                                                "sense_id": "b7c722de-6a58-348d-b398-f347735c60d1",
                                                "text": "И кроме того, я, старовер, люблю, чтобы сонеты были сонетами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
