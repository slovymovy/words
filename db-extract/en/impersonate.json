                    },
                    {
                        "form_id": "36b2c308-8437-459f-b08d-011d25203ec5",
                        "entry_id": "4ebe6497-b83b-39df-bc2c-927861c31f21",
                        "tags": [
                            "past"
                        ],
                        "form": "impersonated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0239ea2-cf02-3064-9f77-f502d644b78c",
                        "entry_id": "4ebe6497-b83b-39df-bc2c-927861c31f21",
                        "glosses": [
                            "To pretend to be (a different person); to assume the identity of, especially when there is an intent to deceive."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae541be-7cea-461e-9cf7-2f2ded00480f",
                                "sense_id": "c0239ea2-cf02-3064-9f77-f502d644b78c",
                                "text": "The conman managed to impersonate several executives."
                            },
                            {
                                "example_id": "f790946c-5b51-4bde-b845-d85dab1b293e",
                                "sense_id": "c0239ea2-cf02-3064-9f77-f502d644b78c",
                                "text": "Evil can and will always impersonate goodness."
                            }
                        ]
                    },
                    {
                        "sense_id": "5be216c2-3c59-3ba2-801b-a03d6f3a7d47",
                        "entry_id": "4ebe6497-b83b-39df-bc2c-927861c31f21",
                        "glosses": [
                            "To operate with the permissions of a different user account."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "661b0971-4b9a-3e92-9e00-e9628e21730b",
                        "entry_id": "4ebe6497-b83b-39df-bc2c-927861c31f21",
                        "glosses": [
                            "To manifest in corporeal form; to personify."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "fc5d353f-c037-4570-8b35-69f59f0599ce",
                                "sense_id": "661b0971-4b9a-3e92-9e00-e9628e21730b",
                                "text": "The shepherds were impersonated, then the Magi, finally Herod himself. In course of time all the elements of a fully developed Nativity play had thus been introduced."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ea0a396-fdff-4eeb-8746-88084a22b938",
                        "source_entry_id": "4ebe6497-b83b-39df-bc2c-927861c31f21",
                        "source_sense_description": "assume the identity of",
                        "target_lang_word": "imiter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imiter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb64146-a5fd-3f73-a9ba-3e5037fa2f79",
                                        "entry_id": "2f760fa5-0a94-3c36-80c2-c2c921f6f98d",
                                        "glosses": [
                                            "Faire ou s’efforcer de faire exactement la même chose que fait une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87129546-6f9b-4bec-b47c-cf3f64896864",
                                                "sense_id": "8eb64146-a5fd-3f73-a9ba-3e5037fa2f79",
                                                "text": "Imitez-le dans tout ce que vous lui verrez faire."
                                            },
                                            {
                                                "example_id": "557b9f07-704e-4c42-a4e2-8c8bbdbd699d",
                                                "sense_id": "8eb64146-a5fd-3f73-a9ba-3e5037fa2f79",
                                                "text": "Le singe imite l’homme."
                                            },
                                            {
                                                "example_id": "156d9393-d06b-4888-9e7d-bd6c076d1dee",
                                                "sense_id": "8eb64146-a5fd-3f73-a9ba-3e5037fa2f79",
                                                "text": "Imiter les manières, la voix de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05565562-2920-3438-8f17-47325e15521a",
                                        "entry_id": "2f760fa5-0a94-3c36-80c2-c2c921f6f98d",
                                        "glosses": [
                                            "Prendre la conduite, les actions d’une personne pour modèle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b37b21e3-49af-465a-bae0-b94cc34af5f2",
                                                "sense_id": "05565562-2920-3438-8f17-47325e15521a",
                                                "text": "Il y a toujours, dans l'imagination d'un gamin de quinze ans, quelque modèle dont il imite jusqu'à la voix."
                                            },
                                            {
                                                "example_id": "ef527bb4-a225-4e1f-8cd9-ecabcb56a6fb",
                                                "sense_id": "05565562-2920-3438-8f17-47325e15521a",
                                                "text": "Imiter ses ancêtres; imiter leurs vertus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d934fd6d-a3ea-3f99-9324-c1553494b587",
                                        "entry_id": "2f760fa5-0a94-3c36-80c2-c2c921f6f98d",
                                        "glosses": [
                                            "Faire l’image, la ressemblance d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca5cb43-e3dc-4e80-ab29-1376b1a8eae7",
                                                "sense_id": "d934fd6d-a3ea-3f99-9324-c1553494b587",
                                                "text": "Ce peintre, ce sculpteur s’attache à bien imiter la nature."
                                            },
                                            {
                                                "example_id": "65895768-086a-4484-9b53-f15d1bdbfee5",
                                                "sense_id": "d934fd6d-a3ea-3f99-9324-c1553494b587",
                                                "text": "La musique imite le bruit du tonnerre, les gémissements, les cris, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "982be43c-e5a0-396e-8d84-da9c7c67d309",
                                        "entry_id": "2f760fa5-0a94-3c36-80c2-c2c921f6f98d",
                                        "glosses": [
                                            "S’efforcer de prendre, dans ses compositions, le style, le genre, la manière d’un autre, en parlant d’un écrivain, d’un artiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3ee1d2-141f-45b5-920e-f5522f8001d8",
                                                "sense_id": "982be43c-e5a0-396e-8d84-da9c7c67d309",
                                                "text": "Il se souvint tout à coup d'une vieille chronique où il avait […] projeté le feu rouge des catachrèses les plus imprévues, des synecdoches les plus arbitraires, des antonomases les plus follement tirées par les cheveux, imitant et plagiant même, en ces débordement insensés, la phraséologie vitupérante et l'inouïssime du dénommé Léon Bloy, magicien de l'Expression, brasseur de bran, tritureur de matière fécale et orfèvre du sublime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f672945c-2268-30db-9570-f2f2d90915ec",
                                        "entry_id": "2f760fa5-0a94-3c36-80c2-c2c921f6f98d",
                                        "glosses": [
                                            "Rédiger un ouvrage dont l’idée principale, le plan, etc., lui ont été suggérés par l’ouvrage d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64f0cdd-3434-410a-8fa6-b5b60f54abef",
                                                "sense_id": "f672945c-2268-30db-9570-f2f2d90915ec",
                                                "text": "Imiter Cicéron, Virgile, etc."
                                            },
                                            {
                                                "example_id": "82c3a747-195b-4434-b1df-9a45e7487e02",
                                                "sense_id": "f672945c-2268-30db-9570-f2f2d90915ec",
                                                "text": "Imiter la manière des grands maîtres."
                                            },
                                            {
                                                "example_id": "7ce8f689-1ee8-40e1-87fe-922d97deb5ec",
                                                "sense_id": "f672945c-2268-30db-9570-f2f2d90915ec",
                                                "text": "Ce tableau est imité de Raphaël."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c75e28ee-be03-3099-b2e7-857980ea9236",
                                        "entry_id": "2f760fa5-0a94-3c36-80c2-c2c921f6f98d",
                                        "glosses": [
                                            "Ressembler à, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d5c465-9427-490a-8796-e9b174986bcd",
                                                "sense_id": "c75e28ee-be03-3099-b2e7-857980ea9236",
                                                "text": "Cette pierre imite bien le rubis."
                                            },
                                            {
                                                "example_id": "817403c3-4aa0-4201-a5d9-0fac58198b8d",
                                                "sense_id": "c75e28ee-be03-3099-b2e7-857980ea9236",
                                                "text": "Ce papier imite le velours."
                                            },
                                            {
                                                "example_id": "b91e5eee-9d7b-45e8-bb05-7b3b4010ac08",
                                                "sense_id": "c75e28ee-be03-3099-b2e7-857980ea9236",
                                                "text": "Le bruit de cette cataracte imite celui du tonnerre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "947da99e-10f2-4b0c-8007-37e831fce159",
