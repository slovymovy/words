                        "glosses": [
                            "Synonym of Rutog; a place in Tibet, China: the Mandarin Chinese-derived name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3b7fb1-c440-465a-897f-7761bb4d439e",
                                "sense_id": "56bb1f9c-3d71-3f64-bfea-6fc98431ddb6",
                                "text": "Among the 343 counties, 143 have per capita income above 200 yuan, 22 above 300, and 5 above 400. The highest is recorded in the Tibetan region whose Ritu county has scored 488.47 yuan."
                            },
                            {
                                "example_id": "a7b779ba-9345-410c-9dcf-4ddf96ffdb01",
                                "sense_id": "56bb1f9c-3d71-3f64-bfea-6fc98431ddb6",
                                "text": "At Duoma, in Ritu County, the early Early Permian Qudi formation contains coldwater fossils including Oriocrassaella intermedia lamel libranchs."
                            },
                            {
                                "example_id": "79b17808-8b5b-475b-bc79-af6ee9bbf204",
                                "sense_id": "56bb1f9c-3d71-3f64-bfea-6fc98431ddb6",
                                "text": "The bridge will cut the travel distance between the PLA position and a military base in Rutog (in Chinese, Ritu) county, Ngari prefecture, in far-western Tibet Autonomous Region by about 150 kilometers (93 miles), making it easier for Chinese troops to counter Indian forces if future flare-ups arise."
                            }
                        ]
                    }
