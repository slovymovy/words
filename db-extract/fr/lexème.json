                    {
                        "translation_id": "2157c752-08d7-497b-ae9f-8ba11e56bade",
                        "source_entry_id": "cbf46008-1d75-3476-a987-ba90edb4f983",
                        "target_lang_word": "語彙素",
                        "target_lang_code": "ja",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "語彙素",
