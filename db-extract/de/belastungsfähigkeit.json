                "senses": [
                    {
                        "sense_id": "18533232-6c72-36f4-908e-b5781737c4f8",
                        "entry_id": "780d644a-9ac0-3fee-a000-ccd5330d0bca",
                        "glosses": [
                            "Eigenschaft oder Fähigkeit, etwas (einem Gewicht, einer Belastung) standhalten zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03230160-c667-45a4-9a07-6e2f0b0cb43b",
                                "sense_id": "18533232-6c72-36f4-908e-b5781737c4f8",
                                "text": "„Nicht überall sind die Folgen so gravierend wie in der Ukraine, wo der Gesundheitsminister das medizinische System schon vorige Woche an der Grenze der Belastungsfähigkeit sah.“"
                            },
                            {
                                "example_id": "d430acb7-885d-475a-b034-4061dd7a40c7",
                                "sense_id": "18533232-6c72-36f4-908e-b5781737c4f8",
                                "text": "„Kein Wunder, dass es viele Menschen an den Rand ihrer Belastungsfähigkeit bringt, wenn sie plötzlich relativiert werden.“"
                            },
                            {
                                "example_id": "16826992-d814-4221-8131-cc2c041ecbf0",
                                "sense_id": "18533232-6c72-36f4-908e-b5781737c4f8",
                                "text": "„Wer die 500 Meilen zu Ende bringt, gelangt ans Limit seiner körperlichen Belastungsfähigkeit.“"
                            },
                            {
                                "example_id": "e31ea081-3104-44d8-afe5-509fd1a52a65",
                                "sense_id": "18533232-6c72-36f4-908e-b5781737c4f8",
                                "text": "„Die Gehäuse der Geräte seien aus festem Aluminium hergestellt und auf Belastungsfähigkeit getestet worden.“"
                            },
                            {
                                "example_id": "cc924421-79c1-4e10-847c-3d888acf9c06",
                                "sense_id": "18533232-6c72-36f4-908e-b5781737c4f8",
                                "text": "„Die Belastungsfähigkeit seiner Spieler bei einem Turnier mit ‚Weltklassemannschaften‘ als Gegner schon in der Vorrunde sieht der Trainer als eines der entscheidenden Kriterien an.“"
                            }
                        ],
