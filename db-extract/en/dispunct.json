                        "examples": [
                            {
                                "example_id": "470582f9-6675-4da1-9dd1-73b07870dfeb",
                                "sense_id": "4a3a57a1-a403-352f-aa66-16d8cc826097",
                                "text": "I desire the Reder then so to take me, as though I did not deal here withal, nor speak of the matter, but utterly to haue pretermitted, and dispuncted the same."
                            },
                            {
                                "example_id": "43de0f4e-221c-4b62-a5ab-cdf68d909d49",
                                "sense_id": "4a3a57a1-a403-352f-aa66-16d8cc826097",
                                "text": "... all beyond Carthage, as Mauritania, & c., would wind up into a small inconsiderable tract, as being dispuncted by no great states or colonies."
                            }
                        ]
                    }
