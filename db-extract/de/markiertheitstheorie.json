                "senses": [
                    {
                        "sense_id": "ce269174-fe7b-3938-8e12-2900331a8a94",
                        "entry_id": "f33af207-5773-33eb-a44e-b42c9990f8e9",
                        "glosses": [
                            "Theorie der Markiertheit, vor allem in Morphologie und Phonologie, bei der verwandte grammatische oder phonologische Kategorien als Gegensatzpaare aufgefasst und daraufhin untersucht werden, welches Element davon markiert, welches unmarkiert ist. Grundidee dabei ist, dass zwischen der Form von sprachlichen Einheiten und ihrer Bedeutung oder grammatischen Funktion ein enger Zusammenhang besteht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb989411-2d97-48bb-8e12-53a715fbe643",
                                "sense_id": "ce269174-fe7b-3938-8e12-2900331a8a94",
                                "text": "Die Markiertheitstheorie entstand in der sog. Prager Schule in den 1930er Jahren."
                            },
                            {
                                "example_id": "10ea97c2-1988-4a5f-989d-3b428cb5eb66",
                                "sense_id": "ce269174-fe7b-3938-8e12-2900331a8a94",
                                "text": "Ein Beispiel zur Markiertheitstheorie: Plural bedeutet im Allgemeinen mehr als Singular; entsprechend wird der Singular im Deutschen morphologisch nicht mit einem eigenen Morphem versehen, während der Plural morphologisch repräsentiert wird. Die Form \"Kind\" ist unmarkiert für den Numerus, die Form \"Kinder\" dagegen ist markiert durch \"-er\" für Plural. Solche Verhältnisse werden dann als mehr oder weniger natürlich interpretiert."
                            },
                            {
                                "example_id": "39af63af-2d4b-4f7e-a111-fd976809a871",
                                "sense_id": "ce269174-fe7b-3938-8e12-2900331a8a94",
                                "text": "„Es soll nun versucht werden, die bisherigen Überlegungen zur morphologischen Markiertheitstheorie (…) zusammenzufassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
