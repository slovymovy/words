                        "entry_id": "f9fbdf65-05cd-37ef-9062-de63f2831379",
                        "glosses": [
                            "Partie saillante de l’oreille chez la chauve-souris."
                        ],
                        "tags": [
                            "Chiroptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "ec0ba0a1-ce70-4e10-b0d8-26f9b3c60732",
                                "sense_id": "93867adb-6830-3ff7-a83a-3b0d13df9db3",
                                "text": "La plupart ont la tète surmontée par quatre oreillons, toutes out les yeux petits, obscurs et couverts, le nez ou plutôt les naseaux informes, la gueule fendue de l’une à l'autre oreille […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c2d2c23-94cb-3471-bd6a-93bde9e26b9c",
                        "entry_id": "f9fbdf65-05cd-37ef-9062-de63f2831379",
                        "glosses": [
                            "Partie d’un casque qui protège les oreilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edcd9558-3403-4da0-98a2-a5ab078a3b73",
                                "sense_id": "2c2d2c23-94cb-3471-bd6a-93bde9e26b9c",
                                "text": "Les aviateurs portent des casques à oreillons."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fa2da87-95fd-3496-be47-38618b4b3167",
                        "entry_id": "f9fbdf65-05cd-37ef-9062-de63f2831379",
                        "glosses": [
                            "Parties saillantes de chaque côté d’un objet."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "12207f76-0281-4c86-9ab5-f4f59c8567aa",
                                "sense_id": "8fa2da87-95fd-3496-be47-38618b4b3167",
                                "text": "C’était une de ces gourdes revêtues d’osier, larges et plates, à oreillons, qu’on se pendait au côté par une courroie, et qu’on appelait alors « gourdes de hanche »."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dce0171-e727-3e11-94b0-0f59dc37358b",
