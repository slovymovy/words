                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anakolut",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "95d8f735-d135-3a4d-a3c9-5d912615c353",
                                        "entry_id": "decb4180-24a2-3176-91b6-e301edfea8d5",
                                        "glosses": [
                                            "vyšinutí z větné vazby"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88eaecd3-bc4f-4a3d-a2ba-9fd3703befbd",
                                                "sense_id": "95d8f735-d135-3a4d-a3c9-5d912615c353",
                                                "text": "Když jsem v říjnu 1950 nastoupil v dnes už neexistujících kasárnách pěšího pluku 35 základní vojenskou službu, patřil k mým prvním dojmům nápadný nápis v jídelně: „Kdo přijde pozdě, nic mu nedají.“ Anakolut, a docela pěkný. Poznamenal jsem si ho (ovšem nenápadně) a později zařadil do kartotéky."
                                            },
                                            {
                                                "example_id": "08b8c796-9af9-4d08-a5a4-fcd2b74377d2",
                                                "sense_id": "95d8f735-d135-3a4d-a3c9-5d912615c353",
                                                "text": "Postoje k typickým mluvenostním jevům, jako jsou elipsy, anakoluty, parenteze atp. hodnotí ve svém příspěvku A. Bettenová (Eichstätt)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
