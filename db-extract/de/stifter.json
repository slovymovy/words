                        "examples": [
                            {
                                "example_id": "3d10f0bf-d653-43e4-b7a0-fdc9e49f02cf",
                                "sense_id": "7a8b9226-1ceb-38e5-8c20-48658ea7cbd6",
                                "text": "„Eigentum verpflichtet - nach diesem Motto handeln die meisten Stifter und setzten sich für Notleidende oder gegen ein konkretes Problem ein.“"
                            },
                            {
                                "example_id": "70776c61-b427-4d7a-a41f-71e5470bb967",
                                "sense_id": "7a8b9226-1ceb-38e5-8c20-48658ea7cbd6",
                                "text": "„Niemand nahm es so genau, denn man hätte den edlen Stifter ja verärgern können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
