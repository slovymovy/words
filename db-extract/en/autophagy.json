                        "source_entry_id": "14f58f45-a236-372c-bc8d-a7ccb8f5d718",
                        "source_sense_description": "the process of self-digestion",
                        "target_lang_word": "Autophagie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autophagie",
