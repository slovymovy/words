        "ru-extract.jsonl": [
            {
                "entry_id": "847e8659-13b4-392f-9594-bd077317b7aa",
                "word": "отчётливо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ac37627a-aaa7-30fe-86c6-891d9f40b679",
                        "entry_id": "847e8659-13b4-392f-9594-bd077317b7aa",
                        "glosses": [
                            "наречие к отчётливый; так, чтобы все детали, тонкости хорошо воспринимались, были заметны, различимы"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "48542f15-4c06-4ec7-bbc4-c106398448e7",
                                "sense_id": "ac37627a-aaa7-30fe-86c6-891d9f40b679",
                                "text": "У больных после исчезновения протекавшей в течение многих месяцев деперсонализации начинали отчётливо проявляться и нарастать признаки эмоционально-волевого дефекта, нарушения мышления в виде резонёрства, иногда появлялись идеи отношения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "589a5212-f007-48d1-9415-b3ed9772880a",
                        "source_entry_id": "847e8659-13b4-392f-9594-bd077317b7aa",
                        "source_sense_id": "ac37627a-aaa7-30fe-86c6-891d9f40b679",
                        "target_lang_word": "distinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                        "entry_id": "1f7f69ac-9ac5-3c15-9fe6-5b93d07b8175",
                                        "glosses": [
                                            "In a distinct manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b7c8ad-6f9a-4d63-93e4-423615b8f2d5",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "I distinctly remember the voice of my deceased grandmother."
                                            },
                                            {
                                                "example_id": "59ebcc5d-34fd-46d6-a259-95a81ece9046",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "About ten months ago a report reached my ears that a Dutchman had constructed a telescope, by the aid of which visible objects, although at a great distance from the eye of the observer, were seen distinctly as if near; […]"
                                            },
                                            {
                                                "example_id": "6b4671bb-65bf-4869-955d-5f8f218c0e36",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy."
                                            },
                                            {
                                                "example_id": "4e0abc77-efc2-4fce-8d94-fbe6beef251d",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "\"Aloud,\" he said distinctly, \"the Seven Words are spoken thus. Melenkurion abatha. Duroc minas mill. Harad khabaal.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "140f8444-ea77-4e2a-a885-26761e636480",
                        "source_entry_id": "847e8659-13b4-392f-9594-bd077317b7aa",
                        "source_sense_id": "ac37627a-aaa7-30fe-86c6-891d9f40b679",
                        "target_lang_word": "clearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "In a clear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695f2aec-9e34-4b70-ad5a-60b7557941e6",
                                                "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                                "text": "He enunciated every syllable clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "Without a doubt; obviously."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7744b0e0-d2f5-43ee-88ca-65eef287f79f",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "Clearly, the judge erred in his opinion."
                                            },
                                            {
                                                "example_id": "ebcc9eea-220f-4d40-829a-f7630f78b950",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "While Gunners boss Arsene Wenger had warned his players against letting the pre-match festivities distract them from the task at hand, they clearly struggled for fluency early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "To a degree clearly discernible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4633d05-925e-4e13-9124-451a88013cab",
                                                "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                                "text": "He was clearly wrong on all points but one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5470a52f-ae40-4ef6-91a9-60922bc36cec",
