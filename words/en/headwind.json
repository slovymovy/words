{
    "word_family": [
        "head",
        "wind"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d361d069-2ef6-34b7-90ea-dc8eb7ac3f37",
                    "sense_definition": "A wind blowing directly against the direction of travel of a vehicle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wind_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot had to use more fuel because of the strong <w>headwind</w> during the flight.",
                            "target_lang_translations": {
                                "pl": "Pilot musiał zużyć więcej paliwa z powodu silnego <w>wiatru czołowego</w> podczas lotu."
                            }
                        },
                        {
                            "text": "The ship struggled to maintain its speed while sailing into a powerful <w>headwind</w>.",
                            "target_lang_translations": {
                                "pl": "Statek z trudem utrzymywał prędkość, płynąc pod silny <w>wiatr czołowy</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "tailwind"
                    ],
                    "common_phrases": [
                        "strong headwind",
                        "face a headwind"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wiatr wiejący bezpośrednio w kierunku przeciwnym do kierunku poruszania się pojazdu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wiatr czołowy",
                                "target_lang_sense_clarification": "standardowe określenie wiatru utrudniającego ruch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c68fc909-6bca-3dcc-bcf7-ceaa13fd601f",
                    "sense_definition": "A force or situation that slows down or prevents progress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hindrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced significant economic <w>headwinds</w> that delayed their expansion plans.",
                            "target_lang_translations": {
                                "pl": "Firma napotkała znaczące <w>przeciwności ekonomiczne</w>, które opóźniły jej plany ekspansji."
                            }
                        },
                        {
                            "text": "Rising interest rates are creating <w>headwinds</w> for the housing market this year.",
                            "target_lang_translations": {
                                "pl": "Rosnące stopy procentowe <w>hamują</w> w tym roku rynek mieszkaniowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "obstacle",
                        "hindrance",
                        "setback"
                    ],
                    "common_phrases": [
                        "economic headwinds",
                        "face headwinds"
                    ],
                    "target_lang_definitions": {
                        "pl": "Siła lub sytuacja, która spowalnia lub uniemożliwia postęp w jakiejś dziedzinie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeciwności",
                                "target_lang_sense_clarification": "ogólne określenie trudności"
                            },
                            {
                                "target_lang_word": "bariery",
                                "target_lang_sense_clarification": "czynniki hamujące rozwój"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32df3d14-c85b-3e1c-b8e0-cb9606be1fe4",
                    "sense_definition": "To blow directly against the path of a vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wind_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm began to <w>headwind</w> the small plane as it approached the runway.",
                            "target_lang_translations": {
                                "pl": "Burza zaczęła <w>wiać w twarz</w> małemu samolotowi, gdy zbliżał się do pasa startowego."
                            }
                        },
                        {
                            "text": "Strong gusts continued to <w>headwind</w> the ship throughout the entire journey.",
                            "target_lang_translations": {
                                "pl": "Silne podmuchy wiatru <w>wiały w twarz</w> statkowi przez całą podróż."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wiać bezpośrednio przeciwko drodze pojazdu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wiać w twarz",
                                "target_lang_sense_clarification": "idiomatyczne określenie wiatru wiejącego z naprzeciwka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46dbad24-2233-3c06-a41a-f2d11cd66f7a",
                    "sense_definition": "To act as a force that slows down or reverses progress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hindrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New regulations may <w>headwind</w> the growth of the startup sector.",
                            "target_lang_translations": {
                                "pl": "Nowe przepisy mogą <w>hamować</w> rozwój sektora startupów."
                            }
                        },
                        {
                            "text": "High inflation continues to <w>headwind</w> the recovery of the local economy.",
                            "target_lang_translations": {
                                "pl": "Wysoka inflacja nadal <w>utrudnia</w> ożywienie lokalnej gospodarki."
                            }
                        }
                    ],
                    "synonyms": [
                        "impede",
                        "hinder",
                        "obstruct"
                    ],
                    "target_lang_definitions": {
                        "pl": "Działać jako siła, która spowalnia lub cofa postęp."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "hamować",
                                "target_lang_sense_clarification": "powodować spowolnienie rozwoju"
                            },
                            {
                                "target_lang_word": "utrudniać",
                                "target_lang_sense_clarification": "stawiać przeszkody w procesie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}