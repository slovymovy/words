                "senses": [
                    {
                        "sense_id": "3c19c783-ae21-3467-9361-080a04acf9b6",
                        "entry_id": "5dd3c310-b380-3579-ab66-1c9823271e35",
                        "glosses": [
                            "Konvention über bestimmte Regeln beim Verfassen von Texten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dec97944-81e4-45dd-beeb-c29101ac2c0a",
                                "sense_id": "3c19c783-ae21-3467-9361-080a04acf9b6",
                                "text": "„Bei bestimmten Textgattungen bildeten sich in dieser Hinsicht zum Teil feste Schreibkonventionen heraus"
                            },
                            {
                                "example_id": "2441aded-8776-4f35-a0ce-9b89ccf45816",
                                "sense_id": "3c19c783-ae21-3467-9361-080a04acf9b6",
                                "text": "„Diese Schreibkonvention stammt aus der Zeit, als die Mehrzahl der chinesischen Wörter einsilbig waren und mit je einem Zeichen geschrieben wurden, als also keine Veranlassung bestand, Wortgrenzen graphisch zu markieren (…).“"
                            },
                            {
                                "example_id": "a8754ac4-831b-405a-9770-4b014523b142",
                                "sense_id": "3c19c783-ae21-3467-9361-080a04acf9b6",
                                "text": "„Die Schreibkonvention gibt Viererblöcke für die IBAN vor, im digitalen Datensatz fehlen die Zwischenräume selbstverständlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
