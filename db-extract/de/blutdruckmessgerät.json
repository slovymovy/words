                                        "entry_id": "48f9a539-b870-37a1-90f4-e2466464a50a",
                                        "glosses": [
                                            "Appareil destiné à mesurer la tension mécanique (force exercée en traction) nommé aussi tensomètre."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bad2017-16ed-4d58-8bea-925c512d64f3",
                                                "sense_id": "388a836d-3f05-3039-b759-324ba6672e0b",
                                                "text": "De nombreux tests permettent de mesurer ces propriétés, tels les tests de traction (tensiomètre), de succion (cutomètre), de torsion (twistomètre), la tonométrie, l'indentation et la balisto-métrie."
                                            }
                                        ]
                                    },
