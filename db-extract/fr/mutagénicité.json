                                        "entry_id": "59f2e7ff-b6e0-3945-805d-5c0342f07db4",
                                        "glosses": [
                                            "Capacidad de ocasionar alteraciones del material genético celular (genes, cromosomas) o producir mutaciones sobre el ADN, clonado o no. De realizarse in vitro, dicha alteración (mutagénesis) puede realizarse al azar, sobre cualquier secuencia, o bien de forma dirigida."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee48c3f-331e-4bac-93b0-134d13d72539",
                                                "sense_id": "53f175aa-c595-3601-87d8-522b8f06e00c",
                                                "text": "La mutagenicidad está directamente relacionada con la producción de malformaciones congénitas"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
