                "senses": [
                    {
                        "sense_id": "c21a948a-bfac-375d-960f-2881bf3f93ff",
                        "entry_id": "850a19db-3d6b-3832-b4a1-a8b3939f5db7",
                        "glosses": [
                            "związany z katakumbami, dotyczący katakumb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a72133-3659-46c9-b5ba-099b927167e7",
                                "sense_id": "c21a948a-bfac-375d-960f-2881bf3f93ff",
                                "text": "Nie sposób podczas jednej wycieczki zapoznać się z całym systemem katakumbowych korytarzy."
                            },
                            {
                                "example_id": "5ab89657-f90d-4c3b-9364-0f47b165d1d4",
                                "sense_id": "c21a948a-bfac-375d-960f-2881bf3f93ff",
                                "text": "Włoski album z malarstwem katakumbowym kosztował fortunę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fd22e609-71e1-35ef-aa18-e3d5e5f3bae2",
                        "entry_id": "850a19db-3d6b-3832-b4a1-a8b3939f5db7",
                        "glosses": [
                            "podziemny, nielegalny"
                        ],
                        "tags": [
