                                        "glosses": [
                                            "srst některých savců (zejména ovcí, koz a jaků) používaná pro výrobu textilních vláken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62728da-e8e8-44f8-a85b-b4cf111570e8",
                                                "sense_id": "fcb11fec-bf08-3c11-a62a-42736f42555e",
                                                "text": "Ovce jsou hospodářská zvířata chovaná pro mléko, maso a vlnu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26307fb1-bfc5-34c2-827c-17a9d029cf51",
                                        "entry_id": "7c960a1c-c0b4-3241-be56-724e3336b25c",
                                        "glosses": [
                                            "textilní vlákno spředené z vlny (1) nebo látka utkaná z tohoto vlákna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4106398-3c64-49c8-95dd-e22f9a780966",
                                                "sense_id": "26307fb1-bfc5-34c2-827c-17a9d029cf51",
                                                "text": "Na upletení jednoho svetru je potřeba asi 400 gramů vlny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f614cf49-d647-395c-9b5c-9c6e9a1db254",
                                        "entry_id": "7c960a1c-c0b4-3241-be56-724e3336b25c",
                                        "glosses": [
                                            "střídavý pohyb hladiny nahoru a dolů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25dbe00-301e-48eb-b8aa-b0795c9c9a3a",
                                                "sense_id": "f614cf49-d647-395c-9b5c-9c6e9a1db254",
                                                "text": "Zvedl se silný vítr a lodí zmítaly vysoké vlny."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a8fd45-3121-33bc-994c-c02aaf0f514b",
                                        "entry_id": "7c960a1c-c0b4-3241-be56-724e3336b25c",
                                        "glosses": [
                                            "porucha nebo změna hodnoty veličiny šířící se prostředím"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0a566c-d3a7-4f73-a159-899405742e68",
                                                "sense_id": "d2a8fd45-3121-33bc-994c-c02aaf0f514b",
                                                "text": "Radiové vlny k přenosu informací poprvé využil Guglielmo Marconi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f4338f-0c4f-3774-be92-9d3a6a20a3a0",
                                        "entry_id": "7c960a1c-c0b4-3241-be56-724e3336b25c",
                                        "glosses": [
                                            "povlovná, v prostoru vymezená nerovnost nebo deformace povrchu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e2059b-daf6-4b10-85e4-b1e27cce1e51",
                                                "sense_id": "57f4338f-0c4f-3774-be92-9d3a6a20a3a0",
                                                "text": "Lyžař přejel přes terénní vlnu tak rychle, že ztratil rovnováhu a málem upadl."
                                            },
                                            {
                                                "example_id": "23b85075-ea03-429c-aa6e-3ee0305d10ce",
                                                "sense_id": "57f4338f-0c4f-3774-be92-9d3a6a20a3a0",
                                                "text": "sušit vlasy do vln"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85464c94-558a-3875-829b-d75182504638",
                                        "entry_id": "7c960a1c-c0b4-3241-be56-724e3336b25c",
                                        "glosses": [
                                            "příchod jedinců nebo jiný jev objevující se současně nebo postupně na mnoha místech nebo mnoha chvílích rychle za sebou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0647899-ae3a-43d1-9510-9ef2b57a5aaf",
                                                "sense_id": "85464c94-558a-3875-829b-d75182504638",
                                                "text": "Mezi továrnami se šířila další vlna propouštění."
                                            },
