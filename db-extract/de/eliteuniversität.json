                    {
                        "sense_id": "661ccf1f-fb65-3edc-a76f-5c3bfbffc83b",
                        "entry_id": "25d900fa-34bb-36ad-833f-c1017f409b40",
                        "glosses": [
                            "Universität, die als besonders hochklassig angesehen wird und an der Menschen mit besonderer Befähigung oder besonderen Qualitäten ausgebildet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9962c35c-f279-4016-b9b6-23581a77d946",
                                "sense_id": "661ccf1f-fb65-3edc-a76f-5c3bfbffc83b",
                                "text": "Am Beginn ihres Aufstiegs stand ein Studium an einer Eliteunversität."
                            },
                            {
                                "example_id": "137bf3d9-174f-4c77-b097-38e3be3168af",
                                "sense_id": "661ccf1f-fb65-3edc-a76f-5c3bfbffc83b",
                                "text": "„Der Abschluss einer Eliteuniversität gilt als Eintrittskarte in die Welt der Macht.“"
                            },
                            {
                                "example_id": "caa536c8-5f99-4044-83fb-eed5297128da",
                                "sense_id": "661ccf1f-fb65-3edc-a76f-5c3bfbffc83b",
                                "text": "Die Kinder von Spitzenpolitikern studieren oft an ausländischen Eliteuniversitäten"
                            },
                            {
                                "example_id": "5d72cf9a-3682-4be8-a6ce-849a01da05f5",
                                "sense_id": "661ccf1f-fb65-3edc-a76f-5c3bfbffc83b",
                                "text": "„Um ihre Kinder in Eliteuniversitäten unterzubringen, sollen wohlhabende Firmenchefs, Unternehmer, Investoren und Prominente Bestechungsgelder gezahlt haben.“"
                            }
                        ],
