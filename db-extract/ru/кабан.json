                                                "example_id": "77f0d06a-7016-4cbc-95fd-cd81e2fcc914",
                                                "sense_id": "4ad7581d-d394-34bb-b5e3-1493af255ad2",
                                                "text": "„Er lag auf einer Pritsche auf einer kleinen Erhöhung des Fußbodens, und die Tiere lagen dicht neben ihm auf der anderen Seite des Lattenzauns, ein Eber, für sich in einem Koben, im zweiten eine Sau mit zwölf Ferkeln, und einige größere junge Schweine im dritten Koben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41a2acd3-e1ca-43c3-b211-635d58f7f006",
                        "source_entry_id": "1bf708a7-786e-350d-a4b9-35ae46874f38",
                        "source_sense_description": "дикое парнокопытное млекопитающее",
                        "target_lang_word": "Keiler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keiler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ff010bc-8c7a-3a0e-b9cb-48ac303a8896",
                                        "entry_id": "2adb089c-f4ea-384f-ac4a-9f0d58f1ebdb",
                                        "glosses": [
                                            "männliches Wildschwein"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1bb241b-3ed5-4be2-8397-0faf50eb7547",
                                                "sense_id": "5ff010bc-8c7a-3a0e-b9cb-48ac303a8896",
                                                "text": "„So fürchterlich diese wilden Bachen oft sind, so sind die Keiler doch weit grausamer und gefährlicher. Ich traf einst einen im Walde an, als ich unglücklicherweise weder auf Angriff noch Verteidigung gefaßt war. Mit genauer Not konnte ich noch hinter einen Baum schlüpfen, als die wütende Bestie aus Leibeskräften einen Seitenhieb nach mir tat.“"
                                            },
                                            {
                                                "example_id": "0f79a8f5-34b1-4360-bab7-dc3d2a65df15",
                                                "sense_id": "5ff010bc-8c7a-3a0e-b9cb-48ac303a8896",
                                                "text": "„Aber ich glaube, bei weiterem Zuspruch an klaren Schnäpsen hätte ich auch versprochen, einen Keiler mit Pfeil und Bogen zu erlegen, so gebauchpinselt wie ich mich fühlte, denn in dem Bottich sollen schon Goethe und die Gebrüder Grimm gebadet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b79e00db-b5e4-37ae-90b8-1af2b09f7894",
                                        "entry_id": "2adb089c-f4ea-384f-ac4a-9f0d58f1ebdb",
                                        "glosses": [
                                            "Verkaufskraft mit aggressiven Methoden"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed416ab5-c88c-444d-af28-0c61a25a9c30",
                                                "sense_id": "b79e00db-b5e4-37ae-90b8-1af2b09f7894",
                                                "text": "„Den Vertriebspartnern seien hohe Provisionen in Aussicht gestellt worden, um immer mehr Keiler an Land zu ziehen, auch Aufsichtsorgane und Behörden seien getäuscht worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
