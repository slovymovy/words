                                                "example_id": "04d1aa48-9cca-45ff-a9cb-6b4a427978e6",
                                                "sense_id": "5e3c060a-6b79-3b9e-ab34-e12be3420211",
                                                "text": "Hij heeft een tijdje in Hongkong gewoond."
                                            }
