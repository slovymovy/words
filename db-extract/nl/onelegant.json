                                        "examples": [
                                            {
                                                "example_id": "00a00645-d613-42d1-ab4a-51b866c08878",
                                                "sense_id": "f805b283-799c-3b81-bfd7-3aa7ac27f506",
                                                "text": "Her cheeks have plumped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa8211e-6232-396a-b775-742f72452cef",
                                        "entry_id": "9b79f342-bb1f-3c25-9c53-17d17f54aec3",
                                        "glosses": [
                                            "To make plump; to fill (out) or support; often with up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac79fa37-0255-4c97-9537-34c753d79c10",
                                                "sense_id": "3fa8211e-6232-396a-b775-742f72452cef",
                                                "text": "to plump oysters or scallops by placing them in fresh or brackish water"
                                            },
                                            {
                                                "example_id": "c07f5de0-2cb5-45b4-9f11-ab956ff5bac0",
                                                "sense_id": "3fa8211e-6232-396a-b775-742f72452cef",
                                                "text": "to plump up the hollowness of their history with improbable miracles"
                                            },
                                            {
                                                "example_id": "173c07b3-cfb4-4ca6-af5f-d030b063ec3a",
                                                "sense_id": "3fa8211e-6232-396a-b775-742f72452cef",
                                                "text": "Although Miss Pross, through her long association with a French family, might have known as much of their language as of her own, if she had had a mind, she had no mind in that direction […] So her manner of marketing was to plump a noun-substantive at the head of a shopkeeper without any introduction in the nature of an article […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3523a27-55ef-3ee5-9ac3-96603a4c2db8",
                                        "entry_id": "9b79f342-bb1f-3c25-9c53-17d17f54aec3",
                                        "glosses": [
                                            "To give a plumper (kind of vote)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d603c869-90e7-35ae-bed8-daca7b9732f2",
                                        "entry_id": "9b79f342-bb1f-3c25-9c53-17d17f54aec3",
                                        "glosses": [
                                            "To give (a vote), as a plumper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af812ae5-3a30-3690-8a6b-d4de6e62c622",
                                        "entry_id": "9b79f342-bb1f-3c25-9c53-17d17f54aec3",
                                        "glosses": [
                                            "To favor or decide in favor of."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a3ccc6-bf37-4f06-aba4-186e103f73cc",
                                                "sense_id": "af812ae5-3a30-3690-8a6b-d4de6e62c622",
                                                "text": "A recent poll by the New York Times found that although most Brazilians plump for arch-rival Argentina as the team they most want to lose, the second-biggest group want Brazil itself to stumble."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plump",
