                                    {
                                        "sense_id": "da69199a-3cac-361b-9532-38b3953d0e44",
                                        "entry_id": "33b1fe1f-9639-3e37-b935-4740da45aa7a",
                                        "glosses": [
                                            "elend, so dass man Mitleid haben muss, jämmerlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f8c42e-169c-4dee-a78f-681ed6a964cd",
                                                "sense_id": "da69199a-3cac-361b-9532-38b3953d0e44",
                                                "text": "Dafür herrschen aber in Bauernhäusern oft um so erbärmlichere Wohnverhältnisse;"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06bf2a55-7b81-35a2-bfb5-3849c36ace0e",
                                        "entry_id": "33b1fe1f-9639-3e37-b935-4740da45aa7a",
                                        "glosses": [
                                            "von sehr schlechter Qualität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb2b70c-8404-4bb5-a030-d58b89fe0686",
                                                "sense_id": "06bf2a55-7b81-35a2-bfb5-3849c36ace0e",
                                                "text": "Die Schauspieler zeigten eine erbärmliche Leistung."
                                            },
                                            {
                                                "example_id": "aa050a22-b11b-435d-83e8-36e9414ed72e",
                                                "sense_id": "06bf2a55-7b81-35a2-bfb5-3849c36ace0e",
                                                "text": "Die Regierungsführung in Bangladesch ist erbärmlich und die Fähigkeit, lokale Manager und Textilfabrik-Besitzer zu überwachen und zu bestrafen ist problematisch."
                                            },
                                            {
                                                "example_id": "5cf5f886-115a-434b-9535-af1033c50d72",
                                                "sense_id": "06bf2a55-7b81-35a2-bfb5-3849c36ace0e",
                                                "text": "[COP26 2021:] „Mehr Klimaschutz gibt es auch nach der Klimakonferenz nicht - nur so viel, wie vorher eh schon verabredet war. Das reicht nicht, das Ergebnis des Gipfels ist erbärmlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e18a0c4d-f595-32e1-90f6-531f124afeb7",
                                        "entry_id": "33b1fe1f-9639-3e37-b935-4740da45aa7a",
                                        "glosses": [
                                            "moralisch verwerflich, gemein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9975b7-bbcc-4f7e-af68-9f559752c601",
                                                "sense_id": "e18a0c4d-f595-32e1-90f6-531f124afeb7",
                                                "text": "Das ist eine erbärmliche Lüge."
                                            },
                                            {
                                                "example_id": "b2127d06-16f5-42aa-8123-98316c303c2a",
                                                "sense_id": "e18a0c4d-f595-32e1-90f6-531f124afeb7",
                                                "text": "Schweden will 1900 Menschen aufnehmen. Dass in Ländern wie den Niederlanden über die Aufnahme von 50 [syrischen] Flüchtlingen diskutiert werde, bezeichneten liberale Parlamentarier als \"erbärmlich\"."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "190600d3-da26-3bc7-a607-386924ec1355",
                                        "entry_id": "33b1fe1f-9639-3e37-b935-4740da45aa7a",
                                        "glosses": [
                                            "sehr groß (um Negatives zu verstärken)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdd5963-fab1-4a72-a1cf-395c9f11d764",
                                                "sense_id": "190600d3-da26-3bc7-a607-386924ec1355",
                                                "text": "Unsere Kinder hatten erbärmlichen Hunger."
                                            },
                                            {
                                                "example_id": "8e877529-a270-41ce-912d-132400224551",
                                                "sense_id": "190600d3-da26-3bc7-a607-386924ec1355",
                                                "text": "Im Bosnien-Krieg seien bis zu 50.000 Frauen Opfer sexueller Gewalt geworden, sagte Jolie. Aber nur etwas mehr als 60 Täter seien dafür strafrechtlich zur Verantwortung gezogen worden. Die Zahl der Verurteilungen wegen Vergewaltigungen in Kriegsgebieten sei \"erbärmlich gering\"."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d90385f3-1d10-3ff8-bd36-3cba19fe3c91",
                                        "entry_id": "33b1fe1f-9639-3e37-b935-4740da45aa7a",
                                        "glosses": [
                                            "nur sehr (um Adjektive oder Verben mit negativen Sinn zu verstärken)"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c9dff7e-463e-42e8-a121-119153899eb6",
                                                "sense_id": "d90385f3-1d10-3ff8-bd36-3cba19fe3c91",
                                                "text": "Auf der Höhe war es kalt, so dass wir erbärmlich froren."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
