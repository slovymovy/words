                    "sense_id": "7c47b530-0ede-3038-9d82-c8cf7c7949a3",
                    "sense_definition": "Het gevoel hebben dat je moet overgeven.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb te veel kersen gegeten, waardoor ik <w>misselijk</w> ben.",
                            "target_lang_translations": {
                                "ru": "Я съел слишком много вишни, из-за чего меня <w>тошнит</w>.",
                                "en": "I ate too many cherries, which makes me feel <w>sick</w>.",
                                "pl": "Zjadłem za dużo wiśni, przez co jest mi <w>niedobrze</w>.",
                                "de": "Ich habe zu viele Kirschen gegessen, weshalb mir <w>übel</w> ist.",
                                "fr": "J'ai mangé trop de cerises, ce qui fait que j'ai <w>mal au cœur</w>.",
                                "it": "Ho mangiato troppe ciliegie, per questo ho la <w>nausea</w>.",
                                "cs": "Snědl jsem moc třešní, takže je mi <w>špatně</w>.",
                                "tr": "Çok fazla kiraz yedim, bu yüzden mdem <w>bulanıyor</w>.",
                                "es": "He comido demasiadas cerezas, por lo que estoy <w>mareado</w>."
                            }
                        },
                        {
                            "text": "Als ik in de bus een boek lees, word ik snel <w>misselijk</w>.",
                            "target_lang_translations": {
                                "ru": "Когда я читаю книгу в автобусе, меня быстро начинает <w>тошнить</w>.",
                                "en": "When I read a book on the bus, I quickly get <w>nauseous</w>.",
                                "pl": "Kiedy czytam książkę w autobusie, szybko robi mi się <w>niedobrze</w>.",
                                "de": "Wenn ich im Bus ein Buch lese, wird mir schnell <w>schlecht</w>.",
                                "fr": "Quand je lis un livre dans le bus, j'ai vite la <w>nausée</w>.",
                                "it": "Se leggo un libro sull'autobus, mi viene subito la <w>nausea</w>.",
                                "cs": "Když si v autobuse čtu knihu, udělá se mi rychle <w>nevolno</w>.",
                                "tr": "Otobüste kitap okursam hemen mdem <w>bulanır</w>.",
                                "es": "Si leo un libro en el autobús, me <w>mareo</w> rápidamente."
                            }
                        }
