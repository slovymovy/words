                    {
                        "translation_id": "e71f2c1c-742c-4880-9f2f-489a30140e40",
                        "source_entry_id": "c8dfe39b-2ae7-3e57-b430-d424d6699651",
                        "source_sense_id": "a0df2f0c-e75e-3fb8-89ac-fab4aefddbe4",
                        "source_sense_description": "difficult or laboured respiration",
                        "target_lang_word": "Atemnot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atemnot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db83c160-887c-3629-ac1c-198a03efabbc",
                                        "entry_id": "53e16438-21dc-3b96-9c6e-4a76bc7fb9fd",
                                        "glosses": [
                                            "(subjektiv als unangenehm bis bedrohlich empfundene) Schwierigkeiten beim Luftholen mit einhergehender verstärkter Atemarbeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd550c0-9858-41b1-9e3c-e3afa572a5de",
                                                "sense_id": "db83c160-887c-3629-ac1c-198a03efabbc",
                                                "text": "„Typische Anzeichen eines Vorhofflimmerns sind ein unregelmäßiger Puls, Herzrasen, Atemnot und Angstgefühl.“"
                                            },
                                            {
                                                "example_id": "8247642e-c5da-471d-86f1-3fe9d3424bb3",
                                                "sense_id": "db83c160-887c-3629-ac1c-198a03efabbc",
                                                "text": "„Wenige Jahre zuvor hatte man bei ihr eine chronische Lungenerkrankung mit Husten, Auswurf und Atemnot diagnostiziert.“"
                                            },
                                            {
                                                "example_id": "1381680b-b07f-4395-9361-370e68f340ae",
                                                "sense_id": "db83c160-887c-3629-ac1c-198a03efabbc",
                                                "text": "„Eine Handvoll Minuten vielleicht, dann kriechen wir vorsichtig ins Freie, schleichen erst geduckt, laufen dann querfeldein um sichere Entfernung, bis die Atemnot zum Anhalten zwingt.“"
                                            },
                                            {
                                                "example_id": "7ae8aaf1-44b5-4636-b3e4-280d9512f774",
                                                "sense_id": "db83c160-887c-3629-ac1c-198a03efabbc",
                                                "text": "„Ich versuchte, ruhig zu klingen, aber ich kannte diesen Blick, ich kannte die Stimmlage und jetzt auch noch ihre Atemnot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fcd1c91-e310-41a4-9b92-d71c6bd3c04a",
