                        "source_sense_id": "4e76c0d2-5a95-3f43-a7da-284082ed414c",
                        "source_sense_description": "Linguistik: Verb, das die Funktion des Prädikats in einem Satz alleine übernehmen kann",
                        "target_lang_word": "full verb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "full verb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c69c97b-d068-3989-bae6-e4ea2de62815",
                                        "entry_id": "1877c4b5-6ceb-3c82-895d-00829c100597",
                                        "glosses": [
                                            "A verb with its own meaning: a verb that is not an auxiliary verb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e2fbc0-17c9-4a01-862a-d4167df5d512",
                                                "sense_id": "5c69c97b-d068-3989-bae6-e4ea2de62815",
                                                "text": "In \"They have it\", have is a full verb, but in \"They have done it\", it's an auxiliary verb."
                                            }
                                        ]
                                    }
                                ]
                            }
