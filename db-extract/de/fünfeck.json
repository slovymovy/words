                "senses": [
                    {
                        "sense_id": "36229c71-c7ea-37e0-9ba2-6c957d45bd95",
                        "entry_id": "0b1dd05f-320a-31aa-8b26-5d6172fa6f28",
                        "glosses": [
                            "geometrische Figur mit fünf Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "d21b4cdd-9efd-4b6d-8d34-97dd6f1a6011",
                                "sense_id": "36229c71-c7ea-37e0-9ba2-6c957d45bd95",
                                "text": "Einen Grundriss in Form eines Fünfecks hat beispielsweise das Gebäude des Verteidigungsministeriums der USA und wird deshalb „Pentagon“ genannt."
                            },
                            {
                                "example_id": "208749bd-005d-4cb0-ab2d-70e7f82c7c63",
                                "sense_id": "36229c71-c7ea-37e0-9ba2-6c957d45bd95",
                                "text": "„Hippasos hat am Pentagramm (der Überlieferung nach am Dodekaeder, das aus 12 Fünfecken zusammengesetzt ist) das erste inkommensurable Verhältnis gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3f02a26-f641-4bd0-91b3-93e2b81ca969",
                        "source_entry_id": "0b1dd05f-320a-31aa-8b26-5d6172fa6f28",
                        "source_sense_id": "36229c71-c7ea-37e0-9ba2-6c957d45bd95",
                        "source_sense_description": "geometrische Figur mit fünf Ecken",
                        "target_lang_word": "pentagon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
