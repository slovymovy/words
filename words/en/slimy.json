{
    "word_family": [
        "slime",
        "sliminess"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b9e5d97-559f-37a5-bb26-9b722d1338ea",
                    "sense_definition": "Covered with, resembling, or containing thick, wet, slippery substance (slime).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "slimy_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frog felt cold and <w>slimy</w> when I tried to pick it up.",
                            "target_lang_translations": {
                                "ru": "Лягушка показалась холодной и <w>слизкой</w>, когда я попытался взять её в руки."
                            }
                        },
                        {
                            "text": "Be careful walking along the riverbank because the rocks are covered in <w>slimy</w> mud.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, гуляя по берегу реки, потому что камни покрыты <w>скользкой</w> грязью."
                            }
                        }
                    ],
                    "synonyms": [
                        "viscous",
                        "glutinous",
                        "lubricous"
                    ],
                    "common_phrases": [
                        "slimy mud",
                        "slimy texture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый густым, мокрым и скользким веществом (слизью), напоминающий слизь или содержащий её."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слизистый",
                                "target_lang_sense_clarification": "покрытый слизью или выделяющий слизь"
                            },
                            {
                                "target_lang_word": "ослизлый",
                                "target_lang_sense_clarification": "ставший скользким от налёта слизи"
                            },
                            {
                                "target_lang_word": "скользкий",
                                "target_lang_sense_clarification": "мокрый и скользкий на ощупь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a2ccf9b-b26b-3192-9704-49624b5163a4",
                    "sense_definition": "Pleasant and polite in an insincere, untrustworthy, and manipulative way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slimy_personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nobody trusted the <w>slimy</w> politician after he broke his promises.",
                            "target_lang_translations": {
                                "ru": "Никто не доверял этому <w>скользкому</w> политику после того, как он нарушил свои обещания."
                            }
                        },
                        {
                            "text": "He gave me a <w>slimy</w> smile that made me feel uneasy.",
                            "target_lang_translations": {
                                "ru": "Он одарил меня <w>елейной</w> улыбкой, от которой мне стало не по себе."
                            }
                        }
                    ],
                    "synonyms": [
                        "conniving"
                    ],
                    "common_phrases": [
                        "slimy smile",
                        "slimy salesman"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливый и любезный лицемерным, не заслуживающим доверия и манипулятивным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скользкий",
                                "target_lang_sense_clarification": "ненадёжный, хитрый, увёртливый (о человеке или поведении)"
                            },
                            {
                                "target_lang_word": "елейный",
                                "target_lang_sense_clarification": "лицемерно-слащавый, вкрадчивый"
                            },
                            {
                                "target_lang_word": "скользкий тип",
                                "target_lang_sense_clarification": "о человеке, вызывающем недоверие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f9d2949-0f3b-3446-b1c3-dcfdc248e94e",
                    "sense_definition": "A ponyfish, a small marine fish of the family Leiognathidae.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman caught a small <w>slimy</w> in his coastal net.",
                            "target_lang_translations": {
                                "ru": "Рыбак поймал в прибрежную сеть небольшую <w>сребробрюшку</w>."
                            }
                        },
                        {
                            "text": "Local markets often sell <w>slimy</w> alongside other small shore fishes.",
                            "target_lang_translations": {
                                "ru": "На местных рынках часто продают <w>сребробрюшку</w> вместе с другой мелкой прибрежной рыбой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сребробрюшка (небольшая морская рыба семейства сребробрюшковых)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сребробрюшка",
                                "target_lang_sense_clarification": "вид морской рыбы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}