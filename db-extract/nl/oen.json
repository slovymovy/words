                "senses": [
                    {
                        "sense_id": "453a144b-513c-3b3e-b229-3bfa472cd99d",
                        "entry_id": "b20e671f-0cde-3572-a291-311376873160",
                        "glosses": [
                            "dom en/of onhandig iemand"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0dff62ae-02e8-434f-98e3-f8112b16f633",
                                "sense_id": "453a144b-513c-3b3e-b229-3bfa472cd99d",
                                "text": "Wat een oen is dat, zeg."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b532afd-4976-38f2-b8b9-33b466862ec3",
                        "entry_id": "b20e671f-0cde-3572-a291-311376873160",
                        "glosses": [
                            "gecastreerde ezelhengst, ofwel ezelruin"
                        ],
                        "tags": [
                            "evenhoevigen"
                        ],
                        "examples": [
                            {
                                "example_id": "d9585e22-fac6-435c-beca-abe5a7f498bb",
                                "sense_id": "0b532afd-4976-38f2-b8b9-33b466862ec3",
                                "text": "Zij heeft een oen in haar bezit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "631e3f6b-56a5-433d-9f89-fce67bf3a020",
                        "source_entry_id": "b20e671f-0cde-3572-a291-311376873160",
                        "source_sense_id": "453a144b-513c-3b3e-b229-3bfa472cd99d",
                        "target_lang_word": "Knilch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knilch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1594f35-f706-39c1-8d2c-9bb0d04622f0",
                                        "entry_id": "11142b49-2739-3ab9-841e-36f61fa9e61b",
                                        "glosses": [
                                            "unangenehmer Mann"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8641abe-f202-41d7-a7e9-a3cb16e2316e",
                                                "sense_id": "f1594f35-f706-39c1-8d2c-9bb0d04622f0",
                                                "text": "„In der Weihnachtsbäckerei, gibt es manche Leckerei.",
                                                "translation": "eine riesengroße Kleckerei. In der Weihnachtsbäckerei.“ (Liedtext)"
                                            },
                                            {
                                                "example_id": "c80c3309-0d29-4a22-a694-aebfef458315",
                                                "sense_id": "f1594f35-f706-39c1-8d2c-9bb0d04622f0",
                                                "text": "„Doch Monika merkte schnell, dass ich mich für Caesar, Goethe und Schiller, notgedrungen sogar für Sinus und Cosinus mehr interessierte als für Kleider und Knilche, unser Wort für Jungen.“"
                                            },
                                            {
                                                "example_id": "b5120d8c-2223-460f-9c38-5cb1b729b3ee",
                                                "sense_id": "f1594f35-f706-39c1-8d2c-9bb0d04622f0",
                                                "text": "„Dieser Knilch hat mir gerade noch gefehlt!“"
                                            },
                                            {
                                                "example_id": "bb62e6fb-eeba-4b31-ba2c-a3784ee9e46a",
                                                "sense_id": "f1594f35-f706-39c1-8d2c-9bb0d04622f0",
                                                "text": "„Der Knilch nahm Erwin gar nicht richtig wahr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fab3728-4458-4cd9-8e6d-61c53e808fe7",
                        "source_entry_id": "b20e671f-0cde-3572-a291-311376873160",
                        "source_sense_id": "453a144b-513c-3b3e-b229-3bfa472cd99d",
                        "target_lang_word": "Macker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Macker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a86f5616-7dc7-3485-8430-a5355c62f5bb",
                                        "entry_id": "246a2cb1-7d33-34be-8bea-1526dd06d448",
                                        "glosses": [
                                            "Freund eines Mädchens"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1af1f29f-0f88-49b1-9006-c11694625154",
                                                "sense_id": "a86f5616-7dc7-3485-8430-a5355c62f5bb",
                                                "text": "Heute kam sie mit ihrem neuen Macker zum Fest."
                                            },
                                            {
                                                "example_id": "7219b7b0-a560-41b4-ae25-17b8ac020660",
                                                "sense_id": "a86f5616-7dc7-3485-8430-a5355c62f5bb",
                                                "text": "Wo hast du denn heute deinen Macker gelassen?"
                                            },
                                            {
                                                "example_id": "89758995-47aa-4576-a7e0-2a2a051f0ced",
                                                "sense_id": "a86f5616-7dc7-3485-8430-a5355c62f5bb",
                                                "text": "„Und wenn ich Pech habe, ist dieser Macker Bodybuilder, gewaltbereit und einen Kopf größer als ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b273b31-ec72-3b41-98f5-66fec80d01b1",
                                        "entry_id": "246a2cb1-7d33-34be-8bea-1526dd06d448",
                                        "glosses": [
                                            "Kamerad, der gleichzeitig Chef ist, so der Kapitän und Schiffseigner zum Beispiel auf einem Fischkutter, jemand, der eine Chefposition innehat"
                                        ],
                                        "tags": [
                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff29a7af-628a-4f94-a333-d36aace0110a",
                                                "sense_id": "9b273b31-ec72-3b41-98f5-66fec80d01b1",
                                                "text": "Auf unseren Macker können wir uns verlassen."
                                            },
                                            {
                                                "example_id": "03589735-46d6-41ae-8cef-4b63469caa54",
                                                "sense_id": "9b273b31-ec72-3b41-98f5-66fec80d01b1",
                                                "text": "Wer ist denn hier der Obermacker von dem Laden?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a8ea5776-0281-3c02-8cda-a0f894400a23",
                                        "entry_id": "246a2cb1-7d33-34be-8bea-1526dd06d448",
                                        "glosses": [
                                            "Mann; oftmals jemand, der mindestens etwas fremd ist und mit dem Beiklang Chauvi, Macho"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0622846-8336-4a95-a221-9e2ee3d801de",
                                                "sense_id": "a8ea5776-0281-3c02-8cda-a0f894400a23",
                                                "text": "Was ist denn das für ein Macker?"
                                            },
                                            {
                                                "example_id": "53ea1c57-653a-4ddc-9c22-9319f7b3204f",
                                                "sense_id": "a8ea5776-0281-3c02-8cda-a0f894400a23",
                                                "text": "„Der Abstieg des Mackers ist daher eng verknüpft mit dem Strukturwandel der Männlichkeit.“"
                                            },
                                            {
                                                "example_id": "cdc72b54-71e3-47a8-82cc-59551cc6cd37",
                                                "sense_id": "a8ea5776-0281-3c02-8cda-a0f894400a23",
                                                "text": "Der umgangssprachliche Ausruf: „Ey, Macker!“ leitet eine Revierverteidigungsdrohgebärde ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
