{
    "word_family": [
        "hospitality",
        "hospitable",
        "hospital"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4576a35b-9030-3a33-ad87-3a9c41baef58",
                    "sense_definition": "Not friendly or welcoming to guests or strangers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unwelcoming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host was <w>inhospitable</w> and did not offer us anything to drink.",
                            "target_lang_translations": {
                                "ru": "Хозяин был <w>негостеприимным</w> и не предложил нам ничего выпить."
                            }
                        },
                        {
                            "text": "We felt <w>inhospitable</w> treatment when we arrived at the cold and dark house.",
                            "target_lang_translations": {
                                "ru": "Мы столкнулись с <w>негостеприимным</w> приемом, когда прибыли в холодный и темный дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "unfriendly",
                        "unwelcoming",
                        "cold"
                    ],
                    "antonyms": [
                        "hospitable",
                        "welcoming"
                    ],
                    "common_phrases": [
                        "inhospitable host",
                        "inhospitable treatment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недружелюбный или нерадушный по отношению к гостям или незнакомцам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "негостеприимный",
                                "target_lang_sense_clarification": "не отличающийся гостеприимством, нерадушный"
                            },
                            {
                                "target_lang_word": "неприветливый",
                                "target_lang_sense_clarification": "холодный в общении, не проявляющий радушия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f44e531-726a-3c97-9c76-3eef271b8dfa",
                    "sense_definition": "Difficult to live in or survive in due to harsh conditions or lack of resources.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unwelcoming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert is an <w>inhospitable</w> environment for most plants and animals.",
                            "target_lang_translations": {
                                "ru": "Пустыня — это <w>суровая</w> среда для большинства растений и животных."
                            }
                        },
                        {
                            "text": "Explorers struggled to survive in the <w>inhospitable</w> terrain of the frozen mountains.",
                            "target_lang_translations": {
                                "ru": "Исследователи боролись за выживание в <w>суровых</w> условиях замерзших гор."
                            }
                        }
                    ],
                    "synonyms": [
                        "barren",
                        "harsh",
                        "forbidding"
                    ],
                    "antonyms": [
                        "hospitable"
                    ],
                    "common_phrases": [
                        "inhospitable environment",
                        "inhospitable terrain",
                        "inhospitable climate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для жизни или выживания из-за суровых условий или нехватки ресурсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о тяжелых природных условиях, непригодных для жизни"
                            },
                            {
                                "target_lang_word": "непригодный для жизни",
                                "target_lang_sense_clarification": "о местности или климате, где трудно выжить"
                            },
                            {
                                "target_lang_word": "неприветливый",
                                "target_lang_sense_clarification": "переносное значение: суровый, неуютный (о ландшафте или климате)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}