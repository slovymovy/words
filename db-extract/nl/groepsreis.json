                "senses": [
                    {
                        "sense_id": "88af323d-4cfa-344b-846f-50505bcfc243",
                        "entry_id": "2e2960f0-5b03-32a2-9d0d-00e387703607",
                        "glosses": [
                            "tocht georganiseerd om samen met andere mensen uit andere gezinnen te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3360496d-9fcb-4540-bf69-09074f5d4054",
                                "sense_id": "88af323d-4cfa-344b-846f-50505bcfc243",
                                "text": "Toen de reisorganisatie op sociale media de plannen bekendmaakte om zo'n beetje als eerste in de reisbranche weer een groepsreis te organiseren, werden er kritische vragen gesteld. Het kabinetsbeleid is er immers op gericht om in deze coronatijd vooral ouderen te beschermen."
                            },
                            {
                                "example_id": "c9c1166e-491b-40e4-a5cb-ac2508ac2608",
                                "sense_id": "88af323d-4cfa-344b-846f-50505bcfc243",
                                "text": "Braun begeleidt in totaal zo'n veertig toeristen op zoek naar een coronavaccinatie in het buitenland. Tot nu toe hielp hij vooral individuele reizigers en families die naar Miami vlogen en daar zijn gevaccineerd. Deze week vertrok de eerste groepsreis, naar New York."
                            }
                        ]
                    }
