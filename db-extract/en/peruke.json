    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4b1ba520-ed48-3099-9511-bd915c6555b5",
                "word": "peruke",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "939061a8-c632-4897-b712-f572362a9eb4",
                        "entry_id": "4b1ba520-ed48-3099-9511-bd915c6555b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "perukes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                        "entry_id": "4b1ba520-ed48-3099-9511-bd915c6555b5",
                        "glosses": [
                            "A wig, especially one with long hair on the sides and back, worn mainly by men in the 17th and 18th centuries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adcd2687-36ab-4e6e-8f47-2d99aabad430",
                                "sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                                "text": "To poſterity perhaps his prints vvill carry an idea of ſomething burleſque; perukes of outrageous length flovving over ſuits of armour compoſe vvonderfull habits."
                            },
                            {
                                "example_id": "ea888a51-b6cc-4c63-8bc0-e79b2c01be4e",
                                "sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                                "text": "But now at thirty years my hair is gray— / (I wonder what it will be like at forty? / I thought of a peruke the other day) […]"
                            },
                            {
                                "example_id": "d6368aea-0adc-485e-9617-88765b41c619",
                                "sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                                "text": "Let the long peruke succeed the godly cropt hair; the cravat, the ruff; […]"
                            },
                            {
                                "example_id": "1ec3f3b3-ad88-471d-8e28-1cb184e51650",
                                "sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                                "text": "Every chair was filled, the line of assistants working like conjurors at the bizarre hairstyles, a splendid confusion of feathers and flared perukes, wings of back-brushed hair, like the plumage of an aviary."
                            },
                            {
                                "example_id": "a730e84a-9401-42ec-84fb-26b806d35294",
                                "sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                                "text": "With a delicate touch, he reset his golden peruke on his sweat-slick skull."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f99500e-6880-437f-849d-1b87dd2fba08",
                        "source_entry_id": "4b1ba520-ed48-3099-9511-bd915c6555b5",
                        "source_sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                        "source_sense_description": "wig",
                        "target_lang_word": "pruik",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pruik",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "03914764-aca6-3b92-b2f5-54bb086147bc",
                                        "entry_id": "82337701-abd9-38dc-a85b-37375bf45fd8",
                                        "glosses": [
                                            "een kunstmatig haarstuk waarmee het hoofd bedekt wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f2e1eb-6028-4708-ae8e-2cc1ff7fe6bb",
                                                "sense_id": "03914764-aca6-3b92-b2f5-54bb086147bc",
                                                "text": "In de achttiende eeuw was het dragen van pruiken erg in de mode."
                                            },
                                            {
                                                "example_id": "949520e0-55d7-410b-825c-f6ed58068764",
                                                "sense_id": "03914764-aca6-3b92-b2f5-54bb086147bc",
                                                "text": "\"Ik had mijn best gedaan haar goed te bestuderen en thuis voor de spiegel geoefend. Ik had een pruik opgezet, haar befaamde eyeliner en lippenstift opgedaan en zong De Verzoening van Frank Boeijen, terwijl Liesbeth voor mijn neus zat.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb2bfbde-f8ec-4da0-986e-4471da6c9848",
                        "source_entry_id": "4b1ba520-ed48-3099-9511-bd915c6555b5",
                        "source_sense_id": "7fe8f724-5e1c-3bc9-aded-8ca719129c66",
                        "source_sense_description": "wig",
                        "target_lang_word": "perruque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perruque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                        "entry_id": "b4cd1b10-d3ec-3c49-891c-06923f7e7d4f",
                                        "glosses": [
                                            "Coiffure de faux cheveux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56a38c14-da08-4efc-83a2-89154d3f417a",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "Il est bien nécessaire d’employer de l’argent à des perruques, lorsque l’on peut porter des cheveux de son cru qui ne coûtent rien !"
                                            },
                                            {
                                                "example_id": "efa06cc9-af50-43b1-b887-7a1be9819cb9",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "Sa perruque blonde bien frisée, bien mise, seyait à sa blanche figure froidie comme celle de ces femmes de bourgmestre peintes par Holbein."
                                            },
                                            {
                                                "example_id": "50c71819-585c-4297-9717-62fb641606a9",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "Il ôtait son grand habit noisette, remettait sa perruque dans la boîte et tirait de nouveau son bonnet de soie sur ses oreilles, en disant."
                                            },
                                            {
                                                "example_id": "d9c49233-2633-4e15-bcdb-244ffe47848d",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "— On n’est pas coiffé à Londres comme à Paris. Les Anglais savent faire des constitutions, mais ils ne savent pas faire de perruques, et leur poudre n’est pas d’un blanc assez pur."
                                            },
                                            {
                                                "example_id": "bda519ad-5921-4fcf-a6fa-5542df936eb4",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "Que ne trouve- t-on pas dans les greniers ? […] Des perruques de cour ou de comédie, ce qui est à peu près la même chose, perruques à marteau, perruques moyen âge, perruques de satyres décorées de petites cornes d’or ; […]"
                                            },
                                            {
                                                "example_id": "b169ca7c-9ea6-4ae4-bfbf-ea9a6c0749b8",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "On devine ses mérites rien qu’à la regarder : elle est grande, énorme de taille et barbue, avec un long nez, de longues dents, des yeux jaunes brouillés et une espèce de perruque à la Titus, aplatie sur le front, qui a dû être noire autrefois."
                                            },
                                            {
                                                "example_id": "6c8844cc-cad2-46d5-a5a6-a04a64b18f49",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "Une tronche d’aigrefin soiffard surmontée d’une bouse de vache rousse, la perruque la plus loupée que j’ai jamais vue sur le crâne de quelqu’un."
                                            },
                                            {
                                                "example_id": "37506a72-6d9f-4e63-bf5f-83320128865c",
                                                "sense_id": "bde402d1-56d2-378d-b383-bba25b3e89c1",
                                                "text": "Il saisit rageusement sa perruque, qui lui redonnait pour un soir la chevelure bananoïde de ses chères sixties, et la jette dans le lavabo où elle se met à sombrer comme un transatlantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c29c463-a61f-351e-9890-8314af6964a6",
                                        "entry_id": "b4cd1b10-d3ec-3c49-891c-06923f7e7d4f",
                                        "glosses": [
                                            "Feuillage ; frondaison."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03866207-2ce1-44da-8e85-59a73d4bd3d3",
                                                "sense_id": "4c29c463-a61f-351e-9890-8314af6964a6",
                                                "text": "Le tronc de branches dévêtu… Reprenant sa perruque verte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb15133-cd2b-32df-bb18-94d68ed86325",
                                        "entry_id": "b4cd1b10-d3ec-3c49-891c-06923f7e7d4f",
                                        "glosses": [
                                            "Vieillard qui tient opiniâtrement à d’anciens préjugés."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "587cf8e5-cacd-482d-a2aa-841ad14b6672",
                                                "sense_id": "dcb15133-cd2b-32df-bb18-94d68ed86325",
                                                "text": "Je ne balance pas assurément entre Catherine II et les vingt-cinq perruques de Genève."
                                            },
                                            {
                                                "example_id": "b8119596-cb88-410a-ba8b-0196185cbeca",
                                                "sense_id": "dcb15133-cd2b-32df-bb18-94d68ed86325",
                                                "text": "Mais vous ne savez pas que si je tarde seulement quinze jours à ma convalescence, on me dira, quand je reviendrai, que je suis une perruque, un vieux, que mon temps est fini, que je suis Empire, rococo !"
                                            },
                                            {
                                                "example_id": "06ac696d-659a-4662-997a-f07e59000670",
                                                "sense_id": "dcb15133-cd2b-32df-bb18-94d68ed86325",
                                                "text": "Tout sera présenté, tout sera mis en forme parfaitement – irréfutablement – et les vieilles perruques nobles qu’on croirait peintes sur la boiserie acquiesceront au Sénat l’une après l’autre à la lecture de mon rapport, comme si de leur vie il n’avait été question de faire autre chose : se dérobe-t-on à la voix même de la patrie ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9abebbcf-dd84-3590-b1e7-bbcd953347d4",
                                        "entry_id": "b4cd1b10-d3ec-3c49-891c-06923f7e7d4f",
                                        "glosses": [
                                            "Utilisation clandestine des machines d’une usine à des fins personnelles ; désigne l’action, comme l’objet réalisé."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88524155-7164-4567-9e29-483938a5af13",
                                                "sense_id": "9abebbcf-dd84-3590-b1e7-bbcd953347d4",
                                                "text": "Dans le monde de l’entreprise, certains ont fait de la « perruque » une grande spécialité. Point de postiches ici, mais la volonté d’exercer une double vie professionnelle."
                                            },
                                            {
                                                "example_id": "bcdc91f1-ba3b-430b-a32b-ed95e50a1f11",
                                                "sense_id": "9abebbcf-dd84-3590-b1e7-bbcd953347d4",
                                                "text": "« La perruque, ça veut dire retrouver le sens de soi et à mon avis ça correspond vraiment à la réalité de la perruque : on travaille pour soi, on retrouve sa personnalité, sa créativité. Ou plus simplement, réparer son scooter ou réparer une balayette! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddaac047-5fdf-3806-af39-7994f487d824",
                                        "entry_id": "b4cd1b10-d3ec-3c49-891c-06923f7e7d4f",
                                        "glosses": [
                                            "Ligne de pêche emmêlée, constituant un amas ressemblant à un postiche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14aa2183-c17a-3b3d-97ab-25e7dc85ab53",
                                        "entry_id": "b4cd1b10-d3ec-3c49-891c-06923f7e7d4f",
                                        "glosses": [
                                            "Paquet de fil de fer sur lequel on soude des métaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "perruque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f304b03-923b-362a-8c8b-cf88f3d6aa8a",
                                        "entry_id": "63d85cf1-ac16-3de7-83f5-f9cfc94df239",
                                        "glosses": [
                                            "Vieux, suranné."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e25da3a0-cacb-4025-8885-8ad4a261c0f2",
                                                "sense_id": "0f304b03-923b-362a-8c8b-cf88f3d6aa8a",
                                                "text": "Cela est décidément perruque."
                                            },
                                            {
                                                "example_id": "f7e48744-ab14-4b2f-8349-eb92b9d6dbea",
                                                "sense_id": "0f304b03-923b-362a-8c8b-cf88f3d6aa8a",
                                                "text": "Il le trouvait [un journal] tiède, timide, arriéré, perruque ; ce dernier substantif métamorphosé en adjectif exprimait le plus haut degré de son mépris."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perruque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d376f92b-8731-3849-8a31-3102b6a39689",
