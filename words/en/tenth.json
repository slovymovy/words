                },
                {
                    "sense_id": "b5b1a953-bce9-3b33-97c7-1d877af003de",
                    "sense_definition": "A tax or contribution consisting of one tenth of personal property or produce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tax",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers were required to pay a <w>tenth</w> of their harvest to the church.",
