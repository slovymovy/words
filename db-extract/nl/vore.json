                        "tags": [
                            "plural"
                        ],
                        "form": "voren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d817357d-c336-38b0-a3f8-fc1ce5156aa1",
                        "entry_id": "e68eaf09-a1a2-3627-9951-e2fcc4967064",
                        "glosses": [
                            "lange, smalle en ondiepe insnijding in een akker, gewoonlijk door een ploeg aangebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30f6b18-b403-492e-93ca-dce67e793d22",
                                "sense_id": "d817357d-c336-38b0-a3f8-fc1ce5156aa1",
                                "text": "Dan passeren ze een boer die net een vore in de akker heeft geploegd en goedkeurend zegt: ‘Dat is recht’."
                            }
                        ]
                    },
                    {
                        "sense_id": "22190326-43d3-39b7-8750-1b895afd817d",
                        "entry_id": "e68eaf09-a1a2-3627-9951-e2fcc4967064",
                        "glosses": [
                            "benaming voor de scheiding tussen de eerste twee delen van hoofse minneliederen uit de 13e eeuw"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9f836f-0d14-46e9-a4e2-85c4241050ed",
                                "sense_id": "22190326-43d3-39b7-8750-1b895afd817d",
                                "text": "De kop is een formeel kenmerk van de Noord-Franse hoofse poëzie (…); een Noord-Franse kop bestaat doorgaans uit twee stollen van elk twee versregels, van elkaar gescheiden door een vore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90363e3f-6446-4ab1-96b9-4932d2899bf5",
                        "source_entry_id": "e68eaf09-a1a2-3627-9951-e2fcc4967064",
                        "source_sense_id": "d817357d-c336-38b0-a3f8-fc1ce5156aa1",
                        "source_sense_description": "ploegsnede",
                        "target_lang_word": "Furche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Furche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a98bc56-7204-3921-85e8-0347b09dd591",
                                        "entry_id": "ed50cfcf-a0a6-3dff-aa85-2a96077f5e37",
                                        "glosses": [
                                            "eine längliche, enge und flache Bodenvertiefung, für gewöhnlich auf einem Acker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7440c9-a29d-4a37-acfa-1c9f19204b96",
                                                "sense_id": "1a98bc56-7204-3921-85e8-0347b09dd591",
                                                "text": "Der Bauer zog Furchen mit dem Pflug in den Acker."
                                            },
                                            {
                                                "example_id": "b5ce1d3f-2083-4915-8ea7-7df43324f2db",
                                                "sense_id": "1a98bc56-7204-3921-85e8-0347b09dd591",
                                                "text": "„Die Dämmerung brach herein, und Krähen ließen sich in den Furchen nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bab0c2f4-240a-32d7-9bbd-b68fe335849c",
                                        "entry_id": "ed50cfcf-a0a6-3dff-aa85-2a96077f5e37",
                                        "glosses": [
                                            "eine tiefe Falte, meist im Gesicht"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a919c8b-1712-4ffa-9207-6247b2a3b0f0",
                                                "sense_id": "bab0c2f4-240a-32d7-9bbd-b68fe335849c",
                                                "text": "Der alte Mann hatte tiefe Furchen im Gesicht."
                                            },
                                            {
                                                "example_id": "62515d21-3a3f-46d0-9740-80708c2c3a1a",
                                                "sense_id": "bab0c2f4-240a-32d7-9bbd-b68fe335849c",
                                                "text": "„Die Furchen auf seiner Stirn werden tiefer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "88f29e9d-d9d6-3e21-b94f-e59111d938aa",
                                        "entry_id": "ed50cfcf-a0a6-3dff-aa85-2a96077f5e37",
                                        "glosses": [
                                            "tiefe Linie im Wasser hinter einem fahrenden Wasserfahrzeug"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96f0267b-4bf9-4152-9107-89aa3ed9c399",
                                                "sense_id": "88f29e9d-d9d6-3e21-b94f-e59111d938aa",
                                                "text": "„Hie und da wächst ein weniges von Schilf und Binsen auf, aber kein Kahn zieht seine Furchen, kein Vogel singt, und nur selten, daß ein Habicht drüber hinfliegt und seinen Schatten auf die Spiegelfläche wirft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1cf53c4-efc5-4ef1-8f1f-07e83eeb2139",
                        "source_entry_id": "e68eaf09-a1a2-3627-9951-e2fcc4967064",
                        "source_sense_id": "d817357d-c336-38b0-a3f8-fc1ce5156aa1",
                        "source_sense_description": "ploegsnede",
                        "target_lang_word": "furrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                                        "entry_id": "7993cac4-cb09-3fb7-8467-a57632188210",
                                        "glosses": [
                                            "A trench cut in the soil, as when plowed in order to plant a crop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de844c95-7efe-44ca-8c8e-f3be5b20098c",
                                                "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                                                "text": "Don't walk across that deep furrow in the field."
                                            },
                                            {
                                                "example_id": "16a627d3-4120-4840-969e-07922b634ea8",
                                                "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                                                "text": "The family feeling was intensified as we stopped to speak to mothers in the cottage gardens, or waved to distant tractors turning over chocolate-brown furrows and driven by 'my dad' or 'my Uncle Bob'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427d9365-d559-3bca-960c-6b6a951aa040",
                                        "entry_id": "7993cac4-cb09-3fb7-8467-a57632188210",
                                        "glosses": [
                                            "Any trench, channel, or groove, as in wood or metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bcffa7b-890c-3ebc-94d1-4c4363f24082",
                                        "entry_id": "7993cac4-cb09-3fb7-8467-a57632188210",
                                        "glosses": [
                                            "A deep wrinkle in the skin of the face, especially on the forehead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463d91f6-2ad0-4cac-92df-c8f5a9454dda",
                                                "sense_id": "7bcffa7b-890c-3ebc-94d1-4c4363f24082",
                                                "text": "When she was tired, a deep furrow appeared on her forehead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "furrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "To cut one or more grooves in (the ground, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f7c2df6-7ab4-4d6e-a286-b0dd11dbbc65",
                                                "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                                                "text": "Cart wheels can furrow roads."
                                            },
                                            {
                                                "example_id": "d8efa477-65c7-46f7-a59e-168ea43d46ff",
                                                "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                                                "text": "Morn in the white wake of the morning star / Came furrowing all the orient into gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040f9fba-9041-30e3-ab22-a6fd7845c97e",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "To wrinkle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf2abce6-a228-34cf-a6f5-b169651bbcbf",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "To pull one's brows or eyebrows together due to concentration, worry, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06054e58-5104-43ee-a0b0-106f1f742b4f",
                                                "sense_id": "cf2abce6-a228-34cf-a6f5-b169651bbcbf",
                                                "text": "As she pored over the company's bewildering tax documents, she furrowed her brows, wrinkled her nose, and began to frown her befuddlement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c064d335-75c7-313e-af1e-74d73548423d",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "to become furrowed"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40cdab0-0960-40e7-90c4-1663f592d7af",
                                                "sense_id": "c064d335-75c7-313e-af1e-74d73548423d",
                                                "text": "If you were bold enough to ask Antonin Scalia questions, you had to be precise. Otherwise the bushy black brows would furrow, the chin would crumple and the pudgy, puckish body would start to rock, eager to get at you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7178779-59ec-4ee5-a7a1-f13638a4c080",
                        "source_entry_id": "e68eaf09-a1a2-3627-9951-e2fcc4967064",
                        "source_sense_id": "d817357d-c336-38b0-a3f8-fc1ce5156aa1",
                        "source_sense_description": "ploegsnede",
                        "target_lang_word": "sillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b7aa7ec-3c15-369c-96c0-5d77f00c3bf2",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Tranchée que le soc, le coutre de la charrue ouvre dans la terre qu’on laboure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347c3eac-f1e1-472c-97e2-5ae6cf336cd2",
                                                "sense_id": "6b7aa7ec-3c15-369c-96c0-5d77f00c3bf2",
                                                "text": "Ce soc est fort petit, et le coutre qui ne fait qu’écorcher la terre , pour ainsi dire ; à mesure que les sillons sont tirés, les laboureurs rompent les mottes avec de grosses maillottes de bois."
                                            },
                                            {
                                                "example_id": "61313f67-3e38-49be-92e1-0fdd4dcc1df2",
                                                "sense_id": "6b7aa7ec-3c15-369c-96c0-5d77f00c3bf2",
                                                "text": "Faire son sillon, tracer son sillon, faire l’ouvrage qu’on est tenu de faire, qu’on s’est imposé l’obligation de faire chaque jour."
                                            },
                                            {
                                                "example_id": "58ad13fe-5f65-49cc-87cd-2aad6d81cab7",
                                                "sense_id": "6b7aa7ec-3c15-369c-96c0-5d77f00c3bf2",
                                                "text": "Trop de sang a inondé, abreuvé nos sillons, nos champs, nos campagnes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a75f95-4806-32ae-87e1-450f7697e574",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Propriété foncière."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a272ccae-1b38-4899-96bf-0aa1e609306e",
                                                "sense_id": "e7a75f95-4806-32ae-87e1-450f7697e574",
                                                "text": "Les marquis, les comtes, les barons de maintenant, n’ayant ni privilèges ni sillons, les trois quarts mourant de faim, se dénigrant les uns les autres,..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f01c3b7-040a-37dd-a052-3b3e85fb478f",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Trace laissée en passant."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399c1309-9d18-490d-8711-6b0b1a775705",
                                                "sense_id": "4f01c3b7-040a-37dd-a052-3b3e85fb478f",
                                                "text": "Le navire laissait derrière lui un large sillon."
                                            },
                                            {
                                                "example_id": "872cafa5-434d-4adc-865c-00f89068d01c",
                                                "sense_id": "4f01c3b7-040a-37dd-a052-3b3e85fb478f",
                                                "text": "L'hiver était rude. Sur les routes que le court dégel de midi amollissait vaguement, la boue se ridait, se hérissait en lilliputiennes murailles et les sillons durcis qui bordaient les ornières ne s'affaissaient point."
                                            },
                                            {
                                                "example_id": "7c52062a-9b5b-46c5-960a-2cd786146cb3",
                                                "sense_id": "4f01c3b7-040a-37dd-a052-3b3e85fb478f",
                                                "text": "Un sillon de lumière."
                                            },
                                            {
                                                "example_id": "908c1ad9-986e-4f59-8484-bc5f36c6f70b",
                                                "sense_id": "4f01c3b7-040a-37dd-a052-3b3e85fb478f",
                                                "text": "Suivre le sillon de quelqu’un, entrer, marcher dans le sillon de quelqu’un, suivre la trace, la voie qu’il a ouverte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c2bd772-e992-3c4b-bb2b-b90198feb9bf",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Microsillon."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4f70b4-20b8-458f-8fd1-5826d2a0c6b6",
                                                "sense_id": "2c2bd772-e992-3c4b-bb2b-b90198feb9bf",
                                                "text": "Le saphir du tourne-disque mono avait longuement parcouru le sillon des vinyles. Les disques amenés de Londres s'étaient succédé les uns aux autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df397515-3531-3516-ac2d-5bff00bc8c76",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Sillon horaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ed7894-1643-4624-b07a-91d0c82d59f3",
                                                "sense_id": "df397515-3531-3516-ac2d-5bff00bc8c76",
                                                "text": "Les convois de marchandises sont tributaires de la qualité des créneaux horaires, appelés « sillons », fournis par SNCF Réseau, le gestionnaire des rails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c55e2d-e0ad-3929-86c8-bc51f60acd53",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Ride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd03f99d-187d-4e74-84ef-579998d20ca9",
                                                "sense_id": "61c55e2d-e0ad-3929-86c8-bc51f60acd53",
                                                "text": "Les sillons que le temps et le malheur avaient creusés sur son front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f6cd114-25da-3525-9fab-fa7e079d48f0",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Raie, strie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15ce3eb3-507f-428e-bb8e-d97d4b54a5c5",
                                                "sense_id": "4f6cd114-25da-3525-9fab-fa7e079d48f0",
                                                "text": "Les valves de cette coquille ont des sillons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Fente, rainure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a362010-3086-4143-92d2-327bd8188a1d",
                                                "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                                                "text": "Sillon longitudinal."
                                            },
                                            {
                                                "example_id": "7bbcdb0d-b60c-433c-a1bd-4f8a9623d72f",
                                                "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                                                "text": "Sillon transversal."
                                            },
                                            {
                                                "example_id": "d7456897-bfec-4f33-a2f3-10c15ab0ec0b",
                                                "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                                                "text": "Sillon interfessier."
                                            },
                                            {
                                                "example_id": "613c7427-f263-4ec2-bb8d-028c5d726654",
                                                "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                                                "text": "Les sillons du foie."
                                            },
                                            {
                                                "example_id": "27c656b3-caf2-4d94-8b58-cc09bb78cddb",
                                                "sense_id": "40e31db1-a089-31f0-8e5f-7a2622083673",
                                                "text": "À ce mouvement, l’étoffe misérable jetée sur son épaule glissa et découvrit entièrement son corps. J’aperçus alors un énorme sillon qui, depuis la naissance du cou jusqu’à l’aine, labourait une chair maigre et sèche. C’était une cicatrice monstrueuse dont les bourrelets, les crevasses et les lèvres avaient la couleur de la viande boucanée et du sang caillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08174230-e647-34a8-b944-d49098ced133",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Longue et étroite dépression."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0f07ac-2120-4394-bf2f-858d134f8884",
                                                "sense_id": "08174230-e647-34a8-b944-d49098ced133",
                                                "text": "Nous quittons maintenant notre itinéraire de Casablanca à Sokhrat Ed-Djeja et nous dirigeons vers le Nord-Ouest en descendant insensiblement dans un sillon de la terrasse supérieure des Châouïa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be552408-7647-36a8-83e2-616cf51ce2c9",
                                        "entry_id": "a1d13e29-9e7f-3ecc-b797-b04f208a2a8c",
                                        "glosses": [
                                            "Chemin ; carrière."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff62a631-ea64-4b24-9501-4dc19d51803e",
                                                "sense_id": "be552408-7647-36a8-83e2-616cf51ce2c9",
                                                "text": "Œcuménique avant la lettre, fraternisant d’instinct avec les aumôniers protestants des corps expéditionnaires anglais et américains dans le Nord, ce fils de paysans trace son sillon avec la lenteur obstinée de ceux qui ont labouré la terre."
                                            },
                                            {
                                                "example_id": "65b04af5-a371-4baa-9be7-a31426a1f67f",
                                                "sense_id": "be552408-7647-36a8-83e2-616cf51ce2c9",
                                                "text": "Junior, lui, trace son sillon avec constance. En 2018, la campagne des élections de mi-mandat lui offre une nouvelle tribune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
