                ],
                "senses": [
                    {
                        "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                        "entry_id": "2aa70c23-7a5c-3cae-abe7-313277bbbb0b",
                        "glosses": [
                            "Arbeitsplatz für eine Person (meist einen Jugendlichen), die eine Ausbildung in einem Beruf erhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab6e767-3890-48ca-9505-87048223e25a",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "„Ich bin froh, wenn ich einen Ausbildungsplatz gefunden habe.“"
                            },
                            {
                                "example_id": "fa449c52-ff77-4e64-8e89-b981e1dab6a3",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Im August beginnt in Deutschland das neue Ausbildungsjahr. Während Unternehmen über mangelhafte Bewerbungen klagen, finden einige Jugendliche erst gar keinen Ausbildungsplatz."
                            },
                            {
                                "example_id": "7db7b4ae-67ce-4200-ab56-70ab4f138afc",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "[…] Jugendliche mit Migrationshintergrund [haben] auch bei gleicher Qualifikation schlechtere Chancen, einen Ausbildungsplatz zu bekommen."
                            },
                            {
                                "example_id": "135afd1b-bafa-44b8-8abd-56ba986285b2",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Insgesamt wurden 2016 laut der Studie bundesweit von den Betrieben 80.000 duale Ausbildungsplätze weniger angeboten als noch 2007."
                            },
                            {
                                "example_id": "077b7a3b-4024-4bc7-965f-ab846ca13ec7",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Laut Berufsbildungsbericht brach zuletzt jeder vierte Lehrling seine Ausbildung ab, allerdings wechseln die Azubis in rund der Hälfte dieser Fälle auf einen anderen Ausbildungsplatz."
                            },
                            {
                                "example_id": "2e67b54f-3123-42e7-a9a3-281e76eee540",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Nach Angaben des Deutschen Gewerkschaftsbunds gibt es in Deutschland über zwei Millionen Menschen zwischen 20 und 34, die keine Ausbildung haben, keinen Ausbildungsplatz, keinen Studienplatz und auch keinen Platz in einem Freiwilligendienst."
                            },
                            {
                                "example_id": "1a2ed91e-5f7a-41ea-a1c6-1cb0c843c4fb",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Wer aber nicht mindestens einen Hauptschulabschluss besitze, habe kaum eine Chance auf einen Ausbildungsplatz, heißt es in der Studie [des Bildungsforschers Klaus Klemm]."
                            },
                            {
                                "example_id": "96486d0c-70a5-4b3f-9ddf-64ec65234852",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Immer mehr junge Menschen sind in der Schweiz von der Invalidenversicherung abhängig. Oft sind psychische Probleme der Grund. Die Migros Aare bietet solchen Personen nun einen Ausbildungsplatz an."
                            },
                            {
                                "example_id": "cd7de662-a83f-495d-b8b7-c0d5a3b41e3d",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Drei Ausbildungsplätze hatte Philipp Reinhold in diesem Jahr zu vergeben, doch nur zwei konnte er besetzen."
                            },
                            {
                                "example_id": "3fb6e0c3-e9c5-4540-b544-257c9280d7fd",
                                "sense_id": "2db1cfbd-267a-3ed1-8b9d-af86f207d37f",
                                "text": "Es werden [vom NDR] derzeit jährlich 10 Ausbildungsplätze in Hamburg und 4 in Hannover angeboten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
