                "senses": [
                    {
                        "sense_id": "6d1297df-4901-315d-9fbc-1bfe71074428",
                        "entry_id": "36f87719-8ab2-3da6-ab75-35d1d07b17fc",
                        "glosses": [
                            "Gottesdienst, der (von einem Militärgeistlichen für Soldaten) im Freien durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057254da-5d61-4053-ab17-9e1f2a4dc8e0",
                                "sense_id": "6d1297df-4901-315d-9fbc-1bfe71074428",
                                "text": "„Nachmittags rückten wir auf eine Wiese außerhalb des Ortes und stellten uns im großen Quadrat zum Feldgottesdienst auf.“"
                            },
                            {
                                "example_id": "7e320a15-dcf0-4303-b47f-76d9a5c655b9",
                                "sense_id": "6d1297df-4901-315d-9fbc-1bfe71074428",
                                "text": "„Nachdem es beim Festabend am Samstag zu keinen nennenswerten Vorkommnissen gekommen und auch der Frühschoppen am Sonntagmorgen nebst dem Kirchenzug zur Festwiese ohne Komplikationen vonstattengegangen war, würde vor allem der Feldgottesdienst den Trachtlern in jenem Jahr in lebhafter Erinnerung bleiben.“"
                            },
                            {
                                "example_id": "044beca2-b994-4dd9-ac5b-52d3dcbccba4",
                                "sense_id": "6d1297df-4901-315d-9fbc-1bfe71074428",
                                "text": "„Auf den Feldgottesdienst folgte der große Festumzug mit der Vereinsfahne als wichtigstem Vorzeigesymbol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
