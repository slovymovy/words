                "senses": [
                    {
                        "sense_id": "f7569706-cd0e-3224-bbdd-b0fb7dde0e0b",
                        "entry_id": "a52a9e48-84bb-317f-9788-ec9c985eb6f6",
                        "glosses": [
                            "interessant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1d7349-7a85-4b4e-bc68-8119f3caaa29",
                                "sense_id": "f7569706-cd0e-3224-bbdd-b0fb7dde0e0b",
                                "text": "Dat is boeiende materie, zeg!"
                            },
                            {
                                "example_id": "3cda0cac-5bbd-4452-b6b2-4d257566033d",
                                "sense_id": "f7569706-cd0e-3224-bbdd-b0fb7dde0e0b",
                                "text": "De queeste naar het dagboek wordt nergens echt spannend en als levensbeschrijving van Rosenberg schiet het ook tekort. Dat is jammer, want het basismateriaal van het boek is boeiend genoeg. Rosenbergs leven laat zien dat ideeën - hoe vaag en theoretisch ze ook mogen lijken - verstrekkende gevolgen kunnen hebben."
                            },
                            {
                                "example_id": "8cb03b57-3426-4ca7-a3ca-21a32a0f3892",
                                "sense_id": "f7569706-cd0e-3224-bbdd-b0fb7dde0e0b",
                                "text": "Het was boeiend te kijken waar mijn benen toe in staat waren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8799417c-1261-46d2-85df-b3ca7d5af554",
                        "source_entry_id": "a52a9e48-84bb-317f-9788-ec9c985eb6f6",
                        "source_sense_id": "f7569706-cd0e-3224-bbdd-b0fb7dde0e0b",
                        "target_lang_word": "interessant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interessant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efec6908-64cd-3f4b-8175-6f2b11b9d74d",
                                        "entry_id": "51bfee09-2dc7-34f3-91f8-38fdb7294f9f",
                                        "glosses": [
                                            "Interesse beanspruchend/weckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d61783-7442-4cf6-b1f2-be00e2f99111",
                                                "sense_id": "efec6908-64cd-3f4b-8175-6f2b11b9d74d",
                                                "text": "„Das Buch solltest du lesen, das ist interessant.“"
                                            },
                                            {
                                                "example_id": "56efdcee-f3e7-4908-b36a-8babccb45fdb",
                                                "sense_id": "efec6908-64cd-3f4b-8175-6f2b11b9d74d",
                                                "text": "Indien ist ein sehr interessantes Land."
                                            },
                                            {
                                                "example_id": "0c74ef56-b40d-4d85-9d5e-f03c897c7355",
                                                "sense_id": "efec6908-64cd-3f4b-8175-6f2b11b9d74d",
                                                "text": "Ich finde, sie ist eine interessante Frau."
                                            },
                                            {
                                                "example_id": "d77ed702-1ac0-4c7a-9962-2a4a1b00a118",
                                                "sense_id": "efec6908-64cd-3f4b-8175-6f2b11b9d74d",
                                                "text": "Es gab viele interessante Gespräche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef76876f-b915-38c2-9230-2d84f80c06ae",
                                        "entry_id": "51bfee09-2dc7-34f3-91f8-38fdb7294f9f",
