                        "form": "urywani"
                    },
                    {
                        "form_id": "397bd942-7e6d-4edd-8082-67225f6db838",
                        "entry_id": "d60f7de1-e076-316c-8274-fcc6b7fdc916",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "urywane"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37169624-861d-3ac7-8f6f-63ab3b4f1bbc",
                        "entry_id": "d60f7de1-e076-316c-8274-fcc6b7fdc916",
                        "glosses": [
                            "niepełny, nie trwający do końca, niedokończony i powtarzający się w pewnych odstępach czasu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3068de-34b3-4826-ac1e-ce4ca5a43241",
                                "sense_id": "37169624-861d-3ac7-8f6f-63ab3b4f1bbc",
                                "text": "Im bardziej się denerwowała, tym bardziej urywana stawała się jej wypowiedź."
                            },
                            {
                                "example_id": "d7cca311-3326-4f47-bd51-87b9245b635a",
                                "sense_id": "37169624-861d-3ac7-8f6f-63ab3b4f1bbc",
                                "text": "— No… no — zaczął chrapliwym, urywanym głosem."
                            },
                            {
                                "example_id": "99d310e4-c453-4b4e-ab18-1748db16bd70",
                                "sense_id": "37169624-861d-3ac7-8f6f-63ab3b4f1bbc",
                                "text": "Odezwały się jęki rannych, nawoływania bliskich, krótkie urywane polecenia sanitariuszy, których nie brakło między pobożnymi i którzy rozpoczęli od razu ratowanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "078c1026-897b-43d1-aec8-9feed3e07ee3",
                        "source_entry_id": "d60f7de1-e076-316c-8274-fcc6b7fdc916",
                        "source_sense_id": "37169624-861d-3ac7-8f6f-63ab3b4f1bbc",
                        "target_lang_word": "отрывистый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отрывистый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "328f7d6a-898f-3509-8597-a96328c42f9d",
                                        "entry_id": "3639189e-7a55-31c1-9c49-f0dd9996f65b",
                                        "glosses": [
                                            "прерывистый, без плавных переходов в звучании; с частыми паузами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ada3cd9-4fdb-4ee0-8c8f-18a5b6d5fbb9",
                                                "sense_id": "328f7d6a-898f-3509-8597-a96328c42f9d",
                                                "text": "У главного врача, человека сорока двух лет, выпуклые, стальные глаза, высокомерное лицо и отрывистая своеобразная речь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cce7f07-696e-3e7c-8ba8-14be69ffe35e",
                                        "entry_id": "3639189e-7a55-31c1-9c49-f0dd9996f65b",
                                        "glosses": [
                                            "не составляющий целого, не образующий единства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "491e2c02-515d-45df-870b-a9a2a9f587bf",
                                                "sense_id": "4cce7f07-696e-3e7c-8ba8-14be69ffe35e",
                                                "text": "При этом он сварливым голосом произносил отрывистые, малопонятные афоризмы об искусстве ваяния."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
