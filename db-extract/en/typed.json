                "translations": [
                    {
                        "translation_id": "e21c0aa9-b0db-4e9b-beb7-af9835f0f0f3",
                        "source_entry_id": "f86dd0d2-b0f6-3437-9364-18640265a869",
                        "source_sense_description": "Translations",
                        "target_lang_word": "maschinengeschrieben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maschinengeschrieben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78b86254-015d-3221-8ce0-214d63d0be19",
                                        "entry_id": "f1f1c4c2-1cf1-3b88-bf84-ec72e75a9920",
                                        "glosses": [
                                            "mithilfe einer Schreibmaschine verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7fe9558-aca3-4afa-b601-fc7a6eff8d19",
                                                "sense_id": "78b86254-015d-3221-8ce0-214d63d0be19",
                                                "text": "„Ich ging zum Fenster und nahm auf dem Sofa Platz. Dort saß ich mit den maschinengeschriebenen Seiten und vergaß alles um mich herum.“"
                                            },
                                            {
                                                "example_id": "522d143c-bdcb-41dd-950d-cc48d8a73b1e",
                                                "sense_id": "78b86254-015d-3221-8ce0-214d63d0be19",
                                                "text": "„Eigentlich handelt es sich bei der ganzen Angelegenheit um eine merkwürdige Häufung von Andeutungen und Nichtgesagtem; vielleicht wäre nie ans Licht gekommen, was im Jahr 1931 tatsächlich in Clotton geschah, hätte man im Haus eines zurückgezogen lebenden Mannes nach dessen Tod nicht ein maschinengeschriebenes Schriftstück gefunden.“"
                                            },
                                            {
                                                "example_id": "1db4fd57-1587-4343-9936-c4687b93a2d7",
                                                "sense_id": "78b86254-015d-3221-8ce0-214d63d0be19",
                                                "text": "„Mit nichts als ein paar maschinengeschriebenen Blättern und einem Händedruck in das Büro eines Vorgesetzten zu marschieren, das erforderte Mut.“"
                                            },
                                            {
                                                "example_id": "549eb350-a82a-4bad-aa7e-41c71388ccca",
                                                "sense_id": "78b86254-015d-3221-8ce0-214d63d0be19",
                                                "text": "„Tags darauf jedoch erhielt sie seine Antwort: eine einzelne, maschinengeschriebene Seite in einem verschlossenen Umschlag, den er im Büro von Danielle Marton abgab.“"
                                            },
                                            {
                                                "example_id": "41d5e014-1cd7-43dc-9e29-2b67ff223f2f",
                                                "sense_id": "78b86254-015d-3221-8ce0-214d63d0be19",
                                                "text": "„Das maschinengeschriebene Schriftstück, das ihm sein Vater reichte, war wie eine billige Parodie auf einen der geheimnisvollen Texte aus Lovecrafts Geschichten: eine literarische Amateurzeitschrift, produziert auf einem alten Vervielfältigungsapparat und in fleckige Pappe gebunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
