{
    "word_family": [
        "devil",
        "devilish",
        "devilishly",
        "devilment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80b086aa-65e4-321a-8082-325472b416d0",
                    "sense_definition": "Reckless, playful, or troublesome behavior; mischief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mischief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children had a spark of sheer <w>devilry</w> in their eyes before running off.",
                            "target_lang_translations": {
                                "ru": "Прежде чем убежать, в глазах детей мелькнула искра настоящего <w>озорства</w>."
                            }
                        },
                        {
                            "text": "Their sudden <w>devilry</w> consisted mostly of prank-calling local businesses late at night.",
                            "target_lang_translations": {
                                "ru": "Их внезапное <w>озорство</w> сводилось в основном к хулиганским звонкам в местные заведения поздно ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "mischief",
                        "devilment",
                        "rascality",
                        "roguery"
                    ],
                    "common_phrases": [
                        "sheer devilry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Озорное, дерзкое или рискованное поведение; шалость, проказливость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озорство",
                                "target_lang_sense_clarification": "шаловливое, задорное поведение"
                            },
                            {
                                "target_lang_word": "бесовство",
                                "target_lang_sense_clarification": "буйное, неуемное озорство"
                            },
                            {
                                "target_lang_word": "чертовщина",
                                "target_lang_sense_clarification": "проделки, шалости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d8a3018-0b18-305a-ac35-9072414e804a",
                    "sense_definition": "Extreme wickedness, malice, or cruelty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain sought to spread absolute <w>devilry</w> across the kingdom.",
                            "target_lang_translations": {
                                "ru": "Злодей стремился посеять абсолютное <w>злодейство</w> по всему королевству."
                            }
                        },
                        {
                            "text": "No one could comprehend the cold-hearted <w>devilry</w> behind such a senseless attack.",
                            "target_lang_translations": {
                                "ru": "Никто не мог постичь бессердечную <w>жестокость</w>, стоявшую за столь бессмысленным нападением."
                            }
                        }
                    ],
                    "synonyms": [
                        "wickedness",
                        "evil",
                        "malice",
                        "cruelty",
                        "iniquity"
                    ],
                    "antonyms": [
                        "goodness",
                        "righteousness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайняя злоба, жестокость или коварство; дьявольское злодеяние."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злодейство",
                                "target_lang_sense_clarification": "крайняя жестокость и зло"
                            },
                            {
                                "target_lang_word": "дьявольщина",
                                "target_lang_sense_clarification": "проявление злой воли или коварства"
                            },
                            {
                                "target_lang_word": "жестокость",
                                "target_lang_sense_clarification": "бессердечие, бессмысленное зло"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b29a7a8-364e-3155-83c0-b08ca71d73d3",
                    "sense_definition": "A specific act of mischief, wickedness, or cruelty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boys spent the whole evening planning further <w>devilries</w> against their neighbors.",
                            "target_lang_translations": {
                                "ru": "Мальчишки провели весь вечер, планируя новые <w>выходки</w> против своих соседей."
                            }
                        },
                        {
                            "text": "What started as innocent games slowly turned into dangerous <w>devilries</w>.",
                            "target_lang_translations": {
                                "ru": "То, что начиналось как безобидные игры, постепенно переросло в опасные <w>проделки</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prank",
                        "misdeed",
                        "atrocity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная проделка, выходка или жестокий поступок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "недопустимый или дерзкий поступок"
                            },
                            {
                                "target_lang_word": "проделка",
                                "target_lang_sense_clarification": "шалость или коварный поступок"
                            },
                            {
                                "target_lang_word": "злая шутка",
                                "target_lang_sense_clarification": "вредная проказа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "525d5b57-b41c-3c3d-88f6-9722531102fc",
                    "sense_definition": "The practice of black magic or sorcery attributed to the devil; witchcraft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers accused the recluse of practicing dark <w>devilry</w> in the woods.",
                            "target_lang_translations": {
                                "ru": "Жители деревни обвинили отшельника в занятиях темным <w>колдовством</w> в лесу."
                            }
                        },
                        {
                            "text": "Ancient tales warned travelers against the strange <w>devilry</w> haunting the abandoned ruins.",
                            "target_lang_translations": {
                                "ru": "Древние сказания предостерегали путников от странной <w>чертовщины</w>, обитающей в заброшенных руинах."
                            }
                        }
                    ],
                    "synonyms": [
                        "witchcraft",
                        "sorcery",
                        "black magic",
                        "necromancy"
                    ],
                    "common_phrases": [
                        "dark devilry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занятие черной магией, колдовством, приписываемое нечистой силе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертовщина",
                                "target_lang_sense_clarification": "колдовские или необъяснимые явления"
                            },
                            {
                                "target_lang_word": "колдовство",
                                "target_lang_sense_clarification": "черная магия"
                            },
                            {
                                "target_lang_word": "чернокнижие",
                                "target_lang_sense_clarification": "занятие темными заклинаниями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}