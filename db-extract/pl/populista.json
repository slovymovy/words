                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f80b4a7-9072-4eb3-b659-8b0437dcaffd",
                        "source_entry_id": "f76656b6-142c-3dc1-ad42-020c1b5867f5",
                        "source_sense_id": "97535204-d938-3ea9-9837-07a20b1dd90e",
                        "target_lang_word": "populist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "populist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e5b4f3-25ca-3144-9e57-8e60bfdb3364",
                                        "entry_id": "6c3518be-b5fb-3b25-a379-baa87312cdcd",
                                        "glosses": [
                                            "A person who advocates populism (a movement against ruling elites who are presumed not to act in the interests of the ordinary citizen)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0da469-667a-443d-abcd-5bd22e3ab4a8",
                                                "sense_id": "f5e5b4f3-25ca-3144-9e57-8e60bfdb3364",
                                                "text": "Critics suggest that Fernández, an unashamed populist and nationalist, is seeking to deflect attention from social disharmony at home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2632fd15-f135-3e9d-b2e2-990e0c618f8b",
                                        "entry_id": "6c3518be-b5fb-3b25-a379-baa87312cdcd",
                                        "glosses": [
                                            "A politician who advocates specific policies just because they are popular."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e074d726-d31d-382d-9bd1-c4166de30cbc",
                                        "entry_id": "6c3518be-b5fb-3b25-a379-baa87312cdcd",
                                        "glosses": [
                                            "A person who advocates democratic principles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "populist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "296dd9ad-48dc-38eb-8115-24f2b46a2ca5",
                                        "entry_id": "7f4fd97f-c002-3509-b496-6e0e467a059c",
                                        "glosses": [
                                            "Democratic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb5a2711-f73e-3c76-a89b-0f033f698786",
                                        "entry_id": "7f4fd97f-c002-3509-b496-6e0e467a059c",
                                        "glosses": [
                                            "Put forward just because it would be popular."
                                        ],
