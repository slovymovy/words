                ],
                "senses": [
                    {
                        "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                        "entry_id": "19ca95f9-f28e-3b72-a363-1229639ede87",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8513e54-4cd2-473e-9624-5e686b969ad4",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Eckert kommt und geht."
                            },
                            {
                                "example_id": "7bd221e6-aeca-4d71-a2d0-2aba3f2055a0",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Eckerts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ffc74b4f-29a3-4a5f-a020-b4c968ea9ece",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Frau Eckert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4ec0aaf9-f58d-4c93-b1cf-2482a4a15e73",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Herr Eckert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ea39c55e-3053-4087-b689-e3aa60613886",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Die Eckerts fliegen heute nach Kanada."
                            },
                            {
                                "example_id": "cb81253b-44a6-4a0b-9cd7-c63c1d8c67f1",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Der Eckert trägt nie die Pullover, die die Eckert ihm strickt."
                            },
                            {
                                "example_id": "4a0edf49-e0fb-40e8-9d32-7027c0daec02",
                                "sense_id": "16a35607-bfd6-3c0a-9bed-a4eeb3f2c39a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eckert kommt, geht der Herr Eckert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
