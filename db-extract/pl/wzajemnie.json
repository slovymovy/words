                                "sense_id": "9bd228d3-717c-37f1-b52a-ba8891c50a9b",
                                "text": "Zrobili sobie wzajemnie krzywdę."
                            },
                            {
                                "example_id": "56af8569-5666-4568-aab2-df10858889a8",
                                "sense_id": "9bd228d3-717c-37f1-b52a-ba8891c50a9b",
                                "text": "Dziś w życiu coraz większej liczby kobiet firma zajmuje dawne miejsce mężczyzny - to firma zapewnia jej utrzymanie, bezpieczeństwo, kontakty i pozycję, to ludzie z firmy pomagają sobie wzajemnie, zupełnie jak członkowie rodziny"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d12fd762-5180-3c76-a46d-ed6b14143f92",
                        "entry_id": "dcaaaab4-ba5c-3cb4-8c63-d8e468c7b1fb",
                        "glosses": [
                            "również, tak samo – w odpowiedzi na czyjeś życzenia"
                        ],
