                                "example_id": "0921db04-37eb-47e2-9aba-33f778befeb4",
                                "sense_id": "17f8f3b8-df6e-3e20-9536-5806bcf5941b",
                                "text": "trop contente une photo de moi ! c'est rare vu que c'est moi qui \"paparazzise\" tout le monde!!"
                            }
