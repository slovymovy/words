                "translations": [
                    {
                        "translation_id": "c11ccca0-8165-430e-9e10-f62b50b360de",
                        "source_entry_id": "7789cf4f-097a-363e-bd50-9f92f344bd24",
                        "source_sense_id": "47665cb9-2a52-3dcc-acbb-09ccf6f07415",
                        "target_lang_word": "parallel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parallel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8889b46e-e160-359f-9c84-2def80a8993c",
                                        "entry_id": "b00ff969-5201-3963-bdae-3020f63f4787",
                                        "glosses": [
                                            "Equally distant from one another at all points."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a8d30d0-9ee8-4a1e-a533-44379a34c53a",
                                                "sense_id": "8889b46e-e160-359f-9c84-2def80a8993c",
                                                "text": "The horizontal lines on my notebook paper are parallel."
                                            },
                                            {
                                                "example_id": "a51a1d63-cc72-4f4c-8552-6175c9dc54ee",
                                                "sense_id": "8889b46e-e160-359f-9c84-2def80a8993c",
                                                "text": "the instrument held with its plane roughly parallel to the equinoctial or celestial equato"
                                            },
                                            {
                                                "example_id": "733e928a-032e-4369-ae5d-9737b0f1014e",
                                                "sense_id": "8889b46e-e160-359f-9c84-2def80a8993c",
                                                "text": "Upon interaction with ss- nucleic acid (NA) targets (deoxyribooligonucleotides (ODNs) or ribooligonucleotides), they form very stable anti-parallel and parallel duplexes [3 ], and the melting temperatures of the antiparallel duplexes are 10 to 15°C higher than those of the parallel duplexes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794ba2c7-cdc4-30e2-91af-6089bea5d027",
                                        "entry_id": "b00ff969-5201-3963-bdae-3020f63f4787",
                                        "glosses": [
                                            "Having the same overall direction; the comparison is indicated with \\\"to\\\"."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3ba2d3-d818-4a2d-b16b-fb75bf6dd209",
                                                "sense_id": "794ba2c7-cdc4-30e2-91af-6089bea5d027",
                                                "text": "The two railway lines are parallel."
                                            },
                                            {
                                                "example_id": "7749b628-2a69-4b53-9f95-6de2b2de7abf",
                                                "sense_id": "794ba2c7-cdc4-30e2-91af-6089bea5d027",
                                                "text": "When honour runs parallel with the laws of God and our country, it cannot be too much cherished."
                                            },
                                            {
                                                "example_id": "d0ddfaf1-e17a-4009-8d71-edacf9e3da21",
                                                "sense_id": "794ba2c7-cdc4-30e2-91af-6089bea5d027",
                                                "text": "All three parallel valleys of the Llynvi, Garw and Ogmore are much the same in physical character: the lower reaches are wooded and not unattractive, but as the railway climbs on ever-steepening grades, the hills on either hand grow barer and closer together, while in all respects the scene becomes more sombre, with the terraced, slate-roofed colliery towns and the road, railway and river all struggling for space in the narrowing defiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7819ef3-16ec-35a1-b5aa-593cd6b67429",
                                        "entry_id": "b00ff969-5201-3963-bdae-3020f63f4787",
                                        "glosses": [
                                            "Either not intersecting, or coinciding."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "777e77aa-37fb-3b5f-9bee-74228880e94d",
                                        "entry_id": "b00ff969-5201-3963-bdae-3020f63f4787",
                                        "glosses": [
                                            "Involving the processing of multiple tasks at the same time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "310811c7-f14d-4240-8e72-0acbe304c245",
                                                "sense_id": "777e77aa-37fb-3b5f-9bee-74228880e94d",
                                                "text": "a parallel algorithm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ae6dd15-1da6-3945-9d94-d0b9585e95c1",
                                        "entry_id": "b00ff969-5201-3963-bdae-3020f63f4787",
                                        "glosses": [
                                            "Analogous, similar, comparable."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34c716f-949c-4644-ada2-711f8c7d8d06",
                                                "sense_id": "3ae6dd15-1da6-3945-9d94-d0b9585e95c1",
                                                "text": "the parallel lives of two citizens"
                                            },
                                            {
                                                "example_id": "13fc4cca-a3c1-4bab-80d6-a492514db151",
                                                "sense_id": "3ae6dd15-1da6-3945-9d94-d0b9585e95c1",
                                                "text": "In those days she had admired his pluralistic openness of mind, and struggled, in her kitchen, towards a parallel eclecticism, learning to cook the dosas and uttapams of South India as well as the soft meatballs of Kashmir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fff6b006-f33c-3a41-80cb-e86139fa290b",
                                        "entry_id": "b00ff969-5201-3963-bdae-3020f63f4787",
                                        "glosses": [
                                            "Coexisting but normally not interacting with the regular reality."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62101e3-8344-428e-8645-70c5f57aacb7",
                                                "sense_id": "fff6b006-f33c-3a41-80cb-e86139fa290b",
                                                "text": "parallel universe"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parallel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b2f76f-c12b-368f-b158-b3b31bbc14dd",
                                        "entry_id": "f52b93d0-e76f-3424-893d-d9f42a38a7c1",
                                        "glosses": [
                                            "With a parallel relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a5d684e-8545-491c-a263-af731fd8524e",
                                                "sense_id": "e8b2f76f-c12b-368f-b158-b3b31bbc14dd",
                                                "text": "The road runs parallel to the canal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parallel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0fd924-24fd-3c1d-afc9-4dc7e8582042",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "One of a set of parallel lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b977c33c-25ae-4c90-997c-afc5022a7254",
                                                "sense_id": "1c0fd924-24fd-3c1d-afc9-4dc7e8582042",
                                                "text": "Who made the spider parallels design, / Sure as De Moivre, without rule or line?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83908c1a-b3d2-3cae-a281-41e9eb9ea77a",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "Direction conformable to that of another line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b2c67b3-b38a-49fe-87f2-494b545cf73a",
                                                "sense_id": "83908c1a-b3d2-3cae-a281-41e9eb9ea77a",
                                                "text": "lines that from their parallel decline"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21b2f91f-3dbc-3b1a-9fb3-ef02392429c7",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "A line of latitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6495948-08d5-48c9-96cf-9d78289bcfef",
                                                "sense_id": "21b2f91f-3dbc-3b1a-9fb3-ef02392429c7",
                                                "text": "The 31st parallel passes through the center of my town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31d1928f-e12c-3bae-863f-384a7bdc7098",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "An arrangement of electrical components such that a current flows along two or more paths; see in parallel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80f87204-e6a7-3fad-b2d8-b64a43afbe1f",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "Something identical or similar in essential respects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59e5f95-d1a5-410a-b01e-8ca7a6444188",
                                                "sense_id": "80f87204-e6a7-3fad-b2d8-b64a43afbe1f",
                                                "text": "It has also been suggested that environmental crimes might include the proposed crime of ‘ecocide’ or ‘geocide’, with proponents of this view attempting to draw parallels between destructive acts towards the environment and those against the qualifying groups for genocide. […] [M]any who advocate for the creation of either ecocide or geocide principally argue that the best place to try such crimes is through an apparatus created in a separate and environment-oriented treaty."
                                            },
                                            {
                                                "example_id": "8606ca5f-8058-4b29-833d-335e76893a15",
                                                "sense_id": "80f87204-e6a7-3fad-b2d8-b64a43afbe1f",
                                                "text": "None but thyself can be thy parallel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f8ad06-691d-398b-840d-99a41d80f79d",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "A comparison made; elaborate tracing of similarity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582e9792-4514-4c48-b64a-68dbafa22f7c",
                                                "sense_id": "43f8ad06-691d-398b-840d-99a41d80f79d",
                                                "text": "Johnson's parallel between Dryden and Pope"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dba5466d-b13d-3011-a562-734f5d006adb",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "One of a series of long trenches constructed before a besieged fortress, by the besieging force, as a cover for troops supporting the attacking batteries. They are roughly parallel to the line of outer defenses of the fortress."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04da4896-c1ed-3873-8974-1ea5120a9b65",
                                        "entry_id": "8943ab79-a51a-33af-b8eb-1c6efe556ed8",
                                        "glosses": [
                                            "A character consisting of two parallel vertical lines, used in the text to direct attention to a similarly marked note in the margin or at the foot of a page."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "parallel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ccd61dd-b26d-328f-8ae0-9f3150d461f3",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "To construct or place something parallel to something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46b41c57-f666-41b9-87e9-418f41942d9e",
                                                "sense_id": "8ccd61dd-b26d-328f-8ae0-9f3150d461f3",
                                                "text": "The needle […] doth parallel and place itself upon the true meridian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cac1363b-7559-355c-9e16-896bbfe30273",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "Of a path etc: To be parallel to something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11a492f5-3025-4e5f-8deb-96cfbb18e32a",
                                                "sense_id": "cac1363b-7559-355c-9e16-896bbfe30273",
                                                "text": "Archaic covered bridges lingered fearsomely out of the past in pockets of the hills, and the half-abandoned railway track paralleling the river seemed to exhale a nebulously visible air of desolation."
                                            },
                                            {
                                                "example_id": "f9b7c427-662c-4825-ae63-30a0a7253b6a",
                                                "sense_id": "cac1363b-7559-355c-9e16-896bbfe30273",
                                                "text": "Racing on, we parallel the M5 doing 95mph, according to the app on my smartphone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38a43611-e2ab-3cc6-ac25-0727c2b2aa07",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "Of a process etc: To be analogous to something else."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dbdb5f9-d39f-3994-99ea-170017c4311e",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "To compare or liken something to something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e16c77e-2f62-4749-912a-a3bc6d4fcddd",
                                                "sense_id": "4dbdb5f9-d39f-3994-99ea-170017c4311e",
                                                "text": "Although its spokesmen do not hesitate to parallel their oppression to that of blacks, the gay male community has chosen to ignore the voices of black gay men."
                                            },
                                            {
                                                "example_id": "c8d03d4e-ffa2-412c-8c03-31f6e196e02f",
                                                "sense_id": "4dbdb5f9-d39f-3994-99ea-170017c4311e",
                                                "text": "These scholars argue that gender and sexual identity are like nature and the environment; they parallel the queer/performance connection to the environmental/performance connection. I consider, instead, how all these categories actively interact and overlap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45eb2733-a38b-3fc9-a9dc-188a4caed779",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "To make to conform to something else in character, motive, aim, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5be7d3e7-1fa6-4058-89d6-8bd081b02818",
                                                "sense_id": "45eb2733-a38b-3fc9-a9dc-188a4caed779",
                                                "text": "[H]is life is paralel’d / Euen with the ſtroke and line of his great Iuſtice: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6adee2e-9a5c-324c-a9c8-cb6f82145e57",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "To equal; to match; to correspond to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee173ae-7527-468f-a86d-615bd235c454",
                                                "sense_id": "b6adee2e-9a5c-324c-a9c8-cb6f82145e57",
                                                "text": "He will ſteale ſir an Egge out of a Cloiſter: for rapes and rauiſhments he paralels Neſſus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3783f317-8945-32de-8b6f-292181f1935b",
                                        "entry_id": "c1751667-6176-3a06-9e75-968eaafd06d3",
                                        "glosses": [
                                            "To produce or adduce as a parallel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265f7b89-1000-4734-ab91-f84b450c45a8",
                                                "sense_id": "3783f317-8945-32de-8b6f-292181f1935b",
                                                "text": "Macb[eth]. ’Twas a rough Night. / Lenox. My young remembrance cannot paralell / A fellow to it."
                                            },
                                            {
                                                "example_id": "ee7db7d6-624a-4ce7-87d0-dc815b5b4bb6",
                                                "sense_id": "3783f317-8945-32de-8b6f-292181f1935b",
                                                "text": "Who cannot parallel theſe ſtories out of his experience?"
                                            },
                                            {
                                                "example_id": "120470ce-e220-4d0e-b1d7-acc9e8a5b21f",
                                                "sense_id": "3783f317-8945-32de-8b6f-292181f1935b",
                                                "text": "Many have exerciſed their Wits in parallelling the Inconveniences of Regal and Popular Government, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f976215f-6921-4d74-85a3-3d2a80644d8e",
                        "source_entry_id": "7789cf4f-097a-363e-bd50-9f92f344bd24",
