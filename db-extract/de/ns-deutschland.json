                                "example_id": "5e7a6599-403e-4b1b-8e87-f6473bc1247a",
                                "sense_id": "938b48e4-a9a3-37cf-9662-cc51ea76e3e8",
                                "text": "„Der Zweite Weltkrieg und der Sieg über NS-Deutschland verliehen der Sowjetunion auch militärisch den Status einer Weltmacht.“"
                            }
                        ],
