                "senses": [
                    {
                        "sense_id": "8e0a3e20-0085-3457-b303-05d5481dd615",
                        "entry_id": "38f93d90-7baf-3c6e-a908-301ffb4ccd97",
                        "glosses": [
                            "walzenförmige Weinflasche, die sich erst am letzten Teilstück zum Flaschenhals hin stark verjüngt; dieser Flaschentyp wurde klassischerweise für den Vertrieb von Bordeaux-Rotweinen genutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3439139-8c6b-4282-affc-ed754a83e36d",
                                "sense_id": "8e0a3e20-0085-3457-b303-05d5481dd615",
                                "text": "Bordeauxflaschen sind leicht an ihrer Schulter zu erkennen."
                            },
                            {
                                "example_id": "a00424b2-2682-4b03-a1a9-9ce243967f51",
                                "sense_id": "8e0a3e20-0085-3457-b303-05d5481dd615",
                                "text": "Leider werden heute fast alle deutschen Rotweine auf Bordeauxflaschen abgefüllt."
                            },
                            {
                                "example_id": "d6d278b8-07d5-4b9a-94e7-d8bff9b1e666",
                                "sense_id": "8e0a3e20-0085-3457-b303-05d5481dd615",
                                "text": "Der Boden der Bordeauxflasche ist leicht gewölbt, um zu verhindern, dass Ablagerungen beim Eingießen aufgespült werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
