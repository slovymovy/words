                                "target_lang_word": "烦人",
                                "target_lang_sense_clarification": "causing irritation"
                            },
                            {
                                "target_lang_word": "讨厌",
                                "target_lang_sense_clarification": "bothersome or unpleasant"
                            },
                            {
                                "target_lang_word": "恼人",
                                "target_lang_sense_clarification": "vexatious or troublesome"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5c8cc341-019e-3af4-b3ae-51400102e2ad",
                    "sense_definition": "Present participle and gerund of <w>annoy</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop <w>annoying</w> your brother while he is doing his homework.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, перестань <w>донимать</w> брата, пока он делает уроки.",
                                "zh": "请不要在你哥哥写作业时<w>烦扰</w>他。"
                            }
                        },
                        {
                            "text": "The loud construction noise is <w>annoying</w> everyone in the office.",
                            "target_lang_translations": {
                                "ru": "Громкий шум стройки <w>раздражает</w> всех в офисе.",
                                "zh": "巨大的施工噪音正在<w>惹恼</w>办公室里的每一个人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop annoying",
                        "keep annoying"
                    ],
                    "traits": [
