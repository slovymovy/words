                ],
                "senses": [
                    {
                        "sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                        "entry_id": "d88f7fd7-3559-3527-8060-e46385137d82",
                        "glosses": [
                            "книжн. действие по значению гл. интенсифицировать; увеличение интенсивности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03d5d248-84f2-4824-863d-ee4aa71dfcd9",
                                "sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                                "text": "У меня в связи с интенсификацией огородных и строительных усилий наблюдается определённый куркулизм и даже где-то обрастание шерстью."
                            },
                            {
                                "example_id": "0927d884-d915-41ba-bccb-bb4470acd065",
                                "sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                                "text": "Сибирь даёт много новой обработанной земли, а интенсификация сельского хозяйства даст возможность повысить производство."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8126c4ab-d47e-485c-8eb8-2b4a6c24e83b",
                        "source_entry_id": "d88f7fd7-3559-3527-8060-e46385137d82",
                        "source_sense_id": "1781f0d3-409c-38c7-92fd-2c5c2336e11f",
                        "target_lang_word": "intensification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intensification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                        "entry_id": "9d6fde05-06b9-3e2b-88a0-4e8d0c310db1",
                                        "glosses": [
                                            "The act or process of intensifying, or of making more intense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3936244-1442-4812-845f-c8df42585f6e",
                                                "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                                "text": "With the intensification of air raids on London last September, these tube platforms began to be used as an air raid shelter, and shelterers travelled by train (specially stopped there) from other stations in order to gain access."
                                            },
                                            {
                                                "example_id": "6d1fbc23-6541-4610-9ff0-488dcb463702",
                                                "sense_id": "7ffec866-b0e7-3249-8be7-18c7821f1e06",
                                                "text": "[...] moreover, the layout fortunately allows for the likely intensification of the suburban service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
