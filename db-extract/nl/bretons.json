                    },
                    {
                        "translation_id": "a50932a8-84f9-4ea9-b96d-ef8365cf1f24",
                        "source_entry_id": "721b8fa0-6e85-3839-aad0-963e6e7d5f9f",
                        "source_sense_id": "b780aafc-bebf-3369-a18b-dfb131c01081",
                        "source_sense_description": "een Keltische taal die wordt gesproken in Bretagne",
                        "target_lang_word": "Bretonisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bretonisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                        "entry_id": "fdcdc2c1-df80-3c28-aff3-d2cd9fa9cbfb",
                                        "glosses": [
                                            "die Sprache der Bretonen in der Bretagne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366f163f-cad9-4db3-935a-fb368581dcbd",
                                                "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                                "text": "Sprechen Sie Bretonisch?"
                                            },
                                            {
                                                "example_id": "234d7035-6efb-4bd9-be86-f5c065caf5ec",
                                                "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                                "text": "Wie heißt das auf Bretonisch?"
                                            },
                                            {
                                                "example_id": "ac30fe04-19b3-4cf1-ba5d-8e3a9b370265",
                                                "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                                "text": "Das Bretonische ist mit dem Walisischen verwandt."
                                            },
                                            {
                                                "example_id": "524e3521-06a1-4d3a-920d-da1b44385805",
                                                "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                                "text": "„Eine Kakophonie von Stimmen und Rufen erfüllt den Platz, und das Bretonisch und Gälisch der Bauern, beides Sprachen, die ihren Ursprung auf den Britischen Inseln haben und auf dem Land um Vannes gebräuchlich sind, übertönt oft das Französisch der Städter.“"
                                            },
                                            {
                                                "example_id": "58774c9c-dd39-4eb2-b179-11b30411539c",
                                                "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                                "text": "„Bei den inselkeltischen Sprachen wiederum unterscheidet man die goidelische Sprachgruppe mit den Sprachen Irisch, Gälisch und Manx und die britannische Sprachgruppe mit den Sprachen Kymrisch, Kumbrisch, Kornisch und Bretonisch.“"
                                            },
                                            {
                                                "example_id": "4240117e-420a-4fae-8edf-c23166845026",
                                                "sense_id": "405c56b0-d53c-37e4-b3c6-3a8a21f48db8",
                                                "text": "„Zur selben Zeit siedelten auch Kelten aus Südengland in die Bretagne über, wo sich das Bretonische bildete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
