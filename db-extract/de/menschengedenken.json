                        "form": "dem Menschengedenken"
                    },
                    {
                        "form_id": "54a497f0-0fd8-4318-877c-66cc158ad7da",
                        "entry_id": "52ea3424-a41a-3b6a-ade5-5c031f07d776",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Menschengedenken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e665a3b-d5f4-3d66-b9e3-d85361ee2e09",
                        "entry_id": "52ea3424-a41a-3b6a-ade5-5c031f07d776",
                        "glosses": [
                            "der gesamte Zeitraum der Menschheitsgeschichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98517d33-ab74-43f1-bacd-10a3089bcb1d",
                                "sense_id": "3e665a3b-d5f4-3d66-b9e3-d85361ee2e09",
                                "text": "Seit Menschengedenken ist eine der wichtigsten Aufgaben die Versorgung und Erziehung des Nachwuchses."
                            },
                            {
                                "example_id": "45c293f7-4a18-42df-aa67-ab778c400a48",
                                "sense_id": "3e665a3b-d5f4-3d66-b9e3-d85361ee2e09",
                                "text": "„Halluzinogene sind in zahlreichen Pflanzen enthalten, die anscheinend seit Menschengedenken und in allen Kulturen als Rauschmittel verwendet werden.“"
                            },
                            {
                                "example_id": "fd20b316-5769-4705-b373-1f3bd7378bcb",
                                "sense_id": "3e665a3b-d5f4-3d66-b9e3-d85361ee2e09",
                                "text": "„Dennoch priesen es die großen Weltreligionen seit Menschengedenken als segensreich, die Fleischeslust abzutöten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff930cac-7355-3bcf-bef3-cabafa789db5",
                        "entry_id": "52ea3424-a41a-3b6a-ade5-5c031f07d776",
                        "glosses": [
                            "der Zeitraum, soweit die persönliche Erinnerung irgend eines Menschen zurückreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e42ed6-eb0c-460f-9b19-679c607eff40",
                                "sense_id": "ff930cac-7355-3bcf-bef3-cabafa789db5",
                                "text": "In der Nähe der Dörfer Uttewalde und Lohmen war ein verheerender Wolkenbruch niedergegangen, ein Wolkenbruch, wie man ihn seit Menschengedenken in dieser Gegend nicht erlebt hatte."
                            },
                            {
                                "example_id": "3eb7da86-da53-4f17-934e-de699b9145d6",
                                "sense_id": "ff930cac-7355-3bcf-bef3-cabafa789db5",
                                "text": "„Immer dann, wenn draußen die Kälte die Landschaft erstarren ließ, rückten früher die Menschen im Eichsfeldischen noch näher zusammen, als die seit Menschengedenken ohnehin der Fall war.“"
                            },
                            {
                                "example_id": "33b4039e-8f76-4041-8e58-e26df0605769",
                                "sense_id": "ff930cac-7355-3bcf-bef3-cabafa789db5",
                                "text": "„Seit Menschengedenken hatte kein Mädchen je solchen Erfolg gehabt wie diese junge Dame.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffae5964-2d9a-464d-97a9-99adc5e49e99",
                        "source_entry_id": "52ea3424-a41a-3b6a-ade5-5c031f07d776",
                        "source_sense_id": "3e665a3b-d5f4-3d66-b9e3-d85361ee2e09",
                        "source_sense_description": "der gesamte Zeitraum der Menschheitsgeschichte",
                        "target_lang_word": "time immemorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "time immemorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                        "entry_id": "3c2ca162-3085-336c-b3f7-05f91658c59f",
                                        "glosses": [
                                            "Time that extends beyond memory or record."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d588fbd-d542-491a-940c-98fd4f7dea65",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "from time immemorial"
                                            },
                                            {
                                                "example_id": "75ad4672-1bbf-46db-bd7e-e817ab67fac1",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "My home is in the North of Palestine on the other side of Jordan, beyond the Sea of Galilee. My family has dwelt there from time immemorial, but they always loved this city, and have a legend that they dwelt occasionally within its walls, even in the days when Titus from that hill looked down upon the temple."
                                            },
                                            {
                                                "example_id": "e71c6092-30d5-485e-8148-6748c5971084",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "The tower had been consecrated to this ancient diversion from time immemorial, the western façade conveniently forming the boundary of the churchyard at that end, where the ground was trodden hard and bare as a pavement by the players."
                                            },
                                            {
                                                "example_id": "5958970d-e301-4adb-ab43-247b9939c455",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "She had worn from time immemorial an old blue satin dress, and a white crape shawl embroidered in colors; […]"
                                            },
                                            {
                                                "example_id": "fcf366d8-5c4d-4308-84b5-bdbc0e7bd856",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "In every Circular or Polygonal household it has been a habit from time immemorial[…]that the mothers and daughters should constantly keep their eyes and mouths towards their husband and his male friends; and for a lady in a family of distinction to turn her back upon her husband would be regarded as a kind of portent, involving loss of status."
                                            },
                                            {
                                                "example_id": "97881c87-bb1f-4774-bdda-622b53eae923",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "The Communists have no need to introduce community of women; it has existed almost from time immemorial."
                                            },
                                            {
                                                "example_id": "54e7b4c0-dd12-418b-87ef-85822297ea2a",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "This is a great tract of a hundred thousand acres, which from time immemorial has been a hunting preserve of the nobility."
                                            },
                                            {
                                                "example_id": "b6e05ff3-d7e7-44dd-b54f-e1e8a1762718",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "That there is and from time immemorial has been within that part of the parish called Mablethorpe St. Mary's a laudable custom that, if any outdweller take ancient pasture ground, he shall pay a modus of 4d. an acre, and so in proportion, on the 1st of August, in lieu of all manner of tithe; and that if any of the ancient pasture be once ploughed up or meadowed, it shall, when restored to pasture again, pay 4d. the acre in the hands of such outdweller."
                                            },
                                            {
                                                "example_id": "98eaec7f-1066-48e7-951c-5bc6dd256981",
                                                "sense_id": "2855a3b6-1e63-3aa7-a685-a4b07372cdba",
                                                "text": "This thing is a \"pyramid\" since time immemorial, shit goes downhill, money goes up: it's that simple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c74a9b62-d9b9-3609-a9d4-f6d2cc33b4f0",
                                        "entry_id": "3c2ca162-3085-336c-b3f7-05f91658c59f",
                                        "glosses": [
                                            "Time before 6 July 1189."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
