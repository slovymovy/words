                        "sense_id": "77791ed3-9d70-3132-b71b-b2aad4d280df",
                        "entry_id": "5a69a70a-03fc-3879-a1c3-2d2b88310abd",
                        "glosses": [
                            "Méthode de rééducation qui permet à l’aide d’appareils de mobiliser les articulations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce7f2ed-a389-4f68-a086-71c1d425254f",
                                "sense_id": "77791ed3-9d70-3132-b71b-b2aad4d280df",
                                "text": "Par l’intermédiaire d’un support mécanique comme la pouliethérapie ou la mécanothérapie, le patient peut obtenir une mobilisation directe des articulations."
                            },
                            {
                                "example_id": "a64aae8e-b0db-463c-9886-c9873068f006",
                                "sense_id": "77791ed3-9d70-3132-b71b-b2aad4d280df",
                                "text": "On avait montré à Édouard des appareils dentaires de mécanothérapie, des têtes en plâtre équipées de tiges en acier, toutes sortes de dispositifs d’aspect moyenâgeux qui étaient le dernier cri de la science orthopédique."
                            }
                        ]
                    }
                ],
