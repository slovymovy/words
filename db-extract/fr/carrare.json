        "fr-extract.jsonl": [
            {
                "entry_id": "67512a3a-394d-3400-8395-3b0b8a419638",
                "word": "Carrare",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "999a7f27-d3b0-3efa-a131-ae068c1e1a22",
                        "entry_id": "67512a3a-394d-3400-8395-3b0b8a419638",
                        "glosses": [
                            "Ville de la province de Massa-Carrara dans la région de Toscane, en Italie, célèbre par son marbre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f993961-c5b5-486f-84a3-3d62841e6f67",
                                "sense_id": "999a7f27-d3b0-3efa-a131-ae068c1e1a22",
                                "text": "Seravezza était un point de départ des mieux choisis pour quelques tournées qui devaient me conduire aux points les plus curieux de la Toscane, si riche en mines et en carrières, et surtout à deux centres d’exploitation justement célèbres, l’Altissimo et Carrare,\n— l’Altissimo, où le génie de Michel-Ange, obéissant à la volonté patriotique d’un Médicis, Léon X, découvrit, il y a plus de trois siècles, des gisemens de marbres qui, retrouvés il y a quarante ans, n’ont pas cessé depuis d’être exploités ;\n— Carrare, où tous les habitans tiennent le ciseau comme sculpteurs ou comme carriers, et dont les marbres, connus bien avant ceux de Seravezza, ont depuis deux mille ans fourni tant de précieux matériaux à l’architecture et aux arts d’ornement comme à la statuaire."
                            }
                        ]
                    }
