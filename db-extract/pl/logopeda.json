                        "cross_references": [
                            {
                                "target_word": "Logopäde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09544f7c-d94f-3cda-bbe2-9b19df0ab98e",
                                        "entry_id": "8c102fae-a9fa-33f1-b2d5-96c74300dc4f",
                                        "glosses": [
                                            "Person, die beruflich Logopädie betreibt, also Sprachstörungen/Sprachentwicklungsstörungen behandelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77a7c6d-973c-4790-b670-cc37ef5e2b45",
                                                "sense_id": "09544f7c-d94f-3cda-bbe2-9b19df0ab98e",
                                                "text": "„Und Therapeuten wie Logopäden und andere kommen dann in die Kitas und arbeiten dort mit den Kindern.“"
                                            },
                                            {
                                                "example_id": "e42715f1-9e04-4eac-afd3-9925a6cb923f",
                                                "sense_id": "09544f7c-d94f-3cda-bbe2-9b19df0ab98e",
                                                "text": "„Jeder Logopäde wird darüberhinaus aus der Beobachtung einzelner Stammler angeben können, mit welcher Häufigkeit einzelne Konsonanten ersetzt werden und welche insbesondere als Ersatzkonsonanten dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
