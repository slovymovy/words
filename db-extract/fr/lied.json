                        "sense_id": "d2493ed0-f650-357c-881b-678f84a15f7e",
                        "entry_id": "16d5a245-f073-3b0f-8ca3-2fc4c865a9a6",
                        "glosses": [
                            "Chanson allemande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77331b20-e9d2-490b-97fc-8290971d0610",
                                "sense_id": "d2493ed0-f650-357c-881b-678f84a15f7e",
                                "text": "Paula feuillette les partitions disposées à côté du piano.\nEt choisit finalement celle d’un lied de Schubert."
                            },
                            {
                                "example_id": "ed61196d-e2b3-477e-ad4c-4c0895dbf4ba",
                                "sense_id": "d2493ed0-f650-357c-881b-678f84a15f7e",
                                "text": "Les amis trinquèrent et, d’une voix de fausset, d’une vraie voix russe, ils se mirent à chanter avec émotion cet ancien lied des étudiants allemands."
                            },
                            {
                                "example_id": "39a266a7-11b6-4182-b011-39845aa16d89",
                                "sense_id": "d2493ed0-f650-357c-881b-678f84a15f7e",
                                "text": "Et comme le percepteur serrait la boucle de la courroie, tout à coup des faneuses et des faucheurs, qui se rendaient chez eux après le travail, se mirent à chanter ensemble le vieux lied : Quand je pense à ma bien-aimée !"
                            }
                        ]
                    }
                ],
