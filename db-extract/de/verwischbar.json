                    },
                    {
                        "form_id": "7726b8bb-2841-401f-b228-a617cbd0175b",
                        "entry_id": "4f61069a-c481-3978-9518-c9fa80b3a556",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind verwischbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                        "entry_id": "4f61069a-c481-3978-9518-c9fa80b3a556",
                        "glosses": [
                            "so, dass es verwischt werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "b70802b0-ada0-4b0f-a3f6-335b40a7ffc7",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Tyvek® war aber in Versuchen nicht erfolgreich genug, die Tinte war verwischbar und es ließ sich zerreißen.“"
                            },
                            {
                                "example_id": "bb7bc762-53a0-467f-8c2f-882fb9cd1a34",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Die Bezeichnung muß in deutscher Sprache abgefaßt, deutlich, nicht verwischbar und dauerhaft an der Seite des Gefäßes, welche das Gefäßschild trägt, angebracht sein.“"
                            },
                            {
                                "example_id": "25eb93c4-a19e-447c-b8c3-a9368a9531d0",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Doch besteht der Unterschied, dass bei dem Intransitivum nicht so normaler Weise wie beim Pass. an eine wirkende Ursache gedacht wird. Dieser Unterschied ist [in einigen Sprachen] aber leicht verwischbar.“"
                            },
                            {
                                "example_id": "e1ea7475-8135-4137-8029-a19a54a633d7",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Alle acht Tage eine leidenschaftliche Laune, ein Name, der in allen Redewendungen wiederkehrte und den Rosalie sorgfältig zu jeder Mahlzeit auf die kleine hübsch verzierte Speisekarte schrieb, der aber dann plötzlich wieder verschwand, als wäre die Persönlichkeit des Betreffenden ebenso hinfällig, ebenso leicht verwischbar befunden worden, wie die Malerei der kleinen Karte.“"
                            },
                            {
                                "example_id": "7861351a-51ee-4e75-9e19-939a61caf0ef",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Es ist hiernach leicht zu verstehen, dass eine solche Stiftzeichnung um so leichter verwischbar sein wird, und daher um so mehr der Fixierung bedarf, je gröber das Farbpulver, je weniger rauh die Unterlage und je dicker der Auftrag ist.“"
                            },
                            {
                                "example_id": "45a4fb24-25fa-4ae7-a079-d7ff7246635a",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Die verpflichtenden Angaben sind verständlich, gut lesbar und dauerhaft bzw. nicht verwischbar mit einer Mindestschriftgröße von 1,2 mm aufzudrucken und im Sichtfeld der Verpackung zu platzieren.“"
                            },
                            {
                                "example_id": "b29e3d71-d132-4982-bffa-db56afc06abf",
                                "sense_id": "1f8a1f3e-c8ae-35b9-a955-eadae3594ea6",
                                "text": "„Die ersten Farbdruckversuche auf Fotopapier sind soweit gut geworden, jedoch wurde ich bei einfachem Textdruck sehr enttäuscht: Das Gedruckte ist sehr leicht verwischbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
