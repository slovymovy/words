{
    "word_family": [
        "gross",
        "grossness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1aebdb22-10de-30bc-a799-ce06aec7f977",
                    "sense_definition": "Extremely, excessively, or to an unacceptable degree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public transport system was <w>grossly</w> overcrowded during peak morning hours.",
                            "target_lang_translations": {
                                "es": "El sistema de transporte público estaba <w>extremadamente</w> abarrotado durante las horas pico de la mañana."
                            }
                        },
                        {
                            "text": "The initial cost of the renovation project was <w>grossly</w> underestimated by the planners.",
                            "target_lang_translations": {
                                "es": "El costo inicial del proyecto de renovación fue <w>enormemente</w> subestimado por los planificadores."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grossly unfair",
                        "grossly exaggerated",
                        "grossly underestimated"
                    ],
                    "target_lang_definitions": {
                        "es": "De manera extrema, excesiva o hasta un grado inaceptable."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "extremadamente",
                                "target_lang_sense_clarification": "en grado sumo o excesivo"
                            },
                            {
                                "target_lang_word": "enormemente",
                                "target_lang_sense_clarification": "de forma desmedida"
                            },
                            {
                                "target_lang_word": "sumamente",
                                "target_lang_sense_clarification": "muy o altamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da71528-716c-3fda-a5ee-b33804460cfb",
                    "sense_definition": "In a severe, flagrant, or offensive manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital administration was accused of being <w>grossly</w> negligent in their care of patients.",
                            "target_lang_translations": {
                                "es": "La administración del hospital fue acusada de ser <w>gravemente</w> negligente en el cuidado de los pacientes."
                            }
                        },
                        {
                            "text": "The proposed compensation package is <w>grossly</w> inadequate given the severe damage caused.",
                            "target_lang_translations": {
                                "es": "El paquete de compensación propuesto es <w>totalmente</w> inadecuado dados los graves daños ocasionados."
                            }
                        }
                    ],
                    "synonyms": [
                        "gravely",
                        "flagrantly"
                    ],
                    "common_phrases": [
                        "grossly negligent",
                        "grossly offensive",
                        "grossly inadequate"
                    ],
                    "target_lang_definitions": {
                        "es": "De forma grave, flagrante o indignante."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "gravemente",
                                "target_lang_sense_clarification": "con severidad o seriedad extrema"
                            },
                            {
                                "target_lang_word": "flagrantemente",
                                "target_lang_sense_clarification": "de manera evidente e indiscutible"
                            },
                            {
                                "target_lang_word": "totalmente",
                                "target_lang_sense_clarification": "por completo o de forma absoluta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9be2dd3a-398c-3f52-9ef3-633ae116b2b8",
                    "sense_definition": "In a crude, vulgar, or disgusting manner; without refinement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They behaved <w>grossly</w> at the dinner table, making everyone feel thoroughly uncomfortable.",
                            "target_lang_translations": {
                                "es": "Se comportaron <w>groseramente</w> en la mesa, haciendo que todos se sintieran sumamente incómodos."
                            }
                        },
                        {
                            "text": "The guests were talking <w>grossly</w> about private matters during the formal reception.",
                            "target_lang_translations": {
                                "es": "Los invitados hablaban <w>vulgarmente</w> sobre asuntos privados durante la recepción formal."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgustingly"
                    ],
                    "target_lang_definitions": {
                        "es": "De manera tosca, vulgar, desagradable o sin refinamiento."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "groseramente",
                                "target_lang_sense_clarification": "con falta de educación o modales"
                            },
                            {
                                "target_lang_word": "vulgarmente",
                                "target_lang_sense_clarification": "de forma ordinaria o chabacana"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86e70f59-ccad-364f-9b55-12988dc873cd",
                    "sense_definition": "Roughly, approximately, or without precision.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The initial figures were only <w>grossly</w> calculated before the final audit was conducted.",
                            "target_lang_translations": {
                                "es": "Las cifras iniciales solo se calcularon <w>a grandes rasgos</w> antes de que se realizara la auditoría final."
                            }
                        },
                        {
                            "text": "We can <w>grossly</w> estimate the total costs before looking closely at each detail.",
                            "target_lang_translations": {
                                "es": "Podemos estimar <w>aproximadamente</w> los costos totales antes de analizar minuciosamente cada detalle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "A grandes rasgos, aproximadamente o sin precisión."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "a grandes rasgos",
                                "target_lang_sense_clarification": "de forma general y aproximada"
                            },
                            {
                                "target_lang_word": "aproximadamente",
                                "target_lang_sense_clarification": "sin exactitud"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}