                                                "example_id": "5c7de952-8ad2-4e00-972f-a18c696abd39",
                                                "sense_id": "285cc7d9-ff81-3b7d-9d5e-cdfebf9e5d5e",
                                                "text": "Les hydroxydes d’ammonium sont également formés par réaction de l’hydroxyde d’argent avec un sel d’ammonium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6451289-780a-38d4-81ec-3c2a83817873",
                                        "entry_id": "60b60c82-8a3c-3e90-a7ca-789663f2c082",
                                        "glosses": [
                                            "L’ion OH⁻ lui-même."
