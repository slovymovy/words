    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bca4da3-878c-32dc-a1a8-9ef7147fb1b7",
                    "sense_definition": "Present participle and gerund of <w>bend</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>bending</w> down to pick up the heavy box.",
                            "target_lang_translations": {
                                "ru": "Он <w>наклоняется</w>, чтобы поднять тяжелую коробку.",
                                "nl": "Hij <w>buigt</w> voorover om de zware doos op te pakken."
                            }
                        },
                        {
                            "text": "She was <w>bending</w> the wire to form a perfect circle.",
                            "target_lang_translations": {
                                "ru": "Она <w>сгибала</w> проволоку, чтобы сделать идеальный круг.",
                                "nl": "Ze was de draad aan het <w>buigen</w> om een perfecte cirkel te vormen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bending over",
                        "bending down",
                        "bending forward"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>bend</w>.",
                        "nl": "Tegenwoordig deelwoord en gerundium van het werkwoord 'to bend'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгибание",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "движение тела"
                            },
                            {
                                "target_lang_word": "сгибающий",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "buigen",
                                "target_lang_sense_clarification": "het proces van buigen"
                            },
                            {
                                "target_lang_word": "buigend",
                                "target_lang_sense_clarification": "als deelwoord"
                            }
                        ]
                    }
                }
