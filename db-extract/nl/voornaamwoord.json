                ],
                "translations": [
                    {
                        "translation_id": "b5c5b2e1-b3d8-4e14-9ca1-61162a42a8dd",
                        "source_entry_id": "a2b418ac-a19f-384d-90f0-ca6dccfcfb65",
                        "source_sense_id": "afc5a695-bbdc-3a3f-8160-7112ba881759",
                        "source_sense_description": "een woord dat verwijst naar iets anders zonder ze te noemen",
                        "target_lang_word": "Fürwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fürwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9272ce53-5f1f-3d3d-bb03-656ff7e10f80",
                                        "entry_id": "228e217f-987d-3c25-b1a4-0e4f1f905aa5",
                                        "glosses": [
                                            "Fürsprache; Zuspruch; verbale Unterstützung"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b24be8c0-9149-4eeb-acb7-60ff41f8145f",
                                                "sense_id": "9272ce53-5f1f-3d3d-bb03-656ff7e10f80",
                                                "text": "Sie erhielten deutliche Fürworte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "207df7fc-e180-3f38-a06c-2d1de06c8ea8",
                                        "entry_id": "228e217f-987d-3c25-b1a4-0e4f1f905aa5",
                                        "glosses": [
                                            "deutsche Bezeichnung für Pronomen; es handelt sich bei Fürwörtern um eine Wortart, deren Wörter ein anderes Wort (meist ein Nomen) oder ein Satzglied im Satz in gleicher Funktion ersetzen kann."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f421d8-4a5f-494e-8c9f-1f4e6141403d",
                                                "sense_id": "207df7fc-e180-3f38-a06c-2d1de06c8ea8",
                                                "text": "„Er“ in „Er ist groß“ ist ein Fürwort."
                                            },
                                            {
                                                "example_id": "e2de7c20-a3bf-4033-885f-2d3976cb9e58",
                                                "sense_id": "207df7fc-e180-3f38-a06c-2d1de06c8ea8",
                                                "text": "„Die Merkmale, nach denen Hauptwort (Substantiv), Eigenschaftswort (Adjektiv), Fürwort (Pronomen), Zahlwort (Numerale), Tätigkeits- oder Zeitwort (Verbum), Umstandswort (Adverbium), Verhältniswort (Präposition) und Bindewort (Konjunktion) unterschieden werden, sind teils solche der Form, teils solche der Leistung.“"
                                            },
                                            {
                                                "example_id": "fa61c4d1-a3da-4918-aabe-945d6beb9ea1",
                                                "sense_id": "207df7fc-e180-3f38-a06c-2d1de06c8ea8",
                                                "text": "„Allerdings ist die Form des Fürworts in den beiden Fällen verschieden.“"
                                            },
                                            {
                                                "example_id": "4d08f676-0fc4-4fab-b32c-d81b1284dc78",
                                                "sense_id": "207df7fc-e180-3f38-a06c-2d1de06c8ea8",
                                                "text": "„Diese Gruppe darf nicht mit Vornamen oder Fürwort angeredet werden, sondern nur mit der Verwandtschaftsbezeichnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7477c93-4eb6-4817-8213-7b33959ece43",
                        "source_entry_id": "a2b418ac-a19f-384d-90f0-ca6dccfcfb65",
                        "source_sense_id": "afc5a695-bbdc-3a3f-8160-7112ba881759",
                        "source_sense_description": "een woord dat verwijst naar iets anders zonder ze te noemen",
                        "target_lang_word": "Pronomen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pronomen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "800b8ca6-6b1f-39dc-8b9c-006a51bdc518",
                                        "entry_id": "63006fb0-3671-36ab-8d8c-dbe85a6970f4",
                                        "glosses": [
                                            "eine Wortart; ein Wort, welches ein anderes Wort (meist ein Substantiv) oder ein Satzglied ersetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2f841c-1bf8-4e9b-b69e-b48d9c7130bb",
                                                "sense_id": "800b8ca6-6b1f-39dc-8b9c-006a51bdc518",
                                                "text": "„Er“ in „Er ist groß“ ist ein Pronomen."
                                            },
                                            {
                                                "example_id": "12400442-3cd5-4fa1-aa6d-71481dc2cad1",
                                                "sense_id": "800b8ca6-6b1f-39dc-8b9c-006a51bdc518",
                                                "text": "„Wer die Aussprachehürde genommen hat, wird als Nächstes von der Nachricht schockiert, dass es im Polnischen für Substantive, Adjektive, Pronomina und Zahlwörter ganze sieben Fälle gibt.“"
                                            },
                                            {
                                                "example_id": "0039fb8a-2dfb-4b10-96a9-c33819327b4e",
                                                "sense_id": "800b8ca6-6b1f-39dc-8b9c-006a51bdc518",
                                                "text": "„In der darauf folgenden Verbalisierung ihrer Erinnerung greift Angela dann allerdings nicht zum zunächst erwartbaren Pronomen der ersten Person Singular, sondern sie wählt die entsprechende Pluralform mir (wir), womit sie sich als Mitglied einer Gruppe - hier ihrer Familie - identifiziert und als Vertreterin dieser erzählt.“"
                                            },
                                            {
                                                "example_id": "aa8877b1-0fbd-4938-8992-6c645cdc5455",
                                                "sense_id": "800b8ca6-6b1f-39dc-8b9c-006a51bdc518",
                                                "text": "„Aus der speziellen Funktion der Pronomen ergibt sich, daß es – im Gegensatz zu Substantiven, Adjektiven und Verben – keine unbegrenzte Anzahl gibt.“"
                                            },
                                            {
                                                "example_id": "715b14d9-39ae-491d-84bb-444116e2b7ad",
                                                "sense_id": "800b8ca6-6b1f-39dc-8b9c-006a51bdc518",
                                                "text": "„In Texten verknüpfen Pronomen Wörter und Sätze.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pronomen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5be56787-c51d-331f-a133-8d4e0a0c706c",
                                        "entry_id": "a41d8188-4839-377c-a700-1df2542bc857",
