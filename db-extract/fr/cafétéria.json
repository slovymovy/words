                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "буфет",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "22f1eabd-ea13-3da9-a0c0-33a2d579d2bd",
                                        "entry_id": "33933268-213b-38ca-b2ff-5427d61ef65f",
                                        "glosses": [
                                            "шкаф для хранения посуды, столового белья, закусок, напитков и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b37074e-abb8-49f5-ad98-21075c051832",
                                                "sense_id": "22f1eabd-ea13-3da9-a0c0-33a2d579d2bd",
                                                "text": "Буфет состоит из тёмнокрасного двухэтажного шкафа с тусклыми стёклами, дающими, впрочем, возможность видеть, что в шкафу находится салфетка, вилка, пробка и синяя с рисунками тарелка."
                                            },
                                            {
                                                "example_id": "7933e0d8-85c8-4b84-978a-2108bba7fc7c",
                                                "sense_id": "22f1eabd-ea13-3da9-a0c0-33a2d579d2bd",
                                                "text": "Олимпиада Васильевна достала из буфета графинчик, бросив меланхолический взгляд на Володю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8041393-6cd7-35ae-abe8-17a4c1db02ed",
                                        "entry_id": "33933268-213b-38ca-b2ff-5427d61ef65f",
                                        "glosses": [
                                            "истор. комната в доме помещика, где хранились посуда и продукты, приготовлялись закуски, чай и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2aae5f-ed64-4c2a-bcc0-f5b6a0abd3ca",
                                                "sense_id": "e8041393-6cd7-35ae-abe8-17a4c1db02ed",
                                                "text": "Живёт Мардарий Аполлоныч совершенно на старый лад. И дом у него старинной постройки: в передней, как следует, пахнет квасом, сальными свечами и кожей; тут же направо буфет с трубками и утиральниками."
                                            },
                                            {
                                                "example_id": "edb7678b-8326-4a78-90a6-68b3881ca3a5",
                                                "sense_id": "e8041393-6cd7-35ae-abe8-17a4c1db02ed",
                                                "text": "Дутя, напиши: … 3) согласна ли буфет отдать под комнату для гостей и прирезать ещё вторую комнату от запасной, а остаток запасной отдать под буфет?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17246fba-4784-3e09-937f-65ddce70798a",
                                        "entry_id": "33933268-213b-38ca-b2ff-5427d61ef65f",
                                        "glosses": [
                                            "небольшая закусочная при общественных учреждениях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8881941-f35e-47c5-a0e9-950e1e2eaea2",
                                                "sense_id": "17246fba-4784-3e09-937f-65ddce70798a",
                                                "text": "В пассажирском зале буфет — водочка разная, закусочка, икорка, рыбка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d473bb2-f5e6-337b-b3af-cf1f8035b6c7",
                                        "entry_id": "33933268-213b-38ca-b2ff-5427d61ef65f",
                                        "glosses": [
                                            "специально оборудованный стол или стойка для продажи закусок и напитков в столовых, ресторанах и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bba237e-fa61-4a08-925e-647a1b115917",
                                                "sense_id": "6d473bb2-f5e6-337b-b3af-cf1f8035b6c7",
                                                "text": "В «Собаке» садились где кто хочет, в буфет за едой и вином ходили сами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
