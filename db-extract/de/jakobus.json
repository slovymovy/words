                                                "example_id": "81446259-9f52-4827-a9a2-0f1f06d186ac",
                                                "sense_id": "aebd1b32-3dbb-3606-bdc6-1ed8f3c57608",
                                                "text": "Poszedłem z Jakubem do wesołego miasteczka."
                                            }
