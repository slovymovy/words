                                        "glosses": [
                                            "An empress of several Eastern European countries, especially Russia, or the wife of a tsar."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff00a22-64eb-4237-8074-167b53607176",
                                                "sense_id": "f4315650-37af-303f-8805-b04ed6d48d62",
                                                "text": "The biggest Russian czarina was Catherine the Great, a German, who incidentally made Crimea part of Russia."
                                            }
