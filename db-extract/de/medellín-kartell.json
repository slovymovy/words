                "senses": [
                    {
                        "sense_id": "2929b8e5-e4dc-38b0-af68-ba6f360a0364",
                        "entry_id": "c61900a4-54f7-3253-a79a-d108f3594c18",
                        "glosses": [
                            "während den 1980er und 90er Jahren aktives Kokainkartell aus Medellín"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdcd591e-cc32-425d-8108-4fdfb402f849",
                                "sense_id": "2929b8e5-e4dc-38b0-af68-ba6f360a0364",
                                "text": "„Statt dem Medellín-Kartell Steuern aufzuerlegen, hatten die Aufständischen in manchen Gebieten begonnen, sich mit ihm über den Schutz von Kokafeldern und Verarbeitungslabors zu einigen.“"
                            },
                            {
                                "example_id": "260feb40-514d-4758-9ff5-c02a3b4c8877",
                                "sense_id": "2929b8e5-e4dc-38b0-af68-ba6f360a0364",
                                "text": "„Die Drogenmacht, das Geld, aber auch die Kontrollen wanderten nach Zentral-Kolumbien. Zu Leuten wie Pablo Escobar und dem Medellín-Kartell.“"
                            },
                            {
                                "example_id": "ac599f61-08d5-4da2-8b50-849cd066f9e7",
                                "sense_id": "2929b8e5-e4dc-38b0-af68-ba6f360a0364",
                                "text": "„Das Medellín-Kartell gibt monatlich 2500 Dollar für Gummibänder aus, zum Bündeln der Geldscheine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
