                                        "entry_id": "4704eaab-d679-3cc1-ae2a-951c34357d12",
                                        "glosses": [
                                            "insieme delle manifestazioni materiali, sociali e spirituali di un popolo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feac6cd8-4593-46e1-b408-0e4ce3755207",
                                                "sense_id": "a6d6e83e-0328-33c9-b55e-7577f8a8f24e",
                                                "text": "La civiltà greca fiorì tra il decimo e il secondo secolo a.C."
                                            },
                                            {
                                                "example_id": "d0c5bbf5-14d9-4344-bb2b-fee7323407a8",
                                                "sense_id": "a6d6e83e-0328-33c9-b55e-7577f8a8f24e",
                                                "text": "La civiltà tecnologica ha reso molto meno faticoso il lavoro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bd0bc24-d566-3bd6-b441-1262d89d29d8",
                                        "entry_id": "4704eaab-d679-3cc1-ae2a-951c34357d12",
                                        "glosses": [
                                            "usato in modo assoluto, l'insieme delle conquiste dell'umanità"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2482db3e-b82f-43fb-bd88-2cef67f62c9d",
                                                "sense_id": "4bd0bc24-d566-3bd6-b441-1262d89d29d8",
                                                "text": "In quel paese dimenticato da Dio e dagli uomini non era ancora arrivata la civiltà."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6081308b-5d10-31f9-9b01-1f709aec9a10",
                                        "entry_id": "4704eaab-d679-3cc1-ae2a-951c34357d12",
                                        "glosses": [
                                            "cortesia, buona educazione"
                                        ],
                                        "tags": [
                                            "estensione"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf376e3-9ec3-4748-bdec-dfb4071fac24",
                                                "sense_id": "6081308b-5d10-31f9-9b01-1f709aec9a10",
                                                "text": "Un po' di civiltà, suvvia!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
