                ],
                "senses": [
                    {
                        "sense_id": "fd256caf-f829-32b6-953a-652e94a6c4d6",
                        "entry_id": "eeab8489-eaa1-3c9d-8e5a-99a86cfb9410",
                        "glosses": [
                            "zusammenhängende Datenmenge, die zweckspezifisch in Spalten und Zeilen aggregierte Informationen aus ggf. mehreren Datenbanktabellen beinhaltet"
                        ],
                        "tags": [
                            ".NET"
                        ],
                        "examples": [
                            {
                                "example_id": "e9a11055-7db9-4741-861e-2ce449dc32e3",
                                "sense_id": "fd256caf-f829-32b6-953a-652e94a6c4d6",
                                "text": "„Ein Dataset enthält also in der Regel zunächst eine Kopie der Daten aus einer bestimmten 'Sicht' auf die Datenbank, dient aber auch der Zwischenspeicherung neuer oder geänderter Daten. Er ist der zentrale Datenpuffer in ASPX- oder Smart-Client-Anwendungen.“"
                            },
                            {
                                "example_id": "17087225-d589-40c9-b684-9aec33a33c18",
                                "sense_id": "fd256caf-f829-32b6-953a-652e94a6c4d6",
                                "text": "„Ein Dataset ist nur eine logische Gruppierung von Daten in der Datenbank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d7b2f1e0-393e-3224-91e3-db525c971797",
                        "entry_id": "eeab8489-eaa1-3c9d-8e5a-99a86cfb9410",
                        "glosses": [
                            "zusammengehörige Datenmenge in tabellarischer Struktur, die im Hauptspeicher verwaltet wird"
                        ],
                        "tags": [
                            "IBM"
                        ],
                        "examples": [
                            {
                                "example_id": "c707aac0-1626-4c15-b48e-c7004525c5d0",
                                "sense_id": "d7b2f1e0-393e-3224-91e3-db525c971797",
                                "text": "„In Anwendungsprogrammen wird in der Regel nicht direkt über den Dataset-Namen auf ein Dataset zugegriffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
