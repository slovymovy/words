                                "target_word": "Anästhetikum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "187d05c9-7531-39de-bb12-e08d73601d38",
                                        "entry_id": "371e2446-7206-3b52-b54c-a65a0cbde646",
                                        "glosses": [
                                            "Arzneimittel zur reversiblen Verminderung oder Ausschaltung der Schmerzempfindung, das auch zusammen mit weiteren Medikamenten zur Narkose verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f284e1c1-9acc-4cb2-a655-e34bb97f8e85",
                                                "sense_id": "187d05c9-7531-39de-bb12-e08d73601d38",
                                                "text": "Propofol ist das am häufigsten eingesetzte intravenöse Anästhetikum für Erwachsene und Kinder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbe29c94-a5be-424e-bdde-9f3553cd009a",
                        "source_entry_id": "47293bfb-3225-3156-903a-aa865fa27d91",
                        "source_sense_id": "4bfdfd4d-36d6-38db-a3d0-ca8750445544",
                        "target_lang_word": "Betäubungsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betäubungsmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0806b481-ec76-3cc4-99c6-67562e659fff",
                                        "entry_id": "75bd2984-0b7f-3e1c-bebe-0385814f1d4e",
                                        "glosses": [
                                            "Substanz, mit der man Menschen oder Tiere betäuben kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd66c9f2-e955-451f-a3c7-c1fa68be4b9d",
                                                "sense_id": "0806b481-ec76-3cc4-99c6-67562e659fff",
                                                "text": "Früher wurde in der Medizin Lachgas als Betäubungsmittel verwendet."
                                            },
                                            {
                                                "example_id": "4a4594ae-f71b-4ef4-b823-6acb209cad14",
                                                "sense_id": "0806b481-ec76-3cc4-99c6-67562e659fff",
                                                "text": "„Mr. Mullins und Josey und Doktor Smoaks mußten sich alle drei auf sie setzen und sie festhalten, während er mit der Nadel zustach und ihr das Betäubungsmittel einspritzte.“"
                                            },
                                            {
                                                "example_id": "99342017-2def-4f14-96ee-b7b39d2ce51c",
                                                "sense_id": "0806b481-ec76-3cc4-99c6-67562e659fff",
                                                "text": "„Sie saß, eingehüllt in Schmerz, der kein Schmerz zu sein schien, sondern eine dumpfe Qual, die durch Betäubungsmittel abgeschwächt worden war.“"
                                            },
                                            {
                                                "example_id": "93993c56-1ff5-45b7-b7bf-a4ad3543fd98",
                                                "sense_id": "0806b481-ec76-3cc4-99c6-67562e659fff",
                                                "text": "„Juliette flüchtet aber bald, nachdem sie Minski ein kräftiges Betäubungsmittel in die Schokolade geschüttet hat.“"
                                            },
                                            {
                                                "example_id": "ca7c6b66-77fb-4c16-bd2f-cf1c6019dc7e",
                                                "sense_id": "0806b481-ec76-3cc4-99c6-67562e659fff",
                                                "text": "„Nach dem Zweiten Weltkrieg entfernten sich in Deutschland und der Schweiz durch die Betäubungsmittel-Gleichstellungsverordnungen die juristische und medizinische Bedeutung des Begriffes Betäubungsmittel voneinander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "66c159cb-d870-39c6-9e5a-dbdb7fbac3e0",
                                        "entry_id": "75bd2984-0b7f-3e1c-bebe-0385814f1d4e",
                                        "glosses": [
                                            "Substanz mit Missbrauchspotential, die beim Menschen einen angeregten oder beruhigten Zustand hervorruft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4d006de-768f-41a9-b297-6161f29fcacc",
                                                "sense_id": "66c159cb-d870-39c6-9e5a-dbdb7fbac3e0",
                                                "text": "„Nach dem Zweiten Weltkrieg entfernten sich in Deutschland und der Schweiz durch die Betäubungsmittel-Gleichstellungsverordnungen die juristische und medizinische Bedeutung des Begriffes Betäubungsmittel voneinander.“"
                                            },
                                            {
                                                "example_id": "f7311c0b-3e5c-4a98-b9d4-1021e1d3c51e",
                                                "sense_id": "66c159cb-d870-39c6-9e5a-dbdb7fbac3e0",
                                                "text": "„Eine Erlaubnis zum Umgang mit Betäubungsmitteln der Anlage I, worunter auch weit verbreitete Betäubungsmittel wie Cannabisprodukte, LSD, Heroin (Diamorphin) fallen, ist praktisch nicht möglich.“"
                                            },
                                            {
                                                "example_id": "037e7784-a7db-4ca0-b7b8-9607c171a50d",
                                                "sense_id": "66c159cb-d870-39c6-9e5a-dbdb7fbac3e0",
                                                "text": "„Zu den Rauschgiften oder Betäubungsmitteln zählt man eine Reihe von Drogen pflanzlicher Herkunft. Die bekanntesten Rauschgifte sind Opium, gewonnen aus der Mohnpflanze, und seine Inhaltsstoffe (wie Morphium) und Abkömmlinge (wie Heroin, Kodein), Kokain […], Haschisch […] und Meskalin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c833ea5d-2de7-4be0-b280-d9b716ff6ad4",
                        "source_entry_id": "47293bfb-3225-3156-903a-aa865fa27d91",
                        "source_sense_id": "4bfdfd4d-36d6-38db-a3d0-ca8750445544",
                        "target_lang_word": "анестетик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анестетик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8aae82ab-865a-32ce-a396-9d7b8d4b3421",
                                        "entry_id": "6c51e650-9113-389f-8f8d-b1a0600ba6df",
                                        "glosses": [
                                            "мед. анестетическое лекарственное средство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d968c97c-e46f-43cf-b071-fa377002f95a",
                                                "sense_id": "8aae82ab-865a-32ce-a396-9d7b8d4b3421",
                                                "text": "Анестезиологи считают, что идеальный анестетик ещё не создан."
                                            },
                                            {
                                                "example_id": "b2ecef22-69be-41cf-acbb-68dd4464af41",
                                                "sense_id": "8aae82ab-865a-32ce-a396-9d7b8d4b3421",
                                                "text": "История местных анестетиков, начавшаяся с кокаина, очевидно, не остановится и на тримекаине."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
