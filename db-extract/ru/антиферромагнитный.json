                        "glosses": [
                            "обладающий антиферромагнетизмом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f57bbabf-a504-403b-9456-7a3e30dc960d",
                                "sense_id": "ad87f1cd-5c77-3db5-833f-ec1430741082",
                                "text": "Кроме названных существуют материалы с так называемыми антиферромагнитными и ферримагнитными свойствами."
                            }
                        ]
                    }
                ],
