                    },
                    {
                        "translation_id": "a5a3ae4d-7d6e-4b75-9d7f-d52418c1a79d",
                        "source_entry_id": "2189a532-9426-3796-a0ba-b00256bf8ee4",
                        "source_sense_id": "9d864d2c-1abd-381a-b866-255ace42f264",
                        "source_sense_description": "een pop die gemaakt is van sneeuw",
                        "target_lang_word": "Schneemann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneemann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                        "entry_id": "2dc23114-f576-3c1c-87e2-3cb50abe09a8",
                                        "glosses": [
                                            "aus Schnee (oft aus größeren Schneebällen) geformte, menschenähnliche Figur, traditionellerweise mit einer Mohrrübe oder einem gebrochenen Zweig als Nase sowie Kohlestücke, Kieselsteine, gebrochene Zweige als Augen und Mund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf7d86a-9739-4724-8c80-e1d5a814d491",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "Die Kinder bauten gestern den Schneemann an der Straße."
                                            },
                                            {
                                                "example_id": "0b8c7e72-604a-468a-9746-d07951962155",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Seht, da steht er, unser Schneemann!",
                                                "translation": "Wir dich schlittenfahren.“"
                                            },
                                            {
                                                "example_id": "64bed64f-1bcd-497b-af1e-ab121db4a8a7",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Sie traf den Künstler eben damit beschäftigt, einem Schneemann, den seine vier pausbäckigen Buben vor der Haustür gebaut hatten, die väterliche bildnerische Nachhilfe zu geben.“"
                                            },
                                            {
                                                "example_id": "e275ca91-a599-42a7-beb8-7bdec6eb1bd0",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Seht den Mann, o große Not!",
                                                "translation": "haſt den Stock und wehrſt dich nicht.“"
                                            },
                                            {
                                                "example_id": "0466c798-5656-4480-a53f-0dc898f1ea92",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Die wenigen Zentimeter Schnee, die in der Arlberggemeinde für eine vorweihnachtliche Kulisse sorgen, reichen kaum zum Bau eines Schneemanns.“"
                                            },
                                            {
                                                "example_id": "bd1d5347-07d8-48be-b0b6-c87c595cb8f5",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Während die vierjährige Nestle noch etwas ungläubig blickt, formt Rabiye (7) bereits den Kopf des Schneemannes.“"
                                            },
                                            {
                                                "example_id": "b93a053f-0791-4a0c-9bef-065629f6960a",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Da wurde dann so manche Schneeballschlacht geschlagen und einige kleine Schneemänner fabriziert.“"
                                            },
                                            {
                                                "example_id": "f1cbc38b-c6d6-4159-a201-c01328bceddd",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Danach zogen sie in die Parks und bauten Schneemänner mit ihren Kindern.“"
                                            },
                                            {
                                                "example_id": "1680b7b4-9a5c-4fca-8a5b-d0e02f395179",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Die Advents- und Weihnachtsstimmung muss mit Sternen, Kerzen, Ästchen, Engeln, Glöckchen, Schneemännern, Weihnachtsbäumchen usw. heraufbeschworen werden.“"
                                            },
                                            {
                                                "example_id": "23492fca-f2df-42f6-a5c2-7f78e9978380",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Nur einen Kuß könnteſt Du mir geben. Aber daran denkſt Du nicht. Auf dem ganzen weiten Wege nicht gerührt, froſtig wie ein Schneemann.“"
                                            },
                                            {
                                                "example_id": "745edd1e-22e9-48b5-9480-7ce183788019",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„‚Liebe Frau Holm, rechnen Sie es uns gar nicht als Verdienſt an; wir flüchten uns an Ihren warmen Ofen; man wird ja zum Schneemann draußen,‘ rief die Juſtizrätin, eine wohlbeleibte Dame mit rotem Geſicht, das von der Kälte förmlich mit Zinnober bemalt war.“"
                                            },
                                            {
                                                "example_id": "d84ff0de-b89a-4b99-a23f-6c1c022b9b04",
                                                "sense_id": "4e65cfde-ebfa-3eb2-b27f-ea0ea9423d4d",
                                                "text": "„Da stehst du unter ihnen wie ein schmelzender Schneemann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7351802-770d-3fb4-b5b9-18eb3317ec36",
                                        "entry_id": "2dc23114-f576-3c1c-87e2-3cb50abe09a8",
                                        "glosses": [
                                            "kraft- und schwunglose männliche Person, die vom Leid anderer Personen schnell berührt ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec4b2da-a778-47da-8549-3aa4454a75d1",
                                                "sense_id": "e7351802-770d-3fb4-b5b9-18eb3317ec36",
                                                "text": "„Die Freunde des Chevalier waren über diese Asthenie verwundert, welche für sie etwas Uebermenschliches, Monströses war. Besonders war Grécourt, der Wüstling, ganz erstaunt. »Du bist ein Schneemann!« sagte er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ea5d5255-b98d-3579-bd38-c42b26d20d52",
                                        "entry_id": "2dc23114-f576-3c1c-87e2-3cb50abe09a8",
                                        "glosses": [
                                            "Wintersport treibende Person"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0633169b-0269-4e64-8795-520f14db6a85",
                                                "sense_id": "ea5d5255-b98d-3579-bd38-c42b26d20d52",
                                                "text": "„Heute sind Sie der erfolgreichste Schneemann der Welt: 93 Weltcup-Siege – kein Wintersportler hat mehr, sechs Gold-Medaillen bei Olympia – nur ihr Landsmann Björn Daehlie hat zwei mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81e12395-a46c-41eb-b818-35edb5b5dc94",
                        "source_entry_id": "2189a532-9426-3796-a0ba-b00256bf8ee4",
