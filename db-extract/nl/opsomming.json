                                "sense_id": "a1bcbfe0-364a-3e65-a402-5b8d74b229e2",
                                "text": "Kan je een opsomming geven van alles wat er gedaan moet worden?",
                                "translation": "Can you make a list of everything that needs to be done?",
                                "english": "Can you make a list of everything that needs to be done?"
                            }
                        ]
