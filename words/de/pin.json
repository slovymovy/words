    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85b13c70-30b2-340c-883a-725098840187",
                    "sense_definition": "Persönliche Identifikationsnummer (Geheimzahl) zur Autorisierung, beispielsweise bei Bankkarten oder Mobiltelefonen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "identifikation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte geben Sie Ihre vierstellige <w>PIN</w> am Geldautomaten ein."
                        },
                        {
                            "text": "Ich habe die <w>PIN</w> meiner neuen Bankkarte leider vergessen."
                        }
                    ],
                    "common_phrases": [
                        "die PIN eingeben"
                    ]
                },
                {
                    "sense_id": "820cf7f8-551f-3491-9842-7739df19ddf1",
                    "sense_definition": "Kleine Nadel oder Reißzwecke zum Befestigen von Notizzetteln an einer Wand oder Pinnwand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "befestigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er befestigte das Werbeplakat mit vier bunten <w>Pins</w> am Schwarzen Brett."
                        },
                        {
                            "text": "Nimm einen <w>Pin</w>, um die Notiz an der Pinnwand festzumachen."
                        }
                    ],
                    "common_phrases": [
                        "mit einem Pin befestigen"
                    ]
                },
                {
                    "sense_id": "e597c5bf-d7c2-334c-9eee-56698574f022",
                    "sense_definition": "Kleines Abzeichen mit Befestigungsnadel auf der Rückseite, das an der Kleidung getragen wird",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abzeichen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie trägt einen kleinen <w>Pin</w> mit der Flagge ihres Landes an der Jacke."
                        },
                        {
                            "text": "Auf der Konferenz verteilte der Veranstalter bunte <w>Pins</w> an alle Teilnehmer."
