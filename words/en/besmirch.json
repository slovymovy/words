{
    "word_family": [
        "smirch"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2af4a3f-aff8-31c0-ae00-d525dc219a12",
                    "sense_definition": "To damage or ruin someone's reputation, honor, or good name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rival newspaper was on a relentless campaign to <w>besmirch</w> the actor's reputation.",
                            "target_lang_translations": {
                                "ru": "Газета-конкурент вела беспощадную кампанию с целью <w>очернить</w> репутацию актёра."
                            }
                        },
                        {
                            "text": "He refused to lie because he would never do anything to <w>besmirch</w> his family's name.",
                            "target_lang_translations": {
                                "ru": "Он отказался лгать, потому что никогда бы не сделал ничего, что могло бы <w>запятнать</w> имя его семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "slander",
                        "libel",
                        "blacken",
                        "debase"
                    ],
                    "common_phrases": [
                        "besmirch a reputation",
                        "besmirch someone's name",
                        "besmirch his honor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить ущерб чести, доброму имени или репутации; порочить, очернять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "наносить ущерб репутации или чести"
                            },
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "ложиться позорным пятном на репутацию, имя"
                            },
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "обесчестить, скомпрометировать"
                            },
                            {
                                "target_lang_word": "чернить",
                                "target_lang_sense_clarification": "оклеветывать, представлять в дурном свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10454bf3-9c76-3854-8a38-13e23672039b",
                    "sense_definition": "To make physically dirty, stained, or soiled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soot and coal dust from the old train engine began to <w>besmirch</w> her white coat.",
                            "target_lang_translations": {
                                "ru": "Сажа и угольная пыль из топки старого паровоза принялись <w>пачкать</w> её белое пальто."
                            }
                        },
                        {
                            "text": "The soldier's uniform was completely <w>besmirched</w> with mud after days of marching through the rain.",
                            "target_lang_translations": {
                                "ru": "После многодневного марша под дождём форма солдата была вся <w>заляпана</w> грязью."
                            }
                        }
                    ],
                    "synonyms": [
                        "soil"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary or archaic when used physically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать физически грязным, оставлять пятна или пачкать (обычно в книжном стиле)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "делать грязным"
                            },
                            {
                                "target_lang_word": "испачкать",
                                "target_lang_sense_clarification": "загрязнить, покрыть грязью или сажей"
                            },
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "покрыть пятнами, загрязнить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}