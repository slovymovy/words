                "senses": [
                    {
                        "sense_id": "d8d246b1-577f-3048-9113-356db2327025",
                        "entry_id": "54470762-0241-3fbb-beb8-94a77fd3d9ae",
                        "glosses": [
                            "Hotel oder Beherbergungsbetrieb, in dem statt Zimmern oder Suiten vollständig eingerichtete Wohnungen mit Küche, Bad und entweder einem Wohnschlafzimmer oder getrennten Wohn- und Schlafzimmern vermietet werden"
                        ],
                        "tags": [
                            "Hotelwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "b0165a97-2957-44a0-9578-c6a703c1b3a2",
                                "sense_id": "d8d246b1-577f-3048-9113-356db2327025",
                                "text": "„Schon ist in vielen Apartmenthotels des Bayerischen Waldes gegenüber dem Vorjahr für den Sommer ein deutlicher Buchungsrückgang eingetreten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74b3820b-354e-44a4-a549-548ab61f6235",
                        "source_entry_id": "54470762-0241-3fbb-beb8-94a77fd3d9ae",
                        "source_sense_id": "d8d246b1-577f-3048-9113-356db2327025",
                        "source_sense_description": "Hotel oder Beherbergungsbetrieb, in dem Appartements vermietet werden",
                        "target_lang_word": "suite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd14a15-e0c3-3aac-b230-b8b8335388d1",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Ce ou ceux qui suivent, ce ou ceux qui vont après."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b48cecbe-74e6-4f16-beac-400c40176ed9",
                                                "sense_id": "0cd14a15-e0c3-3aac-b230-b8b8335388d1",
                                                "text": "On laissa passer les trois premiers et on ferma la porte à toute la suite. - Pour bien entendre ce passage, il faut lire la suite."
                                            },
                                            {
                                                "example_id": "b4803703-0cda-4153-a7cb-1d8172dc60b2",
                                                "sense_id": "0cd14a15-e0c3-3aac-b230-b8b8335388d1",
                                                "text": "Voyons la suite. - Attendons la suite. - Il faut voir ce qui fait suite. - Suite et fin."
                                            },
                                            {
                                                "example_id": "b739a0d5-43df-437b-8302-13b6f74c2bc5",
                                                "sense_id": "0cd14a15-e0c3-3aac-b230-b8b8335388d1",
                                                "text": "À cet instant je prononçais les mots fatidiques : « La suite au prochain numéro » – « Qu’est-ce que tu dis ? » demandait ma mère. Je répondais prudemment : « Je me laisse en suspens »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a6dfd0-1877-3202-b4c7-c8a693d18b91",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Ceux qui accompagnent quelqu’un pour lui faire honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ad64a26-f6ed-4141-91d1-ed175ec80912",
                                                "sense_id": "e9a6dfd0-1877-3202-b4c7-c8a693d18b91",
                                                "text": "[…], comme elle était de race princière, elle avait soutenu pendant son veuvage la splendeur primitive de sa maison, de sorte que sa suite continua d’être une des plus élégantes des châteaux environnants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Choses qui sont la continuation, le développement de choses du même ordre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3eb63ae-caa7-4ade-8ba4-2b772f0edc71",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Il avait formé un excellent projet, mais cela n’a point eu de suite."
                                            },
                                            {
                                                "example_id": "e608a329-bfe2-46bc-8137-6f3026f3dbe7",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Il avait eu une fort bonne idée, mais il n’y a pas donné suite."
                                            },
                                            {
                                                "example_id": "c745493d-f777-42d5-ac80-33956bba28fe",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "L’observateur rapporte qu'une paysanne ayant vendu des oignons de perce-neige en guise de ciboulette, toutes les personnes qui en mangèrent furent surprises de vomissement, qui n'eurent aucunes suites fâcheuses."
                                            },
                                            {
                                                "example_id": "2a2e2de1-3bff-4f1e-b778-f7976013a2bc",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Il en arrivait à négliger Geneviève qui se rétablissait lentement des suites de son opération […]."
                                            },
                                            {
                                                "example_id": "b1f73eca-8f9a-48e7-ad19-3e798f4e9d02",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Décédé à Paris le 11 novembre 1872, des suites d’une albuminurie, son corps a été transporté le soir même pour être inhumé dans un caveau de famille, à Sedan."
                                            },
                                            {
                                                "example_id": "04cb2296-04a5-4dfb-b9f4-a63eba1ba2a3",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "De même que toutes les autres parties situées au fond de la bouche, les tonsilles sont sujettes à différentes sortes d’engorgements dont la nature varie autant que les suites."
                                            },
                                            {
                                                "example_id": "13f2cf05-79ca-4995-b579-0453582993a7",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Créer une marine : œuvre de longue haleine, qui veut de la suite, de l'argent, et il a toujours été difficile d'intéresser le Français terrien aux choses de la mer."
                                            },
                                            {
                                                "example_id": "a071c0e1-17fd-4329-b256-519aa37d87e9",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Il a pris la suite des affaires de ce commerçant."
                                            },
                                            {
                                                "example_id": "248eb883-e331-40a7-95d9-e5c11d2814b3",
                                                "sense_id": "545cdd1b-4c05-35f1-b80e-262a8a1117bc",
                                                "text": "Ce qui lui arrive est une suite naturelle, nécessaire, inévitable de sa mauvaise conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1eedfcf-a386-3764-a6d9-7a96c27dc0ac",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Continuation, ce qui est ajouté à un ouvrage pour le continuer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62cfcf0e-013f-4103-9002-dcd185ed47c7",
                                                "sense_id": "e1eedfcf-a386-3764-a6d9-7a96c27dc0ac",
                                                "text": "La suite de Don Quichotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d440bf-af29-39ef-b567-343151c13e64",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Époque postérieure à celle dont on parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d4c112-244d-454b-998e-376c05fd64f7",
                                                "sense_id": "a9d440bf-af29-39ef-b567-343151c13e64",
                                                "text": "Tel est le plan qu’il avait conçu, mais il le réforma beaucoup par la suite."
                                            },
                                            {
                                                "example_id": "b9344776-c307-46d2-beef-cc46b1f46286",
                                                "sense_id": "a9d440bf-af29-39ef-b567-343151c13e64",
                                                "text": "Il devint par la suite un homme laborieux et réfléchi."
                                            },
                                            {
                                                "example_id": "cbab0d14-553e-44f5-8db1-c8c2740989fa",
                                                "sense_id": "a9d440bf-af29-39ef-b567-343151c13e64",
                                                "text": "La suite a fait voir ce qu’on pouvait attendre de leur zèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Série, enchaînement, succession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d98db23e-0b26-4a2d-a033-c5518f4e8f92",
                                                "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                                "text": "La vie de cet homme n’a été qu’une suite de fautes."
                                            },
                                            {
                                                "example_id": "26ba6a43-0a8f-45d1-8d6a-b56bcf6e4bf3",
                                                "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                                "text": "Cet ouvrage est le résultat d’une longue suite d’observations."
                                            },
                                            {
                                                "example_id": "4e07426d-7dd8-43f5-853a-838d21cd4f9b",
                                                "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                                "text": "Une suite de pensées, d’images."
                                            },
                                            {
                                                "example_id": "5acb84f7-0bbb-4bba-b1bc-f6f285f5883d",
                                                "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                                "text": "La suite des temps, la succession des siècles."
                                            },
                                            {
                                                "example_id": "215ebc84-6704-4acd-845f-e53f1f9bebe4",
                                                "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                                "text": "La suite d’une affaire, la série des événements, des incidents qui arrivent les uns après les autres dans le cours d’une affaire."
                                            },
                                            {
                                                "example_id": "946b02e7-b9f5-4432-9caf-dcc89d94a19c",
                                                "sense_id": "d0f656ed-f760-3506-b4e1-8b55b8a9991c",
                                                "text": "Je connais par moi-même toute la suite de cette affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f9e659c-3804-3f01-948b-7b523eff84f4",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Série de choses de même espèce, que l’on range selon l’ordre des temps ou des matières."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dbd16a1-0fce-415c-bd54-3405117d31a0",
                                                "sense_id": "0f9e659c-3804-3f01-948b-7b523eff84f4",
                                                "text": "Une belle suite de médailles, de monnaies, d’estampes, de portraits."
                                            },
                                            {
                                                "example_id": "01a0e56c-77e1-41be-984e-43f45d9546e6",
                                                "sense_id": "0f9e659c-3804-3f01-948b-7b523eff84f4",
                                                "text": "La suite des tapisseries des chasses de Maximilien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d128b3d-a93b-334b-bd80-faf3fe896112",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Série de gravures d’un ouvrage tirées à part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23db2ab7-434a-466f-b16d-5852ae075576",
                                                "sense_id": "4d128b3d-a93b-334b-bd80-faf3fe896112",
                                                "text": "Suite de gravures ou absolument suite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1df6550-5a40-38fd-8406-1113c6bdfabb",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Œuvre composée de plusieurs pièces successives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285b2b59-52c0-4b84-8268-7acde55c3bb9",
                                                "sense_id": "f1df6550-5a40-38fd-8406-1113c6bdfabb",
                                                "text": "Suite pour orchestre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a66c71-225f-3784-8b28-eb84e6bd9f73",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Certain nombre de personnes qui ont succédé les unes aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980e6918-bb3b-4034-9cfb-469388a85d09",
                                                "sense_id": "d0a66c71-225f-3784-8b28-eb84e6bd9f73",
                                                "text": "Une longue suite de rois."
                                            },
                                            {
                                                "example_id": "60adb12a-dd4c-415a-9424-c5324e418a87",
                                                "sense_id": "d0a66c71-225f-3784-8b28-eb84e6bd9f73",
                                                "text": "Une longue suite de magistrats."
                                            },
                                            {
                                                "example_id": "02394a63-0757-4bb9-8d9d-deb4f5266239",
                                                "sense_id": "d0a66c71-225f-3784-8b28-eb84e6bd9f73",
                                                "text": "Une longue suite d’aïeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "224ec946-e5a4-3837-86c1-c91a48bb06e8",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Succession d’éléments, appelés termes, indexés par des entiers qui se suivent, pouvant être notés uₙ où n est l'entier mis en indice. Formellement, famille indexée par un intervalle d'entiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06036f37-6294-403b-856e-8dfae3d3905c",
                                                "sense_id": "224ec946-e5a4-3837-86c1-c91a48bb06e8",
                                                "text": "Suite réelle : suite dont les termes sont réels."
                                            },
                                            {
                                                "example_id": "288da8ee-5c13-4af9-90ec-37099b09b308",
                                                "sense_id": "224ec946-e5a4-3837-86c1-c91a48bb06e8",
                                                "text": "Suite arithmétique, suite géométrique, suite des nombres premiers."
                                            },
                                            {
                                                "example_id": "d091e1d6-a59f-4a81-914c-f2f76bcc9368",
                                                "sense_id": "224ec946-e5a4-3837-86c1-c91a48bb06e8",
                                                "text": "Note : Quand l'intervalle est fini, le mot séquence est plus souvent utilisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95ebdcb3-8a05-3c71-ad2f-0c4a234830b1",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Ordre ; liaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03597616-0050-4bd2-a7d5-8522f62aae15",
                                                "sense_id": "95ebdcb3-8a05-3c71-ad2f-0c4a234830b1",
                                                "text": "Il n’y a point de suite dans ce discours."
                                            },
                                            {
                                                "example_id": "c816b1cf-a89f-4c9c-8908-8621b0b54602",
                                                "sense_id": "95ebdcb3-8a05-3c71-ad2f-0c4a234830b1",
                                                "text": "Il m’a tenu des propos sans suite."
                                            },
                                            {
                                                "example_id": "e47a7f8c-2778-470e-b1b4-2b2f1f75da87",
                                                "sense_id": "95ebdcb3-8a05-3c71-ad2f-0c4a234830b1",
                                                "text": "Il y a beaucoup de suite dans ses idées, dans ses raisonnements, dans ses réponses."
                                            },
                                            {
                                                "example_id": "107328d3-2d72-44a3-8a77-5d98cc686a9c",
                                                "sense_id": "95ebdcb3-8a05-3c71-ad2f-0c4a234830b1",
                                                "text": "Cet homme n’a pas de suite dans les idées, n’a pas l’esprit de suite, il n’est pas capable d’une attention continue, de persévérance."
                                            },
                                            {
                                                "example_id": "59ccf029-9de5-421e-a27e-ffe02336e845",
                                                "sense_id": "95ebdcb3-8a05-3c71-ad2f-0c4a234830b1",
                                                "text": "Il n’y a pas de suite dans sa conduite, Il y a beaucoup d’inégalité dans sa conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b22a879-7a90-3a42-8a40-1527e87ea623",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Action de suivre le gibier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df3432e-1425-4fd7-9497-459ed210141c",
                                                "sense_id": "7b22a879-7a90-3a42-8a40-1527e87ea623",
                                                "text": "Faire une suite ou faire suite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8050b13-c382-3d70-a0fd-5b79c6ba88a6",
                                        "entry_id": "63b37ccb-19e1-3ce0-b453-c6909178b94c",
                                        "glosses": [
                                            "Possibilité de poursuite, de saisie."
                                        ],
                                        "tags": [],
                                        "examples": [
