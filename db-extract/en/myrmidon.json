            {
                "entry_id": "b995bb57-c784-337b-ab69-39890487106a",
                "word": "Myrmidon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "25239b5d-6eac-4229-b286-d4cce0ab0cc1",
                        "entry_id": "b995bb57-c784-337b-ab69-39890487106a",
                        "tags": [
                            "plural"
                        ],
                        "form": "Myrmidons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37d99f6b-cc1b-3f03-a3f3-eba7e0200718",
                        "entry_id": "b995bb57-c784-337b-ab69-39890487106a",
                        "glosses": [
                            "One of a fierce tribe or troop who accompanied Achilles, their king, in the Trojan War."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "69e8f6de-84ba-42c3-8dfd-c66879bace2a",
                                "sense_id": "37d99f6b-cc1b-3f03-a3f3-eba7e0200718",
                                "text": "The Myrmidons were the soldiers of Achilles, in the Trojan war. From them all zealous and unscrupulous followers of a political chief are called by that name, down to this day. But the origin of the Myrmidons would not give one the idea of a fierce and bloody race, but rather of a laborious and peaceful one."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "821ea7ce-5a0f-4542-9bf1-6af26916a544",
                        "source_entry_id": "b995bb57-c784-337b-ab69-39890487106a",
                        "source_sense_id": "37d99f6b-cc1b-3f03-a3f3-eba7e0200718",
                        "source_sense_description": "member of a tribe who accompanied Achilles",
                        "target_lang_word": "Myrmidone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
