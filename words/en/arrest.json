{
    "word_family": [
        "arrestable",
        "arrester",
        "arrestment",
        "rearrest"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc1015ba-613e-3ecf-8028-b60748cfc177",
                    "sense_definition": "To seize someone with the authority of the law and take them into legal custody.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had to <w>arrest</w> the suspect after finding the stolen goods in his car.",
                            "target_lang_translations": {
                                "ru": "Полиции пришлось <w>арестовать</w> подозреваемого после того, как в его машине были найдены краденые вещи.",
                                "zh": "警方在车里发现赃物后，不得不<w>逮捕</w>了嫌疑人。"
                            }
                        },
                        {
                            "text": "Officers will <w>arrest</w> anyone who tries to break into the building during the protest.",
                            "target_lang_translations": {
                                "ru": "Офицеры будут <w>задерживать</w> любого, кто попытается ворваться в здание во время протеста.",
                                "zh": "抗议期间，警官将<w>拘留</w>任何试图闯入大楼的人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apprehend",
                        "seize"
                    ],
                    "antonyms": [
                        "release",
                        "free"
                    ],
                    "common_phrases": [
                        "arrest a suspect",
                        "under arrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задержать кого-либо на законных основаниях и взять под стражу.",
                        "zh": "依法将某人拘留并带入法律监管之下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арестовать",
                                "target_lang_sense_clarification": "совершить арест"
                            },
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "взять под стражу до выяснения обстоятельств"
                            },
                            {
                                "target_lang_word": "арестовывать",
                                "target_lang_sense_clarification": "процесс совершения ареста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逮捕",
                                "target_lang_sense_clarification": "依法拘捕"
                            },
                            {
                                "target_lang_word": "拘留",
                                "target_lang_sense_clarification": "扣留、关押"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a091504-a744-3cc3-ae57-bf5a103365e9",
                    "sense_definition": "To stop or slow down a process, course, or development.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stopping_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government policy aims to <w>arrest</w> the decline of the local economy.",
                            "target_lang_translations": {
                                "ru": "Новая государственная политика направлена на то, чтобы <w>остановить</w> упадок местной экономики.",
                                "zh": "新政府政策旨在<w>阻止</w>当地经济的下滑。"
                            }
                        },
                        {
                            "text": "Doctors are working hard to <w>arrest</w> the spread of the virus within the community.",
                            "target_lang_translations": {
                                "ru": "Врачи усердно работают над тем, чтобы <w>приостановить</w> распространение вируса среди населения.",
                                "zh": "医生们正在努力<w>遏制</w>病毒在社区内的传播。"
                            }
                        }
                    ],
                    "synonyms": [
                        "halt",
                        "cease",
                        "discontinue"
                    ],
                    "antonyms": [
                        "advance",
                        "promote",
                        "accelerate"
                    ],
                    "common_phrases": [
                        "arrest the spread",
                        "arrest the decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить или замедлить процесс, ход или развитие чего-либо.",
                        "zh": "停止或减缓某事物的进程、过程或发展。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "добиться прекращения процесса"
                            },
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "приостановить или замедлить"
                            },
                            {
                                "target_lang_word": "приостановить",
                                "target_lang_sense_clarification": "временно прекратить развитие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻止",
                                "target_lang_sense_clarification": "使停止发展"
                            },
                            {
                                "target_lang_word": "遏制",
                                "target_lang_sense_clarification": "制止、控制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8dc3955-32bb-36ca-98e6-4811f50c7a76",
                    "sense_definition": "To catch and hold someone's attention or interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright colors of the painting immediately <w>arrest</w> the attention of everyone who enters the room.",
                            "target_lang_translations": {
                                "ru": "Яркие цвета картины сразу же <w>приковывают</w> внимание каждого, кто входит в комнату.",
                                "zh": "画作鲜艳的色彩立刻<w>吸引</w>了每个走进房间的人的注意。"
                            }
                        },
                        {
                            "text": "Her unusual style of dress was enough to <w>arrest</w> the gaze of passersby.",
                            "target_lang_translations": {
                                "ru": "Ее необычного стиля одежды было достаточно, чтобы <w>задержать</w> на себе взгляды прохожих.",
                                "zh": "她独特的着装风格足以<w>吸引</w>路人的目光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "attract",
                        "engage",
                        "entice"
                    ],
                    "antonyms": [
                        "bore",
                        "repel"
                    ],
                    "common_phrases": [
                        "arrest the attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлечь и удержать чье-либо внимание или интерес.",
                        "zh": "吸引并保持某人的注意力或兴趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приковывать",
                                "target_lang_sense_clarification": "заставлять внимание быть неотрывно устремленным"
                            },
                            {
                                "target_lang_word": "задерживать",
                                "target_lang_sense_clarification": "сосредоточивать взгляд или внимание"
                            },
                            {
                                "target_lang_word": "приковать",
                                "target_lang_sense_clarification": "привлечь внимание к чему-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "引起注意"
                            },
                            {
                                "target_lang_word": "引人注目",
                                "target_lang_sense_clarification": "吸引目光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b278e5d5-6c9d-3b51-ae25-a7c9ca17b37e",
                    "sense_definition": "To stop the physical motion of a person, animal, or object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stopping_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The safety net was designed to <w>arrest</w> the fall of any worker who slipped.",
                            "target_lang_translations": {
                                "ru": "Страховочная сетка была разработана для того, чтобы <w>остановить</w> падение любого поскользнувшегося рабочего.",
                                "zh": "安全网的设计旨在<w>阻止</w>任何滑倒工人的坠落。"
                            }
                        },
                        {
                            "text": "He reached out his hand to <w>arrest</w> her progress as she tried to walk past him.",
                            "target_lang_translations": {
                                "ru": "Он протянул руку, чтобы <w>преградить</w> ей путь, когда она попыталась пройти мимо него.",
                                "zh": "当她试图从他身边走过时，他伸出手<w>拦住</w>了她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "freeze",
                        "halt"
                    ],
                    "antonyms": [
                        "release",
                        "propel"
                    ],
                    "common_phrases": [
                        "arrest the motion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить физическое движение человека, животного или объекта.",
                        "zh": "阻止人、动物或物体的物理运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановить",
                                "target_lang_sense_clarification": "заставить прекратить движение"
                            },
                            {
                                "target_lang_word": "задержать",
                                "target_lang_sense_clarification": "воспрепятствовать движению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阻止",
                                "target_lang_sense_clarification": "使停止运动"
                            },
                            {
                                "target_lang_word": "拦住",
                                "target_lang_sense_clarification": "阻挡去路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "357de623-142b-32ae-948f-222b1c7e6970",
                    "sense_definition": "To undergo a sudden cessation of heart function (cardiac arrest).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>arrest</w> on the operating table, requiring immediate resuscitation.",
                            "target_lang_translations": {
                                "ru": "У пациента на операционном столе начало <w>останавливаться</w> сердце, что потребовало немедленной реанимации.",
                                "zh": "病人在手术台上心脏开始<w>停跳</w>，需要立即进行复苏。"
                            }
                        },
                        {
                            "text": "Medical staff must act quickly when a person starts to <w>arrest</w> in the emergency room.",
                            "target_lang_translations": {
                                "ru": "Медицинский персонал должен действовать быстро, когда у человека в отделении неотложной помощи происходит <w>остановка</w> сердца.",
                                "zh": "当急诊室里有人心脏<w>停跳</w>时，医务人员必须迅速采取行动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перенести внезапную остановку сердечной деятельности.",
                        "zh": "心脏功能突然停止。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановиться",
                                "target_lang_sense_clarification": "о сердце"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停跳",
                                "target_lang_sense_clarification": "指心脏停止跳动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf0fe38d-bc04-3949-a2fd-9ca7ad8f02dc",
                    "sense_definition": "The act of taking a person into legal custody by the police.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police made an <w>arrest</w> late last night following a long investigation.",
                            "target_lang_translations": {
                                "ru": "Полиция произвела <w>арест</w> поздно вечером после долгого расследования.",
                                "zh": "经过长时间的调查，警方在昨晚深夜进行了一次<w>逮捕</w>。"
                            }
                        },
                        {
                            "text": "He was placed under <w>arrest</w> for driving without a valid license.",
                            "target_lang_translations": {
                                "ru": "Он был взят под <w>арест</w> за вождение без действительных прав.",
                                "zh": "他因无证驾驶而被<w>拘留</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apprehend",
                        "seize"
                    ],
                    "antonyms": [
                        "release"
                    ],
                    "common_phrases": [
                        "make an arrest",
                        "under arrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт взятия человека под стражу полицией.",
                        "zh": "警方将某人依法拘留的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арест",
                                "target_lang_sense_clarification": "заключение под стражу"
                            },
                            {
                                "target_lang_word": "задержание",
                                "target_lang_sense_clarification": "действие по значению гл. задержать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逮捕",
                                "target_lang_sense_clarification": "法律上的拘捕行动"
                            },
                            {
                                "target_lang_word": "拘留",
                                "target_lang_sense_clarification": "被扣留的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a59fbec3-dd56-3e0d-9b00-4ff7e0d2ffef",
                    "sense_definition": "The condition of being stopped or at a standstill, especially in a medical context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The victim suffered a sudden cardiac <w>arrest</w> while running in the park.",
                            "target_lang_translations": {
                                "ru": "У пострадавшего произошла внезапная <w>остановка</w> сердца во время пробежки в парке.",
                                "zh": "受害者在公园跑步时突然发生了心脏<w>停跳</w>。"
                            }
                        },
                        {
                            "text": "Respiratory <w>arrest</w> can occur if the airway is completely blocked for too long.",
                            "target_lang_translations": {
                                "ru": "<w>Остановка</w> дыхания может произойти, если дыхательные пути полностью заблокированы слишком долго.",
                                "zh": "如果气道被完全阻塞太久，可能会发生呼吸<w>停止</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "halt",
                        "seize"
                    ],
                    "common_phrases": [
                        "cardiac arrest",
                        "respiratory arrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние прекращения деятельности или застоя, особенно в медицине.",
                        "zh": "停止或停滞的状态，尤指医学领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановка",
                                "target_lang_sense_clarification": "прекращение работы органа"
                            },
                            {
                                "target_lang_word": "останов",
                                "target_lang_sense_clarification": "состояние прекращения движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停止",
                                "target_lang_sense_clarification": "功能中止"
                            },
                            {
                                "target_lang_word": "停滞",
                                "target_lang_sense_clarification": "停止活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82c974fc-9e78-3be4-af96-039d07db0676",
                    "sense_definition": "A state of confinement or detention following a legal seizure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_detention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political prisoner remained under house <w>arrest</w> for more than five years.",
                            "target_lang_translations": {
                                "ru": "Политический заключенный оставался под домашним <w>арестом</w> более пяти лет.",
                                "zh": "这位政治犯被软禁了五年多，处于<w>监禁</w>状态。"
                            }
                        },
                        {
                            "text": "His <w>arrest</w> lasted several days before the judge finally granted him bail.",
                            "target_lang_translations": {
                                "ru": "Его <w>задержание</w> длилось несколько дней, прежде чем судья наконец отпустил его под залог.",
                                "zh": "在法官最终准许保释前，他被<w>拘留</w>了几天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seize"
                    ],
                    "antonyms": [
                        "freedom",
                        "liberty"
                    ],
                    "common_phrases": [
                        "house arrest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения под стражей или задержания после законного изъятия свободы.",
                        "zh": "依法被剥夺自由后的监禁或拘留状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "арест",
                                "target_lang_sense_clarification": "лишение свободы, нахождение под стражей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监禁",
                                "target_lang_sense_clarification": "被关押的状态"
                            },
                            {
                                "target_lang_word": "拘留",
                                "target_lang_sense_clarification": "被扣押的状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}