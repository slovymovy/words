                        "entry_id": "e56646ed-a8bf-38c8-877c-9565481d2f95",
                        "glosses": [
                            "Qui concerne la muséologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b9f5789-46c8-48a1-a47f-e762ae4a27fb",
                                "sense_id": "edccc6c9-455f-3b8d-9ba3-338e6d63cf51",
                                "text": "Science, matériel muséologique; activités, méthodes muséologiques."
                            },
                            {
                                "example_id": "3f2944db-adcc-4dee-85ed-149637d4bf03",
                                "sense_id": "edccc6c9-455f-3b8d-9ba3-338e6d63cf51",
                                "text": "L'inventaire muséologique répond à la nécessité d'assurer la conservation administrative et de préserver l'identité des objets acquis par les Musées ou qui y sont déposés."
                            },
                            {
                                "example_id": "d595df5e-d88e-42db-a529-0d54e21d1327",
                                "sense_id": "edccc6c9-455f-3b8d-9ba3-338e6d63cf51",
                                "text": "La présentation de l'oeuvre d'art est, de nos jours, au premier rang des préoccupations muséologiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e25cce17-a586-4a74-a657-8aa889c017be",
                        "source_entry_id": "e56646ed-a8bf-38c8-877c-9565481d2f95",
                        "source_sense_id": "edccc6c9-455f-3b8d-9ba3-338e6d63cf51",
                        "target_lang_word": "museological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "museological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2420d92-5473-3a98-8cb6-84f26ea47329",
                                        "entry_id": "17a32cea-35ca-35f2-9b5b-dd71abb75ebb",
                                        "glosses": [
                                            "Pertaining to museology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baace44a-0210-4119-89a0-842590e4cac3",
                                                "sense_id": "c2420d92-5473-3a98-8cb6-84f26ea47329",
                                                "text": "But as a testament to what might be called the Thomas Krens legacy — he will be remembered as a builder of museums who failed to build where his museum needed it most — this is partly a depressing show, symptomatic of the kind of museological missteps that have become par for the course in New York."
                                            },
                                            {
                                                "example_id": "ba9b96a7-9cda-4b20-8d2a-5b5f1dce7e52",
                                                "sense_id": "c2420d92-5473-3a98-8cb6-84f26ea47329",
                                                "text": "Of course, in the cinema gallery, where monitors and projections are accompanied by museological text labels, a voyeuristic, peep-show pleasure is partly promised; and tape loops of pornographic hydraulics hold repeat viewers in rapt attention."
                                            },
                                            {
                                                "example_id": "9800f5f6-9a6c-4ad7-af8a-1d35767c2027",
                                                "sense_id": "c2420d92-5473-3a98-8cb6-84f26ea47329",
                                                "text": "They are stars of the museological jet set."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
