                                "target_senses": [
                                    {
                                        "sense_id": "689c11a2-c707-3fc4-83be-b973eaacb2e8",
                                        "entry_id": "34483405-d128-318c-91fd-ddb9949cc94e",
                                        "glosses": [
                                            "Schneidewerkzeug mit Griff und Klinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89541b72-3319-46a8-8026-d6f09c7a4bb8",
                                                "sense_id": "689c11a2-c707-3fc4-83be-b973eaacb2e8",
                                                "text": "Das Messer hat eine scharfe Klinge."
                                            },
                                            {
                                                "example_id": "55088c99-b438-4b36-805c-a94f4bda358c",
                                                "sense_id": "689c11a2-c707-3fc4-83be-b973eaacb2e8",
                                                "text": "„Die Mutter rammte das Messer in ein Kartoffelauge, das sie längst ausgestochen hatte.“"
                                            },
                                            {
                                                "example_id": "758b77e8-97e7-41e6-9fa1-7cffb1e968b8",
                                                "sense_id": "689c11a2-c707-3fc4-83be-b973eaacb2e8",
                                                "text": "„In der Schublade des Tisches waren ein paar Gabeln, Löffel und ein Messer gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67dea2c9-64bf-3b73-9ec8-3a540ab95a9a",
                                        "entry_id": "34483405-d128-318c-91fd-ddb9949cc94e",
                                        "glosses": [
                                            "Stichwaffe mit Griff und Klinge"
                                        ],
                                        "tags": [
                                            "Waffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23aa4ec2-fe7f-4254-965c-9ea7b5753405",
                                                "sense_id": "67dea2c9-64bf-3b73-9ec8-3a540ab95a9a",
                                                "text": "Zu seiner Sicherheit hat er ein Messer in seiner Socke und zusätzlich eins in der Jackeninnentasche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "646fb613-9d86-33b4-bfc0-aeb4b98ab743",
                                        "entry_id": "34483405-d128-318c-91fd-ddb9949cc94e",
                                        "glosses": [
                                            "schneidende Klinge in Maschinen, wie zum Beispiel einem Rasenmäher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea696060-a594-4c97-8a91-2ecaa13f595e",
                                                "sense_id": "646fb613-9d86-33b4-bfc0-aeb4b98ab743",
                                                "text": "Das Messer der Brotmaschine kann auch entnommen und geschliffen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Messer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "938ffe9f-6cbf-3369-aee8-15ea0bcc67c5",
                                        "entry_id": "0998f44b-454a-376f-b5e9-0041a6531e3c",
                                        "glosses": [
                                            "der messende Mensch"
                                        ],
                                        "tags": [],
