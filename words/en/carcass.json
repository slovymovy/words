                                "target_lang_word": "szkielet",
                                "target_lang_sense_clarification": "konstrukcja nośna budynku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e688647f-9e06-3784-b020-18af21f5a9aa",
                    "sense_definition": "An old type of incendiary projectile used in naval warfare.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship fired a <w>carcass</w> at the enemy vessel.",
                            "target_lang_translations": {
                                "pl": "Okręt wystrzelił <w>karkas</w> w stronę wrogiej jednostki."
