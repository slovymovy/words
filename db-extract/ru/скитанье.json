                "senses": [
                    {
                        "sense_id": "0356b56e-9258-3b7c-b494-7cbfb355fe84",
                        "entry_id": "0c74c92e-541a-3f83-a55f-9ece09f0c029",
                        "glosses": [
                            "устар., разг. и поэт. то же, что скитание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb4e4738-fee1-4fa3-bb53-1b97fab81309",
                                "sense_id": "0356b56e-9258-3b7c-b494-7cbfb355fe84",
                                "text": "И все пошло опять по-старому: сбор провианта, сыск беглых, литье пушек, рубка лесов, строенье болверков, скитанье из города в город."
                            },
                            {
                                "example_id": "5f9ed0b9-179d-414f-acf2-4573d11f6108",
                                "sense_id": "0356b56e-9258-3b7c-b494-7cbfb355fe84",
                                "text": "И в наше новое скитанье // Мы взяли, что смогли сберечь, // Терпенье наше, наши знанья // И русскую родную речь."
                            },
                            {
                                "example_id": "604dc84c-9bf8-43bd-8b3a-b06987e158ae",
                                "sense_id": "0356b56e-9258-3b7c-b494-7cbfb355fe84",
                                "text": "Следить погод и непогод // устав чередованье, // ушел из дому старый год, // как старый граф в скитанье."
                            }
                        ]
                    }
                ],
