                        ],
                        "form": "den Erzählern"
                    },
                    {
                        "form_id": "e44e018e-be16-40ed-a565-7c4b54cda24f",
                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Erzähler"
                    },
                    {
                        "form_id": "bb972dd2-e581-444d-8f94-4441d3463567",
                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erzähler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                        "glosses": [
                            "Person, die etwas erzählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                            },
                            {
                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                            },
                            {
                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                        "glosses": [
                            "Verfasser einer Erzählung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                        "glosses": [
                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafbf4f6-37dc-4d47-b225-fc5c5bd6e341",
                        "source_entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                        "source_sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                        "source_sense_description": "Person, die etwas erzählt",
                        "target_lang_word": "teller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "293b9f78-122a-3438-a2fe-515ef605ca64",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A person who tells stories."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A bank clerk who receives and pays out money."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec0216cc-a31a-42c6-a8cb-6dc5500d9b3d",
                                                "sense_id": "42695eea-863d-3a6a-9002-af08e764baae",
                                                "text": "Sukumar was thirty years old, four years into his bank job, where he’d moved up to the role of teller, turning up to work on time every day, counting the money, making the deposits, entering in the ledger, filing the reports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A cashier at any place of business."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2a9238-8384-4c8b-ae39-528e12d167b1",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "In the case discussed above, for example, the employee who stole money did so by waiting until another teller was on break, then logging on to that teller's register, ringing a “no sale,” and taking the cash."
                                            },
                                            {
                                                "example_id": "0b75dbe0-06ef-40ce-be97-55d371e3c22f",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "The young femail teller fingered the prices into the cash register at great speed with great dexterity while simultaneously holding a conversation with the teller in the next lane."
                                            },
                                            {
                                                "example_id": "6848b34d-db92-48c6-9f3e-435916e827a1",
                                                "sense_id": "1ff1e369-1c01-3dec-8ad5-b3cb33ce6fab",
                                                "text": "The main street was shuttered; the only sign of life she detected was behind the window of the petrol station, where the teller was counting the day's cash balance into the till."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "272fb4cd-e9f7-314a-8a17-1489f4017870",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "Synonym of automated teller machine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "506c981a-fb5d-3b68-b5ac-69c49c31ba26",
                                        "entry_id": "bddfe198-c834-3d19-825e-09d2fc598ea2",
                                        "glosses": [
                                            "A person who counts the votes in an election."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
