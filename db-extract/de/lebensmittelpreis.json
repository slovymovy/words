                        "examples": [
                            {
                                "example_id": "7ce4cf1a-870f-41fc-ae44-fa31c3cd394e",
                                "sense_id": "0ad43369-8307-3897-8173-52ff029d33d8",
                                "text": "„Den stark gestiegenen Lebensmittelpreisen gegenüber stand eine sehr unterschiedliche Entwicklung bei den Löhnen.“"
                            },
                            {
                                "example_id": "9db1e754-de0d-4fd6-aea9-20de83baa7b9",
                                "sense_id": "0ad43369-8307-3897-8173-52ff029d33d8",
                                "text": "„»Im Jahr 2022 sind die Lebensmittelpreise im Schnitt in der Eurozone um neun Prozent gestiegen und im Jahr 2023 um fast elf Prozent. Also das sind die offiziellen Zahlen von Eurostat.«“"
