                "senses": [
                    {
                        "sense_id": "7872c6d5-b773-3e88-8129-a5adba2476fb",
                        "entry_id": "3ecb0040-bea0-38fd-aa55-e95380170c69",
                        "glosses": [
                            "barwna tkanina bawełniana"
                        ],
                        "tags": [],
