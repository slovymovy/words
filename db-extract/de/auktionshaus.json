                ],
                "senses": [
                    {
                        "sense_id": "a21b8436-4bad-33c3-b5a1-13e65f200aae",
                        "entry_id": "2055a574-ebbd-32d9-8273-6106c470bc1b",
                        "glosses": [
                            "Unternehmen, das Waren begutachtet, dokumentiert, präsentiert und schließlich die Abwicklung des Verkaufs übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd84036d-7e5e-4a04-9fb2-4241fa4c476d",
                                "sense_id": "a21b8436-4bad-33c3-b5a1-13e65f200aae",
                                "text": "„Das eingelieferte Material wird von Fachexperten im Auktionshaus grob sortiert, detailliert gesichtet und geprüft.“"
                            },
                            {
                                "example_id": "978309b0-c299-48a2-9439-1126b27c0ff2",
                                "sense_id": "a21b8436-4bad-33c3-b5a1-13e65f200aae",
                                "text": "„Der Kirchenmaler und Restaurator Christian Goller aus Niederbayern soll seit Jahrzehnten den internationalen Kunstmarkt mit selbstgemalten Bildern speisen, die er über Freunde als Werke \"aus der Werkstatt / dem Umfeld von Lucas Cranach dem Älteren\" oder seinem Sohn Lucas Cranach dem Jüngeren bei Auktionshäusern einbringen lasse.“"
                            },
                            {
                                "example_id": "5db3b56b-feef-43a1-bb3c-3cbb031b9165",
                                "sense_id": "a21b8436-4bad-33c3-b5a1-13e65f200aae",
                                "text": "„Als der Sieger eine halbe Stunde später mit dem Buch das Auktionshaus verläßt, wird er, wie Nachforschungen ergeben, von genau derselben Person verfolgt, die im Saal unterlegen war.“"
                            },
                            {
                                "example_id": "590e2e48-562f-45b7-a2e9-fe7eea13daf7",
                                "sense_id": "a21b8436-4bad-33c3-b5a1-13e65f200aae",
                                "text": "„Wir würden im Auktionshaus mit Bens Referenzen und dem Verweis auf den Acquisewunsch der Britischen Bibliothek um die Herausgabe von Informationen bitten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
