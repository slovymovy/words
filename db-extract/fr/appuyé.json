                                "sense_id": "f07ab180-76bf-3581-ad0c-ad0d4a4412c6",
                                "text": "Appuyé contre un mur."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                        "entry_id": "b1730690-c519-38af-a14a-0f60ce87068b",
                        "glosses": [
                            "Qui se repose sur, secondé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "17cea1ea-4878-4094-8ea2-72daf1e105d2",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Appuyé sur la faveur populaire."
                            },
                            {
                                "example_id": "e90cc0ed-691f-461a-91cb-c3b46ee324eb",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Appuyé par le ministre dans son élection."
                            },
                            {
                                "example_id": "72999e3d-06f5-4253-bc20-8ef08f0f9444",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Sur son jugement seul ce grand homme appuyé."
                            },
                            {
                                "example_id": "ca7d97c6-6907-42ae-9c84-b8ebd745ae9f",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Après mille serments appuyés de mes larmes."
                            },
                            {
                                "example_id": "c143a70d-cdeb-4719-b8e7-ee34f0cdb037",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Appuyé de Sénèque et du tribun Burrhus."
                            },
                            {
                                "example_id": "b7b77f2e-fa53-4430-9155-ab36dd408589",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Elle n’est en ces lieux que trop bien appuyée."
                            },
                            {
                                "example_id": "cf4b2d78-3815-40dd-809b-849f1ffe1093",
                                "sense_id": "e8acdf9e-6501-35b7-b0fb-79f0dae427f6",
                                "text": "Appuyé sur un pareil homme, j'eusse bravé Paris !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9bafa6bd-2128-3d5e-9df1-0f992a37f94b",
                        "entry_id": "b1730690-c519-38af-a14a-0f60ce87068b",
                        "glosses": [
                            "Marqué, significatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270693fd-69e7-4971-907f-9ef263c22bf8",
                                "sense_id": "9bafa6bd-2128-3d5e-9df1-0f992a37f94b",
                                "text": "Ces derniers mots furent prononcés avec une gravité appuyée qui surprit fort l’assistance."
                            },
                            {
                                "example_id": "c0fd922c-6a9d-4dc4-a3e9-88645baa08d8",
                                "sense_id": "9bafa6bd-2128-3d5e-9df1-0f992a37f94b",
                                "text": "D’un ton grave et d’un accent appuyé."
                            }
                        ]
                    },
                    {
                        "sense_id": "7edfa880-4f47-302d-8fec-d94742a223f2",
                        "entry_id": "b1730690-c519-38af-a14a-0f60ce87068b",
                        "glosses": [
