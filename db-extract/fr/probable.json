                                    {
                                        "sense_id": "47575cfe-44b2-320b-8d55-ee602cca460e",
                                        "entry_id": "197bfc91-2cb9-3138-9fe2-199c4c9b9d6f",
                                        "glosses": [
                                            "naar men denkt, maar niet zeker weet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fedacda-ea97-497d-9961-d88fcb2fff33",
                                                "sense_id": "47575cfe-44b2-320b-8d55-ee602cca460e",
                                                "text": "Ruimtevaartorganisatie NASA is klaar met het uitvoeren van tests met zijn Space Launch System-raket (SLS). De raket wordt vermoedelijk eind augustus gelanceerd."
                                            },
                                            {
                                                "example_id": "d524b982-e6a9-4113-b45c-e1dc1eedf34d",
                                                "sense_id": "47575cfe-44b2-320b-8d55-ee602cca460e",
                                                "text": "Vermoedelijk waren de mooie vloerkleden ook gewassen met groene zeep omdat andere soorten zeep en wasmiddel op rantsoen waren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vermoedelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "063b5909-7fff-3bd1-9b4b-13459fa6e4f0",
                                        "entry_id": "007bbe57-d192-35af-b5a5-714b5d581b43",
                                        "glosses": [
                                            "naar men denkt, maar niet zeker weet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc8f9a3-b66b-4c5f-82ee-78b17d1ab9f3",
                                                "sense_id": "063b5909-7fff-3bd1-9b4b-13459fa6e4f0",
                                                "text": "Riccardo bleef in de kuil van zo'n 1,5 meter achter en is vermoedelijk een tunnel gaan graven."
                                            },
                                            {
                                                "example_id": "a7fe291b-c694-488c-a93e-ffa05390955e",
                                                "sense_id": "063b5909-7fff-3bd1-9b4b-13459fa6e4f0",
                                                "text": "Aan beide kanten worden de onzekerheden in de resultaten vermoedelijk onderschat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "652ce0bb-0988-4849-b86e-56a67ac05bea",
