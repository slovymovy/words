                                    {
                                        "sense_id": "b6045656-651b-357f-9342-cdf4ef0b7e77",
                                        "entry_id": "2aa71017-fdc2-3530-aa30-6b62c175aecc",
                                        "glosses": [
                                            "dikke darmonderzoek waarbij men met een endoscoop het darmslijmvlies onderzoekt en zo nodig een biopsie kan nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94cb60f9-3303-4bbb-8ff3-b834a148cfc8",
                                                "sense_id": "b6045656-651b-357f-9342-cdf4ef0b7e77",
                                                "text": "Hierdoor zijn er veel mensen die bij maag-, darm- en leverartsen aankloppen met een positieve uitslag van de ontlastingstest. Patiënten die 'echt klachten' hebben moeten daardoor langer dan normaal op een coloscopie wachten, het kijkonderzoek."
                                            },
                                            {
                                                "example_id": "fa9b7966-c4d9-4532-ab35-5444e51c9bcf",
                                                "sense_id": "b6045656-651b-357f-9342-cdf4ef0b7e77",
                                                "text": "Om deze resultaten te bereiken zijn jaarlijks 110.000 coloscopieën nodig. Een coloscopie is een belastend inwendig darmonderzoek waarbij een buigzame slang in de darm wordt gebracht. Aan de slang zitten een cameraatje en een lampje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b08d987f-3302-4cff-86a9-45a2860f7f70",
                        "source_entry_id": "bcec4279-3d34-3d0e-b8e5-5551fbf08aec",
                        "source_sense_id": "f88be5de-2b99-3414-91c7-551e6a60d6e8",
                        "target_lang_word": "colonoscopie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonoscopie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "55ff29e7-c8da-3643-b60c-4251660dccb8",
                                        "entry_id": "13494701-ea10-369c-9b2a-7aea9ccb8d4a",
                                        "glosses": [
                                            "dikke darmonderzoek waarbij men met een endoscoop het darmslijmvlies onderzoekt en zo nodig een biopsie kan nemen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10181aad-96f4-41e0-8f37-88da63e420a6",
                                                "sense_id": "55ff29e7-c8da-3643-b60c-4251660dccb8",
                                                "text": "De man werd meegenomen en veertien uur lang tegen zijn wil in onderzocht door doktoren en de politie. Ondanks een uitgebreide zoektocht met twee röntgenfoto's, drie klysma's en een colonoscopie (darmonderzoek) werden er geen drugs gevonden in het lichaam van Eckert."
                                            },
                                            {
                                                "example_id": "444418fc-c4f2-40fb-b76d-948c69abb0f1",
                                                "sense_id": "55ff29e7-c8da-3643-b60c-4251660dccb8",
                                                "text": "Als er bloed in de ontlasting zit, volgt een dikke-darmonderzoek, een colonoscopie. Bloed in de ontlasting kan ook andere oorzaken hebben dan darmkanker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
