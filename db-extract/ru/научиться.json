                        "form_id": "d06d2c17-e44f-4975-b6be-dea82ff68a2c",
                        "entry_id": "8ac07a60-bf33-35fc-bf36-d7cc069e2938",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "научи́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c8a175d-63c8-3e74-8ead-6ef0001b222d",
                        "entry_id": "8ac07a60-bf33-35fc-bf36-d7cc069e2938",
                        "glosses": [
                            "получить знания и навыки, позволяющие выполнять определённую работу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11552eed-77da-46d2-87ab-b4a6ffcd00c5",
                                "sense_id": "8c8a175d-63c8-3e74-8ead-6ef0001b222d",
                                "text": "Я научился читать в 4 года."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93f51445-6e3c-4f06-b80a-92eba8ede90b",
                        "source_entry_id": "8ac07a60-bf33-35fc-bf36-d7cc069e2938",
                        "source_sense_id": "8c8a175d-63c8-3e74-8ead-6ef0001b222d",
                        "target_lang_word": "learn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "learn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To acquire, or attempt to acquire knowledge or an ability to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "166056e6-a385-4a30-9d07-34ddf6d2f3e7",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "It's time Dad learned (how) to change the oil in the car."
                                            },
                                            {
                                                "example_id": "4e59b337-16a0-428d-91ed-30613c3de6e4",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "In my latest job, I've learnt to keep my mouth shut more than in the last one."
                                            },
                                            {
                                                "example_id": "e453568d-e55b-42a3-adec-60f6e43f4de1",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "Toddlers learn to walk at around one year old."
                                            },
                                            {
                                                "example_id": "ed3a4013-f223-4f2e-97de-8343fe080b66",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "a school in which he learns sly circumvention"
                                            },
                                            {
                                                "example_id": "65744afd-5560-494d-868a-f8e07119a059",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "I was very impressed with the obvious amount of work that went into the learning and synchronization of such a complex and harmonically and difficult score."
                                            },
                                            {
                                                "example_id": "91795502-4bde-4351-b0d4-054c2b8aa44f",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "I have learned far more from them about how to be a scientist than they realize. Above all else, they taught me the virtues of proper waterfowl alignment."
                                            },
                                            {
                                                "example_id": "087b93a8-ea7c-47a2-9048-6a18d58b5c68",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "Every day I learn more about this great city."
                                            },
                                            {
                                                "example_id": "5a0c881c-ce39-4564-a0ed-9c3b8c69daa4",
                                                "sense_id": "4f1c077c-d19a-3ba5-9fe1-96c666be219b",
                                                "text": "Other rules learnt by butlers include lighting candles 15 minutes before guests enter a room, and not saying \"good morning\" to guests until you are 5ft away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d23864-0874-360b-9add-2e84d9ca6ba3",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To attend a course or other educational activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55f8b240-7be6-434b-88db-b5defac65505",
                                                "sense_id": "87d23864-0874-360b-9add-2e84d9ca6ba3",
                                                "text": "For, as he took delight to introduce me, I took delight to learn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0ef8db-69ef-3a6f-a440-8f0b6f9a133c",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To gain knowledge from a bad experience so as to improve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33d71289-b013-4189-9401-a1f9b888e3c1",
                                                "sense_id": "1c0ef8db-69ef-3a6f-a440-8f0b6f9a133c",
                                                "text": "learn from one's mistakes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e25cc3-3d94-3275-bcc7-c9034458e621",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f1101b-f55d-4a87-bfcc-919f9e7114ec",
                                                "sense_id": "a0e25cc3-3d94-3275-bcc7-c9034458e621",
                                                "text": "I learn medicine."
                                            },
                                            {
                                                "example_id": "5e27ec8c-11f2-494f-a48a-fa86ff89ca09",
                                                "sense_id": "a0e25cc3-3d94-3275-bcc7-c9034458e621",
                                                "text": "They learn psychology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82f5239-b4bb-39d0-985c-8f6d7f51dadf",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To come to know; to become informed of; to find out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5eaf69-ee3c-44af-b363-c558cf24e7a1",
                                                "sense_id": "b82f5239-b4bb-39d0-985c-8f6d7f51dadf",
                                                "text": "He just learned that he will be sacked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                        "entry_id": "1a3a19a8-1553-3f48-8aeb-0cc02e236e14",
                                        "glosses": [
                                            "To teach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50010699-ad07-45c1-9f24-c44b5eb6ca82",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "Give him a clip round the ear. That'll learn him!"
                                            },
                                            {
                                                "example_id": "3c9b5c74-c871-46be-9e10-2b21e73c0a1d",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "And whan she had serched hym\n she fond in the bottome of his wound that therin was poyson\n And soo she heled hym[…]\n and therfore Tramtrist cast grete loue to la beale Isoud\n for she was at that tyme the fairest mayde and lady of the worlde\n And there Tramtryst lerned her to harpe\n and she beganne to haue grete fantasye vnto hym"
                                            },
                                            {
                                                "example_id": "cf442a3e-ea01-4b32-a5e4-2a404ee048cb",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "Sweete Prince, you learne me noble thankfulnes: […]"
                                            },
                                            {
                                                "example_id": "4497b675-4537-481e-be8c-e9ca4b4d27b4",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "Haue I not bene\n Thy Pupill long? Haſt thou not learn'd me how\n To make Perfumes?"
                                            },
                                            {
                                                "example_id": "3e3920cf-9cb9-4226-b6be-4d043535177b",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "[…] Take heed of filling their [i.e., children's] heads with VVhimzies, and unprofitable Notions; for this vvill ſooner learn them to be malepert and proud, than ſober and humble."
                                            },
                                            {
                                                "example_id": "eca1b2b6-ac6c-4f42-94c0-21b91fe10f02",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "But we’ll play Robin Hood—it’s noble fun. I’ll learn you."
                                            },
                                            {
                                                "example_id": "9b20120b-d9eb-4b83-b5ce-26a76b4ed854",
                                                "sense_id": "32c3b934-f3b0-3cea-b742-1873c9286041",
                                                "text": "That'll learn him to bust my tomater."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "learn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3ef08d-4d9e-3cb7-b96f-fef1a501c926",
                                        "entry_id": "3bddcbd4-efb4-32a9-9a58-4e78cc581197",
                                        "glosses": [
                                            "The act of learning something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c0b8258-472a-4a31-9e4f-e2852f8aea76",
                                                "sense_id": "1f3ef08d-4d9e-3cb7-b96f-fef1a501c926",
                                                "text": "I did a quick learn of the place by watching the people shuffle in. There was a healthy mix of beautiful and freaky people, who shared a few common denominators[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f733579-3d9d-40a6-af83-0dadb740fa9e",
                        "source_entry_id": "8ac07a60-bf33-35fc-bf36-d7cc069e2938",
                        "source_sense_id": "8c8a175d-63c8-3e74-8ead-6ef0001b222d",
                        "target_lang_word": "lernen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lernen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4414698c-967c-3073-9c76-4d27c05ffa92",
                                        "entry_id": "867ac835-91d7-3f83-b395-9deac41994b8",
                                        "glosses": [
                                            "erarbeiten/erwerben/gewinnen von Kenntnissen und/oder geistigen oder körperlichen Fähigkeiten, Fertigkeiten und Erfahrungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "611ff085-b893-4e25-ba10-689967c6f3c3",
                                                "sense_id": "4414698c-967c-3073-9c76-4d27c05ffa92",
                                                "text": "Man lernt jeden Tag etwas Neues."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f04d9e32-8b34-3554-9304-62ef5e168711",
                                        "entry_id": "867ac835-91d7-3f83-b395-9deac41994b8",
                                        "glosses": [
                                            "gezielt einen vorgegebenen Lernstoff erarbeiten und verinnerlichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7453a07b-352c-45c3-81bb-63fdfdb3a95b",
                                                "sense_id": "f04d9e32-8b34-3554-9304-62ef5e168711",
                                                "text": "Ich habe keine Zeit, ich muss bis morgen noch für Französisch Vokabeln lernen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b1d62983-beaa-30d1-ae3a-d67687e48e0f",
                                        "entry_id": "867ac835-91d7-3f83-b395-9deac41994b8",
                                        "glosses": [
                                            "sich in ein Metier einarbeiten, eine Ausbildung (Lehre) absolvieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7425b777-5167-43b0-b311-37a8903f06de",
                                                "sense_id": "b1d62983-beaa-30d1-ae3a-d67687e48e0f",
                                                "text": "Er ist Lehrling und muss noch 2 Jahre lernen."
                                            },
                                            {
                                                "example_id": "0cce1266-f66d-4e4b-9326-212d945cb426",
                                                "sense_id": "b1d62983-beaa-30d1-ae3a-d67687e48e0f",
                                                "text": "„In Lübeck hat er Schriftsetzer gelernt, nahm als Kriegsfreiwilliger an den Befreiungskriegen gegen Napoleon teil und kam um 1814 nach Frankfurt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6234e74d-3fd0-33d6-9868-3509b36dcee3",
                                        "entry_id": "867ac835-91d7-3f83-b395-9deac41994b8",
                                        "glosses": [
                                            "Erfahrungen sammeln, eine Einstellung zu etwas erwerben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d6073ce-aaf1-44ae-b2f8-848073978d5f",
                                                "sense_id": "6234e74d-3fd0-33d6-9868-3509b36dcee3",
                                                "text": "Er hat mit der Zeit gelernt, sich mit Wenigem zufriedenzugeben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7785b685-0537-30c4-b8c1-7ee9ac667ce1",
                                        "entry_id": "867ac835-91d7-3f83-b395-9deac41994b8",
                                        "glosses": [
                                            "lehren, auch in alter Zeit nicht häufig, galt schon Ende des 18. Jahrhunderts als veraltet und nicht mehr korrekt, heute entweder ungrammatisch oder regional beispielsweise im Raum Bayern und in Norddeutschland, vergleiche hier das niederdeutsche „lehren“ = lehren und lernen"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9e088dd-5a1e-467e-9a81-3569c4dc8783",
                                                "sense_id": "7785b685-0537-30c4-b8c1-7ee9ac667ce1",
                                                "text": "(1684) „Dieſer kalen Possen schämte er sich nicht allein ſondern wolte noch / wegen ſolcher klugen Erfindung / die ihm sein Geiz gelernet Ruhm haben.“"
                                            },
                                            {
                                                "example_id": "2aaf0931-976c-4fc8-add7-5bf5090a5256",
                                                "sense_id": "7785b685-0537-30c4-b8c1-7ee9ac667ce1",
                                                "text": "(Niederbayern) „Eine andere Nachbarin kam, um mir das Kochen und Flicken zu lernen, und wie ich mit den kleinen Kindern umgehen muß.“"
                                            },
                                            {
                                                "example_id": "535d9199-d7fd-4b7e-8785-3195a717a6d3",
                                                "sense_id": "7785b685-0537-30c4-b8c1-7ee9ac667ce1",
                                                "text": "(Missingsch, Hamburg) „Wertes Frollein! Klein Erna is keine Rose, Sie solln ihr nich riechen, sie solln ihr lernen!“ (Das Frollein – Fräulein ist hier die Lehrerin)"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2e10ec7-38f5-4198-856f-0e1672ca6da8",
                        "source_entry_id": "8ac07a60-bf33-35fc-bf36-d7cc069e2938",
                        "source_sense_id": "8c8a175d-63c8-3e74-8ead-6ef0001b222d",
                        "target_lang_word": "erlernen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erlernen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3656b9a9-7888-3dc7-8f42-96d6c11b7ef4",
                                        "entry_id": "767abc90-0577-314b-8b7d-7a3f33ee3b99",
                                        "glosses": [
                                            "etwas begreifen und üben (lernen), meist über längere Zeit hinweg und mit dem Ziel, es zu können/beherrschen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8fb66e0-3dab-46af-b51d-87dea1cb5773",
                                                "sense_id": "3656b9a9-7888-3dc7-8f42-96d6c11b7ef4",
                                                "text": "„Man kann, weil Finnisch eine finnougrische Sprache ist, mithin keiner zivilisierten Sprachgruppe angehört, nicht auf andere Sprachen zurückgreifen, um es zu erlernen.“"
                                            },
                                            {
                                                "example_id": "1f62f21a-af7a-4821-827d-2ae30819f1bd",
                                                "sense_id": "3656b9a9-7888-3dc7-8f42-96d6c11b7ef4",
                                                "text": "„Ziel ist es, Techniken zu erlernen, mit denen die Gelenke durch die kräftigen Muskeln entlastet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
