                ],
                "senses": [
                    {
                        "sense_id": "f13e6943-802f-3cf1-a08d-bae4c8412e6a",
                        "entry_id": "1b60dfea-ffa4-3a35-9be3-c4d4d7360112",
                        "glosses": [
                            "спец. цилиндрический сердечник для намотки чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1ef44b-e762-4287-84fd-4065f5dac5fd",
                                "sense_id": "f13e6943-802f-3cf1-a08d-bae4c8412e6a",
                                "text": "Шпули с шёлком упаковывают и отправляют на текстильные фабрики."
                            }
                        ]
                    },
                    {
                        "sense_id": "02564873-86eb-36b6-bde2-3ff81f6040da",
                        "entry_id": "1b60dfea-ffa4-3a35-9be3-c4d4d7360112",
                        "glosses": [
                            "спец. шпуля [1] вместе с тем, что на неё намотано"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae53421-b41a-4bb6-8756-5692a332a3f9",
                                "sense_id": "02564873-86eb-36b6-bde2-3ff81f6040da",
                                "text": "Дальнейшая обработка нити заключается в промывке, отбелке, сушке, затем крутке и перемотке в шпули."
                            },
                            {
                                "example_id": "a9358044-3aa1-4ad0-a20b-08f9ca5ef8ae",
                                "sense_id": "02564873-86eb-36b6-bde2-3ff81f6040da",
                                "text": "Что бесконечность постигаешь, созерцая нескончаемую шпулю ниток защитного цвета, которые выданы матери для шитья маскхалатов."
                            }
                        ]
                    }
