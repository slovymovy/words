                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fbd6434-f7ad-41b1-8e97-3f9f120edeae",
                        "source_entry_id": "925d97b1-3439-3bb9-be24-719f1b0fc612",
                        "source_sense_id": "79db3fca-6a1f-327c-a47d-979e9ef80875",
                        "target_lang_word": "blood covered",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6021625d-ffd8-4a01-aeab-792365f762e2",
                        "source_entry_id": "925d97b1-3439-3bb9-be24-719f1b0fc612",
                        "source_sense_id": "79db3fca-6a1f-327c-a47d-979e9ef80875",
                        "target_lang_word": "bloody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "507374e1-2d95-327f-ae7b-3d2a2f9ed53a",
                                        "entry_id": "8d47f1ec-c231-3092-a215-e71146f96071",
                                        "glosses": [
                                            "Covered in blood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c54e122-0555-473e-a2e3-82a9f589a0ea",
                                                "sense_id": "507374e1-2d95-327f-ae7b-3d2a2f9ed53a",
                                                "text": "All that remained of his right hand after the accident was a bloody stump."
                                            },
                                            {
                                                "example_id": "650b09e7-b0eb-4c4a-ba94-51b897bdc6c6",
                                                "sense_id": "507374e1-2d95-327f-ae7b-3d2a2f9ed53a",
                                                "text": "And, as she fled, her mantle she did fall, / Which Lion vile with bloody mouth did stain."
                                            },
                                            {
                                                "example_id": "d60b2592-ed52-4a5d-84fe-d6d437bf838d",
                                                "sense_id": "507374e1-2d95-327f-ae7b-3d2a2f9ed53a",
                                                "text": "O Antony! Begge not your death of vs: / Though now we muſt appeare bloody and cruell, / As by our hands, and this our preſent Acte / You ſee we do: Yet ſee you but our hands, / And this, the bleeding buſineſſe they haue done:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f43fc2c8-fb62-38ff-be65-cff114c41b0f",
                                        "entry_id": "8d47f1ec-c231-3092-a215-e71146f96071",
                                        "glosses": [
                                            "Characterised by bloodshed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd00a158-f313-44be-bffe-d9df7eb7aad5",
                                                "sense_id": "f43fc2c8-fb62-38ff-be65-cff114c41b0f",
                                                "text": "There have been bloody battles between the two tribes."
                                            },
                                            {
                                                "example_id": "6e512236-b080-4793-b70d-005406c20046",
                                                "sense_id": "f43fc2c8-fb62-38ff-be65-cff114c41b0f",
                                                "text": "Some bloody paſſion ſhakes your very Frame:"
                                            },
                                            {
                                                "example_id": "a1be8731-b479-4b3c-8e6b-0d9fbf533c18",
                                                "sense_id": "f43fc2c8-fb62-38ff-be65-cff114c41b0f",
                                                "text": "I had therefore been, until now, out of the way of the bloody scenes that often occurred on the plantation."
                                            },
                                            {
                                                "example_id": "9b4eba99-f257-4412-86c9-c6c569220940",
                                                "sense_id": "f43fc2c8-fb62-38ff-be65-cff114c41b0f",
                                                "text": "The story of Elizabeth Bathory is one of the bloodiest in history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                        "entry_id": "8d47f1ec-c231-3092-a215-e71146f96071",
                                        "glosses": [
                                            "Used as an intensifier."
                                        ],
                                        "tags": [
                                            "British",
                                            "Commonwealth",
                                            "Hawaii",
                                            "Ireland",
                                            "informal",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd49d3a3-8977-4704-a003-c7a1f22fed40",
                                                "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                                "text": "Traffic in central London was a bloody mess this morning."
                                            },
                                            {
                                                "example_id": "f5f9eb19-4c36-4215-9371-cad238fb051c",
                                                "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                                "text": "There seems to be something wrong with our bloody ships today."
                                            },
                                            {
                                                "example_id": "005458c0-3758-4987-a252-24518c69c77f",
                                                "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                                "text": "Try to keep those bloody women's bloody heads on their bloody shoulders by somehow helping them make this whole mad impossible scheme actually work."
                                            },
                                            {
                                                "example_id": "11902b01-f0cf-4e71-af6c-e88e22de8d8c",
                                                "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                                "text": "You are not to go asking anyone about who killed that bloody dog."
                                            },
                                            {
                                                "example_id": "62cae2f8-27d8-4164-a2f1-6591e7f5ed14",
                                                "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                                "text": "“You bloody fool, I could′ve stabbed you in the heart,” David said in mock anger, and then smiled widely."
                                            },
                                            {
                                                "example_id": "9bc48f83-6dc5-465a-9dca-0812214fca11",
                                                "sense_id": "45d49da4-b1d5-3c90-884f-2b2594bc991f",
                                                "text": "With 109km of fixed infrastructure, of which only 50% is utilised, Perry's message is simple: \"put more bloody trains on it!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb2f7b00-4e9b-3aea-bdee-25a6903af503",
                                        "entry_id": "8d47f1ec-c231-3092-a215-e71146f96071",
                                        "glosses": [
                                            "Badly behaved; unpleasant; beastly."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098a1735-fb21-420d-b11b-e08d00f99c01",
                                                "sense_id": "bb2f7b00-4e9b-3aea-bdee-25a6903af503",
                                                "text": "Come to apologize to Charles. I was bloody to him and he's my guest. He's my guest and my only friend and I was bloody to him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bloody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12291609-de4a-3841-9b94-abe81288e272",
                                        "entry_id": "fa34c1f2-f219-3358-b219-c68b9b7dee44",
                                        "glosses": [
                                            "Used to express anger, annoyance, or shock, or for emphasis."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "India",
                                            "Ireland",
                                            "New-Zealand",
                                            "Newfoundland",
                                            "South-Africa",
                                            "informal",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf9462a8-f50e-4ccf-a4a2-897d9c4cd9b2",
                                                "sense_id": "12291609-de4a-3841-9b94-abe81288e272",
                                                "text": "Walk! Not bloody likely. [Sensation]. I am going in a taxi. [She goes out]."
                                            },
                                            {
                                                "example_id": "4b2f273e-d543-4a9f-800d-253f9ec84c73",
                                                "sense_id": "12291609-de4a-3841-9b94-abe81288e272",
                                                "text": "\"Dice are no bloody good,\" David said."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bloody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74b69622-fab2-31d0-8c4b-3ca63382c1c7",
                                        "entry_id": "80290b51-b951-3bf6-a6c9-fe90d4cbe1f1",
                                        "glosses": [
