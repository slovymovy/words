                                        "sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                                        "entry_id": "5681210c-8548-30dd-bbad-865447f4b426",
                                        "glosses": [
                                            "A conventionally defined time interval in a schedule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356d0f26-2f89-4906-ab19-78eb9386fb9a",
                                                "sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                                                "text": "Prime-time television has two- to four-hour-long timeslots."
                                            },
                                            {
                                                "example_id": "8e5120bb-35c0-45c2-a5a9-2c2af73fb5c1",
                                                "sense_id": "094ca95f-0df1-33b8-9567-a4389586d256",
                                                "text": "At the peak of its success, the show drew 3.9 million viewers per week to its Sunday night timeslot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
