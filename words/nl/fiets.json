                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het weekend toert hij graag op zijn zware <w>fiets</w> door de heuvels.",
                            "target_lang_translations": {
                                "en": "On weekends he likes to tour the hills on his heavy <w>bike</w>.",
                                "ru": "По выходным он любит кататься по холмам на своем тяжелом <w>байке</w>.",
                                "pl": "W weekendy chętnie jeździ po wzgórzach na swoim ciężkim <w>motorze</w>.",
                                "de": "Am Wochenende tourt er gerne auf seinem schweren <w>Motorrad</w> durch die Hügel.",
                                "fr": "Le week-end, il aime parcourir les collines sur sa grosse <w>bécane</w>.",
                                "it": "Nel fine settimana gli piace fare un giro tra le colline sulla sua <w>moto</w> pesante.",
                                "cs": "O víkendech se rád projíždí po kopcích na své těžké <w>motorce</w>.",
                                "tr": "Hafta sonları ağır <w>motoruyla</w> tepelerde gezmeyi sever.",
                                "es": "Los fines de semana le gusta recorrer las colinas en su <w>moto</w> pesada."
                            }
                        },
                        {
                            "text": "Wat een snelle <w>fiets</w> heb jij gekocht!",
                            "target_lang_translations": {
                                "en": "What a fast <w>bike</w> you bought!",
                                "ru": "Какой быстрый <w>байк</w> ты купил!",
                                "pl": "Ale szybki <w>motor</w> kupiłeś!",
                                "de": "Was für ein schnelles <w>Bike</w> hast du dir gekauft!",
                                "fr": "Quelle <w>moto</w> rapide tu as achetée !",
                                "it": "Che <w>moto</w> veloce che hai comprato!",
                                "cs": "Tedy, ty jsi koupil ale rychlou <w>mašinu</w>!",
                                "tr": "Ne kadar hızlı bir <w>motor</w> satın almışsın!",
                                "es": "¡Qué <w>moto</w> tan rápida te has comprado!"
