                                        "glosses": [
                                            "in great abundance, very abundant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6cfe15-9226-4323-8ae4-8fb8bfa74e0d",
                                                "sense_id": "1b17aea1-d575-34da-97e4-066f69bb7916",
                                                "text": "On Chicago Trio, New York Tenor, released this month on the Italian label Soul Note, his trio features two fellow fellow Chicagoans--Larry Kohut on bass, a steadying influence even during his sudden shifts to double time, and cornucopian pianist Jim Trompeter--and collectively it has the flexibility and tensile strength of metal mesh."
                                            },
                                            {
                                                "example_id": "e8ce69b9-54f5-4f1b-b243-06f2c84c8867",
                                                "sense_id": "1b17aea1-d575-34da-97e4-066f69bb7916",
                                                "text": "In response, many researchers at the cutting edge of dealing with matter on the near-atomic scale have become aggressively matter- of-fact, squirming at the suggestion of cornucopian nanofactories or even humbler mass-produced nanodevices."
                                            },
                                            {
                                                "example_id": "f5941f66-d585-418c-97d3-6aa391815d43",
                                                "sense_id": "1b17aea1-d575-34da-97e4-066f69bb7916",
                                                "text": "The full mystic vision of Kali includes birth as well as death, the cornucopian vagina as well as the hungry mouth."
                                            },
                                            {
                                                "example_id": "875c2d73-15c3-446a-bc55-ed4d6af09c23",
                                                "sense_id": "1b17aea1-d575-34da-97e4-066f69bb7916",
                                                "text": "With cornucopian Fire thou giv'st me strength, Caresses and golden hours and grace of sleep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
