                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fe409bab-aa1c-41c0-9079-2297adef0860",
                        "entry_id": "0e98e9ff-cd8b-3825-8741-16a558a58db0",
                        "tags": [
                            "plural"
