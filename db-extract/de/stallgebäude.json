                    {
                        "sense_id": "b02f75ed-23bf-3189-9cda-ca695b598d0d",
                        "entry_id": "ea156ecc-3079-309f-82f0-2971c5e9bc85",
                        "glosses": [
                            "Gebäude/Gebäudeteil in einem Anwesen, in dem sich ein Stall befindet (oder auch mehrere Ställe)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f85a43-9fef-47f1-bae5-136be94e0540",
                                "sense_id": "b02f75ed-23bf-3189-9cda-ca695b598d0d",
                                "text": "„Rechtwinklig vor dem Stallgebäude gegenüber dem Bauernhof, am Berghang entlang, befanden sich die klösterlichen Wirtschaftsgebäude, die Schlosserei, die Brauerei und die Wagnerei, sie bildeten den länglichen Innenhof.“"
                            },
                            {
                                "example_id": "6ac3f33a-034e-460b-a1ca-bb24ee587247",
                                "sense_id": "b02f75ed-23bf-3189-9cda-ca695b598d0d",
                                "text": "„Es gab zwei Wohnhäuser – das neue und das alte Haus – und zwei Stallgebäude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
