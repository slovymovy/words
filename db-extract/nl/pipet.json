                                    {
                                        "sense_id": "0038aadd-680e-3b0b-925c-be4fcb777c1c",
                                        "entry_id": "052e800e-7be3-3f9f-82b3-c46304dd52ba",
                                        "glosses": [
                                            "Petit tube servant à prélever une petite quantité de liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e2165e-3c00-4357-aed3-de283e340d3c",
                                                "sense_id": "0038aadd-680e-3b0b-925c-be4fcb777c1c",
                                                "text": "Il est commode de se servir d'une pipette jaugeuse pour le mesurage rapide des 90ᶜᵐ³ d'eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f92c64d-e4c7-360f-9bf0-1f72296713dc",
                                        "entry_id": "052e800e-7be3-3f9f-82b3-c46304dd52ba",
                                        "glosses": [
                                            "Petite pipe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a97bceb-5942-4103-9cb8-9272401f9974",
                                                "sense_id": "1f92c64d-e4c7-360f-9bf0-1f72296713dc",
                                                "text": "Son chapeau de castor, rabattu devant ses yeux, le séparait du paysage ; il fumait une pipette de genièvre et abandonnait ses pensées à leur mouvement naturel."
                                            },
                                            {
                                                "example_id": "9b7b7a9b-b86f-4463-b58e-015b92a90dee",
                                                "sense_id": "1f92c64d-e4c7-360f-9bf0-1f72296713dc",
                                                "text": "Alphonse Daudet secoua sa pipette blanche émaillée, legs de Flaubert, maître lui-même du pauvre Guy : « Le fait est que son silence avait l’air traversé de visions sinistres… Brr !... Allons, Pugno, un peu de piano, je ne veux pas aller me coucher sur cette impression-là. »\nNous ne devions plus revoir Maupassant."
                                            }
                                        ]
                                    }
