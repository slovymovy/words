                            {
                                "target_word": "typhoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fcda36f-79de-3a48-b675-fad2ab908709",
                                        "entry_id": "96050fcb-e299-31be-b352-7b5f9390099d",
                                        "glosses": [
                                            "Ellipsis of typhoid fever."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb141ab-51e5-4d82-9a18-b9fff2ca25f7",
                                                "sense_id": "6fcda36f-79de-3a48-b675-fad2ab908709",
                                                "text": "Typhoid may not worry people as it once did, but it still affects more than 20 million people a year around the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "5d188d79-86a5-3a78-88e7-7de9811410bc",
                "word": "typhoïde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "766d7dcb-ff0f-4d03-bb7c-a3034ff05217",
                        "entry_id": "5d188d79-86a5-3a78-88e7-7de9811410bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "typhoïdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04901845-a797-399a-8507-3e4b61ad5d98",
                        "entry_id": "5d188d79-86a5-3a78-88e7-7de9811410bc",
                        "glosses": [
                            "Fièvre typhoïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b45977b2-14d9-46b8-b2d1-34a8a19569e4",
                                "sense_id": "04901845-a797-399a-8507-3e4b61ad5d98",
                                "text": "Une autre fois, mon père entrait dans ma chambre, avec une dépêche et disait, presque railleur : — Eh ! eh ! ils vont bien à La Châtre. Tes deux tantes Picard sont mortes de la typhoïde."
                            },
                            {
                                "example_id": "6ed3e8b3-d3a0-4be9-9760-d0bc0d933884",
                                "sense_id": "04901845-a797-399a-8507-3e4b61ad5d98",
                                "text": "« Dites bien à tout le monde, docteur, que Marie est morte de la typhoïde. À cause de mes deux pauvres frères, on fait courir le bruit que c’est la phtisie qui l’a emportée. »"
                            },
                            {
                                "example_id": "87a32460-a6f6-4ec3-aeef-c064d213819e",
                                "sense_id": "04901845-a797-399a-8507-3e4b61ad5d98",
                                "text": "Soudain une épidémie de typhoïde ravagea le village. Coup sur coup, les morts s’amoncelaient."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
