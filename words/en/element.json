{
    "word_family": [
        "elemental",
        "elementary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a485ba65-dcee-31b6-9e43-7434c8a6cc27",
                    "sense_definition": "An essential or characteristic part of something abstract.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "part_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Honesty is a vital <w>element</w> of any healthy friendship.",
                            "target_lang_translations": {
                                "ru": "Честность — жизненно важный <w>элемент</w> любой здоровой дружбы.",
                                "zh": "诚实是任何健康友谊中至关重要的<w>要素</w>。"
                            }
                        },
                        {
                            "text": "The movie combines the <w>elements</w> of comedy and tragedy perfectly.",
                            "target_lang_translations": {
                                "ru": "Фильм идеально сочетает в себе <w>элементы</w> комедии и трагедии.",
                                "zh": "这部电影完美地结合了喜剧和悲剧的<w>成分</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "key element",
                        "essential element",
                        "basic element"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существенная или характерная часть чего-либо абстрактного.",
                        "zh": "构成抽象事物的基本或特征部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "составная часть"
                            },
                            {
                                "target_lang_word": "составная часть",
                                "target_lang_sense_clarification": "компонент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要素",
                                "target_lang_sense_clarification": "构成事物的基本成分"
                            },
                            {
                                "target_lang_word": "成分",
                                "target_lang_sense_clarification": "构成整体的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60dcf5df-c0c4-31b1-8fb5-1811b439c5c6",
                    "sense_definition": "A simple chemical substance that consists of atoms of only one type and cannot be broken down into simpler substances.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "matter_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oxygen is the most common <w>element</w> in the Earth's crust.",
                            "target_lang_translations": {
                                "ru": "Кислород — самый распространенный <w>элемент</w> в земной коре.",
                                "zh": "氧是地壳中最常见的<w>元素</w>。"
                            }
                        },
                        {
                            "text": "Gold is a chemical <w>element</w> with the symbol Au.",
                            "target_lang_translations": {
                                "ru": "Золото — это химический <w>элемент</w> с символом Au.",
                                "zh": "金是一种化学<w>元素</w>，符号为Au。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chemical element",
                        "elementary substance"
                    ],
                    "antonyms": [
                        "compound"
                    ],
                    "common_phrases": [
                        "trace element"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простое химическое вещество, состоящее из атомов только одного типа.",
                        "zh": "一种简单的化学物质，仅由一种原子组成，无法分解为更简单的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "химия"
                            },
                            {
                                "target_lang_word": "химический элемент",
                                "target_lang_sense_clarification": "полный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "元素",
                                "target_lang_sense_clarification": "化学元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7bae81f-f735-3554-988e-219366b4fca0",
                    "sense_definition": "The weather, especially strong winds and heavy rain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The homeless man had to sleep outside, exposed to the <w>elements</w>.",
                            "target_lang_translations": {
                                "ru": "Бездомному пришлось спать на улице, открытому всем <w>стихиям</w>.",
                                "zh": "那个无家可归的人不得不睡在外面，忍受着<w>风雨</w>。"
                            }
                        },
                        {
                            "text": "We braved the <w>elements</w> to go for a walk along the stormy coast.",
                            "target_lang_translations": {
                                "ru": "Мы бросили вызов <w>стихии</w>, чтобы прогуляться по штормовому побережью.",
                                "zh": "我们冒着<w>风雨</w>沿着风暴肆虐的海岸散步。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brave the elements",
                        "exposed to the elements",
                        "battle the elements"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Погода, особенно сильный ветер и проливной дождь; силы природы.",
                        "zh": "指天气，尤指强风和大雨等自然力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стихия",
                                "target_lang_sense_clarification": "силы природы"
                            },
                            {
                                "target_lang_word": "непогода",
                                "target_lang_sense_clarification": "плохая погода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风雨",
                                "target_lang_sense_clarification": "恶劣天气"
                            },
                            {
                                "target_lang_word": "自然力",
                                "target_lang_sense_clarification": "大自然的力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62ae43ca-41e9-392a-9da3-11a895f5b6cb",
                    "sense_definition": "A small but distinct amount of a particular quality or feeling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "part_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is an <w>element</w> of truth in what she says.",
                            "target_lang_translations": {
                                "ru": "В том, что она говорит, есть <w>доля</w> правды.",
                                "zh": "她说的话里有<w>一点</w>真实性。"
                            }
                        },
                        {
                            "text": "We need to remove any <w>element</w> of doubt from the decision.",
                            "target_lang_translations": {
                                "ru": "Нам нужно устранить любой <w>элемент</w> сомнения из этого решения.",
                                "zh": "我们需要消除决策中任何怀疑的<w>成分</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "element of truth",
                        "element of doubt",
                        "element of surprise",
                        "element of risk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое, но отчетливое количество определенного качества или чувства.",
                        "zh": "某种品质或感觉的微小但明显的成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть, процент"
                            },
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "составляющая"
                            },
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "малая часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成分",
                                "target_lang_sense_clarification": "某种因素"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "少许"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02ab58ca-ccf2-3de5-839e-609dee3b3d22",
                    "sense_definition": "A situation or environment where a person feels comfortable, confident, and successful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is in her <w>element</w> when she is organizing large parties.",
                            "target_lang_translations": {
                                "ru": "Она в своей <w>стихии</w>, когда организует большие вечеринки.",
                                "zh": "她在组织大型派对时总是<w>如鱼得水</w>。"
                            }
                        },
                        {
                            "text": "He felt completely out of his <w>element</w> discussing complex politics.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя совершенно не в своей <w>стихии</w>, обсуждая сложную политику.",
                                "zh": "在讨论复杂的政治问题时，他感到完全不在状态。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in one's element",
                        "out of one's element"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обстановка или среда, где человек чувствует себя комфортно и уверенно.",
                        "zh": "一个人感到舒适、自信和成功的环境或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стихия",
                                "target_lang_sense_clarification": "привычная среда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "如鱼得水",
                                "target_lang_sense_clarification": "形容处于最适宜的环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1713608a-c6e8-3da1-a381-901ea998e96f",
                    "sense_definition": "The basic principles or beginning stages of a subject of study.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The course teaches the <w>elements</w> of computer programming to beginners.",
                            "target_lang_translations": {
                                "ru": "Курс обучает новичков <w>основам</w> компьютерного программирования.",
                                "zh": "这门课程向初学者教授计算机编程的<w>基础</w>。"
                            }
                        },
                        {
                            "text": "He has mastered the <w>elements</w> of French grammar.",
                            "target_lang_translations": {
                                "ru": "Он освоил <w>азы</w> французской грамматики.",
                                "zh": "他已经掌握了法语语法的<w>入门</w>知识。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elements of style",
                        "elements of design"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основные принципы или начальные этапы изучения предмета.",
                        "zh": "学科的基本原则或入门阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основы",
                                "target_lang_sense_clarification": "базовые принципы"
                            },
                            {
                                "target_lang_word": "азы",
                                "target_lang_sense_clarification": "начала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基础",
                                "target_lang_sense_clarification": "基本原理"
                            },
                            {
                                "target_lang_word": "入门",
                                "target_lang_sense_clarification": "初步知识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba86a59b-93c0-3568-84bb-126b55ff9c4c",
                    "sense_definition": "The part of an electrical device, such as a kettle or heater, that produces heat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heating <w>element</w> in the toaster needs to be replaced.",
                            "target_lang_translations": {
                                "ru": "Нагревательный <w>элемент</w> в тостере необходимо заменить.",
                                "zh": "烤面包机里的<w>发热管</w>需要更换。"
                            }
                        },
                        {
                            "text": "Water covers the <w>element</w> inside the kettle to prevent it from burning out.",
                            "target_lang_translations": {
                                "ru": "Вода покрывает <w>элемент</w> внутри чайника, чтобы предотвратить его перегорание.",
                                "zh": "水覆盖着水壶里的<w>加热元件</w>，以防其烧坏。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heating element"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть электрического прибора, вырабатывающая тепло.",
                        "zh": "电器中产生热量的部件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "деталь прибора"
                            },
                            {
                                "target_lang_word": "нагревательный элемент",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发热管",
                                "target_lang_sense_clarification": "加热元件"
                            },
                            {
                                "target_lang_word": "加热元件",
                                "target_lang_sense_clarification": "技术术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36245a4e-98d8-3830-bbc2-2611b0f23e34",
                    "sense_definition": "An individual object or member that belongs to a set.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If A is a set, then x is an <w>element</w> of A.",
                            "target_lang_translations": {
                                "ru": "Если A — это множество, то x — <w>элемент</w> A.",
                                "zh": "如果A是一个集合，那么x就是A的一个<w>元素</w>。"
                            }
                        },
                        {
                            "text": "The set contains five distinct <w>elements</w>.",
                            "target_lang_translations": {
                                "ru": "Множество содержит пять различных <w>элементов</w>.",
                                "zh": "该集合包含五个不同的<w>元素</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "member"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный объект или член, принадлежащий множеству.",
                        "zh": "属于集合的单个对象或成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "математика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "元素",
                                "target_lang_sense_clarification": "数学集合中的成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1dfb913-3d82-31c2-a012-75105b9c3b87",
                    "sense_definition": "A distinct part of a document or code in a markup language, usually defined by tags.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The div <w>element</w> is used to group content in HTML.",
                            "target_lang_translations": {
                                "ru": "<w>Элемент</w> div используется для группировки контента в HTML.",
                                "zh": "div<w>元素</w>用于在HTML中对内容进行分组。"
                            }
                        },
                        {
                            "text": "You can style each <w>element</w> differently using CSS.",
                            "target_lang_translations": {
                                "ru": "Вы можете стилизовать каждый <w>элемент</w> по-разному с помощью CSS.",
                                "zh": "你可以使用CSS为每个<w>元素</w>设置不同的样式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "HTML element",
                        "block element"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная часть документа или кода в языке разметки, обычно определяемая тегами.",
                        "zh": "标记语言中由标签定义的文档或代码的独立部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "元素",
                                "target_lang_sense_clarification": "计算机编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1561d2-07b6-3924-b003-cfa6c513a634",
                    "sense_definition": "One of the four substances (earth, air, fire, and water) formerly believed to compose the physical universe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "matter_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient Greeks believed that everything was made of four <w>elements</w>: earth, air, fire, and water.",
                            "target_lang_translations": {
                                "ru": "Древние греки верили, что все состоит из четырех <w>стихий</w>: земли, воздуха, огня и воды.",
                                "zh": "古希腊人认为万物由四种<w>元素</w>组成：土、气、火和水。"
                            }
                        },
                        {
                            "text": "Fire is considered the most volatile of the four <w>elements</w>.",
                            "target_lang_translations": {
                                "ru": "Огонь считается самой нестабильной из четырех <w>стихий</w>.",
                                "zh": "火被认为是四种<w>元素</w>中最不稳定的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "four elements"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical philosophy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно из четырех веществ (земля, воздух, огонь и вода), из которых, как считалось ранее, состоит физическая вселенная.",
                        "zh": "古人认为构成物理宇宙的四种物质（地、气、火、水）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стихия",
                                "target_lang_sense_clarification": "сила природы"
                            },
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "первовещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "元素",
                                "target_lang_sense_clarification": "古代哲学中的基本物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c138868-2ad8-35a0-910c-65c045546d59",
                    "sense_definition": "A distinct group of people within a larger society or organization, often viewed negatively.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are cracking down on the criminal <w>element</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Полиция принимает жесткие меры против криминального <w>элемента</w> в городе.",
                                "zh": "警方正在严厉打击城里的犯罪<w>分子</w>。"
                            }
                        },
                        {
                            "text": "There is a disruptive <w>element</w> in the class that affects everyone's learning.",
                            "target_lang_translations": {
                                "ru": "В классе есть деструктивный <w>элемент</w>, который влияет на обучение всех остальных.",
                                "zh": "班里有一个破坏性的<w>分子</w>，影响了所有人的学习。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "criminal element",
                        "radical element",
                        "unruly element"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная группа людей внутри большего общества, часто воспринимаемая негативно.",
                        "zh": "社会或组织中一个独特的群体，通常带有负面含义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "элемент",
                                "target_lang_sense_clarification": "группа людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分子",
                                "target_lang_sense_clarification": "指特定群体的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}