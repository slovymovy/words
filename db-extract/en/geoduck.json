                "senses": [
                    {
                        "sense_id": "e7c6e016-2ad6-39b3-8a22-78cad9f14b8a",
                        "entry_id": "c6989b56-8c3e-35f3-b0e0-11a593282cd4",
                        "glosses": [
                            "The species of large saltwater clam Panopea generosa, native to the northeast Pacific coasts from Alaska to Washington State, distinguished by its deep burrowing and long unprotected siphon."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "76ce2395-1a48-477f-9756-f5d18ede3631",
                                "sense_id": "e7c6e016-2ad6-39b3-8a22-78cad9f14b8a",
                                "text": "Glycimeris generosa. Olympia, Washington Territory... The boys at Olympia call them ‘Geoducks’; they dig them on a certain sand bar at extreme low tide, and sell them to a merchant who ships them to Portland, Oreg... The boys inform me that the Indians on the Sound... dry them for food with the other clams."
                            },
                            {
                                "example_id": "4a6c34ba-0247-4792-837f-bee6db35d762",
                                "sense_id": "e7c6e016-2ad6-39b3-8a22-78cad9f14b8a",
                                "text": "I survey the ice-lined crates containing sea snails, rock cod, sea urchin and a Vancouver favorite, geoduck (pronounced gooey-duck)—a giant clam."
                            }
                        ]
                    },
                    {
                        "sense_id": "2248cb4e-b482-301c-9f24-bd8575911132",
                        "entry_id": "c6989b56-8c3e-35f3-b0e0-11a593282cd4",
                        "glosses": [
                            "The species of large saltwater clam Panopea generosa, native to the northeast Pacific coasts from Alaska to Washington State, distinguished by its deep burrowing and long unprotected siphon.",
                            "its flesh as a seafood."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "92b14aa1-7a2f-3b89-86cc-5215ae3d1404",
                        "entry_id": "c6989b56-8c3e-35f3-b0e0-11a593282cd4",
                        "glosses": [
                            "Other species of Panopea, especially Panopea zelandica, native to the coasts of New Zealand."
                        ],
                        "tags": [
                            "New-Zealand",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0d5a10bd-f6dd-4a35-8372-96f27047f731",
                                "sense_id": "92b14aa1-7a2f-3b89-86cc-5215ae3d1404",
                                "text": "Alick Shaw... uses up to 14 kilograms of geoduck in chowder weekly..."
                            }
                        ]
