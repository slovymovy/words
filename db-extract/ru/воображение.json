                ],
                "senses": [
                    {
                        "sense_id": "1661be56-c67f-34c8-96a6-6cc1a11935e1",
                        "entry_id": "5fa955d7-7522-39dd-af96-3ffa28247ee0",
                        "glosses": [
                            "imagination, fancy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a8e651-14fc-4702-8d9e-8dea47d8da01",
                                "sense_id": "1661be56-c67f-34c8-96a6-6cc1a11935e1",
                                "text": "Как всегда́ быва́ет в да́льней доро́ге, на пе́рвых двух-трёх ста́нциях воображе́ние остаё́тся в том ме́сте, отку́да е́дешь, и пото́м вдруг, с пе́рвым у́тром, встре́ченным в доро́ге, перено́сится к це́ли путеше́ствия и там уже́ стро́ит за́мки бу́дущего.",
                                "translation": "It is always the case on a long journey that till the first two or three stages have been passed imagination continues to dwell on the place left behind, but with the first morning on the road it leaps to the end of the journey and there begins building castles in the air.",
                                "english": "It is always the case on a long journey that till the first two or three stages have been passed imagination continues to dwell on the place left behind, but with the first morning on the road it leaps to the end of the journey and there begins building castles in the air."
                            }
                        ]
                    }
                ],
                "translations": [],
