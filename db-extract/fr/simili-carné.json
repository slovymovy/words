                "senses": [
                    {
                        "sense_id": "9d204bf8-7b3c-3a77-b126-075a59389f73",
                        "entry_id": "77d906c2-13e5-3ba3-bf1c-e671707931c4",
                        "glosses": [
                            "Dont les qualités esthétiques (principalement la texture, la flaveur et l’apparence) imitent un produit d’origine animale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0682f26-0ce1-494d-957d-54c112f2f2a6",
                                "sense_id": "9d204bf8-7b3c-3a77-b126-075a59389f73",
                                "text": "Le soja est très probablement l’aliment qui a le plus popularisé la cuisine simili-carnée. Réalisé à partir de lait de soja caillé, le tofu ressemble à une pâte blanche."
                            },
                            {
                                "example_id": "b8b55cee-54f7-4d0b-8bdf-34cf8fbe84a8",
                                "sense_id": "9d204bf8-7b3c-3a77-b126-075a59389f73",
                                "text": "Nous étions chez un ami au Pays-Bas, qui nous a fait manger ce que nous croyions être de la viande (Isabelle n’avait pas refusé par politesse) mais qui était en fait des produits simili-carnés."
                            }
                        ]
                    }
                ],
