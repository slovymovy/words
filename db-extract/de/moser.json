                ],
                "senses": [
                    {
                        "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                        "entry_id": "9011d0cb-824b-34be-810f-8a95c6119316",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6e39f9f-88e2-44c1-993f-8977d529ecd2",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Bernd Moser, 38, arbeitet für das Deutsche Rote Kreuz und ist in Baden-Württemberg zuständig für die Unterbringung von Flüchtlingen."
                            },
                            {
                                "example_id": "0a0c15b8-5d7b-4703-aa58-baa51cc91f72",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Hans Moser, 81, wird im September von der Stadt Wien für die beste schauspielerische Leistung der Saison mit der \"Josef-Kainz-Medaille\" dekoriert werden."
                            },
                            {
                                "example_id": "119f0f9e-af3b-47b4-b619-97c6c735760a",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Frau Moser ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "06df7d81-3b3c-484d-9236-040a25667480",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Herr Moser wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "24d46a30-afe9-4db9-afcf-6acc0fa5e538",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Die Mosers fahren heute in die Wachau."
                            },
                            {
                                "example_id": "cc1dbe34-38c9-40a6-a8c3-ffff2103e3d8",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Der Moser trägt nie die Schals, die die Moser ihm strickt."
                            },
                            {
                                "example_id": "900327e9-eb89-49e0-93c3-2d44578b27bf",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Moser kommt, geht der Herr Moser.“"
                            },
                            {
                                "example_id": "7bfd4213-d994-434d-8f3b-203508c2179d",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Moser kommt und geht."
                            },
                            {
                                "example_id": "f36e61b1-f5e0-42cc-b9ca-9cf96d56bc14",
                                "sense_id": "ba03d8c6-a44c-3213-8b5e-2c89d3be2c75",
                                "text": "Mosers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
