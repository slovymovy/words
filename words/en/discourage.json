{
    "word_family": [
        "discouragement",
        "discouraging",
        "discouraged",
        "courage",
        "encourage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e4af727-bda9-3328-8505-220df004e9f0",
                    "sense_definition": "To persuade someone not to do something or to prevent something from happening by making it seem difficult or unpleasant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deterrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high cost of the tickets will <w>discourage</w> many people from attending the concert.",
                            "target_lang_translations": {
                                "ru": "Высокая стоимость билетов <w>отпугнет</w> многих людей от посещения концерта."
                            }
                        },
                        {
                            "text": "We should <w>discourage</w> smoking in public places to protect the health of others.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>препятствовать</w> курению в общественных местах, чтобы защитить здоровье окружающих."
                            }
                        }
                    ],
                    "synonyms": [
                        "deter",
                        "dissuade"
                    ],
                    "antonyms": [
                        "encourage"
                    ],
                    "common_phrases": [
                        "discourage smoking",
                        "discourage bad behavior",
                        "discourage investment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убеждать кого-либо не делать чего-либо или предотвращать событие, делая его трудным или неприятным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отговаривать",
                                "target_lang_sense_clarification": "пытаться убедить не совершать действие"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать помехи для совершения чего-либо"
                            },
                            {
                                "target_lang_word": "отбивать охоту",
                                "target_lang_sense_clarification": "лишать желания что-либо делать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef21148a-0e84-32a6-acab-1f6f216e9293",
                    "sense_definition": "To cause someone to lose confidence, enthusiasm, or hope.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dishearten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't let one small failure <w>discourage</w> you from trying again.",
                            "target_lang_translations": {
                                "ru": "Не позволяйте одной маленькой неудаче <w>обескуражить</w> вас и помешать попробовать снова."
                            }
                        },
                        {
                            "text": "The coach tried not to <w>discourage</w> the team after their difficult loss.",
                            "target_lang_translations": {
                                "ru": "Тренер старался не <w>расхолаживать</w> команду после тяжелого поражения."
                            }
                        }
                    ],
                    "synonyms": [
                        "daunt"
                    ],
                    "antonyms": [
                        "encourage"
                    ],
                    "common_phrases": [
                        "easily discouraged",
                        "discourage the team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо терять уверенность, энтузиазм или надежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "лишать уверенности или приводить в замешательство"
                            },
                            {
                                "target_lang_word": "расхолаживать",
                                "target_lang_sense_clarification": "лишать интереса или энтузиазма"
                            },
                            {
                                "target_lang_word": "угнетать",
                                "target_lang_sense_clarification": "лишать надежды и бодрости духа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7991a1db-aa6a-3ed3-bc20-1ae673bd4685",
                    "sense_definition": "A state of lacking courage or being disheartened.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lack of courage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a moment of deep <w>discourage</w>, he considered giving up on his lifelong dream.",
                            "target_lang_translations": {
                                "ru": "В момент глубокого <w>уныния</w> он подумывал о том, чтобы отказаться от своей давней мечты."
                            }
                        },
                        {
                            "text": "The general noted the <w>discourage</w> among the troops after the long winter.",
                            "target_lang_translations": {
                                "ru": "Генерал отметил <w>упадок духа</w> среди войск после долгой зимы."
                            }
                        }
                    ],
                    "synonyms": [
                        "cowardliness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние отсутствия мужества или уныния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уныние",
                                "target_lang_sense_clarification": "состояние подавленности и отсутствия духа"
                            },
                            {
                                "target_lang_word": "малодушие",
                                "target_lang_sense_clarification": "отсутствие твердости духа и мужества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}