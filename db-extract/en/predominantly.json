                    },
                    {
                        "translation_id": "3b0893ba-4c14-43b4-9b47-8128ebb00f06",
                        "source_entry_id": "12852ca7-a046-3253-b9e5-70508fa17037",
                        "source_sense_id": "69dc8656-2626-37f1-b1bb-5a579fd6e181",
