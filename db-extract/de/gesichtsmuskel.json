                "senses": [
                    {
                        "sense_id": "63d3d10f-c6bb-3666-97a8-3ea5490b4e3d",
                        "entry_id": "6564d0f1-3d99-3866-93dc-5866675d2574",
                        "glosses": [
                            "Muskel, der zusammen mit anderen an der Beweglichkeit des Gesichts beteiligt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db07960-63e5-40f2-8732-3cf043483f75",
                                "sense_id": "63d3d10f-c6bb-3666-97a8-3ea5490b4e3d",
                                "text": "„Und jetzt lächelte Papin zum erstenmal ausdauernd, für seine untrainierten Gesichtsmuskeln wohnt ungewöhnlich lange das Lächeln in seinem Gesicht.“"
                            },
                            {
                                "example_id": "66826278-48a2-4bf0-bb2f-5dc05939b384",
                                "sense_id": "63d3d10f-c6bb-3666-97a8-3ea5490b4e3d",
                                "text": "„Als er eintrat, lag der Gliedermann auf der Seite, und da die Gesichtsmuskeln abgenommen waren, quoll das Auge ungeheuer heraus und flößte Entsetzen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
