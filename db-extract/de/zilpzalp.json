                                    {
                                        "sense_id": "4f1d73c5-759f-3007-b839-4fc201b3e639",
                                        "entry_id": "adf9b2ca-94f6-35db-ac2b-89237a1114b0",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau, pouillot de l’Ancien Monde brun-verdâtre dessus et blanc cassé dessous, aux pattes foncées, au chant répétitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6125f2fe-41f3-4c9b-86a3-55263145b892",
                                                "sense_id": "4f1d73c5-759f-3007-b839-4fc201b3e639",
                                                "text": "Le pouillot véloce est rarement visible."
                                            },
                                            {
                                                "example_id": "e6021cc0-fc3f-4fe7-98df-0dfd8e0f3e78",
                                                "sense_id": "4f1d73c5-759f-3007-b839-4fc201b3e639",
                                                "text": "Comme si tous les coucous, sitelles, tourterelles des bois et pouillots véloces s’étaient donné rendez-vous sous les branches pour se relayer dans un bavardage de pipelettes."
                                            },
                                            {
                                                "example_id": "1e608566-071e-4d6d-92c3-cb540d48cc33",
                                                "sense_id": "4f1d73c5-759f-3007-b839-4fc201b3e639",
                                                "text": "En abordant la forêt, Joseph et Thélise ont été accueillis par le « tsip-stap » du pouillot véloce, qui joue un peu le rôle de guetteur pour la gent ailée."
                                            }
                                        ]
                                    }
                                ]
                            }
