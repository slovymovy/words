                    {
                        "translation_id": "99a6f471-5e0c-4806-988d-92346a88b13e",
                        "source_entry_id": "c4b5380b-9113-3e70-8e9e-860037f0f8e7",
                        "source_sense_id": "10d334a5-1278-3757-9dc4-9e6c58db2e91",
                        "source_sense_description": "etwas, worüber jedes Mitglied in einer Gemeinschaft verfügen kann",
                        "target_lang_word": "bien commun",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bien commun",
