{
    "word_family": [
        "outspeak"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28b86cfa-0c6c-3e8b-b6db-fce78ff68c06",
                    "sense_definition": "Expressing opinions freely, openly, or boldly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>outspoken</w> critic of the new government policies.",
                            "target_lang_translations": {
                                "it": "Lei è una critica <w>schietta</w> delle nuove politiche governative."
                            }
                        },
                        {
                            "text": "He is known for being <w>outspoken</w> about his political beliefs during meetings.",
                            "target_lang_translations": {
                                "it": "È noto per essere <w>franco</w> riguardo alle sue convinzioni politiche durante le riunioni."
                            }
                        }
                    ],
                    "synonyms": [
                        "frank",
                        "candid",
                        "vocal",
                        "blunt"
                    ],
                    "antonyms": [
                        "reserved",
                        "reticent"
                    ],
                    "common_phrases": [
                        "outspoken critic"
                    ],
                    "target_lang_definitions": {
                        "it": "Che esprime le proprie opinioni in modo libero, aperto o audace."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "franco",
                                "target_lang_sense_clarification": "Persona che parla in modo diretto e senza giri di parole."
                            },
                            {
                                "target_lang_word": "sincero",
                                "target_lang_sense_clarification": "Persona che esprime i propri pensieri senza inganni o finzioni."
                            },
                            {
                                "target_lang_word": "schietto",
                                "target_lang_sense_clarification": "Persona che dice ciò che pensa in modo spontaneo e senza filtri."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4c77021-f6fb-3bac-a881-d9ff83a2395b",
                    "sense_definition": "The past participle of <w>outspeak</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness had <w>outspoken</w> the others in the heated debate.",
                            "target_lang_translations": {
                                "it": "Il testimone aveva <w>parlato con più audacia</w> degli altri nel acceso dibattito."
                            }
                        },
                        {
                            "text": "He felt he had been <w>outspoken</w> by his more confident colleague.",
                            "target_lang_translations": {
                                "it": "Sentiva di essere stato <w>messo in ombra dalla schiettezza</w> del suo collega più sicuro di sé."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb outspeak."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Il participio passato del verbo 'outspeak' (parlare più apertamente o con più audacia di qualcun altro)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "parlare con più audacia",
                                "target_lang_sense_clarification": "participio passato di outspeak: superare qualcuno nel parlare"
                            },
                            {
                                "target_lang_word": "mettere in ombra",
                                "target_lang_sense_clarification": "essere superato da chi parla con più franchezza"
                            }
