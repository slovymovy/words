                "senses": [
                    {
                        "sense_id": "fab23d81-d835-33b7-a2e3-50fc3b5746c9",
                        "entry_id": "4d44303f-a289-35b2-bc41-6d16071ce157",
                        "glosses": [
                            "Gerät, mit dem die Sonnen- und Himmelsstrahlung gemessen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33d0347-7619-42f3-92fa-8e9016f56272",
                                "sense_id": "fab23d81-d835-33b7-a2e3-50fc3b5746c9",
                                "text": "„Für die Beobachtung der Sonnenfinsternis wurde auf die Registrierung der Himmelstrahlung mit dem Solarimeter verzichtet und dafür Augenblicksablesungen mit dem Pyranometer Angström durchgeführt.“"
                            },
                            {
                                "example_id": "900f8914-deb2-407b-a45d-0bcc8628c2fe",
                                "sense_id": "fab23d81-d835-33b7-a2e3-50fc3b5746c9",
                                "text": "„Die aus den Robitzsch-Registrierungen erhaltenen Werte sind ausgezogen, die mit dem Solarimeter gewonnenen gestrichelt gezeichnet. Man sieht, daß die Werte des Solarimeters im Sommer um etwa 15 % höher liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
