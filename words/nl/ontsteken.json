            "senses": [
                {
                    "sense_id": "64438006-83b8-34e8-b586-ee5ac54c871f",
                    "sense_definition": "een lichtbron of apparaat aanzetten",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "licht_en_vuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra het donker werd, besloot hij de lampen te <w>ontsteken</w>.",
                            "target_lang_translations": {
                                "en": "As soon as it got dark, he decided to <w>light</w> the lamps."
                            }
                        },
                        {
                            "text": "Zij wilde de kaarsen <w>ontsteken</w> voor een gezellige sfeer in huis.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>light</w> the candles for a cozy atmosphere in the house."
                            }
