                                    },
                                    {
                                        "sense_id": "65bb03bd-7753-3e21-908e-b66dfbebb61b",
                                        "entry_id": "ecdbf60a-279b-3827-890a-0384dce247f3",
                                        "glosses": [
                                            "A hotel messenger, especially in France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccac3df1-98fa-44e3-b40b-f619dcf7ccd8",
                                                "sense_id": "65bb03bd-7753-3e21-908e-b66dfbebb61b",
                                                "text": "The chasseur of the Hôtel Récamier (whom he knew far too well) was approaching them at a run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8886fa04-b984-32c4-a5f7-fcfeaf6d6577",
                                        "entry_id": "ecdbf60a-279b-3827-890a-0384dce247f3",
                                        "glosses": [
                                            "A hunter or huntsman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47be318e-8f7b-3275-ab3f-09f53897db86",
                                        "entry_id": "ecdbf60a-279b-3827-890a-0384dce247f3",
                                        "glosses": [
                                            "A dish of meat cooked in a sauce containing mushrooms, shallots and white wine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b4decbc-9f53-4858-bff8-4a141c558448",
                                                "sense_id": "47be318e-8f7b-3275-ab3f-09f53897db86",
                                                "text": "From France, Greeley checks in with rabbit chausseurs made with red wine, shallots, tomatoes, and rosemary; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "038d5ebf-5a1a-4687-b274-5c9a508a954d",
                        "source_entry_id": "45d276ad-cb9f-33ca-ad9a-f6c1e0bd13c8",
                        "source_sense_id": "ab0abdd9-aaeb-34b3-9c15-31f359b64b3c",
                        "target_lang_word": "chasseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chasseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6092006f-dbd3-3a02-b293-544f0b9b33e5",
                                        "entry_id": "e8da7175-6374-3caf-a718-d68879e89bf0",
                                        "glosses": [
                                            "Qui chasse ; de la chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2db8ad1f-d125-43db-9136-fd4fc54b357a",
                                                "sense_id": "6092006f-dbd3-3a02-b293-544f0b9b33e5",
                                                "text": "Il est à observer qu’un peuple chasseur doit se répandre sur un vaste continent, beaucoup plus vite qu’un peuple cultivateur."
                                            },
                                            {
                                                "example_id": "5326c821-5637-4cf8-818e-72b419812af5",
                                                "sense_id": "6092006f-dbd3-3a02-b293-544f0b9b33e5",
                                                "text": "Car la région que nous traversons est assez giboyeuse, et les grands nemrods de la m’halla, […], qui ont emmené des meutes de lévriers et des faucons chasseurs, font des hécatombes de lièvres, de perdrix, de poules de Carthage, de renards et de chacals."
                                            },
                                            {
                                                "example_id": "feae76b1-15bc-458a-9d38-7dcd77ba9311",
                                                "sense_id": "6092006f-dbd3-3a02-b293-544f0b9b33e5",
                                                "text": "Je découvrais dans ces jeux Concha telle que je ne l’avais guère imaginée, non plus poursuivie mais poursuivante, non plus chassée mais chasseresse après une proie consentante bien qu’étourdie, et comme béate des attentions qu’on lui prodiguait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c816b4cc-eefc-3758-b452-a63fd42fea4d",
                                        "entry_id": "e8da7175-6374-3caf-a718-d68879e89bf0",
                                        "glosses": [
                                            "Qualifie une arme ou un système d’armes destiné à donner la chasse à une cible pour la détruire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bfa012a-4558-411f-a750-e81efbda9962",
                                                "sense_id": "c816b4cc-eefc-3758-b452-a63fd42fea4d",
                                                "text": "Un destroyer chasseur de sous-marins, un avion chasseur de sous-marins, un char chasseur de char…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d50b433-f635-3f79-b135-9a888169ec83",
                                        "entry_id": "e8da7175-6374-3caf-a718-d68879e89bf0",
                                        "glosses": [
                                            "Qualifie une personne ou un objet destiné à rechercher une personne ou un objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75db112-1026-4124-9dfe-2a7aa4798d9f",
                                                "sense_id": "1d50b433-f635-3f79-b135-9a888169ec83",
                                                "text": "Un satellite chasseur d’exoplanètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b122e18a-f6e2-3653-b168-d7804f089202",
                                        "entry_id": "e8da7175-6374-3caf-a718-d68879e89bf0",
                                        "glosses": [
                                            "Qualifie un plat ou une sauce à base de champignons et de vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9547bfb-2306-43e6-8ff7-91e94b946b62",
                                                "sense_id": "b122e18a-f6e2-3653-b168-d7804f089202",
                                                "text": "Ce lapin chasseur est vraiment délicieux."
                                            },
                                            {
                                                "example_id": "3967c43a-05d7-4f84-8855-ae0ce0267334",
                                                "sense_id": "b122e18a-f6e2-3653-b168-d7804f089202",
                                                "text": "Un civet de sanglier chasseur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa889ce9-3362-3882-b7ed-cb8e2cff120f",
                                        "entry_id": "e8da7175-6374-3caf-a718-d68879e89bf0",
                                        "glosses": [
                                            "Qui se prête à la chasse, giboyeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e4dc15-e616-4da3-96ec-e97c341749e7",
                                                "sense_id": "aa889ce9-3362-3882-b7ed-cb8e2cff120f",
                                                "text": "Cette fois, j’étais de la louée des foulaisons à Marigrate, un gros ménage sur les bords de Durance, une campagne avec des blés à perte de vue, des bois chasseurs, des vignes, tout le tremblement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chasseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                        "entry_id": "9ad50a7d-90b9-3418-89e5-5f2d568a27ef",
                                        "glosses": [
                                            "Celui qui pratique la chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df01e62b-3c14-4ade-aa24-9b0cf42fa165",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "Plus loin, une vision rapide de chevaux lancés à toute vitesse, de selles rouges et de vêtements blancs envolés dans un nuage de poussière : des chasseurs à la poursuite de quelque gibier, lièvre ou gazelle probablement."
                                            },
                                            {
                                                "example_id": "688c1104-c2a3-43a8-9d03-10826a017e8f",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "Rivaux comme tous bons chasseurs, c’était à qui raserait à l’autre le lièvre indiqué, et le roulé subissait naturellement les quolibets du vainqueur."
                                            },
                                            {
                                                "example_id": "38eaf2f2-2370-4f44-9e9d-6a574d724b72",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "Les chasseurs s’étaient précipités sur leurs fusils, mais je donnai l’ordre de les remettre au râtelier."
                                            },
                                            {
                                                "example_id": "1c79aef7-01b1-4e49-bd05-35f7542e1209",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "Une bécasse, c’est chère de prince; et c’était pour se la réserver que les chasseurs avaient obtenu l’arrêté de prohibition!"
                                            },
                                            {
                                                "example_id": "5e81ec70-d43b-49c3-8225-00e322a07e2e",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "Sa fille m’a dit qu’il aime mieux tirer sur les chasseurs que sur les oiseaux !\n– Je comprends ça, dit l’oncle sur un ton grave, je comprends ça : c’est plus facile. Parce qu’un chasseur c’est plus gros, et puis ça ne vole pas."
                                            },
                                            {
                                                "example_id": "2e02f302-7633-4da3-b361-7f415ec4e412",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "On avait mis sur le plateau improvisé des chasseurs et des antichasseurs, et les journalistes poussaient les uns et les autres au conflit. Ce que j’ai remarqué alors : l’agressivité n’était pas du côté des chasseurs."
                                            },
                                            {
                                                "example_id": "99685fb7-2215-454a-a20a-cac51053970c",
                                                "sense_id": "be176dfb-4326-3f51-ab64-29cacd2f10e8",
                                                "text": "Un article rapide relatait la venue en fanfare d’une troupe de chasseurs de trésors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39bd2af3-f570-3ec5-bb10-e427b41bcbe1",
                                        "entry_id": "9ad50a7d-90b9-3418-89e5-5f2d568a27ef",
                                        "glosses": [
                                            "Vaisseau léger, armé pour la course."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1755339-6553-3f39-b505-39d173869d2f",
                                        "entry_id": "9ad50a7d-90b9-3418-89e5-5f2d568a27ef",
                                        "glosses": [
                                            "Avion de chasse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ff297f-34a4-4749-92c9-dc09c5773780",
                                                "sense_id": "f1755339-6553-3f39-b505-39d173869d2f",
                                                "text": "La production d’avions de chasse destinés à la Luftwaffe, d’après les rapports très précis de l’Intelligence a été du 1ᵉʳ novembre 1943 au 1ᵉʳ avril 1944 de 7 065 chasseurs — dont 150 à réaction."
                                            },
                                            {
                                                "example_id": "df4c7a3c-7bbf-43b3-b49f-a9ed3e3e7665",
                                                "sense_id": "f1755339-6553-3f39-b505-39d173869d2f",
                                                "text": "Après avoir regardé les appareils quelques instants, je vis qu’un avion était attaqué par trois chasseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da79a21-1773-3ba1-8500-9231e9a04291",
                                        "entry_id": "9ad50a7d-90b9-3418-89e5-5f2d568a27ef",
                                        "glosses": [
                                            "Domestique qui montait derrière le carrosse de son maître ou sur le siège d’une automobile à côté du chauffeur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e541d2c6-e42c-380f-800e-072394cecc13",
                                        "entry_id": "9ad50a7d-90b9-3418-89e5-5f2d568a27ef",
                                        "glosses": [
                                            "Groom d’un restaurant ou d’un hôtel, en livrée, chargé de faire les courses, les commissions."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed5cb8a0-423e-4539-92a3-97b3f179fab3",
                                                "sense_id": "e541d2c6-e42c-380f-800e-072394cecc13",
                                                "text": "Sophie. — (Présentant une dépêche à Ribadier.) Voilà une dépêche qui est arrivée au Cercle pour Monsieur et qu’un chasseur vient d’apporter."
                                            },
                                            {
                                                "example_id": "b1aeeffb-3edc-49a2-be82-671388b302f8",
                                                "sense_id": "e541d2c6-e42c-380f-800e-072394cecc13",
                                                "text": "J’avais pour invité, dans un bar de Montmartre, le chasseur d’une boite de nuit qui, sous son beau costume, abritait une nature inquiète."
                                            },
                                            {
                                                "example_id": "7c3e5d7e-32a2-4ea1-bad2-cf7074d8dcc2",
                                                "sense_id": "e541d2c6-e42c-380f-800e-072394cecc13",
                                                "text": "Il suivait l’innominé dans l’ombre, le petit chasseur galonné, comme son propre instinct."
                                            },
                                            {
                                                "example_id": "3ec9581b-b255-404d-b4c9-1ab5e36b1021",
                                                "sense_id": "e541d2c6-e42c-380f-800e-072394cecc13",
                                                "text": "– Vous faites un travail très banal, cela dit sans vous offenser. Un travail semblable à celui de grouillot ou de chasseur d'hôtel…"
                                            },
                                            {
                                                "example_id": "a02462b7-fadd-4fae-8adb-0bb36720a7c5",
                                                "sense_id": "e541d2c6-e42c-380f-800e-072394cecc13",
                                                "text": "Dans le hall de l’Athletic Club, le chasseur se précipita dans un vieil ascenseur à cage ouverte et réapparut presque immédiatement en me faisant un signe de la tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6226d3-bf35-3515-8e76-ac6d95e4277d",
                                        "entry_id": "9ad50a7d-90b9-3418-89e5-5f2d568a27ef",
                                        "glosses": [
                                            "Soldat de certains corps francs d’infanterie ou de cavalerie spécialisés dans les opérations d’éclairage, de renseignement et de coup de main au-delà des lignes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa77d1e-a0d1-492a-a10e-85d42da2bd71",
                                                "sense_id": "3d6226d3-bf35-3515-8e76-ac6d95e4277d",
                                                "text": "Nos chasseurs à pied surtout, avec leurs carabines qui envoient un homme ad patres à des distances de tous les diables, avaient la manie de chercher leur cible quotidienne de l'autre côté du ravin."
                                            },
                                            {
                                                "example_id": "5dcc7957-d80c-4d3e-873e-37a0ff2fd5f9",
                                                "sense_id": "3d6226d3-bf35-3515-8e76-ac6d95e4277d",
                                                "text": "« Voila des régiments qui réfléchissent », doivent se dire les bourgs qui ont vu la veille défiler à l’étourdie des zouaves ou des chasseurs."
                                            },
                                            {
                                                "example_id": "6f20ce15-38b3-4567-98fb-3e59c07744ae",
                                                "sense_id": "3d6226d3-bf35-3515-8e76-ac6d95e4277d",
                                                "text": "Il apprend peu à peu le rituel des chasseurs chez qui tout est bleu, même les liserés et les galons jaunes des uniformes, qui deviennent « bleu jonquille ». L’instruction est assurée à un rythme d'enfer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
