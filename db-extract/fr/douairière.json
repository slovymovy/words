                "senses": [
                    {
                        "sense_id": "3dba5f95-625e-3dd7-80cf-aeb07d3a6484",
                        "entry_id": "63c8386a-1040-3581-9435-43b7a14faeb4",
                        "glosses": [
                            "Qui jouissait d’un douaire, étant veuve (en parlant de personnes d’un rang distingué)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e8f70ee7-1032-479e-9392-1fe823f96200",
                                "sense_id": "3dba5f95-625e-3dd7-80cf-aeb07d3a6484",
                                "text": "La duchesse douairière."
                            },
                            {
                                "example_id": "aab93144-8967-42a5-b80e-b60fd1f1a465",
                                "sense_id": "3dba5f95-625e-3dd7-80cf-aeb07d3a6484",
                                "text": "Mais, entêté que tu es, quand je te dis que M. de Buckingham a loué toutes les maisons qui entourent celle où doit descendre Sa Majesté la reine douairière d’Angleterre et la princesse sa fille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                "word": "douairière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "653cf85a-86f7-4605-88fb-d53d4461be62",
                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "douairières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "303e6179-4ab4-3001-b699-b3453a1989e7",
                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                        "glosses": [
                            "Veuve qui jouissait d’un douaire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "29fc7be8-d668-4389-a132-3e7627fd5fd1",
                                "sense_id": "303e6179-4ab4-3001-b699-b3453a1989e7",
                                "text": "La douairière de Ronsdorf, femme d’une haute vertu et d’une réputation intacte, était alors restée veuve avec sa fille unique âgée de cinq ans ; […]."
                            },
                            {
                                "example_id": "d37ae4af-2e55-4541-a698-d78b6e7c5dc8",
                                "sense_id": "303e6179-4ab4-3001-b699-b3453a1989e7",
                                "text": "L’abbé va trop vite… On ne peut pas suivre, murmure la vieille douairière en agitant sa coiffe avec égarement."
                            }
                        ]
                    },
                    {
                        "sense_id": "c20724f1-a65e-374b-9511-5d23b948832f",
                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                        "glosses": [
                            "Veuve d’une famille aristocratique ayant un fils devenu chef de famille."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                        "entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
                        "glosses": [
                            "Femme âgée, de rang distingué."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ee5bce40-47b5-439b-abcb-a10349c04730",
                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                "text": "En ce moment la douairière tricotait."
                            },
                            {
                                "example_id": "b640c923-1fc9-40bb-a281-07cf031038fb",
                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                "text": "Il est vrai que tous les jours nous faisons un pas vers la liberté, l’égalité, la fraternité, trois grands mots que la Révolution de 93, vous savez, l’autre, la douairière, a lancés au milieu de la société moderne, […]."
                            },
                            {
                                "example_id": "02bacb77-26ef-4ba9-a592-3e7c81fed700",
                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                "text": "Frivole, nonchalante, d’une naïveté un peu hautaine, il ne semblait pas qu’aucun chagrin pût altérer la bienveillance dont elle regardait la vie ; et son plus grave caprice aujourd’hui était de jouer à la douairière, se coiffant de dentelle et réclamant des petits-enfants à tout prix."
                            },
                            {
                                "example_id": "29bfcc21-792f-4f2e-b6b5-2c6c7e3e3925",
                                "sense_id": "3c62cf64-db35-33e3-a034-57d3a73599f4",
                                "text": "Nous entrâmes dans un cirque.\n« Nous employons quinze personnes de la famille », me confia la patronne à tête de douairière andalouse, qui comptait ses mots comme des pesetas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5b6337e-0594-45d2-961d-9c8cba8acbe1",
                        "source_entry_id": "26b6f34d-1365-3449-9b3b-e73de1e892dd",
