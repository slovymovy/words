                    "sense_id": "cad77a6e-f469-3ca3-b5a7-75cfb8cdfc65",
                    "sense_definition": "met iemand meegaan als metgezel",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "begeleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De scholier werd <w>vergezeld</w> door zijn grootouders tijdens de diploma-uitreiking.",
                            "target_lang_translations": {
                                "en": "The student was <w>accompanied</w> by his grandparents during the graduation ceremony."
                            }
                        },
                        {
                            "text": "Zou je mij naar het gala willen <w>vergezellen</w> vanavond?",
                            "target_lang_translations": {
                                "en": "Would you like to <w>accompany</w> me to the gala tonight?"
                            }
                        }
                    ],
                    "synonyms": [
                        "begeleiden",
                        "meegaan"
                    ],
                    "antonyms": [
                        "verlaten"
                    ],
                    "common_phrases": [
                        "iemand vergezellen"
                    ],
                    "target_lang_definitions": {
                        "en": "to go with someone as a companion or escort"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accompany",
                                "target_lang_sense_clarification": "to go somewhere with someone"
                            },
                            {
                                "target_lang_word": "go with",
                                "target_lang_sense_clarification": "to join someone for an event or journey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "586b09e6-42b1-3df1-96b1-ffd5b2563b66",
                    "sense_definition": "samen met iets anders voorkomen of gebeuren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begeleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weer werd er geschoten, ditmaal <w>vergezeld</w> door luid gegil.",
                            "target_lang_translations": {
                                "en": "There were shots again, this time <w>accompanied</w> by loud screaming."
                            }
                        },
                        {
                            "text": "De hevige regenval werd <w>vergezeld</w> door een krachtige wind uit het noorden.",
                            "target_lang_translations": {
                                "en": "The heavy rainfall was <w>accompanied</w> by a strong wind from the north."
                            }
                        }
                    ],
                    "synonyms": [
                        "samengaan"
                    ],
                    "common_phrases": [
                        "vergezeld gaan van"
                    ],
                    "target_lang_definitions": {
