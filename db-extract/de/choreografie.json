                                        "sense_id": "2e5e05e4-2d1b-3353-8c7b-ed883a96f5c3",
                                        "entry_id": "7431f46e-4ff0-38ae-a95b-b0db491f6eaa",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de chorégraphier."
                                        ],
