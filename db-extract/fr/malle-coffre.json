                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80bdec2b-55d2-416c-9242-f90b4bee63d0",
                                "sense_id": "9694b5df-3370-3762-b70a-828186410ddd",
                                "text": "On peut noter au passage, une table et un meuble Boule, et une malle-coffre en acajou."
                            },
                            {
                                "example_id": "e6d799eb-52a3-4c29-b450-58ac84f61bf3",
                                "sense_id": "9694b5df-3370-3762-b70a-828186410ddd",
                                "text": "Pièces lumineuses, parquets clairs, deux chevalets, couleurs et palettes posées sur une malle-coffre, lit de repos composaient un décor étonnamment moderne."
                            },
                            {
                                "example_id": "22b301ef-10fe-464f-9a55-cc81045ac00e",
                                "sense_id": "9694b5df-3370-3762-b70a-828186410ddd",
                                "text": "Les comédiens emmènent le visiteur à Louxor avec les malles-armoires qui prenaient place sur les bateaux à vapeur, ou encore dans les stations balnéaires huppées de la côte avec les malles-coffres des premières voitures."
                            }
                        ]
