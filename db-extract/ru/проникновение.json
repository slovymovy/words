                                        "sense_id": "f0dfdeb7-e759-3aa2-8f16-d1bcf6dc62be",
                                        "entry_id": "348fd679-aa68-394e-9fc7-de04db16f801",
                                        "glosses": [
                                            "The insertion of the penis (or similar object) during sexual intercourse."
                                        ],
                                        "tags": [
