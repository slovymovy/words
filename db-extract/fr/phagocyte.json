        "fr-extract.jsonl": [
            {
                "entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
                "word": "phagocyte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d194b768-d1a1-450c-b26a-1d9ef2370450",
                        "entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
                        "tags": [
                            "plural"
                        ],
                        "form": "phagocytes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                        "entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
                        "glosses": [
                            "Cellule possédant le pouvoir d’absorber et souvent aussi de digérer des particules étrangères, inorganiques ou organiques (microorganismes notamment)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3de553-e9c5-4466-a820-3b1e05e69a0a",
                                "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                "text": "Le macrophage activé dans sa nouvelle fonction se nomme « phagocyte », c’est-à-dire « cellule mangeuse », et va opérer la phagocytose (« action de manger les cellules » étrangères à l’organisme)."
                            },
                            {
                                "example_id": "f50cabca-95da-41db-ab00-3feb61dea541",
                                "sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                                "text": "C'est le signe d'une réaction de l'organisme : le tissu lymphoïde fabrique des phagocytes en abondance pour pouvoir lutter contre l'invasion parasitaire, qui se produit au niveau de la muqueuse intestinale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73b05bed-5375-46e0-b0e4-8b3a597d6208",
                        "source_entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
                        "source_sense_id": "9d8ddba0-c24a-33aa-b208-ab4f319c076a",
                        "target_lang_word": "Phagozyt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phagozyt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                        "entry_id": "fd7b46ea-4012-3cdf-b46f-bfebe68c6354",
                                        "glosses": [
                                            "weißes Blutkörperchen bzw. sogenannte „Fresszelle“, die belebte und unbelebte Gewebs- oder andere Teile aufnehmen, verdauen und unschädlich machen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "127d14f5-174f-4193-9412-2c18697d7024",
                                                "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                                "text": "Die Phagozyten sind Zellen der allgemeinen, unspezifischen Abwehr."
                                            },
                                            {
                                                "example_id": "7fcb7c34-7119-45f9-8439-a429e48906f0",
                                                "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                                "text": "Diese kommensalen Bakterien, die opportunistische Infektionen verursachen können, besitzen zwar nicht die Eigenschaft, nach Phagozytose weiterleben zu können, dennoch führt deren Aufnahme in einigen Fällen zum Tod der Phagozyten."
                                            },
                                            {
                                                "example_id": "14186501-9028-474d-b5c1-c172371094d1",
                                                "sense_id": "d3f1aa0c-aea8-3f9d-bd9a-0dc5cfabeae2",
                                                "text": "„Als wollte er alle gegen ihn in Stellung gebrachten Vorwürfe bestätigen, ja aufnehmen wie ein gefräßiger Phagozyt, greift er (zur Selbstverortung?) in den Hosenschritt, lässt einen Kollegen mit mannsgroßem Plastikpenis die Bühne stürmen, reicht aber den dargebotenen Tangaslip eines Groupies schnell einem Assistenten weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b220c71-52cd-44dd-ab5a-441ee44dc5d3",
                        "source_entry_id": "3bc848c7-1b00-3949-812e-6e2362c65798",
