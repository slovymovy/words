                "senses": [
                    {
                        "sense_id": "a314eb97-eea2-33df-8d03-85e307a7b65f",
                        "entry_id": "4368ca76-9b35-3e0e-998c-d8abffa2c1df",
                        "glosses": [
                            "Dans le cirque, mur central peu élevé, autour duquel tournaient les chars."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "7ddb37cb-2a00-44dd-9669-b67a7cb72a34",
                                "sense_id": "a314eb97-eea2-33df-8d03-85e307a7b65f",
                                "text": "Formé d’un grand ovale oblong, l’hippodrome est séparé en deux parties par un muret central, la spina, longue de plus de deux cents mètres."
                            },
                            {
                                "example_id": "e0aec94b-1b20-4abe-823f-50f25f6d6c32",
                                "sense_id": "a314eb97-eea2-33df-8d03-85e307a7b65f",
                                "text": "À Rome, l’obélisque en syénite situé au centre de la place du Vatican avait été transporté d’Héliopolis par Caligula pour décorer la spina du cirque de Néron."
                            }
                        ]
                    },
                    {
                        "sense_id": "116f47a2-0da5-360f-a398-8ccc17aa3f06",
                        "entry_id": "4368ca76-9b35-3e0e-998c-d8abffa2c1df",
                        "glosses": [
                            "Renfort longitudinal de bois au milieu d’un bouclier celte."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "9cfc81ca-88e1-4939-b3fb-fdbe2a454bf8",
                                "sense_id": "116f47a2-0da5-360f-a398-8ccc17aa3f06",
                                "text": "L’arme [= le bouclier celte] est composée d’une planche, d’un demi-fuseau en bois (la spina), d’une coque en fer rivetée destinée à protéger la main (l’umbo), d’une poignée horizontale parfois renforcée d’une barrette (le manipule) et éventuellement de renforts métalliques (les orles)."
                            }
                        ]
                    }
