                "senses": [
                    {
                        "sense_id": "c2b170ae-e7ad-38ca-84ca-447c68a422f8",
                        "entry_id": "f2bd90a9-14b1-3930-9a00-84a14111ac5c",
                        "glosses": [
                            "Befugnis zum unbehinderten Marsch durch ein Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d59ec8-7115-4e2f-b42f-2fe7c2f5fa3b",
                                "sense_id": "c2b170ae-e7ad-38ca-84ca-447c68a422f8",
                                "text": "„Alle Mitglieder der Vereinten Nationen verpflichten sich, zur Wahrung des Weltfriedens und der internationalen Sicherheit dadurch beizutragen, daß sie nach Maßgabe eines oder mehrerer Sonderabkommen dem Sicherheitsrat auf sein Ersuchen Streitkräfte zur Verfügung stellen, Beistand leisten und Erleichterungen einschließlich des Durchmarschrechts gewähren, soweit dies zur Wahrung des Weltfriedens und der internationalen Sicherheit erforderlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
