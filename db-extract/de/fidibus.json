                                "target_senses": [
                                    {
                                        "sense_id": "50d1191c-c72e-338c-ba26-0a5516087a95",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To drop something so that it spreads out or makes a mess; to accidentally pour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faac22bb-17e0-467d-baa2-c56a82c14e9b",
                                                "sense_id": "50d1191c-c72e-338c-ba26-0a5516087a95",
                                                "text": "I spilled some sticky juice on the kitchen floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd79e72-65b2-386f-83bf-6b30dc849c84",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To spread out or fall out, as above."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94768bce-cf93-4041-96d7-26b9f87b5ae4",
                                                "sense_id": "cbd79e72-65b2-386f-83bf-6b30dc849c84",
                                                "text": "Some sticky juice spilled onto the kitchen floor."
                                            },
                                            {
                                                "example_id": "42172e2c-ae76-4a5f-bd92-f8e02a0d8484",
                                                "sense_id": "cbd79e72-65b2-386f-83bf-6b30dc849c84",
                                                "text": "He was so topful of himself, that he let it spill on all the company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "add5cd9a-d682-3593-aebc-b92a1ee95965",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To overflow out of a designated area."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6007f5a-2449-43ea-b801-939305743216",
                                                "sense_id": "add5cd9a-d682-3593-aebc-b92a1ee95965",
                                                "text": "The crowd spilled onto Maple Avenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35e2fde5-b89f-31eb-b177-e444b359cfb0",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To drop something that was intended to be caught."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df0a6c05-3c9b-4d32-8a62-3fec1afd82ab",
                                                "sense_id": "35e2fde5-b89f-31eb-b177-e444b359cfb0",
                                                "text": "That should have been that, but Hart caught a dose of the Hennessey wobbles and spilled Adlene Guedioura's long-range shot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f746a4af-567b-3770-8256-4cbf5f02b865",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To mar; to damage; to destroy by misuse; to waste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b3ba28-7f21-449f-9912-b9f4b5542e4d",
                                                "sense_id": "f746a4af-567b-3770-8256-4cbf5f02b865",
                                                "text": "They [the colours] disfigure the stuff and spill the whole workmanship."
                                            },
                                            {
                                                "example_id": "357bddb8-1736-463c-a2f2-1206e5ea1075",
                                                "sense_id": "f746a4af-567b-3770-8256-4cbf5f02b865",
                                                "text": "Spill not the morning (the quintessence of day) in recreations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e08bca6a-bbf4-383d-9a61-eb87540ed470",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To be destroyed, ruined, or wasted; to come to ruin; to perish; to waste."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b412b57b-3c2c-49a0-8d2b-40e968be7893",
                                                "sense_id": "e08bca6a-bbf4-383d-9a61-eb87540ed470",
                                                "text": "That thou wilt suffer innocence to spill."
                                            },
                                            {
                                                "example_id": "285cbcd3-5dad-4d4d-9525-1dfd9bd062a2",
                                                "sense_id": "e08bca6a-bbf4-383d-9a61-eb87540ed470",
                                                "text": "This winter’s weather it waxeth cold, / And frost it freezeth on every hill, / And Boreas blows his blast so bold / That all our cattle are like to spill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7314f06-511e-3187-9d15-c57b6a22c94a",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To overflow or flow out, over or off something."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b1ed6f-9ae0-41fb-9922-1fb5c8f664bf",
                                                "sense_id": "c7314f06-511e-3187-9d15-c57b6a22c94a",
                                                "text": "Liverpool Street's 1985-92 remodelling by the British Rail Architects' Department (under project lead Nick Derbyshire) had carefully followed original 1870s detailing, with the concourse designed to allow natural light to spill into the station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "880e6e02-f661-3b39-9225-95d00c74840c",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To cause or flow out and be lost or wasted; to shed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a234bd1-4e4b-4989-9d19-b922f74acb91",
                                                "sense_id": "880e6e02-f661-3b39-9225-95d00c74840c",
                                                "text": "to revenge his Blood, ſo juſtly ſpilt, / VVhat is it leſs then to partake his guilt?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "824b0371-6759-38eb-9c5a-8b1b68d0f786",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To cause to be thrown from a mount, a carriage, etc."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e125e506-93e3-429f-a80b-88652acf5367",
                                                "sense_id": "824b0371-6759-38eb-9c5a-8b1b68d0f786",
                                                "text": "Then, not thirty feet beyond, a sudden panicky lunge to the side by his horse spilled him from the saddle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef30f301-21c9-344a-a7ff-ae9534180a04",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To cover or decorate with slender pieces of wood, metal, ivory, etc.; to inlay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf7b1f3-3461-486b-84bf-99c9979dedbb",
                                                "sense_id": "ef30f301-21c9-344a-a7ff-ae9534180a04",
                                                "text": "And all the others pavement were with yvory spilt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612f7582-d9ae-3e5c-89f6-1af913288175",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To relieve a sail from the pressure of the wind, so that it can be more easily reefed or furled, or to lessen the strain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "406d77fe-296e-33d1-803a-efe9bee978a1",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To open the leadership of a parliamentary party for re-election."
                                        ],
                                        "tags": [
                                            "Australian",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "150444be-3cf0-3823-bef0-06d33b6ac82a",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To reveal information to an uninformed party."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d00e26fd-981f-4eee-b68c-d6d1844456e3",
                                                "sense_id": "150444be-3cf0-3823-bef0-06d33b6ac82a",
                                                "text": "He spilled his guts out to his new psychologist."
                                            },
                                            {
                                                "example_id": "cb7a6bfc-6905-400c-812b-4adf84617f95",
                                                "sense_id": "150444be-3cf0-3823-bef0-06d33b6ac82a",
                                                "text": "‘You wanted to know where we were going. Follow me. I’m going to spill it.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb337710-fb6b-30cb-9064-e953664fe815",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To come undone."
                                        ],
                                        "tags": [
                                            "of a knot"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d9806bc-2916-38f4-840a-11060736436e",
                                        "entry_id": "09eadc53-9d4b-3dc8-9110-ebec1f65b306",
                                        "glosses": [
                                            "To express (something), especially repeatedly or floridly; to be expressed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a8168e-713a-4bf7-bd99-7eee82f2b45b",
                                                "sense_id": "5d9806bc-2916-38f4-840a-11060736436e",
                                                "text": "He spilled insults about the other team."
                                            },
                                            {
                                                "example_id": "ce76ce6a-32ec-4c55-a33b-ca906cbd69fd",
                                                "sense_id": "5d9806bc-2916-38f4-840a-11060736436e",
                                                "text": "Praise spilled from him every day."
                                            }
                                        ]
                                    }
                                ]
                            },
