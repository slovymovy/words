                ],
                "senses": [
                    {
                        "sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                        "entry_id": "a61ec2df-cc3f-36b1-959b-17407d524b8b",
                        "glosses": [
                            "Verstopfung einer Lungenarterie in der Lunge, beispielsweise durch ein Blutgerinnsel, seltener auch durch Fett, Luft, Fruchtwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f848631-1480-4567-95b3-2fb9a7fc1513",
                                "sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                                "text": "Die Lungenembolie ist im Krankenhaus eine häufige Erkrankung."
                            },
                            {
                                "example_id": "3c553426-b807-47c9-8330-1c99b6491c2d",
                                "sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                                "text": "Wenn wichtige Blutgefäße verstopft sind, kann eine Lungenembolie tödlich sein."
                            },
                            {
                                "example_id": "cc0d6400-24c9-4ccc-9f3c-cf27e7a953f0",
                                "sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                                "text": "„In der Lungenklinik führten die Kollegen eine ganze Reihe weiterer Tests durch: Mithilfe einer Computertomografie konnten sie eine Lungenembolie ausschließen.“"
                            },
                            {
                                "example_id": "5422fdc0-4ef2-4c02-b9ac-14edb34600bf",
                                "sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                                "text": "„Der spanische Opernstar Placido Domingo, der Mitte Juli nach der Behandlung einer Lungenembolie aus einem Madrider Krankenhaus entlassen worden ist, hat seine Termine als Sänger und Dirigent im Rahmen des Festivals für das 100-jährige Jubiläum der Arena von Verona bestätigt.“"
                            },
                            {
                                "example_id": "9b548993-91b2-4af9-8bdb-dba663077ac8",
                                "sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                                "text": "„Akademiepräsident Max von Schillings ist am 24. Juli unerwartet in Berlin gestorben, an einer Lungenembolie infolge einer Darmkrebsoperation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81aa132f-bb2e-4f70-b904-da3b9212940b",
                        "source_entry_id": "a61ec2df-cc3f-36b1-959b-17407d524b8b",
                        "source_sense_id": "20a9263f-69da-3b17-9530-fd8df4d2432c",
                        "target_lang_word": "pulmonary embolism",
