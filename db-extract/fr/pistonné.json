                    {
                        "form_id": "71e0a142-800e-4ef7-a1e2-a6a779c2b2c7",
                        "entry_id": "da953650-4eb4-396b-9840-4100d8d8d6c6",
                        "tags": [
                            "feminine"
                        ],
                        "form": "pistonnée"
