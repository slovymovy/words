                    "sense_definition": "vervoeging van <w>zitten</w>: eerste persoon enkelvoud tegenwoordige tijd (en tweede persoon enkelvoud bij inversie)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zit</w> graag bij het raam om naar buiten te kijken.",
