    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04ab6c5e-b971-3e63-b10f-34c886ff334f",
                    "sense_definition": "A preliminary version of a written work or drawing that is not yet in its final form.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to finish the first <w>draft</w> of my essay before the weekend.",
                            "target_lang_translations": {
                                "ru": "Мне нужно закончить первый <w>черновик</w> эссе до выходных."
                            }
                        },
                        {
                            "text": "The author shared a rough <w>draft</w> of the new chapter with her editor.",
                            "target_lang_translations": {
                                "ru": "Автор поделилась черновым <w>наброском</w> новой главы со своим редактором."
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "final version"
                    ],
                    "common_phrases": [
                        "rough draft",
                        "first draft",
                        "final draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предварительная версия письменной работы или рисунка, которая еще не находится в окончательной форме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черновик",
                                "target_lang_sense_clarification": "для текста"
                            },
                            {
                                "target_lang_word": "набросок",
                                "target_lang_sense_clarification": "для рисунка или текста"
                            },
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "для рисунка или проекта"
                            },
                            {
                                "target_lang_word": "проект",
                                "target_lang_sense_clarification": "документа или плана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a0b7ce-f7ae-331b-a248-3c69e4d69be5",
                    "sense_definition": "A current of cool air moving through a room or vehicle, often caused by an open window or door.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt a cold <w>draft</w> coming from under the front door.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал холодный <w>сквозняк</w>, идущий из-под входной двери."
                            }
                        },
                        {
                            "text": "Please close the window because there is a <w>draft</w> in here.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, закрой окно, потому что здесь <w>сквозняк</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cold draft",
                        "feel a draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поток прохладного воздуха, движущийся через комнату или транспортное средство, часто вызванный открытым окном или дверью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквозняк",
                                "target_lang_sense_clarification": "в помещении"
                            },
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "в печи или трубе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dbb1a9d-ef53-3273-a361-07a1042e21de",
                    "sense_definition": "A system where people are required by law to join the military; conscription.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young men were worried about the military <w>draft</w> during the war.",
                            "target_lang_translations": {
                                "ru": "Многие молодые люди были обеспокоены военным <w>призывом</w> во время войны."
                            }
                        },
                        {
                            "text": "The government decided to end the <w>draft</w> and move to a volunteer army.",
                            "target_lang_translations": {
                                "ru": "Правительство решило отменить <w>призыв</w> и перейти к добровольческой армии."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "military draft",
                        "avoid the draft"
                    ],
                    "target_lang_definitions": {
                        "ru": "Система, при которой люди обязаны по закону вступать в армию; призыв."
