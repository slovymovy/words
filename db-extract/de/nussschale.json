                        "entry_id": "5a32bb2e-128f-3d8f-9f41-e163e9dd9afa",
                        "glosses": [
                            "verholzte, ungenießbare Schale von Nüssen sowie nussartigen Früchten und Kernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afcc6849-1d76-4138-877a-dbdb58327d01",
                                "sense_id": "72ec3ee0-2f4e-387a-811e-d65d81806db1",
                                "text": "Jede Nuss hat eine Nussschale zum Schutz der Samen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29f8b2a8-fe46-37a1-a73d-0683c0b7c42d",
                        "entry_id": "5a32bb2e-128f-3d8f-9f41-e163e9dd9afa",
                        "glosses": [
                            "kleines Boot oder Schiff"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b19bc2c3-6792-43fd-8bbd-89720c2bdf77",
                                "sense_id": "29f8b2a8-fe46-37a1-a73d-0683c0b7c42d",
                                "text": "Du willst doch nicht allen Ernstes in dieser schwankenden Nussschale den Atlantik überqueren?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd78e59f-a3a4-4eac-a296-9fdf20aa181e",
                        "source_entry_id": "5a32bb2e-128f-3d8f-9f41-e163e9dd9afa",
                        "source_sense_id": "72ec3ee0-2f4e-387a-811e-d65d81806db1",
                        "source_sense_description": "verholzte, ungenießbare Schale von Nüssen sowie nussartigen Früchten und Kernen",
                        "target_lang_word": "nutshell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutshell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "389823ee-3fb3-3faa-bf13-45a349cb663f",
                                        "entry_id": "bdaf686f-ea8b-32ae-bf3c-551740ce51c1",
                                        "glosses": [
                                            "The shell that surrounds the kernel of a nut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "275fbc17-2f19-443f-addf-e6c5ba94d7cf",
                                                "sense_id": "389823ee-3fb3-3faa-bf13-45a349cb663f",
                                                "text": "For men be now tratlers and tellers of tales;\nWhat tidings at Totnam, what newis in Wales,\nWhat ſhippis are ſailing to Scalis Malis?\nAnd all is not worth a couple of nut ſhalis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3906e108-f4f6-33d5-8ced-1379d9c7f74b",
                                        "entry_id": "bdaf686f-ea8b-32ae-bf3c-551740ce51c1",
                                        "glosses": [
                                            "A short book summarizing an area of law."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed50dec9-35f8-3c54-95f7-2a2cfb5c1345",
                                        "entry_id": "bdaf686f-ea8b-32ae-bf3c-551740ce51c1",
                                        "glosses": [
                                            "A small boat; a boat considered small in comparison to the seas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30aba450-2b28-47cc-8d08-06dea39ed915",
                                                "sense_id": "ed50dec9-35f8-3c54-95f7-2a2cfb5c1345",
                                                "text": "[A]t last the fishing-line stood straight out behind, and the stone weights jumped along the tops of the billows, while the seas - notwithstanding the guiding hand of the pilot sought to avoid them - broke over our little nutshell, and sent the spray high above mast and sail."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nutshell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "feb5d315-74fd-30bc-892b-28160af0b7c5",
                                        "entry_id": "1bef3334-4a72-3cb1-a2ce-7b50c40c6c74",
                                        "glosses": [
                                            "To summarize (from the term in a nutshell)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c21d11-b4f3-4fc0-beec-8e049bd60ccb",
                        "source_entry_id": "5a32bb2e-128f-3d8f-9f41-e163e9dd9afa",
                        "source_sense_id": "72ec3ee0-2f4e-387a-811e-d65d81806db1",
                        "source_sense_description": "verholzte, ungenießbare Schale von Nüssen sowie nussartigen Früchten und Kernen",
                        "target_lang_word": "coquille de noix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coquille de noix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18b69a22-a994-3b0c-8acf-118b548eb545",
                                        "entry_id": "87731bd9-6592-3ad8-9f79-09fe398967e7",
                                        "glosses": [
                                            "Enveloppe dure de la noix, sous le brou."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20126d1b-58f5-3dc8-94ce-f337befbf759",
                                        "entry_id": "87731bd9-6592-3ad8-9f79-09fe398967e7",
                                        "glosses": [
                                            "Petit bateau peu susceptible de voguer."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c24167-af4d-4ad6-a8d9-23a51f6f8a6a",
                                                "sense_id": "20126d1b-58f5-3dc8-94ce-f337befbf759",
                                                "text": "La Mésange était une coquille de noix plutôt qu’un vrai navire. Mais cette coquille, bâtie et équipée dans les ateliers du meilleur constructeur de Bordeaux, avait toutes les qualités d’un bon bateau-pilote."
                                            },
                                            {
                                                "example_id": "b62e4fa1-003d-4bf7-8ebe-8cd65fa86225",
                                                "sense_id": "20126d1b-58f5-3dc8-94ce-f337befbf759",
                                                "text": "La France entière s’est moquée des coquilles de noix de Napoléon au camp de Boulogne, et, quinze ans après, nous comprîmes que l’Angleterre n’avait jamais été si près de sa perte."
                                            },
                                            {
                                                "example_id": "6a84431b-d352-4448-91cc-4599f60e5ff3",
                                                "sense_id": "20126d1b-58f5-3dc8-94ce-f337befbf759",
                                                "text": "Nous sautions comme dans une coquille de noix, et nous embarquions de l’eau à chaque instant."
                                            },
                                            {
                                                "example_id": "893a2f36-b878-47e4-8b7b-8187eb1ee118",
                                                "sense_id": "20126d1b-58f5-3dc8-94ce-f337befbf759",
                                                "text": "Son frisson s’accentua encore quand il reçut l’image de ce bateau qui s’enfonçait comme une coquille de noix dans l’affreuse nuit de novembre, dans l’affreuse cuvette noire, flagellée de vents polaires."
                                            },
                                            {
                                                "example_id": "99a18a86-0597-4d6d-893c-e57ec05baa0a",
                                                "sense_id": "20126d1b-58f5-3dc8-94ce-f337befbf759",
                                                "text": "Il désigna l’appontement où une flotte disparate se pressait . Il y avait pêle-mêle des croiseurs, des frégates, des navires de croisière et même quelques coquilles de noix peu engageantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
