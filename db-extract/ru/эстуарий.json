                        "cross_references": [
                            {
                                "target_word": "estuarium",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "04d31ec3-c48d-328d-91e2-073eccb3ded5",
                                        "entry_id": "cecaa9a3-f6e1-3eb9-8b77-4270d078660c",
                                        "glosses": [
                                            "poszerzone, lejkowate ujście rzeki, powstałe w wyniku działania pływów morskich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24fd6f0-9b0b-4245-9ef5-ac55a7d03c6e",
                                                "sense_id": "04d31ec3-c48d-328d-91e2-073eccb3ded5",
                                                "text": "Roślinność wodna tego estuarium jest bardzo bogata."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "328314a5-099a-484b-ad1c-214f602b9624",
                        "source_entry_id": "67c0f6ac-20bc-3a53-8c2e-d6da941a6656",
                        "source_sense_id": "b06dc612-f062-3525-b70d-7842f9988b5f",
                        "target_lang_word": "estuaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estuaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b82b573-5dea-30ae-a883-17e4e46f18f1",
                                        "entry_id": "da8ed81d-abb3-3402-b924-bca468aebf3d",
                                        "glosses": [
                                            "Estran, partie du littoral, qui n’est couverte d’eau qu’à la marée montante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2600374-f487-4eb0-8024-77c7ff790f36",
                                                "sense_id": "1b82b573-5dea-30ae-a883-17e4e46f18f1",
                                                "text": "Quant aux autres navigateurs recherchés, il s'agit principalement de marins d’eau douce qui pratiquent sur la Vire et les autres rivières de cette zone - la Taute, la Douve - le transport de la tangue, prélevée dans cette zone vaseuse d’estuaires formant la baie des Veys, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28358e27-e542-31aa-bfc0-ab058fff9d78",
                                        "entry_id": "da8ed81d-abb3-3402-b924-bca468aebf3d",
                                        "glosses": [
                                            "Embouchure d’un fleuve qui forme une sorte de baie large et longue."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c558c5d-b2fa-4334-889d-c48ce6de0e98",
                                                "sense_id": "28358e27-e542-31aa-bfc0-ab058fff9d78",
                                                "text": "Béatitude bleue de l'Atlantique ; la brise du large nous fit croiser doucement dans l'estuaire."
                                            },
                                            {
                                                "example_id": "0ed624b3-dc66-487f-ba1f-d6caef5b38d3",
                                                "sense_id": "28358e27-e542-31aa-bfc0-ab058fff9d78",
                                                "text": "De l'autre côté, sur la gauche de l'estuaire, à partir de l'embouchure même de la Coppermine, la côte remontait au nord et se terminait par le cap Kruzenstern."
                                            },
                                            {
                                                "example_id": "d0f57764-01b1-416f-8317-e0624cc0543f",
                                                "sense_id": "28358e27-e542-31aa-bfc0-ab058fff9d78",
                                                "text": "Peu de spectacles, en Europe, dépassent en grandeur celui qu'on découvre de Honfleur quand le soleil couchant, de ses flammes marines, éclaire jusqu'en ses profondeurs l'estuaire de la Seine."
                                            },
                                            {
                                                "example_id": "6e422fc1-e1b3-443d-8bbc-7eacf0c6f2ab",
                                                "sense_id": "28358e27-e542-31aa-bfc0-ab058fff9d78",
                                                "text": "Louis le pieux meurt en 840 sur le Rhin. Un an plus tard, la flotte danoise embouque l’estuaire de la Seine."
                                            },
                                            {
                                                "example_id": "735e55ca-db96-482e-aa5b-e6d9f06589f4",
                                                "sense_id": "28358e27-e542-31aa-bfc0-ab058fff9d78",
                                                "text": "Gigantesque boucan à la dérive, le village reculait dans les ténèbres tandis que s’illunait la voile lancée dans l’estuaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
