                        "glosses": [
                            "Donner un caractère mécréant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ba743d-ec81-41d9-bc8e-c79f4dccaa21",
                                "sense_id": "4bd585f8-75ac-3195-80c5-9cf1168704cb",
                                "text": "Ca donne des réactions de mécréantiser la mémoire d'un défunt."
                            },
                            {
                                "example_id": "ca27e9a4-e3be-4b54-a043-a1f007ee850a",
                                "sense_id": "4bd585f8-75ac-3195-80c5-9cf1168704cb",
                                "text": "Prétendre tuer au nom d'une religion est donc, ipso facto, se mettre hors religion, en quelque sorte se « mécréantiser », s'excommunier."
                            }
                        ]
