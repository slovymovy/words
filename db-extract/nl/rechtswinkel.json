                        "entry_id": "5fca4944-82d4-37d9-99f4-2226100e5882",
                        "glosses": [
                            "vrijwilligersorganisatie die goedkoop of gratis juridische bijstand geeft aan armere mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad35945-7a2f-487e-b312-1a5cd520ee71",
                                "sense_id": "fc516bf1-9c5b-3544-961a-86b519a9fbdc",
                                "text": "Als bijna afgestudeerd jurist was hij in elk geval oprichter en voorzitter van de Ierse organisatie van rechtswinkels, waar \"gewone\" Ieren voor advies terechtkunnen."
                            },
                            {
                                "example_id": "90a94473-d07b-4e30-a5d8-5788bc914827",
                                "sense_id": "fc516bf1-9c5b-3544-961a-86b519a9fbdc",
                                "text": "De Rechtswinkel ging van start in september 2013. Inwoners van Enschede konden met juridische vragen naar inloopspreekuren in de servicecentra. Daar werden ze geholpen door Saxion-studenten van de opleiding Sociaal Juridische Dienstverlening. Deze studenten kregen op hun beurt weer ondersteuning van juristen van de gemeente. Williams: \"Zes studenten werkten als vrijwilliger bij de Rechtswinkel, maar er was te weinig aanloop om ze aan het werk te houden.\""
                            }
                        ]
                    }
