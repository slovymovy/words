                "senses": [
                    {
                        "sense_id": "7355f06b-6a90-3003-815f-25b247bbcaa7",
                        "entry_id": "2c07ee89-933c-31c4-8ea0-1fda31769257",
                        "glosses": [
                            "Shampoo, dass dem Haar mehr Festigkeit verleiht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f07f026-c818-4a2d-bb3b-84b665f7eece",
                                "sense_id": "7355f06b-6a90-3003-815f-25b247bbcaa7",
                                "text": "Zu einer schicken Frisur gehört in der Regel auch Schaumfestiger."
                            },
                            {
                                "example_id": "a499ddc0-2dcf-43e2-87f9-ec86bed38de6",
                                "sense_id": "7355f06b-6a90-3003-815f-25b247bbcaa7",
                                "text": "„Was haben ein Glas Bier, Schlagsahne, Geschirrspülmittel, Shampoo und Schaumfestiger gemein? Sie sollen ordentlich schäumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
