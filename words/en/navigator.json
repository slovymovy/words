    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2bdb9a77-6e54-3081-96e5-22a77a6b63f6",
                    "sense_definition": "A person who directs the course of a ship, aircraft, or other vehicle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's <w>navigator</w> carefully plotted the course through the narrow channel.",
                            "target_lang_translations": {
                                "ru": "Корабельный <w>штурман</w> тщательно проложил курс через узкий пролив."
                            }
                        },
                        {
                            "text": "During the flight, the <w>navigator</w> updated the pilot on their current position.",
                            "target_lang_translations": {
                                "ru": "Во время полета <w>штурман</w> сообщал пилоту их текущее местоположение."
                            }
                        }
                    ],
                    "synonyms": [
                        "helmsman",
                        "pilot",
                        "guide"
                    ],
                    "common_phrases": [
                        "skilled navigator",
                        "flight navigator",
                        "marine navigator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который управляет курсом корабля, самолета или другого транспортного средства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штурман",
                                "target_lang_sense_clarification": "специалист по прокладке курса"
                            },
                            {
                                "target_lang_word": "навигатор",
                                "target_lang_sense_clarification": "лицо, ответственное за маршрут"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3fa7e77-fde8-3e85-9cd2-70b3ce3cc05a",
                    "sense_definition": "A device or system, such as a GPS, used to find the way to a destination.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "navigation_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I turned on the car <w>navigator</w> to find the quickest route to the hotel.",
                            "target_lang_translations": {
                                "ru": "Я включил автомобильный <w>навигатор</w>, чтобы найти кратчайший путь к отелю."
                            }
                        },
                        {
                            "text": "The satellite <w>navigator</w> lost its signal when we entered the long tunnel.",
                            "target_lang_translations": {
                                "ru": "Спутниковый <w>навигатор</w> потерял сигнал, когда мы въехали в длинный туннель."
                            }
                        }
                    ],
                    "synonyms": [
                        "GPS",
                        "satnav"
                    ],
                    "common_phrases": [
                        "car navigator",
                        "satellite navigator",
                        "digital navigator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство или система, например GPS, используемая для поиска пути к пункту назначения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навигатор",
                                "target_lang_sense_clarification": "электронное устройство или программа"
                            },
                            {
                                "target_lang_word": "GPS-навигатор",
                                "target_lang_sense_clarification": "спутниковая система навигации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dc6eb25-763e-318d-a50a-9db7594c691f",
                    "sense_definition": "A software interface or tool used to browse through files, folders, or complex data structures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the project <w>navigator</w> on the left to switch between different source files.",
                            "target_lang_translations": {
                                "ru": "Используйте <w>навигатор</w> проекта слева для переключения между различными исходными файлами."
                            }
                        },
                        {
                            "text": "The file <w>navigator</w> makes it easy to organize your documents into groups.",
                            "target_lang_translations": {
                                "ru": "Файловый <w>навигатор</w> позволяет легко распределять документы по группам."
                            }
                        }
                    ],
                    "synonyms": [
                        "browser",
                        "explorer"
                    ],
                    "common_phrases": [
                        "file navigator",
                        "project navigator",
                        "sidebar navigator"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Программный интерфейс или инструмент для просмотра файлов, папок или сложных структур данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навигатор",
                                "target_lang_sense_clarification": "инструмент для перемещения по структуре данных"
                            },
                            {
                                "target_lang_word": "проводник",
                                "target_lang_sense_clarification": "программа для управления файлами"
                            },
                            {
                                "target_lang_word": "браузер",
                                "target_lang_sense_clarification": "программа для просмотра контента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a0f1006-a607-3b31-81b0-3e8362116cf6",
                    "sense_definition": "A historical sea explorer who discovered new routes or lands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "navigation_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>navigator</w> set sail in search of a new trade route to the East.",
                            "target_lang_translations": {
                                "ru": "Знаменитый <w>мореплаватель</w> отправился в плавание на поиски нового торгового пути на Восток."
                            }
                        },
                        {
                            "text": "Many islands were first mapped by a Portuguese <w>navigator</w> in the fifteenth century.",
                            "target_lang_translations": {
                                "ru": "Многие острова были впервые нанесены на карту португальским <w>мореплавателем</w> в пятнадцатом веке."
                            }
                        }
                    ],
                    "synonyms": [
                        "explorer",
                        "voyager"
                    ],
                    "common_phrases": [
                        "famous navigator",
                        "early navigator",
                        "portuguese navigator"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический морской исследователь, открывавший новые маршруты или земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мореплаватель",
                                "target_lang_sense_clarification": "исследователь морей"
                            },
                            {
                                "target_lang_word": "навигатор",
                                "target_lang_sense_clarification": "исторический термин для исследователя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "077f2ea9-a75a-3691-a697-d98d08387677",
                    "sense_definition": "A manual laborer working on major civil engineering projects like canals or railways.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The canal was dug by hand by thousands of <w>navigators</w> during the industrial revolution.",
                            "target_lang_translations": {
                                "ru": "Канал был вырыт вручную тысячами <w>землекопов</w> во время промышленной революции."
                            }
                        },
                        {
                            "text": "Life was incredibly harsh for a railway <w>navigator</w> living in temporary camps.",
                            "target_lang_translations": {
                                "ru": "Жизнь <w>строителя</w> железных дорог, живущего во временных лагерях, была невероятно суровой."
                            }
                        }
                    ],
                    "synonyms": [
                        "navvy",
                        "laborer"
                    ],
                    "common_phrases": [
                        "railway navigator",
                        "canal navigator"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a navvy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разнорабочий, занятый на крупных гражданских инженерных проектах, таких как каналы или железные дороги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "землекоп",
                                "target_lang_sense_clarification": "рабочий на строительстве каналов или дорог"
                            },
                            {
                                "target_lang_word": "строитель",
                                "target_lang_sense_clarification": "рабочий на инженерных объектах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}