                "senses": [
                    {
                        "sense_id": "04000d5c-6bb8-36ff-a48d-992010b8fa89",
                        "entry_id": "cd6267f6-0524-3198-b6ad-a66cbdba7500",
                        "glosses": [
                            "gelegentlich fälschlich (Die Verbrennung beginnt während des Verdichtungstaktes kurz vor dem oberen Totpunkt und endet kurz nach dem oberen Totpunkt.) für den Arbeits- oder Expansionstakt von Verbrennungsmotoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc5807c-1242-4b46-9d5f-410154c83cf6",
                                "sense_id": "04000d5c-6bb8-36ff-a48d-992010b8fa89",
                                "text": "„Unter innerer Abgasrückführung versteht man eine Maßnahme, die verhindert, dass alle Gase nach dem Verbrennungstakt ausgestoßen werden.“"
                            },
                            {
                                "example_id": "bf8d80a1-d15c-47a1-b554-549d7a33ec99",
                                "sense_id": "04000d5c-6bb8-36ff-a48d-992010b8fa89",
                                "text": "„Beim Viertakt-Verfahren wird zwischen jedem Verbrennungstakt ein separater Gaswechseltakt – bestehend aus Ausschiebehub und Ansaughub – eingeschoben […].“"
                            },
                            {
                                "example_id": "d2aeefcf-31bd-486b-bf85-1cbda275ee76",
                                "sense_id": "04000d5c-6bb8-36ff-a48d-992010b8fa89",
                                "text": "„Der Motor funktioniert nach wie vor als Viertakter, verteilt die Verbrennungstakte aber auf zwei Kolben (‚Split Cycle‘).“"
                            },
                            {
                                "example_id": "2639b7a9-a792-4e58-91a4-c787f552a5c6",
                                "sense_id": "04000d5c-6bb8-36ff-a48d-992010b8fa89",
                                "text": "„Beim Common Rail System beeinflussen sich die dicht aufeinander folgenden Einspritzungen in einem Verbrennungstakt durch die jeweils ausgelösten Druckwellen gegenseitig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
