    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                "word": "notability",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "05e331d2-4d6f-4db2-8778-26e32e272d71",
                        "entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "tags": [
                            "plural"
                        ],
                        "form": "notabilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d084fc21-fcb1-3ad0-bf94-fa30975a3b99",
                        "entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "glosses": [
                            "The quality or state of being notable or eminent."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d32cfa9b-b5fb-3ded-92b3-9a1f4f8c674c",
                        "entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "glosses": [
                            "A notable or eminent person or thing."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a3f4e88-8630-4dd1-bddb-ff09de457be0",
                                "sense_id": "d32cfa9b-b5fb-3ded-92b3-9a1f4f8c674c",
                                "text": "Lesser notabilities have indeed utilized and built upon the opportunities created for filling in the gaps within the socioeconomic and political maps of the popular community."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c4022f9-2214-30cb-acac-ec7b6746c6f5",
                        "entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "glosses": [
                            "Locally eminent people; the bourgeoisie or upper middle class"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "912e7c57-02c2-4e6e-8f8e-864b59a3fb22",
                                "sense_id": "3c4022f9-2214-30cb-acac-ec7b6746c6f5",
                                "text": "Just as the notability lived in its own social universe between the common citizenry and the aristocracy, so too did its intellectual universe express this complex mediation."
                            },
                            {
                                "example_id": "ca515fb7-f67f-4140-aa2f-f8f5557b4c19",
                                "sense_id": "3c4022f9-2214-30cb-acac-ec7b6746c6f5",
                                "text": "Such petitions were part of the role of the notability as understood at the time; a manifestation of their social hegemony was the obligation to speak for or represent the local community to the imperial center."
                            }
                        ]
                    },
                    {
                        "sense_id": "34a25663-8993-3ce9-bc4d-2b82a1266839",
                        "entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "glosses": [
                            "A standard used to determine whether a subject merits its own article."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff1e69b-8452-4373-889b-28850e904d86",
                        "source_entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "source_sense_description": "quality of being notable",
                        "target_lang_word": "notabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b513a4b-e3f6-31f2-9955-f76c4ac0118c",
                                        "entry_id": "d320feb6-8fae-344f-84c6-64e41a26b16a",
                                        "glosses": [
                                            "Caractère de ce qui est notable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eac3828-fedf-435a-adbd-809897537554",
                                                "sense_id": "7b513a4b-e3f6-31f2-9955-f76c4ac0118c",
                                                "text": "Sa notabilité est incontestable."
                                            },
                                            {
                                                "example_id": "fe0789db-f4c0-4f24-9113-22d1c2b804b5",
                                                "sense_id": "7b513a4b-e3f6-31f2-9955-f76c4ac0118c",
                                                "text": "Les codes de la supériorité sociale et de la notabilité, qui passent par l’élaboration de l’urbanité, ont donc un double usage, externe et interne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21c0c875-88eb-390a-ade5-beca82ae1afa",
                                        "entry_id": "d320feb6-8fae-344f-84c6-64e41a26b16a",
                                        "glosses": [
                                            "Personnage notable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0438f00-7601-41b3-af0f-dedecf53f9b8",
                                                "sense_id": "21c0c875-88eb-390a-ade5-beca82ae1afa",
                                                "text": "Trop souvent une aristocratie de notabilités locales a exploité à son profit les fonctions publiques, et fait sentir aux Anglais que son despotisme peut être plus intolérable encore que celui d’une administration centrale, […]."
                                            },
                                            {
                                                "example_id": "30e9103d-0e3b-4a49-9632-93706e7d719c",
                                                "sense_id": "21c0c875-88eb-390a-ade5-beca82ae1afa",
                                                "text": "Une fois la victoire présidentielle acquise, le choix des candidats aux législatives sous l'étiquette de LREM s'est fait de manière centralisée sous l'égide d’un professionnel de la politique venu du gaullisme, Jean-Paul Delevoye, avec parfois l'intervention de notabilités socialistes ralliées à LREM [Lefebvre, 2019]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed2d3964-5e5a-456f-a1c5-61c694c3ce83",
                        "source_entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "source_sense_description": "quality of being notable",
                        "target_lang_word": "notoriété",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notoriété",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f553869d-689a-3835-93fa-e1cdf346371a",
                                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                                        "glosses": [
                                            "Connaissance générale, publique, d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e411087-0a07-4a5c-a383-344a951805a4",
                                                "sense_id": "f553869d-689a-3835-93fa-e1cdf346371a",
                                                "text": "Le clergé réuni reconnut la force du plaidoyer, ainsi que la notoriété des circonstances sur lesquelles il se fondait […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                                        "glosses": [
                                            "État d’une personne fort connue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7206449e-afd3-49f5-9429-33baef33a5ec",
                                                "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                                "text": "Ah ! le temps joyeux de la stupidité, de pharisaïsme à rebours où les petits messieurs pressés se hissaient paisiblement sur la crête de la notoriété. Tous des faiseurs, tous des faisans."
                                            },
                                            {
                                                "example_id": "9336ca83-2bb9-489f-b0cf-e8e9aa10d058",
                                                "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                                "text": "La notoriété médiatique de la photo y repose sur ses qualités de documentarité (elle fait document) et de testimonialité (elle atteste)."
                                            },
                                            {
                                                "example_id": "9dbb9624-5ce9-441c-ab80-d9555aa00671",
                                                "sense_id": "6e44eb56-c50b-3d07-82b4-bc43e0e017e2",
                                                "text": "Cet événement, qui jouit d'une réputation internationale, présente des oeuvres issues des nouveaux courants artistiques ; l'occasion est donc belle de faire valoir la complexité de mon travail et d'accroître ma notoriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c619c8-a5d1-3da7-a047-1d3c1e790c52",
                                        "entry_id": "bb2283fe-f809-33c3-bb1c-91e23dc8b32d",
                                        "glosses": [
                                            "Personne connue, célébrité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21269bb9-f9d2-4b8a-95f4-067cefed500e",
                                                "sense_id": "43c619c8-a5d1-3da7-a047-1d3c1e790c52",
                                                "text": "Tu voulais voir ton nom cité parmi les notoriétés, le soir de la « générale » au Châtelet…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f861aa99-c9db-4e37-a58c-4f692ca7863e",
                        "source_entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "source_sense_description": "quality of being notable",
                        "target_lang_word": "Bekanntheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bekanntheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                        "entry_id": "7c03cc56-d6ff-3591-8306-0c78f7cf42ad",
                                        "glosses": [
                                            "Umstand, von vielen gekannt zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50c59bc7-2b82-42aa-8a2f-d4a3f173c370",
                                                "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                                "text": "„Aber er kann helfen, die Bekanntheit eines Projekts zu steigern und einen Künstler bekannter zu machen.“"
                                            },
                                            {
                                                "example_id": "f199dd71-cb33-4ec2-9bcc-e41b3d0bedb6",
                                                "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                                "text": "„Mit der wachsenden Bekanntheit des Brunello hat auch der lokale Tourismus Auftrieb erhalten.“"
                                            },
                                            {
                                                "example_id": "edc1974e-32bd-456e-b6df-04c947e91f5b",
                                                "sense_id": "bb8fdc61-1d05-3b56-8b55-cc0c9e39c864",
                                                "text": "„Die Bekanntheit und die, nach Wielands Urteil, verfehlten bisherigen Bearbeitungen sind ein Grund für seine Stoffwahl.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e44a162-66d4-3544-8c56-d0051d9f2ed1",
                                        "entry_id": "7c03cc56-d6ff-3591-8306-0c78f7cf42ad",
                                        "glosses": [
                                            "prominente Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8e0563-24b5-4d13-bb4e-d76501264c8a",
                                                "sense_id": "0e44a162-66d4-3544-8c56-d0051d9f2ed1",
                                                "text": "„Auch die Unerreichbarkeit, das Funkeln und die Distanz, die der Begriff Star beinhaltet, sind bei diesen Bekanntheiten nicht mehr vorhanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a087c24-982b-4cb2-a953-d76e0f0767d0",
                        "source_entry_id": "1b7a4a0f-1e56-3d29-86c1-5470b7239363",
                        "source_sense_description": "notable person or thing",
                        "target_lang_word": "Persönlichkeit",
                        "target_lang_code": "de",
                        "note": "of a person",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Persönlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de1cc4bf-e61b-37a9-9f7e-47322ec720c2",
                                        "entry_id": "0252d17b-d74f-3ed5-88da-4fb6aadc3cfe",
                                        "glosses": [
                                            "die Gesamtheit der persönlichen Eigenschaften eines Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1685cae1-958a-4f36-85fa-f2bfdcf3b982",
                                                "sense_id": "de1cc4bf-e61b-37a9-9f7e-47322ec720c2",
                                                "text": "„In einem der Interviews sagt er, dass die ersten Lebensjahre seine Persönlichkeit vollkommen zerstört hätten.“"
                                            },
                                            {
                                                "example_id": "00634ac6-8376-471d-99e3-d6800378bddd",
                                                "sense_id": "de1cc4bf-e61b-37a9-9f7e-47322ec720c2",
                                                "text": "„Aus dem Klang der Stimme eines Menschen ziehen Hörer Schlüsse über die Persönlichkeit des Sprechers.“"
                                            },
                                            {
                                                "example_id": "ad5099d8-aa24-47c1-9a0b-9777ac1caf78",
                                                "sense_id": "de1cc4bf-e61b-37a9-9f7e-47322ec720c2",
                                                "text": "„Die Handschriften meiner Eltern unterschieden sich ebenso stark wie ihre Persönlichkeiten.“"
                                            },
                                            {
                                                "example_id": "bec61d97-36eb-4ddf-a967-be8862db342b",
                                                "sense_id": "de1cc4bf-e61b-37a9-9f7e-47322ec720c2",
                                                "text": "„Cécile fühlte sich sofort angezogen durch seine Persönlichkeit und sprach ihm unbefangen und liebenswürdig aus, wie sehr sie sich freue, seine Bekanntschaft zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00f0efd0-0e9f-39ce-aca2-7604c4e9ad44",
                                        "entry_id": "0252d17b-d74f-3ed5-88da-4fb6aadc3cfe",
                                        "glosses": [
                                            "ein Mensch mit in einem Bereich sehr stark ausgeprägten Persönlichkeitsmerkmalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a48a037-44a3-478a-9825-66c2bc8a3356",
                                                "sense_id": "00f0efd0-0e9f-39ce-aca2-7604c4e9ad44",
                                                "text": "„Es gibt keine Persönlichkeit, die den Erfolg des Fußballs so verkörpert wie Franz Beckenbauer.“"
                                            },
                                            {
                                                "example_id": "f1e81874-2c86-4d4d-b9f8-bb81976efe5e",
                                                "sense_id": "00f0efd0-0e9f-39ce-aca2-7604c4e9ad44",
                                                "text": "„Virginia Woolfs Grundierung der Vision einer eigenständigen Persönlichkeit mit der Farbe Blau ist nicht zufällig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19ec1d59-d483-38f8-8a30-b1cc0df29d6e",
                                        "entry_id": "0252d17b-d74f-3ed5-88da-4fb6aadc3cfe",
                                        "glosses": [
                                            "eine Person, die eine führende Rolle in der Gesellschaft spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0bf0358-ff54-4740-880e-275106acaf5f",
                                                "sense_id": "19ec1d59-d483-38f8-8a30-b1cc0df29d6e",
                                                "text": "„Seine Kochkünste haben sich herumgesprochen, Stange hat viele bedeutende Persönlichkeiten kennengelernt und redet darüber, als wäre es nichts.“"
                                            },
                                            {
                                                "example_id": "eaff9001-1fed-4740-a853-a43865f467b5",
                                                "sense_id": "19ec1d59-d483-38f8-8a30-b1cc0df29d6e",
                                                "text": "„In Ariovist war den Germanen eine Persönlichkeit neuen Typs erwachsen.“"
                                            },
                                            {
                                                "example_id": "8f88186e-5d37-4187-9f00-ef20fd86d4d8",
                                                "sense_id": "19ec1d59-d483-38f8-8a30-b1cc0df29d6e",
                                                "text": "„Aber vielleicht sollte man ja bei einem Ausflug nach Heldra nicht nur den leiblichen Gelüsten frönen, sondern sein lückenhaftes Wissen um diese beiden Persönlichkeiten durch einen Besuch im Dorfmuseum auffrischen.“"
                                            },
                                            {
                                                "example_id": "906165da-b950-4ac8-b7d3-90d49aedd965",
                                                "sense_id": "19ec1d59-d483-38f8-8a30-b1cc0df29d6e",
                                                "text": "„Die Peronskaja nannte der Gräfin die hervorragendsten Persönlichkeiten unter den Ballgästen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
