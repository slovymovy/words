                "senses": [
                    {
                        "sense_id": "83f3e33f-45e8-375a-85e3-9107ddcf105c",
                        "entry_id": "c3411169-c3e3-3854-9537-f2f03aaf38b2",
                        "glosses": [
                            "Italianiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72913b9-4998-4964-bf9a-8ab0aab97e18",
                                "sense_id": "83f3e33f-45e8-375a-85e3-9107ddcf105c",
                                "text": "Quant à moi il suffit de transalpiniser François pour avoir mon prénom."
                            },
                            {
                                "example_id": "83a4e4d8-62a4-49c3-9d3e-44e3542bd608",
                                "sense_id": "83f3e33f-45e8-375a-85e3-9107ddcf105c",
                                "text": "Très beau ce tobec transalpinisé."
                            },
                            {
                                "example_id": "ce60840d-eaba-41ec-9005-c2e6d666c6df",
                                "sense_id": "83f3e33f-45e8-375a-85e3-9107ddcf105c",
                                "text": "Le homard s'encanaille avec des olives, le filet de mulet en croûte de citron se « transalpinise » avec son confit de risotto de céleri, sauce curcuma, le filet de chevreuil s'orientalise avec des feuilles de dattes et le suprême de canard au sang se sublime avec sa mousseline de racines et sa pastilla de béatilles."
                            }
                        ]
                    }
