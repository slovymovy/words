                                        "sense_id": "7cfb5069-82f7-3fae-a08e-1b03e71af3b4",
                                        "entry_id": "44411c5a-f7ec-3e13-aa0d-861eda464b46",
                                        "glosses": [
                                            "Pays imaginaire, inventé dans le cadre d’un canular."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee8ba6f-45f9-4318-8bcd-597ca3083ed8",
                                                "sense_id": "7cfb5069-82f7-3fae-a08e-1b03e71af3b4",
                                                "text": "ALESSANDROVICI : […] Quoi, la Poldavie ? Ah ! non ! Vous n’allez pas me faire le coup de de la patrie, hein ? La Poldavie, je sais ce que c’est que la Poldavie. J’en ai vendu avant vous et je n’en suis même pas fier, parce que la Poldavie, c’est plus facile à vendre que des bretelles ou des pantalons usagés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0026cc4-d82d-4138-8644-2133f4598f2e",
                        "source_entry_id": "23ba41d7-cdf5-3114-a0a6-7fb72c76cea2",
                        "source_sense_description": "used to describe a fictitious and generic foreign government or person",
                        "target_lang_word": "Syldavie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Syldavie",
