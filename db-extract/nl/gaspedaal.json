                        "entry_id": "df9f2361-77e8-3ec2-9df5-3b37d815d170",
                        "glosses": [
                            "het rechter pedaal van een auto waarmee de brandstoftoevoer naar de motor geregeld wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b144d8-ffc5-47f5-8191-f5d232935a3f",
                                "sense_id": "e0923210-23fc-3224-86c2-301b60a114cf",
                                "text": "Hij liet het gaspedaal los en liet zijn auto geleidelijk tot stilstand komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c3cabac-c3b2-4f35-b9f7-d595c8ce4c89",
                        "source_entry_id": "df9f2361-77e8-3ec2-9df5-3b37d815d170",
                        "source_sense_id": "e0923210-23fc-3224-86c2-301b60a114cf",
                        "source_sense_description": "het rechter pedaal van een auto waarmee de brandstoftoevoer naar de motor geregeld wordt",
                        "target_lang_word": "Gaspedal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaspedal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b354638-9d72-33e0-a378-c8dfb5e5eb1d",
                                        "entry_id": "bb5e01de-9743-3a66-b6bc-e355e6bd2461",
                                        "glosses": [
                                            "Fußhebel zur Steuerung der Motorleistung im Kraftfahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07fa027-bd6a-4cfc-800c-b193dad814a5",
                                                "sense_id": "9b354638-9d72-33e0-a378-c8dfb5e5eb1d",
                                                "text": "Mit dem Gaspedal kann die Geschwindigkeit eines Fahrzeugs beeinflusst werden."
                                            },
                                            {
                                                "example_id": "2be6d3e2-72d7-429b-aff9-a785c5c86878",
                                                "sense_id": "9b354638-9d72-33e0-a378-c8dfb5e5eb1d",
                                                "text": "„Der Fuß auf dem Gaspedal ist müde, wenn man den Norden erreicht hat, der andere schwebt über der Kupplung und ist schon eingeschlafen.“"
                                            },
                                            {
                                                "example_id": "4ccc8256-c603-4d7f-8930-7d33ffe2c946",
                                                "sense_id": "9b354638-9d72-33e0-a378-c8dfb5e5eb1d",
                                                "text": "„Ich hatte das Gaspedal bis zum Boden durchgetreten und ließ es da, bis ich zu meiner Ausfahrt kam.“"
                                            },
                                            {
                                                "example_id": "b94651e8-747f-4a40-a516-c6f1bab93b15",
                                                "sense_id": "9b354638-9d72-33e0-a378-c8dfb5e5eb1d",
                                                "text": "„Als Antwort drückte Jacques das Gaspedal durch, verließ die asphaltierte Straße und sauste quer über die Ebene.“"
                                            },
                                            {
                                                "example_id": "495be44d-2f6d-4462-b5cc-0a19f8795703",
                                                "sense_id": "9b354638-9d72-33e0-a378-c8dfb5e5eb1d",
                                                "text": "„Nettie beobachtete sie lange Zeit im Rückspiegel, während ihr nackter Fuß aufs Gaspedal trat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
