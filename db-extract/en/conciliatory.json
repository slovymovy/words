                        "form": "more conciliatory"
                    },
                    {
                        "form_id": "ebaceeac-b846-4ac0-8b78-116a534202b7",
                        "entry_id": "61a3b341-d4c9-35d2-b45e-42cf3470250b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most conciliatory"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7aaccc47-4559-355b-870e-1df880617cc5",
                        "entry_id": "61a3b341-d4c9-35d2-b45e-42cf3470250b",
                        "glosses": [
                            "Willing to conciliate, or to make concessions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "606c7d5d-6b41-42ed-912a-f1d01d9e5eb8",
                                "sense_id": "7aaccc47-4559-355b-870e-1df880617cc5",
                                "text": "Lady Anne checked herself, for she heard a carriage stop at the door, and her daughters enter the house; and she had not made up her mind as to the turn she should give to their conciliatory visit."
                            },
                            {
                                "example_id": "057d73a8-262c-465a-8314-99bf28236ad2",
                                "sense_id": "7aaccc47-4559-355b-870e-1df880617cc5",
                                "text": "Shaken by the biggest challenge to their authority in years, Brazil’s leaders made conciliatory gestures on Tuesday to try to defuse the protests engulfing the nation’s cities."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a86138a2-d3c8-4843-afee-4f28143c8e1c",
                        "source_entry_id": "61a3b341-d4c9-35d2-b45e-42cf3470250b",
                        "source_sense_id": "7aaccc47-4559-355b-870e-1df880617cc5",
                        "source_sense_description": "willing to conciliate",
                        "target_lang_word": "smířlivý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smířlivý",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b8afcc3f-7b1a-37f0-975e-e3d8077a4521",
                                        "entry_id": "dae51dda-bfea-3751-9b29-882340825569",
                                        "glosses": [
                                            "usilující o smír; který se vyhýbá zbytečnému konfliktu nebo usiluje o jeho zažehnání"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "094de71f-c586-42ff-858a-11f0d6d7f8e8",
                                                "sense_id": "b8afcc3f-7b1a-37f0-975e-e3d8077a4521",
                                                "text": "Vyloženě nerada se hádá - má značně smířlivou povahu."
                                            },
                                            {
                                                "example_id": "5b623f19-19ec-4db4-9c4d-867ea4c71420",
                                                "sense_id": "b8afcc3f-7b1a-37f0-975e-e3d8077a4521",
                                                "text": "Romové na fotografiích nabídli prezidentovi relativně důstojnou ústupovou cestu, mohl třeba některé z nich pozvat do Lán, pronést něco smířlivého, vzpomenout si na některou z romských osobností při udělování státních vyznamenání 28. října, těch způsobů je spousta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6975a221-8cb0-4609-adda-29a21541089f",
                        "source_entry_id": "61a3b341-d4c9-35d2-b45e-42cf3470250b",
                        "source_sense_id": "7aaccc47-4559-355b-870e-1df880617cc5",
                        "source_sense_description": "willing to conciliate",
                        "target_lang_word": "accommodant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accommodant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                        "entry_id": "1389b203-b12f-3425-a846-41fb65cffbd2",
                                        "glosses": [
                                            "Qui s’accommode à tous et à tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19f99e91-6637-4769-85b0-cdb97902fb42",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "C’est un homme accommodant, d’un esprit fort accommodant."
                                            },
                                            {
                                                "example_id": "320f525c-4cad-4106-ae59-8dbed7d7bb2a",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Une humeur, une personne accommodante."
                                            },
                                            {
                                                "example_id": "24fbaae2-f468-4b80-a64d-1b179b5276f1",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Ce marchand est fort accommodant."
                                            },
                                            {
                                                "example_id": "4972dad4-356b-4c74-a7ec-3d1aa9ce393b",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "« Ces Parisiens, se dit-il, sont les gens les plus accommodants du monde. On les juge mal dans nos provinces. »"
                                            },
                                            {
                                                "example_id": "7cb59238-29b4-4f72-9646-e6d50d68706e",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Julius sourit avec une accommodante condescendance et, pour changer de sujet, demande à son beau-frère des nouvelles de sa sciatique, qu’il appelle par erreur : son lumbago."
                                            },
                                            {
                                                "example_id": "cf03a790-6023-46d6-bfea-e26bfb4a65ee",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Nous lui passâmes cette niaiserie. Mais nous n’étions pas toujours aussi accommodantes ; quand un sujet nous intéressait, nous discutions ferme."
                                            },
                                            {
                                                "example_id": "1222dfee-d5fe-436c-9f32-7636da6f0842",
                                                "sense_id": "3cac6b68-0adc-335c-b0ca-892cc8c5341d",
                                                "text": "Les lentilles ont un effet de mise au repos accommodant parfois supérieur aux cycloplégies qui ont pu être réitérées lors du suivi habituel du patient, y compris chez l’adulte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accommodant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "763604ce-eaf2-3d98-ab5e-74dea4b11d63",
                                        "entry_id": "16bc7672-6023-36a9-9271-06b25328d8b8",
                                        "glosses": [
                                            "Participe présent du verbe accommoder."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c38f83-a5f5-4003-960f-0985d50cffd0",
                                                "sense_id": "763604ce-eaf2-3d98-ab5e-74dea4b11d63",
                                                "text": "A la différence des gens de condition élevée, il n’a pas été formé à une culture classique qui a pour effet de dénationaliser les intelligences, si j’ose ainsi dire, en les accommodant à la manière grecque et latine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3586ebb4-879a-4bec-a76d-576b85709b64",
