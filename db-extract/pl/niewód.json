                ],
                "senses": [
                    {
                        "sense_id": "d29ca3aa-e6f1-30d0-9fa5-f04e8658414c",
                        "entry_id": "343dea67-0db6-3b36-8d6d-4dd84bce47a3",
                        "glosses": [
                            "rodzaj dużej sieci rybackiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40e88985-6d3f-4260-aaba-25e2486894d1",
                                "sense_id": "d29ca3aa-e6f1-30d0-9fa5-f04e8658414c",
                                "text": "Nie będziemy zresztą łapać ryb przed niewodem…"
                            },
                            {
                                "example_id": "3e94e1dd-cfec-4ccb-a628-17f910b868b0",
                                "sense_id": "d29ca3aa-e6f1-30d0-9fa5-f04e8658414c",
                                "text": "Zostawiwszy stułokciową linę na brzegu, wyjechał w wielkim bacie na morze, wyrzucił prawe skrzydło, macicę, lewe skrzydło niewodu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0917918d-39a3-41e7-b010-9f3f8e79bb73",
                        "source_entry_id": "343dea67-0db6-3b36-8d6d-4dd84bce47a3",
                        "source_sense_id": "d29ca3aa-e6f1-30d0-9fa5-f04e8658414c",
                        "target_lang_word": "seine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86a22c85-153b-3b41-a051-b75ff234c50c",
                                        "entry_id": "cd273040-8fb8-3b8f-8924-0421db22ebf1",
                                        "glosses": [
                                            "A long net having floats attached at the top and sinkers (weights) at the bottom, used in shallow water for catching fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d321b02a-fe2c-4f4f-81d9-c56ceb494656",
                                                "sense_id": "86a22c85-153b-3b41-a051-b75ff234c50c",
                                                "text": "We all went on Monday Evening to the sea shore, to see the scene Drawn: this is a most curious Work: and all done by Women."
                                            },
                                            {
                                                "example_id": "bc1d7a1e-f51b-4cac-ae6b-52fd4e2bec87",
                                                "sense_id": "86a22c85-153b-3b41-a051-b75ff234c50c",
                                                "text": "They were too busy hauling at ropes, collectively drawing a large seine across the bay before them – and singing their hearts out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "seine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af55d5fc-5fdc-3ab5-af41-9dde4c28af06",
                                        "entry_id": "50cbc1c5-7e82-3fbf-8b69-38c4e34e93e5",
                                        "glosses": [
                                            "To use a seine, to fish with a seine."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7a4a9ac-bc1d-43bc-aabc-0d9368489ac7",
                                                "sense_id": "af55d5fc-5fdc-3ab5-af41-9dde4c28af06",
                                                "text": "This was especially the case with seining for pilchards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ebf15f3-3f6d-4048-bdd6-e6a839eb192d",
                        "source_entry_id": "343dea67-0db6-3b36-8d6d-4dd84bce47a3",
                        "source_sense_id": "d29ca3aa-e6f1-30d0-9fa5-f04e8658414c",
