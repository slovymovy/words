                        "examples": [
                            {
                                "example_id": "f0751f4f-0809-4a5e-90fd-124c15e4a63a",
                                "sense_id": "94198ede-f9f5-3165-b774-a6b355b40edb",
                                "text": "Here the rachis is bent at the point of its origin, and thereby it produces pendulate inflorescence."
                            },
                            {
                                "example_id": "51b95c54-8824-405a-8766-84baa4583d3b",
                                "sense_id": "94198ede-f9f5-3165-b774-a6b355b40edb",
                                "text": "Above the lower headcut, phreatophytic mesquite and little leaf sumac hug the banks, drawing pendulate water from the silts remaining from former marsh deposits and sending long taproots into channel stores."
                            },
                            {
                                "example_id": "079fca99-d2be-4a7d-a70c-9131c8ed01b1",
                                "sense_id": "94198ede-f9f5-3165-b774-a6b355b40edb",
                                "text": "The first group of genotypes demonstrates a pendulate/spreading form, whereas the second group remains upright when the fruits grow on the shoots."
                            }
                        ]
                    }
                ],
