                "entry_id": "d332c65a-2427-331c-946e-713d2b18d4cb",
                "word": "anti-tech",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6a30c26b-be63-3ed7-9653-8ae5d5eab39b",
                        "entry_id": "d332c65a-2427-331c-946e-713d2b18d4cb",
                        "glosses": [
                            "Défavorable à la technologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "174ee048-09e0-420c-bbd1-49e549afa41d",
                                "sense_id": "6a30c26b-be63-3ed7-9653-8ae5d5eab39b",
                                "text": "« On n’est pas anti-tech, mais on souhaite une technologie éthique », a déclaré la présidente de l’association de sensibilisation aux enjeux du numérique Janus International."
                            },
                            {
                                "example_id": "836ee84d-bb1e-4f1f-845d-01ef9453b81e",
                                "sense_id": "6a30c26b-be63-3ed7-9653-8ae5d5eab39b",
                                "text": "Il existe des sociétés pro-tech comme le Brésil ou les États Baltes ; en tant qu’ensemble régional, l’Union Européenne apparaît elle aussi plutôt pro-tech sur le fond, mais anti-tech quand on intègre les acteurs."
                            },
                            {
                                "example_id": "5c88edaf-597d-4dc0-bdd3-4886f67d65a0",
                                "sense_id": "6a30c26b-be63-3ed7-9653-8ae5d5eab39b",
                                "text": "Les vieux ne sont pas tous anti-tech et les jeunes ne sont pas tous pro-tech."
                            }
                        ]
                    },
                    {
                        "sense_id": "5873c1a3-d89e-38f0-884b-13068814a057",
                        "entry_id": "d332c65a-2427-331c-946e-713d2b18d4cb",
                        "glosses": [
                            "Faisant partie du mouvement de l'écologie radicale qui identifie le système techno-industriel comme l'ennemi majeur du monde vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "314113dd-dd36-4d4d-b8c7-8c5d6dacc1d8",
                                "sense_id": "5873c1a3-d89e-38f0-884b-13068814a057",
                                "text": "«  Anti-Tech Resistance (ATR) est un mouvement révolutionnaire international qui a pour objectif de démanteler le système technologique pour stopper la dévastation du monde et empêcher l’extinction de l’espèce humaine.  »"
                            }
                        ]
                    }
