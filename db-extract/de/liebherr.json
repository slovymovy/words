                ],
                "senses": [
                    {
                        "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                        "entry_id": "f957f1c2-8e30-3975-8c49-83eb16199e9d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65545829-d19f-4ce3-ae7b-6aab71fe9a66",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Frau Liebherr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9c21b2b0-be09-4046-a32b-7a621c27aa2f",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Herr Liebherr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d4314033-f0a8-47b3-9b36-c318616e9461",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Die Liebherrs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "594da97d-4240-48f1-92a6-ed14f2f9a1e0",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Der Liebherr trägt nie die Schals, die die Liebherr ihm strickt."
                            },
                            {
                                "example_id": "a8336180-6abd-4df2-9746-6b2617fc2d0c",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Liebherr kommt, geht der Herr Liebherr.“"
                            },
                            {
                                "example_id": "5f10aea7-bf79-41ec-b86b-f4a61bf3a6ee",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Liebherr kommt und geht."
                            },
                            {
                                "example_id": "a3977efa-706c-4187-b5e0-903bda7fdbce",
                                "sense_id": "0f521504-7de7-344a-9fd3-40f6aa7be9fa",
                                "text": "Liebherrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
