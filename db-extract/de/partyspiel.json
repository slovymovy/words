                ],
                "senses": [
                    {
                        "sense_id": "cbfa075b-4186-3452-a09d-1149a842a893",
                        "entry_id": "eef55a9a-55fa-3552-86c7-a6b303f31d5e",
                        "glosses": [
                            "geselliges Spiel im Rahmen eines Festes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36fc7b7e-2432-4c29-b6ab-2aa10675153e",
                                "sense_id": "cbfa075b-4186-3452-a09d-1149a842a893",
                                "text": "„Im Laufe der Jahre fragten uns viele Eltern nach Partyspielen, besonders für Geburtstagsfeiern, bei denen nicht geweint, sondern gelacht wird.“"
                            },
                            {
                                "example_id": "bdc584a7-288b-415c-84c0-e1226c0a667a",
                                "sense_id": "cbfa075b-4186-3452-a09d-1149a842a893",
                                "text": "„Im Kapitel Kindergeburtstag ist dem speziellen Bedürfnis einer Festgestaltung für die jüngere, in den Partyspielen für die ältere Generation Rechnung getragen.“"
                            },
                            {
                                "example_id": "fc5f825a-2349-4b77-9f9c-0c31f5abc5b9",
                                "sense_id": "cbfa075b-4186-3452-a09d-1149a842a893",
                                "text": "„Und doch basiert der Erfolg der Bewegungssteuerung auf wenigen Spielen, die gezielt für diese Art des Inputs konzipiert wurden, allen voran Tanz-, Sport- und Partyspiele.“"
                            },
                            {
                                "example_id": "5b75eb07-bfe2-46a7-a130-98f52a6c234f",
                                "sense_id": "cbfa075b-4186-3452-a09d-1149a842a893",
                                "text": "„Zugrunde liegt das Muster des Partyspiels, dessen Teilnehmer aus vorgegebenen Begriffen eine Geschichte stricken müssen.“"
                            },
                            {
                                "example_id": "504c2f9f-e709-4f98-ac09-d5f917161abc",
                                "sense_id": "cbfa075b-4186-3452-a09d-1149a842a893",
                                "text": "„Daß diese Sorte Spiel auch ohne Aufnahmegerät herrliche Unsinns-Blüten treibt, ist in ‚Das große Haus- und Familienbuch der Spiele‘ in der Abteilung Partyspiele unter Gerichtstag nachzulesen, wo es um einen Elefantenraub geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
