{
    "word_family": [
        "aberrant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "032aab3e-d219-347d-ab25-def1b643db59",
                    "sense_definition": "A departure from what is considered normal, correct, or expected.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden drop in temperature was a strange <w>aberration</w> in the middle of summer.",
                            "target_lang_translations": {
                                "ru": "Внезапное падение температуры посреди лета было странной <w>аномалией</w>."
                            }
                        },
                        {
                            "text": "His aggressive behavior was an <w>aberration</w> from his usual calm and polite personality.",
                            "target_lang_translations": {
                                "ru": "Его агрессивное поведение было <w>отклонением</w> от привычного спокойного и вежливого характера."
                            }
                        }
                    ],
                    "synonyms": [
                        "anomaly",
                        "deviation",
                        "irregularity"
                    ],
                    "antonyms": [
                        "normality",
                        "regularity"
                    ],
                    "common_phrases": [
                        "minor aberration",
                        "statistical aberration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклонение от того, что считается нормальным, правильным или ожидаемым."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "от нормы или привычного порядка"
                            },
                            {
                                "target_lang_word": "аномалия",
                                "target_lang_sense_clarification": "необычное явление"
                            },
                            {
                                "target_lang_word": "аберрация",
                                "target_lang_sense_clarification": "книжное отклонение от нормы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4547042-2c61-3674-bc58-88eae63ba3f5",
                    "sense_definition": "A flaw in an optical system that prevents light from focusing correctly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "optical_defect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lens suffered from chromatic <w>aberration</w>, causing colored fringes around the edges of the image.",
                            "target_lang_translations": {
                                "ru": "Объектив страдал от хроматической <w>аберрации</w>, из-за чего по краям изображения возникала цветная кайма."
                            }
                        },
                        {
                            "text": "Engineers worked to correct the spherical <w>aberration</w> in the telescope's primary mirror.",
                            "target_lang_translations": {
                                "ru": "Инженеры работали над устранением сферической <w>аберрации</w> главного зеркала телескопа."
                            }
                        }
                    ],
                    "synonyms": [
                        "distortion"
                    ],
                    "common_phrases": [
                        "chromatic aberration",
                        "spherical aberration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дефект оптической системы, препятствующий правильной фокусировке света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аберрация",
                                "target_lang_sense_clarification": "в оптике"
                            },
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "оптическое несовершенство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c706506-3d8a-3dea-b2f3-3608859e3aa8",
                    "sense_definition": "A temporary or minor lapse in mental clarity or reason.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mental_lapse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He claimed his poor decision was just a momentary <w>aberration</w> of judgment.",
                            "target_lang_translations": {
                                "ru": "Он утверждал, что его неудачное решение было лишь минутным <w>помутнением рассудка</w>."
                            }
                        },
                        {
                            "text": "The witness suffered a brief <w>aberration</w> and could not recall the events clearly.",
                            "target_lang_translations": {
                                "ru": "У свидетеля произошло кратковременное <w>умопомрачение</w>, и он не смог чётко вспомнить события."
                            }
                        }
                    ],
                    "synonyms": [
                        "lapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временное помрачение рассудка или минутная неспособность здраво мыслить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помутнение рассудка",
                                "target_lang_sense_clarification": "временная утрата ясного мышления"
                            },
                            {
                                "target_lang_word": "умопомрачение",
                                "target_lang_sense_clarification": "минутная потеря способности соображать"
                            },
                            {
                                "target_lang_word": "заблуждение",
                                "target_lang_sense_clarification": "ошибочное умозаключение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}