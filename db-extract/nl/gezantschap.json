                    {
                        "sense_id": "aecb2bca-b9da-38f2-930e-4feb9d248961",
                        "entry_id": "f85e524e-2869-3460-9d2c-fafee1ed301c",
                        "glosses": [
                            "een diplomatieke vertegenwoordiging bestaande uit een gezant met al de hem toegevoegde personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0594b83-457d-4304-a4ee-9dd8e99710d7",
                                "sense_id": "aecb2bca-b9da-38f2-930e-4feb9d248961",
                                "text": "Mijn vader Antoine was de zoon van een Franse diplomaat in Stockholm, maar toen mama en hij elkaar ontmoetten, had een aantal Franse diplomaten hun baan opgezegd bij het gezantschap aan de Narvavâgen."
                            }
                        ]
