                                        "examples": [
                                            {
                                                "example_id": "9dca2b07-8c55-4a36-9e21-b46165f6a95c",
                                                "sense_id": "868eed91-abfc-30c7-ada2-b5f5743b586f",
                                                "text": "fallen raindrops"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f80290be-a507-3fe9-aa3d-499a6474f414",
                                        "entry_id": "c8831ae7-5fd0-31d0-b4c3-3301c2e1df6b",
                                        "glosses": [
                                            "Killed, especially in battle."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcca404d-5d26-4531-b605-9399cdfb3d71",
                                                "sense_id": "f80290be-a507-3fe9-aa3d-499a6474f414",
                                                "text": "a ceremony to honor fallen soldiers"
                                            },
                                            {
                                                "example_id": "a26e33cc-3f80-4e2b-abc8-ac4409ed0e95",
                                                "sense_id": "f80290be-a507-3fe9-aa3d-499a6474f414",
                                                "text": "the disposal of fallen livestock"
                                            },
                                            {
                                                "example_id": "4a04a7ee-533e-4d1e-8d0a-ac07c1640601",
                                                "sense_id": "f80290be-a507-3fe9-aa3d-499a6474f414",
                                                "text": "We will face the problems of peace with the same courage that we have faced and mastered the problems of war. In the memory of those that have made the supreme sacrifice, in the memory of our fallen president, we shall not fail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2b84f20-00aa-3b9c-8d98-91bcb1bc3856",
                                        "entry_id": "c8831ae7-5fd0-31d0-b4c3-3301c2e1df6b",
                                        "glosses": [
                                            "Having lost one's chastity."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11eaa369-ac59-4628-b173-e68e3007c097",
                                                "sense_id": "b2b84f20-00aa-3b9c-8d98-91bcb1bc3856",
                                                "text": "a fallen woman"
                                            },
                                            {
                                                "example_id": "1432f33b-e15a-4666-b339-e6e0d68d3d93",
                                                "sense_id": "b2b84f20-00aa-3b9c-8d98-91bcb1bc3856",
                                                "text": "Madam Julia was the town's ranking prostitute; virtuous female society demanded that they not suffer the unbearable pain of looking at, and being in company with, a fallen woman— one of the happiest, fallenest women in history, by the way."
                                            },
                                            {
                                                "example_id": "ae3147f4-cb22-4285-a33a-4db2bc329a31",
                                                "sense_id": "b2b84f20-00aa-3b9c-8d98-91bcb1bc3856",
                                                "text": "\"You make yourself out to be the fallenest of fallen women.\" Tilting her head toward Sharon, Debbie grinned. \"Let's face it. There can't be winners without losers, and I'm a loser. But look at it this way. I make it possible for some other woman[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae179d8-0890-3717-a31d-70f1bb82593f",
                                        "entry_id": "c8831ae7-5fd0-31d0-b4c3-3301c2e1df6b",
                                        "glosses": [
                                            "Having collapsed."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12fc2064-0323-4aef-8f40-7963a553b61b",
                                                "sense_id": "2ae179d8-0890-3717-a31d-70f1bb82593f",
                                                "text": "a fallen building"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89f7fb94-d725-36bb-aaaf-ba653245afc9",
                                        "entry_id": "c8831ae7-5fd0-31d0-b4c3-3301c2e1df6b",
                                        "glosses": [
                                            "Having lost prestige, (Christian) grace, etc."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64516381-622b-44bc-af56-8face4883487",
                                                "sense_id": "89f7fb94-d725-36bb-aaaf-ba653245afc9",
                                                "text": "That fallenest of our fallen race has left town — said to be near Fontainebleau by some, in Italy by others. More consequent with himself than usual, he is fulfilling, in the only possible way left open to him, his promise […]"
                                            }
                                        ]
                                    }
                                ]
                            },
