                                                "example_id": "f86b8655-6690-4e8f-a3f7-63a11a3e1be5",
                                                "sense_id": "efec280f-7c29-35f5-8cdd-562051b17994",
                                                "text": "Например, египтянка Эман эль-Марсафи, в прошлом служащая банка, изучает Коран и даже проповедует в одной из каирских мечетей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5cc57b-4904-30ed-8229-71f73b3111c5",
                                        "entry_id": "24da97e8-5cd9-3974-a86e-31af95f7f759",
                                        "glosses": [
                                            "истор. представительница народа Древнего Египта"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "511d9df7-7841-4619-a2ec-69000cc96d25",
                                                "sense_id": "2c5cc57b-4904-30ed-8229-71f73b3111c5",
                                                "text": "В Древнем Египте такие глаза назывались «говорящими» — тонкие чёрные чёрточки проводили египтянки от углов глаз к вискам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
