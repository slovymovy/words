                                    {
                                        "sense_id": "83a500b8-458f-3551-ad01-5f86ba8918de",
                                        "entry_id": "cefc57b8-c648-37d2-bdae-6713d8b933e0",
                                        "glosses": [
                                            "Tired; feeling the need for sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86658585-2846-48ad-a297-b377da02561d",
                                                "sense_id": "83a500b8-458f-3551-ad01-5f86ba8918de",
                                                "text": "She wak'd her sleepy crew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c24367d0-2bd1-3f3d-b0ca-adbb263145f4",
                                        "entry_id": "cefc57b8-c648-37d2-bdae-6713d8b933e0",
                                        "glosses": [
                                            "Suggesting tiredness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449d8bf9-1daf-4fa9-b184-81780c4abe93",
                                                "sense_id": "c24367d0-2bd1-3f3d-b0ca-adbb263145f4",
                                                "text": "At the very moment he cried out, David realised that what he had run into was only the Christmas tree. Disgusted with himself at such cowardice, he spat a needle from his mouth, stepped back from the tree and listened. There were no sounds of any movement upstairs: no shouts, no sleepy grumbles, only a gentle tinkle from the decorations as the tree had recovered from the collision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c3972c9-7111-3edb-a247-145e559c155f",
                                        "entry_id": "cefc57b8-c648-37d2-bdae-6713d8b933e0",
                                        "glosses": [
                                            "Tending to induce sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d4f4b3b-5f93-41b1-8bf0-a5b142550095",
                                                "sense_id": "0c3972c9-7111-3edb-a247-145e559c155f",
                                                "text": "a sleepy drink or potion"
                                            },
                                            {
                                                "example_id": "285ab66e-9aac-46b4-977f-f96663203b2a",
                                                "sense_id": "0c3972c9-7111-3edb-a247-145e559c155f",
                                                "text": "[T]he yong L. Roger Mortimer, […] hauing corrupted his Keepers, or (as ſome others vvrite) hauing potioned them vvith a ſleepy drinke, eſcaped out of the Tovver of London, getting ouer clearely vvithout any empeachment into France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d05c477-b1ec-3845-88a1-c61d12c0c3f0",
                                        "entry_id": "cefc57b8-c648-37d2-bdae-6713d8b933e0",
                                        "glosses": [
                                            "Dull; lazy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f466804-f306-4e85-a232-c4bfde3429de",
                                                "sense_id": "9d05c477-b1ec-3845-88a1-c61d12c0c3f0",
                                                "text": "'Tis not sleepy business;\nBut must be looked to speedily and strongly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "010b3d46-d727-39a3-8e1c-a72cf8ee3fc3",
                                        "entry_id": "cefc57b8-c648-37d2-bdae-6713d8b933e0",
                                        "glosses": [
                                            "Quiet; without bustle or activity."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81223e7-4286-41e4-b96d-a0246624551b",
                                                "sense_id": "010b3d46-d727-39a3-8e1c-a72cf8ee3fc3",
                                                "text": "a sleepy English village"
                                            },
                                            {
                                                "example_id": "e225ad27-2dd0-4479-84b9-0c0a5ea8a3ca",
                                                "sense_id": "010b3d46-d727-39a3-8e1c-a72cf8ee3fc3",
                                                "text": "Experts believe a pandemic welfare programme for poorer Brazilians has encouraged robbers to plan bold raids in sleepy regional cities where bank branches are storing more cash."
                                            },
                                            {
                                                "example_id": "3754b92d-0d1b-494b-8767-b66843522806",
                                                "sense_id": "010b3d46-d727-39a3-8e1c-a72cf8ee3fc3",
                                                "text": "Usually sleepy border crossings into Kazakhstan and Mongolia have also been overwhelmed by the sudden influx of Russians looking for a way out."
                                            },
                                            {
                                                "example_id": "208432cc-cf45-4a77-a2b7-83f428bc022a",
                                                "sense_id": "010b3d46-d727-39a3-8e1c-a72cf8ee3fc3",
                                                "text": "Despite Horwich's international fame as a centre of railway engineering, Horwich station itself was usually quite a sleepy place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sleepy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48940233-b0be-30c1-be35-fc52a4eff38a",
