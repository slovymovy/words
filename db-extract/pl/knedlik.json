                "senses": [
                    {
                        "sense_id": "37f2b72b-8c1c-36e4-b332-cda86b281451",
                        "entry_id": "ac193448-f6c2-3a06-947e-1c4a853fa8fd",
                        "glosses": [
                            "potrawa mączna kuchni czeskiej i słowackiej, przygotowywana z ciasta na bazie gotowanych ziemniaków lub bułki, gotowana w wodzie lub na parze"
                        ],
