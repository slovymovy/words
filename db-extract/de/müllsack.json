                "senses": [
                    {
                        "sense_id": "f007b3fe-64a6-3d38-814b-86c13f960061",
                        "entry_id": "6c54134d-de2e-3305-80d3-be5e02467928",
                        "glosses": [
                            "meist aus Plastik hergestellte Tüte zur temporären Aufbewahrung und Entsorgung von Müll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7afaf2cc-8120-4eda-932e-ee056995369b",
                                "sense_id": "f007b3fe-64a6-3d38-814b-86c13f960061",
                                "text": "Jeden Montag werden hier die Müllsäcke abgeholt."
                            },
                            {
                                "example_id": "e4233da5-2de2-46a5-81a0-4a984497d793",
                                "sense_id": "f007b3fe-64a6-3d38-814b-86c13f960061",
                                "text": "„Alle Jungs, die alt genug waren, einen Müllsack zu tragen, sprangen auf den erstbesten Zug.“"
                            },
                            {
                                "example_id": "f3716725-4168-43e1-b4ca-f71487a4b7d1",
                                "sense_id": "f007b3fe-64a6-3d38-814b-86c13f960061",
                                "text": "„Müllsäcke rollten umher, platzten auf und der Wind hetzte ihren Inhalt durch die engen Fluchten.“"
                            },
                            {
                                "example_id": "515b42c8-179c-431a-aee1-f43e668d6243",
                                "sense_id": "f007b3fe-64a6-3d38-814b-86c13f960061",
                                "text": "„Ich steckte ihre Pullover in Müllsäcke, ihre Blusen ereilte dasselbe Schicksal, sie flatterten ganz von selbst zu Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
