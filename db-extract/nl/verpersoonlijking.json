                        "sense_id": "81ac0f7d-9f0b-319d-9ff0-886db94ea9ff",
                        "entry_id": "05096cb2-c748-325d-82dc-f507b9dae708",
                        "glosses": [
                            "een abstract begrip voorstellen als een mens"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "94261aa1-daf6-3b88-b8c4-63750a797549",
                        "entry_id": "05096cb2-c748-325d-82dc-f507b9dae708",
                        "glosses": [
                            "persoon die een bepaald abstract begrip in een mens zichtbaar maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5364efb7-4925-4cd5-be54-f4de2ce842ed",
                                "sense_id": "94261aa1-daf6-3b88-b8c4-63750a797549",
                                "text": "Later zou Pierre van hen allemaal slechts een vage voorstelling hebben, maar Platon Karatajev bleef voor hem altijd een zeer levendige en dierbare herinnering, de verpersoonlijking van alles wat Russisch, goed en rond was."
                            },
                            {
                                "example_id": "91435180-c58b-4077-a191-8492037e903b",
                                "sense_id": "94261aa1-daf6-3b88-b8c4-63750a797549",
                                "text": "Haar aanhangers zien in Harris de verpersoonlijking van het steeds diversere Amerika en het bewijs dat in de Democratische partij minderheden meer en meer invloed krijgen. Tegelijkertijd is Harris een gematigd politicus, die op economisch gebied zeker niet tot de linkervleugel van de partij behoort zoals bijvoorbeeld Bernie Sanders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c42c192-2c87-4c0d-b7e0-fc20bc9d6f37",
                        "source_entry_id": "05096cb2-c748-325d-82dc-f507b9dae708",
                        "source_sense_id": "81ac0f7d-9f0b-319d-9ff0-886db94ea9ff",
                        "source_sense_description": "een abstract begrip voorstellen als een mens",
                        "target_lang_word": "personification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A person, thing or name typifying a certain quality or idea; an embodiment or exemplification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1688a5c0-8aa1-4e7b-b1ae-e6869779f355",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "Adolf Hitler was the personification of anti-Semitism."
                                            },
                                            {
                                                "example_id": "41d88554-d9b9-46bc-9aed-53309f6c53fb",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "He might have sat for a personification of fear: if he moved, he seemed rather afraid of his own shadow following him too closely; if he laughed, he soon checked himself, quite alarmed at the sound."
                                            },
                                            {
                                                "example_id": "4fa256ba-c9b9-447e-8bda-6eacb7666477",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "De Coude was the personification of coolness—was he not the best shot in France?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A literary device in which an inanimate object or an idea is given human qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261f660c-c3b9-4669-8b3e-f55079e01faf",
                                                "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                                "text": "The writer used personification to convey her ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "An artistic representation of an abstract quality as a human"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c6de46-4d09-475e-a82f-9e63dfe8bc6e",
                                                "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                                "text": "The Grim Reaper is a personification of death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
