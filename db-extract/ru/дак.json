                        "sense_id": "06520ccc-7753-3398-b775-85e0ad3c8ee8",
                        "entry_id": "f89ae09a-dd24-3bfa-9f13-c2eed9f870ab",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11f1e20-a877-49a2-b0f0-037eebdbfc32",
                                "sense_id": "06520ccc-7753-3398-b775-85e0ad3c8ee8",
                                "text": "Моего друга зовут Дак."
                            }
                        ]
                    }
                ],
                "translations": [],
