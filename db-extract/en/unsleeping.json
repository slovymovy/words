                "senses": [
                    {
                        "sense_id": "a3ee214d-c456-3623-bfaa-c65ce4b6209b",
                        "entry_id": "aacd1189-1b39-3b78-8e95-cfc8bb9d32cb",
                        "glosses": [
                            "Not sleeping."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fce7540-8e61-461a-a71d-f481f229fb4e",
                                "sense_id": "a3ee214d-c456-3623-bfaa-c65ce4b6209b",
                                "text": "All that night Saxon lay, unsleeping, without taking off her clothes, and when she arose in the morning and washed her face and dressed her hair she was aware of a strange numbness, of a feeling of constriction about her head as if it were bound by a heavy band of iron."
                            }
                        ]
                    },
                    {
                        "sense_id": "addb4964-682f-37b0-a8f4-b6c655a22588",
                        "entry_id": "aacd1189-1b39-3b78-8e95-cfc8bb9d32cb",
                        "glosses": [
                            "Remaining constantly alert."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7a155f23-3b0a-4b44-a54c-a29478581d51",
                                "sense_id": "addb4964-682f-37b0-a8f4-b6c655a22588",
                                "text": "Did you fixedly gaze, too, upon that ribbed and dented brow; there also, you would see still stranger foot-prints—the foot-prints of his one unsleeping, ever-pacing thought."
                            },
                            {
                                "example_id": "df4f12bd-0b8e-45a5-b494-de0a901a5fca",
                                "sense_id": "addb4964-682f-37b0-a8f4-b6c655a22588",
                                "text": "Captain Kennedy, who is the Commodore of the fleet, and so always commands the newest and best ship of the line, is an admirable seaman, with a quick eye for everything, always on deck at critical moments, watching with unsleeping vigilance over the safety of all on board."
                            },
                            {
                                "example_id": "4d8fe398-130f-4cda-8a6f-fdfcd09371df",
                                "sense_id": "addb4964-682f-37b0-a8f4-b6c655a22588",
                                "text": "An unsleeping eye watches the steam pressure and steadily regulates the firing much more economically and patiently than the most experienced fireman."
                            }
                        ]
                    },
                    {
                        "sense_id": "a472f18a-a5be-369c-bb6a-03c515f655bb",
                        "entry_id": "aacd1189-1b39-3b78-8e95-cfc8bb9d32cb",
                        "glosses": [
                            "Remaining constantly active."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b13f8e-098e-43cb-ba1d-88efdf6003ed",
                                "sense_id": "a472f18a-a5be-369c-bb6a-03c515f655bb",
                                "text": "Five hundred miles of moonlit fields and sleeping villages; of black towns and unsleeping furnaces; rain, fog, and frost; snow flurry and flood; tunnel and viaduct."
                            },
                            {
                                "example_id": "05256159-563c-4374-af0e-98201b0b5787",
                                "sense_id": "a472f18a-a5be-369c-bb6a-03c515f655bb",
                                "text": "A shiver of cool air wafted over her and passed; and she remembered her debt, and why she had come out. She looked down at the unsleeping river."
                            }
                        ]
                    }
