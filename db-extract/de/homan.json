                ],
                "senses": [
                    {
                        "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                        "entry_id": "86d2392f-ab6a-3629-8cde-30f5ebe92555",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51166137-5901-4f90-9c45-2f6e846f634a",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Frau Homan ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bf0c7b6f-6cd3-47c3-9023-4d9937865cf5",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Herr Homan wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "670d7a09-adb1-4639-bdbd-2e7aed58ac8c",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Die Homans fahren heute nach Budapest."
                            },
                            {
                                "example_id": "9a4529e9-d018-4a57-82e7-4a724bb655ef",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Der Homan trägt nie die Schals, die die Homan ihm strickt."
                            },
                            {
                                "example_id": "1b36ad8b-7c80-4507-be67-1f768fabbb03",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Homan kommt, geht der Herr Homan.“"
                            },
                            {
                                "example_id": "a8b1a0f8-7894-48ed-bf65-f6b04865f6bf",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Homan kommt und geht."
                            },
                            {
                                "example_id": "08685f2d-c32a-4e81-b507-e3433e371fc4",
                                "sense_id": "4552b9bf-87aa-321e-9e7b-d0b0002302c0",
                                "text": "Homans kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
