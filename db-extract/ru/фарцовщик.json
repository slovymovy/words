                                        "sense_id": "ad70ba30-4377-3320-b688-1258852103c4",
                                        "entry_id": "145be77a-10a6-3f59-9fa4-519148f605b7",
                                        "glosses": [
                                            "A specialist in marketing (promoting and selling products and services)."
                                        ],
