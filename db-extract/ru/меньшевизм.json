                                        "examples": [
                                            {
                                                "example_id": "600555aa-6a95-41e7-b2df-96661593fd00",
                                                "sense_id": "24ce7b82-c242-32ac-b207-f6496fb0c66d",
                                                "text": "Les vrais révolutionnaires, à leurs postes de combat, tentaient un suprême effort pour l’homogénéité d’un parti fort et efficacement révolutionnaire, apportant vraiment dans l’humanité le bienfait d’un changement politique et social profond, à la place d’un menchévisme de défaitisme, qui se mutilait définitivement."
                                            },
                                            {
                                                "example_id": "5f525a25-267f-497e-b216-aeb54fcc227a",
                                                "sense_id": "24ce7b82-c242-32ac-b207-f6496fb0c66d",
                                                "text": "Martov, le futur leader du menchévisme, prit figure de modéré."
                                            }
