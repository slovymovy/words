                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad48308-7950-41bc-89ad-5354d220005e",
                                "sense_id": "d8cb04e6-d2ff-344e-abee-a937f1739fb4",
                                "text": "Tous les organes placés à la périphérie du corps, toutes les tumeurs superficielles, et même tous les points de l'appareil tégumentaire, peuvent être le siège d'une compression spéciale."
                            },
                            {
                                "example_id": "4199e70b-0727-46dd-9da5-83c6cb9cfc2b",
                                "sense_id": "d8cb04e6-d2ff-344e-abee-a937f1739fb4",
                                "text": "[L'embryon] est protégé d'enveloppes tégumentaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ba08b3d-915d-3017-9d70-2a76ea0d9282",
                        "entry_id": "067489f3-f38b-3c13-bc75-1d61d6295e34",
                        "glosses": [
                            "Qui affecte le tégument."
                        ],
                        "tags": [],
                        "examples": [
                            {
