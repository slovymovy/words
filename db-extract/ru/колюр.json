                        "glosses": [
                            "астрон. один из двух больших кругов небесной сферы, разделяющих экватор и зодиак на четыре равные части и служащих для счислительного означения четырёх времён года"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d10124-eb19-49a7-8db8-2b80d8e08031",
                                "sense_id": "ef8e6fbf-08e5-3999-a96b-0616e279ff02",
                                "text": "Колюр солнцестояний проходит близ звезд южных созвездий Жертвенника и Киля."
                            }
                        ]
                    }
