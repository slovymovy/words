                ],
                "senses": [
                    {
                        "sense_id": "059190fd-15a9-37a5-ad2b-b6c2a367fcce",
                        "entry_id": "3ecbe49d-0d13-300e-ac34-fdd555263747",
                        "glosses": [
                            "runder, meist flacher Teil des Essgeschirrs aus Polymer, auf dem die Speisen vor dem Verzehr angerichtet werden"
                        ],
                        "tags": [
                            "Kunststoffgefäß"
                        ],
                        "examples": [
                            {
                                "example_id": "2d633583-7460-49f4-aa29-1b962e058f86",
                                "sense_id": "059190fd-15a9-37a5-ad2b-b6c2a367fcce",
                                "text": "„Mit unseren bunten Kunststofftellern, Kühltaschen, glänzenden Kunststoffweingläsern und Kühlern wird es ein unvergessliches Erlebnis!“"
                            },
                            {
                                "example_id": "f62e9d85-7960-4394-ae69-fea1a37051e9",
                                "sense_id": "059190fd-15a9-37a5-ad2b-b6c2a367fcce",
                                "text": "„Kunststoffteller sind strapazierfähig und wärmespeichernd.“"
                            },
                            {
                                "example_id": "ca3dd3e9-775c-4324-90b8-9eaa4166f1eb",
                                "sense_id": "059190fd-15a9-37a5-ad2b-b6c2a367fcce",
                                "text": "„Von Table Stories, der fabelhaften Serie von Tord Boontje, die Geschichten aus einer Fabelwelt erzählt, bis hin zu zauberhaften Kunststofftellern für Ihre Gartenparty oder Ihr Zuhause bieten wir Ihnen eine reiche Auswahl unterschiedlichster Teller.“"
                            },
                            {
                                "example_id": "e55c6d48-0a90-4e70-922e-8b6cce8b5846",
                                "sense_id": "059190fd-15a9-37a5-ad2b-b6c2a367fcce",
                                "text": "„Auf einem grünen Kunststoffteller liegt ein wenig Kunstschnee und 12 kleine Weihnachtskugeln aus Kunststoff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
