                                "target_senses": [
                                    {
                                        "sense_id": "fdac34ec-c4c2-3e43-a988-05e7f2565625",
                                        "entry_id": "65c3bc74-bdf5-306b-83fe-2ef3e9c7d8aa",
                                        "glosses": [
                                            "A simple lensless device for producing a photographic image, consisting of an enclosed box with film or some other flat photosensitive surface on one interior side and a tiny hole in the opposite side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1273fa55-d660-431b-8e43-ef90df4213b2",
                                                "sense_id": "fdac34ec-c4c2-3e43-a988-05e7f2565625",
                                                "text": "Many of today's photographers forget that a pinhole camera — essentially a small box with a hole in it — can be used to produce a quality photograph."
                                            },
                                            {
                                                "example_id": "1f6d2071-d3c8-4579-8c96-6c76fb2a4838",
                                                "sense_id": "fdac34ec-c4c2-3e43-a988-05e7f2565625",
                                                "text": "There are never-published treasures like British entrepreneur William Turner's scenes of Shanghai life in the early 1900s — probably taken with a homemade pinhole camera."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
