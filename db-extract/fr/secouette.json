                        "glosses": [
                            "Tabatière de forme lenticulaire pour le tabac à priser."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e011eaf4-b8b5-4136-a51f-a6f07c2d3184",
                                "sense_id": "e2a8380f-3ae5-3338-b6c2-32d4736eedf8",
                                "text": "Secouettes, touines ou pétuniers [ ] petites bouteilles sphériques et plates (forme lenticulaire), pour garder le tabac à priser dans la poche."
                            },
                            {
                                "example_id": "dfbd33bf-02d1-4446-a2e0-704d0efa3b84",
                                "sense_id": "e2a8380f-3ae5-3338-b6c2-32d4736eedf8",
                                "text": "La différence entre une tabatière et une secouette à tabac ? La tabatière est généralement une boîte avec un couvercle permettant d’accéder à la prise en pinçant des brins de tabac. La secouette est un récipient fermé. Le tabac sort par un orifice en secouant l’objet en direction du creux de la main, entre le pouce et l’index."
                            }
                        ]
                    },
