        "fr-extract.jsonl": [
            {
                "entry_id": "04e265ae-3f36-34e0-a64c-8caa46ff85ec",
                "word": "implant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6bb8a58f-3541-4c2c-a1d1-f0986b59b950",
                        "entry_id": "04e265ae-3f36-34e0-a64c-8caa46ff85ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "implants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50429505-4c00-3da7-9718-66727cf5724e",
                        "entry_id": "04e265ae-3f36-34e0-a64c-8caa46ff85ec",
                        "glosses": [
                            "Greffe ou prothèse dont le but est esthétique ou médical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1196386a-2508-4e60-85c5-9d096a6a7d95",
                                "sense_id": "50429505-4c00-3da7-9718-66727cf5724e",
                                "text": "Des implants capillaires dont le but est de rendre plus beau."
                            },
                            {
                                "example_id": "389abb86-5b33-4991-9915-57b821b52011",
                                "sense_id": "50429505-4c00-3da7-9718-66727cf5724e",
                                "text": "Un implant mammaire."
                            },
                            {
                                "example_id": "08028560-ce46-4148-8061-5d134356c630",
                                "sense_id": "50429505-4c00-3da7-9718-66727cf5724e",
                                "text": "C'est un pas de plus dans la recherche d'une solution pour redonner la vue aux personnes aveugles : des scientifiques ont conçu et testé chez des singes un implant cérébral qui leur a permis de percevoir des formes créées artificiellement et de meilleure résolution que ce qui était possible jusqu'à présent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b524cbf4-88e1-4b1e-bc2e-0300668a6527",
                        "source_entry_id": "04e265ae-3f36-34e0-a64c-8caa46ff85ec",
                        "source_sense_id": "50429505-4c00-3da7-9718-66727cf5724e",
                        "target_lang_word": "Implantat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Implantat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                                        "glosses": [
                                            "in den Körper operativ eingepflanztes künstliches Gerät, das dort permanent oder zumindest für einen längeren Zeitraum verbleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63c3e2fe-0281-4a0b-9eca-849d94cb9457",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "Die Chirurgen setzen dem Patienten in einer dreistündigen Operation ein Implantat in den Knochen."
                                            },
                                            {
                                                "example_id": "6b3af04a-ff14-4af9-bbbc-8f98962d19b5",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "Statt Sport zu treiben, ließ sich Klaus Implantate in die Waden einsetzen."
                                            },
                                            {
                                                "example_id": "8d0cad82-25e7-425f-8b0b-c328e04ac4c0",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "„Aus der Altersschwerhörigkeit führt kein Weg heraus, da können nur noch Hörgeräte oder Implantate helfen.“"
                                            },
                                            {
                                                "example_id": "63c1f1d5-3d28-4d4c-999b-b280de0ec835",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "„Die Patientinnen sollen am besten mit ihrem Arzt sprechen und per Ultraschall oder Kernspintomografie erfassen lassen, ob ihr Implantat möglicherweise beschädigt ist.“"
                                            },
                                            {
                                                "example_id": "f0eb3977-13c8-451b-abd5-a6c2328af0b8",
                                                "sense_id": "e1da320c-78b8-35c0-a573-a484045699fb",
                                                "text": "„Den mümmelnden Greis gibt es nicht mehr. Er trägt Implantate.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44435e4b-8bba-35a5-bed1-3b48f8db7993",
                                        "entry_id": "9079eeac-f61c-319d-8f25-95bec95e5ab9",
                                        "glosses": [
                                            "Platzierung von Zähnen in nicht besetzte Zahnkammern (Alveolen)"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf400c65-94d3-4514-a499-fd920b98e797",
                                                "sense_id": "44435e4b-8bba-35a5-bed1-3b48f8db7993",
                                                "text": "„Die gute Nachricht: Wer Wert auf ein Implantat legt, um Zahnverlust zu verbergen und so auch Kau- und Sprechproblemen vorzubeugen, kann einem bereits begonnenen Abbau der Alveolen entgegenwirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21b1f43d-2316-4992-90bc-9113974bd07e",
                        "source_entry_id": "04e265ae-3f36-34e0-a64c-8caa46ff85ec",
                        "source_sense_id": "50429505-4c00-3da7-9718-66727cf5724e",
                        "target_lang_word": "implant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implant",
