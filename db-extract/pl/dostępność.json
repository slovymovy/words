                    },
                    {
                        "translation_id": "b0b0d9a1-10ca-48f3-9762-a309ccb4e18b",
                        "source_entry_id": "44bcc089-d839-367d-b58c-448e36ebd66f",
                        "source_sense_id": "ea45220c-029c-3d0c-91f8-0cf986239924",
                        "target_lang_word": "Verständlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verständlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddbb665f-82dc-3f95-8432-ad29eb828b0e",
                                        "entry_id": "4b980f5b-f5a0-3793-8c35-bd2bb811d464",
                                        "glosses": [
                                            "Eigenschaft eines sprachlichen Textes, eines musikalischen oder künstlerischen Werkes, durch Rezipienten mehr oder weniger leicht und angemessen aufgefasst werden zu können."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93993faa-505a-48cd-8022-f2ac8eeac111",
                                                "sense_id": "ddbb665f-82dc-3f95-8432-ad29eb828b0e",
                                                "text": "Der Text hat durch die vielfache Bearbeitung die Verständlichkeit verloren."
                                            },
                                            {
                                                "example_id": "6a7d1580-1e74-4a3a-b0e6-5e539cb249cd",
                                                "sense_id": "ddbb665f-82dc-3f95-8432-ad29eb828b0e",
                                                "text": "„Anhand von konkreten Beispielen zeigte Thieme, wie wichtig der mutige »Blick von außen« auf Gesetzestexte und Verordnungen ist und wie Verständlichkeit verbessert werden kann.“"
                                            },
                                            {
                                                "example_id": "b7f3f7c4-7c5c-486e-ae2c-972ab4bbf11e",
                                                "sense_id": "ddbb665f-82dc-3f95-8432-ad29eb828b0e",
                                                "text": "„Maßstäbe für eine Rechtfertigung sind die Wahrhaftigkeit, Relevanz und Verständlichkeit des Gesagten.“"
                                            },
                                            {
                                                "example_id": "d3ff20b6-08f3-4ff1-8bdc-b5cdb92b3d79",
                                                "sense_id": "ddbb665f-82dc-3f95-8432-ad29eb828b0e",
                                                "text": "„Kurz, als unerläßliche Tugend, ja Sinn unseres Sprechens und Schreibens ist Verständlichkeit zweifellos höchst wichtig, doch bei weitem nicht alles, wenn es um guten Stil geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c012b15-3182-3e03-9a25-c072dbe8e00c",
                                        "entry_id": "4b980f5b-f5a0-3793-8c35-bd2bb811d464",
                                        "glosses": [
                                            "Eigenschaft von sprachlichen Texten, die auf Leserlichkeit, Lesbarkeit und weiteren Merkmalen wie Gegliedertheit und Stimulanz beruht."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29eefbbc-7b27-47cc-aacd-cd55007bc27f",
                                                "sense_id": "9c012b15-3182-3e03-9a25-c072dbe8e00c",
                                                "text": "Aufschluss über die Verständlichkeit von Texten geben ein Lesbarkeitsindex und eine Reihe weiterer Testverfahren (darunter: semantisches Differential, cloze procedure)."
                                            },
                                            {
                                                "example_id": "d330fd82-1b08-4d72-b0f1-dab06db2de11",
                                                "sense_id": "9c012b15-3182-3e03-9a25-c072dbe8e00c",
                                                "text": "„Insbesondere die Frage, welchen Einfluss das Passiv auf die Verständlichkeit von Texten und Sätzen hat, wurde immer wieder zum Gegenstand empirischer Forschung in Sprachwissenschaft und Psychologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
