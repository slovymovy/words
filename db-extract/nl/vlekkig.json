                                                "sense_id": "f9be1f7a-d8d7-377f-a7f3-8ef9a6e88148",
                                                "text": "The old flag was a dirty white."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f6ac6f-d7ed-3eec-8dc7-f5fde2937dd4",
