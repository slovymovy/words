            "senses": [
                {
                    "sense_id": "6a586e52-d928-3c72-b350-8adc48b3effe",
                    "sense_definition": "Vervoeging van <w>wijzen</w>: eerste persoon enkelvoud tegenwoordige tijd, gebiedende wijs of inversie tweede persoon enkelvoud.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wijs</w> de toerist de weg naar het station.",
                            "target_lang_translations": {
                                "en": "I <w>show</w> the tourist the way to the station.",
                                "ru": "Я <w>показываю</w> туристу дорогу на вокзал.",
                                "fr": "J' <w>indique</w> le chemin de la gare au touriste.",
                                "zh": "我给游客<w>指</w>了去车站的路。"
                            }
                        },
                        {
                            "text": "<w>Wijs</w> niet met je vinger naar andere mensen, dat is onbeleefd.",
                            "target_lang_translations": {
                                "en": "Do not <w>point</w> your finger at other people, that is rude.",
                                "ru": "Не <w>показывай</w> пальцем на других людей, это невежливо.",
                                "fr": "Ne <w>pointe</w> pas les autres gens du doigt, c'est impoli.",
                                "zh": "不要用手指<w>指</w>别人，那样很不礼貌。"
                            }
                        },
                        {
                            "text": "<w>Wijs</w> jij even aan waar we nu precies zijn op de kaart?",
                            "target_lang_translations": {
                                "en": "Can you just <w>point out</w> exactly where we are on the map?",
                                "ru": "<w>Покажешь</w> мне, где именно мы находимся на карте?",
                                "fr": "Peux-tu <w>montrer</w> exactement où nous sommes sur la carte ?",
                                "zh": "你能帮我<w>指出</w>我们在地图上的确切位置吗？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
