                        "sense_id": "e5089a68-e2c8-3fbf-b3ef-cf8efaef3ca5",
                        "entry_id": "8c5c73fa-c231-39bc-b9c2-6d51afdb7ceb",
                        "glosses": [
                            "Féminin singulier de ingénieux."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6ffeb5a6-0b8f-4fe1-8597-41c3f7bd7e57",
                                "sense_id": "e5089a68-e2c8-3fbf-b3ef-cf8efaef3ca5",
                                "text": "Pour détourner le cours des épigrammes faciles, les Arboisiens ont eu l’ingénieuse pensée d’appeler leurs voisins salinois les « glorieux de Salins »."
                            },
                            {
                                "example_id": "c3b6961e-8b52-404a-8fd4-0f725d53360c",
                                "sense_id": "e5089a68-e2c8-3fbf-b3ef-cf8efaef3ca5",
                                "text": "Lorsque la finesse d’une saillie ne consiste pas dans une équivoque, mais dans une idée ingénieuse, exprimée avec précision, ce n’est plus un jeu de mots ; c’est véritablement un bon mot."
                            }
                        ]
                    }
