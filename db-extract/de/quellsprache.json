                ],
                "senses": [
                    {
                        "sense_id": "85195d01-43ee-3133-b6d5-8a8b061ddc45",
                        "entry_id": "b2408bcb-fb2f-3f91-bbfc-56c799110cc2",
                        "glosses": [
                            "Programmiersprache, in der ein Programmcode geschrieben wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b43145-e22a-4b93-b97f-334b7dac7ae1",
                                "sense_id": "85195d01-43ee-3133-b6d5-8a8b061ddc45",
                                "text": "„Die Programmiersprache A, aus der die zu übersetzenden Programme stammen, wird dabei als Quellsprache, die Programmiersprache B als Zielsprache des Übersetzers bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5e0bfe60-cb2a-3e0b-ba5d-66b79a817fd4",
                        "entry_id": "b2408bcb-fb2f-3f91-bbfc-56c799110cc2",
                        "glosses": [
                            "Sprache, aus der ein Wort oder eine sonstige sprachliche Einheit in eine andere übernommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c83c650d-4db0-4874-b5a5-f099991a2dee",
                                "sense_id": "5e0bfe60-cb2a-3e0b-ba5d-66b79a817fd4",
                                "text": "„Ein Lehnwort ist das Ergebnis einer sprachlichen Entlehnung, bei der ein Wort aus einer Sprache (Gebersprache, Quellsprache) in eine (Nehmersprache, Zielsprache) übernommen wird."
                            },
                            {
                                "example_id": "7a780f58-61db-4390-93ed-58f5627ac416",
                                "sense_id": "5e0bfe60-cb2a-3e0b-ba5d-66b79a817fd4",
                                "text": "„Üblicherweise werden im Deutschen Entlehnungen aus dem Englischen, Französischen und Italienischen in der Aussprache und Schreibung der Quellsprache übernommen.“"
                            },
                            {
                                "example_id": "f4c2fa25-aee4-40e5-b282-7b1e0e11d70c",
                                "sense_id": "5e0bfe60-cb2a-3e0b-ba5d-66b79a817fd4",
                                "text": "„Unter dem Begriff »Komponenten« werden dagegen jene Elemente der Quellsprachen zusammengefasst, welche tatsächlich in das Jiddische eingegangen sind.“"
                            },
                            {
                                "example_id": "f5278ecc-ee6f-484b-898d-6579fc43acd8",
                                "sense_id": "5e0bfe60-cb2a-3e0b-ba5d-66b79a817fd4",
                                "text": "„Stattdessen weist eine Komponentensprache ein gegenüber den Quellsprachen eigenständiges grammatisches System, eigene Wortbildungsmuster und eigene semantische Felder auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "d8b433ca-63d9-371d-ae89-398721af127a",
                        "entry_id": "b2408bcb-fb2f-3f91-bbfc-56c799110cc2",
                        "glosses": [
                            "Sprache, aus der in eine andere Sprache, die Zielsprache, übersetzt wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686210f4-b665-4004-ac70-454469baee63",
                                "sense_id": "d8b433ca-63d9-371d-ae89-398721af127a",
                                "text": "„Die Quellsprache ist die Sprache, in der der Originaltext geschrieben ist. Die Zielsprache ist die Sprache, in die der Text übersetzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
