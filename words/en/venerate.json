{
    "word_family": [
        "veneration",
        "venerable",
        "venerator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "09b97f7c-42f0-3d36-8826-becd955713c9",
                    "sense_definition": "To treat with great respect and deference.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many cultures <w>venerate</w> their ancestors through elaborate annual ceremonies.",
                            "target_lang_translations": {
                                "ru": "Во многих культурах <w>почитают</w> своих предков, проводя сложные ежегодные церемонии."
                            }
                        },
                        {
                            "text": "The students <w>venerate</w> the professor for her lifelong dedication to scientific research.",
                            "target_lang_translations": {
                                "ru": "Студенты <w>глубоко уважают</w> профессора за её многолетнюю преданность научным исследованиям."
                            }
                        }
                    ],
                    "synonyms": [
                        "revere",
                        "honor",
                        "respect"
                    ],
                    "antonyms": [
                        "despise",
                        "disrespect"
                    ],
                    "common_phrases": [
                        "venerate ancestors",
                        "venerate tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться к кому-либо или чему-либо с глубоким уважением и почтением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почитать",
                                "target_lang_sense_clarification": "относиться с глубоким уважением"
                            },
                            {
                                "target_lang_word": "чтить",
                                "target_lang_sense_clarification": "память, традиции, предков"
                            },
                            {
                                "target_lang_word": "глубоко уважать",
                                "target_lang_sense_clarification": "испытывать высокое уважение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce0e38dd-fe70-32fa-a8ff-971967a7592b",
                    "sense_definition": "To revere or hold in awe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient civilization continued to <w>venerate</w> the mountain as a sacred deity.",
                            "target_lang_translations": {
                                "ru": "Древняя цивилизация продолжала <w>почитать</w> эту гору как священное божество."
                            }
                        },
                        {
                            "text": "Scholars <w>venerate</w> the author for his profound influence on modern literature.",
                            "target_lang_translations": {
                                "ru": "Учёные <w>преклоняются перед</w> автором за его глубокое влияние на современную литературу."
                            }
                        }
                    ],
                    "synonyms": [
                        "revere",
                        "adore",
                        "worship"
                    ],
                    "common_phrases": [
                        "venerate the past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать благоговение, глубокий трепет или религиозное поклонение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преклоняться",
                                "target_lang_sense_clarification": "перед кем-либо или чем-либо с благоговением"
                            },
                            {
                                "target_lang_word": "благоговеть",
                                "target_lang_sense_clarification": "испытывать трепет и священный восторг"
                            },
                            {
                                "target_lang_word": "боготворить",
                                "target_lang_sense_clarification": "почитать как божество"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}