                                                "text": "literary conversation"
                                            },
                                            {
                                                "example_id": "7577563f-2a1a-43de-850a-f911ceaa0496",
                                                "sense_id": "99df58a0-5c7f-3ea1-bf4c-6ded893ecffa",
                                                "text": "He has long outlived his century, the term commonly fixed as the test of literary merit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1760441d-ee43-3233-9485-73c4a99f0699",
