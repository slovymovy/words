                "forms": [],
                "senses": [
                    {
                        "sense_id": "f281624e-16ec-37d6-a49d-a3d73b391547",
                        "entry_id": "54d8be9f-a4e3-3de2-9c30-312d28cae71f",
                        "glosses": [
                            "oplettend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13c710ee-d2a8-4ada-bea7-e2e7855f7b6e",
                                "sense_id": "f281624e-16ec-37d6-a49d-a3d73b391547",
                                "text": "Waakzaam schoten mijn ogen alle kanten op, speurend naar verborgen slangen in het struikgewas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "710e7a3d-a7fa-4b2e-bd79-d528e56c01cf",
                        "source_entry_id": "54d8be9f-a4e3-3de2-9c30-312d28cae71f",
                        "source_sense_id": "f281624e-16ec-37d6-a49d-a3d73b391547",
                        "source_sense_description": "oplettend",
                        "target_lang_word": "wachsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wachsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f252a0c-93d0-3144-871a-38ded4a257a0",
                                        "entry_id": "b4eecb98-6004-341d-b6fe-e846c1dac3cc",
                                        "glosses": [
                                            "Geschehnisse aufmerksam verfolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d4cdf53-1e53-45f6-88c7-f581c9ff515a",
                                                "sense_id": "7f252a0c-93d0-3144-871a-38ded4a257a0",
                                                "text": "Ein wachsamer Hund kann vor größerem Schaden bewahren."
                                            },
                                            {
                                                "example_id": "6bd34b1b-d8c3-461b-9f24-ae09aa4690ae",
                                                "sense_id": "7f252a0c-93d0-3144-871a-38ded4a257a0",
                                                "text": "„Menschen seid wachsam!“ (Julius Fučík vor seiner Hinrichtung)"
                                            },
                                            {
                                                "example_id": "1a36d4ea-dd19-4436-9649-f418cdc88a01",
                                                "sense_id": "7f252a0c-93d0-3144-871a-38ded4a257a0",
                                                "text": "„Justizminister Jürgen Banzer und Innenminister Volker Bouffier (beide CDU) versprechen sich davon nach eigenen Worten einen besseren Schutz der Bevölkerung vor rückfallgefährdeten Sexualstraftätern: ‚Auch nach der Haftentlassung haben Justiz und Polizei ein wachsames Auge.‘“"
                                            },
                                            {
                                                "example_id": "42326abc-bf5b-4b75-82ac-5742d98999c5",
                                                "sense_id": "7f252a0c-93d0-3144-871a-38ded4a257a0",
                                                "text": "„Die wachsamen Ameisen vertreiben nämlich auch jene Parasiten, die sonst die Käferlarven drastisch dezimieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "120c8b2e-4259-4944-8da5-81e2ed1085a7",
                        "source_entry_id": "54d8be9f-a4e3-3de2-9c30-312d28cae71f",
                        "source_sense_id": "f281624e-16ec-37d6-a49d-a3d73b391547",
                        "source_sense_description": "oplettend",
                        "target_lang_word": "watchful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watchful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "907b09f7-5d42-3f9a-b5e3-778f204cfceb",
                                        "entry_id": "20da89d1-6748-3fb4-9853-239b60d81941",
                                        "glosses": [
                                            "Fully observant, vigilant, or aware."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a774e4d-763d-460a-a479-7cca4f1acf22",
                                                "sense_id": "907b09f7-5d42-3f9a-b5e3-778f204cfceb",
                                                "text": "The teacher kept a watchful eye on her pupils during the school trip."
                                            },
                                            {
                                                "example_id": "dcc0e149-5485-4e7b-be9c-827b5e20bf1c",
                                                "sense_id": "907b09f7-5d42-3f9a-b5e3-778f204cfceb",
                                                "text": "But there was so much at stake that I had to take some risk—though even when I was far away there has never been a day when the Shire has not been guarded by watchful eyes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fedbb021-7147-4794-a1ba-1344e6f97317",
                        "source_entry_id": "54d8be9f-a4e3-3de2-9c30-312d28cae71f",
                        "source_sense_id": "f281624e-16ec-37d6-a49d-a3d73b391547",
                        "source_sense_description": "oplettend",
                        "target_lang_word": "vigilant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigilant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "671e2b07-b642-3001-a91a-208b33301fb0",
                                        "entry_id": "007007a1-3da8-35ff-b4df-0d95f84b673e",
                                        "glosses": [
                                            "Qui veille avec attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41cbcb0-72db-449d-976f-6a6e5cbe14a1",
                                                "sense_id": "671e2b07-b642-3001-a91a-208b33301fb0",
                                                "text": "Ce titre, si glorieux pour un roi, est mérité par la sagesse d'une administration vigilante malgré les désastres amenés par des guerres presque toujours malheureuses."
                                            },
                                            {
                                                "example_id": "15520666-c72d-4560-b44a-d5be58e1ec4b",
                                                "sense_id": "671e2b07-b642-3001-a91a-208b33301fb0",
                                                "text": "Certes, il était vigilant : attentif à tout, depuis le podium, jetant un regard aux grandes affirmations que renferment ces Confessions de foi sans se sentir lié par la lettre de leurs formules, […]."
                                            },
                                            {
                                                "example_id": "2b4136fe-c777-4a65-a1c1-aeb28df9611f",
                                                "sense_id": "671e2b07-b642-3001-a91a-208b33301fb0",
                                                "text": "Des veilles vigilantes seront tournées vers la prévention des épidémies, des coopérations seront impulsées pour compenser les déséquilibres ou les désastres provoqués par des cataclysmes telluriques ou climatiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vigilant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b59937ac-daae-3ae0-9620-6b447f2e10d7",
                                        "entry_id": "44c2c941-90af-3153-87da-faa08885f3df",
                                        "glosses": [
                                            "Participe présent de vigiler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
