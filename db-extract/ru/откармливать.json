                    }
                ],
                "translations": [
                    {
                        "translation_id": "25a1ccb8-8e9e-4ef4-8dca-c6c0e81fb495",
                        "source_entry_id": "1826ec3a-e12d-374d-b64c-afa487ff3a70",
                        "target_lang_word": "engraisser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engraisser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e18434-39b7-3598-87f6-c421395aea05",
                                        "entry_id": "4ea5c6d7-bae2-3be7-8469-b79877f57cf8",
                                        "glosses": [
                                            "Faire devenir gras ou gros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "346beeea-282f-4545-af28-a2886360a143",
                                                "sense_id": "d5e18434-39b7-3598-87f6-c421395aea05",
                                                "text": "Il parait qu'à Strasbourg on engraisse les carpeaux du Rhin, et on les fait grossir dans des réservoirs d’où on les tire pour les demandes du pays, et souvent de Paris."
                                            },
                                            {
                                                "example_id": "b0151db8-5a7a-4705-a968-8e2644c28962",
                                                "sense_id": "d5e18434-39b7-3598-87f6-c421395aea05",
                                                "text": "On ne peut avoir la prétention de défendre au vendeur d’engraisser son cheval, avant la vente, de la manière qui lui convient ; c’est une adresse ou une supercherie qui rend la marchandise attrayante."
                                            },
                                            {
                                                "example_id": "e3541ca0-980f-46b2-a69b-4318eacd9d7d",
                                                "sense_id": "d5e18434-39b7-3598-87f6-c421395aea05",
                                                "text": "Avec leurs pommes de terre, leurs châtaignes et leur seigle, les paysans du Ségala engraissent de nombreux troupeaux de porcs dont ils tirent beaucoup d'argent."
                                            },
                                            {
                                                "example_id": "00620e08-c27b-4b01-9ad5-8f6fc96b5ce0",
                                                "sense_id": "d5e18434-39b7-3598-87f6-c421395aea05",
                                                "text": "Si vous me parlez que ça se mange alors c'est sans doute l'histoire des baby-bœufs dont on a beaucoup parlé récemment, ces pauvres bêtes que l'on engraissait artificiellement rien que pour la boucherie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1bff9a0-3f1a-3ce0-a1dc-d3f624c552b6",
                                        "entry_id": "4ea5c6d7-bae2-3be7-8469-b79877f57cf8",
                                        "glosses": [
                                            "Amender, fertiliser, améliorer, en parlant des terres, y répandre de l'engrais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a3c112-e61f-4f6a-82a5-7c6b2f1a954a",
                                                "sense_id": "e1bff9a0-3f1a-3ce0-a1dc-d3f624c552b6",
                                                "text": "Le camion dont la benne était vide vint prendre la place de celui qui venait d’emporter la barrière et le premier chargement de cette bonne terre noire que le père avait engraissée de tant de fumier, et si souvent mouillée de sa sueur."
                                            },
                                            {
                                                "example_id": "2f59bfad-8e9f-4be8-9ce2-defe82cdcdbd",
                                                "sense_id": "e1bff9a0-3f1a-3ce0-a1dc-d3f624c552b6",
                                                "text": "Et leur matière est perdue alors qu'elle pourrait engraisser les champs."
                                            },
                                            {
                                                "example_id": "cedacd61-bca3-4ead-b1a1-71705339d52e",
                                                "sense_id": "e1bff9a0-3f1a-3ce0-a1dc-d3f624c552b6",
                                                "text": "Il n'est pas rare de voir les maraîchers rétais charger le varech providentiel sur leurs remorques pour en engraisser les parcelles de pommes de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab2d337-5b84-30c0-b6b1-85f1ca40a00f",
                                        "entry_id": "4ea5c6d7-bae2-3be7-8469-b79877f57cf8",
                                        "glosses": [
                                            "Remettre en état une plage dégradée par les intempéries."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cc1ce89-7035-45c6-943a-b8945d6f76e2",
                                                "sense_id": "fab2d337-5b84-30c0-b6b1-85f1ca40a00f",
                                                "text": "Les plages de Nice ont perdu trop de galets avec l'érosion. Il faut donc les engraisser pour la saison estivale qui arrive. — (https://france3-regions.francetvinfo.fr/provence-alpes-cote-d-azur/alpes-maritimes/nice/nice-plages-engraissees-ete-1454499.html)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37bd1d8-8c77-3271-b179-22bafc19429a",
                                        "entry_id": "4ea5c6d7-bae2-3be7-8469-b79877f57cf8",
                                        "glosses": [
                                            "Prendre du poids ; devenir plus gras."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb440bd-872a-4318-903b-7987fc66570f",
                                                "sense_id": "a37bd1d8-8c77-3271-b179-22bafc19429a",
                                                "text": "C'était une malédiction d'être si belle et, à l'école de médecine, elle a engraissé pour le cacher. Elle a eu sa période obèse."
                                            },
                                            {
                                                "example_id": "64ffce2f-2966-4eb7-a2bf-4bfc0f85b875",
                                                "sense_id": "a37bd1d8-8c77-3271-b179-22bafc19429a",
                                                "text": "Il est plus grand que je ne le pensais en voyant sa photo, une carrure d'ours, mais il a engraissé et, s'il a toujours des bras musclés, son ventre ballotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "823b2d86-7bb6-39d4-9814-a1eebfa3f427",
                                        "entry_id": "4ea5c6d7-bae2-3be7-8469-b79877f57cf8",
                                        "glosses": [
                                            "Devenir gras."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5a911c4-ead8-4fe4-aa26-dec4224e77a7",
                                                "sense_id": "823b2d86-7bb6-39d4-9814-a1eebfa3f427",
                                                "text": "Les chiens étaient en bonne santé et s'engraissaient à ne rien faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8429e2ad-0b7b-379f-8949-46553f524e8c",
                                        "entry_id": "4ea5c6d7-bae2-3be7-8469-b79877f57cf8",
                                        "glosses": [
                                            "Faire du « gras », du profit."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdbefb8-a835-4ce6-bef7-b245d8f3c6f2",
                                                "sense_id": "8429e2ad-0b7b-379f-8949-46553f524e8c",
                                                "text": "Mais les collecteurs ne sont que marchands : ils fournissent leur clientèle, s'engraissent du travail des uns, de la gourmandise des autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
