                "senses": [
                    {
                        "sense_id": "0a68541a-be11-327b-94fe-615fab25b4ab",
                        "entry_id": "4837594d-64cb-3597-94cd-ccb50f593fd6",
                        "glosses": [
                            "über einen Sarg ausgebreitetes Tuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "255a1615-6480-47bd-9641-ede1f27892be",
                                "sense_id": "0a68541a-be11-327b-94fe-615fab25b4ab",
                                "text": "„Als Accessoire für die Trauerfeier haben die Gestalter ein Sargtuch entworfen, das auch von Freunden, die nicht vor Ort sein können, per Mausklick mitgestaltet und mit letzten Grüßen versehen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1148eab-192a-499d-b8ad-019db24b92ed",
                        "source_entry_id": "4837594d-64cb-3597-94cd-ccb50f593fd6",
                        "source_sense_id": "0a68541a-be11-327b-94fe-615fab25b4ab",
                        "source_sense_description": "über einen Sarg ausgebreitetes Tuch",
                        "target_lang_word": "pall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74bdb669-522f-37d2-9a6e-7bd1ec3a1902",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to cloth.",
                                            "Fine cloth, especially purple cloth used for robes."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57f0d9f6-ed2e-32b3-af98-2020f19f773b",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to cloth.",
                                            "A heavy cloth laid over a coffin or tomb; a shroud laid over a corpse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "735c273d-e331-4264-8938-e83ab2002ad6",
                                                "sense_id": "57f0d9f6-ed2e-32b3-af98-2020f19f773b",
                                                "text": "After his death he [Diocletian] remained corporeally in possession of the palace, his tomb resting in the centre of the mausoleum. Thirty years or so later, a woman was put to death for stealing the purple pall from his sarcophagus, a strange, crazy crime, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f0dcea1-6bf0-3871-8e1b-946b27336f28",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to cloth.",
                                            "A piece of cardboard, covered with linen and embroidered on one side, used to cover the chalice during the Eucharist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "089ffc36-4151-32e2-92d9-199b7b274c34",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to cloth.",
                                            "A cloth used for various purposes on the altar in a church, such as a corporal (“cloth on which elements of the Eucharist are placed”) or frontal (“drapery covering the front of an altar”)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "008d7f2f-2934-3f81-90cd-6f7a738f71e2",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to clothing.",
                                            "An outer garment; a cloak, mantle, or robe."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046df84d-3754-4a5e-8feb-7886279e3d34",
                                                "sense_id": "008d7f2f-2934-3f81-90cd-6f7a738f71e2",
                                                "text": "In a long purple pall, whose ſkirt with gold, / Was fretted all about, ſhe was arayd, […]"
                                            },
                                            {
                                                "example_id": "a20becea-b1dc-481f-a28e-936dfc938d1d",
                                                "sense_id": "008d7f2f-2934-3f81-90cd-6f7a738f71e2",
                                                "text": "His [Hercules's] Lyons skin chaungd to a pall of gold, / In which forgetting warres, he onely ioyed / In combats of ſweet loue, and with his miſtreſſe toyed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56edefc6-1367-3905-95cc-1094509f6f11",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to clothing.",
                                            "Something that covers or surrounds like a cloak; in particular, a cloud of dust, smoke, etc., or a feeling of fear, gloom, or suspicion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab931f71-ef34-45b9-9a67-2f0164c239f5",
                                                "sense_id": "56edefc6-1367-3905-95cc-1094509f6f11",
                                                "text": "The early election results cast a pall over what was supposed to be a celebration."
                                            },
                                            {
                                                "example_id": "90e8dbf0-9381-4a03-a39f-8361e26a64dc",
                                                "sense_id": "56edefc6-1367-3905-95cc-1094509f6f11",
                                                "text": "A pall came over the crowd when the fourth goal was scored."
                                            },
                                            {
                                                "example_id": "8a213f7b-2cb5-4646-bb20-31558edffb62",
                                                "sense_id": "56edefc6-1367-3905-95cc-1094509f6f11",
                                                "text": "The smoke-pall of industrial Lancashire hung over the landscape; perhaps slagscape would be a more fitting term. The general prospect was a succession of chimney-stacks, factories, pit-heads, slagheaps, junctions, sidings and coal wagons."
                                            },
                                            {
                                                "example_id": "58db68a4-8120-44b2-80bf-f20e80616631",
                                                "sense_id": "56edefc6-1367-3905-95cc-1094509f6f11",
                                                "text": "Night has spread her pall once more,\nAnd the prisoner still is free:\nOpen is his dungeon door,\nUseless now his dungeon key!"
                                            },
                                            {
                                                "example_id": "fae3bc18-6beb-4485-b4e7-c52bfbcad37e",
                                                "sense_id": "56edefc6-1367-3905-95cc-1094509f6f11",
                                                "text": "[…]and the pillar of smoke which had recently begun to dissipate, as many of the fires amidships had been smothered by the onrushing water, was replaced by a vast mushroom cloud of steam, smoke, flame, and debris as the magazines detonated. In the pall of this apocalyptic destruction, the U.S. fleet takes stock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b8f27c-8aab-3812-a438-5fc0edb74d34",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to clothing.",
                                            "Especially in Roman Catholicism: a pallium (“liturgical vestment worn over the chasuble”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e75ea5-466e-4029-affc-26f434331840",
                                                "sense_id": "e7b8f27c-8aab-3812-a438-5fc0edb74d34",
                                                "text": "By the way, a pall is a pontifical vestment, considerable for the matter, making, and mysteries thereof. […] But, to speak plainly, the mystery of mysteries in this pall was, that the archbishops' receiving it showed therein their dependence on Rome; and a mote, in this manner ceremoniously taken, was an acknowledgement of their subjection. And as it owned Rome's power, so in after-ages it increased their profit. For, though now such palls were freely given to archbishops, […] yet in after-ages the archbishop of Canterbury's pall was sold for five thousand florins: […]"
                                            },
                                            {
                                                "example_id": "71756b97-f593-4268-be68-d6406e118ca6",
                                                "sense_id": "e7b8f27c-8aab-3812-a438-5fc0edb74d34",
                                                "text": "Or it might be a magnificent pall, in the days in which this garment had lost its primitive character, that taxed the skill and the patience of the fair needlewoman. It was about the year a.d. 601 that Pope Gregory [I] sent two archbishop's palls into England; the one for London, which see was afterwards removed to Canterbury, and the other to York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84faca95-d584-3f90-9c7d-3d2c24e4b184",
                                        "entry_id": "dada9d96-d9b3-3017-9c9b-a678d8be8256",
                                        "glosses": [
                                            "Senses relating to clothing.",
                                            "A charge representing an archbishop's pallium, having the form of the letter Y, sometimes charged with crosses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91deb23-963b-478f-879a-c17dbd028212",
                                                "sense_id": "84faca95-d584-3f90-9c7d-3d2c24e4b184",
                                                "text": "The flag of South Africa has a green pall"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e68fd24-e13f-3298-b690-dc597c8b04fc",
                                        "entry_id": "613af229-1791-336e-96c8-129170647243",
                                        "glosses": [
                                            "To cloak or cover with, or as if with, a pall."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c4f9449-9da3-4aba-a884-7a7a7cb02ad1",
                                                "sense_id": "2e68fd24-e13f-3298-b690-dc597c8b04fc",
                                                "text": "Come, thick Night, / And pall thee in the dunneſt ſmoake of Hell, / That my keene Knife ſee not the Wound it makes, / Nor Heauen peepe through the Blanket of the darke, / To cry, hold, hold."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a395a99b-7131-3c3c-a62d-261ff202718c",
                                        "entry_id": "f0e000ad-c0e9-30d4-aaf6-e62fe0a18b12",
                                        "glosses": [
                                            "To make vapid or insipid; to make lifeless or spiritless; to dull, to weaken."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "764fbd53-a73a-4084-bc5b-21cc0ccbbccf",
                                                "sense_id": "a395a99b-7131-3c3c-a62d-261ff202718c",
                                                "text": "[…] Reaſon and Reflection, which by repreſenting perpetually to the mind of Man the meanneſs of all ſenſual Gratifications, do, in great meaſure, blunt the edge of his keeneſt Deſires, and pall all his Enjoyments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                        "entry_id": "f0e000ad-c0e9-30d4-aaf6-e62fe0a18b12",
                                        "glosses": [
                                            "To become dull, insipid, tasteless, or vapid; to lose life, spirit, strength, or taste."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9484e2b-0854-471b-9c25-f22e381bf5e8",
                                                "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                                "text": "The liquor palls."
                                            },
                                            {
                                                "example_id": "938bd1df-dfc7-44fc-aac7-c07250a09fd8",
                                                "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                                "text": "[T]he ale and byere haue palled, and were nought, by cause such ale and biere hathe taken wynde in spurgyng.",
                                                "translation": "Storehouse for Children or Clerics, the First English–Latin Dictionary, […]",
                                                "english": "Storehouse for Children or Clerics, the First English–Latin Dictionary, […]"
                                            },
                                            {
                                                "example_id": "eadbe2bf-d057-4424-8d9f-cee8bc9daae9",
                                                "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                                "text": "Beauty ſoon grows familiar to the lover, / Fades in the eye, and palls upon the ſenſe."
                                            },
                                            {
                                                "example_id": "b09413ae-7023-4f09-b469-c3484c61a45e",
                                                "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                                "text": "He interests himself in nothing: he scarcely cares to go beyond the garden-gate. Even Captain Glanders and Captain Strong pall upon him […]"
                                            },
                                            {
                                                "example_id": "166a3491-2727-4adc-aaea-c98b945b0b8f",
                                                "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                                "text": "We are all becoming accustomed to adventure. It is beginning to pall on us. We suffered no casualties and there was no illness."
                                            },
                                            {
                                                "example_id": "97413605-ceff-4ebc-8d95-742b28c04cfd",
                                                "sense_id": "040ab82f-9d86-3b43-80e7-b28b24d8bef3",
                                                "text": "And one day the new port palled, like a book one has read too often, or a picture one has looked at over-long. And it was sheet home the royals and off to a new port, where there were new strange people, and streets laid another way, and other things in the merchants' booths, and a new language to pick up a phrase or two of."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0fb6bf-f4e7-3bf4-8f81-c8c2b5607d06",
                                        "entry_id": "c8de4338-0ac3-30f9-a804-a6a7cccf2f66",
                                        "glosses": [
                                            "A feeling of nausea caused by disgust or overindulgence."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f2aa12-57bd-463d-92dd-552f3c4cbb67",
                                                "sense_id": "7c0fb6bf-f4e7-3bf4-8f81-c8c2b5607d06",
                                                "text": "Tho the Impatience of abſtaining be greater; the Pleaſure of Indulgence is really leſs. The Palls or Nauseatings which continually intervene, are of the worſt and moſt hateful kind of Senſation. Hardly is there any thing taſted which is wholly free from this ill reliſh of a ſurfeited Senſe and ruin'd Appetite."
                                            }
                                        ]
                                    }
                                ]
                            },
