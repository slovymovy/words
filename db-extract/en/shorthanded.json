                        "sense_id": "9e2183d9-4bea-3965-a458-aa7512371121",
                        "entry_id": "cf725411-9276-3602-b079-208c8b80462b",
                        "glosses": [
                            "Lacking sufficient staff or people, as for normal or efficient operations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9057533-832e-4f15-b66b-7134b73f80ee",
                                "sense_id": "9e2183d9-4bea-3965-a458-aa7512371121",
                                "text": "The tiny restaurant usually got by with three workers on that shift, but found itself shorthanded when the tour bus pulled in."
                            },
                            {
                                "example_id": "b87b4103-e2d1-4c19-910b-f74a23e6bf06",
                                "sense_id": "9e2183d9-4bea-3965-a458-aa7512371121",
                                "text": "\"What are you doing out here?\" I asked Iris. “We shorthanded?” She smiled. “We're always shorthanded, Miss Lois."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd8253bf-a91a-35b8-8f93-8ddbaac46442",
                        "entry_id": "cf725411-9276-3602-b079-208c8b80462b",
                        "glosses": [
                            "Having less than a quorum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d863b3-e93b-49b0-9613-72298ef72859",
                                "sense_id": "fd8253bf-a91a-35b8-8f93-8ddbaac46442",
                                "text": "Neither the code nor the case law discuss whether or how the power of a shorthanded school board should be curtailed"
                            }
                        ]
                    },
                    {
                        "sense_id": "d14a2808-2b4a-39a4-a577-a45e54ef73fa",
                        "entry_id": "cf725411-9276-3602-b079-208c8b80462b",
                        "glosses": [
                            "Having, or occurring during an interval with, fewer than a full complement of players, often as the result of a penalty."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63fe928-68b4-419c-ba09-280353980ae6",
                                "sense_id": "d14a2808-2b4a-39a4-a577-a45e54ef73fa",
                                "text": "“Scoring a shorthanded goal gives the team a lift,” Lefley said. “We've been picking our spots and making the most of them."
                            }
                        ]
                    },
                    {
                        "sense_id": "c037aea4-2e99-3186-a539-5cf40bc588d8",
                        "entry_id": "cf725411-9276-3602-b079-208c8b80462b",
                        "glosses": [
                            "Having fewer than the standard number of players."
                        ],
                        "tags": [
                            "of a table"
                        ],
                        "examples": [
                            {
                                "example_id": "e913908c-141f-416d-bd1b-4a29b49f21b2",
                                "sense_id": "c037aea4-2e99-3186-a539-5cf40bc588d8",
                                "text": "Some of the ideas discussed in the Omaha eight-or-better section include general concepts, position, low hands, high hands, your starting hand, play on the flop, multi-way versus shorthanded play, scare cards, getting counterfeited, and your playing style."
                            }
                        ]
                    }
