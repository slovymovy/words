                ],
                "senses": [
                    {
                        "sense_id": "a3d1ca43-a40f-3dd2-a9df-4eead9c0d71f",
                        "entry_id": "45ac0823-f555-3e33-ab57-3f949ad82baa",
                        "glosses": [
                            "процесс действия по значению глаг.: крепить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8264227-f42c-4a37-928e-66e8bfca3c8d",
                                "sense_id": "a3d1ca43-a40f-3dd2-a9df-4eead9c0d71f",
                                "text": "Это дощечки, в которых проделываются отверстия для крепления металлического стержня."
                            }
                        ]
                    },
                    {
                        "sense_id": "648bb5d4-1a12-37a7-a440-4916811cdb2d",
                        "entry_id": "45ac0823-f555-3e33-ab57-3f949ad82baa",
                        "glosses": [
                            "устройство для скрепления, закрепления и т. п. чего-л."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1acbbec3-bcb1-4f2e-931c-e43fb0c6f73b",
                                "sense_id": "648bb5d4-1a12-37a7-a440-4916811cdb2d",
                                "text": "Он мгновенно достал изо рта вставной зуб на штифтовом креплении…"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce053c0a-1fbe-3272-9653-a876aed4f5fc",
                        "entry_id": "45ac0823-f555-3e33-ab57-3f949ad82baa",
                        "glosses": [
                            "приспособление, прикрепляющее лыжу к ботинку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb5364b-229a-4208-a762-4db35ecf2687",
                                "sense_id": "ce053c0a-1fbe-3272-9653-a876aed4f5fc",
                                "text": "Доверьте подбор ботинок, креплений и прочих необходимых вещей и вещиц профессионалам."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab894081-b40a-36c4-9de3-c52fce324e38",
                        "entry_id": "45ac0823-f555-3e33-ab57-3f949ad82baa",
                        "glosses": [
                            "то же, что крепь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b9bb08-571b-40b4-ac2f-ff849ee3f8b4",
                                "sense_id": "ab894081-b40a-36c4-9de3-c52fce324e38",
                                "text": "Здесь бетон, из него не так скоро крепления вышибешь"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
