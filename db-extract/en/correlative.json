                ],
                "senses": [
                    {
                        "sense_id": "1c02e365-90ce-3e05-accf-44ee23fff60b",
                        "entry_id": "fbbb809b-6e51-329d-b606-f6e3bb611bac",
                        "glosses": [
                            "Mutually related; corresponding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bdc44d4-3e51-4d68-99b9-0d8f4ee8ec0d",
                                "sense_id": "1c02e365-90ce-3e05-accf-44ee23fff60b",
                                "text": "If we reinterpret these phenomena in terms of a consistently game-playing model of behavior, the need to distinguish between primary and secondary gains disappears. The correlative necessity to estimate the relative significance of physiological needs and dammed-up impulses on the one hand, and of social and interpersonal factors on the other, also vanishes. Since needs and impulses cannot be said to exist in human social life without specified rules for dealing with them, instinctual needs cannot be considered solely in terms of biological rules, but must also be viewed in terms of their psychosocial significance—that is, as parts of the game."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd9bebc3-3b9a-4d77-a686-545491d41167",
                        "source_entry_id": "fbbb809b-6e51-329d-b606-f6e3bb611bac",
                        "source_sense_id": "1c02e365-90ce-3e05-accf-44ee23fff60b",
                        "source_sense_description": "mutually related",
                        "target_lang_word": "correlativo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correlativo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "72e2ab23-6bc6-32a5-b984-a934e68e9064",
                                        "entry_id": "92d8a1e8-5783-33bd-a492-06e68cadaed0",
                                        "glosses": [
                                            "Que tiene con otro u otros una relación de sucesión inmediata, correspondencia o influencia recíproca, de tal modo que los evoca en una serie lógica."
                                        ],
                                        "tags": [
                                            "generalmente en plural para referirse",
                                            "dos",
                                            "más personas",
                                            "cosas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a66623b9-d0f0-4f4b-ad9d-f5665459c2e2",
                                                "sense_id": "72e2ab23-6bc6-32a5-b984-a934e68e9064",
                                                "text": "* Los adverbios \"aquí\" y \"allá\" son correlativos en la indicación de lugar."
                                            },
                                            {
                                                "example_id": "22c280f5-a1cb-4b59-8363-3c31be2d183d",
                                                "sense_id": "72e2ab23-6bc6-32a5-b984-a934e68e9064",
                                                "text": "* El talento y la suerte son factores correlativos para obtener un buen ingreso."
                                            },
                                            {
                                                "example_id": "b005774c-6b0d-4511-aa61-bed1c09b98a9",
                                                "sense_id": "72e2ab23-6bc6-32a5-b984-a934e68e9064",
                                                "text": "Los términos \"tanto.como...\" se usan de manera correlativa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7956d6aa-dc1f-335f-97a1-2a423a477204",
                                        "entry_id": "92d8a1e8-5783-33bd-a492-06e68cadaed0",
                                        "glosses": [
                                            "Dicho de una materia: que es necesario tenerla aprobada para poder cursar otra."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
