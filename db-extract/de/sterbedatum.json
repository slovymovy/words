                        "examples": [
                            {
                                "example_id": "e8626da0-869c-4793-a276-89b05e051aa7",
                                "sense_id": "5c87d0ab-4afc-31b6-810d-277f3513fefe",
                                "text": "„Ich glaube, dass Henry Martins zwei Tage nach seinem Tod beerdigt wurde. Wenn ich diese Tage zu seinem Sterbedatum addiere, geht die Rechnung auf.“"
                            }
                        ],
