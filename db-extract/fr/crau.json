                        "entry_id": "63182e0c-b8ac-3222-b004-d9e668a04412",
                        "glosses": [
                            "Plaine formée par l’ancien delta de la Durance près de la Camargue, dans le département des Bouches-du-Rhône."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deab5670-bbce-4d9a-9799-3d4980015594",
                                "sense_id": "513cb8ee-aa73-39e4-95ed-8753bc0ab48a",
                                "text": "Les auberges sont pleines de gens de la campagne, fermiers de Camargue ou de Crau, dont les charrettes dételées encombrent les petites places, les rues des quartiers populeux, comme aux jours de marché ; […]."
                            },
                            {
                                "example_id": "04d39bd8-8cc4-4f71-b66b-c6abd190b1d7",
                                "sense_id": "513cb8ee-aa73-39e4-95ed-8753bc0ab48a",
                                "text": "À Arles, les Castors ont quitté leur train pour un car qui s’enfonce à travers la Crau, vers la Camargue."
                            }
                        ]
                    }
