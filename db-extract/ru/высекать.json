                ],
                "senses": [
                    {
                        "sense_id": "d8318b32-9a3e-3991-baa2-432ba93f7aac",
                        "entry_id": "2229f550-e22f-337c-a200-1b1e945a8bab",
                        "glosses": [
                            "to hew, to carve, to sculpt, to cut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a53a51b-cd59-4540-89ec-998fb1778ef9",
                                "sense_id": "d8318b32-9a3e-3991-baa2-432ba93f7aac",
                                "text": "высека́ть на́дпись на надгро́бном ка́мне",
                                "translation": "carve the inscription on the gravestone",
                                "english": "carve the inscription on the gravestone"
                            },
                            {
                                "example_id": "c864ad9d-0fb2-4a69-9a03-bf36092d5ef9",
                                "sense_id": "d8318b32-9a3e-3991-baa2-432ba93f7aac",
                                "text": "Ску́льптор высека́ет из мра́мора ста́тую.",
                                "translation": "The sculptor is carving the statue out of marble.",
                                "english": "The sculptor is carving the statue out of marble."
                            },
                            {
                                "example_id": "2aab12df-7049-4c00-b2bd-9d1914609b37",
                                "sense_id": "d8318b32-9a3e-3991-baa2-432ba93f7aac",
                                "text": "высека́ть ого́нь",
                                "translation": "to strike fire (from a flint)",
                                "english": "to strike fire (from a flint)"
                            },
                            {
                                "example_id": "16caf298-ee5e-49d3-a3d8-1f001ed6c1ff",
                                "sense_id": "d8318b32-9a3e-3991-baa2-432ba93f7aac",
                                "text": "В мое́й прихо́жей, в голове́, ты открыва́ешь дверь,\nЗахо́дишь, хоть и приглаше́ний нет тебе́ тепе́рь,\nИ улыба́юсь, зна́я то, что разлучи́т нас.\nТы высека́ешь и́скры, я открыва́ю газ."
                            }
                        ]
                    }
                ],
