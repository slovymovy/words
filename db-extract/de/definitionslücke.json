                "senses": [
                    {
                        "sense_id": "dbb5c187-8899-395d-a6ff-d764ae65eedc",
                        "entry_id": "008bd472-49f0-33a2-bc21-45bb19f01c3e",
                        "glosses": [
                            "Stelle, an der eine Funktion nicht festgelegt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42748ad3-70b7-4405-b717-d098a923cb89",
                                "sense_id": "dbb5c187-8899-395d-a6ff-d764ae65eedc",
                                "text": "„Definitionslücken können Polstellen mit nicht existierendem Grenzwert oder aber behebbare Lücken sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96e727ac-8dd1-3c28-a5af-4fce26a29ea6",
                        "entry_id": "008bd472-49f0-33a2-bc21-45bb19f01c3e",
                        "glosses": [
                            "Umstand, für den eine Festlegung fehlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdadbcf1-91b6-434d-ae89-e79e8c5f6591",
                                "sense_id": "96e727ac-8dd1-3c28-a5af-4fce26a29ea6",
                                "text": "„Geschickt lassen sich hierbei Definitionslücken im Gesetz ausnutzen.“"
                            },
                            {
                                "example_id": "e0f80bff-6ec5-47ec-9369-e9df621c3d8f",
                                "sense_id": "96e727ac-8dd1-3c28-a5af-4fce26a29ea6",
                                "text": "„Diese Definitionslücke im Gesetz zur Verwendung des Parteivermögens machte sich das Bundesfinanzministerium zunutze.“"
                            },
                            {
                                "example_id": "fb06f91c-27f0-4e04-9264-3958fe4f2a9b",
                                "sense_id": "96e727ac-8dd1-3c28-a5af-4fce26a29ea6",
                                "text": "„Dagegen haben lückenhafte geographische und produktmäßige Restriktionen im Banking Act von 1933 und eine Definitionslücke im Bank Holding Company Act von 1956 eine explosionsartige Verbreitung neuer Finanzinstitute ermöglicht, […]“"
                            },
                            {
                                "example_id": "861a6f78-b24b-4e4a-b08c-68686db4006b",
                                "sense_id": "96e727ac-8dd1-3c28-a5af-4fce26a29ea6",
                                "text": "„Im Gesetz hinterlassen diese Begriffe oft eine Definitionslücke.“"
                            },
                            {
                                "example_id": "a7b9419d-f87e-4be9-8006-1aad11405347",
                                "sense_id": "96e727ac-8dd1-3c28-a5af-4fce26a29ea6",
                                "text": "„Andererseits bestehen konkrete gesetzliche Definitionslücken, welche die Beschreibung des Kindeswohls und der Kindeswohlgefährdung betreffen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
