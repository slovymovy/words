                    {
                        "translation_id": "516fb86c-0c2b-43f8-a230-7ef65eacef7a",
                        "source_entry_id": "e9525f7f-4908-3746-bf20-0b89dd22a857",
                        "source_sense_id": "c2b335c2-d146-3733-a88e-d6d122773033",
                        "target_lang_word": "neutrality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutrality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54448d32-3468-3702-95fa-a572de90406e",
                                        "entry_id": "d9a0aed5-8fbf-3fc1-9d15-eb6cefd1a4c6",
                                        "glosses": [
                                            "The state or quality of being neutral; the condition of being unengaged in contests between others; state of taking no part on either side."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe8fe04-54cc-4478-8e43-b20d1f524dd3",
                                                "sense_id": "54448d32-3468-3702-95fa-a572de90406e",
                                                "text": "And what happineſs is there in a ſtorm of paſſions? On this account the Scepticks affected an indifferent æquipondious neutrality as the only means to their Ataraxia, and freedom from paßionate diſturbances."
                                            },
                                            {
                                                "example_id": "81bd79bf-1813-4e68-8899-35a1baee505b",
                                                "sense_id": "54448d32-3468-3702-95fa-a572de90406e",
                                                "text": "Men who possess a state of neutrality in times of public danger, desert the interest of their fellow subjects."
                                            },
                                            {
                                                "example_id": "ca6d5535-02ec-4d88-9dfc-b3df6cd9f788",
                                                "sense_id": "54448d32-3468-3702-95fa-a572de90406e",
                                                "text": "The official pretence of a scrupulous solicitude to maintain neutrality is flagrantly insincere."
                                            },
                                            {
                                                "example_id": "53615c07-6080-4a5e-80fc-eec33cac6a34",
                                                "sense_id": "54448d32-3468-3702-95fa-a572de90406e",
                                                "text": "Lizzo, who is known for messages of self-love and wider acceptance, has recently said as much as she shared that she is encouraging a stance of body neutrality for herself and others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1294bd4b-4a46-3c34-9408-e715a7caed8b",
                                        "entry_id": "d9a0aed5-8fbf-3fc1-9d15-eb6cefd1a4c6",
                                        "glosses": [
                                            "Indifference in quality; a state neither very good nor bad."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ad44d9f-c947-4a2a-9c3a-1e97d3c985fc",
                                                "sense_id": "1294bd4b-4a46-3c34-9408-e715a7caed8b",
                                                "text": "There is no health; physicians say that we\nAt best enjoy but a neutrality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a619e6ae-638d-3b2e-9fcf-2118d2e9f828",
                                        "entry_id": "d9a0aed5-8fbf-3fc1-9d15-eb6cefd1a4c6",
                                        "glosses": [
                                            "The quality or state of being neutral."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9eacc7a-8872-3742-a043-9b862181beb1",
                                        "entry_id": "d9a0aed5-8fbf-3fc1-9d15-eb6cefd1a4c6",
                                        "glosses": [
                                            "The condition of a nation or government which refrains from taking part, directly or indirectly, in a war between other powers."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6df8dd64-d8a0-352e-9a37-fddd02df3133",
                                        "entry_id": "d9a0aed5-8fbf-3fc1-9d15-eb6cefd1a4c6",
                                        "glosses": [
                                            "Those who are neutral; a combination of neutral powers or states."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
