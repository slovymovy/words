                        "glosses": [
                            "A fan or supporter of Canadian singer Justin Bieber (born 1994); a Justin Bieber fanatic."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ffb3bd-06c3-4c1b-a2d6-4e9bf180b1de",
                                "sense_id": "7a4d6db5-8d35-3668-86e2-66f7886415bd",
                                "text": "A Belieber is sustained by the hope of someday being followed by, and receiving a direct message from Justin on Twitter."
                            },
                            {
                                "example_id": "62876424-1d6a-4375-9d73-de2889b03e6d",
                                "sense_id": "7a4d6db5-8d35-3668-86e2-66f7886415bd",
                                "text": "There is simply nothing you can say that could make me feel remorse. If Justin sings Christmas, then for the duration of the track I am a Belieber."
                            }
                        ]
                    }
