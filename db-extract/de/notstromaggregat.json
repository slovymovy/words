                    {
                        "sense_id": "981abccb-6351-3791-a881-336913b4d2a0",
                        "entry_id": "b37b4025-484e-3c0a-ad20-8c61ac9781c5",
                        "glosses": [
                            "Maschine zur Erzeugung von Strom mit Benzin oder Diesel, die bei einem Ausfall der öffentlichen Stromversorgung einspringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5115ec2a-be36-486d-9816-f8450e475cc8",
                                "sense_id": "981abccb-6351-3791-a881-336913b4d2a0",
                                "text": "Das Krankenhaus verfügt über mehrere Notstromaggregate, damit bei Stromausfällen weitergearbeitet werden kann."
                            },
                            {
                                "example_id": "65743b87-0f6c-4a8c-a66f-ada65db2ab25",
                                "sense_id": "981abccb-6351-3791-a881-336913b4d2a0",
                                "text": "„Drei Wochen, so der Plan, könnten die Menschen hier überleben, für diesen Zeitraum gibt es Diesel für das Notstromaggregat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
