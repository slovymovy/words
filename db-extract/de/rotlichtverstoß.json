                "senses": [
                    {
                        "sense_id": "aaf10214-587e-3e95-aff5-f2e6a91c6b86",
                        "entry_id": "736ec667-d248-3c7a-865c-acd3be2aa1e9",
                        "glosses": [
                            "Gesetzesverstoß, der begangen wird, wenn man eine rote Ampel überfährt oder übergeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e0ecda1-9497-4c67-8d16-da650c739054",
                                "sense_id": "aaf10214-587e-3e95-aff5-f2e6a91c6b86",
                                "text": "Der schwere Unfall auf der Kreuzung resultierte aus einem Rotlichtverstoß."
                            },
                            {
                                "example_id": "83e64a7a-36cf-44d1-b0ea-402730561aea",
                                "sense_id": "aaf10214-587e-3e95-aff5-f2e6a91c6b86",
                                "text": "„Von einem einfachen Rotlichtverstoß spricht man, wenn die auf rot geschaltete Ampel überfahren wird, nachdem sie weniger als eine Sekunde Rot geleuchtet hat.“"
                            },
                            {
                                "example_id": "d4d0effa-ee4f-4fd7-9e31-33f16ad05e79",
                                "sense_id": "aaf10214-587e-3e95-aff5-f2e6a91c6b86",
                                "text": "„Das Verkehrsrecht bezüglich der roten Ampel gilt für sämtliche Passanten – auch Fußgänger können beispielsweise mit einem Bußgeld bestraft werden, wenn Sie bei Rot die Ampel überqueren und somit einen Rotlichtverstoß begehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
