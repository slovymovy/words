                        "examples": [
                            {
                                "example_id": "05fbd7ad-cb6b-464c-9614-ad8687c3218f",
                                "sense_id": "50b7c580-a2ff-318d-8a6e-1798c19d3503",
                                "text": "И, отпустив их, пошел на гору помолиться.",
