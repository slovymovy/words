                "senses": [
                    {
                        "sense_id": "6edeb825-8bc7-34dd-b9ae-02b9785b33ce",
                        "entry_id": "c760e548-075d-36d9-8710-66a7f342744c",
                        "glosses": [
                            "Sambucus nigra tot boom uitgegroeide vlier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48f5e087-0e28-4f23-af00-217e2fd14394",
                                "sense_id": "6edeb825-8bc7-34dd-b9ae-02b9785b33ce",
                                "text": "Rond 1878 beschrijft hij de grafkelder als „een verwilderd metselwerk, over welks hardstenen stijlen de knoestige takken van een vlierboom zich heenbuigen, terwijl een roestig, scheefgezakt ijzeren hek den toegang tot deze puinhoop niet meer afsluit. ’t Is een vreemd en aangrijpend plekje - midden in een levendig en bloeijend dorp, zoo eenzaam en verlaten.”"
                            },
                            {
                                "example_id": "ff3d8eee-501b-49b9-bb4d-1a0f4a888113",
                                "sense_id": "6edeb825-8bc7-34dd-b9ae-02b9785b33ce",
                                "text": "Het recept voor vlierbloesemsiroop staat als ‘flits uit het paradijs’ in het vierde NRC Handelsbladkookboek dat gelukkig in de bibliotheek te vinden is. Alleen de vlierbomen zijn bijna uitgebloeid, dus wees er snel bij."
                            }
                        ]
                    }
                ],
