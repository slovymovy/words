                "senses": [
                    {
                        "sense_id": "4ff52f75-5896-3bbf-87ed-108b5343f3eb",
                        "entry_id": "8ecf5e25-5f3a-38d0-b997-180adaf61caa",
                        "glosses": [
                            "Celui/celle qui est sale, malpropre."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "48be0c19-5e90-49e6-900e-3175a23151e8",
                                "sense_id": "4ff52f75-5896-3bbf-87ed-108b5343f3eb",
                                "text": "Petit saligaud !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                        "entry_id": "8ecf5e25-5f3a-38d0-b997-180adaf61caa",
                        "glosses": [
                            "Celui/celle qui est méprisable."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "44464eb4-3816-4ebf-9f6c-c714db18558b",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "Bon sang de sort ! faisait-il ; ces saligauds-là m’ont chauffé ma bagnole."
                            },
                            {
                                "example_id": "b15ce283-300d-4d4b-9ff7-5591404e8d3d",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "« Quel saligaud et quel sommaire saligaud, votre Zola », s’écriait-il, un exemplaire des Rougon à la main, en apercevant mon père."
                            },
                            {
                                "example_id": "956bd1c0-c529-4df9-ae3c-8d3754dea4e9",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "Ce vaurien de Mablot, ce dégoûtant, ce saligaud ! Et lui qui le tenait en si haute estime, lui qui avait tant chanté ses louanges !"
                            },
                            {
                                "example_id": "1d2e8221-0481-46fa-88ff-a2869776ed61",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "— Veux-tu que je te le dise, Clarius ? Eh bien, tu n’es qu’un fichu saligaud !"
                            },
                            {
                                "example_id": "608124a1-4215-4dff-94fb-34245d842c78",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "Vous vous êtes vanté, m’a-t-on dit, d’avoir remarqué la femme du capitaine Bourguignon complètement nue à sa fenêtre… Qu’est-ce que c’est que cette rocambolade, hein ? Saligaud !"
                            },
                            {
                                "example_id": "ae4fbf3d-7ae5-41bb-8fbb-96ce053fe545",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "« Et même, à ce qu’il paraît, qu’il y a des saligauds qui mangent des grenouilles ! »"
                            },
                            {
                                "example_id": "2e292dce-0686-4cc6-b1a4-07c5d4d49f59",
                                "sense_id": "c6a16f4e-e140-3a30-83ce-399380109651",
                                "text": "— Espèce de petit saligaud. Je vais t’apprendre…"
                            }
                        ]
                    }
                ],
