                                "sense_id": "b384d9cc-0c54-3bb4-b036-6cb5aa59af10",
                                "text": "Een andere benaming voor deze langnek is dan ook kameelpanter (of Oudnederlands: kameelpardel)."
                            },
                            {
                                "example_id": "81f9997e-445b-4db9-8d7e-3dedf355d8a1",
                                "sense_id": "b384d9cc-0c54-3bb4-b036-6cb5aa59af10",
                                "text": "Het grootste probleem voor de langnek is het verlies van zijn leefgebied."
                            }
                        ]
