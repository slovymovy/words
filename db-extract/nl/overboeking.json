                    },
                    {
                        "sense_id": "5d6ae69d-3141-3ab7-8711-acb4e39a0f90",
                        "entry_id": "b34af36b-96fa-3732-a62f-f795a2930dda",
                        "glosses": [
                            "een financiële transactie waarbij geld van de ene naar de andere bankrekening gaat zonder dat waardepapieren worden gebruikt"
