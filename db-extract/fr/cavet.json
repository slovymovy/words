                "senses": [
                    {
                        "sense_id": "83831d4b-1d08-369a-8449-8af6e18efa36",
                        "entry_id": "c143a20b-c5ed-3b7d-a7bc-484b836eb612",
                        "glosses": [
                            "Moulure concave dont le profil est d’un quart de cercle, il est spécifique de l’ordre dorique"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a20634d-c5f8-44bd-aeff-2296d3135965",
                                "sense_id": "83831d4b-1d08-369a-8449-8af6e18efa36",
                                "text": "Dans une ligne d’arcatures surmontant une des portes de la mosquée des morts, l’arc à lambrequins apparaît, appareillé en briques, sous une forme trilobée et élémentaire : un lobe supérieur en arc brisé retombant par des décrochements sur deux cavets."
                            },
                            {
                                "example_id": "28e7a2f1-242b-490e-a9d2-b1b16117eadc",
                                "sense_id": "83831d4b-1d08-369a-8449-8af6e18efa36",
                                "text": "Il ne s’agit plus de reproduire le profil des entablements, mais de souligner ce qui représente l’essentiel de la mouluration : l’ensemble baguette, cavet, listel."
                            }
                        ]
                    }
                ],
