                        "entry_id": "fbb2ba7f-3195-3d97-9ddc-a8dfa4ddd5c5",
                        "glosses": [
                            "Any of a large group of structurally similar hydrated double silicate minerals, containing various combinations of sodium, calcium, magnesium, iron, and aluminium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4396fe80-930b-45db-aed4-64e33f765817",
                                "sense_id": "b18bb835-e107-31c5-8d8b-62d0dd25f162",
                                "text": "Remember when we could see the mountain's peak?\nThe sparkle off the amphibole."
                            }
                        ]
                    }
                ],
