                        "translation_id": "3daeebe9-8ef5-4e1d-8754-a8d3330ecaac",
                        "source_entry_id": "f18d24c3-312a-3b3b-be9b-635306cd7c20",
                        "source_sense_id": "a81405f6-e766-3dc2-973e-de52843806fa",
