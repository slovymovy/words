                    {
                        "sense_id": "6e7bcbf4-3445-31e0-b3f8-be49887058dd",
                        "entry_id": "7ad1dacf-d19f-36fc-a41a-441bb71ee015",
                        "glosses": [
                            "Carabine américaine, à répétition, de la fin du XIXᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0390fdbc-e3b1-4df9-ad02-7fe409aaf0f7",
                                "sense_id": "6e7bcbf4-3445-31e0-b3f8-be49887058dd",
                                "text": "On trouvait fière allure aux chevaux et aux winchesters gainées de cuir à franges pendant le long des selles […]"
                            },
                            {
                                "example_id": "b73f0a8b-6b0a-4118-b923-25bb47367ab0",
                                "sense_id": "6e7bcbf4-3445-31e0-b3f8-be49887058dd",
                                "text": "Le fracas d’une winchester m’arrache à mes rêveries. Depuis tout-petit je tressaille au premier claquement d’un fusil."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "aefe1490-faa5-38ed-99d8-1070f60d4332",
