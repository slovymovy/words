                                        "entry_id": "0309b6d1-f6b8-3c96-bb8f-f755c1d2ea32",
                                        "glosses": [
                                            "Attached directly by the base; not having an intervening stalk; stalkless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8f63c9-a264-4f29-8cee-6e839b2007f9",
                                                "sense_id": "a389ad82-74fc-32be-9035-3698c737eb13",
                                                "text": "The pileus is sessile, or sometimes narrowed at the base into a short stem, the caps often numerous and crowded together in an overlapping or imbricate manner."
                                            },
                                            {
                                                "example_id": "61ffb29c-cd21-409e-b04c-0253d072e74e",
                                                "sense_id": "a389ad82-74fc-32be-9035-3698c737eb13",
                                                "text": "The sporophyte foot is also characteristic: it is very broad and more or less lenticular or disciform, as broad or broader than the calyptra stalk[…], and is sessile on the calyptra base[…]"
                                            }
                                        ]
                                    }
