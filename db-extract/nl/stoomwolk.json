                "senses": [
                    {
                        "sense_id": "d8f36d1f-1a73-34c7-81c8-9ca18a95470f",
                        "entry_id": "c7c17bad-7e76-303e-b92a-7bccb4598df7",
                        "glosses": [
                            "een wolk die is ontstaan door waterdamp die in hele kleine waterdruppeltjes is gecondenseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb9ac42-e01e-4e57-9476-92716fa24626",
                                "sense_id": "d8f36d1f-1a73-34c7-81c8-9ca18a95470f",
                                "text": "In februari en maart voeren we hier naartoe, dwars door piratengebied; bij Somalië en door de Rode zee. Het was winter toen we in de Middellandse zee aankwamen en Katia en ik kropen klappertandend tegen elkaar, terwijl we stoomwolkjes bliezen in de kou."
                            },
                            {
                                "example_id": "9f8baa72-177f-4285-8e66-6dfac2398048",
                                "sense_id": "d8f36d1f-1a73-34c7-81c8-9ca18a95470f",
                                "text": "Maar de treintocht verlegt voor even de aandacht. Helemaal als de zware locomotief vlak voor terugkomst op het station een enorme stoomwolk uitstoot tussen de torenhoge Redwoods, bomen van meer dan 1800 jaar oud en met lengtes van 46 meter de hoogste bomen die op de wereld voorkomen."
                            }
                        ]
                    }
