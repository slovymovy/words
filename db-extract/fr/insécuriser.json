                "senses": [
                    {
                        "sense_id": "42c39880-47b9-3c61-a10d-aac356685dc7",
                        "entry_id": "37c6e1f5-b8e5-341f-8579-5865e6bdb436",
                        "glosses": [
                            "Rendre moins sûr, plus dangereux."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "27a0e1a4-7534-3e2f-8681-b33c86a3afc9",
                        "entry_id": "37c6e1f5-b8e5-341f-8579-5865e6bdb436",
                        "glosses": [
                            "Faire perdre son sentiment de sécurité à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b657e95-ff74-45f9-b5ca-c34ae0a7a4b4",
                                "sense_id": "27a0e1a4-7534-3e2f-8681-b33c86a3afc9",
                                "text": "Alors que la population est déchirée par les enjeux de la pandémie, que les espoirs de s’en sortir sont sans cesse repoussés, qu’une menace pèse sur nos systèmes hospitaliers, comment pourra-t-on traverser des débats politiques qui, à l’évidence, nous insécuriseront davantage ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b95e11a8-e773-4dd9-adb0-a5cf59a6a4c6",
                        "source_entry_id": "37c6e1f5-b8e5-341f-8579-5865e6bdb436",
                        "target_lang_word": "verunsichern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verunsichern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "472cf3c6-b12b-3593-9e84-57caf1caa776",
                                        "entry_id": "f1a0574d-e551-3715-8496-5af13ec763cf",
                                        "glosses": [
                                            "jemanden durch eine Person oder Situation so beeinflussen, das ein Gefühl der Unsicherheit entsteht"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47efdda9-428f-4e77-b91a-ef00560c859a",
                                                "sense_id": "472cf3c6-b12b-3593-9e84-57caf1caa776",
                                                "text": "„Chinas rasante Entwicklung vom Bauernstaat zur Wirtschaftsmacht verunsichert“, resümiert die Frankfurter Rundschau."
                                            },
                                            {
                                                "example_id": "8fbed181-61f0-49f7-8d96-887d35eae963",
                                                "sense_id": "472cf3c6-b12b-3593-9e84-57caf1caa776",
                                                "text": "Der Protest gegen die dänischen Karikaturen verunsichert Europa: Können wir auf einen Islam hoffen, der sich mit unseren Freiheitsrechten verträgt?"
                                            },
                                            {
                                                "example_id": "086a79c6-de8d-4263-99b4-35dcfa52ce8a",
                                                "sense_id": "472cf3c6-b12b-3593-9e84-57caf1caa776",
                                                "text": "Zudem verunsichern die je nach Anbieter abweichenden Nutzungsrechte die Kunden."
                                            },
                                            {
                                                "example_id": "086e147b-5caa-4c90-bcd9-57aed5575a7c",
                                                "sense_id": "472cf3c6-b12b-3593-9e84-57caf1caa776",
                                                "text": "Auch durch den Hinweis, dass die Komparserie des Filmes Tiefland (1940 bis 1944) erst durch die Zwangsmaßnahmen des Regimes gestellt werden konnte, ließ sie sich nicht verunsichern."
                                            },
                                            {
                                                "example_id": "66c35852-ef68-4efa-a746-c382d866ada5",
                                                "sense_id": "472cf3c6-b12b-3593-9e84-57caf1caa776",
                                                "text": "Einem Comic gleich, verführen Texte am Bildrand zum einordnenden Lesen, um dann den Betrachter vielleicht doch nur zu verunsichern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
