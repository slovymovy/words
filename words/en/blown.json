{
    "word_family": [
        "blow",
        "blower",
        "blowout",
        "windblown",
        "flyblown",
        "full-blown"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "181dc575-a657-37c3-8957-ade35841c5ae",
                    "sense_definition": "The past participle of the verb <w>blow</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind has <w>blown</w> the leaves all over the garden.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>разнес</w> листья по всему саду.",
                                "zh": "大风把落叶<w>吹</w>得满园都是。"
                            }
                        },
                        {
                            "text": "She has <w>blown</w> out all the candles on her birthday cake.",
                            "target_lang_translations": {
                                "ru": "Она <w>задула</w> все свечи на своем именинном торте.",
                                "zh": "她<w>吹</w>灭了生日蛋糕上所有的蜡烛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have blown",
                        "has blown"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола blow (дуть).",
                        "zh": "动词 blow 的过去分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развеянный",
                                "target_lang_sense_clarification": "ветром"
                            },
                            {
                                "target_lang_word": "задутый",
                                "target_lang_sense_clarification": "погашенный потоком воздуха"
                            },
                            {
                                "target_lang_word": "надутый",
                                "target_lang_sense_clarification": "наполненный воздухом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吹",
                                "target_lang_sense_clarification": "指风吹动或吹灭"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "332cd729-65f7-3d29-93df-e1ad1827f403",
                    "sense_definition": "Damaged or rendered non-functional by excessive pressure, overheating, or an explosion, often referring to electrical parts or engines.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car would not start because of a <w>blown</w> fuse.",
                            "target_lang_translations": {
                                "ru": "Машина не заводилась из-за <w>перегоревшего</w> предохранителя.",
                                "zh": "因为保险丝<w>烧断</w>了，车子发动不起来。"
                            }
                        },
                        {
                            "text": "He had to pay a lot of money to fix the <w>blown</w> head gasket.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось заплатить кучу денег, чтобы починить <w>пробитую</w> прокладку головки блока цилиндров.",
                                "zh": "他花了大价钱才修好那块<w>冲坏</w>的气缸垫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blown fuse",
                        "blown gasket",
                        "blown engine",
                        "blown bulb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поврежденный или вышедший из строя из-за перегрева, давления или взрыва (обычно об электрике или деталях двигателя).",
                        "zh": "指因压力过大、过热或爆炸而损坏或无法正常工作的部件，常用于电气元件或发动机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегоревший",
                                "target_lang_sense_clarification": "о предохранителе или лампочке"
                            },
                            {
                                "target_lang_word": "пробитый",
                                "target_lang_sense_clarification": "о прокладке или шине"
                            },
                            {
                                "target_lang_word": "сгоревший",
                                "target_lang_sense_clarification": "об электронике или моторе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烧断",
                                "target_lang_sense_clarification": "指保险丝或灯丝"
                            },
                            {
                                "target_lang_word": "冲坏",
                                "target_lang_sense_clarification": "指发动机垫片等密封件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68fac2ed-d94d-3150-9c29-d112cbf09cb6",
                    "sense_definition": "Shaped or created by forcing air into molten material, especially glass.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum features a beautiful collection of <w>blown</w> glass vases.",
                            "target_lang_translations": {
                                "ru": "В музее представлена прекрасная коллекция ваз из <w>выдувного</w> стекла.",
                                "zh": "博物馆里展出了一系列精美的<w>吹制</w>玻璃花瓶。"
                            }
                        },
                        {
                            "text": "Artisans create <w>blown</w> ornaments by hand using traditional techniques.",
                            "target_lang_translations": {
                                "ru": "Ремесленники создают <w>выдувные</w> украшения вручную, используя традиционные методы.",
                                "zh": "工匠们利用传统工艺手工制作<w>吹制</w>装饰品。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blown glass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготовленный методом выдувания (обычно о стекле).",
                        "zh": "通过向熔融材料（尤其是玻璃）中吹气而制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдувной",
                                "target_lang_sense_clarification": "о стеклянных изделиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吹制",
                                "target_lang_sense_clarification": "指玻璃工艺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aef01d4-2f1c-3716-a408-892593621167",
                    "sense_definition": "Equipped with a supercharger to increase engine power.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic spent the weekend working on his <w>blown</w> hot rod.",
                            "target_lang_translations": {
                                "ru": "Механик провел выходные, работая над своим хот-родом <w>с наддувом</w>.",
                                "zh": "机械师整个周末都在修理他那辆<w>增压</w>改装车。"
                            }
                        },
                        {
                            "text": "A <w>blown</w> V8 engine produces significantly more horsepower than a standard one.",
                            "target_lang_translations": {
                                "ru": "Двигатель V8 <w>с наддувом</w> выдает значительно больше лошадиных сил, чем стандартный.",
                                "zh": "一台<w>增压</w>V8发动机产生的马力远高于普通发动机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "supercharged"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный нагнетателем (суперчарджером) для увеличения мощности двигателя.",
                        "zh": "指配备了增压器以提高发动机功率的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с наддувом",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "компрессорный",
                                "target_lang_sense_clarification": "о типе двигателя"
                            },
                            {
                                "target_lang_word": "форсированный",
                                "target_lang_sense_clarification": "общая мощность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增压",
                                "target_lang_sense_clarification": "指发动机技术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61c7f9ce-84b8-3df9-9289-1aa261a5df1c",
                    "sense_definition": "Breathing heavily due to physical exertion; out of breath.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horses were <w>blown</w> and exhausted after the long gallop.",
                            "target_lang_translations": {
                                "ru": "Лошади были <w>загнаны</w> и истощены после долгого галопа.",
                                "zh": "长距离疾驰后，马儿已经<w>精疲力竭</w>了。"
                            }
                        },
                        {
                            "text": "He was completely <w>blown</w> by the time he reached the top of the hill.",
                            "target_lang_translations": {
                                "ru": "Он совершенно <w>выдохся</w> к тому времени, как добрался до вершины холма.",
                                "zh": "等他爬到山顶时，已经<w>气喘吁吁</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело дышащий от физического напряжения; запыхавшийся.",
                        "zh": "因体力消耗而呼吸急促；气喘吁吁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запыхавшийся",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "загнанный",
                                "target_lang_sense_clarification": "о лошади"
                            },
                            {
                                "target_lang_word": "без сил",
                                "target_lang_sense_clarification": "состояние усталости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气喘吁吁",
                                "target_lang_sense_clarification": "形容人呼吸急促"
                            },
                            {
                                "target_lang_word": "精疲力竭",
                                "target_lang_sense_clarification": "形容极度疲劳"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}