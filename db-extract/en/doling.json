                "senses": [
                    {
                        "sense_id": "d78c0f7f-2780-34b4-9627-854f9bec7573",
                        "entry_id": "a7bae05d-9b3c-315c-9bab-38797f404959",
                        "glosses": [
                            "The act of one who doles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4951e4-80c0-4c78-a642-1bcb6f622162",
                                "sense_id": "d78c0f7f-2780-34b4-9627-854f9bec7573",
                                "text": "Alas! we talk of their vanity; we forget that, in doling forth the careless commendation, or as careless sneer, we are bestowing but the passing thought of a moment to that which has been the work of an existence."
                            },
                            {
                                "example_id": "ae2abad1-d5c9-4fab-91f2-0c35c37e5f60",
                                "sense_id": "d78c0f7f-2780-34b4-9627-854f9bec7573",
                                "text": "Their charities never have been limited to the necessities of mere subsistence, like the secular dolings out of so-called modern charity."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
