                                        "examples": [
                                            {
                                                "example_id": "a802b7b5-b368-4b16-95ae-fd47132b34b0",
                                                "sense_id": "3bf2f4db-4dd7-35ed-b909-380de73bf559",
                                                "text": "Medaili Za zásluhy měl převzít společně se Zikmundem také jeho cestovatelské dvojče Jiří Hanzelka, ale ten už několik měsíců leží v nemocnici."
                                            },
                                            {
                                                "example_id": "59e5e5bc-1493-468c-ada6-e9d1f3e580f2",
                                                "sense_id": "3bf2f4db-4dd7-35ed-b909-380de73bf559",
                                                "text": "Balaštíkovo hokejové dvojče Petr Leška proměnil dva samostatné nájezdy."
                                            },
                                            {
                                                "example_id": "c3a46c48-ee80-4536-8486-2814581988a8",
                                                "sense_id": "3bf2f4db-4dd7-35ed-b909-380de73bf559",
                                                "text": "Pilot takového obráceného balonu ovšem nevidí, kam letí, a tak ho musí vždy navádět další balon, jeho dvojče, které je už obráceno správně a letí vždy poblíž."
                                            },
                                            {
                                                "example_id": "acf80793-fcc8-46b2-aeff-85cfcad55d10",
                                                "sense_id": "3bf2f4db-4dd7-35ed-b909-380de73bf559",
                                                "text": "Vynikajícímu golfistovi, který se úspěšně vyhýbá médiím, se kvůli jeho skvělým letitým vztahům s primátorem Pavlem Bémem (ODS) často přezdívá „Bémovo dvojče“, oběma dohromady se pak říká „blaničtí rytíři“."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ee218dd-3900-3a8a-bef1-0a2a903835a2",
                                        "entry_id": "a98571e3-a219-340a-968d-522ef567b18d",
                                        "glosses": [
                                            "ten (či to), co někoho (něco) velmi silně připomíná"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6373f1-462f-49ae-aff9-6d9df2eb9beb",
                                                "sense_id": "3ee218dd-3900-3a8a-bef1-0a2a903835a2",
                                                "text": "Budoucí prezident tak může přijít sociální demokracii velice draho. Pokud jím bude Zeman, může na to tato strana doplatit ještě mnohem více, než kdyby se jím stalo Zemanovo dvojče Václav Klaus."
                                            },
                                            {
                                                "example_id": "df3663f5-c5a7-4cdd-8f42-907a7b5fcd46",
                                                "sense_id": "3ee218dd-3900-3a8a-bef1-0a2a903835a2",
                                                "text": "Spirálovitou galaxii NGC 3949, kterou zachytil Hubbleův vesmírný teleskop, vědci označují za dvojče Mléčné dráhy. Tvarem i strukturou se jí totiž velmi blíží."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82d3da7-f36d-3e4e-9ae6-d1d558ce05a4",
                                        "entry_id": "a98571e3-a219-340a-968d-522ef567b18d",
                                        "glosses": [
                                            "kazetový magnetofon se dvěma kazetami (umožňujícími kopírování kazet)"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfa3b7eb-25da-4f6e-bcc5-06a3b13a1f14",
                                                "sense_id": "b82d3da7-f36d-3e4e-9ae6-d1d558ce05a4",
                                                "text": "Každý, kdo měl vysněné dvojče (kazeťák se dvěma kazetami), kopíroval jako šílený. Kdo přinesl do party nějakou novou skvělou kapelu či kvalitní záznam koncertu, měl na měsíc o popularitu vystaráno."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe0a745a-d58f-3163-9560-a3d43fa53d67",
                                        "entry_id": "a98571e3-a219-340a-968d-522ef567b18d",
                                        "glosses": [
                                            "zbraň sestávající ze dvou spojených kulometů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d0e5592-d7d1-4acc-bf1c-7b70b6baf715",
                                                "sense_id": "fe0a745a-d58f-3163-9560-a3d43fa53d67",
                                                "text": "S automatickými zbraněmi ráže 30 mm měli českoslovenští konstruktéři letité zkušenosti, sahající až do roku 1944, kdy ve Zbrojovce Brno vyvíjeli protiletadlové dvojče pro německé ponorky"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ccafbb-1675-36a1-803a-b93c29d78439",
                                        "entry_id": "a98571e3-a219-340a-968d-522ef567b18d",
                                        "glosses": [
                                            "jeden ze dvou či více srostlých krystalů, sdílejících souměrně některé atomy"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
