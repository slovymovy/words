                                            {
                                                "example_id": "e52a76ad-f3a0-413f-b02c-dc871b1a5caa",
                                                "sense_id": "4e2d92cb-da26-3b75-80ef-2f7a88901ea2",
                                                "text": "Le tournoi junior me semble tellement éloigné du prestigieux tournoi adulte. J'ai l'impression d'être une joueuse de sous-catégorie."
                                            },
                                            {
                                                "example_id": "9132649a-ff25-48a1-8933-ca7d9d3a6613",
                                                "sense_id": "4e2d92cb-da26-3b75-80ef-2f7a88901ea2",
                                                "text": "Nils Guyon, très performant en Catalogne comme lors de tous les tournois estivaux de 2021, est encore de la fête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "729eeb16-38a5-36f5-9580-ecdcb4ca1e09",
                                        "entry_id": "7faeb9b8-ec15-32bc-985c-8b754bb730bf",
                                        "glosses": [
                                            "Combat à armes courtoises entre deux ou plusieurs partis de chevaliers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c38195-0cb1-4f88-89e0-f9d835733dfd",
                                                "sense_id": "729eeb16-38a5-36f5-9580-ecdcb4ca1e09",
                                                "text": "Le prince fit publier le tournoi."
                                            },
                                            {
                                                "example_id": "ac7f9a1b-c23d-4a73-8f0b-0122019a8551",
                                                "sense_id": "729eeb16-38a5-36f5-9580-ecdcb4ca1e09",
                                                "text": "La faveur des tournois s’est continuée jusqu’au XVIe siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ca4794-1b95-31d8-a641-98dde17d5c67",
                                        "entry_id": "7faeb9b8-ec15-32bc-985c-8b754bb730bf",
