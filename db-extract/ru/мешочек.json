                        ],
                        "examples": [
                            {
                                "example_id": "d7fc9e11-348b-4cb4-889e-15974ef5f926",
                                "sense_id": "02e069b1-1e18-3d8d-8f4a-46231f0fa0ae",
                                "text": "свари́ть яйцо́ в мешо́чек",
                                "translation": "to cook an egg semisoft",
                                "english": "to cook an egg semisoft"
                            },
                            {
                                "example_id": "7d715f0c-936b-4260-936b-70ba30b0f94f",
                                "sense_id": "02e069b1-1e18-3d8d-8f4a-46231f0fa0ae",
                                "text": "—[...]По́мнится, что он в мешо́чек колбасу́ и три францу́зских хле́ба положи́л![...]",
                                "translation": "‘…I remember him putting a sausage and three French loaves in the bag.…’",
                                "english": "‘…I remember him putting a sausage and three French loaves in the bag.…’"
                            }
                        ]
                    }
