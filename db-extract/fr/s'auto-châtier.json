                "senses": [
                    {
                        "sense_id": "c3a52ecd-e91c-34e0-a310-52407fbe5141",
                        "entry_id": "5d972ea2-3282-360b-bf7e-d66d6a30b946",
                        "glosses": [
                            "Se châtier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "079775f4-8a05-40b4-aa4b-21ccb30d722d",
                                "sense_id": "c3a52ecd-e91c-34e0-a310-52407fbe5141",
                                "text": "Bûcher pour nous auto-châtier en tant qu’hérétiques de ces temps hermétiques."
                            },
                            {
                                "example_id": "33ef5c5a-ede5-46fb-9b5e-8b0e7c191b77",
                                "sense_id": "c3a52ecd-e91c-34e0-a310-52407fbe5141",
                                "text": "Le responsable va immédiatement s’auto-châtier !"
                            },
                            {
                                "example_id": "8719ad88-a610-40f3-af64-9071b9b216cf",
                                "sense_id": "c3a52ecd-e91c-34e0-a310-52407fbe5141",
                                "text": "Ajouté à son dépérissement progressif, le voir s’auto-châtier, pour des crimes dont il était probablement innocent, devait être cruel pour ses amis."
                            }
                        ]
                    }
