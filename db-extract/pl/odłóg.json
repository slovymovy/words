                                            },
                                            {
                                                "example_id": "4c32d7a3-2cb3-4d3d-b02e-c92b276cd51e",
                                                "sense_id": "eee4f20e-0b3e-3be6-bab8-7cb705c438ea",
                                                "text": "How does your fallow greyhound, sir?"
