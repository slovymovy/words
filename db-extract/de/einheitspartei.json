                ],
                "senses": [
                    {
                        "sense_id": "9672bc1a-59b1-3bf2-baae-093b5d365468",
                        "entry_id": "6cc0235e-f0d8-3ee8-85ad-74d67d065420",
                        "glosses": [
                            "die Partei eines Landes, die alle konformen politischen Strömungen beinhaltet; oft unterdrückt diese Partei oppositionelle Strömungen, um ihre Vormachtsstellung zu wahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc6590d-2462-493a-8a36-bc41eb7ce5c6",
                                "sense_id": "9672bc1a-59b1-3bf2-baae-093b5d365468",
                                "text": "„Tansanias Einheitspartei Chama Cha Mapinduzi (CCM) befürwortete im Verlauf eines Parteitags am 19. Februar in Daressalam die Abschaffung des Einparteiensystems in dem afrikanischen Staat und die Einführung eines Systems des politischen Pluralismus, in dessen Rahmen sich verschiedene Parteien bilden können.“"
                            },
                            {
                                "example_id": "681e6286-3250-4e9c-ad5d-3cdb7bc5020f",
                                "sense_id": "9672bc1a-59b1-3bf2-baae-093b5d365468",
                                "text": "„Die Unfähigkeit der ‚Sozialistischen Einheitspartei Deutschlands‘ (SED), mit politischen Gegnern und oppositionellen Strömungen in den eigenen Reihen flexibel und duldsam umzugehen, ergab sich aus ihrer ideologischen und organisatorischen Herkunft.“"
                            },
                            {
                                "example_id": "a2108c5d-3059-4000-b5e2-593fe5f26252",
                                "sense_id": "9672bc1a-59b1-3bf2-baae-093b5d365468",
                                "text": "„Man hörte, dass der Vorschlag gemacht worden sei, das Abzeichen der Einheitspartei des tschechischen Volkes, die Präsident Hácha sofort nach dem Einmarsch der Deutschen gegründet hatte, umzudrehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
