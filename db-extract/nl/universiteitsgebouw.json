                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5cb7028-ad2a-49ec-9555-fcc6e53138f1",
                                "sense_id": "0b10e3a7-9e0d-3a4b-a882-0783ef4a533b",
                                "text": "Op het dak van een universiteitsgebouw bij Lyon is vanochtend een grote explosie geweest. Daarna brak er brand uit. De universiteit in de voorstad Villeurbanne zegt dat de explosie ontstond bij werkzaamheden. Mogelijk zijn gasflessen ontploft."
                            },
                            {
                                "example_id": "af54e668-b6c6-4014-89fb-a40afcfcc8ad",
                                "sense_id": "0b10e3a7-9e0d-3a4b-a882-0783ef4a533b",
                                "text": "Op het dak van een universiteitsgebouw bij Lyon is vanochtend een grote explosie geweest. Daarna brak er brand uit. Drie mensen zijn lichtgewond geraakt, meldt Université Claude Bernard Lyon 1."
                            }
