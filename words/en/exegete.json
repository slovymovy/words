{
    "word_family": [
        "exegesis",
        "exegetic",
        "exegetical",
        "exegetics"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "12cd5590-eef6-3ef3-9f31-8cd459ec24d3",
                    "sense_definition": "A person skilled in exegesis; an interpreter of texts, difficult passages, law, oracles, and similar obscure or esoteric sources.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biblical <w>exegete</w> spent decades analyzing the ancient Hebrew manuscripts to uncover their original meaning.",
                            "target_lang_translations": {
                                "pl": "Biblijny <w>egzegeta</w> spędził dziesięciolecia na analizowaniu starożytnych hebrajskich manuskryptów, aby odkryć ich pierwotne znaczenie."
                            }
                        },
                        {
                            "text": "As a skilled literary <w>exegete</w>, she was able to clarify the most obscure passages of the medieval poem.",
                            "target_lang_translations": {
                                "pl": "Jako wprawna <w>egzegetka</w> literatury była w stanie wyjaśnić najbardziej niejasne fragmenty średniowiecznego poematu."
                            }
                        }
                    ],
                    "synonyms": [
                        "exegetist",
                        "hermeneut",
                        "hermeneutician",
                        "hermeneuticist"
                    ],
                    "common_phrases": [
                        "biblical exegete",
                        "literary exegete"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba biegła w egzegezie; interpretator tekstów, trudnych fragmentów, prawa, wyroczni i podobnych niejasnych lub ezoterycznych źródeł."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "egzegeta",
                                "target_lang_sense_clarification": "forma męska"
                            },
                            {
                                "target_lang_word": "egzegetka",
                                "target_lang_sense_clarification": "forma żeńska"
                            },
                            {
                                "target_lang_word": "interpretator",
                                "target_lang_sense_clarification": "ogólne określenie osoby objaśniającej teksty"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45b74457-1cae-3798-b1f1-966dd7466f3e",
                    "sense_definition": "To interpret or perform an exegesis on a text, especially a religious scripture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars continue to <w>exegete</w> the ancient scriptures to understand their historical context.",
                            "target_lang_translations": {
                                "pl": "Uczeni nadal <w>dokonują egzegezy</w> starożytnych pism, aby zrozumieć ich kontekst historyczny."
                            }
                        },
                        {
                            "text": "It is difficult to <w>exegete</w> sacred texts without a deep knowledge of ancient languages.",
                            "target_lang_translations": {
                                "pl": "Trudno jest <w>interpretować</w> święte teksty bez głębokiej znajomości starożytnych języków."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exegete sacred texts",
                        "exegete the scriptures"
                    ],
                    "target_lang_definitions": {
                        "pl": "Dokonywać interpretacji lub egzegezy tekstu, zwłaszcza pisma świętego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dokonywać egzegezy",
                                "target_lang_sense_clarification": "przeprowadzać krytyczną interpretację tekstu"
                            },
                            {
                                "target_lang_word": "interpretować",
                                "target_lang_sense_clarification": "objaśniać sens tekstu, zwłaszcza religijnego"
                            },
                            {
                                "target_lang_word": "objaśniać",
                                "target_lang_sense_clarification": "wyjaśniać znaczenie trudnych fragmentów"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}