                        "glosses": [
                            "Concernant l'interaction ou les différences entre les hommes et les femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea271dfc-9878-4e31-b6de-c4fb314347e4",
                                "sense_id": "290173e2-4db5-3ee0-b200-6e25d9a7b7eb",
                                "text": "La parité hommes-femmes."
                            },
                            {
                                "example_id": "b3909f0f-2f16-4bd5-9f2a-38544b4fbb9f",
                                "sense_id": "290173e2-4db5-3ee0-b200-6e25d9a7b7eb",
                                "text": "L’égalité hommes-femmes."
                            },
                            {
                                "example_id": "59b693bc-ec19-44b6-9e56-bacd68c407c5",
                                "sense_id": "290173e2-4db5-3ee0-b200-6e25d9a7b7eb",
                                "text": "Prenons le cas des religions monothéistes qui présentent en général une vision inégalitaire des rapports hommes-femmes."
                            }
                        ]
                    }
