                    {
                        "form_id": "44fc18ad-c4f7-4ae1-a9ba-2af4ccbf9e76",
                        "entry_id": "2984417b-4537-3f94-bd25-8521e9dff611",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mikronährstoffe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99cf83b5-39bc-3bcc-b1ac-b0e243f78400",
                        "entry_id": "2984417b-4537-3f94-bd25-8521e9dff611",
                        "glosses": [
                            "notwendiger Nährstoff von Pflanzen, der jedoch nur in geringen Mengen erforderlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "827f6a30-97a8-4dde-af38-3bb3220a1b37",
                                "sense_id": "99cf83b5-39bc-3bcc-b1ac-b0e243f78400",
                                "text": "„Vitamin A beeinflusst bei den Tieren das Immunsystem und den Hormonhaushalt sowie die Pigmentierung roter und gelber Federn. Der Mikronährstoff entsteht durch die Umwandlung von Beta-Carotinen.“"
                            },
                            {
                                "example_id": "78b8b9c7-3a57-4236-8a5d-6ddcaf146eb5",
                                "sense_id": "99cf83b5-39bc-3bcc-b1ac-b0e243f78400",
                                "text": "„ERDINGER Alkoholfrei – pur oder als Mix mit Grapefruit oder Zitrone – enthält B12 sowie Folsäure. Diese Mikronährstoffe werden für die Fettverbrennung und den Energiestoffwechsel benötigt.“"
                            },
                            {
                                "example_id": "63221297-514e-4502-b148-5b6bbbfa5e37",
                                "sense_id": "99cf83b5-39bc-3bcc-b1ac-b0e243f78400",
                                "text": "„In kleinen Plastikbehältern, die genau in die ungenutzten Leerräume zwischen den Flaschen passen, liefert die Initiative nun unter anderem Tabletten mit dem wichtigen Nährstoff Zink in entlegene Dörfer. Solche Mikronährstoffe fanden im weltweiten Kampf gegen Unterernährung lange nur wenig Beachtung.“"
                            },
                            {
                                "example_id": "518994fb-1c8f-44f7-a803-704791760851",
                                "sense_id": "99cf83b5-39bc-3bcc-b1ac-b0e243f78400",
                                "text": "„Allerdings existieren keine verbindlichen Empfehlungen, welche Mengen an Mikronährstoffen tatsächlich bei sportlicher Aktivität notwendig sind oder aufgenommen werden müssten1.“"
                            },
                            {
                                "example_id": "2f900bef-0493-4219-ba0e-e7d4aa957661",
                                "sense_id": "99cf83b5-39bc-3bcc-b1ac-b0e243f78400",
                                "text": "„Übergewicht gehe besonders bei Heranwachsenden oft mit einem Mangel an Mikronährstoffen einher, also an denjenigen Nahrungsbestandteilen, die keine Energie liefern, aber ebenfalls lebensnotwendig sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
