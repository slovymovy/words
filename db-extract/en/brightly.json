                "senses": [
                    {
                        "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                        "entry_id": "dc090dbf-eebe-311e-9f55-c5e87607aebd",
                        "glosses": [
                            "In a bright manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85d3c11-9b4a-4ec2-affc-39f20fade48f",
                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                "text": "The sun was shining brightly, making me squint."
                            },
                            {
                                "example_id": "be9c98ae-b1df-402e-844b-b2c4cc896251",
                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                "text": "The visitors started brightly and had an early chance when Valencia's experienced captain David Albeda gifted the ball to Fernando Torres, but the striker was caught by defender Adil Rami as he threatened to shoot."
                            },
                            {
                                "example_id": "0615750b-1eeb-4565-8284-2ee363be4214",
                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                "text": "She looked brightly at Grandmamma, who nodded and said, 'Yes, it's yours now.'"
                            },
                            {
                                "example_id": "df64ae00-025d-4baa-bb9f-5c635faa55ef",
                                "sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                                "text": "Now he rushed to the platform edge carrying a full fire bucket, in a forlorn attempt to douse the flames as the now brightly burning wagon rolled past."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d45f4ea-c4ba-4993-b30c-d0e138877c11",
                        "source_entry_id": "dc090dbf-eebe-311e-9f55-c5e87607aebd",
                        "source_sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                        "source_sense_description": "in a bright manner",
                        "target_lang_word": "jasně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jasně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8c8679-0d43-35d1-b9d8-569eecb1d226",
                                        "entry_id": "80a48d79-09ee-3719-a26f-23607e835e4a",
                                        "glosses": [
                                            "jasným způsobem, se září"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051dc021-6259-44ef-8d57-62ed31667855",
                                                "sense_id": "fc8c8679-0d43-35d1-b9d8-569eecb1d226",
                                                "text": "Hvězdy na nebi jasně zářily."
                                            },
                                            {
                                                "example_id": "0778e221-ffda-47e8-8ee9-b7725d2d4dd3",
                                                "sense_id": "fc8c8679-0d43-35d1-b9d8-569eecb1d226",
                                                "text": "Slečna na sobě měla šaty jasně červené barvy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d42963f-e5bc-3ffa-ab14-f796b589f90e",
                                        "entry_id": "80a48d79-09ee-3719-a26f-23607e835e4a",
                                        "glosses": [
                                            "jasným, pochopitelným způsobem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "065999da-c7e2-4835-995e-df366f1ad605",
                                                "sense_id": "1d42963f-e5bc-3ffa-ab14-f796b589f90e",
                                                "text": "Chceš-li, aby ti rozuměli, musíš jim to vysvětlit jasně."
                                            },
                                            {
                                                "example_id": "8342197d-dc8d-464a-9931-f7c35fa3780d",
                                                "sense_id": "1d42963f-e5bc-3ffa-ab14-f796b589f90e",
                                                "text": "Zákon jasně popisuje, co se smí a co ne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jasně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "278a7e78-a5f3-34ac-ae32-be623fc549f2",
                                        "entry_id": "871a553f-7b3e-332b-a870-984af4bab0b5",
                                        "glosses": [
                                            "bez pochyb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4431b33-daac-4fc4-8ecd-f1804d21a96f",
                                                "sense_id": "278a7e78-a5f3-34ac-ae32-be623fc549f2",
                                                "text": "Jasně že jdeme s vámi!"
                                            },
                                            {
                                                "example_id": "6a4e54db-5963-4269-afbf-8753b08a00d9",
                                                "sense_id": "278a7e78-a5f3-34ac-ae32-be623fc549f2",
                                                "text": "„Dáš si panáka?“ „No jasně že ano!“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30e7be6f-840b-4437-b363-85c3e78d58fb",
                        "source_entry_id": "dc090dbf-eebe-311e-9f55-c5e87607aebd",
                        "source_sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                        "source_sense_description": "in a bright manner",
                        "target_lang_word": "clairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                        "entry_id": "7f529d56-3e31-3be5-9129-9cb46608c8a8",
                                        "glosses": [
                                            "D’une manière claire et nette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a07e334-3376-4e75-b122-fa360b162691",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Les principaux problèmes auxquels il faudra faire face dans vingt ans sont clairement posés : la Corée du Nord et l’Iran auront-ils à cette date une arme nucléaire qui puisse être vectorisée ?"
                                            },
                                            {
                                                "example_id": "cb1d0246-8a3b-40d5-bae2-d1bcb1d17394",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Si vous vous expliquiez un peu plus clairement."
                                            },
                                            {
                                                "example_id": "5b5c360e-5448-4564-93d3-ef4dda66808b",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "[Elle] […] fait voir clairement les merveilleux effets Qu’en un cœur irrité produisent les bienfaits."
                                            },
                                            {
                                                "example_id": "2d18c738-88df-4e7b-b6bf-79138f37f2a2",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Ce que l’on conçoit bien s’énonce clairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577a5fee-5d38-36c0-9f3d-8cb1c1d72510",
                                        "entry_id": "7f529d56-3e31-3be5-9129-9cb46608c8a8",
                                        "glosses": [
                                            "Indéniablement, sans aucun doute."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403dffde-55df-4e1f-8dc5-947e3ba31359",
                                                "sense_id": "577a5fee-5d38-36c0-9f3d-8cb1c1d72510",
                                                "text": "C’est clairement moins cher dans ce magasin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d0fb215-757e-470c-8820-0e929623da35",
                        "source_entry_id": "dc090dbf-eebe-311e-9f55-c5e87607aebd",
                        "source_sense_id": "a1827a30-4c7b-3963-9039-e4c170dfe482",
                        "source_sense_description": "in a bright manner",
                        "target_lang_word": "précisément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précisément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                        "entry_id": "8234c244-0c69-3023-8d83-f8fd6784f089",
                                        "glosses": [
                                            "Avec précision ; exactement ; au plus juste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aef0909-b832-40e9-bdf6-54e32d80c77d",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Le pauvre homme vivotait dans un chaos d’innovations continuelles et acharnées, en un endroit précisément où ces innovations s’effectuaient ostensiblement et impitoyablement."
                                            },
                                            {
                                                "example_id": "45d9e97f-f817-44c2-a97c-ef843bb1de8e",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s’efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d’une forme littéraire."
                                            },
                                            {
                                                "example_id": "7007f738-68eb-4e1a-929f-d6cd8b154788",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Pourvu que ceux que nous faisons parler se soient connus…. nous ne sommes pas obligés à nous attacher si précisément à la durée de leur vie,"
                                            },
                                            {
                                                "example_id": "bcedb2a2-153e-406c-b5f2-23f981ce033c",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Il n'y a presque personne qui ne pense plutôt à ce qu’il veut dire qu’à répondre précisément à ce qu’on lui dit,"
                                            },
                                            {
                                                "example_id": "fb698b01-f288-45a8-8592-bfb5c8b8b800",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Nous fîmes bien précisément ce que nous avions résolu,"
                                            },
                                            {
                                                "example_id": "33dd2bb6-86dc-4ac4-b6b6-ff23ccf88495",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Vouloir et agir, c’est précisément la même chose qu’être libre,"
                                            },
                                            {
                                                "example_id": "b3f9d641-f067-4ff4-a66e-6fd70f4d7c24",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "C'est précisément parce qu’on est riche, qu’on se vend plus cher, quand on fait tant que de se vendre,"
                                            },
                                            {
                                                "example_id": "a87b8d29-ba1c-497b-abab-b54237734330",
                                                "sense_id": "13fbd406-21a6-3675-aea8-ec64e5a57945",
                                                "text": "Pendant les répétitions, il a fait des raccords, ajouté des béquets, et aussi pratiqué des coupures qui ont précisément pour but de lui rendre ce public indulgent et favorable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414afb98-428b-3c75-9972-6bafeb73df7c",
                                        "entry_id": "8234c244-0c69-3023-8d83-f8fd6784f089",
                                        "glosses": [
                                            "Véritablement ; réellement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                                        "entry_id": "8234c244-0c69-3023-8d83-f8fd6784f089",
                                        "glosses": [
                                            "Oui, c’est cela."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "915d6724-e3db-48cb-83ab-a504ed7f6d50",
                                                "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                                                "text": "— Le chevalier : Je parie que ce rival redoutable, c’est Volsain.\n — La comtesse : Précisément."
                                            },
                                            {
                                                "example_id": "493f4cd6-dd00-4262-8b6d-e9107cb2bd1b",
                                                "sense_id": "b0fe7ea4-5419-3e7f-aabd-55eb06235310",
                                                "text": "Précisément, reprit Timante ; celui que je propose est ce qui vous convient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
