                ],
                "senses": [
                    {
                        "sense_id": "7fc12b87-9dc8-3574-ba6e-cfae03d84f6a",
                        "entry_id": "1ad7c504-70dd-3b3f-aec5-a648cb89efdd",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным канал; свойственный, характерный для канала"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f334d273-721a-4ba5-94b5-810d34b0833d",
                                "sense_id": "7fc12b87-9dc8-3574-ba6e-cfae03d84f6a",
                                "text": "А про сухое лето и говорить нечего ― одна песчаная пыль поднимется на канальном русле."
                            },
                            {
                                "example_id": "88e15ad2-f97c-4578-8d4f-3b961a4ef716",
                                "sense_id": "7fc12b87-9dc8-3574-ba6e-cfae03d84f6a",
                                "text": "По условиям плавания новые водные пути делятся на четыре вида: речные (с регулируемым стоком), канальные, озерные и морские."
                            },
                            {
                                "example_id": "8ee6e635-a4e5-44e0-92a7-5d84dcb4665e",
                                "sense_id": "7fc12b87-9dc8-3574-ba6e-cfae03d84f6a",
                                "text": "В качестве канального и физического уровня могут выступать любые среды передачи данных, в частности, Ethernet или ATM."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7f94a22-8db1-3404-a4f2-d52816adb13f",
                        "entry_id": "1ad7c504-70dd-3b3f-aec5-a648cb89efdd",
                        "glosses": [
                            "расположенный у канала"
                        ],
                        "tags": [],
                        "examples": []
