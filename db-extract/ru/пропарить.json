                ],
                "translations": [
                    {
                        "translation_id": "5e8e8e42-a036-4cbd-81c6-7e79780fd9f4",
                        "source_entry_id": "3c1ff009-753c-34c8-9545-20a89fb743ec",
                        "source_sense_description": "пропустить",
                        "target_lang_word": "fail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8817c96-0b34-3d48-a6a5-132e6060d3a8",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To be unsuccessful."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24907ee1-3cd5-48d2-8220-c12ee0bd6e99",
                                                "sense_id": "c8817c96-0b34-3d48-a6a5-132e6060d3a8",
                                                "text": "Throughout my life, I have always failed."
                                            },
                                            {
                                                "example_id": "02f5e2db-bbba-4f39-af5f-d190b8b31846",
                                                "sense_id": "c8817c96-0b34-3d48-a6a5-132e6060d3a8",
                                                "text": "If they ſhoulde gyue battayle it was to be doubted, leaſt through treaſon amõgſt themſelues, the armie ſhould be betrayed into the enimies hands, the which would not fayle to execute all kinde of crueltie in the ſlaughter of the whole nation."
                                            },
                                            {
                                                "example_id": "da0781f4-860b-4be7-a4a4-8f4df98d1415",
                                                "sense_id": "c8817c96-0b34-3d48-a6a5-132e6060d3a8",
                                                "text": "As the world’s drug habit shows, governments are failing in their quest to monitor every London window-box and Andean hillside for banned plants. But even that Sisyphean task looks easy next to the fight against synthetic drugs. No sooner has a drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "865353ba-75eb-3897-90db-986672d02eb5",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "Not to achieve a particular stated goal. (Usage note: The direct object of this word is usually an infinitive.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71fe7dc-3fbf-4125-b201-949b6ebd5df8",
                                                "sense_id": "865353ba-75eb-3897-90db-986672d02eb5",
                                                "text": "The truck failed to start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa384c1-f1e5-3b21-8040-ab6425f71d09",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To neglect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc7b974-8d92-44fa-8fbe-d05d50a5db95",
                                                "sense_id": "5fa384c1-f1e5-3b21-8040-ab6425f71d09",
                                                "text": "The report fails to take into account all the mitigating factors."
                                            },
                                            {
                                                "example_id": "3929c6b3-226e-4426-9c37-1780845b9e61",
                                                "sense_id": "5fa384c1-f1e5-3b21-8040-ab6425f71d09",
                                                "text": "Those who have advocated the closure of the G.C. have so far failed to say by which alternative route this North-to-West traffic could be carried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5a7897-efac-323c-8829-9cf53a6470b3",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "Of a machine, etc.: to cease to operate correctly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a2092d7-ba20-4c69-a835-618ce3c39aaa",
                                                "sense_id": "2b5a7897-efac-323c-8829-9cf53a6470b3",
                                                "text": "After running five minutes, the engine failed."
                                            },
                                            {
                                                "example_id": "add71c7c-d684-4ddc-81d7-dbaa89a4838b",
                                                "sense_id": "2b5a7897-efac-323c-8829-9cf53a6470b3",
                                                "text": "We also found that the only emergency egress from the tram was by smashing the front or rear windscreens, and that emergency lighting had failed when the tram overturned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a21b16-938b-3c70-a5d9-d1930ba815c7",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To be wanting to, to be insufficient for, to disappoint, to desert; to disappoint one's expectations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b10be1-920e-4b75-96dc-185c3de23577",
                                                "sense_id": "51a21b16-938b-3c70-a5d9-d1930ba815c7",
                                                "text": "I've failed my parents many times growing up."
                                            },
                                            {
                                                "example_id": "81ee06ac-28c2-4003-b722-9b8165423c08",
                                                "sense_id": "51a21b16-938b-3c70-a5d9-d1930ba815c7",
                                                "text": "There shall not fail thee a man on the throne."
                                            },
                                            {
                                                "example_id": "c65e01aa-db1b-421f-8a56-55185f9ca62e",
                                                "sense_id": "51a21b16-938b-3c70-a5d9-d1930ba815c7",
                                                "text": "A poor Irish Widow […] went forth with her three children, bare of all resource, to solicit help from the Charitable Establishments of that City. At this Charitable Establishment and then at that she was refused; referred from one to the other, helped by none; — till she had exhausted them all; till her strength and heart failed her: she sank down in typhus-fever […]"
                                            },
                                            {
                                                "example_id": "9d647455-3d84-4eda-b742-dfae9167292f",
                                                "sense_id": "51a21b16-938b-3c70-a5d9-d1930ba815c7",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired. And if the arts of humbleness failed him, he overcame you by sheer impudence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5539c4e1-9509-3259-bac6-42e99fdb5fc7",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To receive one or more non-passing grades in academic pursuits."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb7d634a-af44-49d5-86a7-d02f90a7f4a4",
                                                "sense_id": "5539c4e1-9509-3259-bac6-42e99fdb5fc7",
                                                "text": "I failed English last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a92d16-32fc-38b7-a384-2059bb52e51f",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To give a student a non-passing grade in an academic endeavour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1d28c64-41bc-42c9-93e8-b98bb3ef7289",
                                                "sense_id": "29a92d16-32fc-38b7-a384-2059bb52e51f",
                                                "text": "The professor failed me because I did not complete any of the course assignments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "388b4a81-dfc1-3e86-9558-25cd9134e4b9",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To miss attaining; to lose."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09b744f-a587-4685-9541-42299766abb0",
                                                "sense_id": "388b4a81-dfc1-3e86-9558-25cd9134e4b9",
                                                "text": "though that seat of earthly bliss be failed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6bfedcf-60d0-31a5-8c0d-5e3052d43b33",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To be wanting; to fall short; to be or become deficient in any measure or degree up to total absence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3861e53c-58ee-46f7-ab62-c8b7d8242b91",
                                                "sense_id": "c6bfedcf-60d0-31a5-8c0d-5e3052d43b33",
                                                "text": "The crops failed last year."
                                            },
                                            {
                                                "example_id": "028d7bb0-20d0-4bcf-808d-be6146a452c8",
                                                "sense_id": "c6bfedcf-60d0-31a5-8c0d-5e3052d43b33",
                                                "text": "as the waters fail from the sea"
                                            },
                                            {
                                                "example_id": "e28c56f7-29ac-4234-93d5-a1456ce329db",
                                                "sense_id": "c6bfedcf-60d0-31a5-8c0d-5e3052d43b33",
                                                "text": "Till Lionel's issue fails, his should not reign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4139ac20-c15f-3cc9-a8a4-07f07eb2b766",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To be affected with want; to come short; to lack; to be deficient or unprovided; used with of."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2aca6c6-8833-478d-bfec-6fa320f2d6d4",
                                                "sense_id": "4139ac20-c15f-3cc9-a8a4-07f07eb2b766",
                                                "text": "If ever they fail of beauty, this failure is not to be attributed to their size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d93f29-e3df-395a-bad2-9bcdedd2b8d7",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To fall away; to become diminished; to decline; to decay; to sink."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64115cf3-9777-404d-8297-b38b6121f386",
                                                "sense_id": "e4d93f29-e3df-395a-bad2-9bcdedd2b8d7",
                                                "text": "When earnestly they seek / Such proof, conclude they then begin to fail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5f5123-7ef6-3615-9fbb-3c1bab9c35d0",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To deteriorate in respect to vigour, activity, resources, etc.; to become weaker."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82566347-0fdc-4c59-a1c5-534a37da3927",
                                                "sense_id": "2b5f5123-7ef6-3615-9fbb-3c1bab9c35d0",
                                                "text": "A sick man fails."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d96e393e-c8b2-3b99-810f-b17f405210fd",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To perish; to die; used of a person."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8a6c24-3129-415e-8280-23462fe68f7d",
                                                "sense_id": "d96e393e-c8b2-3b99-810f-b17f405210fd",
                                                "text": "had the king in his last sickness failed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84dc7ee8-d3fb-3707-9583-557ef54fa373",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To err in judgment; to be mistaken."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c97522a-141d-43c0-a69a-7470758b4f68",
                                                "sense_id": "84dc7ee8-d3fb-3707-9583-557ef54fa373",
                                                "text": "Which ofttimes may succeed, so as perhaps / Shall grieve him, if I fail not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "766e80b9-bea8-32cd-bd01-fb9e2c1969de",
                                        "entry_id": "b15925bd-d3d8-3dba-8b4b-feb9488792ac",
                                        "glosses": [
                                            "To become unable to meet one's engagements; especially, to be unable to pay one's debts or discharge one's business obligation; to become bankrupt or insolvent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13fb4964-0e08-3a09-ada4-04d70294060a",
