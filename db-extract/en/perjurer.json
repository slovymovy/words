    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "47444393-eca7-37e6-9b8e-4343999fa540",
                "word": "perjurer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "92913053-e319-4554-876d-607646ed6b25",
                        "entry_id": "47444393-eca7-37e6-9b8e-4343999fa540",
                        "tags": [
                            "plural"
                        ],
                        "form": "perjurers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14dc9dfe-1d19-34d8-9bde-f74cc007ef1d",
                        "entry_id": "47444393-eca7-37e6-9b8e-4343999fa540",
                        "glosses": [
                            "someone who has committed perjury by lying under oath"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a116cb-a62d-4bd7-bd8a-86e94104b759",
                                "sense_id": "14dc9dfe-1d19-34d8-9bde-f74cc007ef1d",
                                "text": "Here are none exempted or excluded, be they never so prophane or wretched, no Atheist, adulterer, thief, or murderer, no lyer, perjurer, Witch or conjurer, &c· al are one fellowship, one body, one Church."
                            },
                            {
                                "example_id": "e35c400e-67cd-40d0-a2d2-efc06116d8fa",
                                "sense_id": "14dc9dfe-1d19-34d8-9bde-f74cc007ef1d",
                                "text": "Come in, you false witness, you perjurer, you suborner of evidence, come in!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b57543d-e1eb-47c2-beb1-f6a84c4b3a62",
                        "source_entry_id": "47444393-eca7-37e6-9b8e-4343999fa540",
                        "source_sense_id": "14dc9dfe-1d19-34d8-9bde-f74cc007ef1d",
                        "source_sense_description": "Someone who has lied under oath",
                        "target_lang_word": "křivopřísežník",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e5f563ed-48a9-4cc1-9872-dc5d798685f9",
                        "source_entry_id": "47444393-eca7-37e6-9b8e-4343999fa540",
                        "source_sense_id": "14dc9dfe-1d19-34d8-9bde-f74cc007ef1d",
                        "source_sense_description": "Someone who has lied under oath",
                        "target_lang_word": "parjure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parjure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                        "entry_id": "6777bf23-22e5-3dd5-ab7d-c585b7676a21",
                                        "glosses": [
                                            "Faux serment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c76de495-22f6-4f09-bf1b-3341fc9eca0d",
                                                "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                                "text": "En signant ce traité qu’il était décidé à ne pas respecter, il a commis un parjure."
                                            },
                                            {
                                                "example_id": "22e1a17e-396f-4539-8b51-058c966ce23a",
                                                "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                                "text": "« La différence, monsieur, qui existe entre moi et vous, c’est que ma noblesse est fondée sur le serment, tandis que la vôtre est fondée sur le parjure. »"
                                            },
                                            {
                                                "example_id": "86be71d1-b5cf-4499-aaf5-e6a1bce3f36f",
                                                "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                                "text": "J’entendais bien mes propres paroles et consciemment j’affirmai coup sur coup ce mensonge par serment, rien que pour avoir l’amusante satisfaction de commettre un parjure patent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49207ea1-8db0-3146-83cb-d00551df3a98",
                                        "entry_id": "6777bf23-22e5-3dd5-ab7d-c585b7676a21",
                                        "glosses": [
                                            "Violation de serment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adaaa2ba-f472-401d-b0d3-739edc4269c9",
                                                "sense_id": "49207ea1-8db0-3146-83cb-d00551df3a98",
                                                "text": "Ne pas respecter la neutralité d’un pays est un véritable parjure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2158cbf-d349-33ec-95f7-3a879ce6b05e",
                                        "entry_id": "6777bf23-22e5-3dd5-ab7d-c585b7676a21",
                                        "glosses": [
                                            "Celui, celle qui fait un faux serment, qui viole son serment, qui se parjure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "parjure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91480603-69fc-38bd-87a4-2cca736824fc",
                                        "entry_id": "08e6a55d-6709-30d7-b61f-86f353f06811",
                                        "glosses": [
                                            "Qui fait un faux serment, qui viole son serment, qui se parjure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4df32dc0-363c-41df-8ff4-c25021aead19",
                                                "sense_id": "91480603-69fc-38bd-87a4-2cca736824fc",
                                                "text": "Ah! Manon, lui dis-je d'un ton tendre, infidèle et parjure Manon! par où commencerai-je à me plaindre?"
                                            },
                                            {
                                                "example_id": "fe8b8ed3-0fb7-4c1e-b506-94be2f1c664e",
                                                "sense_id": "91480603-69fc-38bd-87a4-2cca736824fc",
                                                "text": "Ce que j’exige de toi comme homme de parole et d’honneur, à peine d’être reconnu sans foi, parjure et infâme, c’est de pardonner et de rendre ton affection paternelle au brave chevalier Wilfrid d’Ivanhoé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parjure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96cbc9b7-4abe-3309-986e-9ad8f99e565b",
                                        "entry_id": "c758f0b5-57b0-37ef-8939-9879914993bf",
