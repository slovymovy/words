                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "459f90e1-29de-4290-8fed-441388f9bb68",
                                                "sense_id": "0c24250b-6477-3f0b-912b-88229d5fcc42",
                                                "text": "And ſince not only a dead Fathers fame, / But more a Ladies honour muſt be touch’d, / Which nice as Ermines will not bear a Soil ; / Let all retire ; that you alone may hear / What ev’n in whiſpers I won’d tell your ear."
                                            }
