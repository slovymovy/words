                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9ac8130-2d99-3cf5-8141-d837c822207b",
                        "entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                        "glosses": [
                            "Auteur ou autrice de pièces de théâtre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d161a928-3787-4c51-b9b0-e097ead8bd28",
                                "sense_id": "c9ac8130-2d99-3cf5-8141-d837c822207b",
                                "text": "L’auteur des Contes cruels reste un dramaturge mal connu et prétendument “mineur”, alors qu’il s’est toute sa vie consacré à l’écriture dramatique, et que c’est sans doute avec son théâtre qu’il est le plus inventif, à son époque."
                            },
                            {
                                "example_id": "d0b3aba3-e5c7-4e63-98d6-ba6195705b11",
                                "sense_id": "c9ac8130-2d99-3cf5-8141-d837c822207b",
                                "text": "La dramaturge engagée termine aussi ColoniséEs, une pièce inspirée de la vie de Pauline Julien et de Gérald Godin qui sera présentée en janvier, et travaille à une adaptation de J'accuse pour la France."
                            }
                        ]
                    },
                    {
                        "sense_id": "77d2e953-de0b-399f-84cc-436ffd70fb79",
                        "entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                        "glosses": [
                            "Membre de l’équipe théâtrale spécialisé dans la recherche et le conseil littéraires, l’histoire théâtrale, la documentation linguistique ou le travail philologique ; il peut également, dans certains cas, être chargé de la mission de communication et des aspects pédagogiques du travail de l’équipe artistique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8479979-7ab6-41c2-92f7-8880876e7e72",
                        "source_entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                        "source_sense_description": "Auteur ou autrice de pièces de théâtre",
                        "target_lang_word": "Dramatikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dramatikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a48c39-007a-37ba-a164-9b9463d724c1",
                                        "entry_id": "3a2b6394-ccb6-3a8c-b28c-745713224203",
                                        "glosses": [
                                            "weibliche Person, die Dramen verfasst"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04ea66ee-4f7d-43e9-8d22-d7a1cd7ced89",
                                                "sense_id": "f0a48c39-007a-37ba-a164-9b9463d724c1",
                                                "text": "„Von 1670, dem Aufführungsjahr ihres Debüt-Stückes The Forc’d Marriage, bis zu ihrem Tod im Jahr 1689, behauptet sich Aphra Behn erfolgreich als einzige Dramatikerin in der männlich dominierten Theaterwelt des ausgehenden 17. Jahrhunderts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "571377c6-6d1f-4672-a213-647a1961dac9",
                        "source_entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                        "source_sense_description": "Auteur ou autrice de pièces de théâtre",
                        "target_lang_word": "Dramatiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dramatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                        "entry_id": "c3c9b982-05b2-30f1-8b56-8e89705214b8",
                                        "glosses": [
                                            "Person, die Dramen verfasst"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6932778-260e-481e-90ef-d8b3613f9cb4",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "Manche Dramatiker haben nur Komödien verfasst."
                                            },
                                            {
                                                "example_id": "320b27ee-aa7d-4a4e-b950-69ee8a462fc5",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "„Ruth Albu ist zu diesem Zeitpunkt noch mit Heinrich Schnitzler, dem Sohn des großen Wiener Dramatikers, verheiratet.“"
                                            },
                                            {
                                                "example_id": "ead9a367-e791-489a-8409-9748be34e4d2",
                                                "sense_id": "9ba3cf28-effd-36d8-9e57-4348a8188731",
                                                "text": "„Was der Geschichtsschreiber als ungelöstes Problem stehen lassen muss, stellt der Dramatiker in einer Form hin, die ebenfalls keine Auflösung suggeriert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "012e0325-826f-4bb2-9320-13035ea3a68f",
                        "source_entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                        "source_sense_description": "Auteur ou autrice de pièces de théâtre",
                        "target_lang_word": "Theaterautor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theaterautor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd46991-a995-364c-81d9-e227aa079ded",
                                        "entry_id": "4d1f835a-9ed2-3bcf-ab49-4e22f13d7956",
                                        "glosses": [
                                            "Autor, der für das Theater arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6468139d-fb29-4a82-993f-50696e0a05fe",
                                                "sense_id": "6cd46991-a995-364c-81d9-e227aa079ded",
                                                "text": "„Der Traum, sich auch als Theaterautor zu etablieren, wird sich jedoch nicht erfüllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68006c30-e2ec-4dae-8142-339df43d20ac",
                        "source_entry_id": "f85bd5ed-fce9-3656-a535-e42d854dc9ce",
                        "source_sense_description": "Auteur ou autrice de pièces de théâtre",
                        "target_lang_word": "Theaterautorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theaterautorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fceaf6dc-e8a5-3640-a3d3-3ced49753409",
                                        "entry_id": "e4d45722-69f0-32c2-aa59-ec6d21999cb8",
                                        "glosses": [
                                            "Autorin, die für das Theater arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "676d94cc-1cca-46a8-91a4-cde52341d48e",
                                                "sense_id": "fceaf6dc-e8a5-3640-a3d3-3ced49753409",
                                                "text": "„Die Selbstreflexion der Theaterautorin als Theaterautorin, die das Theater als politischen Raum in antiker Tradition verstanden haben scheint, gibt die politische Stimme in ihrer Ratlosigkeit ab an die Fernsehnachrichten und ihren Unterhaltungswert ab an DVDs (die ‚silbernen Scheiben‘) – und damit auch das politische Schreiben, das auch Sinnstiftung in der Welt ist.“"
                                            },
                                            {
                                                "example_id": "7b1033e7-d347-4d08-95c2-3dd0e1f9804b",
                                                "sense_id": "fceaf6dc-e8a5-3640-a3d3-3ced49753409",
                                                "text": "„Junge Theaterautorinnen würden in ihren Stücken nicht nur Geschlechterverhältnisse mit all ihren Implikationen behandeln, sondern ebenfalls Kritik an anderen sozialen Missständen formulieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
