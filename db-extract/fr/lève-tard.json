                    {
                        "translation_id": "1d772219-f836-40ba-9845-478f94ac98af",
                        "source_entry_id": "db8630d3-08ff-3524-8dd5-2ced04806f91",
                        "source_sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                        "target_lang_word": "Schlafmütze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafmütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "Mütze, wie man sie früher nachts im Bett trug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66672df8-05bd-4247-ba87-548770550574",
                                                "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                                "text": "Der „deutsche Michel“ wird immer mit einer Schlafmütze dargestellt."
                                            },
                                            {
                                                "example_id": "ede4bc63-355c-4739-9e80-31f5318ad20d",
                                                "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                                "text": "„Sir Evelyn Blood, den Elefantenrücken gegen einen Kissenberg gelehnt, eine viktorianische Schlafmütze auf seinem fast kahlen Schädel, blätterte in einem Magazin mit Fotos von nackten athletischen Männerkörpern und versuchte gleichzeitig ein Gedicht zu machen.“"
                                            },
                                            {
                                                "example_id": "0071dfb2-6e4a-4618-9a7e-c7b7186b8636",
                                                "sense_id": "62a8f12a-2b60-3d9d-b3fb-14b3a4ae2560",
                                                "text": "„Der erste, dem Rostow hier begegnete, war ein kleines, dürres, einarmiges Männchen, das mit Schlafmütze und Spitalkittel, eine kurze Pfeife im Munde, im ersten Zimmer umherwanderte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1314a005-b617-3e54-82b9-56122bd438d0",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "schläfriger Mensch, Langschläfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11109dfe-393a-420c-889a-1c1d1905a903",
                                                "sense_id": "1314a005-b617-3e54-82b9-56122bd438d0",
                                                "text": "He, du alte Schlafmütze, aufwachen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1a10406c-96d9-3cf9-a98d-8842a4f50fd9",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "geistig oder körperlich träger, langsamer Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0814f2a4-63dd-44c9-a217-33098f288bb5",
                                                "sense_id": "1a10406c-96d9-3cf9-a98d-8842a4f50fd9",
                                                "text": "Hast du schon wieder vergessen, das Wasser aufzufüllen? Du bist aber auch eine Schlafmütze!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2768b56f-4089-3b09-b2c2-c9c8acdb77b7",
                                        "entry_id": "aded0842-26b8-31d6-bdcd-b8fce87bbdfa",
                                        "glosses": [
                                            "Jargon-Ausdruck für Kronenkorken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b0aadf-1e61-43c9-b1f9-7ad8e977fd85",
                                                "sense_id": "2768b56f-4089-3b09-b2c2-c9c8acdb77b7",
                                                "text": "Mit Hilfe akustischer Signale wird die Schlafmütze zum Schwingen gebracht, um den richtigen Sitz zu überprüfen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f26d1f49-92ba-4517-96cf-db6bfda4f9a5",
                        "source_entry_id": "db8630d3-08ff-3524-8dd5-2ced04806f91",
                        "source_sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                        "target_lang_word": "Spätaufsteherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spätaufsteherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                        "entry_id": "eb043884-3e4b-3f10-af50-c647ee4a56be",
                                        "glosses": [
                                            "Frau, die gewohnheitsmäßig später als üblich aufsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d5695cd-0fca-4a4f-875a-d4424704e2f7",
                                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                                "text": "„Unsere Spätaufsteherin Christina ist am Güdisdienstag 2019 zu Krampus gestossen.“"
                                            },
                                            {
                                                "example_id": "89ccd54f-efb0-443d-b9f3-e6c9fc3f4461",
                                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                                "text": "„Sie ist eher eine Spätaufsteherin und dreht erst ab ca. 23 Uhr ihre Runden durchs Gehege.“"
                                            },
                                            {
                                                "example_id": "2c4e5d3f-13df-46e1-a28f-fef6639de401",
                                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                                "text": "Die Sendung läuft aber am Samstag Morgen und ich finde, das auch SpätaufsteherInnen [sic] diese fantastische Songs hören sollten.“"
                                            },
                                            {
                                                "example_id": "ee83516c-b078-4c38-9e94-d5a42f93e826",
                                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                                "text": "„Bei der Untersuchung der University of Bristol wurde festgestellt, dass früh aufstehende Frauen im Vergleich zu Spätaufsteherinnen seltener Brustkrebs entwickeln.“"
                                            },
                                            {
                                                "example_id": "1328be6b-6720-4944-bfb1-ba7217786db4",
                                                "sense_id": "dd4a025e-9db8-3ea2-85c7-7b65185f76e3",
                                                "text": "„Ich bin eine Spätaufsteherin, und nur selten gelingt es mir, einen Blick auf den Sonnenaufgang zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "638f739a-7823-4be8-8080-10ad2e01f6d6",
                        "source_entry_id": "db8630d3-08ff-3524-8dd5-2ced04806f91",
                        "source_sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                        "target_lang_word": "Spätaufsteher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spätaufsteher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                        "entry_id": "d1b5050c-37e5-32f5-a0ea-f76fc27786de",
                                        "glosses": [
                                            "Person, die gewohnheitsmäßig später als üblich aufsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e724c7e7-48fd-4e92-999a-dfb38789b891",
                                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                                "text": "„Das Frühstück, welches für Frühaufsteher ab 06:30 und für Spätaufsteher bis 10:30 Uhr serviert wird, ist sehr abwechslungsreich.“"
                                            },
                                            {
                                                "example_id": "80162f66-2e62-4ff7-9d36-f3dc878cc40e",
                                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                                "text": "„In Frankreich beleuchten Skigebiete Pisten bis Mitternacht, damit ‚die Spätaufsteher‚ nachts Ski fahren können.“"
                                            },
                                            {
                                                "example_id": "a9e19bfb-ed64-4ee9-8442-24b835127e7f",
                                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                                "text": "„Die meisten Menschen sind laut Chronobiologie, welche die Biorhythmus-Typen untersucht, entweder Spätaufsteher oder Neutral-Typen.“"
                                            },
                                            {
                                                "example_id": "7e5adeff-8d9f-4a13-9f8c-ea134b2cd71f",
                                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                                "text": "„Inder sind Spätaufsteher, so dass Du um sieben Uhr morgens zwar nicht alleine auf dem großen Gelände bist, aber die Zahl der Touristen überschaubar ist.“"
                                            },
                                            {
                                                "example_id": "2fe51af2-e32b-4b08-8946-cfe86b5bb84c",
                                                "sense_id": "afdc599b-dba9-33e0-b3cb-c910d58869dc",
                                                "text": "„Je 20% verteilen sich auf die Früh- und Spätaufsteher, die übrigen 60% gehören zu einer Mischform, die häufig eine Vorliebe entweder für das frühe oder für das späte Aufstehen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
