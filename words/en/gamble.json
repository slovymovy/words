{
    "word_family": [
        "gambler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbd35aef-aba2-3496-91d5-2de036ddaf29",
                    "sense_definition": "To play risky games, especially casino games, for monetary gain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gambling_betting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many tourists visit the city specifically to <w>gamble</w> in the famous casinos.",
                            "target_lang_translations": {
                                "ru": "Многие туристы приезжают в город специально, чтобы <w>поиграть в азартные игры</w> в знаменитых казино.",
                                "zh": "许多游客专门来到这座城市，在著名的赌场里<w>赌博</w>。"
                            }
                        },
                        {
                            "text": "He lost a significant amount of money because he loved to <w>gamble</w> on horses.",
                            "target_lang_translations": {
                                "ru": "Он потерял значительную сумму денег, потому что любил <w>делать ставки</w> на скачках.",
                                "zh": "他因为喜欢在赛马上<w>下注</w>而输掉了一大笔钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bet",
                        "wager"
                    ],
                    "common_phrases": [
                        "gamble online",
                        "gamble responsibly",
                        "gamble away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в игры на деньги (особенно в казино), полагаясь на удачу.",
                        "zh": "为了金钱利益而参与高风险的游戏，尤指在赌场中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть в азартные игры",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "играть на деньги",
                                "target_lang_sense_clarification": "с акцентом на финансовую составляющую"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赌博",
                                "target_lang_sense_clarification": "一般性动词"
                            },
                            {
                                "target_lang_word": "博彩",
                                "target_lang_sense_clarification": "常用于正式或商业语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c3dc55a-8713-3ba4-b054-0b5b6c48bffa",
                    "sense_definition": "To take a risk, with the potential of a positive outcome.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "risk_taking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>gamble</w> on a new marketing strategy despite the high costs.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>сделать ставку</w> на новую маркетинговую стратегию, несмотря на высокие затраты.",
                                "zh": "尽管成本高昂，公司还是决定在新的营销策略上<w>押注</w>。"
                            }
                        },
                        {
                            "text": "Sometimes you have to <w>gamble</w> on your instincts to achieve success.",
                            "target_lang_translations": {
                                "ru": "Иногда нужно <w>довериться</w> интуиции (рискнуть), чтобы добиться успеха.",
                                "zh": "有时你必须<w>冒险</w>相信自己的直觉才能获得成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "risk",
                        "chance"
                    ],
                    "common_phrases": [
                        "gamble on success",
                        "gamble with life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти на риск в надежде на благоприятный исход.",
                        "zh": "为了获得潜在的积极结果而承担风险。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "действовать наудачу"
                            },
                            {
                                "target_lang_word": "делать ставку",
                                "target_lang_sense_clarification": "переносное значение: рассчитывать на что-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒险",
                                "target_lang_sense_clarification": "承担风险"
                            },
                            {
                                "target_lang_word": "押注",
                                "target_lang_sense_clarification": "比喻性用法，指把希望寄托在某事上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3ca9dfc-924c-3f53-9c09-3dcd80f2b0a7",
                    "sense_definition": "To risk something valuable for potential gain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "risk_taking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>gambled</w> his reputation on the outcome of the trial.",
                            "target_lang_translations": {
                                "ru": "Он <w>поставил на карту</w> свою репутацию, зависящую от исхода судебного процесса.",
                                "zh": "他拿自己的名誉去为审判的结果<w>冒险</w>。"
                            }
                        },
                        {
                            "text": "She was not willing to <w>gamble</w> her savings on such a volatile stock.",
                            "target_lang_translations": {
                                "ru": "Она не хотела <w>рисковать</w> своими сбережениями, вкладывая их в такие нестабильные акции.",
                                "zh": "她不愿意拿自己的积蓄去为这种波动剧烈的股票<w>冒险</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stake",
                        "risk",
                        "wager"
                    ],
                    "common_phrases": [
                        "gamble everything",
                        "gamble money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рисковать чем-то ценным ради возможной выгоды.",
                        "zh": "为了可能的收益而拿有价值的东西去冒险。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить на карту",
                                "target_lang_sense_clarification": "идиома: рисковать всем или чем-то важным"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "подвергать опасности (чем-либо)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拿……去冒险",
                                "target_lang_sense_clarification": "指将某物置于危险境地"
                            },
                            {
                                "target_lang_word": "孤注一掷",
                                "target_lang_sense_clarification": "成语，指把所有筹码押上"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1bd21e2-d52e-303e-99af-446aef2856ba",
                    "sense_definition": "A significant risk, undertaken with a potential gain.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "risk_taking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starting a business during a recession is a huge <w>gamble</w> for anyone.",
                            "target_lang_translations": {
                                "ru": "Открытие бизнеса во время рецессии — это огромный <w>риск</w> для любого.",
                                "zh": "在经济衰退期间创业对任何人来说都是一场巨大的<w>冒险</w>。"
                            }
                        },
                        {
                            "text": "The decision to hire him was a <w>gamble</w> that eventually paid off.",
                            "target_lang_translations": {
                                "ru": "Решение нанять его было <w>авантюрой</w>, которая в итоге оправдала себя.",
                                "zh": "雇佣他的决定是一场最终获得回报的<w>冒险</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "risk",
                        "venture"
                    ],
                    "antonyms": [
                        "sure thing",
                        "certainty"
                    ],
                    "common_phrases": [
                        "take a gamble",
                        "huge gamble",
                        "bit of a gamble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рискованный шаг или предприятие с надеждой на успех.",
                        "zh": "一种为了潜在收益而采取的重大风险行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "риск",
                                "target_lang_sense_clarification": "опасность неудачи"
                            },
                            {
                                "target_lang_word": "авантюра",
                                "target_lang_sense_clarification": "сомнительное или смелое предприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冒险",
                                "target_lang_sense_clarification": "名词，指风险行为"
                            },
                            {
                                "target_lang_word": "赌注",
                                "target_lang_sense_clarification": "比喻性用法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "737e0d11-5605-3e8c-96c0-9eb929e05add",
                    "sense_definition": "A bet or wager.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gambling_betting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a small <w>gamble</w> on the football match last weekend.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные я сделал небольшую <w>ставку</w> на футбольный матч.",
                                "zh": "上周末我在足球比赛上下了点小<w>赌注</w>。"
                            }
                        },
                        {
                            "text": "His <w>gamble</w> on the lottery did not result in any winnings.",
                            "target_lang_translations": {
                                "ru": "Его <w>ставка</w> в лотерее не принесла никакого выигрыша.",
                                "zh": "他在彩票上下的<w>赌注</w>并没有带来任何奖金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bet",
                        "wager"
                    ],
                    "common_phrases": [
                        "have a gamble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Денежная ставка в игре.",
                        "zh": "在博彩或游戏中下的赌金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставка",
                                "target_lang_sense_clarification": "сумма денег, поставленная на кон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赌注",
                                "target_lang_sense_clarification": "指下注的金额"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "11e562ac-b57d-3459-b17f-7773e7c95690",
                    "sense_definition": "A surname from Old Norse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited the <w>Gamble</w> family to dinner next Saturday.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Гэмбл</w> на ужин в следующую субботу.",
                                "zh": "我们邀请了<w>甘布尔</w>一家下周六来吃晚饭。"
                            }
                        },
                        {
                            "text": "Mr. <w>Gamble</w> has been teaching history at the local school for years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Гэмбл</w> уже много лет преподает историю в местной школе.",
                                "zh": "<w>甘布尔</w>先生在当地学校教历史已经很多年了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "A surname from Old Norse."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия древнескандинавского происхождения.",
                        "zh": "源自古诺斯语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гэмбл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甘布尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}