                        "sense_id": "b104a45b-e0ae-3cfd-97fa-91a5372b21fd",
                        "entry_id": "efb707cc-111a-3e44-a153-364688ff09c8",
                        "glosses": [
                            "Berufsbezeichnung für einen Beschäftigten im Vertrieb, der Kunden davon abbringen soll, ihren Vertrag mit dem eigenen Unternehmen zu kündigen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304ec22f-b527-4cc5-bd67-fbb2bbdb369d",
                                "sense_id": "b104a45b-e0ae-3cfd-97fa-91a5372b21fd",
                                "text": "„Mit Wirkung vom XX.XX.1939 übernehmen Sie den bisher von Herrn XXX bearbeiteten Bezirk als Stornobekämpfer.“"
                            },
                            {
                                "example_id": "62e31945-50a2-4e34-80fa-0a7d603ec6ff",
                                "sense_id": "b104a45b-e0ae-3cfd-97fa-91a5372b21fd",
                                "text": "Die Rechtsabteilung der Filiale zieht rückständige Prämien ein und wickelt den sich daraus ergebenden Schriftwechsel ab, verbucht die Mahnprämie und die Kosten auf den Karteikarten, stellt die Mahnstatistiken auf, leitet das gerichtliche Mahnverfahren ein und nimmt Termine bei Prämienprozessen wahr und setzt Stornobekämpfer ein."
                            }
                        ],
