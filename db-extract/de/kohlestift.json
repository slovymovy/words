                        "sense_id": "37911068-4eec-3d03-94ee-4d0d23aa4b89",
                        "entry_id": "5073c9bb-aa03-32f4-bc9d-442bf8730309",
                        "glosses": [
                            "Zeichenstift aus Holzkohle"
