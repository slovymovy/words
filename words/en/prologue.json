                    "frequency": "Middle",
                    "semantic_group_id": "introduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author wrote a brief <w>prologue</w> to explain the historical background of the story."
                        },
                        {
                            "text": "Before the main characters appeared, an actor stepped forward to deliver the <w>prologue</w>."
                        }
                    ],
                    "synonyms": [
