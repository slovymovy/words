                    },
                    {
                        "translation_id": "73c03852-1eb7-49f2-a997-f7da03e2b0e2",
                        "source_entry_id": "e6c46bab-587f-3d4b-b56a-2d94bb878cd6",
                        "source_sense_id": "b24fa5f3-8d17-30df-b7f9-4b3558b82739",
                        "source_sense_description": "Kopf eines Menschen",
                        "target_lang_word": "tête humaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête humaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f35a63de-d67b-318e-953f-9a3489b3fd9a",
                                        "entry_id": "0d1c2662-ae2d-35e0-8399-8756af8fcffe",
                                        "glosses": [
                                            "Partie supérieure du corps humain, qui est le siège du cerveau et des principaux organes des sens. Il est rattaché au reste du corps par le cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b9ab76-7af3-40c9-ba0a-037b986c4cd6",
                                                "sense_id": "f35a63de-d67b-318e-953f-9a3489b3fd9a",
                                                "text": "Tout sort du climat ; la tête humaine ne fait que reproduire et concentrer la nature qui l’environne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7512def-e34d-3347-b50b-672f8c3aef14",
                                        "entry_id": "0d1c2662-ae2d-35e0-8399-8756af8fcffe",
                                        "glosses": [
                                            "Crâne humain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d2696c3-e0ce-3168-b053-416959173792",
                                        "entry_id": "0d1c2662-ae2d-35e0-8399-8756af8fcffe",
                                        "glosses": [
                                            "Élément architectural décoratif représentant l’ensemble (cou, crâne) d’un être humain (saint, héros, seigneur, commanditaire de la construction, donateur…). À rapprocher de gargouille"
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b176a3b-b51a-3af2-91ac-19259e59ed9b",
                                        "entry_id": "0d1c2662-ae2d-35e0-8399-8756af8fcffe",
                                        "glosses": [
                                            "Meuble représentant la tête d'un être humain avec son cou dans les armoiries. Cette terminologie est rarement employée. Généralement, lorsqu’une tête est représentée, il s’agit d'un personnage spécifique dont le nom doit être mentionné dans le blasonnement. Sa position est rarement définie. On peut trouver aussi bien des têtes humaines de profil que de front. À rapprocher de tête, tête de Maure et triquètre sicilien."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea4019a6-d39a-42c9-8fef-1b155edc6e23",
                                                "sense_id": "2b176a3b-b51a-3af2-91ac-19259e59ed9b",
                                                "text": "De gueules, à une tête humaine d’argent le poil levé d’or, qui est de la famille de Pellevé → voir illustration « armoiries avec une tête humaine »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
