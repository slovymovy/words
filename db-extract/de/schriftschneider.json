                "senses": [
                    {
                        "sense_id": "35945ef2-6e38-3274-bff4-d99b6bc1f672",
                        "entry_id": "9f661d53-6ff8-3cbf-9463-22f3e49d9f20",
                        "glosses": [
                            "Handwerker, der mit der Herstellung von Schrifttypen (und ähnlichen Aufgaben) befasst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4d62ee-478f-4edb-b8ad-c8db5ed1afed",
                                "sense_id": "35945ef2-6e38-3274-bff4-d99b6bc1f672",
                                "text": "„Faktisch wurde damit die Antiqua zur Schrift öffentlicher Kommunikation ebenso, wie sie sich bei den Schriftschneidern für den Buchdruck zunehmender Beliebtheit erfreute: Das Publikum bevorzugte in Antiqua gesetzte Bücher und die Drucker folgten diesem Verlangen.“"
                            },
                            {
                                "example_id": "54ad97d1-1da3-4e08-bebd-0cd5b9749478",
                                "sense_id": "35945ef2-6e38-3274-bff4-d99b6bc1f672",
                                "text": "„Die Schriftschneider Jenson und Janson und die nach ihnen benannten Schriften lassen sich schon leicht verwechseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
