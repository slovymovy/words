                "senses": [
                    {
                        "sense_id": "716d3ec0-0f52-3ab9-b72e-b3157fa5e609",
                        "entry_id": "d4c22381-88b6-3c99-83d5-bd404f301ccf",
                        "glosses": [
                            "patologiczna przestrzeń w ciele wypełniona płynem, stanowiąca miękki guz w kształcie błoniastego woreczka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d376aa1-592a-4e56-99bd-d99ed9d34ded",
                                "sense_id": "716d3ec0-0f52-3ab9-b72e-b3157fa5e609",
                                "text": "Duże torbiele mogą uciskać zdrowy miąższ wątroby, powodując okoliczny jego zanik i niekiedy kompensacyjny przerost"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0def9659-83f7-49ba-953a-416acd8f1052",
