                                                "example_id": "f8f76e29-cce4-442f-9c15-40b4ead84a0f",
                                                "sense_id": "fe85c2ea-f42c-35cb-855d-d171db4ffb62",
                                                "text": "L’équipe de Rigobert Song a arraché sa qualification pour les 8ᵉˢ de finale de la CAN à la 91ᵉ minute face à la Gambie (3-2)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fa4c3b0-7785-3ec4-90cc-4de95f7d147d",
                                        "entry_id": "6758c752-e6a8-33b5-9858-543234c64bcc",
                                        "glosses": [
                                            "Fleuve qui traverse la Guinée, le Sénégal puis la Gambie."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23ff9567-af11-47e1-8897-68d607e9416b",
                                                "sense_id": "4fa4c3b0-7785-3ec4-90cc-4de95f7d147d",
                                                "text": "La rivière de Gambie se jette dans la mer entre le cap Sainte-Marie au sud, & l’ile aux Oiseaux au nord."
                                            }
                                        ]
                                    }
                                ]
                            }
