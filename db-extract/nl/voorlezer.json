                                "sense_id": "64c9c89e-75ec-3587-913d-0eec365bc738",
                                "text": "Bij Librivox zijn veel voorlezers actief."
                            },
                            {
                                "example_id": "871ae3e9-c4de-4213-9175-91f41a7d6984",
                                "sense_id": "64c9c89e-75ec-3587-913d-0eec365bc738",
                                "text": "Hij was altijd voorlezer geweest voor zijn kinderen."
                            },
