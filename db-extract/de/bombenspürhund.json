                        "glosses": [
                            "Hund, der darauf abgerichtet ist, Bomben und Stoffe zur Bombenherstellung aufzuspüren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1941c9-566d-4465-b098-77cb678d847b",
                                "sense_id": "30196a87-dd63-3eee-a88f-ed9270506cbc",
                                "text": "„Als sie im 64. Stock ankamen, öffneten sich die Fahrstuhltüren und die beiden jungen Frauen wurden von vier neugierigen Schäferhundnasen begrüßt. Bombenspürhunde.“"
                            },
                            {
                                "example_id": "0891ace5-77df-4bf9-97aa-f6a6656038e0",
                                "sense_id": "30196a87-dd63-3eee-a88f-ed9270506cbc",
                                "text": "„In diesem Augenblick laufen Bombenspürhunde schnüffelnd durchs Gerichtsgebäude.“"
                            }
                        ],
