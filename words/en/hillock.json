{
    "word_family": [
        "hill"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                    "sense_definition": "A small hill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geographical_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children enjoyed rolling down the grassy <w>hillock</w> during their afternoon picnic.",
                            "target_lang_translations": {
                                "tr": "Çocuklar öğleden sonraki piknikleri sırasında çimenli <w>tepecikten</w> aşağı yuvarlanmaktan keyif aldılar."
                            }
                        },
                        {
                            "text": "A small <w>hillock</w> provided a perfect view of the entire valley below.",
                            "target_lang_translations": {
                                "tr": "Küçük bir <w>tümsek</w>, aşağıdaki vadinin tamamını görmek için mükemmel bir manzara sunuyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grassy hillock",
                        "small hillock"
                    ],
                    "target_lang_definitions": {
                        "tr": "Küçük tepe, yerin hafifçe yükseldiği yer."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tepecik",
                                "target_lang_sense_clarification": "Yerden yüksekliği az olan küçük tepe."
                            },
                            {
                                "target_lang_word": "tümsek",
                                "target_lang_sense_clarification": "Yeryüzünde oluşan küçük kabarıklık veya tepe."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3a1545ac-cebe-3dfb-a954-b655207614bc",
                    "sense_definition": "A surname from Middle English.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local historian discovered that the <w>Hillock</w> family had lived in the village for centuries.",
                            "target_lang_translations": {
                                "tr": "Yerel tarihçi, <w>Hillock</w> ailesinin yüzyıllardır köyde yaşadığını keşfetti."
                            }
                        },
                        {
                            "text": "Mr. <w>Hillock</w> was known throughout the town for his extensive collection of rare books.",
                            "target_lang_translations": {
                                "tr": "Bay <w>Hillock</w>, nadir kitaplardan oluşan geniş koleksiyonuyla kasaba genelinde tanınırdı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Orta İngilizce kökenli bir soyadı."
                    },
                    "translations": {
                        "tr": []
                    }
                }
            ]
        }
    ]
}