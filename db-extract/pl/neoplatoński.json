                                "target_senses": [
                                    {
                                        "sense_id": "fd445545-1c75-36d5-aec2-4b766b35c78c",
                                        "entry_id": "7e1f9002-86d2-3c89-b480-b96e843ac897",
                                        "glosses": [
                                            "Variante de néoplatonicien."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42810803-40b8-447c-8a3b-7c38b5c202d3",
                                                "sense_id": "fd445545-1c75-36d5-aec2-4b766b35c78c",
                                                "text": "…un écrit essentiellement néo-platonicien, la Théologie d'Aristote, était faussement attribuée au Stagirite."
