        "nl-extract.jsonl": [
            {
                "entry_id": "79922736-9ba1-3672-a2a1-b65aa76a98f3",
                "word": "tongval",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3b876eef-19b5-464a-935b-9168f7ba91ae",
                        "entry_id": "79922736-9ba1-3672-a2a1-b65aa76a98f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "tongvallen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "589b5a86-aac0-395b-a711-dc40e682903d",
                        "entry_id": "79922736-9ba1-3672-a2a1-b65aa76a98f3",
                        "glosses": [
                            "het accent waarmee iemand spreekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e10fa5-b5b4-407b-9f33-38e0952e9bf4",
                                "sense_id": "589b5a86-aac0-395b-a711-dc40e682903d",
                                "text": "Tom Boonen verklapte woensdag aan Studio Brussel dat hij volop bezig is met een nieuwe tatoeage. Het zou een hert worden, want: ‘Ge gaat hert of ge gaat niet hert’, zo vertelde Boonen in zijn sappige Kempense tongval."
                            },
                            {
                                "example_id": "23afb675-8dce-4a6a-b41e-2e094281ef15",
                                "sense_id": "589b5a86-aac0-395b-a711-dc40e682903d",
                                "text": "De oud-machinist woont in het Gelderse Vuren, maar aan zijn tongval is goed te horen dat hij uit Amsterdam komt."
                            },
                            {
                                "example_id": "16b371d8-5cff-40ed-93e7-153e40ae113c",
                                "sense_id": "589b5a86-aac0-395b-a711-dc40e682903d",
                                "text": "Naar Wessels en zijn Twentse tongval werd inderdaad geluisterd. Hij stond bekend om zijn donderpreken. De muren van zijn kantoor in Rijssen waren met kurk bekleed om te voorkomen dat het hele gebouw kon meegenieten. Hij gaf toe: Áls ik mijn stem verhef, dn dringt iets tot je door."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00d8d21c-a0c7-4d24-802a-9775336b75db",
                        "source_entry_id": "79922736-9ba1-3672-a2a1-b65aa76a98f3",
                        "source_sense_id": "589b5a86-aac0-395b-a711-dc40e682903d",
                        "source_sense_description": "het accent waarmee iemand spreekt",
                        "target_lang_word": "accent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ede1945-bf4c-3601-a85f-16d7a8da872f",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "A higher-pitched or stronger (louder or longer) articulation of a particular syllable of a word or phrase in order to distinguish it from the others or to emphasize it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3203b593-66ce-4ef7-89b6-850497008357",
                                                "sense_id": "3ede1945-bf4c-3601-a85f-16d7a8da872f",
                                                "text": "In the word \"careful\", the accent is placed on the first syllable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "173d1d92-98ae-3295-94ed-0b53487c95ba",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "Emphasis or importance in general."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165da6bc-dede-4293-84e8-c7e64cb76aab",
                                                "sense_id": "173d1d92-98ae-3295-94ed-0b53487c95ba",
                                                "text": "At this hotel, the accent is on luxury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4654d610-9b09-35cb-9fc7-e2b413d5006b",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "A mark or character used in writing, in order to indicate the place of the spoken accent, or to indicate the nature or quality of the vowel marked."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "824dd4ea-6b66-402c-9d54-e3e770fc70d9",
                                                "sense_id": "4654d610-9b09-35cb-9fc7-e2b413d5006b",
                                                "text": "The name Cézanne is written with an acute accent."
                                            },
                                            {
                                                "example_id": "c6582c43-0c41-4d46-b228-40d0ed852e6d",
                                                "sense_id": "4654d610-9b09-35cb-9fc7-e2b413d5006b",
                                                "text": "California, like several other states, prohibits the use of diacritical marks or accents on official documents. That means no tilde (~), no accent grave (`), no umlaut (¨) and certainly no cedilla (¸)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706b65d6-c2f4-38d9-957e-ec97bdd1f2cc",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "Modulation of the voice in speaking; the manner of speaking or pronouncing; a peculiar or characteristic modification of the voice, expressing emotion; tone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60fa5013-2459-404b-bc27-6b1b592d713f",
                                                "sense_id": "706b65d6-c2f4-38d9-957e-ec97bdd1f2cc",
                                                "text": "I know, sir, I am no flatterer: he that beguiled you in a plain accent was a plain knave; which for my part I will not be, though I should win your displeasure to entreat me to 't."
                                            },
                                            {
                                                "example_id": "ac587868-d22f-46b3-820c-c203442b703e",
                                                "sense_id": "706b65d6-c2f4-38d9-957e-ec97bdd1f2cc",
                                                "text": "The tender Accent of a Woman's Cry / Will pass unheard, will unregarded die;"
                                            },
                                            {
                                                "example_id": "1a96df78-df38-4284-8e00-dbec6ef05459",
                                                "sense_id": "706b65d6-c2f4-38d9-957e-ec97bdd1f2cc",
                                                "text": "And he repeated her words with such assurance of accent, such boastful pretence of amazement, that she could not help replying with quickness …"
                                            },
                                            {
                                                "example_id": "dc51c2eb-ea3f-4f91-a698-37cc2cf2663c",
                                                "sense_id": "706b65d6-c2f4-38d9-957e-ec97bdd1f2cc",
                                                "text": "Edmund White, John Mitzel, and David Goodstein, among others, have taken pains to distinguish two kinds of \"liberation\" envisioned by the members of our recently emerged movement: assimilation into the body politic — or a total restructuring of the sex-role system. The second path amounts to revolutionary subversion, but we hear little about it here, except in the accents of reproach: to the idea that gay people might be \"pioneers in the area of relationship\" and that \"our greatest offering to civilization is the beauty of sexual freedom,\" McNaught responds: \"Bunk!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05afec40-4273-3b63-b4c2-7bc2fa0f9859",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "The distinctive manner of pronouncing a language associated with a particular region, social group, etc., whether of a native speaker or a foreign speaker; the phonetic and phonological aspects of a dialect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a4aa02b-8515-46b0-afe1-658a782b3863",
                                                "sense_id": "05afec40-4273-3b63-b4c2-7bc2fa0f9859",
                                                "text": "a foreign accent"
                                            },
                                            {
                                                "example_id": "d4715d9d-1ecb-401a-8d85-25a8b5176645",
                                                "sense_id": "05afec40-4273-3b63-b4c2-7bc2fa0f9859",
                                                "text": "a broad Irish accent"
                                            },
                                            {
                                                "example_id": "3f4b6c01-53af-49d1-9c1a-b71df5d41135",
                                                "sense_id": "05afec40-4273-3b63-b4c2-7bc2fa0f9859",
                                                "text": "a hint of a German accent"
                                            },
                                            {
                                                "example_id": "c65eb3ee-1874-432f-8309-7f591524d8d5",
                                                "sense_id": "05afec40-4273-3b63-b4c2-7bc2fa0f9859",
                                                "text": "a thick French accent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "The distinctive manner of pronouncing a language associated with a particular region, social group, etc., whether of a native speaker or a foreign speaker; the phonetic and phonological aspects of a dialect.",
                                            "A manner of pronunciation suggesting that the speaker is from a different region; a foreign accent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "proscribed",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc3fbc5-7e4e-48d2-8b12-65310fb9bcbd",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "I was surprised to learn that he was an immigrant, as he spoke without any accent."
                                            },
                                            {
                                                "example_id": "adfc2395-36da-4342-a756-ecab07e52379",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "My professor's accent is so thick that it's difficult to understand her lectures."
                                            },
                                            {
                                                "example_id": "68572950-509d-4217-920d-5b405f61b558",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "She spoke with a strong accent that betrayed her southern roots."
                                            },
                                            {
                                                "example_id": "26cee817-8e68-442a-9d95-ca4cb31ee363",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "They were all Middle Eastern types but spoke French without any accent."
                                            },
                                            {
                                                "example_id": "f7cea082-d0db-4df3-a049-ebaf35dc0d36",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "Growing up in the Rhondda and having a strong accent was never a problem for me and my voice never really stood out from the crowd."
                                            },
                                            {
                                                "example_id": "fa066765-6702-4a45-bd7c-37bedcaf269f",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "It's really hard to get in an audition room when you have an accent. Rather than being treated as the other people, you are falling into a category of foreigners who can't really maintain the role."
                                            },
                                            {
                                                "example_id": "26f7fd88-47ec-448a-ba0b-3df22739166e",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "Why go to the effort of writing in a character with an Indian name played by an Indian actor whose main personality trait is that he is stupid and has an accent?"
                                            },
                                            {
                                                "example_id": "be719021-e220-4bb7-a8e4-5295a03eca39",
                                                "sense_id": "31444486-3a18-35ce-a37d-c619e4e1324a",
                                                "text": "But over the years, even after perfecting \"accent-less\" English, graduating from college, getting a job at Goldman Sachs, and becoming an American citizen, Arce still felt like she didn't belong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f2e6ff-0aa2-36e0-9ebd-5041fefee091",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "The distinctive manner of pronouncing a language associated with a particular region, social group, etc., whether of a native speaker or a foreign speaker; the phonetic and phonological aspects of a dialect.",
                                            "A distinctive manner of producing a sign language, such as someone who does not normally use a certain sign language might have when using it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e40ff65-0f7e-4a40-ab2c-adc4f85c29ac",
                                                "sense_id": "35f2e6ff-0aa2-36e0-9ebd-5041fefee091",
                                                "text": "I believe I still retain some of my hearing accent when I use American Sign Language."
                                            },
                                            {
                                                "example_id": "5d74b2c7-7fdb-422b-bc10-2f4ee24e8bcd",
                                                "sense_id": "35f2e6ff-0aa2-36e0-9ebd-5041fefee091",
                                                "text": "Cheesesteaks, Peanut Chews, Tastykakes, oh yeah, the Liberty Bell — there's so much to love about Philadelphia, but one of the best things about the city of Brotherly Love is the accent. We're not talking about spoken English — we're talking about American Sign Language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "633e1832-e9a2-39b1-a878-e7173e34c131",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "A word; a significant tone or sound."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f4c8097-3420-435b-9739-e69ce9f75f9d",
                                                "sense_id": "633e1832-e9a2-39b1-a878-e7173e34c131",
                                                "text": "I heard my landlady's accents attuned to nervous civility, mingling with the mellow tones of a deep masculine voice,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de04881e-59d2-3943-ad9e-0319f3f8f02b",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "Expressions in general; speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "plural-only",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e115bec-2e5f-46db-b5bb-eb038115e9de",
                                                "sense_id": "de04881e-59d2-3943-ad9e-0319f3f8f02b",
                                                "text": "Winds! on your wings to Heaven her accents bear, / Such words as Heaven alone is fit to hear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac1b0102-4cce-30f4-ac07-ad4673ae2fb3",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "Stress laid on certain syllables of a verse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7d39de1-90ae-31e4-8f9c-fa190d481311",
                                        "entry_id": "9e4526da-cf01-3ded-a2f5-fec454484e4a",
                                        "glosses": [
                                            "A regularly recurring stress upon the tone to mark the beginning, and, more feebly, the third part of the measure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5f23d08-7bdc-36ee-b724-c02dc51b9547",
