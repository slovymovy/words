                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e65cac1-ec98-4318-8723-23cf6b109d1f",
                                "sense_id": "efdd103e-4e44-312e-9cab-8f1834f54428",
                                "text": "„Pierre erkundigte sich bei einigen ihm entgegenkommenden Hofesleuten, wo der Fürst wohne, und sie wiesen auf das kleine neue Seitengebäude hart am Teichufer.“"
                            },
                            {
                                "example_id": "ed8485c6-1af1-4096-8f0f-4097caab65be",
                                "sense_id": "efdd103e-4e44-312e-9cab-8f1834f54428",
                                "text": "„Er umschritt es langsam, spähte aber vergeblich nach einem Zugang zu dem Seitengebäude.“"
                            }
                        ],
