                        "glosses": [
                            "Se régler tout seul, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d6a30a-53ac-41c7-aa6e-0718888317c4",
                                "sense_id": "000cd357-630a-3367-bb2e-79c61ddb12bd",
                                "text": "Les recherches dans les dernières années ont permis d’augmenter le spectre des applications du contrôle flou, comme la capacité pour résoudre des problèmes de contrôle, s'autorégler et s'auto-optimiser."
                            },
                            {
                                "example_id": "5d2a2dc4-4599-422a-af29-c8b32ed8b17f",
                                "sense_id": "000cd357-630a-3367-bb2e-79c61ddb12bd",
                                "text": "Et donc même le mode automatique, censé s'autorégler, ne me permet pas d'être nette."
                            },
                            {
                                "example_id": "fcd2884b-8cbc-484b-bafe-ec41e52303fe",
                                "sense_id": "000cd357-630a-3367-bb2e-79c61ddb12bd",
                                "text": "Par définition le libéralisme c'est \"on laisse tout s'autorégler sans règle\"."
                            }
                        ]
                    }
