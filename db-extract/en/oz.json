                "senses": [
                    {
                        "sense_id": "a20a5da2-81d8-34b0-a840-85c1575e7d51",
                        "entry_id": "f169cc32-3998-3637-85a4-794bafc255ca",
                        "glosses": [
                            "An ounce (especially of marijuana or other drugs)."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fb2a55c3-e272-44ba-9e79-e11003a2cc01",
                                "sense_id": "a20a5da2-81d8-34b0-a840-85c1575e7d51",
                                "text": "Selling reefer was a round-the-clock hustle that required more time and energy than I wanted to invest. Unloading a single O.Z. sometimes took up to an hour."
                            },
                            {
                                "example_id": "6ce0f38e-9e53-4725-b54f-be48709e8731",
                                "sense_id": "a20a5da2-81d8-34b0-a840-85c1575e7d51",
                                "text": "Cool. I'll take a large 3 cheese, a 2-Liter of Coke, one ohzee of Purple Cush..."
                            },
                            {
                                "example_id": "eea12568-2744-4e77-bd69-0ebd12a2aaa0",
                                "sense_id": "a20a5da2-81d8-34b0-a840-85c1575e7d51",
                                "text": "The standard basketball weighs twenty-two oh-zees. But right now, it's weightless. It floats. Oh, what it is to be alive."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
