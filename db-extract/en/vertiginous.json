                                        "glosses": [
                                            "Que causa vértigo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad4c971-dd1f-4e28-88ae-878edc4f3e97",
                                                "sense_id": "b661325e-6cdb-3487-aaec-8165668b07f5",
                                                "text": "Muchos de esos rastros desaparecen todos los días, sitios que cierran, links que ya no funcionan, documentos que nadie respaldó, millones de datos que se pierden sin que nadie lo note. Y lo más loco es que todo esto está pasando a una velocidad vertiginosa."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
