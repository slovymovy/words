                "senses": [
                    {
                        "sense_id": "5eeaf287-a4d3-3457-a079-b4e24574e505",
                        "entry_id": "8722c513-0578-32cf-99fe-133b2185a9ae",
                        "glosses": [
                            "Envie permanente de bavarder, état de celui qui est bavard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58b592d-489d-4e27-a799-ea4a7989c85c",
                                "sense_id": "5eeaf287-a4d3-3457-a079-b4e24574e505",
                                "text": "On pourrait bien me reprocher encore que je laisse quelquefois trop courir ma plume, et que, quand je conte, je tombe un peu dans la garrulité."
                            },
                            {
                                "example_id": "197b56fb-7ed6-4f89-84e4-686b7dc3be21",
                                "sense_id": "5eeaf287-a4d3-3457-a079-b4e24574e505",
                                "text": "Toi. — Assez, bon sang ! Quelle platine !\nMoi. —Tu railles ma garrulité peut-être à tort,\nChère. J'admets que j'ai tendu fort le ressort,\nJe sais que j'exagère et sans doute plaisante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd701548-ccb9-4682-90b7-b4ac44a19dc7",
                        "source_entry_id": "8722c513-0578-32cf-99fe-133b2185a9ae",
                        "source_sense_id": "5eeaf287-a4d3-3457-a079-b4e24574e505",
                        "target_lang_word": "garrulity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garrulity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e3f1933-f158-34e5-88ed-0c01e3867573",
                                        "entry_id": "c267b1b1-cb87-3d2b-acb7-252527904eea",
                                        "glosses": [
                                            "The state or characteristic of being garrulous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ef5181-89f6-445f-8a57-59ef469b437f",
                                                "sense_id": "1e3f1933-f158-34e5-88ed-0c01e3867573",
                                                "text": "He ought to bee of some abilities in disputing; and what he wants in Logick, he must supply in Garrulity: for whatsoever he affirms, the interest he hath in his seduc'd hearers, improves into Syllogism […]"
                                            },
                                            {
                                                "example_id": "b04e4570-166d-4057-aafe-b86285c978b5",
                                                "sense_id": "1e3f1933-f158-34e5-88ed-0c01e3867573",
                                                "text": "With all the affectionate garrulity of age, she a thousand times expressed her pleasure at beholding the sisters;[…]"
                                            },
                                            {
                                                "example_id": "44402c44-2fbc-40e5-8bd7-33d9596a8500",
                                                "sense_id": "1e3f1933-f158-34e5-88ed-0c01e3867573",
                                                "text": "She delivered herself of a great number of original reflections. It was the most charming garrulity he had ever heard."
                                            },
                                            {
                                                "example_id": "c69461d6-f8c8-402d-894f-917cd2810df4",
                                                "sense_id": "1e3f1933-f158-34e5-88ed-0c01e3867573",
                                                "text": "A stream of inquiry and comment issued from her lips. . . . At last Gillian managed to stem the torrent of garrulity and interposed a question."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
