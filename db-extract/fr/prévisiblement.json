                            {
                                "example_id": "22802cf9-b2ab-4910-b63a-aa5fe72bcef3",
                                "sense_id": "9dd2591e-8778-379b-aed0-dee8fe83bbbf",
                                "text": "Nous sommes irrationnels, mais... « prévisiblement » irrationnels Car l’humain est loin d'être aussi rationnel que ce que nous avons cru et voudrions toujours croire."
                            },
                            {
                                "example_id": "d5502044-8394-4fe2-9d01-695abd8cc973",
                                "sense_id": "9dd2591e-8778-379b-aed0-dee8fe83bbbf",
                                "text": "Autrement dit, un ensemble prévisiblement évanescent est séparément évanescent."
                            },
                            {
                                "example_id": "925eb496-cee9-4da1-9b44-020a57dcfeaf",
                                "sense_id": "9dd2591e-8778-379b-aed0-dee8fe83bbbf",
                                "text": "Elles ne l’étaient sans doute pas plus que ça, puisque, de cette suite, je ne me rappelle que le montant, prévisiblement exorbitant, des honoraires, que nous comptions encore (soit dit pour situer un peu ladite période), non seulement en francs, mais en anciens francs …."
                            }
                        ]
                    }
