            "pos": "noun",
            "senses": [
                {
                    "sense_id": "546fef16-27b8-31c2-8b82-2c0286841b50",
                    "sense_definition": "De handeling van het helpen of verplegen van iemand of iets dat hulp nodig heeft.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hulp_en_verpleging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt veel <w>zorg</w> voor zijn zieke moeder.",
                            "target_lang_translations": {
                                "en": "He takes great <w>care</w> of his sick mother.",
                                "ru": "Он проявляет большую <w>заботу</w> о своей больной матери."
                            }
                        },
                        {
                            "text": "De <w>zorg</w> voor de kinderen kost veel tijd en energie.",
                            "target_lang_translations": {
                                "en": "The <w>care</w> of the children takes a lot of time and energy.",
                                "ru": "<w>Уход</w> за детьми требует много времени и энергии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zorg dragen voor",
                        "de zorg op zich nemen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of helping or nursing someone or something that needs assistance.",
                        "ru": "Действие по оказанию помощи или уходу за кем-либо или чем-либо, нуждающимся в поддержке."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "care",
                                "target_lang_sense_clarification": "the provision of what is necessary for health and welfare"
                            },
                            {
                                "target_lang_word": "nursing",
                                "target_lang_sense_clarification": "the profession or practice of providing medical care"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "внимание и уход за кем-то"
                            },
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "оказание помощи больному или нуждающемуся"
                            },
                            {
                                "target_lang_word": "попечение",
                                "target_lang_sense_clarification": "официальная или личная ответственность за кого-то"
                            }
                        ]
