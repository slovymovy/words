            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79a9d80d-88e3-37f5-b3d5-0abbc6ed000f",
                    "sense_definition": "Очень сильная физическая или душевная боль, крайне болезненное ощущение.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Больные зубы вызывают сильное <w>мучение</w>.",
                            "target_lang_translations": {
                                "en": "Bad teeth cause intense <w>agony</w>."
                            }
                        },
                        {
                            "text": "Он не мог больше терпеть эти <w>мучения</w> и обратился к врачу.",
                            "target_lang_translations": {
                                "en": "He could no longer endure these <w>torments</w> and went to the doctor."
                            }
                        }
                    ],
                    "synonyms": [
                        "му́ка",
                        "страдание"
                    ],
                    "antonyms": [
                        "наслаждение",
                        "радость",
                        "блаженство"
                    ],
                    "common_phrases": [
                        "испытывать мучения",
                        "причинять мучение"
                    ],
                    "target_lang_definitions": {
                        "en": "Extremely intense physical or mental pain; a state of severe suffering."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "torture",
                                "target_lang_sense_clarification": "Refers to severe physical or mental anguish."
                            },
                            {
                                "target_lang_word": "torment",
                                "target_lang_sense_clarification": "Refers to extreme mental or physical suffering."
                            },
                            {
                                "target_lang_word": "agony",
                                "target_lang_sense_clarification": "Refers to intense, often prolonged, physical or mental pain."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c290089-7d5d-34e5-9445-fb5be66def69",
                    "sense_definition": "Тяжелое, неприятное занятие или ситуация, вызывающая раздражение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня с этой работой одно <w>мучение</w>.",
                            "target_lang_translations": {
                                "en": "This job is a complete <w>nightmare</w> for me."
                            }
                        },
                        {
                            "text": "Каждый день вставать так рано — настоящее <w>мучение</w>.",
                            "target_lang_translations": {
                                "en": "Getting up so early every day is a real <w>ordeal</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "мытарство"
                    ],
                    "common_phrases": [
                        "одно мучение"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи для описания неприятных дел"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A difficult, unpleasant task or situation that causes irritation or frustration."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ordeal",
                                "target_lang_sense_clarification": "A very unpleasant or difficult experience."
                            },
                            {
                                "target_lang_word": "nightmare",
                                "target_lang_sense_clarification": "Used colloquially to describe a very difficult or frustrating situation."
                            },
                            {
                                "target_lang_word": "pain",
                                "target_lang_sense_clarification": "Used colloquially to describe something annoying or troublesome."
                            }
                        ]
                    }
                }
            ]
        }
    ]
