                                        "entry_id": "b080f9d2-9583-31af-a4de-d43e763e45f0",
                                        "glosses": [
                                            "Frisur mit stark gekrausten, langen und dichten Locken, die nach allen Seiten wild abstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44c8c8a-b535-4df4-86db-d498abd7b78e",
                                                "sense_id": "62e75b11-2001-3c56-85fb-bbc3f527e420",
                                                "text": "„Ich konnte mir nicht einmal einen anständigen Haarschnitt leisten, weshalb ich einen riesigen, unregelmäßigen Afro hatte, außerdem ärgerte sich meine Mutter immer wieder, dass ich zu schnell aus meinen Schuluniformen herauswuchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
