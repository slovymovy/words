                "senses": [
                    {
                        "sense_id": "34a8f6d2-f0a9-3ce2-b97d-584040af21be",
                        "entry_id": "de6530d7-bfee-3131-915e-884a66e8565c",
                        "glosses": [
                            "mężczyzna, którego ostatnia żona nie żyje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99268f4-41da-461d-9d0b-56016271fa13",
                                "sense_id": "34a8f6d2-f0a9-3ce2-b97d-584040af21be",
                                "text": "Wuj Leon jest wdowcem – jego żona umarła na raka."
                            },
                            {
                                "example_id": "3ab0a7a8-f905-4896-9813-b656a853497b",
                                "sense_id": "34a8f6d2-f0a9-3ce2-b97d-584040af21be",
                                "text": "Żona Jerzego umarła półtora roku temu, ale (on) nie był długo wdowcem: znowu się ożenił."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c910fc3-386c-4fee-8de6-74c79939b618",
                        "source_entry_id": "de6530d7-bfee-3131-915e-884a66e8565c",
                        "source_sense_id": "34a8f6d2-f0a9-3ce2-b97d-584040af21be",
