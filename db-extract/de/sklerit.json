                ],
                "senses": [
                    {
                        "sense_id": "834b0a76-9e7a-32be-9049-18f20cbb246b",
                        "entry_id": "df35d84d-5c5b-3bed-9e76-19275f8e0d5c",
                        "glosses": [
                            "die klerotisierten, harten Chitinplatten der Segmente des Außenskeletts"
                        ],
                        "tags": [
                            "Gliederfüßler"
                        ],
                        "examples": [
                            {
                                "example_id": "75210f9c-3803-49ba-b864-553365d58a78",
                                "sense_id": "834b0a76-9e7a-32be-9049-18f20cbb246b",
                                "text": "„Sklerite bei Gliederfüßern sind die durch Sklerotisierung, bei Krebstieren zusätzlich oft durch Kalzifizierung verhärteten Einzelplatten des Exoskeletts.“"
                            },
                            {
                                "example_id": "858d1d64-4c7d-4e50-8182-99133e398670",
                                "sense_id": "834b0a76-9e7a-32be-9049-18f20cbb246b",
                                "text": "„Im Unterschied zu den Steinkorallen besitzen die meisten Octocorallia kein festes Kalkskelett, sondern haben als Festigungselemente nur kleine Kalknadeln (Sklerite) im Körper, der ansonsten durch den Wasserdruck im Innern stabilisiert wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7623e5e9-9d79-3bd7-84fb-3622bd034d50",
                        "entry_id": "df35d84d-5c5b-3bed-9e76-19275f8e0d5c",
                        "glosses": [
                            "die Kalknadeln oder Skleren, die als Stützelement des Schwammkörpers dienen"
                        ],
                        "tags": [
                            "Schwämme"
                        ],
                        "examples": [
                            {
                                "example_id": "1eb88f6b-d514-46e0-bb9d-0f566c17ca6d",
                                "sense_id": "7623e5e9-9d79-3bd7-84fb-3622bd034d50",
                                "text": "„Als Skelettnadeln (lateinisch Spiculum ‚Stachel‘, Plural Spicula) können Sklerite der Stabilität und als Fraßschutz von Blumentieren, Schwämmen, Stachelhäutern, Weichtieren und Manteltieren dienen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "53e6c818-5329-39c2-a5b5-fbcc374e32ed",
                        "entry_id": "df35d84d-5c5b-3bed-9e76-19275f8e0d5c",
