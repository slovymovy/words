                "senses": [
                    {
                        "sense_id": "03faf878-fcd1-33b9-84bd-7257642f2461",
                        "entry_id": "cd5aec6a-b5a3-3e88-adf9-b6cb5ff92f3a",
                        "glosses": [
                            "Doter d’une colonne vertébrale ou, par extension, d’une structure qui renforce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2499ce46-9b17-4933-8b61-ed51125e0638",
                                "sense_id": "03faf878-fcd1-33b9-84bd-7257642f2461",
                                "text": "C'est le schéma de l'entreprise qui viendrait « vertébraliser » notre personne."
                            },
                            {
                                "example_id": "15064d31-dc58-4b28-89b0-b0807ce4b740",
                                "sense_id": "03faf878-fcd1-33b9-84bd-7257642f2461",
                                "text": "Elle vertébralise les rêves absurdes, soutient la fragilité des personnages, leurs espérances inouïes, les contient, les encadre."
                            },
                            {
                                "example_id": "1a5725a9-1230-4b15-b8ca-5922a5119b1a",
                                "sense_id": "03faf878-fcd1-33b9-84bd-7257642f2461",
                                "text": "Dans cette métamorphose, le crustacé infantile perd son exosquelette protecteur mais limitant pour « se vertébraliser » en interne et se dresser adulte."
                            }
                        ]
                    }
