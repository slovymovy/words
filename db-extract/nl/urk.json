                        "sense_id": "95f2e163-db94-3464-b2d6-779720af4041",
                        "entry_id": "52c1c22f-ed51-3ccc-967a-a656ea401a3d",
                        "glosses": [
                            "vissersdorp en gemeente in de provincie Flevoland in Nederland\\nNa een overstroming in de 13e eeuw is Urk tot de drooglegging van de Noordoostpolder een eiland in de Zuiderzee geweest. Daardoor wordt ook het voorzetsel \\\"op\\\" nog altijd gebruikt. De gemeente behoorde tot 1950 tot de provincie Noord-Holland en van 1950 tot 1986 tot de provincie Overijssel."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "ae43a01f-0366-43fa-b3fe-bb2760ac6c2a",
                                "sense_id": "95f2e163-db94-3464-b2d6-779720af4041",
                                "text": "Het wordt mogelijk om bij alle huisartsenposten op Urk een coronavaccin te halen."
                            },
                            {
                                "example_id": "efde3874-22c0-46d8-bc11-cdecc38be5c6",
                                "sense_id": "95f2e163-db94-3464-b2d6-779720af4041",
                                "text": "De politie voert vrijdag voor de vierde dag op rij controles uit op de vier toegangswegen naar Urk."
                            },
                            {
                                "example_id": "f75cb826-7008-42bf-849e-4b05bdc74c49",
                                "sense_id": "95f2e163-db94-3464-b2d6-779720af4041",
                                "text": "In Urk is negentig procent van de bevolking betrokken bij de visserij."
                            },
                            {
                                "example_id": "2959ae1c-1ad6-4cf7-a20c-98a5c5d243b3",
                                "sense_id": "95f2e163-db94-3464-b2d6-779720af4041",
                                "text": "De dominee van Urk,\nDie zou op Schokland preêken,\nDoor 't razen van de zee,\nHad hij zijn tekst vergeten."
                            }
                        ]
                    }
