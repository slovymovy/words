                "senses": [
                    {
                        "sense_id": "c15c3f7b-1e94-399a-81cc-502df9c7cdcb",
                        "entry_id": "0146fef9-8e56-3019-b653-2e52f28dc331",
                        "glosses": [
                            "Parler, se comporter, comme un daron ou une daronne (comme un père ou une mère)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c33cd1-7029-4370-98fc-4b8bc67dca87",
                                "sense_id": "c15c3f7b-1e94-399a-81cc-502df9c7cdcb",
                                "text": "Ce n’est rien, ce sont deux ou trois gouttes de bouillie, qui sont tombées du poëlon dans votre écuelle ; vous aimez toujours à daronner (gronder)."
                            },
                            {
                                "example_id": "c07db7dd-c4be-4422-9203-219542e24310",
                                "sense_id": "c15c3f7b-1e94-399a-81cc-502df9c7cdcb",
                                "text": "Elle ne demande pas, elle ordonne, et on observe Woody, impuissant, se faire daronner pendant 45 min."
                            },
                            {
                                "example_id": "01b643f0-be82-406a-a832-d32ac483fba4",
                                "sense_id": "c15c3f7b-1e94-399a-81cc-502df9c7cdcb",
                                "text": "L’égoïsme général crée ces putains d’inégalités ignobles et pousse le système à daronner la population et à partir de là c’est juste terminé."
                            },
                            {
                                "example_id": "46f13ccd-6576-499a-9069-f2e71ddb52ff",
                                "sense_id": "c15c3f7b-1e94-399a-81cc-502df9c7cdcb",
                                "text": "plus qu’un an, aprés tu pourras daronner, sans avoir l’air d’un branque comme nous…"
                            }
                        ]
                    }
                ],
