        "fr-extract.jsonl": [
            {
                "entry_id": "613edbfa-cd14-3248-82d1-da96b7d000f1",
                "word": "parcimonie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38be42e2-dc9b-4c7c-9477-abd3b069e021",
                        "entry_id": "613edbfa-cd14-3248-82d1-da96b7d000f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "parcimonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8c65bd2-dba5-3ecc-833a-5085e56aa18c",
                        "entry_id": "613edbfa-cd14-3248-82d1-da96b7d000f1",
                        "glosses": [
                            "Épargne minutieuse, s’attachant aux petites choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9f270f-c1eb-4c90-bf58-7d76fe54df3d",
                                "sense_id": "f8c65bd2-dba5-3ecc-833a-5085e56aa18c",
                                "text": "Si Grandet coupait le pain avec un peu trop de parcimonie, elle ne s’en plaignait pas."
                            },
                            {
                                "example_id": "06139d4c-1519-4fdc-9b5b-0082a631ab0e",
                                "sense_id": "f8c65bd2-dba5-3ecc-833a-5085e56aa18c",
                                "text": "Pailleron traitait ses collègues de l’Institut avec une grande parcimonie gastronomique, car il était prodigieusement avare, ce dont se plaignaient ses invités : « C’est dommage, déclarait Francis Magnard, qu’on ne puisse pas manger la vaisselle. Elle est fort belle et très appétissante. »"
                            },
                            {
                                "example_id": "fda663f4-d303-488d-a60d-27c72c9ecf69",
                                "sense_id": "f8c65bd2-dba5-3ecc-833a-5085e56aa18c",
                                "text": "Si les ouvriers agricoles de l’Hérault avaient la sagesse de s’astreindre à la parcimonie des gens de l’Ariège ou de la Lozère, je ne doute pas qu’ils se trouveraient très heureux."
                            },
                            {
                                "example_id": "a764ec55-8b5f-440a-a883-781df5440af5",
                                "sense_id": "f8c65bd2-dba5-3ecc-833a-5085e56aa18c",
                                "text": "Ils dénonceront âprement un déficit qui sera le plus souvent minime. […]. Ils crieront haro sur un ministre qu'ils accuseront de ruiner la France alors qu’en réalité ils lui en voudront de sa parcimonie."
                            },
                            {
                                "example_id": "a6c8ce91-ed75-47d6-bfe7-1549dc7f91ef",
                                "sense_id": "f8c65bd2-dba5-3ecc-833a-5085e56aa18c",
                                "text": "On pouvait critiquer l’arrogance de leur inspecteur, déplorer la parcimonie avec laquelle il distribuait les points d’avancement, mais en faire un sous-officier, ça, c’était inacceptable !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f121098-9ebe-3933-9246-a128a132475c",
                        "entry_id": "613edbfa-cd14-3248-82d1-da96b7d000f1",
                        "glosses": [
                            "S’applique à un raisonnement qui s’attache à expliquer un phénomène en un minimum d’hypothèses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5819b4-13ef-4ba2-a48f-eef2d9df28e2",
                                "sense_id": "5f121098-9ebe-3933-9246-a128a132475c",
                                "text": "Le rasoir d’Ockham est le principe selon lequel l’explication la meilleure est celle faisant le plus usage de parcimonie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ac50189-d8a8-4a84-ab24-a14ffce41417",
                        "source_entry_id": "613edbfa-cd14-3248-82d1-da96b7d000f1",
                        "target_lang_word": "parsimony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parsimony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                        "entry_id": "58a2919e-5a68-3716-bdc9-3aac2a9424da",
                                        "glosses": [
                                            "Great reluctance to spend money unnecessarily."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f1a774e-4cca-4bd6-a8a3-1c15b41a7291",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "Near-synonyms: (usually admirable) frugality, economy, thrift, thriftiness; (excessive degree) tightness, stinginess; (extreme degree) miserliness; see also Thesaurus:frugal, Thesaurus:stingy"
                                            },
                                            {
                                                "example_id": "da82ed68-b976-49e7-badb-d7e1c20bda7b",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "Parsimony, and not industry, is the immediate cause of the increase of capital. Industry, indeed, provides the subject which parsimony accumulates. But whatever industry might acquire, if parsimony did not save and store up, the capital would never be the greater."
                                            },
                                            {
                                                "example_id": "5a84cc3f-bc9e-4c2a-9506-ac8faf6107a1",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "If mere parsimony could have made a man rich, Sir Pitt Crawley might have become very wealthy […]"
                                            },
                                            {
                                                "example_id": "23db4349-0fdc-479b-969f-585bf780a9b4",
                                                "sense_id": "0d9fe652-7ebd-3810-95cd-9f389099baba",
                                                "text": "THE WATERFORD & TRAMORE RAILWAY. By H. Fayle and A. T. Newham. David & Charles. 12s 6d. [...] Parsimony was responsible for low wages: at the turn of the century the Secretary & Manager was receiving £175 a year and the Locomotive Superintendent slightly less."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef429eef-929c-3a36-bcd2-b749bf8bda79",
                                        "entry_id": "58a2919e-5a68-3716-bdc9-3aac2a9424da",
                                        "glosses": [
                                            "The quality or characteristic of using the fewest resources or explanations to solve a problem."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08bd873-1e8e-4a01-876a-f311414a9627",
                                                "sense_id": "ef429eef-929c-3a36-bcd2-b749bf8bda79",
                                                "text": "We used three search heuristics, Bayesian inference, maximum likelihood, and maximum parsimony, to construct phylogenies from unique COI haplotypes and used default parameters for analyses unless otherwise noted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "def345a7-d86d-438a-8d0a-979e9a50433c",
