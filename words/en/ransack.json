{
    "word_family": [
        "ransacker",
        "ransacking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "368d0f04-e122-3f12-8f52-45b80ef959b4",
                    "sense_definition": "To search through a place or container thoroughly and often roughly, especially in a way that causes disorder or damage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The burglars decided to <w>ransack</w> the house for valuables while the family was away on vacation.",
                            "target_lang_translations": {
                                "ru": "Грабители решили <w>обыскать</w> дом в поисках ценностей, пока семья была в отпуске."
                            }
                        },
                        {
                            "text": "I had to <w>ransack</w> the drawer to find my passport before leaving for the airport.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>перерыть</w> весь ящик, чтобы найти паспорт перед отъездом в аэропорт."
                            }
                        }
                    ],
                    "synonyms": [
                        "sack"
                    ],
                    "common_phrases": [
                        "ransack the drawer",
                        "ransack the house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и часто грубо обыскивать место или контейнер, создавая беспорядок или нанося ущерб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обыскивать",
                                "target_lang_sense_clarification": "тщательно искать что-то"
                            },
                            {
                                "target_lang_word": "перерывать",
                                "target_lang_sense_clarification": "создавать беспорядок при поиске"
                            },
                            {
                                "target_lang_word": "обшаривать",
                                "target_lang_sense_clarification": "искать повсюду, заглядывая во все углы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15abb536-58ea-3467-b869-03444507dbe6",
                    "sense_definition": "To plunder or pillage a place, especially during a war or riot.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "plundering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army began to <w>ransack</w> the city, taking everything of value they could find.",
                            "target_lang_translations": {
                                "ru": "Вторгшаяся армия начала <w>разграблять</w> город, забирая все ценное, что попадалось под руку."
                            }
                        },
                        {
                            "text": "Historical accounts describe how the Vikings would <w>ransack</w> coastal villages during their raids.",
                            "target_lang_translations": {
                                "ru": "Исторические хроники описывают, как викинги <w>опустошали</w> прибрежные деревни во время своих набегов."
                            }
                        }
                    ],
                    "synonyms": [
                        "sack"
                    ],
                    "common_phrases": [
                        "ransack the city",
                        "ransack the village"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грабить или разорять место, особенно во время войны или беспорядков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разграблять",
                                "target_lang_sense_clarification": "похищать ценности, разоряя место"
                            },
                            {
                                "target_lang_word": "мародерствовать",
                                "target_lang_sense_clarification": "грабить во время войны или бедствий"
                            },
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "разорять и грабить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e8bcefd-b776-3368-a544-bad9be0bfebc",
                    "sense_definition": "To examine or investigate something very carefully and minutely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar spent years trying to <w>ransack</w> ancient archives for any mention of the lost civilization.",
                            "target_lang_translations": {
                                "ru": "Ученый потратил годы, пытаясь <w>перерыть</w> древние архивы в поисках любого упоминания о затерянной цивилизации."
                            }
                        },
                        {
                            "text": "He would <w>ransack</w> his memory for any detail that might help solve the mystery.",
                            "target_lang_translations": {
                                "ru": "Он <w>ворошил</w> свою память в поисках любой детали, которая могла бы помочь разгадать тайну."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ransack one's memory",
                        "ransack the archives"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of careful investigation is less common in modern usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень тщательно и детально изучать или исследовать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерывать",
                                "target_lang_sense_clarification": "изучать архивы или документы"
                            },
                            {
                                "target_lang_word": "ворошить",
                                "target_lang_sense_clarification": "искать в памяти или прошлом"
                            },
                            {
                                "target_lang_word": "тщательно исследовать",
                                "target_lang_sense_clarification": "детально изучать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31750aca-3a03-3402-8638-d8cca9a19376",
                    "sense_definition": "To violate or ravish; to treat with violent disrespect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old poem spoke of the rich spoil of <w>ransacked</w> chastity during the fall of the city.",
                            "target_lang_translations": {
                                "ru": "В старой поэме говорилось о богатой добыче в виде <w>оскверненного</w> целомудрия во время падения города."
                            }
                        },
                        {
                            "text": "In the brutal chaos of the siege, many feared the soldiers would <w>ransack</w> the innocent.",
                            "target_lang_translations": {
                                "ru": "В жестоком хаосе осады многие боялись, что солдаты будут <w>насиловать</w> невинных."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literature to describe violation or ravishment."
                        },
                        {
                            "trait_type": "form",
                            "comment": "Often used in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осквернять или подвергать насилию; относиться с грубым неуважением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осквернять",
                                "target_lang_sense_clarification": "относиться с неуважением"
                            },
                            {
                                "target_lang_word": "насиловать",
                                "target_lang_sense_clarification": "совершать насилие (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d62a13c-c38c-3f81-bd61-5ef6bcd77080",
                    "sense_definition": "An instance of searching through something very thoroughly or eagerly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thorough <w>ransack</w> of the library yielded a few forgotten manuscripts from the middle ages.",
                            "target_lang_translations": {
                                "ru": "Тщательный <w>обыск</w> библиотеки принес несколько забытых рукописей времен средневековья."
                            }
                        },
                        {
                            "text": "After a quick <w>ransack</w> of his pockets, he realized he had lost his keys.",
                            "target_lang_translations": {
                                "ru": "Быстро <w>проверив</w> карманы, он понял, что потерял ключи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай очень тщательного или нетерпеливого поиска чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обыск",
                                "target_lang_sense_clarification": "тщательный поиск"
                            },
                            {
                                "target_lang_word": "прочесывание",
                                "target_lang_sense_clarification": "детальный осмотр места"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}