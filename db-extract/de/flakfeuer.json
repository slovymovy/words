                ],
                "senses": [
                    {
                        "sense_id": "60a225fc-3e6e-38ca-adc4-31bf988d57dd",
                        "entry_id": "38ced4a1-47ff-344a-895f-d00690c0ce7b",
                        "glosses": [
                            "vielfache Schüsse durch die Flak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6525e867-ded9-406b-bcc7-2a5b19fe4276",
                                "sense_id": "60a225fc-3e6e-38ca-adc4-31bf988d57dd",
                                "text": "„Heute nacht aber, in dieser Stunde, von der Sekunde des Flakfeuers an, bekamen Dynamit und Phosphor ihren alten Schrecken im ohnehin bedrohten Leben der Bertinis wieder, und die Ohren sausten Roman noch in der Erkenntnis, als nach vierzig Minuten Entwarnung gegeben wurde.“"
                            },
                            {
                                "example_id": "8e660e4c-6ad7-4510-b9da-826cd6d8a46a",
                                "sense_id": "60a225fc-3e6e-38ca-adc4-31bf988d57dd",
                                "text": "„Japanische Jäger ließen sich jedoch nicht blicken, auch gab es kein Flakfeuer.“"
                            },
                            {
                                "example_id": "f2899ca9-da8c-4902-b5c8-24e361de52e1",
                                "sense_id": "60a225fc-3e6e-38ca-adc4-31bf988d57dd",
                                "text": "„Sie werden in die letzten Schlachten geraten sein, abgedrängt von den Bomberpulks, verstört durch ständiges Flakfeuer und den Lärm des zu Ende gehenden Krieges.“"
                            },
                            {
                                "example_id": "28d4d72f-04a9-4790-9668-8d3671c5176d",
                                "sense_id": "60a225fc-3e6e-38ca-adc4-31bf988d57dd",
                                "text": "„Das Flakfeuer raste weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
