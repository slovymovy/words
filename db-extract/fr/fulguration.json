        "fr-extract.jsonl": [
            {
                "entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                "word": "fulguration",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "46010155-81e7-4a8b-b91f-766709c5c33e",
                        "entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                        "tags": [
                            "plural"
                        ],
                        "form": "fulgurations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48583ba7-7cbf-34b2-af05-9e19c1f92a98",
                        "entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                        "glosses": [
                            "Lueur se produisant dans les hautes régions de l’atmosphère, sans être accompagnée d’aucun bruit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "987e8b3b-e256-45c2-97d7-e5ff96906a24",
                                "sense_id": "48583ba7-7cbf-34b2-af05-9e19c1f92a98",
                                "text": "Averse, ouragan, fulgurations, fulminations, vagues jusqu’aux nuages, écume, détonations, torsions frénétiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fae02a5-1e90-360c-8ccd-afdc32d1e9f4",
                        "entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                        "glosses": [
                            "Action de la foudre sur les êtres vivants et par extension, tout accident causé par de fortes décharges électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b814d5-5c28-457b-a2fa-91b0ad51e1aa",
                                "sense_id": "4fae02a5-1e90-360c-8ccd-afdc32d1e9f4",
                                "text": "Mais les fulgurations collectives, qui permettent de comprendre les variantes entre individus, sont rarissimes."
                            }
                        ]
                    },
                    {
                        "sense_id": "beba9427-4833-3f46-937b-824a9a9e87b0",
                        "entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                        "glosses": [
                            "Thérapie qui repose sur l’utilisation de courants électriques à haute fréquence et haute tension pour soigner certains types de tumeurs et affections."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9b3cbda0-eb3e-3d2d-88dd-f1ed48e84384",
                        "entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                        "glosses": [
                            "Lumière vive et éclatante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "db82b636-f23d-4f29-a326-822cf3737cb8",
                                "sense_id": "9b3cbda0-eb3e-3d2d-88dd-f1ed48e84384",
                                "text": "Tout un crépitement de coups de feu et d’éclatements de projectiles commença, et Bert vit autour de lui, l’enveloppant, l’engloutissant, le submergeant, une immense fulguration blanche accompagnée d’un coup de tonnerre semblable à l’explosion d’un monde."
                            },
                            {
                                "example_id": "3b1dff54-5e3c-49dc-b334-d4cac0180e25",
                                "sense_id": "9b3cbda0-eb3e-3d2d-88dd-f1ed48e84384",
                                "text": "On ne voyait pas les tramways. […]. Pourtant les quais où ils roulaient, […], n'étaient guère éloignés, car la rue, quelquefois, tremblait à leur passage et les feux des pylônes de ciment et des toits des hangars émergeaient, ça et là, entre les murs où leurs reflets mettaient de soudaines fulgurations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85642974-bcc7-4428-afd4-f5290a1cb3f9",
                        "source_entry_id": "9f605a53-ccb3-3234-b96b-447856dcdf08",
                        "source_sense_id": "48583ba7-7cbf-34b2-af05-9e19c1f92a98",
                        "source_sense_description": "Lueur se produisant dans les hautes régions de l’atmosphère.",
                        "target_lang_word": "Wetterleuchten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wetterleuchten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94429652-7b3a-3540-9233-7023d2d2b4f8",
                                        "entry_id": "56a53779-b846-3c21-8a82-5b08783d21e9",
                                        "glosses": [
                                            "nicht oder nur schwach von Donner begleiteter Widerschein von Blitzen eines fernen Gewitters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c760a772-28d0-4b52-ab40-3afbefca8714",
                                                "sense_id": "94429652-7b3a-3540-9233-7023d2d2b4f8",
                                                "text": "„Das Wetterleuchten am Himmel zeigt weitere Gewitter an.“"
                                            },
                                            {
                                                "example_id": "92d1948f-9e9d-4b3f-88ad-e2d2bb5ff25f",
                                                "sense_id": "94429652-7b3a-3540-9233-7023d2d2b4f8",
                                                "text": "„Aber keiner konnte schlafen vor Erwartung und Freude, die Matrosen lagen in der warmen Sommernacht plaudernd auf dem Verdecke umher, Alvarez, Antonio und die Offiziere saßen zusammen vorn auf Fortunas Schopfe, unter ihnen schlugen die Wellen leise ans Schiff, während fern am Horizont die Nacht sich mit Wetterleuchten kühlte.“"
                                            },
                                            {
                                                "example_id": "542699ed-1b49-43c0-a71f-995e56b7a4ad",
                                                "sense_id": "94429652-7b3a-3540-9233-7023d2d2b4f8",
                                                "text": "„Dachte Alfred Saß an sein Museum, so war es ihm, als kühle das Wetter sich ab; dachte er an die Geschäfte seines Hauses, so glaubte er schon den nah und näher kommenden Donner zu hören, der aus dem Wetterleuchten hervorwuchs.“"
                                            },
                                            {
                                                "example_id": "c34c7403-4de1-410d-82d4-6b3f5b6e7862",
                                                "sense_id": "94429652-7b3a-3540-9233-7023d2d2b4f8",
                                                "text": "„Wetterleuchten ist ein Elektrometeor, bei dem aufgrund der großen Entfernung des elektrischen Entladungsortes (Gewitter in großer Entfernung vom Beobachtungsort) nur das Aufleuchten, die Reflexion an den Wolken, aber kein Donner wahrgenommen werden kann. Das Wetterleuchten zeigt sich als flaches, fast linienhaftes Aufleuchten am nächtlichen Horizont.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c9b98e8-95d9-394e-856e-48d1532fd4db",
                                        "entry_id": "56a53779-b846-3c21-8a82-5b08783d21e9",
                                        "glosses": [
                                            "Anzeichen, zumeist schwerer Konflikte"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62c7445-6a5e-46a7-a0e3-fc4fcb5e097b",
                                                "sense_id": "8c9b98e8-95d9-394e-856e-48d1532fd4db",
                                                "text": "„Im Brautkleid tritt sie ihr entgegen, ein Wetterleuchten im Gesicht.“"
                                            },
                                            {
                                                "example_id": "1694d515-d938-4692-9e1a-b420f5be11ce",
                                                "sense_id": "8c9b98e8-95d9-394e-856e-48d1532fd4db",
                                                "text": "„Einen Unterschied gibt es zu dem unheilvollen Wetterleuchten des beginnenden Bürgerkrieges, wie es Thukydides beschreibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
