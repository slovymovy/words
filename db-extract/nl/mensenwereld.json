                        "entry_id": "b728df27-02d1-3571-98d8-937118d2658d",
                        "glosses": [
                            "de huidige wereld waarin mensen leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e129cc77-b949-4b69-af6e-75f011653c52",
                                "sense_id": "251bb2c4-f84a-3dd0-afb5-dc7c8fb6016a",
                                "text": "Het was moeilijk voor te stellen dat zo'n schepsel ooit in de mensenwereld had geleefd of deel had uitgemaakt van Aristoteles'grote keten van het leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "8dec76c3-2a06-30dd-8a7c-8d42d8ec0676",
                        "entry_id": "b728df27-02d1-3571-98d8-937118d2658d",
                        "glosses": [
                            "de wereld van de mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a115ccce-7c5b-4228-9377-2a2a9b0ba90c",
                                "sense_id": "8dec76c3-2a06-30dd-8a7c-8d42d8ec0676",
                                "text": "\"Als je ruzie hebt met een bedrijf of een politicus, dan kun je altijd terugvallen op je gedeelde normen en waarden. Bij criminelen geldt dat niet. Het zijn geen mensen die een advocaat op je afsturen. Ze zullen eerder op andere manieren dreigen dan in de 'gewone mensenwereld'.\""
                            }
                        ]
                    }
