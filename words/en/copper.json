{
    "word_family": [
        "coppery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cddf249-2eda-3b42-8a72-dd0b67ba0596",
                    "sense_definition": "A reddish-brown metal that is a chemical element, used to make wires, pipes, and coins.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old pipes in the house were made of <w>copper</w>.",
                            "target_lang_translations": {
                                "ru": "Старые трубы в доме были сделаны из <w>меди</w>.",
                                "zh": "房子里的旧管道是用<w>铜</w>做的。"
                            }
                        },
                        {
                            "text": "Electricity flows very easily through a <w>copper</w> wire.",
                            "target_lang_translations": {
                                "ru": "Электричество очень легко проходит через <w>медный</w> провод.",
                                "zh": "电流很容易通过<w>铜</w>线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "copper wire",
                        "copper pipe",
                        "pure copper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красновато-коричневый металл, являющийся химическим элементом; используется для изготовления проводов, труб и монет.",
                        "zh": "一种红褐色的金属化学元素，常用于制造电线、管道和硬币。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медь",
                                "target_lang_sense_clarification": "металл / химический элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜",
                                "target_lang_sense_clarification": "金属化学元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a205e76-d6d8-399e-b5d5-819ce7ee3ec3",
                    "sense_definition": "A coin made of copper or bronze, usually of low value such as a penny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "money_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I only had a few <w>coppers</w> left in my pocket after buying the newspaper.",
                            "target_lang_translations": {
                                "ru": "После покупки газеты у меня в кармане осталось лишь несколько <w>медяков</w>.",
                                "zh": "买完报纸后，我口袋里只剩下几枚<w>铜币</w>了。"
                            }
                        },
                        {
                            "text": "She dropped a handful of <w>coppers</w> into the donation jar.",
                            "target_lang_translations": {
                                "ru": "Она бросила горсть <w>мелочи</w> в банку для пожертвований.",
                                "zh": "她往捐款罐里投了一把<w>零钱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "penny",
                        "cent"
                    ],
                    "common_phrases": [
                        "spare coppers",
                        "count the coppers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Монета из меди или бронзы, обычно небольшого достоинства (мелочь).",
                        "zh": "由铜或青铜制成的硬币，通常面值较低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медяк",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "мелкие монеты"
                            },
                            {
                                "target_lang_word": "медная монета",
                                "target_lang_sense_clarification": "прямое значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜币",
                                "target_lang_sense_clarification": "铜制硬币"
                            },
                            {
                                "target_lang_word": "零钱",
                                "target_lang_sense_clarification": "指代小额硬币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd1459d2-d3d7-3eb2-a2b0-89ac69a98f55",
                    "sense_definition": "A police officer.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "police_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The robber ran down the alley when he saw the <w>copper</w> coming.",
                            "target_lang_translations": {
                                "ru": "Грабитель побежал по переулку, когда увидел приближающегося <w>легавого</w>.",
                                "zh": "劫匪看到<w>警察</w>过来时，沿着小巷逃跑了。"
                            }
                        },
                        {
                            "text": "My uncle worked as a <w>copper</w> in London for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мой дядя двадцать лет работал <w>полицейским</w> в Лондоне.",
                                "zh": "我叔叔在伦敦当了二十年<w>警察</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cop",
                        "police officer"
                    ],
                    "common_phrases": [
                        "bent copper"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский.",
                        "zh": "警察（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полицейский",
                                "target_lang_sense_clarification": "профессия"
                            },
                            {
                                "target_lang_word": "легавый",
                                "target_lang_sense_clarification": "слэнг"
                            },
                            {
                                "target_lang_word": "мент",
                                "target_lang_sense_clarification": "слэнг, разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "警察",
                                "target_lang_sense_clarification": "执法人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e000818b-d8a7-3b50-a62e-fef03fcda3d5",
                    "sense_definition": "A reddish-brown color resembling the metal copper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaves on the trees turned a deep <w>copper</w> in the autumn.",
                            "target_lang_translations": {
                                "ru": "Осенью листья на деревьях приобрели глубокий <w>медный цвет</w>.",
                                "zh": "秋天，树叶变成了深<w>铜色</w>。"
                            }
                        },
                        {
                            "text": "She dyed her hair a bright shade of <w>copper</w>.",
                            "target_lang_translations": {
                                "ru": "Она покрасила волосы в яркий <w>медный</w> оттенок.",
                                "zh": "她把头发染成了明亮的<w>铜色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chestnut",
                        "russet"
                    ],
                    "common_phrases": [
                        "burnished copper",
                        "shade of copper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красновато-коричневый цвет, напоминающий металл медь.",
                        "zh": "一种类似于铜金属的红褐色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медный цвет",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜色",
                                "target_lang_sense_clarification": "颜色名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                    "sense_definition": "A large metal pot used for boiling water or washing clothes, often built into a structure with a fire underneath.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "container_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother used to boil the bed sheets in the old <w>copper</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка кипятила простыни в старом <w>медном котле</w>.",
                                "zh": "我祖母过去常在旧<w>铜锅</w>里煮床单。"
                            }
                        },
                        {
                            "text": "We had to light a fire under the <w>copper</w> to heat water for the bath.",
                            "target_lang_translations": {
                                "ru": "Нам приходилось разжигать огонь под <w>котлом</w>, чтобы нагреть воду для ванны.",
                                "zh": "我们得在<w>铜锅</w>下生火来烧洗澡水。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "largely replaced by washing machines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой металлический чан для кипячения воды или стирки белья, часто встроенный в конструкцию с топкой внизу.",
                        "zh": "一种大型金属容器，常用于烧水或洗衣，底部通常设有火炉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медный котёл",
                                "target_lang_sense_clarification": "ёмкость"
                            },
                            {
                                "target_lang_word": "бак для кипячения",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜锅",
                                "target_lang_sense_clarification": "大型金属容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d07c7a56-1a58-3f4d-9b7b-df05da3fda7b",
                    "sense_definition": "A small butterfly with reddish-brown wings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>copper</w> rested gently on the flower petal.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>червонец</w> осторожно сидел на лепестке цветка.",
                                "zh": "那只小<w>灰蝶</w>轻轻地停在花瓣上。"
                            }
                        },
                        {
                            "text": "We were lucky to see a rare <w>copper</w> flying near the river bank.",
                            "target_lang_translations": {
                                "ru": "Нам повезло увидеть редкого <w>червонца</w>, летающего у берега реки.",
                                "zh": "我们很幸运在河岸边看到了一只稀有的<w>灰蝶</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая бабочка с красновато-коричневыми крыльями.",
                        "zh": "一种翅膀呈红褐色的小型蝴蝶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "червонец",
                                "target_lang_sense_clarification": "вид бабочки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灰蝶",
                                "target_lang_sense_clarification": "蝴蝶种类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "629ced26-c735-3407-8109-118b0217bc68",
                    "sense_definition": "Made of the reddish-brown metal copper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prefers to use a <w>copper</w> pan for making sauces.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар предпочитает использовать <w>медную</w> сковороду для приготовления соусов.",
                                "zh": "厨师更喜欢用<w>铜制</w>平底锅来制作酱汁。"
                            }
                        },
                        {
                            "text": "They found an ancient <w>copper</w> bowl buried in the ground.",
                            "target_lang_translations": {
                                "ru": "Они нашли древнюю <w>медную</w> чашу, зарытую в землю.",
                                "zh": "他们在地下发现了一个古代<w>铜制</w>碗。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "copper coin",
                        "copper kettle",
                        "copper tubing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из красновато-коричневого металла меди.",
                        "zh": "由铜制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медный",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜制的",
                                "target_lang_sense_clarification": "材质形容词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd6d01e2-faf4-31f1-8b0f-7717a601ad29",
                    "sense_definition": "Having a reddish-brown color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun turned the sky a beautiful <w>copper</w> color.",
                            "target_lang_translations": {
                                "ru": "Заходящее солнце окрасило небо в красивый <w>медный</w> цвет.",
                                "zh": "落日将天空染成了美丽的<w>铜色</w>。"
                            }
                        },
                        {
                            "text": "He had distinct <w>copper</w> hair that made him easy to recognize.",
                            "target_lang_translations": {
                                "ru": "У него были заметные <w>медно-рыжие</w> волосы, по которым его было легко узнать.",
                                "zh": "他那头独特的<w>铜色</w>头发让他很容易被认出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coppery",
                        "reddish-brown"
                    ],
                    "common_phrases": [
                        "copper hair",
                        "copper sky",
                        "copper tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий красновато-коричневый цвет.",
                        "zh": "呈现红褐色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "медный",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "медно-рыжий",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铜色的",
                                "target_lang_sense_clarification": "颜色形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ad21a6b-3990-31d6-93cb-9ed90c1c81be",
                    "sense_definition": "To cover or coat something with a layer of copper.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders decided to <w>copper</w> the roof to protect it from the weather.",
                            "target_lang_translations": {
                                "ru": "Строители решили <w>покрыть медью</w> крышу, чтобы защитить её от непогоды.",
                                "zh": "建筑工人们决定给屋顶<w>镀铜</w>以抵御风雨。"
                            }
                        },
                        {
                            "text": "They used a special process to <w>copper</w> the bottom of the ship.",
                            "target_lang_translations": {
                                "ru": "Они использовали специальный процесс, чтобы <w>обшить медью</w> днище корабля.",
                                "zh": "他们使用了一种特殊工艺来给船底<w>镀铜</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать что-либо слоем меди.",
                        "zh": "在物体表面覆盖一层铜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрывать медью",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "меднить",
                                "target_lang_sense_clarification": "техническое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镀铜",
                                "target_lang_sense_clarification": "表面处理工艺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "54f708d5-6bfd-3bbb-b377-e4d601a0b68d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Copper</w> signed the documents at the bank.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Коппер</w> подписал документы в банке.",
                                "zh": "<w>科珀</w>先生在银行签署了文件。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Copper</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Сара <w>Коппер</w>.",
                                "zh": "我和一个叫莎拉·<w>科珀</w>的女孩上过同一所学校。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Коппер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科珀",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}