                ],
                "senses": [
                    {
                        "sense_id": "8ae6e7ab-e639-3d1f-835d-368c0f5dccf5",
                        "entry_id": "4fcf7112-c565-3dbd-8156-049eb971accd",
                        "glosses": [
                            "linker oder rechter senkrechter Teil eines Tores"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a53e78-29e7-4dff-8363-c6f6b9398bae",
                                "sense_id": "8ae6e7ab-e639-3d1f-835d-368c0f5dccf5",
                                "text": "„Während Pierre den Mantel wieder zurechtzog, öffnete er für einen Moment die Augen und sah wieder die Schuppendächer, die Torpfosten, den Hof von vorhin, aber jetzt war alles bläulich, hell und mit blitzendem Tau oder Reif bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "223f9b38-eb73-31b0-9384-a57f3c42eeed",
                        "entry_id": "4fcf7112-c565-3dbd-8156-049eb971accd",
                        "glosses": [
                            "seitlicher Pfosten eines Tores (im Fußball, Handball oder in anderen Spielen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443fd218-da87-491a-b65c-d5111a3710ea",
                                "sense_id": "223f9b38-eb73-31b0-9384-a57f3c42eeed",
                                "text": "„Ich bin mit Michael dann sofort auf die Moselwiesen gegangen, und Michael hat zwei Äste als Torpfosten auf die Moselwiesen gelegt, und dann ist er ins Tor gegangen, und ich habe den Ball auf sein Tor geschossen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34d4ce16-2803-4ecc-a7ac-24ae7fa3e885",
                        "source_entry_id": "4fcf7112-c565-3dbd-8156-049eb971accd",
                        "source_sense_id": "8ae6e7ab-e639-3d1f-835d-368c0f5dccf5",
                        "source_sense_description": "linker oder rechter senkrechter Teil eines Tores",
                        "target_lang_word": "goalpost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goalpost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05564566-71cc-30a9-aa34-4539847634b9",
                                        "entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                                        "glosses": [
                                            "One of the two vertical side poles of a goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50ed8ae8-d738-4aa3-8643-4582a6b15635",
                                                "sense_id": "05564566-71cc-30a9-aa34-4539847634b9",
                                                "text": "Some kids were having a kickabout on the grass beside the walkway, cheering, groaning, calling for the ball, absorbed in the game, a self-contained universe marked out by jackets for goalposts and invisible touchlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d4592c-9c32-389f-9315-9805c67edbea",
                                        "entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                                        "glosses": [
                                            "The tall Y-shaped upright, now usually of fiberglass, at either end of the playing field, through which a football must go in order for a field goal to be scored. (They were originally H-shaped, with one wooden post on either side.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec68e1d3-aa9d-343c-82b4-518b6d97467c",
                                        "entry_id": "f1602a60-85cc-3a95-b1bc-3910cd5f4052",
                                        "glosses": [
                                            "A rule or target that is \\\"moved\\\" (changed) unfairly; see move the goalposts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af900bc5-8cb8-4fa4-9ab5-c7334b57078e",
                                                "sense_id": "ec68e1d3-aa9d-343c-82b4-518b6d97467c",
                                                "text": "[…] whatever you eat, how much you drink, you know the goalposts keep moving all the time, and it's difficult to be sure that, but I don't think it's harmful, not the amount I drink."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
