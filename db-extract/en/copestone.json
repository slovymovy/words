                                "sense_id": "e372ebca-7fac-3f29-8855-5cf0bdbbf953",
                                "text": "The universe is finished; the copestone is on, and the chips were carted off a million years ago."
                            },
                            {
                                "example_id": "57340d55-4cd5-4522-877e-f1237b833a97",
                                "sense_id": "e372ebca-7fac-3f29-8855-5cf0bdbbf953",
                                "text": "For small erections may be finished by their first architects ; grand ones, true ones, ever leave the copestone to posterity."
                            }
                        ]
