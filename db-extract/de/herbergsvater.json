                "senses": [
                    {
                        "sense_id": "f95715e0-e183-3122-b324-6864402c3e76",
                        "entry_id": "81bfe557-43aa-39e4-8dcb-e3d1a2a556df",
                        "glosses": [
                            "Leiter einer Herberge (zum Beispiel einer Jugendherberge)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66cf2535-904f-4758-bd9e-beaaba512522",
                                "sense_id": "f95715e0-e183-3122-b324-6864402c3e76",
                                "text": "Für die Reparaturen ist bei uns der Herbergsvater zuständig."
                            },
                            {
                                "example_id": "a3aaf489-c379-41a4-b49a-f555bcc1bbff",
                                "sense_id": "f95715e0-e183-3122-b324-6864402c3e76",
                                "text": "„Auch Fried war begeistert von seinen Bildern, und als er es wagte, sie in der Herberge und der Gärtnerei zu zeigen und der Herbergsvater ihm sogar ein Aquarell des Lehrlingsheims abkaufte, da war er zum ersten Mal in seinem Leben richtig stolz gewesen.“"
                            },
                            {
                                "example_id": "184f2408-f5ce-406d-a7eb-6d3a32cef097",
                                "sense_id": "f95715e0-e183-3122-b324-6864402c3e76",
                                "text": "„Der Herbergsvater spricht ziemlich laut und so, als sei er sehr schlecht gelaunt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
