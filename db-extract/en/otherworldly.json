                                        "entry_id": "d2d95874-5c6a-3088-9888-31059c3d40f2",
                                        "glosses": [
                                            "auf der anderen Seite"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22d4e4d1-9b86-48a0-b8b7-f9ad7f758eac",
                                                "sense_id": "f9f5e8be-83f0-361b-b0e3-6690a6e68b28",
                                                "text": "Das jenseitige Ufer war nicht zu erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4c7a23f-6321-3137-8a77-f6934ebb36b2",
                                        "entry_id": "d2d95874-5c6a-3088-9888-31059c3d40f2",
                                        "glosses": [
                                            "auf das Jenseits, das Himmlische bezogen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "193db9e7-1ba1-4a3e-8212-f6732e6fd4a4",
                                                "sense_id": "c4c7a23f-6321-3137-8a77-f6934ebb36b2",
                                                "text": "„Nur wer eine Macht im Diesseits war, dem gehörte auch die jenseitige Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2df433b4-ee2b-305b-aced-ff269f61a712",
                                        "entry_id": "d2d95874-5c6a-3088-9888-31059c3d40f2",
                                        "glosses": [
                                            "abwesend, weggetreten, daneben liegend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c30ac6f-8146-4208-858e-e49672392d8d",
                                                "sense_id": "2df433b4-ee2b-305b-aced-ff269f61a712",
                                                "text": "„Nun ja, der Vergleich mit Stalingrad ist irgendwie jenseitig, aber was ist bezüglich Saigon da wirklich zu verneinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
