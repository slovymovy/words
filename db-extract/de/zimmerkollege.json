                            {
                                "example_id": "d0aab58e-f4e4-4db2-ba14-64a1588bd7ee",
                                "sense_id": "d1724990-e808-33f9-b296-a5fc9a693317",
                                "text": "Aufgrund der Zeitverschiebung war ich um 12 Uhr im Bett und konnte ab 4.30 Uhr nicht mehr schlafen. Ich habe trotzdem versucht ruhig liegen zu bleiben, um meinen Zimmerkollegen John Tripp nicht zu wecken."
                            }
                        ],
