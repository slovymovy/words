{
    "word_family": [
        "unyielding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b58e887b-ff1d-3320-8cf9-3007b38a3b77",
                    "sense_definition": "To produce or provide a result, answer, or natural product.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "produce_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation <w>yielded</w> some interesting results regarding the company's finances.",
                            "target_lang_translations": {
                                "ru": "Расследование <w>дало</w> несколько интересных результатов касательно финансов компании.",
                                "tr": "Soruşturma, şirketin finansal durumuyla ilgili bazı ilginç sonuçlar <w>verdi</w>."
                            }
                        },
                        {
                            "text": "This new method generally <w>yields</w> better outcomes than the old one.",
                            "target_lang_translations": {
                                "ru": "Этот новый метод обычно <w>даёт</w> лучшие результаты, чем старый.",
                                "tr": "Bu yeni yöntem genellikle eski yönteme göre daha iyi sonuçlar <w>sağlar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "produce",
                        "generate",
                        "provide",
                        "bear",
                        "furnish"
                    ],
                    "common_phrases": [
                        "yield results",
                        "yield benefits",
                        "yield fruit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить или предоставлять результат, ответ или природный продукт.",
                        "tr": "Sonuç, yanıt veya doğal bir ürün vermek, üretmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дава́ть",
                                "target_lang_sense_clarification": "производить результат"
                            },
                            {
                                "target_lang_word": "приноси́ть",
                                "target_lang_sense_clarification": "плоды, пользу, прибыль"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "vermek",
                                "target_lang_sense_clarification": "sonuç veya ürün sağlamak"
                            },
                            {
                                "target_lang_word": "sağlamak",
                                "target_lang_sense_clarification": "fayda veya sonuç getirmek"
                            },
                            {
                                "target_lang_word": "ürün vermek",
                                "target_lang_sense_clarification": "doğal ürün veya mahsul elde edilmesini sağlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "813d4095-1dc6-3313-a9e4-ad44b274dba7",
                    "sense_definition": "To stop resisting and surrender to someone or something; to give up control.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "surrender",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government refused to <w>yield</w> to the demands of the terrorists.",
                            "target_lang_translations": {
                                "ru": "Правительство отказалось <w>уступать</w> требованиям террористов.",
                                "tr": "Hükümet, teröristlerin taleplerine <w>boyun eğmeyi</w> reddetti."
                            }
                        },
                        {
                            "text": "After a long argument, she finally <w>yielded</w> the point to her colleague.",
                            "target_lang_translations": {
                                "ru": "После долгого спора она наконец <w>уступила</w> в этом вопросе своему коллеге.",
                                "tr": "Uzun bir tartışmanın ardından nihayet meslektaşına hak vererek <w>pes etti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "surrender",
                        "give in",
                        "submit",
                        "capitulate",
                        "relent"
                    ],
                    "antonyms": [
                        "resist",
                        "withstand"
                    ],
                    "common_phrases": [
                        "yield to pressure",
                        "yield control",
                        "yield to temptation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать сопротивляться и сдаться кому-то или чему-то; отказаться от контроля.",
                        "tr": "Direnç göstermeyi bırakıp birine veya bir şeye boyun eğmek; kontrolü bırakmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уступа́ть",
                                "target_lang_sense_clarification": "соглашаться, поддаваться"
                            },
                            {
                                "target_lang_word": "сдава́ться",
                                "target_lang_sense_clarification": "прекращать сопротивление"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boyun eğmek",
                                "target_lang_sense_clarification": "teslim olmak, direnmeyi bırakmak"
                            },
                            {
                                "target_lang_word": "pes etmek",
                                "target_lang_sense_clarification": "vazgeçmek, teslim olmak"
                            },
                            {
                                "target_lang_word": "ödün vermek",
                                "target_lang_sense_clarification": "uzlaşmak, kararından vazgeçmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c147987-c416-36a2-b843-76002095a17a",
                    "sense_definition": "To allow other vehicles or people to go past before you enter a road or cross a path.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "give_way",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers must <w>yield</w> to pedestrians who are crossing the street.",
                            "target_lang_translations": {
                                "ru": "Водители должны <w>уступать</w> дорогу пешеходам, переходящим улицу.",
                                "tr": "Sürücüler, karşıdan karşıya geçen yayalara <w>yol vermelidir</w>."
                            }
                        },
                        {
                            "text": "You are required to <w>yield</w> the right of way to oncoming traffic.",
                            "target_lang_translations": {
                                "ru": "Вы обязаны <w>уступить</w> право проезда встречному транспорту.",
                                "tr": "Gelen trafiğe <w>yol hakkı tanımanız</w> gerekmektedir."
                            }
                        }
                    ],
                    "synonyms": [
                        "give way"
                    ],
                    "common_phrases": [
                        "yield the right of way",
                        "yield to traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропускать другие транспортные средства или людей перед выездом на дорогу или переходом пути.",
                        "tr": "Bir yola girmeden veya karşıya geçmeden önce diğer araçların veya insanların geçmesine izin vermek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уступа́ть",
                                "target_lang_sense_clarification": "дорогу"
                            },
                            {
                                "target_lang_word": "пропуска́ть",
                                "target_lang_sense_clarification": "давать пройти"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yol vermek",
                                "target_lang_sense_clarification": "geçiş üstünlüğü tanımak"
                            },
                            {
                                "target_lang_word": "yol hakkı tanımak",
                                "target_lang_sense_clarification": "trafikte öncelik vermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30554c24-fd71-369c-a249-3e466a8aa697",
                    "sense_definition": "To move, bend, or break because of physical force or pressure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "give_way",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy wooden door finally <w>yielded</w> when we pushed it together.",
                            "target_lang_translations": {
                                "ru": "Тяжёлая деревянная дверь наконец <w>поддалась</w>, когда мы толкнули её вместе.",
                                "tr": "Hep birlikte ittiğimizde ağır ahşap kapı nihayet <w>dayanamadı</w>."
                            }
                        },
                        {
                            "text": "The shelf began to <w>yield</w> under the weight of all the books.",
                            "target_lang_translations": {
                                "ru": "Полка начала <w>прогибаться</w> под тяжестью всех этих книг.",
                                "tr": "Raf, tüm kitapların ağırlığı altında <w>esnemeye</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "give way",
                        "break",
                        "bend"
                    ],
                    "common_phrases": [
                        "yield under pressure",
                        "yield under weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдвигаться, гнуться или ломаться под воздействием физической силы или давления.",
                        "tr": "Fiziksel güç veya baskı nedeniyle esnemek, eğilmek veya kırılmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддава́ться",
                                "target_lang_sense_clarification": "сдвигаться с места"
                            },
                            {
                                "target_lang_word": "прогиба́ться",
                                "target_lang_sense_clarification": "гнуться под весом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dayanamamak",
                                "target_lang_sense_clarification": "baskı altında pes etmek veya kırılmak"
                            },
                            {
                                "target_lang_word": "esnemek",
                                "target_lang_sense_clarification": "basınca uğrayıp bükülmek"
                            },
                            {
                                "target_lang_word": "çökmek",
                                "target_lang_sense_clarification": "ağırlık altında kırılmak veya teslim olmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f0230c34-d5c3-3d90-9a88-515adede9650",
                    "sense_definition": "The total amount of a crop or other product that is produced.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "amount_produced",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers were pleased with the high <w>yield</w> of wheat this harvest.",
                            "target_lang_translations": {
                                "ru": "Фермеры были довольны высоким <w>урожаем</w> пшеницы в эту жатву.",
                                "tr": "Çiftçiler bu hasattaki yüksek buğday <w>veriminden</w> memnundu."
                            }
                        },
                        {
                            "text": "New agricultural techniques have significantly increased the crop <w>yield</w>.",
                            "target_lang_translations": {
                                "ru": "Новые сельскохозяйственные методы значительно увеличили <w>урожайность</w> культур.",
                                "tr": "Yeni tarım teknikleri ürün <w>rekoltesini</w> önemli ölçüde artırdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "harvest",
                        "crop",
                        "produce",
                        "output"
                    ],
                    "common_phrases": [
                        "crop yield",
                        "high yield",
                        "average yield"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее количество урожая или другого продукта, которое было произведено.",
                        "tr": "Üretilen toplam tarım ürünü veya miktar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урожа́й",
                                "target_lang_sense_clarification": "сельскохозяйственный"
                            },
                            {
                                "target_lang_word": "вы́ход",
                                "target_lang_sense_clarification": "продукции"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ürün",
                                "target_lang_sense_clarification": "elde edilen mahsul"
                            },
                            {
                                "target_lang_word": "rekolte",
                                "target_lang_sense_clarification": "yıllık toplam tarımsal rekolte"
                            },
                            {
                                "target_lang_word": "verim",
                                "target_lang_sense_clarification": "elde edilen üretim miktarı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82163cfe-9123-3c0e-8d54-e673bfdcaa5a",
                    "sense_definition": "The profit or money earned from an investment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_return",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors are always looking for safe bonds with a high <w>yield</w>.",
                            "target_lang_translations": {
                                "ru": "Инвесторы всегда ищут надёжные облигации с высокой <w>доходностью</w>.",
                                "tr": "Yatırımcılar her zaman yüksek <w>getirili</w> güvenli tahviller ararlar."
                            }
                        },
                        {
                            "text": "The current <w>yield</w> on these shares is lower than we expected.",
                            "target_lang_translations": {
                                "ru": "Текущая <w>доходность</w> этих акций ниже, чем мы ожидали.",
                                "tr": "Bu hisselerin mevcut <w>getirisi</w> beklediğimizden daha düşük."
                            }
                        }
                    ],
                    "synonyms": [
                        "return",
                        "profit",
                        "gain"
                    ],
                    "common_phrases": [
                        "bond yield",
                        "dividend yield",
                        "annual yield"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прибыль или деньги, полученные от инвестиций.",
                        "tr": "Bir yatırımdan elde edilen kâr veya finansal getiri."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дохо́дность",
                                "target_lang_sense_clarification": "процентный доход"
                            },
                            {
                                "target_lang_word": "дохо́д",
                                "target_lang_sense_clarification": "прибыль"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "getiri",
                                "target_lang_sense_clarification": "finansal kazanç oranı"
                            },
                            {
                                "target_lang_word": "kazanç",
                                "target_lang_sense_clarification": "elde edilen para"
                            },
                            {
                                "target_lang_word": "kâr",
                                "target_lang_sense_clarification": "yatırım getirisi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}