        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32051692-bfbe-3566-844f-5b462134ed62",
                    "sense_definition": "Caractère de ce qui manque de netteté ou de précision ; situation incertaine ou indéterminée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il existe un véritable <w>flou</w> juridique autour de l'utilisation de cette nouvelle technologie.",
                            "target_lang_translations": {
                                "en": "There is genuine legal <w>vagueness</w> surrounding the use of this new technology.",
                                "ru": "Вокруг использования этой новой технологии существует настоящая правовая <w>неопределённость</w>.",
                                "de": "Rund um den Einsatz dieser neuen Technologie herrscht echte rechtliche <w>Unklarheit</w>.",
                                "es": "Existe una verdadera <w>vaguedad</w> jurídica en torno al uso de esta nueva tecnología.",
                                "zh": "关于这项新技术的使用，法律上确实存在不小的<w>模糊性</w>。"
                            }
                        },
                        {
                            "text": "Le photographe a volontairement conservé un léger <w>flou</w> pour mettre en valeur le sujet.",
                            "target_lang_translations": {
                                "en": "The photographer deliberately kept a slight <w>blur</w> to highlight the subject.",
                                "ru": "Фотограф намеренно оставил лёгкую <w>размытость</w>, чтобы выделить главный объект снимка.",
                                "de": "Der Fotograf hat absichtlich eine leichte <w>Unschärfe</w> belassen, um das Motiv hervorzuheben.",
                                "es": "El fotógrafo conservó a propósito un ligero <w>desenfoque</w> para realzar el sujeto.",
                                "zh": "摄影师故意保留了一点<w>模糊性</w>，以突出主体。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flou artistique",
                        "flou juridique"
