                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "celestial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "457df9d0-c24c-3fc2-b40b-4be90b3d3daa",
                                        "entry_id": "8e0e8d67-db39-3831-9135-911a3b9b8380",
                                        "glosses": [
                                            "Synonym of heavenly: of or related to Heaven and the divine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fce27fd-9cf4-422b-b4c1-7d969a4a084b",
                                                "sense_id": "457df9d0-c24c-3fc2-b40b-4be90b3d3daa",
                                                "text": "Thus ſhall my heart be ſtil combinde with thine,\nUntill our bodies turne to Elements:\nAnd both our ſoules aſpire celeſtiall thrones."
                                            },
                                            {
                                                "example_id": "aef11f97-0501-40f0-b38c-6f336d4f441e",
                                                "sense_id": "457df9d0-c24c-3fc2-b40b-4be90b3d3daa",
                                                "text": "But far above, in spangled sheen,\nCelestial Cupid her famed son advanced",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f611d1-9418-3d2b-888a-0ff034ebabf0",
                                        "entry_id": "8e0e8d67-db39-3831-9135-911a3b9b8380",
                                        "glosses": [
                                            "Relating to the sky or outer space, regarded as the realm of the sun, moon, planets, and stars."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7505672b-7718-4069-a1dd-d8ee9294c427",
                                                "sense_id": "02f611d1-9418-3d2b-888a-0ff034ebabf0",
                                                "text": "The twelve celestial signs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4ae49fc-f297-35a2-bc02-3ed41c6eb029",
                                        "entry_id": "8e0e8d67-db39-3831-9135-911a3b9b8380",
                                        "glosses": [
                                            "Of or pertaining to the highest degree of glory."
                                        ],
                                        "tags": [
                                            "Mormonism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db0c18d1-cd9e-4a22-b7d2-4011ac75847e",
                                                "sense_id": "c4ae49fc-f297-35a2-bc02-3ed41c6eb029",
                                                "text": "We are now living and obeying celestial laws that will make us candidates for celestial glory."
                                            },
                                            {
                                                "example_id": "dff62452-0fea-460f-bd8f-4a106c58fc1b",
                                                "sense_id": "c4ae49fc-f297-35a2-bc02-3ed41c6eb029",
                                                "text": "How will you make it through your teenage years spiritually prepared for your celestial future? How will you connect your celestial goals with your everyday life?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a2c9d3-2dfb-3037-a86c-0996234dc751",
                                        "entry_id": "8e0e8d67-db39-3831-9135-911a3b9b8380",
                                        "glosses": [
                                            "Extremely good, pleasant, or blissful; heavenly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "755856f9-8670-40fa-a96a-2a4692034a0f",
                                                "sense_id": "20a2c9d3-2dfb-3037-a86c-0996234dc751",
                                                "text": "[Reader:] A really bad coconut is soooo yukky. But a really good coconut is so celestial. [...] If you can hear the milk sloshing inside, odds are you’ve got a celestial coconut rather than a yukky one."
                                            }
                                        ]
                                    }
                                ]
                            },
