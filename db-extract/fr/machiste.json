                    }
                ],
                "senses": [
                    {
                        "sense_id": "dab32529-fb10-3fee-859a-c85fb3b5e4e9",
                        "entry_id": "4449a5b5-404c-335e-aaa5-365f08c50f2b",
                        "glosses": [
                            "Tenant du machisme, pensée d’Ernst Mach."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf43bb89-54a9-421e-ba04-8073a41673c2",
                                "sense_id": "dab32529-fb10-3fee-859a-c85fb3b5e4e9",
                                "text": "Je remarque que votre pensée, Machistes, s’est heurtée souvent à une dualité, à des dichotomies, et que vous n’avez pas toujours pu les surmonter, ni les réduire."
                            },
                            {
                                "example_id": "c127ac9f-52a0-4ff4-a62d-124b56a86259",
                                "sense_id": "dab32529-fb10-3fee-859a-c85fb3b5e4e9",
                                "text": "La seconde étape de l'évolution du positivisme est celle de l'empiriocriticisme (le « machisme ») qui se constitue à la limite du xixc et du xxe siècles. Alors que les positivistes du xix° siècle niaient qu'il fût possible de donner une réponse fondée, précise, au problème fondamental de la philosophie, les machistes (Mach, Avenarius et autres) essaient une autre façon de se défaire du matérialisme."
                            }
                        ]
                    }
                ],
                "translations": [
