                    "frequency": "Middle",
                    "semantic_group_id": "diminution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les températures vont <w>chuter</w> de dix degrés dès demain matin avec l'arrivée de l'hiver."
                        },
                        {
                            "text": "Le cours de cette action a commencé à <w>chuter</w> après l'annonce des résultats trimestriels."
                        }
                    ],
                    "synonyms": [
