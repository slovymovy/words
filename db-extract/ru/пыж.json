                    },
                    {
                        "sense_id": "b9bab97d-f7ca-3254-a8ab-11361a6b1cd8",
                        "entry_id": "83f4315e-8052-3fc6-990d-e35339aa8fcd",
                        "glosses": [
                            "истор., воен. комок пеньки, шерсти, войлока и т. п., которым забивают заряд в огнестрельном оружии, заряжающемся с дула"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "413c8e06-8a00-47b9-a13b-5e4e1b843e44",
                        "source_entry_id": "83f4315e-8052-3fc6-990d-e35339aa8fcd",
                        "target_lang_word": "wad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89fd28e1-35c7-3c49-9f23-c5f8de61a26a",
                                        "entry_id": "6a31fe5f-4161-33bf-ac71-99c661fa1c4d",
                                        "glosses": [
                                            "An amorphous, compact mass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d54f0d4-eaaf-41ec-a74a-4c40eed2f683",
                                                "sense_id": "89fd28e1-35c7-3c49-9f23-c5f8de61a26a",
                                                "text": "Our cat loves to play with a small wad of paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66af1391-f0c4-3d55-bfd2-bbf557cc0eb7",
                                        "entry_id": "6a31fe5f-4161-33bf-ac71-99c661fa1c4d",
                                        "glosses": [
                                            "A substantial pile (normally of money)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa593df-dbca-4dbe-bf03-cdbd88090f8d",
                                                "sense_id": "66af1391-f0c4-3d55-bfd2-bbf557cc0eb7",
                                                "text": "With a wad of cash like that, she should not have been walking round Manhattan."
                                            },
                                            {
                                                "example_id": "bc8dbfd5-5557-41b3-b155-9f1db74175ae",
                                                "sense_id": "66af1391-f0c4-3d55-bfd2-bbf557cc0eb7",
                                                "text": "The campfires provide enough plain old regular visible light to show this sorry affair for what it is: a bunch of demented Boy Scouts, a jamboree without merit badges or hygiene. With the IR supered on top of the visible, she can also see vague, spectral red faces out in the shadows where her unassisted eyes would only see darkness. These new Knight Visions cost her a big wad of her Mob drug-running money. Just the kind of thing Mom had in mind when she insisted Y.T. get a part-time job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c4e073-7eed-3263-91b5-0a2e5549ff04",
                                        "entry_id": "6a31fe5f-4161-33bf-ac71-99c661fa1c4d",
                                        "glosses": [
                                            "A soft plug or seal, particularly as used between the powder and pellets in a shotgun cartridge, or earlier on the charge of a muzzleloader or cannon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "705582d5-2f6f-3d73-abfd-619b91c80d5a",
                                        "entry_id": "6a31fe5f-4161-33bf-ac71-99c661fa1c4d",
                                        "glosses": [
                                            "A sandwich."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41656e59-7252-41c3-9050-fef390499282",
                                                "sense_id": "705582d5-2f6f-3d73-abfd-619b91c80d5a",
                                                "text": "Once we were all sat on the ground, drinking our tea and eating a cheese wad - that was all you could get - I asked where my mate Jackson was. Nobody had any idea but as he was required in the flight office we did a search."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35cb8185-9cd8-3179-a9ad-e26408be8df5",
                                        "entry_id": "6a31fe5f-4161-33bf-ac71-99c661fa1c4d",
                                        "glosses": [
                                            "An ejaculation of semen."
                                        ],
                                        "tags": [
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2bd549-e8d9-4dde-9ce0-4a5053a582d4",
                                                "sense_id": "35cb8185-9cd8-3179-a9ad-e26408be8df5",
                                                "text": "All at once, Steven let out a loud gasp, as his cock jerked violently in his hand and sent wad after wad of hot white sperm shooting out all over his chest and stomach."
                                            },
                                            {
                                                "example_id": "9f1058e6-9e1e-4c0f-82c9-90de323ccdd4",
                                                "sense_id": "35cb8185-9cd8-3179-a9ad-e26408be8df5",
                                                "text": "It's a strange thing this yellow liquid, the bodily fluid of a stranger. What was he thinking when he shot his wad? Is he somewhere now wondering about his sperm? Is he at this very moment wondering if a woman somewhere is inseminating with his seed? Well, we are! Here we are in Boston, and we are!"
                                            },
                                            {
                                                "example_id": "cf51c7ee-c098-4c04-9448-97c097c06e70",
                                                "sense_id": "35cb8185-9cd8-3179-a9ad-e26408be8df5",
                                                "text": "When a man \"blows his wad,\" at least two different things could have occurred: he either spent or lost all his money in a wager (his wad), or he spent or ejaculated his sperm (his wad). Thorne goes on to suggest that since at least the 1950s \"blow,\" in this context, is a euphemism for \"ejaculate.\""
                                            },
                                            {
                                                "example_id": "e9c36a0f-a54d-4b43-835b-22ef12fc3852",
                                                "sense_id": "35cb8185-9cd8-3179-a9ad-e26408be8df5",
                                                "text": "Grabbing hold of his throbbing organ, he started to turn away from her, had second thoughts, and proceeded to shoot his wad, ejaculate all over the sweating, sultry body that was stretched out, languishing at his feet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "599d5201-d7ef-3724-801d-83de91364976",
                                        "entry_id": "172263c3-0f71-3a03-8be2-3b9cb3e995fc",
                                        "glosses": [
                                            "To crumple or crush into a compact, amorphous shape or ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55197d7-2bc9-4aec-8e0b-2b6436927400",
                                                "sense_id": "599d5201-d7ef-3724-801d-83de91364976",
                                                "text": "She wadded up the scrap of paper and threw it in the trash."
                                            },
                                            {
                                                "example_id": "a17cea7c-fab6-4fb5-8791-783cc5195f8b",
                                                "sense_id": "599d5201-d7ef-3724-801d-83de91364976",
                                                "text": "[…] if you lay any fearnbrakes or other trash about them to entertain the moisture, and skreen it from the heat, let it not be wadded so close, or suffer’d to lie so long, as to contract any mustiness, but rather loose and easie, that the Air may have free intercourse, and to break the more intense ardours of the scorching Sun-beams."
                                            },
                                            {
                                                "example_id": "699222b2-256b-4933-bd09-f6da701b2b93",
                                                "sense_id": "599d5201-d7ef-3724-801d-83de91364976",
                                                "text": "She stood just inside the door, wadding a black-bordered hand-kerchief in her small gloved hands […]"
                                            },
                                            {
                                                "example_id": "cf635600-ba2c-46a0-8a94-6eed7a326d20",
                                                "sense_id": "599d5201-d7ef-3724-801d-83de91364976",
                                                "text": "Mitch wadded the note, and tossed it over the cliff."
                                            },
                                            {
                                                "example_id": "bedc60c8-69d0-4948-9275-8e23594eb658",
                                                "sense_id": "599d5201-d7ef-3724-801d-83de91364976",
                                                "text": "She wadded Marian into her chair, which was lumpy with garments in progressive stages of dirtiness, and tucked a towel around her neck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8193d3c4-ac3a-35c8-be4b-ded96900e3a9",
                                        "entry_id": "172263c3-0f71-3a03-8be2-3b9cb3e995fc",
                                        "glosses": [
                                            "To wager."
