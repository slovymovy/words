                        "examples": [
                            {
                                "example_id": "699dd070-ad09-47bd-bb51-428191f8c9ea",
                                "sense_id": "ce6c2576-c0bf-36fc-88f8-146b665b02f1",
                                "text": "U2-zanger Bono (54) draagt altijd een zonnebril omdat hij al twintig jaar lijdt aan de oogziekte glaucoom. Dat onthult de zanger in de Graham Norton Show. Bij deze chronische oogaandoening gaan de zenuwvezels van de oogzenuw geleidelijk verloren."
                            },
                            {
                                "example_id": "61cdbaf2-5bfc-4a16-9eb6-c9d46c78d084",
                                "sense_id": "ce6c2576-c0bf-36fc-88f8-146b665b02f1",
                                "text": "Tanden en kiezen bestaan uit een kroon en één of meerdere wortels. Deze zitten in het kaakbot onder het tandvlees. In elke wortel loopt tenminste één kanaal: het wortelkanaal. Hierin zitten zenuwvezels en kleine bloedvaten. Door tandbederf of een lekkende vulling kan dit weefsel worden aangetast; binnendringende bacteriën veroorzaken ontstoken tandweefsel"
                            }
                        ]
                    }
