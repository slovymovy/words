                "senses": [
                    {
                        "sense_id": "afe30bc0-12c9-3481-b04f-344688595bf6",
                        "entry_id": "f3bc4f9d-75fb-3d9f-b64c-4743656f4a51",
                        "glosses": [
                            "Werkstatt/Produktionsort an dem Druckerzeugnisse hergestellt werden; geschäftliche Aktivität des Erstellens von Druckerzeugnissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5288238-ca84-474b-86de-d73b297fc282",
                                "sense_id": "afe30bc0-12c9-3481-b04f-344688595bf6",
                                "text": "„Zwar bestätigte im Jahr 1603 das Reichskammergericht die Rechtsauffassung der Regierung; der Streit zog sich jedoch noch einige Jahre hin, bis Hantzsch im Sommer 1610 aufgab und den Druckereibetrieb einstellte.“"
                            },
                            {
                                "example_id": "816b1087-2e92-4434-a13f-4245c6c21eda",
                                "sense_id": "afe30bc0-12c9-3481-b04f-344688595bf6",
                                "text": "„Bozen gab es hinter dem Bahnhof einen kleinen Druckereibetrieb, der die besten Zeiten hinter sich hatte. Gianluca, der die Firma von seinem Vater geerbt hatte, versuchte, sich mit kleinen Aufträgen über Wasser zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6bd456df-032b-3b0b-9e9e-8c820ad63acd",
                        "entry_id": "f3bc4f9d-75fb-3d9f-b64c-4743656f4a51",
                        "glosses": [
                            "Gesamtheit der Aktivitäten und Tätigkeiten in einer Druckerei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a236595-f7c6-47f7-8d90-c0d8f0fd58b8",
                                "sense_id": "6bd456df-032b-3b0b-9e9e-8c820ad63acd",
                                "text": "„Nach Ende des Zweiten Weltkrieges wurde am 1. November 1949 der Druckereibetrieb wieder aufgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
