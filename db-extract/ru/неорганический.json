                        "source_sense_id": "0e3fa3d4-d4e1-3017-bf1b-c250b7e3c387",
                        "target_lang_word": "anorganisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorganisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da4bf70f-3461-3cff-adaa-314511789b52",
                                        "entry_id": "c609a3eb-1ea7-3d3d-a77f-1884586904f1",
                                        "glosses": [
                                            "zum unbelebten Teil der Natur gehörend; nicht von Lebewesen stammend; nicht zum belebten Teil der Natur gehörend;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a7f67e8-2767-486a-8404-031f498bfc8d",
                                                "sense_id": "da4bf70f-3461-3cff-adaa-314511789b52",
                                                "text": "Tübingen und München gelang es, in der anorganischen Chemie unter die ersten zehn zu kommen, Freiburg und Mainz in der organischen und Polymerchemie."
                                            },
                                            {
                                                "example_id": "6751ff15-67ee-443d-998b-6a220b252e38",
                                                "sense_id": "da4bf70f-3461-3cff-adaa-314511789b52",
                                                "text": "In der Atomphysik vereinigten sich in den ersten Jahrzehnten des 20. Jahrhunderts die Disziplinen der Chemie und Physik, und Heisenbergs Quantentheorie leistete das, was Weizsäcker die »Vereinheitlichung der Grundgesetze« im anorganischen Bereich nannte."
                                            },
                                            {
                                                "example_id": "735065d4-c90a-42e3-9a6c-b2657dcab193",
                                                "sense_id": "da4bf70f-3461-3cff-adaa-314511789b52",
                                                "text": "Organische Moleküle kann man zum Beispiel mithilfe der so genannten PCR tausendfach kopieren - ein entsprechendes Verfahren für anorganische Moleküle wäre revolutionär."
                                            },
                                            {
                                                "example_id": "879a2a3e-53f3-4bb8-9d80-627e89d3a711",
                                                "sense_id": "da4bf70f-3461-3cff-adaa-314511789b52",
                                                "text": "Ein Begriff von Erdgeschichte entstand allerdings erst in der Zeit der Französischen Revolution, und so erschienen die Versteinerungen nicht als Relikte organischen Lebens, sondern als anorganische Schöpfungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "06da577c-eb84-3ad5-8697-30db4abb40b4",
                                        "entry_id": "c609a3eb-1ea7-3d3d-a77f-1884586904f1",
                                        "glosses": [
                                            "nicht nach bestimmten, natürlichen Regeln ablaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a60ae0c7-036d-47e4-944b-75beb79a8597",
                                                "sense_id": "06da577c-eb84-3ad5-8697-30db4abb40b4",
                                                "text": "Anorganisch und menschenfern, tief unter der Oberfläche der Technik und der bearbeiteten Tonquellen, sind meist nicht mehr als zwei klingende Phänomene zur selben Zeit zu hören, die aber akribisch organisiert sind."
                                            },
                                            {
                                                "example_id": "a1c1ce5f-e38d-420d-aa21-a9b9f2c6a7a3",
                                                "sense_id": "06da577c-eb84-3ad5-8697-30db4abb40b4",
                                                "text": "Die Bewegungen des Kinos waren für Sternberg anorganisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58d152bd-a049-33fe-abf6-982f6c17aeea",
                                        "entry_id": "c609a3eb-1ea7-3d3d-a77f-1884586904f1",
                                        "glosses": [
                                            "ohne morphologische Notwendigkeit, zumeist aus phonologischen Gründen eingeschoben"
                                        ],
                                        "tags": [
                                            "von Lauten oder Buchstaben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42be38e0-7a8e-4dde-9fa6-223a5054c393",
                                                "sense_id": "58d152bd-a049-33fe-abf6-982f6c17aeea",
                                                "text": "Die Einfügung von „t“ im Wort „wesentlich“ ist anorganisch, weil sie keine morphologische Funktion besitzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
