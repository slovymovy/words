                        "examples": [
                            {
                                "example_id": "c96df9ed-8ba0-483b-be75-988c6971033a",
                                "sense_id": "9b874fe3-57de-360f-94fa-72995525f7c6",
                                "text": "De deelnemers krijgen de gladiolen traditiegetrouw van het publiek aangeboden op de laatste dag van het wandelevenement. Met hun armen vol bloemen lopen ze de stad in over de Sint Annastraat, die dan voor even Via Gladiola heet. Dit jaar dus niet."
                            },
                            {
                                "example_id": "8fe7b83a-901c-41d9-a759-1cec37768e25",
                                "sense_id": "9b874fe3-57de-360f-94fa-72995525f7c6",
                                "text": "De 59e editie van het populaire wandelevenement zou op 2 juni beginnen. ‘Een datum waarom nog niet zeker is of een evenement van deze omvang al mogelijk is. Ook in de voorbereiding zouden er probleem ontstaan door de beperkingen om bijeen te komen’, zo laat de organisatie van de wandelvierdaagse weten."
                            }
                        ]
