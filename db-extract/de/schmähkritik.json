                        ],
                        "examples": [
                            {
                                "example_id": "56b0ead7-cfac-473c-a319-e6b30572e10d",
                                "sense_id": "9d718735-afd0-3560-9b51-6640f267d8e8",
                                "text": "Bei herabsetzenden Äußerungen, die sich als Formalbeleidigung oder Schmähung darstellten, habe die Meinungsfreiheit aber regelmäßig hinter dem Ehrenschutz zurückzutreten. Nach der engen Definition des Bundesverfassungsgerichts für das Vorliegen einer Schmähung liege eine solche Schmähkritik vor."
                            }
                        ]
