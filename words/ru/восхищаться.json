{
    "word_family": [
        "восхищение",
        "восхитительный",
        "восхитить",
        "восхищать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4573a8e1-e2e9-3f8a-9cea-c1c591ba5ec3",
                    "sense_definition": "Испытывать чувство глубокого удовлетворения, восторга, радости от кого-либо или чего-либо; выражать сильное одобрение.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "восхищение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я искренне <w>восхищаюсь</w> твоим талантом и трудолюбием.",
                            "target_lang_translations": {
                                "en": "I sincerely <w>admire</w> your talent and hard work."
                            }
                        },
                        {
                            "text": "Все зрители продолжали <w>восхищаться</w> красотой этого старинного города.",
                            "target_lang_translations": {
                                "en": "All the spectators continued to <w>admire</w> the beauty of this ancient city."
                            }
                        }
                    ],
                    "synonyms": [
                        "восторгаться"
                    ],
                    "common_phrases": [
                        "восхищаться талантом",
                        "искренне восхищаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To experience a feeling of deep satisfaction, delight, or joy from someone or something; to express strong approval."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "admire",
                                "target_lang_sense_clarification": "to look upon with pleasure, approval, or esteem"
                            },
                            {
                                "target_lang_word": "marvel",
                                "target_lang_sense_clarification": "to be filled with wonder or astonishment"
                            },
                            {
                                "target_lang_word": "be delighted",
                                "target_lang_sense_clarification": "to feel great pleasure or joy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0adc296a-79a9-39c1-aae3-9e1f6ac58144",
                    "sense_definition": "Уноситься вверх, <w>подниматься</w> ввысь.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "движение вверх",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старинных легендах души праведников могли <w>восхищаться</w> прямо на небеса.",
                            "target_lang_translations": {
                                "en": "In ancient legends, the souls of the righteous could <w>ascend</w> straight to heaven."
                            }
                        },
                        {
                            "text": "Птицы стремительно <w>восхищались</w> к облакам, исчезая из виду.",
                            "target_lang_translations": {
                                "en": "The birds rapidly <w>soared</w> towards the clouds, disappearing from sight."
                            }
                        }
                    ],
                    "synonyms": [
                        "подниматься"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To rise upwards, to ascend or be carried up into the heights."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ascend",
                                "target_lang_sense_clarification": "to rise or go up, especially in a spiritual or poetic sense"
                            },
                            {
                                "target_lang_word": "soar",
                                "target_lang_sense_clarification": "to fly or rise high in the air"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}