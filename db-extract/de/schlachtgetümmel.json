                    {
                        "sense_id": "02063d08-9519-3317-94de-eefeaec10cfe",
                        "entry_id": "53a9daf9-7395-3380-8f60-97bbb67c168a",
                        "glosses": [
                            "bewaffnete Soldaten in heftigem Kampf; heftiger Kampf bewaffneter Soldaten; Heftigkeit beim Kampf bewaffneter Soldaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd0d62a-db79-469c-9b6b-9e38193cc62d",
                                "sense_id": "02063d08-9519-3317-94de-eefeaec10cfe",
                                "text": "Bei zunehmendem Schlachtgetümmel wurde es schwerer, Freund und Feind zu unterscheiden."
                            },
                            {
                                "example_id": "55f82936-7f29-4bfa-a7bf-c0c0eec8a217",
                                "sense_id": "02063d08-9519-3317-94de-eefeaec10cfe",
                                "text": "„Muhammad, als äußeres Zeichen seiner Heiligkeit mit Flammennimbus und Gesichtsschleier dargestellt, lenkt und beobachtet die Auseinandersetzung – ein ruhiger Punkt am Rande des Schlachtgetümmels.“"
                            },
                            {
                                "example_id": "9b77025f-3d9a-4bbc-a03f-9c4b2b8b9841",
                                "sense_id": "02063d08-9519-3317-94de-eefeaec10cfe",
                                "text": "„Auch im Schlachtgetümmel wollen sie schön aussehen.“"
                            },
                            {
                                "example_id": "0c4345c6-018b-43f0-a22b-e36baf60e0db",
                                "sense_id": "02063d08-9519-3317-94de-eefeaec10cfe",
                                "text": "„Dieser pfeifende Ton erinnert Lampe an Schlachtgetümmel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
