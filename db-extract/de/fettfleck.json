                                "target_senses": [
                                    {
                                        "sense_id": "c28b5ddc-f128-3c1e-966b-fb4c38d3a342",
                                        "entry_id": "535ec095-0717-3756-a32f-0b82704ed949",
                                        "glosses": [
                                            "A minute remnant, humorously the only distinguishable remains of an antagonist after a fight."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63f04b44-3333-43c9-b815-5fc32ee68337",
                                                "sense_id": "c28b5ddc-f128-3c1e-966b-fb4c38d3a342",
                                                "text": "If you'd come at me with even numbers, I wouldn't leave a grease spot of you."
                                            },
                                            {
                                                "example_id": "c85b3855-017a-480b-a97a-002c661804c1",
                                                "sense_id": "c28b5ddc-f128-3c1e-966b-fb4c38d3a342",
                                                "text": "[W]hole Brigades of theirs were \"wiped out,\" there being hardly a grease spot left of the Kentucky Brigade, which were the ones I saw fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72996c73-dcf1-39c1-821b-16a2c2564d09",
                                        "entry_id": "535ec095-0717-3756-a32f-0b82704ed949",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see grease, spot."
                                        ],
