{
    "word_family": [
        "miserable",
        "miserably",
        "miserliness",
        "miserly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90618798-e711-3abe-871a-b38122a24d07",
                    "sense_definition": "A person who hoards money rather than spending it and is extremely unwilling to part with wealth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hoarding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>miser</w> lived in a tiny house and refused to buy even basic food.",
                            "target_lang_translations": {
                                "ru": "Старый <w>скряга</w> жил в крошечном доме и отказывался покупать даже самые простые продукты."
                            }
                        },
                        {
                            "text": "He was such a <w>miser</w> that he would never donate a single penny to charity.",
                            "target_lang_translations": {
                                "ru": "Он был таким <w>скупцом</w>, что никогда не жертвовал ни копейки на благотворительность."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheapskate",
                        "skinflint",
                        "tightwad",
                        "penny-pincher"
                    ],
                    "antonyms": [
                        "spendthrift"
                    ],
                    "common_phrases": [
                        "stingy miser"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который накопил деньги, вместо того чтобы тратить их, и крайне неохотно расстается с богатством."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скряга",
                                "target_lang_sense_clarification": "разговорное обозначение очень скупого человека"
                            },
                            {
                                "target_lang_word": "скупец",
                                "target_lang_sense_clarification": "нейтральное обозначение скупого человека"
                            },
                            {
                                "target_lang_word": "жмот",
                                "target_lang_sense_clarification": "разговорное, пренебрежительное обозначение жадного человека"
                            },
                            {
                                "target_lang_word": "крохобор",
                                "target_lang_sense_clarification": "пренебрежительное обозначение человека, который скупится на мелочах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fe9fbe5-d866-326e-a440-e65ccbd84f65",
                    "sense_definition": "A person who is wretched, miserable, or despicable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wretched",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lonely <w>miser</w> wandered the streets without hope or comfort.",
                            "target_lang_translations": {
                                "ru": "Одинокий <w>бедняга</w> бродил по улицам без надежды и утешения."
                            }
                        },
                        {
                            "text": "In the dark alley, the <w>miser</w> sat alone, forgotten by the world.",
                            "target_lang_translations": {
                                "ru": "В темном переулке <w>страдалец</w> сидел в одиночестве, забытый миром."
                            }
                        }
                    ],
                    "synonyms": [
                        "wretch"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic and reflects the etymological connection to misery."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который является несчастным, жалким или презренным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедняга",
                                "target_lang_sense_clarification": "человек, вызывающий сочувствие из-за своего несчастного положения"
                            },
                            {
                                "target_lang_word": "страдалец",
                                "target_lang_sense_clarification": "человек, который много страдает"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e32750-4847-395e-aa4a-abf1e8921556",
                    "sense_definition": "A large, hand-operated tool used for boring holes into the earth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers used a heavy <w>miser</w> to drill deep into the soil for the fence posts.",
                            "target_lang_translations": {
                                "ru": "Рабочие использовали тяжелый <w>бур</w>, чтобы пробурить глубокие отверстия в почве для столбов забора."
                            }
                        },
                        {
                            "text": "He struggled to turn the large <w>miser</w> as it cut through the hard clay.",
                            "target_lang_translations": {
                                "ru": "Он с трудом поворачивал большой <w>бур</w>, когда тот врезался в твердую глину."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой ручной инструмент, используемый для бурения отверстий в земле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бур",
                                "target_lang_sense_clarification": "инструмент для сверления или бурения отверстий"
                            },
                            {
                                "target_lang_word": "ручной бур",
                                "target_lang_sense_clarification": "инструмент для бурения, приводимый в действие вручную"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "efe323ce-9df2-3eb1-bc78-e6750abf6877",
                    "sense_definition": "A family name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Miser</w> is the new teacher at our school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Майзер</w> — новый учитель в нашей школе."
                            }
                        },
                        {
                            "text": "The <w>Miser</w> family has lived in this town for over a century.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Майзер</w> живет в этом городе уже больше века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Майзер",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}