                "senses": [
                    {
                        "sense_id": "233a52f8-0fe2-30e2-b644-b4fdfa9fd987",
                        "entry_id": "71f13623-6bf4-382e-bf58-873549bcedd1",
                        "glosses": [
                            "A harsh and throaty spoken sound"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab0bd99-139b-48c0-8565-75c149e4d0bf",
                                "sense_id": "233a52f8-0fe2-30e2-b644-b4fdfa9fd987",
                                "text": "He was hairy, and his speech of rough gutturals was imperfect."
                            },
                            {
                                "example_id": "f7079f55-e32f-4f7e-9e43-793f9c12716f",
                                "sense_id": "233a52f8-0fe2-30e2-b644-b4fdfa9fd987",
                                "text": "He seems quite an exception to some husbands in that respect!\" remarked the Berliner in deep gutturals."
                            },
                            {
                                "example_id": "ac6ba0f1-4fed-4ccd-b71e-878b162dabe6",
                                "sense_id": "233a52f8-0fe2-30e2-b644-b4fdfa9fd987",
                                "text": "\"Teeka is Tarzan's,\" said the ape-man, in the low gutturals of the great anthropoids."
                            }
                        ]
                    }
                ],
