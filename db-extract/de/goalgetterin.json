                "senses": [
                    {
                        "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                        "entry_id": "e6fe648e-63c4-335a-9918-cef1abae670e",
                        "glosses": [
                            "Spielerin, die besonders erfolgreich beim Erzielen von Toren ist"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7c595b96-7fb1-4c94-96f5-930701a112c8",
                                "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                                "text": "„‚Spaß wollen wir am Fußballspiel haben, nicht die Härte hervorkehren, aber doch Ehrgeiz entwickeln‘, definiert die neue Umgebung Sonja Moser, Goalgetterin von Leopoldskron.“"
                            },
                            {
                                "example_id": "045271bf-2311-4df9-a21d-13a58f1b28dc",
                                "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                                "text": "„Goalgetterin Steffi Komma fiel praktisch die ganze Saison mit einem Bänderriß aus, die finnische Verteidigerin Marjaana Tommola mußte aus beruflichen Gründen wieder in ihre Heimat und Nationalspielerin Natascha Schaffrik verließ kurz vor Ende der Hauptrunde entnervt die Lions in Richtung Meisterschaftsfinalisten TuS Wiehl, weil sie in Frankfurt keine Perspektive sah.“"
                            },
                            {
                                "example_id": "1e94cd7a-ed77-4903-8a2c-a1a8e4266682",
                                "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                                "text": "„Neben den Goalgetterinnen sind hervorzuheben: die Nachwuchs-Stürmerinnen Strauch und Gouverneur, die hervorragenden Abwehrspielerinnen Schulz-Linkholt und Zakkou sowie die beiden verläßlichen Torhüterinnen Böhm und Sander.“"
                            },
                            {
                                "example_id": "d6b07df4-1c29-465f-b0ba-dffebc8c9df8",
                                "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                                "text": "„Am Ende war sie mit drei Treffern die erfolgreichste Goalgetterin, gemeinsam mit Andrea Seul, die ebenfalls dreimal erfolgreich war.“"
                            },
                            {
                                "example_id": "bf720c1e-2b61-4ff9-b86f-df3c1fa46d18",
                                "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                                "text": "„Auch eine Manndeckung gegen ihre beiden Goalgetterinnen nutzte nichts mehr.“"
                            },
                            {
                                "example_id": "89d91acc-79df-4f14-bf1e-fe4cf5bff9c7",
                                "sense_id": "b0d969f3-4835-36da-8cc7-6b5cd87f8964",
                                "text": "„Damit hatte sich das Kirdorfer Team um seine beiden Goalgetterinnen Sonja Gomez Perez (sie traf am Samstag sieben Mal) und Rebecca Rüdelstein (sechs Mal) zugleich hessenweit in der Kalenderwoche 14 auf Platz eins der torreichsten Spiele geballert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
