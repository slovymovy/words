        "fr-extract.jsonl": [
            {
                "entry_id": "9d215466-451a-389f-8735-11a9d98da5da",
                "word": "prosaïque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e4d6fb1-a578-4286-b43d-88c38584e885",
                        "entry_id": "9d215466-451a-389f-8735-11a9d98da5da",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "prosaïques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e77a435c-9748-3ce8-a7f0-1323faf3d956",
                        "entry_id": "9d215466-451a-389f-8735-11a9d98da5da",
                        "glosses": [
                            "Qui tient de la prose, qui tient trop de la prose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8dba80c-450d-4b85-b80b-be281a4b5d04",
                                "sense_id": "e77a435c-9748-3ce8-a7f0-1323faf3d956",
                                "text": "Terme, expression, style prosaïque."
                            },
                            {
                                "example_id": "39f38c50-8fe4-4658-b63d-769cf0326792",
                                "sense_id": "e77a435c-9748-3ce8-a7f0-1323faf3d956",
                                "text": "Vers prosaïques."
                            }
                        ]
                    },
                    {
                        "sense_id": "4317c948-b170-316a-bbfb-6cd663d995a6",
                        "entry_id": "9d215466-451a-389f-8735-11a9d98da5da",
                        "glosses": [
                            "Qui manque d’élégance, de distinction."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "88245196-de50-4d6d-8d62-fbb2dc380906",
                                "sense_id": "4317c948-b170-316a-bbfb-6cd663d995a6",
                                "text": "Oui, plaisanterie à part, elle contient ce que je souhaitais, une expression de sentiments prosaïques aussi nécessaires à la famille que l’air au poumon."
                            },
                            {
                                "example_id": "5903e8a4-d27b-47ff-9df4-3318ddeb7550",
                                "sense_id": "4317c948-b170-316a-bbfb-6cd663d995a6",
                                "text": "La troisième est une ère prosaïque et pédantesque; à elle la dernière partie du Roman de la Rose, recueil de science aride, dans lequel il n’y a de remarquable que la satire, la satire toujours puissante contre une époque qui approche de sa fin."
                            },
                            {
                                "example_id": "49127855-ec9f-47da-8043-9d4bc18bafb1",
                                "sense_id": "4317c948-b170-316a-bbfb-6cd663d995a6",
                                "text": "Le sociographe s'interroge : « Quoi de neuf dans le domestique ? » Ah ! Quelqu'un s'intéresse au domestique ! Mais n'est-ce pas vraiment trop prosaïque, voire un tantinet vulgaire, le domestique ? Au fait, qu'est-ce que le domestique ?"
                            },
                            {
                                "example_id": "28daeadc-d7f8-45c8-9b93-0df96fb485f0",
                                "sense_id": "4317c948-b170-316a-bbfb-6cd663d995a6",
                                "text": "C’est probablement ce qui nous pousse, de temps en temps, à rouvrir une bédé ou un roman de cape et d’épée. Au cœur de notre imaginaire d’enfant se trouve le désir jamais complètement asséché de voir notre vie comme une aventure. Ou du moins, de ne pas la réduire à une série d’obligations prosaïques et de pesantes contraintes que l’on nomme poliment la vie quotidienne."
                            },
                            {
                                "example_id": "29516d96-3a58-42aa-b3cd-adcc6a6636cc",
                                "sense_id": "4317c948-b170-316a-bbfb-6cd663d995a6",
                                "text": "Ma plume n’a plus son ancienne légèreté, elle ne remplit plus si rapidement les feuilles légères. Mon esprit est obsédé de chimères plus froides, plus graves, plus prosaïques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1a1d484-c094-45f1-bb89-84774852b6c6",
                        "source_entry_id": "9d215466-451a-389f-8735-11a9d98da5da",
                        "target_lang_word": "prosaisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosaisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78225ab0-7e1e-3e12-ae28-c355fc4a93a5",
                                        "entry_id": "efe2d5bc-7497-3da6-a840-9578bcca18e8",
                                        "glosses": [
                                            "in Prosa verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0378d2cb-eaa4-4f89-b105-3d7f5967fa33",
                                                "sense_id": "78225ab0-7e1e-3e12-ae28-c355fc4a93a5",
                                                "text": "Abzählreime sind selten prosaisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e5e83ad1-5e4c-3898-8b88-a3bdce5a2634",
                                        "entry_id": "efe2d5bc-7497-3da6-a840-9578bcca18e8",
                                        "glosses": [
                                            "nüchtern, ohne Fantasie, ohne Poesie"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c8436d7-e505-445e-9589-0a3d048cbf40",
                                                "sense_id": "e5e83ad1-5e4c-3898-8b88-a3bdce5a2634",
                                                "text": "Hitchcock's prosaisches Bühnenbild in \"Rear Window\" wurde erst durch die Protagonisten belebt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "074f4875-0a2e-4e2e-9459-60ca0874e407",
                        "source_entry_id": "9d215466-451a-389f-8735-11a9d98da5da",
                        "target_lang_word": "prosaic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosaic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0cd5f1-cd68-3e2c-80e0-87cb3e4c14e6",
                                        "entry_id": "7c79c379-3d13-3209-8927-a0b83fec455e",
                                        "glosses": [
                                            "Pertaining to or having the characteristics of prose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0df8d60-5274-4163-a3ef-7642887e9c39",
                                                "sense_id": "ed0cd5f1-cd68-3e2c-80e0-87cb3e4c14e6",
                                                "text": "The tenor of Eliot's prosaic work differs greatly from that of his poetry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1309d57-7207-3499-8f82-3051f036fcbf",
                                        "entry_id": "7c79c379-3d13-3209-8927-a0b83fec455e",
                                        "glosses": [
                                            "Straightforward; matter-of-fact; lacking the feeling or elegance of poetry."
                                        ],
                                        "tags": [
                                            "of writing or speaking"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25745c2e-c3a8-424f-a9c5-6493a9d3bec2",
                                                "sense_id": "a1309d57-7207-3499-8f82-3051f036fcbf",
                                                "text": "I was simply making the prosaic point that we are running late."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                        "entry_id": "7c79c379-3d13-3209-8927-a0b83fec455e",
                                        "glosses": [
                                            "Overly plain, simple or commonplace, to the point of being boring."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d259c5c2-8b97-4d08-a211-480c3cae4247",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "His account of the incident was so prosaic that I nodded off while reading it."
                                            },
                                            {
                                                "example_id": "397def79-b6b3-4313-9983-1746f002b9cf",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "She lived a prosaic life."
                                            },
                                            {
                                                "example_id": "094d55b4-35c2-427e-aed6-73b02fd2008e",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "Our people are the most prosaic in the world, but the most faithful; and with curious reverence we keep up and transmit, from generation to generation, the superstition of what we call the education of a gentleman."
                                            },
                                            {
                                                "example_id": "61b3923a-5ee9-4d46-8817-84d58059100e",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "Their steepness and abruptness were even greater than I had imagined from hearsay, and suggested nothing in common with the prosaic objective world we know."
                                            },
                                            {
                                                "example_id": "ba5e928a-7258-43f8-b0a9-800d74ce790c",
                                                "sense_id": "83091879-9ca1-3171-8e57-d91153a2c674",
                                                "text": "Ultimately, though, the more prosaic goals carried the greater significance in this contest. Madrid have managed only one clean sheet on their way to winning this competition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
