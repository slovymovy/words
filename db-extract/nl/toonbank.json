                    {
                        "sense_id": "49f03fc8-2fef-3b86-a7fa-f647347d3256",
                        "entry_id": "c5e1df33-1c57-3af3-a3de-22fae8b27df1",
                        "glosses": [
                            "een winkeltafel waarop waren worden getoond en afgerekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5c6d6e-fc73-4d25-9c4d-f5cb8d92288f",
                                "sense_id": "49f03fc8-2fef-3b86-a7fa-f647347d3256",
                                "text": "De magnetische beveiligingsstrip werd op de toonbank verwijderd."
                            },
                            {
                                "example_id": "22f79d06-dce3-44d2-96b0-a7064d59a91f",
                                "sense_id": "49f03fc8-2fef-3b86-a7fa-f647347d3256",
                                "text": "De winkelbediende die naar ons toe kwam, was ook heel vriendelijk en leidde ons door het gedrang naar de toonbank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49b73cb6-c9ff-49ef-92f2-359af0d793d5",
                        "source_entry_id": "c5e1df33-1c57-3af3-a3de-22fae8b27df1",
                        "source_sense_id": "49f03fc8-2fef-3b86-a7fa-f647347d3256",
                        "source_sense_description": "een winkeltafel waarop waren worden getoond en afgerekend",
                        "target_lang_word": "Tresen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tresen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88b06b37-4172-3537-bd09-4519bf45d1c0",
                                        "entry_id": "233209ef-45dc-3ef6-98cc-a195feea2a17",
                                        "glosses": [
                                            "Verkaufstisch in einem Geschäft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec97e3aa-630c-408f-a9ce-ddc499a4b2cc",
                                                "sense_id": "88b06b37-4172-3537-bd09-4519bf45d1c0",
                                                "text": "„Vor dem Tresen in dem vollgestopften muffigen Laden stand eine Schlange.“"
                                            },
                                            {
                                                "example_id": "1515c2b4-a365-4686-bf5f-284daf4fe6af",
                                                "sense_id": "88b06b37-4172-3537-bd09-4519bf45d1c0",
                                                "text": "„Die Kassiererin am Tresen sagte mir, dass der samische Tanzabend abgesagt wurde, der dort am kommenden Wochenende stattfinden sollte.“"
                                            },
                                            {
                                                "example_id": "dab36ecc-d2d5-4c32-aa48-1fb510ec4cf3",
                                                "sense_id": "88b06b37-4172-3537-bd09-4519bf45d1c0",
                                                "text": "„Mir fiel dort an dem Tresen ein, daß ich nicht wußte, wie die Mädchen hießen.“"
                                            },
                                            {
                                                "example_id": "aba68238-0603-45e8-a925-7c28b39abe89",
                                                "sense_id": "88b06b37-4172-3537-bd09-4519bf45d1c0",
                                                "text": "„Die zwei Männer am Tresen lasen die Speisekarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3304e524-fd94-36f7-b01c-b0d41f465dea",
                                        "entry_id": "233209ef-45dc-3ef6-98cc-a195feea2a17",
                                        "glosses": [
                                            "Serviertisch in einer Gaststätte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5caeb348-b740-462e-9c68-8baceeb78bf5",
                                                "sense_id": "3304e524-fd94-36f7-b01c-b0d41f465dea",
                                                "text": "„In der Gaststube saßen bereits einige Gäste. Wolter stand hinter dem Tresen und lächelte sie an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b394578-60f5-4848-849f-fe82332b64ba",
                        "source_entry_id": "c5e1df33-1c57-3af3-a3de-22fae8b27df1",
