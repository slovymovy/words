{
    "word_family": [
        "borduren",
        "borduursel",
        "voortgang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ca0fcf8-d476-34fd-9e37-4d4aed97653a",
                    "sense_definition": "doorgaan met het ontwikkelen of uitwerken van iets waarmee al een begin is gemaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Verscheidene wetenschappers hebben <w>voortgeborduurd</w> op zijn ideeën.",
                            "target_lang_translations": {
                                "en": "Several scientists have <w>built on</w> his ideas."
                            }
                        },
                        {
                            "text": "De sprekers <w>borduurden</w> <w>voort</w> op het thema van de dag.",
                            "target_lang_translations": {
                                "en": "The speakers <w>elaborated</w> on the theme of the day."
                            }
                        }
                    ],
                    "synonyms": [
                        "voortbouwen",
                        "uitwerken",
                        "verdergaan"
                    ],
                    "common_phrases": [
                        "voortborduren op een idee",
                        "voortborduren op het thema"
                    ],
                    "target_lang_definitions": {
                        "en": "To continue developing or elaborating on something that has already been started"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "build on",
                                "target_lang_sense_clarification": "to use something as a basis for further development"
                            },
                            {
                                "target_lang_word": "elaborate on",
                                "target_lang_sense_clarification": "to add more detail to an existing idea"
                            },
                            {
                                "target_lang_word": "expand on",
                                "target_lang_sense_clarification": "to further develop a concept or theme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b0491e4-6c66-30f2-a4e3-b1485297251e",
                    "sense_definition": "verdergaan met het maken van een borduurwerk",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "handwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een korte pauze pakte ze de naald op om <w>voort</w> te <w>borduren</w> aan het patroon.",
                            "target_lang_translations": {
                                "en": "After a short break, she picked up the needle to <w>continue embroidering</w> the pattern."
                            }
                        },
                        {
                            "text": "Zij <w>borduurde</w> rustig <w>voort</w> aan de bloemen op het tafelkleed.",
                            "target_lang_translations": {
                                "en": "She quietly <w>continued embroidering</w> the flowers on the tablecloth."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To continue embroidering"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "continue embroidering",
                                "target_lang_sense_clarification": "to carry on with needlework"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}