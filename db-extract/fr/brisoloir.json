                        "glosses": [
                            "Poêle à marrons."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "59794d75-0d0a-4f07-ac45-f4dc9884ce2b",
                                "sense_id": "cde3e844-235b-3275-8123-9d78cc99b9bb",
                                "text": "Le brisoloir est l’ustensile dont on se sert pour rôtir les châtaignes, qu’il s’agisse d’une poêle en fonte, d’un cylindre ou de tout autre appareil."
                            },
                            {
                                "example_id": "972ba0d8-555c-43d4-a2cf-52c4b7546b85",
                                "sense_id": "cde3e844-235b-3275-8123-9d78cc99b9bb",
                                "text": "Les flammes doivent lécher le brisoloir, juste assez pour rôtir l’enveloppe des châtaignes, mais sans les carboniser."
                            }
                        ]
                    }
                ],
