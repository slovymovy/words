                            {
                                "target_word": "Jürgen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                        "entry_id": "7e0e1647-fd12-337f-930b-27dfabef9939",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a17246a-ed30-46cb-8998-cfd7c3ad9ae1",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Frau Jürgen ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9e72d1d2-f9d3-497d-bb7d-83d68b6cde62",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Herr Jürgen wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "e5f9ef28-bdd6-45b1-806d-ed194686c560",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Die Jürgens fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "47697265-1ae8-4309-8a01-a8f31ce22e3f",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Der Jürgen trägt nie die Schals, die die Jürgen ihm strickt."
                                            },
                                            {
                                                "example_id": "75aad5b3-a1ff-41e4-b9e7-20bccb6c4562",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jürgen kommt, geht der Herr Jürgen.“"
                                            },
                                            {
                                                "example_id": "b9bcec15-f3df-45a2-a039-d4112110f0fc",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Jürgen kommt und geht."
                                            },
                                            {
                                                "example_id": "ff6c3999-b391-4f49-8e3d-3396d562ef66",
                                                "sense_id": "97361058-4d1a-3f54-bb3a-c7242dfbecd6",
                                                "text": "Jürgens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
