                "senses": [
                    {
                        "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                        "entry_id": "c927b68e-7d2f-3eff-b447-50306d1e4251",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27766b1b-5177-4418-9308-61f07c04fbe3",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Frau Wörnle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "acb81752-ec51-49f2-825b-93e7c69c8379",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Herr Wörnle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f0081c7e-2638-4cb5-9eff-62fa6cb2f8b0",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Die Wörnles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4ad98d74-c41d-4dcf-8549-e517686f5dbb",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Der Wörnle trägt nie die Pullover, die die Wörnle ihm strickt."
                            },
                            {
                                "example_id": "b6b1db26-c29d-41cb-8182-68e46a819655",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wörnle kommt, geht der Herr Wörnle.“"
                            },
                            {
                                "example_id": "24e0d71e-0996-4032-8f68-a164da95e239",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Wörnle kommt und geht."
                            },
                            {
                                "example_id": "1324b566-5fd4-4eca-b91d-bb7c188f1a16",
                                "sense_id": "16983305-af60-3be8-b47c-ed7580c56af4",
                                "text": "Wörnles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
