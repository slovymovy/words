                                    {
                                        "sense_id": "8dd05b1c-e80a-3929-b1a4-fa8ed010b29b",
                                        "entry_id": "486849a0-c071-321d-8a06-5aac45b05308",
                                        "glosses": [
                                            "Rama marginal del islam, con fuerte énfasis en el misticismo y el ascetismo."
                                        ],
