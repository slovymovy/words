                    {
                        "translation_id": "f467365b-dc1c-493a-b9a4-b88e540321a4",
                        "source_entry_id": "736877d2-adcc-37a8-aba2-0963e64e1d08",
                        "source_sense_description": "een smaak- en geurstof geëxtraheerd van de vanilleplant",
                        "target_lang_word": "vanille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
