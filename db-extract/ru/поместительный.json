                "senses": [
                    {
                        "sense_id": "8396635d-dc7b-33c4-9694-c47f60696bc1",
                        "entry_id": "56a17069-5ed7-364a-a9c9-ed87d628d00f",
                        "glosses": [
                            "capacious"
                        ],
