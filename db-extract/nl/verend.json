        "nl-extract.jsonl": [
            {
                "entry_id": "415f9e57-3ea0-3bad-9090-29eb1c1a1a08",
                "word": "verend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                        "entry_id": "415f9e57-3ea0-3bad-9090-29eb1c1a1a08",
                        "glosses": [
                            "schokken opvangend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b0dab9-9e50-4b1d-85b3-6001ec3b922b",
                                "sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                                "text": "Het zoutwaterbad in Boekelo had een landelijke primeur wat betreft de parabolische springplank met een enorm verend vermogen."
                            },
                            {
                                "example_id": "68b2a970-93ed-4275-b4fd-713602dabed3",
                                "sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                                "text": "Overigens geloven steeds meer bewegingswetenschappers dat het zinvoller is zogenaamd dynamisch te strekken. Dat vindt ook trainer Schoots, die het 'verend rekken' noemt. Hiermee gooi je je been bijvoorbeeld een aantal keer 'een klein stukje' in de lucht, in plaats van dertig seconden met je hoofd tussen je benen naar beneden te hangen. 'Alleen dat heeft echt zin', aldus Schoots."
                            },
                            {
                                "example_id": "4859cec7-0fc8-4ad8-ba32-e51dda201860",
                                "sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                                "text": "'Een reuze gezellig kamertje van twee bij drieëneenhalve meter met een prachtig verend bed, wastafel, stoel en dakraam zonder gordijnen, dat dag en nacht openstaat'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80188391-88f3-4039-a6d7-9a0813cfa8d4",
                        "source_entry_id": "415f9e57-3ea0-3bad-9090-29eb1c1a1a08",
                        "source_sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                        "target_lang_word": "spring-loaded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spring-loaded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d24e54a-8889-30ae-ae12-e04246ef7c3c",
                                        "entry_id": "7592d962-4696-3235-89dc-42c69ff4d13c",
                                        "glosses": [
                                            "Of a mechanical device, containing a spring that holds a component in a particular position."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfe49256-8902-4947-b7d6-5fb722e1d267",
                                                "sense_id": "1d24e54a-8889-30ae-ae12-e04246ef7c3c",
                                                "text": "Near-synonym: sprung"
                                            },
                                            {
                                                "example_id": "529b646e-611b-458f-855a-83f1ecc5832c",
                                                "sense_id": "1d24e54a-8889-30ae-ae12-e04246ef7c3c",
                                                "text": "A spring-loaded reducing valve, controllable from the cab, admitted h.p. steam to both h.p. and l.p. cylinders whenever necessary, as, for example, on starting; [...]."
                                            },
                                            {
                                                "example_id": "7832e33c-2987-4beb-aba7-b2289daf12c0",
                                                "sense_id": "1d24e54a-8889-30ae-ae12-e04246ef7c3c",
                                                "text": "These spring-loaded seats are a bit harder and very snappy when you get off them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spring-loaded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad01ceb8-0ede-32eb-8b2a-bb2bf8bd1e00",
                                        "entry_id": "8f15ecb2-d49e-3934-8012-9f73fd637264",
                                        "glosses": [
                                            "simple past and past participle of spring-load"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56988853-2c3c-47f6-bdad-7499bce295dc",
                        "source_entry_id": "415f9e57-3ea0-3bad-9090-29eb1c1a1a08",
                        "source_sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                        "target_lang_word": "springy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "springy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "697bfd28-bd9b-361f-b474-e302c79d6f2c",
                                        "entry_id": "0ffc57b9-cbea-3c77-ad87-998346d78c6f",
                                        "glosses": [
                                            "That returns rapidly to its original form (as a spring does) after being bent, compressed, stretched, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22294e9c-b5ef-49c8-a7e4-9c70cf23d722",
                                                "sense_id": "697bfd28-bd9b-361f-b474-e302c79d6f2c",
                                                "text": "The soft peat was springy under her feet."
                                            },
                                            {
                                                "example_id": "ee6d7c02-a1b4-4ce9-9a7f-055c0be962fa",
                                                "sense_id": "697bfd28-bd9b-361f-b474-e302c79d6f2c",
                                                "text": "The hard woods were used for pegging, the soft woods for cradling the load and the springy woods for carrying it."
                                            },
                                            {
                                                "example_id": "a2843606-0d66-42e3-8daf-4b2aafb472a9",
                                                "sense_id": "697bfd28-bd9b-361f-b474-e302c79d6f2c",
                                                "text": "What returning director Genndy Tartakovsky reveres is animation—and not necessarily the wonders of photorealistic follicle creation or impeccably rendered water, but the kind of gloriously exaggerated movement, the stretchy and springy caricature, that enlivens many classic cartoons."
                                            },
                                            {
                                                "example_id": "c4fa19b5-c768-4a5d-9a75-82dcdc1d775d",
                                                "sense_id": "697bfd28-bd9b-361f-b474-e302c79d6f2c",
                                                "text": "We had now reach'd the closest point of union; but when he backened to come on the fiercer, as if I had been actuated by a fear of losing him, in the height of my fury I twisted my legs round his naked loins, the flesh of which, so firm, so springy to the touch, quiver'd again under the pressure",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56fdf676-f5dc-3925-a277-7ff4d22e5e79",
                                        "entry_id": "0ffc57b9-cbea-3c77-ad87-998346d78c6f",
                                        "glosses": [
                                            "Lively; bouncy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aacb4d6b-6f4e-4f8b-9ba5-1755163df9a0",
                                                "sense_id": "56fdf676-f5dc-3925-a277-7ff4d22e5e79",
                                                "text": "Shangrila and Linda is an outstandingly uneven book -- sometimes it's fun and springy, and other times it's irritating and boring."
                                            },
                                            {
                                                "example_id": "da8dd894-55bc-494c-9c39-6f8b87c4c834",
                                                "sense_id": "56fdf676-f5dc-3925-a277-7ff4d22e5e79",
                                                "text": "Every step—a light click of the heel and then a springy step, optimistic, perhaps a bit contemptuous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3651c983-71e7-3b16-84cd-0a8c8eef0acf",
                                        "entry_id": "0ffc57b9-cbea-3c77-ad87-998346d78c6f",
                                        "glosses": [
                                            "Characteristic of the spring season."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "882988d5-e8d5-453b-bcc4-4027b0f55f5d",
                                                "sense_id": "3651c983-71e7-3b16-84cd-0a8c8eef0acf",
                                                "text": "It was springy weather after Easter, and she wore a pale lavender silk dress with myriad little ruchings down the front, each edged with a narrow band of real lace."
                                            },
                                            {
                                                "example_id": "cf14469a-3b1b-419a-bb27-963d646e73f5",
                                                "sense_id": "3651c983-71e7-3b16-84cd-0a8c8eef0acf",
                                                "text": "We had a blizzard, a thaw, a spell of springy weather, and James baked me a heart-shaped white clam pizza for Valentine's Day."
                                            },
                                            {
                                                "example_id": "69f2bcbb-ac26-43e9-8a23-087b24b7ffbc",
                                                "sense_id": "3651c983-71e7-3b16-84cd-0a8c8eef0acf",
                                                "text": "After our few brief days of springy weather it surely is a sudden change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4bc2d8b-dc6a-362a-8703-2b7160c0f2cf",
                                        "entry_id": "0ffc57b9-cbea-3c77-ad87-998346d78c6f",
                                        "glosses": [
                                            "Of land, having many springs (of water)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "801e3deb-a7f4-49b7-b6b7-abc17abce409",
                        "source_entry_id": "415f9e57-3ea0-3bad-9090-29eb1c1a1a08",
                        "source_sense_id": "54d2b106-658b-3159-adb5-780c632b41c7",
                        "target_lang_word": "elastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "172451d7-a1e1-3567-b2df-60b79c626d3b",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Capable of stretching; particularly, capable of stretching so as to return to an original shape or size when force is released."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1406fa-50ff-422c-9058-1ffa9c0ee403",
                                                "sense_id": "172451d7-a1e1-3567-b2df-60b79c626d3b",
                                                "text": "The rope is somewhat elastic, so expect it to give when you pull on it."
                                            },
                                            {
                                                "example_id": "f7c234d3-ce96-4ef6-9627-a8d4634c8d58",
                                                "sense_id": "172451d7-a1e1-3567-b2df-60b79c626d3b",
                                                "text": "In trumpets for assisting the hearing, all reverbation of the trumpet must be avoided. It must be made thick, of the least elastic materials, and covered with cloth externally. For all reverbation lasts for a short time, and produces new sounds which mix with those which are coming in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08fd370f-c567-30dc-a98a-4e7acd7e90e6",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Made of elastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3e1d95d-7157-4816-a376-70fbe9580bbb",
                                                "sense_id": "08fd370f-c567-30dc-a98a-4e7acd7e90e6",
                                                "text": "elastic band"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcd2fbc-d150-302c-8a56-6f611fddaa0c",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Of clothing, elasticated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b2bdfc7-1a3e-3a30-9c32-2b48aaf64aec",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Sensitive to changes in price."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96e495d-3b51-4eb6-8e74-48f17fd781bb",
                                                "sense_id": "5b2bdfc7-1a3e-3a30-9c32-2b48aaf64aec",
                                                "text": "Demand for entertainment is more elastic than demand for energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bbf026d-5e36-3da0-a899-c58bc30eef24",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "springy; bouncy; vivacious"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8ef226c-7d43-4c98-adf8-32fc0ee471d2",
                                                "sense_id": "9bbf026d-5e36-3da0-a899-c58bc30eef24",
                                                "text": "He could see that she was tastefully, though not richly, dressed, and that she walked with an elastic step that revealed a light heart and the vigor of perfect health. Her face, of course, he could not analyze, since he had caught only the one brief but convincing glimpse of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e6ba166-c67f-3372-9877-45150cc5d684",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Pervasive, all-encompassing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb565acc-4d74-4da1-9911-354d8f5039f9",
                                                "sense_id": "7e6ba166-c67f-3372-9877-45150cc5d684",
                                                "text": "It was now about six o'clock, and that first freshness was on the air, which is to the day what youth is to life,—so light, so elastic, so sweet, and so brief:..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c786381b-391a-3590-9663-49c55f28edf1",
                                        "entry_id": "52d45ad3-2d1a-3950-aa1f-1874b10ee7d0",
                                        "glosses": [
                                            "Able to return quickly to a former state or condition, after being depressed or overtaxed; having power to recover easily from shocks and trials."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41175099-53b6-4cf1-a118-26427adcb073",
                                                "sense_id": "c786381b-391a-3590-9663-49c55f28edf1",
                                                "text": "elastic spirits; an elastic constitution"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d4a0ac-a484-3f54-9ac6-ba778c72dc95",
