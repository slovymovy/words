                    {
                        "sense_id": "368d8e42-9f85-34bd-bbb4-57dbef2d68dd",
                        "entry_id": "8dc1ea24-5e6b-3dd6-b561-22babe4bdf67",
                        "glosses": [
                            "Instrument à cordes frottées (le plus souvent un violon) fabriqué par Antonio Stradivari (ou un membre de sa famille)."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "23099463-a973-414c-a048-2cb577c2e6ef",
                                "sense_id": "368d8e42-9f85-34bd-bbb4-57dbef2d68dd",
                                "text": "Entre-temps, le stradivarius s'est imposé comme une référence."
                            },
                            {
                                "example_id": "70a885c1-9d77-4b68-9ff4-22dc8df04568",
                                "sense_id": "368d8e42-9f85-34bd-bbb4-57dbef2d68dd",
                                "text": "Depuis septembre 2021, Anastasia Kobekina joue avec un stradivarius prêté par une fondation suisse, Habisreutinger, sise à Saint-Gall. Un violoncelle de 1698, le « De Kermadec Bläss », à qui son propriétaire a donné le nom de son chien préféré, un bouvier d’Appenzell russel terrier."
                            }
                        ]
                    },
                    {
                        "sense_id": "6124c685-0855-333f-9418-8638ac0cb2e7",
                        "entry_id": "8dc1ea24-5e6b-3dd6-b561-22babe4bdf67",
                        "glosses": [
                            "Symbole de l'excellence."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f51b1089-5141-44b0-a22f-8c0646db0f48",
                                "sense_id": "6124c685-0855-333f-9418-8638ac0cb2e7",
                                "text": "Ce verre ovoïde en cristal est le stradivarius de la dégustation."
                            }
                        ]
