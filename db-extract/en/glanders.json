                    },
                    {
                        "translation_id": "21adeecd-cf28-4639-b795-1f996ea48ef6",
                        "source_entry_id": "e11826b9-844a-3eba-bc6e-818e2e2bf2f7",
                        "source_sense_id": "c4a693a0-9d0d-3df3-99c9-9139f3718dff",
                        "source_sense_description": "disease",
                        "target_lang_word": "Rotz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rotz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                        "entry_id": "7d02b3db-5e43-31cc-9f67-0f0a1a0703e6",
                                        "glosses": [
                                            "schleimartiges Nasensekret"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbb4cb78-7d2e-49c2-a43f-e57bd6923a0d",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "Er putzte sich den Rotz mit einem Taschentuch von der Nase."
                                            },
                                            {
                                                "example_id": "5266e225-3c2c-44b6-929f-e4ada502f8e9",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "Ich war dermaßen erkältet, ich hatte hohes Fieber und der Rotz lief in Strömen."
                                            },
                                            {
                                                "example_id": "f1c858dd-45fa-41de-8c77-8a2d85af1dd0",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Da kommen üble Trollweiber vor, die rülpsen und furzen und ewig unbändigen Hunger haben auf Menschenfleisch. Oder Riesen, denen der Rotz nur so aus der Nase trieft.“"
                                            },
                                            {
                                                "example_id": "00b91bc5-616d-4638-b2fe-48a0cf0d13ca",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Das Taschentuch, vor dem er sich ekelte, hatte er weggeworfen, der verletzte Finger brannte, und die Nase lief so heftig, daß er angewidert dazu überging, den Rotz mit der bloßen Hand herauszuschneuzen.“"
                                            },
                                            {
                                                "example_id": "63176395-ea88-4da9-a59d-e554e9fd17be",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Aus der Nase lief ihm ständig der Rotz, uns so löste seine gesamte Erscheinung bei den anderen Kindern Ekel und Furcht aus.“"
                                            },
                                            {
                                                "example_id": "8154b5b9-5008-49ac-a656-883f00262b97",
                                                "sense_id": "92f7b0db-cee4-35df-8f56-0dc961de073d",
                                                "text": "„Auch zieht er gern den Rotz durch die Nase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                        "entry_id": "7d02b3db-5e43-31cc-9f67-0f0a1a0703e6",
                                        "glosses": [
                                            "bakterielle Infektion bei Unpaarhufern, vor allem bei Pferden"
                                        ],
                                        "tags": [
                                            "Veterinärmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "553d9ed9-b789-442e-810c-46f8df295339",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Rotz kann auf den Menschen übergehen und dann auch tödlich sein."
                                            },
                                            {
                                                "example_id": "823540cf-7ecf-42b6-b638-b24ad0145a3f",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Mein Pferd hatte Rotz, deshalb mussten wir es einschläfern lassen."
                                            },
                                            {
                                                "example_id": "8287da68-aa57-46de-95bd-ef623d505d17",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Der Rotz ist hochgefährlich und kann auch auf den Menschen übergehen."
                                            },
                                            {
                                                "example_id": "bdbd4d4a-7eed-451a-a430-e22b271232ed",
                                                "sense_id": "194742e2-aa5b-3aa1-ab12-d443e36ced0d",
                                                "text": "Die Behandlung von an Rotz erkrankten Tieren ist aussichtslos und verboten. Sie werden sofort getötet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9e2c10b4-d15f-37cb-a02c-68900e1f9dcb",
                                        "entry_id": "7d02b3db-5e43-31cc-9f67-0f0a1a0703e6",
                                        "glosses": [
                                            "Zeug, unleidige Sache"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3f528d0-1857-4d3e-923e-67881b0fb696",
                                                "sense_id": "9e2c10b4-d15f-37cb-a02c-68900e1f9dcb",
                                                "text": "Als es beim dritten Mal wieder nicht funktioniert hat, habe ich den ganzen Rotz einfach in die Tonne gehauen."
                                            },
                                            {
                                                "example_id": "0ba56da6-9a3f-498b-acfd-18adff1558cb",
                                                "sense_id": "9e2c10b4-d15f-37cb-a02c-68900e1f9dcb",
                                                "text": "Was ist denn das für ein Rotz?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
