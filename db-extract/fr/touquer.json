                        "glosses": [
                            "Tremper (par exemple tremper son pain)."
                        ],
                        "tags": [
                            "Nord de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "ce4830cc-5b51-462f-9c5b-ae98ccf42d13",
                                "sense_id": "2ec8678f-066f-364b-8a52-de728e0316bf",
                                "text": "Après avoir « touqué » son assiette avec une dernière croûte, il rota grossièrement."
                            },
                            {
                                "example_id": "230b87ce-89b1-4117-b804-6b321546054a",
                                "sense_id": "2ec8678f-066f-364b-8a52-de728e0316bf",
                                "text": "Aux offrandes des messes d’enterrement, les seules qu’elle entendit, elle portait ses plus méchants liards, ou même elle « touquait » dans le plat sans y rien mettre ;"
                            }
                        ]
                    }
