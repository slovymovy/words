                "senses": [
                    {
                        "sense_id": "35d97bbe-ccd9-3e2b-bd50-d690a1a53a22",
                        "entry_id": "82a5e209-7e4b-3560-85bf-bd201b130a8c",
                        "glosses": [
                            "Qui est compatible avec les tissus vivants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f89c51f-ebb3-4ad3-a5ef-747c806dca9f",
                                "sense_id": "35d97bbe-ccd9-3e2b-bd50-d690a1a53a22",
                                "text": "Reste à vérifier de nombreux points, qui vont de la facilité de réalisation par un procédé industriel jusqu'à la biocompatibilité en passant par la longévité."
                            },
                            {
                                "example_id": "21770d4e-7f7c-4369-bbd5-9ae1af576cd3",
                                "sense_id": "35d97bbe-ccd9-3e2b-bd50-d690a1a53a22",
                                "text": "Surtout, ce marquage ne pose aucun problème de santé et la biocompatibilité a été vérifiée avec un grand nombre de types cellulaires, des cellules tumorales aux cellules souches en passant par les lymphocytes."
                            },
                            {
                                "example_id": "093941f8-a98d-4bab-8460-311cfd614876",
                                "sense_id": "35d97bbe-ccd9-3e2b-bd50-d690a1a53a22",
                                "text": "Pour vérifier la biocompatibilité et la viabilité de leur structure, les auteurs ont implanté les oreilles artificielles sur le dos de rats."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
