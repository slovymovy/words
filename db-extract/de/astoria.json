                    {
                        "translation_id": "8f038938-6f68-4636-84e6-48965fb4d638",
                        "source_entry_id": "eb08e7a1-1987-31ec-b46f-66a42ccfd8a8",
                        "source_sense_id": "10140607-803d-319b-b51f-6c5c79811086",
