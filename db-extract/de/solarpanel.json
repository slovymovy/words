                "senses": [
                    {
                        "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                        "entry_id": "9e5d859b-c063-3ea1-ba56-3e803cbb10d6",
                        "glosses": [
                            "Bauteil, das das Licht der Sonne in elektrische Energie umwandelt; Zusammenschluss von Solarzellen zu einer größeren Einheit"
                        ],
                        "tags": [
                            "Energie"
                        ],
                        "examples": [
                            {
                                "example_id": "60493c61-02c3-49ac-ba28-a66e825427d7",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "Solarpanels mit Wechselrichter sind ziemlich teuer."
                            },
                            {
                                "example_id": "1e859184-ff74-4366-8e6a-c13be13dd7bc",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„Solarpanels werden aber noch selten eingesetzt.“"
                            },
                            {
                                "example_id": "84960739-7d10-476c-bcd5-59f62f0cb1ae",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "[Schlagzeile:] „Photovoltaik: Schweiz will Autobahnen mit Solarpanels überdachen“"
                            },
                            {
                                "example_id": "cadff1da-2e60-42f7-9f0d-c2c9470c9a8d",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„80 Prozent des Rohstoffs Polysilizium, das in den Solarpanels steckt, stammt aus China.“"
                            },
                            {
                                "example_id": "7705645c-e14b-4369-8fb5-d3f38bfd7ae4",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„Solarpanels auf Dächern sollen für neu gebaute gewerbliche und öffentliche Gebäude schon bis 2025 verpflichtend werden.“"
                            },
                            {
                                "example_id": "f3eb1f79-7275-4f7f-a705-3cbc3f3cadf7",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„Über Solarpanels auf dem Dach wird die Energie gewonnen, um das Eishotel auch im Sommer auf minus fünf Grad Celsius zu kühlen.“"
                            },
                            {
                                "example_id": "c839d916-ba76-41ed-ae1f-76a09d5386b2",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "[Manganknollen aus der Tiefsee:] „Sie könnten wertvolle Metalle liefern, um Batterien, E-Autos oder Solarpanele zu bestücken.“"
                            },
                            {
                                "example_id": "322e8814-a3a0-4d16-941a-86a2ea35e3aa",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„Ein mit dem Solarpanel verbundener Wechselrichter speist den Strom direkt ins Hausnetz ein – meist über einen Schutzkontaktstecker an einer beliebigen Steckdose.“"
                            },
                            {
                                "example_id": "bd513fd5-4e9e-47b7-8fdc-0195ee83d26f",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "[…] „Nach Möglichkeit sollte der Akku über ein Solarpanel (etwa dem eines Wohnmobils) aufgeladen werden können.“"
                            },
                            {
                                "example_id": "462a6955-6461-457c-8c90-f33cf7a0a575",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„Er hat 2,25 Tonnen CO₂ eingespart. Für ihn ist diese Lösung sehr kostspielig, da er nicht nur das Solarpanel, sondern auch das E-Auto beschaffen muss.“"
                            },
                            {
                                "example_id": "c2ccc403-a2fa-490c-9542-c25c7c52e1fe",
                                "sense_id": "bdf51c82-e1f6-3e37-8943-7e328e096b79",
                                "text": "„An entlegene Haushalte liefern wir dann eher Solarpanels oder auch nur eine Solarlampe in den Busch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
