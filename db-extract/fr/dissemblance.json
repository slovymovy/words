                            {
                                "example_id": "6c9c2cf0-0d54-45ae-a3a6-97c738525ddf",
                                "sense_id": "f9bebfa6-fc6e-38fa-80d6-294bf45f61e6",
                                "text": "En pareil cas, la dissemblance des destinées est presque toujours un puissant lien d'amitié."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c385898-be0d-49c0-b299-5d314dce9e58",
                        "source_entry_id": "8c35feec-bfa7-3a6b-83d3-26cd4b83bc59",
