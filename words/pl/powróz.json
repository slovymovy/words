                    "sense_id": "5540054e-07d2-3fd9-8d7b-ba76c26c6e31",
                    "sense_definition": "gruby, mocny sznur spleciony z włókien roślinnych lub syntetycznych",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żeglarz użył grubego <w>powrozu</w>, aby bezpiecznie przywiązać łódź do drewnianego pomostu.",
                            "target_lang_translations": {
                                "en": "The sailor used a thick <w>rope</w> to securely tie the boat to the wooden jetty."
                            }
                        },
                        {
                            "text": "W starym warsztacie leżały mocne <w>powrozy</w> splecione z konopi.",
                            "target_lang_translations": {
                                "en": "In the old workshop lay strong <w>ropes</w> woven from hemp."
                            }
                        }
                    ],
                    "synonyms": [
                        "sznur",
                        "postronek"
                    ],
                    "common_phrases": [
                        "gruby powróz",
                        "związać powrozem"
                    ],
                    "target_lang_definitions": {
                        "en": "a thick, strong line woven from plant or synthetic fibers"
                    },
                    "translations": {
