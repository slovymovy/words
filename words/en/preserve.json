{
    "word_family": [
        "preservation",
        "preservative",
        "preserver",
        "preservable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27095be2-a594-3c88-a346-252d2cceef5c",
                    "sense_definition": "To keep something safe from harm, injury, or destruction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "protect_maintain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must do everything we can to <w>preserve</w> the environment.",
                            "target_lang_translations": {
                                "ru": "Мы должны сделать всё возможное, чтобы <w>сохранить</w> окружающую среду.",
                                "zh": "我们必须尽一切努力<w>保护</w>环境。"
                            }
                        },
                        {
                            "text": "The museum works to <w>preserve</w> local history for future generations.",
                            "target_lang_translations": {
                                "ru": "Музей работает над тем, чтобы <w>сохранить</w> местную историю для будущих поколений.",
                                "zh": "博物馆致力于为后代<w>保存</w>当地历史。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conserve",
                        "protect",
                        "save"
                    ],
                    "antonyms": [
                        "destroy",
                        "ruin"
                    ],
                    "common_phrases": [
                        "preserve peace",
                        "preserve life",
                        "preserve the environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уберегать что-либо от вреда, порчи или разрушения; обеспечивать безопасность.",
                        "zh": "使某物免受伤害、损害或破坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "не давать исчезнуть или разрушиться"
                            },
                            {
                                "target_lang_word": "беречь",
                                "target_lang_sense_clarification": "относиться с заботой, не давать в обиду"
                            },
                            {
                                "target_lang_word": "охранять",
                                "target_lang_sense_clarification": "стеречь, защищать от нападения или вреда"
                            },
                            {
                                "target_lang_word": "защищать",
                                "target_lang_sense_clarification": "ограждать от опасности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保护",
                                "target_lang_sense_clarification": "维护某物使其不受伤害"
                            },
                            {
                                "target_lang_word": "保存",
                                "target_lang_sense_clarification": "使事物保持原样不被破坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6a1eb3c-6a19-35de-9fa1-e0d6fd3b5cf4",
                    "sense_definition": "To make a condition, situation, or quality continue without changing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "protect_maintain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>preserve</w> his dignity despite the embarrassing situation.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>сохранить</w> достоинство, несмотря на неловкую ситуацию.",
                                "zh": "尽管处境尴尬，他仍试图<w>保持</w>尊严。"
                            }
                        },
                        {
                            "text": "Please <w>preserve</w> silence while inside the library.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>соблюдайте</w> тишину, находясь в библиотеке.",
                                "zh": "在图书馆内请<w>保持</w>安静。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "preserve order",
                        "preserve the status quo",
                        "preserve appearances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать состояние, ситуацию или качество неизменными.",
                        "zh": "使某种状态、情况或品质持续存在而不改变。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "оставлять в силе, удерживать состояние"
                            },
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "придерживаться правил или порядка (напр. тишину)"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "не давать прекратиться или измениться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保持",
                                "target_lang_sense_clarification": "维持某种状态或品质"
                            },
                            {
                                "target_lang_word": "维持",
                                "target_lang_sense_clarification": "使某种情况继续存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a103d5a5-d8cf-3266-b0d3-aff6ea43b944",
                    "sense_definition": "To treat food with substances like salt or sugar to prevent it from decaying.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_prep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother likes to <w>preserve</w> peaches in the summer.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка любит <w>консервировать</w> персики летом.",
                                "zh": "我祖母喜欢在夏天把桃子<w>制成罐头</w>。"
                            }
                        },
                        {
                            "text": "Salt was historically used to <w>preserve</w> meat for long voyages.",
                            "target_lang_translations": {
                                "ru": "Соль исторически использовалась, чтобы <w>сохранять</w> мясо для долгих путешествий.",
                                "zh": "历史上人们曾用盐来<w>腌制</w>肉类以备长途航行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "preserve fruit",
                        "preserve meat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать продукты (солью, сахаром и т.д.) для предотвращения порчи.",
                        "zh": "用盐、糖等物质处理食物，以防止其腐烂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "консервировать",
                                "target_lang_sense_clarification": "обрабатывать для длительного хранения"
                            },
                            {
                                "target_lang_word": "заготавливать",
                                "target_lang_sense_clarification": "делать запасы продуктов впрок"
                            },
                            {
                                "target_lang_word": "сохранять",
                                "target_lang_sense_clarification": "предохранять от гниения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "腌制",
                                "target_lang_sense_clarification": "用盐或调料处理食物以长期保存"
                            },
                            {
                                "target_lang_word": "制成罐头",
                                "target_lang_sense_clarification": "通过加工处理使食物长期保存"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6294715f-0e1e-3819-85fb-8c87ec3c35a8",
                    "sense_definition": "An area of land managed to protect its flora, fauna, and physical features.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hunting is strictly forbidden within the nature <w>preserve</w>.",
                            "target_lang_translations": {
                                "ru": "Охота строго запрещена на территории природного <w>заповедника</w>.",
                                "zh": "在自然<w>保护区</w>内严禁狩猎。"
                            }
                        },
                        {
                            "text": "We saw many rare birds during our visit to the wildlife <w>preserve</w>.",
                            "target_lang_translations": {
                                "ru": "Мы видели много редких птиц во время посещения <w>заповедника</w> дикой природы.",
                                "zh": "我们在参观野生动物<w>保护区</w>时看到了许多珍稀鸟类。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nature preserve",
                        "wildlife preserve",
                        "game preserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли, охраняемый для защиты флоры, фауны и природных особенностей.",
                        "zh": "为保护动植物及其自然特征而管理的土地区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заповедник",
                                "target_lang_sense_clarification": "особо охраняемая природная территория"
                            },
                            {
                                "target_lang_word": "заказник",
                                "target_lang_sense_clarification": "территория с ограниченной охраной природы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保护区",
                                "target_lang_sense_clarification": "专门划定用于保护自然环境的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0931c6d1-d36c-34f2-9a7a-7afc6e699875",
                    "sense_definition": "Fruit that has been cooked with sugar to keep it for a long time; similar to jam.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spread some strawberry <w>preserves</w> on her toast.",
                            "target_lang_translations": {
                                "ru": "Она намазала немного клубничного <w>варенья</w> на тост.",
                                "zh": "她在吐司上抹了一些草莓<w>果酱</w>。"
                            }
                        },
                        {
                            "text": "The pantry was stocked with jars of homemade <w>preserves</w>.",
                            "target_lang_translations": {
                                "ru": "Кладовая была заставлена банками с домашним <w>вареньем</w>.",
                                "zh": "食品储藏室里堆满了自制的<w>果酱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jam",
                        "jelly",
                        "marmalade",
                        "conserve"
                    ],
                    "common_phrases": [
                        "fruit preserves",
                        "strawberry preserves",
                        "apricot preserves"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фрукты или ягоды, сваренные в сахаре для длительного хранения.",
                        "zh": "用糖煮过的水果，以便长期保存；类似于果酱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варенье",
                                "target_lang_sense_clarification": "ягоды или фрукты в сиропе"
                            },
                            {
                                "target_lang_word": "джем",
                                "target_lang_sense_clarification": "густое варенье, желеобразная масса"
                            },
                            {
                                "target_lang_word": "конфитюр",
                                "target_lang_sense_clarification": "разновидность джема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "果酱",
                                "target_lang_sense_clarification": "由水果和糖熬制而成的食品"
                            },
                            {
                                "target_lang_word": "蜜饯",
                                "target_lang_sense_clarification": "用糖腌制的水果制品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99497238-b8d7-30e7-8d21-8f848f360e15",
                    "sense_definition": "An activity, job, or subject that is restricted to a specific person or group.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "domain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Foreign policy is often considered the <w>preserve</w> of the national government.",
                            "target_lang_translations": {
                                "ru": "Внешняя политика часто считается <w>прерогативой</w> национального правительства.",
                                "zh": "外交政策通常被认为是国家政府的<w>特权</w>。"
                            }
                        },
                        {
                            "text": "Golf was once the exclusive <w>preserve</w> of wealthy men.",
                            "target_lang_translations": {
                                "ru": "Гольф когда-то был исключительным <w>уделом</w> богатых мужчин.",
                                "zh": "高尔夫球曾经是富人的<w>专属领域</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "exclusive preserve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сфера деятельности или привилегия, доступная только определенному кругу лиц.",
                        "zh": "仅限于特定个人或群体的活动、工作或领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прерогатива",
                                "target_lang_sense_clarification": "исключительное право"
                            },
                            {
                                "target_lang_word": "удел",
                                "target_lang_sense_clarification": "сфера деятельности, судьба"
                            },
                            {
                                "target_lang_word": "вотчина",
                                "target_lang_sense_clarification": "перен. подконтрольная сфера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特权",
                                "target_lang_sense_clarification": "特定群体享有的专属权利"
                            },
                            {
                                "target_lang_word": "专属领域",
                                "target_lang_sense_clarification": "某人或某群体独有的活动范围"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}