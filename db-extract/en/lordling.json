                                            {
                                                "example_id": "88fe8c3c-311a-47df-a247-97edc35a8a5c",
                                                "sense_id": "3b008ca5-dc46-3dfc-b4c2-3e06c93e3524",
                                                "text": "Как барич дома, да не спит, так к барыне приступу нет."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c756f0-309c-3396-9cf8-d332593e5f35",
                                        "entry_id": "3fadf5ba-d4e5-312f-b608-377b933dbfc0",
                                        "glosses": [
                                            "разг. избалованный, изнеженный человек, белоручка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a3f5a7-c4e8-4836-8953-577a15bd32b4",
                                                "sense_id": "59c756f0-309c-3396-9cf8-d332593e5f35",
                                                "text": "Для реформ нужен был человек трезвый и деловой ― не барич, не набалованный царедворец, не влюблённый в себя аристократ…"
                                            }
                                        ]
