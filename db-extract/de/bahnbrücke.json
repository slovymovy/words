                "senses": [
                    {
                        "sense_id": "3a8cb4b2-f854-3e3e-816a-d5aebe39a90c",
                        "entry_id": "9bc09d5e-e5a8-399e-a262-3e9775cd7ce0",
                        "glosses": [
                            "Brücke für eine Bahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b103a7f-55be-4475-96ec-98797ea6e54e",
                                "sense_id": "3a8cb4b2-f854-3e3e-816a-d5aebe39a90c",
                                "text": "„Tarka hielt sich oft in der Nähe der Bahnbrücken auf, das laute Rattern der Züge störte ihn nicht, denn daran hatte er sich längst gewöhnt.“"
                            },
                            {
                                "example_id": "ff382021-87f1-4c99-b323-5199d909d998",
                                "sense_id": "3a8cb4b2-f854-3e3e-816a-d5aebe39a90c",
                                "text": "„Die Sperrung der Kreisstraße 121 auf der anderen Bahnseite dauert weiter an, weil sich die Sanierungsarbeiten an der Bahnbrücke vermutlich bis Ende September hinziehen werden.“"
                            }
                        ],
