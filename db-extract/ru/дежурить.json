                                                "example_id": "8ec81ecf-8c8c-42ce-a056-27887a9b36b1",
                                                "sense_id": "3ad0bf98-c21b-3f07-a8bd-84b9c20afb0a",
                                                "text": "Wait for the light to change before you cross the street."
                                            },
                                            {
                                                "example_id": "261139d8-248f-4e7e-af56-04401eebf95e",
                                                "sense_id": "3ad0bf98-c21b-3f07-a8bd-84b9c20afb0a",
                                                "text": "What are you waiting for?"
                                            },
                                            {
                                                "example_id": "0657e162-e2d5-4d7f-85c5-c98aa9cfd9a0",
                                                "sense_id": "3ad0bf98-c21b-3f07-a8bd-84b9c20afb0a",
                                                "text": "And now we're waiting for the very same people to establish GBR, drive through urgently needed fares reform, and come up with imaginative and effective train operating contracts..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06320c94-4608-399b-a929-9d14fdfd666f",
                                        "entry_id": "3c3574fb-210e-3544-9c07-aa3c375f91fa",
                                        "glosses": [
                                            "To await the arrival of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b982c6e9-2739-48f1-af99-9a2b17a34d88",
                                                "sense_id": "06320c94-4608-399b-a929-9d14fdfd666f",
                                                "text": "I'm waiting for my date."
                                            },
                                            {
                                                "example_id": "041d03a0-708d-47c8-8f6c-5a2e1fcb316b",
                                                "sense_id": "06320c94-4608-399b-a929-9d14fdfd666f",
                                                "text": "I'm waiting for the train."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
