                {
                    "sense_id": "4f9aa7cd-a145-3ecd-94a2-7f029a232598",
                    "sense_definition": "Ausruf, mit dem jemand um eine kurze Wartezeit gebeten wird",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Augenblick</w>, ich komme sofort zu dir!",
                            "target_lang_translations": {
                                "en": "<w>Just a moment</w>, I'll be right with you!",
                                "ru": "<w>Минуточку</w>, я сейчас подойду к тебе!",
                                "nl": "<w>Momentje</w>, ik kom meteen naar je toe!",
                                "pl": "<w>Chwileczkę</w>, zaraz do ciebie przyjdę!",
                                "fr": "<w>Un instant</w>, j'arrive tout de suite vers toi !",
                                "it": "<w>Un attimo</w>, vengo subito da te!",
                                "cs": "<w>Okamžik</w>, hned jsem u tebe!",
                                "tr": "<w>Bir saniye</w>, hemen yanına geliyorum!",
                                "es": "¡<w>Un momento</w>, voy enseguida hacia ti!",
                                "zh": "<w>等一下</w>，我马上就过去找你！"
                            }
                        },
                        {
                            "text": "<w>Augenblick</w>, ich muss nur kurz meine Tasche holen.",
                            "target_lang_translations": {
                                "en": "<w>One moment</w>, I just need to quickly grab my bag.",
                                "ru": "<w>Один момент</w>, мне нужно только быстро взять сумку.",
                                "nl": "<w>Een ogenblik</w>, ik moet alleen even snel mijn tas pakken.",
                                "pl": "<w>Momencik</w>, muszę tylko szybko zabrać torbę.",
                                "fr": "<w>Un instant</w>, je dois juste vite récupérer mon sac.",
                                "it": "<w>Un momento</w>, devo solo prendere la mia borsa.",
                                "cs": "<w>Moment</w>, musím si jen rychle vzít tašku.",
                                "tr": "<w>Bir dakika</w>, sadece hemen çantamı almam gerek.",
                                "es": "<w>Un momento</w>, solo tengo que recoger mi bolso rápidamente.",
                                "zh": "<w>稍等</w>，我只需快去拿一下包。"
                            }
                        }
                    ],
