                        "glosses": [
                            "een wettige afspraak rond het opnemen van een vreemd kind als het eigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12df7f5f-244d-4a7b-af4b-e5ad128da9c4",
                                "sense_id": "4e918812-41c3-3643-aa40-fa814d059118",
                                "text": "De socialistische regering van premier Jean-Marc Ayrault wil volgend jaar het homohuwelijk en de adoptieregeling invoeren. De regering wordt gesteund door een meerderheid van de Fransen, van wie de meesten zichzelf katholiek noemen maar zelden naar de kerk gaan."
                            },
                            {
                                "example_id": "2fcabe98-aa8c-43ac-a93e-88e8376dcfce",
                                "sense_id": "4e918812-41c3-3643-aa40-fa814d059118",
                                "text": "De belangrijkste tegenstander van de wet is de Rooms-Katholieke kerk. Die heeft zich fel verzet, vooral tegen de adoptieregeling. Volgens de Argentijnse kardinaal Bergoglio is het belangrijk dat kinderen als voorbeelden zowel een moeder als een vader hebben."
                            }
                        ]
                    }
