                        "examples": [
                            {
                                "example_id": "8cf574b0-234e-4e32-a218-2e4556afd488",
                                "sense_id": "378af347-2880-317e-877d-43e1b20645c5",
                                "text": "Begin vorig jaar werd de Zuid-Koreaanse sportwereld opgeschrikt door meerdere verhalen over misbruik van atleten. Shorttrackster Shim Suk-hee, tweevoudig olympisch kampioen, trad als eerste naar buiten met beschuldigingen aan het adres van haar coach, die haar meermaals zou hebben verkracht."
                            },
                            {
                                "example_id": "cddc5454-93f9-46b4-82fe-b5f51e9b586d",
                                "sense_id": "378af347-2880-317e-877d-43e1b20645c5",
                                "text": "De shorttrackster traint in de fysiopraktijk van haar moeder en probeert zich zo goed en zo kwaad als het kan voor te bereiden op een nieuw - en vooralsnog zeer onduidelijk - seizoen. Al zag ze de afgelasting van de WK wel aankomen."
                            }
                        ]
