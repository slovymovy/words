                    {
                        "sense_id": "40b976fc-cdef-3e65-8c50-db222963b578",
                        "entry_id": "e1777a7a-53ea-38af-843e-7e9c5005d42e",
                        "glosses": [
                            "een geslacht Carex van zowel bladverliezende als groenblijvende overblijvende kruiden met een grasachtige groeivorm, behorend tot de cypergrassenfamilie (Cyperaceae). Het geslacht Carex is met ruim 2000 soorten een van de grootste geslachten van de bedektzadigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa4f009-3c55-4487-b135-c6786f73bb7f",
                                "sense_id": "40b976fc-cdef-3e65-8c50-db222963b578",
                                "text": "Een aantal zeggesoorten worden als sierplanten in tuinen benut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4e0fae4-d1e1-489e-9f2b-f4bad62b9dab",
                        "source_entry_id": "e1777a7a-53ea-38af-843e-7e9c5005d42e",
                        "source_sense_id": "40b976fc-cdef-3e65-8c50-db222963b578",
                        "source_sense_description": "een geslacht van zowel bladverliezende als groenblijvende kruidachtige planten",
                        "target_lang_word": "Segge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segge",
