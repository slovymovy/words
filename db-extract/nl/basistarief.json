                        "examples": [
                            {
                                "example_id": "d6f3218e-19be-461c-a3de-d1c9d92e0a00",
                                "sense_id": "9720195f-0c08-3e47-9675-04d727d47afc",
                                "text": "Het CDA wil dat het stelsel eenvoudiger wordt en dat de lasten omlaag gaan. Dat kan door de invoering van de vlaktaks: een vorm van inkomstenbelasting waarbij iedereen hetzelfde percentage betaalt. Het CDA pleit voor twee tarieven: een basistarief en \"een solidariteitsheffing\" voor de hogere inkomens. Dat kost geld, maar levert volgens hem nog veel meer op, omdat er meer mensen aan het werk gaan."
                            },
                            {
                                "example_id": "3dda67d9-988c-41f8-a72e-4b6621659149",
                                "sense_id": "9720195f-0c08-3e47-9675-04d727d47afc",
                                "text": "In eerste instantie zou het basistarief in bestuurszaken 500 euro worden. In het nieuwe voorstel betalen mensen met een laag of middeninkomen 250 euro bij geschillen over studiefinanciering, uitkeringen of huurtoeslag."
                            }
                        ]
                    }
