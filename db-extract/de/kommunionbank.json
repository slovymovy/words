                        "entry_id": "47c3edcb-234b-3556-8925-f7b2ee8bc39f",
                        "glosses": [
                            "Bank am Rande des Altarraums katholischer Kirchen, an der die Gläubigen die Kommunion empfangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae16ce66-b8f7-4432-8274-f9839ca003e1",
                                "sense_id": "56228a9f-a1f9-3988-a707-1fd52e8f7863",
                                "text": "„Bertram schaute zu mir herüber, winkte mit dem Kopf auffordernd in Richtung Kommunionbank und erhob sich.“"
                            },
                            {
                                "example_id": "5746e5c7-8c6e-4caa-b094-42f639da3c83",
                                "sense_id": "56228a9f-a1f9-3988-a707-1fd52e8f7863",
                                "text": "„Eine Frau steht auf, geht durch den Mittelgang nach vorn bis zur Kommunionbank und wirft sich dort auf den Boden.“"
                            }
                        ],
