                                "target_word": "tagliatelle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2df11c6d-34ad-374a-b3ed-362fbdad551c",
                                        "entry_id": "13fee35d-40a1-3058-bf5f-e082de20796f",
                                        "glosses": [
                                            "Long, flat ribbons of egg pasta, originally from Emilia-Romagna, sliced from a rolled-out sheet."
                                        ],
                                        "tags": [
                                            "plural-normally",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9864b24e-4a3e-4546-8a8e-258ef10234ec",
                                                "sense_id": "2df11c6d-34ad-374a-b3ed-362fbdad551c",
                                                "text": "When the tagliatelle are al dente, drain thoroughly and transfer to a warm bowl."
                                            },
                                            {
                                                "example_id": "5801b9cb-b5c5-4e2c-868f-fa573dc60ac4",
                                                "sense_id": "2df11c6d-34ad-374a-b3ed-362fbdad551c",
                                                "text": "And the tagliatelle are topped with shrimp and accompanied by a plate of good hot French bread made before your eyes in the restaurant’s small glass-walled bakery."
                                            },
                                            {
                                                "example_id": "9ee9d8e5-7ec5-4d1c-bc26-8129a8f8adf7",
                                                "sense_id": "2df11c6d-34ad-374a-b3ed-362fbdad551c",
                                                "text": "Stir the ham into the sauce; if the tagliatelle are not quite ready, remove the ham and the peas from the heat."
                                            },
                                            {
                                                "example_id": "61b34b65-7e3b-42a2-90fa-11176cab4a80",
                                                "sense_id": "2df11c6d-34ad-374a-b3ed-362fbdad551c",
                                                "text": "Fry gently over a low heat, stirring from time to time, until the tagliatelle are ready (it’s fine if the beans go slightly fuzzy at the edges, just as long as they don’t burn!)."
                                            },
                                            {
                                                "example_id": "69c13524-0b8a-4cb9-8fe8-3e5a0dc2e2aa",
                                                "sense_id": "2df11c6d-34ad-374a-b3ed-362fbdad551c",
                                                "text": "“Hi, honey. If you have a sec, could you pick up a few things for dinner? Well, I was thinking some tagliatelle from that restaurant in Rome, and maybe that wine from Provence, the rosé. Yeah. Thanks, sweetie. Love you.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
