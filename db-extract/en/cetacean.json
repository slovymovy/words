                    {
                        "translation_id": "4dbbf8d8-de25-47b2-bcb9-90b8e31231a8",
                        "source_entry_id": "d41dc797-5c23-3669-a8a3-225c37f47ef1",
                        "source_sense_id": "7be93b26-73d9-3bd8-9253-0f11c015f0df",
