                "senses": [
                    {
                        "sense_id": "944042f1-ebd8-3e8f-9ab4-8127bf03d650",
                        "entry_id": "5c63d8e1-1f82-387e-aa1f-dec0da58fe22",
                        "glosses": [
                            "Celui qui brunit les ouvrages d’or et d’argent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0098678b-e8b7-4fbc-ba1a-f9d508491855",
                                "sense_id": "944042f1-ebd8-3e8f-9ab4-8127bf03d650",
                                "text": "Un brunisseur habile ne tracerait pas des arabesques si délicates."
                            },
                            {
                                "example_id": "7e579a63-3d16-4b8a-afc1-9de1d7579ef9",
                                "sense_id": "944042f1-ebd8-3e8f-9ab4-8127bf03d650",
                                "text": "Elle avait aperçu la petite Adèle, une brunisseuse qui dînait à leur restaurant,"
                            },
                            {
                                "example_id": "68b35abc-447f-433d-868d-b8f90e110b80",
                                "sense_id": "944042f1-ebd8-3e8f-9ab4-8127bf03d650",
                                "text": "Il prend sa plume, souffle soigneusement les mies de pain tombées sur son grand livre, fait un geste pour bien poser sa main, et de sa plus belle ronde il écrit le nom qu’il vient de déchiffrer sur le livret mouillé :\nFélicie Rameau, brunisseuse, dix-sept ans."
                            }
                        ]
                    }
                ],
