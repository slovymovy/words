                        "source_entry_id": "d55f1cbe-004e-36d4-95f1-6869d23799e2",
                        "source_sense_id": "8483f815-5081-321d-b519-31dddf9fe991",
                        "source_sense_description": "chemisches Element mit der Ordnungszahl 61, das zu den Lanthanoiden gehört",
                        "target_lang_word": "prométhéum",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prométhéum",
