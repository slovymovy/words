                                "target_senses": [
                                    {
                                        "sense_id": "c04ebc2a-bf8d-391f-a435-29156fdc8e7c",
                                        "entry_id": "37ee09ba-0867-3c16-b45f-f1357b603ac7",
                                        "glosses": [
                                            "Écumeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1648624b-14a0-480a-ba9c-5cbaeffaa7cb",
                                                "sense_id": "c04ebc2a-bf8d-391f-a435-29156fdc8e7c",
                                                "text": "La masse spumeuse se compose en majeure partie d'air emprisonné dans de petites bulles."
                                            },
                                            {
                                                "example_id": "bcf68102-ba92-4b9e-9633-aeb434bbab5e",
                                                "sense_id": "c04ebc2a-bf8d-391f-a435-29156fdc8e7c",
                                                "text": "Un mince filet de sang spumeux perla sur ses lèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3294d412-f1bc-3cc4-ba71-ef01209b138a",
                                        "entry_id": "37ee09ba-0867-3c16-b45f-f1357b603ac7",
                                        "glosses": [
                                            "Flou, étrange, bizarre, fatigué, et par extension mauvais ou raté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc5b07e-2d8d-46ac-8bf5-c9f968b5aa20",
                                                "sense_id": "3294d412-f1bc-3cc4-ba71-ef01209b138a",
                                                "text": "Une attitude spumeuse se caractérise par une apathie ainsi que par des difficultés à réaliser certaines choses ou des problèmes de communication pouvant entraîner un festonnement des rapports humains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
