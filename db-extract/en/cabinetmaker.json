                                    {
                                        "sense_id": "aa73339e-2ca8-3661-96eb-6b5aeaac2ff7",
                                        "entry_id": "8400d150-2bae-349b-84b1-58d906326728",
                                        "glosses": [
                                            "столяр, изготовляющий высококачественную мебель из дорогих сортов дерева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252aa167-552a-4f44-895f-794774b6dabd",
                                                "sense_id": "aa73339e-2ca8-3661-96eb-6b5aeaac2ff7",
                                                "text": "Ведь в Москве открылся салон, где представлена мебель этой старинной английской фирмы, прославившейся своими краснодеревщиками."
                                            },
                                            {
                                                "example_id": "2871a914-3a17-47b2-b987-2c3d416bbdff",
                                                "sense_id": "aa73339e-2ca8-3661-96eb-6b5aeaac2ff7",
                                                "text": "Для панелей из красного дерева Иван Пирогов сам сделал эскизы, а высококвалифицированные краснодеревщики их воплотили."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff219565-aacc-4987-94b1-53885778a136",
                        "source_entry_id": "476baf1e-65a5-3ec5-8b0e-6b3dfe1e03c7",
                        "source_sense_id": "a2f2c8fb-95c5-3699-b3ae-896b64b9c437",
                        "source_sense_description": "skilled woodworker",
                        "target_lang_word": "ме́бельщик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ме́бельщик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efe10e54-c223-38ad-b6cb-ebdb883b2e62",
                                        "entry_id": "de3e13ca-59ef-3137-a8b6-3f4a469fb86b",
                                        "glosses": [
                                            "мастер, изготавливающий мебель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "912296cf-9c7d-4f06-bf85-c38b9176191f",
                                                "sense_id": "efe10e54-c223-38ad-b6cb-ebdb883b2e62",
                                                "text": "Превосходный столяр и мебельщик, Сокольцев постоянно работал в мастерской, находившейся за тюремной оградой .."
                                            },
                                            {
                                                "example_id": "1aa079ba-378f-4eb4-8096-5ac568eb3bbf",
                                                "sense_id": "efe10e54-c223-38ad-b6cb-ebdb883b2e62",
                                                "text": "Получив эту квартиру, мы относительно меблировки договорились с мебельщиком Комовым, который к осени обязался сделать мебель по одобренным нами образцам."
                                            },
                                            {
                                                "example_id": "2daaa2c9-5c51-4ada-bf36-035c6c7d0d15",
                                                "sense_id": "efe10e54-c223-38ad-b6cb-ebdb883b2e62",
                                                "text": "Новые дома красивы и комфортабельны, но перед новосёлами возникает немало трудностей, когда они начинают обставлять своё жильё. И происходит это потому, что мебельщики, которые должны были принять эстафету от архитекторов и строителей и продолжить заботу о новосёлах, до сих пор не создали новых образцов мебели, в первую очередь для малометражных квартир."
                                            },
                                            {
                                                "example_id": "6da3132e-4b55-4ecc-b367-a8f2d427a0c0",
                                                "sense_id": "efe10e54-c223-38ad-b6cb-ebdb883b2e62",
                                                "text": "В коллективе столяров и мебельщиков много хороших мастеров, специалистов своего дела."
                                            },
                                            {
                                                "example_id": "3656c899-1c5d-4948-bd8b-a01f5b3146b9",
                                                "sense_id": "efe10e54-c223-38ad-b6cb-ebdb883b2e62",
                                                "text": "Эрибо хороший, можно сказать, отличный столяр, главным образом мебельщик, но стильной мебели раньше не делал, делать стильную мебель он научился у него, Груля."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18fb106b-9f43-4e97-bb09-3089a0715bba",
                        "source_entry_id": "476baf1e-65a5-3ec5-8b0e-6b3dfe1e03c7",
                        "source_sense_id": "a2f2c8fb-95c5-3699-b3ae-896b64b9c437",
                        "source_sense_description": "skilled woodworker",
