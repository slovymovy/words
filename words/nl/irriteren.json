{
    "word_family": [
        "irritatie",
        "irritant",
        "irriteerbaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c283c790-29c0-31cc-9e0a-33c86da6d74f",
                    "sense_definition": "iemand een onaangenaam of boos gevoel geven door storend gedrag of vervelende situaties",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het lawaai van de buren begint me echt te <w>irriteren</w> tijdens het werken.",
                            "target_lang_translations": {
                                "en": "The noise from the neighbors is really starting to <w>irritate</w> me while I'm working."
                            }
                        },
                        {
                            "text": "Zijn constante vragen kunnen anderen soms behoorlijk <w>irriteren</w>.",
                            "target_lang_translations": {
                                "en": "His constant questions can <w>annoy</w> others quite a bit sometimes."
                            }
                        }
                    ],
                    "synonyms": [
                        "ergeren"
                    ],
                    "antonyms": [
                        "kalmeren",
                        "geruststellen"
                    ],
                    "common_phrases": [
                        "iemand mateloos irriteren",
                        "elkaar irriteren"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone to feel annoyed or angry due to disturbing behavior or unpleasant situations."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "to provoke annoyance or displeasure"
                            },
                            {
                                "target_lang_word": "annoy",
                                "target_lang_sense_clarification": "to disturb or bother someone"
                            },
                            {
                                "target_lang_word": "aggravate",
                                "target_lang_sense_clarification": "to make someone feel frustrated or impatient"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfcda393-f5a7-38fb-b13e-cf1e14b73c94",
                    "sense_definition": "een lichamelijke reactie veroorzaken die pijnlijk of gevoelig is, zoals op de huid of in de ogen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rook van het kampvuur kan je ogen behoorlijk <w>irriteren</w>.",
                            "target_lang_translations": {
                                "en": "The smoke from the campfire can <w>irritate</w> your eyes significantly."
                            }
                        },
                        {
                            "text": "Deze sterke zeep kan een gevoelige huid snel <w>irriteren</w>.",
                            "target_lang_translations": {
                                "en": "This strong soap can quickly <w>irritate</w> sensitive skin."
                            }
                        }
                    ],
                    "antonyms": [
                        "verzachten"
                    ],
                    "common_phrases": [
                        "de huid irriteren",
                        "de ogen irriteren"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a physical reaction that is painful or sensitive, such as on the skin or in the eyes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "to induce physical pain or inflammation"
                            },
                            {
                                "target_lang_word": "inflame",
                                "target_lang_sense_clarification": "to cause redness or swelling in the body"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}