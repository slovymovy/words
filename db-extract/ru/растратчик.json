                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dilapidateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f68941cb-05d3-3180-bfb7-1168fef65bfa",
                                        "entry_id": "a7969fc3-9a77-39f0-a1b7-af5c3ca80ebf",
                                        "glosses": [
                                            "Celui qui dilapide un bien, une fortune, des fonds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb780d1a-c3aa-4502-beaa-bd1e708331de",
                                                "sense_id": "f68941cb-05d3-3180-bfb7-1168fef65bfa",
                                                "text": "Dilapidateur des fonds de l’État."
                                            },
                                            {
                                                "example_id": "189c9ad9-8a29-4878-a06d-90b84ead6965",
                                                "sense_id": "f68941cb-05d3-3180-bfb7-1168fef65bfa",
                                                "text": "Parfaitement ; le roi me croyait un dilapidateur. Ou plutôt un administrateur médiocre."
                                            },
                                            {
                                                "example_id": "9a72908c-4d4a-43ce-b464-ebf520f52872",
                                                "sense_id": "f68941cb-05d3-3180-bfb7-1168fef65bfa",
                                                "text": "Dilapidateur enragé d’un patrimoine entamé déjà depuis longtemps, le père du vicomte actuel expirait sans gloire, en 1815, laissant à peine à son avorton de fils, infailliblement désigné pour l’extinction de la Race, de quoi subsister comme un laboureur antique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dilapidateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebdf2223-6cc0-3cd7-baf1-69b7c6ca638c",
                                        "entry_id": "bfdcf439-0163-3c20-a642-7fc21b5df454",
                                        "glosses": [
                                            "Qui dilapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ed7816-d4a3-4412-ab7d-579d7c817e1d",
                                                "sense_id": "ebdf2223-6cc0-3cd7-baf1-69b7c6ca638c",
                                                "text": "Ministre dilapidateur des fonds publics."
                                            },
                                            {
                                                "example_id": "a78b47dc-6d80-455c-b214-e4ab1d30a62b",
                                                "sense_id": "ebdf2223-6cc0-3cd7-baf1-69b7c6ca638c",
                                                "text": "Plus d’époux incommode et dilapidateur, plus de scènes, plus de retours à l’improviste, de départs qui ressemblaient à des fuites, de dépêches suspectes, d’interlocutrices invisibles qu’au téléphone on nomme « mon vieux » ou « cher monsieur »…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9fa4f96-c442-4e91-9280-329eabb9c6c5",
                        "source_entry_id": "8bba2927-e54f-3ae8-bac4-73d533abfe74",
                        "source_sense_description": "тот, кто совершил или совершает растрату",
                        "target_lang_word": "déprédateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déprédateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a89d3a74-c67d-32cb-8460-f386111fb72f",
                                        "entry_id": "0718e312-ec9b-3330-9452-a38fbd8fc329",
                                        "glosses": [
                                            "Celui qui commet des déprédations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46e24d94-d82d-47c5-b5b0-15c555910be0",
                                                "sense_id": "a89d3a74-c67d-32cb-8460-f386111fb72f",
                                                "text": "[…] le chat sauvage a conservé le caractère de la famille ; il est aussi cruel, aussi méchant, aussi déprédateur en petit, que ses consanguins le sont en grand ; ils sont tous également carnassiers, également ennemis des autres animaux."
                                            },
                                            {
                                                "example_id": "1cfe0119-cac0-4665-9f0f-ace5f86ed52b",
                                                "sense_id": "a89d3a74-c67d-32cb-8460-f386111fb72f",
                                                "text": "Le sujet humain, selon la perspective neurobiologique contemporaine, est un déprédateur dont la morphologie imaginaire peut reposer dans la déprédation comme dans l’imprécation de ses regrets et injures."
                                            }
                                        ]
                                    }
                                ]
