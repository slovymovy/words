                "senses": [
                    {
                        "sense_id": "565dff11-0ca4-3fd9-8ff0-7f7ae36914d1",
                        "entry_id": "0fce0cd9-fd12-3357-9666-98e12461b0dc",
                        "glosses": [
                            "Waffe, die Laserstrahlen zur Bekämpfung feindlicher Ziele verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c92c4eef-fe4f-483d-a8a5-51d53526b280",
                                "sense_id": "565dff11-0ca4-3fd9-8ff0-7f7ae36914d1",
                                "text": "„Ein Prototyp einer fliegenden Laserwaffe soll es auf Spione im Orbit abgesehen haben.“"
                            },
                            {
                                "example_id": "99381e2e-fe3c-414f-a4b1-e1975bcd779e",
                                "sense_id": "565dff11-0ca4-3fd9-8ff0-7f7ae36914d1",
                                "text": "„Das US-Militär investiert große Summen in Laserwaffen, damit sollen beispielsweise Drohnen abgewehrt werden.“"
                            },
                            {
                                "example_id": "314e6d8f-32fa-43eb-93e3-5010930780fb",
                                "sense_id": "565dff11-0ca4-3fd9-8ff0-7f7ae36914d1",
                                "text": "„Dass die US Navy eine neuartige Laserwaffe testet, war bekannt.“"
                            },
                            {
                                "example_id": "7fd463d8-6b0c-4127-9374-977c96bcce33",
                                "sense_id": "565dff11-0ca4-3fd9-8ff0-7f7ae36914d1",
                                "text": "„Die US Army vermeldete gemeinsam mit dem Rüstungskonzern Raytheon, erfolgreiche Testversuche mit Laserwaffen in Hubschraubern durchgeführt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4b2711e-c545-451a-92cf-f3f3e2116685",
