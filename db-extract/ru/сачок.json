                        ],
                        "form": "сачке́"
                    },
                    {
                        "form_id": "5776c138-eecd-4b48-8c8c-38162eb84c90",
                        "entry_id": "15857d22-1882-3ca2-bbaa-bcb4d73bb6c8",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "сачка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                        "entry_id": "15857d22-1882-3ca2-bbaa-bcb4d73bb6c8",
                        "glosses": [
                            "конусообразная сетка на обруче с рукоятью, служащая для ловли рыб, насекомых и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb1eca7-3010-47f2-b4b5-d618b0d6b253",
                                "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                "text": "Молодые люди были вооружены удочками, сачками, банками с червями и прочими рыболовными принадлежностями."
                            },
                            {
                                "example_id": "d835db99-c7a9-4ad7-bd21-375a273fd808",
                                "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                "text": "Сейчас беру сачок, норы все мне в известности, подведешь сачок к выходу, пугнёшь – готово."
                            },
                            {
                                "example_id": "bc4ec7ec-f0c3-43a5-a376-a0e652c9964f",
                                "sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                                "text": "В руках Женька держал сачок для ловли бабочек, он его все стремился нести на плече, как винтовку, но почему-то не мог поднять, хотя в руках сачок казался очень лёгким."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2949f19c-d122-4ded-8f4f-35900de8e1f3",
                        "source_entry_id": "15857d22-1882-3ca2-bbaa-bcb4d73bb6c8",
                        "source_sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                        "target_lang_word": "acchiappafarfalle",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8b561735-ff21-4f92-9256-34c3d84b905a",
                        "source_entry_id": "15857d22-1882-3ca2-bbaa-bcb4d73bb6c8",
                        "source_sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                        "target_lang_word": "Schmetterlingsnetz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmetterlingsnetz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41172063-5f7c-3271-8ad0-061bc0789421",
                                        "entry_id": "727037c1-f86c-3761-9646-edc9c4ecc8d5",
                                        "glosses": [
                                            "Kescher für den Fang von Schmetterlingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebe5486-fab8-49b3-8e39-f378f624df7a",
                                                "sense_id": "41172063-5f7c-3271-8ad0-061bc0789421",
                                                "text": "„Es gab Bücherregale mit herrlichen unlesbaren Büchern und – in einem Winkel – eine Flinte, ein Schmetterlingsnetz und einen Bergstock.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41a00997-d77c-4270-a3a1-1113eb607c9f",
                        "source_entry_id": "15857d22-1882-3ca2-bbaa-bcb4d73bb6c8",
                        "source_sense_id": "321496fd-93ea-3d0e-ad8f-6834cb50a08e",
                        "target_lang_word": "Kescher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kescher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                        "entry_id": "891ab189-255e-33ea-adcf-7f677e700651",
                                        "glosses": [
                                            "bestielter, auf einen Kunststoff- oder Metallbügel aufgezogener Netzsack, der als Landungshilfe für den an der Angel befindlichen Fische dient"
                                        ],
                                        "tags": [
                                            "Angelfischerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1cbbdc-4e0e-4809-afad-d1df03ac945c",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "Der Angler lenkte den gehakten Fisch mit der Angelrute über den Kescher. Er hob dann den ausgedrillten Fisch mit dem Kescher aus dem Wasser."
                                            },
                                            {
                                                "example_id": "bf22cb94-80fd-4f5a-b4e8-68973a5c11be",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "„Mama sagte, ich sei ein oller Quengelpott, aber dann kaufte sie mir auch einen Kescher, damit es nicht noch weiter böses Blut gab zwischen Volker und mir.“"
                                            },
                                            {
                                                "example_id": "5ccf5655-e2ef-4103-b98d-a789ad94832a",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "„An einem schönen Sommernachmittag hatten wir uns wieder am Weiher verabredet, und Niki hatte sogar einen Kescher mitgebracht, denn wir hätten den kapitalen Fisch niemals ans Ufer heben können.“"
                                            },
                                            {
                                                "example_id": "b46b9cfe-fb6e-4cb5-b27a-06b50f75e528",
                                                "sense_id": "42648eed-c8e7-39ab-9a0f-8a13e49a8d54",
                                                "text": "„Man muß, das ist die Technik, mit der Landschaft verschmelzen, warten und den Vogel dann mit einem großen Kescher fangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cca49eda-63cb-311d-8bc1-0c54428a2b55",
                                        "entry_id": "891ab189-255e-33ea-adcf-7f677e700651",
                                        "glosses": [
                                            "Geflecht, in dem Fische gehältert werden"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
