    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78d56f18-a394-33f3-a087-f12f5e972681",
                    "sense_definition": "A belief or opinion that is contrary to the official or established doctrines of a religion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unorthodox_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church council accused the priest of <w>heresy</w> for his radical teachings."
                        },
                        {
                            "text": "Many historical figures were punished for spreading <w>heresy</w> against the state religion."
                        }
                    ],
                    "synonyms": [
                        "misbelief"
                    ],
                    "antonyms": [
                        "orthodoxy"
                    ],
                    "common_phrases": [
                        "accused of heresy",
                        "charge of heresy"
                    ]
                },
                {
                    "sense_id": "08cc1a1a-1ef0-34b8-92f0-d85fee1074da",
                    "sense_definition": "An opinion or belief that strongly disagrees with the accepted or standard views of a particular group or field.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unorthodox_belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the world of traditional physics, his new theory was considered pure <w>heresy</w>."
                        },
                        {
                            "text": "Challenging the company's core strategy was seen as <w>heresy</w> by the senior management team."
                        }
                    ],
                    "common_phrases": [
                        "scientific heresy",
                        "political heresy"
                    ]
                }
            ]
        }
    ]
