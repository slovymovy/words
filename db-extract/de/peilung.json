                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af22af09-2180-4bc3-9946-bae402ec299c",
                                "sense_id": "788bf285-f943-3542-b9b2-1bc69ed5010b",
                                "text": "Die Peilung wurde immer geringer."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "9cc4a8ae-c6f0-3937-a0bf-ac2974bf88cb",
