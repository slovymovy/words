{
    "word_family": [
        "narrow",
        "narrowly",
        "narrowness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ab23589-609f-395c-8b8f-96a8575a7988",
                    "sense_definition": "Present participle of <w>narrow</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "narrowing_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain path was <w>narrowing</w> quickly as they climbed higher toward the summit.",
                            "target_lang_translations": {
                                "ru": "Горная тропа быстро <w>сужалась</w> по мере того, как они поднимались все выше к вершине."
                            }
                        },
                        {
                            "text": "Police are gradually <w>narrowing</w> down the list of suspects in the ongoing investigation.",
                            "target_lang_translations": {
                                "ru": "Полиция постепенно <w>сужает</w> список подозреваемых в ходе текущего расследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "tapering",
                        "constricting"
                    ],
                    "antonyms": [
                        "widening",
                        "broadening"
                    ],
                    "common_phrases": [
                        "narrowing down",
                        "narrowing the gap"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола narrow; сужающийся, сужающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сужаться",
                                "target_lang_sense_clarification": "становиться более узким"
                            },
                            {
                                "target_lang_word": "сужать",
                                "target_lang_sense_clarification": "делать более узким, сокращать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40181242-c33c-353d-b1c5-cc935ff5acbf",
                    "sense_definition": "The act or process of becoming narrower, or a place where something becomes narrow.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "narrowing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers should take extra care because of a sudden <w>narrowing</w> of the road ahead.",
                            "target_lang_translations": {
                                "ru": "Водителям следует быть особенно осторожными из-за внезапного <w>сужения</w> дороги впереди."
                            }
                        },
                        {
                            "text": "The doctor explained that the chest pain was caused by a gradual <w>narrowing</w> of the arteries.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что боль в груди была вызвана постепенным <w>сужением</w> артерий."
                            }
                        }
                    ],
                    "synonyms": [
                        "constriction",
                        "tapering",
                        "stenosis"
                    ],
                    "antonyms": [
                        "widening",
                        "expansion"
                    ],
                    "common_phrases": [
                        "narrowing of the arteries",
                        "narrowing of the road"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс уменьшения ширины или место, где что-либо становится уже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сужение",
                                "target_lang_sense_clarification": "процесс или узкое место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57f39b1c-1d1d-367a-a6ec-aa9e08cb4aa0",
                    "sense_definition": "A place where the width of a knitted item, such as a stocking, is reduced by decreasing stitches.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "narrowing_knitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pattern instructs you to begin the <w>narrowing</w> after finishing the main section of the leg.",
                            "target_lang_translations": {
                                "ru": "Схема предписывает начать <w>убавление</w> после завершения основной части паголенка."
                            }
                        },
                        {
                            "text": "Carefully count your remaining stitches when you reach the first <w>narrowing</w> of the stocking.",
                            "target_lang_translations": {
                                "ru": "Внимательно пересчитайте оставшиеся петли, когда дойдете до первого <w>убавления</w> чулка."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В вязании: убавление петель или место, где изделие сужается."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убавление",
                                "target_lang_sense_clarification": "в вязании, уменьшение петель"
                            },
                            {
                                "target_lang_word": "убавка",
                                "target_lang_sense_clarification": "в вязании"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb922996-a184-3f86-93e6-bf145f7d1f91",
                    "sense_definition": "Becoming progressively narrower or more restricted.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "narrowing_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers carefully navigated the <w>narrowing</w> path along the edge of the steep cliff.",
                            "target_lang_translations": {
                                "ru": "Туристы осторожно шли по <w>сужающейся</w> тропе вдоль края крутого обрыва."
                            }
                        },
                        {
                            "text": "Analysts noted a <w>narrowing</w> gap between the two leading candidates in the recent polls.",
                            "target_lang_translations": {
                                "ru": "Аналитики отметили <w>сокращающийся</w> разрыв между двумя лидирующими кандидатами в последних опросах."
                            }
                        }
                    ],
                    "synonyms": [
                        "tapering",
                        "converging"
                    ],
                    "antonyms": [
                        "widening"
                    ],
                    "common_phrases": [
                        "narrowing path",
                        "narrowing gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становящийся более узким, ограниченным или сокращающийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сужающийся",
                                "target_lang_sense_clarification": "становящийся уже по ширине или объему"
                            },
                            {
                                "target_lang_word": "сокращающийся",
                                "target_lang_sense_clarification": "об отрыве, разрыве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}