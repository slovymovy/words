                "senses": [
                    {
                        "sense_id": "ad2a22af-f751-39b5-8f50-67b66d1c26ad",
                        "entry_id": "be3e3fd0-cd3e-3383-91eb-9006c3d2a158",
                        "glosses": [
                            "sprachlicher Kontext einer Spracheinheit innerhalb eines Textes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10acf824-32b1-46b2-b93a-6f56dae8ebb8",
                                "sense_id": "ad2a22af-f751-39b5-8f50-67b66d1c26ad",
                                "text": "In der Linguistik wird gelegentlich zwischen Kotext (sprachlicher Kontext, Kontext im engeren Sinn) und Kontext (Kontext im weiteren Sinn, kann auch die Redesituation einbeziehen) unterschieden."
                            },
                            {
                                "example_id": "f0723373-8f8c-4eea-9fa1-36a9574693c7",
                                "sense_id": "ad2a22af-f751-39b5-8f50-67b66d1c26ad",
                                "text": "„Als Textwort erfährt es durch die engere und weitere Umgebung (Kotext, Kontext und Situation) seine Prägung und grammatische Formung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
