                                    {
                                        "sense_id": "cc57d9d2-eb96-393d-ba28-9124dae0686f",
                                        "entry_id": "c046c7db-84ed-31e6-9509-241ab1df1a54",
                                        "glosses": [
                                            "A member of the Habsburg noble family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddcfe754-d6b0-4c1a-82cb-7f371204034e",
                                                "sense_id": "cc57d9d2-eb96-393d-ba28-9124dae0686f",
                                                "text": "Did European royals sometimes intermarry? Yes. There are a couple of examples of that. The Habsburgs are not beating the allegations."
                                            }
