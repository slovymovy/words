                "senses": [
                    {
                        "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                        "entry_id": "0f725262-ddea-3d66-94ef-7825a1e4b0ec",
                        "glosses": [
                            "Nichteinhaltung eines festgesetzten Termins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aec8116-31c7-40f9-ba9f-96eb352673c0",
                                "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                "text": "Wegen seiner Unpünktlichkeit verpasste er sein Vorstellungsgespräch."
                            },
                            {
                                "example_id": "af69494f-9135-46a4-bb0d-8801965af3ac",
                                "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                "text": "„Ebenso sehr wie die Pünktlichkeit ist es eine Tugend, von der Unpünktlichkeit seiner Mitmenschen kein Aufhebens zu machen.“"
                            },
                            {
                                "example_id": "44ce8a05-04d0-46ad-a717-ba526b4de469",
                                "sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                                "text": "„Unpünktlichkeit der Gäste erregte seinen Unwillen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cd31e30-5c54-4cb0-90f6-9d087ee2611d",
                        "source_entry_id": "0f725262-ddea-3d66-94ef-7825a1e4b0ec",
                        "source_sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                        "source_sense_description": "Nichteinhaltung eines festgesetzten Termins",
                        "target_lang_word": "tardiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tardiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd292948-7f7e-3d0d-9c16-db1a83762197",
                                        "entry_id": "24551963-657f-3963-9da6-228f2ec64360",
                                        "glosses": [
                                            "The state or quality of being tardy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b1d8167-8e93-4018-b6e5-10662f4fc18e",
                                                "sense_id": "fd292948-7f7e-3d0d-9c16-db1a83762197",
                                                "text": "Some ten years ago, an evening excursion train from the Walsall area to Manchester, when travelling well over the heavily-graded Walsall-Rugeley line, was brought to a stand at a level crossing at Hednesford by the tardiness of a gatekeeper, who was pottering about in his garden instead of attending to his duties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54e5994a-1e63-31cd-b2ad-3c56e6e34c15",
                                        "entry_id": "24551963-657f-3963-9da6-228f2ec64360",
                                        "glosses": [
                                            "The result or product of being tardy."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ca84941-8e9c-4e6d-9cf1-5c6f662f6f72",
                        "source_entry_id": "0f725262-ddea-3d66-94ef-7825a1e4b0ec",
                        "source_sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                        "source_sense_description": "Nichteinhaltung eines festgesetzten Termins",
                        "target_lang_word": "unpunctuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unpunctuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb0dda2-3eaf-31e7-99a2-c2fb4f3bb8d9",
                                        "entry_id": "e97e87b6-640f-394e-bc85-a4ff3535a38b",
                                        "glosses": [
                                            "Not being punctual; lateness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa9105ce-077d-4fea-bcca-01f2d435f715",
                                                "sense_id": "9fb0dda2-3eaf-31e7-99a2-c2fb4f3bb8d9",
                                                "text": "Thank you—but there is no escaping these little vexations, Mary, live where we may; and when you are settled in town and I come to see you, I dare say I shall find you with yours, in spite of the nurseryman and the poulterer—or perhaps on their very account. Their remoteness and unpunctuality, or their exorbitant charges and frauds will be drawing forth bitter lamentations."
                                            },
                                            {
                                                "example_id": "ca4d42cd-4a39-4485-993d-7e7ee2971a9d",
                                                "sense_id": "9fb0dda2-3eaf-31e7-99a2-c2fb4f3bb8d9",
                                                "text": "Yule soon became so accustomed to the din as to be undisturbed by the noise, but the unpunctuality and carelessness of the native workmen sorely tried his patience, of which Nature had endowed him with but a small reserve."
                                            },
                                            {
                                                "example_id": "68e540bc-b00f-4392-bec5-9383b752986e",
                                                "sense_id": "9fb0dda2-3eaf-31e7-99a2-c2fb4f3bb8d9",
                                                "text": "Thus he made a habit of long walks after dark on week-days and of unpunctuality at meals."
                                            },
                                            {
                                                "example_id": "5730772a-b322-4b61-8b4a-a9ef4798a592",
                                                "sense_id": "9fb0dda2-3eaf-31e7-99a2-c2fb4f3bb8d9",
                                                "text": "There is one golden rule of timetable work, that if a passenger train never runs to time it must be altered or other trains must be altered so that it can shake off its chronic unpunctuality."
                                            },
                                            {
                                                "example_id": "8e6114b3-824f-4ed3-a4ca-4fae9a2f0f97",
                                                "sense_id": "9fb0dda2-3eaf-31e7-99a2-c2fb4f3bb8d9",
                                                "text": "Thirty-one years ago I joined a railway in rather a hurry. My father's sudden death had just released the Metropolitan from the most persistent, accurate and belligerent critic of its unpunctuality. We were brought up in the belief that all trains ran to time before the war - the Kaiser's war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71582a33-2f79-4463-8c77-27662737a477",
                        "source_entry_id": "0f725262-ddea-3d66-94ef-7825a1e4b0ec",
                        "source_sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                        "source_sense_description": "Nichteinhaltung eines festgesetzten Termins",
                        "target_lang_word": "inexactitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inexactitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                        "entry_id": "b86d4952-59ba-39bf-a1ed-a5c10fe5ab62",
                                        "glosses": [
                                            "Défaut d’exactitude ou de précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c75c8d4-066b-4bdf-ad4b-2e90af7d0853",
                                                "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                                "text": "Le père Clément Pérès avait cru découvrir de légères inexactitudes dans ce dernier voyage ; il les avait marquées sur des feuilles volantes, et il me fit présent de ces notes."
                                            },
                                            {
                                                "example_id": "04af4d39-f3d3-43a9-b46d-0c3270957766",
                                                "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                                "text": "[…], il narra, en une esquisse sommaire et avec les omissions et les inexactitudes naturelles à son genre de mentalité, la série de ses aventures."
                                            },
                                            {
                                                "example_id": "9a4c82c2-586e-48e4-a931-c61abddb1a5f",
                                                "sense_id": "1c85232d-dc97-318b-9a8b-1f726fd31fae",
                                                "text": "Même fourmillement de fautes innombrables, d’erreurs ou d’inexactitudes phonétiques, dans les mots souletins que porte le dictionnaire du P. Lhande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "506230ac-5e4a-32c4-85d7-b9c0b411042f",
                                        "entry_id": "b86d4952-59ba-39bf-a1ed-a5c10fe5ab62",
                                        "glosses": [
                                            "Manque de régularité ou de ponctualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9bd575-5800-41a6-a8c1-e344bac81a2f",
                                                "sense_id": "506230ac-5e4a-32c4-85d7-b9c0b411042f",
                                                "text": "Milady B***, disait-il, avait eu la bonté de me donner un rendez-vous au bois de Boulogne et l’inhumanité d’y manquer. Au bout de deux heures, je m’ennuyai de l’attendre, et, de retour chez moi, je lui écrivis pour me plaindre de son inexactitude."
                                            },
                                            {
                                                "example_id": "f0600156-f0a4-4b26-9a5d-7d666b81ee32",
                                                "sense_id": "506230ac-5e4a-32c4-85d7-b9c0b411042f",
                                                "text": "Quand il entra dans le salon, tout le monde était réuni ; on l’attendait depuis dix minutes déjà pour se mettre à table, au grand mécontentement de M. Donis, qui n’admettait pas plus l’inexactitude pour un déjeuner que pour une échéance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a11da1f-821b-4fd5-88d4-ca73b1973b95",
                        "source_entry_id": "0f725262-ddea-3d66-94ef-7825a1e4b0ec",
                        "source_sense_id": "c7f3d862-49b6-3117-8338-914025718ed9",
                        "source_sense_description": "Nichteinhaltung eines festgesetzten Termins",
                        "target_lang_word": "manque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                        "entry_id": "9faf03f5-5043-34a2-a9b5-bcb754ddc629",
                                        "glosses": [
                                            "Absence, défaut, fait de manquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a3ec36-323a-407e-9697-1a6f6d0f7e00",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Le vieux von Winterfeld entra bientôt dans le coma ; parmi les blessés, trois se rétablissaient assez rapidement, alors que l’état des autres empirait, par suite du manque de bonne nourriture."
                                            },
                                            {
                                                "example_id": "8f3b2e26-9e08-42a6-8585-618dc3d5053a",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Pendant que les lames attaquaient mon vaillant navire […], je restai allongé sur ma couchette, philosophant sur le manque de confort de ma présente situation."
                                            },
                                            {
                                                "example_id": "51cb8182-92f8-45bf-8c73-c49f8f8d4774",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Lui non plus n’aurait pas voulu choquer Jim par son manque de délicatesse, mais sa nature brutale subitement l’emportait."
                                            },
                                            {
                                                "example_id": "fcefcbd8-b66f-499f-9d3d-a17f3f2b433a",
                                                "sense_id": "e6f95e98-a4c9-34a6-82b5-aaf1619fdb92",
                                                "text": "Moyennant quoi rien ne réfrénait sa connardise que le manque d’imagination. Il ne faisait de doute pour personne que le connard n’était pas réformable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                        "entry_id": "9faf03f5-5043-34a2-a9b5-bcb754ddc629",
                                        "glosses": [
                                            "État de stress dû à la privation d’une drogue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef284c7-459b-4883-8bc4-54c34db293ad",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "Il était encore trop tôt pour prévoir le « manque » d’April qui viendrait probablement un jour m’assaillir – le « manque » au sens où l’entendent ceux que la drogue a soumis, et qui la quittent, et dont le corps crie famine parce que ça leur a fait trop mal d’arracher le singe qui s’accrochait à leur dos. Et peut-être, d’ailleurs, ne connaîtrais-je pas ce « manque »."
                                            },
                                            {
                                                "example_id": "29ca7cea-ecb3-4358-b84d-e967e0e9f5fe",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "— Les gars des Stups prétendent que beaucoup de drogués prennent de la méthédrine quand ils ne peuvent se procurer de l’héro. Apparemment, ça les aide à supporter les douleurs du manque."
                                            },
                                            {
                                                "example_id": "36031178-9e05-4a6a-b0f3-08efba97a31e",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "Lorsqu’on joue aux cartes, malgré l’insignifiance des symptômes de manque, chacun fume comme une cheminée, même si sa consommation habituelle est très faible."
                                            },
                                            {
                                                "example_id": "2ab62254-4e33-4dfb-b875-4761724edc25",
                                                "sense_id": "8dca3c00-d77c-3f6d-8141-c270fe049657",
                                                "text": "— Je suis au fond du trou, dit–il au capitaine. Je suis en manque, je n'ai plus d'argent et je suis bien incapable de trouver un boulot pour en gagner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manque",
                                "target_lang_code": "fr",
                                "target_senses": [
