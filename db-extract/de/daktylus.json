                "senses": [
                    {
                        "sense_id": "1a9703ba-7300-3fcf-8447-32f9cb2052a6",
                        "entry_id": "199cfea9-630c-30b3-ad66-122a989fd661",
                        "glosses": [
                            "rhythmische Einheit, bei der erst eine lange oder betonte und dann zwei kurze oder unbetonte Silben auftreten (– υ υ)"
                        ],
                        "tags": [
                            "Lyrik"
                        ],
                        "examples": [
                            {
                                "example_id": "10519e7b-f96c-4c72-b5b2-e103d3880044",
                                "sense_id": "1a9703ba-7300-3fcf-8447-32f9cb2052a6",
                                "text": "„Das metrische Gegenteil des Daktylus ist der Anapäst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60b8751a-2c12-47b4-a2fa-7b0f354c8583",
                        "source_entry_id": "199cfea9-630c-30b3-ad66-122a989fd661",
                        "source_sense_id": "1a9703ba-7300-3fcf-8447-32f9cb2052a6",
                        "source_sense_description": "rhythmische Einheit, bei der eine lange/betonte und zwei kurze/nbetonte Silben auftreten (– υ υ)",
                        "target_lang_word": "dactyl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dactyl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb7c4751-5637-3df4-b6f0-7857b61e6b09",
                                        "entry_id": "99fb7a9e-b0a8-357e-b0c6-c5b895f83939",
                                        "glosses": [
                                            "A metrical foot of three syllables (— ⏑ ⏑), one long followed by two short, or one accented followed by two unaccented."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebc58ce-f6b8-4b52-9e34-d3117d9768dc",
                                                "sense_id": "cb7c4751-5637-3df4-b6f0-7857b61e6b09",
                                                "text": "Now the Bard, glad to get an audience, […] / stuck fast with his first hexameter, / Not one of all whose gouty feet would stir. // But ere the spavin'd dactyls could be spurr'd / Into recitative, in great dismay / Both cherubim and seraphim were heard / To murmur loudly through their long array; […]"
                                            },
                                            {
                                                "example_id": "959789e0-cb34-413d-a740-ca160e5837df",
                                                "sense_id": "cb7c4751-5637-3df4-b6f0-7857b61e6b09",
                                                "text": "—My name is absurd too: Malachi Mulligan, two dactyls. But it has a Hellenic ring, hasn't it?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74baebf6-7921-4ea0-8ecb-cbd1f2821fd9",
                        "source_entry_id": "199cfea9-630c-30b3-ad66-122a989fd661",
                        "source_sense_id": "1a9703ba-7300-3fcf-8447-32f9cb2052a6",
                        "source_sense_description": "rhythmische Einheit, bei der eine lange/betonte und zwei kurze/nbetonte Silben auftreten (– υ υ)",
                        "target_lang_word": "dactyle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dactyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cadd4e8a-2047-3578-aa82-0373e095a452",
                                        "entry_id": "d088c0e2-0758-3bb4-8bfb-e84c2f25f085",
                                        "glosses": [
                                            "Pied qui est formé d’une syllabe longue suivie de deux brèves, comme le doigt qui comporte une phalange longue et deux courtes."
                                        ],
                                        "tags": [
                                            "Versification"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2344a889-015a-4d52-b0e2-bef6c43228e4",
                                                "sense_id": "cadd4e8a-2047-3578-aa82-0373e095a452",
                                                "text": "Le vers hexamètre est composé de dactyles et de spondées."
                                            },
                                            {
                                                "example_id": "4af2f8cc-fa2e-4281-afe3-e283d97bceae",
                                                "sense_id": "cadd4e8a-2047-3578-aa82-0373e095a452",
                                                "text": "Quant aux groupes quadrisyllabes impairs (premier et troisième), des seize pieds quadrisyllabes, à priori, treize peuvent commencer le vers, onze ou douze peuvent commencer le second pâda ; en d’autres termes, 3 seulement sont interdits au commencement du 1ᵉʳ pâda, 4 ou 5 le sont au commencement du second. Quels sont ces trois et ces cinq ? Les trois sont le procéleusmatique, le dactyle et le choriambe ; les mêmes, plus le diïambe, voilà les 4, plus l’épitrite 3ᵉ, voilà les 5."
                                            },
                                            {
                                                "example_id": "54654e59-ed12-4acf-9a85-8a6589294349",
                                                "sense_id": "cadd4e8a-2047-3578-aa82-0373e095a452",
                                                "text": "LES VARIÉTÉS DE L’HEXAMÈTRE\nPartagé en deux hémistiches ce vers devient le priapéen ; Le buccolique, quand il l’est en deux, et une dipodie, séparées par une pause. Les deux premières dipodies forment le vers alcmanien ; Les deux dernières le phalisque ; La dernière l’adonique ; Le dernier hémistiche forme le phérécratien ; Une fraction d’un spondée et de deux dactyles forme un glyconique ; Et une fraction impaire forme le dactylique tétramètre catalectique. C’est un composé de trois pieds et demi ou une epthémimérie. Le miurus ou téliambe, mentionné dans le même tableau, n’est que le résultat d’un accident prosodique. Mais chacune de ces variétés a sa valeur mimique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dactyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3006f6d-894c-3e68-bbde-b1b717cfcde5",
                                        "entry_id": "b68b9bc7-43f2-321e-9948-b3d51358f980",
                                        "glosses": [
                                            "Nom usuel des plantes du genre Dactylis de la famille des Poacées, dont la forme des épis fait penser à des doigts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ee6fb7-4d30-4151-aa76-17845ac1035c",
                                                "sense_id": "d3006f6d-894c-3e68-bbde-b1b717cfcde5",
                                                "text": "Une association luzerne x dactyle produit plus de lait par hectare, mais moins de lait par vache, qu'une association luzerne x brome."
                                            },
                                            {
                                                "example_id": "1943383e-cedb-435d-acd5-a4be77a5f02d",
                                                "sense_id": "d3006f6d-894c-3e68-bbde-b1b717cfcde5",
                                                "text": "Puis, Gus avait récupéré les deux pattes coupées gisant dans les dactyles, avait saisi le faon, était remonté sur son tracteur avec le corps sans vie sur ses cuisses, puis s’était mis en route vers la ferme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dactyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b5b5f03-b630-3e08-bf6f-f70592ad7e45",
                                        "entry_id": "26634f8a-604b-3881-8abf-390da7f0aa5c",
                                        "glosses": [
                                            "Synonyme de datte de mer (espèce de mollusque bivalve de la famille des mytilidés (moules) (Lithophaga lithophaga))."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
