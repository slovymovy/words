                    }
                ],
                "senses": [
                    {
                        "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                        "entry_id": "323d96de-045d-3977-aa03-304200962e58",
                        "glosses": [
                            "ausschließlich von einem Elektromotor angetrieben"
                        ],
                        "tags": [
                            "Fahrzeuge"
                        ],
                        "examples": [
                            {
                                "example_id": "517df86b-dafe-40f0-b4fb-e6d4166a0cce",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„Eine aktuelle Studie […] zeigt […], dass heute in Europa verkaufte vollelektrische Autos über ihre Lebensdauer 73 Prozent weniger Treibhausgase ausstoßen als Benziner.“"
                            },
                            {
                                "example_id": "daa00578-f0d4-4e00-9542-7065beb43e7e",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„»Damit die Bundesregierung ihr Ziel von 15 Millionen vollelektrischen Pkw in 2030 erreichen kann, muss sie sich jetzt in Brüssel dafür einsetzen, dass der Vorschlag der EU-Kommission für die CO₂-Grenzwerte für Pkw nachgeschärft wird«, sagt Jens Hilgenberg, Leiter Verkehrspolitik des Bund für Umwelt und Naturschutz Deutschland.“"
                            },
                            {
                                "example_id": "37dce924-a1e6-4391-9f30-a5db135a5807",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "[2024:] „Die Jahresstatistik des Kraftfahrtbundesamtes (KBA) offenbart: Bei den Neuzulassungen sinkt erstmals der Anteil vollelektrischer Pkw - und zwar von 18,4 auf 13,5 Prozent.“"
                            },
                            {
                                "example_id": "67f9e0bc-2202-41b4-8818-966cf4bb5e42",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„BMW macht sein Stammwerk München zum Vorreiter beim Bau vollelektrischer Autos.“"
                            },
                            {
                                "example_id": "c8bc7f15-cd4e-414f-97f5-73a837ae36fc",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "[Schweiz:] „Im Juni wurden zum ersten Mal überhaupt mehr vollelektrische Autos als Dieselfahrzeuge verkauft.“"
                            },
                            {
                                "example_id": "ac4820ee-f81a-476f-afaa-348aae9ccf4d",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„Der schwedische Autohersteller Volvo Cars hat nach eigenen Angaben sein Ziel aufgegeben, bis 2030 nur noch vollelektrische Autos zu verkaufen.“"
                            },
                            {
                                "example_id": "d8dc159f-4cf9-459d-a526-cc179b3081a4",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„Toyota baute etwa 1500 Stück des vollelektrischen Geländewagens RAV4 EV, Nissan etwa 220 Stück Nissan Hypermini, und Honda den Honda EV Plus.“"
                            },
                            {
                                "example_id": "fc46e45d-f111-49b5-a6bf-2328c5e1484e",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„Als Vehikel bei ihrer Weltumrundung dient der jungen Abenteurerin ein vollelektrischer Ford Explorer.“"
                            },
                            {
                                "example_id": "245df9db-2d9b-4267-babd-07e00bb98e38",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "[Schlagzeile:] „W-LAN, Steckdosen und vollelektrisch: Der neue Akkuzug in Husum“"
                            },
                            {
                                "example_id": "322ea3e6-cf97-46f1-b3ab-518e64823caf",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„[…] Viele Strecken sind bislang nicht elektrifiziert, also ohne Oberleitungen. Die neuen Akku-Züge sollen genau dieses Problem lösen, denn sie fahren vollelektrisch, auch auf diesen Abschnitten.“"
                            },
                            {
                                "example_id": "aec356ba-561b-424d-a167-ac2e15ddc61a",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„Die ersten vollelektrischen Pistengeräte (Pistenraupe, Motorschlitten) sind bereits in Serienerzeugung, allerdings bisher nur für das Spuren von Loipen.“"
                            },
                            {
                                "example_id": "839eb048-8f3e-4d5e-8f45-502d360c7ab3",
                                "sense_id": "07022ca1-51f4-3f6b-9b09-f229b50d320c",
                                "text": "„Noch werden die allermeisten Pistenfahrzeuge mit Diesel betrieben. Im Skigebiet Flumserberg im Kanton St. Gallen ist seit knapp einem Monat das erste, in Serie produzierte, vollelektrische Pistenfahrzeug in Betrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
