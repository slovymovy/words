                                            {
                                                "example_id": "6a4167be-8b81-45da-8f00-0fce92e8ba3a",
                                                "sense_id": "8f2fbb8c-86b9-3a38-8464-46f1d989a320",
                                                "text": "She sits on a bench carved with names—“Jenna + Christo 4eva”—by the entrance to the sanctuary and pulls her shoes back on."
                                            },
                                            {
                                                "example_id": "7a25c0db-2215-4bb1-a74f-e044a4d3ce25",
                                                "sense_id": "8f2fbb8c-86b9-3a38-8464-46f1d989a320",
                                                "text": "Apparently, Stacey H. was here, Jessica & Naomi were BFFs 4Eva, and someone wished K. P. a gruesome death."
                                            },
                                            {
                                                "example_id": "29bf1ff3-845a-4a0b-b9b0-68ac3ed5684c",
                                                "sense_id": "8f2fbb8c-86b9-3a38-8464-46f1d989a320",
                                                "text": "I stared down at the rutted wood of the table. “LB luvs AJ 4eva” was centered between my hands, […]"
                                            }
