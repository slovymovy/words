                    }
                ],
                "senses": [
                    {
                        "sense_id": "92ab5e29-d05a-38b6-a794-e90a9126269b",
                        "entry_id": "22d0769c-1090-3c5d-9cba-f77c78d0c8ab",
                        "glosses": [
                            "odgłos tarcia twardych przedmiotów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ccf454d-7d29-4259-b274-5182231cec4f",
                                "sense_id": "92ab5e29-d05a-38b6-a794-e90a9126269b",
                                "text": "Rozległ się przeraźliwy zgrzyt dawno nieotwieranej ciężkiej bramy."
                            },
                            {
                                "example_id": "51c24c6c-74ee-4bd3-8b7c-540c05e5abab",
                                "sense_id": "92ab5e29-d05a-38b6-a794-e90a9126269b",
                                "text": "Chroboty i zgrzyty mechanizmu nie wróżyły mu długiej żywotności."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9c157656-1b68-3f64-8d9d-9fb26ebf7e2c",
                        "entry_id": "22d0769c-1090-3c5d-9cba-f77c78d0c8ab",
                        "glosses": [
                            "przykre zdarzenie, niemiła sytuacja"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "1bcad799-ae5f-445d-b746-7b0016a2eff6",
                                "sense_id": "9c157656-1b68-3f64-8d9d-9fb26ebf7e2c",
                                "text": "Niefortunna wypowiedź nieradzącego sobie z językiem obcym urzędnika państwowego była z jednej strony dyplomatycznym zgrzytem, z drugiej – obiektem kpin, żartów i niezliczonych memów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7799c066-553f-4c0d-8215-ba52e3506254",
                        "source_entry_id": "22d0769c-1090-3c5d-9cba-f77c78d0c8ab",
                        "source_sense_id": "92ab5e29-d05a-38b6-a794-e90a9126269b",
                        "target_lang_word": "stridor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stridor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd07fe5-951d-37af-9cb7-8061f45abd42",
                                        "entry_id": "5b1b6213-2b29-39f7-8677-8547b362a174",
                                        "glosses": [
                                            "A harsh, shrill, unpleasant noise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ccffb70-59c1-4a46-a4c3-817132cdea8f",
                                                "sense_id": "1fd07fe5-951d-37af-9cb7-8061f45abd42",
                                                "text": "But when the tilted plank let slide its freight into the sea, a second strange human murmur was heard, blended now with another inarticulate sound proceeding from certain larger sea-fowl, whose attention having been attracted by the peculiar commotion in the water resulting from the heavy sloped dive of the shotted hammock into the sea, flew screaming to the spot. So near the hull did they come, that the stridor or bony creak of their gaunt double-jointed pinions was audible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4987951-a8d6-3d36-9a87-474558a63d74",
                                        "entry_id": "5b1b6213-2b29-39f7-8677-8547b362a174",
                                        "glosses": [
                                            "A high-pitched sound heard on inspiration resulting from turbulent air flow in the upper airway usually indicative of serious airway obstruction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1eb261e-df59-4ee5-8a24-912b5eaba81d",
                                                "sense_id": "b4987951-a8d6-3d36-9a87-474558a63d74",
                                                "text": "Her breath-holding increased in duration to almost a minute; her expirations became complicated by stridor, forced retching, and forced phonations ('Oouuggh!')."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32c23b7a-c2f5-49b3-a431-0cba8007e166",
                        "source_entry_id": "22d0769c-1090-3c5d-9cba-f77c78d0c8ab",
                        "source_sense_id": "92ab5e29-d05a-38b6-a794-e90a9126269b",
                        "target_lang_word": "creak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "813e54f1-c78d-30e4-8eed-ca3d65764919",
                                        "entry_id": "a90b4dc6-008e-3a67-9193-c4c4dc4375d8",
                                        "glosses": [
                                            "The sound produced by anything that creaks; a creaking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "creak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3171cac5-d9b8-338b-a5ca-72bdb3d5a462",
                                        "entry_id": "83db451f-7f38-3518-b1de-027b78ff213d",
                                        "glosses": [
                                            "To make a prolonged sharp grating or squeaking sound, as by the friction of hard substances."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec28d862-4536-4c00-9fe7-795d12ddb069",
                                                "sense_id": "3171cac5-d9b8-338b-a5ca-72bdb3d5a462",
                                                "text": "Then when the four ropes were arranged the coffin was placed upon them. He watched it descend; it seemed descending for ever. At last a thud was heard; the ropes creaked as they were drawn up."
                                            },
                                            {
                                                "example_id": "7e38cfc5-1521-449e-aacf-ef721f403598",
                                                "sense_id": "3171cac5-d9b8-338b-a5ca-72bdb3d5a462",
                                                "text": "He heard the creaking of the bolt as it came slowly back, and at the same moment he found the monkey's paw, and frantically breathed his third and last wish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "055ae753-6fe4-35f5-b625-d6178b959fa6",
                                        "entry_id": "83db451f-7f38-3518-b1de-027b78ff213d",
                                        "glosses": [
                                            "To produce a creaking sound with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6bf0cf6-3261-44af-a6c3-3fffcccb98a9",
                                                "sense_id": "055ae753-6fe4-35f5-b625-d6178b959fa6",
                                                "text": "Creaking my shoes on the plain masonry."
                                            },
                                            {
                                                "example_id": "42dd52b5-b8d9-4218-94f9-8122b2591e7f",
                                                "sense_id": "055ae753-6fe4-35f5-b625-d6178b959fa6",
                                                "text": "I miss the polished brass, the powerful black horses,\nThe drivers creaking the seats of the baroque hearses, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1318ed40-859e-362e-84d3-2bc1ab56c7b2",
                                        "entry_id": "83db451f-7f38-3518-b1de-027b78ff213d",
                                        "glosses": [
                                            "To suffer from strain or old age."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24aa4e19-ab1c-4e7f-9b1c-d845f270fdad",
                                                "sense_id": "1318ed40-859e-362e-84d3-2bc1ab56c7b2",
                                                "text": "Fascinating though this high-minded re-reading was, certain crucial joints of the play creaked a good deal under the strain."
                                            },
                                            {
