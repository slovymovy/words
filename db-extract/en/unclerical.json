                        "entry_id": "fd48f1e1-01d0-3be8-888e-90cd33ab6ecb",
                        "glosses": [
                            "Not clerical."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74782c9c-3abd-459e-a856-81d49c4432d2",
                                "sense_id": "388bba57-8d5e-3c18-a7a8-5041bc2f9d61",
                                "text": "The solitary muezzin, who cried the mughreb at the close of the fast, and lighted the lamps on his minaret, went through with his work in most unclerical haste, now that there was no one to notice him."
                            },
                            {
                                "example_id": "d02a00d9-90bb-44c2-a642-d759e190b91d",
                                "sense_id": "388bba57-8d5e-3c18-a7a8-5041bc2f9d61",
                                "text": "A more remorseless foe, however, than Foote appeared in the person of Charles Churchill, the wild and unclerical son of a poor curate of Westminster."
                            },
                            {
                                "example_id": "1012a67a-052e-4b2b-ba4d-b6f85c636d3a",
                                "sense_id": "388bba57-8d5e-3c18-a7a8-5041bc2f9d61",
                                "text": "She drew from her gloved palm her offering and extended it towards Brother Weldon, who with unclerical haste and noise took the office."
                            },
                            {
                                "example_id": "435dabe1-bd96-4caa-9f18-2ad3878ce3b1",
                                "sense_id": "388bba57-8d5e-3c18-a7a8-5041bc2f9d61",
                                "text": "As they came to the churchyard, the grave-digger was just busy at a grave, and it was quiet about him; no sheep, no goat came and desecrated man's last resting-place; for in this village the churchyard was no pasture for unclerical animals."
                            }
                        ]
                    }
