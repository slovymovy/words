                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "8e0466bc-966c-4ab9-be01-e2ca50f5c918",
                                "sense_id": "c2106b51-bbe2-3de6-8520-b875a4bc1ea3",
                                "text": "Drives the profane from Mystery's bolted door, / And Suilence guards the Eleusinian lore."
                            },
                            {
