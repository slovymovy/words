                        ],
                        "examples": [
                            {
                                "example_id": "64226e1d-383c-4595-84b4-dcd4a762953e",
                                "sense_id": "a724439d-3fa4-33c8-aa3c-d882972720fb",
                                "text": "Wydawało jej się kiedyś, że oboje z chłopem będą zawsze młodzi, silni i urodni, a tymczasem ciężkie pożycie małżeńskie wyssało krzepkość cielesną, odbarwiło krwiste policzki w bledziznę codziennych wyczerpań, pożarło ponętność urody"
                            }
                        ],
