                "senses": [
                    {
                        "sense_id": "6d7e06aa-30c6-3a81-b1c4-9a1eb5dc3d2f",
                        "entry_id": "62ce3786-4c10-3ca2-a0c7-847ac3d5f19e",
                        "glosses": [
                            "laska opleciona winoroślą i bluszczem oraz zakończona szyszką sosny pinii; atrybut Dionizosa (Bachusa), menad (bachantek) i satyrów; symbol płodności"
                        ],
                        "tags": [
                            "Ancient-Greek",
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "1341750d-2c59-4a54-9e62-77a6ba07e3d0",
                                "sense_id": "6d7e06aa-30c6-3a81-b1c4-9a1eb5dc3d2f",
                                "text": "Atrybutami Dionizosa były: tyrs, kielich (kantaros), wino, wieniec z bluszczu lub winorośli, kiść winogron, delfin, lampart, leopard, lew, osioł, pantera i róg."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bab123b1-5c60-4b0e-a3d0-8bb93eba3f9e",
                        "source_entry_id": "62ce3786-4c10-3ca2-a0c7-847ac3d5f19e",
