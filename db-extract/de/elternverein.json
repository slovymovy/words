                ],
                "senses": [
                    {
                        "sense_id": "1c0393f0-72f0-39ab-8457-6d53b7c52fd6",
                        "entry_id": "fbe79efb-1b15-3bf1-8c1c-2f2a092cca91",
                        "glosses": [
                            "organisierte Gruppe (Verein) von Eltern, deren Kinder meistens eine bestimmte Bildungseinrichtung besuchen, die diese unterstützt und die Interessen der Eltern und Kinder vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2546497a-27bc-4abb-9e47-47b1065d5220",
                                "sense_id": "1c0393f0-72f0-39ab-8457-6d53b7c52fd6",
                                "text": "„Eine weitere Kita in der Mudra-Kaserne wird vom Elternverein EG Kiddy betrieben.“"
                            },
                            {
                                "example_id": "d05444b6-a8cf-451b-920c-3ea06b9cfedf",
                                "sense_id": "1c0393f0-72f0-39ab-8457-6d53b7c52fd6",
                                "text": "„Lokale Produzenten und Kunsthandwerker laden ein, auch der Elternverein der Volksschule ist mit einem Basar vertreten.“"
                            },
                            {
                                "example_id": "dfa9a95b-5bf5-4192-a7fa-80dfefe6a066",
                                "sense_id": "1c0393f0-72f0-39ab-8457-6d53b7c52fd6",
                                "text": "„Die Lokalpolitikerin mit einer Leitungsfunktion in ihrer Partei hat in ihrer Rolle als Kassiererin im Elternverein das Konto zwischen 2019 und 2023 allein verwaltet.“"
                            },
                            {
                                "example_id": "77c19be3-7727-4e02-80f8-7b4eeaf901e0",
                                "sense_id": "1c0393f0-72f0-39ab-8457-6d53b7c52fd6",
                                "text": "„Der Elternverein Korczak-Haus Freiburg ist Träger der Janusz-Korczak-Schule, eines Schulkindergartens und eines Familienentlastenden Dienstes für Kinder und Jugendliche mit einer schweren Mehrfachbehinderung.“"
                            },
                            {
                                "example_id": "30232669-dbe8-4ed1-9f43-d19aa0174d9c",
                                "sense_id": "1c0393f0-72f0-39ab-8457-6d53b7c52fd6",
                                "text": "„Diese Ferienbetreuung findet in Kooperation mit dem Elternverein der Sonderschule für Kinder mit erhöhtem Förderbedarf (SeF Klagenfurt/Waidmannsdorf) und der Mobilen Kinderkrankenpflege Kärnten (MOKI) statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
