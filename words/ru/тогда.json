    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "415560e2-86f5-31bd-814d-1410f87d4319",
                    "sense_definition": "в то время, не теперь",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сейчас здесь стоят дома, а <w>тогда</w> шумел лес.",
                            "target_lang_translations": {
                                "en": "Now houses stand here, but <w>then</w> a forest rustled.",
                                "zh": "现在这里盖起了房子，而<w>当时</w>这里是一片森林。"
                            }
                        },
                        {
                            "text": "Мы <w>тогда</w> жили в маленьком городе.",
                            "target_lang_translations": {
                                "en": "We lived in a small town <w>then</w>.",
                                "zh": "我们<w>那时</w>住在一个小城市里。"
                            }
                        }
                    ],
                    "antonyms": [
                        "сейчас",
                        "теперь"
                    ],
                    "common_phrases": [
                        "именно тогда",
                        "только тогда"
                    ],
                    "target_lang_definitions": {
                        "en": "at that time, not now",
                        "zh": "指过去某个特定的时间，而非现在"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "at that time"
                            },
                            {
                                "target_lang_word": "at that time",
                                "target_lang_sense_clarification": "specific past moment"
                            },
                            {
                                "target_lang_word": "back then",
                                "target_lang_sense_clarification": "in the past"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当时",
                                "target_lang_sense_clarification": "指过去发生某事的时间点"
                            },
                            {
                                "target_lang_word": "那时",
                                "target_lang_sense_clarification": "指过去的一段时间或时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f93cc849-1681-37f0-bd93-62377b04d34a",
                    "sense_definition": "в таком случае",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Тогда</w> я пойду домой.",
                            "target_lang_translations": {
                                "en": "<w>Then</w> I will go home.",
                                "zh": "<w>那么</w>我就回家了。"
                            }
                        },
                        {
                            "text": "Ты не хочешь есть? <w>Тогда</w> выпей чаю.",
                            "target_lang_translations": {
                                "en": "You don't want to eat? <w>Then</w> have some tea.",
                                "zh": "你不想吃东西吗？<w>那么</w>喝点茶吧。"
                            }
                        }
                    ],
                    "antonyms": [
                        "иначе"
                    ],
                    "common_phrases": [
                        "ну тогда",
                        "что тогда"
                    ],
                    "target_lang_definitions": {
