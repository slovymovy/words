                            },
                            {
                                "target_lang_word": "labyrinthisch",
                                "target_lang_sense_clarification": "wie ein Irrgarten gebaut"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5a164ce-19b3-38ad-8605-48236244d9c6",
