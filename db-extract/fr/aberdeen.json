                                                "sense_id": "ce9531ba-781c-3123-b6ca-a8df046b36fa",
                                                "text": "„Im Kirchspiel Monymusk in der Grafschaft Aberdeen sah man im J. 1720 noch keinen Nadelbaum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
