                        ],
                        "form": "die Tange"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                        "entry_id": "e8932c08-9e79-3173-b659-490c9b5c7641",
                        "glosses": [
                            "lange, feste Pflanze, die im Wasser wächst und zusammenhängende Bestände bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a8973d-9d63-42d4-8112-a794c5e0e44e",
                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                "text": "Im ganzen See wächst Tang."
                            },
                            {
                                "example_id": "73ae671d-a38d-4bdc-9c4d-e7f22a2a6c07",
                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                "text": "„Ich glaube, ich roch die Klippen und den Tang und das Schäumen der Wellen, die Schärfe des Jods und den darunterliegenden Geruch von ausgewaschenen und zerbrochenen Kalkmuscheln.“"
                            },
                            {
                                "example_id": "ad544857-aa48-4ce9-b449-b8e63cb42898",
                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                "text": "„Die Ankerpflüge verhakten sich an einem mit Tang bewachsenen Felsbrocken auf dem Grund, und langsam drehte sich die Glamour in den Wind.“"
                            },
                            {
                                "example_id": "16174ce1-050c-4c88-9e5a-d22b2b2eac85",
                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                "text": "„Über der Küste lag der Geruch von Salz und Tang, vermischt mit der erdigen Luft des Landes.“"
                            },
                            {
                                "example_id": "654d3007-a4fe-4b20-bc9c-de5d977659a4",
                                "sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                                "text": "„Es roch nach Tang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "172234b8-7f8c-4d44-b7d6-2c168afdb091",
                        "source_entry_id": "e8932c08-9e79-3173-b659-490c9b5c7641",
                        "source_sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                        "source_sense_description": "lange, feste Pflanze, die im Wasser wächst und zusammenhängende Bestände bildet",
                        "target_lang_word": "seaweed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seaweed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                        "entry_id": "3dbf5a23-1631-3adb-b23d-addcda3c0d0c",
                                        "glosses": [
                                            "Any of numerous marine algae, such as a kelp."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "044ea1fe-2292-490a-b7cc-7d8838db85fb",
                                                "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                                "text": "We have lingered in the chambers of the sea / By sea-girls wreathed with seaweed red and brown / Till human voices wake us, and we drown."
                                            },
                                            {
                                                "example_id": "8e0a2fe6-bf3d-4f2f-a468-9fa0c806c308",
                                                "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            },
                                            {
                                                "example_id": "7aa4c786-3ebd-48f0-b7a9-0a62ff3ee65e",
                                                "sense_id": "01208ac5-d55c-369d-9b8f-739170091914",
                                                "text": "There has been some investigation into the potential of seaweeds as a carbon store, and although more is needed, one study says that seaweed habitats are believed to be the most productive of all coastal vegetated ecosystems, and suggested that the world’s seaweed sequesters as much carbon as all the planet’s seagrass meadows, saltmarshes and mangroves combined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "345730c1-9f87-3c99-af42-5dd0a0fd8d21",
                                        "entry_id": "3dbf5a23-1631-3adb-b23d-addcda3c0d0c",
                                        "glosses": [
                                            "Any of various fresh water plants and algae."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24cdb8c9-e5c3-4ccd-8790-82983dfe94f1",
                                                "sense_id": "345730c1-9f87-3c99-af42-5dd0a0fd8d21",
                                                "text": "With light penetrating to the lake bottom, beds of seaweed flourished where little had grown before."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30598fa0-4d0b-4639-b1f2-beb8e8982fdd",
                        "source_entry_id": "e8932c08-9e79-3173-b659-490c9b5c7641",
                        "source_sense_id": "1280ed62-e21c-368d-94b4-e4b3fe156de3",
                        "source_sense_description": "lange, feste Pflanze, die im Wasser wächst und zusammenhängende Bestände bildet",
                        "target_lang_word": "varech",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "varech",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                        "entry_id": "3bb886b8-a244-38ba-9e8f-d30a60e029f8",
                                        "glosses": [
                                            "Algue ou plante marine qui pousse sur les roches que la mer tantôt couvre et tantôt laisse à sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd1d2737-a24a-417b-9699-0321d8737d16",
                                                "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                                "text": "Ces Algues sont très souvent sur nos côtes désignées sous le nom vulgaire de Goëmon ou de Varech, bien que ce dernier nom ne doive s’appliquer qu’à une plante phanérogame mais maritime : la Zostère, du grec Zoster, ceinture."
                                            },
                                            {
                                                "example_id": "4b6b4940-0d06-4e33-b815-78646733c5e6",
                                                "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                                "text": "Il n'est pas rare de voir les maraîchers rétais charger le varech providentiel sur leurs remorques pour en engraisser les parcelles de pommes de terre."
                                            },
                                            {
                                                "example_id": "94cd9bef-843b-4cf4-8860-795f249699de",
                                                "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                                "text": "C’étaient de longs filaments de varechs qui, on n'en pouvait douter, avaient été récemment arrachés au continent américain !"
                                            },
                                            {
                                                "example_id": "da1e8bf7-9f50-46df-9f32-cdb03ff63914",
                                                "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                                "text": "Des rochers bas, couverts de mousses et de varechs, émergent à marée basse. On pêche la crevette et l’équille."
                                            },
                                            {
                                                "example_id": "5b0ac3b3-8879-4ae7-bd8c-661fef6c83a7",
                                                "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                                "text": "[…] ces matins blafards où l’on rentrait avec un masque de poussière et de fatigue, des odeurs de pipe, de pétrole, de vieux varech collées aux vêtements."
                                            },
                                            {
                                                "example_id": "f4fb10d2-d75c-442f-b6e6-6e4468f1c0ab",
                                                "sense_id": "44eb6890-515c-300e-b33f-22dd5361bbba",
                                                "text": "L’Atlantique était devant moi tout à l’heure, puis il avait disparu dans la grève, comme font les décors dans les trappes, et je marchais à présent au milieu d’un désert. Seuls, la sensation, le souffle de l’eau salée demeuraient en moi. Je sentais l’odeur du varech, l’odeur de la vague, la rude et bonne odeur des côtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11411a9-202e-33b1-a9ae-8e8ce291e6c9",
                                        "entry_id": "3bb886b8-a244-38ba-9e8f-d30a60e029f8",
                                        "glosses": [
                                            "Débris que la mer rejette sur ses côtes."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
