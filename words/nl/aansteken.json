    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8bc74cc-7f2e-339d-8394-bd0d300275a9",
                    "sense_definition": "iets doen branden of ontbranden",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "brand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een kleine aansteker kun je de sigaret gemakkelijk <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "With a small lighter, you can easily <w>light</w> the cigarette."
                            }
                        },
                        {
                            "text": "Zodra het donker wordt, zal ik de kaarsen in de woonkamer <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "As soon as it gets dark, I will <w>light</w> the candles in the living room."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontsteken"
                    ],
                    "antonyms": [
                        "doven",
                        "uitmaken",
                        "blussen"
                    ],
                    "common_phrases": [
                        "kaarsen aansteken",
                        "het vuur aansteken",
                        "een sigaret aansteken"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause something to burn or ignite"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "light",
                                "target_lang_sense_clarification": "to set fire to something like a candle or cigarette"
                            },
                            {
                                "target_lang_word": "ignite",
                                "target_lang_sense_clarification": "to set fire to or cause to burn"
                            },
                            {
                                "target_lang_word": "set fire to",
                                "target_lang_sense_clarification": "to cause something to start burning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e68b125-3fb2-34cf-9f07-4c91a2c94c50",
                    "sense_definition": "een ziekte of een negatief gevoel overdragen op iemand anders",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "besmetting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben door mijn zieke collega <w>aangestoken</w> met de griep.",
                            "target_lang_translations": {
                                "en": "I was <w>infected</w> with the flu by my sick colleague."
                            }
                        },
                        {
                            "text": "Zijn enthousiasme zal de hele groep <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "His enthusiasm will <w>infect</w> the whole group."
                            }
                        }
                    ],
                    "synonyms": [
                        "besmetten",
                        "overdragen"
                    ],
                    "common_phrases": [
                        "iemand aansteken",
                        "met de griep aansteken"
                    ],
                    "target_lang_definitions": {
                        "en": "to pass on a disease or a negative feeling to someone else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "infect",
                                "target_lang_sense_clarification": "to pass on a disease or a strong emotion"
                            },
                            {
                                "target_lang_word": "pass on",
                                "target_lang_sense_clarification": "to transmit a sickness or feeling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf7721bc-64f3-3942-878b-e9af4e0dc5bb",
                    "sense_definition": "beginnen met het tappen uit een vat of verpakking",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tappen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De waard besloot om een nieuw vat bier voor de gasten <w>aan te steken</w>.",
                            "target_lang_translations": {
                                "en": "The innkeeper decided to <w>tap</w> a new barrel of beer for the guests."
                            }
                        },
                        {
                            "text": "We zullen vanavond die speciale fles wijn eindelijk eens <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "We will finally <w>broach</w> that special bottle of wine tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanslaan",
                        "openen"
                    ],
                    "common_phrases": [
                        "een vat aansteken"
                    ],
                    "target_lang_definitions": {
                        "en": "to start tapping from a barrel or opening a package"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tap",
                                "target_lang_sense_clarification": "to open a barrel or cask to draw liquid"
                            },
                            {
                                "target_lang_word": "broach",
                                "target_lang_sense_clarification": "to pierce or open a cask or bottle to begin drinking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ce8de1b-5e2a-3729-924e-5593b6dfeea0",
                    "sense_definition": "iets met een scherp voorwerp of speld vastmaken",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilde de broche voorzichtig op haar nieuwe jurk <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "She wanted to carefully <w>pin</w> the brooch onto her new dress."
                            }
                        },
                        {
                            "text": "Je kunt de memo met een punaise op het bord <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "You can <w>pin</w> the memo to the board with a thumbtack."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastspelden",
                        "vaststeken"
                    ],
                    "target_lang_definitions": {
                        "en": "to fasten something with a sharp object or pin"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pin",
                                "target_lang_sense_clarification": "to fasten with a pin or tack"
                            },
                            {
                                "target_lang_word": "pin on",
                                "target_lang_sense_clarification": "to attach something using a pin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89b24ccf-c000-381f-9e9e-bf25daeab43e",
                    "sense_definition": "het herstellen van een beschadigde veer bij een vogel met een naald",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "valkerij",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De valkenier moest de gebroken vleugelpen van de havik vakkundig <w>aansteken</w>.",
                            "target_lang_translations": {
                                "en": "The falconer had to skillfully <w>imp</w> the hawk's broken wing feather."
                            }
                        },
                        {
                            "text": "Bij het <w>aansteken</w> van de veer wordt een dunne naald in de schacht geplaatst.",
                            "target_lang_translations": {
                                "en": "When <w>imping</w> the feather, a thin needle is placed into the shaft."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de valkerij"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to repair a bird's damaged feather using a needle (falconry term)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "imp",
                                "target_lang_sense_clarification": "to repair a broken feather by grafting"
                            }
                        ]
                    }
                }
            ]
        }
    ]
