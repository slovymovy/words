                "senses": [
                    {
                        "sense_id": "414766be-de83-3947-9f5e-2137b3490c26",
                        "entry_id": "cff95a2d-cc35-3212-9f58-7db788b8c948",
                        "glosses": [
                            "Donner un caractère rappelant le poisson (ou les poissons) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a5e904-dea9-4753-866f-a70778b74ee0",
                                "sense_id": "414766be-de83-3947-9f5e-2137b3490c26",
                                "text": "Une fois découpé en tranches, ne restera plus qu'à «poissonniser» notre seitan en le pochant dans un bouillon à base notamment d'algues."
                            },
                            {
                                "example_id": "193ad55c-e524-4643-a6e6-e3e2b409b3b4",
                                "sense_id": "414766be-de83-3947-9f5e-2137b3490c26",
                                "text": "Très juste, et belle, critique, vous m'ôtez les mots de la bouche (j'aurais vraiment voulu rapporter dans ce commentaire la citation sur les reptiles qui veulent se poissonniser...)."
                            }
                        ]
                    },
                    {
                        "sense_id": "bada5db9-051c-328a-a705-947cda8f99a1",
                        "entry_id": "cff95a2d-cc35-3212-9f58-7db788b8c948",
                        "glosses": [
                            "Faire un poisson d’avril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f834e5-d0d3-4ad3-a26c-ddb030d4c2a0",
                                "sense_id": "bada5db9-051c-328a-a705-947cda8f99a1",
                                "text": "C'est vrai qu'on est le 1ᵉʳ avril !!! Bien !! Franchement, si j'avais voulu poissonniser, j'aurais raconté un truc du genre Drogba revient à l'OM ou Gerrard signe à Everton, pas notre Benach' national dans un club à 2 fr. non ?"
                            }
                        ]
                    }
