                            "text": "Alle asbesthoudende schuren zijn inmiddels <w>gesloopt</w> om plaats te maken voor zonnepanelen.",
                            "target_lang_translations": {
                                "en": "All asbestos-containing sheds have since been <w>torn down</w> to make room for solar panels."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of the verb 'to demolish' or 'to tear down'."
                    },
                    "translations": {
