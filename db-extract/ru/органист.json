                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ac7ae180-721b-3a90-9b40-22b40c7f91ac",
                                        "entry_id": "76b9072a-6325-3da1-833a-5baa3850d3ea",
                                        "glosses": [
                                            "muzyk grający na organach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
