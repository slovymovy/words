{
    "word_family": [
        "kriebel",
        "gekriebel",
        "kriebelig",
        "kriebeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "661aeb52-9044-3170-9d2a-72722aa49277",
                    "sense_definition": "Een licht jeukend of kietelend gevoel veroorzaken of hebben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "jeuk_en_kietelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe wollen trui <w>kriebelde</w> enorm in mijn nek.",
                            "target_lang_translations": {
                                "en": "The new woolen sweater <w>itched</w> terribly on my neck."
                            }
                        },
                        {
                            "text": "Ik moet lachen omdat die veer zo op mijn voet <w>kriebelt</w>.",
                            "target_lang_translations": {
                                "en": "I have to laugh because that feather <w>tickles</w> my foot so much."
                            }
                        }
                    ],
                    "synonyms": [
                        "kietelen",
                        "jeuken"
                    ],
                    "common_phrases": [
                        "in de keel kriebelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause or have a light itchy or tickling sensation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tickle",
                                "target_lang_sense_clarification": "to cause a light, tingling sensation"
                            },
                            {
                                "target_lang_word": "itch",
                                "target_lang_sense_clarification": "to cause or feel an irritating sensation on the skin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e6a5ca-c9b2-3ab9-8ede-f9d19cbf84af",
                    "sense_definition": "Met heel kleine, onduidelijke letters schrijven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schrijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bijziende vrouw <w>kriebelde</w> haar naam onleesbaar klein op het formulier.",
                            "target_lang_translations": {
                                "en": "The near-sighted woman <w>scribbled</w> her name illegibly small on the form."
                            }
                        },
                        {
                            "text": "Hij <w>kriebelt</w> altijd zijn aantekeningen in de kantlijn van zijn boeken.",
                            "target_lang_translations": {
                                "en": "He always <w>scrawls</w> his notes in the margins of his books."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een briefje kriebelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe messy or tiny handwriting"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To write with very small, messy, or illegible letters"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrawl",
                                "target_lang_sense_clarification": "to write in a hurried, untidy way"
                            },
                            {
                                "target_lang_word": "scribble",
                                "target_lang_sense_clarification": "to write quickly and messily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}