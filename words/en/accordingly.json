{
    "word_family": [
        "accord",
        "accordance",
        "accordant",
        "according"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "18f86c6c-b912-370b-8c7e-8121a88a250c",
                    "sense_definition": "As a result of something already mentioned; in a way that follows logically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logical consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecast predicted heavy rain; <w>accordingly</w>, the outdoor concert was canceled.",
                            "target_lang_translations": {
                                "ru": "Прогноз погоды обещал сильный дождь; <w>соответственно</w>, концерт на открытом воздухе был отменен.",
                                "nl": "Het weerbericht voorspelde zware regen; <w>daarom</w> werd het buitenconcert afgelast."
                            }
                        },
                        {
                            "text": "Our preparations were all finished. <w>Accordingly</w>, we set sail.",
                            "target_lang_translations": {
                                "ru": "Наши приготовления были завершены. <w>Следовательно</w>, мы отправились в плавание.",
                                "nl": "Onze voorbereidingen waren allemaal afgerond. <w>Bijgevolg</w> hijsten we de zeilen."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequently",
                        "therefore",
                        "hence",
                        "so"
                    ],
                    "target_lang_definitions": {
                        "ru": "Как результат чего-либо уже упомянутого; логическим образом.",
                        "nl": "Als gevolg van iets dat al genoemd is; op een manier die er logisch uit volgt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следовательно",
                                "target_lang_sense_clarification": "в силу этого, поэтому"
                            },
                            {
                                "target_lang_word": "таким образом",
                                "target_lang_sense_clarification": "вследствие этого"
                            },
                            {
                                "target_lang_word": "соответственно",
                                "target_lang_sense_clarification": "в связи с этим"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "daarom",
                                "target_lang_sense_clarification": "om die reden"
                            },
                            {
                                "target_lang_word": "bijgevolg",
                                "target_lang_sense_clarification": "als logisch gevolg"
                            },
                            {
                                "target_lang_word": "derhalve",
                                "target_lang_sense_clarification": "dus, dientengevolge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f4eac6f-c807-323d-b8fb-ce3f4cde3aae",
                    "sense_definition": "In a way that is appropriate to the particular circumstances or situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rules have changed, and you must adjust your behavior <w>accordingly</w>.",
                            "target_lang_translations": {
                                "ru": "Правила изменились, и вы должны <w>соответствующим образом</w> скорректировать свое поведение.",
                                "nl": "De regels zijn veranderd en je moet je gedrag <w>dienovereenkomstig</w> aanpassen."
                            }
                        },
                        {
                            "text": "When the kitchen equipment changed, the chefs had to change their cooking styles <w>accordingly</w>.",
                            "target_lang_translations": {
                                "ru": "Когда кухонное оборудование изменилось, поварам пришлось <w>соответственно</w> изменить свой стиль приготовления пищи.",
                                "nl": "Toen de keukenapparatuur veranderde, moesten de chefs hun kookstijl <w>overeenkomstig</w> aanpassen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "act accordingly",
                        "adjust accordingly",
                        "proceed accordingly",
                        "plan accordingly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способом, который соответствует конкретным обстоятельствам или ситуации.",
                        "nl": "Op een manier die passend is bij de specifieke omstandigheden of situatie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответственно",
                                "target_lang_sense_clarification": "сообразно обстоятельствам"
                            },
                            {
                                "target_lang_word": "должным образом",
                                "target_lang_sense_clarification": "как того требует ситуация"
                            },
                            {
                                "target_lang_word": "соответствующим образом",
                                "target_lang_sense_clarification": "в зависимости от ситуации"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "overeenkomstig",
                                "target_lang_sense_clarification": "in overeenstemming daarmee"
                            },
                            {
                                "target_lang_word": "dienovereenkomstig",
                                "target_lang_sense_clarification": "op een manier die daar bij past"
                            },
                            {
                                "target_lang_word": "naar behoren",
                                "target_lang_sense_clarification": "op de juiste wijze"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}