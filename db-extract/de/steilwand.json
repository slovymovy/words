                                    {
                                        "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                        "entry_id": "22615cd0-e9a4-37d2-b20f-178ea7e794a5",
                                        "glosses": [
                                            "Endroit d’une montagne dont la pente est très escarpée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ded33da-1978-4cd2-8acc-44ce17ca7352",
                                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                                "text": "[…] nous avons pu encore admirer les falaises de la côte Nord ; découpées en architectures fantastiques, elles se dressent parfois en à-pics de 600 mètres de hauteur."
                                            },
                                            {
                                                "example_id": "8264d0f4-ecc3-4ba7-81b3-faa9ea82a0a1",
                                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                                "text": "On trouve en Bretagne des anatifes cramponnés en colonies serrées au bas des à-pics rocheux sans cesse battus par les vagues."
                                            },
                                            {
                                                "example_id": "55fe912c-374e-4d89-85e7-67f724069642",
                                                "sense_id": "00d01603-abe3-3919-90ca-fbe2e066ece7",
                                                "text": "En quittant les hautes terres de Tulancingo et en progressant vers le nord et l’est, on traverse la forêt sclérophylle pour aboutir dans une zone de montagnes escarpées où l’affleurement du Jurassique se traduit par une succession d'à-pics vertigineux."
                                            }
                                        ]
                                    }
