                ],
                "senses": [
                    {
                        "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                        "entry_id": "55d0121a-f1c7-3bbb-bd08-143cee1b3fc0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b7d8e1-0d04-4156-8240-5ef0ce77e14c",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Frau Schoch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fc72ba44-30f4-4aa6-864e-2afb5d721dc4",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Herr Schoch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e6889a30-b42d-4a83-ad79-f776ab60fafe",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Die Schochs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "752ff00f-6e40-4eb3-a2c4-ec66e0614b4e",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Der Schoch trägt nie die Schals, die die Schoch ihm strickt."
                            },
                            {
                                "example_id": "8e12eedc-4674-4c41-a948-94bb9d7250e5",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schoch kommt, geht der Herr Schoch.“"
                            },
                            {
                                "example_id": "2c88c1d6-aff4-4e2d-acb1-f58498ae04fd",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Schoch kommt und geht."
                            },
                            {
                                "example_id": "77e18071-95b3-4bee-a793-01f0f2fb8ae3",
                                "sense_id": "f355b04a-4005-3216-94d9-b979fa656977",
                                "text": "Schochs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
