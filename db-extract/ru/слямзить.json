                                        "tags": [
                                            "meist in Negation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c73de6c9-db7f-4336-89d0-34ebd63ac21f",
                                                "sense_id": "4e327fe2-e47d-325a-bfad-f8086e3ae833",
                                                "text": "Diesen Depp kann ich einfach nicht verputzen."
                                            },
                                            {
                                                "example_id": "64a3c1d9-09e1-41fd-8795-04d3bbec4593",
                                                "sense_id": "4e327fe2-e47d-325a-bfad-f8086e3ae833",
                                                "text": "Diese Niederlage habe ich bis heute nicht verputzt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
