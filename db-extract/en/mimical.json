                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "20836759-ef73-4aca-b4f4-52350a0f2020",
                                "sense_id": "be2e5dce-127d-3e97-9ad8-d75688b1f71f",
                                "text": "If he can […] talk big fustian, insult, scorn, strut, contemn others, and use a little mimical and apish complement above the rest, he is a complete (Egregiam vero laudem), a well-qualified gentleman […]"
                            },
                            {
                                "example_id": "a7117b84-1c8c-439c-828c-93639f20d91b",
                                "sense_id": "be2e5dce-127d-3e97-9ad8-d75688b1f71f",
                                "text": "[F]requent jot / Of his hard ſetting jade did ſo confound / The vvords that he by papyr-ſtealth had got, / That their loſt ſenſe the youngſter could not ſound, / Though he vvith mimical attention did abound."
                            },
                            {
                                "example_id": "7c493b13-44e5-47ca-8cdd-a0cb4f732702",
                                "sense_id": "be2e5dce-127d-3e97-9ad8-d75688b1f71f",
                                "text": "Man is, of all creatures, the most mimical."
                            }
                        ]
