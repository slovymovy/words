            {
                "entry_id": "25b4ca93-4a6a-3de1-87c7-450a70aebedd",
                "word": "Opéra-Comique",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "de9e62b7-fafe-3e44-bbd1-d479d146fcc4",
                        "entry_id": "25b4ca93-4a6a-3de1-87c7-450a70aebedd",
                        "glosses": [
                            "Nom court du Théâtre national de l’Opéra-Comique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "606db55f-168d-439d-ab3f-3c4aca43489c",
                                "sense_id": "de9e62b7-fafe-3e44-bbd1-d479d146fcc4",
                                "text": "À quelques jours de là, une grande représentation eût lieu à l’Opéra-Comique."
                            },
                            {
                                "example_id": "f9301471-251b-4b82-b806-0437e201107b",
                                "sense_id": "de9e62b7-fafe-3e44-bbd1-d479d146fcc4",
                                "text": "Le bulletin contient aussi —déjà— le récit d’un ténor de l’Opéra-Comique, qui s’est trouvé dans une bataille : « J’aurais préféré, conclut-il, chanter la Tosca ». Que de périls la vie recèle pour un ténor."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "35fea6bd-13eb-4312-a129-167148c77ed7",
                        "source_entry_id": "25b4ca93-4a6a-3de1-87c7-450a70aebedd",
                        "source_sense_ids": [
