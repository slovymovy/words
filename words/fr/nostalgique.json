{
    "word_family": [
        "nostalgie",
        "nostalgiquement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f1519ef8-5dc9-3ccb-afe4-7cfd37f69bec",
                    "sense_definition": "Qui éprouve ou qui évoque un sentiment doux et triste mêlé de regret du passé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En écoutant cette chanson, elle avait un regard <w>nostalgique</w> tourné vers la fenêtre."
                        },
                        {
                            "text": "Cette vieille mélodie réveille en moi un souvenir particulièrement <w>nostalgique</w> de mes vacances."
                        }
                    ],
                    "synonyms": [
                        "mélancolique"
                    ],
                    "common_phrases": [
                        "regard nostalgique",
                        "chanson nostalgique"
                    ]
                },
                {
                    "sense_id": "524285c5-7535-32ff-9ecf-66bfd635b4c8",
                    "sense_definition": "Qui regrette une époque révolue et reste attaché aux coutumes ou modes d'autrefois.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passeisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup d'amateurs de cinéma restent <w>nostalgiques</w> des films en noir et blanc."
                        },
                        {
                            "text": "Cet auteur semble être profondément <w>nostalgique</w> du passé dans son dernier roman."
                        }
                    ],
                    "synonyms": [
                        "passéiste"
                    ],
                    "antonyms": [
                        "progressiste"
                    ],
                    "common_phrases": [
                        "nostalgique du passé"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "162d2e31-5a1f-3ea3-9bb9-d094d83c0f2b",
                    "sense_definition": "Personne qui regrette le passé ou qui éprouve de la nostalgie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passeisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce concert exceptionnel a réuni tous les <w>nostalgiques</w> des années quatre-vingt."
                        },
                        {
                            "text": "Cet homme est un éternel <w>nostalgique</w> qui collectionne les objets d'autrefois."
