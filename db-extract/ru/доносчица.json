                        "examples": [
                            {
                                "example_id": "bbea548f-803c-4363-ba28-56fbbf6c00f0",
                                "sense_id": "095e8eaa-842f-350a-8d1f-074411d641c3",
                                "text": "Потом начал говорить о том, что Аля ― доносчица и донесла на Алешу."
                            },
                            {
                                "example_id": "e52abbe2-c78e-440e-9920-715848a7f7f7",
                                "sense_id": "095e8eaa-842f-350a-8d1f-074411d641c3",
                                "text": "Баранов, не прощаясь с девочками, поспешно вышел из класса. ― Шпионка! Доносчица! Фискалка! ― закричали девочки."
                            }
                        ]
                    }
