                    {
                        "translation_id": "502d0247-3d6d-4a3a-9f49-ad3c48254bb4",
                        "source_entry_id": "f561fd71-0be0-354b-a52e-c0441dcdce52",
                        "source_sense_id": "f9e0a06a-03ba-32b7-9327-51ef7e21882e",
                        "target_lang_word": "pool",
                        "target_lang_code": "en",
