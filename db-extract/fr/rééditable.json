                        "sense_id": "8064a273-ac1b-3f77-b159-9e6aa4c44638",
                        "entry_id": "0e750326-2ff7-3ec7-9e42-c2dfd0d2a7f7",
                        "glosses": [
                            "Qualifie un document qui peut être réédité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784dca98-f944-449e-99b4-84172f502147",
                                "sense_id": "8064a273-ac1b-3f77-b159-9e6aa4c44638",
                                "text": "Pour tout le reste, on ne saurait trop recommander la monographie de Benoît Mouchart, Brigitte Fontaine : intérieur/extérieur, rééditable en avril au Castor Astral."
                            },
                            {
                                "example_id": "41273868-c487-4585-b498-522f0aebe8b7",
                                "sense_id": "8064a273-ac1b-3f77-b159-9e6aa4c44638",
                                "text": "La technologie de stockage et de transmission d’informations - via une blockchain - rend ce document infalsifiable, comme un double digital, opposable, transférable en cas de cession et rééditable en cas de perte."
                            }
                        ]
                    },
                    {
                        "sense_id": "506750db-990c-3754-b6f4-b146992a3986",
                        "entry_id": "0e750326-2ff7-3ec7-9e42-c2dfd0d2a7f7",
                        "glosses": [
                            "Qualifie une situation, une action, qui peut être réitérée, reproduite."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "65183211-1367-457c-9069-987b64c4c0c1",
                                "sense_id": "506750db-990c-3754-b6f4-b146992a3986",
                                "text": "La réaction, c’est l’aspiration à la restauration d’une époque vécue comme supra-historique, et l’impossibilité d’expliquer en quoi cette société serait rééditable aujourd’hui."
                            },
                            {
                                "example_id": "878e26db-c22b-4171-a9f9-c6a4f8e66f55",
                                "sense_id": "506750db-990c-3754-b6f4-b146992a3986",
                                "text": "Si la conquête du mont Blanc n’avait pas été imaginée comme rééditable, elle n'aurait provoqué ni la même attente ni le même choc dans l’opinion."
                            },
                            {
                                "example_id": "affd98bc-3cb8-43fb-9451-61e712442d6b",
                                "sense_id": "506750db-990c-3754-b6f4-b146992a3986",
                                "text": "Dans ce registre, leur premier opus The Elephant in the Room, polar en noir et blanc mettant en scène une douce empoisonneuse, était un must et sans doute un des meilleurs spectacles qu’il soit donné de voir. On attendait donc avec appréhension leur second opus. Pareil exploit est-il rééditable ?"
                            }
                        ]
                    }
