                "translations": [
                    {
                        "translation_id": "bd8ebd89-8444-4880-a6d9-de8360be8d4e",
                        "source_entry_id": "ebab95e7-7d48-3c2f-bdcc-5223449b0621",
                        "source_sense_id": "c6753085-c6d7-3b14-a178-e9f07417100a",
                        "source_sense_description": "uitpakken",
                        "target_lang_word": "unpack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unpack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc0e58c6-04b7-3e4b-aa92-ca45270aaed8",
                                        "entry_id": "2ea01520-ce29-31e6-ae4d-b356dd19c0a4",
                                        "glosses": [
                                            "To remove from a package or container, particularly with respect to items that had previously been arranged closely and securely in a pack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e91e4d-cff7-49f9-bb8d-2a13b7b6a8f6",
                                                "sense_id": "dc0e58c6-04b7-3e4b-aa92-ca45270aaed8",
                                                "text": "They didn't have time to unpack their bags before going out to dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "525059a3-27ff-3958-a838-2881bc43fde4",
                                        "entry_id": "2ea01520-ce29-31e6-ae4d-b356dd19c0a4",
                                        "glosses": [
                                            "To empty containers that had been packed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "733250c1-ba0a-4928-be1e-9b35f6c59c94",
                                                "sense_id": "525059a3-27ff-3958-a838-2881bc43fde4",
                                                "text": "They didn't have time to unpack before going to dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b41a73a-1d19-3783-ab4c-72a635af710e",
                                        "entry_id": "2ea01520-ce29-31e6-ae4d-b356dd19c0a4",
                                        "glosses": [
                                            "To analyze a concept or a text; to explain."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "057c053b-8fe9-44e0-b8d9-841f8180fda8",
                                                "sense_id": "6b41a73a-1d19-3783-ab4c-72a635af710e",
                                                "text": "There may be another argument here, if we had time to unpack it, about modernism and the rise of the middle classes."
                                            },
                                            {
                                                "example_id": "61aabc46-cfa7-4066-8b36-d11e8ae26b62",
                                                "sense_id": "6b41a73a-1d19-3783-ab4c-72a635af710e",
                                                "text": "Yet few Americans — including the president — understand how global trade works, both how it can help our economy and how some can be left behind. Let’s try to unpack a few of the complexities."
                                            },
                                            {
                                                "example_id": "2d6ce4b9-ffa5-4fb3-a0a6-736abe1baf65",
                                                "sense_id": "6b41a73a-1d19-3783-ab4c-72a635af710e",
                                                "text": "From a gender reveal to a secret ceremony and rifts with other royal family members, there was a lot to unpack from the interview"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc85341-614d-3b27-8510-04030caa2138",
                                        "entry_id": "2ea01520-ce29-31e6-ae4d-b356dd19c0a4",
                                        "glosses": [
                                            "To undergo separation of its features into distinct segments."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b294134d-c01b-49d0-a540-4807d35c32dc",
                                                "sense_id": "3dc85341-614d-3b27-8510-04030caa2138",
                                                "text": "The rounded vowels [y] and [œ/ə] in Russian seem to unpack as glide-vowel sequences in words borrowed from French and German, […]"
                                            },
                                            {
                                                "example_id": "1244702d-e87a-49b4-a728-9fff8eb7bc69",
                                                "sense_id": "3dc85341-614d-3b27-8510-04030caa2138",
                                                "text": "Whereas the high vowels /ʏ, y/ unpack, the mid vowels /œ, ø/ are adapted as single segments in these languages (see examples in (36) for Vietnamese (Barker 1969) and (37) for Fon (Gbeto 2000)). […]\nFrench /y/ → Vietnamese /wi/\naccu [a'ky] → ac-quy [ak kwi]"
                                            },
                                            {
                                                "example_id": "96e00f44-3e34-4492-bd89-9d81763cfc0f",
                                                "sense_id": "3dc85341-614d-3b27-8510-04030caa2138",
                                                "text": "The objective of these corpora was to check whether vowels other than nasal vowels systematically unpack in L1s that do not allow them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e79a61-5d38-32bd-b0de-7f33d449f302",
                                        "entry_id": "2ea01520-ce29-31e6-ae4d-b356dd19c0a4",
                                        "glosses": [
                                            "To decompress (data)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4699ead8-5be8-4111-a1b5-a1bf000eca5e",
                                                "sense_id": "f7e79a61-5d38-32bd-b0de-7f33d449f302",
                                                "text": "Packages […] are often archived and compressed using the zip utility; you can unpack these with the unzip command[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
