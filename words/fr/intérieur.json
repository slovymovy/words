                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a trouvé un grand apaisement en se recueillant au fond de son <w>intérieur</w>."
                        },
                        {
                            "text": "Il éprouvait dans son <w>intérieur</w> un profond sentiment d'injustice."
