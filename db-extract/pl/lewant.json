                    {
                        "translation_id": "8d5e0bb0-4eb8-48da-9c59-75a34801147f",
                        "source_entry_id": "547b7199-e555-3b9c-85c5-0cc38c1c4579",
                        "source_sense_id": "5d54a006-9b55-37c6-93e2-16868603a3dd",
