                "senses": [
                    {
                        "sense_id": "0a2f0d28-5f6a-30f0-bf6a-4b8164fd12e4",
                        "entry_id": "8004ae06-086a-3fa3-9153-09144c9fa91a",
                        "glosses": [
                            "Zisterne, in der Trinkwasser gespeichert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e21d64c6-3688-4b8d-936d-87687f8e173e",
                                "sense_id": "0a2f0d28-5f6a-30f0-bf6a-4b8164fd12e4",
                                "text": "„Der Erlös ist für die Reparatur der baufälligen Trinkwasserzisterne der Grundschule in Lwamaggwa mit derzeit 700 Schülern bestimmt.“"
                            },
                            {
                                "example_id": "1ea7c38d-5f5b-47ba-904c-3660c430d7c9",
                                "sense_id": "0a2f0d28-5f6a-30f0-bf6a-4b8164fd12e4",
                                "text": "„Insgesamt richteten die preußischen Bauplaner neun Trinkwasserzisternen mit einem Fassungsvermögen von mehr als einer Million Litern Trinkwasser ein.“"
                            },
                            {
                                "example_id": "3ef3bef3-370a-4f98-b087-c9df88c9d296",
                                "sense_id": "0a2f0d28-5f6a-30f0-bf6a-4b8164fd12e4",
                                "text": "„Das Gemäuer, das als Schmuck und Schutz über einer Trinkwasserzisterne zu Beginn des vorigen Jahrhunderts errichtet wurde, steht unter Denkmalschutz und wird als eines der Ohrdrufer Wahrzeichen angesehen.“"
                            },
                            {
                                "example_id": "bdabed64-e333-4a8c-ae8c-76ed92d2c272",
                                "sense_id": "0a2f0d28-5f6a-30f0-bf6a-4b8164fd12e4",
                                "text": "„Durch die Neueinrichtung der Quellfassung und der Einrichtung von drei neuen Trinkwasserzisternen wurde das jährlich auftretende Problem der im Sommer schwindenden Trinkwasserversorgung deutlich gemildert.“"
                            },
                            {
                                "example_id": "f72005d5-d61e-4e2f-b2ba-62440d72ff9c",
                                "sense_id": "0a2f0d28-5f6a-30f0-bf6a-4b8164fd12e4",
                                "text": "„2010 wurde auf dem Markt die große mittelalterliche Trinkwasserzisterne, welche von einem Wiesengebiet am Böhlitzer Weg, genannt Langhan, gespeist wurde, bei Pflasterarbeiten verfüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
