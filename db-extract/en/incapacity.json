                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fc987041-5ac3-45b2-840e-977893f27905",
                                "sense_id": "d5314dd4-e0aa-3b30-bdb6-779d2270b35c",
                                "text": "So that it is not the insufficiency or incapacity of man's mind, but it is the remote standing or placing thereof that breedeth these mazes and incomprehensions;"
                            }
                        ]
                    },
                    {
                        "sense_id": "83646aed-f233-3ae3-95e4-9183c7a91e19",
