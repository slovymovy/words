{
    "word_family": [
        "holism",
        "holistically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "174f0896-5aae-36c6-9c33-a4aa6bd9cf77",
                    "sense_definition": "Relating to a study of the whole instead of a separation into parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "holism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor took a <w>holistic</w> approach to treat the patient's chronic pain.",
                            "target_lang_translations": {
                                "zh": "医生采用了一种<w>整体的</w>方法来治疗患者的慢性疼痛。"
                            }
                        },
                        {
                            "text": "We need a <w>holistic</w> view of the project to understand its long-term impact.",
                            "target_lang_translations": {
                                "zh": "我们需要以<w>全面的</w>视角看待该项目，以理解其长期影响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "systemic"
                    ],
                    "antonyms": [
                        "atomistic"
                    ],
                    "common_phrases": [
                        "holistic approach",
                        "holistic view"
                    ],
                    "target_lang_definitions": {
                        "zh": "整体的，全面的；强调整体而非各个部分的分析或处理方式"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "整体的",
                                "target_lang_sense_clarification": "着眼于全局而非局部"
                            },
                            {
                                "target_lang_word": "全面的",
                                "target_lang_sense_clarification": "涵盖各个方面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73d5fcd4-19eb-3205-8c74-417274fd08be",
                    "sense_definition": "Related to the philosophy of <w>holism</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "holism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the <w>holistic</w> principles underlying the new environmental policy.",
                            "target_lang_translations": {
                                "zh": "教授解释了新环境政策所依据的<w>整体论</w>原则。"
                            }
                        },
                        {
                            "text": "His research is deeply rooted in <w>holistic</w> theories of biological systems.",
                            "target_lang_translations": {
                                "zh": "他的研究深深植根于生物系统的<w>整体论</w>理论。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "整体论的；与哲学或科学中的整体论相关的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "整体论的",
                                "target_lang_sense_clarification": "哲学或理论术语，强调系统不可分割"
                            },
                            {
                                "target_lang_word": "整体主义的",
                                "target_lang_sense_clarification": "涉及整体主义思想或理论"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}