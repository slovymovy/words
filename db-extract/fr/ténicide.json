                        "entry_id": "9eda2954-cad9-3996-a1bc-98e54c0aaed3",
                        "glosses": [
                            "Substantif de l’adjectif: médicament ténicide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95fab9e-32a1-42b4-8a41-b29badc52cb9",
                                "sense_id": "82c582ac-f024-385d-9b2b-c679d1be23a7",
                                "text": "J’ai vu des malades hypochondriaques venir avec un ténia emprunté et dans le but de prendre un ténicide pour être sûrs de ne pas avoir le ver solitaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
