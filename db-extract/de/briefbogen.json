                "senses": [
                    {
                        "sense_id": "d84f4c6a-2ad7-30ea-93f8-4dbca3d6f229",
                        "entry_id": "549d1dd2-4f55-3082-bdd5-02ae5cfa963b",
                        "glosses": [
                            "ein einzelnes Blatt aus Briefpapier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cb4d7ed-7ee3-4fc8-ad7d-5e0dbe0c70dd",
                                "sense_id": "d84f4c6a-2ad7-30ea-93f8-4dbca3d6f229",
                                "text": "Meine Oma hat früher einen ganzen Packen Briefbogen pro Monat verbraucht. Ich dagegen habe seit mehr als zwei Jahren keinen Brief mehr geschrieben."
                            },
                            {
                                "example_id": "4b7ad29b-432f-4a6d-a0ed-ec73ba2d0f99",
                                "sense_id": "d84f4c6a-2ad7-30ea-93f8-4dbca3d6f229",
                                "text": "„Jetzt ist allerdings kein Platz, sich darüber auszulassen, der Briefbogen ist fast voll, und ich bin schon auf dem Weg nach Arnarstapi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
