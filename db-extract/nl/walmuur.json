                        "examples": [
                            {
                                "example_id": "57190b0d-6bee-4119-9c04-7db09112d4ee",
                                "sense_id": "b76e5f9b-f120-36ba-a494-b23e5c28d39d",
                                "text": "Met aanmoedigingen vanaf de walmuur en terrassen was het een feest om door de Dijkstraat te rennen. Eindelijk zonder tegenwind. Op weg naar de finish die verplaatst was van het ongezellige haventerrein naar de sfeervolle Markt met veel publiek."
                            }
                        ]
                    },
                    {
                        "sense_id": "529bd916-4c54-3622-a57d-607773bb7493",
                        "entry_id": "ab5b9c9b-c4ba-3111-ae11-20192337c56b",
                        "glosses": [
                            "muur van een kade die water en land afgrenst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb22c04-7b90-4244-a3f0-dc2e5b951920",
                                "sense_id": "529bd916-4c54-3622-a57d-607773bb7493",
                                "text": "„Een vrachtwagen die langs de grachten rijdt, heeft een impact van 200.000 personenauto’s”, zegt Ploos van Amstel. „Al dat transport sloopt de stad. Hoe meer zwaardere voertuigen van de weg af gaan; hoe beter het is voor onze walmuren.”"
                            }
                        ]
                    }
