{
    "word_family": [
        "constancy",
        "constantly",
        "inconstant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a2a34431-abc5-3afa-a974-21921cbc565b",
                    "sense_definition": "Happening a lot or all the time; consistently recurring.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recurring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>constant</w> noise from the construction site makes it hard to concentrate.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>постоянного</w> шума со строительной площадки трудно сосредоточиться.",
                                "zh": "工地传来的<w>不断</w>噪音让人难以集中注意力。"
                            }
                        },
                        {
                            "text": "She is in <w>constant</w> contact with her family while traveling.",
                            "target_lang_translations": {
                                "ru": "Она находится в <w>постоянном</w> контакте со своей семьей во время путешествия.",
                                "zh": "她在旅行期间与家人保持<w>持续</w>联系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "continual",
                        "continuous",
                        "incessant",
                        "nonstop",
                        "endless",
                        "persistent",
                        "ceaseless",
                        "uninterrupted",
                        "steady",
                        "regular"
                    ],
                    "antonyms": [
                        "occasional",
                        "intermittent",
                        "sporadic"
                    ],
                    "common_phrases": [
                        "constant contact",
                        "constant reminder",
                        "constant stream",
                        "constant pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий часто или всё время; постоянно повторяющийся.",
                        "zh": "经常发生或一直发生；持续不断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "непрекращающийся, регулярный"
                            },
                            {
                                "target_lang_word": "непрерывный",
                                "target_lang_sense_clarification": "длящийся без перерыва"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不断",
                                "target_lang_sense_clarification": "持续不断地"
                            },
                            {
                                "target_lang_word": "持续",
                                "target_lang_sense_clarification": "延续不断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5822dd71-b6b7-386d-8b46-9e4c27f410ea",
                    "sense_definition": "Staying the same over time or space; not changing or varying.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unchanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should try to drive at a <w>constant</w> speed to save fuel.",
                            "target_lang_translations": {
                                "ru": "Вам следует стараться ехать с <w>постоянной</w> скоростью, чтобы сэкономить топливо.",
                                "zh": "你应该尽量保持<w>恒定</w>的速度行驶以节省燃料。"
                            }
                        },
                        {
                            "text": "The refrigerator keeps the food at a <w>constant</w> temperature.",
                            "target_lang_translations": {
                                "ru": "Холодильник поддерживает продукты при <w>постоянной</w> температуре.",
                                "zh": "冰箱使食物保持在<w>恒定</w>的温度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fixed",
                        "steady",
                        "uniform",
                        "unvarying",
                        "permanent",
                        "changeless"
                    ],
                    "antonyms": [
                        "variable",
                        "changing",
                        "fluctuating"
                    ],
                    "common_phrases": [
                        "constant speed",
                        "constant temperature",
                        "constant rate",
                        "constant flow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остающийся неизменным во времени или пространстве; не меняющийся.",
                        "zh": "在时间和空间上保持不变；不改变或不波动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "стабильный, фиксированный"
                            },
                            {
                                "target_lang_word": "неизменный",
                                "target_lang_sense_clarification": "остающийся прежним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恒定",
                                "target_lang_sense_clarification": "持久不变"
                            },
                            {
                                "target_lang_word": "固定",
                                "target_lang_sense_clarification": "设定后不再变动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c50e209e-337f-3093-9a55-fe278d5601f5",
                    "sense_definition": "Faithful and dependable in a relationship, friendship, or purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "loyal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained a <w>constant</w> friend throughout her long illness.",
                            "target_lang_translations": {
                                "ru": "Он оставался <w>верным</w> другом на протяжении всей её долгой болезни.",
                                "zh": "在她长期患病期间，他始终是一位<w>忠诚</w>的朋友。"
                            }
                        },
                        {
                            "text": "The dog was her <w>constant</w> companion during the lonely years.",
                            "target_lang_translations": {
                                "ru": "Собака была её <w>постоянным</w> спутником в одинокие годы.",
                                "zh": "在那段孤独的岁月里，这只狗是她<w>忠诚</w>的伙伴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "faithful",
                        "loyal",
                        "steadfast",
                        "devoted"
                    ],
                    "antonyms": [
                        "fickle",
                        "unfaithful",
                        "inconstant"
                    ],
                    "common_phrases": [
                        "constant friend",
                        "constant companion"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "somewhat literary in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верный и надежный в отношениях, дружбе или намерениях.",
                        "zh": "在关系、友谊或目标上忠诚且可靠。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "преданный друг или союзник"
                            },
                            {
                                "target_lang_word": "неизменный",
                                "target_lang_sense_clarification": "стойкий в чувствах (книжн.)"
                            },
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "всегда присутствующий рядом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忠诚",
                                "target_lang_sense_clarification": "对人或事业坚定不移"
                            },
                            {
                                "target_lang_word": "坚定",
                                "target_lang_sense_clarification": "立场或感情稳固"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2ec50bb-6a80-3010-9c73-019ba7a57b81",
                    "sense_definition": "A number or value that does not change in a particular mathematical or scientific context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pi is a well-known mathematical <w>constant</w> used to calculate the area of a circle.",
                            "target_lang_translations": {
                                "ru": "Пи — это известная математическая <w>константа</w>, используемая для вычисления площади круга.",
                                "zh": "圆周率是一个众所周知的数学<w>常数</w>，用于计算圆的面积。"
                            }
                        },
                        {
                            "text": "The speed of light is a fundamental physical <w>constant</w>.",
                            "target_lang_translations": {
                                "ru": "Скорость света — это фундаментальная физическая <w>постоянная</w>.",
                                "zh": "光速是一个基本的物理<w>常数</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "variable"
                    ],
                    "common_phrases": [
                        "mathematical constant",
                        "physical constant",
                        "cosmological constant"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical: Mathematics, Physics, Computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Число или значение, которое не изменяется в определенном математическом или научном контексте.",
                        "zh": "在特定的数学或科学语境中不改变的数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "константа",
                                "target_lang_sense_clarification": "математический или физический термин"
                            },
                            {
                                "target_lang_word": "постоянная",
                                "target_lang_sense_clarification": "постоянная величина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "常数",
                                "target_lang_sense_clarification": "数学或物理学中的固定数值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40501959-9115-31ac-9923-715da297eb1c",
                    "sense_definition": "Something that stays the same and does not change, especially amidst other changes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Change is the only <w>constant</w> in the modern world.",
                            "target_lang_translations": {
                                "ru": "Перемены — это единственная <w>константа</w> в современном мире.",
                                "zh": "变化是现代世界中唯一的<w>不变因素</w>。"
                            }
                        },
                        {
                            "text": "Her support was a <w>constant</w> in his difficult life.",
                            "target_lang_translations": {
                                "ru": "Её поддержка была <w>постоянной величиной</w> в его трудной жизни.",
                                "zh": "她的支持是他艰难生活中唯一的<w>不变因素</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the only constant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, остающееся неизменным, особенно на фоне других перемен.",
                        "zh": "保持不变的事物，尤其是在其他事物发生变化时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "константа",
                                "target_lang_sense_clarification": "неизменный элемент (перен.)"
                            },
                            {
                                "target_lang_word": "постоянная величина",
                                "target_lang_sense_clarification": "что-то стабильное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不变因素",
                                "target_lang_sense_clarification": "指代稳定的事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c20ba59b-d355-3bd3-a00c-46abe569229c",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I met a man named <w>Constant</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "Я встретил мужчину по имени <w>Констан</w> на конференции.",
                                "zh": "我在会议上遇到了一位名叫<w>康斯坦</w>的男士。"
                            }
                        },
                        {
                            "text": "<w>Constant</w> is coming to visit us next week.",
                            "target_lang_translations": {
                                "ru": "<w>Констан</w> приедет навестить нас на следующей неделе.",
                                "zh": "<w>康斯坦</w>下周要来看望我们。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Констан",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "康斯坦",
                                "target_lang_sense_clarification": "音译人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
