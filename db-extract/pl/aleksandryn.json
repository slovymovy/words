                                "sense_id": "a50795db-6892-3cf1-a8a6-efbf6029326d",
                                "text": "W literaturze francuskiej aleksandryn to podstawowy wzorzec wiersza klasycznego od XVI wieku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9169ca5d-bc55-4b83-898f-1ccfc2858c7f",
                        "source_entry_id": "2eaf3234-6c97-3508-a626-bdac4a1428d2",
                        "source_sense_id": "a50795db-6892-3cf1-a8a6-efbf6029326d",
