                    {
                        "sense_id": "4000cd6e-c66d-3983-8561-90072d87ec2b",
                        "entry_id": "8c7ae22c-f719-3f43-9b54-33e1c059fbcc",
                        "glosses": [
                            "Petit marteau des sculpteurs et marbriers dont la panne est en pointe, tandis que la table est de section carrée et recouverte des petites pointes pyramidales servant à gruger les pierres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89356518-de4e-47b6-8f1f-a61b32eec50c",
                                "sense_id": "4000cd6e-c66d-3983-8561-90072d87ec2b",
                                "text": "Marteline : C'est une espèce de petit marteau dont la tête est taillée de petites pointes et qui sert à gruger le marbre lorsqu'il est très dur, tel que le granit, le porphyre, ou bien à écraser les clous ou durillons."
                            }
                        ]
                    },
                    {
                        "sense_id": "863868dd-48d1-36d3-b50d-a31b43ce332b",
                        "entry_id": "8c7ae22c-f719-3f43-9b54-33e1c059fbcc",
                        "glosses": [
                            "Petit marteau de mosaïste avec deux cotés coupants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "163293d9-bf78-4580-b565-ed9770f5a59c",
                                "sense_id": "863868dd-48d1-36d3-b50d-a31b43ce332b",
                                "text": "Il n'est pas question de reprendre le métier de mosaïste professionnel où la taille se fait à la marteline sur un tranchant."
                            },
                            {
                                "example_id": "8738862c-9775-40c5-aaca-8ce4775a0b6f",
                                "sense_id": "863868dd-48d1-36d3-b50d-a31b43ce332b",
                                "text": "D'une main on tient la galette à plat sur un coupoir, et de l'autre on frappe quelques coups secs avec la marteline à deux tranchants."
                            }
                        ]
                    }
