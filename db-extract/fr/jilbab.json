                                            {
                                                "example_id": "5ae7eca6-5f46-4c12-b0d2-1aae8ca7bb5b",
                                                "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                                                "text": "In islamitische kringen wordt het dragen van hoofddoekjes veelal als religieuze plicht gezien."
                                            },
                                            {
                                                "example_id": "fd74baac-81d3-4c9a-9e3d-554115e3d0d7",
                                                "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                                                "text": "Vanachter halfgesloten ogen zag ik een vrouw met een Schots geruite rok en een hoofddoek met gespreide armen op me afrennen. Ik besloot me niet te verzetten. Willoos liet ik me heen en weer schudden."
                                            },
                                            {
                                                "example_id": "4ccd2067-d0f2-475e-b56f-35642cecdaac",
                                                "sense_id": "258f19e3-6f9e-36d8-9f6a-3c71f70c3d3b",
                                                "text": "Weerstand tegen verplichting hoofddoek groeit in Iran"
                                            }
