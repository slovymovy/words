                        "examples": [
                            {
                                "example_id": "3908dfd4-b59f-401a-9983-2dc2435dba64",
                                "sense_id": "d93a8e89-ede1-33c0-8a76-e8749539c496",
                                "text": "Hij gaf mij een instemmend knikje."
                            },
                            {
                                "example_id": "dbcd2c26-f96e-40dc-a1a2-3249373c533e",
                                "sense_id": "d93a8e89-ede1-33c0-8a76-e8749539c496",
                                "text": "Hockney pakt de draad weer op, de burger is afgelegd, en doet zijn gehoorapparaten in. ‘Ik ben nog nooit in mijn leven in een gym geweest, en dat hou ik zo’, zegt hij, en er wordt instemmend gegrinnikt."
                            }
                        ]
                    }
                ],
