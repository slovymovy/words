                    },
                    {
                        "translation_id": "134f9eda-e7e7-494d-be67-8caf62eb215f",
                        "source_entry_id": "3d044b26-a217-3308-b784-6ad78d84650b",
                        "source_sense_id": "6431dd61-e40b-3d43-9e9d-8b20460715d8",
