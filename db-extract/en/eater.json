                                            {
                                                "example_id": "321b55af-7c78-4b0a-9fb3-4723f490d4a7",
                                                "sense_id": "29a0c1e7-b26d-36c4-bf97-d1a57bd9ffc6",
                                                "text": "„Sind Sie eigentlich ein starker Esser? Ich bin nämlich ein starker Esser“"
                                            },
                                            {
                                                "example_id": "78244754-a8fb-439c-bed1-4b3e1a13f0f1",
                                                "sense_id": "29a0c1e7-b26d-36c4-bf97-d1a57bd9ffc6",
                                                "text": "„Nur zwei Wochen nach dem Besuch Lampes erstickt Divisch, dieser lustvolle Esser und elektrische Forscher, an einem Hühnerknochen, der ihm im Halse stecken bleibt.“"
                                            }
                                        ],
