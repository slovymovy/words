                            {
                                "target_word": "clock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5d0123d-3773-380e-83c8-ed2d5d1a05fb",
                                        "entry_id": "870f66bd-e455-3e30-a174-bd7e35c1af28",
                                        "glosses": [
                                            "A pattern near the heel of a sock or stocking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84be1194-fd10-4701-bf23-4dd772b52b72",
                                                "sense_id": "a5d0123d-3773-380e-83c8-ed2d5d1a05fb",
                                                "text": "But this you can't stand, so you throw up your hand,\nand you find you're as cold as an icicle,\nIn your shirt and your socks (the black silk with gold clocks),\ncrossing Salisbury Plain on a bicycle"
                                            },
                                            {
                                                "example_id": "83e158e4-036f-4074-8a08-d91384806178",
                                                "sense_id": "a5d0123d-3773-380e-83c8-ed2d5d1a05fb",
                                                "text": "She'd a gown wi' girt flowers lik' hollyhocks\nAn zome stockèns o' gramfer's a-knit wi' clocks"
                                            },
                                            {
                                                "example_id": "e13b5459-8a53-46e3-b488-515fbd68e589",
                                                "sense_id": "a5d0123d-3773-380e-83c8-ed2d5d1a05fb",
                                                "text": "Most decoration involved the ankle clocks, and several are shown on p.15 in the form of charts."
                                            },
                                            {
                                                "example_id": "2f04201a-87ab-4fd8-9576-a65974f291c0",
                                                "sense_id": "a5d0123d-3773-380e-83c8-ed2d5d1a05fb",
                                                "text": "Clocks: These are ornamental designs embroidered or woven on to the ankles of stockings."
                                            },
                                            {
                                                "example_id": "bb970356-40b8-4e37-9177-d1d549771e79",
                                                "sense_id": "a5d0123d-3773-380e-83c8-ed2d5d1a05fb",
                                                "text": "his stockings with silver clocks were ravished from him"
                                            }
                                        ]
