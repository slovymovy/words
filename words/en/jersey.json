    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad21a805-28ba-3fd0-a885-0b936edae092",
                    "sense_definition": "A shirt worn by a member of an athletic team, usually oversized, typically depicting the athlete's name and team number as well as the team's logotype.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fan proudly wore the <w>jersey</w> of his favorite football player.",
                            "target_lang_translations": {
                                "ru": "Болельщик с гордостью носил <w>футболку</w> своего любимого футболиста.",
                                "zh": "这位球迷自豪地穿着他最喜欢的足球运动员的<w>球衣</w>。"
                            }
                        },
                        {
                            "text": "Each player must tuck their <w>jersey</w> into their shorts before the game starts.",
                            "target_lang_translations": {
                                "ru": "Каждый игрок должен заправить свою <w>майку</w> в шорты перед началом игры.",
                                "zh": "比赛开始前，每位球员都必须把<w>运动衫</w>塞进短裤里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shirt",
                        "top",
                        "kit"
                    ],
                    "common_phrases": [
                        "team jersey",
                        "football jersey",
                        "wear a jersey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рубашка или майка, которую носят члены спортивной команды, обычно с именем спортсмена, номером и логотипом команды.",
                        "zh": "运动员在比赛时穿的运动衫，通常印有运动员的名字、号码和球队标志。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "футболка",
                                "target_lang_sense_clarification": "спортивная форма"
                            },
                            {
                                "target_lang_word": "майка",
                                "target_lang_sense_clarification": "спортивная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运动衫",
                                "target_lang_sense_clarification": "运动队服"
                            },
                            {
                                "target_lang_word": "球衣",
                                "target_lang_sense_clarification": "球类运动队服"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "436fadb3-9aae-3da7-a437-305b82a484fb",
                    "sense_definition": "A garment knitted from wool or cotton, worn over the upper body to keep warm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put on a thick wool <w>jersey</w> to protect herself from the cold wind.",
                            "target_lang_translations": {
                                "ru": "Она надела толстый шерстяной <w>свитер</w>, чтобы защититься от холодного ветра.",
                                "zh": "她穿上一件厚厚的羊毛<w>毛衣</w>来抵御寒风。"
                            }
                        },
                        {
                            "text": "My grandmother knitted a colorful <w>jersey</w> for me last winter.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка связала мне красочную <w>кофту</w> прошлой зимой.",
                                "zh": "去年冬天，奶奶为我织了一件色彩鲜艳的<w>针织衫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sweater",
                        "pullover",
                        "jumper"
                    ],
                    "common_phrases": [
                        "wool jersey",
                        "knitted jersey",
                        "warm jersey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вязаная одежда из шерсти или хлопка для верхней части тела.",
                        "zh": "一种用羊毛或棉线针织而成的上衣，用于保暖。"
                    },
                    "translations": {
