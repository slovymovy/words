                    {
                        "sense_id": "5905ce1c-e9e3-3abc-84ab-534e7bcbcd0a",
                        "entry_id": "f82c2ebf-522c-317a-ae3a-edc78ddd08f3",
                        "glosses": [
                            "przedsiębiorstwo, w którym produkcja oparta jest na pracy ręcznej, charakterystyczne dla wczesnego kapitalizmu"
                        ],
                        "tags": [],
