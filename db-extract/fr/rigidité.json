                    }
                ],
                "senses": [
                    {
                        "sense_id": "6cbd1610-653f-3cf2-83a7-1029009047bd",
                        "entry_id": "bb001bd2-6e57-3f0b-8ef7-cd89847c914a",
                        "glosses": [
                            "Raideur, qualité de ce qui ne fléchit pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05abf059-4111-4729-86c6-6446f2820978",
                                "sense_id": "6cbd1610-653f-3cf2-83a7-1029009047bd",
                                "text": "En effet, le cadavre était froid. L'homme essaya de le soulever : la rigidité, la lourdeur des membres le firent renoncer à son projet."
                            },
                            {
                                "example_id": "0a227d60-0144-4dcf-bdab-9aaa86d6dd99",
                                "sense_id": "6cbd1610-653f-3cf2-83a7-1029009047bd",
                                "text": "La rigidité d’une barre de fer."
                            }
                        ]
                    },
                    {
                        "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                        "entry_id": "bb001bd2-6e57-3f0b-8ef7-cd89847c914a",
                        "glosses": [
                            "Grande sévérité, exactitude rigoureuse, austérité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "79afe12d-3265-4e4e-9a36-be0afdf2d257",
                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                "text": "Les magistrats font observer cette loi avec une extrême rigidité."
                            },
                            {
                                "example_id": "8283629e-e036-4189-852d-62a0a96b5da7",
                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                "text": "La rigidité de ses mœurs."
                            },
                            {
                                "example_id": "0dbd7930-07de-40fe-b66b-7bebd222b264",
                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                "text": "La rigidité de sa morale, de la discipline qu’il veut établir."
                            },
                            {
                                "example_id": "287ab675-ade9-412c-a66c-2d59d8c790a6",
                                "sense_id": "626e2293-ef2c-3c6b-86ac-0e00f8b19430",
                                "text": "La rigidité des puritains, des jansénistes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c599c215-eae5-4b84-b5d6-d516a45f029a",
                        "source_entry_id": "bb001bd2-6e57-3f0b-8ef7-cd89847c914a",
