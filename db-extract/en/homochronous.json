    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "31741b4a-7b0e-3e7e-bf4e-f8f4599e9e12",
                "word": "homochronous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2e366d1a-a932-3cbc-a852-251d9b6734c6",
                        "entry_id": "31741b4a-7b0e-3e7e-bf4e-f8f4599e9e12",
                        "glosses": [
                            "Of two signals, such that their corresponding significant instants are displaced by a constant interval of time."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e16a9e90-79b9-4c5e-8d56-188d7880ee7c",
                                "sense_id": "2e366d1a-a932-3cbc-a852-251d9b6734c6",
                                "text": "In fact, the various multiplexes in the network are homochronous."
                            },
                            {
                                "example_id": "c3e0c551-edf1-4c0e-ae66-4e7066c53edf",
                                "sense_id": "2e366d1a-a932-3cbc-a852-251d9b6734c6",
                                "text": "Two signals having different nominal signaling rates, and not stemming from the same clock or from homochronous clocks are usually heterochronous."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8008f1f-9dee-3135-acfd-5f6c577b01b1",
                        "entry_id": "31741b4a-7b0e-3e7e-bf4e-f8f4599e9e12",
                        "glosses": [
                            "Occurring at the same time."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "14ce98dd-73d1-41e7-b43b-d3a801959c3f",
                                "sense_id": "b8008f1f-9dee-3135-acfd-5f6c577b01b1",
                                "text": "Broken lateritic pisolites in the lower part of the Nadarra Formation show that it is homochronous with, or post-dates, the main laterite development."
                            },
                            {
                                "example_id": "91ae5d07-68d2-4682-9c5c-a4b134dec5d1",
                                "sense_id": "b8008f1f-9dee-3135-acfd-5f6c577b01b1",
                                "text": "Five events in the developing geniculocortical pathway were found to be homochronous (that is, they occur at the same stage of the Caecal Period ± 4% CP— in all species)."
                            },
                            {
                                "example_id": "ec59924d-ae18-4008-977e-368bfd561c47",
                                "sense_id": "b8008f1f-9dee-3135-acfd-5f6c577b01b1",
                                "text": "Regardless of what genetic or homochronous relationship exists between love and sensual desire, they have nothing to do with each other in respect to their meaning and as phenomena."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b9cd200-dd68-3750-b56f-4aff498382af",
                        "entry_id": "31741b4a-7b0e-3e7e-bf4e-f8f4599e9e12",
                        "glosses": [
                            "Occurring at the same age in successive generations."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "382d0d1d-9188-4772-ae69-e2d78f0b3baf",
                                "sense_id": "0b9cd200-dd68-3750-b56f-4aff498382af",
                                "text": "Hereditary insanity may appear in children at the same time that it appeared in the parent, and it is then called homochronous."
                            },
                            {
                                "example_id": "0aef6593-0669-41f5-bae3-6401a4a2c2d9",
                                "sense_id": "0b9cd200-dd68-3750-b56f-4aff498382af",
                                "text": "Homochronous and homologous manifestations of hereditary diseases"
                            },
                            {
                                "example_id": "9be52e61-7b2c-4089-a35f-5d89465d7084",
                                "sense_id": "0b9cd200-dd68-3750-b56f-4aff498382af",
                                "text": "Hereditary glaucoma belongs to the so-called homochronous diseases, by which is actually understood a herditary disease which manifests itself within a certain period of life."
                            }
                        ]
                    }
                ],
