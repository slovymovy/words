                                "es": "Esta no es la <w>típica</w> guía de viajes.",
                                "zh": "这可不是一本<w>普通的</w>旅游指南。"
                            }
                        },
                        {
                            "text": "He is just <w>your</w> typical high school student.",
                            "target_lang_translations": {
                                "ru": "Он просто <w>типичный</w> старшеклассник.",
                                "nl": "Hij is gewoon <w>je</w> typische middelbare scholier.",
                                "pl": "On jest po prostu <w>typowym</w> uczniem liceum.",
                                "de": "Er ist einfach <w>der</w> typische Highschool-Schüler.",
                                "fr": "C'est juste <w>le</w> lycéen typique.",
                                "it": "È proprio il <w>tipico</w> studente delle superiori.",
                                "cs": "Je to prostě <w>typický</w> středoškolák.",
                                "tr": "O sadece <w>tipik</w> bir lise öğrencisi.",
                                "es": "Él es simplemente el <w>típico</w> estudiante de secundaria.",
                                "zh": "他就是一个<w>典型的</w>高中生。"
                            }
                        }
