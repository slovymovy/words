                    {
                        "translation_id": "a86371ec-471e-4850-b70e-88c136a1c54a",
                        "source_entry_id": "702714df-4b37-350e-96fd-e88e8471566b",
                        "source_sense_description": "один шарик дроби",
                        "target_lang_word": "grenaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grenaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53947b3d-150a-3216-93b5-b6d84f127237",
                                        "entry_id": "3118077c-9b18-34c3-b564-86e01663796b",
                                        "glosses": [
                                            "Rebuts de graine qui servent principalement à nourrir la volaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a810bf5-9eb7-45d1-93a2-6fdb6629d1cc",
                                                "sense_id": "53947b3d-150a-3216-93b5-b6d84f127237",
                                                "text": "Des troupes de canards gourmands guettaient dans le bief les poissons assommés par la roue, et les poules, groupées sous une petite fenêtre, attendaient la grenaille qui, de temps en temps, leur tombait du ciel."
                                            },
                                            {
                                                "example_id": "1d9df0e4-776a-4bc8-aedf-8cf37198a301",
                                                "sense_id": "53947b3d-150a-3216-93b5-b6d84f127237",
                                                "text": "Halle aux grains et grenailles. — Marchand de grains et grenailles."
                                            },
                                            {
                                                "example_id": "ff33ca83-0c35-4cff-bd0a-9c905730f6c8",
                                                "sense_id": "53947b3d-150a-3216-93b5-b6d84f127237",
                                                "text": "— Nourris de lait sûri, d’orties, puis de grenailles de pommes de terre, finalement poussés au seigle jusqu’à frôler le coup de sang, les cochons vagabondent tout le jour dans le pachis —le clos— autour de la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c1de39-f1ae-3406-acf8-c650ac3e4d62",
                                        "entry_id": "3118077c-9b18-34c3-b564-86e01663796b",
                                        "glosses": [
                                            "Métal réduit en menus grains."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e40fe6-d326-4dfa-bc07-17b1abb6a5e1",
                                                "sense_id": "58c1de39-f1ae-3406-acf8-c650ac3e4d62",
                                                "text": "Une des causes qui contribuèrent le plus efficacement à répandre le fusil de chasse, ce fut l’invention de la grenaille de plomb."
                                            },
                                            {
                                                "example_id": "0f439e32-6b22-44f7-b697-0a7023536c92",
                                                "sense_id": "58c1de39-f1ae-3406-acf8-c650ac3e4d62",
                                                "text": "Elle mit charge pleine avec un petit supplément et elle doubla sa balle de petite grenaille."
                                            },
                                            {
                                                "example_id": "d17d6886-1a31-418f-81b4-eb77df14bbef",
                                                "sense_id": "58c1de39-f1ae-3406-acf8-c650ac3e4d62",
                                                "text": "Mes paroles font grenaille sur la canaille de ses os."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e178f9c-6e1b-391a-ab36-000da581baa0",
                                        "entry_id": "3118077c-9b18-34c3-b564-86e01663796b",
                                        "glosses": [
                                            "Très peu de restant de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5145a8fe-fc35-46a0-8526-dc5756511d75",
                                                "sense_id": "7e178f9c-6e1b-391a-ab36-000da581baa0",
                                                "text": "En ne leur laissant que des grenailles dans les intentions de vote, il s’en démarque déjà."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d5525c1-152a-3510-9f8b-06944f4f7cf5",
                                        "entry_id": "3118077c-9b18-34c3-b564-86e01663796b",
                                        "glosses": [
                                            "Pomme de terre de petit calibre (moins de 3,5 cm)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd91ac58-2295-4b8b-ac81-888c4bdc4ff1",
                                                "sense_id": "1d5525c1-152a-3510-9f8b-06944f4f7cf5",
                                                "text": "Je trouve préférable de dégrenailler avant et faire passer la grenaille sur un double séparateur de motte."
                                            }
                                        ]
                                    }
                                ]
                            },
