                "senses": [
                    {
                        "sense_id": "fa379f1c-686d-3abc-8ec5-0f3b10b02b33",
                        "entry_id": "9a601f87-5d05-393c-a5bf-c95d05cb192a",
                        "glosses": [
                            "Relative à l’océan, océanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01cc7d54-50ac-4bab-8867-921016f5a40a",
                                "sense_id": "fa379f1c-686d-3abc-8ec5-0f3b10b02b33",
                                "text": ". Il voyageait aux frais de l’État sur les galères du roi dans les mers océanes et méditerranées."
                            },
                            {
                                "example_id": "f912343a-9856-4cb1-b388-ec8407b2b169",
                                "sense_id": "fa379f1c-686d-3abc-8ec5-0f3b10b02b33",
                                "text": "À la même époque, les Médoquins, tout au moins ceux de la côte océane, ont la mauvaise réputation d’être des naufrageurs."
                            },
                            {
                                "example_id": "1ebc5ca2-678d-49b3-9e1e-9c0f5fdcdc6e",
                                "sense_id": "fa379f1c-686d-3abc-8ec5-0f3b10b02b33",
                                "text": "Le Havre, la Porte océane."
                            },
                            {
                                "example_id": "dee86255-8fe0-410d-ac00-c03cc4c0aad6",
                                "sense_id": "fa379f1c-686d-3abc-8ec5-0f3b10b02b33",
                                "text": "Mais dans le port d’Amsterdam\nY a des marins qui naissent\nDans la chaleur épaisse\nDes langueurs océanes"
                            }
                        ]
                    }
                ],
                "translations": [
