                    {
                        "translation_id": "256e0e74-632d-43f7-88c0-6a5291c6969f",
                        "source_entry_id": "cb32a5c0-e466-3f8b-a32b-8ed6522f9c4b",
                        "source_sense_id": "bfac6121-966f-321f-9f3b-4db6cccc897a",
