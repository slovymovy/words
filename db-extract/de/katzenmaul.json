                "senses": [
                    {
                        "sense_id": "de152826-57ba-3587-b4f3-2adcf6920159",
                        "entry_id": "6b92f93a-4a42-3baa-8897-04f6478930a5",
                        "glosses": [
                            "Maul der Katze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f6dbfa7-2188-4584-b9d1-42a1d28c5547",
                                "sense_id": "de152826-57ba-3587-b4f3-2adcf6920159",
                                "text": "„Nicht ein Wort drang aus ihrem Katzenmaul, und sie starrte uns nur aus den grünlich schimmernden Augen an.“"
                            },
                            {
                                "example_id": "cf6c4b9d-6737-4e74-bdc8-2dad72e0eb68",
                                "sense_id": "de152826-57ba-3587-b4f3-2adcf6920159",
                                "text": "„Dabei hing ihre Zunge ein wenig aus dem Katzenmaul, und das brachte die Dämonen und den Richter zum Lachen.“"
                            },
                            {
                                "example_id": "14dca119-a9ca-4eab-84a0-0a5dd78a1f24",
                                "sense_id": "de152826-57ba-3587-b4f3-2adcf6920159",
                                "text": "„Ihre Schnurrhaare standen wie Borsten von der Klobürste am Katzenmaul, die Augen übergroß und die Ohren stramm nach hinten gelegt und dann knallte sie ihre Pranken gegen die Zaunmaschen.“"
                            },
                            {
                                "example_id": "d4cbe906-3bc6-448a-a1ee-9506dd530773",
                                "sense_id": "de152826-57ba-3587-b4f3-2adcf6920159",
                                "text": "„Groll bewegte plötzlich das Katzenmaul und begann zu sprechen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
