                "senses": [
                    {
                        "sense_id": "ec6fcd75-1091-3a19-8078-275e60ee6851",
                        "entry_id": "34c986e2-9cba-311c-8405-31b1ea488111",
                        "glosses": [
                            "coś smacznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe7805f6-aeab-4140-9ded-328386530703",
                                "sense_id": "ec6fcd75-1091-3a19-8078-275e60ee6851",
                                "text": "Babcia Honorata przyniosła ci torbę pełną smakołyków."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83f73fca-20de-4e2e-ac28-ad5507903028",
                        "source_entry_id": "34c986e2-9cba-311c-8405-31b1ea488111",
                        "source_sense_id": "ec6fcd75-1091-3a19-8078-275e60ee6851",
                        "target_lang_word": "titbit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "titbit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a009e36-ca3d-3ad2-be23-7e7b28e0e552",
                                        "entry_id": "a2ddfa16-837f-30aa-8ddd-ed432f9fba24",
                                        "glosses": [
                                            "Alternative form of tidbit."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "085d8904-6bc6-4fe5-b4de-7cfa99d7fc62",
                                                "sense_id": "5a009e36-ca3d-3ad2-be23-7e7b28e0e552",
                                                "text": "But our particular friends were the rats, that dwelt by the stream. They were long and black. We brought them such titbits from our ordinary as rinds of cheese, and morsels of gristle, and we brought them also bird's eggs, and frogs, and fledgelings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43ba0a31-b4cc-4f42-a182-7a3f701eaefd",
                        "source_entry_id": "34c986e2-9cba-311c-8405-31b1ea488111",
                        "source_sense_id": "ec6fcd75-1091-3a19-8078-275e60ee6851",
                        "target_lang_word": "tidbit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tidbit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be2c87c3-1926-36ff-a4c4-c90349e1ff8d",
                                        "entry_id": "55355f61-abf6-387c-8cf6-7568e908eba6",
                                        "glosses": [
                                            "A part of poultry when prepared as food"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bdb1b07-5f38-416e-8778-b96c952bd2f8",
                                                "sense_id": "be2c87c3-1926-36ff-a4c4-c90349e1ff8d",
                                                "text": "The best mode of cutting up this Poultry is by raising, one after another, the four members, beginning by a thigh and wing on the same side, the tidbits and the white-meats; then break off the rump, and cut the body horizontally. Divide each thigh into two, and wing into three pieces; the body and the rump making six distinct ones; the white meats remaining entire. Place each piece on the dish in such a manner that all may be seen. All this should be done as quickly and cleverly as possible, in order to prevent the pieces getting cold. The tidbit is a veiny piece under the thigh, at the beginning of wing."
                                            },
                                            {
                                                "example_id": "2ee8e864-d259-4b46-8bb1-5ebde5927221",
                                                "sense_id": "be2c87c3-1926-36ff-a4c4-c90349e1ff8d",
                                                "text": "If in any case he ever reserved the tidbits of his own table for his own taste, he was never weary of sending the whole joint, tidbit and all, nay even when the whole joint was itself a tidbit, to his neighbor's table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe0095db-24a0-37e4-9316-151a28fd1679",
                                        "entry_id": "55355f61-abf6-387c-8cf6-7568e908eba6",
                                        "glosses": [
                                            "A tasty morsel (of food)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a543a2d5-394f-4244-8a1a-ed235b0124ac",
                                                "sense_id": "fe0095db-24a0-37e4-9316-151a28fd1679",
                                                "text": "Only a tidbit to a ravenous mouth. (Said when the little tidbit Denmark flies down the huge gullet of Prussia; or when Saghalin falls into Russia's maw.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98fbf8bf-a5a3-3420-a7c3-d74875359dd5",
                                        "entry_id": "55355f61-abf6-387c-8cf6-7568e908eba6",
                                        "glosses": [
                                            "A short item of news, gossip, or information."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928aa1e0-0b8f-4720-89f3-f67478db4151",
                                                "sense_id": "98fbf8bf-a5a3-3420-a7c3-d74875359dd5",
                                                "text": "In the congressional apportionment that followed the 1910 census, the average district had 210,328 people, according to the Census Bureau. We make note of this historical tidbit simply to emphasize the obvious fact that DC’s current population is far greater than the population of many of the districts of generations past."
                                            },
                                            {
                                                "example_id": "768d32de-f777-40c2-8e72-788b879939f6",
                                                "sense_id": "98fbf8bf-a5a3-3420-a7c3-d74875359dd5",
                                                "text": "“Gossip” is about a lot more than just juicy tidbits and the columnists that peddle them, presenting a multifaceted look at gossip’s role in the newspaper/media ecosystem and at Rupert Murdoch’s enterprises in particular."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7054feb8-f36b-3e61-930f-8359aaeef619",
                                        "entry_id": "55355f61-abf6-387c-8cf6-7568e908eba6",
                                        "glosses": [
                                            "Generically, any small thing."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18917d62-77fd-4d3e-a64d-8a73a102d8b8",
                                                "sense_id": "7054feb8-f36b-3e61-930f-8359aaeef619",
                                                "text": "This little book is very entertaining—quite a literary tidbit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efff94ac-cd11-4aa9-a989-0269ec13c8b8",
                        "source_entry_id": "34c986e2-9cba-311c-8405-31b1ea488111",
