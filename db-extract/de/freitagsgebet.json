                ],
                "senses": [
                    {
                        "sense_id": "c8c22a5c-6d81-37f9-a719-1803143c3656",
                        "entry_id": "8ea517dd-ee31-3dd9-b420-1ff93ddfc8c6",
                        "glosses": [
                            "gemeinschaftliche, nach dem Koran für Männer und Jungen verpflichtende Anrufung Gottes (Gebet), die freitags zur Mittagszeit in einer (Freitags-/Haupt-)Moschee abgehalten wird"
                        ],
                        "tags": [
                            "Islam"
                        ],
                        "examples": [
                            {
                                "example_id": "79dc227c-7f96-4b23-946c-99cbfd2ea9c5",
                                "sense_id": "c8c22a5c-6d81-37f9-a719-1803143c3656",
                                "text": "„Aus mehreren Überlieferungen ergibt sich, dass Frauen, Minderjährige, Kinder und Sklaven sowie Kriegsgefangene, Kranke und Reisende dem Freitagsgebet beiwohnen können, jedoch nicht müssen.“"
                            },
                            {
                                "example_id": "9ee249cb-ee07-4a4d-bed5-293485e40259",
                                "sense_id": "c8c22a5c-6d81-37f9-a719-1803143c3656",
                                "text": "„Vier Selbstmordattentäter hatten sich während der Freitagsgebete in zwei Moscheen in Sanaa in die Luft gesprengt, mehr als 130 Menschen starben, mindestens 345 wurden verletzt.“"
                            },
                            {
                                "example_id": "caee2f28-3278-4a9a-8f41-b50ca112e1a3",
                                "sense_id": "c8c22a5c-6d81-37f9-a719-1803143c3656",
                                "text": "„In vielen Teilen der islamischen Welt ist es nach den Freitagsgebeten zu Protesten gegen die Mohammed-Karikaturen der französischen Satirezeitschrift Charlie Hebdo gekommen.“"
                            },
                            {
                                "example_id": "c9dc5d78-6d43-4169-b465-e39f3b7a70bd",
                                "sense_id": "c8c22a5c-6d81-37f9-a719-1803143c3656",
                                "text": "„In einigen ländlichen Gegenden im Punjab kommt es vor, dass Verse aus «Heer Ranjha» öffentlich über den Lautsprecher der Moschee vorgelesen werden, während die männliche Bevölkerung sich nach dem Gebetsruf zum Freitagsgebet einfindet.“"
                            },
                            {
                                "example_id": "a31a0b2b-d7bb-4de1-8b19-8149792efda1",
                                "sense_id": "c8c22a5c-6d81-37f9-a719-1803143c3656",
                                "text": "„Seit zehn Jahren fährt er regelmäßig zum Freitagsgebet nach Zarqa im Norden von Amman.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
