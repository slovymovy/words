                        "glosses": [
                            "Homme qui passe une grande partie de son temps dans des souterrains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37476300-1f16-41a7-8c2d-ad5bf0850d22",
                                "sense_id": "5769292a-e4d0-3194-9442-5a1dfde3b2de",
                                "text": "Des milliers d’« hommes-taupes », rejetés dans les bas-fonds, fuient la répression policière, coincés dans des tunnels crasseux au milieu des rats et des excréments."
                            },
                            {
                                "example_id": "d35e205c-da95-44f2-9453-05a0c5bde8e1",
                                "sense_id": "5769292a-e4d0-3194-9442-5a1dfde3b2de",
                                "text": "Avec les hommes-taupes qui creusent le tunnel du métro entre Brooklyn et Manhattan, c’est la naissance d'une ville sous la ville que raconte ce jeune auteur natif de Dublin."
                            },
                            {
                                "example_id": "461e98ef-2ea9-4ccc-a1ff-b171ae7c2911",
                                "sense_id": "5769292a-e4d0-3194-9442-5a1dfde3b2de",
                                "text": "Les Grozibou tendent des pièges aux hommes-taupes qui s’y laissent prendre à cause de leur curiosité, leur chef en tête."
                            }
                        ]
                    }
