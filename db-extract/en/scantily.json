                        "glosses": [
                            "Sparingly; not plentifully; not fully; in a scanty manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab744bd-6c39-4796-9eae-0797e109cd1b",
                                "sense_id": "611f1a99-d337-31d7-bd7a-22e239c83a71",
                                "text": "It was rather a nod than a bow, and indicated either that he was an old friend, or that he was scantily versed in the usual social forms."
                            },
                            {
                                "example_id": "1fc4e81a-1835-4fea-8955-dd4c83272848",
                                "sense_id": "611f1a99-d337-31d7-bd7a-22e239c83a71",
                                "text": "This brought me into the study itself. It is a scantily furnished room."
                            },
                            {
                                "example_id": "53d679eb-43c2-4c1c-b9c8-f2e5d0eb4921",
                                "sense_id": "611f1a99-d337-31d7-bd7a-22e239c83a71",
                                "text": "American interest is provided by former NBA star, Dennis Rodman, and the scantily clad Traci Bingham, formerly of “Baywatch.”"
                            }
                        ]
                    }
                ],
