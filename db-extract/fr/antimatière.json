                    {
                        "translation_id": "e7a56759-a1b7-4198-b511-72f8d192f762",
                        "source_entry_id": "95866055-09db-3677-b984-894fe99d74f5",
                        "source_sense_id": "1ef08c88-977e-3f01-aa40-ca14380d5e1f",
                        "target_lang_word": "antimaterie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimaterie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c48a5098-7779-3c9f-acc1-18ab3433e190",
                                        "entry_id": "5bc16b89-5000-39da-8382-c1a8d4de6737",
                                        "glosses": [
                                            "materie die in alles de omgekeerde eigenschappen heeft in vergelijking met de normale materie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "718c478d-548b-42bf-aa77-a1efc4524c9f",
                                                "sense_id": "c48a5098-7779-3c9f-acc1-18ab3433e190",
                                                "text": "Antimaterie bestaat uit antideeltjes, elementen die een soort tegenhangers zijn van 'normale' deeltjes. Als een deeltje tegen zijn antideeltje botst, komt er veel energie vrij. Met die energie wil Bland-Hawthorn de raketten van de toekomst aandrijven."
                                            },
                                            {
                                                "example_id": "6e3d9b74-6659-4726-9de0-d78c9d8dd772",
                                                "sense_id": "c48a5098-7779-3c9f-acc1-18ab3433e190",
                                                "text": "In het laadruim van de Endeavour zit onder meer de zeer geavanceerde en deels Nederlandse Alpha Magnetic Spectrometer (AMS). Met dat apparaat wil de wetenschap baanbrekend onderzoek uitvoeren naar vermoede maar onontdekte deeltjes in het heelal, zoals donkere materie en antimaterie."
                                            },
                                            {
                                                "example_id": "5fb97433-1cab-4808-bc6b-d7dd60c39081",
                                                "sense_id": "c48a5098-7779-3c9f-acc1-18ab3433e190",
                                                "text": "Eerder voorspelde het CERN dat natuurkundigen eind 2012 het Higgs-deeltje zullen ontdekken, of bewijzen dat het niet bestaat. Met de LHC hopen natuurkundigen ook andere fenomenen te zien en te begrijpen, zoals donkere materie, antimaterie en supersymmetrie."
                                            },
                                            {
                                                "example_id": "4b8159e5-e95a-4608-a875-82bc3c210f1b",
                                                "sense_id": "c48a5098-7779-3c9f-acc1-18ab3433e190",
                                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5958b097-d161-4b67-ac4f-9fe144363bbe",
                        "source_entry_id": "95866055-09db-3677-b984-894fe99d74f5",
                        "source_sense_id": "1ef08c88-977e-3f01-aa40-ca14380d5e1f",
