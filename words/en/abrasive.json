{
    "word_family": [
        "abrade",
        "abrasion"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41ad8581-ad7f-366d-8af5-b21aaa7ffce7",
                    "sense_definition": "Rough enough to wear away or polish a surface through friction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>abrasive</w> surface of the stone helped to smooth the rough edges of the wood.",
                            "target_lang_translations": {
                                "zh": "那块石头<w>粗糙的</w>表面有助于磨平木头的毛边。"
                            }
                        },
                        {
                            "text": "Use an <w>abrasive</w> cloth to remove the stubborn rust from the metal gate.",
                            "target_lang_translations": {
                                "zh": "用一块<w>有研磨作用的</w>布去除铁门上顽固的铁锈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cutting"
                    ],
                    "common_phrases": [
                        "abrasive surface",
                        "abrasive material"
                    ],
                    "target_lang_definitions": {
                        "zh": "粗糙的，有研磨或磨损作用的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有研磨作用的",
                                "target_lang_sense_clarification": "指物体表面粗糙、能磨损其他表面"
                            },
                            {
                                "target_lang_word": "粗糙的",
                                "target_lang_sense_clarification": "指表面不光滑"
                            },
                            {
                                "target_lang_word": "磨蚀性的",
                                "target_lang_sense_clarification": "用于科技或专业语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0170eb7-ca67-3e3d-9429-006dae8fa7b7",
                    "sense_definition": "Harsh, aggressive, or irritating in manner or personality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>abrasive</w> personality made it difficult for him to keep friends for very long.",
                            "target_lang_translations": {
                                "zh": "他那<w>生硬刺人的</w>性格让他很难长久维持友谊。"
                            }
                        },
                        {
                            "text": "She was known for her <w>abrasive</w> tone during meetings, which often upset her colleagues.",
                            "target_lang_translations": {
                                "zh": "她因开会时语气<w>粗暴生硬</w>而闻名，这经常让同事们感到不快。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "abrasive personality",
                        "abrasive tone"
                    ],
                    "target_lang_definitions": {
                        "zh": "（性格、举止或语气）生硬刺人的，粗暴伤人的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "生硬的",
                                "target_lang_sense_clarification": "指态度或语气粗暴生硬"
                            },
                            {
                                "target_lang_word": "刺人的",
                                "target_lang_sense_clarification": "指言行令人不快、容易伤人"
                            },
                            {
                                "target_lang_word": "粗暴的",
                                "target_lang_sense_clarification": "指态度激烈、缺乏礼貌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5e022721-d1ec-3f8e-8bb3-b205241b6aa8",
                    "sense_definition": "A hard substance used for cleaning, smoothing, or polishing surfaces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker applied a fine <w>abrasive</w> to the glass to give it a matte finish.",
                            "target_lang_translations": {
                                "zh": "工人在玻璃上涂抹了细<w>磨料</w>，使其呈现出磨砂效果。"
                            }
                        },
                        {
                            "text": "Sandpaper is a common <w>abrasive</w> used in woodworking projects.",
                            "target_lang_translations": {
                                "zh": "砂纸是木工制作中常用的一种<w>磨料</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "industrial abrasive"
                    ],
                    "target_lang_definitions": {
                        "zh": "研磨料，磨料（用于清洁、打磨或抛光的硬质材料）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磨料",
                                "target_lang_sense_clarification": "工业或手工用于打磨的材料"
                            },
                            {
                                "target_lang_word": "研磨剂",
                                "target_lang_sense_clarification": "用于抛光或打磨的物质或药剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c44920b6-d434-39f3-97ae-fcd9f1c615f7",
                    "sense_definition": "Natural particles like sand or rock fragments that wear down land surfaces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wind-blown <w>abrasives</w> slowly carved unique shapes into the desert rock formations.",
                            "target_lang_translations": {
                                "zh": "风吹携带的<w>磨蚀物</w>缓缓将沙漠中的岩层雕刻出奇特的形状。"
                            }
                        },
                        {
                            "text": "The river carries various <w>abrasives</w> that erode the canyon walls over thousands of years.",
                            "target_lang_translations": {
                                "zh": "河流夹带了各种<w>磨蚀碎屑</w>，历经数千年侵蚀着峡谷的岩壁。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（风或水携带的）磨蚀碎屑，研磨物质"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磨蚀物",
                                "target_lang_sense_clarification": "地质学中指侵蚀地表的沙石碎屑"
                            },
                            {
                                "target_lang_word": "磨蚀碎屑",
                                "target_lang_sense_clarification": "被风或流水搬运并磨损岩石的颗粒"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}