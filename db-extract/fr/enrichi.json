                        "entry_id": "6f97bc31-4751-3b1f-b7e5-d6b51b41a315",
                        "glosses": [
                            "Dont la teneur en isotopes fissiles a été augmentée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "49d18bcf-e585-42d9-bde1-5518deb0631b",
                                "sense_id": "23d2966e-16e6-32d4-a303-1fa48f6bba33",
                                "text": "7 août 1979. Près de 1,000 personnes reçoivent une dose de rayonnement six fois supérieure aux normes à la suite du rejet d’uranium fortement enrichi de l’usine de production de combustible nucléaire, à proximité d’Evring, Tennessee."
                            }
                        ]
                    }
