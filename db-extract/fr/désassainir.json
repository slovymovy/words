                "senses": [
                    {
                        "sense_id": "7ab19a8d-442a-3e4c-a115-1f7ea6cec1f9",
                        "entry_id": "8841c7a8-0877-3cb0-ad94-b4ba5ed73e4b",
                        "glosses": [
                            "Rendre moins sain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda4d2b4-9143-4043-a1ce-3278fa40606c",
                                "sense_id": "7ab19a8d-442a-3e4c-a115-1f7ea6cec1f9",
                                "text": "Pour avoir un rôle masticatoire il faut d’abord que les dents soient saines et, pour que nos dents soient saines, il nous faut un système de services sociaux qui, en soi, soit sain et je crois que cette loi vient \"désassainir\" ce système que nous avons."
                            },
                            {
                                "example_id": "1ef5ef97-1e15-424a-a5ff-a7488d83c9f7",
                                "sense_id": "7ab19a8d-442a-3e4c-a115-1f7ea6cec1f9",
                                "text": "N’embarquer les passagers que 24 à 36 heures avant le départ, pour ne pas désassainir inutilement le bâtiment."
                            }
                        ]
                    }
                ],
