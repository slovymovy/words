                "forms": [],
                "senses": [
                    {
                        "sense_id": "89d3281c-d4f7-33f7-985a-bb43fdc34dd2",
                        "entry_id": "8c9634ca-ae2e-3b7c-b4a6-eb68cf704d5b",
