                ],
                "senses": [
                    {
                        "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                        "entry_id": "63f95b5c-df24-346d-959a-7878babf51d0",
                        "glosses": [
                            "Strecke, die während eines Trainings zurückgelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c060db6d-0fc0-447f-adb7-5b96883d2e94",
                                "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                                "text": "„Die normale Trainingsdistanz von 7-10 Kilometern konnte ich nicht direkt laufen.“"
                            },
                            {
                                "example_id": "b981ed87-1a6a-4226-baa6-21e755fcc9a6",
                                "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                                "text": "„Ein Longrun ist, sofern er während des Trainings auf eine bestimmte Wettkampfdistanz gemacht wird, deutlich länger als die gewöhnliche Trainingsdistanz, aber kürzer als die Wettkampfdistanz.“"
                            },
                            {
                                "example_id": "e85a6d28-b4a5-4768-bdd2-56f71c5f76fe",
                                "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                                "text": "„Hier stehen uns Trainingsdistanzen von 10 Meter bis 90 Meter zur Verfügung.“"
                            },
                            {
                                "example_id": "d890e7ae-8805-4df2-a521-5ff4d9b4b432",
                                "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                                "text": "„Das normale Training waren etwa eineinhalb Stunden jeden Tag, also etwa 30 Kilometer Trainingsdistanz.“"
                            },
                            {
                                "example_id": "5e930ae6-6fa6-4bb5-a422-ffdf09b9c34c",
                                "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                                "text": "„Wenn wir schon über die Lebensdauer reden – dieser Laufschuh ist sehr solide gebaut und so vor allem auf längere Trainingsdistanzen ausgelegt.“"
                            },
                            {
                                "example_id": "24f7d431-31bf-45a6-b761-507f9d2a8073",
                                "sense_id": "bc1c31cb-305f-3f37-81c8-d248594edb2d",
                                "text": "„Somit ist das Hin- und Zurückschwimmen zwischen den beiden Brücken, auch mehrfach, eine beliebte Trainingsdistanz zahlreicher Wiener Triathleten, Eisschwimmer, usw.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
