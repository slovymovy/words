                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>employed</w> over five hundred workers last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году завод <w>нанимал</w> более пятисот рабочих.",
                                "de": "Die Fabrik <w>beschäftigte</w> im letzten Jahr über fünfhundert Arbeiter.",
                                "pl": "W zeszłym roku fabryka <w>zatrudniała</w> ponad pięciuset pracowników.",
                                "tr": "Fabrika geçen yıl beş yüzden fazla işçi <w>çalıştırdı</w>.",
                                "zh": "去年这家工厂<w>雇佣</w>了五百多名工人。"
                            }
                        },
                        {
                            "text": "She <w>employed</w> a hammer to fix the broken shelf.",
                            "target_lang_translations": {
                                "ru": "Она <w>использовала</w> молоток, чтобы починить сломанную полку.",
                                "de": "Sie <w>benutzte</w> einen Hammer, um das kaputte Regal zu reparieren.",
                                "pl": "<w>Użyła</w> młotka, aby naprawić zepsutą półkę.",
                                "tr": "Kırık rafı tamir etmek için bir çekiç <w>kullandı</w>.",
                                "zh": "她<w>使用</w>了一把锤子来修理坏掉的架子。"
                            }
                        }
                    ],
                    "common_phrases": [
