                                    },
                                    {
                                        "sense_id": "299b9db7-a10f-3dc6-9097-75c026a2e445",
                                        "entry_id": "5ab5357d-6284-31f3-8307-c1be50449c45",
                                        "glosses": [
                                            "A hairstyle that is shaved or clipped short on the sides and kept long on the top."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9c82ca-0e27-4f9e-8d3a-bef19d460c44",
                                                "sense_id": "299b9db7-a10f-3dc6-9097-75c026a2e445",
                                                "text": "Maybe it’s true that “the Left can’t meme,” if “the Left” refers to the earnest suburban revolutionary with an undercut and a nose ring who typically stalks your replies on X."
