                "senses": [
                    {
                        "sense_id": "bba6270f-712e-3bf6-a41a-54a7fbd9be8b",
                        "entry_id": "31ddfddc-269d-3a0d-90a9-8045a3fa4cb8",
                        "glosses": [
                            "Einrichtung, in der Tiere mit gravierenden Erkrankungen oder Verletzungen medizinisch versorgt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07646e47-bac1-47c4-8c32-869ca55d3329",
                                "sense_id": "bba6270f-712e-3bf6-a41a-54a7fbd9be8b",
                                "text": "Das verletzte Schaf wurde in die nächstgelegene Tierklinik gebracht."
                            },
                            {
                                "example_id": "87a1b559-5ea9-4b5e-ae16-c5cf21c6b990",
                                "sense_id": "bba6270f-712e-3bf6-a41a-54a7fbd9be8b",
                                "text": "Der Boxer wedelte fröhlich mit dem Schwanz, als er nach überstandener Operation die Tierklinik wieder verlassen konnte."
                            },
                            {
                                "example_id": "9571205c-46f5-481f-a734-9bf15231295a",
                                "sense_id": "bba6270f-712e-3bf6-a41a-54a7fbd9be8b",
                                "text": "Die Behandlung der Fraktur wurde von einer Expertin aus der Tierklinik begleitet."
                            },
                            {
                                "example_id": "f75783d9-54f4-4abb-9379-b03d99e341b0",
                                "sense_id": "bba6270f-712e-3bf6-a41a-54a7fbd9be8b",
                                "text": "„Der Schatzmeister äußerte die Ansicht, dieser Zustand dürfe nicht länger andauern und sagte, er werde sie am folgenden Tag in die Tierklinik bringen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
