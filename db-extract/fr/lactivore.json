                                        "sense_id": "48e47717-b0a4-3ec6-bc9f-40701b87a94e",
                                        "entry_id": "f6458edc-6f92-3ac4-9a61-ab0ca5e6f25f",
                                        "glosses": [
                                            "Consuming milk."
                                        ],
                                        "tags": [
