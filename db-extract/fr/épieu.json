                                                "sense_id": "8d1d362f-ea55-3fad-b311-66267d4c3b7e",
                                                "text": "By the 1970s, herders were spearing rhinos and poisoning lions to protest the loss of their land to conservation, then represented by the independent Kenyan government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84e1fc6-51f8-37cc-8366-e90d9818ce97",
                                        "entry_id": "ac05f40c-7b15-30ee-a09b-bd8bf9ec1c4c",
                                        "glosses": [
                                            "To penetrate or strike with, or as if with, any long narrow object; to make a thrusting motion that catches an object on the tip of a long device."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d45e49b-5bdd-45aa-9cb1-0cd8f5dd7ca2",
                                                "sense_id": "c84e1fc6-51f8-37cc-8366-e90d9818ce97",
                                                "text": "Former teammate Derek Sanderson recalls that Maki hit Ted from behind as Green was clearing the puck from the Boston zone. Green turned to knock Maki down, but Maki speared him as he rose from the ice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bdf1174-4a39-39ca-b8cd-16453c558050",
                                        "entry_id": "ac05f40c-7b15-30ee-a09b-bd8bf9ec1c4c",
                                        "glosses": [
                                            "To tackle an opponent by ramming into them with one's helmet."
                                        ],
