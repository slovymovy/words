                        "entry_id": "5a8d74c9-d4dc-30a1-9955-b43b21e679aa",
                        "glosses": [
                            "een land in het noorden van Europa, grenzend aan Noorwegen, Zweden en Rusland, en inclusief het eilandgebied Åland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f2921e-42f0-44ee-a314-adf798bdf316",
                                "sense_id": "538e8284-ef9c-3574-9262-cdeb51b404d6",
                                "text": "Finland staat ook bekend als het land van de duizend meren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66f90e44-326d-49ae-9426-d538bd038b77",
                        "source_entry_id": "5a8d74c9-d4dc-30a1-9955-b43b21e679aa",
