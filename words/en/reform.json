{
    "word_family": [
        "reformation",
        "reformer",
        "reformist",
        "reformatory",
        "reformism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94003b5c-c834-32e7-8bfb-eeb529ececa1",
                    "sense_definition": "The change of something that is defective, broken, or inefficient in order to correct or improve it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced a major <w>reform</w> to the healthcare system.",
                            "target_lang_translations": {
                                "ru": "Правительство представило масштабную <w>реформу</w> системы здравоохранения.",
                                "zh": "政府对医疗保健系统进行了一项重大<w>改革</w>。"
                            }
                        },
                        {
                            "text": "We need a <w>reform</w> of the tax laws to make them fairer.",
                            "target_lang_translations": {
                                "ru": "Нам нужна <w>реформа</w> налогового законодательства, чтобы сделать его более справедливым.",
                                "zh": "我们需要对税法进行<w>改革</w>，使其更加公平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reformation",
                        "amendment",
                        "correction",
                        "rectification"
                    ],
                    "common_phrases": [
                        "economic reform",
                        "political reform",
                        "social reform",
                        "tax reform",
                        "prison reform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение чего-либо неэффективного, сломанного или неправильного с целью исправления или улучшения.",
                        "zh": "对有缺陷、破损或低效的事物进行改变，以达到纠正或改进的目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реформа",
                                "target_lang_sense_clarification": "официальное преобразование"
                            },
                            {
                                "target_lang_word": "преобразование",
                                "target_lang_sense_clarification": "существенное изменение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改革",
                                "target_lang_sense_clarification": "指对旧制度、旧事物进行变革"
                            },
                            {
                                "target_lang_word": "改良",
                                "target_lang_sense_clarification": "指对现状进行局部的改进"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6330f77f-a969-3059-bf54-967f8717670f",
                    "sense_definition": "To improve a system, organization, or law by making changes to remove faults.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new president promised to <w>reform</w> the banking sector.",
                            "target_lang_translations": {
                                "ru": "Новый президент пообещал <w>реформировать</w> банковский сектор.",
                                "zh": "新总统承诺将<w>改革</w>银行业。"
                            }
                        },
                        {
                            "text": "They are trying to <w>reform</w> the electoral process to ensure fairness.",
                            "target_lang_translations": {
                                "ru": "Они пытаются <w>реформировать</w> избирательный процесс, чтобы обеспечить справедливость.",
                                "zh": "他们正试图<w>改革</w>选举程序以确保公平。"
                            }
                        }
                    ],
                    "synonyms": [
                        "improve",
                        "amend",
                        "correct",
                        "rectify",
                        "better"
                    ],
                    "common_phrases": [
                        "reform the system",
                        "reform the law",
                        "reform the economy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать систему, организацию или закон путем внесения изменений для устранения недостатков.",
                        "zh": "通过改变来消除缺陷，从而改进系统、组织或法律。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реформировать",
                                "target_lang_sense_clarification": "проводить реформы"
                            },
                            {
                                "target_lang_word": "преобразовывать",
                                "target_lang_sense_clarification": "изменять к лучшему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改革",
                                "target_lang_sense_clarification": "进行系统性的变革"
                            },
                            {
                                "target_lang_word": "整改",
                                "target_lang_sense_clarification": "针对问题进行整顿和改进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e9ed2a4-8dbe-346d-a59b-312e93324f96",
                    "sense_definition": "To improve one's own character or behavior; to stop doing bad things.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of crime, he finally decided to <w>reform</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет преступной жизни он наконец решил <w>исправиться</w>.",
                                "zh": "在多年的犯罪生涯后，他终于决定<w>改过自新</w>。"
                            }
                        },
                        {
                            "text": "The prisoner claimed he had <w>reformed</w> and was ready for release.",
                            "target_lang_translations": {
                                "ru": "Заключенный заявил, что <w>исправился</w> и готов к освобождению.",
                                "zh": "囚犯声称他已经<w>悔改</w>，准备好获释了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mend",
                        "improve"
                    ],
                    "common_phrases": [
                        "reform oneself",
                        "promise to reform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшать свой характер или поведение; перестать совершать дурные поступки.",
                        "zh": "改善个人的品行或行为；停止做坏事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправляться",
                                "target_lang_sense_clarification": "становиться лучше"
                            },
                            {
                                "target_lang_word": "перевоспитываться",
                                "target_lang_sense_clarification": "менять поведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改过自新",
                                "target_lang_sense_clarification": "彻底改正错误，重新做人"
                            },
                            {
                                "target_lang_word": "悔改",
                                "target_lang_sense_clarification": "认识到错误并改正"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                    "sense_definition": "To form again or in a new configuration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "re-creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band decided to <w>reform</w> for a reunion tour.",
                            "target_lang_translations": {
                                "ru": "Группа решила <w>воссоединиться</w> для прощального тура.",
                                "zh": "乐队决定<w>重组</w>并进行巡回演出。"
                            }
                        },
                        {
                            "text": "The troops had to <w>reform</w> after the chaotic battle.",
                            "target_lang_translations": {
                                "ru": "Войскам пришлось <w>перегруппироваться</w> после хаотичного сражения.",
                                "zh": "混乱的战斗结束后，部队不得不<w>重新集合</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "reform the group",
                        "reform the band"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформировать заново или собраться в новой конфигурации.",
                        "zh": "重新组成或以新的配置方式集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воссоединиться",
                                "target_lang_sense_clarification": "о группе людей"
                            },
                            {
                                "target_lang_word": "перегруппироваться",
                                "target_lang_sense_clarification": "о войсках или строе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重组",
                                "target_lang_sense_clarification": "重新组织或排列"
                            },
                            {
                                "target_lang_word": "重新集合",
                                "target_lang_sense_clarification": "再次聚集在一起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "441d5c33-1c3f-37a3-9d88-ea83ecf6e45c",
                    "sense_definition": "Relating to Reform Judaism, a branch of Judaism that emphasizes the evolving nature of the faith.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She attends a <w>Reform</w> synagogue in the city.",
                            "target_lang_translations": {
                                "ru": "Она посещает <w>реформистскую</w> синагогу в городе.",
                                "zh": "她参加了城里的一所<w>改革派</w>犹太会堂。"
                            }
                        },
                        {
                            "text": "His family follows <w>Reform</w> traditions rather than Orthodox ones.",
                            "target_lang_translations": {
                                "ru": "Его семья следует <w>реформистским</w> традициям, а не ортодоксальным.",
                                "zh": "他的家庭遵循的是<w>改革派</w>传统，而非正统派传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Liberal"
                    ],
                    "common_phrases": [
                        "Reform Judaism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к реформистскому иудаизму — течению, подчеркивающему развивающуюся природу веры.",
                        "zh": "与犹太教改革派有关，该派别强调信仰的演进性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реформистский",
                                "target_lang_sense_clarification": "относящийся к движению за реформы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "改革派的",
                                "target_lang_sense_clarification": "指代宗教或政治中的改革派别"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}