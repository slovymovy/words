                },
                {
                    "sense_id": "b70e42ff-912a-3d6b-8108-633c04f15d91",
                    "sense_definition": "met een zeer sterke, brandende hartstocht of verlangen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>vurigste</w> verlangen ging daarmee eindelijk in vervulling.",
                            "target_lang_translations": {
                                "en": "His <w>most fervent</w> desire was finally fulfilled."
                            }
                        },
                        {
                            "text": "Na jaren van scheiding stuurde hij haar een <w>vurige</w> liefdesbrief.",
                            "target_lang_translations": {
