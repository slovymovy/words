    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4b9ddff-d8f6-39e3-8cd0-c1c1fab0bbe6",
                    "sense_definition": "Wolken dicht bij de grond die het zicht beperken, maar minder dicht dan mist.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "weather_fog",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de dichte <w>nevel</w> konden we de overkant van de straat nauwelijks zien.",
                            "target_lang_translations": {
                                "ru": "Из-за густого <w>тумана</w> мы с трудом видели противоположную сторону улицы.",
                                "en": "Due to the dense <w>mist</w>, we could hardly see the other side of the street.",
                                "fr": "À cause de la <w>brume</w> épaisse, nous pouvions à peine voir l'autre côté de la rue."
                            }
                        },
                        {
                            "text": "In de vroege ochtend hing er een lichte <w>nevel</w> over de weilanden.",
                            "target_lang_translations": {
                                "ru": "Ранним утром над лугами висела легкая <w>дымка</w>.",
                                "en": "In the early morning, a light <w>mist</w> hung over the meadows.",
                                "fr": "Tôt le matin, une légère <w>brume</w> flottait au-dessus des prés."
                            }
                        }
                    ],
                    "synonyms": [
                        "mist",
                        "damp",
                        "waas"
                    ],
                    "common_phrases": [
                        "dichte nevel",
                        "in nevelen gehuld",
                        "optrekkende nevel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Облака у поверхности земли, ограничивающие видимость, но менее густые, чем туман.",
                        "en": "Clouds close to the ground that limit visibility, but are less dense than fog.",
                        "fr": "Nuages bas proches du sol qui réduisent la visibilité, mais moins denses que le brouillard."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дымка",
                                "target_lang_sense_clarification": "легкий туман"
                            },
                            {
                                "target_lang_word": "туман",
                                "target_lang_sense_clarification": "атмосферное явление"
                            },
                            {
                                "target_lang_word": "мгла",
                                "target_lang_sense_clarification": "помутнение воздуха"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "mist",
                                "target_lang_sense_clarification": "weather phenomenon"
                            },
                            {
                                "target_lang_word": "haze",
                                "target_lang_sense_clarification": "atmospheric obscuration"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "brume",
                                "target_lang_sense_clarification": "phénomène météorologique"
                            },
                            {
                                "target_lang_word": "brouillard",
                                "target_lang_sense_clarification": "phénomène météorologique plus dense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c351e3de-ed12-3a97-84d4-a6ede52ef3b7",
                    "sense_definition": "Een hoeveelheid fijn verdeelde vloeistofdruppels die in de lucht zweven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_spray",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De waterval veroorzaakte een fijne <w>nevel</w> die ons helemaal nat maakte.",
                            "target_lang_translations": {
                                "ru": "Водопад поднял мелкую <w>водяную пыль</w>, которая нас полностью промочила.",
                                "en": "The waterfall caused a fine <w>mist</w> that got us completely wet.",
                                "fr": "La cascade produisait une fine <w>brume</w> qui nous a complètement trempés."
                            }
                        },
                        {
                            "text": "Hij spoot een <w>nevel</w> van verf op het witte doek.",
                            "target_lang_translations": {
                                "ru": "Он распылил <w>облако</w> краски на белый холст.",
                                "en": "He sprayed a <w>mist</w> of paint onto the white canvas.",
                                "fr": "Il a pulvérisé un <w>nuage</w> de peinture sur la toile blanche."
                            }
                        }
                    ],
                    "synonyms": [
                        "spray"
                    ],
                    "common_phrases": [
                        "fijne nevel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество мелких капель жидкости, парящих в воздухе.",
                        "en": "A quantity of finely divided liquid droplets floating in the air.",
                        "fr": "Ensemble de fines gouttelettes de liquide en suspension dans l'air."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водяная пыль",
                                "target_lang_sense_clarification": "мелкие брызги"
                            },
                            {
