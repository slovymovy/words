                                                "sense_id": "73505416-78a9-3ccb-bb3b-32bbb778c9a1",
                                                "text": "stinging nettles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8257eda4-d529-35e3-8c00-a45b6d9794e5",
                                        "entry_id": "d80e71cd-2987-3505-9c87-6b8ba38133bb",
                                        "glosses": [
                                            "Precise and hurtful."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8821ca58-f9fc-465f-b516-79de7fa6f68c",
                                                "sense_id": "8257eda4-d529-35e3-8c00-a45b6d9794e5",
                                                "text": "That same year, a young Gloria Steinem went undercover as a Playboy Bunny at one of his Playboy Clubs and wrote a stinging inside critique of the magazine's ethos and chauvinism in an article, titled \"A Bunny's Tale,\" which was published in Show magazine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stinging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c94423be-267e-3763-b2f8-f645ad00d417",
                                        "entry_id": "9b0dcd99-cd08-39be-865f-0824c9de60fe",
                                        "glosses": [
                                            "present participle and gerund of sting"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2a8d64c-e96c-439d-bbc1-9e5aecdd8905",
                                                "sense_id": "c94423be-267e-3763-b2f8-f645ad00d417",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom.[…]Drifts of yellow vapour, fiery, parching, stinging, filled the air."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stinging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff380ac-cbcb-3b74-b325-3969aa6708aa",
                                        "entry_id": "cb340b6e-cd2e-3b1b-8b78-1e32070b97d8",
                                        "glosses": [
                                            "The act by which someone receives a sting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99181859-846e-48c2-85ed-3b0b3b563e04",
                                                "sense_id": "eff380ac-cbcb-3b74-b325-3969aa6708aa",
                                                "text": "the stingings of scorpions"
                                            },
                                            {
                                                "example_id": "9239f4c4-c830-463c-95e9-c2db9da3bada",
                                                "sense_id": "eff380ac-cbcb-3b74-b325-3969aa6708aa",
                                                "text": "stingings of remorse"
                                            }
                                        ]
                                    }
                                ]
