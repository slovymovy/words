                    }
                },
                {
                    "sense_id": "b71ef260-def4-35bb-8782-bdda414c2ee2",
                    "sense_definition": "met kleine, snelle passen lopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine kind <w>dribbelde</w> vrolijk achter zijn moeder aan.",
                            "target_lang_translations": {
                                "en": "The small child <w>pattered</w> cheerfully after his mother."
                            }
                        },
                        {
                            "text": "Hij <w>dribbelde</w> onrustig door de kamer omdat hij erg gestrest was.",
                            "target_lang_translations": {
