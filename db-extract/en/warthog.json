                    {
                        "translation_id": "ef70f22e-3b64-40ca-b1d7-c5b2dd4ffd32",
                        "source_entry_id": "fdc7ca7d-3c99-3df4-9ae8-12fc377c516f",
                        "source_sense_description": "a species of wild pig",
                        "target_lang_word": "wrattenzwijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wrattenzwijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3bfd2fa2-2220-3a5d-851a-6484e67c2221",
                                        "entry_id": "f9f10414-2190-3db4-a7d6-fb357119bb57",
                                        "glosses": [
                                            "benaming voor Afrikaanse wilde varkens uit het geslacht Phacochoerus"
                                        ],
                                        "tags": [
                                            "evenhoevigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd761c1-f828-4c80-a478-681aebf3793a",
                                                "sense_id": "3bfd2fa2-2220-3a5d-851a-6484e67c2221",
                                                "text": "Het wrattenzwijn wordt in Zuid-Afrika veel aangetroffen."
                                            },
                                            {
                                                "example_id": "46e399c5-0876-4e7e-8936-64921bc8bf63",
                                                "sense_id": "3bfd2fa2-2220-3a5d-851a-6484e67c2221",
                                                "text": "De ziekte komt in het zuidelijk deel van Afrika voor bij het wrattenzwijn en het bosvarken en wordt overgebracht door teken of door contact tussen varkens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b270e3f-1a13-360c-a297-28f54a0c129c",
                                        "entry_id": "f9f10414-2190-3db4-a7d6-fb357119bb57",
                                        "glosses": [
                                            "benaming voor sommige Aziatische wilde zwijnen uit het geslacht Sus"
                                        ],
                                        "tags": [
                                            "evenhoevigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e534b573-1ef1-4b49-8ccb-bf25b17d3805",
                                                "sense_id": "3b270e3f-1a13-360c-a297-28f54a0c129c",
                                                "text": "Amper een jaar geleden baarde het opzien dat in een grot op Sulawesi (Indonesië), een rotstekening van een soort jachtscène was gevonden die bijna 44.000 jaar oud bleek te zijn. In een naburige grot is inmiddels een nóg oudere rotstekening gevonden van minstens 45.500 jaar oud: een wrattenzwijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "164091d4-9356-3851-bb3d-99ac6b134277",
                                        "entry_id": "f9f10414-2190-3db4-a7d6-fb357119bb57",
                                        "glosses": [
                                            "verachtelijk, waardeloos persoon"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48893bcc-a674-4f3e-b9ae-538b39882154",
                                                "sense_id": "164091d4-9356-3851-bb3d-99ac6b134277",
                                                "text": "Hij houdt van België: „(Het) Belgische volk slaat zijn hoogwaardigheidsbekleders op de televisie gade - het Gentse Wrattenzwijn, de Worstenkop (-) - en besluit dat zijn eigen schilderachige interpretatie van de wet nog steeds ruimschoots gerechtvaardgd is.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fef1c628-a572-49e7-96f6-7a6950b0646c",
                        "source_entry_id": "fdc7ca7d-3c99-3df4-9ae8-12fc377c516f",
                        "source_sense_description": "a species of wild pig",
                        "target_lang_word": "phacochère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phacochère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "afc84fe8-caee-3e03-a555-340b8bfc03d4",
                                        "entry_id": "27cd54a4-6420-3f60-937a-b220ba7b16f0",
                                        "glosses": [
                                            "Mammifère ongulé sauvage, de la famille des suidés, proche du sanglier, vivant dans les savanes africaines et muni de deux défenses dirigées vers le haut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2646838-9cb5-4a2c-b913-99ec7287d9b9",
                                                "sense_id": "afc84fe8-caee-3e03-a555-340b8bfc03d4",
                                                "text": "C’est pourquoi le phacochère est mentionné et loué dans quelques chants entonnés pendant la cure pour le remercier d’en avoir révélé, même sans le vouloir explicitement , les médicaments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "103f2520-fb21-486e-b0cd-3756b3c726d7",
                        "source_entry_id": "fdc7ca7d-3c99-3df4-9ae8-12fc377c516f",
                        "source_sense_description": "a species of wild pig",
                        "target_lang_word": "Warzenschwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Warzenschwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0833f2f2-85f3-3d22-ad44-dc809336db69",
                                        "entry_id": "f93214ca-7093-31f8-a59c-87ec7982312c",
                                        "glosses": [
                                            "afrikanisches Schwein mit warzenartigen Auswüchsen am Kopf und großen Hauern, das vorwiegend in Savannen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c59af2-fb62-4784-98fa-26928157abcf",
                                                "sense_id": "0833f2f2-85f3-3d22-ad44-dc809336db69",
                                                "text": "„Die gerodeten Flächen wachsen allmählich wieder mit Kameldorn und Aloe zu und geben Geparden Auslauf und Warzenschweinen Deckung.“"
                                            },
                                            {
                                                "example_id": "48e80500-5e94-438a-be6c-39f088d2f7bd",
                                                "sense_id": "0833f2f2-85f3-3d22-ad44-dc809336db69",
                                                "text": "„Wir sahen Schwarzfersen-Antilopen, Zebras, Warzenschweine und eine Fülle von Vögeln, doch den stärksten Eindruck hinterließ bei mir eine gemächlich weidende Elefantenherde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
