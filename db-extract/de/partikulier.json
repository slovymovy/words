                "senses": [
                    {
                        "sense_id": "de202e7a-683a-34b1-8b95-0c2f67059763",
                        "entry_id": "1369d876-1d35-3682-a3c8-d4baaddbc3ca",
                        "glosses": [
                            "Schiffseigner, der mit seinem Frachtschiff als selbständiger Unternehmer Transporte durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c2bdac4-c24c-4937-982e-9de7657f4a38",
                                "sense_id": "de202e7a-683a-34b1-8b95-0c2f67059763",
                                "text": "„William Gutende selbst war ein Partikulier, ein Schiffseigentümer, der nur ein Schiff besitzt, auf dem er als Schiffsführer auf eigene Rechnung und unter eigener Flagge Frachttransporte ausführt.“"
                            },
                            {
                                "example_id": "6f810390-d2e3-4045-bfc4-51442bed9b39",
                                "sense_id": "de202e7a-683a-34b1-8b95-0c2f67059763",
                                "text": "„In der DTG haben sich rund 100 selbstständige Schiffseigentümer, sogenannte Partikuliere, zusammengeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
