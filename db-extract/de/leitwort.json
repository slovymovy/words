                "senses": [
                    {
                        "sense_id": "3117eb48-96f4-3483-9177-63f60fe62da3",
                        "entry_id": "381e6340-c4d3-312c-91d6-2fbf58d1ca4b",
                        "glosses": [
                            "Motto, das einen Leitgedanken in Form einer Aussage nennt, zum Beispiel für eine Veranstaltung"
                        ],
                        "tags": [
                            "mit Plural 1"
                        ],
                        "examples": [
                            {
                                "example_id": "05707500-2b16-4dca-824a-f68551bf655e",
                                "sense_id": "3117eb48-96f4-3483-9177-63f60fe62da3",
                                "text": "Jeder Parteitag steht unter einem Leitwort."
                            },
                            {
                                "example_id": "2deadb42-05b9-4c24-ade2-a3664d05198f",
                                "sense_id": "3117eb48-96f4-3483-9177-63f60fe62da3",
                                "text": "„›Stilbildung‹ wurde das Leitwort der deutschen Spracherziehung im 18. Jahrhundert.“"
                            },
                            {
                                "example_id": "f70e4a26-0990-48cd-b483-c2096472c9bf",
                                "sense_id": "3117eb48-96f4-3483-9177-63f60fe62da3",
                                "text": "„Vornehmlich sind dies Leitwörter des Diversitätsdiskurses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e3555a46-97ce-3cec-bad5-2eb011e59fbe",
                        "entry_id": "381e6340-c4d3-312c-91d6-2fbf58d1ca4b",
                        "glosses": [
                            "Stichwort, das der Organisation von Information dient, etwa in Bürosystemen"
                        ],
                        "tags": [
                            "mit Plural 2"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1678285b-f87e-3d5d-bf05-2c88daf9e392",
                        "entry_id": "381e6340-c4d3-312c-91d6-2fbf58d1ca4b",
                        "glosses": [
                            "Stichwort, das einen Leitgedanken kurz und prägnant in einem Wort zusammenfasst."
                        ],
                        "tags": [
                            "mit Plural 2"
                        ],
                        "examples": [
                            {
                                "example_id": "caf1e44c-c70a-4c80-9004-756c2c04a829",
                                "sense_id": "1678285b-f87e-3d5d-bf05-2c88daf9e392",
                                "text": "Vieles wird heutzutage unter dem Leitwort Globalisierung diskutiert."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
