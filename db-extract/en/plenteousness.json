                        "examples": [
                            {
                                "example_id": "a007b7ac-7816-48a5-8436-07aa67f4015b",
                                "sense_id": "b29b42f3-11e6-3812-952a-a4cab89bd3b5",
                                "text": "Few, save the poor, feel for the poor:\nThe rich know not, how hard\nIt is to be of needful food\nAnd needful rest debarred.\nTheir paths are paths of plenteousness,\nThey sleep on silk and down;\nAnd never think how heavily\nThe weary head lies down."
                            }
                        ]
                    }
