                "translations": [
                    {
                        "translation_id": "7727dfed-3d16-4966-a9da-5e81af51d972",
                        "source_entry_id": "b221b536-841e-3ba7-8fc5-04bc620bfcab",
                        "source_sense_id": "4fb82a72-cafa-308e-abd5-7c094cf8751e",
