                                                "example_id": "e3b197d3-db9b-4993-b952-a0187945f7ea",
                                                "sense_id": "a99e35e3-e6ea-3f03-a970-172ffd26cbc4",
                                                "text": "„Reismehl eignet sich nicht zum Backen, da ihm das Gluten fehlt.“"
                                            },
                                            {
                                                "example_id": "5274da59-c1ee-4c28-b1c1-09d54a627ca2",
                                                "sense_id": "a99e35e3-e6ea-3f03-a970-172ffd26cbc4",
                                                "text": "„Eine wichtige Eigenschaft aller Glutene ist ihre ausgeprägte Resistenz gegenüber humanen Peptidasen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
