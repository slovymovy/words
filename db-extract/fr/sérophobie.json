                        "sense_id": "652dbde2-1998-3a9c-8efd-104263db3432",
                        "entry_id": "84d30a86-6a02-3fb9-92e5-4371362281b9",
                        "glosses": [
                            "Peur des personnes séropositives au VIH ou au stade SIDA."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e0cced-79d3-4b69-9e61-5c836d086246",
                                "sense_id": "652dbde2-1998-3a9c-8efd-104263db3432",
                                "text": "Aujourd’hui encore, les personnes vivant avec le VIH font l’expérience d’attitudes de rejet, de stigmatisation, de sérophobie."
                            },
                            {
                                "example_id": "66de4968-f37f-45a7-ad63-e93c4b688a29",
                                "sense_id": "652dbde2-1998-3a9c-8efd-104263db3432",
                                "text": "Le terme de sérophobie est employé pour évoquer toute discrimination spécifique au VIH/sida. Elle signifie la peur, le rejet des personnes vivant avec le VIH (PvVIH)."
                            }
                        ]
                    }
                ],
