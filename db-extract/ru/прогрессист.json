                                        "entry_id": "bd018035-0971-3cdf-b30b-67fd22d67710",
                                        "glosses": [
                                            "An advocate of progressivism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e33fe06e-688e-43d5-985e-cbead51fa1ff",
                                                "sense_id": "9937db53-2b9f-30fa-b2e3-50277ad3266d",
                                                "text": "Discontented progressivists may be persuaded to cross the aisle in small numbers, but the big tent lacks the universal message it needs to persuade effectively."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "progressivist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4080f7dd-a2c1-374f-afe0-7ce08c5dfe6a",
                                        "entry_id": "a15b0b5b-6d4c-368a-9e57-30db3c911fba",
                                        "glosses": [
                                            "Relating to progressivism; progressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e05bfb6-4f55-4f9d-84e9-b9a1ce653b05",
                                                "sense_id": "4080f7dd-a2c1-374f-afe0-7ce08c5dfe6a",
                                                "text": "The conservative movement, having adopted big-tent pseudo-conservatism, will generally resist progressivist impulses for a time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
