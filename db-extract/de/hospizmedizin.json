                "senses": [
                    {
                        "sense_id": "5c6d1264-e166-35ba-bba7-fc12caf93f73",
                        "entry_id": "269b5d8d-cca4-3d5d-86cc-3734269d4f18",
                        "glosses": [
                            "spezieller Zweig der Medizin, der sich mit der Verbesserung der Lebensqualität Schwerstkranker im Terminalstadium einer Krankheit (beispielsweise Krebs) während der verbleibenden Lebenszeit beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26c4af05-319a-482a-a0cd-c8a3786f6a70",
                                "sense_id": "5c6d1264-e166-35ba-bba7-fc12caf93f73",
                                "text": "„Erst in fünf bis sechs Jahren erwarte er eine umfassende gesetzliche Lösung zur Sterbehilfe, die auch Themen wie Sterbebegleitung und Hospizmedizin einschließe.“"
                            },
                            {
                                "example_id": "a49ad966-ee54-4770-b2c0-c41bc40e49c9",
                                "sense_id": "5c6d1264-e166-35ba-bba7-fc12caf93f73",
                                "text": "„Hier hoffe ich, daß die Art von Hospizmedizin, die wir praktizieren, positive Auswirkungen auf das Bewußtsein unserer Gesellschaft zeitigt und wir schwere oder unheilbare Krankheit, Sterben und Tod wieder in unser Leben hineinnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
