                "senses": [
                    {
                        "sense_id": "4f8e917f-2cd5-32be-ab1d-32ab47d4b381",
                        "entry_id": "cb114bc4-b3cd-316e-924b-bd05a0a10aa2",
                        "glosses": [
                            "Stadt, in der eine bestimmte Person geboren wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab2e22a-4366-408f-a235-391ec6c89e31",
                                "sense_id": "4f8e917f-2cd5-32be-ab1d-32ab47d4b381",
                                "text": "„Geplant war auch eine Publikation zum Œuvre des Autors und zu seinen Beziehungen zur Geburtsstadt.“"
                            },
                            {
                                "example_id": "c563a78d-ef07-4e7d-88ce-c4118b1e6b90",
                                "sense_id": "4f8e917f-2cd5-32be-ab1d-32ab47d4b381",
                                "text": "„Aus seiner Geburtsstadt allerdings gibt es noch eine Provinzposse zu berichten, die sich über einen längeren Zeitraum hinzieht.“"
                            },
                            {
                                "example_id": "1a2e74f9-2a30-45d9-816e-cf30e1401e8c",
                                "sense_id": "4f8e917f-2cd5-32be-ab1d-32ab47d4b381",
                                "text": "„Philipp Melanchthon hatte als Kind erlebt, wie seine Geburtsstadt Bretten zwischen einem württembergischen Herzog und einem pfälzischen Kurfürsten umkämpft war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
