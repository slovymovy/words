                "senses": [
                    {
                        "sense_id": "51b736c8-e1d8-3547-8b14-c5ccc74927ae",
                        "entry_id": "df1fa0a1-3d35-3099-a238-0ec74c868feb",
                        "glosses": [
                            "Ce qui est composé de dix parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef99be48-e1fa-42d1-9331-420988ba9384",
                                "sense_id": "51b736c8-e1d8-3547-8b14-c5ccc74927ae",
                                "text": "Toujours est-il que Jean Folantin était né dans de désastreuses conditions ; le jour où la gésine de sa mère prit fin, son père possédait pour tout bien un dizain de petites pièces blanches."
                            }
                        ]
                    },
                    {
                        "sense_id": "5820ffde-5f93-3632-a482-eb7dc597f9c2",
                        "entry_id": "df1fa0a1-3d35-3099-a238-0ec74c868feb",
                        "glosses": [
                            "Pièce de poésie, stance ou strophe composées de dix vers."
                        ],
                        "tags": [
                            "Principalement",
                            "Versification"
                        ],
                        "examples": [
                            {
                                "example_id": "6237e840-ecc4-40d3-afed-ef621bd3ecb1",
                                "sense_id": "5820ffde-5f93-3632-a482-eb7dc597f9c2",
                                "text": "Faire un dizain."
                            },
                            {
                                "example_id": "bf4b4539-c8ba-44d6-87cb-43bba170fe65",
                                "sense_id": "5820ffde-5f93-3632-a482-eb7dc597f9c2",
                                "text": "Cette ode contient tant de dizains."
                            },
                            {
                                "example_id": "d7d7dfe1-34a7-4ec8-8823-4fad15cbef50",
                                "sense_id": "5820ffde-5f93-3632-a482-eb7dc597f9c2",
                                "text": "Les parents et les personnes âgées jouent au trecillo ; les jeunes gens causent avec les demoiselles, récitent les octaves et les dizains faits dans la journée."
                            }
                        ]
                    }
                ],
