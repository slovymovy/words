                ],
                "senses": [
                    {
                        "sense_id": "ea855c89-9e15-3931-9f1d-4d32aa301ad7",
                        "entry_id": "d6f547f6-7571-38e2-90fb-edbc429072d6",
                        "glosses": [
                            "Composé organochloré dérivé du biphényle de formule générale C₁₂H₁₀₋ₙClₙ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bdbdbb9-17b2-434b-ac04-efea479190d0",
                                "sense_id": "ea855c89-9e15-3931-9f1d-4d32aa301ad7",
                                "text": "Un exellent exemple de pollution persistante est le polychlorobiphényle (PCB), plus connu sous le nom de pyralène, un produit utilisé depuis 1930 comme isolant, en particulier dans les transformateurs."
                            },
                            {
                                "example_id": "c24ef494-0aa2-4f8f-9e5f-2ccdb8b3f114",
                                "sense_id": "ea855c89-9e15-3931-9f1d-4d32aa301ad7",
                                "text": "Beaucoup d’études ont été consacrées aux produits chimiques dont la toxicité est avérée, tels que les polychlorobiphényles (PCB), les polluants organiques persistants (POP) et les hydrocarbures aromatiques polycycliques (HAP)."
                            },
                            {
                                "example_id": "a34cc347-7534-4329-85b1-ed2916f5b66a",
                                "sense_id": "ea855c89-9e15-3931-9f1d-4d32aa301ad7",
                                "text": "L’expert évoque d’autres hypothèses : des huiles souillées par des polychlorobiphényles (PCB) issues de garages locaux ou encore des déchets hospitaliers, dont certains faiblement radioactifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff1e963d-2c97-4e4a-ac0d-333d9b095955",
                        "source_entry_id": "d6f547f6-7571-38e2-90fb-edbc429072d6",
                        "source_sense_id": "ea855c89-9e15-3931-9f1d-4d32aa301ad7",
                        "target_lang_word": "polychlorinated biphenyl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polychlorinated biphenyl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd64214-9837-31b6-a380-4de62774e406",
                                        "entry_id": "bad7c961-c1d7-355d-ae8b-27535161958f",
                                        "glosses": [
                                            "Any of a class of aromatic organic compounds formed by the chlorination of the hydrocarbon biphenyl; they have many industrial applications but are now considered persistent organic pollutants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f602d442-a9cf-480c-bca5-ee4f3a5fc6da",
                                                "sense_id": "6cd64214-9837-31b6-a380-4de62774e406",
                                                "text": "Another environmental factor thought to be affecting some coastal birds, although comparatively little is yet known about its extent or origin, is the presence of marine pollutants such as polychlorinated biphenyls (PCBs) and toxic heavy metals."
                                            },
                                            {
                                                "example_id": "7d77c014-eba0-45eb-84f9-18937460414c",
                                                "sense_id": "6cd64214-9837-31b6-a380-4de62774e406",
                                                "text": "The microbes devoured the chlorides in the earth; as metabolic byproducts, they produced toxic polychlorinated biphenyls (PCBs). By the time the infestation was contained an area of nearly 30 square kilometers had been effectively turned into a toxic waste dump."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
