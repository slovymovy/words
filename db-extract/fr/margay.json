                    {
                        "form_id": "33099a5a-fdb9-4405-9dae-4b9d7327a961",
                        "entry_id": "9438e4ee-2786-3af6-b85d-750dabb23f69",
                        "tags": [],
                        "form": "marguay"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8999ce4-f1ba-3221-8c17-b02b1363244c",
                        "entry_id": "9438e4ee-2786-3af6-b85d-750dabb23f69",
                        "glosses": [
                            "Espèce de chat sauvage arboricole d’Amérique du Sud et centrale, de la famille des félidés, à la fourrure fauve et tachetée, et ressemblant fortement à l’ocelot, dont il se différencie par sa plus petite taille et une plus longue queue."
                        ],
                        "tags": [
                            "Félinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c48b5dec-a444-439b-b5f8-c18e7cef59f6",
                                "sense_id": "c8999ce4-f1ba-3221-8c17-b02b1363244c",
                                "text": "Son proche parent, le margay, mériterait autant que lui le titre quasi seigneurial de « léopard peint », en raison de la richesse décorative de son pelage."
                            },
                            {
                                "example_id": "17e0c6fa-75f8-4509-bb00-d9634c3bec60",
                                "sense_id": "c8999ce4-f1ba-3221-8c17-b02b1363244c",
                                "text": "Pour garantir l’intégrité de son territoire, la communauté a décidé de préserver une zone de 10 000 ha, la Playa de Oro Reserva de Tigrillos, afin de protéger les félins de la jungle —jaguars, cougars, ocelots, margays, oncillas et jaguarundis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df6e3c37-f6e8-4cb0-8d79-5127425ec2e7",
                        "source_entry_id": "9438e4ee-2786-3af6-b85d-750dabb23f69",
                        "source_sense_id": "c8999ce4-f1ba-3221-8c17-b02b1363244c",
                        "target_lang_word": "Langschwanzkatze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0313667e-c306-4fae-a578-1d50b4ae1f64",
                        "source_entry_id": "9438e4ee-2786-3af6-b85d-750dabb23f69",
                        "source_sense_id": "c8999ce4-f1ba-3221-8c17-b02b1363244c",
                        "target_lang_word": "margay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "margay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b78cc1c1-c2ae-3b25-92d7-94506f022689",
                                        "entry_id": "1d3cb3b7-7f12-3095-8e0c-c70b7296f943",
                                        "glosses": [
                                            "Leopardus wiedii, a spotted cat native to Central and South America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ba0f487-d031-4e84-8ce3-9bd454b5c7bd",
                                                "sense_id": "b78cc1c1-c2ae-3b25-92d7-94506f022689",
                                                "text": "In Costa Rica margays were once widely distributed in dense forest from the coastal lowlands to about 3,000 meters elevation in the interior mountains."
                                            },
                                            {
                                                "example_id": "aa95751d-a033-4b96-b2a3-7d9186f42637",
                                                "sense_id": "b78cc1c1-c2ae-3b25-92d7-94506f022689",
                                                "text": "Margays are small and slim spotted cats (60cm/40cm/3.5kg) with long bushy tails and long legs with large feet.\nTypically found in mature forest, margays are nocturnal and arboreal, hunting mostly in trees (they can rotate their hind legs and descend a tree head first)."
                                            },
                                            {
                                                "example_id": "1744a4f1-50fb-42ce-8c0f-c3ceae4bbc06",
                                                "sense_id": "b78cc1c1-c2ae-3b25-92d7-94506f022689",
                                                "text": "The margay has broad feet, flexible ankles, and a long tail, all adaptations for arboreality (Nowell and Jackson 1996). In captivity, the margay is well known for its climbing and jumping acrobatics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
