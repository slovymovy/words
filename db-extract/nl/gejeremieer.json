                        "examples": [
                            {
                                "example_id": "9d4d8747-4f10-4c82-9a42-e55abf4aab65",
                                "sense_id": "3c49fba0-a6d3-3ed6-98b4-56f8e200d2ea",
                                "text": "Erg voor de hand liggend, maar toch ook wel grappig, vind ik het als iemand ‘De club van Sinterklaas’ onder een groepsportret van enkel gekleurde spelers van het Nederlandse elftal plaatst, op de dag van de intocht van sinterklaas, een kinderfeest dat bedorven is door een niet te stoppen discussie over of Zwarte Piet nog wel kan, terwijl het overgrote deel van de bevolking het gejeremieer daarover zat was."
                            },
                            {
                                "example_id": "2108254d-1d81-4252-82e5-df88f65f421f",
                                "sense_id": "3c49fba0-a6d3-3ed6-98b4-56f8e200d2ea",
                                "text": "Je kunt de boekensector aan twee dingen herkennen: ze verkopen boeken, en ze klagen dat ze te weinig boeken verkopen. Houd nu eens op dat gejeremieer, schrijft Dirk Demuynck, het einde van het boek is lang niet nabij."
                            }
                        ]
                    }
