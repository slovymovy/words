        "fr-extract.jsonl": [
            {
                "entry_id": "6381670f-1c1d-342a-adba-69284232cd3f",
                "word": "computation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b451aa4-0188-4ba3-b14c-ee60d68f701e",
                        "entry_id": "6381670f-1c1d-342a-adba-69284232cd3f",
                        "tags": [
                            "plural"
                        ],
                        "form": "computations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1c9423f-06a4-343a-9497-de6968217209",
                        "entry_id": "6381670f-1c1d-342a-adba-69284232cd3f",
                        "glosses": [
                            "Calcul, évaluation d’un délai, fixation d’une date précise, ou d’un coût."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3631c03e-4927-46ad-9a61-cbac2bc7917e",
                                "sense_id": "d1c9423f-06a4-343a-9497-de6968217209",
                                "text": "Suivait une date correspondant, selon ma computation, au 14 mars 1257."
                            },
                            {
                                "example_id": "24fd5ae1-57aa-4de6-bc42-6e3aab72489a",
                                "sense_id": "d1c9423f-06a4-343a-9497-de6968217209",
                                "text": "Les professionnels d’un secteur,[…] peuvent également proposer de retenir la date de réception des marchandises ou d’exécution de la prestation de services demandée comme point de départ de ce délai. […]. Un décret peut […] valider le nouveau mode de computation et l’étendre à ces mêmes opérateurs."
                            },
                            {
                                "example_id": "9a65be5e-abdd-4efd-bf1a-d06da1298c44",
                                "sense_id": "d1c9423f-06a4-343a-9497-de6968217209",
                                "text": "La computation permet donc à l’acheteur de faire la meilleure estimation possible de son besoin afin de déterminer correctement les modalités de publicité et de mise en concurrence à mettre en œuvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "16e06fdc-31da-34e8-be2b-1d016de1afcc",
                        "entry_id": "6381670f-1c1d-342a-adba-69284232cd3f",
                        "glosses": [
                            "Génération, création."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea0c70d-385c-4282-8573-69472ff39070",
                                "sense_id": "16e06fdc-31da-34e8-be2b-1d016de1afcc",
                                "text": "Cette définition, traditionnellement retenue par le Parlement, n’a été reprise par le Conseil d’État et le secrétariat général du Gouvernement, pour les textes réglementaires, qu’à partir de l’année 2000. Jusqu’à cette date, il n’était procédé à la computation d’un nouvel alinéa que lors de chaque passage à la ligne faisant suite à un point."
                            }
                        ]
                    }
                ],
