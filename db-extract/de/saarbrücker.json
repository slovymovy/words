                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf99282-f5de-4684-aea6-2fe3ecb39461",
                                "sense_id": "9231a0a3-b7b2-306b-b2e5-139d769435cc",
                                "text": "Mein Freund ist Saarbrücker."
                            },
                            {
                                "example_id": "0a9fcd8f-f2f8-422c-9e7a-60765407cb9c",
                                "sense_id": "9231a0a3-b7b2-306b-b2e5-139d769435cc",
                                "text": "Nach 25 Minuten schwächten sich die Saarbrücker durch eine Rote Karte gegen Kevin Behrens zudem selbst."
                            },
                            {
                                "example_id": "191f2727-7683-4e2f-9e1f-e45c418db8c0",
                                "sense_id": "9231a0a3-b7b2-306b-b2e5-139d769435cc",
                                "text": "Die Saarbrücker konnten sich über erstmals von nächtlichen 15°C auf 29°C steigende Temperaturen freuen."
                            },
                            {
                                "example_id": "7a403cbc-43e2-41e7-a358-80050297494c",
                                "sense_id": "9231a0a3-b7b2-306b-b2e5-139d769435cc",
                                "text": "Die Polizei stoppte auf der Autobahn einen Saarbrücker, der mit einem VW Passat nicht nur mit gestohlenen Kennzeichen unterwegs war."
                            }
                        ],
