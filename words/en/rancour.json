                    "sense_id": "f42a93e2-f9d4-3d90-9410-9a99d4668035",
                    "sense_definition": "A feeling of deep, bitter anger or resentment towards someone, often lasting for a long time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke about his former business partner without any <w>rancour</w> despite their difficult past.",
                            "target_lang_translations": {
                                "zh": "尽管他们过去有过不愉快的经历，但在谈及前商业伙伴时，他毫无<w>怨恨</w>之情。"
                            }
                        },
                        {
                            "text": "The long-standing <w>rancour</w> between the two families finally began to fade after many years.",
                            "target_lang_translations": {
                                "zh": "多年之后，两个家族之间积压已久的<w>宿怨</w>终于开始消退。"
                            }
                        }
                    ],
