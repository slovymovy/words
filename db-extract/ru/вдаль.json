                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f437837-5c58-409c-8f7a-0182ac9cd0ca",
                                "sense_id": "b52ebdd5-3626-3316-82fb-f07e330cc6c7",
                                "text": "— Нет, ребята, я не гордый. // Не загадывая вдаль, // Так скажу: зачем мне орден? // Я согласен на медаль."
                            },
                            {
                                "example_id": "4a1c7c08-57c1-47f5-a573-0fd3fcb13c81",
                                "sense_id": "b52ebdd5-3626-3316-82fb-f07e330cc6c7",
                                "text": "Ему представилась уходящая вдаль вереница дней и недель."
                            }
                        ]
                    }
                ],
