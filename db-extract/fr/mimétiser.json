                ],
                "senses": [
                    {
                        "sense_id": "9f7c8014-c86e-321f-92f8-fac6e485906d",
                        "entry_id": "8e586bef-bd74-3308-958c-17b6478507e6",
                        "glosses": [
                            "Changer par mimétisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d36a05-c4ac-4bdc-8c58-ecb5572c02b6",
                                "sense_id": "9f7c8014-c86e-321f-92f8-fac6e485906d",
                                "text": "Ils croient que cette semblance humanisante consiste à imiter, mimétiser les manières des adultes, comme si les adultes jouaient un rôle qu’eux-mêmes ont à reprendre à leur compte."
                            },
                            {
                                "example_id": "c0a356e5-8b67-4b4f-8ae6-188e2b3c6248",
                                "sense_id": "9f7c8014-c86e-321f-92f8-fac6e485906d",
                                "text": "Par ailleurs, mon objectif, en me rendant au Mexique, était de me mimétiser avec Jérôme, de devenir Jérôme, pas de gagner ma vie."
                            },
                            {
                                "example_id": "5111e920-01b8-4012-b26f-b1bc18749bd9",
                                "sense_id": "9f7c8014-c86e-321f-92f8-fac6e485906d",
                                "text": "À côtoyer les fous, docteur Lasalle, on mimétise."
                            }
                        ]
                    }
                ],
