                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c65923cb-f05a-43bb-b295-2fe9d5c85907",
                                "sense_id": "effc99b5-c2a8-3e82-9cb0-08e9c6933382",
                                "text": "„Es war weit nach Mitternacht, aber in dem dichten Menschenstrom wies nichts darauf hin, dass irgendwer frühzeitig nach Hause gehen wollte.“"
                            },
                            {
                                "example_id": "b0b39b04-928d-44fd-b49a-2075cc4085b0",
                                "sense_id": "effc99b5-c2a8-3e82-9cb0-08e9c6933382",
                                "text": "„Die Menschenströme, die durch die Orte laufen, heißen Touristen.“"
                            }
                        ],
