                                        "sense_id": "e1367d21-6524-3155-8c60-330c5dbad70b",
                                        "entry_id": "c70bb47a-57c9-3f47-84d5-9c1431d64e64",
                                        "glosses": [
                                            "A student (especially an athlete) of the University of Southern California."
                                        ],
                                        "tags": [],
