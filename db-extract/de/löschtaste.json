                "senses": [
                    {
                        "sense_id": "05bd5081-3401-3225-a32d-68d5729b06c9",
                        "entry_id": "aa94db55-4c80-3e47-a742-2bbe90cdf75b",
                        "glosses": [
                            "Taste, deren Betätigung einen Löschvorgang auslöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b3ca8fb-e79d-434b-b3e7-7e10fa04ee64",
                                "sense_id": "05bd5081-3401-3225-a32d-68d5729b06c9",
                                "text": "„Dann schnellen die Zeigefinger der Gesundheitsapostel in die Höhe, so flott kann man gar nicht die Löschtaste drücken.“"
                            },
                            {
                                "example_id": "3ffe1d24-9c3b-4328-8743-58bc487ac4e6",
                                "sense_id": "05bd5081-3401-3225-a32d-68d5729b06c9",
                                "text": "„Die Untersuchung des Cockpit-Stimmen-Aufzeichnungsgeräts durch den Hersteller ergab zudem, dass nach der Landung in Altenrhein die Löschtaste gedrückt worden war.“"
                            },
                            {
                                "example_id": "058b9180-e489-4248-a6bb-f5ad73ffcbf7",
                                "sense_id": "05bd5081-3401-3225-a32d-68d5729b06c9",
                                "text": "„Feinde des Archivs sind der Computer und die Löschtaste, denn Handschriften mit Korrekturen gehören der Vergangenheit an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
