                "senses": [
                    {
                        "sense_id": "e6820596-d4b7-32f9-b00d-a8bf74c4180b",
                        "entry_id": "5ebe90af-3c3a-369b-8104-3a914373b156",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea9f8d8-5126-4352-8551-e7ab699bcad6",
                                "sense_id": "e6820596-d4b7-32f9-b00d-a8bf74c4180b",
                                "text": "Иль нет, спой нам лучше песню об удалом сыне Гостомыслове, Вадиме Новгородском."
                            },
                            {
                                "example_id": "e0de8759-6b5a-418d-80ff-ae707fde63a3",
                                "sense_id": "e6820596-d4b7-32f9-b00d-a8bf74c4180b",
                                "text": "― Твое имя? ― Вадим!"
                            },
                            {
                                "example_id": "5868a522-0719-4a89-a9aa-b5cde5b1e414",
                                "sense_id": "e6820596-d4b7-32f9-b00d-a8bf74c4180b",
                                "text": "Ксюха, дура, наколола себе сердечко, а внутри имя «Вадим»."
                            }
                        ]
                    }
                ],
