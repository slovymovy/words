                        "glosses": [
                            "астрон. единица измерения расстояний, равная 1000 парсек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5edea10-fedf-4999-9c53-69a245b70a48",
                                "sense_id": "80b56b91-4569-3e0b-8fc9-508b08d7c721",
                                "text": "Масштаб размеров Галактики — 30 килопарсек, размер темного гало примерно в десять раз больше."
                            }
                        ]
