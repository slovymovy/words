                    "sense_definition": "Aan de buitenkant of buiten het genoemde; vervangt de combinatie van het voorzetsel <w>buiten</w> met een voornaamwoord zoals 'het'.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "locatie_of_uitsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het restaurant ligt niet in het centrum, maar net <w>erbuiten</w>.",
                            "target_lang_translations": {
                                "en": "The restaurant is not in the city centre, but just <w>outside it</w>."
                            }
                        },
                        {
                            "text": "Dat conflict heeft niets met mij te maken, dus laat me <w>erbuiten</w>.",
                            "target_lang_translations": {
                                "en": "That conflict has nothing to do with me, so leave me <w>out of it</w>."
                            }
                        }
                    ],
