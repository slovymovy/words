                        "glosses": [
                            "Nom scientifique (Engraulis) de l’anchois, francisé en engraule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f64db98-1d7b-4243-95dc-bc87b5487dea",
                                "sense_id": "a3600823-3c36-3f58-ac52-dea3e56bf981",
                                "text": "L’engraulis vulgaire, est connu sous le nom d’anchois."
                            },
                            {
                                "example_id": "d2949521-215a-4a52-a941-e5b48da9effe",
                                "sense_id": "a3600823-3c36-3f58-ac52-dea3e56bf981",
                                "text": "L’engraulis melette, est dit vulgairement melet et nadelle."
                            }
                        ]
                    }
                ],
