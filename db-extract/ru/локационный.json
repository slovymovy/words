                "senses": [
                    {
                        "sense_id": "213b3888-f4cb-374e-bfe9-9544c16efa4c",
                        "entry_id": "1e162e8d-d9d7-34a6-bdd1-e760c9eb0121",
                        "glosses": [
                            "техн. относящийся к локации, основанный на применении методов и средств локации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09423dff-84ae-4efc-a6f3-1f431cd3adcf",
                                "sense_id": "213b3888-f4cb-374e-bfe9-9544c16efa4c",
                                "text": "Максим предложил для безопасности судоходства локационное предупреждающее устройство, которое сигнализировало бы о приближении к айсбергу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e18df391-8fb0-4d62-a591-05a8ce433841",
                        "source_entry_id": "1e162e8d-d9d7-34a6-bdd1-e760c9eb0121",
                        "source_sense_id": "213b3888-f4cb-374e-bfe9-9544c16efa4c",
                        "target_lang_word": "location",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "location",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "691bc65b-a201-31aa-bed8-9ba44bdaa1b9",
                                        "entry_id": "8ffaffb7-ef4b-37b5-84d0-8f7f541c5e30",
                                        "glosses": [
                                            "A particular point or place in physical space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "304a3576-9f10-4d7e-8ec1-e9131d3e30b2",
                                                "sense_id": "691bc65b-a201-31aa-bed8-9ba44bdaa1b9",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98096bb2-f3b1-32c9-ae5c-724149a2e267",
                                        "entry_id": "8ffaffb7-ef4b-37b5-84d0-8f7f541c5e30",
                                        "glosses": [
                                            "An act of locating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64c41ead-8323-4c6a-9b8d-b7c1370b5ddb",
                                                "sense_id": "98096bb2-f3b1-32c9-ae5c-724149a2e267",
                                                "text": "The Ontario tunnel was not located in pursuance of the law relating to tunnel-sites. Lewis failed to follow up his discovery of mineral therein with any effort whatever towards completing the statutory location of a mining claim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ca2b76-76c9-31d4-9ea1-019c4a023700",
                                        "entry_id": "8ffaffb7-ef4b-37b5-84d0-8f7f541c5e30",
                                        "glosses": [
                                            "An apartheid-era urban area populated by non-white people; a township."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b2e94e-c682-4cba-8a38-d8a1d214c5f6",
                                                "sense_id": "a6ca2b76-76c9-31d4-9ea1-019c4a023700",
                                                "text": "It is the sounds of apartheid, of the townships, the locations[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1cd9ba-7100-3252-a245-066e9b7d233b",
                                        "entry_id": "8ffaffb7-ef4b-37b5-84d0-8f7f541c5e30",
                                        "glosses": [
                                            "A leasing on rent."
                                        ],
