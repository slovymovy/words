                "translations": [
                    {
                        "translation_id": "5217d4a1-0e9d-48af-888a-e983de153eab",
                        "source_entry_id": "aa1b3773-9abe-3b3c-964a-06c2fce29146",
                        "source_sense_id": "690f7c8f-7abb-3ac2-b50b-6a3026607b95",
