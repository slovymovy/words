                "senses": [
                    {
                        "sense_id": "97e02f19-f034-33d2-b975-2b7a57e1cd9b",
                        "entry_id": "13963188-ad33-379c-8af6-8c5b3533d27e",
                        "glosses": [
                            "einem Euter ähnelnd, an einen Euter erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e8a2051-98b0-4e13-9d36-608c831cc8f4",
                                "sense_id": "97e02f19-f034-33d2-b975-2b7a57e1cd9b",
                                "text": "„Stumm musterte er das zierliche Webwerk im Moos. Ringförmige giftgrüne Flechten, die sich über die Steine spannten wie klitzekleine Jadevulkane. Gewellte, auf alten verrotteten Baumstämmen nistende Schwämme, flanschige euterartige Gewächse mit der Konsistenz von Gedärmen, bleiche fleischige Schmerwurztrauben im üppigen Humusmoder, Pilze mit gezackten Hautsoffitten, unter denen wahrscheinlich Kröten ihre Siesta hielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
