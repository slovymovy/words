    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b02670e6-ae87-328c-b975-871ae4c7c615",
                "word": "periwig",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "51a8d93c-4204-4320-89e0-6ce2d41472dd",
                        "entry_id": "b02670e6-ae87-328c-b975-871ae4c7c615",
                        "tags": [
                            "plural"
                        ],
                        "form": "periwigs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                        "entry_id": "b02670e6-ae87-328c-b975-871ae4c7c615",
                        "glosses": [
                            "A wig, especially any kind of stylised wig as formerly worn by men and women."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4135daec-d43f-4a3d-97a6-c8d9fa8b16f0",
                                "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                                "text": "O, it\noffends me to the soul to hear a robustious\nperiwig-pated fellow tear a passion to tatters, to\nvery rags, to split the ears of the groundling […]"
                            },
                            {
                                "example_id": "fd818663-bae4-4248-80de-202984c6a4a8",
                                "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                                "text": "Methinks she makes almost as fair a sign / As some old gentlewoman in a periwig."
                            },
                            {
                                "example_id": "db6fc18d-e5f4-4240-81cc-31f8fefb5734",
                                "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                                "text": "[T]he sun\nGrown stale, is to so low a value run,\nThat his dishevel'd beams and scattered fires\nServe but for ladies' periwigs and tyres\nIn lovers' sonnets […]"
                            },
                            {
                                "example_id": "62cd02a5-0567-43c5-a7a3-2f1ef805db8e",
                                "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                                "text": "The floods in icie fetters bound.\nCrusted earth. Every honey-headed twig\nWears his snowie Periwig,\nAnd every bough his snowy beard."
                            },
                            {
                                "example_id": "f94ddfd5-648e-4801-af08-93fa14d8dbf6",
                                "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                                "text": "From her own Head, Megwra takes\nA Perriwig of twisted Snakes;\nWhich in the nicest Fashion curl'd,\nLike Toupets of this upper World […]"
                            },
                            {
                                "example_id": "637ecb04-7ce3-40c7-a3d2-37ecc1100a2c",
                                "sense_id": "f5644611-2cea-3d51-8b86-11a57e076c2d",
                                "text": "[O]ur impetuous youth hearing himself reviled with the appellation of scoundrel, pulled off his antagonist's periwig, and flung it in his face."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
