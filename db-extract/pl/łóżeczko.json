                                        "entry_id": "fa1481dc-2733-3ce6-81f1-a939d23fb1d2",
                                        "glosses": [
                                            "A cottage or small homestead."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
