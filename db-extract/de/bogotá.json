                                        "glosses": [
                                            "Ville et capitale de la Colombie, → voir Bogota."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60e26cf6-3afa-4d93-a8f6-d8cffcefbc56",
                                                "sense_id": "f41285cc-369b-3f87-ba15-c4be72d17f50",
                                                "text": "Ce jour-là, la police de Bogotá découvre dans ses bagages 4 kilos de cocaïne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1380149-360f-3df8-98cf-7b1177a5c34c",
                                        "entry_id": "caf7497e-c6c0-322b-8e16-144c7fe8171e",
                                        "glosses": [
                                            "Le gouvernement colombien, → voir Bogota."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c26f241f-c341-4ed4-9dfe-952c8045dac6",
                                                "sense_id": "a1380149-360f-3df8-98cf-7b1177a5c34c",
                                                "text": "Une cérémonie placée sous le signe de la musique a eu lieu à la cathédrale de Bogotá."
                                            },
                                            {
                                                "example_id": "09ec7760-04d3-4681-a716-f43086b21ae1",
                                                "sense_id": "a1380149-360f-3df8-98cf-7b1177a5c34c",
                                                "text": "Un accord de libre-échange entre Union européenne et Colombie doit être signé ce mercredi. Or la prémisse de cet accord a peut-être été manipulée par Bogotá, dont le service d’espionnage a espionné pendant les discussions."
                                            },
                                            {
                                                "example_id": "40c81d16-ce15-4d6f-9dcc-e6f3b49d8f2d",
                                                "sense_id": "a1380149-360f-3df8-98cf-7b1177a5c34c",
                                                "text": "L’armée de Bogotá a réalisé, en libérant Ingrid Betancourt le 2 juillet, un exploit qui restera dans les annales militaires."
                                            }
                                        ]
                                    }
