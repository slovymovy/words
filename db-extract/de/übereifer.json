                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c448f4c-96f5-42db-bdbf-2c6c380c94a7",
                                "sense_id": "03ffd06b-0819-3d62-a783-610707e57d71",
                                "text": "„Übereifer und Dünkel waren seinem Wesen keine Gefahr, eher Bedenklichkeit und Vorliebe für den Platz im Schatten.“"
                            },
                            {
                                "example_id": "906def05-a52d-4ca8-a245-a403ec23b164",
                                "sense_id": "03ffd06b-0819-3d62-a783-610707e57d71",
                                "text": "„Ihr höflicher Übereifer kam mir verdächtig vor; und ich kam gerade noch rechtzeitig in die Küche, um zu verhindern, daß die Flamme des Samowars etwa ein Dutzend Briefe des lieben Grigori verzehrte.“"
                            }
                        ],
