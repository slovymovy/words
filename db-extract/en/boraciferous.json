                                        "examples": [
                                            {
                                                "example_id": "d9497a78-3717-4b1e-8268-a1b1c4629c8f",
                                                "sense_id": "68b73c9f-8056-398a-ae5b-8044b33a4079",
                                                "text": "Da die Borversorgung über die Nahrung und das Trinkwasser in der Regel ausreichend ist und ein zusätzlicher Nutzen von borhaltigen Nahrungsergänzungsmitteln unbelegt ist, wird angesichts der möglichen Risiken von deren Verwendung abgeraten."
                                            },
                                            {
                                                "example_id": "5d69a178-f759-45ac-9b90-c1132cfa63d2",
                                                "sense_id": "68b73c9f-8056-398a-ae5b-8044b33a4079",
                                                "text": "Statt der BF3-Gasfüllung kann auch eine borhaltige Schicht auf der Innenseite des Zählrohrs verwendet werden."
                                            },
                                            {
                                                "example_id": "11bf30e5-ef24-4dea-9bb2-0224bb7520bb",
                                                "sense_id": "68b73c9f-8056-398a-ae5b-8044b33a4079",
                                                "text": "Seit 2016 gibt es in den USA eine Salbe mit einer borhaltigen Verbindung, die bei Neurodermitis und Psoriasis eingesetzt werden kann."
                                            },
                                            {
                                                "example_id": "25d31bf1-eadd-4e62-a441-7ecb06dee03f",
                                                "sense_id": "68b73c9f-8056-398a-ae5b-8044b33a4079",
                                                "text": "Bei der Düngung sollte borhaltiger Mineraldünger verwendet werden."
                                            },
                                            {
                                                "example_id": "a447fef4-cc18-40c3-985e-95a62a8e4618",
                                                "sense_id": "68b73c9f-8056-398a-ae5b-8044b33a4079",
                                                "text": "Momentan werden in Österreich borhaltige Abfallmaterialien, wie etwa Dämmstoffe, die Borate als Flammschutzmittel und zur Schädlingsabwehr enthalten, als gefährlicher Abfall behandelt und entsprechend entsorgt und deponiert."
                                            }
