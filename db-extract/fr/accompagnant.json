                "senses": [
                    {
                        "sense_id": "29f097d9-6122-3c98-abd5-132a2bc0f230",
                        "entry_id": "15813468-3ca1-3266-9848-2e8f06b9a50e",
                        "glosses": [
                            "Participe présent du verbe accompagner."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ed78f5-d375-4d7d-854e-ca2f0e297d43",
                                "sense_id": "29f097d9-6122-3c98-abd5-132a2bc0f230",
                                "text": "Pour le groupe TF1, l’adaptation au changement climatique soit être abordée « en accompagnant les Français », « sans les culpabiliser », assure Thierry Thuillier, directeur général adjoint de l’information du groupe TF1."
                            },
                            {
                                "example_id": "ec9831cb-9045-414c-a0d0-41d32c08fb85",
                                "sense_id": "29f097d9-6122-3c98-abd5-132a2bc0f230",
                                "text": "S’accompagnant de son gimbri, il nous chante, d’une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                            }
                        ]
                    }
