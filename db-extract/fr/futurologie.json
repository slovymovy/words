        "fr-extract.jsonl": [
            {
                "entry_id": "7375ff6e-9749-34e0-a1b6-3ab72f0c4f21",
                "word": "futurologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "74270d6a-0aef-4eb3-9fc9-9ee7610ca386",
                        "entry_id": "7375ff6e-9749-34e0-a1b6-3ab72f0c4f21",
                        "tags": [
                            "plural"
                        ],
                        "form": "futurologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bb91f37-fece-353f-96a0-08790226060f",
                        "entry_id": "7375ff6e-9749-34e0-a1b6-3ab72f0c4f21",
                        "glosses": [
                            "Étude qui étudie les différents scénarios possibles du futur, à partir des données technologiques, économiques ou sociales du passé et du présent, en se basant sur des techniques et des modèles scientifiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f26e80e-9c74-4679-a10a-39b0de6a88a7",
                                "sense_id": "7bb91f37-fece-353f-96a0-08790226060f",
                                "text": "Il existe des problèmes de futurologie où les données historiques ne sont pas d'une grande utilité pour trouver une solution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de8d4760-b467-4ae3-9a32-03ad2e396364",
                        "source_entry_id": "7375ff6e-9749-34e0-a1b6-3ab72f0c4f21",
                        "source_sense_id": "7bb91f37-fece-353f-96a0-08790226060f",
                        "target_lang_word": "Futurologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Futurologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1148eed-238f-3978-b8fe-da8ca04a8131",
                                        "entry_id": "3ba9e27e-15d3-34b3-b45c-58c6313eb86d",
                                        "glosses": [
                                            "Wissenschaft, die Fragen möglicher zukünftiger Entwicklungen systematisch und kritisch untersucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98684217-9f82-48bb-946b-bf2525098eb9",
                                                "sense_id": "f1148eed-238f-3978-b8fe-da8ca04a8131",
                                                "text": "„Nach Ansicht vieler Futurologen hat die Futurologie nicht nur einen Prognoseaspekt, sondern ist ihrem Wesen nach eine Zusammenfassung von Prognose, Planung und Programmierung, enthält somit auch die aktive Einflussnahme auf das künftige Geschehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d0dfae8-ac68-45d1-b555-09016a15e540",
                        "source_entry_id": "7375ff6e-9749-34e0-a1b6-3ab72f0c4f21",
                        "source_sense_id": "7bb91f37-fece-353f-96a0-08790226060f",
                        "target_lang_word": "Zukunftsforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zukunftsforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "103ca663-ab4f-3d6f-a294-b50f0f080754",
                                        "entry_id": "fe55fa76-4ff0-3eef-b853-3e89bc048d8c",
                                        "glosses": [
                                            "„Sammelbezeichnung für Bemühungen, mit wissenschaftlichen Methoden Entwicklungen auf verschiedenen Gebieten vorauszusagen“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685e035f-6b38-4d6b-9816-a58d4800f20c",
                                                "sense_id": "103ca663-ab4f-3d6f-a294-b50f0f080754",
                                                "text": "„Die Hoffnung aus der Anfangszeit der Zukunftsforschung, Langzeitprognosen stellen zu können, hat sich nicht erfüllt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
