{
    "word_family": [
        "peapod",
        "peashooter",
        "peasoup"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd98f163-dfd6-3e48-95c0-600cbb5337e0",
                    "sense_definition": "The small, round, edible green seed of the legume Pisum sativum.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "legume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child refused to eat even a single <w>pea</w> from his dinner plate.",
                            "target_lang_translations": {
                                "ru": "Ребенок отказался съесть даже одну <w>горошину</w> со своей тарелки."
                            }
                        },
                        {
                            "text": "She added a handful of <w>frozen</w> <w>peas</w> to the boiling vegetable soup.",
                            "target_lang_translations": {
                                "ru": "Она добавила горсть замороженного <w>горошка</w> в кипящий овощной суп."
                            }
                        }
                    ],
                    "common_phrases": [
                        "frozen peas",
                        "mushy peas",
                        "sweet pea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькое круглое съедобное зеленое семя бобового растения Pisum sativum."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горошина",
                                "target_lang_sense_clarification": "отдельное семя"
                            },
                            {
                                "target_lang_word": "горох",
                                "target_lang_sense_clarification": "собирательное название плодов"
                            },
                            {
                                "target_lang_word": "горошек",
                                "target_lang_sense_clarification": "обычно о консервированном или молодом горохе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce76f00a-8160-366a-a30e-d4da86eeddda",
                    "sense_definition": "The climbing plant, Pisum sativum, which produces pods containing edible seeds.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "legume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the garden, long rows of <w>peas</w> put forth their white-winged flowers.",
                            "target_lang_translations": {
                                "ru": "В саду длинные ряды <w>гороха</w> распустили свои белые цветы, похожие на крылья."
                            }
                        },
                        {
                            "text": "We need to build a trellis for the <w>pea</w> plants to climb as they grow.",
                            "target_lang_translations": {
                                "ru": "Нам нужно построить шпалеру, чтобы растения <w>гороха</w> могли виться по мере роста."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pea plant",
                        "pea pod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вьющееся растение Pisum sativum, на котором растут стручки со съедобными семенами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горох",
                                "target_lang_sense_clarification": "само растение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3589355e-cebb-392f-be28-64a0e4281dc9",
                    "sense_definition": "Any of several varieties of bean or other legumes that resemble the true pea.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "legume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Black-eyed <w>peas</w> are a staple ingredient in many traditional Southern dishes.",
                            "target_lang_translations": {
                                "ru": "Черноглазый <w>горох</w> является основным ингредиентом многих традиционных южных блюд."
                            }
                        },
                        {
                            "text": "The recipe calls for pigeon <w>peas</w> to be served alongside the seasoned rice.",
                            "target_lang_translations": {
                                "ru": "По рецепту голубиный <w>горох</w> следует подавать вместе с приправленным рисом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "black-eyed peas",
                        "chick peas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Различные сорта фасоли или других бобовых, напоминающие настоящий горох."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горох",
                                "target_lang_sense_clarification": "в названиях похожих бобовых"
                            },
                            {
                                "target_lang_word": "бобы",
                                "target_lang_sense_clarification": "общая категория"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "def42e9b-6186-36db-abea-5cfad7633a07",
                    "sense_definition": "A slang term used to refer to money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been working hard lately and must have <w>bare</w> <w>peas</w> saved up.",
                            "target_lang_translations": {
                                "ru": "В последнее время он много работал и, должно быть, накопил кучу <w>бабок</w>."
                            }
                        },
                        {
                            "text": "The young entrepreneur was focused on making <w>peas</w> to fund his next project.",
                            "target_lang_translations": {
                                "ru": "Молодой предприниматель был сосредоточен на том, чтобы зашибить <w>деньжат</w> для финансирования своего следующего проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "money",
                        "cash",
                        "dough"
                    ],
                    "common_phrases": [
                        "bare peas"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "primarily British urban slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое выражение, используемое для обозначения денег."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бабки",
                                "target_lang_sense_clarification": "сленг, деньги"
                            },
                            {
                                "target_lang_word": "капуста",
                                "target_lang_sense_clarification": "сленг, деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2db3f68f-de9b-3357-9681-1b3cd7b49c2e",
                    "sense_definition": "A shortened or informal term for a peafowl, such as a peacock or peahen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pea</w> strutted across the lawn, showing off its vibrant feathers.",
                            "target_lang_translations": {
                                "ru": "<w>Павлин</w> важно вышагивал по лужайке, демонстрируя свои яркие перья."
                            }
                        },
                        {
                            "text": "We could hear the loud call of a <w>pea</w> coming from the estate gardens.",
                            "target_lang_translations": {
                                "ru": "Мы слышали громкий крик <w>павлина</w>, доносившийся из садов поместья."
                            }
                        }
                    ],
                    "synonyms": [
                        "peafowl"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rarely used outside specific contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное или неформальное название павлина (самца или самки)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "павлин",
                                "target_lang_sense_clarification": "общее название птицы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "77c339f6-83f6-3f1d-b2cc-8b799d112997",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family with the last name <w>Pea</w> living on Oak Street.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значилась семья по фамилии <w>Пи</w>, живущая на Оук-стрит."
                            }
                        },
                        {
                            "text": "Professor <w>Pea</w> delivered a fascinating lecture on the history of linguistics.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Пи</w> прочитал захватывающую лекцию по истории лингвистики."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "rare surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пи",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}